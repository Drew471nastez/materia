          "type": "faq_item",
          "settings": {
            "question": "How do I take Prime1?",
            "answer": "<p>Mix one scoop with cold water, shake well, and drink it in the morning, before training, before studying, or before a focused work session.</p>"
          }
        },
        "faq_item_J8jTAz": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use Prime1 every day?",
            "answer": "<p>Yes. Prime1 is designed to fit into a daily routine. It is made for people who want something simple, easy to mix, and consistent enough to use regularly.</p>"
          }
        },
        "faq_item_atNJ3i": {
          "type": "faq_item",
          "settings": {
            "question": "When should I drink Prime1?",
            "answer": "<p>Most people take Prime1 in the morning to start the day feeling more focused and ready. You can also take it before work, training, studying, or any moment when you want clean energy and better focus.</p>"
          }
        },
        "faq_item_dEjnPJ": {
          "type": "faq_item",
