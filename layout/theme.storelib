    <script src="{{ 'section-links.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-counters.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-block-runtime.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-dialogs.js' | asset_url }}" defer="defer"></script>
    {%- comment -%} Editor section HTML may be inserted without executing its
      scripts. These runtimes must already be listening before a section is
      added, redrawn, or its controls change. Styles are scoped to each type. {%- endcomment -%}
    {{ 'hero-image-one.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'hero-image-one.js' | asset_url }}" defer="defer"></script>
    {{ 'testimonial-quote.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'testimonial-quote.js' | asset_url }}" defer="defer"></script>
    {{ 'announcement-pro-4.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'announcement-pro-4.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'announcement-three-colors.js' | asset_url }}" defer="defer"></script>
    {{ 'product-block-runtime.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Available before editor toggles hover zoom; modules added
      inside a redrawn section are not guaranteed to execute in the canvas. {%- endcomment -%}
    {{ 'drift-basic.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'drift.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'photoswipe-init.js' | asset_url }}" type="module"></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      // A tap on the menu or search button before the theme's scripts have
      // run (a slow connection) would do nothing. Hold the last such tap and
      // give it again once the page's scripts are ready (DOMContentLoaded
      // follows every deferred script). Links are left alone: they work.
      (function () {
        if (document.readyState !== 'loading') return;
        var EARLY = '.nav-toggle, button[data-action="toggle-nav"], button.top-search-toggle';
        var held = null;
        function hold(e) {
          var t = e.target && e.target.closest && e.target.closest(EARLY);
          if (!t) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          held = t;
          t.setAttribute('aria-busy', 'true');
        }
        document.addEventListener('click', hold, true);
        document.addEventListener('DOMContentLoaded', function () {
          document.removeEventListener('click', hold, true);
          setTimeout(function () {
            if (!held) return;
            var t = held;
            held = null;
            t.removeAttribute('aria-busy');
            if (t.isConnected) t.click();
          }, 0);
        }, { once: true });
      })();
      if ({{ request.design_mode | json }} || window.Shopify?.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
      // Some imported-theme canvases omit request.design_mode. Use the
      // actual builder referrer, never the mere fact that this is an iframe.
      try {
        const editor = new URL(document.referrer);
        if (window.top !== window && (editor.hostname === 'storelib.com' || editor.hostname.endsWith('.storelib.com')) && editor.pathname.includes('/website-builder')) document.documentElement.classList.add('shopify-design-mode');
      } catch (_) {}
      // Once: adding a class the root already has still rewrites the attribute,
      // and every observer of <html> would wake on each frame of a drag.
      {
        const markDesign = () => { const root = document.documentElement; if (!root.classList.contains('shopify-design-mode')) root.classList.add('shopify-design-mode'); };
        document.addEventListener('storelib:settings-change', markDesign);
        document.addEventListener('storelib:section-load', markDesign);
      }
{% comment %}{% endcomment %}    </script>
    {%- comment -%}
      Materia responsiveness guard. Stops any section, image, or embed from
      pushing the page wider than the screen on mobile (the horizontal-scroll /
      content-spilling-off-the-edge problem). overflow-x: clip is used on
      purpose instead of overflow-x: hidden: clip does NOT create a scroll
      container, so it never breaks the sticky / fixed header, the pill header,
      or position: sticky used anywhere else in the theme. overflow-y stays
      visible, so vertical page scrolling is completely unaffected.
    {%- endcomment -%}
    <style>
      html, body { overflow-x: clip; }
      body { max-width: 100%; }
      img, svg, video, iframe, canvas, table, pre,
      lite-youtube, model-viewer, .shopify-installments {
        max-width: 100%;
      }
      /* The page keeps its scrollbar space while a drawer, search or popup
         locks scrolling, so nothing shifts and the fixed header is not cut.
         The old compensation (body padding, header margin) is switched off. */
      html { scrollbar-gutter: stable; --mat-sbw: 0px !important; }
      body { padding-right: 0 !important; }
      /* Buttons press and release smoothly; a loading button keeps its size and
         swaps its label for the spinner with a fade instead of snapping. */
      /* Every theme button eases its colours with Theme settings > Buttons
         (hover transition time and feel), in and out, from the resting state.
         The label and icons inside are painted directly by the button text
         rules above, so they get the same transition or they would snap while
         the fill fades. Only paint and transform move. */
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button], .btn-link, .btn-checkout, .shopify-payment-button__button--unbranded, .shopify-payment-button__more-options, .shopify-challenge__button, .dmp_discount-form button) {
        transition-property: background-color, color, border-color, box-shadow, opacity, transform, filter, text-decoration-color, visibility;
        transition-duration: var(--btn-anim-duration, 300ms);
        transition-timing-function: var(--btn-anim-ease, cubic-bezier(0.2, 0.7, 0.2, 1));
      }
      body :is(.btn-primary, .btn-outline, .btn-white, .btn-secondary, .btn-checkout, .shopify-payment-button__button--unbranded, .shopify-payment-button__more-options, .shopify-challenge__button, .dmp_discount-form button) :where(*) {
        transition-property: color, opacity, transform;
        transition-duration: var(--btn-anim-duration, 300ms);
        transition-timing-function: var(--btn-anim-ease, cubic-bezier(0.2, 0.7, 0.2, 1));
      }
      /* The card's add to cart button had its own fixed .3s and a label that
         snapped; it follows the same setting. */
      html body .product-item :is(button[name="add"], .product__add-cart, .product-item__button-submit) {
        transition-property: background-color, color, border-color, box-shadow, opacity, transform !important;
        transition-duration: var(--btn-anim-duration, 300ms) !important;
        transition-timing-function: var(--btn-anim-ease, cubic-bezier(0.2, 0.7, 0.2, 1)) !important;
      }
      html body .product-item :is(button[name="add"], .product__add-cart, .product-item__button-submit) * {
        transition: color var(--btn-anim-duration, 300ms) var(--btn-anim-ease, cubic-bezier(0.2, 0.7, 0.2, 1));
      }
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]).loading { transform: none; }
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]) :is(.hidden-on-load, .icon-load) { transition: opacity .2s ease; }
      /* Cart reservation timer (drawer and cart page): the label wraps, the
         time stays on its line, digits keep one width so it never jumps. */
      countdown-timer[data-minutes-left] { display: flex; flex-wrap: nowrap !important; align-items: baseline; gap: 8px; }
      countdown-timer[data-minutes-left] > :first-child { flex: 1 1 auto; min-width: 0; margin: 0 !important; }
      countdown-timer[data-minutes-left] .countdown-inner { flex: 0 0 auto; display: inline-flex; gap: .45em; white-space: nowrap; font-variant-numeric: tabular-nums; }
      countdown-timer[data-minutes-left] .countdown--container { display: inline-flex; align-items: baseline; margin: 0 !important; padding: 0 !important; }
      countdown-timer[data-minutes-left] .countdown--container::after { content: none !important; }
      countdown-timer[data-minutes-left] .countdown--container > :first-child { display: inline-block; min-width: 2ch; text-align: end; font-kerning: none; }
      @media (prefers-reduced-motion: reduce) {
        body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button], .btn-link, .btn-checkout) { transition: none; }
        body :is(.btn-primary, .btn-outline, .btn-white, .btn-secondary, .btn-checkout) :where(*),
        html body .product-item :is(button[name="add"], .product__add-cart, .product-item__button-submit),
        html body .product-item :is(button[name="add"], .product__add-cart, .product-item__button-submit) * { transition: none !important; }
        body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]):active { transform: none; }
      }
{% comment %}{% endcomment %}    </style>
    {%- comment -%}
      Sticky-footer layout — page content always fills at least one
      viewport height. This stops the body's white background from
      showing as a gap below the footer when content is short, AND
      keeps the footer flush against the top of the mobile-nav bar
      on mobile (no awkward white strip in between).

      In <head>, so the first paint already has the final layout; drawn
      after the header it made the header shift once on landing.

      Skipped in design_mode so Shopify's section-picker preview
      iframes (which render in tiny viewports and may misbehave with
      flex column + 100dvh) get a clean baseline layout.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
      <style>
        html, body { min-height: 100%; }
        body {
          display: flex;
          flex-direction: column;
          min-height: 100vh;
          min-height: 100dvh;
        }
        body > #shopify-section-header-group,
        body > #shopify-section-sections--header-group,
        body > .shopify-section-header,
        body > #shopify-section-announcement-group,
        body > .shopify-section-group-header-group { flex: 0 0 auto; }
        main#MainContent { flex: 1 0 auto; }
        body > #shopify-section-footer-group,
        body > #shopify-section-sections--footer-group,
        body > .shopify-section-group-footer-group { flex: 0 0 auto; }
{% comment %}{% endcomment %}      </style>
    {%- endunless -%}
  </head>
  <body
    class="gradient{% if request.design_mode %} shopify-design-mode{% endif %}{% if settings.rounded_corner > 1 and settings.enable_rounded %} rounded-style{% endif %}{% if settings.action_after_add_cart == 'show_popup' %} minicart_type-popup{% endif %}{% if enable_rtl %} rtl{% endif %} {% if request.page_type == 'cart'%}template-cart{% endif %} {{ request.page_type }}"
    data-btn-style="{{ settings.btn_style | default: 'solid' }}"
    data-btn-secondary-style="{{ settings.btn_secondary_style | default: 'outline' }}"
    data-scroll-animation="{{ settings.scroll_animation | default: 'none' }}"
    data-btn-shape="{{ settings.btn_shape | default: 'rounded' }}"
    data-btn-hover="{{ settings.btn_hover_effect | default: 'fade' }}"
    data-sl-btn-hover="{{ settings.storelib_button_hover_effect | default: 'theme' }}"
    data-badge-shape="{{ settings.badges_shape | default: 'pill' }}"
    data-badge-size="{{ settings.badges_size | default: 'medium' }}"
    data-badge-position="{{ settings.badges_position | default: 'top_start' }}"
    data-badge-anim="{{ settings.badges_animation | default: 'none' }}"
    data-menu-hover="{{ settings.menu_hover_style | default: 'underline' }}"
  >
    {%- comment -%}
      Theme settings > Buttons draws every hover setting Storelib adds (this
      theme declares each id itself). Storelib also writes its own reading of
      them at the end of <head>: for "Extra hover movement: None" that is a
      sheet that switches off every button transition, lift and shadow with
      !important, so Hover transition time, Hover feel and Hover effect did
      nothing. The theme already draws each of these settings, so that sheet
      is set aside, here before the first paint and again after a change in
      the builder.
    {%- endcomment -%}
    <script>
      (function () {
        function release() {
          var list = document.querySelectorAll('style[data-storelib-overrides]');
          for (var i = 0; i < list.length; i++) if (list[i].media !== 'not all') list[i].media = 'not all';
        }
        release();
        // In the builder: once a frame while a control moves, and once more
        // after it stops, not twice for every value of a drag.
        var frame = 0, later = 0;
        document.addEventListener('storelib:settings-change', function () {
          if (!frame) frame = requestAnimationFrame(function () { frame = 0; release(); });
          clearTimeout(later);
          later = setTimeout(release, 120);
        });
      })();
{% comment %}{% endcomment %}    </script>
    {%- liquid
      sections 'header-group'
    -%}


    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- render 'product-size-chart-data', product: product -%}
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {%- comment -%}
      The overlay group already holds the mobile navigation bar and the custom
      colours. The static copies drawn here as well were a second, empty bar
      wrapper and the same colour CSS twice.
    {%- endcomment -%}
    {%- sections 'overlay-group' -%}
    {%- render 'top-search' -%}
    {%- if localization.available_countries.size > 1 -%}<script type="application/json" id="materia-country-options" data-current="{{ localization.country.iso_code }}">{%- render 'country-options' -%}</script>{%- endif -%}
    {%- render 'minicart' -%}
    {%- comment -%}
      Invisible copy the builder redraws with unsaved settings; the drawer
      reads it in the editor only, so a visitor's page does not carry (or the
      server draw) a second cart drawer.
    {%- endcomment -%}
    {%- if request.design_mode -%}
      {%- section 'cart-drawer-live' -%}
    {%- endif -%}
    {%- render 'editor-live-images' -%}
    {%- render 'scripts-tag' -%}
    {%- render 'sprite-svg' -%}
    {%- render 'content-bottom' -%}
    {%- render 'smooth-media-load' -%}

    {%- if settings.social_floating_enable -%}
      {%- liquid
        assign fb_side = settings.social_floating_side | default: 'left'
        assign fb_vis  = settings.social_floating_visibility | default: 'desktop_only'
      -%}
      <aside class="social-floating-bar social-floating-bar--{{ fb_side }} social-floating-bar--{{ fb_vis }}" aria-label="{{ 'accessibility.social_media' | t }}">
        {%- render 'social-icons' -%}
      </aside>
      {%- style -%}
        .social-floating-bar {
          position: fixed; top: 50%; transform: translateY(-50%); z-index: 90;
          padding: 8px;
          border-radius: 14px;
          background: rgba(255,255,255,0.94);
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
          box-shadow: 0 8px 28px -10px rgba(0,0,0,.16);
          border: 1px solid rgba(0,0,0,.06);
        }
        .social-floating-bar--left  { left: 12px; }
        .social-floating-bar--right { right: 12px; }
        .social-floating-bar .list-social {
          flex-direction: column;
          --col-gap: 8px;
        }
        .social-floating-bar--mobile_only { display: none; }
        @media (min-width: 1025px) {
          .social-floating-bar--mobile_only { display: none !important; }
        }
        @media (max-width: 1024.98px) {
          .social-floating-bar--desktop_only { display: none !important; }
          .social-floating-bar--mobile_only  { display: block; }
        }
      {%- endstyle -%}
    {%- endif -%}

    {%- comment -%}
      Register content sections with the shared, single-run reveal controller.
      Editor previews and content already in view stay visible. The controller
      owns observation and completion so section insertion cannot restart an
      animation that has already finished.
    {%- endcomment -%}
    {%- if settings.scroll_animation != 'none' and settings.scroll_animation != blank -%}
      {%- assign _anim_dur = settings.animation_duration | default: 700 -%}
      {%- assign _anim_dur_short = _anim_dur | times: 0.7 | round -%}
      {%- assign _anim_delay = settings.animation_delay | default: 0 -%}
      <style>
        :root {
          /* Wire the user's Animations & motion settings to the keyframe vars used by animation.css */
          --duration-long: {{ _anim_dur_short }}ms;
          --duration-extra-long: {{ _anim_dur }}ms;
          --duration-extra-longer: {{ _anim_dur }}ms;
          --animation-duration: {{ _anim_dur }}ms;
          --animation-delay-base: {{ _anim_delay }}ms;
        }
        /* Every reveal type, its timing, the first screen, the builder and
           reduced motion are drawn by animation.css for every .scroll-trigger
           (theme-wide sections below and cards inside sections alike). */
{% comment %}{% endcomment %}      </style>
      <script>
        (function() {
          var anim = {{ settings.scroll_animation | json }};
          if (!anim || anim === 'none') return;

          if (document.documentElement.classList.contains('shopify-design-mode') || window.Shopify?.designMode) return;

          // Skip these — chrome/utility sections that should never animate-in.
          var SKIP_PATTERN = /(header|footer|announcement|top[-_]?bar|popup|cookie|gdpr|consent|back[-_]?to[-_]?top|mobile[-_]?navigation|mobile[-_]?nav[-_]?bar|password|age[-_]?verifier|preloader|search[-_]?popup|social[-_]?floating|overlay[-_]?group|header[-_]?group|footer[-_]?group)/i;

          function shouldSkip(s) {
            if (!s) return true;
            if (s.dataset.noReveal === '1') return true;
            if (s.dataset.tiRevealInit === '1') return true;
            if (s.classList.contains('scroll-trigger')) return true;
            if (s.querySelector('[data-ti-no-reveal]')) return true;
            var hay = (s.id || '') + ' ' + (s.className || '');
            // For static/global sections (id starts with shopify-section-sections--)
            // also catch theme-template chrome (e.g. main-* are fine, but the wrappers above are not).
            if (SKIP_PATTERN.test(hay)) return true;
            var main = document.getElementById('MainContent') || document.querySelector('main');
            var first = main && main.querySelector(':scope > .shopify-section');
            if (first && s === first) return true;
            return false;
          }

          function applyReveal(root) {
            root = root || document;
            var sections = Array.from(root.querySelectorAll('.shopify-section'));
            if (root.matches && root.matches('.shopify-section')) sections.unshift(root);
            sections.forEach(function(s) {
              if (shouldSkip(s)) return;
              s.classList.add('scroll-trigger', 'ti-section-reveal', anim);
              s.dataset.tiRevealInit = '1';
            });
            if (typeof initializeScrollAnimationTrigger === 'function') initializeScrollAnimationTrigger(root);
          }

          function boot() {
            applyReveal(document);

            // Observe future section insertions (theme editor, AJAX, etc.).
            if ('MutationObserver' in window) {
              var mo = new MutationObserver(function(muts) {
                var hit = false;
                for (var i = 0; i < muts.length; i++) {
                  var added = muts[i].addedNodes;
                  for (var j = 0; j < added.length; j++) {
                    var n = added[j];
                    if (n && n.nodeType === 1 && (n.classList && n.classList.contains('shopify-section') || (n.querySelector && n.querySelector('.shopify-section')))) {
                      hit = true; break;
                    }
                  }
                  if (hit) break;
                }
                if (hit) applyReveal(document);
              });
              mo.observe(document.body, { childList: true, subtree: true });
            }

            // Theme editor: re-apply on section load/reorder/select.
            if (window.Shopify && window.Shopify.designMode) {
              document.addEventListener('shopify:section:load', function(e) {
                applyReveal(e.target.parentNode || document);
              });
              document.addEventListener('shopify:section:reorder', function() {
                applyReveal(document);
              });
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
          } else {
            boot();
          }
        })();
{% comment %}{% endcomment %}      </script>
    {%- endif -%}
    {%- comment -%}
      Safety net, always on. (1) Content hidden for an entrance animation is
      shown once it sits in view and its animation never started (observer
      missed it, a script failed). (2) Product images still waiting on a
      loader class are shown once they have loaded. (3) A scroll lock left on
      the page with nothing open is released when the visitor tries to scroll.
      It only reads the page on scroll (twice a second at most) and on a
      scroll attempt while locked, never on a timer.
    {%- endcomment -%}
    <style>
      /* The product information ships hidden for its fade; if the script that
         fades it in never runs, show it anyway after 3s. */
      motion-element.opacity-0 { animation: materiaFailsafeShow 0s linear 3s forwards; }
      @keyframes materiaFailsafeShow { to { opacity: 1; } }
      /* The product information is never animated by the script (it skips
         it, so buying is never delayed), yet it stayed hidden until every
         deferred script had run, then popped in. It now shows from the first
         paint with a short settle drawn by CSS alone. It is in the first
         screen, so it never starts invisible: only a small rise, painted
         from the first frame (the title and price count for the first paint
         as soon as they arrive). No fill, so once it ends the block holds no
         layer that could trap a pop-up. */
      @keyframes materiaInfoIn { from { transform: translate3d(0, 6px, 0); } }
      motion-element:is(.product-detail__information, .product-single__information) { opacity: 1; animation: materiaInfoIn .38s cubic-bezier(.2, .7, .2, 1); }
      @media (prefers-reduced-motion: reduce) { motion-element:is(.product-detail__information, .product-single__information) { animation: none; } }
      html.shopify-design-mode motion-element:is(.product-detail__information, .product-single__information) { animation: none; }
{% comment %}{% endcomment %}    </style>
    <script>
      (function () {
        var html = document.documentElement;
        function inView(el) {
          var r = el.getBoundingClientRect();
          return r.width > 0 && r.height > 0 && r.top < innerHeight && r.bottom > 0 && r.left < innerWidth && r.right > 0;
        }

        /* (1) and (2) */
        var pending = typeof WeakMap === 'function' ? new WeakMap() : null;
        function revealNow(el) {
          if (el.classList.contains('scroll-trigger--offscreen') || el.classList.contains('scroll-trigger--armed')) {
            el.classList.remove('scroll-trigger--offscreen', 'scroll-trigger--armed');
            el.setAttribute('data-animation-done', '');
            el.setAttribute('animation-end', '');
          }
          if (el.tagName === 'MOTION-ELEMENT') {
            if (typeof el.finishMotion === 'function') el.finishMotion();
            else { el.style.opacity = '1'; el.style.removeProperty('transform'); el.classList.remove('opacity-0'); }
          }
        }
        function scan() {
          var now = Date.now();
          var hidden = document.querySelectorAll('.scroll-trigger--offscreen, motion-element:not([hold])[style*="opacity"]');
          for (var i = 0; i < hidden.length; i++) {
            var el = hidden[i];
            if (el.tagName === 'MOTION-ELEMENT' && parseFloat(el.style.opacity) !== 0) continue;
            if (!inView(el)) { if (pending) pending.delete(el); continue; }
            if (!pending) { revealNow(el); continue; }
            var since = pending.get(el);
            if (!since) pending.set(el, now);
            // A motion element may wait up to 2s for its image before fading in.
            else if (now - since > (el.tagName === 'MOTION-ELEMENT' ? 2600 : 900)) { pending.delete(el); revealNow(el); }
          }
          var imgs = document.querySelectorAll('img.bls-loading-image');
          for (var j = 0; j < imgs.length; j++) {
            var img = imgs[j];
            if (img.complete && img.naturalWidth > 0) {
              img.classList.remove('bls-loading-image');
              var m = img.closest('motion-element');
              if (m) m.classList.remove('bls-loading-image');
            }
          }
        }
        var lastScan = 0, scanTimer = 0, settleScan = 0, finalScan = 0;
        function queueScan() {
          if (document.hidden) return;
          if (scanTimer) return;
          var wait = Math.max(0, 500 - (Date.now() - lastScan));
          scanTimer = setTimeout(function () {
            scanTimer = 0; lastScan = Date.now();
            (window.requestAnimationFrame || setTimeout)(scan);
            // Keep only two settling checks, not two more for every scroll tick.
            clearTimeout(settleScan); clearTimeout(finalScan);
            settleScan = setTimeout(function () { if (!document.hidden) requestAnimationFrame(scan); }, 1000);
            finalScan = setTimeout(function () { if (!document.hidden) requestAnimationFrame(scan); }, 2800);
          }, wait);
        }
        addEventListener('scroll', queueScan, { passive: true });
        addEventListener('resize', queueScan, { passive: true });
        addEventListener('load', queueScan);
        addEventListener('pageshow', queueScan);
        addEventListener('pagehide', function () {
          clearTimeout(scanTimer); clearTimeout(settleScan); clearTimeout(finalScan);
          scanTimer = settleScan = finalScan = 0;
        });
        document.addEventListener('visibilitychange', function () { if (!document.hidden) queueScan(); });
        document.addEventListener('DOMContentLoaded', function () { setTimeout(queueScan, 1500); });

        /* (3) */
        var LOCKS = ['open-drawer', 'open-popup', 'nav-open', 'nav-verticalmenu', 'open-search', 'open-minicart', 'open-sidebar', 'open-byl', 'no-scroll'];
        var OPEN = 'cart-notification.open, .minicart__wrapper.open, #search-form.open, .popup-search.popup-search-show, .overlay_search.open, .bls__drawer.open, .open.overlay, html.nav-open :is(.navigation.mobile, nav.mobile), .tingle-modal--visible, dialog[open], #mt-gate, .pv-overlay.is-open, [aria-modal="true"]:not([hidden])';
        var lastChange = Date.now();
        function locked() {
          var b = document.body;
          if (!b) return false;
          for (var i = 0; i < LOCKS.length; i++) if (html.classList.contains(LOCKS[i]) || b.classList.contains(LOCKS[i])) return true;
          return b.classList.contains('tingle-enabled') || html.style.overflow === 'hidden' || b.style.overflow === 'hidden';
        }
        function shown(el) {
          // On screen (a drawer slid out of view does not count) and painted.
          var r = el.getBoundingClientRect();
          if (!(r.width > 0 && r.height > 0 && r.top < innerHeight && r.bottom > 0 && r.left < innerWidth && r.right > 0)) return false;
          var cs = getComputedStyle(el);
          return cs.visibility !== 'hidden' && parseFloat(cs.opacity) > 0.05;
        }
        function somethingOpen() {
          var list = document.querySelectorAll(OPEN);
          for (var i = 0; i < list.length; i++) if (shown(list[i])) return true;
          // Whatever covers the middle of the screen: a fixed layer that large is a drawer, sheet or popup.
          // Every layer under that point counts (a small fixed modal over a separate backdrop).
          var stack = document.elementsFromPoint ? document.elementsFromPoint(innerWidth / 2, innerHeight / 2).slice(0, 8) : [document.elementFromPoint(innerWidth / 2, innerHeight / 2)];
          var area = innerWidth * innerHeight;
          for (var s = 0; s < stack.length; s++) {
            for (var el = stack[s]; el && el !== html && el !== document.body; el = el.parentElement) {
              if (getComputedStyle(el).position !== 'fixed') continue;
              var r = el.getBoundingClientRect();
              if (r.width * r.height >= area * 0.25 && !el.closest('header, .section-header')) return true;
            }
          }
          return false;
        }
        function release() {
          var b = document.body;
          LOCKS.forEach(function (c) { html.classList.remove(c); b.classList.remove(c); });
          if (b.classList.contains('tingle-enabled')) {
            var top = parseFloat(b.style.top) || 0;
            b.classList.remove('tingle-enabled');
            b.style.top = '';
            if (top < 0) scrollTo(0, -top);
          }
          if (html.style.overflow === 'hidden') html.style.overflow = '';
          if (b.style.overflow === 'hidden') b.style.overflow = '';
        }
        var lastCheck = 0;
        function check() {
          var now = Date.now();
          if (now - lastCheck < 800 || now - lastChange < 1200 || !locked()) return;
          lastCheck = now;
          try { if (!somethingOpen()) release(); } catch (e) {}
        }
        if ('MutationObserver' in window) {
          var mark = function () { lastChange = Date.now(); };
          new MutationObserver(mark).observe(html, { attributes: true, attributeFilter: ['class', 'style'] });
          var watchBody = function () { if (document.body) new MutationObserver(mark).observe(document.body, { attributes: true, attributeFilter: ['class', 'style'] }); };
          if (document.body) watchBody(); else document.addEventListener('DOMContentLoaded', watchBody);
        }
        addEventListener('wheel', check, { passive: true });
        addEventListener('touchmove', check, { passive: true });
        addEventListener('keydown', function (e) {
          if (/^(ArrowDown|ArrowUp|PageDown|PageUp|Space| |Home|End)$/.test(e.key)) check();
        });
        addEventListener('pageshow', function () { lastChange = 0; lastCheck = 0; setTimeout(check, 300); });
        /* Back button: the page comes back as it was left. A search panel that
           was open keeps its inline position and the header its hidden menu
           row, over the page, while the lock classes are already removed. */
        addEventListener('pageshow', function (e) {
          if (!e.persisted || html.classList.contains('open-search')) return;
          var q = function (s) { return document.querySelectorAll(s); };
          q('.popup-search').forEach(function (el) { el.classList.remove('popup-search-show'); el.style.removeProperty('transform'); el.style.removeProperty('visibility'); });
          q('.overlay_search').forEach(function (el) { el.classList.remove('open'); el.style.removeProperty('opacity'); el.style.removeProperty('visibility'); });
          q('#search-form.open, .top-search-toggle.open').forEach(function (el) { el.classList.remove('open'); });
          q('.header-bottom__navigation').forEach(function (el) { el.style.removeProperty('opacity'); el.style.removeProperty('transition'); el.style.removeProperty('display'); });
          q('header.header').forEach(function (el) { el.style.removeProperty('margin-bottom'); });
        });
      })();
{% comment %}{% endcomment %}    </script>
{%- comment -%} Shipping estimate (cart page and drawer): the rates and copy the creator set in Theme settings > Shopping Cart, read by materia-experience.js. {%- endcomment -%}
<script id="materia-shipping-data" type="application/json">
  {
    "rates": {{ settings.shipping_estimate_rates | default: '' | json }},
    "delivery": {{ settings.shipping_estimate_delivery | default: '' | json }},
    "freePage": {{ settings.cart_page_free_shipping_minimum | default: '' | json }},
    "freeDrawer": {{ settings.free_shipping_minimum | default: '' | json }},
    "subtotal": {{ cart.total_price | default: 0 | json }},
    "currency": {{ cart.currency.iso_code | default: shop.currency | default: 'EUR' | json }},
    "country": {{ localization.country.iso_code | default: '' | json }},
    "text": {
      "choose": {{ 'general.cart.shipping.choose_country' | t | json }},
      "rateTo": {{ 'general.cart.shipping.rate_to' | t | json }},
      "free": {{ 'general.cart.shipping.free' | t | json }},
      "freeOver": {{ 'general.cart.shipping.free_over' | t | json }},
      "atCheckout": {{ 'general.cart.shipping.at_checkout' | t | json }}
    }
  }
</script>
{%- comment -%} Live preview of Theme settings: it only answers the builder's storelib:settings-change, which a visitor's page never gets. {%- endcomment -%}
{%- if request.design_mode -%}{% render 'theme-live' %}{%- endif -%}
{% render 'materia-guard' %}
    <script>
      /* Nothing below the footer takes room: fixed bars, popups, pixels and
         style carriers placed after it used to leave a white band. */
      (function () {
        var SKIP = { SCRIPT: 1, STYLE: 1, LINK: 1, TEMPLATE: 1, META: 1, NOSCRIPT: 1 };
        function collapse(el) {
          var s = el.style;
          s.setProperty('height', '0', 'important');
          s.setProperty('min-height', '0', 'important');
          s.setProperty('margin', '0', 'important');
          s.setProperty('padding', '0', 'important');
          s.setProperty('border', '0', 'important');
          s.setProperty('overflow', 'visible', 'important');
        }
        function run() {
          var footer = document.querySelector('footer.footer, .shopify-section-group-footer-group:last-of-type');
          if (!footer) return;
          var node = footer.closest('.shopify-section, [id^="shopify-section-"]') || footer;
          while (node && node !== document.body) {
            for (var el = node.nextElementSibling; el; el = el.nextElementSibling) {
              if (SKIP[el.tagName] || el.matches('footer, .shopify-section-group-footer-group') || el.querySelector('footer.footer')) continue;
              var cs = getComputedStyle(el);
              if (cs.display === 'none' || cs.position === 'fixed' || cs.position === 'absolute') continue;
              var box = el.getBoundingClientRect();
              if (box.height + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom) > 0.5) collapse(el);
            }
            node = node.parentElement;
          }
        }
        var timer;
        function later() { clearTimeout(timer); timer = setTimeout(run, 200); }
        if (document.readyState === 'complete') later(); else addEventListener('load', later);
        setTimeout(run, 2500);
        addEventListener('resize', later, { passive: true });
        document.addEventListener('shopify:section:load', later);
        document.addEventListener('storelib:section-load', later);
      })();
{% comment %}{% endcomment %}    </script>
    {%- render 'product-counter-data', product: product -%}
  </body>
</html>

</template>
