<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% liquid
  assign enable_rtl = false
  if settings.rtl
    assign enable_rtl = true
  endif
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank and lis_language_rtl contains iso_code
    assign enable_rtl = true
  endif
%}

<!doctype html>
<html class="no-js{% if enable_rtl %} rtl{% endif %}" lang="{{ request.locale.iso_code }}" dir="{% if enable_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'meta-tags' %}
    {%- render 'speed-optimization' -%}
    {{ content_for_header }}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Section isolation (`contain: style; isolation: isolate;`) is great
      on the live storefront but can break Shopify's section-picker
      preview iframes (preview generators don't always cooperate with
      `contain`). Skip it in design_mode so previews render cleanly.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
      {{ 'section-isolation.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}
    {% if settings.scroll_animation != 'none' %}
      {{ 'animation.css' | asset_url | stylesheet_tag }}
    {%- endif %}
    {% if enable_rtl %}{{ 'rtl.css' | asset_url | stylesheet_tag: preload: true }}{% endif %}
    {{ 'product-card.css' | asset_url | stylesheet_tag }}
    {%- render 'product-card-custom-actions' -%}
    {%- render 'cart-recommend-custom-button' -%}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    {{ 'judgeme-reviews.css' | asset_url | stylesheet_tag }}
    {% render 'font-variables' %}
    {% if request.design_mode %}
      {{ 'design-mode.css' | asset_url | stylesheet_tag: preload: true }}
    {% endif %}
    {% style %}
      {% for scheme in settings.color_schemes -%}
        {% # theme-check-disable UndefinedObject %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% # theme-check-disable UndefinedObject %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background }};
          --gradient-background: {{ scheme.settings.background }};
          --color-primary: {{ scheme.settings.primary_color }};
          --color-primary-rgb: {{ scheme.settings.primary_color.red }}, {{ scheme.settings.primary_color.green }}, {{ scheme.settings.primary_color.blue }};
          --color-text: {{ scheme.settings.text_color }};
          --color-text-rgb: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};
          --color-heading: {{ scheme.settings.heading_color }};
          --color-heading-rgb:{{ scheme.settings.heading_color.red }}, {{ scheme.settings.heading_color.green }}, {{ scheme.settings.heading_color.blue }};
          --color-link: {{ scheme.settings.heading_color }};
          --color-link-hover: {{ scheme.settings.primary_color }};
          --color-border: {{ scheme.settings.border_color }};
          --btn-primary-color: {{ scheme.settings.btn_primary_color | default: scheme.settings.background }};
          --btn-primary-hover-color: {{ scheme.settings.btn_primary_hover_color | default: scheme.settings.background }};
          --btn-primary-bg-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-bg-graident-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-hover-bg-color: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-primary-border-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-hover-border-color: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-primary-hover-bg-color-graident: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-color: {{ scheme.settings.btn_secondary_color | default: scheme.settings.heading_color }};
          --btn-secondary-bg-color: {{ scheme.settings.btn_secondary_background | default: scheme.settings.background }};
          --btn-secondary-border-color: {{ scheme.settings.btn_secondary_border | default: scheme.settings.heading_color }};
          --btn-secondary-hover-color: {{ scheme.settings.btn_secondary_hover_color | default: scheme.settings.background }};
          --btn-secondary-hover-bg-color: {{ scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-hover-border-color: {{ scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-bg: var(--btn-secondary-bg-color);
          --btn-secondary-bg-hover: var(--btn-secondary-hover-bg-color);
          --btn-secondary-color-hover: var(--btn-secondary-hover-color);
          --btn-outline-color: {{ scheme.settings.heading_color }};
          --btn-outline-border-color: {{ scheme.settings.border_color }};
          --btn-link-color: {{ scheme.settings.heading_color }};
          --btn-link-hover-color: {{ scheme.settings.primary_color }};
          --input-color: var(--color-text);
          --input-placeholder-color: rgba(var(--color-heading-rgb), 0.55);
          --input-bg: rgba({{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }}, 0.6);
        }
      {% endfor %}
      {{ scheme_classes | prepend: 'body' }} {
        color: var(--color-text);
        background-color: var(--color-background);
      }
      {%- if settings.storelib_link_hover != blank -%}
        a:hover { color: {{ settings.storelib_link_hover }}; }
      {%- endif -%}
      {%- if settings.storelib_input_border != blank -%}
        :root { --color-border: {{ settings.storelib_input_border }}; }
      {%- endif -%}
      {%- if settings.storelib_input_focus != blank -%}
        input:focus, textarea:focus, select:focus {
          outline: 2px solid {{ settings.storelib_input_focus }};
          outline-offset: 2px;
        }
      {%- endif -%}
      {%- if settings.storelib_input_radius != blank and settings.storelib_input_radius >= 0 -%}
        :root { --input-border-radius: {{ settings.storelib_input_radius }}px; }
      {%- endif -%}
      /* GLOBAL BUTTON TEXT GUARANTEE
         The scheme's "Text color" customiser MUST NOT control button
         label colour anywhere in the theme. Button labels are owned
         by the per-button colour customisers:
           - .btn-primary      → --btn-primary-color
           - .btn-outline      → --btn-outline-color
           - .btn-white        → --btn-outline-color
           - .btn-secondary    → --btn-secondary-color
         Without this rule, sections that pin `color` on a parent
         (e.g. cart sidebar, faq, info box) cascade into buttons via
         their inner `<span>` and override the button's own colour.
         These rules win because they have a class selector AND
         `!important`, and they walk into `*` so inner spans inherit. */
      .btn-primary,
      .btn-primary *,
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button),
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button) * {
        color: var(--btn-color, var(--btn-primary-color, #ffffff)) !important;
      }
      .btn-outline,
      .btn-outline *,
      .btn-white,
      .btn-white * {
        color: var(--btn-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      .btn-secondary,
      .btn-secondary * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart drawer "View Cart" button uses .viewcart on a .btn-outline.
         Pin its label to scheme secondary so the text colour follows the
         Button-secondary customiser, not the global Text colour. */
      .btn-outline.viewcart,
      .btn-outline.viewcart * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart "Checkout" button always uses primary. */
      .btn-checkout,
      .btn-checkout * {
        color: var(--btn-primary-color, #ffffff) !important;
      }
      :root {
        --border-color-base: #e5e5e5;
        --light-grey-color: #f5f5f5;
        {% if settings.enable_rounded %} --rounded-radius: {{ settings.rounded_corner }}px;{% endif %}
        --logo-width: {{ settings.mobile_logo_width | default: 82 }}px;
        --body-font-size: {{ settings.body_font_size }}px;
        --body-line-height: {{ settings.body_line_height | default: 1.7 }};
        --body-weight: {{ settings.body_font_weight }};
        --heading-font-scale: {{ settings.heading_font_scale | divided_by: 100.0 }};
        --heading-line-height: {{ settings.heading_line_height | default: 1.2 }};
        --heading-text-transform: {{ settings.heading_text_transform }};
        --heading-letter-spacing: {% if settings.heading_letter_spacing == 'negative' %}-0.034em{% else %}{{ settings.heading_letter_spacing }}{% endif %};
        --heading-weight: {{ settings.heading_font_weight }};
        --subheading-weight: {{ settings.subheading_font_weight }};
        --medium-font-weight: {{ settings.body_font_weight | default: 500 }};
        --btn-text-transform: {{ settings.btn_text_transform | default: 'none' }};
        {%- liquid
          assign _btn_shape = settings.btn_shape | default: 'rounded'
          assign _btn_radius_value = settings.btn_radius | default: 8
          if _btn_shape == 'pill'
            assign _btn_radius_value = 999
          elsif _btn_shape == 'square'
            assign _btn_radius_value = 0
          endif
        -%}
        --btn-radius: {{ _btn_radius_value }}px;
        --btn-font-size: {{ settings.btn_font_size | default: 14 }}px;
        --btn-padding-y: {{ settings.btn_padding_y | default: 14 }}px;
        --btn-padding-x: {{ settings.btn_padding_x | default: 26 }}px;
        --btn-font-weight: {{ settings.btn_font_weight | default: '500' }};
        --btn-border-width: {{ settings.btn_border_width | default: 1 }}px;
        --btn-letter-spacing: {{ settings.btn_letter_spacing | default: 0 }}px;
        --btn-anim-duration: {{ settings.btn_anim_duration | default: 300 }}ms;
        --btn-anim-ease: {{ settings.btn_anim_ease | default: 'cubic-bezier(0.2, 0.7, 0.2, 1)' }};
        --btn-shadow: {% if settings.btn_shadow_enabled %}0 4px 14px -4px rgba(0, 0, 0, 0.18){% else %}none{% endif %};
        --btn-shadow-hover: 0 10px 22px -8px rgba(0, 0, 0, 0.25);
        --icon-btn-size: {{ settings.icon_btn_size | default: 44 }}px;
        --input-height: 5rem;
        {% if settings.rounded_corner > 1 %}
        --input-padding: 1rem 2rem;
        {% else %}
        --input-padding: 1rem 1.5rem;
        {% endif %}
        --inputs-border-width: 1px;
        --input-color: var(--color-text);
        --input-border-radius: {{ settings.input_radius | default: 4 }}px;
        --search-input-radius: {{ settings.search_input_radius | default: 999 }}px;
        --pill-radius: {{ settings.pill_radius | default: 999 }}px;
        --card-radius: {{ settings.card_radius | default: 6 }}px;
        --container-gutter: {{ settings.container_gutter | default: 30 }}px;
        --grid-gap: {{ settings.grid_gap_mobile | default: 12 }}px;
        --border-width: {{ settings.border_width | default: 1 }}px;
        {%- case settings.card_shadow -%}
          {%- when 'soft' -%}--card-shadow: 0 2px 10px -2px rgba(0,0,0,0.06);
          {%- when 'medium' -%}--card-shadow: 0 8px 22px -6px rgba(0,0,0,0.12);
          {%- when 'large' -%}--card-shadow: 0 18px 40px -10px rgba(0,0,0,0.18);
          {%- else -%}--card-shadow: none;
        {%- endcase -%}
        --divider-style: {{ settings.divider_style | default: 'solid' }};
        --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
        --animation-delay-base: {{ settings.animation_delay | default: 0 }}ms;
        --search-popup-height: {{ settings.search_popup_height | default: 200 }}px;
        --input-font-size: {% if settings.body_font_size < 16 %}16{% else %}{{ settings.body_font_size }}{% endif %}px;
        --input-placeholder-color: rgba(var(--color-heading-rgb), 0.6);
        --page-width: {{ settings.page_width }}px;
        --page-width-value: {{ settings.page_width }};
        --fluid-container-width: {{ settings.fluid_container_width }}px;
        --fluid-container-width-value: {{ settings.fluid_container_width }}px;
        --color-white: #FFF;
        --color-dark: #111;
        --h0-size: calc(var(--heading-font-scale) * 4.8rem);
        --h1-size: calc(var(--heading-font-scale) * 4rem);
        --h2-size: calc(var(--heading-font-scale) * 3.6rem);
        --h3-size: calc(var(--heading-font-scale) * 3rem);
        --h4-size:  calc(var(--heading-font-scale) * 2.4rem);
        --h5-size: calc(var(--heading-font-scale) * 1.8rem);
        --h6-size: calc(var(--heading-font-scale) * 1.6rem);
        --transition: 0.4s cubic-bezier(.3, 1, .3, 1);
        --duration-short: 0.3s;
        --duration-long: 0.5s;
        --transition-popup: transform .6s cubic-bezier(.7,0,.2,1);
        --zoom-transform: scale(1.05);
        --overlay-bg: rgba(0, 0, 0, 0.50);
        --grey-color: #f5f5f5;
        --section-spacing: {{ settings.space_mobile }}px;
        --bs-gutter-x: 1.5rem;
        --shadow: 5px 0px 30px 0px rgba(0, 0, 0, 0.08);
        /* Badge color */
        --bages-radius: {{ settings.badges_rounded_corner }}px;
        --badges-font-weight: {{ settings.badges_font_weight | default: '600' }};
        --badges-letter-spacing: {{ settings.badges_letter_spacing | default: 1 }}px;
        --badges-transform: {% if settings.badges_uppercase == false %}none{% else %}uppercase{% endif %};
        --badges-max-stack: {{ settings.badges_stack_max | default: 4 }};
        --badges-padding-x: {{ settings.badges_padding_x | default: 10 }}px;
        --badges-padding-y: {{ settings.badges_padding_y | default: 5 }}px;
        --badges-offset-x: {{ settings.badges_offset_x | default: 8 }}px;
        --badges-offset-y: {{ settings.badges_offset_y | default: 8 }}px;
        --badges-gap: {{ settings.badges_gap | default: 6 }}px;
        --badges-shadow: {% if settings.badges_drop_shadow %}0 2px 6px rgba(0,0,0,.18){% else %}none{% endif %};
        --bages-sale-color: {{ settings.sale_color }};
        --bages-sale-bg-color: {{ settings.sale_background }};
        --bages-new-color: {{ settings.new_color }};
        --bages-new-bg-color: {{ settings.new_background }};
        --bages-pre-order-color: {{ settings.pre_order_color }};
        --bages-pre-order-bg-color: {{ settings.pre_order_background }};
        --bages-sold-out-color: {{ settings.sold_out_color }};
        --bages-sold-out-bg-color: {{ settings.sold_out_background }};
        --bages-custom-color: {{ settings.custom_badge_color }};
        --bages-custom-bg-color: {{ settings.custom_badge_background }};
        --responsive-rate: ((100vw - 575px) / (1600 - 575));
      }
      @media (min-width: 768px) {
        :root{
          --section-spacing: {{ settings.spacing_desktop }}px;
          --grid-gap: {{ settings.grid_gap_desktop | default: 20 }}px;
          --input-font-size: calc(var(--body-font-size) - 1px);
        }
      }
      @media (min-width: 1025px) {
        :root { --logo-width: {{ settings.desktop_logo_width | default: 82 }}px; }
      }
      @media (max-width: 1024.5px) {
        :root {
          --transition-popup: transform .35s cubic-bezier(.7,0,.2,1);
        }
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'popup.css' | asset_url | stylesheet_tag }}
    {% render 'theme-controls' %}
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'motion.min.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'utils.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer-safety.js' | asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if ({{ request.design_mode | json }} || window.Shopify?.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
{% comment %}{% endcomment %}    </script>
    {%- comment -%}
      Materia responsiveness guard. Stops any section, image, or embed from
      pushing the page wider than the screen on mobile (the horizontal-scroll /
      content-spilling-off-the-edge problem). overflow-x: clip is used on
      purpose instead of overflow-x: hidden: clip does NOT create a scroll
      container, so it never breaks the sticky / fixed header, the pill header,
      or position: sticky used anywhere else in the theme. overflow-y stays
      visible, so vertical page scrolling is completely unaffected.
    {%- endcomment -%}
    <style>
      html, body { overflow-x: clip; }
      body { max-width: 100%; }
      img, svg, video, iframe, canvas, table, pre,
      lite-youtube, model-viewer, .shopify-installments {
        max-width: 100%;
      }
      /* The page keeps its scrollbar space while a drawer, search or popup
         locks scrolling, so nothing shifts and the fixed header is not cut.
         The old compensation (body padding, header margin) is switched off. */
      html { scrollbar-gutter: stable; --mat-sbw: 0px !important; }
      body { padding-right: 0 !important; }
      /* Buttons press and release smoothly; a loading button keeps its size and
         swaps its label for the spinner with a fade instead of snapping. */
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]) {
        transition-property: background-color, color, border-color, box-shadow, opacity, transform;
        transition-duration: .2s; transition-timing-function: ease;
      }
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]).loading { transform: none; }
      body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]) :is(.hidden-on-load, .icon-load) { transition: opacity .2s ease; }
      /* Cart reservation timer (drawer and cart page): the label wraps, the
         time stays on its line, digits keep one width so it never jumps. */
      countdown-timer[data-minutes-left] { display: flex; flex-wrap: nowrap !important; align-items: baseline; gap: 8px; }
      countdown-timer[data-minutes-left] > :first-child { flex: 1 1 auto; min-width: 0; margin: 0 !important; }
      countdown-timer[data-minutes-left] .countdown-inner { flex: 0 0 auto; display: inline-flex; gap: .45em; white-space: nowrap; font-variant-numeric: tabular-nums; }
      countdown-timer[data-minutes-left] .countdown--container { display: inline-flex; align-items: baseline; margin: 0 !important; padding: 0 !important; }
      countdown-timer[data-minutes-left] .countdown--container::after { content: none !important; }
      countdown-timer[data-minutes-left] .countdown--container > :first-child { display: inline-block; min-width: 2ch; text-align: end; font-kerning: none; }
      @media (prefers-reduced-motion: reduce) {
        body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]) { transition: none; }
        body :where(.btn, .btn-primary, .btn-outline, .btn-white, .btn-secondary, [data-sl-button]):active { transform: none; }
      }
{% comment %}{% endcomment %}    </style>
  </head>
  <body
    class="gradient{% if settings.rounded_corner > 1 and settings.enable_rounded %} rounded-style{% endif %}{% if settings.action_after_add_cart == 'show_popup' %} minicart_type-popup{% endif %}{% if enable_rtl %} rtl{% endif %} {% if request.page_type == 'cart'%}template-cart{% endif %} {{ request.page_type }}"
    data-btn-style="{{ settings.btn_style | default: 'solid' }}"
    data-scroll-animation="{{ settings.scroll_animation | default: 'none' }}"
    data-btn-shape="{{ settings.btn_shape | default: 'rounded' }}"
    data-btn-hover="{{ settings.btn_hover_effect | default: 'fade' }}"
    data-badge-shape="{{ settings.badges_shape | default: 'pill' }}"
    data-badge-size="{{ settings.badges_size | default: 'medium' }}"
    data-badge-position="{{ settings.badges_position | default: 'top_start' }}"
    data-badge-anim="{{ settings.badges_animation | default: 'none' }}"
    data-menu-hover="{{ settings.menu_hover_style | default: 'underline' }}"
  >
    {%- liquid
      sections 'header-group'
    -%}

    {%- comment -%}
      Sticky-footer layout — page content always fills at least one
      viewport height. This stops the body's white background from
      showing as a gap below the footer when content is short, AND
      keeps the footer flush against the top of the mobile-nav bar
      on mobile (no awkward white strip in between).

      Skipped in design_mode so Shopify's section-picker preview
      iframes (which render in tiny viewports and may misbehave with
      flex column + 100dvh) get a clean baseline layout.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
      <style>
        html, body { min-height: 100%; }
        body {
          display: flex;
          flex-direction: column;
          min-height: 100vh;
          min-height: 100dvh;
        }
        body > #shopify-section-header-group,
        body > #shopify-section-sections--header-group,
        body > .shopify-section-header,
        body > #shopify-section-announcement-group,
        body > .shopify-section-group-header-group { flex: 0 0 auto; }
        main#MainContent { flex: 1 0 auto; }
        body > #shopify-section-footer-group,
        body > #shopify-section-sections--footer-group,
        body > .shopify-section-group-footer-group { flex: 0 0 auto; }
{% comment %}{% endcomment %}      </style>
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {%- liquid
      sections 'overlay-group'
      section 'mobile-navigation-bar'
      section 'custom-colors'
    -%}
    {%- render 'top-search' -%}
    {%- render 'minicart' -%}
    {%- comment -%} Invisible copy the builder redraws with unsaved settings; the drawer reads it in the editor. {%- endcomment -%}
    {%- section 'cart-drawer-live' -%}
    {%- render 'editor-live-images' -%}
    {%- render 'scripts-tag' -%}
    {%- render 'sprite-svg' -%}
    {%- render 'content-bottom' -%}
    {%- render 'smooth-media-load' -%}

    {%- if settings.social_floating_enable -%}
      {%- liquid
        assign fb_side = settings.social_floating_side | default: 'left'
        assign fb_vis  = settings.social_floating_visibility | default: 'desktop_only'
      -%}
      <aside class="social-floating-bar social-floating-bar--{{ fb_side }} social-floating-bar--{{ fb_vis }}" aria-label="{{ 'accessibility.social_media' | t }}">
        {%- render 'social-icons' -%}
      </aside>
      {%- style -%}
        .social-floating-bar {
          position: fixed; top: 50%; transform: translateY(-50%); z-index: 90;
          padding: 8px;
          border-radius: 14px;
          background: rgba(255,255,255,0.94);
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
          box-shadow: 0 8px 28px -10px rgba(0,0,0,.16);
          border: 1px solid rgba(0,0,0,.06);
        }
        .social-floating-bar--left  { left: 12px; }
        .social-floating-bar--right { right: 12px; }
        .social-floating-bar .list-social {
          flex-direction: column;
          --col-gap: 8px;
        }
        .social-floating-bar--mobile_only { display: none; }
        @media (min-width: 1025px) {
          .social-floating-bar--mobile_only { display: none !important; }
        }
        @media (max-width: 1024.98px) {
          .social-floating-bar--desktop_only { display: none !important; }
          .social-floating-bar--mobile_only  { display: block; }
        }
      {%- endstyle -%}
    {%- endif -%}

    {%- comment -%}
      Register content sections with the shared, single-run reveal controller.
      Editor previews and content already in view stay visible. The controller
      owns observation and completion so section insertion cannot restart an
      animation that has already finished.
    {%- endcomment -%}
    {%- if settings.scroll_animation != 'none' and settings.scroll_animation != blank -%}
      {%- assign _anim_dur = settings.animation_duration | default: 700 -%}
      {%- assign _anim_dur_short = _anim_dur | times: 0.7 | round -%}
      {%- assign _anim_delay = settings.animation_delay | default: 0 -%}
      <style>
        :root {
          /* Wire the user's Animations & motion settings to the keyframe vars used by animation.css */
          --duration-long: {{ _anim_dur_short }}ms;
          --duration-extra-long: {{ _anim_dur }}ms;
          --duration-extra-longer: {{ _anim_dur }}ms;
          --animation-duration: {{ _anim_dur }}ms;
          --animation-delay-base: {{ _anim_delay }}ms;
          --ti-reveal-ease: cubic-bezier(0.22, 0.61, 0.36, 1); /* smooth out-cubic */
          --ti-reveal-ease-soft: cubic-bezier(0.16, 1, 0.3, 1);  /* very soft, late-arrival */
        }

        /* ===== Theme-wide section reveal =================================
           Animates only `opacity` and `transform`. NEVER touches color,
           background, border, or any --color-* variable — color schemes
           are completely isolated from this animation system.
           Driven by the user's animation_duration / animation_delay.    */

        /* Default state: VISIBLE. Critically important — Shopify section
           picker preview thumbnails are rendered in a no-JS / partial-JS
           environment. If the default state were opacity:0, every section
           thumbnail would be blank.

           The hidden state and animation only kick in when JS adds the
           `.scroll-trigger--armed` marker. Without armed, content is fully
           visible regardless of whether `--offscreen` is set. */
        .scroll-trigger.ti-section-reveal {
          opacity: 1;
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.scroll-trigger--offscreen {
          opacity: 0;
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.scroll-trigger--offscreen.slide_in {
          transform: translate3d(0, 14px, 0);
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.scroll-trigger--offscreen.zoom_in {
          transform: scale(0.985);
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.scroll-trigger--offscreen.subtle_rise {
          transform: translate3d(0, 8px, 0);
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.scroll-trigger--offscreen.cinematic {
          transform: scale(0.992);
        }

        /* Reveal — default to fade_in keyframe when no flavour class matches.
           Gated behind --armed so previews / no-JS render stays visible. */
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed:not(.scroll-trigger--offscreen) {
          animation: tiSectionFadeIn var(--animation-duration, 700ms) var(--ti-reveal-ease) both;
          animation-delay: var(--animation-delay-base, 0ms) !important;
          will-change: opacity, transform;
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.slide_in:not(.scroll-trigger--offscreen) {
          animation-name: tiSectionSlideIn;
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.zoom_in:not(.scroll-trigger--offscreen) {
          animation-name: tiSectionZoomIn;
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.subtle_rise:not(.scroll-trigger--offscreen) {
          animation-name: tiSectionSubtleRise;
          animation-timing-function: var(--ti-reveal-ease-soft);
        }
        .scroll-trigger.ti-section-reveal.scroll-trigger--armed.cinematic:not(.scroll-trigger--offscreen) {
          animation-name: tiSectionCinematic;
          animation-timing-function: var(--ti-reveal-ease-soft);
          /* Slow it down by ~25% so it feels filmic */
          animation-duration: calc(var(--animation-duration, 700ms) * 1.25);
        }
        .scroll-trigger.ti-section-reveal[data-animation-done],
        .scroll-trigger.ti-section-reveal[animation-end] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
          will-change: auto;
        }

        @keyframes tiSectionFadeIn {
          from { opacity: 0; }
          to   { opacity: 1; }
        }
        @keyframes tiSectionSlideIn {
          from { opacity: 0; transform: translate3d(0, 14px, 0); }
          to   { opacity: 1; transform: translate3d(0, 0, 0); }
        }
        @keyframes tiSectionZoomIn {
          from { opacity: 0; transform: scale(0.985); }
          to   { opacity: 1; transform: scale(1); }
        }
        @keyframes tiSectionSubtleRise {
          from { opacity: 0; transform: translate3d(0, 8px, 0); }
          to   { opacity: 1; transform: translate3d(0, 0, 0); }
        }
        @keyframes tiSectionCinematic {
          from { opacity: 0; transform: scale(0.992); }
          to   { opacity: 1; transform: scale(1); }
        }

        @media (prefers-reduced-motion: reduce) {
          .scroll-trigger.ti-section-reveal,
          .scroll-trigger.ti-section-reveal.scroll-trigger--offscreen {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
          }
        }
{% comment %}{% endcomment %}      </style>
      <script>
        (function() {
          var anim = {{ settings.scroll_animation | json }};
          if (!anim || anim === 'none') return;

          if (document.documentElement.classList.contains('shopify-design-mode') || window.Shopify?.designMode) return;

          // Skip these — chrome/utility sections that should never animate-in.
          var SKIP_PATTERN = /(header|footer|announcement|top[-_]?bar|popup|cookie|gdpr|consent|back[-_]?to[-_]?top|mobile[-_]?navigation|mobile[-_]?nav[-_]?bar|password|age[-_]?verifier|preloader|search[-_]?popup|social[-_]?floating|overlay[-_]?group|header[-_]?group|footer[-_]?group)/i;

          function shouldSkip(s) {
            if (!s) return true;
            if (s.dataset.noReveal === '1') return true;
            if (s.dataset.tiRevealInit === '1') return true;
            if (s.classList.contains('scroll-trigger')) return true;
            if (s.querySelector('[data-ti-no-reveal]')) return true;
            var hay = (s.id || '') + ' ' + (s.className || '');
            // For static/global sections (id starts with shopify-section-sections--)
            // also catch theme-template chrome (e.g. main-* are fine, but the wrappers above are not).
            if (SKIP_PATTERN.test(hay)) return true;
            var main = document.getElementById('MainContent') || document.querySelector('main');
            var first = main && main.querySelector(':scope > .shopify-section');
            if (first && s === first) return true;
            return false;
          }

          function applyReveal(root) {
            root = root || document;
            var sections = Array.from(root.querySelectorAll('.shopify-section'));
            if (root.matches && root.matches('.shopify-section')) sections.unshift(root);
            sections.forEach(function(s) {
              if (shouldSkip(s)) return;
              s.classList.add('scroll-trigger', 'ti-section-reveal', anim);
              s.dataset.tiRevealInit = '1';
            });
            if (typeof initializeScrollAnimationTrigger === 'function') initializeScrollAnimationTrigger(root);
          }

          function boot() {
            applyReveal(document);

            // Observe future section insertions (theme editor, AJAX, etc.).
            if ('MutationObserver' in window) {
              var mo = new MutationObserver(function(muts) {
                var hit = false;
                for (var i = 0; i < muts.length; i++) {
                  var added = muts[i].addedNodes;
                  for (var j = 0; j < added.length; j++) {
                    var n = added[j];
                    if (n && n.nodeType === 1 && (n.classList && n.classList.contains('shopify-section') || (n.querySelector && n.querySelector('.shopify-section')))) {
                      hit = true; break;
                    }
                  }
                  if (hit) break;
                }
                if (hit) applyReveal(document);
              });
              mo.observe(document.body, { childList: true, subtree: true });
            }

            // Theme editor: re-apply on section load/reorder/select.
            if (window.Shopify && window.Shopify.designMode) {
              document.addEventListener('shopify:section:load', function(e) {
                applyReveal(e.target.parentNode || document);
              });
              document.addEventListener('shopify:section:reorder', function() {
                applyReveal(document);
              });
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
          } else {
            boot();
          }
        })();
{% comment %}{% endcomment %}      </script>
    {%- endif -%}
{% render 'theme-live' %}
{% render 'materia-guard' %}
  </body>
</html>

</template>