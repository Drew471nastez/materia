<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% liquid
  assign enable_rtl = false
  if settings.rtl
    assign enable_rtl = true
  endif
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank and iso_code != blank and lis_language_rtl contains iso_code
    assign enable_rtl = true
  endif
%}

<!doctype html>
<html class="no-js{% if enable_rtl %} rtl{% endif %}{% if request.design_mode %} shopify-design-mode sl-calm{% endif %}" lang="{{ request.locale.iso_code }}" dir="{% if enable_rtl %}rtl{% else %}ltr{% endif %}"{% if settings.theme_button_priority == false %} data-button-priority="off"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- render 'section-link-capture' -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% render 'meta-tags' %}
    {%- comment -%} Performance settings: preconnects, page-to-page fade, speculation rules (prerender and prefetch), motion and third-party handling. {%- endcomment -%}
    {%- render 'speed-optimization' -%}
    {%- comment -%}
      theme.js imports cart-components.js, which the browser would only find
      after theme.js has downloaded and parsed. Start it now, resolved from
      theme.js's own address exactly as the import is, at low priority so it
      never competes with the stylesheets or the first image.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var l = document.createElement('link');
          l.rel = 'modulepreload';
          l.href = new URL('./cart-components.js', new URL({{ 'theme.js' | asset_url | json }}, location.href)).href;
          l.fetchPriority = 'low';
          document.head.appendChild(l);
        } catch (e) {}
      })();
{% comment %}{% endcomment %}    </script>
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Section isolation (`contain: style; isolation: isolate;`) is great
      on the live storefront but can break Shopify's section-picker
      preview iframes (preview generators don't always cooperate with
      `contain`). Skip it in design_mode so previews render cleanly.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
      {{ 'section-isolation.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}
    {% if settings.scroll_animation != 'none' %}
      {{ 'animation.css' | asset_url | stylesheet_tag }}
    {%- endif %}
    {% if enable_rtl %}{{ 'rtl.css' | asset_url | stylesheet_tag: preload: true }}{% endif %}
    {{ 'product-card.css' | asset_url | stylesheet_tag }}
    {%- render 'product-card-custom-actions' -%}
    {%- render 'cart-recommend-custom-button' -%}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Review widget styles: not needed for the first paint, so they no longer block it. {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'judgeme-reviews.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'judgeme-reviews.css' | asset_url | stylesheet_tag }}</noscript>
    {% render 'font-variables' %}
    {% if request.design_mode %}
      {{ 'design-mode.css' | asset_url | stylesheet_tag: preload: true }}
      {%- comment -%}
        Calm reloads in the builder. A setting that cannot be shown live (show
        currency code, a font file, a product card option) makes the builder
        draw the page again; that redraw must not look like a fresh visit.
        Until the page has loaded, every CSS animation sits in its end state
        (a marquee or loop in its first) and nothing eases; then entrance
        animations are finished and loops start from their first frame, so
        nothing jumps. Design mode is marked on <html> and <body> from the
        server, before any script, so sections that skip their reveal in the
        editor (they look at <body>) never hide their content first.
      {%- endcomment -%}
      <style>
        html.sl-calm *, html.sl-calm *::before, html.sl-calm *::after { animation-duration: 0s !important; animation-delay: 0s !important; transition: none !important; }
        html.shopify-design-mode .media-fade-run { animation: none !important; }
        html.shopify-design-mode .preload-page { display: none !important; }
{% comment %}{% endcomment %}      </style>
      <script>
        (function () {
          var html = document.documentElement;
          var done = false;
          function settle() {
            if (done) return;
            done = true;
            html.classList.remove('sl-calm');
            if (!document.getAnimations) return;
            try {
              var list = document.getAnimations();
              for (var i = 0; i < list.length; i++) {
                var a = list[i];
                if (!a.animationName) continue;
                try {
                  if (a.effect && a.effect.getComputedTiming().iterations === Infinity) a.currentTime = 0;
                  else a.finish();
                } catch (e) {}
              }
            } catch (e) {}
          }
          function soon() { requestAnimationFrame(function () { requestAnimationFrame(settle); }); }
          if (document.readyState === 'complete') soon(); else addEventListener('load', soon, { once: true });
          setTimeout(settle, 3500);
        })();
{% comment %}{% endcomment %}      </script>
    {% endif %}
    {% style %}
      {% for scheme in settings.color_schemes -%}
        {% # theme-check-disable UndefinedObject %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% # theme-check-disable UndefinedObject %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background }};
          --gradient-background: {{ scheme.settings.background }};
          --color-primary: {{ scheme.settings.primary_color }};
          --color-primary-rgb: {{ scheme.settings.primary_color.red }}, {{ scheme.settings.primary_color.green }}, {{ scheme.settings.primary_color.blue }};
          --color-text: {{ scheme.settings.text_color }};
          --color-text-rgb: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};
          --color-heading: {{ scheme.settings.heading_color }};
          --color-heading-rgb:{{ scheme.settings.heading_color.red }}, {{ scheme.settings.heading_color.green }}, {{ scheme.settings.heading_color.blue }};
          --color-link: {{ scheme.settings.heading_color }};
          --color-link-hover: {{ scheme.settings.primary_color }};
          --color-border: {{ scheme.settings.border_color }};
          --badge-background: {% render 'scheme-color', color: scheme.settings.badge_background, fallback: 'var(--btn-primary-bg-color)' %};
          --badge-text: {% render 'scheme-color', color: scheme.settings.badge_text, fallback: 'var(--btn-primary-color)' %};
          --btn-primary-color: {{ scheme.settings.btn_primary_color | default: scheme.settings.background }};
          --btn-primary-hover-color: {{ scheme.settings.btn_primary_hover_color | default: scheme.settings.background }};
          --btn-primary-bg-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-bg-graident-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-hover-bg-color: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-primary-border-color: {{ scheme.settings.btn_primary_border_color | default: scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-hover-border-color: {{ scheme.settings.btn_primary_hover_border_color | default: scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-primary-hover-bg-color-graident: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-color: {{ scheme.settings.btn_secondary_color | default: scheme.settings.heading_color }};
          --btn-secondary-bg-color: {{ scheme.settings.btn_secondary_background | default: scheme.settings.background }};
          --btn-secondary-border-color: {{ scheme.settings.btn_secondary_border | default: scheme.settings.heading_color }};
          --btn-secondary-hover-color: {{ scheme.settings.btn_secondary_hover_color | default: scheme.settings.background }};
          --btn-secondary-hover-bg-color: {{ scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-hover-border-color: {{ scheme.settings.btn_secondary_hover_border_color | default: scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-bg: var(--btn-secondary-bg-color);
          --btn-secondary-bg-hover: var(--btn-secondary-hover-bg-color);
          --btn-secondary-color-hover: var(--btn-secondary-hover-color);
          --btn-outline-color: {{ scheme.settings.heading_color }};
          --btn-outline-border-color: {{ scheme.settings.border_color }};
          --btn-link-color: {{ scheme.settings.heading_color }};
          --btn-link-hover-color: {{ scheme.settings.primary_color }};
          --input-color: var(--color-text);
          --input-placeholder-color: rgba(var(--color-heading-rgb), 0.55);
          --input-bg: rgba({{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }}, 0.6);
        }
      {% endfor %}
      {{ scheme_classes | prepend: 'body' }} {
        color: var(--color-text);
        background-color: var(--color-background);
      }
      {%- if settings.storelib_link_hover != blank -%}
        a:hover { color: {{ settings.storelib_link_hover }}; }
      {%- endif -%}
      {%- comment -%} Forms and fields: these follow the colour scheme unless picked. {%- endcomment -%}
      {%- if settings.storelib_input_border != blank -%}
        :root { --input-border-color: {{ settings.storelib_input_border }}; }
      {%- endif -%}
      {%- if settings.field_background != blank and settings.field_background.alpha != 0 and settings.field_background != 'transparent' and settings.field_background != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --input-bg: {{ settings.field_background }}; }
      {%- endif -%}
      {%- comment -%}
        Field text is never written over every scheme as it is: a light Text
        colour on a light scheme was white on white. field-colors gives each
        scheme its readable field text, placeholder and Field style.
      {%- endcomment -%}
      {%- render 'field-colors' -%}
      {%- render 'quantity-style' -%}
      {%- if settings.storelib_input_focus != blank -%}
        :root, body, [class*="color-"] { --input-focus-color: {{ settings.storelib_input_focus }}; }
        input:focus, textarea:focus, select:focus {
          outline: 2px solid {{ settings.storelib_input_focus }};
          outline-offset: 2px;
        }
      {%- endif -%}
      {%- if settings.storelib_input_radius != blank and settings.storelib_input_radius >= 0 -%}
        html:root { --input-border-radius: {{ settings.storelib_input_radius }}px; }
      {%- endif -%}
      {%- comment -%} Buttons on hover: one colour for every button when picked, written over each scheme's own hover colours. {%- endcomment -%}
      {%- if settings.storelib_button_hover_bg != blank and settings.storelib_button_hover_bg.alpha != 0 and settings.storelib_button_hover_bg != 'transparent' and settings.storelib_button_hover_bg != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-bg-color: {{ settings.storelib_button_hover_bg }}; --btn-primary-hover-bg-color-graident: {{ settings.storelib_button_hover_bg }}; --btn-secondary-hover-bg-color: {{ settings.storelib_button_hover_bg }}; }
      {%- endif -%}
      {%- if settings.storelib_button_hover_text != blank and settings.storelib_button_hover_text.alpha != 0 and settings.storelib_button_hover_text != 'transparent' and settings.storelib_button_hover_text != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-color: {{ settings.storelib_button_hover_text }}; --btn-secondary-hover-color: {{ settings.storelib_button_hover_text }}; --btn-link-hover-color: {{ settings.storelib_button_hover_text }}; }
      {%- endif -%}
      {%- if settings.storelib_button_hover_border != blank and settings.storelib_button_hover_border.alpha != 0 and settings.storelib_button_hover_border != 'transparent' and settings.storelib_button_hover_border != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-border-color: {{ settings.storelib_button_hover_border }}; --btn-secondary-hover-border-color: {{ settings.storelib_button_hover_border }}; }
      {%- endif -%}
      /* GLOBAL BUTTON TEXT GUARANTEE
         The scheme's "Text color" customiser MUST NOT control button
         label colour anywhere in the theme. Button labels are owned
         by the per-button colour customisers:
           - .btn-primary      → --btn-primary-color
           - .btn-outline      → --btn-outline-color
           - .btn-white        → --btn-outline-color
           - .btn-secondary    → --btn-secondary-color
         Without this rule, sections that pin `color` on a parent
         (e.g. cart sidebar, faq, info box) cascade into buttons via
         their inner `<span>` and override the button's own colour.
         These rules win because they have a class selector AND
         `!important`, and they walk into `*` so inner spans inherit. */
      .btn-primary,
      .btn-primary *,
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button),
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button) * {
        color: var(--btn-color, var(--btn-primary-color, #ffffff)) !important;
      }
      .btn-outline,
      .btn-outline *,
      .btn-white,
      .btn-white * {
        color: var(--btn-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      .btn-secondary,
      .btn-secondary * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart drawer "View Cart" button uses .viewcart on a .btn-outline.
         Pin its label to scheme secondary so the text colour follows the
         Button-secondary customiser, not the global Text colour. */
      .btn-outline.viewcart,
      .btn-outline.viewcart * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart "Checkout" button always uses primary. */
      .btn-checkout,
      .btn-checkout * {
        color: var(--btn-primary-color, #ffffff) !important;
      }
      :root {
        --border-color-base: #e5e5e5;
        --light-grey-color: #f5f5f5;
        {% if settings.enable_rounded %} --rounded-radius: {{ settings.rounded_corner }}px;{% endif %}
        --body-font-size: {{ settings.body_font_size }}px;
        --body-line-height: {{ settings.body_line_height | default: 1.7 }};
        --body-weight: {{ settings.body_font_weight }};
        --heading-font-scale: {{ settings.heading_font_scale | divided_by: 100.0 }};
        --heading-line-height: {{ settings.heading_line_height | default: 1.2 }};
        --heading-text-transform: {{ settings.heading_text_transform }};
        --heading-letter-spacing: {% if settings.heading_letter_spacing == 'negative' %}-0.034em{% else %}{{ settings.heading_letter_spacing }}{% endif %};
        --heading-weight: {{ settings.heading_font_weight }};
        --subheading-weight: {{ settings.subheading_font_weight }};
        --medium-font-weight: {{ settings.body_font_weight | default: 500 }};
        --btn-text-transform: {{ settings.btn_text_transform | default: 'none' }};
        {%- liquid
          assign _btn_shape = settings.btn_shape | default: 'rounded'
          assign _btn_radius_value = settings.btn_radius | default: 8
          if _btn_shape == 'pill'
            assign _btn_radius_value = 999
          elsif _btn_shape == 'square'
            assign _btn_radius_value = 0
          endif
        -%}
        --btn-radius: {{ _btn_radius_value }}px;
        --btn-font-size: {{ settings.btn_font_size | default: 14 }}px;
        --btn-padding-y: {{ settings.btn_padding_y | default: 14 }}px;
        --btn-padding-x: {{ settings.btn_padding_x | default: 26 }}px;
        --btn-font-weight: {{ settings.btn_font_weight | default: '500' }};
        --btn-border-width: {{ settings.btn_border_width | default: 1 }}px;
        --btn-letter-spacing: {{ settings.btn_letter_spacing | default: 0 }}px;
        --btn-anim-duration: {{ settings.btn_anim_duration | default: 300 }}ms;
        --btn-anim-ease: {{ settings.btn_anim_ease | default: 'cubic-bezier(0.2, 0.7, 0.2, 1)' }};
        --btn-shadow: {% if settings.btn_shadow_enabled %}0 4px 14px -4px rgba(0, 0, 0, 0.18){% else %}none{% endif %};
        --btn-shadow-hover: 0 10px 22px -8px rgba(0, 0, 0, 0.25);
        --icon-btn-size: {{ settings.icon_btn_size | default: 44 }}px;
        --input-height: {{ settings.field_height | default: 50 }}px;
        --input-padding: 1rem {{ settings.field_padding_x | default: 16 }}px;
        --inputs-border-width: {{ settings.field_border_width | default: 1 }}px;
        --input-label-weight: var(--body-weight, 400);
        --input-color: var(--color-text);
        --input-border-radius: {{ settings.input_radius | default: 4 }}px;
        --search-input-radius: {{ settings.search_input_radius | default: 999 }}px;
        --pill-radius: {{ settings.pill_radius | default: 999 }}px;
        --card-radius: {{ settings.card_radius | default: 6 }}px;
        --container-gutter: {{ settings.container_gutter | default: 30 }}px;
        --grid-gap: var(--sl-live-grid-gap-mobile, {{ settings.grid_gap_mobile | default: 12 }}px);
        --border-width: {{ settings.border_width | default: 1 }}px;
        {%- case settings.card_shadow -%}
          {%- when 'soft' -%}--card-shadow: 0 2px 10px -2px rgba(0,0,0,0.06);
          {%- when 'medium' -%}--card-shadow: 0 8px 22px -6px rgba(0,0,0,0.12);
          {%- when 'large' -%}--card-shadow: 0 18px 40px -10px rgba(0,0,0,0.18);
          {%- else -%}--card-shadow: none;
        {%- endcase -%}
        --divider-style: {{ settings.divider_style | default: 'solid' }};
        --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
        --animation-delay-base: {{ settings.animation_delay | default: 0 }}ms;
        --input-font-size: var(--body-font-size, 16px);
        --input-placeholder-color: rgba(var(--color-heading-rgb), 0.6);
        --page-width: {{ settings.page_width }}px;
        --fluid-container-width: {{ settings.fluid_container_width }}px;
        --color-white: #FFF;
        --color-dark: #111;
        --h0-size: calc(var(--heading-font-scale) * 4.8rem);
        --h1-size: calc(var(--heading-font-scale) * 4rem);
        --h2-size: calc(var(--heading-font-scale) * 3.6rem);
        --h3-size: calc(var(--heading-font-scale) * 3rem);
        --h4-size:  calc(var(--heading-font-scale) * 2.4rem);
        --h5-size: calc(var(--heading-font-scale) * 1.8rem);
        --h6-size: calc(var(--heading-font-scale) * 1.6rem);
        --transition: 0.4s cubic-bezier(.3, 1, .3, 1);
        --duration-short: 0.3s;
        --duration-long: 0.5s;
        --transition-popup: transform .6s cubic-bezier(.7,0,.2,1);
        --zoom-transform: scale(1.05);
        --overlay-bg: rgba(0, 0, 0, 0.50);
        --grey-color: #f5f5f5;
        {%- comment -%} The --sl-live-* values are set only by the builder's live preview (snippets/theme-live), so a phone value never overrides the desktop one. {%- endcomment -%}
        --section-spacing: var(--sl-live-space-mobile, {{ settings.space_mobile }}px);
        --bs-gutter-x: 1.5rem;
        --shadow: 5px 0px 30px 0px rgba(0, 0, 0, 0.08);
        /* Badge color */
        --bages-radius: {{ settings.badges_rounded_corner }}px;
        --badges-font-weight: {{ settings.badges_font_weight | default: '600' }};
        --badges-letter-spacing: {{ settings.badges_letter_spacing | default: 1 }}px;
        --badges-transform: {% if settings.badges_uppercase == false %}none{% else %}uppercase{% endif %};
        --badges-padding-x: {{ settings.badges_padding_x | default: 10 }}px;
        --badges-padding-y: {{ settings.badges_padding_y | default: 5 }}px;
        --badges-offset-x: {{ settings.badges_offset_x | default: 8 }}px;
        --badges-offset-y: {{ settings.badges_offset_y | default: 8 }}px;
        --badges-gap: {{ settings.badges_gap | default: 6 }}px;
        --badges-shadow: {% if settings.badges_drop_shadow %}0 2px 6px rgba(0,0,0,.18){% else %}none{% endif %};
        --bages-sale-color: {% render 'scheme-color', color: settings.sale_color, fallback: 'var(--badge-text)' %};
        --bages-sale-bg-color: {% render 'scheme-color', color: settings.sale_background, fallback: 'var(--badge-background)' %};
        --bages-new-color: {% render 'scheme-color', color: settings.new_color, fallback: 'var(--badge-text)' %};
        --bages-new-bg-color: {% render 'scheme-color', color: settings.new_background, fallback: 'var(--badge-background)' %};
        --bages-pre-order-color: {% render 'scheme-color', color: settings.pre_order_color, fallback: 'var(--badge-text)' %};
        --bages-pre-order-bg-color: {% render 'scheme-color', color: settings.pre_order_background, fallback: 'var(--badge-background)' %};
        --bages-sold-out-color: {% render 'scheme-color', color: settings.sold_out_color, fallback: 'var(--badge-text)' %};
        --bages-sold-out-bg-color: {% render 'scheme-color', color: settings.sold_out_background, fallback: 'var(--badge-background)' %};
        --bages-custom-color: {% render 'scheme-color', color: settings.custom_badge_color, fallback: 'var(--badge-text)' %};
        --bages-custom-bg-color: {% render 'scheme-color', color: settings.custom_badge_background, fallback: 'var(--badge-background)' %};
        --responsive-rate: ((100vw - 575px) / (1600 - 575));
      }
      @media (min-width: 768px) {
        :root{
          --section-spacing: var(--sl-live-space-desktop, {{ settings.spacing_desktop }}px);
          --grid-gap: var(--sl-live-grid-gap-desktop, {{ settings.grid_gap_desktop | default: 20 }}px);
        }
      }
      @media (max-width: 1024.5px) {
        :root {
          --transition-popup: transform .35s cubic-bezier(.7,0,.2,1);
        }
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- comment -%}
      Popup and dialog styles: every one of them opens after the page has
      shown (quick view, login, newsletter), so they never hold the first paint.
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'popup.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'popup.css' | asset_url | stylesheet_tag }}</noscript>
    {%- comment -%}
      The header menu and the cart drawer link their stylesheets from the body,
      so the browser met them only halfway down the page, and the scripts and
      the page's ready event waited on them. Requested here, with the others;
      the drawer's at low priority so the first screen comes first.
    {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'navigation.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'minicart.css' | asset_url }}" fetchpriority="low">
    <link rel="preload" as="style" href="{{ 'materia-experience.css' | asset_url }}" fetchpriority="low">
    {% render 'theme-controls' %}
    {%- render 'theme-scale' -%}
    {{ 'theme-button-contract.css' | asset_url | stylesheet_tag }}
    {%- comment -%}
      Discover first-paint styles and deferred modules before app-injected head
      scripts. Keep app initialization before the theme's executable scripts.
      Product styles still render at their original component boundary; these
      hints remove the header/body discovery waterfall without duplicate CSS.
    {%- endcomment -%}
    <link rel="modulepreload" href="{{ 'theme.js' | asset_url }}" fetchpriority="low">
    {%- if request.page_type == 'product' -%}
      <link rel="preload" as="style" href="{{ 'main-product.css' | asset_url }}">
      <link rel="preload" as="style" href="{{ 'product-page-ui.css' | asset_url }}">
    {%- endif -%}
    {{ content_for_header }}
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
