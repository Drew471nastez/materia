<template compat="shopify">
<script src="{{ 'live-r7-connect.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Newsletter Split: a picture on one side and, on the other,
  the heading and subheading blocks, the email sign-up and a short note. The
  two sides sit next to each other from 768px and stack on a phone, picture
  first. The sign-up is the same as the Newsletter section's: the store's
  customer form with data-storelib-form="subscribe", sent once by
  materia-forms.js, which sets data-state (sending, done, error) on the form
  and writes the section's own words into its messages. Styles:
  r7-connect.css, reading the --r7n-* variables on the root
  (snippets/r7-connect-vars); live-r7-connect.js applies the builder's live
  edits. A newly picked picture arrives with the builder's redraw.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign header_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign header_count = header_blocks.size | plus: sub_blocks.size
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign own_shape = false
  if st.use_theme_button == false
    assign own_shape = true
  endif
  assign btn_style = st.button_style | default: 'primary'
  assign btn_label = st.btn_text | strip
  if btn_label == blank
    assign btn_label = 'newsletter.button_label' | t
  endif
  assign email_label = st.email_label | strip
  if email_label == blank
    assign email_label = st.email_placeholder | default: 'Email'
  endif
  assign success_ms = st.success_duration | default: 5 | times: 1000
  assign image_alt = st.image_alt | default: st.image.alt | default: ''
-%}
<style>
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }},#shopify-section-{{ sid }}>.section,#shopify-section-{{ sid }}>section,#shopify-section-{{ sid }}>div,#shopify-section-{{ sid }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ sid }}+.shopify-section,#shopify-section-{{ sid }}+section,.shopify-section+#shopify-section-{{ sid }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ sid }}{isolation:isolate;position:relative;margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}
  @media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}
{% comment %}{% endcomment %}</style>
{%- comment -%} The builder also gets the styles inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'r7-connect.css' | inline_asset_content }}</style>{%- endif %}
{{ 'r7-connect.css' | asset_url | stylesheet_tag }}
{%- capture r7n_vars -%}{% render 'r7-connect-vars', section: section, kind: 'split' %}{%- endcapture -%}
{%- capture btn_vars -%}
  {%- if st.enable_custom_style -%}{% render 'button-overrides', bg: st.button_bg, text: st.button_text, border: st.button_border, hover_bg: st.button_bg_hover, hover_text: st.button_text_hover %}{%- endif -%}
  {%- if own_shape -%}--mb-radius:{{ st.button_radius | default: 4 }}px;--mb-font-size:{{ st.button_size | default: 15 }}px;--mb-padding-x:{{ st.button_pad_x | default: 28 }}px;--mb-padding-y:{{ st.button_pad_y | default: 12 }}px;{%- endif -%}
  {%- if sec_font and st.body_font.family != blank -%}--mb-font:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<div class="r7n r7n--split color-{{ color_scheme }} gradient" data-r7n="newsletter-split" data-r7n-section="{{ sid }}"{% if request.design_mode %} data-r7n-settings="{{ st | json | escape }}"{% endif %} data-r7n-width="{{ st.section_width | default: 'fluid_container' }}" data-r7n-show="{{ st.show_section_on | default: 'all' }}" data-r7n-align="{{ st.content_alignment | default: 'left' }}" data-r7n-side="{{ st.image_position | default: 'left' }}" data-r7n-ratio="{{ st.image_ratio | default: 'square' }}" data-r7n-mimg="{% if st.show_image_mobile == false %}false{% else %}true{% endif %}" data-r7n-form-layout="{{ st.form_layout | default: 'horizontal' }}" style="{{ r7n_vars | strip_newlines }}">
  <div class="r7n__inner">
    <div class="r7n__split">
      <div class="r7n__media" data-r7n-media>
        {%- if st.image != blank -%}
          <img class="r7n__img" data-r7n-img src="{{ st.image | image_url: width: 1200 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 900 }} 900w, {{ st.image | image_url: width: 1200 }} 1200w, {{ st.image | image_url: width: 1800 }} 1800w" sizes="(min-width: 768px) 50vw, 100vw" width="{{ st.image.width | default: 1200 }}" height="{{ st.image.height | default: 1500 }}" alt="{{ image_alt | escape }}" loading="lazy" decoding="async"{% if st.image.presentation.focal_point != blank %} style="object-position: {{ st.image.presentation.focal_point }}"{% endif %}>
        {%- else -%}
          {%- render 'placeholder-render', class: 'r7n__img r7n__img--ph' -%}
        {%- endif -%}
      </div>
      <div class="r7n__body">
        {%- if header_count > 0 -%}
          <div class="r7n__header">
            {%- for block in section.blocks -%}{%- render 'r7-connect-block', block: block, section: section -%}{%- endfor -%}
          </div>
        {%- endif -%}
        <div class="r7n__signup" data-r7n-signup{% if sec_font %} data-own-font{% endif %}>
          {%- comment -%} A Storelib sign-up form (data-storelib-form="subscribe") to the creator's Subscribers, sent once by materia-forms.js; the messages and data-mt-words are the section's own words. {%- endcomment -%}
          {%- form 'customer', id: 'NewsletterSplitForm-' | append: sid, class: 'r7n__form', data-nl-form: '', data-mt-inline-subscribe: 'true', data-storelib-form: 'subscribe' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <span hidden data-mt-words data-r7n-words data-success-message="{{ st.success_text | default: "Thanks, you're on the list." | escape }}" data-already-message="{{ st.already_text | escape }}" data-invalid-message="{{ st.invalid_text | escape }}" data-error-message="{{ st.error_text | escape }}" data-success-ms="{{ success_ms }}"></span>
            <div class="r7n__hp" aria-hidden="true" data-mt-trap>
              <label for="NewsletterSplitHp-{{ sid }}">Leave this field empty</label>
              <input id="NewsletterSplitHp-{{ sid }}" type="text" name="company" tabindex="-1" autocomplete="off" pattern="^$" maxlength="0" value="">
            </div>
            <div class="r7n__fields">
              <label class="r7n__vh" for="NewsletterSplitEmail-{{ sid }}" data-r7n-email-label>{{ email_label | escape }}</label>
              <input class="r7n__input" id="NewsletterSplitEmail-{{ sid }}" type="email" name="contact[email]" required inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ st.email_placeholder | escape }}" aria-describedby="NewsletterSplitHint-{{ sid }}" value="{% if customer %}{{ customer.email }}{% endif %}" data-r7n-input{% if sec_font and st.body_font.family != blank %} style="--body-font:{{ st.body_font.family }}, {{ st.body_font.fallback_families }}"{% endif %}>
              <button type="submit" class="r7n__submit {% if btn_style == 'secondary' %}btn-secondary{% else %}btn-primary{% endif %}" data-r7n-submit data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button{% if own_shape %} data-own-shape{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}>
                <span class="r7n__submit-stack">
                  <span class="r7n__submit-state" data-r7n-label data-inline-label{% if request.design_mode %} data-fallback="{{ 'newsletter.button_label' | t | escape }}"{% endif %}>{{ btn_label | escape }}</span>
                  <span class="r7n__submit-state r7n__spinner" aria-hidden="true"></span>
                  <span class="r7n__submit-state r7n__submit-done" data-r7n-subscribed data-subscribed-label aria-hidden="true">{{ st.subscribed_button_text | default: 'Subscribed' | escape }}</span>
                </span>
              </button>
            </div>
            <p class="r7n__msg r7n__hint" id="NewsletterSplitHint-{{ sid }}" data-nl-hint data-r7n-hint>{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>
            <div class="r7n__result" data-nl-result role="status" aria-live="polite">
              <p class="r7n__msg r7n__msg--error" data-nl-msg="error" data-r7n-msg="error">{{ st.error_text | default: 'That did not go through. Check your connection and try again.' | escape }}</p>
              <p class="r7n__msg r7n__msg--done" data-nl-msg="done" data-r7n-msg="done">{{ st.success_text | default: "Thanks, you're on the list." | escape }}</p>
              {%- if form.posted_successfully? -%}<p class="r7n__msg r7n__msg--posted">{{ st.success_text | default: "Thanks, you're on the list." | escape }}</p>{%- endif -%}
              {%- if form.errors -%}<p class="r7n__msg r7n__msg--failed">{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>{%- endif -%}
            </div>
          {%- endform -%}
          <div class="r7n__note" data-r7n-note{% if st.note == blank %} hidden{% endif %}>{{ st.note }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{%- if request.design_mode -%}
{%- comment -%} The builder runs a redrawn or newly added section's inline scripts: load the controller if this page did not have it yet, or set this section up. {%- endcomment -%}
<script>(function(){if(window.MateriaR7Connect)return window.MateriaR7Connect.scan();if(document.querySelector('script[data-r7n-boot]'))return;var s=document.createElement('script');s.src="{{ 'live-r7-connect.js' | asset_url }}";s.setAttribute('data-r7n-boot','');document.head.appendChild(s);})();{% comment %}{% endcomment %}</script>
{%- endif -%}
</template>

<schema>
{
  "type": "newsletter-split",
  "name": "Newsletter Split",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "info": "Read out by screen readers. Empty uses the placeholder.",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "Note under the form",
      "default": "We send a few emails a month. Unsubscribe at any time."
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Messages"
    },
    {
      "type": "text",
      "id": "subscribed_button_text",
      "label": "Subscribed button label",
      "default": "Subscribed"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks, you're on the list."
    },
    {
      "type": "range",
      "id": "success_duration",
      "label": "Success message shows for",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "already_text",
      "label": "Already subscribed message",
      "info": "Shown when this address was signed up from the same browser before.",
      "default": "You're already on the list."
    },
    {
      "type": "text",
      "id": "invalid_text",
      "label": "Invalid email message",
      "default": "Enter a valid email address."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Could not send message",
      "default": "That did not go through. Check your connection and try again."
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Picture side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form layout",
      "default": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Side by side"
        },
        {
          "value": "vertical",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Picture width (desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Picture"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Picture description",
      "info": "Read out by screen readers. Empty uses the picture's own description."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape",
      "default": "square",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Button"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_theme_button",
      "label": "Match theme button",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button text size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_pad_x",
      "label": "Button padding (sides)",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_pad_y",
      "label": "Button padding (top and bottom)",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme and Theme settings > Buttons."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Note and messages",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Button border",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background on hover",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Button text on hover",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_44",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Text, field and button font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_48",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Follows Theme settings > Animations."
    },
    {
      "type": "header",
      "id": "hdr_50",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_55",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "show_image_mobile",
      "label": "Show the picture on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
