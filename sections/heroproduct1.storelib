        "default": 500
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image position",
        "default": "right",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "block_spacing",
        "min": 0,
        "max": 60,
        "step": 5,
        "unit": "px",
        "label": "Block spacing",
        "default": 20
      },
      {
        "type": "header",
