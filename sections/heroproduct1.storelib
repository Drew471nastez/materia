<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- sections/loud-hero-product-1.liquid -->
{%- liquid
  assign media_height_desktop      = section.settings.media_height_desktop
  assign media_height_mobile       = section.settings.media_height_mobile
  assign content_max_width         = section.settings.content_max_width

  assign mobile_padding_top        = section.settings.mobile_padding_top
  assign mobile_padding_bottom     = section.settings.mobile_padding_bottom
  assign block_spacing             = section.settings.block_spacing
  assign background_color          = section.settings.background_color

  assign full_width                = section.settings.full_width
  assign content_width             = section.settings.content_width

  assign content_align_desktop     = section.settings.content_align_desktop
  assign content_align_mobile      = section.settings.content_align_mobile

  assign content_padding_left_desktop  = section.settings.content_padding_left_desktop
  assign content_padding_right_desktop = section.settings.content_padding_right_desktop
  assign content_padding_left_mobile   = section.settings.content_padding_left_mobile
  assign content_padding_right_mobile  = section.settings.content_padding_right_mobile

  assign mobile_media_content_gap  = section.settings.mobile_media_content_gap

  case content_align_desktop
    when 'left'
      assign ai_desktop = 'flex-start'
      assign ta_desktop = 'left'
      assign jc_desktop = 'flex-start'
    when 'right'
      assign ai_desktop = 'flex-end'
      assign ta_desktop = 'right'
      assign jc_desktop = 'flex-end'
    else
      assign ai_desktop = 'center'
      assign ta_desktop = 'center'
      assign jc_desktop = 'center'
  endcase

  case content_align_mobile
    when 'left'
      assign ai_mobile = 'flex-start'
      assign ta_mobile = 'left'
      assign jc_mobile = 'flex-start'
    when 'right'
      assign ai_mobile = 'flex-end'
      assign ta_mobile = 'right'
      assign jc_mobile = 'flex-end'
    else
      assign ai_mobile = 'center'
      assign ta_mobile = 'center'
      assign jc_mobile = 'center'
  endcase
-%}

{%- style -%}
  /* Theme typography inheritance — when custom fonts are OFF, this section
     follows the theme's global Body / Heading fonts. Zero-specificity
     :where() so any block-level or custom-font rule still wins. */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  .loud-hero-promo-section {
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
    {%- if section.settings.divider_bottom_style != 'none' and section.settings.divider_bottom_style != blank -%}
      padding-bottom: {{ section.settings.divider_bottom_height_mobile | default: 40 }}px;
    {%- endif -%}

    /* type scales */
    --desktop-heading-size: 42px;
    --mobile-heading-size: 32px;
    --desktop-paragraph-size: 18px;
    --mobile-paragraph-size: 16px;
    --desktop-rating-size: 16px;
    --mobile-rating-size: 14px;

    /* icons */
    --star-size: 24px;
    --star-size-mobile: 18px;
    --star-gap: 2px;
    --star-text-gap: 10px;
    --benefit-icon-size: 20px;
    --benefit-spacing: 10px;
    --benefit-font-size-desktop: 14px;
    --benefit-font-size-mobile: 12px;

    /* media */
    --media-height-desktop: {{ media_height_desktop }}px;
    --media-height-mobile: {{ media_height_mobile }}px;
  }
  {%- if section.settings.divider_bottom_style != 'none' and section.settings.divider_bottom_style != blank -%}
    @media (min-width: 768px) {
      .loud-hero-promo-section {
        padding-bottom: {{ section.settings.divider_bottom_height_desktop | default: 60 }}px;
      }
    }
  {%- endif -%}

  #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  /* Content column (wrapper) — layout only, not alignment logic */
  #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container > .loud-hero-promo-content {
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* keep layout neutral; block alignment is handled per-block below */
    align-items: var(--content-align-items-desktop);
    padding-left: var(--content-padding-left-desktop);
    padding-right: var(--content-padding-right-desktop);
    background-color: var(--content-bg);
  }

  /* Inner content stack */
  #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container > .loud-hero-promo-content > .loud-hero-promo-content-inner {
    max-width: var(--content-max-width);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--block-spacing);
    align-items: var(--content-align-items-desktop);
  }

  /* ✅ Block-level alignment: affects ONLY blocks, not hero */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > *:not(.happy-customers-block):not(.benefits-pills-block):not(.benefits-stack-block) {
    align-self: var(--content-align-items-desktop);
    text-align: var(--content-text-align-desktop);
  }

  #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading h1,
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph p,
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph .rte,
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph .rte p {
    margin: 0;
    padding: 0;
    line-height: 1.3;
  }

  /* Hero/media column — explicitly unaffected by content alignment */
  #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container > .loud-hero-promo-image-container {
    width: 50%;
    position: relative;
    height: var(--media-height-desktop);
    text-align: initial;
  }

  #loud-hero-promo-{{ section.id }} .loud-hero-promo-image-container > .loud-hero-promo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #loud-hero-promo-{{ section.id }} .loud-hero-promo-image-container > .loud-hero-promo-video-wrapper {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0; left: 0;
    overflow: hidden;
  }

  #loud-hero-promo-{{ section.id }} .loud-hero-promo-video-wrapper > .loud-hero-promo-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #loud-hero-promo-{{ section.id }} .loud-hero-promo-video-wrapper > iframe {
    position: absolute;
    top: 50%; left: 50%;
    width: 100%; height: 100%;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  /* Rating */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-rating {
    display: inline-flex;
    align-items: center;
    justify-content: var(--content-justify-desktop);
    line-height: 1;
    border-style: solid;
    border-width: var(--border-width);
    border-color: var(--border-color);
    border-radius: var(--border-radius);
    padding: var(--padding);
  }
  /* Stars — two stacked rows: an unfilled base + a clipped filled overlay,
     so any fractional rating (4.5, 3.5 …) renders a precise partial fill. */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating > .loud-hero-promo-stars {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    margin-right: var(--star-text-gap);
    line-height: 1;
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-stars-row {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-stars-bg {
    color: var(--star-empty-color, #e0e0e0);
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-stars-fg {
    position: absolute;
    top: 0;
    left: 0;
    width: auto;
    white-space: nowrap;
    color: var(--star-color);
    overflow: hidden;
    -webkit-clip-path: inset(0 calc(100% - var(--star-fill, 100%)) 0 0);
    clip-path: inset(0 calc(100% - var(--star-fill, 100%)) 0 0);
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-stars-row > .loud-hero-star-icon {
    display: inline-block;
    width: var(--star-size);
    height: var(--star-size);
    margin-right: var(--star-gap);
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-star-icon > svg { width: 100%; height: 100%; }
  #loud-hero-promo-{{ section.id }} .loud-hero-star-icon > .loud-hero-custom-star {
    width: 100%; height: 100%; object-fit: contain;
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-stars-row > .loud-hero-star-icon:last-child { margin-right: 0; }
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating > .loud-hero-promo-rating-text {
    margin: 0; padding: 0; line-height: 1;
    font-size: var(--desktop-rating-size);
    color: var(--rating-text-color);
    display: flex; align-items: center;
  }

  /* Heading */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-heading { font-weight: bold; }
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading > h1 {
    font-size: var(--desktop-heading-size);
    color: var(--heading-color) !important;
  }

  /* Paragraph */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-paragraph {
    color: var(--paragraph-color);
    font-size: var(--desktop-paragraph-size);
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph > .rte,
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph > .rte p {
    font-size: var(--desktop-paragraph-size);
  }

  /* Button */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-button {
    padding: 12px 25px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: var(--btn-font-weight, 700);
    border-radius: 0;
     margin-top: 10px; /* ⬅️ adjust value as you like */
    display: inline-block;
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
  }

  /* Benefit */
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-benefit {
    display: flex;
    align-items: center;
    justify-content: var(--content-justify-desktop);
    margin-top: 5px;
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-benefit > .loud-hero-promo-benefit-icon {
    width: var(--benefit-icon-size);
    height: var(--benefit-icon-size);
    margin-right: var(--benefit-spacing);
    display: flex; align-items: center; justify-content: center;
  }
  #loud-hero-promo-{{ section.id }} .loud-hero-promo-benefit > .loud-hero-promo-benefit-text {
    font-size: var(--benefit-font-size-desktop);
    color: var(--benefit-font-color);
    display: flex; align-items: center; line-height: 1;
  }

  /* ── Section-level custom fonts (always applied; previously this lived
        inside the `unless full_width` block, so it never fired on the
        default full-width layout). font_face is emitted so the chosen
        font actually loads. */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  @media screen and (max-width: 768px) {
    #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container { flex-direction: column-reverse; }

    #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container > .loud-hero-promo-content {
      width: 100%;
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
      padding-left: var(--content-padding-left-mobile);
      padding-right: var(--content-padding-right-mobile);
      align-items: var(--content-align-items-mobile);
      /* wrapper remains neutral; block alignment below */
      margin-top: var(--mobile-media-content-gap);
    }

    #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container > .loud-hero-promo-image-container {
      width: 100%;
      height: var(--media-height-mobile);
      text-align: initial;
    }

    #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner {
      align-items: var(--content-align-items-mobile);
    }

    /* ✅ Mobile: block-level alignment only */
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > *:not(.happy-customers-block):not(.benefits-pills-block):not(.benefits-stack-block) {
      align-self: var(--content-align-items-mobile);
      text-align: var(--content-text-align-mobile);
    }

    #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading > h1 { font-size: var(--mobile-heading-size); }
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph,
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph > .rte,
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph > .rte p { font-size: var(--mobile-paragraph-size); }

    #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating > .loud-hero-promo-rating-text { font-size: var(--mobile-rating-size); }
    #loud-hero-promo-{{ section.id }} .loud-hero-stars-row > .loud-hero-star-icon { width: var(--star-size-mobile); height: var(--star-size-mobile); }
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-benefit > .loud-hero-promo-benefit-text { font-size: var(--benefit-font-size-mobile); }

    #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-button {
      padding: var(--button-padding-vertical-mobile) var(--button-padding-horizontal-mobile);
      border-radius: var(--button-border-radius-mobile);
      font-size: var(--button-font-size-mobile);
    }

    #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-rating { justify-content: var(--content-justify-mobile); }
    #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-benefit { justify-content: var(--content-justify-mobile); }
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    #loud-hero-promo-{{ section.id }} > .loud-hero-promo-container {
      max-width: {{ content_width }}rem;
      margin-left: auto;
      margin-right: auto;
    }
{% comment %}{% endcomment %}  </style>
{% endunless %}

<div class="loud-hero-promo-section color-{{ color_scheme }} gradient" id="loud-hero-promo-{{ section.id }}"
     style="--media-height-desktop: {{ media_height_desktop }}px;
            --media-height-mobile: {{ media_height_mobile }}px;">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'rating' -%}
        {%- if block.settings.custom_font and block.settings.font -%}
          <style>
            {{ block.settings.font | font_face: font_display: 'swap' }}
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating-text {
              font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }} !important;
              font-style: {{ block.settings.font.style }};
              font-weight: {{ block.settings.font.weight }};
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
      {%- when 'heading' -%}
        {%- if block.settings.custom_font and block.settings.font -%}
          <style>
            {{ block.settings.font | font_face: font_display: 'swap' }}
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading h1 {
              font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }} !important;
              font-style: {{ block.settings.font.style }};
              font-weight: {{ block.settings.font.weight }};
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
        {%- if block.settings.enable_custom_font_weight -%}
          <style>
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading h1 {
              font-weight: {{ block.settings.font_weight }} !important;
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
      {%- when 'paragraph' -%}
        {%- if block.settings.custom_font and block.settings.font -%}
          <style>
            {{ block.settings.font | font_face: font_display: 'swap' }}
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph,
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph .rte,
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph .rte p {
              font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }} !important;
              font-style: {{ block.settings.font.style }};
              font-weight: {{ block.settings.font.weight }};
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
      {%- when 'button' -%}
        {%- if block.settings.custom_font and block.settings.font -%}
          <style>
            {{ block.settings.font | font_face: font_display: 'swap' }}
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-button {
              font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }} !important;
              font-style: {{ block.settings.font.style }};
              font-weight: {{ block.settings.font.weight }};
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
      {%- when 'benefit' -%}
        {%- if block.settings.custom_font and block.settings.font -%}
          <style>
            {{ block.settings.font | font_face: font_display: 'swap' }}
            #loud-hero-promo-{{ section.id }} .loud-hero-promo-benefit-text {
              font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }} !important;
              font-style: {{ block.settings.font.style }};
              font-weight: {{ block.settings.font.weight }};
            }
{% comment %}{% endcomment %}          </style>
        {%- endif -%}
          {%- endcase -%}
  {%- endfor -%}

  <div class="loud-hero-promo-container">
    <div class="loud-hero-promo-content"
         style="
           --block-spacing: {{ block_spacing }}px;
           --content-max-width: {{ content_max_width }}px;
           --mobile-padding-top: {{ mobile_padding_top }}px;
           --mobile-padding-bottom: {{ mobile_padding_bottom }}px;
           --content-padding-left-desktop: {{ content_padding_left_desktop }}px;
           --content-padding-right-desktop: {{ content_padding_right_desktop }}px;
           --content-padding-left-mobile: {{ content_padding_left_mobile }}px;
           --content-padding-right-mobile: {{ content_padding_right_mobile }}px;
           --content-align-items-desktop: {{ ai_desktop }};
           --content-text-align-desktop: {{ ta_desktop }};
           --content-justify-desktop: {{ jc_desktop }};
           --content-align-items-mobile: {{ ai_mobile }};
           --content-text-align-mobile: {{ ta_mobile }};
           --content-justify-mobile: {{ jc_mobile }};
           --mobile-media-content-gap: {{ mobile_media_content_gap }}px;
           --content-bg: {% render 'scheme-color', color: background_color, fallback: 'transparent' %};
         ">
      <div class="loud-hero-promo-content-inner">
        {%- assign sid = section.id -%}
        {%- assign image_block = null -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- if block.type == 'image' -%}
            {%- assign image_block = block -%}
            {%- continue -%}
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'rating' -%}
              {%- assign star_fill_pct = block.settings.rating_value | times: 20 -%}
              {%- capture one_star -%}
                {%- if block.settings.star_style == 'custom' and block.settings.custom_star_image != blank -%}
                  {{ block.settings.custom_star_image | image_url: width: 50 | image_tag: loading: 'lazy', class: 'loud-hero-custom-star' }}
                {%- elsif block.settings.star_style == 'star1' -%}
                  <svg fill="currentColor" viewBox="0 0 1920 1920" xmlns="http://www.w3.org/2000/svg"><path d="M1915.918 737.475c-10.955-33.543-42.014-56.131-77.364-56.131h-612.029l-189.063-582.1v-.112C1026.394 65.588 995.335 43 959.984 43c-35.237 0-66.41 22.588-77.365 56.245L693.443 681.344H81.415c-35.35 0-66.41 22.588-77.365 56.131-10.955 33.544.79 70.137 29.478 91.03l495.247 359.831-189.177 582.212c-10.955 33.657 1.13 70.25 29.817 90.918 14.23 10.278 30.946 15.487 47.66 15.487 16.716 0 33.432-5.21 47.775-15.6l495.134-359.718 495.021 359.718c28.574 20.781 67.087 20.781 95.662.113 28.687-20.668 40.658-57.261 29.703-91.03l-189.176-582.1 495.36-359.83c28.574-20.894 40.433-57.487 29.364-91.03" fill-rule="evenodd"></path></svg>
                {%- elsif block.settings.star_style == 'star2' -%}
                  <svg fill="currentColor" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg"><path d="M12,17.964l5.214-1.321l2.179,6.714L12,17.964z M24,9.286h-9.179L12,0.643L9.179,9.286 H0l7.429,5.357l-2.821,8.643l7.429-5.357l4.571-3.286L24,9.286L24,9.286L24,9.286L24,9.286z"></path></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.64376 8.20794L11.3273 2.75964C11.6022 2.2015 12.398 2.2015 12.6729 2.75964L15.3565 8.20794L21.3674 9.07654C21.983 9.16549 22.229 9.92194 21.7835 10.356L17.436 14.5921L18.4623 20.5779C18.5674 21.1908 17.9238 21.658 17.3736 21.3682L12.0001 18.5378L6.62666 21.3682C6.07618 21.6582 5.43236 21.1904 5.53802 20.5773L6.56941 14.5921L2.21703 10.3563C1.77116 9.92237 2.01708 9.16552 2.63286 9.07654L8.64376 8.20794Z" fill="currentColor"></path></svg>
                {%- endif -%}
              {%- endcapture -%}
              <div class="loud-hero-promo-rating"
                   style="--desktop-rating-size: {{ block.settings.text_size_desktop }}px;
                          --mobile-rating-size: {{ block.settings.text_size_mobile }}px;
                          --star-size: {{ block.settings.star_size }}px;
                          --star-size-mobile: {{ block.settings.star_size_mobile }}px;
                          --star-gap: {{ block.settings.star_gap }}px;
                          --star-text-gap: {{ block.settings.star_text_gap }}px;
                          --star-color: {% render 'scheme-color', color: block.settings.star_color, fallback: 'var(--color-primary)' %};
                          --star-empty-color: {% render 'scheme-color', color: block.settings.star_empty_color, fallback: 'var(--color-border)' %};
                          --star-fill: {{ star_fill_pct }}%;
                          --rating-text-color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--color-text)' %};
                          --border-width: {{ block.settings.border_width }}px;
                          --border-color: {% render 'scheme-color', color: block.settings.border_color, fallback: 'var(--color-border)' %};
                          --border-radius: {{ block.settings.border_radius }}px;
                          --padding: {{ block.settings.padding }}px;"
                   {{ block.shopify_attributes }}>
                <div class="loud-hero-promo-stars" role="img" aria-label="{{ block.settings.rating_value }} out of 5 stars">
                  <div class="loud-hero-stars-row loud-hero-stars-bg" aria-hidden="true">
                    {%- for i in (1..5) -%}<span class="loud-hero-star-icon">{{ one_star }}</span>{%- endfor -%}
                  </div>
                  <div class="loud-hero-stars-row loud-hero-stars-fg" aria-hidden="true">
                    {%- for i in (1..5) -%}<span class="loud-hero-star-icon">{{ one_star }}</span>{%- endfor -%}
                  </div>
                </div>
                <div class="loud-hero-promo-rating-text">{{ block.settings.rating_text }}</div>
              </div>

            {%- when 'heading' -%}
              <div class="loud-hero-promo-heading"
                   style="--desktop-heading-size: {{ block.settings.font_size_desktop }}px;
                          --mobile-heading-size: {{ block.settings.font_size_mobile }}px;
                          --heading-color: {% render 'scheme-color', color: block.settings.font_color, fallback: 'var(--color-heading)' %};"
                   {{ block.shopify_attributes }}>
                <h1>{{ block.settings.heading }}</h1>
              </div>

            {%- when 'paragraph' -%}
              <div class="loud-hero-promo-paragraph"
                   style="--desktop-paragraph-size: {{ block.settings.font_size_desktop }}px;
                          --mobile-paragraph-size: {{ block.settings.font_size_mobile }}px;
                          --paragraph-color: {% render 'scheme-color', color: block.settings.font_color, fallback: 'var(--color-text)' %};"
                   {{ block.shopify_attributes }}>
                <p>{{ block.settings.text }}</p>
              </div>

            {%- when 'button' -%}
              <a href="{{ block.settings.button_link | default: '#' }}"
                 class="loud-hero-promo-button"
                 data-block-id="{{ block.id }}"
                 style="background-color: {% render 'scheme-color', color: block.settings.button_bg_color, fallback: 'var(--btn-primary-bg-color)' %};
                        color: {% render 'scheme-color', color: block.settings.button_text_color, fallback: 'var(--btn-primary-color)' %};
                        {%- if block.settings.use_theme_button -%}
                        padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 25px);
                        border-radius: var(--btn-radius, 6px);
                        border: var(--btn-border-width, 0px) solid var(--btn-primary-border-color, transparent);
                        font-size: var(--btn-font-size, 14px);
                        {%- else -%}
                        padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                        border-radius: {{ block.settings.border_radius }}px;
                        font-size: {{ block.settings.font_size_desktop }}px;
                        {%- endif -%}"
                 {{ block.shopify_attributes }}>
                {{ block.settings.button_label }}
              </a>

            {%- when 'benefit' -%}
              <div class="loud-hero-promo-benefit"
                   style="--benefit-icon-size: {{ block.settings.icon_size }}px;
                          --benefit-spacing: {{ block.settings.spacing }}px;
                          --benefit-font-size-desktop: {{ block.settings.font_size_desktop }}px;
                          --benefit-font-size-mobile: {{ block.settings.font_size_mobile }}px;
                          --benefit-font-color: {% render 'scheme-color', color: block.settings.font_color, fallback: 'var(--color-text)' %};"
                   {{ block.shopify_attributes }}>
                {%- if block.settings.benefit_icon != blank -%}
                  <div class="loud-hero-promo-benefit-icon">
                    {{ block.settings.benefit_icon | image_url: width: block.settings.icon_size | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <div class="loud-hero-promo-benefit-text">{{ block.settings.benefit_text }}</div>
              </div>

          {%- when 'happy_customers' -%}
            {%- render 'happy-customers', block: block -%}

          {%- when 'benefits_pills' -%}
            {%- render 'benefits-pills', block: block -%}

          {%- when 'benefits_stack_badge' -%}
            {%- render 'benefits-stack', block: block -%}

          {%- when 'simple_rating' -%}
            {%- render 'simple-rating', block: block -%}
          {%- when 'lod_rating_badge' -%}
            {%- render 'lod-rating-badge', block: block -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if image_block != null -%}
      <div class="loud-hero-promo-image-container" {{ image_block.shopify_attributes }}>
        {%- assign demo_src = '' -%}
        {%- if image_block.settings.video == blank and image_block.settings.hero_image == blank -%}
          {%- capture demo_src -%}{%- render 'demo-image', key: image_block.id -%}{%- endcapture -%}
          {%- assign demo_src = demo_src | strip -%}
        {%- endif -%}
        {%- if image_block.settings.video != blank -%}
          <div class="loud-hero-promo-video-wrapper">
            {{ image_block.settings.video | video_tag: controls: false, autoplay: true, loop: true, muted: true, playsinline: true, class: 'loud-hero-promo-video', loading: 'lazy' }}
          </div>
        {%- elsif image_block.settings.hero_image != blank -%}
          {{ image_block.settings.hero_image | image_url: width: 1500 | image_tag: class: 'loud-hero-promo-image', loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 768px) 100vw, 50vw', widths: '600, 900, 1200, 1500' }}
        {%- elsif demo_src != blank -%}
          <img src="{{ demo_src }}" class="loud-hero-promo-image" alt="">
        {%- else -%}
          {%- render 'placeholder-render', class: 'loud-hero-promo-image' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.divider_bottom_style != 'none' and section.settings.divider_bottom_style != blank -%}
    {%- render 'hp-divider-bottom',
        style: section.settings.divider_bottom_style,
        color: section.settings.divider_bottom_color,
        height_desktop: section.settings.divider_bottom_height_desktop,
        height_mobile: section.settings.divider_bottom_height_mobile,
        flip: section.settings.divider_bottom_flip
    -%}
  {%- endif -%}
</div>

{%- style -%}
  @media screen and (max-width: 768px) {
    {%- for block in section.blocks -%}
      {%- if block.type == 'button' and block.settings.use_theme_button != true -%}
        #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-button[data-block-id="{{ block.id }}"] {
          padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px !important;
          border-radius: {{ block.settings.border_radius_mobile }}px !important;
          font-size: {{ block.settings.font_size_mobile }}px !important;
        }
      {%- endif -%}
    {%- endfor -%}
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'button' -%}
      #loud-hero-promo-{{ section.id }} .loud-hero-promo-content-inner > .loud-hero-promo-button[data-block-id="{{ block.id }}"]:hover {
        background-color: {% render 'scheme-color', color: block.settings.button_hover_bg_color, fallback: 'var(--btn-primary-hover-bg-color)' %} !important;
        color: {% render 'scheme-color', color: block.settings.button_hover_text_color, fallback: 'var(--btn-primary-hover-color)' %} !important;
      }
    {%- endif -%}
  {%- endfor -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'rating' -%}
        #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating-text { line-height: {{ block.settings.line_height_desktop }}; }
      {%- when 'heading' -%}
        #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading > h1 { line-height: {{ block.settings.line_height_desktop }}; }
      {%- when 'paragraph' -%}
        #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph,
        #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph p { line-height: {{ block.settings.line_height_desktop }}; }
    {%- endcase -%}
  {%- endfor -%}

  @media screen and (max-width: 768px) {
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'rating' -%}
          #loud-hero-promo-{{ section.id }} .loud-hero-promo-rating-text { line-height: {{ block.settings.line_height_mobile }}; }
        {%- when 'heading' -%}
          #loud-hero-promo-{{ section.id }} .loud-hero-promo-heading > h1 { line-height: {{ block.settings.line_height_mobile }}; }
        {%- when 'paragraph' -%}
          #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph,
          #loud-hero-promo-{{ section.id }} .loud-hero-promo-paragraph p { line-height: {{ block.settings.line_height_mobile }}; }
      {%- endcase -%}
    {%- endfor -%}
  }
{%- endstyle -%}



</template>

<schema>
{
  "type": "heroproduct1",
  "name": "Hero Product 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 30,
      "max": 200,
      "step": 2,
      "unit": "rem",
      "label": "Max width (not full width)",
      "default": 136
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content area"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Content width (max)",
      "default": 500
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "Content alignment (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding_left_desktop",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Left padding (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_right_desktop",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Right padding (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_padding_left_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Left padding (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_right_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Right padding (mobile)",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Block spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_media_content_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Media to content gap (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Media"
    },
    {
      "type": "range",
      "id": "media_height_desktop",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Image/Video height (desktop)",
      "default": 500
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "min": 200,
      "max": 500,
      "step": 50,
      "unit": "px",
      "label": "Image/Video height (mobile)",
      "default": 300
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Content background"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Bottom pattern divider"
    },
    {
      "type": "select",
      "id": "divider_bottom_style",
      "label": "Shape",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "wave_soft",
          "label": "Wave (soft)"
        },
        {
          "value": "zigzag",
          "label": "Zig-zag"
        },
        {
          "value": "curve_down",
          "label": "Curve (dip)"
        },
        {
          "value": "arch_up",
          "label": "Arch (peak)"
        },
        {
          "value": "triangles",
          "label": "Triangles"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        },
        {
          "value": "tilt_left",
          "label": "Tilt left"
        },
        {
          "value": "tilt_right",
          "label": "Tilt right"
        },
        {
          "value": "straight",
          "label": "Straight bar"
        }
      ]
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Divider color",
      "info": "Match next section background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "divider_bottom_height_desktop",
      "label": "Divider height (desktop)",
      "min": 20,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "divider_bottom_height_mobile",
      "label": "Divider height (mobile)",
      "min": 12,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "divider_bottom_flip",
      "label": "Flip horizontally",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Custom fonts (optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Rating",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "rating_text",
          "label": "Text",
          "default": "Rated 4.9 / 5 by 2,000+ customers"
        },
        {
          "type": "range",
          "id": "rating_value",
          "label": "Star rating (out of 5)",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 4.5
        },
        {
          "type": "checkbox",
          "id": "custom_font",
          "label": "Use custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4"
        },
        {
          "type": "select",
          "id": "star_style",
          "label": "Star icon style",
          "options": [
            {
              "value": "star1",
              "label": "Star 1"
            },
            {
              "value": "star2",
              "label": "Star 2"
            },
            {
              "value": "star3",
              "label": "Star 3"
            },
            {
              "value": "custom",
              "label": "Custom image"
            }
          ],
          "default": "star1"
        },
        {
          "type": "image_picker",
          "id": "custom_star_image",
          "label": "Custom star image",
          "info": "Used with Custom image"
        },
        {
          "type": "range",
          "id": "text_size_desktop",
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Text size (desktop)",
          "default": 18
        },
        {
          "type": "range",
          "id": "text_size_mobile",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Text size (mobile)",
          "default": 16
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        },
        {
          "type": "color",
          "id": "star_color",
          "label": "Star color (filled)"
        },
        {
          "type": "color",
          "id": "star_empty_color",
          "label": "Star color (unfilled)"
        },
        {
          "type": "range",
          "id": "star_size",
          "min": 10,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Star size (desktop)",
          "default": 24
        },
        {
          "type": "range",
          "id": "star_size_mobile",
          "min": 8,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Star size (mobile)",
          "default": 19
        },
        {
          "type": "range",
          "id": "star_gap",
          "min": 0,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Gap between stars",
          "default": 1
        },
        {
          "type": "range",
          "id": "star_text_gap",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Gap star ↔ text",
          "default": 10
        },
        {
          "type": "range",
          "id": "border_width",
          "min": 0,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Border width",
          "default": 0
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border color"
        },
        {
