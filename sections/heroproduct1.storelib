        "default": 136,
        "visible_if": "{{ section.settings.full_width == false }}"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section spacing",
        "default": true,
        "info": "Removes outer theme spacing. Content padding is controlled below."
      },
      {
        "type": "header",
        "content": "Content layout"
      },
      {
        "type": "select",
        "id": "content_align_desktop",
