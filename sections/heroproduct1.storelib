  "presets": [
    {
      "name": "Hero Product 1",
      "category": "Hero",
      "settings": {
        "media_height_desktop": 500,
        "media_height_mobile": 300,
        "content_max_width": 500,
        "content_align_desktop": "left",
        "content_align_mobile": "center",
        "content_padding_left_desktop": 80,
        "content_padding_right_desktop": 80,
        "content_padding_left_mobile": 20,
        "content_padding_right_mobile": 10,
        "mobile_media_content_gap": 0,
        "mobile_padding_top": 30,
        "mobile_padding_bottom": 30,
        "block_spacing": 20,
        "full_width": true,
        "content_width": 136
      },
      "blocks": [
        {
          "type": "rating",
          "settings": {
            "rating_text": "Rated 4.9 / 5 by 2,000+ customers",
            "rating_value": 4.5,
            "custom_font": false,
            "font": "assistant_n4",
            "star_style": "star1",
            "text_size_desktop": 18,
            "text_size_mobile": 16,
            "star_size": 24,
            "star_size_mobile": 19,
            "star_gap": 1,
            "star_text_gap": 10,
            "border_width": 0,
            "border_radius": 0,
            "padding": 0,
            "line_height_desktop": 1.2,
            "line_height_mobile": 1.2
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Designed to make everyday better",
            "custom_font": false,
            "font": "assistant_n4",
            "enable_custom_font_weight": false,
            "font_weight": "700",
            "font_size_desktop": 44,
            "font_size_mobile": 32,
            "line_height_desktop": 1.2,
            "line_height_mobile": 1.2
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "Premium quality, thoughtfully made, and built to last.",
            "custom_font": false,
            "font": "assistant_n4",
            "font_size_desktop": 18,
            "font_size_mobile": 16,
            "line_height_desktop": 1.5,
            "line_height_mobile": 1.5
          }
        },
        {
