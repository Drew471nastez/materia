<template compat="shopify">
{% render 'theme-type' %}
{{ 'hero-product-three.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'hero-product-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-three.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign media = section.blocks | where: 'type', 'image' | first %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% assign image = media.settings.hero_image %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="hp3-{{ section.id }}" data-hp3-variant="product1" class="hp3 color-{{ scheme }}" data-hero-product-three="{{ section.id }}" data-hp3-settings="{{ s | json | escape }}" data-hp3-product="{}" data-hp3-button-font="{{ settings.button_font | default: 'body_font' }}" data-hp3-currency="{{ shop.currency | default: 'EUR' }}" data-hp3-defaults='{"color_scheme":"default-color-scheme","full_width":true,"content_width":136,"reset_spacing":true,"content_max_width":500,"content_align_desktop":"left","content_padding_left_desktop":80,"content_padding_right_desktop":80,"block_spacing":20,"media_height_desktop":500,"divider_bottom_style":"none","divider_bottom_height_desktop":60,"divider_bottom_flip":false,"image_position":"right","image_radius":16,"image_fit":"cover","animation":"theme","divider_top_style":"none","divider_top_height_desktop":60,"divider_top_flip":false,"divider_top_rotate":false,"padding_top_desktop":64,"padding_bottom_desktop":64,"divider_bottom_color":"#FFFFFF","enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","content_align_mobile":"center","content_padding_left_mobile":20,"content_padding_right_mobile":20,"mobile_media_content_gap":0,"mobile_padding_top":30,"mobile_padding_bottom":30,"media_height_mobile":300,"divider_bottom_height_mobile":40,"divider_top_height_mobile":40,"image_position_mobile":"top"}' data-hp3-block-defaults='{"rating":{"rating_text":"Rated 4.9 / 5 by 2,000+ customers","rating_value":4.5,"star_style":"star1","text_size_desktop":18,"star_size":24,"star_gap":1,"star_text_gap":10,"padding":0,"enable_custom_alignment":false,"alignment":"left","border_width":0,"border_radius":0,"enable_custom_style":false,"custom_font":false,"font":"assistant_n4","line_height_desktop":1.2,"line_height_mobile":1.2,"text_size_mobile":16,"star_size_mobile":19},"heading":{"heading":"Designed to make everyday better","enable_custom_alignment":false,"alignment":"left","enable_custom_style":false,"custom_font":false,"font":"assistant_n4","enable_custom_font_weight":false,"font_weight":"700","font_size_desktop":44,"font_size_mobile":32,"line_height_desktop":1.2,"line_height_mobile":1.2},"paragraph":{"text":"Premium quality, thoughtfully made, and built to last.","enable_custom_alignment":false,"alignment":"left","enable_custom_style":false,"custom_font":false,"font":"assistant_n4","font_size_desktop":18,"font_size_mobile":16,"line_height_desktop":1.5,"line_height_mobile":1.5},"button":{"button_label":"Shop now","use_theme_button":true,"padding_vertical":12,"padding_horizontal":25,"enable_custom_alignment":false,"alignment":"left","border_radius":6,"border_radius_mobile":6,"enable_custom_style":false,"custom_font":false,"font":"assistant_n4","font_size_desktop":14,"font_size_mobile":13,"padding_vertical_mobile":10,"padding_horizontal_mobile":20},"benefit":{"benefit_text":"Free shipping and easy 30-day returns","icon_size":20,"icon_source":"auto","icon_preset":"check","spacing":10,"enable_custom_alignment":false,"alignment":"left","enable_custom_style":false,"custom_font":false,"font":"assistant_n4","font_size_desktop":14,"font_size_mobile":14},"image":{"video_autoplay":true,"video_loop":true,"video_controls":true},"benefits_pills":{"show_heading":true,"heading_text":"Benefits include:","heading_size_desktop":16,"heading_margin_bottom":12,"pill_radius":100,"pill_icon_size_desktop":16,"pill_border_style":"none","pill1_enable":true,"pill1_text":"Immune boost","pill1_icon_source":"preset","pill1_icon_preset":"leaf","pill2_enable":true,"pill2_text":"Improved mood","pill2_icon_source":"preset","pill2_icon_preset":"smile","pill3_enable":true,"pill3_text":"Skin health","pill3_icon_source":"preset","pill3_icon_preset":"heart","pill4_enable":false,"pill4_icon_source":"preset","pill4_icon_preset":"shield","pill5_enable":false,"pill5_icon_source":"preset","pill5_icon_preset":"lightning","pill6_enable":false,"pill6_icon_source":"preset","pill6_icon_preset":"star","alignment":"flex-start","gap_x":8,"gap_y":8,"padding_top":12,"padding_bottom":12,"heading_alignment":"left","pill_padding_x":14,"pill_padding_y":8,"pill_gap":8,"pill_border_width":0,"enable_custom_alignment":false,"custom_style":false,"heading_color":"#111111","pill_text_color":"#1f1147","pill_bg":"#F2F0FF","pill_icon_color":"#1f1147","pill_shadow":false,"heading_weight":"700","pill_font_weight":"600","pill_font_size_desktop":14,"pill_font_size_mobile":13,"mobile_layout":"wrap","heading_size_mobile":15,"pill_icon_size_mobile":14},"happy_customers":{"show_avatars":true,"show_stars":true,"show_rating_text":false,"heading":"100K+ Happy Customers","rating_text":"4.7","avatar_count":4,"avatar_size":40,"avatar_overlap":35,"total_stars":5,"filled_stars":5,"star_size":14,"padding_top":12,"padding_bottom":12,"enable_custom_alignment":false,"alignment":"left","filled_color":"#22c55e","unfilled_color":"#e5e7eb","enable_custom_style":false,"font_weight":"600","font_size_desktop":16,"font_size_mobile":14},"benefits_stack_badge":{"text_1":"Pore minimizing","text_2":"Instant glass skin","text_3":"Reduces sagging","columns":"1","icon_1":"badge_check","icon_2":"badge_check","icon_3":"badge_check","icon_4":"badge_check","icon_5":"badge_check","icon_6":"badge_check","icon_size":20,"gap_x":16,"gap_y":12,"padding_top":8,"padding_bottom":12,"enable_custom_alignment":false,"alignment":"left","enable_custom_style":false,"font_size_desktop":14,"font_size_mobile":13,"font_weight":"500"},"simple_rating":{"text":"4.9 / 5","total_stars":5,"filled_stars":5,"star_size":18,"padding_top":8,"padding_bottom":8,"alignment":"left","enable_custom_alignment":false,"filled_color":"#fbbf24","unfilled_color":"#e5e7eb","enable_custom_style":false,"font_size_desktop":16,"font_size_mobile":14,"font_weight":"500"},"lod_rating_badge":{"enable_link":false,"label_text":"Excellent 4.7 / 5","text_size":16,"star_radius":0,"rating":4,"star_tile_size_d":16,"star_icon_scale_d":100,"section_mt_d":8,"section_mb_d":8,"section_pl_d":0,"section_pr_d":0,"enable_custom_alignment":false,"alignment":"left","text_color":"#111111","stars_color":"#36A45C","star_icon_color":"#FFFFFF","enable_custom_style":false,"font_weight":"600","star_tile_size_m":16,"star_icon_scale_m":100,"section_mt_m":6,"section_mb_m":6,"section_pl_m":0,"section_pr_m":0}}' data-hp3-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-hp3-motion="{{ settings.scroll_animation | default: 'none' }}" data-hp3-duration="{{ settings.animation_duration | default: 700 }}" data-hp3-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="hp3__inner"><div class="hp3__row"><div class="hp3__content">
 {% if section.blocks.size == 0 %}{% if request.design_mode or page.in_editor %}{% render 'hero-preview-cover', name: 'Hero Product 1' %}{% endif %}{% endif %}{% for block in section.blocks %}{% unless block.hidden or block.type == 'image' %}{% assign kind = block.type %}{% case kind %}{% when 'rating' %}{% assign kind = 'simple_rating' %}{% when 'paragraph' %}{% assign kind = 'rich_text' %}{% when 'button' %}{% assign kind = 'primary_button' %}{% when 'benefit' %}{% assign kind = 'guarantee_badge' %}{% when 'lod_rating_badge' %}{% assign kind = 'rating_badge' %}{% endcase %}<div class="hp3__block" data-hp3-block="{{ block.id }}" data-hp3-kind="{{ kind }}" data-hp1-kind="{{ block.type }}" data-hp3-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>{% render 'hero-product-three-block', block: block, kind: kind %}</div>{% endunless %}{% endfor %}
 </div>{% assign media = section.blocks | where: "type", "image" | first %}<div class="hp3__media" data-hp1-media="{{ media.id }}" data-hp1-media-settings="{{ media.settings | json | escape }}" {{ media.shopify_attributes }}><picture>{% if media.settings.hero_image_mobile != blank %}<source media="(max-width:899px)" srcset="{% render 'offer-image-url', image: media.settings.hero_image_mobile, escaped: true %}">{% endif %}<img src="{% if image != blank %}{% render 'offer-image-url', image: image, escaped: true %}{% elsif media.settings.hero_image_mobile != blank %}{% render 'offer-image-url', image: media.settings.hero_image_mobile, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-hp3-placeholder="{{ placeholder | escape }}" alt="{{ image.alt | default: image.alt | escape }}" width="1600" height="1800" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline hidden></video></div></div></div>
 <div class="hp3__divider hp3__divider--top" data-hp3-top-shape aria-hidden="true"><svg viewBox="0 0 1200 120" preserveAspectRatio="none"><path/></svg></div>
 <div class="hp3__divider" data-hp3-shape aria-hidden="true"><svg viewBox="0 0 1200 120" preserveAspectRatio="none"><path/></svg></div>
 <template data-hp3-icon="shield"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 7.5-8 9-4-1.5-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg></template>
