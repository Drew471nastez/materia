<schema>
{
  "shopify": {
    "name": "Hero Product 1",
    "tag": "section",
    "class": "loud-hero-7",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width",
        "default": true
      },
      {
        "type": "range",
        "id": "content_width",
        "min": 30,
        "max": 200,
        "step": 2,
        "unit": "rem",
