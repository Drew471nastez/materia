<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_main_image_label = 'accessibility.main_image_label' | t -%}
{%- assign fb_accessibility_thumbnail = 'accessibility.thumbnail' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Grid

  Three-area layout (matches the reference screenshot):
    [thumbs column] [main image] [text column]

  - Thumbs column on the far left: a stack of small images (1–6).
  - Main image in the centre: large hero image.
  - Text column on the right: heading + subheading + button.

  Every image AND every text element is a block — fully reorderable
  and customizable. The thumbs column can be hidden, swapped to the
  right, or split as a row on mobile. All sliders / colors / selects
  are wired to scoped CSS via #shopify-section-{{ id }}.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  assign thumb_blocks = section.blocks | where: 'type', 'thumb_image'
  assign main_block = null
  for blk in section.blocks
    if blk.type == 'main_image' and main_block == null
      assign main_block = blk
    endif
  endfor

  case st.layout
    when 'thumbs_right'
      assign _flex_dir_d = 'row-reverse'
    else
      assign _flex_dir_d = 'row'
  endcase

  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase
-%}

<style>
  /* Custom fonts (override theme defaults inside this section only) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6),
    #shopify-section-{{ section.id }} .iwtg__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }

  /* Section margins + reset */
  {%- if st.section_bg != blank and st.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .iwtg { background: {{ st.section_bg }}; }
  {%- endif -%}
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .iwtg__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .iwtg__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .iwtg__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  #shopify-section-{{ sid }} .iwtg {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwtg {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwtg__inner { width: 100%; box-sizing: border-box; }

  /* ------- Top-level grid: media area + text area ------- */
  #shopify-section-{{ sid }} .iwtg__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 32 }}px;
    align-items: stretch;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwtg__grid {
      flex-direction: {% if st.text_position == 'left' %}row-reverse{% else %}row{% endif %};
      gap: {{ st.gap_desktop | default: 48 }}px;
      align-items: center;
    }
  }
  #shopify-section-{{ sid }} .iwtg__media,
  #shopify-section-{{ sid }} .iwtg__text { width: 100%; box-sizing: border-box; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwtg__text  { width: {{ st.text_column_width | default: 38 }}%; }
    #shopify-section-{{ sid }} .iwtg__media { width: calc(100% - {{ st.text_column_width | default: 38 }}%); }
  }

  /* ------- Inner media grid: thumbs + main ------- */
  #shopify-section-{{ sid }} .iwtg__media-grid {
    display: flex;
    flex-direction: row;
    gap: {{ st.media_gap | default: 16 }}px;
    align-items: stretch;
    flex-direction: {{ _flex_dir_d }};
  }
  {%- if st.hide_thumbs_on_mobile -%}
    @media (max-width: 899px) {
      #shopify-section-{{ sid }} .iwtg__thumbs { display: none; }
    }
  {%- endif -%}
  #shopify-section-{{ sid }} .iwtg__thumbs {
    display: flex;
    flex-direction: column;
    gap: {{ st.thumbs_gap | default: 12 }}px;
    width: {{ st.thumbs_width | default: 22 }}%;
    flex: 0 0 auto;
  }
  #shopify-section-{{ sid }} .iwtg__main {
    flex: 1 1 auto;
    width: 100%;
  }
  #shopify-section-{{ sid }} .iwtg__main-wrap,
  #shopify-section-{{ sid }} .iwtg__thumb {
    border-radius: {{ st.image_radius | default: 12 }}px;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
    width: 100%;
    box-sizing: border-box;
  }

  /* Main image aspect */
  #shopify-section-{{ sid }} .iwtg__main-wrap {
    aspect-ratio: {{ st.main_aspect_w | default: 4 }} / {{ st.main_aspect_h | default: 5 }};
  }
  #shopify-section-{{ sid }} .iwtg__main-wrap img {
    width: 100%;
    height: 100%;
    object-fit: {{ st.main_fit | default: 'cover' }};
    display: block;
  }

  /* Thumbs aspect */
  #shopify-section-{{ sid }} .iwtg__thumb {
    aspect-ratio: {{ st.thumb_aspect_w | default: 1 }} / {{ st.thumb_aspect_h | default: 1 }};
  }
  #shopify-section-{{ sid }} .iwtg__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* On mobile, thumbs become a horizontal row above/below the main */
  @media (max-width: 899px) {
    #shopify-section-{{ sid }} .iwtg__media-grid {
      flex-direction: column;
    }
    #shopify-section-{{ sid }} .iwtg__thumbs {
      flex-direction: row;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    #shopify-section-{{ sid }} .iwtg__thumb {
      flex: 0 0 {{ st.thumbs_mobile_width | default: 30 }}%;
      scroll-snap-align: start;
    }
  }

  /* ------- Text column ------- */
  #shopify-section-{{ sid }} .iwtg__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 16 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwtg__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .iwtg__text > * { margin: 0; max-width: 100%; }

  /* Defaults for content blocks */
  #shopify-section-{{ sid }} .iwtg__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  :where(#shopify-section-{{ sid }}) .iwtg__heading {
    color: var(--color-heading);
    font-weight: var(--heading-weight, 700);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .iwtg__subheading {
    line-height: 1.6;
    max-width: 560px;
  }
  #shopify-section-{{ sid }} .iwtg__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iwtg__subheading p:last-child { margin: 0; }

  /* Per-block overrides */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'eyebrow' -%}
      #shopify-section-{{ sid }} .iwtg__eyebrow[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size | default: 12 }}px;
      }
    {%- endif -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .iwtg__heading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
        font-size: {{ bs.size_mobile | default: 30 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwtg__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 40 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .iwtg__subheading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size_mobile | default: 14 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwtg__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 16 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'button' -%}
      #shopify-section-{{ sid }} .iwtg__btn[data-block-id="{{ block.id }}"] {
        display: {% if bs.full_width %}flex{% else %}inline-flex{% endif %};
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        line-height: 1;
        --iwtg-btn-bg: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %};
        background-color: var(--iwtg-btn-bg);
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %};
        border-color: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--iwtg-btn-bg))' %};
        {%- if bs.use_theme_button %}
        border-width: var(--btn-border-width, 1px);
        padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
        border-radius: var(--btn-radius, 8px);
        font-size: var(--btn-font-size, 14px);
        font-weight: var(--btn-font-weight, 600);
        {%- else %}
        border-width: {{ bs.border_width | default: 0 }}px;
        padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 26 }}px;
        border-radius: {{ bs.radius | default: 8 }}px;
        font-size: {{ bs.font_size | default: 14 }}px;
        font-weight: {{ bs.font_weight | default: '600' }};
        {%- endif %}
        border-style: solid;
        text-transform: {% if bs.uppercase %}uppercase{% elsif bs.use_theme_button %}var(--btn-text-transform, none){% else %}none{% endif %};
        width: {% if bs.full_width %}100%{% else %}auto{% endif %};
        max-width: {% if bs.full_width %}100%{% else %}max-content{% endif %};
        transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
      }
      #shopify-section-{{ sid }} .iwtg__btn[data-block-id="{{ block.id }}"]:hover,
      #shopify-section-{{ sid }} .iwtg__btn[data-block-id="{{ block.id }}"]:focus-visible {
        background-color: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
        color: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %};
        border-color: {% render 'scheme-color', color: bs.border_color_hover, fallback: 'var(--btn-primary-hover-border-color)' %};
        transform: translateY(-1px);
      }
      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ sid }} .iwtg__btn[data-block-id="{{ block.id }}"],
        #shopify-section-{{ sid }} .iwtg__btn[data-block-id="{{ block.id }}"]:hover { transition: none; transform: none; }
      }
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="iwtg-{{ sid }}" class="iwtg section sec__image-text-grid color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="iwtg__inner">
    <div class="iwtg__grid">

      <div class="iwtg__media">
        <div class="iwtg__media-grid">

          {%- if thumb_blocks.size > 0 -%}
            <div class="iwtg__thumbs">
              {%- for thumb in thumb_blocks -%}
                <div class="iwtg__thumb" {{ thumb.shopify_attributes }}>
                  {%- if thumb.settings.image != blank -%}
                    <img
                      src="{{ thumb.settings.image | image_url: width: 600 }}"
                      srcset="{{ thumb.settings.image | image_url: width: 300 }} 300w,
                              {{ thumb.settings.image | image_url: width: 600 }} 600w"
                      sizes="(min-width: 900px) 15vw, 30vw"
                      alt="{{ thumb.settings.image.alt | default: fb_accessibility_thumbnail | escape }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="iwtg__main">
            <div class="iwtg__main-wrap"{% if main_block %} {{ main_block.shopify_attributes }}{% endif %}>
              {%- if main_block and main_block.settings.image != blank -%}
                {%- assign mi = main_block.settings.image -%}
                <img
                  src="{{ mi | image_url: width: 1400 }}"
                  srcset="{{ mi | image_url: width: 700 }} 700w,
                          {{ mi | image_url: width: 1100 }} 1100w,
                          {{ mi | image_url: width: 1400 }} 1400w"
                  sizes="(min-width: 900px) 40vw, 100vw"
                  alt="{{ mi.alt | default: fb_accessibility_main_image_label | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
              {%- endif -%}
            </div>
          </div>

        </div>
      </div>

      <div class="iwtg__text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="iwtg__eyebrow" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} class="iwtg__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="iwtg__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if bs.label != blank -%}
                {%- liquid
                  assign custom_btn = true
                  if bs.use_theme_button
                    assign custom_btn = false
                  endif
                  assign btn_case = blank
                  if bs.uppercase
                    assign btn_case = 'uppercase'
                  elsif custom_btn
                    assign btn_case = 'none'
                  endif
                -%}
                <a class="iwtg__btn" data-block-id="{{ block.id }}" data-theme-button="primary" style="{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover, custom: custom_btn, radius: bs.radius, padding_y: bs.padding_y, padding_x: bs.padding_x, font_size: bs.font_size, weight: bs.font_weight, border_width: bs.border_width, transform: btn_case -%}" href="{{ bs.link | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "imagewithtextgrid",
  "name": "Image With Text Grid",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position (desktop)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Thumbs position (desktop)",
      "default": "thumbs_left",
      "options": [
        {
          "value": "thumbs_left",
          "label": "Thumbs left of main"
        },
        {
          "value": "thumbs_right",
          "label": "Thumbs right of main"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 38
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Outer gap (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Outer gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
