            "options": [
              {
                "value": "library",
                "label": "Built-in icon library"
              },
              {
                "value": "svg",
                "label": "Custom SVG (paste markup)"
              },
              {
                "value": "image",
                "label": "Image upload"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "check_circle",
