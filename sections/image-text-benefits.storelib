<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image & Video Benefits (block-based)

  Two-column section: image OR video on one side, benefits list on
  the other. Every text/icon/button is a block — fully reorderable.

  Blocks:
    - heading            (title above the benefits list)
    - subheading         (subtitle below the heading)
    - benefit_list       (container — defines where the list appears)
    - benefit            (icon + title + description) — repeatable
    - button             (CTA below the benefits)
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign image_side = st.image_side | default: 'left'
  assign media_type = st.media_type | default: 'image'
  assign cs_id = ''
-%}

<style>
  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  /* Section width / margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  {%- if st.section_bg != blank and st.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .ivb { background: {{ st.section_bg }}; }
  {%- endif -%}
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .ivb {
    padding: {{ st.padding_top_mobile | default: 48 }}px {{ st.side_padding_mobile | default: 16 }}px {{ st.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ivb {
      padding: {{ st.padding_top_desktop | default: 80 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 80 }}px;
    }
  }

  /* Inner width */
  #shopify-section-{{ sid }} .ivb__inner {
    margin-inline: auto;
    {%- case st.section_width -%}
      {%- when 'container' -%} max-width: calc(var(--page-width, 1300px) + 3rem);
      {%- when 'fluid_container' -%} max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
      {%- when 'stretch_width' -%} max-width: none;
      {%- else -%} max-width: none;
    {%- endcase -%}
  }

  /* Two-column grid */
  #shopify-section-{{ sid }} .ivb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.col_gap_mobile | default: 32 }}px;
    align-items: center;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ivb__grid {
      grid-template-columns: {{ st.media_ratio | default: 50 }}% 1fr;
      gap: {{ st.col_gap_desktop | default: 48 }}px;
    }
    {%- if image_side == 'right' -%}
      #shopify-section-{{ sid }} .ivb__media { order: 2; }
      #shopify-section-{{ sid }} .ivb__content { order: 1; }
    {%- endif -%}
  }

  /* Media side */
  #shopify-section-{{ sid }} .ivb__media {
    border-radius: {{ st.media_radius | default: 16 }}px;
    overflow: hidden;
    background-color: {% render 'scheme-color', color: st.media_placeholder_bg, fallback: 'color-mix(in srgb, var(--color-text) 8%, var(--color-background))' %};
    aspect-ratio: {{ st.media_aspect_ratio | default: '4/3' }};
  }
  #shopify-section-{{ sid }} .ivb__media img,
  #shopify-section-{{ sid }} .ivb__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Content side */
  #shopify-section-{{ sid }} .ivb__content {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 16 }}px;
    text-align: {{ st.text_align | default: 'left' }};
  }

  /* Heading + subheading blocks */
  #shopify-section-{{ sid }} .ivb__heading {
    margin: 0;
    line-height: 1.15;
    font-weight: var(--heading-weight, 700);
    color: var(--color-heading);
  }
  #shopify-section-{{ sid }} .ivb__subheading {
    margin: 0;
    line-height: 1.5;
    opacity: 0.85;
  }
  #shopify-section-{{ sid }} .ivb__subheading p {
    margin: 0 0 .5em;
  }
  #shopify-section-{{ sid }} .ivb__subheading p:last-child {
    margin: 0;
  }

  /* Benefits list */
  #shopify-section-{{ sid }} .ivb__list {
    display: flex;
    flex-direction: column;
    gap: {{ st.benefit_gap | default: 16 }}px;
    margin-top: {{ st.list_margin_top | default: 8 }}px;
  }
  #shopify-section-{{ sid }} .ivb__benefit {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  #shopify-section-{{ sid }} .ivb__benefit-icon {
    flex: 0 0 auto;
    width: {{ st.icon_tile_size | default: 36 }}px;
    height: {{ st.icon_tile_size | default: 36 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    {%- case st.icon_tile_shape -%}
      {%- when 'rounded' -%}border-radius: 8px;
      {%- when 'square'  -%}border-radius: 0;
      {%- else           -%}border-radius: 999px;
    {%- endcase -%}
    background: {% render 'scheme-color', color: st.icon_tile_bg, fallback: 'var(--color-heading)' %};
    color: {% render 'scheme-color', color: st.icon_tile_color, fallback: 'var(--color-background)' %};
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .ivb__benefit-icon svg {
    width: {{ st.icon_glyph_size | default: 50 }}%;
    height: {{ st.icon_glyph_size | default: 50 }}%;
    color: currentColor;
  }
  #shopify-section-{{ sid }} .ivb__benefit-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ sid }} .ivb__benefit-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  #shopify-section-{{ sid }} .ivb__benefit-title {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: var(--heading-weight, 600);
    line-height: 1.3;
    color: var(--color-heading);
  }
  #shopify-section-{{ sid }} .ivb__benefit-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.8;
  }
  #shopify-section-{{ sid }} .ivb__benefit-desc p { margin: 0 0 .25em; }
  #shopify-section-{{ sid }} .ivb__benefit-desc p:last-child { margin: 0; }

  /* Button block */
  #shopify-section-{{ sid }} .ivb__button {
    margin-top: 8px;
  }
  #shopify-section-{{ sid }} .ivb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
    border-radius: var(--btn-radius, 8px);
    font-size: var(--btn-font-size, 14px);
    font-weight: var(--btn-font-weight, 500);
    letter-spacing: var(--btn-letter-spacing, 0px);
    text-transform: var(--btn-text-transform, none);
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    border: 1px solid transparent;
  }
  #shopify-section-{{ sid }} .ivb__btn:hover {
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ivb__btn,
    #shopify-section-{{ sid }} .ivb__btn:hover { transition: none !important; transform: none !important; }
  }
{% comment %}{% endcomment %}</style>

<div
  id="ivb-{{ sid }}"
  class="ivb section color-{{ color_scheme }} gradient"
  data-section-id="{{ sid }}"
>
  <div class="ivb__inner">
    <div class="ivb__grid">

      <div class="ivb__media">
        {%- if media_type == 'video' and st.video != blank -%}
          {{ st.video | video_tag: autoplay: true, muted: true, playsinline: true, loop: true, controls: false, image_size: '1400x' }}
        {%- elsif media_type == 'video' and st.video_url != blank -%}
          <video src="{{ st.video_url }}" autoplay muted loop playsinline></video>
        {%- elsif st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1200 }}"
            srcset="{{ st.image | image_url: width: 600 }} 600w,
                    {{ st.image | image_url: width: 900 }} 900w,
                    {{ st.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 768px) 50vw, 100vw"
            alt="{{ st.image.alt | default: fb_accessibility_image | escape }}"
            width="{{ st.image.width }}"
            height="{{ st.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
        {%- endif -%}
      </div>

      <div class="ivb__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                {%- capture h_color -%}{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
                <{{ block.settings.tag | default: 'h2' }}
                  class="ivb__heading"
                  data-block-id="{{ block.id }}"
                  style="font-size: {{ block.settings.size_mobile | default: 28 }}px; color: {{ h_color }};"
                  {{ block.shopify_attributes }}
                >{{ block.settings.text }}</{{ block.settings.tag | default: 'h2' }}>
                <style>
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} .ivb__heading[data-block-id="{{ block.id }}"] {
                      font-size: {{ block.settings.size_desktop | default: 38 }}px !important;
                    }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if block.settings.text != blank -%}
                {%- capture s_color -%}{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %}{%- endcapture -%}
                <div
                  class="ivb__subheading"
                  style="font-size: {{ block.settings.size | default: 16 }}px; color: {{ s_color }};"
                  {{ block.shopify_attributes }}
                >{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'benefit_list' -%}
              <div class="ivb__list" {{ block.shopify_attributes }}>
                {%- assign benefit_items = section.blocks | where: 'type', 'benefit' -%}
                {%- for benefit in benefit_items -%}
                  {%- liquid
                    comment
                      Per-benefit colors: only apply when user actually set
                      a non-transparent value. Otherwise let the section's
                      CSS defaults (icon_tile_color, title_color, etc) win.
                    endcomment
                    assign _has_b_icon  = false
                    assign _has_b_title = false
                    assign _has_b_desc  = false
                    if benefit.settings.icon_color != blank and benefit.settings.icon_color != 'rgba(0,0,0,0)' and benefit.settings.icon_color.alpha != 0
                      assign _has_b_icon = true
                    endif
                    if benefit.settings.title_color != blank and benefit.settings.title_color != 'rgba(0,0,0,0)' and benefit.settings.title_color.alpha != 0
                      assign _has_b_title = true
                    endif
                    if benefit.settings.desc_color != blank and benefit.settings.desc_color != 'rgba(0,0,0,0)' and benefit.settings.desc_color.alpha != 0
                      assign _has_b_desc = true
                    endif
                  -%}
                  <div class="ivb__benefit" {{ benefit.shopify_attributes }}>
                    <span class="ivb__benefit-icon"{% if _has_b_icon %} style="color: {{ benefit.settings.icon_color }};"{% endif %} aria-hidden="true">
                      {%- case benefit.settings.icon_type -%}
                        {%- when 'image' -%}
                          {%- if benefit.settings.icon_image != blank -%}
                            <img src="{{ benefit.settings.icon_image | image_url: width: 200 }}" alt="">
                          {%- endif -%}
                        {%- when 'svg' -%}
                          {%- if benefit.settings.icon_svg != blank -%}
                            {{ benefit.settings.icon_svg }}
                          {%- endif -%}
                        {%- else -%}
                          {%- render 'hp-icon', icon: benefit.settings.icon -%}
                      {%- endcase -%}
                    </span>
                    <div class="ivb__benefit-text">
                      {%- if benefit.settings.title != blank -%}
                        <h3 class="ivb__benefit-title"{% if _has_b_title %} style="color: {{ benefit.settings.title_color }};"{% endif %}>{{ benefit.settings.title | escape }}</h3>
                      {%- endif -%}
                      {%- if benefit.settings.description != blank -%}
                        <div class="ivb__benefit-desc"{% if _has_b_desc %} style="color: {{ benefit.settings.desc_color }};"{% endif %}>{{ benefit.settings.description }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>

            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                {%- liquid
                  assign bs = block.settings
                -%}
                <style>
                  #shopify-section-{{ sid }} .ivb__btn[data-block-id="{{ block.id }}"] {
                    --ivb-btn-bg: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %};
                    --ivb-btn-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %};
                    --ivb-btn-border: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--ivb-btn-bg))' %};
                    --ivb-btn-bg-h: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
                    --ivb-btn-color-h: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %};
                    --ivb-btn-border-h: {% render 'scheme-color', color: bs.border_color_hover, fallback: 'var(--btn-primary-hover-border-color, var(--ivb-btn-bg-h))' %};
                  }
{% comment %}{% endcomment %}                </style>
                <style>
                  #shopify-section-{{ sid }} .ivb__btn[data-block-id="{{ block.id }}"] {
                    display: {% if bs.full_width %}flex{% else %}inline-flex{% endif %};
                    align-items: center;
                    justify-content: center;
                    text-decoration: none;
                    cursor: pointer;
                    line-height: 1;
                    background-color: var(--ivb-btn-bg);
                    color: var(--ivb-btn-color);
                    border-style: solid;
                    border-color: var(--ivb-btn-border);
                    {%- if bs.use_theme_button %}
                    border-width: var(--btn-border-width, 1px);
                    padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
                    border-radius: var(--btn-radius, 8px);
                    font-size: var(--btn-font-size, 14px);
                    font-weight: var(--btn-font-weight, 600);
                    {%- else %}
                    border-width: {{ bs.border_width | default: 1 }}px;
                    padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 26 }}px;
                    border-radius: {{ bs.radius | default: 8 }}px;
                    font-size: {{ bs.font_size | default: 14 }}px;
                    font-weight: {{ bs.font_weight | default: '600' }};
                    {%- endif %}
                    text-transform: {% if bs.uppercase %}uppercase{% elsif bs.use_theme_button %}var(--btn-text-transform, none){% else %}none{% endif %};
                    width: {% if bs.full_width %}100%{% else %}auto{% endif %};
                    max-width: {% if bs.full_width %}100%{% else %}max-content{% endif %};
                  }
                  #shopify-section-{{ sid }} .ivb__btn[data-block-id="{{ block.id }}"]:hover,
                  #shopify-section-{{ sid }} .ivb__btn[data-block-id="{{ block.id }}"]:focus-visible {
                    background-color: var(--ivb-btn-bg-h);
                    color: var(--ivb-btn-color-h);
                    border-color: var(--ivb-btn-border-h);
                    transform: translateY(-1px);
                  }
{% comment %}{% endcomment %}                </style>
                <div class="ivb__button" {{ block.shopify_attributes }}>
                  <a class="ivb__btn"
                     data-block-id="{{ block.id }}"
                     href="{{ bs.link | default: '#' }}">{{ bs.label | escape }}</a>
                </div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-text-benefits",
  "name": "Image & Video Benefits",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_ratio",
      "label": "Media column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap (content)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "benefit_gap",
      "label": "Gap between benefits",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video URL"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media aspect ratio",
      "default": "4/3",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "media_placeholder_bg",
      "label": "Placeholder background"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
