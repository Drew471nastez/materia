              },
              {
                "value": "lock",
                "label": "Lock"
              },
              {
                "value": "credit_card",
                "label": "Credit card"
              },
              {
                "value": "badge_check",
                "label": "Verified badge"
              },
              {
                "value": "check",
                "label": "Check"
              },
              {
                "value": "check_circle",
                "label": "Check circle"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "award",
                "label": "Award"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
              {
                "value": "gift",
                "label": "Gift"
              },
              {
                "value": "leaf",
                "label": "Leaf"
              },
              {
                "value": "recycle",
                "label": "Recycle"
              },
              {
                "value": "sparkles",
                "label": "Sparkles"
              },
              {
                "value": "lightning",
                "label": "Lightning"
              },
              {
                "value": "fire",
                "label": "Fire"
              },
              {
                "value": "percent",
                "label": "Percent"
              },
              {
                "value": "tag",
                "label": "Tag"
              },
              {
                "value": "chat",
                "label": "Chat"
              },
              {
                "value": "headset",
                "label": "Headset"
              }
            ],
            "visible_if": "{{ block.settings.icon_type == 'library' }}"
          },
          {
            "type": "textarea",
            "id": "icon_svg",
            "label": "SVG code",
            "visible_if": "{{ block.settings.icon_type == 'svg' }}"
          },
          {
            "type": "image_picker",
            "id": "icon_image",
            "label": "Icon image",
            "visible_if": "{{ block.settings.icon_type == 'image' }}"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "icon_color",
            "label": "Icon color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "desc_color",
            "label": "Description color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 3,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width button",
            "default": false
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color_hover",
            "label": "Border on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button shape",
            "default": true,
            "info": "Theme settings > Buttons sets the corners, padding and text size."
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Horizontal padding",
            "min": 8,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 26,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Vertical padding",
            "min": 6,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 4,
            "step": 1,
            "unit": "px",
            "default": 1,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Font size",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "600",
            "options": [
              {
                "value": "500",
                "label": "Medium (500)"
              },
              {
                "value": "600",
                "label": "Semibold (600)"
              },
              {
                "value": "700",
                "label": "Bold (700)"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase text",
            "default": false
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image & Video Benefits",
        "category": "Image and video",
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "Built for everyday brilliance"
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>A short tagline that sets the tone for the benefits below.</p>"
            }
          },
          {
            "type": "benefit_list"
          },
          {
            "type": "benefit",
            "settings": {
              "icon": "truck",
              "title": "Free shipping",
              "description": "<p>Say when orders ship and what delivery costs.</p>"
            }
          },
          {
            "type": "benefit",
            "settings": {
              "icon": "shield_check",
              "title": "2-year warranty",
              "description": "<p>Explain what the warranty covers and for how long.</p>"
            }
          },
          {
            "type": "benefit",
            "settings": {
              "icon": "leaf",
              "title": "Sustainable",
              "description": "<p>Describe the materials and packaging you use.</p>"
            }
          },
          {
            "type": "button",
            "settings": {
              "label": "Shop now"
            }
          }
        ]
      }
    ]
  }
