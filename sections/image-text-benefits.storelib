<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image & Video Benefits.

  An image or video on one side; heading, subheading, a benefits list and
  buttons on the other, all reorderable blocks. The Benefits list block
  marks where the Benefit items show. Colours follow the colour scheme and
  fonts follow Theme settings > Typography until custom styling or custom
  fonts are switched on. Layout lives in snippets/media-benefits-style;
  the builder's live edits in assets/media-live-benefits.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign own = st.enable_custom_style
  assign media_type = st.media_type | default: 'image'
  assign media_ratio = st.media_ratio | default: 50
  assign text_width = 100 | minus: media_ratio
  assign ph_bg = 'color-mix(in srgb, var(--color-text) 8%, var(--color-background))'
  assign benefit_items = section.blocks | where: 'type', 'benefit'
  assign icon_names = 'truck,package,plane,globe,return,refresh,clock,calendar,shield,shield_check,lock,credit_card,badge_check,check,check_circle,star,award,heart,gift,leaf,recycle,sparkles,lightning,fire,percent,tag,chat,headset' | split: ','
-%}
{% render 'media-benefits-style', section: section, bp: 768 %}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .ivb__list { display: flex; flex-direction: column; gap: var(--ivb-bgap); }
  #shopify-section-{{ sid }} .ivb__benefit { display: flex; align-items: flex-start; gap: 14px; text-align: left; }
  #shopify-section-{{ sid }} .ivb__benefit-icon { flex: 0 0 auto; width: var(--ivb-tile); height: var(--ivb-tile); display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--ivb-tile-bg); color: var(--b-ic); overflow: hidden; }
  #shopify-section-{{ sid }} .ivb[data-tile-shape='rounded'] .ivb__benefit-icon { border-radius: var(--rounded-radius, 8px); }
  #shopify-section-{{ sid }} .ivb[data-tile-shape='square'] .ivb__benefit-icon { border-radius: 0; }
  #shopify-section-{{ sid }} .ivb__benefit-icon svg { width: var(--ivb-glyph); height: var(--ivb-glyph); }
  #shopify-section-{{ sid }} .ivb__benefit-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ sid }} .ivb__benefit-text { flex: 1 1 auto; min-width: 0; }
  #shopify-section-{{ sid }} .ivb__benefit-title { margin: 0 0 4px; font-size: 15px; line-height: 1.3; color: var(--b-c); }
  #shopify-section-{{ sid }} .ivb__benefit-desc { margin: 0; font-size: 14px; line-height: 1.55; color: var(--b-c); }
  #shopify-section-{{ sid }} .ivb__benefit-desc p { margin: 0 0 .25em; }
  #shopify-section-{{ sid }} .ivb__benefit-desc p:last-child { margin: 0; }
{% comment %}{% endcomment %}</style>

<div id="ivb-{{ sid }}" class="ivb mlb section color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-mlb-root="image-text-benefits" {% render 'media-benefits-root', section: section, part: 'attrs', side: st.image_side, align: st.text_align, align_m: st.text_align_mobile %} data-tile-shape="{{ st.icon_tile_shape | default: 'round' }}" data-mlb-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;container&quot;,&quot;reset_spacing&quot;:true,&quot;image_side&quot;:&quot;left&quot;,&quot;media_ratio&quot;:50,&quot;text_align&quot;:&quot;left&quot;,&quot;content_gap&quot;:16,&quot;benefit_gap&quot;:16,&quot;media_type&quot;:&quot;image&quot;,&quot;video_autoplay&quot;:true,&quot;video_loop&quot;:true,&quot;video_controls&quot;:false,&quot;media_aspect_ratio&quot;:&quot;4/3&quot;,&quot;media_fit&quot;:&quot;cover&quot;,&quot;media_radius&quot;:16,&quot;icon_tile_size&quot;:36,&quot;icon_glyph_size&quot;:50,&quot;icon_tile_shape&quot;:&quot;round&quot;,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;col_gap_desktop&quot;:48,&quot;padding_top_desktop&quot;:80,&quot;padding_bottom_desktop&quot;:80,&quot;side_padding_desktop&quot;:32,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;text_align_mobile&quot;:&quot;left&quot;,&quot;mobile_order&quot;:&quot;media_first&quot;,&quot;col_gap_mobile&quot;:32,&quot;padding_top_mobile&quot;:48,&quot;padding_bottom_mobile&quot;:48,&quot;side_padding_mobile&quot;:16,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0&#125;" data-mlb-block-defaults="&#123;&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Built for everyday brilliance&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:38,&quot;size_mobile&quot;:28&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;A short tagline that sets the tone for the benefits below.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:16&#125;,&quot;benefit_list&quot;:&#123;&#125;,&quot;benefit&quot;:&#123;&quot;title&quot;:&quot;Benefit title&quot;,&quot;description&quot;:&quot;&lt;p&gt;One-line description of the benefit.&lt;/p&gt;&quot;,&quot;icon_type&quot;:&quot;library&quot;,&quot;icon&quot;:&quot;check_circle&quot;,&quot;enable_custom_style&quot;:false&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;Shop now&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;&#125;" style="{% render 'media-benefits-root', section: section, part: 'vars', tw: text_width, gap_d: st.col_gap_desktop, gap_m: st.col_gap_mobile %}--m-ar: {{ st.media_aspect_ratio | default: '4/3' }};--m-r: {{ st.media_radius | default: 0 }}px;--m-fit: {{ st.media_fit | default: 'cover' }};--m-ph-bg: {% if own %}{% render 'scheme-color', color: st.media_placeholder_bg, fallback: ph_bg %}{% else %}{{ ph_bg }}{% endif %};--ivb-bgap: {{ st.benefit_gap | default: 0 }}px;--ivb-tile: {{ st.icon_tile_size | default: 36 }}px;--ivb-glyph: {{ st.icon_glyph_size | default: 50 }}%;--ivb-tile-bg: {% if own %}{% render 'scheme-color', color: st.icon_tile_bg, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--ivb-tile-c: {% if own %}{% render 'scheme-color', color: st.icon_tile_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};">
  <div class="ivb__inner mlb__inner">
    <div class="ivb__grid mlb__grid">

      <div class="ivb__media mlb__media mlb__frame" data-mlb-media data-autoplay="{% if media_type == 'video' and st.video_autoplay %}true{% else %}false{% endif %}">
        {%- if media_type == 'video' and st.video != blank -%}
          {{ st.video | video_tag: autoplay: st.video_autoplay, muted: true, playsinline: true, loop: st.video_loop, controls: st.video_controls, image_size: '1400x' }}
        {%- elsif media_type == 'video' and st.video_url != blank -%}
          <video src="{{ st.video_url }}" {% if st.video_autoplay %}autoplay {% endif %}muted {% if st.video_loop %}loop {% endif %}{% if st.video_controls %}controls {% endif %}playsinline preload="metadata"></video>
        {%- elsif st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1200 }}"
            srcset="{{ st.image | image_url: width: 600 }} 600w,
                    {{ st.image | image_url: width: 900 }} 900w,
                    {{ st.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 768px) 50vw, 100vw"
            alt="{{ st.image_alt | default: st.image.alt | escape }}"
            width="{{ st.image.width }}"
            height="{{ st.image.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- else -%}
          <svg class="mlb__ph" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g fill="currentColor"><circle cx="172" cy="124" r="14"/><path d="M140 192l40-46 25 28 20-18 35 36z"/></g></svg>
        {%- endif -%}
      </div>

      <div class="ivb__text mlb__text">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'benefit_list' -%}
              <div class="ivb__list" {{ block.shopify_attributes }}>
                {%- for benefit in benefit_items -%}
                  {%- assign bb = benefit.settings -%}
                  {%- assign bown = bb.enable_custom_style -%}
                  {%- assign icon_src = bb.icon_type | default: 'library' -%}
                  <div class="ivb__benefit" {% render 'media-benefits-block', block: benefit %}>
                    <span class="ivb__benefit-icon" aria-hidden="true" style="--b-ic: {% if bown %}{% render 'scheme-color', color: bb.icon_color, fallback: 'var(--ivb-tile-c)' %}{% else %}var(--ivb-tile-c){% endif %};">
                      {%- case icon_src -%}
                        {%- when 'image' -%}
                          {%- if bb.icon_image != blank -%}<img src="{{ bb.icon_image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">{%- endif -%}
                        {%- when 'svg' -%}
                          {{ bb.icon_svg }}
                        {%- else -%}
                          {%- render 'hp-icon', icon: bb.icon -%}
                      {%- endcase -%}
                    </span>
                    <div class="ivb__benefit-text">
                      <h3 class="ivb__benefit-title"{% if bb.title == blank %} hidden{% endif %} style="--b-c: {% if bown %}{% render 'scheme-color', color: bb.title_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};">{{ bb.title }}</h3>
                      <div class="ivb__benefit-desc"{% if bb.description == blank %} hidden{% endif %} style="--b-c: {% if bown %}{% render 'scheme-color', color: bb.desc_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};">{{ bb.description }}</div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- when 'benefit' -%}
            {%- else -%}
              {%- render 'media-benefits-text', block: block, p: 'ivb' -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if request.design_mode -%}
    {%- for name in icon_names -%}<template data-mlb-icon="{{ name }}">{%- render 'hp-icon', icon: name -%}</template>{%- endfor -%}
  {%- endif -%}
</div>
</template>

<schema>
{
  "type": "image-text-benefits",
  "name": "Image & Video Benefits",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_ratio",
      "label": "Media column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap (content)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "benefit_gap",
      "label": "Gap between benefits",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video URL"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media aspect ratio",
      "default": "4/3",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "media_placeholder_bg",
      "label": "Placeholder background"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Benefit icon tile (defaults)"
    },
    {
      "type": "range",
      "id": "icon_tile_size",
      "label": "Tile size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_glyph_size",
      "label": "Glyph size (% of tile)",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "icon_tile_shape",
      "label": "Tile shape",
      "default": "round",
      "options": [
        {
          "value": "round",
          "label": "Round (pill)"
        },
        {
          "value": "rounded",
          "label": "Rounded square (8px)"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "color",
      "id": "icon_tile_bg",
      "label": "Tile background"
    },
    {
      "type": "color",
      "id": "icon_tile_color",
      "label": "Default icon color"
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Built for everyday brilliance"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Heading color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 38
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 28
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading",
          "default": "<p>A short tagline that sets the tone for the benefits below.</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 16
        }
      ],
      "limit": 1
    },
    {
      "type": "benefit_list",
      "name": "Benefits list (container)",
      "settings": [],
      "limit": 1
    },
    {
      "type": "benefit",
      "name": "Benefit item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "richtext",
