      "label": "Card radius",
      "default": 14,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Author color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "inactive_arrows_color",
      "label": "Arrow color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Content"
    },
    {
