    },
    {
      "type": "range",
      "id": "button_corner",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Button radius",
      "visible_if": "{{ section.settings.use_theme_button == false and section.settings.button_style != 'link' }}",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
