      "label": "Expand quote label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_label",
      "label": "Collapse quote label",
      "default": "Read less"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous button label",
      "default": "Previous testimonials"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next testimonials"
    },
    {
      "type": "header",
      "id": "hdr_44",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
