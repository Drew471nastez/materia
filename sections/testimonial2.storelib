      "options": [
        {
          "value": "color",
          "label": "Filled background"
        },
        {
          "value": "border",
          "label": "Border outline"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Rating color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "empty_stars_color",
      "label": "Empty rating color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "testimonial_color",
      "label": "Quote color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "select",
      "id": "testimonial_text_size",
      "label": "Quote size",
      "options": [
        {
          "value": "12",
          "label": "Small"
        },
        {
          "value": "16",
          "label": "Medium"
        },
        {
          "value": "20",
          "label": "Large"
        }
      ],
      "default": "16",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "testimonial_box_color",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "testimonial_border_color",
      "label": "Card border",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
