      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading and text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "select",
      "id": "testimonial_box_style",
