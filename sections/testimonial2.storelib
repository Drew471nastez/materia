          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "range",
          "id": "stars_rating",
          "min": 0,
          "max": 5,
