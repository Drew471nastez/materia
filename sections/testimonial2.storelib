<template compat="shopify">
{% render 'theme-type' %}
{{ 'testimonial-quote.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonial-quote.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign per_row = s.testimonial_per_row | default: 2 | plus: 0
  assign count = 0
  for block in section.blocks
    if block.type == 'testimonial' and block.hidden != true
      assign count = count | plus: 1
    endif
  endfor
-%}
<section id="Quote-{{ section.id }}" class="tq-section color-{{ scheme }}" style="{% render 'testimonial-quote-vars', controls: s, kind: 'section' %}" data-photos="{% if s.enable_reviewer_photo == false %}false{% else %}true{% endif %}" data-collapse="{% if s.truncate_quotes == false %}false{% else %}true{% endif %}" data-peek="{% if s.show_peek != false and count > per_row %}true{% else %}false{% endif %}" data-testimonial-quote="{{ section.id }}" data-settings="{{ s | json | escape }}">
  <div class="tq-inner"><div class="tq-layout">
    {%- capture intro -%}
      {%- for block in section.blocks -%}
        {%- unless block.hidden -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="tq-heading" style="{% render 'testimonial-quote-vars', controls: block.settings, kind: 'heading' %}" data-quote-block="{{ block.id }}" {% if block.settings.heading == blank %} hidden{% endif %} data-kind="heading" data-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- when 'description' -%}
              <div class="tq-description" style="{% render 'testimonial-quote-vars', controls: block.settings, kind: 'description' %}" data-quote-block="{{ block.id }}" {% if block.settings.description == blank %} hidden{% endif %} data-kind="description" data-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>{{ block.settings.description }}</div>
          {%- endcase -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a style="{% render 'testimonial-quote-vars', controls: s, kind: 'button' %}" class="tq-button{% if s.button_style == 'link' %} tq-button--link{% endif %}"{% unless s.button_style == 'link' %} data-theme-button="primary" data-button-appearance="{% if s.button_style == 'outline' %}outline{% else %}solid{% endif %}" data-sl-button{% endunless %} href="{{ s.button_link | url | escape }}"{% if s.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ s.button_label | escape }}</a>
      {%- endif -%}
    {%- endcapture -%}
    {%- assign intro = intro | strip -%}
    {%- if intro != blank -%}<div class="tq-intro">{{ intro }}</div>{%- endif -%}
    <div class="tq-carousel">
      <ul id="QuoteTrack-{{ section.id }}" class="tq-track" data-testimonial-row data-drag-scroll tabindex="0" aria-label="{{ s.track_label | default: 'Testimonials' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' and block.hidden != true -%}
            {%- liquid
              assign b = block.settings
              assign rating = b.stars_rating | default: 5
              assign star_path = 'M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01z'
              if s.stars_shape == 'heart_stars'
                assign star_path = 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z'
              elsif s.stars_shape == 'pointed_stars'
                assign star_path = 'M12 1l2.7 8.3h8.7l-7 5.1L19.1 23 12 17.9 4.9 23l2.7-8.6-7-5.1h8.7z'
              endif
            -%}
            <li class="tq-card" style="{% render 'testimonial-quote-vars', controls: b, kind: 'testimonial' %}" data-quote-block="{{ block.id }}" data-kind="testimonial" data-block-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
                <div class="tq-rating" aria-label="{{ rating }} / 5"{% if rating == 0 %} hidden{% endif %}>
                  {%- for index in (1..5) -%}
                    {%- assign fill = rating | minus: index | plus: 1 | times: 100 -%}
                    {%- if fill > 100 -%}{%- assign fill = 100 -%}{%- elsif fill < 0 -%}{%- assign fill = 0 -%}{%- endif -%}
                    <span class="tq-star" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="{{ star_path }}" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span style="width:{{ fill }}%"><svg viewBox="0 0 24 24"><path d="{{ star_path }}" fill="{% if s.stars_shape == 'outline_stars' %}none{% else %}currentColor{% endif %}" stroke="currentColor" stroke-width="1.4"/></svg></span></span>
                  {%- endfor -%}
                </div>
              <blockquote class="tq-quote"><p id="QuoteText-{{ section.id }}-{{ block.id }}" class="tq-quote-text">{{ b.testimonial_text | escape }}</p><button class="tq-expand" type="button" aria-expanded="false" aria-controls="QuoteText-{{ section.id }}-{{ block.id }}" hidden>{{ s.read_more_label | default: 'Read more' | escape }}</button></blockquote>
                <div class="tq-author">
                  {%- if s.enable_reviewer_photo != false and b.author_photo != blank -%}<img class="tq-avatar" src="{% render 'offer-image-url', image: b.author_photo, escaped: true %}" alt="{{ b.author_name | escape }}" width="48" height="48" loading="lazy" decoding="async">{%- endif -%}
                  <div><p class="tq-name">{{ b.author_name | escape }}</p><p class="tq-meta">{{ b.author_additional_text | escape }}</p></div>
                </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if count > 1 -%}<div class="tq-navigation"{% if s.show_navigation == false %} hidden{% endif %}><button class="tq-prev" type="button" aria-controls="QuoteTrack-{{ section.id }}" aria-label="{{ s.previous_label | default: 'Previous testimonials' | escape }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button><button class="tq-next" type="button" aria-controls="QuoteTrack-{{ section.id }}" aria-label="{{ s.next_label | default: 'Next testimonials' | escape }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button></div>{%- endif -%}
    </div>
  </div></div>
</section>
</template>

<schema>
{
  "type": "testimonial2",
  "name": "Testimonial Quote Block",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Section width (%)",
      "default": 90
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Introduction width (desktop)",
      "min": 20,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 30
