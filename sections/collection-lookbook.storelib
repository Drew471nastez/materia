        "id": "btn_offset",
        "label": "Space above button",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 6
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show arrows",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Change every",
        "min": 2,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 4,
        "info": "Seconds. Autoplay stops off screen and under reduced motion.",
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause autoplay on hover",
        "default": true,
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "hover_zoom",
        "label": "Image zoom on hover",
        "default": true
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "per_view_mobile",
        "label": "Cards per view (mobile)",
        "min": 1,
        "max": 3,
        "step": 0.1,
        "default": 1.3
      },
      {
        "type": "range",
        "id": "title_size_mobile",
        "label": "Title size (mobile)",
        "min": 12,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Shop the collections"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              }
            ],
            "hidden": true,
            "info": "Legacy: the heading is an h2.",
            "visible_if": "{{ false }}"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "300"
              },
              {
                "value": "400",
                "label": "400"
              },
              {
                "value": "500",
                "label": "500"
              },
              {
                "value": "600",
                "label": "600"
              },
              {
                "value": "700",
                "label": "700"
              },
              {
                "value": "800",
                "label": "800"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 16,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 40,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 14,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 28,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.2,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -3,
            "max": 7,
            "step": 0.1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "select",
            "id": "transform",
            "label": "Case",
            "default": "none",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              },
              {
                "value": "lowercase",
                "label": "Lowercase"
              },
              {
                "value": "capitalize",
                "label": "Capitalize"
              }
            ]
          },
          {
            "type": "header",
            "content": "Spacing"
          },
          {
            "type": "range",
            "id": "gap_top",
            "label": "Space above",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 0
          },
          {
            "type": "range",
            "id": "gap_bottom",
            "label": "Space below",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 0
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Browse our latest curated picks.</p>"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 1000,
            "step": 10,
            "unit": "px",
            "default": 720
          },
          {
            "type": "header",
            "content": "Spacing"
          },
          {
            "type": "range",
            "id": "gap_top",
            "label": "Space above",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 8
          }
        ]
      },
      {
        "type": "card",
        "name": "Collection card",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection",
            "info": "Its title, picture and link are used when the fields below are empty."
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "info": "Defaults to the collection's title."
          },
          {
            "type": "text",
            "id": "kicker",
            "label": "Kicker",
            "default": "YOUR PERFECT FIT"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button label",
            "default": "SHOP NOW"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Defaults to the collection"
          },
          {
            "type": "header",
            "content": "Image"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collection Lookbook",
        "category": "Collections",
        "blocks": [
