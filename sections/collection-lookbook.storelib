<template compat="shopify">
<script src="{{ 'live-collections.js' | asset_url }}" defer="defer"></script>
{%- comment -%} Runtime, once per page (the CSS and hero-image-one.js from layout/theme.storelib, every other script from the tags at the top of this file): shopify/assets/live-collections.js. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes. Collection Lookbook: a carousel of collection cards (a
  picture with a kicker, a title and a button label). A card with a
  collection picked takes its title, picture and link from it; its own
  fields replace them. Arrows, dots, keyboard, drag and autoplay (stopped off
  screen, on hover and under reduced motion) are in live-collections.js
  (loaded on every page), with the live builder updates. Colours follow the
  colour scheme and the button Theme settings > Buttons until Enable custom
  styling / Use theme button style say otherwise.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign head_count = 0
  for block in heading_blocks
    if block.settings.text != blank
      assign head_count = head_count | plus: 1
    endif
  endfor
  for block in sub_blocks
    if block.settings.text != blank
      assign head_count = head_count | plus: 1
    endif
  endfor
  if heading_blocks.size == 0 and st.heading != blank
    assign head_count = head_count | plus: 1
  endif
  if sub_blocks.size == 0 and st.subheading != blank
    assign head_count = head_count | plus: 1
  endif
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      if request.design_mode or block.settings.collection != blank or block.settings.title != blank or block.settings.image != blank or block.settings.link != blank
        assign card_count = card_count | plus: 1
      endif
    endif
  endfor
  assign fit_d = false
  assign fit_t = false
  assign fit_m = false
  if card_count <= st.per_view_desktop
    assign fit_d = true
  endif
  if card_count <= st.per_view_tablet
    assign fit_t = true
  endif
  if card_count <= st.per_view_mobile
    assign fit_m = true
  endif
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; }
  }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if st.enable_custom_fonts -%}
    {{ st.heading_font | font_face: font_display: 'swap' }}
    {{ st.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .lcb {
    font-family: var(--body-font, inherit);
    background: var(--cl-section_bg); color: var(--color-text);
    padding-top: var(--cl-padding_top_mobile); padding-bottom: var(--cl-padding_bottom_mobile);
  }
  #shopify-section-{{ sid }} .lcb, #shopify-section-{{ sid }} .lcb *, #shopify-section-{{ sid }} .lcb *::before, #shopify-section-{{ sid }} .lcb *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .lcb__inner { margin-inline: auto; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .lcb[data-width='container'] .lcb__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .lcb[data-width='fluid_container'] .lcb__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .lcb[data-width='full_width'] .lcb__inner { padding-inline: 0; }

  /* Header */
  #shopify-section-{{ sid }} .lcb__header { text-align: center; max-width: 800px; margin: 0 auto var(--cl-gap_header); }
  #shopify-section-{{ sid }} .lcb[data-align='left'] .lcb__header { text-align: left; margin-left: 0; }
  #shopify-section-{{ sid }} .lcb[data-align='right'] .lcb__header { text-align: right; margin-right: 0; }
  #shopify-section-{{ sid }} .lcb__heading {
    margin: var(--clb-gap_top, 0px) 0 var(--clb-gap_bottom, 0px); font-family: var(--heading-font, inherit);
    color: var(--clb-color, var(--cl-heading_color));
    font-weight: var(--clb-weight, var(--heading-weight, 700));
    font-size: var(--clb-size_mobile, var(--type-h2-size, 28px));
    line-height: var(--clb-line_height, var(--heading-line-height, 1.2));
    letter-spacing: var(--clb-tracking, var(--heading-letter-spacing, normal));
  }
  #shopify-section-{{ sid }} .lcb__heading[data-case] { --heading-text-transform: var(--clb-transform); text-transform: var(--clb-transform); }
  #shopify-section-{{ sid }} .lcb__heading[data-own-size] { --heading-letter-spacing: var(--clb-tracking); --heading-line-height: var(--clb-line_height); }
  #shopify-section-{{ sid }} .lcb__heading--legacy { margin: 0; font-weight: var(--cl-heading_weight); font-size: var(--cl-heading_size_mobile); }
  #shopify-section-{{ sid }} .lcb__sub {
    margin: var(--clb-gap_top, var(--cl-gap_heading_sub)) auto 0; max-width: var(--clb-max_width, 720px);
    color: var(--clb-color, var(--cl-sub_color));
    font-size: var(--clb-size, var(--body-font-size, 16px)); line-height: var(--clb-line_height, var(--body-line-height, 1.55));
  }
  #shopify-section-{{ sid }} .lcb[data-align='left'] .lcb__sub { margin-left: 0; }
  #shopify-section-{{ sid }} .lcb[data-align='right'] .lcb__sub { margin-right: 0; }
  #shopify-section-{{ sid }} .lcb__sub--legacy { font-size: var(--cl-sub_size); }
  #shopify-section-{{ sid }} .lcb__sub > * { margin: 0; color: inherit; }
  #shopify-section-{{ sid }} [hidden]:is(.lcb__header, .lcb__heading, .lcb__sub, .lcb__kicker, .lcb__title, .lcb__btn, .lcb__arrow, .lcb__dots) { display: none !important; }

  /* Carousel: a row that scrolls and snaps to each card */
  #shopify-section-{{ sid }} .lcb__viewport { position: relative; }
  #shopify-section-{{ sid }} .lcb__track {
    --pv: var(--cl-per_view_mobile);
    display: flex; gap: var(--cl-card_gap); overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; overscroll-behavior-x: contain;
    padding-block: var(--cl-hover_breath); margin-block: calc(-1 * var(--cl-hover_breath));
    cursor: grab; touch-action: pan-x pan-y;
  }
  #shopify-section-{{ sid }} .lcb__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .lcb__track:focus-visible { outline: 2px solid var(--cl-controls_color); outline-offset: 4px; }
  #shopify-section-{{ sid }} .lcb__track.is-dragging { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; user-select: none; }
  #shopify-section-{{ sid }} .lcb__slide { flex: 0 0 calc((100% - (var(--pv) - 1) * var(--cl-card_gap)) / var(--pv)); min-width: 0; scroll-snap-align: start; }
  #shopify-section-{{ sid }} .lcb__card {
    position: relative; display: block; width: 100%; aspect-ratio: var(--cl-card_aspect);
    border-radius: var(--cl-card_radius); overflow: hidden; isolation: isolate;
    background: var(--cl-card_bg); color: var(--cl-card_text_color); text-decoration: none;
    transition: transform .45s cubic-bezier(.22,1,.36,1), box-shadow .45s ease;
  }
  #shopify-section-{{ sid }} a.lcb__card:focus-visible { outline: 2px solid var(--cl-controls_color); outline-offset: 3px; }
  #shopify-section-{{ sid }} .lcb__bg, #shopify-section-{{ sid }} .lcb__ph {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--cl-image_position);
    display: block; pointer-events: none; transition: transform .8s cubic-bezier(.22,1,.36,1);
  }
  #shopify-section-{{ sid }} .lcb__ph { fill: color-mix(in srgb, #ffffff 18%, transparent); }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .lcb[data-zoom='true'] .lcb__card:hover :is(.lcb__bg, .lcb__ph) { transform: scale(1.05); }
    #shopify-section-{{ sid }} a.lcb__card:hover { transform: translateY(calc(-0.5 * var(--cl-hover_breath))); box-shadow: 0 14px 28px -18px rgba(0,0,0,.45); }
  }
  #shopify-section-{{ sid }} .lcb__overlay { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgb(0 0 0 / var(--cl-overlay_opacity_top)) 0%, rgb(0 0 0 / var(--cl-overlay_opacity_bottom)) 100%); }
  #shopify-section-{{ sid }} .lcb__content {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
    justify-content: var(--cl-content_vertical); text-align: center;
    padding: var(--cl-card_pad); gap: var(--cl-card_gap_inner);
  }
  #shopify-section-{{ sid }} .lcb__kicker {
    margin: 0; color: var(--cl-kicker_color); font-size: var(--cl-kicker_size); font-weight: var(--cl-kicker_weight);
    letter-spacing: var(--cl-kicker_tracking); text-transform: var(--cl-kicker_transform); line-height: 1.2; overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .lcb__title {
    margin: 0; font-family: var(--heading-font, inherit); color: var(--cl-title_color);
    font-size: var(--cl-title_size_mobile); font-weight: var(--cl-title_weight); line-height: 1.15;
    letter-spacing: var(--cl-title_tracking); overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .lcb__title[data-own-size] { --heading-letter-spacing: var(--cl-title_tracking); }
  #shopify-section-{{ sid }} .lcb[data-title-case] .lcb__title { --heading-text-transform: var(--cl-title_transform); text-transform: var(--cl-title_transform); }
  #shopify-section-{{ sid }} .lcb__btn {
    display: inline-flex; align-items: center; justify-content: center; margin-top: var(--cl-btn_offset);
    background: var(--cl-btn_bg); color: var(--cl-btn_color);
    padding: var(--cl-btn_pad_y) var(--cl-btn_pad_x); border-radius: var(--cl-btn_radius);
    font-family: var(--btn-font, var(--body-font, inherit)); font-size: var(--cl-btn_size); font-weight: var(--cl-btn_weight);
    letter-spacing: var(--cl-btn_tracking); text-transform: var(--cl-btn_transform);
    white-space: nowrap; line-height: 1; min-height: 36px;
    transition: background-color var(--btn-anim-duration, .25s) ease, color var(--btn-anim-duration, .25s) ease;
  }
  #shopify-section-{{ sid }} .lcb__card:is(:hover, :focus-visible) .lcb__btn { background: var(--cl-btn_bg_hover); color: var(--cl-btn_color_hover); }

  /* Arrows and dots */
  #shopify-section-{{ sid }} .lcb__controls { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: var(--cl-gap_controls); }
  #shopify-section-{{ sid }} .lcb__arrow {
    width: 44px; height: 44px; border-radius: 999px; padding: 0; cursor: pointer;
    border: 1px solid var(--color-border); background: transparent; color: var(--cl-controls_color);
    display: inline-flex; align-items: center; justify-content: center;
    transition: background-color .2s ease, opacity .2s ease;
  }
  #shopify-section-{{ sid }} .lcb__arrow:hover { background: color-mix(in srgb, var(--cl-controls_color) 10%, transparent); }
  #shopify-section-{{ sid }} .lcb__arrow:focus-visible, #shopify-section-{{ sid }} .lcb__dot:focus-visible { outline: 2px solid var(--cl-controls_color); outline-offset: 2px; }
  #shopify-section-{{ sid }} .lcb__arrow svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .lcb__arrow[aria-disabled='true'] { opacity: .35; cursor: default; }
  #shopify-section-{{ sid }} .lcb__dots { display: inline-flex; align-items: center; }
  #shopify-section-{{ sid }} .lcb__dot { position: relative; width: calc(var(--cl-dot_size) + 12px); height: 44px; border: 0; padding: 0; background: none; cursor: pointer; transition: width .25s ease; }
  #shopify-section-{{ sid }} .lcb__dot::after { content: ''; position: absolute; left: 6px; right: 6px; top: 50%; height: var(--cl-dot_size); transform: translateY(-50%); border-radius: 999px; background: var(--cl-dot_color); transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .lcb__dot[aria-current='true'] { width: calc(var(--cl-dot_size_active) + 12px); }
  #shopify-section-{{ sid }} .lcb__dot[aria-current='true']::after { background: var(--cl-dot_active_color); }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .lcb[data-fit-m='true'] .lcb__controls { display: none; } }
  @media (min-width: 768px) and (max-width: 1099px) { #shopify-section-{{ sid }} .lcb[data-fit-t='true'] .lcb__controls { display: none; } }
  @media (min-width: 1100px) { #shopify-section-{{ sid }} .lcb[data-fit-d='true'] .lcb__controls { display: none; } }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .lcb { padding-top: var(--cl-padding_top_desktop); padding-bottom: var(--cl-padding_bottom_desktop); }
    #shopify-section-{{ sid }} .lcb__heading { font-size: var(--clb-size_desktop, var(--type-h2-size, 40px)); }
    #shopify-section-{{ sid }} .lcb__heading--legacy { font-size: var(--cl-heading_size_desktop); }
    #shopify-section-{{ sid }} .lcb__title { font-size: var(--cl-title_size_desktop); }
    #shopify-section-{{ sid }} .lcb__track { --pv: var(--cl-per_view_tablet); }
  }
  @media (min-width: 1100px) {
    #shopify-section-{{ sid }} .lcb__track { --pv: var(--cl-per_view_desktop); }
  }
  #shopify-section-{{ sid }} .lcb[data-show-on='mobile'] { display: none; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .lcb[data-show-on='mobile'] { display: block; } #shopify-section-{{ sid }} .lcb[data-show-on='desktop'] { display: none; } }
  #shopify-section-{{ sid }} .lcb__empty { margin: 0; padding: 24px 16px; text-align: center; font-size: 14px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .lcb__track { scroll-behavior: auto; }
    #shopify-section-{{ sid }} :is(.lcb__bg, .lcb__ph, .lcb__card, .lcb__btn, .lcb__dot, .lcb__dot::after) { transition: none; }
    #shopify-section-{{ sid }} .lcb__card:hover :is(.lcb__bg, .lcb__ph), #shopify-section-{{ sid }} a.lcb__card:hover { transform: none !important; }
  }
{% comment %}{% endcomment %}</style>

<section class="lcb color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}" data-width="{{ st.section_width | default: 'stretch_width' }}" data-fit-d="{{ fit_d }}" data-fit-t="{{ fit_t }}" data-fit-m="{{ fit_m }}"{% if st.title_transform != blank and st.title_transform != 'none' %} data-title-case{% endif %} {% capture cl_json %}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"show_section_on":{{ section.settings.show_section_on | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"heading":{{ section.settings.heading | append: '' | json }},"heading_tag":{{ section.settings.heading_tag | append: '' | json }},"subheading":{{ section.settings.subheading | append: '' | json }},"header_align":{{ section.settings.header_align | append: '' | json }},"gap_heading_sub":{{ section.settings.gap_heading_sub | default: 0 | json }},"gap_header":{{ section.settings.gap_header | default: 0 | json }},"per_view_desktop":{{ section.settings.per_view_desktop | default: 0 | json }},"per_view_tablet":{{ section.settings.per_view_tablet | default: 0 | json }},"card_gap":{{ section.settings.card_gap | default: 0 | json }},"card_aspect":{{ section.settings.card_aspect | append: '' | json }},"content_vertical":{{ section.settings.content_vertical | append: '' | json }},"card_pad":{{ section.settings.card_pad | default: 0 | json }},"card_gap_inner":{{ section.settings.card_gap_inner | default: 0 | json }},"hover_breath":{{ section.settings.hover_breath | default: 0 | json }},"gap_controls":{{ section.settings.gap_controls | default: 0 | json }},"image_position":{{ section.settings.image_position | append: '' | json }},"overlay_opacity_top":{{ section.settings.overlay_opacity_top | default: 0 | json }},"overlay_opacity_bottom":{{ section.settings.overlay_opacity_bottom | default: 0 | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"heading_color":{{ section.settings.heading_color | append: '' | json }},"sub_color":{{ section.settings.sub_color | append: '' | json }},"card_bg":{{ section.settings.card_bg | append: '' | json }},"card_text_color":{{ section.settings.card_text_color | append: '' | json }},"kicker_color":{{ section.settings.kicker_color | append: '' | json }},"title_color":{{ section.settings.title_color | append: '' | json }},"btn_bg":{{ section.settings.btn_bg | append: '' | json }},"btn_color":{{ section.settings.btn_color | append: '' | json }},"btn_bg_hover":{{ section.settings.btn_bg_hover | append: '' | json }},"btn_color_hover":{{ section.settings.btn_color_hover | append: '' | json }},"controls_color":{{ section.settings.controls_color | append: '' | json }},"dot_color":{{ section.settings.dot_color | append: '' | json }},"dot_active_color":{{ section.settings.dot_active_color | append: '' | json }},"card_radius":{{ section.settings.card_radius | default: 0 | json }},"dot_size":{{ section.settings.dot_size | default: 0 | json }},"dot_size_active":{{ section.settings.dot_size_active | default: 0 | json }},"heading_weight":{{ section.settings.heading_weight | append: '' | json }},"heading_size_desktop":{{ section.settings.heading_size_desktop | default: 0 | json }},"heading_size_mobile":{{ section.settings.heading_size_mobile | default: 0 | json }},"sub_size":{{ section.settings.sub_size | default: 0 | json }},"kicker_size":{{ section.settings.kicker_size | default: 0 | json }},"kicker_weight":{{ section.settings.kicker_weight | append: '' | json }},"kicker_tracking":{{ section.settings.kicker_tracking | default: 0 | json }},"kicker_transform":{{ section.settings.kicker_transform | append: '' | json }},"title_size_desktop":{{ section.settings.title_size_desktop | default: 0 | json }},"title_weight":{{ section.settings.title_weight | append: '' | json }},"title_tracking":{{ section.settings.title_tracking | default: 0 | json }},"title_transform":{{ section.settings.title_transform | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"use_theme_button":{% if section.settings.use_theme_button %}true{% else %}false{% endif %},"btn_radius":{{ section.settings.btn_radius | default: 0 | json }},"btn_size":{{ section.settings.btn_size | default: 0 | json }},"btn_weight":{{ section.settings.btn_weight | append: '' | json }},"btn_tracking":{{ section.settings.btn_tracking | default: 0 | json }},"btn_transform":{{ section.settings.btn_transform | append: '' | json }},"btn_pad_x":{{ section.settings.btn_pad_x | default: 0 | json }},"btn_pad_y":{{ section.settings.btn_pad_y | default: 0 | json }},"btn_offset":{{ section.settings.btn_offset | default: 0 | json }},"show_arrows":{% if section.settings.show_arrows %}true{% else %}false{% endif %},"show_dots":{% if section.settings.show_dots %}true{% else %}false{% endif %},"autoplay":{% if section.settings.autoplay %}true{% else %}false{% endif %},"autoplay_speed":{{ section.settings.autoplay_speed | default: 0 | json }},"pause_on_hover":{% if section.settings.pause_on_hover %}true{% else %}false{% endif %},"hover_zoom":{% if section.settings.hover_zoom %}true{% else %}false{% endif %},"padding_top_desktop":{{ section.settings.padding_top_desktop | default: 0 | json }},"padding_bottom_desktop":{{ section.settings.padding_bottom_desktop | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"per_view_mobile":{{ section.settings.per_view_mobile | default: 0 | json }},"title_size_mobile":{{ section.settings.title_size_mobile | default: 0 | json }},"padding_top_mobile":{{ section.settings.padding_top_mobile | default: 0 | json }},"padding_bottom_mobile":{{ section.settings.padding_bottom_mobile | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-padding_top_desktop: {{ section.settings.padding_top_desktop | default: 0 }}px;--cl-padding_bottom_desktop: {{ section.settings.padding_bottom_desktop | default: 0 }}px;--cl-padding_top_mobile: {{ section.settings.padding_top_mobile | default: 0 }}px;--cl-padding_bottom_mobile: {{ section.settings.padding_bottom_mobile | default: 0 }}px;--cl-gap_header: {{ section.settings.gap_header | default: 0 }}px;--cl-gap_heading_sub: {{ section.settings.gap_heading_sub | default: 0 }}px;--cl-gap_controls: {{ section.settings.gap_controls | default: 0 }}px;--cl-card_gap: {{ section.settings.card_gap | default: 0 }}px;--cl-per_view_desktop: {{ section.settings.per_view_desktop | default: 0 }};--cl-per_view_tablet: {{ section.settings.per_view_tablet | default: 0 }};--cl-per_view_mobile: {{ section.settings.per_view_mobile | default: 0 }};--cl-card_aspect: {{ section.settings.card_aspect }};--cl-card_radius: {{ section.settings.card_radius | default: 0 }}px;--cl-hover_breath: {{ section.settings.hover_breath | default: 0 }}px;--cl-image_position: {{ section.settings.image_position }};--cl-overlay_opacity_top: {{ section.settings.overlay_opacity_top | default: 0 }};--cl-overlay_opacity_bottom: {{ section.settings.overlay_opacity_bottom | default: 0 }};--cl-content_vertical: {{ section.settings.content_vertical }};--cl-card_pad: {{ section.settings.card_pad | default: 0 }}px;--cl-card_gap_inner: {{ section.settings.card_gap_inner | default: 0 }}px;--cl-kicker_size: {{ section.settings.kicker_size | default: 0 }}px;--cl-kicker_weight: {{ section.settings.kicker_weight }};--cl-kicker_tracking: {{ section.settings.kicker_tracking | default: 0 }}px;--cl-kicker_transform: {{ section.settings.kicker_transform }};--cl-title_size_desktop: {{ section.settings.title_size_desktop | default: 0 }}px;--cl-title_size_mobile: {{ section.settings.title_size_mobile | default: 0 }}px;--cl-title_weight: {% if section.settings.title_weight == blank or section.settings.title_weight == 'theme' %}var(--heading-weight, 600){% else %}{{ section.settings.title_weight }}{% endif %};--cl-title_tracking: {{ section.settings.title_tracking | default: 0 }}px;--cl-title_transform: {{ section.settings.title_transform }};--cl-heading_size_desktop: {{ section.settings.heading_size_desktop | default: 0 }}px;--cl-heading_size_mobile: {{ section.settings.heading_size_mobile | default: 0 }}px;--cl-sub_size: {{ section.settings.sub_size | default: 0 }}px;--cl-heading_weight: {% if section.settings.heading_weight == blank or section.settings.heading_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ section.settings.heading_weight }}{% endif %};--cl-dot_size: {{ section.settings.dot_size | default: 0 }}px;--cl-dot_size_active: {{ section.settings.dot_size_active | default: 0 }}px;--cl-btn_offset: {{ section.settings.btn_offset | default: 0 }}px;{% if section.settings.use_theme_button %}--cl-btn_radius: var(--btn-radius, 4px);{% else %}--cl-btn_radius: {{ section.settings.btn_radius | default: 0 }}px;{% endif %}{% if section.settings.use_theme_button %}--cl-btn_size: var(--btn-font-size, 14px);{% else %}--cl-btn_size: {{ section.settings.btn_size | default: 0 }}px;{% endif %}{% if section.settings.use_theme_button %}--cl-btn_weight: var(--btn-font-weight, 600);{% else %}--cl-btn_weight: {{ section.settings.btn_weight }};{% endif %}{% if section.settings.use_theme_button %}--cl-btn_tracking: var(--btn-letter-spacing, 0px);{% else %}--cl-btn_tracking: {{ section.settings.btn_tracking | default: 0 }}px;{% endif %}{% if section.settings.use_theme_button %}--cl-btn_transform: var(--btn-text-transform, none);{% else %}--cl-btn_transform: {{ section.settings.btn_transform }};{% endif %}{% if section.settings.use_theme_button %}--cl-btn_pad_x: var(--btn-padding-x, 22px);{% else %}--cl-btn_pad_x: {{ section.settings.btn_pad_x | default: 0 }}px;{% endif %}{% if section.settings.use_theme_button %}--cl-btn_pad_y: var(--btn-padding-y, 10px);{% else %}--cl-btn_pad_y: {{ section.settings.btn_pad_y | default: 0 }}px;{% endif %}{% if section.settings.enable_custom_style %}--cl-section_bg: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};{% else %}--cl-section_bg: var(--color-background);{% endif %}{% if section.settings.enable_custom_style %}--cl-heading_color: {% render 'scheme-color', color: section.settings.heading_color, fallback: 'var(--color-heading)' %};{% else %}--cl-heading_color: var(--color-heading);{% endif %}{% if section.settings.enable_custom_style %}--cl-sub_color: {% render 'scheme-color', color: section.settings.sub_color, fallback: 'var(--color-text)' %};{% else %}--cl-sub_color: var(--color-text);{% endif %}{% if section.settings.enable_custom_style %}--cl-card_bg: {% render 'scheme-color', color: section.settings.card_bg, fallback: '#1f2937' %};{% else %}--cl-card_bg: #1f2937;{% endif %}{% if section.settings.enable_custom_style %}--cl-card_text_color: {% render 'scheme-color', color: section.settings.card_text_color, fallback: '#ffffff' %};{% else %}--cl-card_text_color: #ffffff;{% endif %}{% if section.settings.enable_custom_style %}--cl-kicker_color: {% render 'scheme-color', color: section.settings.kicker_color, fallback: 'var(--cl-card_text_color)' %};{% else %}--cl-kicker_color: var(--cl-card_text_color);{% endif %}{% if section.settings.enable_custom_style %}--cl-title_color: {% render 'scheme-color', color: section.settings.title_color, fallback: 'var(--cl-card_text_color)' %};{% else %}--cl-title_color: var(--cl-card_text_color);{% endif %}{% if section.settings.enable_custom_style %}--cl-btn_bg: {% render 'scheme-color', color: section.settings.btn_bg, fallback: 'var(--btn-primary-bg-color)' %};{% else %}--cl-btn_bg: var(--btn-primary-bg-color);{% endif %}{% if section.settings.enable_custom_style %}--cl-btn_color: {% render 'scheme-color', color: section.settings.btn_color, fallback: 'var(--btn-primary-color)' %};{% else %}--cl-btn_color: var(--btn-primary-color);{% endif %}{% if section.settings.enable_custom_style %}--cl-btn_bg_hover: {% render 'scheme-color', color: section.settings.btn_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};{% else %}--cl-btn_bg_hover: var(--btn-primary-hover-bg-color);{% endif %}{% if section.settings.enable_custom_style %}--cl-btn_color_hover: {% render 'scheme-color', color: section.settings.btn_color_hover, fallback: 'var(--btn-primary-hover-color)' %};{% else %}--cl-btn_color_hover: var(--btn-primary-hover-color);{% endif %}{% if section.settings.enable_custom_style %}--cl-controls_color: {% render 'scheme-color', color: section.settings.controls_color, fallback: 'var(--color-heading)' %};{% else %}--cl-controls_color: var(--color-heading);{% endif %}{% if section.settings.enable_custom_style %}--cl-dot_color: {% render 'scheme-color', color: section.settings.dot_color, fallback: 'var(--color-border)' %};{% else %}--cl-dot_color: var(--color-border);{% endif %}{% if section.settings.enable_custom_style %}--cl-dot_active_color: {% render 'scheme-color', color: section.settings.dot_active_color, fallback: 'var(--color-heading)' %};{% else %}--cl-dot_active_color: var(--color-heading);{% endif %}{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="collection-lookbook" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default-color-scheme","section_width":"stretch_width","show_section_on":"all","reset_spacing":true,"heading_tag":"h2","header_align":"center","gap_heading_sub":8,"gap_header":28,"per_view_desktop":5,"per_view_tablet":3,"card_gap":16,"card_aspect":"3 / 4","content_vertical":"center","card_pad":20,"card_gap_inner":12,"hover_breath":16,"gap_controls":24,"image_position":"center","overlay_opacity_top":0.1,"overlay_opacity_bottom":0.5,"enable_custom_style":false,"card_radius":8,"dot_size":8,"dot_size_active":22,"heading_weight":"theme","heading_size_desktop":40,"heading_size_mobile":28,"sub_size":16,"kicker_size":11,"kicker_weight":"500","kicker_tracking":2,"kicker_transform":"uppercase","title_size_desktop":28,"title_weight":"theme","title_tracking":0,"title_transform":"none","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","use_theme_button":true,"btn_radius":4,"btn_size":12,"btn_weight":"600","btn_tracking":1,"btn_transform":"uppercase","btn_pad_x":22,"btn_pad_y":10,"btn_offset":6,"show_arrows":true,"show_dots":true,"autoplay":false,"autoplay_speed":4,"pause_on_hover":true,"hover_zoom":true,"padding_top_desktop":64,"padding_bottom_desktop":64,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"per_view_mobile":1.3,"title_size_mobile":22,"padding_top_mobile":32,"padding_bottom_mobile":32,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-cl-block-defaults='{"heading":{"text":"Shop the collections","tag":"h2","enable_custom_style":false,"weight":"theme","size_enable":false,"size_desktop":40,"size_mobile":28,"line_height":1.2,"tracking":0,"transform":"none","gap_top":0,"gap_bottom":0},"subheading":{"text":"<p>Browse our latest curated picks.</p>","enable_custom_style":false,"size_enable":false,"size":16,"line_height":1.5,"max_width":720,"gap_top":8},"card":{"kicker":"YOUR PERFECT FIT","button_text":"SHOP NOW"}}' style="{{ cl_vars | strip }}" data-align="{{ section.settings.header_align }}" data-show-on="{{ section.settings.show_section_on }}" data-zoom="{% if section.settings.hover_zoom %}true{% else %}false{% endif %}"{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  <div class="lcb__inner">
    <div class="lcb__header"{% if head_count == 0 %} hidden{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- if block.type == 'heading' -%}
          <h2 class="lcb__heading" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"tag":{{ block.settings.tag | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"weight":{{ block.settings.weight | append: '' | json }},"size_enable":{% if block.settings.size_enable %}true{% else %}false{% endif %},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }},"line_height":{{ block.settings.line_height | default: 0 | json }},"tracking":{{ block.settings.tracking | default: 0 | json }},"transform":{{ block.settings.transform | append: '' | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }},"gap_bottom":{{ block.settings.gap_bottom | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--cl-heading_color)' %};{% endif %}--clb-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %};{% if block.settings.size_enable %}--clb-size_desktop: {{ block.settings.size_desktop | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-size_mobile: {{ block.settings.size_mobile | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-line_height: {{ block.settings.line_height | default: 0 }};{% endif %}{% if block.settings.size_enable %}--clb-tracking: {{ block.settings.tracking | default: 0 }}px;{% endif %}--clb-transform: {{ block.settings.transform }};--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;--clb-gap_bottom: {{ block.settings.gap_bottom | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="heading" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if block.settings.size_enable %} data-own-size=""{% endif %}{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if bs.transform != blank and bs.transform != 'none' %} data-case{% endif %}{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
        {%- elsif block.type == 'subheading' -%}
          <div class="lcb__sub" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_enable":{% if block.settings.size_enable %}true{% else %}false{% endif %},"size":{{ block.settings.size | default: 0 | json }},"line_height":{{ block.settings.line_height | default: 0 | json }},"max_width":{{ block.settings.max_width | default: 0 | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--cl-sub_color)' %};{% endif %}{% if block.settings.size_enable %}--clb-size: {{ block.settings.size | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-line_height: {{ block.settings.line_height | default: 0 }};{% endif %}--clb-max_width: {{ block.settings.max_width | default: 0 }}px;--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="subheading" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endif -%}
      {%- endfor -%}
      {%- if heading_blocks.size == 0 and st.heading != blank -%}
        <h2 class="lcb__heading lcb__heading--legacy" data-cl-legacy="heading"{% if st.heading_weight != blank and st.heading_weight != 'theme' %} data-own-weight{% endif %}>{{ st.heading | escape }}</h2>
      {%- endif -%}
      {%- if sub_blocks.size == 0 and st.subheading != blank -%}
        <p class="lcb__sub lcb__sub--legacy" data-cl-legacy="subheading">{{ st.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if card_count > 0 -%}
    <div class="lcb__viewport">
      <div class="lcb__track" data-lcb-track tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ 'accessibility.collection' | t | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- liquid
              assign bs = block.settings
              assign coll = bs.collection
              assign href = bs.link | default: coll.url
              assign card_title = bs.title
              if card_title == blank and coll != blank
                assign card_title = coll.title
              endif
              assign img = bs.image
              if img == blank and coll != blank
                if coll.image != blank
                  assign img = coll.image
                elsif coll.products.first.featured_image != blank
                  assign img = coll.products.first.featured_image
                endif
              endif
              assign tag = 'div'
              if href != blank
                assign tag = 'a'
              endif
            -%}
            {%- if request.design_mode or coll != blank or bs.title != blank or bs.image != blank or bs.link != blank -%}
            <div class="lcb__slide" {% capture clb_json %}{"collection":{{ block.settings.collection.handle | append: '' | json }},"title":{{ block.settings.title | append: '' | json }},"kicker":{{ block.settings.kicker | append: '' | json }},"button_text":{{ block.settings.button_text | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %}}{% endcapture %}{% capture clb_vars %}{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="card" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-coll-title="{{ coll.title | escape }}" data-cl-coll-url="{{ coll.url }}" {{ block.shopify_attributes }}>
              <{{ tag }} class="lcb__card"{% if tag == 'a' %} href="{{ href }}" draggable="false"{% endif %}>
                {%- if img != blank -%}
                  <img class="lcb__bg" src="{{ img | image_url: width: 800 }}" alt="{{ card_title | escape }}" draggable="false" loading="lazy" width="{{ img.width }}" height="{{ img.height }}">
                {%- elsif request.design_mode -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'lcb__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
                {%- endif -%}
                <span class="lcb__overlay" aria-hidden="true"></span>
                <div class="lcb__content">
                  <span class="lcb__kicker"{% if bs.kicker == blank %} hidden{% endif %}>{{ bs.kicker | escape }}</span>
                  <h3 class="lcb__title"{% if st.title_weight != blank and st.title_weight != 'theme' %} data-own-weight{% endif %}{% if st.title_tracking != 0 %} data-own-size{% endif %}{% if card_title == blank %} hidden{% endif %}>{{ card_title | escape }}</h3>
                  <span class="lcb__btn"{% if bs.button_text == blank %} hidden{% endif %}>{{ bs.button_text | escape }}</span>
                </div>
              </{{ tag }}>
            </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="lcb__controls" data-lcb-controls>
      <button type="button" class="lcb__arrow" data-lcb-prev aria-label="{{ 'accessibility.previous' | t | escape }}" aria-disabled="true"{% unless st.show_arrows %} hidden{% endunless %}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="lcb__dots" data-lcb-dots{% unless st.show_dots %} hidden{% endunless %}>
        {%- for i in (1..card_count) -%}
          <button type="button" class="lcb__dot" data-lcb-dot="{{ forloop.index0 }}" aria-label="{{ 'accessibility.go_to_slide' | t | escape }} {{ i }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button type="button" class="lcb__arrow" data-lcb-next aria-label="{{ 'accessibility.next' | t | escape }}"{% unless st.show_arrows %} hidden{% endunless %}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
    {%- elsif request.design_mode -%}
      <p class="lcb__empty">Add a Collection card block to show your first card.</p>
    {%- endif -%}
  </div>
</section>
</template>

<schema>
{
  "type": "collection-lookbook",
  "name": "Collection Lookbook",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "stretch_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "hidden": true,
      "info": "Legacy: used only when the section has no Heading block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "hidden": true,
      "info": "Legacy: the heading is an h2.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "hidden": true,
      "info": "Legacy: used only when the section has no Subheading block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
