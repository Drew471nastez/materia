<template compat="shopify">
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- comment -%}
  One rule per colour block, for the swatches that carry the class
  custom__color-swatches--<name> (product options, quick edit, filters). Only
  what was set is written: an empty colour no longer prints
  "background-color: !important" with "background-image: initial", which
  wiped the swatch's own picture. The class is matched as an attribute value,
  so a name like "Black/White" still matches, and the filters' handle form
  gets the same rule.
{%- endcomment -%}
{%- capture colors -%}
  {%- for block in section.blocks -%}
    {%- assign block_st = block.settings -%}
    {%- assign has_color = false -%}
    {%- if block_st.color_code != blank and block_st.color_code.alpha != 0 -%}{%- assign has_color = true -%}{%- endif -%}
    {%- if block_st.heading != blank -%}
      {%- if has_color or block_st.color_image != blank -%}
        {%- assign color_name = block_st.heading | downcase | replace: ' ', '-' | replace: '"', "'" | remove: '<' -%}
        {%- assign color_handle = block_st.heading | handleize -%}
        [class~="custom__color-swatches--{{ color_name }}"]{% if color_handle != color_name %},.custom__color-swatches--{{ color_handle }}{% endif %}{
          {%- if block_st.color_image == blank -%}
            background-color:{{ block_st.color_code }} !important;background-image:none !important;
          {%- else -%}
            background:{% if has_color %}{{ block_st.color_code }} {% endif %}url({{ block_st.color_image | image_url: width: 80 }}) no-repeat 50% 50%/cover !important;
          {%- endif -%}
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign colors = colors | strip_newlines | strip -%}
{%- if colors != blank -%}<style data-custom-colors>{{ colors }}{% comment %}{% endcomment %}</style>{%- endif %}

</template>

<schema>
{
  "type": "custom-colors",
  "name": "Custom colors",
  "settings": [],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "color_code",
          "label": "Color code"
        },
        {
          "type": "image_picker",
          "id": "color_image",
          "label": "Color image"
        }
      ]
    }
  ],
  "shopify": {
    "name": "Custom colors",
    "settings": [],
    "blocks": [
      {
        "type": "color",
        "name": "Color",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Color name",
            "info": "As written in the product option, e.g. Azure"
          },
          {
            "type": "color",
            "id": "color_code",
            "label": "Color"
          },
          {
            "type": "image_picker",
            "id": "color_image",
            "label": "Pattern image"
          }
        ]
      }
    ]
  }
}
</schema>
