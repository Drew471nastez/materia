  "shopify": {
    "name": "Gallery Interactive 2",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "display_section_on",
        "label": "Show section on",
        "options": [
          {
            "value": "all_devices",
            "label": "All Devices"
          },
          {
            "value": "mobile_only",
            "label": "Mobile Devices Only"
          },
          {
            "value": "desktop_only",
            "label": "Desktop / Larger Screens Only"
          },
          {
            "value": "no_devices",
            "label": "No Devices"
          }
        ],
        "default": "all_devices"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove the theme's space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "gallery_height_desktop",
        "label": "Gallery height (desktop, % of screen)",
        "min": 30,
        "max": 90,
        "step": 5,
        "default": 70
      },
      {
        "type": "range",
        "id": "expand_ratio",
        "label": "Opened image width",
        "info": "How many times wider the opened image is than the others.",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 7
      },
      {
        "type": "range",
        "id": "image_gap",
        "label": "Gap between images",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "vertical_space_title_subheading",
