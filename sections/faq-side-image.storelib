<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_faq_image_placeholder = 'accessibility.faq_image_placeholder' | t -%}
{%- assign fb_accessibility_question_goes_here = 'accessibility.question_goes_here' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — FAQ 6 (Side image)
  Heading + subheading + accordion list on the left, product image on
  the right. Image gracefully falls back to a placeholder when no
  image is uploaded so the section reads cleanly even before the
  merchant has assets ready. Smooth open/close animation matches FAQ 5.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign items = section.blocks | where: 'type', 'faq_item'

  assign img_pos = st.image_position | default: 'right'
  assign show_on_mobile = st.show_image_on_mobile
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *::before,
  #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) { font-family: var(--heading-font, inherit); }

  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom | default: 0 }}px;
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .fsi {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding: {{ st.padding_top_mobile | default: 56 }}px 1.25rem {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi {
      padding: {{ st.padding_top_desktop | default: 96 }}px 2rem {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  #shopify-section-{{ sid }} .fsi__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: {{ st.max_width | default: 1280 }}px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(32px, 5vw, 80px);
    }
    {%- if img_pos == 'left' -%}
      #shopify-section-{{ sid }} .fsi__media { order: 1; }
      #shopify-section-{{ sid }} .fsi__content { order: 2; }
    {%- else -%}
      #shopify-section-{{ sid }} .fsi__content { order: 1; }
      #shopify-section-{{ sid }} .fsi__media { order: 2; }
    {%- endif -%}
  }

  /* Hide the image on mobile when the merchant turns it off */
  {%- unless show_on_mobile -%}
    @media (max-width: 1023px) {
      #shopify-section-{{ sid }} .fsi__media { display: none; }
    }
  {%- endunless -%}

  /* Header */
  #shopify-section-{{ sid }} .fsi__heading {
    margin: 0 0 14px;
    color: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %};
    font-size: {{ st.heading_size_mobile | default: 36 }}px;
    line-height: 1.05;
    font-weight: {% if st.heading_weight == blank or st.heading_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ st.heading_weight }}{% endif %};
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi__heading { font-size: {{ st.heading_size_desktop | default: 56 }}px; }
  }
  #shopify-section-{{ sid }} .fsi__sub {
    margin: 0 0 28px;
    color: {% render 'scheme-color', color: st.sub_color, fallback: 'var(--color-text)' %};
    font-size: 15px;
    line-height: 1.55;
    max-width: 540px;
  }
  #shopify-section-{{ sid }} .fsi__sub > * { margin: 0; }

  /* Accordion list */
  #shopify-section-{{ sid }} .fsi__list {
    background: {% render 'scheme-color', color: st.list_bg, fallback: 'var(--color-background)' %};
    border: 1px solid {% render 'scheme-color', color: st.list_border, fallback: 'var(--color-border)' %};
    border-radius: {{ st.list_radius | default: 12 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .fsi__item {
    border-top: 1px solid {% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %};
  }
  #shopify-section-{{ sid }} .fsi__item:first-child { border-top: 0; }

  #shopify-section-{{ sid }} .fsi__q {
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: {{ st.item_padding_y | default: 22 }}px {{ st.item_padding_x | default: 24 }}px;
    text-align: start;
    color: {% render 'scheme-color', color: st.q_color, fallback: 'var(--color-heading)' %};
    font-family: inherit;
    font-size: {{ st.q_size | default: 16 }}px;
    font-weight: {{ st.q_weight | default: 600 }};
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .fsi__icon {
    flex-shrink: 0;
    width: 22px; height: 22px;
    position: relative;
    color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %};
  }
  #shopify-section-{{ sid }} .fsi__icon::before,
  #shopify-section-{{ sid }} .fsi__icon::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    background: currentColor;
    transform-origin: center;
    transition: transform .35s cubic-bezier(.4,0,.2,1), opacity .25s ease;
  }
  #shopify-section-{{ sid }} .fsi__icon::before { width: 14px; height: 2px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .fsi__icon::after  { width: 2px; height: 14px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .fsi__item[data-open="1"] .fsi__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  /* Smooth height — same 3-level grid-template-rows pattern as FAQ 5 */
  #shopify-section-{{ sid }} .fsi__a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1);
  }
  #shopify-section-{{ sid }} .fsi__item[data-open="1"] .fsi__a-wrap { grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .fsi__a-inner { overflow: hidden; }
  #shopify-section-{{ sid }} .fsi__a {
    padding: 0 {{ st.item_padding_x | default: 24 }}px {{ st.item_padding_y | default: 22 }}px;
    color: {% render 'scheme-color', color: st.a_color, fallback: 'var(--color-text)' %};
    font-size: {{ st.a_size | default: 15 }}px;
    line-height: 1.6;
  }
  #shopify-section-{{ sid }} .fsi__a > * { margin: 0; }
  #shopify-section-{{ sid }} .fsi__a > * + * { margin-top: 8px; }

  /* Media — uses aspect-ratio so it always has height even on mobile.
     On desktop it stretches to match the FAQ list column when aspect
     ratio is set to "auto" via align-self: stretch on the grid item. */
  #shopify-section-{{ sid }} .fsi__inner { align-items: stretch; }
  #shopify-section-{{ sid }} .fsi__media {
    border-radius: {{ st.image_radius | default: 0 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: st.image_bg, fallback: 'rgba(var(--color-heading-rgb), 0.06)' %};
    position: relative;
    width: 100%;
    {%- if st.image_aspect == 'auto' -%}
      aspect-ratio: 4 / 5;
    {%- else -%}
      aspect-ratio:
      {%- case st.image_aspect -%}
        {%- when '1_1'  %} 1 / 1
        {%- when '4_5'  %} 4 / 5
        {%- when '3_4'  %} 3 / 4
        {%- when '4_3'  %} 4 / 3
        {%- when '3_2'  %} 3 / 2
        {%- when '16_9' %} 16 / 9
        {%- else        %} 1 / 1
      {%- endcase -%};
    {%- endif -%}
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi__media {
      {%- if st.image_aspect == 'auto' -%}
        aspect-ratio: auto;
        height: 100%;
        align-self: stretch;
      {%- endif -%}
      {%- if st.image_min_height_desktop and st.image_min_height_desktop > 0 -%}
        min-height: {{ st.image_min_height_desktop }}px;
      {%- endif -%}
    }
  }
  #shopify-section-{{ sid }} .fsi__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ st.image_fit | default: 'cover' }};
    object-position: center;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.fsi__a-wrap, .fsi__icon::before, .fsi__icon::after) {
      transition: none !important;
    }
  }
{% comment %}{% endcomment %}</style>

<section class="fsi color-{{ color_scheme }} gradient" id="fsi-{{ sid }}">
  <div class="fsi__inner">
    <div class="fsi__content">
      {%- if st.heading != blank -%}
        <h2 class="fsi__heading">{{ st.heading }}</h2>
      {%- endif -%}
      {%- if st.subheading != blank -%}
        <div class="fsi__sub">{{ st.subheading }}</div>
      {%- endif -%}

      {%- if items.size > 0 -%}
        <div class="fsi__list" data-fsi-list data-multiple="{% if st.allow_multiple_open %}true{% else %}false{% endif %}">
          {%- for item in items -%}
            {%- liquid
              assign open_first = false
              if forloop.first and st.open_first
                assign open_first = true
              endif
            -%}
            <div class="fsi__item" data-fsi-item id="block-{{ item.id }}" {% if open_first %}data-open="1"{% endif %} {{ item.shopify_attributes }}>
              <button type="button" class="fsi__q" data-fsi-toggle aria-expanded="{% if open_first %}true{% else %}false{% endif %}" aria-controls="fsi-a-{{ sid }}-{{ forloop.index }}">
                <span>{{ item.settings.question | default: fb_accessibility_question_goes_here }}</span>
                <span class="fsi__icon" aria-hidden="true"></span>
              </button>
              <div class="fsi__a-wrap" id="fsi-a-{{ sid }}-{{ forloop.index }}"><div class="fsi__a-inner"><div class="fsi__a">{{ item.settings.answer }}</div></div></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="fsi__media">
      {%- if st.image != blank -%}
        {{ st.image | image_url: width: 1400 | image_tag:
            alt: st.image.alt | default: st.heading,
            loading: 'lazy',
            widths: '480,640,800,1000,1200,1400' }}
      {%- else -%}
        {%- comment -%}
          No image uploaded yet — show the standard demo placeholder so
          the section reads cleanly out of the box. As soon as the
          merchant assigns an image in the Image setting, this is replaced.
        {%- endcomment -%}
        <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E"
             alt="{{ st.heading | default: fb_accessibility_faq_image_placeholder }}"
             loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ sid }}');
    if (!section || section.__fsiInit) return;
    section.__fsiInit = true;
    var list = section.querySelector('[data-fsi-list]');
    if (!list) return;
    var multiple = list.dataset.multiple === 'true';
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-fsi-toggle]');
      if (!btn) return;
      var item = btn.closest('[data-fsi-item]');
      if (!item) return;
      var isOpen = item.getAttribute('data-open') === '1';
      if (!multiple) {
        list.querySelectorAll('[data-fsi-item][data-open="1"]').forEach(function (it) {
          if (it !== item) {
            it.removeAttribute('data-open');
            var b = it.querySelector('[data-fsi-toggle]');
            if (b) b.setAttribute('aria-expanded', 'false');
          }
        });
      }
      if (isOpen) {
        item.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        item.setAttribute('data-open', '1');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "faq-side-image",
  "name": "FAQ 6",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_image_on_mobile",
      "label": "Show image on mobile",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Find answers to common questions about our products, shipping, returns, and more.</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading color"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "FAQ list"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open at once",
      "default": false
    },
    {
      "type": "color",
      "id": "list_bg",
      "label": "List background"
    },
    {
      "type": "color",
      "id": "list_border",
      "label": "List border"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color"
    },
    {
      "type": "range",
      "id": "list_radius",
      "label": "List corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "label": "Item padding Y",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "item_padding_x",
      "label": "Item padding X",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Toggle icon color"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Question typography"
    },
    {
      "type": "color",
      "id": "q_color",
      "label": "Question color"
    },
    {
      "type": "range",
      "id": "q_size",
      "label": "Question size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "q_weight",
      "label": "Question weight",
      "default": "600",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Answer typography"
    },
    {
      "type": "color",
      "id": "a_color",
      "label": "Answer color"
    },
    {
      "type": "range",
      "id": "a_size",
      "label": "Answer size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image background (placeholder)"
    },
    {
      "type": "select",
      "id": "image_aspect",
      "label": "Aspect ratio",
      "default": "1_1",
      "options": [
        {
          "value": "auto",
          "label": "Auto / fill column"
        },
        {
          "value": "1_1",
          "label": "1 : 1"
        },
        {
          "value": "4_5",
          "label": "4 : 5"
        },
        {
          "value": "3_4",
          "label": "3 : 4"
        },
        {
          "value": "4_3",
          "label": "4 : 3"
        },
        {
          "value": "3_2",
          "label": "3 : 2"
        },
        {
          "value": "16_9",
          "label": "16 : 9"
        }
      ]
    },
    {
