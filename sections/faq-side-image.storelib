            "question": "How do I place an order?",
            "answer": "<p>Add an item to your cart, head to checkout, and follow the prompts. We accept all major payment methods.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>Visa, Mastercard, Amex, Apple Pay, Google Pay, Shop Pay and PayPal are all supported at checkout.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping arrives in 3–5 business days. Faster options are available at checkout.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>30-day returns, no questions asked. We'll cover the return label.</p>"
          }
        }
      ]
    }
