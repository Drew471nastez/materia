<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. FAQ 6: heading, subheading and questions beside an image.
  Header and questions: snippets/faq-live-accordion. Every value is a
  --fsi-* variable on the root; live-faq.js opens and closes the questions
  and applies live edits.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign own = st.enable_custom_style
  assign hw = st.heading_weight | default: 'theme'
  assign own_hw = false
  if hw != 'theme'
    assign own_hw = true
  endif
  case st.image_aspect
    when '4_5'
      assign ratio = '4 / 5'
    when '3_4'
      assign ratio = '3 / 4'
    when '4_3'
      assign ratio = '4 / 3'
    when '3_2'
      assign ratio = '3 / 2'
    when '16_9'
      assign ratio = '16 / 9'
    when 'auto'
      assign ratio = '4 / 5'
    else
      assign ratio = '1 / 1'
  endcase
-%}
{%- capture fsi_vars -%}
--fsi-bg:{% if own %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--fsi-pt-m:{{ st.padding_top_mobile | default: 56 }}px;--fsi-pb-m:{{ st.padding_bottom_mobile | default: 56 }}px;--fsi-pt-d:{{ st.padding_top_desktop | default: 96 }}px;--fsi-pb-d:{{ st.padding_bottom_desktop | default: 96 }}px;
--fsi-maxw:{{ st.max_width | default: 1280 }}px;
--fsi-h-m:{{ st.heading_size_mobile | default: 36 }}px;--fsi-h-d:{{ st.heading_size_desktop | default: 56 }}px;--fsi-hw:{% if own_hw %}{{ hw }}{% else %}var(--heading-weight, 700){% endif %};
--fsi-heading-color:{% if own %}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--fsi-sub-color:{% if own %}{% render 'scheme-color', color: st.sub_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--fsi-list-bg:{% if own %}{% render 'scheme-color', color: st.list_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--fsi-list-border:{% if own %}{% render 'scheme-color', color: st.list_border, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};--fsi-divider:{% if own %}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
--fsi-list-r:{{ st.list_radius | default: 12 }}px;--fsi-py:{{ st.item_padding_y | default: 22 }}px;--fsi-px:{{ st.item_padding_x | default: 24 }}px;
--fsi-icon:{% if own %}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--fsi-q-color:{% if own %}{% render 'scheme-color', color: st.q_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--fsi-q-size:{{ st.q_size | default: 16 }}px;--fsi-q-weight:{{ st.q_weight | default: 600 }};
--fsi-a-color:{% if own %}{% render 'scheme-color', color: st.a_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--fsi-a-size:{{ st.a_size | default: 15 }}px;
--fsi-img-bg:{% if own %}{% render 'scheme-color', color: st.image_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--fsi-img-r:{{ st.image_radius | default: 0 }}px;--fsi-ratio:{{ ratio }};--fsi-fit:{{ st.image_fit | default: 'cover' }};--fsi-img-minh:{{ st.image_min_height_desktop | default: 0 }}px;
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--fsi-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--fsi-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom | default: 0 }}px; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :where(button) { font-family: inherit; }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) { font-family: var(--heading-font, inherit); }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }}, #shopify-section-{{ sid }} > section, #shopify-section-{{ sid }} > div { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section, .shopify-section + #shopify-section-{{ sid }} { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .fsi { background: var(--fsi-bg) !important; padding: var(--fsi-pt-m) 1.25rem var(--fsi-pb-m); }
  #shopify-section-{{ sid }} .fsi[data-fsi-width="container"] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .fsi[data-fsi-width="fluid_container"] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .fsi__inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; max-width: var(--fsi-maxw); margin-inline: auto; align-items: stretch; }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi { padding: var(--fsi-pt-d) 2rem var(--fsi-pb-d); }
    #shopify-section-{{ sid }} .fsi__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); }
    #shopify-section-{{ sid }} .fsi[data-fsi-side="left"] .fsi__media { order: -1; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .fsi[data-fsi-width="stretch_width"] { padding-inline: 3rem; }
  }
  @media (max-width: 1023px) {
    #shopify-section-{{ sid }} .fsi[data-fsi-mobile-image="false"] .fsi__media { display: none; }
  }

  #shopify-section-{{ sid }} .fsi__header > [hidden] { display: none; }
  #shopify-section-{{ sid }} .fsi__heading {
    margin: 0 0 14px;
    color: var(--fb-c, var(--fsi-heading-color)) !important;
    font-family: var(--fb-ff, var(--fsi-hf, var(--heading-font, inherit)));
    font-size: var(--fb-fs-m, var(--fsi-h-m));
    font-weight: var(--fsi-hw);
    line-height: var(--fb-lh, 1.05);
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .fsi__heading[data-own-weight] { font-weight: var(--fb-fw, var(--fsi-hw)); }
  #shopify-section-{{ sid }} .fsi__heading[data-own-size] { letter-spacing: var(--fb-ls, -0.01em); }
  #shopify-section-{{ sid }} .fsi__subheading {
    margin: 0 0 28px;
    max-width: 540px;
    color: var(--fb-c, var(--fsi-sub-color)) !important;
    font-family: var(--fb-ff, var(--fsi-bf, inherit));
    font-size: var(--fb-fs, 15px);
    line-height: var(--fb-lh, 1.55);
  }
  #shopify-section-{{ sid }} .fsi__subheading[data-own-weight] { font-weight: var(--fb-fw); }
  #shopify-section-{{ sid }} :is(.fsi__subheading, .fsi__a) > * { margin: 0; }
  #shopify-section-{{ sid }} :is(.fsi__subheading, .fsi__a) :is(p, li, strong, em) { font-family: inherit; }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi__heading { font-size: var(--fb-fs-d, var(--fsi-h-d)); }
  }

  #shopify-section-{{ sid }} .fsi__list { background: var(--fsi-list-bg); border: 1px solid var(--fsi-list-border); border-radius: var(--fsi-list-r); overflow: hidden; }
  #shopify-section-{{ sid }} .fsi__item { border-top: 1px solid var(--fsi-divider); }
  #shopify-section-{{ sid }} .fsi__item:first-child { border-top: 0; }
  #shopify-section-{{ sid }} .fsi__q {
    width: 100%; min-height: 44px; background: transparent; border: 0; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: var(--fsi-py) var(--fsi-px); text-align: start;
    color: var(--fsi-q-color); font-family: var(--fsi-hf, inherit); font-size: var(--fsi-q-size); font-weight: var(--fsi-q-weight); line-height: 1.4;
  }
  #shopify-section-{{ sid }} .fsi__q:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  #shopify-section-{{ sid }} .fsi__icon { flex-shrink: 0; width: 22px; height: 22px; position: relative; display: inline-flex; align-items: center; justify-content: center; color: var(--fsi-icon); }
  #shopify-section-{{ sid }} .fsi__icon svg { width: 100%; height: 100%; stroke: currentColor; stroke-width: 2; fill: none; transition: transform .35s cubic-bezier(.4,0,.2,1); }
  #shopify-section-{{ sid }} .fsi__item[open] .fsi__icon-chevron { transform: rotate(180deg); }
  #shopify-section-{{ sid }} .fsi__icon-plus .v, #shopify-section-{{ sid }} .fsi__icon-plus .h { position: absolute; left: 50%; top: 50%; background: currentColor; transform: translate(-50%, -50%); transition: transform .35s cubic-bezier(.4,0,.2,1), opacity .25s ease; }
  #shopify-section-{{ sid }} .fsi__icon-plus .v { width: 2px; height: 14px; }
  #shopify-section-{{ sid }} .fsi__icon-plus .h { width: 14px; height: 2px; }
  #shopify-section-{{ sid }} .fsi__item[open] .fsi__icon-plus .v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
  #shopify-section-{{ sid }} .fsi__a-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1); }
  #shopify-section-{{ sid }} .fsi__item[open] .fsi__a-wrap { grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .fsi__a-inner { overflow: hidden; min-height: 0; }
  #shopify-section-{{ sid }} .fsi__a { padding: 0 var(--fsi-px) var(--fsi-py); color: var(--fsi-a-color); font-family: var(--fsi-bf, inherit); font-size: var(--fsi-a-size); line-height: 1.6; }
  #shopify-section-{{ sid }} .fsi__a > * + * { margin-top: 8px; }
  #shopify-section-{{ sid }} .fsi__a a { color: inherit; text-decoration: underline; }

  #shopify-section-{{ sid }} .fsi__media { position: relative; width: 100%; overflow: hidden; border-radius: var(--fsi-img-r); background: var(--fsi-img-bg); color: var(--color-heading); aspect-ratio: var(--fsi-ratio); }
  #shopify-section-{{ sid }} .fsi__media :is(img, svg) { width: 100%; height: 100%; object-fit: var(--fsi-fit); object-position: center; display: block; }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fsi__media { min-height: var(--fsi-img-minh); }
    #shopify-section-{{ sid }} .fsi[data-fsi-aspect="auto"] .fsi__media { aspect-ratio: auto; height: 100%; align-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.fsi__a-wrap, .fsi__icon svg, .fsi__icon-plus *) { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<section class="fsi color-{{ color_scheme }} gradient" id="fsi-{{ sid }}" data-faq-root="faq-side-image" data-faq-section="{{ section.id }}" data-faq-settings="{{ section.settings | json | escape }}" data-fsi-width="{{ st.section_width | default: 'full_width' }}" data-fsi-side="{{ st.image_position | default: 'right' }}" data-fsi-mobile-image="{% if st.show_image_on_mobile %}true{% else %}false{% endif %}" data-fsi-aspect="{{ st.image_aspect | default: '1_1' }}" style="{{ fsi_vars | strip_newlines }}">
  <div class="fsi__inner">
    <div class="fsi__content">
      {%- render 'faq-live-accordion', section: section, p: 'fsi', own_hw: own_hw -%}
    </div>
    <div class="fsi__media" data-faq-media>
      {%- if st.image != blank -%}
        {{ st.image | image_url: width: 1400 | image_tag: alt: st.image.alt, width: st.image.width, height: st.image.height, loading: 'lazy', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '480,640,800,1000,1200,1400' }}
      {%- else -%}
        <svg class="fsi__ph" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><rect width="400" height="300" fill="currentColor" opacity=".08"/><g fill="currentColor" opacity=".35"><circle cx="172" cy="124" r="14"/><path d="M140 192l40-46 25 28 20-18 35 36z"/></g></svg>
      {%- endif -%}
    </div>
  </div>
</section>
</template>

<schema>
{
  "type": "faq-side-image",
  "name": "FAQ 6",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_image_on_mobile",
      "label": "Show image on mobile",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Find answers to common questions about our products, shipping, returns, and more.</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading color"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "FAQ list"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open at once",
      "default": false
    },
    {
      "type": "color",
      "id": "list_bg",
      "label": "List background"
    },
    {
      "type": "color",
      "id": "list_border",
      "label": "List border"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color"
    },
    {
      "type": "range",
      "id": "list_radius",
      "label": "List corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "label": "Item padding Y",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "item_padding_x",
      "label": "Item padding X",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Toggle icon color"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Question typography"
    },
    {
      "type": "color",
      "id": "q_color",
      "label": "Question color"
    },
    {
      "type": "range",
      "id": "q_size",
      "label": "Question size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "q_weight",
      "label": "Question weight",
      "default": "600",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Answer typography"
    },
    {
      "type": "color",
      "id": "a_color",
      "label": "Answer color"
    },
    {
      "type": "range",
      "id": "a_size",
      "label": "Answer size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image background (placeholder)"
    },
    {
      "type": "select",
      "id": "image_aspect",
      "label": "Aspect ratio",
      "default": "1_1",
      "options": [
        {
          "value": "auto",
          "label": "Auto / fill column"
        },
        {
          "value": "1_1",
          "label": "1 : 1"
        },
        {
          "value": "4_5",
          "label": "4 : 5"
        },
        {
          "value": "3_4",
          "label": "3 : 4"
        },
        {
          "value": "4_3",
          "label": "4 : 3"
        },
        {
          "value": "3_2",
          "label": "3 : 2"
        },
        {
          "value": "16_9",
          "label": "16 : 9"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "image_min_height_desktop",
