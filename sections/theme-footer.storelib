<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_background_image = 'accessibility.background_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if request.design_mode != true and settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  /* Phones: each footer menu link is a 44px tap target; the row gap it
     replaces is dropped so the list barely grows. */
  @media screen and (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .footer-block.collapsible-content li.pb-8 { padding-bottom: 0; }
    #shopify-section-{{ section.id }} .footer-block.collapsible-content li > a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger') || document.documentElement.classList.contains('shopify-design-mode') || (window.Shopify && window.Shopify.designMode)) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{{ 'collapsible.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign theme_st = settings
  assign section_st = section.settings
  assign container = section_st.section_width
  assign scroll_animation = settings.scroll_animation
  # Link hover colour: only honour a real, VISIBLE custom colour. A blank value
  # OR a fully-transparent one (e.g. rgba(0,0,0,0), which Shopify stores when the
  # colour picker is "cleared") must fall back to the scheme colour — otherwise
  # the link turns transparent on hover and reads as white over a light footer.
  assign lhc = section_st.link_hover_color
  assign lhc_norm = lhc | downcase | replace: ' ', ''
  assign lhc_is_set = false
  if lhc != blank and lhc_norm != 'rgba(0,0,0,0)' and lhc_norm != 'transparent' and lhc.alpha != 0
    assign lhc_is_set = true
  endif
-%}

{%- capture style -%}
--section-pt: {{ section_st.padding_top }};
--section-pb: {{ section_st.padding_bottom }};
{%- if lhc_is_set %}
--footer-link-hover: {{ lhc }};
{%- else %}
--footer-link-hover: var(--color-heading);
{%- endif %}
--footer-heading-weight: {{ section_st.heading_weight | default: 600 }};
--footer-heading-tt: {{ section_st.heading_transform | default: 'none' }};
--footer-arrow-size: {{ section_st.arrow_icon_size | default: 14 }}px;
{%- endcapture -%}

{%- style -%}
  @media screen and (max-width: 767.98px) {
    .footer__middle {
      --section-pb: 0;
    }
  }

  /* Footer padding is driven purely by the theme-editor Top/Bottom padding
     sliders — no CSS floor, so 0 means 0. */

  /* Tight, balanced bottom band — keep the © copyright + payment
     row visually compact. The Top/Bottom padding sliders still drive
     the footer's overall padding (`--section-pt` / `--section-pb`);
     this only controls the inner bottom row's own breathing room. */
  .footer__bottom .footer_bottom-inner {
    padding-top: 16px !important;
    padding-bottom: 16px !important;
  }
  @media screen and (min-width: 768px) {
    .footer__bottom .footer_bottom-inner {
      padding-top: 20px !important;
      padding-bottom: 20px !important;
    }
  }

  .footer__block-heading { font-weight: var(--footer-heading-weight, 600); text-transform: var(--footer-heading-tt, none); }

  /* Footer copyright and localization are one baseline-aligned control row. */
  .footer__bottom .footer_bottom-inner > .flex:first-child {
    display: flex;
    align-items: center;
    gap: 12px 22px;
    min-width: 0;
  }
  .footer__bottom :is(.footer__copyright,.footer__localization, .footer__localization localization-form) {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    line-height: 1.45;
    vertical-align: middle;
    margin-block: 0;
  }
  .footer__bottom .footer__copyright { overflow-wrap: anywhere; }
  @media (max-width: 767.98px) {
    .footer__bottom .footer_bottom-inner > .flex:first-child { justify-content: center; text-align: center; }
  }

  /* Link hover: scheme-aware. Base color uses --color-text; hover uses custom color if set, else theme heading color (always readable on any scheme). Subtle fade, no underline, never. */
  .footer__blocks .footer-block.link_list .reversed-links,
  .footer__blocks .footer-block.link_list .reversed-links:visited {
    color: var(--color-text);
    text-decoration: none !important;
    border-bottom: 0 !important;
    background-image: none !important;
    opacity: .88;
    transition: color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__blocks .footer-block.link_list .reversed-links,
    .footer__block-heading .arrow-toggle,
    #shopify-section-{{ section.id }} .footer-newsletter-email input,
    #shopify-section-{{ section.id }} .newsletter-form__button { transition: none !important; }
  }
  .footer__blocks .footer-block.link_list .reversed-links:hover,
  .footer__blocks .footer-block.link_list .reversed-links:focus-visible {
    color: var(--footer-link-hover);
    text-decoration: none !important;
    border-bottom: 0 !important;
    background-image: none !important;
    opacity: 1;
  }
  /* Kill any ::after underline pseudo-element that other themes add on menu links */
  .footer__blocks .footer-block.link_list .reversed-links::before,
  .footer__blocks .footer-block.link_list .reversed-links::after {
    display: none !important;
    content: none !important;
  }

  /* ==========================================================================
     Bulletproof heading alignment — every footer block heading pinned to the
     top of its column at exactly the same Y, on every breakpoint. Achieved
     by positioning the heading absolutely at top:0 of each block and
     reserving a uniform top-padding band on every block.
     ========================================================================== */
  /* Normalize custom element (defaults to inline) */
  .footer__blocks .footer-acc {
    display: block;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    .footer__blocks {
      align-items: flex-start !important;
    }
    .footer__blocks > .footer-block {
      position: relative !important;
      align-self: flex-start !important;
      padding-top: 76px !important;   /* 60px heading band + 16px gap */
      margin-top: 0 !important;
    }
    /* Store info block — optional merchant-controlled top-spacing offset.
       `--store-info-top-offset` is set inline on the block from the
       block schema's `top_offset` slider (-80..60px). It shifts the
       block's top edge without rewriting the 76px heading-band padding,
       so the heading (when present) still aligns with the other
       columns, while empty space above can be tightened or loosened. */
    .footer__blocks > .footer-block.store_info {
      margin-top: var(--store-info-top-offset, 0) !important;
    }
    /* Zero out intermediate wrappers so the heading's absolute positioning
       is relative to the .footer-block and nothing else. */
    .footer__blocks > .footer-block > .footer-acc,
    .footer__blocks > .footer-block > .footer-acc > .newsletter-inner,
    .footer__blocks > .footer-block > .store-info-content {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    /* Pin every heading to the top of its block at identical Y.

       NOTE on horizontal alignment: the heading is `position: absolute`
       at `left: 0` which anchors it to the .footer-block's *padding-box*
       edge. The menu list (`<ul>`) is in normal flow, so its first
       character sits at the .footer-block's *content-box* edge — which
       is ~12-24px further right because every direct child of
       `.flex-col-custom` (i.e. every .footer-block) has
       `padding-inline: calc(var(--gap, var(--bs-gutter-x)) * 0.5)` from
       the column-gutter system. That mismatch is why the menu items
       used to look slightly indented compared to the heading.

       Fix: give the absolutely-positioned heading the SAME inline
       gutter padding as the list's parent, so its text starts at the
       content-box edge too — flush-left with every menu link. */
    .footer__blocks .footer__block-heading {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 60px !important;
      min-height: 60px !important;
      max-height: 60px !important;
      margin: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-left: calc(var(--gap, var(--bs-gutter-x)) * 0.5) !important;
      padding-right: calc(var(--gap, var(--bs-gutter-x)) * 0.5) !important;
      display: flex !important;
      align-items: center !important;
      line-height: 1.3 !important;
      box-sizing: border-box !important;
      z-index: 1;
    }
  }

  /* Mobile: stack blocks — collapsible-heading shows a chevron and must
     remain clickable. Use consistent band height across every heading. */
  @media screen and (max-width: 767.98px) {
    .footer__blocks .footer__block-heading {
      min-height: 56px !important;
      padding: 16px 0 !important;
      margin: 0 !important;
      display: flex !important;
      align-items: center !important;
      line-height: 1.3 !important;
    }
    /* Chevron span covers the full heading (absolute inset-0) — force its
       inner flex to vertically center the arrow so it sits on the same
       visual line as the heading text, not at the top. */
    .footer__blocks .footer__block-heading .open-children-toggle {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
    }
    .footer__blocks .footer__block-heading .arrow-toggle {
      align-self: center !important;
    }
  }

  /* Menu links flush-left with the heading — zero every possible source of
     left indentation (UA padding-inline-start, collapsible wrapper, li, a). */
  .footer__blocks .footer-block.link_list .collapsible-content,
  .footer__blocks .footer-block.link_list .footer-block.collapsible-content {
    padding: 0 !important;
    margin: 0 0 12px !important;
    padding-inline-start: 0 !important;
    margin-inline-start: 0 !important;
  }
  .footer__blocks .footer-block.link_list ul {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    padding-inline-start: 0 !important;
    margin-inline-start: 0 !important;
  }
  .footer__blocks .footer-block.link_list ul li {
    padding-left: 0 !important;
    margin-left: 0 !important;
    padding-inline-start: 0 !important;
    margin-inline-start: 0 !important;
    text-indent: 0 !important;
    list-style: none !important;
  }
  .footer__blocks .footer-block.link_list ul li a,
  .footer__blocks .footer-block.link_list .reversed-links {
    padding-left: 0 !important;
    margin-left: 0 !important;
    padding-inline-start: 0 !important;
    margin-inline-start: 0 !important;
    text-indent: 0 !important;
    display: inline-block;
  }

  /* Arrow collapsible indicator (replaces +/- plus-animation) */
  .footer__block-heading .arrow-toggle {
    width: var(--footer-arrow-size, 14px);
    height: var(--footer-arrow-size, 14px);
    color: var(--color-heading);
    transition: transform .28s var(--btn-anim-ease, cubic-bezier(.4,.0,.2,1));
    transform: rotate(0deg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .footer-acc.is-open .footer__block-heading .arrow-toggle { transform: rotate(-180deg); }
  .footer__block-heading .arrow-toggle svg { display: block; width: 100%; height: 100%; }

  /* Phone accordion. The heading is a real button; its panel opens and closes
     on its height (grid rows 0fr to 1fr), so the links below never jump and
     a closed panel keeps nothing in the Tab order. From 768px every column
     is open and the heading is plain text. */
  #shopify-section-{{ section.id }} .footer-acc__toggle {
    -webkit-appearance: none;
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    text-transform: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  #shopify-section-{{ section.id }} .footer-acc__toggle:focus:not(:focus-visible) { outline: none; }
  #shopify-section-{{ section.id }} .footer-acc__toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
  #shopify-section-{{ section.id }} .footer-acc__toggle .open-children-toggle { position: static; inset: auto; flex: none; }
  #shopify-section-{{ section.id }} .footer-acc .collapsible-content { display: block; }
  #shopify-section-{{ section.id }} .footer-acc__panel { display: grid; grid-template-rows: 1fr; }
  #shopify-section-{{ section.id }} .footer-acc__inner { min-height: 0; min-width: 0; }
  @media screen and (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .footer-acc__panel:not(.is-static) {
      grid-template-rows: 0fr;
      visibility: hidden;
      transition: grid-template-rows .38s cubic-bezier(.2, .7, .2, 1), visibility 0s linear .38s;
    }
    #shopify-section-{{ section.id }} .footer-acc.is-open .footer-acc__panel {
      grid-template-rows: 1fr;
      visibility: visible;
      transition: grid-template-rows .38s cubic-bezier(.2, .7, .2, 1), visibility 0s linear 0s;
    }
    #shopify-section-{{ section.id }} .footer-acc__inner { overflow: hidden; }
    #shopify-section-{{ section.id }} .footer-acc .collapsible-content {
      opacity: 0;
      transform: translateY(-4px);
      transition: opacity .3s ease, transform .38s cubic-bezier(.2, .7, .2, 1);
    }
    #shopify-section-{{ section.id }} .footer-acc.is-open .collapsible-content,
    #shopify-section-{{ section.id }} .footer-acc__panel.is-static .collapsible-content {
      opacity: 1;
      transform: none;
    }
    #shopify-section-{{ section.id }} .footer-block.collapsible-content li.pb-8 { padding-bottom: 0; }
    #shopify-section-{{ section.id }} .footer-block.collapsible-content li > a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .footer-acc__toggle { pointer-events: none; cursor: default; min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .footer-acc__panel,
    #shopify-section-{{ section.id }} .footer-acc .collapsible-content,
    #shopify-section-{{ section.id }} .footer__block-heading .arrow-toggle { transition: none !important; }
  }

  /* Fit the form to its own footer column, not the viewport width. */
  #shopify-section-{{ section.id }} .footer__blocks > .footer-block { min-width: 0; }
  #shopify-section-{{ section.id }} .newsletter-inner {
    container: footer-newsletter / inline-size;
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .footer__newsletter,
  #shopify-section-{{ section.id }} .newsletter-form__field-wrapper,
  #shopify-section-{{ section.id }} .footer-newsletter-email { min-width: 0; max-width: 100%; }
  #shopify-section-{{ section.id }} .footer-newsletter-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .footer-newsletter-email input {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    min-height: var(--input-height, 48px);
    padding: var(--input-padding, 12px 14px);
    font-size: max(16px, var(--input-font-size, 16px));
    line-height: 1.5;
    text-overflow: ellipsis;
    background: var(--input-bg, var(--color-background));
    color: var(--input-color, var(--color-text));
    border: var(--inputs-border-width, 1px) solid var(--color-border);
    border-radius: var(--input-border-radius, var(--input-radius, 0));
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .footer-newsletter-email input::placeholder { color: var(--input-placeholder-color, currentColor); }
  #shopify-section-{{ section.id }} .newsletter-form__button {
    min-width: 0;
    max-width: 100%;
    width: 100%;
    height: auto;
    min-height: var(--input-height, 48px);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .footer__block-description { overflow-wrap: anywhere; }
  @container footer-newsletter (min-width: 480px) {
    #shopify-section-{{ section.id }} .footer-newsletter-fields { grid-template-columns: minmax(0, 1fr) minmax(120px, 35%); }
  }
  /* Payment badges use the platform's full-color SVGs at their native ratio. */
  .footer__payment-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
  }
  @media screen and (min-width: 768px) { .footer__payment-badges { justify-content: flex-end; } }
  .footer__payment-badges .payment-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 28px;
    border-radius: 4px;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;
    overflow: hidden;
    padding: 0;
  }

  /* Match cart recommendation/payment badge artwork exactly. */
  .footer__payment-badges .payment-badge {
    width:46px;
    height:31px;
    background:transparent !important;
    overflow:hidden;
  }
  .footer__payment-badges .payment-badge .cda-payments__svg {
    display:block;
    width:100%;height:100%;
    object-fit:contain;
    border-radius:4px;
  }
  .footer__payment-badges .payment-badge svg,
  .footer__payment-badges .payment-badge .icon {
    width: 100%;
    height: 100%;
    display: block;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;
    object-fit: contain;
    fill: initial;
  }
{%- endstyle -%}

<footer
  class="product-sticky-hide footer color-{{ color_scheme }} gradient{% if section_st.background_image != blank %} bg-transparent relative{% endif %}{% if request.page_type == 'index' and section_st.separator_line == 'homepage' %} border-top{% endif %}{% if section_st.separator_line == 'all-page' %} border-top{% endif %}{% if request.page_type != 'index' and section_st.separator_line == 'inner_page' %} border-top{% endif %}{% if section_st.reset_spacing %} remove_spacing remove_spacing-on-home{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  {%- if section_st.background_image != blank -%}
    {%- assign image_alt = section_st.background_image.alt | default: fb_accessibility_background_image -%}
    {% render 'responsive-image',
      type: 'banner',
      image: section_st.background_image,
      image_alt: image_alt,
      no_animate: true,
      class: 'background-footer absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover'
    %}
    {%- if section_st.footer_bg_brightness != blank and section_st.footer_bg_brightness != 100 -%}
      <style>
        #shopify-section-{{ section.id }} .background-footer {
          filter: brightness({{ section_st.footer_bg_brightness }}%);
        }
{% comment %}{% endcomment %}      </style>
    {%- endif -%}
  {% endif %}

  {%- comment -%}
    Custom Header Elements — optional oversized text + image rendered
    at the top of the footer, above all blocks. Driven by the new
    schema group. Each piece is independently togglable.
  {%- endcomment -%}
  {%- liquid
    assign show_custom_text_big = false
    if section_st.enable_custom_text_big and section_st.custom_text != blank
      assign show_custom_text_big = true
    endif
    assign show_custom_img = false
    if section_st.enable_custom_image and section_st.custom_image != blank
      assign show_custom_img = true
    endif
    assign show_custom_header = false
    if show_custom_text_big or show_custom_img
      assign show_custom_header = true
    endif
    assign custom_header_position = section_st.custom_header_position | default: 'top'
  -%}
  {%- if show_custom_header -%}
    <style>
      #shopify-section-{{ section.id }} .footer__custom-header {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 16px;
        padding-top: {{ section_st.padding_top | default: 60 }}px;
        margin-bottom: {{ section_st.custom_elements_gap | default: 24 }}px;
        overflow: hidden;
        position: relative;
        z-index: 0;
      }
      /* Bottom placement: drop the big top padding and give balanced
         spacing so the element sits neatly above the copyright line. */
      #shopify-section-{{ section.id }} .footer__custom-header--bottom {
        padding-top: 0;
        margin-top: {{ section_st.custom_elements_gap | default: 24 }}px;
        margin-bottom: {{ section_st.custom_elements_gap | default: 24 }}px;
      }
      #shopify-section-{{ section.id }} .footer__custom-text {
        font-size: {{ section_st.custom_text_font_size_mobile | default: 50 }}px;
        color: {% render 'scheme-color', color: section_st.custom_text_color, fallback: 'var(--color-heading)' %};
        line-height: 0.95;
        font-weight: var(--heading-weight, 800);
        font-style: {% if section_st.custom_text_italic %}italic{% else %}normal{% endif %};
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        margin: 0;
        font-family: var(--heading-font, inherit);
        pointer-events: none;
        user-select: none;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ section.id }} .footer__custom-text {
          font-size: {{ section_st.custom_text_font_size_desktop | default: 200 }}px;
        }
      }
      #shopify-section-{{ section.id }} .footer__custom-image {
        width: {{ section_st.custom_image_size_mobile | default: 150 }}px;
        height: auto;
        max-width: 100%;
        display: block;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ section.id }} .footer__custom-image {
          width: {{ section_st.custom_image_size_desktop | default: 200 }}px;
        }
      }
{% comment %}{% endcomment %}    </style>
    {%- capture footer_custom_header -%}
      <div class="footer__custom-header footer__custom-header--{{ custom_header_position }}">
        {%- if show_custom_text_big -%}
          <div class="footer__custom-text">{{ section_st.custom_text }}</div>
        {%- endif -%}
        {%- if show_custom_img -%}
          <img
            class="footer__custom-image"
            src="{{ section_st.custom_image | image_url: width: 1200 }}"
            srcset="
              {{ section_st.custom_image | image_url: width: 200 }} 200w,
              {{ section_st.custom_image | image_url: width: 400 }} 400w,
              {{ section_st.custom_image | image_url: width: 800 }} 800w,
              {{ section_st.custom_image | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 768px) {{ section_st.custom_image_size_desktop | default: 200 }}px, {{ section_st.custom_image_size_mobile | default: 150 }}px"
            alt="{{ section_st.custom_image.alt | default: shop.name | escape }}"
            loading="lazy"
            width="{{ section_st.custom_image_size_desktop | default: 200 }}"
            height="{{ section_st.custom_image_size_desktop | default: 200 }}"
          >
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- comment -%} Top placement (default). Bottom placement is emitted in .footer__bottom. {%- endcomment -%}
    {%- unless custom_header_position == 'bottom' -%}
      {{ footer_custom_header }}
    {%- endunless -%}
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="footer__middle section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} remove_spacing">
      <div class="{{ container }}">
        {%- liquid
          assign menu_item = 0
        -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- liquid
                assign menu_item = menu_item | plus: 1
              -%}
          {%- endcase -%}
        {%- endfor -%}
        <div class="footer__blocks flex flex-col-custom flex-wrap">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_st = block.settings
            -%}
              {%- case block.type -%}
                {%- when 'newsletter' -%}
                  <div
                    class="footer-block w-full col-md-w-custom-50 col-md-w-custom{% if block.type == 'store_info' %} pb-30 border-bottom border-bottom-md-0{% else %} mb-0 mb-md-20 border-bottom border-bottom-md-0{% endif %} {{ block.type }}"
                    style="--col-width: {{ block_st.content_width }}; --menu-list: {{ menu_item }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="footer-acc footer-block mb-30 newsletter mb-50 my-md-0" data-footer-acc>
                      <div class="newsletter-inner{% if block_st.content_width == '100%' %} text-center mx-auto{% endif %}">
                        {%- if block_st.heading != blank or block_st.description != blank -%}
                          {%- if block_st.heading != blank -%}
                            <h3
                              class="footer__block-heading collapsible-heading relative heading-letter-spacing fs-custom my-0 py-20 mb-md-5"
                              style="--font-size: {{ section_st.footer_heading_size }}"
                            >
                              <button type="button" class="footer-acc__toggle" data-footer-acc-toggle aria-expanded="false" aria-controls="FooterAcc-{{ block.id }}">
                                <span>{{- block_st.heading | escape -}}</span>
                                <span class="open-children-toggle hidden-md absolute inset-0 flex flex-end">
                                  <span class="arrow-toggle" aria-hidden="true">
                                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M3.5 6 8 10.5 12.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </span>
                                </span>
                              </button>
                            </h3>
                          {% endif %}
                        {% endif %}
                        <div class="footer-acc__panel{% if block_st.heading == blank %} is-static{% endif %}" id="FooterAcc-{{ block.id }}"><div class="footer-acc__inner">
                        <div class="collapsible-content mb-30">
                          {%- if block_st.description != blank -%}
                            <div class="footer__block-description mb-23">
                              {{ block_st.description }}
                            </div>
                          {% endif %}
                          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                            <input type="hidden" name="contact[tags]" value="newsletter">
                            <div class="newsletter-form__field-wrapper">
                              <div class="field mb-0 footer-newsletter-fields">
                                <div class="flex-1 relative footer-newsletter-email">
                                  <input
                                    id="NewsletterForm--{{ section.id }}"
                                    type="email"
                                    name="contact[email]"
                                    class="field__input show-placeholder m-0 w-full form-control"
                                    value="{{ form.email }}"
                                    aria-required="true"
                                    autocapitalize="off"
                                    autocomplete="email"
                                    {% if form.errors %}
                                      aria-invalid="true"
                                      aria-describedby="ContactFooter-error"
                                    {% elsif form.posted_successfully? %}
                                      aria-describedby="ContactFooter-success"
                                    {% endif %}
                                    placeholder="{%- if block_st.email_placeholder != blank -%}{{ block_st.email_placeholder }} {%- else -%} {{ 'newsletter.label' | t }} {% endif %}"
                                    required
                                  >
                                  <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                                    {%- if block_st.email_placeholder != blank -%}
                                      {{ block_st.email_placeholder }}
                                    {%- else -%}
                                      {{ 'newsletter.label' | t }}
                                    {% endif %}
                                  </label>
                                </div>
                                <button
                                  type="submit"
                                  class="btn-primary newsletter-form__button word-break"
                                  data-theme-button="primary" data-sl-button
                                  name="commit"
                                  id="Subscribe-{{ section.id }}"
                                  aria-label="{%- if block_st.button_label != blank -%}{{ block_st.button_label }} {%- else -%} {{ 'subscribe.button_label' | t }} {% endif %}"
                                >
                                  {%- if block_st.button_label != blank -%}
                                    {{ block_st.button_label }}
                                  {%- else -%}
                                    {{ 'newsletter.button_label' | t }}
                                  {% endif %}
                                </button>
                              </div>
                              {%- if form.errors -%}
                                <div
                                  class="newsletter-form__message mt-10 inline-flex align-center error form__message"
                                  id="ContactFooter-error"
                                >
                                  {%- render 'icon-error' -%}
                                  {{- form.errors.translated_fields.email | capitalize }}
                                  {{ form.errors.messages.email -}}
                                </div>
                              {% endif %}
                            </div>
                            {%- if form.posted_successfully? -%}
                              <div
                                class="mt-10 newsletter-form__message--success success form__message inline-flex align-center"
                                id="ContactFooter-success"
                                tabindex="-1"
                              >
                                {%- render 'icon-success' -%}
                                <span class="newsletter-form__message ml-5">{{- 'newsletter.success' | t }}</span>
                              </div>
                            {% endif %}
                          {%- endform -%}
                          {%- if block_st.note != blank -%}
                            <div class="newsletter-note mt-15">{{ block_st.note }}</div>
                          {% endif %}
                          {%- liquid
                            assign not_has_store_info = true
                            for block in section.blocks
                              if block.type == 'store_info'
                                assign not_has_store_info = false
                              endif
                            endfor
                          -%}
                          {% if not_has_store_info %}
                            {%- if section_st.show_social -%}
                              <social-icon class="block mt-15">
                                {% render 'social-icons' %}
                              </social-icon>
                            {% endif %}
                          {% endif %}
                        </div>
                        </div></div>
                      </div>
                    </div>
                  </div>
                {%- when 'link_list' -%}
                  {%- if block_st.menu != blank -%}
                    <div
                      class="footer-block w-full col-md-w-custom-50 col-md-w-custom{% if block.type == 'store_info' %} pb-30 border-bottom border-bottom-md-0{% else %} mb-0 mb-md-20 border-bottom border-bottom-md-0{% endif %} {{ block.type }}"
                      style="--col-width: {{ block_st.content_width }}; --menu-list: {{ menu_item }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="footer-acc" data-footer-acc>
                        {%- if block_st.menu != blank or block_st.heading != blank -%}
                          <h3
                            class="footer__block-heading collapsible-heading heading-letter-spacing relative fs-custom my-0 py-20 mb-md-5"
                            style="--font-size: {{ section_st.footer_heading_size }}"
                          >
                            {%- if block_st.menu != blank -%}
                              <button type="button" class="footer-acc__toggle" data-footer-acc-toggle aria-expanded="false" aria-controls="FooterAcc-{{ block.id }}">
                                <span>
                                  {{- block_st.heading | default: block_st.menu.title | escape -}}
                                </span>
                                <span class="open-children-toggle hidden-md absolute inset-0 flex flex-end">
                                  <span class="arrow-toggle" aria-hidden="true">
                                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M3.5 6 8 10.5 12.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </span>
                                </span>
                              </button>
                            {%- else -%}
                              <span>
                                {{- block_st.heading | escape -}}
                              </span>
                            {% endif %}
                          </h3>
                          {%- if block_st.menu != blank -%}
                            <div class="footer-acc__panel" id="FooterAcc-{{ block.id }}"><div class="footer-acc__inner">
                            <div class="footer-block collapsible-content mb-12 mb-md-0">
                              <ul class="list-unstyled">
                                {%- for link in block_st.menu.links -%}
                                  <li class="pb-8">
                                    <a
                                      href="{{ link.url | remove: '#_blank' }}"
                                      aria-label="{{ link.title }}"
                                      class="no-underline word-break reversed-links relative"
                                      {% render 'link-target', link: link %}
                                    >
                                      {{ link.title }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                            </div></div>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {%- when 'store_info' -%}
                  {%- comment -%}
                    Apply the merchant-controlled top spacing offset
                    (`top_offset`, range -80..60px) via inline custom
                    property so it composes with the existing 76px
                    desktop heading-band padding without rewriting it.
                    A negative offset lets merchants pull the block up
                    to remove dead space when no heading is set.
                  {%- endcomment -%}
                  <div
                    class="footer-block w-full col-md-w-custom-50 col-md-w-custom{% if block.type == 'store_info' %} pb-30 border-bottom border-bottom-md-0{% else %} mb-0 mb-md-20 border-bottom border-bottom-md-0{% endif %} {{ block.type }}"
                    style="--col-width: {{ block_st.content_width }}; --menu-list: {{ menu_item }}; --store-info-top-offset: {{ block_st.top_offset | default: 0 }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block_st.store_heading != blank -%}
                      <h3
                        class="footer__block-heading fs-custom my-0 py-20 mb-md-5"
                        style="--font-size: {{ section_st.footer_heading_size }}"
                      >
                        {{ block_st.store_heading | escape }}
                      </h3>
                    {% endif %}
                    <div
                      class="store-info-content"
                    >
                      {%- comment -%}
                        Logo display logic:
                        • If a Custom logo image is uploaded → ALWAYS show it
                          (the upload itself is intent — merchants kept
                          uploading a custom logo, leaving the "Show logo
                          image" toggle off, and being confused why nothing
                          rendered).
                        • Else, if "Show logo image" toggle is ON → fall
                          back to the theme-level logo (Theme settings → Logo).
                        • Else → no logo.
                      {%- endcomment -%}
                      {%- if block_st.image != blank -%}
                        {%- assign footer_logo = block_st.image -%}
                      {%- elsif block_st.show_logo -%}
                        {%- assign footer_logo = theme_st.logo -%}
                      {%- else -%}
                        {%- assign footer_logo = blank -%}
                      {%- endif -%}
                      {%- if footer_logo != blank -%}
                        {%- assign sizes = block_st.image_width | append: 'px' -%}
                        {%- assign image_alt = footer_logo.alt | default: shop.name -%}

                        {% render 'responsive-image',
                          type: 'other',
                          image: footer_logo,
                          image_alt: image_alt,
                          sizes: sizes,
                          width: block_st.image_width,
                          no_animate: true
                        %}
                      {% endif %}

                      {%- if block_st.store_description != blank -%}
                        <div class="footer__block-info rich__text-mt-0 mb-20">
                          {{ block_st.store_description }}
                        </div>
                      {% endif %}
                      {%- liquid
                        assign store_href = theme_st.store_page.url | default: theme_st.store_page
                        if store_href != blank
                          unless store_href contains '/'
                            assign store_href = '/pages/' | append: store_href
                          endunless
                        endif
                        assign show_store_info = false
                        if block_st.store_address and theme_st.store_address != blank
                          assign show_store_info = true
                        endif
                        if block_st.store_phone and theme_st.store_phone != blank
                          assign show_store_info = true
                        endif
                        if block_st.store_email and theme_st.store_email != blank
                          assign show_store_info = true
                        endif
                      -%}
                      {%- if show_store_info %}
                        <div class="footer_store-infor">
                          {%- if block_st.store_address and theme_st.store_address != blank -%}
                            <div class="footer__block-info">
                              {%- if store_href != blank -%}
                                <a href="{{ store_href | url }}" class="heading-color no-underline">{{ theme_st.store_address }}</a>
                              {%- else -%}
                                {{ theme_st.store_address }}
                              {%- endif -%}
                            </div>
                          {% endif %}
                          {%- if block_st.store_phone and theme_st.store_phone != blank -%}
                            <div class="footer__store-info">
                              <a href="tel:{{ theme_st.store_phone }}" class="heading-color no-underline">
                                {{ theme_st.store_phone }}
                              </a>
                            </div>
                          {% endif %}
                          {%- if block_st.store_email and theme_st.store_email != blank -%}
                            <div class="footer__store-info">
                              <a href="mailto:{{ theme_st.store_email }}" class="heading-color no-underline">
                                {{ theme_st.store_email }}
                              </a>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {%- if section_st.show_social -%}
                        <social-icon class="block mt-22">
                          {% render 'social-icons' %}
                        </social-icon>
                      {% endif %}
                    </div>
                  </div>
                {%- when 'payment_badges' -%}
                  {%- comment -%}
                    The payment_badges block holds SETTINGS only — its
                    visible row is rendered in the footer bottom band
                    (alongside the copyright line) so it sits where the
                    legacy payment row used to live. We emit nothing
                    inline here. The bottom-band loop below picks up
                    the block by `{% for block in section.blocks %}`
                    and renders it on the same line as `© ... All rights
                    reserved`.
                  {%- endcomment -%}
                {%- when 'custom_liquid' -%}
                  <div
                    class="footer-block w-full col-md-w-custom-50 col-md-w-custom{% if block.type == 'store_info' %} pb-30 border-bottom border-bottom-md-0{% else %} mb-0 mb-md-20 border-bottom border-bottom-md-0{% endif %} {{ block.type }}"
                    style="--col-width: {{ block_st.content_width }}; --menu-list: {{ menu_item }}"
                    {{ block.shopify_attributes }}
                  >
                    <div
                      class="block {% if scroll_animation == 'slide_in' %}  opacity-0 {% endif %}"
                    >
                      {{ block_st.custom_liquid }}
                    </div>
                  </div>
              {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {% endif %}
  <div class="footer__bottom">
    {%- comment -%} Custom header at the bottom: sits under the menu blocks and above the copyright line. {%- endcomment -%}
    {%- if show_custom_header and custom_header_position == 'bottom' -%}
      {{ footer_custom_header }}
    {%- endif -%}
    <div class="{{ container }}">
      <div class="footer_bottom-inner justify-center justify-md-end flex flex-wrap flex-md-nowrap align-center border-top gap-20 gap-xl-30 py-30">
        {%- if section_st.enable_country_selector
          or section_st.enable_language_selector
          or section_st.copyright_text
        -%}
          <div class="flex flex-wrap gap-10 gap-xl-30 justify-center justify-md-start">
            {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
              <div class="footer__column footer__localization lang__currency-desktop flex flex-nowrap align-center gap-10">
                {%- if section_st.enable_country_selector -%}
                  {%- render 'country-switcher' -%}
                {% endif %}
                {%- if section_st.enable_language_selector -%}
                  {%- render 'language-switcher' -%}
                {% endif %}
              </div>
            {% endif %}
            {%- if section_st.copyright_text %}
              <div class="footer__copyright">{{ section_st.copyright_text }}</div>
            {% endif %}
          </div>
        {% endif %}

        {%- comment -%}
          Payment badges row — rendered HERE (in the bottom band, on
          the same line as the © copyright text) when the merchant has
          added a `payment_badges` block to the footer. The block holds
          the per-badge toggles + alignment; we keep the visual position
          fixed in the bottom band per merchant feedback that the badges
          must sit on the copyright line.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_badges' -%}
            {%- liquid
              assign pb_st = block.settings
              assign pb_any = false
              if pb_st.enable_visa or pb_st.enable_mastercard or pb_st.enable_amex or pb_st.enable_paypal or pb_st.enable_apple_pay or pb_st.enable_google_pay or pb_st.enable_klarna
                assign pb_any = true
              endif
              assign pb_align = pb_st.alignment | default: 'right'
              assign pb_justify_b = 'flex-end'
              if pb_align == 'left'
                assign pb_justify_b = 'flex-start'
              elsif pb_align == 'center'
                assign pb_justify_b = 'center'
              endif
            -%}
            {%- if pb_any -%}
              <div class="footer__payment flex grow-1 align-center max-w-100" style="justify-content: {{ pb_justify_b }};" {{ block.shopify_attributes }}>
                <ul class="footer__payment-badges">
                  {%- if pb_st.enable_visa -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.visa' | t }}">{% render 'payment-icon', method: 'visa', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_mastercard -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.mastercard' | t }}">{% render 'payment-icon', method: 'master', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_amex -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.american_express' | t }}">{% render 'payment-icon', method: 'american_express', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_paypal -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.paypal' | t }}">{% render 'payment-icon', method: 'paypal', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_apple_pay -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.apple_pay' | t }}">{% render 'payment-icon', method: 'apple_pay', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_google_pay -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.google_pay' | t }}">{% render 'payment-icon', method: 'google_pay', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                  {%- if pb_st.enable_klarna -%}
                    <li class="payment-badge" aria-label="{{ 'payment.methods.klarna' | t }}">{% render 'payment-icon', method: 'klarna', icon_class: 'icon icon--full-color' %}</li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>
<script>
  /* Footer columns on phones: one click handler on document for every footer,
     so a footer the builder draws again (storelib:section-load) works at once
     and is never bound twice. A tap toggles .is-open; CSS animates it. */
  (function () {
    var mq = window.matchMedia('(max-width: 767.98px)');
    function sync(scope) {
      var buttons = (scope && scope.querySelectorAll ? scope : document).querySelectorAll('[data-footer-acc-toggle]');
      for (var i = 0; i < buttons.length; i++) {
        var b = buttons[i], acc = b.closest('[data-footer-acc]');
        b.setAttribute('aria-expanded', mq.matches ? String(!!(acc && acc.classList.contains('is-open'))) : 'true');
        if (mq.matches) b.removeAttribute('tabindex'); else b.setAttribute('tabindex', '-1');
      }
    }
    if (!window.MateriaFooterAccordion) {
      window.MateriaFooterAccordion = { sync: sync };
      document.addEventListener('click', function (event) {
        var b = event.target.closest && event.target.closest('[data-footer-acc-toggle]');
        if (!b || !mq.matches) return;
        event.preventDefault();
        var acc = b.closest('[data-footer-acc]');
        if (!acc) return;
        var open = !acc.classList.contains('is-open');
        acc.classList.toggle('is-open', open);
        b.setAttribute('aria-expanded', String(open));
      });
      if (mq.addEventListener) mq.addEventListener('change', function () { sync(); });
      document.addEventListener('storelib:section-load', function (event) { sync(event.target); });
    }
    sync(document.getElementById('shopify-section-{{ section.id }}'));
  })();
{% comment %}{% endcomment %}</script>
</template>

<schema>
{
  "type": "theme-footer",
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Basics"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "Show country selector"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "Show language selector"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "Show social icons",
      "info": "Links in Theme settings"
    },
    {
      "type": "header",
      "id": "hdr_8",
