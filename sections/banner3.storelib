      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "id": "bg_color",
      "type": "color",
      "label": "Banner background colour",
      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "id": "enable_bg_gradient",
      "type": "checkbox",
      "label": "Enable background gradient",
      "default": false,
      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "id": "bg_gradient",
      "type": "color_background",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "id": "overlay_color",
      "type": "color",
      "label": "Tint overlay",
      "info": "Leave empty for a black tint. Set the strength with Tint opacity.",
      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "label": "Tint opacity",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.use_custom_bg }}"
    },
    {
      "type": "select",
      "id": "banner_surface",
      "label": "Banner background",
      "info": "Soft tint makes the banner stand out from the section so its corners, border and shadow show. Custom background colours override this.",
      "default": "soft",
      "options": [
        {
          "value": "soft",
          "label": "Soft tint of the colour scheme"
        },
        {
          "value": "section",
          "label": "Same as the section"
        }
      ]
    },
    {
      "type": "range",
      "id": "banner_tint",
      "label": "Tint strength",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 6,
      "visible_if": "{{ section.settings.banner_surface == 'soft' }}"
    },
    {
      "type": "checkbox",
