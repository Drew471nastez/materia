    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "use_custom_text",
      "label": "Enable custom text colours",
      "default": false
    },
    {
      "type": "color",
