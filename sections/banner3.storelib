    },
    {
      "type": "range",
      "id": "banner_border_width",
      "label": "Banner border",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "banner_border_color",
