<template compat="shopify">
{%- render 'theme-type' -%}
{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign custom = s.enable_custom_style
  assign align = 'center'
  if s.text_align == 'left'
    assign align = 'flex-start'
  elsif s.text_align == 'right'
    assign align = 'flex-end'
  endif
-%}
<style>
  #shopify-section-{{ section.id }}{isolation:isolate;position:relative;margin-block:{{ s.section_margin_top_mobile | default: 0 }}px {{ s.section_margin_bottom_mobile | default: 0 }}px!important;}
  #shopify-section-{{ section.id }} .rm-promo{container-type:inline-size;padding-block:{{ s.section_padding_top | default: 60 }}px {{ s.section_padding_bottom | default: 60 }}px;color:var(--color-text);background:{% if custom %}{% render 'scheme-color', color: s.section_bg_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};font-family:var(--body-font,inherit);font-weight:var(--body-weight,400);}
  #shopify-section-{{ section.id }} .rm-promo__container{box-sizing:border-box;width:100%;margin-inline:auto;}
  {% case s.section_width %}
  {% when 'container' %}#shopify-section-{{ section.id }} .rm-promo__container{max-width:calc(var(--page-width,1300px) + 3rem);padding-inline:1.5rem;}
  {% when 'fluid_container' %}#shopify-section-{{ section.id }} .rm-promo__container{max-width:calc(var(--fluid-container-width,1500px) + 3rem);padding-inline:1.5rem;}
  {% when 'stretch_width' %}#shopify-section-{{ section.id }} .rm-promo__container{padding-inline:clamp(15px,2vw,30px);}
  {% endcase %}
  #rm-hero-{{ section.id }}{position:relative;isolation:isolate;box-sizing:border-box;overflow:hidden;margin-inline:{{ s.section_pad_left_mobile | default: 20 }}px {{ s.section_pad_right_mobile | default: 20 }}px;padding:{{ s.pad_top_mobile | default: 50 }}px {{ s.side_padding | default: 16 }}px {{ s.pad_bottom_mobile | default: 56 }}px;background:var(--color-background);border-radius:var(--rounded-radius,0px);}
  {% if custom %}
  #rm-hero-{{ section.id }}{background:{% render 'scheme-color', color: s.bg_color, fallback: 'var(--color-background)' %};{% if s.enable_bg_gradient and s.bg_gradient != blank %}background-image:{{ s.bg_gradient }};{% endif %}border-radius:{{ s.section_border_radius | default: 0 }}px;}
  #rm-hero-{{ section.id }}::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:{% render 'scheme-color', color: s.overlay_color, fallback: 'transparent' %};opacity:{{ s.overlay_opacity | default: 0 | divided_by: 100.0 }};}
  {% endif %}
  #rm-hero-{{ section.id }} .rm-hero__inner{position:relative;display:flex;flex-direction:column;align-items:{{ align }};gap:{{ s.stack_gap | default: 18 }}px;text-align:{{ s.text_align | default: 'center' }};max-width:{{ s.max_width | default: 760 }}px;margin-inline:auto;min-width:0;}
  #rm-hero-{{ section.id }} :is(.rm-hero__eyebrow,.rm-hero__heading,.rm-hero__sub){margin:0;max-width:100%;overflow-wrap:anywhere;}
  #rm-hero-{{ section.id }} .rm-hero__eyebrow{font:inherit;color:var(--color-heading);}
  #rm-hero-{{ section.id }} .rm-hero__heading{font-family:var(--heading-font,inherit);font-weight:var(--heading-weight,600);font-size:var(--h2-size,2.4rem);line-height:var(--heading-line-height,1.15);letter-spacing:var(--heading-letter-spacing,normal);color:var(--color-heading);}
  #rm-hero-{{ section.id }} .rm-hero__sub{font:inherit;font-size:var(--body-font-size,16px);line-height:var(--body-line-height,1.6);color:var(--color-text);}
  #rm-hero-{{ section.id }} .rm-hero__btn{display:inline-flex;align-items:center;justify-content:center;max-width:100%;width:fit-content;text-align:center;white-space:normal;overflow-wrap:anywhere;box-sizing:border-box;}
  #rm-hero-{{ section.id }} .rm-hero__sub + .rm-hero__btn{margin-top:calc({{ s.sub_btn_gap | default: 30 }}px - {{ s.stack_gap | default: 18 }}px);}
  @media(min-width:768px){#shopify-section-{{ section.id }}{margin-block:{{ s.section_margin_top_desktop | default: 0 }}px {{ s.section_margin_bottom_desktop | default: 0 }}px!important;}}
  @container(min-width:750px){#rm-hero-{{ section.id }}{margin-inline:{{ s.section_pad_left | default: 20 }}px {{ s.section_pad_right | default: 20 }}px;padding-block:{{ s.pad_top_desktop | default: 70 }}px {{ s.pad_bottom_desktop | default: 50 }}px;}}
  {% for block in section.blocks %}
    {% assign b = block.settings %}
    {% if b.enable_custom_style %}
    #rm-hero-{{ section.id }} [data-promo-block="{{ block.id }}"]{
      {% case block.type %}
      {% when 'eyebrow' %}color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-heading)' %};font-weight:{{ b.weight }};text-transform:{{ b.transform }};letter-spacing:{{ b.letterspace }}em;opacity:{{ b.opacity | divided_by: 100.0 }};font-size:{{ b.size_m }}px;
      {% when 'heading' %}color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-heading)' %};font-weight:{{ b.weight }};line-height:{{ b.lineheight }};letter-spacing:{{ b.letterspace }}em;font-size:{{ b.size_m }}px;
      {% when 'subheading' %}color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-text)' %};line-height:{{ b.lineheight }};opacity:{{ b.opacity | divided_by: 100.0 }};font-size:{{ b.size_m }}px;
      {% when 'button' %}{% render 'button-overrides', bg: b.bg, text: b.text_color, border: b.border_color %}{% unless b.use_theme_button %}--btn-border-width:{{ b.border_width }}px;--mb-radius:{{ b.radius }}px;--mb-padding-y:{{ b.pad_v }}px;--mb-padding-x:{{ b.pad_h }}px;--mb-weight:{{ b.weight }};--mb-font-size:{{ b.size_m }}px;{% endunless %}
      {% endcase %}
    }
    @container(min-width:750px){#rm-hero-{{ section.id }} [data-promo-block="{{ block.id }}"]{ {% if block.type == 'button' %}{% unless b.use_theme_button %}--mb-font-size:{{ b.size_d }}px;{% endunless %}{% else %}font-size:{{ b.size_d }}px;{% endif %} }}
    {% endif %}
  {% endfor %}
</style>
<div class="rm-promo color-{{ scheme }}{% unless s.reset_spacing %} section-spacing-top{% endunless %}{% if s.reveal != false and settings.scroll_animation != blank and settings.scroll_animation != 'none' %} scroll-trigger {{ settings.scroll_animation }}{% endif %}" data-promo-banner3 style="--animation-duration:{{ settings.animation_duration | default: 700 }}ms;--animation-delay:{{ settings.animation_delay | default: 0 }}ms;">
  {% if s.reveal == false %}<span data-ti-no-reveal hidden></span>{% endif %}
  <div class="rm-promo__container">
    <section class="rm-hero" id="rm-hero-{{ section.id }}" data-section-id="{{ section.id }}">
      <div class="rm-hero__inner">
      {% for block in section.blocks %}
        {% if block.hidden %}{% continue %}{% endif %}
        {% assign b = block.settings %}
        {% case block.type %}
        {% when 'eyebrow' %}{% if b.text != blank %}<div class="rm-hero__eyebrow" data-promo-block="{{ block.id }}" {{ block.shopify_attributes }}>{{ b.text | escape }}</div>{% endif %}
        {% when 'heading' %}{% if b.text != blank %}<h2 class="rm-hero__heading" data-promo-block="{{ block.id }}"{% if b.max_width > 0 %} style="max-width:{{ b.max_width }}ch"{% endif %} {{ block.shopify_attributes }}>{{ b.text | escape }}</h2>{% endif %}
        {% when 'subheading' %}{% if b.text != blank %}<p class="rm-hero__sub" data-promo-block="{{ block.id }}"{% if b.max_width > 0 %} style="max-width:{{ b.max_width }}ch"{% endif %} {{ block.shopify_attributes }}>{{ b.text | escape }}</p>{% endif %}
        {% when 'button' %}{% if b.label != blank and b.link != blank %}<a class="rm-hero__btn" data-promo-block="{{ block.id }}" data-theme-button="primary" data-sl-button data-button-role="primary" href="{{ b.link | url | escape }}" {{ block.shopify_attributes }}>{{ b.label | escape }}</a>{% endif %}
        {% endcase %}
      {% endfor %}
      </div>
    </section>
  </div>
</div>
</template>

<schema>
{
  "shopify": {
    "name": "Promo Banner 3",
    "tag": "section",
    "class": "section section-edge-bleed",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "stretch_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "id": "text_align",
        "type": "select",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "id": "max_width",
        "type": "range",
        "label": "Content max width",
        "min": 480,
        "max": 1400,
        "step": 10,
        "unit": "px",
        "default": 760
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off uses the selected theme colour scheme. Layout and spacing controls always apply."
      },
      {
        "id": "section_bg_color",
        "type": "color",
        "label": "Section background color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "bg_color",
        "type": "color",
        "label": "Banner background color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "enable_bg_gradient",
        "type": "checkbox",
        "label": "Enable background gradient",
        "default": false,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "bg_gradient",
        "type": "color_background",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "overlay_color",
        "type": "color",
        "label": "Tint overlay",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "overlay_opacity",
        "type": "range",
        "label": "Tint opacity",
        "min": 0,
        "max": 90,
        "step": 1,
        "unit": "%",
        "default": 0,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "id": "section_border_radius",
        "type": "range",
        "label": "Section border radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "id": "section_padding_top",
        "type": "range",
        "label": "Section top padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "id": "section_padding_bottom",
        "type": "range",
        "label": "Section bottom padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "id": "side_padding",
        "type": "range",
        "label": "Inner side padding",
        "min": 0,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "id": "stack_gap",
        "type": "range",
        "label": "Vertical gap between most blocks",
        "min": 4,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "id": "sub_btn_gap",
        "type": "range",
        "label": "Subheading to button gap",
        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "id": "pad_top_desktop",
        "type": "range",
        "label": "Banner top padding (desktop)",
        "info": "Padding inside the banner container.",
        "min": 0,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 70
      },
      {
        "id": "pad_bottom_desktop",
        "type": "range",
        "label": "Banner bottom padding (desktop)",
        "info": "Padding inside the banner container.",
        "min": 0,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 50
      },
      {
        "id": "section_pad_left",
        "type": "range",
        "label": "Overall left padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 20
      },
      {
        "id": "section_pad_right",
        "type": "range",
        "label": "Overall right padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "id": "pad_top_mobile",
        "type": "range",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 10,
        "unit": "px",
        "default": 50
      },
      {
        "id": "pad_bottom_mobile",
        "type": "range",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "id": "section_pad_left_mobile",
        "type": "range",
        "label": "Overall left padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 20
      },
      {
        "id": "section_pad_right_mobile",
        "type": "range",
        "label": "Overall right padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Top text (eyebrow)",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "id": "text",
            "type": "text",
            "label": "Text",
            "default": "Real Moments"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off follows the theme’s typography, weights, colours and buttons."
          },
          {
            "id": "color",
            "type": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "weight",
            "type": "select",
            "label": "Font weight",
            "default": "500",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "transform",
            "type": "select",
            "label": "Transform",
            "default": "uppercase",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "letterspace",
            "type": "range",
            "label": "Letter-spacing",
            "min": 0,
            "max": 1,
            "step": 0.1,
            "default": 0.6,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "opacity",
            "type": "range",
            "label": "Opacity",
            "min": 20,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 100,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "size_d",
            "type": "range",
            "label": "Size (desktop)",
            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 17,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Mobile"
          },
          {
            "id": "size_m",
            "type": "range",
            "label": "Size (mobile)",
            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 17,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "id": "text",
            "type": "text",
            "label": "Heading text",
            "default": "Wear It Your Way"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off follows the theme’s typography, weights, colours and buttons."
          },
          {
            "id": "color",
            "type": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "weight",
            "type": "select",
            "label": "Font weight",
            "default": "700",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "lineheight",
            "type": "text",
            "label": "Line-height",
            "default": "1.15",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "letterspace",
            "type": "range",
            "label": "Letter-spacing",
            "min": -0.1,
            "max": 1,
            "step": 0.1,
            "default": 0,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "size_d",
            "type": "range",
            "label": "Size (desktop)",
            "min": 18,
            "max": 72,
            "step": 1,
            "unit": "px",
            "default": 34,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "id": "max_width",
            "type": "range",
            "label": "Max width (characters)",
            "min": 0,
            "max": 80,
            "step": 1,
            "default": 0
          },
          {
            "type": "header",
            "content": "Mobile"
          },
          {
            "id": "size_m",
            "type": "range",
            "label": "Size (mobile)",
            "min": 16,
            "max": 46,
            "step": 1,
            "unit": "px",
            "default": 28,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "id": "text",
            "type": "text",
            "label": "Subheading text",
            "default": "See our pieces in real-life settings — from weekend escapes to daily city life."
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off follows the theme’s typography, weights, colours and buttons."
          },
          {
            "id": "color",
            "type": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "lineheight",
            "type": "text",
            "label": "Line-height",
            "default": "1.5",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "opacity",
            "type": "range",
            "label": "Opacity",
            "min": 40,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 100,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "id": "size_d",
            "type": "range",
            "label": "Size (desktop)",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
