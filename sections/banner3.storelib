<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>

<style>
  /* ── Theme typography (from your Typography Preset) ── */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  
  /* ── Section margin sliders ── */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* ── Section width — CSS-only, no HTML wrapper ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}

  /* ── Reset spacing ── */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} {
      margin-bottom: 0 !important;
      margin-top: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->

<section
  class="rm-hero color-{{ color_scheme }} gradient {{ section.settings.section_width }}"
  id="rm-hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <style>
    /* Section-level padding + background around the whole section (separate from banner inner) */
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.section_padding_top | default: 60 }}px;
      padding-bottom: {{ section.settings.section_padding_bottom | default: 60 }}px;
      {% if section.settings.section_bg_color != blank %}
        background-color: {{ section.settings.section_bg_color }} !important;
      {% endif %}
    }
    /* ---- Scoped variables ---- */
    #rm-hero-{{ section.id }}{
      --rm-bg: {% render 'scheme-color', color: section.settings.bg_color, fallback: 'var(--color-background)' %};
      --rm-gradient: {% if section.settings.enable_bg_gradient and section.settings.bg_gradient != blank %}{{ section.settings.bg_gradient }}{% else %}none{% endif %};
      --rm-overlay: {% render 'scheme-color', color: section.settings.overlay_color, fallback: 'transparent' %};
      --rm-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --rm-content-max: {{ section.settings.max_width }}px;
      --rm-align: {{ section.settings.text_align }};
      --rm-gap: {{ section.settings.stack_gap }}px;
      --rm-pt: {{ section.settings.pad_top_desktop }}px;
      --rm-pb: {{ section.settings.pad_bottom_desktop }}px;
      --rm-pt-m: {{ section.settings.pad_top_mobile }}px;
      --rm-pb-m: {{ section.settings.pad_bottom_mobile }}px;
      --rm-mt: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      --rm-mb: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
      --rm-mt-m: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
      --rm-mb-m: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
      --rm-section-pad-left: {{ section.settings.section_pad_left }}px;
      --rm-section-pad-right: {{ section.settings.section_pad_right }}px;
      --rm-section-pad-left-m: {{ section.settings.section_pad_left_mobile }}px;
      --rm-section-pad-right-m: {{ section.settings.section_pad_right_mobile }}px;
      --rm-section-radius: {{ section.settings.section_border_radius }}px;
      --rm-sub-btn-gap: {{ section.settings.sub_btn_gap }}px;
      --rm-inner-pad: {{ section.settings.side_padding }}px;
    }

    {% for block in section.blocks %}
      {% if block.type == 'eyebrow' %}
        #rm-hero-{{ section.id }} .rm-hero__eyebrow {
          --rm-eyebrow-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
          --rm-eyebrow-weight: {{ block.settings.weight }};
          --rm-eyebrow-transform: {{ block.settings.transform }};
          --rm-eyebrow-letterspace: {{ block.settings.letterspace }}em;
          --rm-eyebrow-opacity: {{ block.settings.opacity | divided_by: 100.0 }};
          --rm-eyebrow-size-d: {{ block.settings.size_d }}px;
          --rm-eyebrow-size-m: {{ block.settings.size_m }}px;
        }
      {% elsif block.type == 'heading' %}
        #rm-hero-{{ section.id }} .rm-hero__heading {
          --rm-heading-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
          --rm-heading-weight: {{ block.settings.weight }};
          --rm-heading-lineheight: {{ block.settings.lineheight }};
          --rm-heading-letterspace: {{ block.settings.letterspace }}em;
          --rm-heading-size-d: {{ block.settings.size_d }}px;
          --rm-heading-size-m: {{ block.settings.size_m }}px;
        }
      {% elsif block.type == 'subheading' %}
        #rm-hero-{{ section.id }} .rm-hero__sub {
          --rm-sub-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %} !important;
          --rm-sub-lineheight: {{ block.settings.lineheight }};
          --rm-sub-opacity: {{ block.settings.opacity | divided_by: 100.0 }};
          --rm-sub-size-d: {{ block.settings.size_d }}px;
          --rm-sub-size-m: {{ block.settings.size_m }}px;
        }
      {% elsif block.type == 'button' %}
        #rm-hero-{{ section.id }} .rm-hero__btn {
          --rm-btn-bg: {% render 'scheme-color', color: block.settings.bg, fallback: 'var(--btn-primary-bg-color)' %};
          --rm-btn-text: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--btn-primary-color)' %};
          --rm-btn-border: {% render 'scheme-color', color: block.settings.border_color, fallback: 'var(--btn-primary-border-color)' %};
          {%- if block.settings.use_theme_button -%}
          --rm-btn-border-width: var(--btn-border-width, 1px);
          --rm-btn-radius: var(--btn-radius, 8px);
          --rm-btn-pad-v: var(--btn-padding-y, 14px);
          --rm-btn-pad-h: var(--btn-padding-x, 26px);
          --rm-btn-weight: var(--btn-font-weight, 500);
          --rm-btn-size-d: var(--btn-font-size, 14px);
          --rm-btn-size-m: var(--btn-font-size, 14px);
          {%- else -%}
          --rm-btn-border-width: {{ block.settings.border_width }}px;
          --rm-btn-radius: {{ block.settings.radius }}px;
          --rm-btn-pad-v: {{ block.settings.pad_v }}px;
          --rm-btn-pad-h: {{ block.settings.pad_h }}px;
          --rm-btn-weight: {{ block.settings.weight }};
          --rm-btn-size-d: {{ block.settings.size_d }}px;
          --rm-btn-size-m: {{ block.settings.size_m }}px;
          {%- endif -%}
        }
      {% endif %}
    {% endfor %}

    #rm-hero-{{ section.id }}{
      position: relative;
      width: calc(100% - var(--rm-section-pad-left-m) - var(--rm-section-pad-right-m));
      margin: var(--rm-mt) auto var(--rm-mb);
      background: var(--rm-bg);
      background-image: var(--rm-gradient);
      padding: var(--rm-pt) var(--rm-inner-pad) var(--rm-pb) var(--rm-inner-pad);
      border-radius: var(--rm-section-radius);
      overflow: hidden;
    }
    @media (min-width: 750px){
      #rm-hero-{{ section.id }}{
        width: calc(100% - var(--rm-section-pad-left) - var(--rm-section-pad-right));
      }
    }
    @media (max-width: 749px){
      #rm-hero-{{ section.id }}{
        padding: var(--rm-pt-m) var(--rm-inner-pad) var(--rm-pb-m) var(--rm-inner-pad);
        margin: var(--rm-mt-m) auto var(--rm-mb-m);
      }
    }
    #rm-hero-{{ section.id }} .rm-hero__inner{
      position: relative;
      z-index: 1;
      max-width: var(--rm-content-max);
      margin-inline: auto;
      text-align: var(--rm-align);
      display: flex;
      flex-direction: column;
      align-items: var(--rm-align);
      padding-inline: 0;
    }
    #rm-hero-{{ section.id }}::before{
      content:"";
      position:absolute; inset:0;
      background: var(--rm-overlay);
      opacity: var(--rm-overlay-opacity);
      pointer-events:none;
    }

    /* Block base */
    #rm-hero-{{ section.id }} .rm-hero__eyebrow{
      font-weight: var(--rm-eyebrow-weight);
      letter-spacing: var(--rm-eyebrow-letterspace);
      text-transform: var(--rm-eyebrow-transform);
      opacity: var(--rm-eyebrow-opacity);
      color: var(--rm-eyebrow-color);
      margin-bottom: var(--rm-gap);
    }
    #rm-hero-{{ section.id }} .rm-hero__heading{
      margin: 0 0 var(--rm-gap) 0;
      line-height: var(--rm-heading-lineheight);
      font-weight: var(--rm-heading-weight);
      color: var(--rm-heading-color) !important;
      letter-spacing: var(--rm-heading-letterspace);
    }
    #rm-hero-{{ section.id }} .rm-hero__sub{
      margin: 0 0 var(--rm-sub-btn-gap) 0;
      line-height: var(--rm-sub-lineheight);
      color: var(--rm-sub-color);
      opacity: var(--rm-sub-opacity);
    }

    /* Sizes (desktop) */
    #rm-hero-{{ section.id }} .rm-hero__eyebrow{
      font-size: var(--rm-eyebrow-size-d);
    }
    #rm-hero-{{ section.id }} .rm-hero__heading{
      font-size: var(--rm-heading-size-d);
    }
    #rm-hero-{{ section.id }} .rm-hero__sub{
      font-size: var(--rm-sub-size-d);
    }

    /* Button */
    #rm-hero-{{ section.id }} .rm-hero__btn{
      display: inline-flex;
      align-items:center;
      justify-content:center;
      gap:.5rem;
      padding: var(--rm-btn-pad-v) var(--rm-btn-pad-h);
      border-radius: var(--rm-btn-radius);
      background: var(--rm-btn-bg);
      color: var(--rm-btn-text);
      border: var(--rm-btn-border-width) solid var(--rm-btn-border);
      text-decoration:none;
      font-weight: var(--rm-btn-weight);
      font-size: var(--rm-btn-size-d);
      margin-bottom: 0;
      width: max-content;
    }
    #rm-hero-{{ section.id }} .rm-hero__btn:hover{
      filter: brightness(1.08);
    }

    /* Mobile */
    @media (max-width: 749px){
      #rm-hero-{{ section.id }} .rm-hero__eyebrow{
        font-size: var(--rm-eyebrow-size-m);
      }
      #rm-hero-{{ section.id }} .rm-hero__heading{
        font-size: var(--rm-heading-size-m);
      }
      #rm-hero-{{ section.id }} .rm-hero__sub{
        font-size: var(--rm-sub-size-m);
      }
      #rm-hero-{{ section.id }} .rm-hero__btn{
        font-size: var(--rm-btn-size-m);
      }
    }
{% comment %}{% endcomment %}  </style>

  <div class="rm-hero__inner">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'eyebrow' %}
          {% if block.settings.text != blank %}
            <div class="rm-hero__eyebrow" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}

        {% when 'heading' %}
          {% if block.settings.text != blank %}
            <h2 class="rm-hero__heading" style="
              {% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}ch;{% endif %}
            " {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </h2>
          {% endif %}

        {% when 'subheading' %}
          {% if block.settings.text != blank %}
            <p class="rm-hero__sub" style="
              {% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}ch;{% endif %}
            " {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>
          {% endif %}

        {% when 'button' %}
          {% if block.settings.label != blank and block.settings.link != blank %}
            <a class="rm-hero__btn" data-sl-button data-button-role="primary" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </a>
          {% endif %}

      {% endcase %}
    {% endfor %}
  </div>
</section>


</template>

<schema>
{
  "type": "banner3",
  "name": "Promo Banner 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "stretch_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Typography"
    },
    {
      "id": "text_align",
      "type": "select",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style & Colors"
    },
    {
      "id": "section_bg_color",
      "type": "color",
      "label": "Section background color"
    },
    {
      "id": "bg_color",
      "type": "color",
      "label": "Banner background color"
    },
    {
      "id": "enable_bg_gradient",
      "type": "checkbox",
      "label": "Enable background gradient",
      "default": false
    },
    {
      "id": "bg_gradient",
      "type": "color_background",
      "label": "Background gradient"
    },
    {
      "id": "overlay_color",
      "type": "color",
      "label": "Tint overlay"
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "label": "Tint opacity",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "id": "section_border_radius",
      "type": "range",
      "label": "Section border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Layout & Spacing"
    },
    {
      "id": "max_width",
      "type": "range",
      "label": "Content max width",
      "min": 480,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 760
    },
    {
      "id": "side_padding",
      "type": "range",
      "label": "Inner side padding",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "id": "stack_gap",
      "type": "range",
      "label": "Vertical gap between most blocks",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "id": "sub_btn_gap",
      "type": "range",
      "label": "Vertical gap between subheading and button",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "id": "pad_top_desktop",
      "type": "range",
      "label": "Banner top padding (desktop)",
      "info": "Padding inside the banner container.",
      "min": 0,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 70
    },
    {
      "id": "pad_bottom_desktop",
      "type": "range",
      "label": "Banner bottom padding (desktop)",
      "info": "Padding inside the banner container.",
      "min": 0,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "id": "section_pad_left",
      "type": "range",
      "label": "Overall left padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "id": "section_pad_right",
      "type": "range",
      "label": "Overall right padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "id": "section_padding_top",
      "type": "range",
      "label": "Section top padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "id": "section_padding_bottom",
      "type": "range",
      "label": "Section bottom padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Mobile"
    },
    {
      "id": "pad_top_mobile",
      "type": "range",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "id": "pad_bottom_mobile",
      "type": "range",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "id": "section_pad_left_mobile",
      "type": "range",
      "label": "Overall left padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "id": "section_pad_right_mobile",
      "type": "range",
      "label": "Overall right padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Top text (eyebrow)",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "id": "text",
          "type": "text",
