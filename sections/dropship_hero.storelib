<template>
<section class="dh" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ settings.text_color }}; --s-heading: {{ settings.heading_color }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ settings.button_color }}; --s-btn-text: {{ settings.button_text_color }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --dh-focal: {{ settings.image_focal | default: '50% 50%' }};">
  <div class="dh__in dh__in--{{ settings.max_width }} dh__in--{{ settings.photo_side }}">

    <figure class="dh__media dh__media--{{ settings.photo_shape }}">
      {% if settings.image %}
        <img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" width="1200" height="1200" loading="eager" decoding="async">
      {% elsif settings.product.settings.image %}
        <img src="{{ settings.product.settings.image | asset }}" alt="{{ settings.product.settings.title }}" width="1200" height="1200" loading="eager" decoding="async">
      {% elsif page.in_editor %}
        <div class="dh__empty">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-8 8"/></svg>
          <span>{{ settings.image_hint }}</span>
        </div>
      {% endif %}
      {% if settings.badge_text %}<span class="dh__badge">{{ settings.badge_text }}</span>{% endif %}
    </figure>

    <div class="dh__copy">
      {% if settings.heading %}<h1 class="dh__h">{{ settings.heading | raw }}</h1>{% endif %}
      {% if settings.text %}<div class="dh__text">{{ settings.text | raw }}</div>{% endif %}

      {% if settings.product.settings.price %}
        <p class="dh__price">
          <span class="dh__now">{{ settings.product.settings.price }}</span>
          {% if settings.product.settings.compare_price %}<s class="dh__was">{{ settings.product.settings.compare_price }}</s>{% endif %}
        </p>
      {% elsif page.in_editor %}
        <p class="dh__note-editor">{{ settings.product_hint }}</p>
      {% endif %}

      {% if settings.button_text or settings.secondary_text %}
        <div class="dh__actions">
          {% if settings.button_text %}<a class="dh__btn" data-sl-button href="{{ settings.product.settings.url | default: settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
          {% if settings.secondary_text %}<a class="dh__link" href="{{ settings.secondary_url | default: '#' | url }}">{{ settings.secondary_text }}</a>{% endif %}
        </div>
      {% endif %}

      {% if settings.proof %}<p class="dh__proof">{{ settings.proof }}</p>{% endif %}

      {% for block in blocks %}
        {% if forloop.first %}<ul class="dh__list">{% endif %}
        <li class="dh__item" data-block-id="{{ block.id }}">
          <span class="dh__icon" aria-hidden="true">
            {% if block.settings.icon == 'truck' %}
              <svg viewBox="0 0 24 24"><path d="M2 6h11v10H2z"/><path d="M13 9h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
            {% elsif block.settings.icon == 'return' %}
              <svg viewBox="0 0 24 24"><path d="M9 14L4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-4"/></svg>
            {% elsif block.settings.icon == 'lock' %}
              <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {% endif %}
          </span>
          <span class="dh__itxt">
            {% if block.settings.title %}<span class="dh__ititle">{{ block.settings.title | raw }}</span>{% endif %}
            {% if block.settings.text %}<span>{{ block.settings.text }}</span>{% endif %}
          </span>
        </li>
        {% if forloop.last %}</ul>{% endif %}
      {% else %}
        {% if page.in_editor %}<p class="dh__note-editor">Add assurances in the sidebar</p>{% endif %}
      {% endfor %}
    </div>

  </div>
</section>
</template>

<style scoped>
.dh { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); }
.dh__in { display: grid; gap: 32px; margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); align-items: center; }
.dh__in--medium { max-width: 960px; }
.dh__in--wide { max-width: var(--theme-page-width, 1280px); }
.dh__in--full { max-width: none; }

.dh__media { position: relative; margin: 0; overflow: hidden; border-radius: var(--theme-image-radius, 8px); background: var(--s-border); isolation: isolate; }
.dh__media--square { aspect-ratio: 1 / 1; }
.dh__media--portrait { aspect-ratio: 4 / 5; }
.dh__media--landscape { aspect-ratio: 4 / 3; }
.dh__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--dh-focal); transition: transform 400ms ease; }
.dh__media:hover img { transform: scale(1.04); }
.dh__empty { height: 100%; display: grid; place-content: center; justify-items: center; gap: 8px; padding: 24px; text-align: center; font-size: 14px; border: 1px dashed var(--s-text); border-radius: inherit; opacity: 0.6; background: var(--s-bg); }
.dh__empty svg { width: 48px; height: 48px; fill: none; stroke: var(--s-text); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.dh__badge { position: absolute; top: 16px; left: 16px; z-index: 1; padding: 6px 12px; font-size: 13px; font-weight: 600; line-height: 1.2; background: var(--s-btn); color: var(--s-btn-text); border-radius: 6px; }

.dh__copy { min-width: 0; }
.dh__h { margin: 0; color: var(--s-heading); font-family: var(--theme-font-heading); font-size: clamp(30px, 5cqi, 48px); line-height: 1.1; font-weight: var(--section-heading-weight, 700); letter-spacing: -0.01em; overflow-wrap: break-word; }
.dh__text { margin-top: 16px; max-width: 36rem; font-size: var(--section-text-size, 16px); line-height: 1.6; }
.dh__text > :first-child { margin-top: 0; }
.dh__text > :last-child { margin-bottom: 0; }

.dh__price { display: flex; align-items: baseline; gap: 12px; margin: 24px 0 0; }
.dh__now { font-size: 24px; font-weight: 700; color: var(--s-heading); }
.dh__was { font-size: 16px; opacity: 0.7; }

.dh__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 24px; }
.dh__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 28px; font-size: 16px; font-weight: 600; text-decoration: none; background: var(--s-btn); color: var(--s-btn-text); border: 1px solid var(--s-btn); border-radius: 8px; transition: opacity 200ms ease, transform 200ms ease; }
.dh__btn:hover { opacity: 0.88; transform: translateY(-1px); }
.dh__link { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 4px; transition: opacity 200ms ease; }
.dh__link:hover { opacity: 0.7; }
.dh__btn:focus-visible, .dh__link:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }

.dh__proof { margin: 16px 0 0; font-size: 14px; opacity: 0.85; }

.dh__list { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--s-border); }
.dh__item { display: flex; align-items: flex-start; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--s-border); }
.dh__icon { flex: none; width: 24px; height: 24px; color: var(--s-heading); }
.dh__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.dh__itxt { display: grid; gap: 4px; font-size: 14px; line-height: 1.5; }
.dh__ititle { font-size: 15px; font-weight: 600; color: var(--s-heading); }

.dh__note-editor { margin: 16px 0 0; font-size: 13px; opacity: 0.6; }

@container (min-width: 760px) {
  .dh__in { gap: 56px; }
  .dh__in--right { grid-template-columns: 5fr 7fr; }
  .dh__in--right .dh__media { order: 2; }
  .dh__in--left { grid-template-columns: 7fr 5fr; }
}

@media (prefers-reduced-motion: reduce) {
  .dh__media img, .dh__btn, .dh__link { transition: none; }
  .dh__media:hover img, .dh__btn:hover { transform: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "dropship_hero",
  "name": "Dropship Product Hero",
  "category": "hero",
  "description": "One product, its live price and a buy button, beside a large photo and a short list of shopping assurances.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    {
      "type": "header",
      "id": "hdr_product",
      "label": "Product"
    },
    {
      "type": "product_picker",
      "id": "product",
      "label": "Product",
      "info": "Its price, compare price and link come from your store."
    },
    {
      "type": "text",
      "id": "product_hint",
      "label": "Note when no product is chosen",
      "default": "Choose a product in the sidebar to show its price"
    },
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The everyday essential, delivered to your door"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Made for daily use, priced fairly and sent straight to you with tracking from the moment it ships.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Shop the product"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link when no product is chosen",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Second link",
      "default": "Shipping and returns"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Second link address",
      "default": "/policies/shipping-policy"
    },
    {
      "type": "text",
      "id": "proof",
      "label": "Line under the button",
      "default": "",
      "info": "Only real proof, such as a review count from your store."
    },
    {
      "type": "header",
      "id": "hdr_media",
      "label": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "default": "",
      "info": "Leave empty to use the product's own photo."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "default": "The product"
    },
    {
      "type": "focal_point",
      "id": "image_focal",
      "label": "Photo focus",
      "default": "50% 50%"
    },
    {
      "type": "text",
      "id": "image_hint",
      "label": "Empty photo note",
      "default": "Add the product photo"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge on photo",
      "default": "New"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "radio",
      "id": "photo_side",
      "label": "Photo side",
      "default": "right",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "photo_shape",
      "label": "Photo shape",
      "default": "square",
      "options": [
        {
          "label": "Square",
          "value": "square"
        },
        {
          "label": "Portrait",
          "value": "portrait"
        },
        {
          "label": "Landscape",
          "value": "landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "scheme.text"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "scheme.primary_button_background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "scheme.primary_button_text"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "assurance",
      "name": "Assurance",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "label": "Delivery truck",
              "value": "truck"
            },
            {
              "label": "Return arrow",
              "value": "return"
            },
            {
              "label": "Lock",
              "value": "lock"
            },
            {
              "label": "Clock",
              "value": "clock"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Tracked delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Line",
          "default": "A tracking link arrives by email once your order ships."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": []
}
</schema>