        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Bottom padding (mobile)",
        "default": 50
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS"
      }
    ],
    "blocks": [
      {
        "name": "Image",
        "type": "image",
        "limit": 9,
        "settings": [
          {
            "type": "image_picker",
