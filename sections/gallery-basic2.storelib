        "max": 3,
        "step": 1,
        "default": 1
      },
      {
        "type": "select",
        "id": "img_proportion_mobile",
        "label": "Image shape (mobile)",
        "options": [
          {
            "value": "100%",
            "label": "1x1"
          },
          {
            "value": "150%",
            "label": "2x3"
          },
          {
            "value": "133.333%",
            "label": "3x4"
          },
          {
            "value": "75%",
            "label": "4x3"
          },
          {
            "value": "56.25%",
            "label": "16x9"
          },
          {
            "value": "42.857%",
            "label": "21x9"
          },
          {
            "value": "125%",
            "label": "4x5"
          },
          {
            "value": "80%",
            "label": "5x4"
          }
        ],
        "default": "80%"
