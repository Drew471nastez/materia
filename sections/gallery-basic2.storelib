      },
      {
        "type": "range",
        "id": "icon_size",
        "min": 8,
        "max": 64,
        "step": 1,
        "unit": "px",
        "label": "Link arrow size",
        "default": 32
      },
      {
        "type": "checkbox",
        "id": "lazyload",
        "default": true,
        "label": "Load images as they scroll into view"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Gallery background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "link_bg",
        "label": "Link button background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Link arrow colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "section_padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Top padding (desktop)",
        "default": 50
      },
      {
        "type": "range",
        "id": "section_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Bottom padding (desktop)",
        "default": 50
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
