<template compat="shopify">
{%- render 'theme-type' -%}
{%- render 'password-launch-content', section: section -%}
</template>

<schema>
{
  "type": "coming-soon",
  "name": "Coming soon",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "enable_logo",
      "label": "Show logo",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo",
      "info": "Empty: the theme logo.",
      "visible_if": "{{ section.settings.enable_logo }}"
    },
    {
      "type": "checkbox",
      "id": "show_owner_login",
      "label": "Show owner sign in link",
      "default": true
    },
    {
      "type": "text",
      "id": "owner_login_label",
      "label": "Owner link label",
      "default": "Website owner? Log in",
      "visible_if": "{{ section.settings.show_owner_login }}"
    },
    {
      "type": "url",
      "id": "owner_login_url",
      "label": "Owner link",
      "default": "https://storelib.com",
      "visible_if": "{{ section.settings.show_owner_login }}"
    },
    {
      "type": "checkbox",
      "id": "owner_open_new_tab",
      "label": "Open owner link in a new tab",
      "default": true,
      "visible_if": "{{ section.settings.show_owner_login }}"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Minutes label",
      "default": "Minutes"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Seconds label",
      "default": "Seconds"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Messages"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Signup button",
      "default": "Join the waitlist"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks, you’re on the list."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "Please try again."
    },
    {
      "type": "select",
      "id": "preview_submit_mode",
      "label": "Waitlist in the builder",
      "default": "live",
      "options": [
        {
          "value": "preview",
          "label": "Preview only"
        },
        {
          "value": "live",
          "label": "Save emails"
        }
      ],
      "info": "Preview only never saves email addresses. Save subscribers makes a real request and requires StoreLib to enable subscriber submissions for this preview."
    },
    {
      "type": "text",
      "id": "preview_success_text",
      "label": "Preview message",
      "default": "Preview complete. No email was saved.",
      "visible_if": "{{ section.settings.preview_submit_mode == 'preview' }}"
    },
    {
      "type": "text",
      "id": "preview_subscribed_label",
      "label": "Preview button label",
      "default": "Subscribed (preview)",
      "visible_if": "{{ section.settings.preview_submit_mode == 'preview' }}"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "fill_screen",
      "label": "Fill the screen height",
      "default": true
    },
    {
      "type": "range",
      "id": "viewport_height",
      "label": "Height",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 84,
      "visible_if": "{{ section.settings.fill_screen == false }}",
      "info": "A share of the screen height."
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Space between blocks",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "signup_layout",
      "label": "Signup layout",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Media"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_bg_image",
      "label": "Background picture",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "custom_bg_image",
      "label": "Picture",
      "visible_if": "{{ section.settings.enable_custom_bg_image }}"
    },
    {
      "type": "range",
      "id": "bg_image_brightness",
      "label": "Picture brightness",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "default": 1,
      "visible_if": "{{ section.settings.enable_custom_bg_image }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_video_background",
      "label": "Background video",
      "default": false,
      "info": "A video shows instead of the picture."
    },
    {
      "type": "video",
      "id": "custom_bg_video",
      "label": "Video",
      "visible_if": "{{ section.settings.enable_custom_video_background }}"
    },
    {
      "type": "text",
      "id": "custom_bg_video_url",
      "label": "Or video address (.mp4)",
      "visible_if": "{{ section.settings.enable_custom_video_background and section.settings.custom_bg_video == blank }}"
    },
    {
      "type": "range",
      "id": "video_brightness",
      "label": "Video brightness",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "default": 1,
      "visible_if": "{{ section.settings.enable_custom_video_background }}"
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_bg_gradient",
      "label": "Background gradient",
      "default": false,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "bg_gradient_color1",
      "label": "Gradient color 1",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
    },
    {
      "type": "color",
      "id": "bg_gradient_color2",
      "label": "Gradient color 2",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
    },
    {
      "type": "color",
      "id": "bg_gradient_color3",
      "label": "Gradient color 3",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
    },
    {
      "type": "select",
      "id": "bg_gradient_degree",
      "label": "Gradient angle",
      "default": "90",
      "options": [
        {
          "value": "0",
          "label": "0°"
        },
        {
          "value": "45",
          "label": "45°"
        },
        {
          "value": "90",
          "label": "90°"
        },
        {
          "value": "135",
          "label": "135°"
        },
        {
          "value": "180",
          "label": "180°"
        },
        {
          "value": "225",
          "label": "225°"
        },
        {
          "value": "270",
          "label": "270°"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "content_radius",
      "label": "Content corners",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_52",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_56",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "logo_size_desktop",
      "label": "Logo size (desktop)",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200,
      "visible_if": "{{ section.settings.enable_logo }}"
    },
    {
      "type": "range",
      "id": "email_gap_top",
      "label": "Space above the signup (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Left padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Right padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_63",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "label": "Logo size (mobile)",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 100,
      "visible_if": "{{ section.settings.enable_logo }}"
    },
    {
      "type": "range",
      "id": "email_gap_top_mobile",
      "label": "Space above the signup (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "countdown",
      "name": "Countdown",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "countdown_date",
          "label": "Launch date",
          "info": "Year-month-day, for example 2027-03-01. The countdown hides once the date has passed.",
          "default": ""
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "color",
          "id": "countdown_unit_bg_color",
          "label": "Box background",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "countdown_text_color",
          "label": "Number color",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "countdown_border_color",
          "label": "Box border",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "countdown_border_radius",
          "label": "Box corners",
          "min": 0,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 5,
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "countdown_size_desktop",
          "label": "Number size (desktop)",
          "min": 1,
          "max": 5,
          "step": 0.1,
          "default": 1.9,
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "countdown_size_mobile",
          "label": "Number size (mobile)",
          "min": 1,
          "max": 1.5,
          "step": 0.1,
          "default": 1.5,
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "paragraph",
          "id": "para_11",
          "label": "Colors and sizes show with the section's Enable custom styling on.",
          "content": "Colors and sizes show with the section's Enable custom styling on."
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Our Store is Coming Soon"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Text color",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "checkbox",
          "id": "enable_heading_gradient",
          "label": "Gradient text",
          "default": false,
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "heading_gradient_color1",
          "label": "Gradient color 1",
          "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
        },
        {
          "type": "color",
          "id": "heading_gradient_color2",
          "label": "Gradient color 2",
          "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
        },
        {
          "type": "color",
          "id": "heading_gradient_color3",
          "label": "Gradient color 3",
          "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
        },
        {
          "type": "select",
          "id": "heading_gradient_degree",
          "label": "Gradient angle",
          "default": "90",
          "options": [
            {
              "value": "0",
              "label": "0°"
            },
            {
              "value": "45",
              "label": "45°"
            },
            {
              "value": "90",
              "label": "90°"
            },
            {
              "value": "135",
              "label": "135°"
            },
            {
              "value": "180",
              "label": "180°"
            },
            {
              "value": "225",
              "label": "225°"
            },
            {
              "value": "270",
              "label": "270°"
            }
          ],
          "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
        },
        {
          "type": "header",
          "id": "hdr_10",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "label": "Text size",
          "min": 20,
          "max": 120,
          "step": 1,
          "default": 60,
          "visible_if": "{{ section.settings.enable_custom_style }}",
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Text",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Text",
          "default": "<p>Stay tuned for something amazing!</p>"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Text color",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "subheading_font_size",
          "label": "Text size",
          "min": 10,
          "max": 60,
          "step": 1,
          "default": 20,
          "visible_if": "{{ section.settings.enable_custom_style }}",
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "email",
      "name": "Email signup",
      "settings": [
        {
          "type": "paragraph",
          "id": "para_1",
          "label": "The label, button text and messages are in the section's Messages group.",
          "content": "The label, button text and messages are in the section's Messages group."
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_email_input_bg",
          "label": "Custom field background",
          "default": false,
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "email_input_bg_color",
          "label": "Field background",
          "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_email_input_bg }}"
        },
        {
          "type": "color",
          "id": "email_input_border_color",
          "label": "Field border",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "email_text_color",
          "label": "Field text",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "placeholder_color",
          "label": "Placeholder",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "button_hover_bg",
          "label": "Button hover background",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "button_hover_text",
          "label": "Button hover text",
          "visible_if": "{{ section.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    }
  ],
  "presets": [],
  "allowed_templates": [
    "password"
  ],
  "shopify": {
    "name": "Coming soon",
    "enabled_on": {
      "templates": [
        "password"
      ]
    },
    "presets": [],
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "enable_logo",
        "label": "Show logo",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo",
        "info": "Empty: the theme logo.",
        "visible_if": "{{ section.settings.enable_logo }}"
      },
      {
        "type": "checkbox",
        "id": "show_owner_login",
        "label": "Show owner sign in link",
        "default": true
      },
      {
        "type": "text",
        "id": "owner_login_label",
        "label": "Owner link label",
        "default": "Website owner? Log in",
        "visible_if": "{{ section.settings.show_owner_login }}"
      },
      {
        "type": "url",
        "id": "owner_login_url",
        "label": "Owner link",
        "default": "https://storelib.com",
        "visible_if": "{{ section.settings.show_owner_login }}"
      },
      {
        "type": "checkbox",
        "id": "owner_open_new_tab",
        "label": "Open owner link in a new tab",
        "default": true,
        "visible_if": "{{ section.settings.show_owner_login }}"
      },
      {
        "type": "text",
        "id": "days_label",
        "label": "Days label",
        "default": "Days"
      },
      {
        "type": "text",
        "id": "hours_label",
        "label": "Hours label",
        "default": "Hours"
      },
      {
        "type": "text",
        "id": "minutes_label",
        "label": "Minutes label",
        "default": "Minutes"
      },
      {
        "type": "text",
        "id": "seconds_label",
        "label": "Seconds label",
        "default": "Seconds"
      },
      {
        "type": "header",
        "content": "Messages"
      },
      {
        "type": "text",
        "id": "email_label",
        "label": "Email label",
        "default": "Email address"
      },
      {
        "type": "text",
        "id": "email_placeholder",
        "label": "Email placeholder",
        "default": "you@example.com"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Signup button",
        "default": "Join the waitlist"
      },
      {
        "type": "text",
        "id": "success_text",
        "label": "Success message",
        "default": "Thanks, you’re on the list."
      },
      {
        "type": "text",
        "id": "error_text",
        "label": "Error message",
        "default": "Please try again."
      },
      {
        "type": "select",
        "id": "preview_submit_mode",
        "label": "Waitlist in the builder",
        "default": "live",
        "options": [
          {
            "value": "preview",
            "label": "Preview only"
          },
          {
            "value": "live",
            "label": "Save emails"
          }
        ],
        "info": "Preview only never saves email addresses. Save subscribers makes a real request and requires StoreLib to enable subscriber submissions for this preview."
      },
      {
        "type": "text",
        "id": "preview_success_text",
        "label": "Preview message",
        "default": "Preview complete. No email was saved.",
        "visible_if": "{{ section.settings.preview_submit_mode == 'preview' }}"
      },
      {
        "type": "text",
        "id": "preview_subscribed_label",
        "label": "Preview button label",
        "default": "Subscribed (preview)",
        "visible_if": "{{ section.settings.preview_submit_mode == 'preview' }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "content_width",
        "label": "Content width",
        "min": 360,
        "max": 900,
        "step": 20,
        "unit": "px",
        "default": 640
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Content alignment",
        "default": "center",
        "options": [
          {
            "value": "start",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "end",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "vertical_alignment",
        "label": "Vertical alignment",
        "default": "center",
        "options": [
          {
            "value": "start",
            "label": "Top"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "end",
            "label": "Bottom"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "fill_screen",
        "label": "Fill the screen height",
        "default": true
      },
      {
        "type": "range",
        "id": "viewport_height",
        "label": "Height",
        "min": 40,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 84,
        "visible_if": "{{ section.settings.fill_screen == false }}",
        "info": "A share of the screen height."
      },
      {
        "type": "range",
        "id": "block_gap",
        "label": "Space between blocks",
        "min": 0,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "select",
        "id": "signup_layout",
        "label": "Signup layout",
        "default": "inline",
        "options": [
          {
            "value": "inline",
            "label": "Inline"
          },
          {
            "value": "stacked",
            "label": "Stacked"
          }
        ]
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_bg_image",
        "label": "Background picture",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "custom_bg_image",
        "label": "Picture",
        "visible_if": "{{ section.settings.enable_custom_bg_image }}"
      },
      {
        "type": "range",
        "id": "bg_image_brightness",
        "label": "Picture brightness",
        "min": 0.5,
        "max": 1.5,
        "step": 0.1,
        "default": 1,
        "visible_if": "{{ section.settings.enable_custom_bg_image }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_video_background",
        "label": "Background video",
        "default": false,
        "info": "A video shows instead of the picture."
      },
      {
        "type": "video",
        "id": "custom_bg_video",
        "label": "Video",
        "visible_if": "{{ section.settings.enable_custom_video_background }}"
      },
      {
        "type": "text",
        "id": "custom_bg_video_url",
        "label": "Or video address (.mp4)",
        "visible_if": "{{ section.settings.enable_custom_video_background and section.settings.custom_bg_video == blank }}"
      },
      {
        "type": "range",
        "id": "video_brightness",
        "label": "Video brightness",
        "min": 0.5,
        "max": 1.5,
        "step": 0.1,
        "default": 1,
        "visible_if": "{{ section.settings.enable_custom_video_background }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient == false }}"
      },
      {
        "type": "checkbox",
        "id": "enable_bg_gradient",
        "label": "Background gradient",
        "default": false,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "bg_gradient_color1",
        "label": "Gradient color 1",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
      },
      {
        "type": "color",
        "id": "bg_gradient_color2",
        "label": "Gradient color 2",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
      },
      {
        "type": "color",
        "id": "bg_gradient_color3",
        "label": "Gradient color 3",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
      },
      {
        "type": "select",
        "id": "bg_gradient_degree",
        "label": "Gradient angle",
        "default": "90",
        "options": [
          {
            "value": "0",
            "label": "0°"
          },
          {
            "value": "45",
            "label": "45°"
          },
          {
            "value": "90",
            "label": "90°"
          },
          {
            "value": "135",
            "label": "135°"
          },
          {
            "value": "180",
            "label": "180°"
          },
          {
            "value": "225",
            "label": "225°"
          },
          {
            "value": "270",
            "label": "270°"
          }
        ],
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_bg_gradient }}"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content padding",
        "min": 0,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "content_radius",
        "label": "Content corners",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "logo_size_desktop",
        "label": "Logo size (desktop)",
        "min": 50,
        "max": 500,
        "step": 10,
        "unit": "px",
        "default": 200,
        "visible_if": "{{ section.settings.enable_logo }}"
      },
      {
        "type": "range",
        "id": "email_gap_top",
        "label": "Space above the signup (desktop)",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_left_desktop",
        "label": "Left padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "padding_right_desktop",
        "label": "Right padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "logo_size_mobile",
        "label": "Logo size (mobile)",
        "min": 50,
        "max": 500,
        "step": 10,
        "unit": "px",
        "default": 100,
        "visible_if": "{{ section.settings.enable_logo }}"
      },
      {
        "type": "range",
        "id": "email_gap_top_mobile",
        "label": "Space above the signup (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_left_mobile",
        "label": "Left padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "padding_right_mobile",
        "label": "Right padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20
      }
    ],
    "blocks": [
      {
        "type": "countdown",
        "name": "Countdown",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "countdown_date",
            "label": "Launch date",
            "info": "Year-month-day, for example 2027-03-01. The countdown hides once the date has passed.",
            "default": ""
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "color",
            "id": "countdown_unit_bg_color",
            "label": "Box background",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "countdown_text_color",
            "label": "Number color",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "countdown_border_color",
            "label": "Box border",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "countdown_border_radius",
            "label": "Box corners",
            "min": 0,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 5,
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "countdown_size_desktop",
            "label": "Number size (desktop)",
            "min": 1,
            "max": 5,
            "step": 0.1,
            "default": 1.9,
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "countdown_size_mobile",
            "label": "Number size (mobile)",
            "min": 1,
            "max": 1.5,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "paragraph",
            "content": "Colors and sizes show with the section's Enable custom styling on."
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Our Store is Coming Soon"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Text color",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "enable_heading_gradient",
            "label": "Gradient text",
            "default": false,
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "heading_gradient_color1",
            "label": "Gradient color 1",
            "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
          },
          {
            "type": "color",
            "id": "heading_gradient_color2",
            "label": "Gradient color 2",
            "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
          },
          {
            "type": "color",
            "id": "heading_gradient_color3",
            "label": "Gradient color 3",
            "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
          },
          {
            "type": "select",
            "id": "heading_gradient_degree",
            "label": "Gradient angle",
            "default": "90",
            "options": [
              {
                "value": "0",
                "label": "0°"
              },
              {
                "value": "45",
                "label": "45°"
              },
              {
                "value": "90",
                "label": "90°"
              },
              {
                "value": "135",
                "label": "135°"
              },
              {
                "value": "180",
                "label": "180°"
              },
              {
                "value": "225",
                "label": "225°"
              },
              {
                "value": "270",
                "label": "270°"
              }
            ],
            "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_heading_gradient }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "heading_font_size",
            "label": "Text size",
            "min": 20,
            "max": 120,
            "step": 1,
            "default": 60,
            "visible_if": "{{ section.settings.enable_custom_style }}",
            "unit": "px"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Text",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "subheading",
            "label": "Text",
            "default": "<p>Stay tuned for something amazing!</p>"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "color",
            "id": "subheading_color",
            "label": "Text color",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "subheading_font_size",
            "label": "Text size",
            "min": 10,
            "max": 60,
            "step": 1,
            "default": 20,
            "visible_if": "{{ section.settings.enable_custom_style }}",
            "unit": "px"
          }
        ]
      },
      {
        "type": "email",
        "name": "Email signup",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "The label, button text and messages are in the section's Messages group."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_email_input_bg",
            "label": "Custom field background",
            "default": false,
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "email_input_bg_color",
            "label": "Field background",
            "visible_if": "{{ section.settings.enable_custom_style and block.settings.enable_email_input_bg }}"
          },
          {
            "type": "color",
            "id": "email_input_border_color",
            "label": "Field border",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "email_text_color",
            "label": "Field text",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "placeholder_color",
            "label": "Placeholder",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button background",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "button_text_color",
            "label": "Button text",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "button_hover_bg",
            "label": "Button hover background",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "button_hover_text",
            "label": "Button hover text",
            "visible_if": "{{ section.settings.enable_custom_style }}"
          }
        ]
      }
    ]
  }
}
</schema>