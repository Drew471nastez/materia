<template compat="shopify">
{%- assign fb_accessibility_promo_banner_image = 'accessibility.promo_banner_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Promo Banner 4 (block-based — Spotlight Card)
  2-column "spotlight card" banner with floating badges. Content uses blocks
  (eyebrow / heading / description / buttons / badge) so merchants can reorder,
  hide, or duplicate any element.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign layout = st.layout | default: 'image_left'
  assign card_style = st.card_style | default: 'shadow'
  assign image_ratio = st.image_aspect_ratio | default: '4-3'

  assign content_align = st.vertical_alignment | default: 'center'
  assign text_align = st.text_align | default: 'left'

  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins + reset spacing */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer container */
  #shopify-section-{{ sid }} .pb4 {
    background-color: {{ st.section_bg | default: '#FFFFFF' }} !important;
    padding-top: {{ st.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb4 {
      padding-top: {{ st.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 80 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb4__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb4__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .pb4__inner { padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .pb4__inner { padding-inline: 3rem; } }
    {%- else -%}
      #shopify-section-{{ sid }} .pb4__inner { padding-inline: 0; }
  {%- endcase -%}

  /* Card */
  #shopify-section-{{ sid }} .pb4__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.card_gap | default: 24 }}px;
    background-color: {{ st.card_bg | default: '#F7F7F7' }} !important;
    border: {{ st.card_border_width | default: 0 }}px solid {{ st.card_border_color | default: 'rgba(0,0,0,0.08)' }};
    border-radius: {{ st.card_radius | default: 16 }}px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb4__card {
      grid-template-columns: 1fr 1fr;
      gap: {{ st.card_gap | default: 24 }}px;
    }
    #shopify-section-{{ sid }} .pb4__card.pb4--reverse .pb4__media { order: 2; }
    #shopify-section-{{ sid }} .pb4__card.pb4--reverse .pb4__content { order: 1; }
  }

  /* Card variants */
  {%- if card_style == 'shadow' -%}
    #shopify-section-{{ sid }} .pb4__card {
      box-shadow: 0 18px 40px -16px rgba(0,0,0,0.18);
    }
  {%- elsif card_style == 'glass' -%}
    #shopify-section-{{ sid }} .pb4__card {
      background-color: rgba(255,255,255,0.55) !important;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,0.4);
      box-shadow: 0 18px 40px -16px rgba(0,0,0,0.12);
    }
  {%- endif -%}

  /* Image side */
  #shopify-section-{{ sid }} .pb4__media {
    position: relative;
    overflow: hidden;
    background-color: {{ st.image_bg | default: '#EDEDED' }};
  }
  #shopify-section-{{ sid }} .pb4__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .6s ease;
  }
  {%- if st.enable_image_zoom -%}
    #shopify-section-{{ sid }} .pb4__card:hover .pb4__media img {
      transform: scale(1.05);
    }
  {%- endif -%}

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb4__media {
      aspect-ratio:
        {%- case image_ratio -%}
          {%- when 'square' -%} 1 / 1
          {%- when '4-3' -%} 4 / 3
          {%- when '16-9' -%} 16 / 9
          {%- when '9-16' -%} 9 / 16
          {%- else -%} 4 / 3
        {%- endcase -%};
    }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .pb4__media {
      aspect-ratio: 16 / 10;
    }
  }

  {%- if st.enable_overlay -%}
    #shopify-section-{{ sid }} .pb4__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {{ st.overlay_color | default: '#000000' }};
      opacity: {{ st.overlay_opacity | default: 30 | divided_by: 100.0 }};
      pointer-events: none;
    }
  {%- endif -%}

  /* Floating badges */
  #shopify-section-{{ sid }} .pb4__badge {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    box-shadow: 0 6px 18px -8px rgba(0,0,0,0.25);
    pointer-events: none;
    {%- if st.enable_badge_pulse -%}
      animation: pb4-pulse 2.4s ease-in-out infinite;
    {%- endif -%}
  }
  @keyframes pb4-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }
  #shopify-section-{{ sid }} .pb4__badge--top-left { top: 14px; left: 14px; }
  #shopify-section-{{ sid }} .pb4__badge--top-right { top: 14px; right: 14px; }
  #shopify-section-{{ sid }} .pb4__badge--center { top: 50%; left: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .pb4__badge--center.pb4__badge--pulse { animation: pb4-pulse-c 2.4s ease-in-out infinite; }
  @keyframes pb4-pulse-c {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.06); }
  }
  #shopify-section-{{ sid }} .pb4__badge--bottom-left { bottom: 14px; left: 14px; }
  #shopify-section-{{ sid }} .pb4__badge--bottom-right { bottom: 14px; right: 14px; }

  /* Content side */
  #shopify-section-{{ sid }} .pb4__content {
    display: flex;
    flex-direction: column;
    justify-content:
      {%- if content_align == 'top' -%} flex-start
      {%- elsif content_align == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    padding: {{ st.card_padding | default: 32 }}px;
    gap: {{ st.content_gap | default: 16 }}px;
    text-align: {{ text_align }};
  }

  /* Block — Eyebrow */
  #shopify-section-{{ sid }} .pb4__eyebrow {
    margin: 0;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1.3;
  }

  /* Block — Heading */
  #shopify-section-{{ sid }} .pb4__heading { margin: 0; line-height: 1.15; }

  /* Block — Description */
  #shopify-section-{{ sid }} .pb4__description { margin: 0; line-height: 1.55; }
  #shopify-section-{{ sid }} .pb4__description p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .pb4__description p:last-child { margin: 0; }

  /* Block — Buttons (equal-height stretch) */
  #shopify-section-{{ sid }} .pb4__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    justify-content: {% if text_align == 'center' %}center{% elsif text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #shopify-section-{{ sid }} .pb4__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform .15s ease, background-color .2s ease, color .2s ease;
    border: 0;
    cursor: pointer;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .4px;
  }
  #shopify-section-{{ sid }} .pb4__btn:hover { transform: translateY(-1px); }

  /* Mobile order */
  @media (max-width: 767px) {
    {%- if st.mobile_image_first == false -%}
      #shopify-section-{{ sid }} .pb4__media { order: 2; }
      #shopify-section-{{ sid }} .pb4__content { order: 1; }
    {%- endif -%}
  }
{% comment %}{% endcomment %}</style>

<section class="pb4-wrap">
  <div class="pb4">
    <div class="pb4__inner">
      <div class="pb4__card pb4--{{ layout }}">
        <div class="pb4__media">
          {%- if st.image -%}
            <img
              src="{{ st.image | image_url: width: 1400 }}"
              srcset="{{ st.image | image_url: width: 600 }} 600w,
                      {{ st.image | image_url: width: 900 }} 900w,
                      {{ st.image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 768px) 50vw, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_promo_banner_image | escape }}"
              loading="lazy"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            <img
              src="{{ placeholder }}"
              alt="{{ 'accessibility.promo_banner_placeholder' | t }}"
              loading="lazy"
              width="1200"
              height="900"
            >
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' and block.settings.text != blank -%}
              <span class="pb4__badge pb4__badge--{{ block.settings.position | default: 'top-left' }}{% if block.settings.position == 'center' and st.enable_badge_pulse %} pb4__badge--pulse{% endif %}"
                    style="background:{{ block.settings.bg | default: '#FF3B30' }};color:{{ block.settings.color | default: '#FFFFFF' }};"
                    {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pb4__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb4__eyebrow"
                     style="
                       font-size: {{ block.settings.size | default: 13 }}px;
                       color: {{ block.settings.color }} !important;
                     "
                     {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  <{{ block.settings.tag | default: 'h2' }} class="pb4__heading"
                     style="
                       font-size: {{ block.settings.size_mobile | default: 28 }}px;
                       color: {{ block.settings.color }} !important;
                       font-weight: {{ block.settings.weight | default: 700 }};
                     "
                     {{ block.shopify_attributes }}>
                    <span class="pb4-heading-d" style="font-size: inherit">{{ block.settings.text | escape }}</span>
                  </{{ block.settings.tag | default: 'h2' }}>
                  <style>
                    @media (min-width: 768px) {
                      #shopify-section-{{ sid }} [data-shopify-editor-block="{{ block.id }}"].pb4__heading,
                      #shopify-section-{{ sid }} .pb4__heading[data-block-id="{{ block.id }}"] {
                        font-size: {{ block.settings.size_desktop | default: 42 }}px !important;
                      }
                    }
{% comment %}{% endcomment %}                  </style>
                {%- endif -%}

              {%- when 'description' -%}
                {%- if block.settings.text != blank -%}
                  <div class="pb4__description"
                       style="
                         font-size: {{ block.settings.size_mobile | default: 15 }}px;
                         color: {{ block.settings.color }} !important;
                       "
                       {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'buttons' -%}
                {%- assign primary_label = block.settings.primary_label -%}
                {%- assign secondary_label = block.settings.secondary_label -%}
                {%- if primary_label != blank or secondary_label != blank -%}
                  <div class="pb4__buttons" {{ block.shopify_attributes }}
                       style="margin-top: {{ block.settings.gap_top | default: 8 }}px;">
                    {%- if primary_label != blank -%}
                      <a class="pb4__btn pb4__btn--primary"
                         href="{{ block.settings.primary_link | default: '#' }}"
                         style="
                           background-color: {{ block.settings.primary_bg | default: '#0F0F0F' }} !important;
                           color: {{ block.settings.primary_text | default: '#FFFFFF' }} !important;
                           border: {{ block.settings.primary_border_width | default: 0 }}px solid {{ block.settings.primary_border_color | default: '#0F0F0F' }};
                           padding: {{ block.settings.btn_pad_y | default: 13 }}px {{ block.settings.btn_pad_x | default: 26 }}px;
                           border-radius: {{ block.settings.btn_radius | default: 8 }}px;
                           font-size: {{ block.settings.btn_size | default: 14 }}px;
                         ">
                        {{ primary_label | escape }}
                      </a>
                    {%- endif -%}
                    {%- if secondary_label != blank -%}
                      <a class="pb4__btn pb4__btn--secondary"
                         href="{{ block.settings.secondary_link | default: '#' }}"
                         style="
                           background-color: {{ block.settings.secondary_bg | default: 'rgba(0,0,0,0)' }} !important;
                           color: {{ block.settings.secondary_text | default: '#0F0F0F' }} !important;
                           border: {{ block.settings.secondary_border_width | default: 1 }}px solid {{ block.settings.secondary_border_color | default: '#0F0F0F' }};
                           padding: {{ block.settings.btn_pad_y | default: 13 }}px {{ block.settings.btn_pad_x | default: 26 }}px;
                           border-radius: {{ block.settings.btn_radius | default: 8 }}px;
                           font-size: {{ block.settings.btn_size | default: 14 }}px;
                         ">
                        {{ secondary_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "promo-banner-4",
  "name": "Promo Banner 4",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, content right"
        },
        {
          "value": "reverse",
          "label": "Image right, content left"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "shadow",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "shadow",
          "label": "Soft shadow"
        },
        {
          "value": "glass",
          "label": "Glassmorphism"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Spotlight image",
      "info": "Falls back to a default placeholder if blank."
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio (desktop)",
      "default": "4-3",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "4-3",
          "label": "4:3"
        },
        {
          "value": "16-9",
          "label": "16:9"
        },
        {
          "value": "9-16",
          "label": "9:16 portrait"
        }
      ]
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image area placeholder color",
      "default": "#EDEDED"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable image overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Zoom image on hover",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_badge_pulse",
      "label": "Pulse animation on badges",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Content text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between image and content",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Content side padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
