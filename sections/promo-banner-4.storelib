<template compat="shopify">
{% render 'theme-type' %}
{{ 'marketing-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'marketing-sections.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign bg = section.blocks | where: 'type', 'background' | first %}{% assign photo = s.background_image | default: s.image | default: bg.settings.background_image %}{% assign mobile_photo = s.background_image_mobile | default: bg.settings.background_image_mobile %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="mk-{{ section.id }}" class="mk-shell color-{{ scheme }}" data-marketing-section="{{ section.id }}" data-mk-kind="card" data-mk-settings="{{ s | json | escape }}" data-mk-defaults='{"section_width":"container","color_scheme":"default-color-scheme","reset_spacing":true,"layout":"image_left","text_align":"left","vertical_alignment":"center","card_style":"shadow","card_border_width":0,"card_radius":16,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","enable_image_zoom":true,"reveal":true,"enable_badge_pulse":true,"animation":"theme","mobile_image_first":true,"padding_top_mobile":40,"padding_bottom_mobile":40,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"image_aspect_ratio":"4-3","enable_overlay":false,"overlay_opacity":30,"card_gap":24,"card_padding":32,"content_gap":16,"padding_top_desktop":80,"padding_bottom_desktop":80,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0}' data-mk-block-defaults='{"eyebrow":{"text":"Limited time","enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"size":13,"font_weight":"theme"},"heading":{"text":"Spotlight on this season&#39;s bestseller","enable_custom_style":false,"tag":"h2","weight":"theme","font_source":"heading","text_case":"theme","letter_spacing":0,"line_height":1.2,"size_desktop":42,"size_mobile":28},"description":{"text":"&lt;p&gt;A handpicked highlight that pairs beautifully with everything in your collection. Discover what everyone is talking about.&lt;/p&gt;","enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"size_desktop":17,"size_mobile":15,"font_weight":"theme"},"buttons":{"primary_label":"Shop now","enable_custom_style":false,"primary_border_width":0,"secondary_border_width":1,"btn_radius":8,"use_theme_button":true,"btn_size":14,"btn_pad_x":26,"btn_pad_y":13,"gap_top":8},"badge":{"text":"NEW","enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"position":"top-left","font_weight":"theme"}}' data-mk-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-mk-button-font="{{ settings.button_font | default: 'body_font' }}" data-mk-motion="{{ settings.scroll_animation | default: 'none' }}" data-mk-duration="{{ settings.animation_duration | default: 700 }}" data-mk-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="mk-inner"><div class="mk-row"><div class="mk-media"><picture>{% if mobile_photo != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: mobile_photo, escaped: true %}">{% endif %}<img src="{% if photo != blank %}{% render 'offer-image-url', image: photo, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-mk-placeholder="{{ placeholder | escape }}" alt="{{ photo.alt | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline hidden></video><div class="mk-split" hidden><img alt="" width="960" height="1080"><img alt="" width="960" height="1080"></div><span class="mk-overlay" aria-hidden="true"></span></div>
 <div class="mk-content">{% for block in section.blocks %}{% unless block.hidden %}<div class="mk-block" data-mk-block="{{ block.id }}" data-mk-type="{{ block.type }}" data-mk-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}{% if block.type == 'background' %} hidden{% endif %}>{% render 'marketing-block', block: block, kind: 'card' %}</div>{% endunless %}{% endfor %}</div></div><button class="mk-close" type="button" aria-label="{{ 'accessibility.dismiss' | t }}" data-mk-close hidden>×</button></div>
 {% assign icons = 'check,star,heart,gift,truck,shield,shield_check,lightning,package,leaf,lock,award,clock,return,chat,globe,credit_card,tag' | split: ',' %}{% for icon in icons %}<template data-mk-icon="{{ icon }}">{% render 'hp-icon', icon: icon %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "promo-banner-4",
  "name": "Promo Banner 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, content right"
        },
        {
          "value": "reverse",
          "label": "Image right, content left"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style & Colors"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "shadow",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "shadow",
          "label": "Soft shadow"
        },
        {
          "value": "glass",
          "label": "Glassmorphism"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Placeholder background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Spotlight image"
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Zoom image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_badge_pulse",
      "label": "Pulse animation on badges",
      "default": true
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "default": "theme",
      "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image ratio (desktop)",
      "default": "4-3",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "4-3",
          "label": "4:3"
        },
        {
          "value": "16-9",
          "label": "16:9"
        },
        {
          "value": "9-16",
          "label": "9:16 portrait"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable image overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.enable_overlay }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Image to content gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Content side padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Block gap",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Section bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Image first on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow / tagline",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Limited time"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_source",
          "label": "Font",
          "options": [
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            }
          ],
          "default": "body",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "text_case",
          "label": "Text case",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "none",
              "label": "Original"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "theme",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": -2,
          "max": 8,
          "step": 0.1,
          "default": 0,
          "unit": "px",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.8,
          "max": 2.4,
          "step": 0.1,
          "default": 1.5,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 10,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 13,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            }
          ],
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_12",
          "label": "Layout & Spacing"
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Spotlight on this season's bestseller"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra-bold"
            }
          ],
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_source",
          "label": "Font",
          "options": [
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            }
          ],
          "default": "heading",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "text_case",
          "label": "Text case",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "none",
              "label": "Original"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "theme",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": -2,
          "max": 8,
          "step": 0.1,
          "default": 0,
          "unit": "px",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.8,
          "max": 2.4,
          "step": 0.1,
          "default": 1.2,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 42,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 28,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_13",
          "label": "Layout & Spacing"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "visible_if": "{{ false }}"
        }
      ],
      "limit": 2
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A handpicked highlight that pairs beautifully with everything in your collection. Discover what everyone is talking about.</p>"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style & Colors"
        },
