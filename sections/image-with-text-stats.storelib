          "type": "heading",
          "settings": {
            "text": "Results"
          }
        },
        {
          "type": "stats_group"
        },
        {
          "type": "stat",
          "settings": {
            "percent": 94,
            "text": "<p>Say what this number measures. Replace it with a figure from your own store.</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "percent": 87,
            "text": "<p>Keep each line short, so the number stays the first thing people read.</p>"
          }
        },
        {
          "type": "stat",
          "settings": {
            "percent": 98,
            "text": "<p>Add the source of your figures in the footnote below.</p>"
          }
        },
        {
          "type": "footnote",
          "settings": {
            "text": "Source: your own order data"
          }
        }
      ]
    }
  ],
