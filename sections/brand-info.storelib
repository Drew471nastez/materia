<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia — Brand Info (split brand statement section)
  Developed for Materia Themes.

  Two-column brand statement. Scoped entirely to this section's own ID.
  Every visual property is written with a doubled-ID selector
  (#shopify-section-x #editorial-x) plus !important so the theme's global
  rules (heading sizing, inherited body font-size, link colours, default
  heading margins) can never win — that is what makes every slider/toggle
  take effect on screen.

  Connected to the theme: color scheme picker, theme fonts, and the
  scroll-animation settings (settings.scroll_animation).
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign s = section.settings

  assign scheme = s.color_scheme | default: 'default'

  assign bg_value = 'var(--color-background)'
  assign heading_value = 'var(--color-heading)'
  assign text_value = 'var(--color-text)'
  assign link_value = 'var(--color-link)'
  assign link_hover_value = 'var(--color-link-hover)'
  assign rule_value = 'var(--color-border)'
  if s.override_colors
    assign bg_value = s.custom_background_color
    assign heading_value = s.custom_heading_color
    assign text_value = s.custom_text_color
    assign link_value = s.custom_link_color
    assign link_hover_value = s.custom_link_hover_color
    assign rule_value = s.custom_rule_color
  endif

  if s.override_fonts
    assign heading_font_value = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families
    assign body_font_value = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
  else
    assign heading_font_value = 'var(--heading-font, inherit)'
    assign body_font_value = 'var(--body-font, inherit)'
  endif

  assign left_w = s.left_column_width | default: 42
  assign right_w = 100 | minus: left_w

  assign ta_left = s.left_text_align | default: 'left'
  assign ta_right = s.right_text_align | default: 'left'
  assign ta_left_m = s.left_text_align_mobile | default: ta_left
  assign ta_right_m = s.right_text_align_mobile | default: ta_right

  assign fa_left = 'flex-start'
  if ta_left == 'center'
    assign fa_left = 'center'
  elsif ta_left == 'right'
    assign fa_left = 'flex-end'
  endif
  assign fa_right = 'flex-start'
  if ta_right == 'center'
    assign fa_right = 'center'
  elsif ta_right == 'right'
    assign fa_right = 'flex-end'
  endif
  assign fa_left_m = 'flex-start'
  if ta_left_m == 'center'
    assign fa_left_m = 'center'
  elsif ta_left_m == 'right'
    assign fa_left_m = 'flex-end'
  endif
  assign fa_right_m = 'flex-start'
  if ta_right_m == 'center'
    assign fa_right_m = 'center'
  elsif ta_right_m == 'right'
    assign fa_right_m = 'flex-end'
  endif

  assign anim_on = false
  if settings.scroll_animation != blank and settings.scroll_animation != 'none'
    assign anim_on = true
  endif
-%}

{%- if anim_on -%}
<style>
  #editorial-{{ uid }} .scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}

{%- if s.reset_spacing -%}
<style>
  #shopify-section-{{ uid }},
  #shopify-section-{{ uid }} > .section,
  #shopify-section-{{ uid }} > section,
  #shopify-section-{{ uid }} > div {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  #shopify-section-{{ uid }} + .shopify-section,
  .shopify-section + #shopify-section-{{ uid }} {
    margin-top: 0 !important;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}

{%- if s.override_fonts -%}
<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  {{ s.body_font | font_face: font_display: 'swap' }}
{% comment %}{% endcomment %}</style>
{%- endif -%}

<style>
  /* Tokens on the section root */
  #editorial-{{ uid }} {
    isolation: isolate;
    position: relative;
    box-sizing: border-box;
    --ed-bg: {{ bg_value }};
    --ed-heading: {{ heading_value }};
    --ed-text: {{ text_value }};
    --ed-link: {{ link_value }};
    --ed-link-hover: {{ link_hover_value }};
    --ed-rule: {{ rule_value }};
    --ed-heading-font: {{ heading_font_value }};
    --ed-body-font: {{ body_font_value }};
    margin-top: {{ s.margin_top | default: 0 }}px;
    margin-bottom: {{ s.margin_bottom | default: 0 }}px;
  }

  #shopify-section-{{ uid }} #editorial-{{ uid }} {
    background: var(--ed-bg) !important;
    color: var(--ed-text) !important;
    width: 100%;
    overflow: hidden;
  }

  /* Width */
  #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-inner {
    {% if s.section_width == 'fluid' %}max-width: var(--fluid-container-width, 1500px) !important; margin-inline: auto !important;
    {% elsif s.section_width == 'full' %}max-width: none !important;
    {% else %}max-width: var(--page-width, 1300px) !important; margin-inline: auto !important;{% endif %}
    padding-top: {{ s.padding_top | default: 80 }}px !important;
    padding-bottom: {{ s.padding_bottom | default: 80 }}px !important;
    padding-left: {{ s.padding_horizontal | default: 40 }}px !important;
    padding-right: {{ s.padding_horizontal | default: 40 }}px !important;
    box-sizing: border-box;
  }

  /* Grid */
  #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-grid {
    display: grid !important;
    grid-template-columns: {{ left_w }}fr {{ right_w }}fr !important;
    column-gap: {{ s.column_gap | default: 80 }}px !important;
    row-gap: {{ s.row_gap | default: 40 }}px !important;
    align-items: {{ s.vertical_align | default: 'center' }} !important;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--left {
    align-items: {{ fa_left }} !important;
    text-align: {{ ta_left }} !important;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--right {
    align-items: {{ fa_right }} !important;
    text-align: {{ ta_right }} !important;
  }

  /* Primitives */
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-block { margin: 0; padding: 0; max-width: 100%; }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-eyebrow {
    font-family: var(--ed-body-font) !important;
    color: var(--ed-text) !important;
    text-transform: uppercase;
    line-height: 1.4 !important;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-heading {
    font-family: var(--ed-heading-font) !important;
    color: var(--ed-heading) !important;
    letter-spacing: {{ s.heading_letter_spacing | default: 0 }}px !important;
    line-height: 1.05 !important;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-paragraph,
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-paragraph p {
    font-family: var(--ed-body-font) !important;
    color: var(--ed-text) !important;
    line-height: {{ s.paragraph_line_height | default: 1.6 }} !important;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-paragraph p { margin: 0 !important; }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-paragraph p + p { margin-top: 1em !important; }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-paragraph a { color: var(--ed-link) !important; text-decoration: underline !important; }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-link-wrap a {
    display: inline-block;
    font-family: var(--ed-body-font) !important;
    color: var(--ed-link) !important;
    text-decoration: underline !important;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    line-height: 1.3 !important;
    transition: color .2s ease, opacity .2s ease;
  }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-link-wrap a:hover { color: var(--ed-link-hover) !important; opacity: .85; }
  #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-divider { border: 0; border-top: 1px solid var(--ed-rule); width: 100%; }

  /* Per-block typography + spacing */
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} {
      margin-top: {{ b.space_above | default: 0 }}px !important;
      margin-bottom: {{ b.space_below | default: 0 }}px !important;
    }
    {%- if block.type == 'heading' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} {
      font-size: {{ b.size | default: 40 }}px !important;
      font-weight: {{ b.font_weight | default: 700 }} !important;
      {% if b.text_transform != 'none' %}text-transform: {{ b.text_transform }} !important;{% endif %}
      {% if b.use_custom_color %}color: {{ b.custom_color }} !important;{% endif %}
    }
    {%- elsif block.type == 'eyebrow' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} {
      font-size: {{ b.size | default: 13 }}px !important;
      font-weight: {{ b.font_weight | default: 500 }} !important;
      letter-spacing: {{ b.letter_spacing | default: 1 }}px !important;
      {% if b.use_custom_color %}color: {{ b.custom_color }} !important;{% endif %}
    }
    {%- elsif block.type == 'paragraph' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }},
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} p {
      font-size: {{ b.size | default: 17 }}px !important;
      font-weight: {{ b.font_weight | default: 400 }} !important;
      {% if b.use_custom_color %}color: {{ b.custom_color }} !important;{% endif %}
    }
    {%- elsif block.type == 'link' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} a {
      font-size: {{ b.size | default: 14 }}px !important;
      font-weight: {{ b.font_weight | default: 600 }} !important;
      {% if b.text_transform != 'none' %}text-transform: {{ b.text_transform }} !important;{% endif %}
      letter-spacing: {{ b.letter_spacing | default: 0.5 }}px !important;
      {% if b.use_custom_color %}color: {{ b.custom_color }} !important;{% endif %}
    }
    {%- if b.use_custom_color -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} a:hover { color: {{ b.custom_color_hover | default: b.custom_color }} !important; }
    {%- endif -%}
    {%- elsif block.type == 'divider' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} {
      border-top-width: {{ b.thickness | default: 1 }}px !important;
      max-width: {{ b.width | default: 100 }}% !important;
    }
    {%- elsif block.type == 'spacer' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} { height: {{ b.height | default: 24 }}px !important; }
    {%- endif -%}
  {%- endfor -%}

  /* Mobile */
  @media (max-width: 768px) {
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-inner {
      padding-top: {{ s.padding_top_mobile | default: 48 }}px !important;
      padding-bottom: {{ s.padding_bottom_mobile | default: 48 }}px !important;
      padding-left: {{ s.padding_horizontal_mobile | default: 22 }}px !important;
      padding-right: {{ s.padding_horizontal_mobile | default: 22 }}px !important;
    }
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-grid {
      grid-template-columns: 1fr !important;
      row-gap: {{ s.row_gap_mobile | default: 28 }}px !important;
      align-items: stretch !important;
    }
    {%- if s.mobile_stack_order == 'right_first' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--left { order: 2; }
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--right { order: 1; }
    {%- endif -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--left {
      text-align: {{ ta_left_m }} !important;
      align-items: {{ fa_left_m }} !important;
    }
    #shopify-section-{{ uid }} #editorial-{{ uid }} .editorial-col--right {
      text-align: {{ ta_right_m }} !important;
      align-items: {{ fa_right_m }} !important;
    }
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- if block.type == 'heading' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} { font-size: {{ b.size_mobile | default: 30 }}px !important; }
      {%- elsif block.type == 'paragraph' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }},
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} p { font-size: {{ b.size_mobile | default: 15 }}px !important; }
      {%- elsif block.type == 'eyebrow' -%}
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-{{ block.id }} { font-size: {{ b.size_mobile | default: 12 }}px !important; }
      {%- endif -%}
    {%- endfor -%}
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ uid }} #editorial-{{ uid }} .ed-link-wrap a { transition: none; }
  }
{% comment %}{% endcomment %}</style>

{%- if anim_on -%}
  {%- assign anim_class = ' scroll-trigger ' | append: settings.scroll_animation -%}
{%- else -%}
  {%- assign anim_class = '' -%}
{%- endif -%}

<div id="editorial-{{ uid }}" class="editorial-mission color-{{ scheme }} gradient {{ section.settings.section_width }}">
  <div class="editorial-inner">
    <div class="editorial-grid">

      <div class="editorial-col editorial-col--left">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'left' -%}
            {%- assign b = block.settings -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                <p class="ed-block ed-eyebrow ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</p>
              {%- when 'heading' -%}
                <h2 class="ed-block ed-heading ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</h2>
              {%- when 'paragraph' -%}
                <div class="ed-block ed-paragraph ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</div>
              {%- when 'link' -%}
                <div class="ed-block ed-link-wrap ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>
                  <a href="{{ b.url | default: '#' }}">{{ b.text }}</a>
                </div>
              {%- when 'divider' -%}
                <hr class="ed-block ed-divider ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>
              {%- when 'spacer' -%}
                <div class="ed-block ed-{{ block.id }}" {{ block.shopify_attributes }} aria-hidden="true"></div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="editorial-col editorial-col--right">
        {%- for block in section.blocks -%}
          {%- if block.settings.column != 'left' -%}
            {%- assign b = block.settings -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                <p class="ed-block ed-eyebrow ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</p>
              {%- when 'heading' -%}
                <h2 class="ed-block ed-heading ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</h2>
              {%- when 'paragraph' -%}
                <div class="ed-block ed-paragraph ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>{{ b.text }}</div>
              {%- when 'link' -%}
                <div class="ed-block ed-link-wrap ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>
                  <a href="{{ b.url | default: '#' }}">{{ b.text }}</a>
                </div>
              {%- when 'divider' -%}
                <hr class="ed-block ed-divider ed-{{ block.id }}{{ anim_class }}" {{ block.shopify_attributes }}>
              {%- when 'spacer' -%}
                <div class="ed-block ed-{{ block.id }}" {{ block.shopify_attributes }} aria-hidden="true"></div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "brand-info",
  "name": "Brand info",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid",
          "label": "Fluid (wide)"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Colors"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Use custom colors",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "custom_link_color",
      "label": "Link color"
    },
    {
      "type": "color",
      "id": "custom_link_hover_color",
      "label": "Link color (hover)"
    },
    {
      "type": "color",
      "id": "custom_rule_color",
      "label": "Divider color"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Fonts"
    },
    {
      "type": "checkbox",
      "id": "override_fonts",
      "label": "Use custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "sans-serif"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -4,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "paragraph_line_height",
      "label": "Paragraph line height",
      "min": 1,
      "max": 2.4,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "range",
      "id": "left_column_width",
      "label": "Left column width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between stacked rows (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment of columns",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "left_text_align",
      "label": "Left column text align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "right_text_align",
      "label": "Right column text align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Spacing (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Mobile stack order",
      "default": "left_first",
      "options": [
        {
          "value": "left_first",
          "label": "Left column first"
        },
        {
          "value": "right_first",
          "label": "Right column first"
        }
      ]
    },
    {
      "type": "select",
      "id": "left_text_align_mobile",
      "label": "Left column text align (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "right_text_align_mobile",
