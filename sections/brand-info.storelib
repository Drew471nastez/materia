<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Brand info: a two-column brand statement.

  Eyebrow, heading, paragraph, link, divider and spacer blocks, each placed
  in the left or right column. Colours follow the colour scheme and fonts
  follow Theme settings > Typography until custom styling or custom fonts are
  switched on; a block's own colour, weight and letter case apply only to
  that block. Shared rules live in snippets/logos-style; the builder's live
  edits in assets/live-logos.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default'
  assign own = st.override_colors
  assign fonts = st.override_fonts
  assign lw = st.left_column_width | default: 42
  assign rw = 100 | minus: lw
  assign anim_class = ''
  if settings.scroll_animation != blank and settings.scroll_animation != 'none'
    assign anim_class = ' scroll-trigger ' | append: settings.scroll_animation
  endif
-%}
{%- if anim_class != '' -%}
<style>
  #shopify-section-{{ sid }} .scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{% render 'logos-style', section: section, bp: 769 %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .bi { margin-top: var(--bi-mt); margin-bottom: var(--bi-mb); }
  #shopify-section-{{ sid }} .bi-grid { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--bi-cgap); row-gap: var(--bi-rgap-m); align-items: stretch; }
  #shopify-section-{{ sid }} .bi-col { display: flex; flex-direction: column; min-width: 0; align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .bi[data-ta-l-m='center'] .bi-col--left, #shopify-section-{{ sid }} .bi[data-ta-r-m='center'] .bi-col--right { align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .bi[data-ta-l-m='right'] .bi-col--left, #shopify-section-{{ sid }} .bi[data-ta-r-m='right'] .bi-col--right { align-items: flex-end; text-align: right; }
  #shopify-section-{{ sid }} .bi[data-order-m='right_first'] .bi-col--left { order: 2; }
  #shopify-section-{{ sid }} .bi-b { margin: var(--b-mt, 0px) 0 var(--b-mb, 0px); padding: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .bi-eyebrow { color: var(--b-c); font-size: var(--b-fs-m); font-weight: var(--b-fw, var(--subheading-weight, 500)); letter-spacing: var(--b-ls, 1px); text-transform: uppercase; line-height: 1.4; }
  #shopify-section-{{ sid }} .bi-heading { color: var(--b-c); font-size: var(--b-fs-m); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .bi-heading[data-own-weight] { font-weight: var(--b-fw); }
  #shopify-section-{{ sid }} .bi-heading[data-own-size] { letter-spacing: var(--bi-hls); line-height: var(--heading-line-height, 1.2); }
  #shopify-section-{{ sid }} .bi-paragraph { color: var(--b-c); font-size: var(--b-fs-m); font-weight: var(--b-fw, inherit); line-height: var(--bi-plh); }
  #shopify-section-{{ sid }} .bi-paragraph p { margin: 0; font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ sid }} .bi-paragraph p + p { margin-top: 1em; }
  #shopify-section-{{ sid }} .bi-paragraph a { color: var(--lg-link); text-decoration: underline; }
  #shopify-section-{{ sid }} .bi-link a { display: inline-flex; align-items: center; min-height: 44px; color: var(--b-c); font-size: var(--b-fs-m); font-weight: var(--b-fw, 600); text-transform: var(--b-tt, none); letter-spacing: var(--b-ls, 0px); line-height: 1.3; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px; transition: color var(--btn-anim-duration, .2s) ease; }
  #shopify-section-{{ sid }} .bi-link a:hover { color: var(--b-ch); }
  #shopify-section-{{ sid }} .bi-divider { border: 0; border-top: var(--b-th, 1px) solid var(--lg-rule); width: 100%; max-width: var(--b-w, 100%); height: 0; }
  #shopify-section-{{ sid }} .bi-spacer { height: var(--b-h, 24px); }
  @media (min-width: 769px) {
    #shopify-section-{{ sid }} .bi-grid { grid-template-columns: minmax(0, var(--bi-lw)) minmax(0, var(--bi-rw)); row-gap: var(--bi-rgap-d); align-items: var(--bi-va); }
    #shopify-section-{{ sid }} .bi .bi-col { order: 0; align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .bi[data-ta-l='center'] .bi-col--left, #shopify-section-{{ sid }} .bi[data-ta-r='center'] .bi-col--right { align-items: center; text-align: center; }
    #shopify-section-{{ sid }} .bi[data-ta-l='right'] .bi-col--left, #shopify-section-{{ sid }} .bi[data-ta-r='right'] .bi-col--right { align-items: flex-end; text-align: right; }
    #shopify-section-{{ sid }} .bi-b { font-size: var(--b-fs-d, var(--b-fs-m)); }
    #shopify-section-{{ sid }} .bi-link a { font-size: var(--b-fs-d); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .bi-link a { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture link_c -%}{% if own %}{% render 'scheme-color', color: st.custom_link_color, fallback: 'var(--color-link, var(--color-heading))' %}{% else %}var(--color-link, var(--color-heading)){% endif %}{%- endcapture -%}
{%- capture link_h -%}{% if own %}{% render 'scheme-color', color: st.custom_link_hover_color, fallback: 'var(--color-link-hover, var(--color-text))' %}{% else %}var(--color-link-hover, var(--color-text)){% endif %}{%- endcapture -%}
{%- capture rule_c -%}{% if own %}{% render 'scheme-color', color: st.custom_rule_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}{%- endcapture -%}
<div id="editorial-{{ sid }}" class="lg bi editorial-mission color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'brand-info', width: st.section_width, fonts: fonts %} data-ta-l="{{ st.left_text_align | default: 'left' }}" data-ta-r="{{ st.right_text_align | default: 'left' }}" data-ta-l-m="{{ st.left_text_align_mobile | default: 'left' }}" data-ta-r-m="{{ st.right_text_align_mobile | default: 'left' }}" data-order-m="{{ st.mobile_stack_order | default: 'left_first' }}" data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default&quot;,&quot;section_width&quot;:&quot;container&quot;,&quot;reset_spacing&quot;:true,&quot;left_column_width&quot;:42,&quot;column_gap&quot;:80,&quot;row_gap&quot;:40,&quot;vertical_align&quot;:&quot;center&quot;,&quot;left_text_align&quot;:&quot;left&quot;,&quot;right_text_align&quot;:&quot;left&quot;,&quot;override_colors&quot;:false,&quot;override_fonts&quot;:false,&quot;heading_font&quot;:&quot;sans-serif&quot;,&quot;body_font&quot;:&quot;sans-serif&quot;,&quot;heading_letter_spacing&quot;:0,&quot;paragraph_line_height&quot;:1.6,&quot;padding_top&quot;:80,&quot;padding_bottom&quot;:80,&quot;padding_horizontal&quot;:40,&quot;margin_top&quot;:0,&quot;margin_bottom&quot;:0,&quot;mobile_stack_order&quot;:&quot;left_first&quot;,&quot;left_text_align_mobile&quot;:&quot;left&quot;,&quot;right_text_align_mobile&quot;:&quot;left&quot;,&quot;padding_top_mobile&quot;:48,&quot;padding_bottom_mobile&quot;:48,&quot;padding_horizontal_mobile&quot;:22,&quot;row_gap_mobile&quot;:28&#125;" data-lg-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Our story&quot;,&quot;column&quot;:&quot;left&quot;,&quot;use_custom_color&quot;:false,&quot;custom_color&quot;:&quot;#888888&quot;,&quot;size&quot;:13,&quot;size_mobile&quot;:12,&quot;font_weight&quot;:&quot;theme&quot;,&quot;letter_spacing&quot;:1,&quot;space_above&quot;:0,&quot;space_below&quot;:20&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;A short statement about your brand&quot;,&quot;column&quot;:&quot;left&quot;,&quot;use_custom_color&quot;:false,&quot;custom_color&quot;:&quot;#111111&quot;,&quot;size&quot;:40,&quot;size_mobile&quot;:30,&quot;font_weight&quot;:&quot;theme&quot;,&quot;text_transform&quot;:&quot;none&quot;,&quot;space_above&quot;:0,&quot;space_below&quot;:0&#125;,&quot;paragraph&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Use this space to tell customers what your brand is about. Share the story behind it, the values that guide you, and why you started. Keep it human and specific.&lt;/p&gt;&quot;,&quot;column&quot;:&quot;right&quot;,&quot;use_custom_color&quot;:false,&quot;custom_color&quot;:&quot;#444444&quot;,&quot;size&quot;:17,&quot;size_mobile&quot;:15,&quot;font_weight&quot;:&quot;theme&quot;,&quot;space_above&quot;:0,&quot;space_below&quot;:28&#125;,&quot;link&quot;:&#123;&quot;text&quot;:&quot;ABOUT US&quot;,&quot;column&quot;:&quot;right&quot;,&quot;use_custom_color&quot;:false,&quot;custom_color&quot;:&quot;#111111&quot;,&quot;custom_color_hover&quot;:&quot;#555555&quot;,&quot;size&quot;:14,&quot;font_weight&quot;:&quot;theme&quot;,&quot;text_transform&quot;:&quot;uppercase&quot;,&quot;letter_spacing&quot;:0.5,&quot;space_above&quot;:8,&quot;space_below&quot;:0&#125;,&quot;divider&quot;:&#123;&quot;column&quot;:&quot;right&quot;,&quot;thickness&quot;:1,&quot;width&quot;:100,&quot;space_above&quot;:16,&quot;space_below&quot;:16&#125;,&quot;spacer&quot;:&#123;&quot;column&quot;:&quot;right&quot;,&quot;height&quot;:24&#125;&#125;" style="{% render 'logos-root', section: section, custom: own, bg: st.custom_background_color, text: st.custom_text_color, heading: st.custom_heading_color, fonts: fonts, hfont: st.heading_font, bfont: st.body_font, pt_d: st.padding_top, pb_d: st.padding_bottom, pt_m: st.padding_top_mobile, pb_m: st.padding_bottom_mobile, px_d: st.padding_horizontal, px_m: st.padding_horizontal_mobile %}--lg-link: {{ link_c }};--lg-link-h: {{ link_h }};--lg-rule: {{ rule_c }};--bi-lw: {{ lw }}fr;--bi-rw: {{ rw }}fr;--bi-cgap: {{ st.column_gap | default: 0 }}px;--bi-rgap-d: {{ st.row_gap | default: 0 }}px;--bi-rgap-m: {{ st.row_gap_mobile | default: 0 }}px;--bi-va: {{ st.vertical_align | default: 'center' }};--bi-hls: {{ st.heading_letter_spacing | default: 0 }}px;--bi-plh: {{ st.paragraph_line_height | default: 1.6 }};--bi-mt: {{ st.margin_top | default: 0 }}px;--bi-mb: {{ st.margin_bottom | default: 0 }}px;">
  <div class="lg__inner editorial-inner">
    <div class="bi-grid editorial-grid">
      {%- assign cols = 'left,right' | split: ',' -%}
      {%- for col in cols -%}
      <div class="bi-col bi-col--{{ col }} editorial-col editorial-col--{{ col }}" data-lg-col="{{ col }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign bcol = 'right'
            if b.column == 'left'
              assign bcol = 'left'
            endif
          -%}
          {%- if bcol == col -%}
            {%- liquid
              assign bc = 'var(--lg-text)'
              assign fb = 'var(--lg-text)'
              if block.type == 'heading'
                assign fb = 'var(--lg-heading)'
              elsif block.type == 'link'
                assign fb = 'var(--lg-link)'
              endif
              assign bc = fb
              assign fw = ''
              if b.font_weight != blank and b.font_weight != 'theme'
                assign fw = b.font_weight
              endif
            -%}
            {%- capture bc -%}{% if b.use_custom_color %}{% render 'scheme-color', color: b.custom_color, fallback: fb %}{% else %}{{ fb }}{% endif %}{%- endcapture -%}
            {%- capture common -%}data-lg-index="{{ forloop.index0 }}" {% render 'logos-block', block: block, live: true %}{%- endcapture -%}
            {%- capture spacing -%}--b-mt: {{ b.space_above | default: 0 }}px;--b-mb: {{ b.space_below | default: 0 }}px;{%- endcapture -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                <p class="bi-b bi-eyebrow ed-block ed-eyebrow{{ anim_class }}" {{ common }}{% if b.text == blank %} hidden{% endif %} style="{{ spacing }}--b-c: {{ bc }};--b-fs-m: {{ b.size_mobile | default: b.size }}px;--b-fs-d: {{ b.size | default: 13 }}px;--b-ls: {{ b.letter_spacing | default: 0 }}px;{% if fw != '' %}--b-fw: {{ fw }};{% endif %}">{{ b.text }}</p>
              {%- when 'heading' -%}
                <h2 class="bi-b bi-heading ed-block ed-heading{{ anim_class }}" {{ common }}{% if b.text == blank %} hidden{% endif %}{% if fw != '' %} data-own-weight{% endif %}{% if st.heading_letter_spacing != 0 and st.heading_letter_spacing != blank %} data-own-size{% endif %} style="{{ spacing }}--b-c: {{ bc }};--b-fs-m: {{ b.size_mobile | default: b.size }}px;--b-fs-d: {{ b.size | default: 40 }}px;{% if fw != '' %}--b-fw: {{ fw }};{% endif %}{% if b.text_transform != blank and b.text_transform != 'none' %}--heading-text-transform: {{ b.text_transform }};{% endif %}">{{ b.text }}</h2>
              {%- when 'paragraph' -%}
                <div class="bi-b bi-paragraph ed-block ed-paragraph{{ anim_class }}" {{ common }}{% if b.text == blank %} hidden{% endif %} style="{{ spacing }}--b-c: {{ bc }};--b-fs-m: {{ b.size_mobile | default: b.size }}px;--b-fs-d: {{ b.size | default: 17 }}px;{% if fw != '' %}--b-fw: {{ fw }};{% endif %}">{{ b.text }}</div>
              {%- when 'link' -%}
                {%- capture bh -%}{% if b.use_custom_color %}{% render 'scheme-color', color: b.custom_color_hover, fallback: bc %}{% else %}var(--lg-link-h){% endif %}{%- endcapture -%}
                <div class="bi-b bi-link ed-block ed-link-wrap{{ anim_class }}" {{ common }}{% if b.text == blank %} hidden{% endif %} style="{{ spacing }}--b-c: {{ bc }};--b-ch: {{ bh }};--b-fs-m: {{ b.size | default: 14 }}px;--b-fs-d: {{ b.size | default: 14 }}px;--b-ls: {{ b.letter_spacing | default: 0 }}px;--b-tt: {{ b.text_transform | default: 'none' }};{% if fw != '' %}--b-fw: {{ fw }};{% endif %}">
                  {%- if b.url != blank -%}<a href="{{ b.url | url }}">{{ b.text | escape }}</a>{%- else -%}<a role="link" aria-disabled="true">{{ b.text | escape }}</a>{%- endif -%}
                </div>
              {%- when 'divider' -%}
                <hr class="bi-b bi-divider ed-block ed-divider{{ anim_class }}" {{ common }} style="{{ spacing }}--b-th: {{ b.thickness | default: 1 }}px;--b-w: {{ b.width | default: 100 }}%;">
              {%- when 'spacer' -%}
                <div class="bi-b bi-spacer ed-block ed-spacer" {{ common }} aria-hidden="true" style="--b-h: {{ b.height | default: 24 }}px;"></div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "brand-info",
  "name": "Brand info",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid",
          "label": "Fluid"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "label": "Left column width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "left_text_align",
      "label": "Left column alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "right_text_align",
      "label": "Right column alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_background_color",
      "label": "Background",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Heading",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Body text",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "custom_link_color",
      "label": "Link",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "custom_link_hover_color",
      "label": "Link on hover",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "custom_rule_color",
      "label": "Divider",
      "visible_if": "{{ section.settings.override_colors }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "override_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "sans-serif",
      "visible_if": "{{ section.settings.override_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "sans-serif",
      "visible_if": "{{ section.settings.override_fonts }}"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -4,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "paragraph_line_height",
      "label": "Paragraph line height",
      "min": 1,
      "max": 2.4,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Stack order",
      "default": "left_first",
      "options": [
        {
          "value": "left_first",
          "label": "Left column first"
        },
        {
          "value": "right_first",
          "label": "Right column first"
        }
      ]
    },
    {
      "type": "select",
      "id": "left_text_align_mobile",
      "label": "Left column alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "right_text_align_mobile",
      "label": "Right column alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
