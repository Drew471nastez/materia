<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_question_goes_here = 'accessibility.question_goes_here' | t -%}
{%- assign fb_accessibility_faq_image_placeholder = 'accessibility.faq_image_placeholder' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — FAQ 5 (image + accordion).
  Clean, fully scoped, mobile responsive, smooth open/close via CSS only.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign heading = st.heading
  assign subheading = st.subheading

  assign image = st.image
  assign image_position = st.image_position | default: 'left'
  assign image_ratio = st.image_ratio | default: 'square'
  assign image_radius = st.image_radius | default: 16

  assign content_alignment = st.content_alignment | default: 'left'
  assign allow_multiple_open = st.allow_multiple_open
  assign first_item_open = st.first_item_open
  assign open_icon = st.open_icon | default: 'plus'

  assign heading_size_d = st.heading_size_desktop | default: 36
  assign heading_size_m = st.heading_size_mobile | default: 26
  assign subheading_size_d = st.subheading_size_desktop | default: 16
  assign subheading_size_m = st.subheading_size_mobile | default: 14
  assign question_size_d = st.question_size_desktop | default: 18
  assign question_size_m = st.question_size_mobile | default: 15
  assign answer_size_d = st.answer_size_desktop | default: 15
  assign answer_size_m = st.answer_size_mobile | default: 14


  assign reveal = st.reveal
  assign scroll_animation = st.scroll_animation | default: 'inherit'
  if scroll_animation == 'inherit'
    assign scroll_animation = settings.scroll_animation | default: 'none'
  endif

  case image_ratio
    when 'square'
      assign aspect = '1/1'
    when 'portrait'
      assign aspect = '3/4'
    when 'landscape'
      assign aspect = '4/3'
    when 'wide'
      assign aspect = '16/9'
    else
      assign aspect = '1/1'
  endcase
-%}
{%- capture heading_color -%}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture subheading_color -%}{% render 'scheme-color', color: st.subheading_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture question_color -%}{% render 'scheme-color', color: st.question_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture answer_color -%}{% render 'scheme-color', color: st.answer_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture divider_color -%}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture icon_color -%}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture card_bg -%}{% render 'scheme-color', color: st.card_bg, fallback: 'transparent' %}{%- endcapture -%}
{%- capture card_border_color -%}{% render 'scheme-color', color: st.card_border_color, fallback: 'transparent' %}{%- endcapture -%}
{%- capture hover_color -%}{% render 'scheme-color', color: st.hover_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- capture section_bg -%}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{%- endcapture -%}

<style>
  /* ===== FAQ 5 — fully scoped to #shopify-section-{{ sid }} ===== */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, inherit);
  }

  /* Section margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Section width — content-only, background full bleed */
  #shopify-section-{{ sid }} .faq5__inner {
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: 1.5rem;
  }
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .faq5__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .faq5__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .faq5__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}

  #shopify-section-{{ sid }} .faq5 {
    background-color: {{ section_bg }} !important;
    padding-top: {{ st.padding_top | default: 60 }}px;
    padding-bottom: {{ st.padding_bottom | default: 60 }}px;
  }

  #shopify-section-{{ sid }} .faq5__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.gap_mobile | default: 30 }}px;
    align-items: center;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq5__grid {
      grid-template-columns: 1fr 1fr;
      gap: {{ st.gap_desktop | default: 60 }}px;
    }
    {% if image_position == 'right' %}
      #shopify-section-{{ sid }} .faq5__media { order: 2; }
      #shopify-section-{{ sid }} .faq5__content { order: 1; }
    {% endif %}
  }

  #shopify-section-{{ sid }} .faq5__media {
    width: 100%;
    border-radius: {{ image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ aspect }};
    background: rgba(var(--color-heading-rgb), 0.06);
  }
  #shopify-section-{{ sid }} .faq5__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ sid }} .faq5__header {
    text-align: {{ content_alignment }};
    margin-bottom: {{ st.gap_header_to_items | default: 24 }}px;
  }
  #shopify-section-{{ sid }} .faq5__heading {
    margin: 0;
    font-size: {{ heading_size_m }}px;
    line-height: 1.15;
    color: {{ heading_color }} !important;
    {% if st.enable_custom_heading_weight %}font-weight: {{ st.heading_weight | default: 600 }};{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq5__heading { font-size: {{ heading_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq5__subheading {
    margin: {{ st.gap_heading_to_subheading | default: 12 }}px 0 0;
    font-size: {{ subheading_size_m }}px;
    color: {{ subheading_color }} !important;
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq5__subheading { font-size: {{ subheading_size_d }}px; }
  }

  #shopify-section-{{ sid }} .faq5__list {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_between_items | default: 0 }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ sid }} .faq5__item {
    background: {{ card_bg }} !important;
    border: 1px solid {{ card_border_color }};
    border-radius: {{ st.item_radius | default: 0 }}px;
    {% if st.show_dividers and st.gap_between_items == 0 %}
      border-bottom: 1px solid {{ divider_color }};
    {% endif %}
  }
  {% if st.show_dividers and st.gap_between_items == 0 %}
    #shopify-section-{{ sid }} .faq5__item:first-child { border-top: 1px solid {{ divider_color }}; }
  {% endif %}

  #shopify-section-{{ sid }} .faq5__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: {{ st.item_padding_y | default: 18 }}px {{ st.item_padding_x | default: 4 }}px;
    text-align: start;
    color: {{ question_color }} !important;
    font-size: {{ question_size_m }}px;
    line-height: 1.4;
    transition: color .2s ease;
    {% if st.enable_custom_question_weight %}font-weight: {{ st.question_weight | default: 600 }};{% else %}font-weight: var(--heading-weight, 600);{% endif %}
  }
  #shopify-section-{{ sid }} .faq5__q:hover { color: {{ hover_color }} !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq5__q { font-size: {{ question_size_d }}px; }
  }

  #shopify-section-{{ sid }} .faq5__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: {{ icon_color }} !important;
    transition: transform .35s cubic-bezier(.4,0,.2,1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  #shopify-section-{{ sid }} .faq5__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  #shopify-section-{{ sid }} .faq5__item[open] .faq5__icon-chevron {
    transform: rotate(180deg);
  }
  #shopify-section-{{ sid }} .faq5__icon-plus .v,
  #shopify-section-{{ sid }} .faq5__icon-plus .h {
    position: absolute;
    background: currentColor;
    transition: transform .35s cubic-bezier(.4,0,.2,1), opacity .25s ease;
  }
  #shopify-section-{{ sid }} .faq5__icon-plus .v { width: 2px; height: 14px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq5__icon-plus .h { width: 14px; height: 2px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq5__item[open] .faq5__icon-plus .v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }

  /* Smooth open/close — grid-template-rows trick */
  #shopify-section-{{ sid }} .faq5__a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1);
  }
  #shopify-section-{{ sid }} .faq5__item[open] .faq5__a-wrap {
    grid-template-rows: 1fr;
  }
  #shopify-section-{{ sid }} .faq5__a-inner { overflow: hidden; }
  #shopify-section-{{ sid }} .faq5__a {
    margin: 0;
    padding: 0 {{ st.item_padding_x | default: 4 }}px {{ st.item_padding_y | default: 18 }}px;
    color: {{ answer_color }} !important;
    font-size: {{ answer_size_m }}px;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq5__a { font-size: {{ answer_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq5__a a { color: inherit; text-decoration: underline; }

  /* Reveal-on-scroll */
  {%- if reveal and scroll_animation != 'none' and request.design_mode != true -%}
    #shopify-section-{{ sid }} .faq5 {
      opacity: 0;
      transition: opacity .8s ease, transform .8s ease, filter .8s ease, clip-path .8s ease;
      will-change: opacity, transform;
    }
    {%- case scroll_animation -%}
      {%- when 'slide-in' -%}
        #shopify-section-{{ sid }} .faq5 { transform: translateX(-20px); }
        #shopify-section-{{ sid }} .faq5.is-revealed { transform: translateX(0); }
      {%- when 'smooth-fade-up' -%}
        #shopify-section-{{ sid }} .faq5 { transform: translateY(20px); }
        #shopify-section-{{ sid }} .faq5.is-revealed { transform: translateY(0); }
      {%- when 'blur_up' -%}
        #shopify-section-{{ sid }} .faq5 { transform: translateY(12px); filter: blur(4px); }
        #shopify-section-{{ sid }} .faq5.is-revealed { transform: none; filter: none; }
      {%- when 'slide_side' -%}
        #shopify-section-{{ sid }} .faq5 { transform: translateX(-28px); }
        #shopify-section-{{ sid }} .faq5.is-revealed { transform: none; }
      {%- when 'mask_reveal' -%}
        #shopify-section-{{ sid }} .faq5 { opacity: 1; clip-path: inset(0 0 100% 0); transform: translateY(10px); }
        #shopify-section-{{ sid }} .faq5.is-revealed { clip-path: inset(0 0 0 0); transform: none; }
    {%- endcase -%}
    #shopify-section-{{ sid }} .faq5.is-revealed { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .faq5 { transition: none !important; transform: none !important; opacity: 1 !important; filter: none !important; clip-path: none !important; }
    }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.faq5__a-wrap, .faq5__icon, .faq5__icon-plus *) {
      transition: none !important;
    }
  }
{% comment %}{% endcomment %}</style>

<div class="faq5 color-{{ color_scheme }} gradient">
  <div class="faq5__inner">
    <div class="faq5__grid">
      <div class="faq5__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 1500 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 768px) 50vw, 100vw',
            widths: '375, 600, 900, 1200, 1500',
            alt: image.alt | default: heading | escape
          }}
        {%- else -%}
          <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E"
               loading="lazy"
               alt="{{ heading | default: fb_accessibility_faq_image_placeholder | escape }}">
        {%- endif -%}
      </div>

      <div class="faq5__content">
        {%- if heading != blank or subheading != blank -%}
          <div class="faq5__header">
            {%- if heading != blank -%}<h2 class="faq5__heading">{{ heading }}</h2>{%- endif -%}
            {%- if subheading != blank -%}<div class="faq5__subheading">{{ subheading }}</div>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="faq5__list" data-faq5-list data-multiple="{% if allow_multiple_open %}true{% else %}false{% endif %}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign bs = block.settings
                assign open_first = false
                if first_item_open and forloop.first
                  assign open_first = true
                endif
              -%}
              <div
                class="faq5__item"
                {% if open_first %}open{% endif %}
                data-faq5-item
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="faq5__q"
                  aria-expanded="{% if open_first %}true{% else %}false{% endif %}"
                  aria-controls="faq5-a-{{ sid }}-{{ forloop.index }}"
                  data-faq5-trigger
                >
                  <span>{{ bs.question | default: fb_accessibility_question_goes_here }}</span>
                  <span class="faq5__icon" aria-hidden="true">
                    {%- if open_icon == 'chevron' -%}
                      <svg class="faq5__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- elsif open_icon == 'arrow' -%}
                      <svg class="faq5__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
                    {%- else -%}
                      <span class="faq5__icon-plus">
                        <span class="v"></span>
                        <span class="h"></span>
                      </span>
                    {%- endif -%}
                  </span>
                </button>
                <div class="faq5__a-wrap" id="faq5-a-{{ sid }}-{{ forloop.index }}">
                  <div class="faq5__a-inner">
                    <div class="faq5__a">{{ bs.answer }}</div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ sid }}');
    if (!section) return;
    var list = section.querySelector('[data-faq5-list]');
    if (!list) return;
    var multiple = list.dataset.multiple === 'true';

    list.addEventListener('click', function (e) {
      var trig = e.target.closest('[data-faq5-trigger]');
      if (!trig) return;
      var item = trig.closest('[data-faq5-item]');
      if (!item) return;
      var isOpen = item.hasAttribute('open');
      if (!multiple) {
        list.querySelectorAll('[data-faq5-item][open]').forEach(function (it) {
          if (it !== item) {
            it.removeAttribute('open');
            var btn = it.querySelector('[data-faq5-trigger]');
            if (btn) btn.setAttribute('aria-expanded', 'false');
          }
        });
      }
      if (isOpen) {
        item.removeAttribute('open');
        trig.setAttribute('aria-expanded', 'false');
      } else {
        item.setAttribute('open', '');
        trig.setAttribute('aria-expanded', 'true');
      }
    });

    var animation = '{{ scroll_animation }}';
    var revealEl = section.querySelector('.faq5');
    if (document.body.classList.contains('shopify-design-mode')) {
      if (revealEl) revealEl.classList.add('is-revealed');
    } else if (animation && animation !== 'none' && revealEl) {
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            revealEl.classList.add('is-revealed');
            obs.unobserve(revealEl);
          }
        });
      }, { threshold: 0.12 });
      io.observe(revealEl);
    } else if (revealEl) {
      revealEl.classList.add('is-revealed');
    }
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "faq5",
  "name": "FAQ 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Heading & Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
