<template compat="shopify">
{%- comment -%}Removed at the creator's request. StoreLib retains Git-deleted definitions; this retired definition stays empty and out of Add section.{%- endcomment -%}
</template>

<schema>
{
  "type": "page-sale-banner",
  "name": "Page sale banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Section Header"
    },
    {
      "type": "textarea",
      "id": "heading",
      "default": "Sale Up to 75% Off",
      "label": "Heading"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Image / Media"
    },
    {
      "type": "video",
      "id": "local_video",
      "label": "Local video"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading uppercase"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Video overlay color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 80
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "sale_label",
          "label": "Sale label",
          "default": "Sale off"
        },
        {
          "type": "text",
          "id": "sale_title",
          "label": "Sale title",
          "default": "Sale title"
        },
        {
          "type": "textarea",
