            "min": 16,
            "max": 80,
            "step": 2,
            "default": 32
          },
          {
            "type": "range",
            "id": "ref_avatar_overlap_desktop",
            "label": "Avatar overlap (desktop, px)",
            "min": 0,
            "max": 40,
            "step": 1,
            "default": 10
          },
