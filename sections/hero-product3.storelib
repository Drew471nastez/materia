"icon":"gift","shimmer":true,"enable_custom_style":false,"border_style":"dashed","border_width":1,"radius":12,"icon_radius":12,"title_size":14,"body_size":13,"icon_box_size":44,"padding_x":16,"padding_y":14,"gap":14,"max_width":540,"margin_top":8,"margin_bottom":14,"enable_custom_alignment":false}}' data-hp3-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-hp3-motion="{{ settings.scroll_animation | default: 'none' }}" data-hp3-duration="{{ settings.animation_duration | default: 700 }}" data-hp3-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="hp3__inner"><div class="hp3__row"><div class="hp3__content">
 {% if section.blocks.size == 0 and request.design_mode %}{% render 'hero-preview-cover', name: 'Hero Product 3' %}{% endif %}{% for block in section.blocks %}{% unless block.hidden %}<div class="hp3__block" data-hp3-block="{{ block.id }}" data-hp3-kind="{{ block.type }}" data-hp3-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>{% render 'hero-product-three-block', block: block %}</div>{% endunless %}{% endfor %}
 </div><div class="hp3__media"><picture>{% if s.featured_image_mobile != blank %}<source media="(max-width:899px)" srcset="{% render 'offer-image-url', image: s.featured_image_mobile, escaped: true %}">{% endif %}<img src="{% if image != blank %}{% render 'offer-image-url', image: image, escaped: true %}{% elsif s.featured_image_mobile != blank %}{% render 'offer-image-url', image: s.featured_image_mobile, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-hp3-placeholder="{{ placeholder | escape }}" alt="{{ s.image_alt | default: image.alt | default: p.title | escape }}" width="1600" height="1800" loading="eager" fetchpriority="high" decoding="async"></picture></div></div></div>
 <div class="hp3__divider hp3__divider--top" data-hp3-top-shape aria-hidden="true"><svg viewBox="0 0 1200 120" preserveAspectRatio="none"><path/></svg></div>
 <div class="hp3__divider" data-hp3-shape aria-hidden="true"><svg viewBox="0 0 1200 120" preserveAspectRatio="none"><path/></svg></div>
 <template data-hp3-icon="shield"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 7.5-8 9-4-1.5-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg></template>
<template data-hp3-icon="shield_check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></template>
<template data-hp3-icon="check"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></template>
<template data-hp3-icon="lock"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></template>
<template data-hp3-icon="truck"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="13" height="9"/><path d="M15 10h4l3 4v2h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></template>
<template data-hp3-icon="preset"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></template>
<template data-hp3-icon="svg"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></template>
