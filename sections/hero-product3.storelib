        {
          "type": "header",
          "id": "hdr_79",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "gap_x",
          "label": "Horizontal gap between pills",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "gap_y",
          "label": "Vertical gap between pills",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Top padding",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Bottom padding",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "heading_margin_bottom",
          "label": "Space below heading",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "pill_padding_x",
          "label": "Pill horizontal padding",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "pill_padding_y",
          "label": "Pill vertical padding",
          "min": 0,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "pill_gap",
          "label": "Gap between icon and text",
          "min": 0,
          "max": 16,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "checkbox",
          "id": "enable_custom_alignment",
          "label": "Override section alignment",
          "default": false
        }
      ],
      "limit": 3
