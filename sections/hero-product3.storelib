<template data-hp3-icon="leaf"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c8 0 14-6 14-14-7 0-13 1-14 8-.5 4 0 6 0 6Z"/><path d="M5 19c2-3 5-6 9-9"/></svg></template>
<template data-hp3-icon="smile"><svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c.7 1.3 2 2.2 3.5 2.2s2.8-.9 3.5-2.2"/><circle cx="9" cy="10" r=".6" fill="currentColor"/><circle cx="15" cy="10" r=".6" fill="currentColor"/></svg></template>
