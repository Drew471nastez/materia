<schema>
{
  "type": "hero-product3",
  "name": "Hero Product 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 35,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_columns",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "top_divider_color",
      "label": "Top divider color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "bottom_divider_color",
      "label": "Bottom divider color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "divider_bottom_color",
      "label": "Divider color",
      "info": "Match next section background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Content"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product",
      "info": "Used by rating blocks"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image"
    },
    {
      "type": "image_picker",
      "id": "featured_image_mobile",
      "label": "Featured image (mobile override)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Media Layout"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image height (desktop)",
      "min": 100,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "checkbox",
      "id": "image_full_width",
      "label": "Image full width",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Animation & Behavior"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "default": "theme",
      "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal content on entry",
      "default": false,
      "info": "When no other animation is selected, use a subtle reveal. Editor slider changes never replay the entrance."
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Section Dividers"
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "range",
      "id": "top_divider_thickness",
      "label": "Top divider thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "Show bottom divider",
      "default": false
    },
    {
      "type": "range",
      "id": "bottom_divider_thickness",
      "label": "Bottom divider thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "divider_top_style",
      "label": "Top shape",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "wave_soft",
          "label": "Wave (soft)"
        },
        {
          "value": "zigzag",
          "label": "Zig-zag"
        },
        {
          "value": "curve_down",
          "label": "Curve (dip)"
        },
        {
          "value": "arch_up",
          "label": "Arch (peak)"
        },
        {
          "value": "triangles",
          "label": "Triangles"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        },
        {
          "value": "tilt_left",
          "label": "Tilt left"
        },
        {
          "value": "tilt_right",
          "label": "Tilt right"
        },
        {
          "value": "straight",
          "label": "Straight bar"
        }
      ]
    },
    {
      "type": "color",
      "id": "divider_top_color",
      "label": "Top shape color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "divider_top_height_desktop",
      "label": "Top shape height (desktop)",
      "min": 0,
      "max": 200,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "divider_top_height_mobile",
      "label": "Top shape height (mobile)",
      "min": 0,
      "max": 200,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "divider_top_flip",
      "label": "Flip top shape horizontally",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "divider_top_rotate",
      "label": "Rotate top shape 180°",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_bottom_style",
      "label": "Shape",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
