          },
          {
            "type": "color",
            "id": "dot_color",
            "label": "Dot color",
            "default": "#ef4444",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Pill background color",
            "default": "#fff5f5",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "border_radius",
            "label": "Border radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 4,
            "step": 1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "shadow_value",
            "label": "Shadow style",
            "default": "0 2px 10px -2px rgba(0,0,0,0.08)",
