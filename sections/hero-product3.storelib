            "label": "Total stars",
            "min": 3,
            "max": 5,
            "step": 1,
            "default": 5
          },
          {
            "type": "range",
            "id": "filled_stars",
            "label": "Filled stars",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "default": 5,
            "info": "Supports half stars (e.g., 4.5)."
          },
          {
            "type": "range",
            "id": "star_size",
            "label": "Star size",
            "min": 12,
            "max": 36,
            "step": 1,
            "unit": "px",
            "default": 18
          },
          {
            "type": "checkbox",
            "id": "enable_custom_alignment",
            "label": "Override section alignment",
            "default": false
          }
        ]
      },
      {
        "type": "low_stock_badge",
        "name": "Low stock badge",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "checkbox",
            "id": "enable_pulse",
            "label": "Pulsing dot animation",
            "default": true
          },
          {
            "type": "text",
            "id": "label_text",
            "label": "Label text (bold)",
            "default": "Low Stock:"
          },
          {
            "type": "text",
            "id": "body_text",
            "label": "Body text",
            "info": "[count] inserts the number",
            "default": "Only [count] units left in stock"
          },
          {
            "type": "select",
            "id": "stock_source",
            "label": "Stock source",
            "default": "product",
            "options": [
              {
                "value": "product",
                "label": "Product inventory"
              },
              {
                "value": "manual",
                "label": "Manual count"
              }
            ],
            "info": "Hide the badge if verified inventory is unavailable. Manual mode displays only the fixed count you enter."
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "show_shadow",
            "label": "Show shadow",
            "default": true,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Body text color (optional)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "font_size_desktop",
            "label": "Font size (desktop)",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "font_size_mobile",
            "label": "Font size (mobile)",
            "min": 10,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "500",
            "options": [
              {
                "value": "400",
                "label": "Regular (400)"
              },
              {
                "value": "500",
                "label": "Medium (500)"
              },
              {
                "value": "600",
                "label": "Semibold (600)"
              },
              {
                "value": "700",
                "label": "Bold (700)"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "accent_color",
            "label": "Accent color (label + count)",
