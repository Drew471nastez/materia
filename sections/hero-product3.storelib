              },
              {
                "value": "0 2px 10px -2px rgba(0,0,0,0.08)",
                "label": "Soft (default)"
              },
              {
                "value": "0 4px 14px -4px rgba(0,0,0,0.15)",
                "label": "Medium"
              },
              {
                "value": "0 6px 24px -6px rgba(0,0,0,0.2)",
                "label": "Strong"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Inner horizontal padding",
            "min": 8,
            "max": 32,
            "step": 1,
            "unit": "px",
            "default": 18
          },
          {
            "type": "range",
            "id": "padding_y",
