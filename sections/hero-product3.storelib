<template compat="shopify">
{% render 'theme-type' %}
{{ 'hero-product-three.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'hero-product-three.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign p = s.featured_product %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% assign image = s.featured_image | default: p.featured_image | default: p.image %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="hp3-{{ section.id }}" class="hp3 color-{{ scheme }}" data-hero-product-three="{{ section.id }}" data-hp3-settings="{{ s | json | escape }}" data-hp3-product="{{ p | json | escape }}" data-hp3-button-font="{{ settings.button_font | default: 'body_font' }}" data-hp3-currency="{{ shop.currency | default: 'EUR' }}" data-hp3-defaults='{"section_width":"container","color_scheme":"default-color-scheme","reset_spacing":true,"image_position":"right","text_column_width":50,"gap_columns":64,"content_align_desktop":"left","enable_custom_style":false,"image_radius":16,"divider_bottom_color":"#FFFFFF","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","image_fit":"cover","image_height_desktop":550,"image_full_width":false,"animation":"theme","reveal":false,"show_top_divider":false,"top_divider_thickness":1,"show_bottom_divider":false,"bottom_divider_thickness":1,"divider_top_style":"none","divider_top_height_desktop":60,"divider_top_height_mobile":40,"divider_top_flip":false,"divider_top_rotate":false,"divider_bottom_style":"none","divider_bottom_height_desktop":60,"divider_bottom_flip":false,"padding_top_desktop":64,"padding_bottom_desktop":64,"section_padding_left_desktop":16,"section_padding_right_desktop":16,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"image_position_mobile":"top","content_align_mobile":"left","gap_columns_mobile":32,"image_height_mobile":320,"padding_top_mobile":32,"padding_bottom_mobile":32,"section_padding_left_mobile":20,"section_padding_right_mobile":20,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"divider_bottom_height_mobile":40}' data-hp3-block-defaults='{"heading":{"heading_text":"Hero Product Section","accent_style":"italic","enable_custom_style":false,"font_weight":"theme","font_size_desktop":56,"font_size_mobile":32,"line_height_desktop":1.1,"line_height_mobile":1.2,"enable_custom_font":false,"custom_font_name":"assistant_n4","enable_gradient":false,"gradient_angle":90,"font_source":"heading","text_case":"theme","letter_spacing":0,"max_width":640,"margin_bottom":16,"enable_custom_alignment":false},"subheading":{"text":"&lt;p&gt;Short supporting copy that explains what the product does and why it matters.&lt;/p&gt;","enable_custom_style":false,"font_weight":"theme","font_size_desktop":17,"font_size_mobile":15,"line_height":1.5,"font_source":"body","text_case":"theme","letter_spacing":0,"max_width":560,"margin_bottom":16,"enable_custom_alignment":false},"primary_button":{"label":"SHOP NOW","full_width":true,"enable_custom_style":false,"uppercase":true,"use_theme_button":true,"border_width":0,"border_radius":100,"font_weight":"700","font_size_desktop":15,"font_size_mobile":14,"letter_spacing":0.5,"padding_x_desktop":28,"padding_y_desktop":16,"padding_x_mobile":22,"padding_y_mobile":14,"margin_top":8,"margin_bottom":16,"enable_custom_alignment":false},"secondary_button":{"label":"Learn More","full_width":false,"enable_custom_style":false,"style":"outline","uppercase":false,"use_theme_button":true,"border_width":1,"border_radius":100,"font_weight":"600","font_size_desktop":15,"font_size_mobile":14,"letter_spacing":0.3,"padding_x_desktop":28,"padding_y_desktop":16,"padding_x_mobile":22,"padding_y_mobile":14,"margin_top":8,"margin_bottom":16,"enable_custom_alignment":false},"guarantee_badge":{"text":"30-Day Money-Back Guarantee","icon":"shield_check","enable_custom_style":false,"font_size":14,"font_weight":"500","icon_size":18,"alignment":"flex-start","margin_top":0,"margin_bottom":0,"enable_custom_alignment":false},"pill_badge":{"text":"NEW ARRIVAL","icon":"✨","enable_custom_style":false,"style_preset":"solid_dark","uppercase":true,"border_width":0,"border_radius":100,"enable_gradient":false,"gradient_angle":90,"font_size":12,"font_weight":"700","letter_spacing":0.5,"padding_x":14,"padding_y":8,"margin_top":0,"margin_bottom":16,"enable_custom_alignment":false},"accent_block":{"text":"1,250+ customers trust us","enable_custom_styl