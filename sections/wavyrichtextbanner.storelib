</template>

<schema>
{
  "type": "wavyrichtextbanner",
  "name": "Wavy Richtext Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment of Content",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color",
      "default": "#FFFFFF",
      "info": "Background of the whole section area around the wavy banner."
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Color of Waves",
      "default": "#F2F2F2"
    },
    {
      "type": "select",
      "id": "wave_type",
      "label": "Type of Waves",
      "options": [
        {
          "value": "type1",
          "label": "Gentle Waves"
        },
        {
          "value": "type2",
          "label": "Curvy Waves"
        },
        {
          "value": "type3",
          "label": "Sharp Waves"
        },
        {
          "value": "type4",
          "label": "Asymmetric Waves"
        },
        {
          "value": "type5",
          "label": "Rolling Waves"
        }
      ],
      "default": "type5"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "checkbox",
      "id": "enable_wave_animation",
      "label": "Enable Wave Animation",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_layout_desktop",
      "label": "Desktop Layout for Content",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical_reverse",
          "label": "Vertical reverse"
        },
        {
          "value": "horizontal_reverse",
          "label": "Horizontal reverse"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "vertical_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Vertical Gap between Button & Elements",
      "default": 20
    },
    {
      "type": "range",
      "id": "inner_width",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Inner content width",
      "default": 80,
      "info": "Applies only to desktop"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "vertical_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Vertical Gap between Button & Elements",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Catchy Headline",
          "label": "Heading Text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 16,
          "max": 72,
          "step": 2,
          "unit": "px",
          "label": "Heading Font Size",
          "default": 32
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading Font Weight",
          "options": [
            {
              "value": "100",
              "label": "Thin"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "600"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "heading_alternative_font",
          "label": "Use Alternative Font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "heading_font",
          "label": "Alternative Font",
          "default": "sans_serif_n4"
        }
      ],
      "limit": 1
    },
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "caption",
          "default": "Supporting Subheadline",
          "label": "Caption Text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "caption_size",
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Caption Font Size",
          "default": 16
        },
        {
          "type": "select",
          "id": "caption_weight",
          "label": "Caption Font Weight",
          "options": [
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "600",
              "label": "Bold"
            }
          ],
          "default": "400"
        },
        {
          "type": "color",
          "id": "caption_color",
          "label": "Caption Color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "caption_alternative_font",
          "label": "Use Alternative Font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "caption_font",
          "label": "Alternative Font",
          "default": "sans_serif_n4"
        }
      ],
      "limit": 1
    },
    {
      "type": "text",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Engage your audience with compelling content about your offer.</p>",
          "label": "Description Text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "description_size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Description Font Size",
          "default": 16
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description Color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "description_alternative_font",
          "label": "Use Alternative Font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "description_font",
          "label": "Alternative Font",
          "default": "sans_serif_n4"
        }
      ],
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "select",
          "id": "primary_button_behaviour",
          "label": "Primary Button Action",
          "options": [
            {
              "value": "link",
              "label": "Link"
            },
            {
              "value": "scroll_to_top",
              "label": "Scroll to top"
            }
          ],
          "default": "link"
        },
        {
          "type": "text",
          "id": "primary_button_label",
          "default": "Shop Now",
          "label": "Primary Button Text"
        },
        {
          "type": "url",
          "id": "primary_button_link",
          "label": "Primary Button URL",
          "visible_if": "{{ block.settings.primary_button_behaviour == 'link' }}"
        },
        {
          "type": "checkbox",
          "id": "primary_new_tab",
          "label": "Open Primary Link in New Tab",
          "default": false,
          "visible_if": "{{ block.settings.primary_button_behaviour == 'link' }}"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Button Text"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button URL"
        },
        {
          "type": "checkbox",
          "id": "secondary_new_tab",
          "label": "Open Secondary Link in New Tab",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_9",
          "label": "Buttons"
        },
        {
          "type": "checkbox",
          "id": "use_theme_button",
          "label": "Use theme button style",
          "info": "Solid and outline buttons follow Theme settings > Buttons. Turn off to set their colours and corners here.",
          "default": true
        },
        {
          "type": "select",
          "id": "primary_button_style",
          "label": "Primary Button Style",
          "options": [
            {
              "value": "solid",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "primary_text_color",
          "label": "Primary Text Color",
          "default": "#FFFFFF",
          "visible_if": "{{ block.settings.use_theme_button == false or block.settings.primary_button_style == 'link' }}"
        },
        {
          "type": "color",
          "id": "primary_background_color",
          "label": "Primary Background Color",
          "default": "#222222",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}"
        },
        {
          "type": "color",
          "id": "primary_border_color",
          "label": "Primary Border Color",
          "default": "#222222",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}"
        },
        {
          "type": "range",
          "id": "primary_button_corner",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Primary Corner Radius",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}",
          "default": 8
        },
        {
          "type": "select",
          "id": "secondary_button_style",
          "label": "Secondary Button Style",
          "options": [
            {
              "value": "solid",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "secondary_text_color",
          "label": "Secondary Text Color",
          "default": "#FFFFFF",
          "visible_if": "{{ block.settings.use_theme_button == false or block.settings.secondary_button_style == 'link' }}"
        },
        {
          "type": "color",
          "id": "secondary_background_color",
          "label": "Secondary Background Color",
          "default": "#222222",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}"
        },
        {
          "type": "color",
          "id": "secondary_border_color",
          "label": "Secondary Border Color",
          "default": "#222222",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}"
        },
        {
          "type": "range",
          "id": "secondary_button_corner",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Secondary Corner Radius",
          "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}",
          "default": 8
        },
        {
          "type": "select",
          "id": "button_font_weight",
          "label": "Button Font Weight",
          "options": [
            {
              "value": "100",
              "label": "Thin"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "400",
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Wavy Richtext Banner",
      "category": "Text",
      "blocks": [
        {
          "type": "caption"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
