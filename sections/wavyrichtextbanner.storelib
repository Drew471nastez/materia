        assign bottom_front_animate2 = 'M0,100 C150,0 350,200 600,100 C850,0 1050,200 1200,100 L1200,200 L0,200 Z'
        assign bottom_front_animate3 = bottom_front_animate1
      when 'type2'
        assign top_back_d = 'M0,120 C180,170 380,50 580,120 C780,170 980,50 1180,120 L1200,0 L0,0 Z'
        assign top_back_animate1 = 'M0,120 C180,50 380,170 580,120 C780,50 980,170 1180,120 L1200,0 L0,0 Z'
        assign top_back_animate2 = 'M0,120 C180,170 380,50 580,120 C780,170 980,50 1180,120 L1200,0 L0,0 Z'
