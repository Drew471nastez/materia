        assign top_back_animate1 = 'M0,140 C240,90 440,190 640,140 C840,90 1040,190 1240,140 L1200,0 L0,0 Z'
        assign top_back_animate2 = 'M0,140 C240,190 440,90 640,140 C840,190 1040,90 1240,140 L1200,0 L0,0 Z'
        assign top_back_animate3 = top_back_animate1

        assign top_front_d = 'M0,120 C190,220 390,20 640,120 C890,220 1090,20 1240,120 L1200,0 L0,0 Z'
        assign top_front_animate1 = 'M0,120 C190,220 390,20 640,120 C890,220 1090,20 1240,120 L1200,0 L0,0 Z'
        assign top_front_animate2 = 'M0,120 C190,20 390,220 640,120 C890,20 1090,220 1240,120 L1200,0 L0,0 Z'
        assign top_front_animate3 = top_front_animate1

        assign bottom_back_d = 'M0,120 C290,120 490,170 640,120 C790,70 990,120 1240,120 L1200,200 L0,200 Z'
        assign bottom_back_animate1 = 'M0,120 C290,120 490,170 640,120 C790,70 990,120 1240,120 L1200,200 L0,200 Z'
        assign bottom_back_animate2 = 'M0,120 C290,170 490,70 640,120 C790,170 990,70 1240,120 L1200,200 L0,200 Z'
        assign bottom_back_animate3 = bottom_back_animate1

        assign bottom_front_d = 'M0,120 C190,220 390,20 640,120 C890,220 1090,20 1240,120 L1200,200 L0,200 Z'
        assign bottom_front_animate1 = 'M0,120 C190,220 390,20 640,120 C890,220 1090,20 1240,120 L1200,200 L0,200 Z'
        assign bottom_front_animate2 = 'M0,120 C190,20 390,220 640,120 C890,20 1090,220 1240,120 L1200,200 L0,200 Z'
        assign bottom_front_animate3 = bottom_front_animate1
    endcase
	-%}

	<div class="LoudzWavesBoxContainer">
		<div class="LoudzWavesBox LoudzWavesBox--top">
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--back">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					 <path d="{{ top_back_d }}" opacity="0.4">
					{% if section.settings.enable_wave_animation %}
					<animate
					  attributeName="d"
					  dur="12s"
					  repeatCount="indefinite"
					  values="{{ top_back_animate1 }}; {{ top_back_animate2 }}; {{ top_back_animate3 }}" />
					{% endif %}
					 </path>
				</svg>
			</div>
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--front">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					 <path d="{{ top_front_d }}">
					{% if section.settings.enable_wave_animation %}
						<animate
						attributeName="d"
						dur="8s"
						repeatCount="indefinite"
						values="{{ top_front_animate1 }}; {{ top_front_animate2 }}; {{ top_front_animate3 }}" />
					{% endif %}
					 </path>
				</svg>
			</div>
		</div>
		<div class="LoudzWavyBannerSectionContainer">
			<div
				class="
					LoudzTextButtonContent
					LoudzTextButtonContent--contentLayout-{{ section.settings.content_layout_desktop }}
					LoudzTextButton__Content--alignment-{{ section.settings.content_alignment }}
				"
			>
				<div class="LoudzTextBox">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading_alternative_font -%}
									<style>
										{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture heading_css_variables -%}
										--block-heading-size: {{- block.settings.heading_size -}}px;
										--block-heading-color: {{- block.settings.heading_color -}} !important;
										--block-heading-font: {{- block.settings.heading_font.family -}};
                    --block-heading-weight: {{- block.settings.heading_weight -}};
									  {%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Heading {% if block.settings.heading_alternative_font == true %}LoudzTextBox__Heading--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "caption" -%}
								{%- if block.settings.caption_alternative_font -%}
									<style>
										{{- block.settings.caption_font | font_face: font_display: 'swap' -}}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture caption_css_variables -%}
										--block-caption-size: {{- block.settings.caption_size -}}px;
										--block-caption-color: {{- block.settings.caption_color -}} !important;
										--block-caption-font: {{- block.settings.caption_font.family -}};
										--block-caption-weight: {{- block.settings.caption_weight -}};
									  {%- endcapture -%}
								<p
									style="{{- caption_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Caption {% if block.settings.caption_alternative_font == true %}LoudzTextBox__Caption--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.caption -}}
								</p>
							{%- when "text" -%}
								{%- if block.settings.description_alternative_font -%}
									{%- liquid
										assign body_font_bold = block.settings.description_font | font_modify: 'weight', 'bold'
										assign body_font_italic = block.settings.description_font | font_modify: 'style', 'italic'
										assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
									%}
									<style>
										{{- block.settings.description_font | font_face: font_display: 'swap' -}}
										{{ body_font_bold | font_face: font_display: 'swap' }}
										{{ body_font_italic | font_face: font_display: 'swap' }}
										{{ body_font_bold_italic | font_face: font_display: 'swap' }}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture description_css_variables -%}
										--block-description-size: {{- block.settings.description_size -}}px;
										--block-description-color: {{- block.settings.description_color -}} !important;
										--block-description-font: {{- block.settings.description_font.family -}};
									  {%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Description {% if block.settings.description_alternative_font == true %}LoudzTextBox__Description--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
				{%- if buttons_block -%}
					<div class="LoudzButtonsGroup">
						{%- capture buttons_css_variables -%}
								--block-primary-button-text-color: {{- buttons_block.settings.primary_text_color -}} !important;
								--block-primary-button-background-color: {{- buttons_block.settings.primary_background_color -}} !important;
								--block-primary-button-corner-radius: {{- buttons_block.settings.primary_button_corner -}}px;
								--block-primary-button-border-color: {{- buttons_block.settings.primary_border_color -}} !important;
				
								--block-secondary-button-text-color: {{- buttons_block.settings.secondary_text_color -}} !important;
								--block-secondary-button-background-color: {{- buttons_block.settings.secondary_background_color -}} !important;
								--block-secondary-button-corner-radius: {{- buttons_block.settings.secondary_button_corner -}}px;
								--block-secondary-button-border-color: {{- buttons_block.settings.secondary_border_color -}} !important;

                --block-button-font-weight: {{- buttons_block.settings.button_font_weight -}};
							  {%- endcapture -%}
						<div
							style="{{- buttons_css_variables | strip_newlines | escape -}}"
							class="LoudzTextButtonButtons"
							{{ buttons_block.shopify_attributes }}
						>
							{%- if buttons_block.settings.primary_button_label != blank -%}
								<loudz-wave-scroll-to-top>
									<a
										{% if buttons_block.settings.primary_new_tab == true %}
											target="_blank"
										{% endif %}
										class="LoudzTextButtonButtons__Primary LoudzTextButtonButtons__Primary--{{ buttons_block.settings.primary_button_style }}"
										{%- if buttons_block.settings.primary_button_style != 'link' %}
										data-theme-button="primary"
										data-button-local-appearance="{{ buttons_block.settings.primary_button_style }}"
										{%- unless buttons_block.settings.use_theme_button %}
										style="{%- render 'button-overrides', bg: buttons_block.settings.primary_background_color, text: buttons_block.settings.primary_text_color, border: buttons_block.settings.primary_border_color, custom: true, radius: buttons_block.settings.primary_button_corner, padding_y: 16, padding_x: 20, font_size: 14, weight: buttons_block.settings.button_font_weight -%}"
										{%- endunless %}
										{%- endif %}
										{% if buttons_block.settings.primary_button_behaviour == "link" %}
											href="{{ buttons_block.settings.primary_button_link }}"
										{% else %}
											href="javascript:void(0)"
											data-scroll-to-top
										{% endif %}
										aria-label="{{ buttons_block.settings.primary_button_label | escape }}"
									>
										{{- buttons_block.settings.primary_button_label | escape -}}
									</a>
								</loudz-wave-scroll-to-top>
							{%- endif -%}
							{%- if buttons_block.settings.secondary_button_label != blank -%}
								<a
									{% if buttons_block.settings.secondary_new_tab == true %}
										target="_blank"
									{% endif %}
									class="LoudzTextButtonButtons__Secondary LoudzTextButtonButtons__Secondary--{{ buttons_block.settings.secondary_button_style }}"
										{%- if buttons_block.settings.secondary_button_style != 'link' %}
										data-theme-button="secondary"
										data-button-local-appearance="{{ buttons_block.settings.secondary_button_style }}"
										{%- unless buttons_block.settings.use_theme_button %}
										style="{%- render 'button-overrides', bg: buttons_block.settings.secondary_background_color, text: buttons_block.settings.secondary_text_color, border: buttons_block.settings.secondary_border_color, custom: true, radius: buttons_block.settings.secondary_button_corner, padding_y: 16, padding_x: 20, font_size: 14, weight: buttons_block.settings.button_font_weight -%}"
										{%- endunless %}
										{%- endif %}
									href="{{ buttons_block.settings.secondary_button_link }}"
									aria-label="{{ buttons_block.settings.secondary_button_label | escape }}"
								>
									{{- buttons_block.settings.secondary_button_label | escape -}}
								</a>
							{%- endif -%}
						</div>
					</div>
				{%- endif -%}
			</div>
		</div>
		<div class="LoudzWavesBox LoudzWavesBox--bottom">
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--back">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					<path d="{{ bottom_back_d }}" opacity="0.4">
						{% if section.settings.enable_wave_animation %}
							<animate
							attributeName="d"
							dur="12s"
							repeatCount="indefinite"
							values="{{ bottom_back_animate1 }}; {{ bottom_back_animate2 }}; {{ bottom_back_animate3 }}" />
						{% endif %}
					</path>
				</svg>
			</div>

			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--front">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					<path d="{{ bottom_front_d }}">
						{% if section.settings.enable_wave_animation %}
							<animate
							attributeName="d"
							dur="8s"
							repeatCount="indefinite"
							values="{{ bottom_front_animate1 }}; {{ bottom_front_animate2 }}; {{ bottom_front_animate3 }}" />
						{% endif %}
					</path>
				</svg>
			</div>
		</div>
	</div>
</section>



{% style %}
	/* Section padding controls apply to the whole section wrapper (full bleed bg + spacing) */
	#shopify-section-{{ section.id }} {
	  padding-top: {{ section.settings.top_padding_desktop | default: 40 }}px;
	  padding-bottom: {{ section.settings.bottom_padding_desktop | default: 40 }}px;
	}
	@media (max-width: 767px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.top_padding_mobile | default: 40 }}px;
	    padding-bottom: {{ section.settings.bottom_padding_mobile | default: 40 }}px;
	  }
	}
	#shopify-section-{{ section.id }} {
	  background-color: {{ section.settings.section_bg | default: '#FFFFFF' }};
	}
	.Loudz-{{ section.id | handle }} {
	 --section-top-margin: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
   --section-bottom-margin: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
	 --section-top-margin-mobile: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
   --section-bottom-margin-mobile: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
	 --section-wave-color: {{- section.settings.wave_color -}} !important;
	 --section-top-padding: {{- section.settings.top_padding_desktop -}}px;
   --section-bottom-padding: {{- section.settings.bottom_padding_desktop -}}px;
	 --section-top-padding-mobile: {{- section.settings.top_padding_mobile -}}px;
   --section-bottom-padding-mobile: {{- section.settings.bottom_padding_mobile -}}px;
	 --section-text-alignment: {{- section.settings.content_alignment -}};
	 --section-width: {{- section.settings.inner_width -}}%;
	 --vertical-gap-desktop: {{- section.settings.vertical_gap_desktop -}}px;
	 --vertical-gap-mobile: {{- section.settings.vertical_gap_mobile -}}px;
	}

	

.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection{margin:var(--section-top-margin-mobile) 0 var(--section-bottom-margin-mobile) 0;position:relative}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection{margin:var(--section-top-margin) 0 var(--section-bottom-margin) 0}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBoxContainer{position:relative}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox{width:100%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave{max-height:var(--loudz-space-48);width:100%;height:100%;z-index:0}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave svg{max-height:var(--loudz-space-48);width:100%;fill:var(--section-wave-color, var(--loudz-color-bg-fill-tertiary-on-light))}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave{max-height:var(--loudz-space-96)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave svg{max-height:var(--loudz-space-96)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--top{top:0;transform:rotate(180deg)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--top .LoudzWavesBox__Wave--back{position:absolute}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--bottom{transform:rotate(180deg)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--bottom .LoudzWavesBox__Wave--back{bottom:0;position:absolute}@keyframes waveParallax{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavyBannerSectionContainer{padding:var(--section-top-padding-mobile) 0 var(--section-bottom-padding-mobile) 0;display:flex;margin:0 auto;position:relative;background-color:var(--section-wave-color, var(--loudz-color-bg-fill-tertiary-on-light));justify-content:center}@media(min-width: 992px){.Loudz-{{ section.id