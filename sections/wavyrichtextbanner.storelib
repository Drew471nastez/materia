{% render 'text-controls-initial', section: section, kind: 'wavyrichtextbanner' %}
{{ 'text-section-controls.css' | asset_url | stylesheet_tag }}
{{ 'text-section-controls.js' | asset_url | script_tag }}
{% render 'wavy-title-initial', section:section, kind:'wavyrichtextbanner' %}
</template>

<schema>
{
  "type": "wavyrichtextbanner",
  "name": "Wavy Richtext Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section gap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "wave_type",
      "label": "Wave type",
      "options": [
        {
          "value": "type1",
          "label": "Gentle Waves"
        },
        {
          "value": "type2",
          "label": "Curvy Waves"
        },
        {
          "value": "type3",
          "label": "Sharp Waves"
        },
        {
          "value": "type4",
          "label": "Asymmetric Waves"
        },
        {
          "value": "type5",
          "label": "Rolling Waves"
        }
      ],
      "default": "type5"
    },
    {
      "type": "select",
      "id": "content_layout_desktop",
      "label": "Desktop layout",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical_reverse",
          "label": "Vertical reverse"
        },
        {
          "value": "horizontal_reverse",
          "label": "Horizontal reverse"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "range",
      "id": "inner_width",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Inner width (desktop)",
      "default": 80,
      "info": "Applies only to desktop"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Custom styling"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Panel background",
      "visible_if": "{{ section.settings.enable_custom_style }}",
      "info": "Fills the text panel. Unset wave colour follows this same background."
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Wave colour (optional)",
      "visible_if": "{{ section.settings.enable_custom_style }}",
      "info": "Leave blank to blend the waves into the panel."
    },
    {
      "type": "color",
      "id": "outer_background",
      "label": "Surrounding background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Wave animation"
    },
    {
      "type": "checkbox",
      "id": "enable_wave_animation",
      "label": "Animate waves",
      "default": true,
      "info": "Runs in the editor and storefront. Pauses off screen and under reduced motion."
    },
    {
      "type": "range",
      "id": "wave_duration",
      "label": "Wave duration",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 12,
      "visible_if": "{{ section.settings.enable_wave_animation }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "vertical_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "vertical_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Catchy Headline",
          "label": "Heading"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Layout"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 16,
          "max": 72,
          "step": 2,
          "unit": "px",
          "label": "Size",
          "default": 32
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Weight",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "100",
              "label": "Thin"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "theme"
        },
        {
          "type": "checkbox",
          "id": "heading_alternative_font",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "heading_font",
          "label": "Font",
          "default": "sans_serif_n4",
          "visible_if": "{{ block.settings.heading_alternative_font }}"
        },
        {
          "type": "header",
          "id": "hdr_9",
          "label": "Custom styling"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "caption",
          "default": "Supporting Subheadline",
          "label": "Caption"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Layout"
        },
        {
          "type": "range",
          "id": "caption_size",
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Size",
          "default": 16
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "select",
          "id": "caption_weight",
          "label": "Weight",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "600",
              "label": "Bold"
            }
          ],
          "default": "theme"
        },
        {
