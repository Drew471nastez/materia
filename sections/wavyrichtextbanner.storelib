	<div class="LoudzWavesBoxContainer">
		<div class="LoudzWavesBox LoudzWavesBox--top">
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--back">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					 <path d="{{ top_back_d }}" opacity="0.4">
					{% if section.settings.enable_wave_animation %}
					<animate
					  attributeName="d" calcMode="spline" keyTimes="0;0.5;1" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
					  dur="{{ section.settings.wave_duration | default: 12 }}s"
					  repeatCount="indefinite"
					  values="{{ top_back_animate1 }}; {{ top_back_animate2 }}; {{ top_back_animate3 }}" />
					{% endif %}
					 </path>
				</svg>
			</div>
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--front">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					 <path d="{{ top_front_d }}">
					{% if section.settings.enable_wave_animation %}
						<animate
						attributeName="d" calcMode="spline" keyTimes="0;0.5;1" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
						dur="{{ section.settings.wave_duration | default: 12 | times: 2 | divided_by: 3.0 }}s"
						repeatCount="indefinite"
						values="{{ top_front_animate1 }}; {{ top_front_animate2 }}; {{ top_front_animate3 }}" />
					{% endif %}
					 </path>
				</svg>
			</div>
		</div>
		<div class="LoudzWavyBannerSectionContainer">
			<div
				class="
					LoudzTextButtonContent
					LoudzTextButtonContent--contentLayout-{{ section.settings.content_layout_desktop }}
					LoudzTextButton__Content--alignment-{{ section.settings.content_alignment }}
				"
			>
				<div class="LoudzTextBox">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading_alternative_font -%}
									<style>
										{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture heading_css_variables -%}
										--block-heading-size: {{- block.settings.heading_size -}}px;
										--block-heading-color: {% if block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: block.settings.heading_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %} !important;
										--block-heading-font: {{- block.settings.heading_font.family -}};
                    --block-heading-weight: {% if block.settings.heading_weight == 'theme' or block.settings.heading_weight == blank %}var(--heading-weight, 600){% else %}{{- block.settings.heading_weight -}}{% endif %};
									  {%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Heading {% if block.settings.heading_alternative_font == true %}LoudzTextBox__Heading--alternativeFont{% endif %}"
									data-tx-block="{{ block.id }}" data-tx-type="{{ block.type }}" data-tx-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "caption" -%}
								{%- if block.settings.caption_alternative_font -%}
									<style>
										{{- block.settings.caption_font | font_face: font_display: 'swap' -}}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture caption_css_variables -%}
										--block-caption-size: {{- block.settings.caption_size -}}px;
										--block-caption-color: {% if block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: block.settings.caption_color, fallback: 'var(--color-text)' %}{% else %}{{ 'var(--color-text)' }}{% endif %} !important;
										--block-caption-font: {{- block.settings.caption_font.family -}};
										--block-caption-weight: {{- block.settings.caption_weight -}};
									  {%- endcapture -%}
								<p
									style="{{- caption_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Caption {% if block.settings.caption_alternative_font == true %}LoudzTextBox__Caption--alternativeFont{% endif %}"
									data-tx-block="{{ block.id }}" data-tx-type="{{ block.type }}" data-tx-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}
								>
									{{- block.settings.caption -}}
								</p>
							{%- when "text" -%}
								{%- if block.settings.description_alternative_font -%}
									{%- liquid
										assign body_font_bold = block.settings.description_font | font_modify: 'weight', 'bold'
										assign body_font_italic = block.settings.description_font | font_modify: 'style', 'italic'
										assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
									%}
									<style>
										{{- block.settings.description_font | font_face: font_display: 'swap' -}}
										{{ body_font_bold | font_face: font_display: 'swap' }}
										{{ body_font_italic | font_face: font_display: 'swap' }}
										{{ body_font_bold_italic | font_face: font_display: 'swap' }}
{% comment %}{% endcomment %}									</style>
								{%- endif -%}
								{%- capture description_css_variables -%}
										--block-description-size: {{- block.settings.description_size -}}px;
										--block-description-color: {% if block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: block.settings.description_color, fallback: 'var(--color-text)' %}{% else %}{{ 'var(--color-text)' }}{% endif %} !important;
										--block-description-font: {{- block.settings.description_font.family -}};
									  {%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Description {% if block.settings.description_alternative_font == true %}LoudzTextBox__Description--alternativeFont{% endif %}"
									data-tx-block="{{ block.id }}" data-tx-type="{{ block.type }}" data-tx-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
				{%- if buttons_block -%}
					<div class="LoudzButtonsGroup">
						{%- capture buttons_css_variables -%}
								--block-primary-button-text-color: {% if buttons_block.settings.primary_button_style == 'solid' %}{% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.primary_text_color, fallback: 'var(--btn-primary-color)' %}{% else %}{{ 'var(--btn-primary-color)' }}{% endif %}{% else %}{% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.primary_text_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %}{% endif %} !important;
								--block-primary-button-background-color: {% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.primary_background_color, fallback: 'var(--btn-primary-bg-color)' %}{% else %}{{ 'var(--btn-primary-bg-color)' }}{% endif %} !important;
								--block-primary-button-corner-radius: {{- buttons_block.settings.primary_button_corner -}}px;
								--block-primary-button-border-color: {% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.primary_border_color, fallback: 'var(--btn-secondary-border-color, currentColor)' %}{% else %}{{ 'var(--btn-secondary-border-color, currentColor)' }}{% endif %} !important;
				
								--block-secondary-button-text-color: {% if buttons_block.settings.secondary_button_style == 'solid' %}{% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.secondary_text_color, fallback: 'var(--btn-primary-color)' %}{% else %}{{ 'var(--btn-primary-color)' }}{% endif %}{% else %}{% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.secondary_text_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %}{% endif %} !important;
								--block-secondary-button-background-color: {% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.secondary_background_color, fallback: 'var(--btn-primary-bg-color)' %}{% else %}{{ 'var(--btn-primary-bg-color)' }}{% endif %} !important;
								--block-secondary-button-corner-radius: {{- buttons_block.settings.secondary_button_corner -}}px;
								--block-secondary-button-border-color: {% if buttons_block.settings.enable_custom_style or section.settings.enable_custom_style %}{% render 'scheme-color', color: buttons_block.settings.secondary_border_color, fallback: 'var(--btn-secondary-border-color, currentColor)' %}{% else %}{{ 'var(--btn-secondary-border-color, currentColor)' }}{% endif %} !important;

                --block-button-font-weight: {{- buttons_block.settings.button_font_weight -}};
							  {%- endcapture -%}
						<div
							style="{{- buttons_css_variables | strip_newlines | escape -}}"
							data-tx-block="{{ buttons_block.id }}" data-tx-type="buttons" data-tx-settings="{{ buttons_block.settings | json | escape }}" {{ buttons_block.shopify_attributes }} class="LoudzTextButtonButtons"
							{{ buttons_block.shopify_attributes }}
						>
							{%- if buttons_block.settings.primary_button_label != blank -%}
								<loudz-wave-scroll-to-top>
									<a
										{% if buttons_block.settings.primary_new_tab == true %}
											target="_blank" rel="noopener noreferrer"
										{% endif %}
										class="LoudzTextButtonButtons__Primary LoudzTextButtonButtons__Primary--{{ buttons_block.settings.primary_button_style }}"
										{%- if buttons_block.settings.primary_button_style != 'link' %}
										data-theme-button="primary"
										data-button-local-appearance="{{ buttons_block.settings.primary_button_style }}"
										{%- unless buttons_block.settings.use_theme_button %}
										style="{%- render 'button-overrides', bg: buttons_block.settings.primary_background_color, text: buttons_block.settings.primary_text_color, border: buttons_block.settings.primary_border_color, custom: true, radius: buttons_block.settings.primary_button_corner, padding_y: 16, padding_x: 20, font_size: 14, weight: buttons_block.settings.button_font_weight -%}"
										{%- endunless %}
										{%- endif %}
										{% if buttons_block.settings.primary_button_behaviour == "link" %}
											href="{{ buttons_block.settings.primary_button_link }}"
										{% else %}
											role="button" tabindex="0"
											data-scroll-to-top
										{% endif %}
										aria-label="{{ buttons_block.settings.primary_button_label | escape }}"
									>
										{{- buttons_block.settings.primary_button_label | escape -}}
									</a>
								</loudz-wave-scroll-to-top>
							{%- endif -%}
							{%- if buttons_block.settings.secondary_button_label != blank -%}
								<a
									{% if buttons_block.settings.secondary_new_tab == true %}
										target="_blank" rel="noopener noreferrer"
									{% endif %}
									class="LoudzTextButtonButtons__Secondary LoudzTextButtonButtons__Secondary--{{ buttons_block.settings.secondary_button_style }}"
										{%- if buttons_block.settings.secondary_button_style != 'link' %}
										data-theme-button="secondary"
										data-button-local-appearance="{{ buttons_block.settings.secondary_button_style }}"
										{%- unless buttons_block.settings.use_theme_button %}
										style="{%- render 'button-overrides', bg: buttons_block.settings.secondary_background_color, text: buttons_block.settings.secondary_text_color, border: buttons_block.settings.secondary_border_color, custom: true, radius: buttons_block.settings.secondary_button_corner, padding_y: 16, padding_x: 20, font_size: 14, weight: buttons_block.settings.button_font_weight -%}"
										{%- endunless %}
										{%- endif %}
									href="{{ buttons_block.settings.secondary_button_link }}"
									aria-label="{{ buttons_block.settings.secondary_button_label | escape }}"
								>
									{{- buttons_block.settings.secondary_button_label | escape -}}
								</a>
							{%- endif -%}
						</div>
					</div>
				{%- endif -%}
			</div>
		</div>
		<div class="LoudzWavesBox LoudzWavesBox--bottom">
			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--back">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					<path d="{{ bottom_back_d }}" opacity="0.4">
						{% if section.settings.enable_wave_animation %}
							<animate
							attributeName="d" calcMode="spline" keyTimes="0;0.5;1" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
							dur="{{ section.settings.wave_duration | default: 12 }}s"
							repeatCount="indefinite"
							values="{{ bottom_back_animate1 }}; {{ bottom_back_animate2 }}; {{ bottom_back_animate3 }}" />
						{% endif %}
					</path>
				</svg>
			</div>

			<div class="LoudzWavesBox__Wave LoudzWavesBox__Wave--front">
				<svg viewBox="0 0 1200 200" preserveAspectRatio="none">
					<path d="{{ bottom_front_d }}">
						{% if section.settings.enable_wave_animation %}
							<animate
							attributeName="d" calcMode="spline" keyTimes="0;0.5;1" keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
							dur="{{ section.settings.wave_duration | default: 12 | times: 2 | divided_by: 3.0 }}s"
							repeatCount="indefinite"
							values="{{ bottom_front_animate1 }}; {{ bottom_front_animate2 }}; {{ bottom_front_animate3 }}" />
						{% endif %}
					</path>
				</svg>
			</div>
		</div>
	</div>
</section>
{%- if section.settings.enable_wave_animation -%}
<script>
  /* Waves hold still under reduced motion and while off screen */
  (function(){
    var root = document.querySelector('.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection');
    if (!root || root.dataset.waveInit) return;
    root.dataset.waveInit = '1';
    var svgs = root.querySelectorAll('svg');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function setRun(on){ svgs.forEach(function(s){ if (s.pauseAnimations) { on ? s.unpauseAnimations() : s.pauseAnimations(); } }); }
    if (reduce) { setRun(false); return; }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(es){ es.forEach(function(e){ setRun(e.isIntersecting); }); }).observe(root);
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}



{% style %}
	/* Section padding controls apply to the whole section wrapper (full bleed bg + spacing) */
	#shopify-section-{{ section.id }} {
	  padding-top: {{ section.settings.top_padding_desktop | default: 40 }}px;
	  padding-bottom: {{ section.settings.bottom_padding_desktop | default: 40 }}px;
	}
	@media (max-width: 767px) {
	  #shopify-section-{{ section.id }} {
	    padding-top: {{ section.settings.top_padding_mobile | default: 40 }}px;
	    padding-bottom: {{ section.settings.bottom_padding_mobile | default: 40 }}px;
	  }
	}
	#shopify-section-{{ section.id }} {
	  background-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %}{% else %}{{ 'var(--color-background)' }}{% endif %};
	}
	.Loudz-{{ section.id | handle }} {
	 --section-top-margin: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
   --section-bottom-margin: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
	 --section-top-margin-mobile: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
   --section-bottom-margin-mobile: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
	 --section-wave-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.wave_color, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %}{% else %}{{ 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' }}{% endif %} !important;
	 --section-top-padding: {{- section.settings.top_padding_desktop -}}px;
   --section-bottom-padding: {{- section.settings.bottom_padding_desktop -}}px;
	 --section-top-padding-mobile: {{- section.settings.top_padding_mobile -}}px;
   --section-bottom-padding-mobile: {{- section.settings.bottom_padding_mobile -}}px;
	 --section-text-alignment: {{- section.settings.content_alignment -}};
	 --section-width: {{- section.settings.inner_width -}}%;
	 --vertical-gap-desktop: {{- section.settings.vertical_gap_desktop -}}px;
	 --vertical-gap-mobile: {{- section.settings.vertical_gap_mobile -}}px;
	}

	

.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection{margin:var(--section-top-margin-mobile) 0 var(--section-bottom-margin-mobile) 0;position:relative}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection{margin:var(--section-top-margin) 0 var(--section-bottom-margin) 0}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBoxContainer{position:relative}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox{width:100%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave{max-height:var(--loudz-space-48);width:100%;height:100%;z-index:0}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave svg{max-height:var(--loudz-space-48);width:100%;fill:var(--section-wave-color, var(--loudz-color-bg-fill-tertiary-on-light))}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave{max-height:var(--loudz-space-96)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox__Wave svg{max-height:var(--loudz-space-96)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--top{top:0;transform:rotate(180deg)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--top .LoudzWavesBox__Wave--back{position:absolute}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--bottom{transform:rotate(180deg)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavesBox--bottom .LoudzWavesBox__Wave--back{bottom:0;position:absolute}@keyframes waveParallax{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavyBannerSectionContainer{padding:var(--section-top-padding-mobile) 0 var(--section-bottom-padding-mobile) 0;display:flex;margin:0 auto;position:relative;background-color:var(--section-wave-color, var(--loudz-color-bg-fill-tertiary-on-light));justify-content:center}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzWavyBannerSectionContainer{display:flex;padding:var(--section-top-padding) 0 var(--section-bottom-padding) 0;width:100%}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent{max-width:100%;width:100%;display:flex;align-items:center;flex-direction:column;gap:var(--vertical-gap-mobile);padding:var(--loudz-space-12) var(--loudz-space-16)}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent{justify-content:var(--section-text-alignment);width:var(--section-width);gap:var(--vertical-gap-desktop)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical{flex-direction:column;gap:var(--vertical-gap-mobile)}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical{gap:var(--vertical-gap-desktop)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical .LoudzButtonsGroup{width:100%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical .LoudzTextBox{width:100%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzButtonsGroup{width:100%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzTextBox{width:100%}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzTextBox{width:50%}}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal{flex-direction:row;width:var(--section-width);gap:var(--vertical-gap-desktop);justify-content:space-between;margin:0 auto}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzTextBox{width:50%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzButtonsGroup{width:50%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal .LoudzButtonsGroup .LoudzTextButtonButtons{justify-content:flex-end}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal_reverse{flex-direction:row-reverse;width:var(--section-width);gap:var(--vertical-gap-desktop);justify-content:space-between;margin:0 auto}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal_reverse .LoudzTextBox{width:50%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal_reverse .LoudzButtonsGroup{width:50%}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-horizontal_reverse .LoudzButtonsGroup .LoudzTextButtonButtons{justify-content:flex-start}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical_reverse{flex-direction:column-reverse;gap:var(--vertical-gap-mobile)}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent--contentLayout-vertical_reverse{gap:var(--vertical-gap-desktop)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox{display:flex;flex-direction:column;gap:var(--loudz-space-8);text-align:var(--section-text-alignment)}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox{text-align:var(--section-text-alignment)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox p:empty,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox div:empty,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox h2:empty{display:none}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Heading{margin:0;font-size:calc(var(--block-heading-size)*.75);color:var(--block-heading-color);font-weight:var(--block-heading-weight)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Heading--alternativeFont{font-family:var(--block-heading-font)}@media(min-width: 992px){.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Heading{font-size:var(--block-heading-size);text-align:var(--section-text-alignment)}}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description p,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description ul,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description ol{margin:0;font-size:calc(var(--block-description-size)*.88);color:var(--block-description-color)}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h1,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h2,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h3,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h4,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h5,.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description h6{color:var(--block-description-color);margin:0;padding:0}.Loudz-{{ section.id | handle }}.LoudzWavyBannerSection .LoudzTextButtonContent .LoudzTextBox__Description a{color:var(--block-description-color);margin:0;padding:0;text-decoration:underline;text-underline-offset:var(--