e-0);padding:0;border-radius:var(--loudz-space-0);text-decoration:var(--loudz-text-decoration-underline);text-underline-offset:var(--loudz-space-4)}

{% endstyle %}
<script>
	(() => {
		class LoudzWaveScrollToTop extends HTMLElement {
			constructor() {
				super();
			}

			connectedCallback() {
				this.initScrollHandler();
			}

			initScrollHandler() {
				const scrollToButton = this.querySelector('[data-scroll-to-top]');

				if (!scrollToButton) {
					return;
				}

				scrollToButton.addEventListener('click', this.handleClick.bind(this));
			}

			handleClick(event) {
				event.preventDefault();

				window.scrollTo({
					top: 0,
					behavior: 'smooth',
				});
			}
		}

		document.addEventListener('shopify:section:load', () => {
			if (!customElements.get('loudz-wave-scroll-to-top')) {
				customElements.define('loudz-wave-scroll-to-top', LoudzWaveScrollToTop);
			}
		});

		document.addEventListener('DOMContentLoaded', () => {
			if (!customElements.get('loudz-wave-scroll-to-top')) {
				customElements.define('loudz-wave-scroll-to-top', LoudzWaveScrollToTop);
			}
		});
	})();
{% comment %}{% endcomment %}</script>



