        "label": "Mobile Top Padding",
        "default": 40
      },
      {
        "type": "range",
        "id": "bottom_padding_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Mobile Bottom Padding",
        "default": 40
      },
      {
        "type": "range",
        "id": "vertical_gap_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Mobile Vertical Gap between Button & Elements",
