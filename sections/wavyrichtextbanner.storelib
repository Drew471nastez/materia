<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>

<style>
  /* ── Theme typography (from your Typography Preset) ── */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  
  /* ── Section margin sliders ── */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* ── Section width — CSS-only, no HTML wrapper ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}

  /* ── Reset spacing ── */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} {
      margin-bottom: 0 !important;
      margin-top: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->

<!-- --VERSION-9-- -->

{% style %}
:root {
--loudz-neutral-100: #222;
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-05: #eaeaea;
--loudz-neutral-01: #fff;
--loudz-size-0: 0px;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-8: 8px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-48: 48px;
--loudz-size-96: 96px;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-line-height-140: 1.4;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-border-width-1: var(--loudz-size-1);
--loudz-color-bg-fill-default-on-light: var(--loudz-neutral-100);
--loudz-color-bg-fill-tertiary-on-light: var(--loudz-neutral-05);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-color-text-on-bg-fill-on-light: var(--loudz-neutral-01);
--loudz-space-0: var(--loudz-size-0);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-space-48: var(--loudz-size-48);
--loudz-space-96: var(--loudz-size-96);
--loudz-font-size-14: var(--loudz-size-14);
}


{% endstyle %}

<!-- --UUID-c3ee5db1-- -->

<section class="Loudz-{{ section.id | handle }} LoudzWavyBannerSection">
