        assign top_front_d = 'M0,90 C130,190 330,10 580,90 C830,190 1030,10 1180,90 L1200,0 L0,0 Z'
        assign top_front_animate1 = 'M0,90 C130,190 330,10 580,90 C830,190 1030,10 1180,90 L1200,0 L0,0 Z'
        assign top_front_animate2 = 'M0,90 C130,10 330,190 580,90 C830,10 1030,190 1180,90 L1200,0 L0,0 Z'
        assign top_front_animate3 = top_front_animate1

        assign bottom_back_d = 'M0,90 C230,90 430,140 580,90 C730,40 930,90 1180,90 L1200,200 L0,200 Z'
        assign bottom_back_animate1 = 'M0,90 C230,90 430,140 580,90 C730,40 930,90 1180,90 L1200,200 L0,200 Z'
        assign bottom_back_animate2 = 'M0,90 C230,140 430,40 580,90 C730,140 930,40 1180,90 L1200,200 L0,200 Z'
        assign bottom_back_animate3 = bottom_back_animate1

        assign bottom_front_d = 'M0,90 C130,190 330,10 580,90 C830,190 1030,10 1180,90 L1200,200 L0,200 Z'
        assign bottom_front_animate1 = 'M0,90 C130,190 330,10 580,90 C830,190 1030,10 1180,90 L1200,200 L0,200 Z'
        assign bottom_front_animate2 = 'M0,90 C130,10 330,190 580,90 C830,10 1030,190 1180,90 L1200,200 L0,200 Z'
        assign bottom_front_animate3 = bottom_front_animate1
      when 'type3'
        assign top_back_d = 'M0,130 C220,150 420,70 620,130 C820,150 1020,70 1220,130 L1200,0 L0,0 Z'
        assign top_back_animate1 = 'M0,130 C220,70 420,150 620,130 C820,70 1020,150 1220,130 L1200,0 L0,0 Z'
        assign top_back_animate2 = 'M0,130 C220,150 420,70 620,130 C820,150 1020,70 1220,130 L1200,0 L0,0 Z'
        assign top_back_animate3 = top_back_animate1

        assign top_front_d = 'M0,110 C170,210 370,30 620,110 C870,210 1070,30 1220,110 L1200,0 L0,0 Z'
        assign top_front_animate1 = 'M0,110 C170,210 370,30 620,110 C870,210 1070,30 1220,110 L1200,0 L0,0 Z'
        assign top_front_animate2 = 'M0,110 C170,30 370,210 620,110 C870,30 1070,210 1220,110 L1200,0 L0,0 Z'
        assign top_front_animate3 = top_front_animate1

        assign bottom_back_d = 'M0,110 C270,110 470,160 620,110 C770,60 970,110 1220,110 L1200,200 L0,200 Z'
        assign bottom_back_animate1 = 'M0,110 C270,110 470,160 620,110 C770,60 970,110 1220,110 L1200,200 L0,200 Z'
        assign bottom_back_animate2 = 'M0,110 C270,160 470,60 620,110 C770,160 970,60 1220,110 L1200,200 L0,200 Z'
        assign bottom_back_animate3 = bottom_back_animate1

        assign bottom_front_d = 'M0,110 C170,210 370,30 620,110 C870,210 1070,30 1220,110 L1200,200 L0,200 Z'
        assign bottom_front_animate1 = 'M0,110 C170,210 370,30 620,110 C870,210 1070,30 1220,110 L1200,200 L0,200 Z'
        assign bottom_front_animate2 = 'M0,110 C170,30 370,210 620,110 C870,30 1070,210 1220,110 L1200,200 L0,200 Z'
        assign bottom_front_animate3 = bottom_front_animate1
      when 'type4'
        assign top_back_d = 'M0,100 C160,180 360,40 560,100 C760,180 960,40 1160,100 L1200,0 L0,0 Z'
        assign top_back_animate1 = 'M0,100 C160,40 360,180 560,100 C760,40 960,180 1160,100 L1200,0 L0,0 Z'
        assign top_back_animate2 = 'M0,100 C160,180 360,40 560,100 C760,180 960,40 1160,100 L1200,0 L0,0 Z'
        assign top_back_animate3 = top_back_animate1

        assign top_front_d = 'M0,80 C120,180 320,-20 560,80 C800,180 1000,-20 1160,80 L1200,0 L0,0 Z'
        assign top_front_animate1 = 'M0,80 C120,180 320,-20 560,80 C800,180 1000,-20 1160,80 L1200,0 L0,0 Z'
        assign top_front_animate2 = 'M0,80 C120,-20 320,180 560,80 C800,-20 1000,180 1160,80 L1200,0 L0,0 Z'
        assign top_front_animate3 = top_front_animate1

        assign bottom_back_d = 'M0,80 C210,80 410,130 560,80 C710,30 910,80 1160,80 L1200,200 L0,200 Z'
        assign bottom_back_animate1 = 'M0,80 C210,80 410,130 560,80 C710,30 910,80 1160,80 L1200,200 L0,200 Z'
        assign bottom_back_animate2 = 'M0,80 C210,130 410,30 560,80 C710,130 910,30 1160,80 L1200,200 L0,200 Z'
        assign bottom_back_animate3 = bottom_back_animate1

        assign bottom_front_d = 'M0,80 C120,180 320,-20 560,80 C800,180 1000,-20 1160,80 L1200,200 L0,200 Z'
        assign bottom_front_animate1 = 'M0,80 C120,180 320,-20 560,80 C800,180 1000,-20 1160,80 L1200,200 L0,200 Z'
        assign bottom_front_animate2 = 'M0,80 C120,-20 320,180 560,80 C800,-20 1000,180 1160,80 L1200,200 L0,200 Z'
        assign bottom_front_animate3 = bottom_front_animate1
