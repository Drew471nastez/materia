        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading",
            "default": "Catchy Headline",
            "label": "Heading Text"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "heading_size",
            "min": 16,
            "max": 72,
            "step": 2,
            "unit": "px",
            "label": "Heading Font Size",
            "default": 32
          },
          {
            "type": "select",
            "id": "heading_weight",
            "label": "Heading Font Weight",
            "options": [
              {
                "value": "100",
                "label": "Thin"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "default": "600"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color",
            "default": "#000000"
          },
          {
            "type": "checkbox",
            "id": "heading_alternative_font",
            "label": "Use Alternative Font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "heading_font",
            "label": "Alternative Font",
            "default": "sans_serif_n4"
          }
        ]
      },
      {
        "type": "caption",
        "name": "Caption",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "caption",
            "default": "Supporting Subheadline",
            "label": "Caption Text"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "caption_size",
            "min": 10,
            "max": 30,
            "step": 1,
            "unit": "px",
            "label": "Caption Font Size",
            "default": 16
          },
          {
            "type": "select",
            "id": "caption_weight",
            "label": "Caption Font Weight",
            "options": [
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "600",
                "label": "Bold"
              }
            ],
            "default": "400"
          },
          {
            "type": "color",
            "id": "caption_color",
            "label": "Caption Color",
            "default": "#000000"
          },
          {
            "type": "checkbox",
            "id": "caption_alternative_font",
            "label": "Use Alternative Font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "caption_font",
            "label": "Alternative Font",
            "default": "sans_serif_n4"
          }
        ]
      },
      {
        "type": "text",
        "name": "Description",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "description",
            "default": "<p>Engage your audience with compelling content about your offer.</p>",
            "label": "Description Text"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "description_size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Description Font Size",
            "default": 16
          },
          {
            "type": "color",
            "id": "description_color",
            "label": "Description Color",
            "default": "#000000"
          },
          {
            "type": "checkbox",
            "id": "description_alternative_font",
            "label": "Use Alternative Font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "description_font",
            "label": "Alternative Font",
            "default": "sans_serif_n4"
          }
        ]
      },
      {
        "type": "buttons",
        "name": "Buttons",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "select",
            "id": "primary_button_behaviour",
            "label": "Primary Button Action",
            "options": [
              {
                "value": "link",
                "label": "Link"
              },
              {
                "value": "scroll_to_top",
                "label": "Scroll to top"
              }
            ],
            "default": "link"
          },
          {
            "type": "text",
            "id": "primary_button_label",
            "default": "Shop Now",
            "label": "Primary Button Text"
          },
          {
            "type": "url",
            "id": "primary_button_link",
            "label": "Primary Button URL",
            "visible_if": "{{ block.settings.primary_button_behaviour == 'link' }}"
          },
          {
            "type": "checkbox",
            "id": "primary_new_tab",
            "label": "Open Primary Link in New Tab",
            "default": false,
            "visible_if": "{{ block.settings.primary_button_behaviour == 'link' }}"
          },
          {
            "type": "text",
            "id": "secondary_button_label",
            "label": "Secondary Button Text"
          },
          {
            "type": "url",
            "id": "secondary_button_link",
            "label": "Secondary Button URL"
          },
          {
            "type": "checkbox",
            "id": "secondary_new_tab",
            "label": "Open Secondary Link in New Tab",
            "default": false
          },
          {
            "type": "header",
            "content": "Buttons"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button style",
            "info": "Solid and outline buttons follow Theme settings > Buttons. Turn off to set their colours and corners here.",
            "default": true
          },
          {
            "type": "select",
            "id": "primary_button_style",
            "label": "Primary Button Style",
            "options": [
              {
                "value": "solid",
                "label": "Filled"
              },
              {
                "value": "outline",
                "label": "Outline"
              },
              {
                "value": "link",
                "label": "Link"
              }
            ],
            "default": "solid"
          },
          {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary Text Color",
            "default": "#FFFFFF",
            "visible_if": "{{ block.settings.use_theme_button == false or block.settings.primary_button_style == 'link' }}"
          },
          {
            "type": "color",
            "id": "primary_background_color",
            "label": "Primary Background Color",
            "default": "#222222",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}"
          },
          {
            "type": "color",
            "id": "primary_border_color",
            "label": "Primary Border Color",
            "default": "#222222",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}"
          },
          {
            "type": "range",
            "id": "primary_button_corner",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Primary Corner Radius",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.primary_button_style != 'link' }}",
            "default": 8
          },
          {
            "type": "select",
            "id": "secondary_button_style",
            "label": "Secondary Button Style",
            "options": [
              {
                "value": "solid",
                "label": "Filled"
              },
              {
                "value": "outline",
                "label": "Outline"
              },
              {
                "value": "link",
                "label": "Link"
              }
            ],
            "default": "solid"
          },
          {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary Text Color",
            "default": "#FFFFFF",
            "visible_if": "{{ block.settings.use_theme_button == false or block.settings.secondary_button_style == 'link' }}"
          },
          {
            "type": "color",
            "id": "secondary_background_color",
            "label": "Secondary Background Color",
            "default": "#222222",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}"
          },
          {
            "type": "color",
            "id": "secondary_border_color",
            "label": "Secondary Border Color",
            "default": "#222222",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}"
          },
          {
            "type": "range",
            "id": "secondary_button_corner",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Secondary Corner Radius",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.secondary_button_style != 'link' }}",
            "default": 8
          },
          {
            "type": "select",
            "id": "button_font_weight",
            "label": "Button Font Weight",
            "options": [
              {
                "value": "100",
                "label": "Thin"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "default": "400",
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Wavy Richtext Banner",
        "category": "Text",
        "blocks": [
          {
            "type": "caption"
          },
          {
            "type": "heading"
          },
          {
            "type": "text"
          },
          {
            "type": "buttons"
