<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Connect to the theme's global Animations & motion settings (Theme settings > Animations). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Content Tabs: a heading, a row of highlights, a swipeable
  row of image cards with arrows, buttons and a footer line, all blocks.
  Colours follow the colour scheme and fonts follow Theme settings >
  Typography until custom styling or custom fonts are switched on. Every
  value is a CSS variable printed here; assets/live-features-c.js works out
  the same variables for live edits and runs the carousel (arrows, drag,
  arrow keys) for each copy of the section.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts

  comment
    Speed: honour the theme's global performance settings (Theme settings > Speed).
  endcomment
  assign ct_img_max = 900
  assign sp_lazy = settings.perf_images
  # The first picture loads first only when the section opens the page;
  # lower down it would hold back the hero picture.
  assign sp_preload = false
  if settings.perf_images and section.index != blank and section.index <= 2
    assign sp_preload = true
  endif
  assign sp_decode = settings.perf_images

  assign tab_count = 0
  assign highlight_count = 0
  assign heading_found = false
  for block in section.blocks
    case block.type
      when 'tab'
        assign tab_count = tab_count | plus: 1
      when 'highlight'
        assign highlight_count = highlight_count | plus: 1
      when 'heading'
        unless heading_found
          assign heading_block = block
          assign heading_found = true
        endunless
    endcase
  endfor

  assign ta_d = 'center'
  assign ta_m = 'center'
  if heading_found
    assign ta_d = heading_block.settings.text_align | default: 'center'
    assign ta_m = heading_block.settings.text_align_mobile | default: 'center'
  endif
  case ta_d
    when 'left'
      assign jc_d = 'flex-start'
    when 'right'
      assign jc_d = 'flex-end'
    else
      assign jc_d = 'center'
  endcase
  case ta_m
    when 'left'
      assign ai_m = 'flex-start'
    when 'right'
      assign ai_m = 'flex-end'
    else
      assign ai_m = 'center'
  endcase
-%}

{%- if st.reset_spacing -%}
<style>
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if fonts -%}{% style %}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% endstyle %}{%- endif -%}
{%- if heading_found and heading_block.settings.heading_custom_font_enable and heading_block.settings.heading_font != blank -%}
  {% style %}{{ heading_block.settings.heading_font | font_face: font_display: 'swap' }}{% endstyle %}
{%- endif -%}

<style>
  /* ---- Isolation: nothing in here touches the rest of the page ---- */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *::before,
  #shopify-section-{{ sid }} *::after {
    box-sizing: border-box;
  }

  /* ---- Outer spacing ---- */
  #shopify-section-{{ sid }} .ctabs {
    background: var(--ct-bg);
    padding-top: var(--ct-pt-m);
    padding-bottom: var(--ct-pb-m);
    margin-top: var(--ct-mt-m);
    margin-bottom: var(--ct-mb-m);
    font-family: var(--ct-bf);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs {
      padding-top: var(--ct-pt-d);
      padding-bottom: var(--ct-pb-d);
      margin-top: var(--ct-mt-d);
      margin-bottom: var(--ct-mb-d);
    }
  }

  /* ---- Inner container width ---- */
  #shopify-section-{{ sid }} .ctabs__inner { padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .ctabs[data-width='container'] .ctabs__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .ctabs[data-width='fluid'] .ctabs__inner { max-width: 1600px; margin-inline: auto; }

  /* ---- Heading + highlights ---- */
  #shopify-section-{{ sid }} .ctabs__head {
    text-align: var(--ct-ta-m);
    margin-bottom: var(--ct-g1);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs__head { text-align: var(--ct-ta-d); }
  }
  #shopify-section-{{ sid }} .ctabs__heading {
    font-family: var(--ct-h-font, var(--ct-hf));
    font-weight: var(--ct-h-weight, var(--heading-weight, 600));
    color: var(--ct-h-color);
    margin: 0;
    line-height: 1.15;
    font-size: var(--ct-h-size-m);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs__heading { font-size: var(--ct-h-size-d); }
  }

  /* Mobile: highlights stack one under the other. Desktop: single row. */
  #shopify-section-{{ sid }} .ctabs__highlights {
    display: flex;
    flex-direction: column;
    align-items: var(--ct-ai-m);
    gap: 12px;
    margin-bottom: var(--ct-g2);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs__highlights {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: var(--ct-jc-d);
      gap: 10px var(--ct-hl-gap);
    }
  }
  #shopify-section-{{ sid }} .ctabs__highlight {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--ct-bf);
    color: var(--ct-hl-color);
    font-size: var(--ct-hl-size);
    line-height: 1.3;
  }
  #shopify-section-{{ sid }} .ctabs__icon { display: inline-flex; flex: 0 0 auto; }
  #shopify-section-{{ sid }} .ctabs__highlight svg {
    width: calc(var(--ct-hl-size) + 6px);
    height: calc(var(--ct-hl-size) + 6px);
    flex: 0 0 auto;
    stroke: currentColor;
  }

  /* ---- Carousel track (native scroll-snap, contained) ---- */
  #shopify-section-{{ sid }} .ctabs__track {
    --ctabs-per: var(--ct-per-m);
    --ctabs-gap: var(--ct-gap);
    display: flex;
    gap: var(--ctabs-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 6px;
    cursor: grab;
    border-radius: var(--ct-radius);
  }
  #shopify-section-{{ sid }} .ctabs__track:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  #shopify-section-{{ sid }} .ctabs__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }
  #shopify-section-{{ sid }} .ctabs__track.is-dragging a { pointer-events: none; }
  #shopify-section-{{ sid }} .ctabs__media img {
    -webkit-user-drag: none;
    user-select: none;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs__track {
      --ctabs-per: var(--ct-per-d);
      --ctabs-gap: calc(var(--ct-gap) + 8px);
    }
  }
  /* Tablet: the desktop count squeezes titles into broken words ("Electrolyt es")
     and clips the text, so show at most two and a half cards until 1024px. */
  @media (min-width: 768px) and (max-width: 1023px) {
    #shopify-section-{{ sid }} .ctabs__track {
      --ctabs-per: min({{ st.cards_desktop | default: '3.5' }}, 2.5);
    }
  }
  #shopify-section-{{ sid }} .ctabs__track::-webkit-scrollbar { display: none; }

  #shopify-section-{{ sid }} .ctabs__card {
    flex: 0 0 calc((100% - (var(--ctabs-per) - 1) * var(--ctabs-gap)) / var(--ctabs-per));
    scroll-snap-align: start;
    position: relative;
    display: block;
    height: var(--ct-h-m);
    border-radius: var(--ct-radius);
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-heading) 82%, var(--color-background));
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctabs__card { height: var(--ct-h-d); }
  }
  #shopify-section-{{ sid }} a.ctabs__card[href] { cursor: pointer; }
  #shopify-section-{{ sid }} a.ctabs__card[href]:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }

  #shopify-section-{{ sid }} .ctabs__media { position: absolute; inset: 0; z-index: 0; }
  #shopify-section-{{ sid }} .ctabs__media img,
  #shopify-section-{{ sid }} .ctabs__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(var(--ctabs-bri, 100%));
  }
  #shopify-section-{{ sid }} .ctabs__media svg { fill: color-mix(in srgb, var(--color-background) 22%, transparent); }
  #shopify-section-{{ sid }} .ctabs__media [hidden] { display: none; }
  #shopify-section-{{ sid }} .ctabs__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--ctabs-ovl);
    opacity: calc(var(--ctabs-ovl-op, 45) / 100);
  }
  #shopify-section-{{ sid }} .ctabs__grad {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(0,0,0,.28) 0%, rgba(0,0,0,0) 38%, rgba(0,0,0,0) 60%, rgba(0,0,0,.30) 100%);
  }
  #shopify-section-{{ sid }} .ctabs__body {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--ct-pad);
    color: var(--ctabs-text);
  }
  #shopify-section-{{ sid }} .ctabs__title {
    font-family: var(--ct-hf);
    color: var(--ctabs-title);
    margin: 0 0 10px;
    line-height: 1.15;
    font-size: var(--ct-title-size);
    font-weight: var(--heading-weight, 500);
  }
  #shopify-section-{{ sid }} .ctabs__desc {
    font-family: var(--ct-bf);
    color: var(--ctabs-text);
    margin: 0;
    flex: 1 1 auto;
    line-height: 1.5;
    font-size: var(--ct-text-size);
    opacity: .94;
  }
  #shopify-section-{{ sid }} .ctabs__badges {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  #shopify-section-{{ sid }} .ctabs__badges:not(:has(.ctabs__badge:not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .ctabs__badge {
    display: inline-flex;
    align-items: center;
    background: var(--ctabs-badge-bg);
    color: var(--ctabs-badge-c);
    padding: 5px 12px;
    border-radius: 999px;
    font-family: var(--ct-bf);
    font-size: 12px;
    font-weight: var(--badges-font-weight, 600);
    letter-spacing: .04em;
    text-transform: uppercase;
    line-height: 1;
  }
  #shopify-section-{{ sid }} :is(.ctabs__badge, .ctabs__title, .ctabs__desc, .ctabs__head, .ctabs__footer, .ctabs__btn)[hidden] { display: none; }

  /* ---- Arrows ---- */
  #shopify-section-{{ sid }} .ctabs__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: var(--ct-g3);
  }
  #shopify-section-{{ sid }} .ctabs__nav[hidden] { display: none; }
  #shopify-section-{{ sid }} .ctabs__arrow {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--ct-arrow-line);
    background: transparent;
    color: var(--ct-arrow-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: opacity .2s ease, transform .15s ease, background .2s ease;
  }
  #shopify-section-{{ sid }} .ctabs__arrow:hover { transform: translateY(-1px); }
  #shopify-section-{{ sid }} .ctabs__arrow:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  #shopify-section-{{ sid }} .ctabs__arrow svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }
  #shopify-section-{{ sid }} .ctabs__arrow[disabled] { opacity: .35; cursor: default; transform: none; }

  /* ---- Button(s) ---- */
  #shopify-section-{{ sid }} .ctabs__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: var(--ct-g4);
  }
  #shopify-section-{{ sid }} .ctabs__buttons:not(:has(.ctabs__btn:not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .ctabs__btn { text-align: center; text-decoration: none !important; }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .ctabs__btn[data-full='true'] { width: 100%; }
  }

  /* ---- Footer line ---- */
  #shopify-section-{{ sid }} .ctabs__footer {
    text-align: center;
    max-width: 760px;
    margin: var(--ct-g5) auto 0;
    font-family: var(--ct-bf);
    color: var(--ct-f-color);
    font-size: var(--ct-f-size);
    line-height: 1.6;
    opacity: .85;
  }
  #shopify-section-{{ sid }} .ctabs__footer p { font-size: inherit; color: inherit; font-family: inherit; }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ctabs__track { scroll-behavior: auto; }
    #shopify-section-{{ sid }} .ctabs__arrow { transition: none; }
  }
{% comment %}{% endcomment %}</style>

{%- capture root_vars -%}
  --ct-bg: {% if custom %}{% render 'scheme-color', color: st.background, fallback: 'var(--gradient-background, var(--color-background))' %}{% else %}var(--gradient-background, var(--color-background)){% endif %};
  --ct-hl-color: {% if custom %}{% render 'scheme-color', color: st.highlights_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --ct-arrow-ink: {% if custom %}{% render 'scheme-color', color: st.arrow_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --ct-arrow-line: {% if custom %}{% render 'scheme-color', color: st.arrow_border_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
  --ct-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
  --ct-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
  --ct-hl-size: {{ st.highlights_size | default: 16 }}px; --ct-hl-gap: {{ st.highlights_gap | default: 32 }}px;
  --ct-per-d: {{ st.cards_desktop | default: '3.5' }}; --ct-per-m: {{ st.cards_mobile | default: '1.5' }};
  --ct-gap: {{ st.card_gap | default: 0 }}px; --ct-h-d: {{ st.card_height_desktop | default: 230 }}px; --ct-h-m: {{ st.card_height_mobile | default: 260 }}px;
  --ct-radius: {{ st.card_radius | default: 0 }}px; --ct-pad: {{ st.card_padding | default: 22 }}px;
  --ct-title-size: {{ st.card_title_size | default: 24 }}px; --ct-text-size: {{ st.card_text_size | default: 15 }}px;
  --ct-g1: {{ st.gap_heading_to_highlights | default: 0 }}px; --ct-g2: {{ st.gap_highlights_to_cards | default: 0 }}px; --ct-g3: {{ st.gap_cards_to_arrows | default: 0 }}px; --ct-g4: {{ st.gap_arrows_to_button | default: 0 }}px; --ct-g5: {{ st.gap_button_to_footer | default: 0 }}px;
  --ct-pt-d: {{ st.padding_top_desktop | default: 0 }}px; --ct-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px; --ct-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ct-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
  --ct-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px; --ct-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px; --ct-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px; --ct-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  --ct-ta-d: {{ ta_d }}; --ct-ta-m: {{ ta_m }}; --ct-jc-d: {{ jc_d }}; --ct-ai-m: {{ ai_m }};
{%- endcapture -%}

<div class="ctabs color-{{ color_scheme }} gradient" data-fc-root="content-tabs" data-fc-section="{{ sid }}" data-fc-settings="{{ st | json | escape }}" data-width="{{ st.section_width | default: 'container' }}"{% if fonts %} data-own-font{% endif %} style="{{ root_vars | strip_newlines }}">
  <div class="ctabs__inner">

    {%- if heading_found -%}
      {%- assign hb = heading_block.settings -%}
      {%- assign h_font = hb.heading_custom_font_enable -%}
      <div class="ctabs__head" data-fc-block="{{ heading_block.id }}" data-fc-type="heading" data-fc-settings="{{ hb | json | escape }}" {{ heading_block.shopify_attributes }}{% if hb.heading == blank %} hidden{% endif %} style="--ct-h-color: {% if hb.enable_custom_style %}{% render 'scheme-color', color: hb.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --ct-h-size-d: {{ hb.heading_size_desktop | default: 44 }}px; --ct-h-size-m: {{ hb.heading_size_mobile | default: 30 }}px;{% if h_font and hb.heading_font.family != blank %} --ct-h-font: {{ hb.heading_font.family }}, {{ hb.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if h_font and hb.heading_font_weight != blank and hb.heading_font_weight != 'inherit' %} --ct-h-weight: {{ hb.heading_font_weight }};{% endif %}">
        <h2 class="ctabs__heading"{% if h_font %} data-own-font{% endif %}{% if h_font and hb.heading_font_weight != blank and hb.heading_font_weight != 'inherit' %} data-own-weight{% endif %}>{{ hb.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if highlight_count > 0 -%}
      <div class="ctabs__highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'highlight' -%}
            <span class="ctabs__highlight" data-fc-block="{{ block.id }}" data-fc-type="highlight" data-fc-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>
              <span class="ctabs__icon" data-fc-icon="{{ block.settings.icon }}">{% render 'features-c-tabs-icon', icon: block.settings.icon %}</span>
              <span data-fc-text>{{ block.settings.text | escape }}</span>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if tab_count > 0 -%}
      {%- capture placeholder -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endcapture -%}
      <div class="ctabs__track" data-ctabs-track tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ heading_block.settings.heading | strip_html | default: 'Cards' | escape }}">
        {%- assign tab_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            {%- assign tb = block.settings -%}
            {%- assign tab_i = tab_i | plus: 1 -%}
            {%- liquid
              assign ct_loading = 'lazy'
              if tab_i == 1 and sp_preload
                assign ct_loading = 'eager'
              elsif tab_i > 1 and sp_lazy == false
                assign ct_loading = 'eager'
              endif
              assign demo_src = ''
              if tb.image == blank
                capture demo_src
                  render 'demo-image', key: block.id
                endcapture
                assign demo_src = demo_src | strip
              endif
            -%}
            <a class="ctabs__card"{% if tb.link != blank %} href="{{ tb.link }}"{% endif %} role="group" aria-roledescription="slide" aria-label="{{ tab_i }} / {{ tab_count }}" data-fc-block="{{ block.id }}" data-fc-type="tab" data-fc-settings="{{ tb | json | escape }}" {{ block.shopify_attributes }} style="--ctabs-ovl: {% if tb.enable_custom_style %}{% render 'scheme-color', color: tb.overlay_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --ctabs-ovl-op: {{ tb.overlay_opacity | default: 0 }}; --ctabs-bri: {{ tb.image_brightness | default: 100 }}%; --ctabs-title: {% if tb.enable_custom_style %}{% render 'scheme-color', color: tb.title_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --ctabs-text: {% if tb.enable_custom_style %}{% render 'scheme-color', color: tb.text_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --ctabs-badge-bg: {% if tb.enable_custom_style %}{% render 'scheme-color', color: tb.badge_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --ctabs-badge-c: {% if tb.enable_custom_style %}{% render 'scheme-color', color: tb.badge_text_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};">
              <div class="ctabs__media">
                {%- if tb.image != blank -%}
                  <img
                    src="{{ tb.image | image_url: width: ct_img_max }}"
                    srcset="{{ tb.image | image_url: width: 400 }} 400w,
                            {{ tb.image | image_url: width: 600 }} 600w,
                            {{ tb.image | image_url: width: 800 }} 800w,
                            {{ tb.image | image_url: width: ct_img_max }} {{ ct_img_max }}w"
                    sizes="(max-width: 767px) 70vw, 28vw"
                    width="{{ tb.image.width }}"
                    height="{{ tb.image.height }}"
                    alt="{{ tb.image.alt | default: tb.title | escape }}"
                    loading="{{ ct_loading }}"
                    {% if tab_i == 1 and sp_preload %}fetchpriority="high"{% endif %}
                    {% if sp_decode %}decoding="async"{% endif %}>
                {%- elsif demo_src != blank -%}
                  <img src="{{ demo_src }}" sizes="(max-width: 767px) 70vw, 28vw" alt="{{ tb.title | escape }}" loading="{{ ct_loading }}">
                {%- endif -%}
                {%- if tb.image != blank or demo_src != blank -%}{{ placeholder | replace: '<svg ', '<svg hidden aria-hidden="true" ' }}{%- else -%}{{ placeholder | replace: '<svg ', '<svg aria-hidden="true" ' }}{%- endif -%}
              </div>
              <span class="ctabs__tint" aria-hidden="true"></span>
              <span class="ctabs__grad" aria-hidden="true"></span>
              <div class="ctabs__body">
                <h3 class="ctabs__title"{% if tb.title == blank %} hidden{% endif %}>{{ tb.title | escape }}</h3>
                <p class="ctabs__desc"{% if tb.description == blank %} hidden{% endif %}>{{ tb.description | escape }}</p>
                <div class="ctabs__badges">
                  <span class="ctabs__badge" data-fc-badge="1"{% if tb.badge_1 == blank %} hidden{% endif %}>{{ tb.badge_1 | escape }}</span>
                  <span class="ctabs__badge" data-fc-badge="2"{% if tb.badge_2 == blank %} hidden{% endif %}>{{ tb.badge_2 | escape }}</span>
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ctabs__nav"{% unless st.show_arrows %} hidden{% endunless %}>
        <button type="button" class="ctabs__arrow" data-ctabs-prev aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="ctabs__arrow" data-ctabs-next aria-label="{{ 'accessibility.next' | t | default: 'Next' }}">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
    {%- endif -%}

    <div class="ctabs__buttons">
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}
          {%- assign cb = block.settings -%}
          {%- capture btn_attrs -%}class="ctabs__btn btn {% if cb.style == 'outline' %}btn-outline{% else %}btn-primary{% endif %}" data-theme-button="{% if cb.style == 'outline' %}secondary{% else %}primary{% endif %}" data-sl-button data-full="{% if cb.full_width %}true{% else %}false{% endif %}" data-fc-block="{{ block.id }}" data-fc-type="button" data-fc-settings="{{ cb | json | escape }}" {{ block.shopify_attributes }}{% if cb.label == blank %} hidden{% endif %} style="{% if cb.custom_colors %}{% render 'button-overrides', bg: cb.bg, text: cb.text_color, hover_bg: cb.bg_hover, hover_text: cb.text_color %}{% endif %}"{%- endcapture -%}
          {%- if cb.link != blank -%}
            <a href="{{ cb.link }}" {{ btn_attrs }}>{{ cb.label | escape }}</a>
          {%- else -%}
            <button type="button" {{ btn_attrs }}>{{ cb.label | escape }}</button>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'footer' -%}
        {%- assign fb = block.settings -%}
        <div class="ctabs__footer" data-fc-block="{{ block.id }}" data-fc-type="footer" data-fc-settings="{{ fb | json | escape }}" {{ block.shopify_attributes }}{% if fb.footer_text == blank %} hidden{% endif %} style="--ct-f-color: {% if fb.enable_custom_style %}{% render 'scheme-color', color: fb.footer_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}; --ct-f-size: {{ fb.footer_size | default: 15 }}px;">{{ fb.footer_text }}</div>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

  </div>
  {%- if request.design_mode -%}<template data-fc-icons>{%- assign fc_icons = 'seal,flask,no_symbol,leaf,shield,star,heart,lock,check,spark' | split: ',' -%}{%- for name in fc_icons -%}<span data-icon="{{ name }}">{% render 'features-c-tabs-icon', icon: name %}</span>{%- endfor -%}</template>{%- endif -%}
</div>

{%- comment -%}
  The carousel runs in assets/live-features-c.js, which the layout loads on
  every page. This copy only starts when that file is missing.
{%- endcomment -%}
<script>
  (function () {
  function init() {
    if (window.MateriaFeaturesC) return;
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;
    var track = root.querySelector('[data-ctabs-track]');
    if (!track || track.dataset.ctabsInit) return;
    track.dataset.ctabsInit = '1';
    var prev = root.querySelector('[data-ctabs-prev]');
    var next = root.querySelector('[data-ctabs-next]');
    function step() {
      var card = track.querySelector('.ctabs__card');
      if (!card) return track.clientWidth;
      var styles = getComputedStyle(track);
      return card.getBoundingClientRect().width + (parseFloat(styles.columnGap || styles.gap) || 0);
    }
    function update() {
      if (!prev || !next) return;
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    // The arrows are set once the browser has laid the track out.
    if ('ResizeObserver' in window) new ResizeObserver(function () { if (track.isConnected) update(); }).observe(track);
    else window.requestAnimationFrame(update);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else init();
  })();
{% comment %}{% endcomment %}</script>
</template>

