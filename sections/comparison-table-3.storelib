<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Comparison Table 3.

  Heading, subheading and an optional rating on one side; on the other a
  two-column table: your column (block "Column A", filled, with an optional
  floating product picture) against "Column B", one row block per feature
  with a check, cross, thumb, text, picture or SVG on each side. The table
  scrolls sideways inside its own frame when it does not fit (row labels
  stay in view). Colours follow the colour scheme until Enable custom
  styling is on. Live edits: assets/live-features-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign rows = section.blocks | where: 'type', 'row'
  assign cola = nil
  assign colb = nil
  for b in section.blocks
    if b.type == 'col_a' and cola == nil
      assign cola = b
    endif
    if b.type == 'col_b' and colb == nil
      assign colb = b
    endif
  endfor
  assign title_done = false
  assign spx = 'section_max_width_desktop,left_col_fr:fr,right_col_fr:fr,layout_gap_desktop,layout_gap_mobile,content_gap,col_a_width:n,col_b_width:n,col_gap,col_gap_mobile,col_header_pad,col_title_size_desktop,col_title_size_mobile,label_weight:n,label_pad_x,cell_pad_y,cell_size,icon_size,padding_top_desktop,padding_bottom_desktop,section_margin_top_desktop,section_margin_bottom_desktop,padding_top_mobile,padding_bottom_mobile,section_margin_top_mobile,section_margin_bottom_mobile'
  assign sc = 'section_bg,label_color,col_a_text,col_b_text,divider_a_color,divider_b_color,check_bg,check_color,cross_bg,cross_color,thumb_color'
  assign sw = 'col_title_weight'
  assign sf = 'enable_custom_fonts:heading_font,enable_custom_fonts:body_font'
  assign sa = 'section_width,show_section_on,content_align,reset_spacing'
  assign sa_list = sa | split: ','
  assign stx = 'check_label,cross_label'
  assign h_px = 'size_desktop,size_mobile,line_height:n,tracking,space_above,space_below'
  assign s_px = 'size,line_height:n,max_width,space_above,space_below'
  assign r_px = 'stars_total:n,stars_value:n,star_size,size,space_above,space_below'
  assign a_px = 'radius,image_size_desktop,image_size_mobile,image_rotate_desktop:deg,image_rotate_mobile:deg,image_offset_desktop,image_offset_mobile'
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>{%- endcapture -%}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .fbt3 { --hf: var(--fb-heading_font, var(--heading-font)); --bf: var(--fb-body_font, var(--body-font)); background: var(--fb-section_bg, var(--color-background)); color: var(--color-text); font-family: var(--bf); padding: var(--fb-padding_top_mobile) 0 var(--fb-padding_bottom_mobile); margin: var(--fb-section_margin_top_mobile) 0 var(--fb-section_margin_bottom_mobile); }
  #shopify-section-{{ sid }} .fbt3[data-reset_spacing='true'] { margin-block: 0; }
  #shopify-section-{{ sid }} .fbt3 *, #shopify-section-{{ sid }} .fbt3 *::before, #shopify-section-{{ sid }} .fbt3 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .fbt3__inner { margin-inline: auto; padding-inline: 16px; }
  #shopify-section-{{ sid }} .fbt3[data-section_width='container'] .fbt3__inner { max-width: calc(var(--fb-section_max_width_desktop) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .fbt3[data-section_width='fluid_container'] .fbt3__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .fbt3[data-section_width='full_width'] .fbt3__inner { padding-inline: 0; }
  #shopify-section-{{ sid }} .fbt3[data-show_section_on='desktop'] { display: none; }
  #shopify-section-{{ sid }} .fbt3__layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--fb-layout_gap_mobile); align-items: center; }
  #shopify-section-{{ sid }} .fbt3__content { display: flex; flex-direction: column; gap: var(--fb-content_gap); align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .fbt3__heading { margin: var(--fb-space_above) 0 var(--fb-space_below); color: var(--fb-color, var(--color-heading)); font-family: var(--hf); font-weight: var(--fb-weight, var(--heading-weight, 700)); font-size: var(--fb-size_mobile); line-height: var(--fb-line_height); letter-spacing: var(--fb-tracking); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt3__sub { margin: var(--fb-space_above) 0 var(--fb-space_below); color: var(--fb-color, var(--color-text)); font-size: var(--fb-size); line-height: var(--fb-line_height); max-width: var(--fb-max_width); }
  #shopify-section-{{ sid }} .fbt3__sub :is(p, li) { margin: 0; line-height: inherit; }
  #shopify-section-{{ sid }} .fbt3__sub p + p { margin-top: .5em; }
  #shopify-section-{{ sid }} .fbt3__rating { margin: var(--fb-space_above) 0 var(--fb-space_below); display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--fb-color, var(--color-text)); font-size: var(--fb-size); }
  #shopify-section-{{ sid }} .fbt3__stars { position: relative; display: inline-flex; font-size: var(--fb-star_size); line-height: 1; }
  #shopify-section-{{ sid }} .fbt3__stars > span { display: inline-flex; gap: 2px; }
  #shopify-section-{{ sid }} .fbt3__stars svg { width: 1em; height: 1em; display: block; flex: none; }
  #shopify-section-{{ sid }} .fbt3__stars-bg { fill: var(--fb-star_unfilled_color, var(--color-border)); }
  #shopify-section-{{ sid }} .fbt3__stars-fg { position: absolute; inset: 0 auto 0 0; overflow: hidden; width: calc(var(--fb-stars_value) / var(--fb-stars_total) * 100%); fill: var(--fb-star_filled_color, var(--color-heading)); }
  {%- for n in (1..4) %}
  #shopify-section-{{ sid }} .fbt3__rating[data-stars_total='{{ n }}'] .fbt3__stars svg:nth-child(n+{{ n | plus: 1 }}) { display: none; }
  {%- endfor %}
  #shopify-section-{{ sid }} .fbt3__scroll { position: relative; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; scrollbar-width: thin; padding-top: max(0px, var(--off-m, 0px)); }
  #shopify-section-{{ sid }} .fbt3__scroll[data-overflow] { cursor: grab; }
  #shopify-section-{{ sid }} .fbt3__scroll[data-dragging] { cursor: grabbing; user-select: none; }
  #shopify-section-{{ sid }} .fbt3__scroll:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  #shopify-section-{{ sid }} :where(.fbt3__table, .fbt3__table th, .fbt3__table td) { border: 0; font-weight: inherit; padding: 0; }
  #shopify-section-{{ sid }} .fbt3__table { --tot: calc(1.4 + var(--fb-col_a_width) + var(--fb-col_b_width)); width: 100%; min-width: 300px; table-layout: fixed; border-collapse: separate; border-spacing: var(--fb-col_gap_mobile) 0; }
  #shopify-section-{{ sid }} .fbt3__table col.fbt3__ca { width: calc(var(--fb-col_a_width) / var(--tot) * 100%); }
  #shopify-section-{{ sid }} .fbt3__table col.fbt3__cb { width: calc(var(--fb-col_b_width) / var(--tot) * 100%); }
  #shopify-section-{{ sid }} .fbt3__colhead { padding: var(--fb-col_header_pad) 8px calc(var(--fb-col_header_pad) * .6); text-align: center; vertical-align: bottom; font-family: var(--hf); font-weight: var(--fb-col_title_weight, var(--heading-weight, 700)); font-size: var(--fb-col_title_size_mobile); line-height: 1.15; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt3__colhead--a { color: var(--fb-text_color, var(--fb-col_a_text, var(--btn-primary-color))); }
  #shopify-section-{{ sid }} .fbt3__colhead--b { color: var(--fb-text_color, var(--fb-col_b_text, var(--color-text))); }
  #shopify-section-{{ sid }} .fbt3__a { --fbt3-r: var(--fb-radius); background: var(--fb-bg, var(--btn-primary-bg-color)); color: var(--fb-text_color, var(--fb-col_a_text, var(--btn-primary-color))); }
  #shopify-section-{{ sid }} .fbt3__b { --fb-text_color: initial; }
  #shopify-section-{{ sid }} thead .fbt3__a { border-radius: var(--fbt3-r) var(--fbt3-r) 0 0; position: relative; }
  #shopify-section-{{ sid }} tbody tr:last-child .fbt3__a { border-radius: 0 0 var(--fbt3-r) var(--fbt3-r); }
  #shopify-section-{{ sid }} .fbt3__pic { display: block; margin: 0 auto 10px; width: var(--fb-image_size_mobile); height: auto; max-width: 100%; transform: translateY(calc(var(--fb-image_offset_mobile) * -1)) rotate(var(--fb-image_rotate_mobile)); margin-bottom: calc(10px - var(--fb-image_offset_mobile)); }
  #shopify-section-{{ sid }} .fbt3__pic[hidden] { display: none; }
  #shopify-section-{{ sid }} .fbt3__label { position: sticky; left: 0; z-index: 1; background: var(--fb-section_bg, var(--color-background)); text-align: left; padding: var(--fb-cell_pad_y) 8px var(--fb-cell_pad_y) var(--fb-label_pad_x); color: var(--fb-label_color, var(--color-heading)); font-weight: var(--fb-label_weight); font-size: var(--fb-cell_size); line-height: 1.3; border-bottom: 1px dashed var(--fb-divider_a_color, var(--color-border)); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} thead .fbt3__label { border: 0; }
  #shopify-section-{{ sid }} .fbt3__cell { padding: var(--fb-cell_pad_y) 6px; text-align: center; vertical-align: middle; font-size: var(--fb-cell_size); line-height: 1.3; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} tbody .fbt3__a { border-bottom: 1px dashed var(--fb-divider_a_color, color-mix(in srgb, var(--btn-primary-color) 30%, transparent)); }
  #shopify-section-{{ sid }} .fbt3__cell.fbt3__b { color: var(--fb-text_color, var(--fb-col_b_text, var(--color-text))); border-bottom: 1px dashed var(--fb-divider_b_color, var(--color-border)); }
  #shopify-section-{{ sid }} .fbt3__table tbody tr:last-child > :is(th, td.fbt3__cell) { border-bottom: 0; }
  #shopify-section-{{ sid }} .fbt3__v { display: inline-flex; align-items: center; justify-content: center; min-height: var(--fb-icon_size); }
  #shopify-section-{{ sid }} .fbt3__v > * { display: none; }
  {%- assign v_types = 'check-circle,cross-circle,thumb-up,thumb-down,text,image,svg' | split: ',' -%}
  {%- for t in v_types %}
  #shopify-section-{{ sid }} .fbt3__v[data-v='{{ t }}'] > .fbt3__i--{{ t }} { display: inline-flex; }
  {%- endfor %}
  #shopify-section-{{ sid }} .fbt3__i { width: var(--fb-icon_size); height: var(--fb-icon_size); align-items: center; justify-content: center; border-radius: 50%; flex: none; }
  #shopify-section-{{ sid }} .fbt3__i svg, #shopify-section-{{ sid }} .fbt3__i img { width: 100%; height: 100%; display: block; object-fit: contain; }
  #shopify-section-{{ sid }} .fbt3__i--check-circle { background: var(--fb-check_bg, var(--btn-primary-color)); color: var(--fb-check_color, var(--btn-primary-bg-color)); }
  #shopify-section-{{ sid }} .fbt3__i--check-circle svg { width: 58%; height: 58%; }
  #shopify-section-{{ sid }} .fbt3__i--cross-circle { background: var(--fb-cross_bg, transparent); color: var(--fb-cross_color, currentColor); box-shadow: inset 0 0 0 1.5px currentColor; opacity: .8; }
  #shopify-section-{{ sid }} .fbt3__i--cross-circle svg { width: 46%; height: 46%; }
  #shopify-section-{{ sid }} :is(.fbt3__i--thumb-up, .fbt3__i--thumb-down) { color: var(--fb-thumb_color, currentColor); border-radius: 0; }
  #shopify-section-{{ sid }} .fbt3__i--thumb-up svg, #shopify-section-{{ sid }} .fbt3__i--thumb-down svg { width: 78%; height: 78%; }
  #shopify-section-{{ sid }} .fbt3__i--thumb-down { opacity: .75; }
  #shopify-section-{{ sid }} .fbt3__i--text { width: auto; height: auto; border-radius: 0; }
  #shopify-section-{{ sid }} .fb-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fbt3 { padding: var(--fb-padding_top_desktop) 0 var(--fb-padding_bottom_desktop); margin: var(--fb-section_margin_top_desktop) 0 var(--fb-section_margin_bottom_desktop); }
    #shopify-section-{{ sid }} .fbt3[data-reset_spacing='true'] { margin-block: 0; }
    #shopify-section-{{ sid }} .fbt3[data-show_section_on='desktop'] { display: block; }
    #shopify-section-{{ sid }} .fbt3[data-show_section_on='mobile'] { display: none; }
    #shopify-section-{{ sid }} .fbt3__layout { grid-template-columns: minmax(0, var(--fb-left_col_fr)) minmax(0, var(--fb-right_col_fr)); gap: var(--fb-layout_gap_desktop); }
    #shopify-section-{{ sid }} .fbt3[data-content_align='center'] .fbt3__content { align-items: center; text-align: center; }
    #shopify-section-{{ sid }} .fbt3[data-content_align='right'] .fbt3__content { align-items: flex-end; text-align: right; }
    #shopify-section-{{ sid }} .fbt3__heading { font-size: var(--fb-size_desktop); }
    #shopify-section-{{ sid }} .fbt3__table { border-spacing: var(--fb-col_gap) 0; }
    #shopify-section-{{ sid }} .fbt3__colhead { font-size: var(--fb-col_title_size_desktop); }
    #shopify-section-{{ sid }} .fbt3__pic { width: var(--fb-image_size_desktop); transform: translateY(calc(var(--fb-image_offset_desktop) * -1)) rotate(var(--fb-image_rotate_desktop)); margin-bottom: calc(10px - var(--fb-image_offset_desktop)); }
  }
{% comment %}{% endcomment %}</style>
{%- capture spec -%}{"px":"{{ spx }}","c":"{{ sc }}","w":"{{ sw }}","f":"{{ sf }}","a":"{{ sa }}","t":"{{ stx }}"}{%- endcapture -%}
{%- capture bspec -%}{"heading":{"px":"{{ h_px }}","c":"color","w":"weight","r":"text"},"subheading":{"px":"{{ s_px }}","c":"color","r":"text"},"rating":{"px":"{{ r_px }}","c":"color,star_filled_color,star_unfilled_color","a":"stars_total","t":"stars_value,stars_total","r":"text"},"col_a":{"px":"{{ a_px }}","c":"text_color,bg","t":"title","i":"image"},"col_b":{"c":"text_color","t":"title"},"row":{"t":"label,text_a,text_b","v":"type_a,type_b","i":"image_a,image_b"}}{%- endcapture -%}
<section class="fbt3 color-{{ color_scheme }} gradient" data-fb-root="comparison-table-3" data-fb-section="{{ sid }}" data-fb-settings="{{ st | json | escape }}" data-fb-spec="{{ spec | escape }}" data-fb-bspec="{{ bspec | escape }}"{% for k in sa_list %} data-{{ k }}="{{ st[k] }}"{% endfor %}{% if st.enable_custom_fonts and st.body_font.family != blank %} data-own-font{% endif %} data-fb-f="body_font" style="{% render 'features-b-vars', s: st, px: spx, c: sc, w: sw, f: sf, gate: st.enable_custom_style %}">
  <div class="fbt3__inner">
    <div class="fbt3__layout">
      <div class="fbt3__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2{% unless title_done %} id="fb-title-{{ sid }}"{% assign title_done = true %}{% endunless %} class="fbt3__heading" data-fb-block="{{ block.id }}" data-fb-type="heading" data-fb-bs="{{ bs | json | escape }}" data-fb-bt="{{ block.id }}:text" data-fb-bw="{{ block.id }}:weight" data-fb-f="heading_font" data-own-size{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %} style="{% render 'features-b-vars', s: bs, px: h_px, c: 'color', w: 'weight', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="fbt3__sub" data-fb-block="{{ block.id }}" data-fb-type="subheading" data-fb-bs="{{ bs | json | escape }}" data-fb-bt="{{ block.id }}:text" style="{% render 'features-b-vars', s: bs, px: s_px, c: 'color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'rating' -%}
              <div class="fbt3__rating" data-fb-block="{{ block.id }}" data-fb-type="rating" data-fb-bs="{{ bs | json | escape }}" data-stars_total="{{ bs.stars_total }}" style="{% render 'features-b-vars', s: bs, px: r_px, c: 'color,star_filled_color,star_unfilled_color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>
                <span class="fb-vh"><span data-fb-bt="{{ block.id }}:stars_value">{{ bs.stars_value }}</span> / <span data-fb-bt="{{ block.id }}:stars_total">{{ bs.stars_total }}</span></span><span class="fbt3__stars" aria-hidden="true"><span class="fbt3__stars-bg">{% for n in (1..5) %}{{ star }}{% endfor %}</span><span class="fbt3__stars-fg">{% for n in (1..5) %}{{ star }}{% endfor %}</span></span>
                <span class="fbt3__rating-text" data-fb-bt="{{ block.id }}:text">{{ bs.text }}</span>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="fbt3__scroll" data-fb-scroll role="region" {% if title_done %}aria-labelledby="fb-title-{{ sid }}"{% else %}aria-label="{{ cola.settings.title | default: 'Comparison' | escape }}"{% endif %} tabindex="0">
        <table class="fbt3__table"{% if cola %} data-fb-block="{{ cola.id }}" style="{% render 'features-b-vars', s: cola.settings, px: a_px, c: 'text_color,bg', gate: cola.settings.enable_custom_style %}"{% endif %}>
          <colgroup><col><col class="fbt3__ca"><col class="fbt3__cb"></colgroup>
          <thead>
            <tr>
              <td class="fbt3__label"></td>
              <th scope="col" class="fbt3__colhead fbt3__colhead--a fbt3__a"{% if cola %} data-fb-block="{{ cola.id }}" data-fb-type="col_a" data-fb-bs="{{ cola.settings | json | escape }}" style="{% render 'features-b-vars', s: cola.settings, px: a_px, c: 'text_color,bg', gate: cola.settings.enable_custom_style %}" {{ cola.shopify_attributes }}{% endif %}>
                {%- if cola -%}<img class="fbt3__pic" data-fb-bi="{{ cola.id }}:image" src="{% if cola.settings.image != blank %}{{ cola.settings.image | image_url: width: 480 }}{% endif %}" alt="" width="240" height="240" loading="lazy"{% if cola.settings.image == blank %} hidden data-fb-empty{% endif %}>{%- endif -%}
                <span class="fbt3__ct" data-fb-w="col_title_weight" data-fb-f="heading_font"{% if cola %} data-fb-bt="{{ cola.id }}:title"{% endif %}{% if st.col_title_weight != blank and st.col_title_weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %}>{{ cola.settings.title | escape }}</span>
              </th>
              <th scope="col" class="fbt3__colhead fbt3__colhead--b fbt3__b"{% if colb %} data-fb-block="{{ colb.id }}" data-fb-type="col_b" data-fb-bs="{{ colb.settings | json | escape }}" style="{% render 'features-b-vars', s: colb.settings, c: 'text_color', gate: colb.settings.enable_custom_style %}" {{ colb.shopify_attributes }}{% endif %}>
                <span class="fbt3__ct" data-fb-w="col_title_weight" data-fb-f="heading_font"{% if colb %} data-fb-bt="{{ colb.id }}:title"{% endif %}{% if st.col_title_weight != blank and st.col_title_weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %}>{{ colb.settings.title | escape }}</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              {%- assign rs = row.settings -%}
              <tr data-fb-block="{{ row.id }}" data-fb-type="row" data-fb-bs="{{ rs | json | escape }}" {{ row.shopify_attributes }}>
                <th scope="row" class="fbt3__label" data-fb-bt="{{ row.id }}:label">{{ rs.label | escape }}</th>
                {%- for side in (1..2) -%}
                  {%- if side == 1 -%}{%- assign k = 'a' -%}{%- assign t = rs.type_a | default: 'check-circle' -%}{%- else -%}{%- assign k = 'b' -%}{%- assign t = rs.type_b | default: 'thumb-down' -%}{%- endif -%}
                  {%- assign img_key = 'image_' | append: k -%}{%- assign svg_key = 'svg_' | append: k -%}{%- assign text_key = 'text_' | append: k -%}
                  <td class="fbt3__cell fbt3__{{ k }}"{% if side == 2 and colb %} data-fb-block="{{ colb.id }}" style="{% render 'features-b-vars', s: colb.settings, c: 'text_color', gate: colb.settings.enable_custom_style %}"{% endif %}>
                    <span class="fbt3__v" data-fb-bv="{{ row.id }}:type_{{ k }}" data-v="{{ t }}">
                      <span class="fbt3__i fbt3__i--check-circle"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="fb-vh" data-fb-t="check_label">{{ st.check_label }}</span></span>
                      <span class="fbt3__i fbt3__i--cross-circle"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg><span class="fb-vh" data-fb-t="cross_label">{{ st.cross_label }}</span></span>
                      <span class="fbt3__i fbt3__i--thumb-up"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z"/><path d="M2 11h4v11H2z"/></svg><span class="fb-vh" data-fb-t="check_label">{{ st.check_label }}</span></span>
                      <span class="fbt3__i fbt3__i--thumb-down"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3z"/><path d="M22 13h-4V2h4z"/></svg><span class="fb-vh" data-fb-t="cross_label">{{ st.cross_label }}</span></span>
                      <span class="fbt3__i fbt3__i--text" data-fb-bt="{{ row.id }}:{{ text_key }}">{{ rs[text_key] | escape }}</span>
                      <span class="fbt3__i fbt3__i--image"><img data-fb-bi="{{ row.id }}:{{ img_key }}" src="{% if rs[img_key] != blank %}{{ rs[img_key] | image_url: width: 96 }}{% endif %}" alt="" width="48" height="48" loading="lazy"{% if rs[img_key] == blank %} hidden data-fb-empty{% endif %}></span>
                      <span class="fbt3__i fbt3__i--svg">{{ rs[svg_key] }}</span>
                    </span>
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
</template>

