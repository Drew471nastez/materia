<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Comparison Table 3
  Two-up "us vs. them" comparison with a left content column (heading,
  subheading, rating badge) and a right table panel where one column is
  the highlighted "Our Brand" with a deep solid background and a floating
  product image, and the other is the plain "Others" column. All blocks:
  heading, subheading, rating, column header (left/right), and feature
  rows. Each row supports check / cross / thumbs-up / thumbs-down / text /
  custom-svg / image per side.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .ct3 {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 48 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct3 {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width — explicit max-width slider takes priority on desktop */
  #shopify-section-{{ sid }} .ct3__inner {
    max-width: {{ st.section_max_width_desktop | default: 1200 }}px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  {%- case st.section_width -%}
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .ct3__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .ct3__inner { max-width: none; }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .ct3__inner { max-width: none; padding-inline: 0; }
  {%- endcase -%}

  /* 2-up grid: content (left) + table (right). Stacks on mobile. */
  #shopify-section-{{ sid }} .ct3__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.layout_gap_mobile | default: 24 }}px;
    align-items: center;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .ct3__layout {
      grid-template-columns: {{ st.left_col_fr | default: 1 }}fr {{ st.right_col_fr | default: 1.1 }}fr;
      gap: {{ st.layout_gap_desktop | default: 64 }}px;
      align-items: center;
    }
  }

  /* Content column */
  #shopify-section-{{ sid }} .ct3__content {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 18 }}px;
    text-align: {{ st.content_align | default: 'left' }};
    align-items: {%- case st.content_align -%}
      {%- when 'center' -%}center
      {%- when 'right' -%}flex-end
      {%- else -%}flex-start
    {%- endcase -%};
  }
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .ct3__content {
      align-items: center;
      text-align: center;
    }
  }

  #shopify-section-{{ sid }} .ct3__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {% render 'scheme-color', color: st.rating_color, fallback: 'var(--color-text)' %};
    font-size: {{ st.rating_size | default: 14 }}px;
  }
  #shopify-section-{{ sid }} .ct3__rating img {
    height: {{ st.rating_height | default: 22 }}px;
    width: auto;
    display: block;
  }
  #shopify-section-{{ sid }} .ct3__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }
  #shopify-section-{{ sid }} .ct3__star {
    width: 1em;
    height: 1em;
    display: inline-block;
    position: relative;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .ct3__star-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #shopify-section-{{ sid }} .ct3__star-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
  }
  /* Foreground star is always sized to the full star (1em), regardless of
     how much of it is visible — clipping is done by the .ct3__star-fill
     container's width. */
  #shopify-section-{{ sid }} .ct3__star-fg {
    position: absolute;
    top: 0;
    left: 0;
    /* Must stay the FULL star width even though its parent .ct3__star-fill is
       narrower (that's what clips it into a partial star). Global theme resets
       like `svg { max-width: 100% }` would otherwise shrink this to the clip
       width and squish a tiny full star into the corner — breaking half-stars.
       Force it with !important + max-width:none. */
    width: 1em !important;
    height: 1em !important;
    max-width: none !important;
    min-width: 0;
    display: block;
  }

  /* Table panel */
  #shopify-section-{{ sid }} .ct3__table {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) {{ st.col_a_width | default: 1 }}fr {{ st.col_b_width | default: 1 }}fr;
    column-gap: {{ st.col_gap | default: 16 }}px;
    align-items: stretch;
    position: relative;
  }
  @media (max-width: 480px) {
    #shopify-section-{{ sid }} .ct3__table {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      column-gap: {{ st.col_gap_mobile | default: 8 }}px;
    }
  }

  /* Highlighted "Our Brand" column background spans the full table area
     vertically, with the column header sitting on its dark band. */
  #shopify-section-{{ sid }} .ct3__col-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    background: {% render 'scheme-color', color: st.col_a_bg, fallback: 'var(--btn-primary-bg-color)' %};
    border-radius: {{ st.col_a_radius | default: 28 }}px;
    z-index: 0;
    pointer-events: none;
  }

  /* Header row */
  #shopify-section-{{ sid }} .ct3__head {
    display: contents;
  }
  #shopify-section-{{ sid }} .ct3__head-spacer {}
  #shopify-section-{{ sid }} .ct3__col-header {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: {{ st.col_header_pad | default: 32 }}px 8px {{ st.col_header_pad | default: 32 }}px;
    color: {% render 'scheme-color', color: st.col_a_text, fallback: 'var(--btn-primary-color)' %};
    font-style: italic;
    font-weight: {% if st.col_title_weight == blank or st.col_title_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ st.col_title_weight }}{% endif %};
    font-size: {{ st.col_title_size_mobile | default: 18 }}px;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct3__col-header { font-size: {{ st.col_title_size_desktop | default: 26 }}px; }
  }
  #shopify-section-{{ sid }} .ct3__col-header--b {
    color: {% render 'scheme-color', color: st.col_b_text, fallback: 'var(--color-text)' %};
  }
  /* Per-block image controls are written as CSS custom properties on the
     image element. The mobile values are the defaults; the desktop media
     query below swaps to the desktop values. Using vars (instead of inline
     width/top/transform) lets the media query override inline values. */
  #shopify-section-{{ sid }} .ct3__col-header-image {
    position: absolute;
    left: 50%;
    width: var(--ct3-img-size-mobile, 80px);
    top: calc(-1 * var(--ct3-img-offset-mobile, 18px));
    transform: translateX(-50%) rotate(var(--ct3-img-rotate-mobile, -8deg));
    height: auto;
    pointer-events: none;
    z-index: 2;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct3__col-header-image {
      width: var(--ct3-img-size-desktop, 110px);
      top: calc(-1 * var(--ct3-img-offset-desktop, 28px));
      transform: translateX(-50%) rotate(var(--ct3-img-rotate-desktop, -8deg));
    }
  }

  /* Rows */
  #shopify-section-{{ sid }} .ct3__row {
    display: contents;
  }
  #shopify-section-{{ sid }} .ct3__cell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    padding: {{ st.cell_pad_y | default: 18 }}px 12px;
    font-size: {{ st.cell_size | default: 14 }}px;
    line-height: 1.35;
  }
  #shopify-section-{{ sid }} .ct3__cell--label {
    color: {% render 'scheme-color', color: st.label_color, fallback: 'var(--color-heading)' %};
    font-weight: {{ st.label_weight | default: 600 }};
    padding-left: {{ st.label_pad_x | default: 28 }}px;
    border-bottom: 1px dashed {% render 'scheme-color', color: st.divider_a_color, fallback: 'var(--color-border)' %};
  }
  /* Column text colors are driven by CSS custom properties set inline on
     the .ct3__table — block.text_color writes the value, with section
     defaults as fallback. This makes a single block setting drive both the
     column header AND every cell in that column. */
  #shopify-section-{{ sid }} .ct3__col-header--a { color: var(--ct3-a-text, {% render 'scheme-color', color: st.col_a_text, fallback: 'var(--btn-primary-color)' %}); }
  #shopify-section-{{ sid }} .ct3__col-header--b { color: var(--ct3-b-text, {% render 'scheme-color', color: st.col_b_text, fallback: 'var(--color-text)' %}); }
  #shopify-section-{{ sid }} .ct3__cell--a {
    justify-content: center;
    color: var(--ct3-a-text, {% render 'scheme-color', color: st.col_a_text, fallback: 'var(--btn-primary-color)' %});
    border-bottom: 1px dashed {% render 'scheme-color', color: st.divider_a_color, fallback: 'color-mix(in srgb, var(--btn-primary-color) 30%, transparent)' %};
  }
  #shopify-section-{{ sid }} .ct3__cell--b {
    justify-content: center;
    color: var(--ct3-b-text, {% render 'scheme-color', color: st.col_b_text, fallback: 'var(--color-text)' %});
    border-bottom: 1px dashed {% render 'scheme-color', color: st.divider_b_color, fallback: 'var(--color-border)' %};
  }
  #shopify-section-{{ sid }} .ct3__row:last-of-type .ct3__cell { border-bottom: 0; }

  /* Icon styles */
  #shopify-section-{{ sid }} .ct3__icon {
    width: {{ st.icon_size | default: 32 }}px;
    height: {{ st.icon_size | default: 32 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ sid }} .ct3__icon--check-circle {
    border-radius: 999px;
    background: {% render 'scheme-color', color: st.check_bg, fallback: 'var(--btn-primary-color)' %};
    color: {% render 'scheme-color', color: st.check_color, fallback: 'var(--btn-primary-bg-color)' %};
  }
  #shopify-section-{{ sid }} .ct3__icon--check-circle svg { width: 56%; height: 56%; }
  #shopify-section-{{ sid }} .ct3__icon--cross-circle {
    border-radius: 999px;
    background: {% render 'scheme-color', color: st.cross_bg, fallback: 'var(--btn-primary-color)' %};
    color: {% render 'scheme-color', color: st.cross_color, fallback: 'var(--btn-primary-bg-color)' %};
  }
  #shopify-section-{{ sid }} .ct3__icon--cross-circle svg { width: 50%; height: 50%; }
  #shopify-section-{{ sid }} .ct3__icon--thumb-down,
  #shopify-section-{{ sid }} .ct3__icon--thumb-up {
    color: {% render 'scheme-color', color: st.thumb_color, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .ct3__icon img,
  #shopify-section-{{ sid }} .ct3__icon svg { display: block; }
  #shopify-section-{{ sid }} .ct3__icon--image img {
    width: 100%; height: 100%; object-fit: contain;
  }
  #shopify-section-{{ sid }} .ct3__icon--svg svg,
  #shopify-section-{{ sid }} .ct3__icon--svg { color: currentColor; }
  #shopify-section-{{ sid }} .ct3__icon--svg svg { width: 100%; height: 100%; }

  /* Heading + subheading defaults so backwards-compat fallbacks render */
  #shopify-section-{{ sid }} .ct3__heading,
  #shopify-section-{{ sid }} .ct3__sub { margin: 0; }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .ct3 { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .ct3 { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .ct3 { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .ct3 { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- liquid
  assign rows = section.blocks | where: 'type', 'row'
  assign cola = nil
  assign colb = nil
  for b in section.blocks
    if b.type == 'col_a' and cola == nil
      assign cola = b
    endif
    if b.type == 'col_b' and colb == nil
      assign colb = b
    endif
  endfor
-%}

<section class="ct3 color-{{ color_scheme }} gradient {{ st.section_width }}" id="ct3-{{ sid }}">
  <div class="ct3__inner">
    <div class="ct3__layout">

      {%- comment -%}========== LEFT CONTENT ==========={%- endcomment -%}
      <div class="ct3__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="ct3__heading" style="margin-top: {{ bs.space_above | default: 0 }}px; margin-bottom: {{ bs.space_below | default: 0 }}px;" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %} !important;
                    font-weight: {% if bs.weight == blank or bs.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ bs.weight }}{% endif %};
                    line-height: {{ bs.line_height | default: 1.05 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    font-size: {{ bs.size_mobile | default: 36 }}px;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 56 }}px; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="ct3__sub" style="margin-top: {{ bs.space_above | default: 0 }}px; margin-bottom: {{ bs.space_below | default: 0 }}px;" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %} !important;
                    font-size: {{ bs.size | default: 17 }}px;
                    line-height: {{ bs.line_height | default: 1.55 }};
                    max-width: {{ bs.max_width | default: 460 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'rating' -%}
              <div class="ct3__rating" id="block-{{ block.id }}" style="margin-top: {{ bs.space_above | default: 0 }}px; margin-bottom: {{ bs.space_below | default: 0 }}px;" {{ block.shopify_attributes }}>
                {%- assign stars_total = bs.stars_total | default: 5 | plus: 0 -%}
                {%- assign stars_value = bs.stars_value | default: 5 | times: 1.0 -%}
                {%- capture star_filled_color -%}{% render 'scheme-color', color: bs.star_filled_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
                {%- capture star_unfilled_color -%}{% render 'scheme-color', color: bs.star_unfilled_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
                <span class="ct3__stars" aria-label="{{ stars_value }} out of {{ stars_total }} stars" style="font-size: {{ bs.star_size | default: 18 }}px;">
                  {%- for i in (1..stars_total) -%}
                    {%- assign filled = stars_value | minus: i | plus: 1 -%}
                    {%- if filled <= 0 -%}{%- assign pct = 0 -%}
                    {%- elsif filled >= 1 -%}{%- assign pct = 100 -%}
                    {%- else -%}{%- assign pct = filled | times: 100 | round -%}
                    {%- endif -%}
                    <span class="ct3__star" aria-hidden="true">
                      <svg class="ct3__star-bg" viewBox="0 0 24 24" style="fill: {{ star_unfilled_color }}" aria-hidden="true">
                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                      </svg>
                      {%- if pct > 0 -%}
                        <span class="ct3__star-fill" style="width: {{ pct }}%;">
                          <svg class="ct3__star-fg" viewBox="0 0 24 24" style="fill: {{ star_filled_color }}" aria-hidden="true">
                            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                          </svg>
                        </span>
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </span>
                {%- if bs.text != blank -%}
                  <span>{{ bs.text }}</span>
                {%- endif -%}
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
                    font-size: {{ bs.size | default: 14 }}px;
                  }
{% comment %}{% endcomment %}                </style>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%}========== RIGHT TABLE ==========={%- endcomment -%}
      {%- liquid
        assign cola_text = st.col_a_text
        if cola and cola.settings.text_color != blank and cola.settings.text_color.alpha != 0
          assign cola_text = cola.settings.text_color
        endif
        assign colb_text = st.col_b_text
        if colb and colb.settings.text_color != blank and colb.settings.text_color.alpha != 0
          assign colb_text = colb.settings.text_color
        endif
      -%}
      <div class="ct3__table" data-ct3-table style="--ct3-a-text: {% render 'scheme-color', color: cola_text, fallback: 'var(--btn-primary-color)' %}; --ct3-b-text: {% render 'scheme-color', color: colb_text, fallback: 'var(--color-text)' %};">
        {%- comment -%} Solid bg behind the highlighted column {%- endcomment -%}
        <span class="ct3__col-bg" data-ct3-bg aria-hidden="true"
              {% if cola %}style="
                {% if cola.settings.bg != blank and cola.settings.bg.alpha != 0 %}background: {{ cola.settings.bg }};{% endif %}
                {% if cola.settings.radius %}border-radius: {{ cola.settings.radius }}px;{% endif %}
              "{% endif %}></span>

        {%- comment -%} Header row {%- endcomment -%}
        <div class="ct3__head-spacer"></div>
        <div class="ct3__col-header ct3__col-header--a" {% if cola %}{{ cola.shopify_attributes }}{% endif %}>
          {%- if cola and cola.settings.image -%}
            {%- assign cs = cola.settings -%}
            <img class="ct3__col-header-image"
                 src="{{ cs.image | image_url: width: 320 }}"
                 alt="{{ cs.title | escape }}"
                 loading="lazy"
                 style="
                   --ct3-img-size-desktop: {{ cs.image_size_desktop | default: 110 }}px;
                   --ct3-img-size-mobile:  {{ cs.image_size_mobile  | default: 80 }}px;
                   --ct3-img-rotate-desktop: {{ cs.image_rotate_desktop | default: -8 }}deg;
                   --ct3-img-rotate-mobile:  {{ cs.image_rotate_mobile  | default: -8 }}deg;
                   --ct3-img-offset-desktop: {{ cs.image_offset_desktop | default: 28 }}px;
                   --ct3-img-offset-mobile:  {{ cs.image_offset_mobile  | default: 18 }}px;
                 ">
          {%- endif -%}
          {%- if cola and cola.settings.title != blank -%}{{ cola.settings.title | escape }}{%- endif -%}
        </div>
        <div class="ct3__col-header ct3__col-header--b" {% if colb %}{{ colb.shopify_attributes }}{% endif %}>
          {%- if colb and colb.settings.title != blank -%}{{ colb.settings.title | escape }}{%- endif -%}
        </div>

        {%- comment -%} Feature rows {%- endcomment -%}
        {%- for row in rows -%}
          {%- assign rs = row.settings -%}
          <div class="ct3__cell ct3__cell--label" {{ row.shopify_attributes }}>{{ rs.label | escape }}</div>

          {%- comment -%} A side {%- endcomment -%}
          <div class="ct3__cell ct3__cell--a">
            {%- assign t = rs.type_a | default: 'check-circle' -%}
            {%- case t -%}
              {%- when 'check-circle' -%}
                <span class="ct3__icon ct3__icon--check-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              {%- when 'cross-circle' -%}
                <span class="ct3__icon ct3__icon--cross-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                </span>
              {%- when 'thumb-up' -%}
                <span class="ct3__icon ct3__icon--thumb-up">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z"/><path d="M2 11h4v11H2z"/></svg>
                </span>
              {%- when 'thumb-down' -%}
                <span class="ct3__icon ct3__icon--thumb-down">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3z"/><path d="M22 13h-4V2h4z"/></svg>
                </span>
              {%- when 'svg' -%}
                <span class="ct3__icon ct3__icon--svg">{{ rs.svg_a }}</span>
              {%- when 'image' -%}
                {%- if rs.image_a -%}
                  <span class="ct3__icon ct3__icon--image"><img src="{{ rs.image_a | image_url: width: 80 }}" alt="" loading="lazy"></span>
                {%- endif -%}
              {%- when 'text' -%}
                {{ rs.text_a | escape }}
              {%- when 'none' -%}
            {%- endcase -%}
          </div>

          {%- comment -%} B side {%- endcomment -%}
          <div class="ct3__cell ct3__cell--b">
            {%- assign t2 = rs.type_b | default: 'thumb-down' -%}
            {%- case t2 -%}
              {%- when 'check-circle' -%}
                <span class="ct3__icon ct3__icon--check-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              {%- when 'cross-circle' -%}
                <span class="ct3__icon ct3__icon--cross-circle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                </span>
              {%- when 'thumb-up' -%}
                <span class="ct3__icon ct3__icon--thumb-up">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z"/><path d="M2 11h4v11H2z"/></svg>
                </span>
              {%- when 'thumb-down' -%}
                <span class="ct3__icon ct3__icon--thumb-down">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3z"/><path d="M22 13h-4V2h4z"/></svg>
                </span>
              {%- when 'svg' -%}
                <span class="ct3__icon ct3__icon--svg">{{ rs.svg_b }}</span>
              {%- when 'image' -%}
                {%- if rs.image_b -%}
                  <span class="ct3__icon ct3__icon--image"><img src="{{ rs.image_b | image_url: width: 80 }}" alt="" loading="lazy"></span>
                {%- endif -%}
              {%- when 'text' -%}
                {{ rs.text_b | escape }}
              {%- when 'none' -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function() {
 function init() {
  var section = document.querySelector('#shopify-section-{{ sid }}');
  if (!section) return;
  var table = section.querySelector('[data-ct3-table]');
  var bg = section.querySelector('[data-ct3-bg]');
  if (!table || !bg) return;
  if (table.dataset.ct3Init === '1') return;
  table.dataset.ct3Init = '1';

  function position() {
    // Place the highlighted-column background exactly behind the second
    // grid track regardless of column widths or breakpoints.
    var aHeader = table.querySelector('.ct3__col-header--a');
    if (!aHeader) return;
    var rect    = aHeader.getBoundingClientRect();
    var trect   = table.getBoundingClientRect();
    bg.style.left  = (rect.left  - trect.left) + 'px';
    bg.style.width = rect.width + 'px';
  }
  position();

  var raf = 0;
  function schedule() {
    if (raf) return;
    raf = requestAnimationFrame(function() { raf = 0; position(); });
  }
  window.addEventListener('resize', schedule);
  if (window.ResizeObserver) {
    var ro = new ResizeObserver(schedule);
    ro.observe(table);
  }
  // Re-run when fonts/images load (changes column width)
  window.addEventListener('load', position);
 }
  init();
  document.addEventListener('storelib:section-load', function(e) {
    if (e.detail && e.detail.sectionId === '{{ sid }}') init();
  });
})();
{% comment %}{% endcomment %}</script>



</template>

