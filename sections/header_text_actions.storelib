<template>
<header class="hd hd--acts-{{ settings.actions_style }}{% if settings.sticky %} hd--sticky{% endif %}{% if settings.logo_custom_position %} hd--logo-custom{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-border: {{ scheme.primary_button_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --hd-act: {{ settings.action_color }}; --hd-act-size: {{ settings.action_size }}px; --hd-gap: {{ settings.action_gap }}px; --hd-logo-w: {{ settings.logo_width }}px; --hd-logo-x-d: {{ settings.logo_offset_desktop }}px; --hd-logo-x-m: {{ settings.logo_offset_mobile }}px; --hd-c-bg: {{ settings.btn_bg }}; --hd-c-text: {{ settings.btn_text_color }}; --hd-c-border: {{ settings.btn_border }}; --hd-c-hover-bg: {{ settings.btn_hover_bg }}; --hd-c-hover-text: {{ settings.btn_hover_text }}; --hd-c-hover-border: {{ settings.btn_hover_border }};">
  <div class="hd__in">

    <button type="button" class="hd__menu-btn" data-storelib-menu aria-label="Menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a class="hd__logo" href="{{ '/' | url }}">
      {% if settings.logo %}
        <img src="{{ settings.logo | asset }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="40" decoding="async">
      {% elsif theme.logo.url %}
        <img src="{{ theme.logo.url | asset }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="40" decoding="async">
      {% else %}
        <span class="hd__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if settings.show_menu %}
      <nav class="hd__nav" aria-label="Main">
        <ul class="hd__nav-list">
          {% for link in settings.menu.links %}
            <li class="hd__nav-item">
              {% if link.links.size > 0 %}
                <details class="hd__drop" name="{{ section.id }}-nav">
                  <summary class="hd__nav-link">{{ link.title }}<svg class="hd__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg></summary>
                  <ul class="hd__drop-list">
                    {% for sub in link.links %}
                      <li><a class="hd__drop-link" href="{{ sub.url | url }}">{{ sub.title }}</a></li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a class="hd__nav-link" href="{{ link.url | url }}">{{ link.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% else %}
      <span class="hd__spacer" aria-hidden="true"></span>
    {% endif %}

    <div class="hd__right">
      {% if settings.show_language %}
        <details class="hd__lang hd__drop" name="{{ section.id }}-nav">
          <summary class="hd__lang-btn">{{ settings.language_label }}<svg class="hd__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg></summary>
          {% if settings.language_menu.links.size > 0 %}
            <ul class="hd__drop-list hd__drop-list--end">
              {% for link in settings.language_menu.links %}
                <li><a class="hd__drop-link" href="{{ link.url | url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </details>
      {% endif %}

      <ul class="hd__acts">
        {% if settings.show_search %}
          <li><button type="button" class="hd__act" data-storelib-search>
            <svg class="hd__ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <span class="hd__lbl">Search</span>
          </button></li>
        {% endif %}
        {% if settings.show_account %}
          <li class="hd__act-wrap--wide"><a class="hd__act" href="{{ routes.account_url | url }}">
            <svg class="hd__ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            <span class="hd__lbl">Account</span>
          </a></li>
        {% endif %}
        {% if settings.show_wishlist %}
          <li class="hd__act-wrap--wide"><a class="hd__act" href="{{ settings.wishlist_url | default: '/wishlist' | url }}">
            <svg class="hd__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
            <span class="hd__lbl">Wishlist</span>
          </a></li>
        {% endif %}
        {% if settings.show_cart %}
          <li><button type="button" class="hd__act" data-storelib-cart>
            <svg class="hd__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
            <span class="hd__lbl">Cart</span>
            <span class="hd__count">(<span data-storelib-cart-count>0</span>)</span>
          </button></li>
        {% endif %}
      </ul>

      {% if settings.button_text %}
        {% if settings.button_style == 'custom' %}
          <a class="hd__btn hd__btn--custom" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>
        {% else %}
          <a class="hd__btn hd__btn--{{ settings.button_style }}" data-sl-button href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>
        {% endif %}
      {% endif %}
    </div>

  </div>
</header>
</template>

<style scoped>
.hd { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); z-index: 20; }
.hd--sticky { position: sticky; top: 0; }
.hd__in { display: flex; align-items: center; gap: 12px; max-width: var(--theme-page-width, 1280px); margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); min-width: 0; }

.hd__menu-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-left: -10px; padding: 0; border: 0; background: none; color: var(--hd-act); cursor: pointer; flex: none; }
.hd__menu-btn svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }

.hd__logo { display: inline-flex; align-items: center; flex: none; min-height: 44px; text-decoration: none; color: var(--s-heading); }
.hd__logo img { display: block; width: var(--hd-logo-w); max-width: 40cqi; height: auto; }
.hd__logo-text { font-family: var(--theme-font-heading); font-size: 20px; font-weight: 700; line-height: 1.1; white-space: nowrap; }
.hd--logo-custom .hd__logo { transform: translateX(var(--hd-logo-x-m)); }

.hd__nav { display: none; flex: 1; min-width: 0; }
.hd__spacer { flex: 1; }
.hd__nav-list { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--hd-gap); row-gap: 0; margin: 0; padding: 0; list-style: none; }
.hd__nav-item { position: relative; }
.hd__nav-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--hd-act); font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap; cursor: pointer; list-style: none; transition: opacity 150ms ease; }
.hd__nav-link::-webkit-details-marker, .hd__lang-btn::-webkit-details-marker { display: none; }
.hd__nav-link::marker, .hd__lang-btn::marker { content: ""; }

.hd__chev { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 150ms ease; }
.hd__drop { position: relative; }
.hd__drop[open] > summary .hd__chev { transform: rotate(180deg); }
.hd__drop-list { position: absolute; top: 100%; left: 0; min-width: 200px; margin: 4px 0 0; padding: 8px 0; list-style: none; background: var(--s-bg); border: 1px solid var(--s-border); border-radius: var(--s-radius); z-index: 5; }
.hd__drop-list--end { left: auto; right: 0; }
.hd__drop-link { display: block; padding: 10px 16px; color: var(--hd-act); font-size: 14px; text-decoration: none; white-space: nowrap; transition: opacity 150ms ease; }

.hd__right { display: flex; align-items: center; gap: var(--hd-gap); flex: none; min-width: 0; margin-left: auto; }

.hd__lang { display: none; }
.hd__lang-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--hd-act); font-size: 15px; font-weight: 500; white-space: nowrap; cursor: pointer; list-style: none; transition: opacity 150ms ease; }

.hd__acts { display: flex; flex-wrap: nowrap; align-items: center; gap: var(--hd-gap); margin: 0; padding: 0; list-style: none; }
.hd__acts > li { display: flex; flex: none; margin: 0; padding: 0; }
.hd__act-wrap--wide { display: none !important; }
.hd__act { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; min-width: 44px; justify-content: center; padding: 0; margin: 0; border: 0; border-bottom: 0; box-shadow: none; background: none; color: var(--hd-act); font: inherit; font-size: var(--hd-act-size); font-weight: 500; line-height: 1; text-decoration: none; white-space: nowrap; cursor: pointer; transition: opacity 150ms ease; }
.hd__act, .hd__act:hover, .hd__act:focus, .hd__act:visited, .hd__act:active { text-decoration: none; color: var(--hd-act); border-bottom: 0; box-shadow: none; }
.hd__act *, .hd__act::after, .hd__act::before { text-decoration: none; }
.hd__act::after, .hd__act::before { content: none; }
.hd__ic { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.hd__count { font-variant-numeric: tabular-nums; }

.hd__lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.hd__act .hd__count { font-size: 13px; }

.hd__btn { display: none; align-items: center; justify-content: center; flex: none; padding: var(--sl-button-padding, 13px 24px); font-family: var(--theme-button-font, var(--theme-font-body)); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height, 1.2); font-weight: var(--theme-button-weight, 600); letter-spacing: var(--theme-button-tracking, normal); text-transform: var(--theme-button-transform, none); text-decoration: none; white-space: nowrap; border-radius: var(--theme-button-radius, var(--s-radius)); border: var(--theme-button-border-width, 1px) solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease; }
.hd__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn-border, var(--s-btn)); }
.hd__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.hd__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.hd__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); border-color: var(--s-btn2-border); }
.hd__btn--custom, .hd__btn--custom:visited { background: var(--hd-c-bg); color: var(--hd-c-text); border-color: var(--hd-c-border); }
.hd__btn--custom:hover { background: var(--hd-c-hover-bg); color: var(--hd-c-hover-text); border-color: var(--hd-c-hover-border); }

.hd__act:hover, .hd__nav-link:hover, .hd__lang-btn:hover, .hd__drop-link:hover, .hd__logo:hover { opacity: 0.7; }
.hd__act:focus-visible, .hd__nav-link:focus-visible, .hd__lang-btn:focus-visible, .hd__drop-link:focus-visible, .hd__logo:focus-visible, .hd__menu-btn:focus-visible, .hd__btn:focus-visible { outline: 2px solid var(--hd-act); outline-offset: 3px; border-radius: 4px; }

@container (min-width: 640px) {
  .hd__in { gap: 24px; }
  .hd__lang { display: block; }
  .hd__act-wrap--wide { display: flex !important; }
  .hd__btn { display: inline-flex; }
}

@container (min-width: 1024px) {
  .hd__menu-btn { display: none; }
  .hd__nav { display: block; }
  .hd__spacer { display: block; }
  .hd--logo-custom .hd__logo { transform: translateX(var(--hd-logo-x-d)); }
  .hd--acts-text .hd__ic { display: none; }
  .hd--acts-text .hd__lbl, .hd--acts-both .hd__lbl { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  .hd--acts-text .hd__act, .hd--acts-both .hd__act { min-width: 0; gap: 4px; }
  .hd--acts-both .hd__act { gap: 8px; }
  .hd--acts-text .hd__act .hd__count, .hd--acts-both .hd__act .hd__count { font-size: inherit; }
}

@media (prefers-reduced-motion: reduce) { .hd__act, .hd__nav-link, .hd__lang-btn, .hd__drop-link, .hd__btn, .hd__chev, .hd__logo { transition: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "header_text_actions",
  "name": "Header with Text Actions",
  "kind": "header",
  "category": "header",
  "description": "Logo, menu, language picker, search, account, wishlist and cart as text or icons, and one action button.",
  "settings": [
    {"type":"header","id":"hdr_logo","label":"Logo"},
    {"type":"image_picker","id":"logo","label":"Logo override","default":"","info":"Leave empty to use the theme logo."},
    {"type":"range","id":"logo_width","label":"Logo width","min":40,"max":320,"step":4,"unit":"px","default":120},
    {"type":"toggle","id":"logo_custom_position","label":"Use a custom logo position","default":false},
    {"type":"range","id":"logo_offset_desktop","label":"Logo horizontal position (desktop)","min":-200,"max":400,"step":4,"unit":"px","default":0,"visible_if":"{{ section.settings.logo_custom_position }}"},
    {"type":"range","id":"logo_offset_mobile","label":"Logo horizontal position (mobile)","min":-100,"max":200,"step":2,"unit":"px","default":0,"visible_if":"{{ section.settings.logo_custom_position }}"},

    {"type":"header","id":"hdr_menu","label":"Menu"},
    {"type":"toggle","id":"show_menu","label":"Show menu on desktop","default":true},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"toggle","id":"show_language","label":"Show language picker","default":true},
    {"type":"text","id":"language_label","label":"Current language","default":"English","visible_if":"{{ section.settings.show_language }}"},
    {"type":"link_list","id":"language_menu","label":"Language links","default":"","visible_if":"{{ section.settings.show_language }}"},

    {"type":"header","id":"hdr_actions","label":"Actions"},
    {"type":"select","id":"actions_style","label":"Actions show as","default":"text","options":[{"label":"Text","value":"text"},{"label":"Icons","value":"icons"},{"label":"Icons and text","value":"both"}]},
    {"type":"toggle","id":"show_search","label":"Show search","default":true},
    {"type":"toggle","id":"show_account","label":"Show account","default":true},
    {"type":"toggle","id":"show_wishlist","label":"Show wishlist","default":true},
    {"type":"url","id":"wishlist_url","label":"Wishlist page","default":"/wishlist","visible_if":"{{ section.settings.show_wishlist }}"},
    {"type":"toggle","id":"show_cart","label":"Show cart","default":true},
    {"type":"range","id":"action_size","label":"Action text size","min":12,"max":28,"step":1,"unit":"px","default":16},
    {"type":"range","id":"action_gap","label":"Space between actions","min":8,"max":56,"step":4,"unit":"px","default":24},
    {"type":"color","id":"action_color","label":"Action colour","default":"scheme.heading"},

    {"type":"header","id":"hdr_button","label":"Button"},
    {"type":"text","id":"button_text","label":"Button label","default":"Shop now"},
    {"type":"url","id":"button_url","label":"Button link","default":"/products"},
    {"type":"select","id":"button_style","label":"Button style","default":"primary","options":[{"label":"Primary (theme)","value":"primary"},{"label":"Secondary (theme)","value":"secondary"},{"label":"Custom","value":"custom"}]},
    {"type":"color","id":"btn_bg","label":"Background","default":"scheme.primary_button_background","visible_if":"{{ section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"btn_text_color","label":"Text","default":"scheme.primary_button_text","visible_if":"{{ section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"btn_border","label":"Border","default":"scheme.primary_button_border","visible_if":"{{ section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"btn_hover_bg","label":"Hover background","default":"scheme.primary_button_hover_background","visible_if":"{{ section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"btn_hover_text","label":"Hover text","default":"scheme.primary_button_hover_text","visible_if":"{{ section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"btn_hover_border","label":"Hover border","default":"scheme.primary_button_hover_background","visible_if":"{{ section.settings.button_style == 'custom' }}"},

    {"type":"header","id":"hdr_style","label":"Style"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"black"},
    {"type":"toggle","id":"sticky","label":"Stick to the top on scroll","default":true},

    {"type":"header","id":"hdr_spacing","label":"Spacing"},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":16},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":16}
  ],
  "presets": [
    {"name":"Header with Text Actions"},
    {"name":"Header with Text Actions, light","settings":{"color_scheme":"white"}}
  ]
}
</schema>