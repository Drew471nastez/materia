<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Gallery Simple 5: a tagline, heading and button over a
  collage of up to eight images. Desktop (1096px and up) is a collage of
  the first six images around the text; tablets get a two column grid; phones
  get a swipe carousel or a stacked list. Colours and fonts follow the theme
  until "Enable custom styling" / "Enable custom fonts" are on. The carousel
  buttons and live edits run in media-live-galleries-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.45%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign button_block = section.blocks | where: 'type', 'button' | first
  assign hb = heading_block.settings
  assign bb = button_block.settings
  assign heading_weight = hb.heading_weight
  if heading_weight == blank or heading_weight == 'inherit'
    assign heading_weight = st.heading_weight
  endif
  if heading_weight == blank or heading_weight == 'inherit'
    assign heading_weight = 'var(--heading-weight, 700)'
  endif
  assign custom = st.enable_custom_style
  assign button_link = bb.button_link | url
  assign html_id = st.html_id | handleize
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--mgb-mt-m, {{ st.section_margin_top_mobile | default: 0 }}px) !important; margin-bottom: var(--mgb-mb-m, {{ st.section_margin_bottom_mobile | default: 0 }}px) !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--mgb-mt-d, {{ st.section_margin_top_desktop | default: 0 }}px) !important; margin-bottom: var(--mgb-mb-d, {{ st.section_margin_bottom_desktop | default: 0 }}px) !important; }
  }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) { padding-top: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) + .shopify-section { margin-top: 0 !important; }
  {%- if st.enable_custom_fonts %}
    {%- if st.heading_font.family %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endif %}
    {%- if st.body_font.family %}{{ st.body_font | font_face: font_display: 'swap' }}{% endif %}
  {%- endif %}
  #shopify-section-{{ sid }} .gs2 {
    {%- capture legacy_bg %}{% if custom %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{% endcapture %}
    {%- assign legacy_bg = legacy_bg | strip %}
    {%- capture bg %}{% if custom %}{% render 'scheme-color', color: st.background_color, fallback: legacy_bg %}{% else %}{{ legacy_bg }}{% endif %}{% endcapture %}
    {%- assign bg = bg | strip %}
    {%- if custom and st.background_gradient != blank %}{% assign bg = st.background_gradient %}{% endif %}
    --gs2-bg: {{ bg }};
    --gs2-heading-font: {% if st.enable_custom_fonts and st.heading_font.family %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'serif' }}{% else %}var(--heading-font){% endif %};
    --gs2-body-font: {% if st.enable_custom_fonts and st.body_font.family %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
    --gs2-tag-color: {% if custom %}{% render 'scheme-color', color: st.tagline_text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
    --gs2-head-color: {% if custom %}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --gs2-arrow: {% if custom %}{% render 'scheme-color', color: st.arrow_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --gs2-pad-d: {{ st.desktop_top_padding | default: 0 }}px {{ st.desktop_bottom_padding | default: 0 }}px;
    --gs2-pad-m: {{ st.mobile_top_padding | default: 0 }}px {{ st.mobile_bottom_padding | default: 0 }}px;
    --gs2-inner: {{ st.inner_width_px | default: 1100 }}px;
    --gs2-tag-size-d: {{ st.desktop_tagline_size | default: 16 }}px;
    --gs2-tag-size-m: {{ st.mobile_tagline_size | default: 16 }}px;
    --gs2-tag-weight: {{ st.tagline_font_weight | default: 400 }};
    --gs2-tag-pb-d: {{ st.desktop_tagline_padding_bottom | default: 0 }}px;
    --gs2-tag-pb-m: {{ st.mobile_tagline_padding_bottom | default: 0 }}px;
    --gs2-head-max-d: {{ st.desktop_heading_max_width | default: 700 }}px;
    --gs2-head-max-m: {{ st.mobile_heading_max_width | default: 350 }}px;
    --gs2-radius: {{ st.image_border_radius | default: 0 }}px;
    --gs2-img-pb: {{ st.mobile_image_bottom_padding | default: 0 }}px;
    --gs2-arrows-gap: {{ st.arrows_gap | default: 0 }}px;
    --gs2-carousel-pb: {{ st.carousel_bottom_padding | default: 0 }}px;
    --gs2-placement: {{ st.image_placement_mobile | default: 'column' }};
    --gs2-pad: var(--gs2-pad-m); --gs2-tag-size: var(--gs2-tag-size-m); --gs2-tag-pb: var(--gs2-tag-pb-m); --gs2-head-max: var(--gs2-head-max-m);
    display: block;
    background: var(--gs2-bg);
    color: var(--color-text);
    font-family: var(--gs2-body-font);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .gs2 { --gs2-pad: var(--gs2-pad-d); --gs2-tag-size: var(--gs2-tag-size-d); --gs2-tag-pb: var(--gs2-tag-pb-d); --gs2-head-max: var(--gs2-head-max-d); }
  }
  #shopify-section-{{ sid }} .gs2[data-width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .gs2[data-width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .gs2[data-width='stretch_width'] { padding-inline: 3rem; } }
  #shopify-section-{{ sid }} .gs2__container { display: flex; flex-direction: var(--gs2-placement); align-items: center; gap: 24px; padding-block: var(--gs2-pad); padding-inline: 20px; margin: 0 auto; position: relative; overflow-x: clip; }
  #shopify-section-{{ sid }} .gs2__content { display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%; position: relative; z-index: 2; }
  #shopify-section-{{ sid }} .gs2__tagline { max-width: var(--gs2-head-max); width: 100%; margin: 0; padding-bottom: var(--gs2-tag-pb); color: var(--gs2-tag-color); font-size: var(--gs2-tag-size); font-weight: var(--gs2-tag-weight); font-family: var(--gs2-body-font); }
  #shopify-section-{{ sid }} .gs2__heading {
    --gs2-h-size: var(--gs2-h-size-m); --gs2-h-pb: var(--gs2-h-pb-m);
    max-width: var(--gs2-head-max); width: 100%; margin: 0; padding-bottom: var(--gs2-h-pb);
    color: var(--gs2-head-color); font-family: var(--gs2-heading-font); font-size: var(--gs2-h-size); font-weight: var(--gs2-h-weight); line-height: 1.3; overflow-wrap: anywhere;
  }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .gs2__heading { --gs2-h-size: var(--gs2-h-size-d); --gs2-h-pb: var(--gs2-h-pb-d); } }
  #shopify-section-{{ sid }} .gs2__btn { font-family: var(--gs2-body-font); }
  #shopify-section-{{ sid }} .gs2__btn[data-gs2-shape='custom'] { --mb-padding-y: var(--gs2-btn-py-m); --mb-padding-x: var(--gs2-btn-px-m); --mb-font-size: var(--gs2-btn-size-m); }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .gs2__btn[data-gs2-shape='custom'] { --mb-padding-y: var(--gs2-btn-py-d); --mb-padding-x: var(--gs2-btn-px-d); --mb-font-size: var(--gs2-btn-size-d); } }
  #shopify-section-{{ sid }} .gs2__btn[data-gs2-hover='none'] { --mb-hover-bg: var(--mb-rest); --mb-hover-text: var(--mb-ink); --mb-hover-border: var(--mb-line); }
  #shopify-section-{{ sid }} .gs2__btn:focus-visible, #shopify-section-{{ sid }} .gs2__arrow:focus-visible, #shopify-section-{{ sid }} .gs2__list:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  #shopify-section-{{ sid }} .gs2__stage { width: 100%; max-width: 420px; margin: 0 auto; position: relative; z-index: 1; }
  #shopify-section-{{ sid }} .gs2__list { display: flex; flex-direction: column; gap: 20px; width: 100%; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .gs2__item { position: relative; width: 100%; margin: 0; padding-bottom: var(--gs2-img-pb); }
  #shopify-section-{{ sid }} .gs2__item img { display: block; width: 100%; height: auto; margin: 0; border-radius: var(--gs2-radius); object-fit: cover; background: color-mix(in srgb, var(--color-text) 8%, var(--gs2-bg)); }
  #shopify-section-{{ sid }} .gs2__nav { display: none; justify-content: center; align-items: center; gap: var(--gs2-arrows-gap); padding-bottom: var(--gs2-carousel-pb); margin-top: 8px; }
  #shopify-section-{{ sid }} .gs2__arrow { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; margin: 0; border: 0; border-radius: 50%; background: transparent; color: var(--gs2-arrow); cursor: pointer; }
  #shopify-section-{{ sid }} .gs2__arrow svg { width: 24px; height: 24px; }
  @media (max-width: 767.98px) {
    #shopify-section-{{ sid }} .gs2[data-carousel='true'] .gs2__list { flex-direction: row; gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
    #shopify-section-{{ sid }} .gs2[data-carousel='true'] .gs2__list::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .gs2[data-carousel='true'] .gs2__item { flex: 0 0 100%; scroll-snap-align: center; }
    #shopify-section-{{ sid }} .gs2[data-carousel='true'] .gs2__item img { aspect-ratio: 1 / 1; height: auto; }
    #shopify-section-{{ sid }} .gs2[data-carousel='true'] .gs2__nav { display: flex; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .gs2__container { flex-direction: column; max-width: calc(var(--gs2-inner) + 40px); }
    #shopify-section-{{ sid }} .gs2__stage { max-width: 800px; }
    #shopify-section-{{ sid }} .gs2__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    #shopify-section-{{ sid }} .gs2__item { padding-bottom: 0; }
    #shopify-section-{{ sid }} .gs2__item img { aspect-ratio: 1 / 1; }
  }
  @media (min-width: 1096px) {
    #shopify-section-{{ sid }} .gs2__content { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(100% - 40px, var(--gs2-head-max)); }
    #shopify-section-{{ sid }} .gs2__stage { max-width: none; height: 1000px; }
    #shopify-section-{{ sid }} .gs2__list { display: block; position: absolute; inset: 0; }
    #shopify-section-{{ sid }} .gs2__item { position: absolute; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(n + 7) { display: none; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(1) { top: 0; left: 4.5%; width: 31.8%; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(2) { top: 3%; left: 38.2%; width: 30.9%; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(3) { top: 5.2%; right: 0; width: 29.1%; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(4) { top: 58%; left: 0; width: 32%; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(5) { bottom: 0; right: 0; width: 38.2%; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(5) img { aspect-ratio: 4 / 3; }
    #shopify-section-{{ sid }} .gs2__item:nth-child(6) { bottom: 3%; left: 39%; width: 20%; }
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .gs2__list { scroll-behavior: auto; } }
  {%- if button_block %}
  #shopify-section-{{ sid }} [data-mgb-block="{{ button_block.id }}"] {
    {%- if custom %}{% render 'button-overrides', bg: st.button_background_color, text: st.button_text_color, hover_border: st.button_border_hover_color %}{% endif %}
    {%- if bb.use_theme_button == false %}
    --mb-radius: {{ bb.button_border_radius | default: 0 }}px;
    --mb-weight: {{ bb.button_font_weight | default: 500 }};
    --gs2-btn-py-d: {{ bb.desktop_button_padding_vertical | default: 0 }}px; --gs2-btn-px-d: {{ bb.desktop_button_padding_horizontal | default: 0 }}px; --gs2-btn-size-d: {{ bb.button_font_size | default: 16 }}px;
    --gs2-btn-py-m: {{ bb.mobile_button_padding_vertical | default: 0 }}px; --gs2-btn-px-m: {{ bb.mobile_button_padding_horizontal | default: 0 }}px; --gs2-btn-size-m: {{ bb.button_font_size_mobile | default: 14 }}px;
    {%- endif %}
  }
  {%- endif %}
  {%- if heading_block %}
  #shopify-section-{{ sid }} [data-mgb-block="{{ heading_block.id }}"] {
    --gs2-h-size-d: {{ hb.desktop_heading_size | default: 42 }}px; --gs2-h-size-m: {{ hb.mobile_heading_size | default: 32 }}px;
    --gs2-h-pb-d: {{ hb.desktop_heading_padding_bottom | default: 0 }}px; --gs2-h-pb-m: {{ hb.mobile_heading_padding_bottom | default: 0 }}px;
    --gs2-h-weight: {{ heading_weight }};
  }
  {%- endif %}
{% comment %}{% endcomment %}</style>

<div id="loudz-{{ sid }}" class="gs2 loudz-{{ sid }} color-{{ color_scheme }} gradient" data-mgb="gallerysimple2" data-mgb-section="{{ sid }}" data-mgb-reset="{{ st.reset_spacing }}" data-mgb-anim="{{ settings.scroll_animation | default: 'none' }}" data-width="{{ st.section_width | default: 'full_width' }}" data-carousel="{{ st.carousel_on_mobile }}" data-mgb-placeholder-src="{{ placeholder }}" data-mgb-settings="{{ st | json | escape }}" data-mgb-defaults="{&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;full_width&quot;,&quot;reset_spacing&quot;:true,&quot;tagline&quot;:&quot;Latest interior designs&quot;,&quot;inner_width_px&quot;:1100,&quot;desktop_heading_max_width&quot;:700,&quot;image_border_radius&quot;:4,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;heading_weight&quot;:&quot;inherit&quot;,&quot;tagline_font_weight&quot;:&quot;400&quot;,&quot;desktop_tagline_size&quot;:16,&quot;mobile_tagline_size&quot;:16,&quot;reveal&quot;:true,&quot;desktop_top_padding&quot;:40,&quot;desktop_bottom_padding&quot;:40,&quot;desktop_tagline_padding_bottom&quot;:10,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;image_placement_mobile&quot;:&quot;column&quot;,&quot;mobile_heading_max_width&quot;:350,&quot;carousel_on_mobile&quot;:true,&quot;arrows_gap&quot;:30,&quot;carousel_bottom_padding&quot;:0,&quot;mobile_image_bottom_padding&quot;:24,&quot;mobile_tagline_padding_bottom&quot;:10,&quot;mobile_top_padding&quot;:20,&quot;mobile_bottom_padding&quot;:20,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0}" data-mgb-block-defaults="{&quot;heading&quot;:{&quot;heading&quot;:&quot;Share your best images&quot;,&quot;heading_weight&quot;:&quot;inherit&quot;,&quot;desktop_heading_size&quot;:42,&quot;mobile_heading_size&quot;:32,&quot;desktop_heading_padding_bottom&quot;:10,&quot;mobile_heading_padding_bottom&quot;:30},&quot;button&quot;:{&quot;button_text&quot;:&quot;Explore&quot;,&quot;button_target&quot;:&quot;_self&quot;,&quot;use_theme_button&quot;:true,&quot;button_hover&quot;:&quot;fade&quot;,&quot;button_font_size&quot;:16,&quot;button_font_size_mobile&quot;:14,&quot;button_font_weight&quot;:&quot;500&quot;,&quot;button_border_radius&quot;:8,&quot;desktop_button_padding_vertical&quot;:12,&quot;desktop_button_padding_horizontal&quot;:30,&quot;mobile_button_padding_vertical&quot;:10,&quot;mobile_button_padding_horizontal&quot;:24},&quot;gallery_image_02&quot;:{}}">
  <div{% if html_id != blank %} id="{{ html_id }}"{% endif %} class="gs2__container loudz__container{% if st.html_class != blank %} {{ st.html_class | replace: ',', ' ' | escape }}{% endif %}">
    <div class="gs2__content loudz__content">
      <p class="gs2__tagline loudz__tagline" data-mgb-tagline{% if st.tagline == blank %} hidden{% endif %}>{{ st.tagline }}</p>
      {%- if heading_block -%}
        <h2 class="gs2__heading loudz__header" data-mgb-block="{{ heading_block.id }}" data-mgb-type="heading" data-mgb-settings="{{ hb | json | escape }}" {{ heading_block.shopify_attributes }}{% if hb.heading == blank %} hidden{% endif %}>{{ hb.heading }}</h2>
      {%- endif -%}
      {%- if button_block -%}
        {%- capture btn_attrs -%}class="gs2__btn loudz__button" data-mgb-block="{{ button_block.id }}" data-mgb-type="button" data-mgb-settings="{{ bb | json | escape }}" data-gs2-shape="{% if bb.use_theme_button == false %}custom{% else %}theme{% endif %}"{% if bb.use_theme_button == false %} data-gs2-hover="{{ bb.button_hover | default: 'fade' }}"{% if bb.button_hover == 'invert' %} data-button-hover="reverse"{% elsif bb.button_hover == 'fade' %} data-button-hover="fade"{% endif %}{% endif %} {{ button_block.shopify_attributes }}{% if bb.button_text == blank %} hidden{% endif %}{%- endcapture -%}
        {%- if button_link != blank -%}
          <a {{ btn_attrs }} data-theme-button="primary" data-sl-button href="{{ button_link }}"{% if bb.button_target == '_blank' %} target="_blank" rel="noopener"{% endif %}>{{ bb.button_text | escape }}</a>
        {%- else -%}
          <button type="button" {{ btn_attrs }} data-theme-button="primary" data-sl-button>{{ bb.button_text | escape }}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="gs2__stage loudz__grid">
      <div class="gs2__list" data-mgb-track tabindex="0" role="region" aria-label="{{ hb.heading | strip_html | default: 'Gallery' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image_02' -%}
            {%- assign b = block.settings -%}
            {%- assign alt = b.image_alt | default: b.image.alt -%}
            <div class="gs2__item loudz__image" data-mgb-block="{{ block.id }}" data-mgb-type="gallery_image_02" data-mgb-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
              {%- if b.image != blank -%}
                <img src="{{ b.image | image_url: width: 1200 }}" srcset="{{ b.image | image_url: width: 600 }} 600w, {{ b.image | image_url: width: 1200 }} 1200w" sizes="(min-width: 1096px) 33vw, (min-width: 768px) 50vw, 100vw" width="{{ b.image.width | default: 1200 }}" height="{{ b.image.height | default: 1200 }}" alt="{{ alt | escape }}" loading="lazy" decoding="async">
              {%- else -%}
                <img src="{{ placeholder }}" data-mgb-placeholder width="400" height="300" alt="{{ alt | escape }}" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="gs2__nav loudz__nav-arrows">
        <button class="gs2__arrow loudz__arrow prev-arrow" type="button" data-mgb-prev aria-label="Previous image">
          <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true" focusable="false"><path d="M768 903.232l-50.432 56.768L256 512l461.568-448 50.432 56.768L364.928 512z"/></svg>
        </button>
        <button class="gs2__arrow loudz__arrow next-arrow" type="button" data-mgb-next aria-label="Next image">
          <svg viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true" focusable="false"><path d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "gallerysimple2",
  "name": "Gallery Simple 5",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Section Header"
    },
    {
      "type": "inline_richtext",
      "id": "tagline",
      "label": "Tagline text",
      "default": "Latest interior designs",
      "info": "Short text above the heading."
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Header Typography"
    },
    {
      "type": "select",
      "id": "heading_weight",
