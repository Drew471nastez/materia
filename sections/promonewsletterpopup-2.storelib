        "default": 10,
        "visible_if": "{{ section.settings.open_mode == 'inactivity' }}"
      },
      {
        "type": "range",
        "id": "scroll_pct",
        "label": "Scrolled",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 50,
        "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
      },
      {
        "type": "range",
        "id": "page_views",
        "label": "Page views",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 2,
        "visible_if": "{{ section.settings.open_mode == 'pageviews' }}"
      },
      {
        "type": "checkbox",
        "id": "exit_intent",
        "label": "Also open on exit intent",
