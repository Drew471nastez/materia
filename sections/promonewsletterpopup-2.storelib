  "shopify": {
    "name": "Promotional Newsletter 2",
    "class": "loudz-section loudz-newsletter-3",
    "tag": "section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Trigger"
      },
      {
        "type": "checkbox",
        "id": "render_as_popup",
        "label": "Show as a popup",
        "default": true
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "Opens",
        "default": "delay",
        "options": [
          {
            "value": "immediate",
            "label": "On page load"
          },
          {
            "value": "delay",
            "label": "After a delay"
          },
          {
            "value": "scroll",
            "label": "On scroll"
          },
          {
            "value": "exit",
            "label": "On exit intent"
          },
          {
            "value": "inactivity",
            "label": "When idle"
          },
          {
            "value": "pageviews",
            "label": "After page views"
          },
          {
            "value": "manual",
            "label": "From a link"
          }
        ]
      },
      {
        "type": "number",
        "id": "popup_delay",
        "label": "Delay (seconds)",
        "default": 0
      },
      {
        "type": "range",
        "id": "inactivity_s",
