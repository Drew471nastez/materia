            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra Bold"
              }
            ]
          },
          {
            "type": "header",
            "content": "Color"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Heading color",
            "default": "#000000"
          }
        ]
      },
      {
        "type": "description",
        "name": "Description",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Description",
            "default": "Fill in your email and get access to all the amazing offers. Check your email."
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "min": 10,
            "max": 32,
            "step": 1,
            "unit": "px",
            "label": "Desktop font size",
            "default": 16
          },
          {
            "type": "range",
            "id": "size_mobile",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Mobile font size",
            "default": 16
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Font weight",
            "default": "400",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi Bold"
              },
