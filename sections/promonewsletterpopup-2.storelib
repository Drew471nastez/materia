            "id": "color",
            "label": "Description color",
            "default": "#4B4D6C"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image / Icon",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Icon (above heading)"
          },
          {
            "type": "checkbox",
            "id": "disable_icon",
            "label": "Hide icon area",
            "default": true
          },
          {
            "type": "select",
            "id": "icon_source",
            "label": "Icon source",
            "default": "preset",
            "info": "Theme logo auto-fetches your store logo from theme settings.",
            "options": [
              {
                "value": "theme_logo",
                "label": "Theme logo (auto)"
              },
              {
                "value": "preset",
                "label": "Preset icon"
              },
              {
                "value": "upload",
                "label": "Upload my own image"
