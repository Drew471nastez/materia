          },
          {
            "type": "select",
            "id": "preset_icon",
            "label": "Preset icon",
            "default": "envelope",
            "info": "Only used when Icon source = Preset icon.",
            "options": [
              {
                "value": "envelope",
                "label": "Envelope"
              },
              {
                "value": "gift",
                "label": "Gift"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
