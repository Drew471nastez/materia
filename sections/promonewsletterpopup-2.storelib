              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Subscribe to get exclusive offers!"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "min": 12,
            "max": 72,
            "step": 1,
            "unit": "px",
            "label": "Desktop font size",
            "default": 29
          },
          {
            "type": "range",
            "id": "size_mobile",
