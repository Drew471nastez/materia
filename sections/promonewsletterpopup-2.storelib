<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- comment -%} A popup never takes the scroll reveal: an opacity or transform on the section would hide or move its fixed card. {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.render_as_popup == false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Popup must escape section stacking contexts to render above all other content */
  #shopify-section-{{ section.id }} {
    position: static;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{% capture html_id %} 
	{% if section.settings.html_id != blank %}
		id= "{{ section.settings.html_id | handleize }}"
	{% endif %}
{% endcapture %}

{% stylesheet %}
	.loudz-newsletter-3 * {
		margin: 0;
		padding: 0;
	}

	.loudz-newsletter-3 a {
		color: inherit;
	}

	.loudz-newsletter-3 .loudz__popup {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		align-items: center;
		justify-content: center;
		height: calc(var(--sl-vh, 1vh) * 100);
		position: fixed;
		inset: 0;
		z-index: 2147483647;
		transition: opacity 0.3s ease, visibility 0s linear 0.3s;
	}

	.loudz-newsletter-3 .loudz__popup.active {
		visibility: visible;
		pointer-events: auto;
		opacity: 1;
		transition-delay: 0s;
	}
	.loudz-newsletter-3 .loudz__popup .loudz__container {
		transform: translateY(16px) scale(.98);
		transition: transform .35s cubic-bezier(.2,.8,.2,1);
	}
	.loudz-newsletter-3 .loudz__popup.active .loudz__container { transform: none; }

	.loudz-newsletter-3 .loudz__popup:after {
    content: "";
  position: fixed;       /* fixes it to the viewport */
  top: 0;                /* anchor to top */
  left: 0;               /* anchor to left */
  width: 100%;           /* span entire width */
  height: 100%;          /* span entire height */
  background-color: var(--loudz-overlay-color, #000000);
  opacity: var(--loudz-overlay-opacity, 0.5);
  z-index: -1;
	}
	
	.loudz-newsletter-3 .loudz__container {
		position: relative;
		padding-block: var(--loudz-padding-top, 0px) var(--loudz-padding-bottom, 0px);
		background: var(--loudz-section-background, #FFFFFF);
		max-width: var(--loudz-section-width, 790px);
		flex-direction: var(--loudz-image-position, row);
		gap: var(--loudz-horizontal-gap, 50px);
		margin-inline: auto;
		padding-inline: 20px;
		width: calc(100% - 40px);
		justify-content: center;
		align-items: center;
		max-height: calc(var(--sl-vh, 1vh) * 90);
		overflow-y: auto;
		overscroll-behavior: contain;
		border-radius: var(--loudz-popup-border-radius, 0px);
	}

	.loudz-newsletter-3 .loudz__container::-webkit-scrollbar {
  	display: none;	
	}	

	.loudz-newsletter-3 .loudz__container.active {
		opacity: 1;
		visibility: visible;
	}
	
	.loudz-newsletter-3 .loudz__flex {
		display: flex;
	}

	.loudz-newsletter-3 .loudz__icon {
		width: var(--loudz-icon-width, 72px);
		font-size: 0;
		color: var(--loudz-svg-color, #000000);
	}

	/* Centered icon variant — used by block-driven render */
	.loudz-newsletter-3 .loudz__icon--centered {
		width: var(--pn-icon-size, 72px);
		height: var(--pn-icon-size, 72px);
		max-width: var(--loudz-icon-width, 100%);
		max-height: var(--loudz-icon-width, none);
		color: var(--pn-icon-color, currentColor);
		margin-left: auto;
		margin-right: auto;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.loudz-newsletter-3 .loudz__icon--centered svg,
	.loudz-newsletter-3 .loudz__icon--centered img,
	.loudz-newsletter-3 .loudz__icon--centered .loudz__logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		max-height: var(--pn-icon-size, 72px);
	}
	.loudz-newsletter-3 .loudz__logo-fallback {
		font-weight: 800;
		font-size: 18px;
		color: var(--pn-icon-color, currentColor);
		text-align: center;
	}

	.loudz-newsletter-3 .loudz__icon.loudz-svg-custom {
		width: var(--loudz-svg-size, 72px);
		height: var(--loudz-svg-size, 72px);
	}

	.loudz-newsletter-3 .loudz__icon svg {
		width: 100%;
		height: 100%;
		object-fit: contain;
		stroke: currentColor;
	}
	
	.loudz-newsletter-3 .loudz__top-text {
		font-size: var(--loudz-top-text-size, 18px);
		font-weight: var(--loudz-top-text-weight, 400);
		color: var(--loudz-heading-color, #000000);
		text-align: center;
		margin-bottom: var(--loudz-top-text-to-heading-gap, 8px);
	}
	
	.loudz-newsletter-3 .loudz__form {
		background: var(--loudz-section-background, #FFFFFF);
		flex: 1 1 0;
		min-width: 0;
		max-width: 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: static;
		padding: 0;
	}
	@media screen and (min-width: 768px) {
		.loudz-newsletter-3 .loudz__form {
			max-width: 420px;
		}
	}
	
	.loudz-newsletter-3 .loudz__form .loudz__popup-link {
		color: var(--loudz-popup-link-color, #000000);
		font-size: 16px;
		font-weight: 400;
		margin-top: 20px;
		cursor: pointer;
		transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
	}
	
	.loudz-newsletter-3 .loudz__form .loudz__popup-link a {
		border-bottom: 1px solid currentColor;
		text-decoration: none;
		color: inherit;
	}
	
	.loudz-newsletter-3 .loudz__form .loudz__popup-link:hover {
		opacity: 0.7;
	}
	
	.loudz-newsletter-3 .loudz__overlay {
		background-color: var(--loudz-overlay-color);
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
		visibility: hidden;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: -1;
	}
	
	.loudz-newsletter-3 .loudz__overlay.active {
		opacity: var(--loudz-overlay-opacity, 1);
		visibility: visible;
	}
	
	.loudz-newsletter-3 .loudz__form form {
		margin-top: var(--loudz-form-top-space, 32px);
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	/* The phone-field snippet renders inside a wrapper div; tighten its own
	   internal spacing so it sits as a single visual row in the form column. */
	.loudz-newsletter-3 .loudz__form form .cpnb-phone { margin: 0; }
	.loudz-newsletter-3 .loudz__form form input[type="email"] { margin-top: 0; margin-bottom: 0; }
	.loudz-newsletter-3 .loudz__form form .loudz__submit-button { margin-top: calc(var(--loudz-button-top-space, 12px) - 12px); }
	
	.loudz-newsletter-3 .loudz__heading {
		font-size: var(--loudz-heading-size, 24px);
		font-weight: var(--loudz-heading-text-weight, 500);
		color: var(--loudz-heading-color, #000000);
		margin-top: var(--loudz-heading-top-space, 16px);
		text-align: center;
	}
	
	.loudz-newsletter-3 .loudz__heading a {
		color: inherit;
	}
	
	.loudz-newsletter-3 p {
		font-size: var(--loudz-description-size, 16px);
		font-weight: var(--loudz-description-text-weight, 400);
		color: var(--loudz-description-color, var(--color-text));
		margin-top: var(--loudz-description-top-space, 16px);
		text-align: center;
	}

	.loudz-newsletter-3 .loudz__icon img,
	.loudz-newsletter-3 .loudz__icon svg {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	
	.loudz-newsletter-3 input[type="email"] {
		width: 100%;
		color: var(--loudz-input-color, #000000);
		font-size: var(--loudz-input-text-size, 16px);
		font-weight: var(--loudz-input-text-weight, 400);
		border: var(--loudz-input-border-thickness, 1px) solid var(--loudz-input-border-color, #808080);
		border-radius: var(--loudz-input-border-radius, 0px);
		background: var(--loudz-input-background-color, var(--input-bg));
		min-height: var(--loudz-input-height, 0px);
		padding: var(--loudz-input-padding, 16px 12px);
		transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
	}
	.loudz-newsletter-3 input[type="email"]:focus-visible {
		outline: none;
		border-color: var(--color-heading);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent);
	}
	
	.loudz-newsletter-3 input[type="email"]::placeholder {
		color: var(--loudz-input-placeholder-color);
	}
	
	/* The submit is a theme button (theme-button-contract.css): Theme settings >
	   Buttons draw it. Colours set on the block, and the shape when the theme
	   style is off, reach it as --mb-* tokens; an unset token falls back to the
	   theme. */
	.loudz-newsletter-3 .loudz__submit-button {
		width: 100%;
		margin-top: var(--loudz-button-top-space, 12px);
		cursor: pointer;
		--mb-bg: var(--loudz-button-background-color);
		--mb-text: var(--loudz-button-text-color);
		--mb-hover-bg: var(--loudz-button-background-color-hover);
		--mb-hover-text: var(--loudz-button-text-color-hover);
		--mb-radius: var(--loudz-button-border-radius);
		--mb-font-size: var(--loudz-button-text-size);
		--mb-weight: var(--loudz-button-text-weight);
	}
	@media (prefers-reduced-motion: reduce) {
		.loudz-newsletter-3 .loudz__popup,
		.loudz-newsletter-3 .loudz__container,
		.loudz-newsletter-3 .loudz__popup-link,
		.loudz-newsletter-3 input[type="email"],
		.loudz-newsletter-3 .loudz__popup .loudz__container { transition: none; transform: none; }
	}
	
	.loudz-newsletter-3 .loudz__image-wrapper {
		background-color: color-mix(in srgb, var(--color-heading) 6%, var(--color-background));
		position: relative;
		aspect-ratio: 1 / 1;
		align-self: stretch;
		overflow: hidden;
		/* Mobile: escape the popup's 20px inline padding so the image is flush
		   with the popup edges (full-bleed on the top of the popup). */
		width: calc(100% + 40px);
		margin-inline: -20px;
		margin-top: calc(var(--loudz-padding-top, 0px) * -1);
	}

	.loudz-newsletter-3 .loudz__image-wrapper svg,
	.loudz-newsletter-3 .loudz__image-wrapper img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	
	.loudz-newsletter-3 .loudz__close {
		color: var(--color-heading);
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: absolute;
		top: 16px;
		right: 16px;
		cursor: pointer;
		z-index: 2;
	}
	.loudz-newsletter-3 .loudz__close:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
	.loudz-newsletter-3 .loudz__close:focus-visible,
	.loudz-newsletter-3 .loudz__popup-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
	.loudz-newsletter-3 .loudz__close .icon-close { width: 16px; height: 16px; }
	.loudz-newsletter-3 .loudz__popup-link { background: none; border: 0; font: inherit; cursor: pointer; min-height: 44px; padding: 8px 12px; }
	.loudz-newsletter-3 .loudz__placeholder { width: 100%; height: 100%; background: color-mix(in srgb, var(--color-heading) 8%, var(--color-background)); fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
	
	@media screen and (min-width: 768px) {
		.loudz-newsletter-3 .loudz__form {
			padding-block: 40px;
			position: relative;
		}

		.loudz-newsletter-3 .loudz__image-wrapper {
			aspect-ratio: auto;
			flex: 1 1 0;
			min-width: 0;
			max-width: 50%;
			align-self: stretch;
			/* Desktop: image is the side panel — flush to its popup edge.
			   The container has padding-inline: 20px; we counter the side
			   that the image is on so the image hits the popup edge. */
			width: calc(50% + 20px);
			margin-inline: 0;
			margin-top: 0;
		}
		/* When image is on the LEFT of the form (default flex-direction: row),
		   escape the container's left padding. When on the right (row-reverse),
		   escape the right padding. The image-position CSS var drives this. */
		.loudz-newsletter-3 .loudz__container[style*="row-reverse"] .loudz__image-wrapper,
		.loudz-newsletter-3 .loudz__container { /* default row */ }
		.loudz-newsletter-3 .loudz__container .loudz__image-wrapper:first-child { margin-left: -20px; }
		.loudz-newsletter-3 .loudz__container .loudz__image-wrapper:last-child { margin-right: -20px; }

		.loudz-newsletter-3 .loudz__close {
			top: 12px;
			right: 8px;
		}
	}
{% endstylesheet %}

{%- comment -%}
  Block resolution: each content piece is a block (limit 1). If no block of a
  given type exists, fall back to the legacy section settings so existing
  popups keep rendering exactly as before.
{%- endcomment -%}
{%- assign block_top = blank -%}
{%- assign block_heading = blank -%}
{%- assign block_description = blank -%}
{%- assign block_image = blank -%}
{%- assign block_form = blank -%}
{%- assign block_button = blank -%}
{%- assign block_dismiss = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'top_text' -%}{%- assign block_top = b -%}
    {%- when 'heading' -%}{%- assign block_heading = b -%}
    {%- when 'description' -%}{%- assign block_description = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
    {%- when 'form' -%}{%- assign block_form = b -%}
    {%- when 'button' -%}{%- assign block_button = b -%}
    {%- when 'dismiss' -%}{%- assign block_dismiss = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- if block_top != blank -%}
  {%- assign pn_enable_top_text = block_top.settings.enabled -%}
  {%- assign pn_top_text = block_top.settings.text -%}
  {%- assign pn_top_text_size_d = block_top.settings.size_desktop -%}
  {%- assign pn_top_text_size_m = block_top.settings.size_mobile -%}
  {%- assign pn_top_text_weight = block_top.settings.weight -%}
{%- else -%}
  {%- assign pn_enable_top_text = section.settings.enable_top_text -%}
  {%- assign pn_top_text = section.settings.top_text -%}
  {%- assign pn_top_text_size_d = section.settings.desktop_top_text_size -%}
  {%- assign pn_top_text_size_m = section.settings.mobile_top_text_size -%}
  {%- assign pn_top_text_weight = section.settings.top_text_weight -%}
{%- endif -%}

{%- if block_heading != blank -%}
  {%- assign pn_heading = block_heading.settings.text -%}
  {%- assign pn_heading_color = block_heading.settings.color -%}
  {%- assign pn_heading_size_d = block_heading.settings.size_desktop -%}
  {%- assign pn_heading_size_m = block_heading.settings.size_mobile -%}
  {%- assign pn_heading_weight = block_heading.settings.weight -%}
{%- else -%}
  {%- assign pn_heading = section.settings.heading -%}
  {%- assign pn_heading_color = section.settings.heading_color -%}
  {%- assign pn_heading_size_d = section.settings.desktop_heading_text_size -%}
  {%- assign pn_heading_size_m = section.settings.mobile_heading_text_size -%}
  {%- assign pn_heading_weight = section.settings.heading_text_weight -%}
{%- endif -%}

{%- if block_description != blank -%}
  {%- assign pn_description = block_description.settings.text -%}
  {%- assign pn_description_color = block_description.settings.color -%}
  {%- assign pn_description_size_d = block_description.settings.size_desktop -%}
  {%- assign pn_description_size_m = block_description.settings.size_mobile -%}
  {%- assign pn_description_weight = block_description.settings.weight -%}
{%- else -%}
  {%- assign pn_description = section.settings.description -%}
  {%- assign pn_description_color = section.settings.description_color -%}
  {%- assign pn_description_size_d = section.settings.desktop_description_text_size -%}
  {%- assign pn_description_size_m = section.settings.mobile_description_text_size -%}
  {%- assign pn_description_weight = section.settings.description_text_weight -%}
{%- endif -%}

{%- comment -%}
  Main popup image now lives at the section level (settings.image). The
  Image / Icon block still controls the small icon above the heading.
{%- endcomment -%}
{%- assign pn_image = section.settings.image -%}

{%- if block_image != blank -%}
  {%- assign pn_popup_icon = block_image.settings.icon -%}
  {%- assign pn_icon_source = block_image.settings.icon_source | default: 'default_svg' -%}
  {%- assign pn_preset_icon = block_image.settings.preset_icon | default: 'envelope' -%}
  {%- assign pn_disable_icon = block_image.settings.disable_icon -%}
  {%- assign pn_custom_svg_code = block_image.settings.custom_svg_code -%}
  {%- assign pn_icon_size = block_image.settings.icon_size | default: 72 -%}
  {%- assign pn_icon_color = block_image.settings.icon_color -%}
{%- else -%}
  {%- assign pn_popup_icon = section.settings.popup_icon -%}
  {%- assign pn_icon_source = 'default_svg' -%}
  {%- assign pn_preset_icon = 'envelope' -%}
  {%- assign pn_disable_icon = section.settings.disable_icon -%}
  {%- assign pn_custom_svg_code = section.settings.custom_svg_code -%}
  {%- assign pn_icon_size = section.settings.svg_size | default: 72 -%}
  {%- assign pn_icon_color = section.settings.svg_color -%}
{%- endif -%}

{%- comment -%} Subscribe form block (email input only) {%- endcomment -%}
{%- if block_form != blank -%}
  {%- assign pn_placeholder_text = block_form.settings.placeholder_text -%}
  {%- assign pn_input_size_d = block_form.settings.input_size_desktop -%}
  {%- assign pn_input_size_m = block_form.settings.input_size_mobile -%}
  {%- assign pn_input_weight = block_form.settings.input_weight -%}
{%- else -%}
  {%- assign pn_placeholder_text = 'Email address' -%}
  {%- assign pn_input_size_d = 16 -%}
  {%- assign pn_input_size_m = 16 -%}
  {%- assign pn_input_weight = '400' -%}
{%- endif -%}

{%- comment -%} Submit button block (all button visual settings live here) {%- endcomment -%}
{%- if block_button != blank -%}
  {%- assign pn_button_text = block_button.settings.button_text -%}
  {%- assign pn_button_bg = block_button.settings.button_background -%}
  {%- assign pn_button_text_color = block_button.settings.button_text_color -%}
  {%- assign pn_button_bg_hover = block_button.settings.button_background_hover -%}
  {%- assign pn_button_text_hover = block_button.settings.button_text_hover -%}
  {%- assign pn_button_size_d = block_button.settings.button_size_desktop -%}
  {%- assign pn_button_size_m = block_button.settings.button_size_mobile -%}
  {%- assign pn_button_weight = block_button.settings.button_weight -%}
  {%- assign pn_button_border_radius = block_button.settings.button_border_radius -%}
  {%- assign pn_button_hover_ms = block_button.settings.hover_transition | default: 250 -%}
  {%- assign pn_use_theme_button = true -%}
  {%- if block_button.settings.use_theme_button == false -%}{%- assign pn_use_theme_button = false -%}{%- endif -%}
{%- else -%}
  {%- assign pn_use_theme_button = true -%}
  {%- assign pn_button_text = 'Subscribe Now!' -%}
  {%- assign pn_button_bg = '' -%}
  {%- assign pn_button_text_color = '' -%}
  {%- assign pn_button_bg_hover = '' -%}
  {%- assign pn_button_text_hover = '' -%}
  {%- assign pn_button_size_d = 16 -%}
  {%- assign pn_button_size_m = 16 -%}
  {%- assign pn_button_weight = '700' -%}
  {%- assign pn_button_border_radius = 8 -%}
  {%- assign pn_button_hover_ms = 250 -%}
{%- endif -%}

{%- if block_dismiss != blank -%}
  {%- assign pn_popup_link = block_dismiss.settings.text -%}
{%- else -%}
  {%- assign pn_popup_link = section.settings.popup_link -%}
{%- endif -%}

<style>
	#loudz-{{ section.id }} {
		--loudz-padding-top: {{ section.settings.mobile_top_padding }}px;
    --loudz-padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
		--loudz-section-width: {{ section.settings.inner_width }}px;
		--loudz-section-background: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %}{% endif %} !important;
		--loudz-overlay-color: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %} !important;
		--loudz-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
		--loudz-icon-width: {{ section.settings.mobile_icon_width }}px;
		--loudz-svg-size: {{ section.settings.svg_size }}px;
		--loudz-svg-color: {{ section.settings.svg_color }} !important;
		--loudz-image-position: {{ section.settings.mobile_image_position }};
		--loudz-heading-top-space: {{ section.settings.mobile_heading_top_space }}px;
		--loudz-heading-size: {{ pn_heading_size_m }}px;
		--loudz-heading-text-weight: {{ pn_heading_weight }};
		--loudz-heading-color: {% render 'scheme-color', color: pn_heading_color, fallback: 'var(--color-heading)' %} !important;
		--loudz-description-top-space: {{ section.settings.mobile_top_space }}px;
		--loudz-description-size: {{ pn_description_size_m }}px;
		--loudz-description-text-weight: {{ pn_description_weight }};
		--loudz-description-color: {% render 'scheme-color', color: pn_description_color, fallback: 'var(--color-text)' %} !important;
		--loudz-form-top-space: {{ section.settings.mobile_form_top_space }}px;
		--loudz-input-text-size: {{ pn_input_size_m }}px;
		--loudz-input-color: {% render 'scheme-color', color: section.settings.input_color, fallback: 'var(--input-color)' %} !important;
		--loudz-input-background-color: {% render 'scheme-color', color: section.settings.input_background_color, fallback: 'var(--input-bg)' %} !important;
		--loudz-input-text-weight: {{ pn_input_weight }};
		--loudz-input-border-color: {% render 'scheme-color', color: section.settings.input_border_color, fallback: 'var(--color-border)' %} !important;
		--loudz-input-placeholder-color: {% render 'scheme-color', color: section.settings.input_placeholder_color, fallback: 'var(--input-placeholder-color)' %} !important;
		{%- if section.settings.use_theme_fields != false %}
		--loudz-input-border-radius: var(--input-border-radius, {{ section.settings.input_border_radius | default: 6 }}px);
		--loudz-input-border-thickness: var(--inputs-border-width, 1px);
		--loudz-input-height: var(--input-height, 0px);
		--loudz-input-padding: var(--input-padding, 16px 12px);
		{%- else %}
		--loudz-input-border-radius: {{ section.settings.input_border_radius }}px;
		--loudz-input-border-thickness: {{ section.settings.input_border_thickness }}px;
		{%- endif %}
		--loudz-button-top-space: {{ section.settings.mobile_button_top_space }}px;
		--loudz-button-width: {{ section.settings.button_width }}%;
		--loudz-button-text-color: {% render 'scheme-color', color: pn_button_text_color, fallback: 'var(--btn-primary-color)' %} !important;
		--loudz-button-background-color: {% render 'scheme-color', color: pn_button_bg, fallback: 'var(--btn-primary-bg-color)' %} !important;
		--loudz-button-text-color-hover: {% render 'scheme-color', color: pn_button_text_hover, fallback: 'var(--btn-primary-hover-color)' %};
		--loudz-button-background-color-hover: {% render 'scheme-color', color: pn_button_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
		{%- unless pn_use_theme_button %}
		--loudz-button-border-radius: {{ pn_button_border_radius }}px;
		--loudz-button-text-size: {{ pn_button_size_m }}px;
		--btn-anim-duration: {{ pn_button_hover_ms }}ms;
		--loudz-button-text-weight: {{ pn_button_weight }};
		{%- endunless %}
		--loudz-horizontal-gap : {{ section.settings.desktop_gap_between_image_form }}px;
		--loudz-popup-link-color: {% render 'scheme-color', color: section.settings.popup_link_color, fallback: 'var(--color-text)' %} !important;
		--loudz-popup-border-radius: {{ section.settings.popup_border_radius }}px;
		--loudz-top-text-size: {{ pn_top_text_size_m }}px;
		--loudz-top-text-weight: {{ pn_top_text_weight }};
		--loudz-top-text-to-heading-gap: {{ section.settings.top_text_to_heading_gap }}px;
		}

	@media screen and (min-width: 768px) {
		#loudz-{{ section.id }} {
			--loudz-padding-top: {{ section.settings.desktop_top_padding }}px;
			--loudz-padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
			--loudz-icon-width: {{ section.settings.desktop_icon_width }}px;
			--loudz-heading-top-space: {{ section.settings.desktop_heading_top_space }}px;
			--loudz-heading-size: {{ pn_heading_size_d }}px;
			--loudz-description-top-space: {{ section.settings.desktop_top_space }}px;
			--loudz-description-size: {{ pn_description_size_d }}px;
			--loudz-form-top-space: {{ section.settings.desktop_form_top_space }}px;
			--loudz-input-text-size: {{ pn_input_size_d }}px;
			--loudz-button-top-space: {{ section.settings.desktop_button_top_space }}px;
			{%- unless pn_use_theme_button %}
			--loudz-button-text-size: {{ pn_button_size_d }}px;
			{%- endunless %}
			--loudz-horizontal-gap: {{ section.settings.desktop_gap_between_image_form }}px;
			--loudz-image-position: {{ section.settings.desktop_image_position }};
			--loudz-top-text-size: {{ pn_top_text_size_d }}px;
		}
	}
	@media screen and (min-width: 1024px) {
  .loudz__form.loudz__flex {
    margin-left: 0;    /* reset */
    transform: translateX(-12px); /* move left by 50px */
  }
}

{% comment %}{% endcomment %}</style>



{%- liquid
  assign pn_preview = false
  if section.settings.enable_edit_mode or section.settings.enable_customization_mode
    assign pn_preview = true
  endif
-%}
{%- capture pn_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ pn_preview | json }},
   "trigger": {"mode": {{ section.settings.open_mode | default: 'delay' | json }}, "delay": {{ section.settings.popup_delay | default: 0 | json }}, "idle": {{ section.settings.inactivity_s | default: 10 | json }}, "scroll": {{ section.settings.scroll_pct | default: 50 | json }}, "views": {{ section.settings.page_views | default: 2 | json }}, "exit": {{ section.settings.exit_intent | json }} },
   "frequency": {"mode": "after_days", "days": {% if section.settings.hide_days > 0 %}{{ section.settings.hide_days }}{% else %}1{% endif %}, "session": {{ section.settings.once_per_session | json }} } }
{%- endcapture -%}
<div id="loudz-{{ section.id }}" class="loudz-newsletter-3 loudz-{{ section.id }} color-{{ color_scheme }}"
     {% if section.settings.render_as_popup != false %}data-popup-root="{{ section.id }}" data-popup-config="{{ pn_config | strip_newlines | escape }}" aria-hidden="true"{% endif %}>
	<div {{ html_id }} class="{{'loudz__popup loudz__flex '| append: section.settings.html_class | strip }}">
		<div class="loudz__container loudz__flex" role="dialog" aria-modal="true" aria-labelledby="loudz-title-{{ section.id }}" tabindex="-1">
			<button type="button" class="loudz__close" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
				<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-close" fill="none" viewBox="0 0 18 17">
					<path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"/>
				</svg>
			</button>
			<div class="loudz__image-wrapper"{% if block_image != blank %} {{ block_image.shopify_attributes }}{% endif %}>
				{% if pn_image != blank %}
					{{ pn_image | image_url: width: 900 | image_tag:
					    loading: 'lazy',
					    class: 'loudz__img',
					    alt: pn_image.alt | default: shop.name,
					    sizes: '(min-width: 768px) 50vw, 100vw',
					    widths: '360,540,720,900' }}
				{% else %}
					{{ 'lifestyle-1' | placeholder_svg_tag: 'loudz__img loudz__placeholder' }}
				{% endif %}
			</div>

<div class="loudz__form loudz__flex">
	{% unless pn_disable_icon %}
	<div class="loudz__icon loudz__icon--centered{% if pn_custom_svg_code != blank and pn_icon_source == 'custom_svg' %} loudz-svg-custom{% endif %}"
	     style="--pn-icon-size: {{ pn_icon_size }}px; --pn-icon-color: {% render 'scheme-color', color: pn_icon_color, fallback: 'var(--color-heading)' %};"
	     {% if block_image != blank %} {{ block_image.shopify_attributes }}{% endif %}>
		{%- case pn_icon_source -%}
			{%- when 'theme_logo' -%}
				{%- if settings.logo != blank -%}
					{{ settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name, class: 'loudz__logo' }}
				{%- else -%}
					<span class="loudz__logo-fallback">{{ shop.name }}</span>
				{%- endif -%}
			{%- when 'upload' -%}
				{%- if pn_popup_icon != blank -%}
					{{ pn_popup_icon | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
				{%- else -%}
					{%- comment -%} fall back to a preset if no upload yet {%- endcomment -%}
					{%- render 'cpnb-preset-icon', name: pn_preset_icon -%}
				{%- endif -%}
			{%- when 'custom_svg' -%}
				{%- if pn_custom_svg_code != blank -%}
					{{ pn_custom_svg_code }}
				{%- else -%}
					{%- render 'cpnb-preset-icon', name: pn_preset_icon -%}
				{%- endif -%}
			{%- when 'preset' -%}
				{%- render 'cpnb-preset-icon', name: pn_preset_icon -%}
			{%- else -%}
				{%- comment -%} default_svg : original envelope icon {%- endcomment -%}
				<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M10 9.66679L11.3846 11.0001L14.5 8.00012M3.02832 10.0001L10.2246 14.8167C10.8661 15.2444 11.1869 15.4582 11.5336 15.5413C11.8399 15.6147 12.1593 15.6147 12.4657 15.5413C12.8124 15.4582 13.1332 15.2444 13.7747 14.8167L20.971 10.0001M10.2981 4.06892L4.49814 7.71139C3.95121 8.05487 3.67775 8.2266 3.4794 8.45876C3.30385 8.66424 3.17176 8.90317 3.09111 9.16112C3 9.45256 3 9.77548 3 10.4213V16.8001C3 17.9202 3 18.4803 3.21799 18.9081C3.40973 19.2844 3.71569 19.5904 4.09202 19.7821C4.51984 20.0001 5.0799 20.0001 6.2 20.0001H17.8C18.9201 20.0001 19.4802 20.0001 19.908 19.7821C20.2843 19.5904 20.5903 19.2844 20.782 18.9081C21 18.4803 21 17.9202 21 16.8001V10.4213C21 9.77548 21 9.45256 20.9089 9.16112C20.8282 8.90317 20.6962 8.66424 20.5206 8.45876C20.3223 8.2266 20.0488 8.05487 19.5019 7.71139L13.7019 4.06891C13.0846 3.68129 12.776 3.48747 12.4449 3.41192C12.152 3.34512 11.848 3.34512 11.5551 3.41192C11.224 3.48747 10.9154 3.68129 10.2981 4.06892Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
		{%- endcase -%}
				</div>
	{% endunless %}
	{% if pn_enable_top_text %}
	<div class="loudz__top-text"{% if block_top != blank %} {{ block_top.shopify_attributes }}{% endif %}>{{ pn_top_text }}</div>
	{% endif %}
				<h2 class="loudz__heading" id="loudz-title-{{ section.id }}"{% if block_heading != blank %} {{ block_heading.shopify_attributes }}{% endif %}>{{ pn_heading }}</h2>
				<p{% if block_description != blank %} {{ block_description.shopify_attributes }}{% endif %}>{{ pn_description }}</p>
				<form class="loudz__signup" data-storelib-form="subscribe">
					<input type="email" name="email" autocomplete="email" required placeholder="{{ pn_placeholder_text | escape }}" aria-label="{{ pn_placeholder_text | default: 'Email' | escape }}" data-popup-autofocus>
					{%- if block_form != blank and block_form.settings.collect_phone -%}
					  {%- if block_form.settings.phone_required -%}{%- assign pn_phone_req = 'true' -%}{%- else -%}{%- assign pn_phone_req = 'false' -%}{%- endif -%}
					  {%- render 'cpnb-phone-field',
					      scope: section.id,
					      default_country: block_form.settings.phone_default_country,
					      phone_placeholder: block_form.settings.phone_placeholder,
					      required: pn_phone_req -%}
					{%- endif -%}
					<button class="loudz__submit-button btn-primary" type="submit" data-theme-button="primary" data-sl-button{% if block_button != blank %} {{ block_button.shopify_attributes }}{% endif %}>{{ pn_button_text }}</button>
				</form>
				{% if pn_popup_link != blank %}
					<button type="button" class="loudz__popup-link" data-popup-close{% if block_dismiss != blank %} {{ block_dismiss.shopify_attributes }}{% endif %}>{{ pn_popup_link }}</button>
				{% endif %}
				</div>
		</div>
	</div>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  function setup(P){
    var root = document.getElementById('loudz-' + SID);
    if (!root || root.__pn2 || !root.hasAttribute('data-popup-root')) return;
    root.__pn2 = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var popup = root.querySelector('.loudz__popup');
    var box = root.querySelector('.loudz__container');
    var form = root.querySelector('form');
    var api = P.register({
      id: SID, root: root, dialog: box, backdrop: popup,
      design: CFG.design, preview: CFG.preview, trigger: CFG.trigger, frequency: CFG.frequency,
      open: function(){ popup.classList.add('active'); box.classList.add('active'); },
      close: function(){ popup.classList.remove('active'); box.classList.remove('active'); }
    });
    // Signed up (Storelib marks the form done): not offered again for 30 days.
    if (form) new MutationObserver(function(){
      if (form.getAttribute('data-state') === 'done' && api) api.done(30);
    }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
    window['openPromoNewsletter_' + SID] = function(){ api.show(); };
    window['closePromoNewsletter_' + SID] = function(){ api.hide(); };
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>

</template>

<schema>
{
  "type": "promonewsletterpopup-2",
  "name": "Promotional Newsletter 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "enable_customization_mode",
      "label": "Always show popup",
      "default": true
    },
    {
      "type": "number",
      "id": "popup_delay",
      "default": 0,
      "label": "Popup delay (seconds)"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Trigger / Display Behavior"
    },
    {
      "type": "checkbox",
      "id": "render_as_popup",
      "label": "Show as popup",
      "default": true
    },
    {
      "type": "select",
      "id": "open_mode",
      "label": "When to open",
      "default": "delay",
      "options": [
        {
          "value": "immediate",
          "label": "Immediately"
        },
        {
          "value": "delay",
          "label": "After delay"
        },
        {
          "value": "exit",
          "label": "Exit intent (desktop)"
        },
        {
          "value": "inactivity",
          "label": "Inactivity timer"
        },
        {
          "value": "manual",
          "label": "Manual (via JS)"
        }
      ]
    },
    {
      "type": "range",
      "id": "inactivity_s",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Inactivity duration (s)",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Enable exit-intent detection",
      "default": false
    },
    {
      "type": "range",
      "id": "hide_days",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "day",
      "label": "Do not show again for",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "once_per_session",
      "label": "Show only once per session",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_edit_mode",
      "label": "Always show in editor",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main popup image"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Image placement (desktop)",
      "options": [
        {
          "value": "row",
          "label": "Image on left, form on right"
        },
        {
          "value": "row-reverse",
          "label": "Form on left, image on right"
        },
        {
          "value": "column",
          "label": "Image above form"
        },
        {
          "value": "column-reverse",
          "label": "Form above image"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Image placement (mobile)",
      "options": [
        {
          "value": "column",
          "label": "Image above form"
        },
        {
          "value": "column-reverse",
          "label": "Form above image"
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "desktop_gap_between_image_form",
      "label": "Image gap (desktop)",
      "default": 50,
      "step": 1,
      "min": 10,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Content"
    },
    {
      "type": "range",
      "id": "top_text_to_heading_gap",
      "label": "Top text gap (px)",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_heading_top_space",
      "label": "Desktop: Space above main heading",
      "min": 0,
      "max": 50,
      "default": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_heading_top_space",
      "label": "Mobile: Space above main heading",
      "min": 0,
      "max": 50,
      "default": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "use_theme_fields",
      "label": "Use theme field style",
      "default": true
    },
    {
      "type": "range",
      "id": "input_border_thickness",
      "label": "Input border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "max": 50,
      "min": 0,
      "id": "input_border_radius",
