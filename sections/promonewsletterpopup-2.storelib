  "shopify": {
    "name": "Promotional Newsletter 2",
    "class": "loudz-section loudz-newsletter-3",
    "tag": "section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "Trigger"
      },
      {
        "type": "checkbox",
        "id": "render_as_popup",
        "label": "Show as a popup",
        "default": true
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "Opens",
        "default": "delay",
        "options": [
          {
            "value": "immediate",
            "label": "On page load"
          },
          {
            "value": "delay",
            "label": "After a delay"
          },
          {
            "value": "scroll",
            "label": "On scroll"
          },
          {
            "value": "exit",
            "label": "On exit intent"
          },
          {
            "value": "inactivity",
            "label": "When idle"
          },
          {
            "value": "pageviews",
            "label": "After page views"
          },
          {
            "value": "manual",
            "label": "From a link"
          }
        ]
      },
      {
        "type": "number",
        "id": "popup_delay",
        "label": "Delay (seconds)",
        "default": 0
      },
      {
        "type": "range",
        "id": "inactivity_s",
        "label": "Idle for",
        "min": 0,
        "max": 120,
        "step": 5,
        "unit": "s",
        "default": 10,
        "visible_if": "{{ section.settings.open_mode == 'inactivity' }}"
      },
      {
        "type": "range",
        "id": "scroll_pct",
        "label": "Scrolled",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 50,
        "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
      },
      {
        "type": "range",
        "id": "page_views",
        "label": "Page views",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 2,
        "visible_if": "{{ section.settings.open_mode == 'pageviews' }}"
      },
      {
        "type": "checkbox",
        "id": "exit_intent",
        "label": "Also open on exit intent",
        "default": false
      },
      {
        "type": "header",
        "content": "Behaviour"
      },
      {
        "type": "range",
        "id": "hide_days",
        "label": "Hide after closing for",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "once_per_session",
        "label": "Once per session",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_edit_mode",
        "label": "Show in the builder",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_customization_mode",
        "label": "Keep open in the builder",
        "default": true
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "desktop_image_position",
        "label": "Image",
        "options": [
          {
            "value": "row",
            "label": "Left"
          },
          {
            "value": "row-reverse",
            "label": "Right"
          },
          {
            "value": "column",
            "label": "Above"
          },
          {
            "value": "column-reverse",
            "label": "Below"
          }
        ],
        "default": "row"
      },
      {
