            "info": "Only used when Icon source = Upload my own image."
          },
          {
            "type": "textarea",
            "id": "custom_svg_code",
            "label": "Custom SVG code",
            "info": "Only used when Icon source = Paste custom SVG. Use 'currentColor' for stroke/fill to inherit the icon color."
          },
          {
            "type": "range",
            "id": "icon_size",
            "min": 20,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "Icon size",
            "default": 72
          },
          {
            "type": "color",
            "id": "icon_color",
            "label": "Icon color",
            "default": "#1c1c1c"
          }
        ]
      },
      {
        "type": "form",
        "name": "Email input",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "placeholder_text",
