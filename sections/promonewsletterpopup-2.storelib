  "shopify": {
    "name": "Promotional Newsletter 2",
    "class": "loudz-section loudz-newsletter-3",
    "tag": "section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "checkbox",
        "id": "enable_customization_mode",
        "label": "Enable Customization Mode (ignores cookies for editing)",
        "default": true,
        "info": "When ON, the popup always shows on every page load and ignores 'don't show again' rules. Turn this OFF before going live."
      },
      {
        "type": "number",
        "id": "popup_delay",
        "default": 0,
        "label": "Delay before popup appears (seconds)",
        "info": "Set to 0 for immediate display; otherwise, enter seconds to wait. Only used when 'When to open' is set to 'After delay'."
      },
      {
        "type": "header",
        "content": "Trigger / Display Behavior"
      },
      {
        "type": "checkbox",
        "id": "render_as_popup",
        "label": "Render as popup (modal)",
        "default": true,
        "info": "When OFF, this section does nothing — won't render or fire any triggers."
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "When to open",
        "default": "delay",
        "options": [
          {
            "value": "immediate",
            "label": "Immediately"
          },
          {
            "value": "delay",
            "label": "After delay"
          },
          {
            "value": "exit",
            "label": "Exit intent (desktop)"
          },
          {
            "value": "inactivity",
            "label": "Inactivity timer"
          },
          {
            "value": "manual",
            "label": "Manual (via JS)"
          }
        ]
      },
      {
        "type": "range",
        "id": "inactivity_s",
        "min": 0,
        "max": 120,
        "step": 5,
        "unit": "s",
        "label": "Inactivity duration (s)",
        "default": 10,
        "info": "Only used when 'When to open' is set to 'Inactivity timer'. Popup appears after this many seconds of no mouse/keyboard/scroll activity."
      },
      {
        "type": "checkbox",
        "id": "exit_intent",
        "label": "Enable exit-intent detection",
        "default": false,
        "info": "Adds exit-intent as a secondary trigger on desktop alongside the primary 'When to open' mode."
      },
      {
        "type": "range",
        "id": "hide_days",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "day",
        "label": "Do not show again for",
        "default": 2,
        "info": "After the visitor closes the popup, don't show it again for this many days."
      },
      {
        "type": "checkbox",
        "id": "once_per_session",
        "label": "Show only once per session",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_edit_mode",
        "label": "Enable Edit mode (always show in Theme Editor)",
        "default": true,
        "info": "Forces popup to stay visible while you're editing in the Shopify theme editor. Has no effect on live store."
      },
      {
        "type": "header",
        "content": "📝 Content lives in blocks below",
        "info": "Heading, description, top text, image / icon, subscribe form and dismiss link are all configured per-block. Add or edit them in the Blocks panel below."
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Image / Media"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Main popup image",
        "info": "Large hero image that fills the top of the popup on mobile and the side panel on desktop. Recommended ≥ 900×900 (square works best)."
      },
      {
        "type": "select",
        "id": "desktop_image_position",
        "label": "Desktop: Image placement relative to form",
        "options": [
          {
            "value": "row",
            "label": "Image on left, form on right"
          },
          {
            "value": "row-reverse",
            "label": "Form on left, image on right"
          },
          {
            "value": "column",
            "label": "Image above form"
          },
          {
            "value": "column-reverse",
            "label": "Form above image"
          }
        ],
        "default": "row"
      },
      {
        "type": "select",
        "id": "mobile_image_position",
        "label": "Mobile: Image placement relative to form",
        "options": [
          {
            "value": "column",
            "label": "Image above form"
          },
          {
            "value": "column-reverse",
            "label": "Form above image"
          }
        ],
        "default": "column"
      },
      {
        "type": "range",
        "id": "desktop_gap_between_image_form",
        "label": "Desktop: Gap between image and form",
        "default": 50,
        "step": 1,
        "min": 10,
        "max": 100,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "range",
        "id": "top_text_to_heading_gap",
        "label": "Gap between Top Text and Heading (px)",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "desktop_heading_top_space",
        "label": "Desktop: Space above main heading",
        "min": 0,
        "max": 50,
        "default": 16,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mobile_heading_top_space",
        "label": "Mobile: Space above main heading",
        "min": 0,
        "max": 50,
        "default": 16,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "range",
        "id": "input_border_thickness",
        "label": "Email input border thickness",
        "min": 0,
        "max": 5,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "range",
        "max": 50,
        "min": 0,
        "id": "input_border_radius",
        "label": "Email input border radius",
        "step": 1,
        "default": 6,
        "unit": "px"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Popup background color",
        "default": "#FFFFFF"
      },
      {
        "type": "color_background",
        "id": "background_gradient",
        "label": "Popup background gradient",
        "info": "If set, overrides the background color."
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Backdrop overlay color",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Backdrop overlay opacity",
        "max": 100,
        "min": 10,
        "step": 1,
        "default": 50,
        "unit": "%"
      },
      {
        "type": "color",
        "id": "input_color",
        "label": "Email input text color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "input_background_color",
        "label": "Email input background color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "input_border_color",
        "label": "Email input border color",
        "default": "#808080"
      },
      {
        "type": "color",
        "id": "input_placeholder_color",
        "label": "Email placeholder text color",
        "default": "#808080"
      },
      {
        "type": "color",
        "id": "popup_link_color",
        "label": "Dismiss link text color",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "popup_border_radius",
        "label": "Overall Popup Border Radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "desktop_icon_width",
        "label": "Desktop: Icon display width",
        "max": 200,
        "min": 20,
        "step": 2,
        "unit": "px",
        "default": 72
      },
      {
        "type": "number",
        "id": "inner_width",
        "label": "Maximum popup width (px)",
        "default": 800
      },
      {
        "type": "range",
        "id": "desktop_top_space",
        "label": "Desktop: Space above description",
        "min": 0,
        "max": 50,
        "default": 12,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "desktop_form_top_space",
        "label": "Desktop: Space above email form",
        "min": 0,
        "max": 50,
        "default": 32,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "desktop_button_top_space",
        "label": "Desktop: Space above subscribe button",
        "min": 0,
        "max": 50,
        "default": 12,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "desktop_top_padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Desktop: Overall top padding inside popup",
        "default": 0
      },
      {
        "type": "range",
        "id": "desktop_bottom_padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Desktop: Overall bottom padding inside popup",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
