            "default": "US"
          },
          {
            "type": "checkbox",
            "id": "phone_required",
            "label": "Make phone required",
            "default": false
          },
          {
            "type": "header",
            "content": "Input typography"
          },
          {
            "type": "range",
            "id": "input_size_desktop",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Desktop input font size",
            "default": 16
          },
          {
            "type": "range",
