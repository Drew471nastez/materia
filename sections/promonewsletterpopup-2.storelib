          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "min": 8,
            "max": 32,
            "step": 1,
            "unit": "px",
            "label": "Desktop font size",
            "default": 18
          },
          {
            "type": "range",
