        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "top_text",
        "name": "Top text",
        "limit": 1,
        "settings": [
          {
            "type": "header",
