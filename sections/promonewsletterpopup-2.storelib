            "default": "Email address"
          },
          {
            "type": "header",
            "content": "Phone collection (optional)"
          },
          {
            "type": "checkbox",
            "id": "collect_phone",
            "label": "Also collect phone number",
            "info": "Adds a phone field with country-code dropdown. Phone numbers are saved to the customer's Shopify profile alongside the email.",
            "default": false
          },
          {
            "type": "text",
            "id": "phone_placeholder",
            "label": "Phone placeholder",
            "default": "Phone number"
          },
          {
            "type": "text",
