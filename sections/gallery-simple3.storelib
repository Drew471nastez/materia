<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign custom = s.enable_custom_style
  assign loading = 'eager'
  if s.lazyload
    assign loading = 'lazy'
  endif
  assign max_width = 'none'
  if s.is_fullwidth != true and s.container_max_width > 0
    assign max_width = s.container_max_width | append: 'px'
  endif
  assign heading_font = 'var(--heading-font)'
  if s.enable_custom_fonts and s.heading_font.family
    assign heading_font = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families | default: 'sans-serif'
  endif
  assign heading_weight = 'var(--heading-weight, 700)'
  if s.heading_font_weight != blank and s.heading_font_weight != 'inherit'
    assign heading_weight = s.heading_font_weight
  endif
  assign ratio = s.img_proportion | remove: '%'
-%}
{%- capture label_style -%}{%- if custom -%}{% render 'button-overrides', text: s.button_text_color %}{%- endif -%}{%- endcapture -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'media-galleries-a-base', section: section %}
{%- if s.enable_custom_fonts and s.heading_font.family -%}<style>{{ s.heading_font | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- comment -%}
  Materia Themes. Gallery Simple 3: a heading over a grid of images. An image
  with a link shows its button over the image on hover or keyboard focus, and
  always on touch screens.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .mga-s3 { color: var(--mga-text-color); }
  #shopify-section-{{ section.id }} .mga-s3__frame { max-width: var(--mga-max); margin-inline: auto; padding-inline: var(--mga-gap); background: var(--mga-bg); }
  #shopify-section-{{ section.id }} .mga-s3__title {
    margin: 0 0 40px;
    color: var(--mga-heading-color);
    font-family: var(--mga-heading-font);
    font-weight: var(--mga-heading-weight);
    font-size: var(--mga-heading-size-m);
    line-height: var(--heading-line-height, 1.2);
    text-align: var(--mga-align);
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .mga-s3__grid {
    display: grid;
    grid-template-columns: repeat(var(--mga-cols-m), minmax(0, 1fr));
    gap: var(--mga-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .mga-s3__media {
    aspect-ratio: 100 / var(--mga-ratio);
    border-radius: var(--mga-radius);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  #shopify-section-{{ section.id }} .mga-s3__media .mga-fill { transition: transform 0.3s ease, opacity 0.3s ease; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="fade"] .mga-s3__media:hover .mga-fill { opacity: 0.7; }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-zoomin-long"] .mga-s3__media .mga-fill { transition-duration: 0.8s; }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-zoomin-long"] .mga-s3__media:hover .mga-fill { transform: scale(1.1); }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-zoomin"] .mga-s3__media:hover .mga-fill { transform: scale(1.03); }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-shadow"] .mga-s3__media:hover { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-fade-up"] .mga-s3__media:hover { transform: translateY(-8px); }
    #shopify-section-{{ section.id }} .mga-s3[data-mga-hover="smooth-fade-up"] .mga-s3__media:hover .mga-fill { opacity: 0.8; }
  }
  #shopify-section-{{ section.id }} .mga-s3__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 15px;
    background: color-mix(in srgb, var(--color-background) 45%, transparent);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #shopify-section-{{ section.id }} .mga-s3__media:is(:hover, :focus-within) .mga-s3__overlay { opacity: 1; }
  #shopify-section-{{ section.id }} .mga-s3__overlay:focus-visible { outline: none; }
  #shopify-section-{{ section.id }} .mga-s3__overlay:focus-visible .mga-s3__btn { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  #shopify-section-{{ section.id }} .mga-s3__btn { pointer-events: auto; }
  @media (hover: none) {
    #shopify-section-{{ section.id }} .mga-s3__overlay { opacity: 1; background: none; align-items: flex-end; }
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .mga-s3__title { font-size: var(--mga-heading-size-d); }
    #shopify-section-{{ section.id }} .mga-s3__grid { grid-template-columns: repeat(var(--mga-cols-d), minmax(0, 1fr)); }
  }
{% comment %}{% endcomment %}</style>
<div
  class="mga mga-s3 color-{{ color_scheme }} gradient {{ s.custom_class | escape }}"
  data-mga-section="{{ section.id }}"
  data-mga-type="gallery-simple3"
  data-mga-settings="{{ section.settings | json | escape }}"
  data-mga-defaults='{"color_scheme":"default-color-scheme","is_fullwidth":false,"reset_spacing":true,"text_align":"center","heading_tag":"h2","container_max_width":1320,"columns_desktop":4,"gutter":10,"img_proportion":"100%","image_border_radius":0,"image_hover_animation":"none","lazyload":true,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","heading_size":35,"heading_font_weight":"inherit","use_theme_font":false,"section_padding_top":50,"section_padding_bottom":50,"section_padding_left_desktop":100,"section_padding_right_desktop":100,"columns_mobile":2,"heading_size_mobile":28,"section_padding_top_mobile":50,"section_padding_bottom_mobile":50,"section_padding_left_mobile":0,"section_padding_right_mobile":0,"custom_class":"/","custom_css":" /"}'
  data-mga-block-defaults='{"image":{"gallery_link_label":"Discover"}}'
  data-mga-reset="{% if s.reset_spacing %}true{% else %}false{% endif %}"
  data-mga-hover="{{ s.image_hover_animation | default: 'none' }}"
  style="--mga-section-bg: {% if custom %}{% render 'scheme-color', color: s.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --mga-bg: {% if custom %}{% render 'scheme-color', color: s.background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --mga-heading-color: {% if custom %}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --mga-text-color: {% if custom %}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}; --mga-heading-font: {{ heading_font }}; --mga-heading-weight: {{ heading_weight }}; --mga-heading-size-d: {{ s.heading_size }}px; --mga-heading-size-m: {{ s.heading_size_mobile | default: 28 }}px; --mga-align: {{ s.text_align | default: 'center' }}; --mga-max: {{ max_width }}; --mga-gap: {{ s.gutter }}px; --mga-ratio: {{ ratio }}; --mga-radius: {{ s.image_border_radius }}px; --mga-cols-d: {{ s.columns_desktop | default: 4 }}; --mga-cols-m: {{ s.columns_mobile | default: 2 }}; --mga-pt-d: {{ s.section_padding_top }}px; --mga-pb-d: {{ s.section_padding_bottom }}px; --mga-pl-d: {{ s.section_padding_left_desktop }}px; --mga-pr-d: {{ s.section_padding_right_desktop }}px; --mga-pt-m: {{ s.section_padding_top_mobile }}px; --mga-pb-m: {{ s.section_padding_bottom_mobile }}px; --mga-pl-m: {{ s.section_padding_left_mobile }}px; --mga-pr-m: {{ s.section_padding_right_mobile }}px;"
>
  <style data-mga-custom-css>{{ s.custom_css }}</style>
  <div class="mga__frame mga-s3__frame">
    <h2 class="mga-s3__title" data-mga-heading{% if s.heading_text == blank %} hidden{% endif %}>{{ s.heading_text }}</h2>
    <ul class="mga-s3__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          {%- liquid
            assign b = block.settings
            assign img = b.background_image
            assign href = b.gallery_link_url | url
            assign alt = b.alt | strip_html | strip
            if alt == blank
              assign alt = img.alt
            endif
          -%}
          <li class="mga-s3__item" data-mga-block="{{ block.id }}" data-mga-type="image" data-mga-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
            <div class="mga-media mga-s3__media" data-mga-media data-media="{% if img != blank %}image{% else %}none{% endif %}">
              {% render 'media-galleries-a-ph' %}
              <img data-mga-img class="mga-fill"{% if img != blank %} src="{{ img | image_url: width: 1200 }}" srcset="{{ img | image_url: width: 490 }} 490w, {{ img | image_url: width: 750 }} 750w, {{ img | image_url: width: 1200 }} 1200w" sizes="(min-width: 750px) 25vw, 100vw" width="{{ img.width | default: 1200 }}" height="{{ img.height | default: 900 }}"{% else %} hidden{% endif %} alt="{{ alt | escape }}" loading="{{ loading }}" decoding="async">
              <a data-mga-link class="mga-s3__overlay"{% if href != blank %} href="{{ href }}"{% else %} hidden{% endif %}>
                <span class="mga-s3__btn" data-mga-label data-theme-button="primary" data-sl-button{% if label_style != blank %} style="{{ label_style }}"{% endif %}{% if b.gallery_link_label == blank %} hidden{% endif %}>{{ b.gallery_link_label | escape }}</span>
              </a>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>
</template>

<schema>
{
  "type": "gallery-simple3",
  "name": "Gallery Simple 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "is_fullwidth",
      "default": false,
      "label": "Full width"
    },
    {
      "type": "number",
      "id": "container_max_width",
      "label": "Content width (px)",
      "default": 1320
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop top padding",
      "info": "Adjust top spacing for desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom padding",
      "info": "Adjust bottom spacing for desktop",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_left_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop left padding",
      "info": "Adjust left spacing for desktop",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding_right_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop right padding",
      "info": "Adjust right spacing for desktop",
      "default": 100
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile top padding",
      "info": "Adjust top spacing for mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom padding",
      "info": "Adjust bottom spacing for mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_left_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile left padding",
      "info": "Adjust left spacing for mobile",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_right_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile right padding",
      "info": "Adjust right spacing for mobile",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Basic settings"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "gutter",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Gap between images",
      "default": 10
    },
    {
      "type": "select",
      "id": "img_proportion",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "56%",
          "label": "16x9"
        },
        {
          "value": "75%",
          "label": "4x3"
        },
        {
          "value": "100%",
          "label": "1x1"
        },
        {
          "value": "150%",
          "label": "2x3"
        }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "image_hover_animation",
      "label": "Hover effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "smooth-zoomin-long",
          "label": "Smooth Zoomin Long inside"
        },
        {
          "value": "smooth-zoomin",
          "label": "Smooth Zoomin"
        },
        {
          "value": "smooth-shadow",
          "label": "Smooth shadow"
        },
        {
          "value": "smooth-fade-up",
          "label": "Smooth Fade in Up"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Section heading",
      "info": "Title of this section"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Align heading text",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "use_theme_font",
      "default": false,
      "label": "Theme body font"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "info": "Select the heading text weight",
      "options": [
        {
          "value": "inherit",
          "label": "Theme"
        },
        {
          "value": "lighter",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Customization"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "default": "/"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Additional CSS",
      "default": " /",
      "info": "Add extra CSS code here"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "lazyload",
      "default": true,
      "label": "Lazy load images"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Link text"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Upload image"
        },
        {
          "type": "url",
          "id": "gallery_link_url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "gallery_link_label",
          "label": "Button label",
          "default": "Discover"
        }
      ],
      "limit": 12
    }
  ],
  "presets": [
    {
      "name": "Gallery Simple 3",
      "category": "Image and video",
      "settings": {
        "is_fullwidth": true,
        "gutter": 15,
        "img_proportion": "75%"
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "shopify": {
    "name": "Gallery Simple 3",
    "tag": "section",
    "class": "gallery-3",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "is_fullwidth",
        "default": false,
        "label": "Full width"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove the theme's space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "inline_richtext",
        "id": "heading_text",
        "label": "Heading",
        "info": "Title of this section"
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "Heading alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ],
        "default": "center"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading tag",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          }
        ],
        "default": "h2",
        "hidden": true,
        "info": "The heading is always an h2, so the page keeps one h1."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "number",
        "id": "container_max_width",
        "label": "Content max width (px)",
        "default": 1320,
        "info": "Leave at 0 for no limit.",
        "visible_if": "{{ section.settings.is_fullwidth == false }}"
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "label": "Images per row (desktop)",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "gutter",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Gap between images",
        "default": 10
      },
      {
        "type": "header",
        "content": "Images"
      },
      {
        "type": "select",
        "id": "img_proportion",
        "label": "Image shape",
        "options": [
          {
            "value": "56%",
            "label": "16x9"
          },
          {
            "value": "75%",
            "label": "4x3"
          },
          {
            "value": "100%",
            "label": "1x1"
          },
          {
            "value": "150%",
            "label": "2x3"
          }
        ],
        "default": "100%"
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "select",
        "id": "image_hover_animation",
        "label": "Hover effect",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "smooth-zoomin-long",
            "label": "Smooth Zoomin Long inside"
          },
          {
            "value": "smooth-zoomin",
            "label": "Smooth Zoomin"
          },
          {
            "value": "smooth-shadow",
            "label": "Smooth shadow"
          },
          {
            "value": "smooth-fade-up",
            "label": "Smooth Fade in Up"
          }
        ],
        "default": "none"
      },
      {
        "type": "checkbox",
        "id": "lazyload",
        "default": true,
        "label": "Load images as they scroll into view"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Gallery background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Heading colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "heading_size",
        "label": "Heading size (desktop)",
        "min": 10,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "select",
        "id": "heading_font_weight",
        "label": "Heading weight",
        "info": "Select the heading text weight",
        "options": [
          {
            "value": "inherit",
            "label": "Theme"
          },
          {
            "value": "lighter",
            "label": "Light"
          },
          {
            "value": "normal",
            "label": "Normal"
          },
          {
            "value": "bold",
            "label": "Bold"
          }
        ],
        "default": "inherit"
      },
      {
        "type": "checkbox",
        "id": "use_theme_font",
        "default": false,
        "label": "Theme body font",
        "hidden": true,
        "info": "Theme fonts now apply by default. Use Enable custom fonts instead."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "section_padding_top",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Desktop top padding",
        "info": "Adjust top spacing for desktop",
        "default": 50
      },
      {
        "type": "range",
        "id": "section_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Desktop bottom padding",
        "info": "Adjust bottom spacing for desktop",
        "default": 50
      },
      {
        "type": "range",
        "id": "section_padding_left_desktop",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Desktop left padding",
        "info": "Adjust left spacing for desktop",
        "default": 100
      },
      {
        "type": "range",
        "id": "section_padding_right_desktop",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Desktop right padding",
        "info": "Adjust right spacing for desktop",
        "default": 100
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "columns_mobile",
        "label": "Images per row (mobile)",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "min": 16,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "section_padding_top_mobile",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Mobile top padding",
        "info": "Adjust top spacing for mobile",
        "default": 50
      },
      {
        "type": "range",
        "id": "section_padding_bottom_mobile",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Mobile bottom padding",
        "info": "Adjust bottom spacing for mobile",
        "default": 50
      },
      {
        "type": "range",
        "id": "section_padding_left_mobile",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Mobile left padding",
        "info": "Adjust left spacing for mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding_right_mobile",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Mobile right padding",
        "info": "Adjust right spacing for mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "text",
        "id": "custom_class",
        "label": "CSS class",
        "default": "/"
      },
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS",
        "default": " /",
        "info": "Add extra CSS code here"
      }
    ],
    "blocks": [
      {
        "name": "Image",
        "type": "image",
        "limit": 12,
        "settings": [
          {
            "type": "image_picker",
