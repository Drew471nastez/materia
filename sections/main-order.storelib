<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. One order (/account/orders/<id>): its lines, totals and addresses.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="ap ap-order color-{{ scheme }} gradient"
  data-ap-root="main-order"
  data-ap-section="{{ sid }}"
  data-ap-settings="{{ st | json | escape }}"
  {% if st.reset_spacing %}data-ap-reset{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-hfs-d: {{ st.heading_size_desktop | default: 30 }}px; --ap-hfs-m: {{ st.heading_size_mobile | default: 24 }}px;{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  <div class="{{ st.section_width | default: 'container' }}" data-ap-width>
    <p class="ap-order__back"><a class="ap__link" href="{{ routes.account_url }}" data-ap-text="back_label" data-ap-opt{% if st.back_label == blank %} hidden{% endif %}>{{ st.back_label | escape }}</a></p>
    <div class="ap-order__grid">
      <div class="ap-order__main">
        <h1 class="ap__h title-default"><span data-ap-text="heading">{{ st.heading | escape }}</span> {{ order.name }}</h1>
        <p class="ap__t text-order"><span data-ap-text="placed_label">{{ st.placed_label | escape }}</span> {{ order.created_at | date: '%B %d, %Y %I:%M%p' }}</p>
        {%- if order.cancelled -%}
          <p class="ap__msg error" role="status"><span><span data-ap-text="cancelled_label">{{ st.cancelled_label | escape }}</span> {{ order.cancelled_at | date: '%B %d, %Y %I:%M%p' }}. {{ order.cancel_reason_label | default: order.cancel_reason }}</span></p>
        {%- endif -%}
        <div class="ap-table-wrap">
          <table class="ap-table responsive-table">
            <thead>
              <tr>
                <th scope="col" data-ap-text="product_label">{{ st.product_label | escape }}</th>
                <th scope="col" data-ap-text="price_label">{{ st.price_label | escape }}</th>
                <th scope="col" data-ap-text="quantity_label">{{ st.quantity_label | escape }}</th>
                <th scope="col" data-ap-text="total_label">{{ st.total_label | escape }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for line_item in order.line_items -%}
                <tr>
                  <td>
                    {%- if line_item.product.url != blank -%}<a class="ap__link" href="{{ line_item.product.url }}">{{ line_item.title }}</a>{%- else -%}{{ line_item.title }}{%- endif -%}
                    {%- if line_item.sku != blank -%}<div class="ap-order__sku">{{ line_item.sku }}</div>{%- endif -%}
                    {%- assign property_size = line_item.properties | size -%}
                    {%- if property_size > 0 -%}
                      <div class="ap-order__props">
                        {%- for property in line_item.properties -%}
                          {%- assign first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and first_char != '_' -%}
                            <span>{{ property.first }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>{% else %}{{ property.last }}{% endif %}</span>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                      <div class="ap-order__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</div>
                    {%- endfor -%}
                    {%- if line_item.fulfillment.tracking_url != blank -%}
                      <div><a class="ap__link" href="{{ line_item.fulfillment.tracking_url }}" data-ap-text="track_label">{{ st.track_label | escape }}</a></div>
                    {%- endif -%}
                  </td>
                  <td>
                    {%- if line_item.original_price != line_item.final_price -%}<s>{{ line_item.original_price | money }}</s> {{ line_item.final_price | money }}{%- else -%}{{ line_item.original_price | money }}{%- endif -%}
                  </td>
                  <td>{{ line_item.quantity }}</td>
                  <td>{{ line_item.final_line_price | default: line_item.line_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
            <tfoot>
              <tr><th scope="row" colspan="3" data-ap-text="subtotal_label">{{ st.subtotal_label | escape }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
              {%- for discount in order.discounts -%}
                <tr><th scope="row" colspan="3">{{ discount.code }}</th><td>-{{ discount.savings | money }}</td></tr>
              {%- endfor -%}
              {%- for shipping_method in order.shipping_methods -%}
                <tr><th scope="row" colspan="3"><span data-ap-text="shipping_label">{{ st.shipping_label | escape }}</span> ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>
              {%- endfor -%}
              {%- for tax_line in order.tax_lines -%}
                <tr><th scope="row" colspan="3"><span data-ap-text="tax_label">{{ st.tax_label | escape }}</span> ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</th><td>{{ tax_line.price | money }}</td></tr>
              {%- endfor -%}
              <tr><th scope="row" colspan="3" data-ap-text="total_label">{{ st.total_label | escape }}</th><td>{{ order.total_price | money }} {{ order.currency }}</td></tr>
            </tfoot>
          </table>
        </div>
      </div>
      <div class="ap-order__side">
        <div class="ap-card ap-block">
          <h2 class="ap__h ap__h--sub" data-ap-text="billing_heading">{{ st.billing_heading | escape }}</h2>
          <p class="ap__t"><span data-ap-text="payment_label">{{ st.payment_label | escape }}</span> {{ order.financial_status_label }}</p>
          <div class="ap__t">{{ order.billing_address | format_address }}</div>
        </div>
        {%- if order.shipping_address != blank -%}
          <div class="ap-card ap-block">
            <h2 class="ap__h ap__h--sub" data-ap-text="shipping_heading">{{ st.shipping_heading | escape }}</h2>
            <p class="ap__t"><span data-ap-text="fulfillment_label">{{ st.fulfillment_label | escape }}</span> {{ order.fulfillment_status_label }}</p>
            <div class="ap__t">{{ order.shipping_address | format_address }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ sid }} .ap-order__back { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .ap-order__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 30px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ap-order__grid { grid-template-columns: minmax(0, 3fr) minmax(220px, 1fr); } }
  #shopify-section-{{ sid }} .ap-order__grid > * { min-width: 0; }
  #shopify-section-{{ sid }} .ap-order__sku,
  #shopify-section-{{ sid }} .ap-order__props,
  #shopify-section-{{ sid }} .ap-order__discount { font-size: .9em; margin-top: 4px; }
  #shopify-section-{{ sid }} .ap-order__props span { display: block; }
  #shopify-section-{{ sid }} .ap-table { min-width: 460px; }
  #shopify-section-{{ sid }} .ap-table tfoot th { font-weight: 400; color: var(--ap-t-c, var(--color-text)); }
  #shopify-section-{{ sid }} .ap-card .ap__t { margin: 0 0 8px; }
{% comment %}{% endcomment %}</style>
</template>

<schema>
{
  "type": "main-order",
  "name": "Order",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link",
      "default": "Back to my account"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order"
    },
    {
      "type": "text",
