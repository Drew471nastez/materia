      "label": "Date text",
      "default": "Placed on"
    },
    {
      "type": "text",
      "id": "cancelled_label",
      "label": "Cancelled text",
      "default": "Cancelled on"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product column",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price column",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity column",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "tax_label",
      "label": "Tax",
      "default": "Tax"
    },
    {
      "type": "text",
      "id": "track_label",
      "label": "Tracking link",
      "default": "Track shipment"
    },
    {
      "type": "text",
      "id": "billing_heading",
      "label": "Billing heading",
      "default": "Billing address"
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Payment status text",
      "default": "Payment:"
    },
    {
      "type": "text",
      "id": "shipping_heading",
      "label": "Shipping heading",
      "default": "Shipping address"
    },
    {
      "type": "text",
      "id": "fulfillment_label",
      "label": "Delivery status text",
      "default": "Delivery:"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 14,
      "max": 60,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 40,
      "unit": "px"
    }
  ],
