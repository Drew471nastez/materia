<template compat="shopify">
<script src="{{ 'live-features-b.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Comparison Table.

  A heading, a subheading, up to three column blocks and one row block per
  feature, drawn as a real table: a check or a cross per column, the
  highlighted column filled. On a narrow screen the table scrolls sideways
  inside its own frame (the row labels stay in view) and never the page.
  Saved sections without column blocks keep their column one to three
  headings from the section settings. Colours follow the colour scheme until
  Enable custom styling is on. Live edits: assets/live-features-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign col_blocks = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'item'
  assign title_done = false
  assign has_heading_block = false
  assign has_sub_block = false
  for b in section.blocks
    if b.type == 'heading'
      assign has_heading_block = true
    elsif b.type == 'subheading'
      assign has_sub_block = true
    endif
  endfor
  if col_blocks.size > 0
    assign ncols = col_blocks.size
    if ncols > 3
      assign ncols = 3
    endif
  elsif st.third_heading != blank
    assign ncols = 3
  else
    assign ncols = 2
  endif
  assign region_label = st.heading | strip_html | strip
  for b in section.blocks
    if b.type == 'heading' and b.settings.text != blank
      assign region_label = b.settings.text | strip_html | strip
      break
    endif
  endfor
  if region_label == blank
    assign region_label = section.name | default: 'Comparison table'
  endif
  assign spx = 'padding_top,padding_bottom,padding_horizontal:rem,padding_horizontal_mobile:rem,content_width:rem,heading_size,heading_height:%,subheading_font_size,subheading_font_size_mobile,subheading_padding_horizontal,subheading_padding_horizontal_mobile,table_mt,table_radius,table_border_thickness,table_column_active_radius,active_col_gradient_degrees:n,table_heading_size,table_heading_size_mobile,table_heading_height:%,table_heading_padding_horizontal,table_heading_padding_horizontal_mobile,table_heading_padding_vertical,table_heading_padding_vertical_mobile,table_row_padding_horizontal,table_row_padding_horizontal_mobile,table_row_padding_vertical,table_row_padding_vertical_mobile,table_row_heading_size,table_row_heading_size_mobile,table_row_heading_height:%,table_icon_size,table_icon_size_mobile,table_bg_gradient_degrees:n'
  assign sc = 'heading_color,table_border_color,table_heading_color,table_heading_active_color,table_column_active_bg_color,active_col_gradient_color_1,active_col_gradient_color_2,active_col_gradient_color_3,table_row_heading_color,table_icon_color,table_icon_active_color,background_color,background_gradient,table_bg_color,table_bg_color_2,section_bg,first_heading_color_custom,second_heading_color_custom,third_heading_color_custom'
  assign sw = 'heading_font_weight,first_heading_weight,second_heading_weight,third_heading_weight'
  assign sf = 'heading_custom:heading_font,table_heading_custom:table_heading_font,table_row_heading_custom:table_row_heading_font'
  assign sa = 'full_width,heading_align,table_heading_align,table_row_heading_align,table_column_active,enable_active_column_gradient,enable_table_bg_gradient'
  assign stx = 'heading,subheading_text,first_heading,second_heading,third_heading,check_label,cross_label'
  assign sa_list = sa | split: ','
  assign h_px = 'size,size_mobile,line_height:%'
  assign s_px = 'size,size_mobile,padding_x,padding_x_mobile'
-%}
{%- capture icon_check -%}
  {%- if st.table_icon_check_svg != blank -%}{{ st.table_icon_check_svg }}
  {%- elsif st.table_icon_check != blank -%}<img src="{{ st.table_icon_check | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
  {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.4l3.2 3.2L17.2 8.6" fill="none" stroke="var(--fbct-ink)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- endif -%}
{%- endcapture -%}
{%- capture icon_x -%}
  {%- if st.table_icon_x_svg != blank -%}{{ st.table_icon_x_svg }}
  {%- elsif st.table_icon_x != blank -%}<img src="{{ st.table_icon_x | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
  {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10.25" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".45"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- endif -%}
{%- endcapture -%}
<style>
  {%- if st.heading_custom -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.table_heading_custom -%}{{ st.table_heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.table_row_heading_custom -%}{{ st.table_row_heading_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; background-color: var(--fbct-wrap-bg); }
  #shopify-section-{{ sid }} .fbct { --fbct-wrap-bg: var(--fb-section_bg, transparent); background: var(--fb-background_gradient, var(--fb-background_color, var(--fb-section_bg, var(--color-background)))); color: var(--color-text); }
  #shopify-section-{{ sid }} .fbct *, #shopify-section-{{ sid }} .fbct *::before, #shopify-section-{{ sid }} .fbct *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .fbct__inner { margin: 0 auto; padding: calc(var(--fb-padding_top) * .75) var(--fb-padding_horizontal_mobile) calc(var(--fb-padding_bottom) * .75); max-width: var(--fb-content_width); }
  #shopify-section-{{ sid }} .fbct[data-full_width='true'] .fbct__inner { max-width: none; }
  #shopify-section-{{ sid }} .fbct__head { text-align: var(--fbct-align, center); }
  #shopify-section-{{ sid }} .fbct[data-heading_align='left'] { --fbct-align: left; }
  #shopify-section-{{ sid }} .fbct[data-heading_align='right'] { --fbct-align: right; }
  #shopify-section-{{ sid }} .fbct__title { margin: 0; display: block; color: var(--fb-color, var(--fb-heading_color, var(--color-heading))); font-family: var(--fb-heading_font, var(--heading-font)); font-weight: var(--fb-heading_font_weight, var(--heading-weight, 700)); font-size: calc(var(--fb-heading_size) * .85); line-height: var(--fb-heading_height); text-transform: none; text-align: var(--fbct-align, center); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbct__title[data-fb-block] { font-weight: var(--fb-weight, var(--heading-weight, 700)); font-size: var(--fb-size_mobile); line-height: var(--fb-line_height); text-align: var(--fbct-own-align, var(--fbct-align, center)); }
  #shopify-section-{{ sid }} .fbct__title[data-alignment='left'] { --fbct-own-align: left; }
  #shopify-section-{{ sid }} .fbct__title[data-alignment='center'] { --fbct-own-align: center; }
  #shopify-section-{{ sid }} .fbct__title[data-alignment='right'] { --fbct-own-align: right; }
  #shopify-section-{{ sid }} .fbct__sub { display: block; margin: 10px 0 0; line-height: 1.4; color: var(--fb-color, var(--color-text)); font-size: var(--fb-subheading_font_size_mobile); padding-inline: var(--fb-subheading_padding_horizontal_mobile); white-space: pre-line; }
  #shopify-section-{{ sid }} .fbct__sub[data-fb-block] { font-size: var(--fb-size_mobile); padding-inline: var(--fb-padding_x_mobile); }
  #shopify-section-{{ sid }} .fbct__scroll { position: relative; margin-top: calc(var(--fb-table_mt) * .75); overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; scrollbar-width: thin; border-radius: var(--fb-table_radius); }
  #shopify-section-{{ sid }} .fbct__scroll[data-overflow] { cursor: grab; }
  #shopify-section-{{ sid }} .fbct__scroll[data-dragging] { cursor: grabbing; user-select: none; }
  #shopify-section-{{ sid }} .fbct__scroll:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  #shopify-section-{{ sid }} .fbct__table { --fbct-line: var(--fb-table_border_thickness) solid var(--fb-table_border_color, var(--color-border)); --fbct-tbg: var(--fb-table_bg_color, var(--color-background)); width: 100%; min-width: calc(140px + var(--fbct-n) * 80px); border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  #shopify-section-{{ sid }} :where(.fbct__table, .fbct__table th, .fbct__table td) { border: 0; font-weight: inherit; }
  #shopify-section-{{ sid }} .fbct__table tbody { background: var(--fbct-tbg); }
  #shopify-section-{{ sid }} .fbct[data-enable_table_bg_gradient='true'] .fbct__table tbody { background: linear-gradient(var(--fb-table_bg_gradient_degrees), var(--fbct-tbg), var(--fb-table_bg_color_2, var(--color-background))); }
  #shopify-section-{{ sid }} .fbct__table col.fbct__c0 { width: 38%; }
  #shopify-section-{{ sid }} .fbct__table[data-n='2'] col.fbct__c0 { width: 40%; }
  #shopify-section-{{ sid }} .fbct__table :is(th, td) { padding: var(--fb-table_row_padding_vertical_mobile) var(--fb-table_row_padding_horizontal_mobile); vertical-align: middle; text-align: center; border-top: var(--fbct-line); }
  #shopify-section-{{ sid }} .fbct__table thead :is(th, td) { padding: var(--fb-table_heading_padding_vertical_mobile) var(--fb-table_heading_padding_horizontal_mobile); border-top: 0; background: transparent; }
  #shopify-section-{{ sid }} .fbct__table tbody tr:last-child > * { border-bottom: var(--fbct-line); }
  #shopify-section-{{ sid }} .fbct__table tbody tr > :first-child { border-left: var(--fbct-line); }
  #shopify-section-{{ sid }} .fbct__table tbody tr > :last-child { border-right: var(--fbct-line); }
  #shopify-section-{{ sid }} .fbct__table tbody tr:first-child > :first-child { border-top-left-radius: var(--fb-table_radius); }
  #shopify-section-{{ sid }} .fbct__table tbody tr:first-child > :last-child { border-top-right-radius: var(--fb-table_radius); }
  #shopify-section-{{ sid }} .fbct__table tbody tr:last-child > :first-child { border-bottom-left-radius: var(--fb-table_radius); }
  #shopify-section-{{ sid }} .fbct__table tbody tr:last-child > :last-child { border-bottom-right-radius: var(--fb-table_radius); }
  #shopify-section-{{ sid }} .fbct__label { position: sticky; left: 0; z-index: 1; background: var(--fbct-tbg); text-align: var(--fbct-rl-align, center); }
  #shopify-section-{{ sid }} .fbct__table thead .fbct__label { background: var(--fb-background_color, var(--fb-section_bg, var(--color-background))); }
  #shopify-section-{{ sid }} .fbct[data-table_row_heading_align='left'] { --fbct-rl-align: left; }
  #shopify-section-{{ sid }} .fbct[data-table_row_heading_align='right'] { --fbct-rl-align: right; }
  #shopify-section-{{ sid }} .fbct__rl { display: block; text-align: var(--fbct-rl-align, center); color: var(--fb-table_row_heading_color, var(--color-heading)); font-family: var(--fb-table_row_heading_font, var(--heading-font)); font-weight: var(--heading-weight, 700); font-size: var(--fb-table_row_heading_size_mobile); line-height: var(--fb-table_row_heading_height); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbct__col { --fbct-hc: var(--fb-table_heading_color, var(--color-heading)); text-align: var(--fbct-th-align, center); }
  #shopify-section-{{ sid }} .fbct[data-table_heading_align='left'] { --fbct-th-align: left; }
  #shopify-section-{{ sid }} .fbct[data-table_heading_align='right'] { --fbct-th-align: right; }
  #shopify-section-{{ sid }} .fbct__ct { display: block; text-align: var(--fbct-th-align, center); color: var(--fbct-own, var(--fbct-hc)); font-family: var(--fb-table_heading_font, var(--heading-font)); font-weight: var(--fbct-ow, var(--heading-weight, 700)); font-size: var(--fb-table_heading_size_mobile); line-height: var(--fb-table_heading_height); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbct__col[data-fb-block] .fbct__ct { --fbct-own: var(--fb-color); --fbct-ow: var(--fb-weight); }
  #shopify-section-{{ sid }} .fbct__col[data-legacy='1'] .fbct__ct { --fbct-own: var(--fb-first_heading_color_custom); --fbct-ow: var(--fb-first_heading_weight); }
  #shopify-section-{{ sid }} .fbct__col[data-legacy='2'] .fbct__ct { --fbct-own: var(--fb-second_heading_color_custom); --fbct-ow: var(--fb-second_heading_weight); }
  #shopify-section-{{ sid }} .fbct__col[data-legacy='3'] .fbct__ct { --fbct-own: var(--fb-third_heading_color_custom); --fbct-ow: var(--fb-third_heading_weight); }
  #shopify-section-{{ sid }} .fbct__logo { display: block; margin: 0 auto; height: 45px; width: auto; max-width: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .fbct__logo[hidden] { display: none; }
  #shopify-section-{{ sid }} .fbct__cell { --fbct-ink: var(--fbct-tbg); color: var(--fb-table_icon_color, var(--color-heading)); }
  #shopify-section-{{ sid }} .fbct__mark { display: inline-flex; vertical-align: middle; width: var(--fb-table_icon_size_mobile); height: var(--fb-table_icon_size_mobile); }
  #shopify-section-{{ sid }} .fbct__mark :is(svg, img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .fbct__mark > span { display: contents; }
  #shopify-section-{{ sid }} .fbct__mark[data-v='check'] .fbct__x, #shopify-section-{{ sid }} .fbct__mark:not([data-v='check']) .fbct__ok { display: none; }
  #shopify-section-{{ sid }} .fbct__mark:not([data-v='check']) { color: color-mix(in srgb, currentColor 75%, transparent); }
  #shopify-section-{{ sid }} .fb-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  {%- comment -%} The highlighted column: header to last row, one filled band. {%- endcomment %}
  #shopify-section-{{ sid }} :is(.fbct[data-table_column_active='1'] [data-col='1'], .fbct[data-table_column_active='2'] [data-col='2'], .fbct[data-table_column_active='3'] [data-col='3']) { --fbct-hc: var(--fb-table_heading_active_color, var(--btn-primary-color)); --fbct-ink: var(--fb-table_column_active_bg_color, var(--btn-primary-bg-color)); background: var(--fb-table_column_active_bg_color, var(--btn-primary-bg-color)); color: var(--fb-table_icon_active_color, var(--btn-primary-color)); border-color: transparent; }
  #shopify-section-{{ sid }} .fbct[data-enable_active_column_gradient='true'] :is([data-table_column_active='1'] [data-col='1'], [data-table_column_active='2'] [data-col='2'], [data-table_column_active='3'] [data-col='3']) { background: linear-gradient(var(--fb-active_col_gradient_degrees), var(--fb-active_col_gradient_color_1, var(--btn-primary-bg-color)), var(--fb-active_col_gradient_color_2, var(--btn-primary-bg-color)), var(--fb-active_col_gradient_color_3, var(--btn-primary-bg-color))); }
  #shopify-section-{{ sid }} :is(.fbct[data-table_column_active='1'] th[data-col='1'], .fbct[data-table_column_active='2'] th[data-col='2'], .fbct[data-table_column_active='3'] th[data-col='3']) { border-radius: var(--fb-table_column_active_radius) var(--fb-table_column_active_radius) 0 0 !important; }
  #shopify-section-{{ sid }} :is(.fbct[data-table_column_active='1'] tbody tr:last-child td[data-col='1'], .fbct[data-table_column_active='2'] tbody tr:last-child td[data-col='2'], .fbct[data-table_column_active='3'] tbody tr:last-child td[data-col='3']) { border-radius: 0 0 var(--fb-table_column_active_radius) var(--fb-table_column_active_radius) !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fbct__inner { padding: var(--fb-padding_top) var(--fb-padding_horizontal) var(--fb-padding_bottom); }
    #shopify-section-{{ sid }} .fbct__title { font-size: var(--fb-heading_size); }
    #shopify-section-{{ sid }} .fbct__title[data-fb-block] { font-size: var(--fb-size); }
    #shopify-section-{{ sid }} .fbct__sub { font-size: var(--fb-subheading_font_size); padding-inline: var(--fb-subheading_padding_horizontal); }
    #shopify-section-{{ sid }} .fbct__sub[data-fb-block] { font-size: var(--fb-size); padding-inline: var(--fb-padding_x); }
    #shopify-section-{{ sid }} .fbct__scroll { position: relative; margin-top: var(--fb-table_mt); }
    #shopify-section-{{ sid }} .fbct__table col.fbct__c0 { width: 30%; }
    #shopify-section-{{ sid }} .fbct__table[data-n='2'] col.fbct__c0 { width: 40%; }
    #shopify-section-{{ sid }} .fbct__table :is(th, td) { padding: var(--fb-table_row_padding_vertical) var(--fb-table_row_padding_horizontal); }
    #shopify-section-{{ sid }} .fbct__table thead :is(th, td) { padding: var(--fb-table_heading_padding_vertical) var(--fb-table_heading_padding_horizontal); }
    #shopify-section-{{ sid }} .fbct__rl { font-size: var(--fb-table_row_heading_size); }
    #shopify-section-{{ sid }} .fbct__ct { font-size: var(--fb-table_heading_size); }
    #shopify-section-{{ sid }} .fbct__logo { height: 75px; }
    #shopify-section-{{ sid }} .fbct__mark { width: var(--fb-table_icon_size); height: var(--fb-table_icon_size); }
  }
{% comment %}{% endcomment %}</style>
{%- capture spec -%}{"px":"{{ spx }}","c":"{{ sc }}","w":"{{ sw }}","f":"{{ sf }}","a":"{{ sa }}","t":"{{ stx }}"}{%- endcapture -%}
{%- capture bspec -%}{"heading":{"px":"{{ h_px }}","c":"color","w":"weight","a":"alignment","r":"text"},"subheading":{"px":"{{ s_px }}","c":"color","t":"text"},"item":{"t":"row_heading","v":"first_icon,second_icon,third_icon"},"column":{"c":"color","w":"weight","t":"title","i":"image"}}{%- endcapture -%}
<section class="fbct color-{{ color_scheme }} gradient" data-fb-root="comparison-table" data-fb-section="{{ sid }}"{% if request.design_mode %} data-fb-settings="{{ st | json | escape }}"{% endif %}{% if request.design_mode %} data-fb-spec="{{ spec | escape }}"{% endif %}{% if request.design_mode %} data-fb-bspec="{{ bspec | escape }}"{% endif %}{% for k in sa_list %} data-{{ k }}="{{ st[k] }}"{% endfor %} style="{% render 'features-b-vars', s: st, px: spx, c: sc, w: sw, f: sf, gate: st.enable_custom_style %}">
  <div class="fbct__inner">
    <div class="fbct__head">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- if block.type == 'heading' -%}
          <h2{% unless title_done %} id="fb-title-{{ sid }}"{% assign title_done = true %}{% endunless %} class="fbct__title" data-fb-block="{{ block.id }}" data-fb-type="heading"{% if request.design_mode %} data-fb-bs="{{ bs | json | escape }}"{% endif %} data-fb-bt="{{ block.id }}:text" data-fb-bw="{{ block.id }}:weight" data-fb-f="heading_font" data-alignment="{{ bs.alignment }}" data-own-size{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if st.heading_custom and st.heading_font.family != blank %} data-own-font{% endif %} style="{% render 'features-b-vars', s: bs, px: h_px, c: 'color', w: 'weight', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
        {%- elsif block.type == 'subheading' -%}
          <div class="fbct__sub" data-fb-block="{{ block.id }}" data-fb-type="subheading"{% if request.design_mode %} data-fb-bs="{{ bs | json | escape }}"{% endif %} data-fb-bt="{{ block.id }}:text" style="{% render 'features-b-vars', s: bs, px: s_px, c: 'color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</div>
        {%- endif -%}
      {%- endfor -%}
      {%- unless has_heading_block -%}
        {%- if st.heading != blank -%}{%- assign title_done = true -%}<h2 id="fb-title-{{ sid }}" class="fbct__title" data-fb-t="heading" data-fb-w="heading_font_weight" data-fb-f="heading_font" data-own-size{% if st.heading_font_weight != blank and st.heading_font_weight != 'theme' %} data-own-weight{% endif %}{% if st.heading_custom and st.heading_font.family != blank %} data-own-font{% endif %}>{{ st.heading | escape }}</h2>{%- endif -%}
      {%- endunless -%}
      {%- unless has_sub_block -%}
        {%- if st.subheading_text != blank -%}<div class="fbct__sub" data-fb-t="subheading_text">{{ st.subheading_text | escape }}</div>{%- endif -%}
      {%- endunless -%}
    </div>

    <div class="fbct__scroll" data-fb-scroll role="region" {% if title_done %}aria-labelledby="fb-title-{{ sid }}"{% else %}aria-label="{{ region_label | escape }}"{% endif %} tabindex="0">
      <table class="fbct__table" data-n="{{ ncols }}" style="--fbct-n: {{ ncols }};">
        <colgroup><col class="fbct__c0">{% for i in (1..ncols) %}<col>{% endfor %}</colgroup>
        <thead>
          <tr>
            <td class="fbct__label"></td>
            {%- if col_blocks.size > 0 -%}
              {%- for col in col_blocks limit: 3 -%}
                {%- assign cs = col.settings -%}
                <th scope="col" class="fbct__col" data-col="{{ forloop.index }}" data-fb-block="{{ col.id }}" data-fb-type="column"{% if request.design_mode %} data-fb-bs="{{ cs | json | escape }}"{% endif %} style="{% render 'features-b-vars', s: cs, c: 'color', w: 'weight', gate: cs.enable_custom_style %}" {{ col.shopify_attributes }}>
                  <img class="fbct__logo" data-fb-bi="{{ col.id }}:image" src="{% if cs.image != blank %}{{ cs.image | image_url: width: 300 }}{% endif %}" alt="" width="150" height="75" loading="lazy"{% if cs.image == blank %} hidden data-fb-empty{% endif %}>
                  <span class="fbct__ct" data-fb-bt="{{ col.id }}:title" data-fb-bw="{{ col.id }}:weight" data-fb-f="table_heading_font"{% if cs.weight != blank and cs.weight != 'theme' %} data-own-weight{% endif %}{% if st.table_heading_custom and st.table_heading_font.family != blank %} data-own-font{% endif %}>{{ cs.title | escape }}</span>
                </th>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..ncols) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign t_key = 'first_heading' -%}{%- assign w_key = 'first_heading_weight' -%}
                  {%- when 2 -%}{%- assign t_key = 'second_heading' -%}{%- assign w_key = 'second_heading_weight' -%}
                  {%- else -%}{%- assign t_key = 'third_heading' -%}{%- assign w_key = 'third_heading_weight' -%}
                {%- endcase -%}
                <th scope="col" class="fbct__col" data-col="{{ i }}" data-legacy="{{ i }}">
                  {%- assign has_logo = false -%}
                  {%- if i == 1 and st.enable_logo_column_one -%}
                    {%- if st.enable_logo_url and st.logo_image_url != blank -%}{%- assign has_logo = true -%}<img class="fbct__logo" src="{{ st.logo_image_url | escape }}" alt="{{ st.first_heading | escape }}" width="150" height="75" loading="lazy">
                    {%- elsif st.logo_image_column_one != blank -%}{%- assign has_logo = true -%}<img class="fbct__logo" src="{{ st.logo_image_column_one | image_url: width: 300 }}" alt="{{ st.logo_image_column_one.alt | default: st.first_heading | escape }}" width="150" height="75" loading="lazy">
                    {%- endif -%}
                  {%- endif -%}
                  {%- if has_logo -%}<span class="fb-vh">{{ st[t_key] | escape }}</span>{%- else -%}<span class="fbct__ct" data-fb-t="{{ t_key }}" data-fb-w="{{ w_key }}" data-fb-f="table_heading_font"{% if st[w_key] != blank and st[w_key] != 'theme' %} data-own-weight{% endif %}{% if st.table_heading_custom and st.table_heading_font.family != blank %} data-own-font{% endif %}>{{ st[t_key] | escape }}</span>{%- endif -%}
                </th>
              {%- endfor -%}
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign rs = row.settings -%}
            <tr data-fb-block="{{ row.id }}" data-fb-type="item"{% if request.design_mode %} data-fb-bs="{{ rs | json | escape }}"{% endif %} {{ row.shopify_attributes }}>
              <th scope="row" class="fbct__label"><span class="fbct__rl" data-fb-bt="{{ row.id }}:row_heading" data-fb-f="table_row_heading_font"{% if st.table_row_heading_custom and st.table_row_heading_font.family != blank %} data-own-font{% endif %}>{{ rs.row_heading | escape }}</span></th>
              {%- for i in (1..ncols) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign k = 'first_icon' -%}
                  {%- when 2 -%}{%- assign k = 'second_icon' -%}
                  {%- else -%}{%- assign k = 'third_icon' -%}
                {%- endcase -%}
                <td class="fbct__cell" data-col="{{ i }}">
                  <span class="fbct__mark" data-fb-bv="{{ row.id }}:{{ k }}" data-v="{{ rs[k] | default: 'check' }}">
                    <span class="fbct__ok">{{ icon_check }}<span class="fb-vh" data-fb-t="check_label">{{ st.check_label }}</span></span>
                    <span class="fbct__x">{{ icon_x }}<span class="fb-vh" data-fb-t="cross_label">{{ st.cross_label }}</span></span>
                  </span>
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
</template>

<schema>
