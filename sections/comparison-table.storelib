<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
{% comment %}{% endcomment %}</style>

{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width

  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size
  assign heading_color = section.settings.heading_color
  assign heading_custom = section.settings.heading_custom
  assign heading_font = section.settings.heading_font
  assign heading_height = section.settings.heading_height
  assign heading_align = section.settings.heading_align
  assign heading_font_weight = section.settings.heading_font_weight

  assign subheading_text = section.settings.subheading_text
  assign subheading_font_size = section.settings.subheading_font_size
  assign subheading_font_size_mobile = section.settings.subheading_font_size_mobile
  assign subheading_padding_horizontal = section.settings.subheading_padding_horizontal
  assign subheading_padding_horizontal_mobile = section.settings.subheading_padding_horizontal_mobile

  assign table_mt = section.settings.table_mt
  assign table_column_active = section.settings.table_column_active
  assign table_border_thickness = section.settings.table_border_thickness
  assign table_border_color = section.settings.table_border_color
  assign table_radius = section.settings.table_radius

  assign first_heading = section.settings.first_heading
  assign second_heading = section.settings.second_heading
  assign third_heading = section.settings.third_heading

  assign first_heading_weight = section.settings.first_heading_weight
  assign second_heading_weight = section.settings.second_heading_weight
  assign third_heading_weight = section.settings.third_heading_weight

  assign first_heading_color_custom = section.settings.first_heading_color_custom
  assign second_heading_color_custom = section.settings.second_heading_color_custom
  assign third_heading_color_custom = section.settings.third_heading_color_custom

  assign table_heading_size = section.settings.table_heading_size
  assign table_heading_size_mobile = section.settings.table_heading_size_mobile
  assign table_heading_color = section.settings.table_heading_color
  assign table_heading_active_color = section.settings.table_heading_active_color
  assign table_heading_custom = section.settings.table_heading_custom
  assign table_heading_font = section.settings.table_heading_font
  assign table_heading_height = section.settings.table_heading_height
  assign table_heading_align = section.settings.table_heading_align
  assign table_heading_padding_horizontal = section.settings.table_heading_padding_horizontal
  assign table_heading_padding_horizontal_mobile = section.settings.table_heading_padding_horizontal_mobile
  assign table_heading_padding_vertical = section.settings.table_heading_padding_vertical
  assign table_heading_padding_vertical_mobile = section.settings.table_heading_padding_vertical_mobile
  assign table_column_active_radius = section.settings.table_column_active_radius

  assign table_row_padding_horizontal = section.settings.table_row_padding_horizontal
  assign table_row_padding_horizontal_mobile = section.settings.table_row_padding_horizontal_mobile
  assign table_row_padding_vertical = section.settings.table_row_padding_vertical
  assign table_row_padding_vertical_mobile = section.settings.table_row_padding_vertical_mobile

  assign table_row_heading_size = section.settings.table_row_heading_size
  assign table_row_heading_size_mobile = section.settings.table_row_heading_size_mobile
  assign table_row_heading_color = section.settings.table_row_heading_color
  assign table_row_heading_custom = section.settings.table_row_heading_custom
  assign table_row_heading_font = section.settings.table_row_heading_font
  assign table_row_heading_height = section.settings.table_row_heading_height
  assign table_row_heading_align = section.settings.table_row_heading_align

  assign table_icon_check = section.settings.table_icon_check
  assign table_icon_x = section.settings.table_icon_x

  assign table_icon_check_svg = section.settings.table_icon_check_svg
  assign table_icon_x_svg = section.settings.table_icon_x_svg

  assign enable_icon_color_customizers = section.settings.enable_icon_color_customizers
  assign table_icon_color = section.settings.table_icon_color
  assign table_icon_active_color = section.settings.table_icon_active_color
  assign table_icon_size = section.settings.table_icon_size
  assign table_icon_size_mobile = section.settings.table_icon_size_mobile

  assign enable_active_column_gradient = section.settings.enable_active_column_gradient
  assign active_col_gradient_color_1 = section.settings.active_col_gradient_color_1
  assign active_col_gradient_color_2 = section.settings.active_col_gradient_color_2
  assign active_col_gradient_color_3 = section.settings.active_col_gradient_color_3
  assign active_col_gradient_degrees = section.settings.active_col_gradient_degrees

  assign enable_logo_column_one = section.settings.enable_logo_column_one
  assign enable_logo_url = section.settings.enable_logo_url
  assign logo_image_url = section.settings.logo_image_url
  assign logo_image_column_one = section.settings.logo_image_column_one

  assign enable_table_bg_gradient = section.settings.enable_table_bg_gradient
  assign table_bg_color = section.settings.table_bg_color
  assign table_bg_color_2 = section.settings.table_bg_color_2
  assign table_bg_gradient_degrees = section.settings.table_bg_gradient_degrees
-%}
{%- comment -%} Colours follow the colour scheme unless a colour is picked. {%- endcomment -%}
{%- capture heading_color -%}{% render 'scheme-color', color: section.settings.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture table_border_color -%}{% render 'scheme-color', color: section.settings.table_border_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture table_heading_color -%}{% render 'scheme-color', color: section.settings.table_heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture table_heading_active_color -%}{% render 'scheme-color', color: section.settings.table_heading_active_color, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}
{%- capture table_row_heading_color -%}{% render 'scheme-color', color: section.settings.table_row_heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture table_icon_color -%}{% render 'scheme-color', color: section.settings.table_icon_color, fallback: 'color-mix(in srgb, var(--color-text) 45%, transparent)' %}{%- endcapture -%}
{%- capture table_icon_active_color -%}{% render 'scheme-color', color: section.settings.table_icon_active_color, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}
{%- capture table_column_active_bg_color -%}{% render 'scheme-color', color: section.settings.table_column_active_bg_color, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture active_col_gradient_color_1 -%}{% render 'scheme-color', color: section.settings.active_col_gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture active_col_gradient_color_2 -%}{% render 'scheme-color', color: section.settings.active_col_gradient_color_2, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture active_col_gradient_color_3 -%}{% render 'scheme-color', color: section.settings.active_col_gradient_color_3, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture table_bg_color -%}{% render 'scheme-color', color: section.settings.table_bg_color, fallback: 'var(--color-background)' %}{%- endcapture -%}
{%- capture table_bg_color_2 -%}{% render 'scheme-color', color: section.settings.table_bg_color_2, fallback: 'var(--color-background)' %}{%- endcapture -%}
{%- capture section_bg_out -%}{% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %}{%- endcapture -%}
{%- capture background_color -%}{% render 'scheme-color', color: section.settings.background_color, fallback: section_bg_out %}{%- endcapture -%}
{%- liquid
  assign col_fb = 'var(--color-heading)'
  if table_column_active == '1'
    assign col_fb = 'var(--btn-primary-color)'
  endif
-%}
{%- capture first_heading_color_custom -%}{% render 'scheme-color', color: section.settings.first_heading_color_custom, fallback: col_fb %}{%- endcapture -%}
{%- liquid
  assign col_fb = 'var(--color-heading)'
  if table_column_active == '2'
    assign col_fb = 'var(--btn-primary-color)'
  endif
-%}
{%- capture second_heading_color_custom -%}{% render 'scheme-color', color: section.settings.second_heading_color_custom, fallback: col_fb %}{%- endcapture -%}
{%- liquid
  assign col_fb = 'var(--color-heading)'
  if table_column_active == '3'
    assign col_fb = 'var(--btn-primary-color)'
  endif
-%}
{%- capture third_heading_color_custom -%}{% render 'scheme-color', color: section.settings.third_heading_color_custom, fallback: col_fb %}{%- endcapture -%}
{%- if heading_font_weight == blank or heading_font_weight == 'theme' -%}{%- assign heading_font_weight = 'var(--heading-weight, 700)' -%}{%- endif -%}
{%- if first_heading_weight == blank or first_heading_weight == 'theme' -%}{%- assign first_heading_weight = 'var(--heading-weight, 700)' -%}{%- endif -%}
{%- if second_heading_weight == blank or second_heading_weight == 'theme' -%}{%- assign second_heading_weight = 'var(--heading-weight, 700)' -%}{%- endif -%}
{%- if third_heading_weight == blank or third_heading_weight == 'theme' -%}{%- assign third_heading_weight = 'var(--heading-weight, 700)' -%}{%- endif -%}

{% capture icon_check %}
  {% if table_icon_check_svg != blank %}
    {{ table_icon_check_svg }}
  {% elsif table_icon_check != blank %}
    <img src="{{ table_icon_check | image_url }}" alt="{{ table_icon_check.alt }}">
  {% else %}
    <!-- Default CHECK icon -->
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path fill-rule="evenodd" clip-rule="evenodd" d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12ZM16.0303 8.96967C16.3232 9.26256 16.3232 9.73744 16.0303 10.0303L11.0303 15.0303C10.7374 15.3232 10.2626 15.3232 9.96967 15.0303L7.96967 13.0303C7.67678 12.7374 7.67678 12.2626 7.96967 11.9697C8.26256 11.6768 8.73744 11.6768 9.03033 11.9697L10.5 13.4393L12.7348 11.2045L14.9697 8.96967C15.2626 8.67678 15.7374 8.67678 16.0303 8.96967Z" fill="#04ff00"></path> </g></svg>
  {% endif %}
{% endcapture %}

{% capture icon_x %}
  {% if table_icon_x_svg != blank %}
    {{ table_icon_x_svg }}
  {% elsif table_icon_x != blank %}
    <img src="{{ table_icon_x | image_url }}" alt="{{ table_icon_x.alt }}">
  {% else %}
    <!-- Default X icon -->
    <svg width="180px" height="180px" viewBox="-3.6 -3.6 31.20 31.20" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M20.7457 3.32851C20.3552 2.93798 19.722 2.93798 19.3315 3.32851L12.0371 10.6229L4.74275 3.32851C4.35223 2.93798 3.71906 2.93798 3.32854 3.32851C2.93801 3.71903 2.93801 4.3522 3.32854 4.74272L10.6229 12.0371L3.32856 19.3314C2.93803 19.722 2.93803 20.3551 3.32856 20.7457C3.71908 21.1362 4.35225 21.1362 4.74277 20.7457L12.0371 13.4513L19.3315 20.7457C19.722 21.1362 20.3552 21.1362 20.7457 20.7457C21.1362 20.3551 21.1362 19.722 20.7457 19.3315L13.4513 12.0371L20.7457 4.74272C21.1362 4.3522 21.1362 3.71903 20.7457 3.32851Z" fill="#a8a8a8"></path> </g></svg>
  {% endif %}
{% endcapture %}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ table_heading_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px !important;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px !important;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px !important;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px !important;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto !important;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px !important;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px !important;
    /* Mobile left/right padding */
    justify-content: center;
    padding-left: {{ padding_horizontal_mobile }}rem !important;
    padding-right: {{ padding_horizontal_mobile }}rem !important;
  }

  .loudecoms-heading-{{ section.id }} {
    margin: 0 !important;
    font-size: {{ heading_size | times: 0.85 }}px !important;
    /* Font Weight from new setting */
    font-weight: {{ heading_font_weight }} !important;
    color: {{ heading_color }} !important;
    line-height: {{ heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ heading_align }} !important;
    display: block !important;
    width: 100% !important;
  }

  /* Subheading styles */
  .subheading-{{ section.id }} {
    font-size: {{ subheading_font_size_mobile }}px !important;
    text-align: {{ heading_align }} !important;
    padding-left: {{ subheading_padding_horizontal_mobile }}px !important;
    padding-right: {{ subheading_padding_horizontal_mobile }}px !important;
    margin: 10px auto 0 auto !important;
    line-height: 140% !important;
    display: block !important;
    width: 100% !important;
  }
  @media (min-width: 768px) {
    .subheading-{{ section.id }} {
      font-size: {{ subheading_font_size }}px !important;
      padding-left: {{ subheading_padding_horizontal }}px !important;
      padding-right: {{ subheading_padding_horizontal }}px !important;
    }
  }

  .loudecoms-body-{{ section.id }} {
    margin-top: {{ table_mt | times: 0.75 | round: 0 }}px !important;
  }

  .loudecoms-grid-{{ section.id }} {
    display: grid !important;
    {% if third_heading != blank %}
      grid-template-columns: 29% 24% 23.5% 23.5% !important;
    {% else %}
      grid-template-columns: 40% 30% 30% !important;
    {% endif %}
  }

  .loudecoms-item-{{ section.id }} {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Active column gradient or solid color */
  .loudecoms-item-{{ section.id }}.active {
    {% if enable_active_column_gradient %}
      background: linear-gradient(
        {{ active_col_gradient_degrees }},
        {{ active_col_gradient_color_1 }},
        {{ active_col_gradient_color_2 }},
        {{ active_col_gradient_color_3 }}
      ) !important;
    {% else %}
      background-color: {{ table_column_active_bg_color }} !important;
    {% endif %}
  }

  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} {
    padding: {{ table_heading_padding_vertical_mobile }}px {{ table_heading_padding_horizontal_mobile }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }}.active {
    border-top-left-radius: {{ table_column_active_radius }}px !important;
    border-top-right-radius: {{ table_column_active_radius }}px !important;
  }

  /* HEADINGS inside columns (by default) */
  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
    margin: 0 !important;
    font-size: {{ table_heading_size_mobile }}px !important;
    color: {{ table_heading_color }} !important;
    line-height: {{ table_heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ table_heading_align }} !important;
    display: block !important;
    width: 100% !important;
    font-weight: var(--heading-weight, 700) !important;
  }

  /* Active column heading color */
  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }}.active h3 {
    color: {{ table_heading_active_color }} !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child {
    border-top-left-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}:last-child {
    border-top-right-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}.active:last-child {
    border-top-right-radius: 0px !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }} {
    padding: {{ table_row_padding_vertical_mobile }}px {{ table_row_padding_horizontal_mobile }}px !important;
    border-top: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child {
    border-left: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:last-child {
    border-right: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  /* Active column border color override */
  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active {
    position: relative !important;
    border-color: {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active::after {
    content: '' !important;
    position: absolute !important;
    width: 100% !important;
    height: 15px !important;
    left: 0 !important;
    bottom: -15px !important;
    {% if enable_active_column_gradient %}
      background: linear-gradient(
        {{ active_col_gradient_degrees }},
        {{ active_col_gradient_color_1 }},
        {{ active_col_gradient_color_2 }},
        {{ active_col_gradient_color_3 }}
      ) !important;
    {% else %}
      background-color: {{ table_column_active_bg_color }} !important;
    {% endif %}
    border-bottom-left-radius: {{ table_column_active_radius }}px !important;
    border-bottom-right-radius: {{ table_column_active_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }} {
    border-bottom: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active {
    border-color: {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}:first-child {
    border-bottom-left-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}:last-child {
    border-bottom-right-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active:last-child {
    border-bottom-right-radius: 0px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active:last-child::after {
    border-right: {{ table_border_thickness }}px solid {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
    box-sizing: content-box !important;
  }

  /* Row heading (first cell in each row) */
  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
    margin: 0 !important;
    font-size: {{ table_row_heading_size_mobile }}px !important;
    color: {{ table_row_heading_color }} !important;
    line-height: {{ table_row_heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ table_row_heading_align }} !important;
    display: block !important;
    width: 100% !important;
    font-weight: var(--heading-weight, 700) !important;
  }

  /* ICONS */
  .loudecoms-icon-{{ section.id }} {
    width: {{ table_icon_size_mobile }}px !important;
    height: {{ table_icon_size_mobile }}px !important;
  }

  /* Only apply custom colors if the toggle is enabled */
  {% if enable_icon_color_customizers %}
    .loudecoms-icon-{{ section.id }}.icon-check-{{ section.id }} svg path,
    .loudecoms-icon-{{ section.id }}.icon-x-{{ section.id }} svg path {
      fill: {{ table_icon_color }} !important;
    }

    .loudecoms-item-{{ section.id }}.active .loudecoms-icon-{{ section.id }}.icon-check-{{ section.id }} svg path,
    .loudecoms-item-{{ section.id }}.active .loudecoms-icon-{{ section.id }}.icon-x-{{ section.id }} svg path {
      fill: {{ table_icon_active_color }} !important;
    }
  {% endif %}

  .loudecoms-icon-{{ section.id }} svg,
  .loudecoms-icon-{{ section.id }} img {
    display: block !important;
    object-fit: contain !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Single background color/gradient for entire table (all rows) */
  .loudecoms-grid-rows-{{ section.id }} {
    {% if enable_table_bg_gradient %}
      background: linear-gradient(
        {{ table_bg_gradient_degrees }},
        {{ table_bg_color }},
        {{ table_bg_color_2 }}
      ) !important;
    {% else %}
      background-color: {{ table_bg_color }} !important;
    {% endif %}
  }

  /* Logo Image (Column One) */
  .logo-image-col1-{{ section.id }} img.logo-image-col1-img-{{ section.id }} {
    max-width: 100% !important;
    text-align: center;
    object-fit: cover !important;
    display: block !important;
    height: 75px !important;
    justify-content: center;
  }

  @media(min-width: 350px) {
    .loudecoms-grid-{{ section.id }} {
      {% if third_heading != blank %}
        grid-template-columns: 38% 22% 20% 20% !important;
      {% else %}
        grid-template-columns: 40% 30% 30% !important;
      {% endif %}
    }
  }

  @media (max-width: 768px) {
    .logo-image-col1-{{ section.id }} img.logo-image-col1-img-{{ section.id }} {
      max-width: 100% !important;
      text-align: center;
      object-fit: cover !important;
      display: block !important;
      height: 45px !important;
    }
  }

  @media(min-width: 768px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px !important;
      margin-bottom: {{ margin_bottom }}px !important;
    }

    /* Desktop left/right padding now driven by user setting */
    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px !important;
      padding-bottom: {{ padding_bottom }}px !important;
      padding-left: {{ padding_horizontal }}rem !important;
      padding-right: {{ padding_horizontal }}rem !important;
    }

    .loudecoms-grid-{{ section.id }} {
      {% if third_heading != blank %}
        grid-template-columns: 30% 22% 24% 24% !important;
      {% else %}
        grid-template-columns: 40% 28% 32% !important;
      {% endif %}
    }

    .loudecoms-heading-{{ section.id }} {
      font-size: {{ heading_size }}px !important;
    }

    .loudecoms-body-{{ section.id }} {
      margin-top: {{ table_mt }}px !important;
    }

    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} {
      padding: {{ table_heading_padding_vertical }}px {{ table_heading_padding_horizontal }}px !important;
    }

    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
      font-size: {{ table_heading_size }}px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }} {
      padding: {{ table_row_padding_vertical }}px {{ table_row_padding_horizontal }}px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active::after {
      height: 25px !important;
      bottom: -25px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
      font-size: {{ table_row_heading_size }}px !important;
    }

    .loudecoms-icon-{{ section.id }} {
      width: {{ table_icon_size }}px !important;
      height: {{ table_icon_size }}px !important;
    }
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem !important;
    }
{% comment %}{% endcomment %}  </style>
{% endunless %}

{% if heading_custom %}
  <style>
    .loudecoms-heading-{{ section.id }} {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }} !important;
      font-weight: {{ heading_font.weight }} !important;
      font-style: {{ heading_font.style }} !important;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

{% if table_heading_custom %}
  <style>
    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
      font-family: {{ table_heading_font.family }}, {{ table_heading_font.fallback_families }} !important;
      font-weight: {{ table_heading_font.weight }} !important;
      font-style: {{ table_heading_font.style }} !important;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

{% if table_row_heading_custom %}
  <style>
    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
      font-family: {{ table_row_heading_font.family }}, {{ table_row_heading_font.fallback_families }} !important;
      font-weight: {{ table_row_heading_font.weight }} !important;
      font-style: {{ table_row_heading_font.style }} !important;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<div
  class="section-{{ section.id }} loudecoms-{{ section.id }} color-{{ color_scheme }} gradient"
  style="background-color:{{ background_color }} !important; background-image: {{ background_gradient }} !important;"
>
  <div class="section-{{ section.id }}-settings">
    {%- comment -%}
      Heading + subheading rendered from blocks. Falls back to legacy
      `section.settings.heading` / `subheading_text` when no block of
      the matching type is present (preserves saved instances).
    {%- endcomment -%}
    {%- assign __ct_has_heading_block = false -%}
    {%- assign __ct_has_subheading_block = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' and block.settings.text != blank -%}
        {%- assign __ct_has_heading_block = true -%}
        <h2 class="loudecoms-heading-{{ section.id }}"
            style="color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %};
                   font-size: {{ block.settings.size | default: 34 }}px;
                   line-height: {{ block.settings.line_height | default: 100 }}%;
                   text-align: {{ block.settings.alignment | default: 'center' }};
                   font-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %};"
            {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        <style>
          @media (max-width: 767px) {
            #shopify-section-{{ section.id }} .loudecoms-heading-{{ section.id }} {
              font-size: {{ block.settings.size_mobile | default: 28 }}px !important;
            }
          }
{% comment %}{% endcomment %}        </style>
      {%- elsif block.type == 'subheading' and block.settings.text != blank -%}
        {%- assign __ct_has_subheading_block = true -%}
        <div class="subheading-{{ section.id }}"
             style="color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %};
                    font-size: {{ block.settings.size | default: 16 }}px;
                    padding-left: {{ block.settings.padding_x | default: 0 }}px;
                    padding-right: {{ block.settings.padding_x | default: 0 }}px;"
             {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        <style>
          @media (max-width: 767px) {
            #shopify-section-{{ section.id }} .subheading-{{ section.id }} {
              font-size: {{ block.settings.size_mobile | default: 15 }}px !important;
              padding-left: {{ block.settings.padding_x_mobile | default: 0 }}px !important;
              padding-right: {{ block.settings.padding_x_mobile | default: 0 }}px !important;
            }
          }
{% comment %}{% endcomment %}        </style>
      {%- endif -%}
    {%- endfor -%}
    {%- comment -%} Backward-compat fallback for legacy instances without blocks. {%- endcomment -%}
    {%- unless __ct_has_heading_block -%}
      {% if heading != blank %}
        <h2 class="loudecoms-heading-{{ section.id }}">{{ heading }}</h2>
      {% endif %}
    {%- endunless -%}
    {%- unless __ct_has_subheading_block -%}
      {% if subheading_text != blank %}
        <div class="subheading-{{ section.id }}">
          {{ subheading_text }}
        </div>
      {% endif %}
    {%- endunless -%}

    <div class="loudecoms-body-{{ section.id }}">
      <div class="loudecoms-grid-{{ section.id }} loudecoms-grid-header-{{ section.id }}">
        <!-- Empty top-left cell -->
        <div class="loudecoms-item-{{ section.id }}"></div>

        <!-- Column 1 Heading or Logo -->
        <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '1' %}active{% endif %}">
          {%- assign __has_col1_logo = false -%}
          {%- if enable_logo_url and logo_image_url != blank -%}{%- assign __has_col1_logo = true -%}{%- elsif logo_image_column_one != blank -%}{%- assign __has_col1_logo = true -%}{%- endif -%}
          {% if enable_logo_column_one and __has_col1_logo %}
            <!-- Show Logo -->
            <div class="logo-image-col1-{{ section.id }}">
              <img
                src="{% if enable_logo_url and logo_image_url != blank %}{{ logo_image_url }}{% else %}{{ logo_image_column_one | image_url }}{% endif %}"
                alt="{{ 'accessibility.logo_column' | t }}"
                class="logo-image-col1-img-{{ section.id }}"
              >
            </div>
          {% else %}
            <!-- Show Heading Text -->
            <h3
              style="
                font-weight: {{ first_heading_weight }} !important;
                color: {{ first_heading_color_custom }} !important;
              "
            >
              {{ first_heading }}
            </h3>
          {% endif %}
        </div>

        <!-- Column 2 Heading -->
        <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '2' %}active{% endif %}">
          <h3
            style="
              font-weight: {{ second_heading_weight }} !important;
              color: {{ second_heading_color_custom }} !important;
            "
          >
            {{ second_heading }}
          </h3>
        </div>

        <!-- Column 3 Heading (if any) -->
        {% if third_heading != blank %}
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '3' %}active{% endif %}">
            <h3
              style="
                font-weight: {{ third_heading_weight }} !important;
                color: {{ third_heading_color_custom }} !important;
              "
            >
              {{ third_heading }}
            </h3>
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {%- if block.type != 'item' -%}{%- continue -%}{%- endif -%}
        <div class="loudecoms-grid-{{ section.id }} loudecoms-grid-rows-{{ section.id }}" {{ block.shopify_attributes }}>
          <!-- Row heading cell -->
          <div class="loudecoms-item-{{ section.id }}">
            <h3>
              {{ block.settings.row_heading }}
            </h3>
          </div>

          <!-- Column 1 cell -->
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '1' %}active{% endif %}">
            <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.first_icon }}-{{ section.id }}">
              {% if block.settings.first_icon == 'check' %}
                {{ icon_check }}
              {% else %}
                {{ icon_x }}
              {% endif %}
            </div>
          </div>

          <!-- Column 2 cell -->
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '2' %}active{% endif %}">
            <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.second_icon }}-{{ section.id }}">
              {% if block.settings.second_icon == 'check' %}
                {{ icon_check }}
              {% else %}
                {{ icon_x }}
              {% endif %}
            </div>
          </div>

          <!-- Column 3 cell (if any) -->
          {% if third_heading != blank %}
            <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '3' %}active{% endif %}">
              <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.third_icon }}-{{ section.id }}">
                {% if block.settings.third_icon == 'check' %}
                  {{ icon_check }}
                {% else %}
                  {{ icon_x }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "comparison-table",
  "name": "Comparison Table",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "rem",
      "label": "Content width",
      "default": 150,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Bottom Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "label": "Side padding (mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "label": "Side padding (desktop)",
      "default": 5
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Heading (Section Title)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Comparison Table"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Section Title Font Size",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Section Title Line Height",
      "default": 100
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Section Title Alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Section Title Font Weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "lighter",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading_text",
      "label": "Subheading Text",
      "default": "Easily Compare Features, Pricing, and Benefits Side by Side to Find the Perfect Option for Your Needs"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_padding_horizontal",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Subheading side padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "subheading_padding_horizontal_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Subheading side padding (mobile)",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Table Header Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_logo_column_one",
      "label": "Logo in column one",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_logo_url",
      "label": "Logo from URL",
      "default": false
    },
    {
      "type": "text",
      "id": "logo_image_url",
      "label": "Logo Image URL"
    },
    {
      "type": "image_picker",
      "id": "logo_image_column_one",
      "label": "Column one logo"
    },
    {
      "type": "text",
      "id": "first_heading",
      "label": "Heading for Column One",
      "default": "Our Brand"
    },
    {
      "type": "select",
      "id": "first_heading_weight",
      "label": "Column One Heading Font Weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "lighter",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "first_heading_color_custom",
      "label": "Column One Heading Color"
    },
    {
      "type": "text",
      "id": "second_heading",
      "label": "Heading for Column Two",
      "default": "Others"
    },
    {
      "type": "select",
      "id": "second_heading_weight",
      "label": "Column Two Heading Font Weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "lighter",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "second_heading_color_custom",
      "label": "Column Two Heading Color"
    },
    {
      "type": "text",
      "id": "third_heading",
      "label": "Heading for Column Three"
    },
    {
      "type": "select",
      "id": "third_heading_weight",
      "label": "Column Three Heading Font Weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "lighter",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "third_heading_color_custom",
      "label": "Column Three Heading Color"
    },
    {
      "type": "checkbox",
      "id": "table_heading_custom",
      "label": "Custom header font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "table_heading_font",
      "label": "Header font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "table_heading_size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Table Header Font Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "table_heading_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Table Header Font Size (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "table_heading_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Table Header Line Height",
      "default": 100
    },
    {
      "type": "select",
      "id": "table_heading_align",
      "label": "Table Header Text Align",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "table_heading_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Header side padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "table_heading_padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Header side padding (mobile)",
      "default": 4
    },
    {
      "type": "range",
      "id": "table_heading_padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Header padding (top/bottom)",
      "default": 20
    },
    {
      "type": "range",
      "id": "table_heading_padding_vertical_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Header padding (mobile)",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_47",
      "label": "Table Icons Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_icon_color_customizers",
      "label": "Custom icon colors",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "table_icon_check",
      "label": "Check Icon (Image)"
    },
    {
      "type": "textarea",
      "id": "table_icon_check_svg",
      "label": "Check Icon (SVG Code)"
    },
    {
      "type": "image_picker",
      "id": "table_icon_x",
      "label": "X Icon (Image)"
    },
    {
      "type": "textarea",
      "id": "table_icon_x_svg",
      "label": "X Icon (SVG Code)"
