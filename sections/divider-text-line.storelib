<template compat="shopify">
<script src="{{ 'live-r7-extras.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Divider With Text: a thin line with a few words set into
  it, at the start, in the middle or at the end, and an optional link on
  the far side ("New in ———— Shop all"). One Text block and one Link
  block; with neither it is a plain line. The line is solid, dashed or
  dotted in the scheme's border colour, as quiet as the theme's Divider.

  Theme first: colours from the colour scheme, the text in the body font
  (Small label) or the heading font (Heading). Custom colours and the
  custom font only while their switch is on. Every value is a CSS variable
  or an attribute on the root and the blocks, printed here for the first
  paint and written again by shopify/assets/live-r7-extras.js on a live
  edit (the same names and fallbacks).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign design = request.design_mode
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign b_text = section.blocks | where: 'type', 'label' | first
  assign b_link = section.blocks | where: 'type', 'link' | first
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-r7x-space>#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}@media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}{% if st.reset_spacing %}#shopify-section-{{ sid }}{margin-top:0!important;margin-bottom:0!important}#shopify-section-{{ sid }} + .shopify-section{margin-top:0!important}{% endif %}{% comment %}{% endcomment %}</style>
{%- if b_text and b_text.settings.enable_custom_fonts and b_text.settings.font.family != blank -%}
<style>{{ b_text.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>
{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .dtl {
    --dtl-edge: 20px;
    box-sizing: border-box;
    padding-top: var(--dtl-pt-m, 16px);
    padding-bottom: var(--dtl-pb-m, 16px);
    background: var(--dtl-bg, var(--color-background));
    color: var(--color-text);
  }
  #shopify-section-{{ sid }} .dtl *, #shopify-section-{{ sid }} .dtl *::before, #shopify-section-{{ sid }} .dtl *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .dtl [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .dtl__inner { width: 100%; margin-inline: auto; padding-inline: var(--dtl-edge); }
  #shopify-section-{{ sid }} .dtl__row {
    display: flex;
    align-items: center;
    gap: var(--dtl-gap, 14px);
    width: var(--dtl-w, 100%);
    min-height: 24px;
    margin-inline: auto;
  }
  #shopify-section-{{ sid }} .dtl[data-align='left'] .dtl__row { margin-inline: 0 auto; }
  #shopify-section-{{ sid }} .dtl[data-align='right'] .dtl__row { margin-inline: auto 0; }
  #shopify-section-{{ sid }} .dtl__line {
    flex: 1 1 0;
    min-width: 24px;
    height: 0;
    border: 0;
    border-top: var(--dtl-t, 1px) var(--dtl-style, solid) var(--dtl-line, var(--color-border));
  }
  /* Where the text sits: the lines and the link take their places round it. */
  #shopify-section-{{ sid }} .dtl[data-pos='start'] .dtl__line--lead,
  #shopify-section-{{ sid }} .dtl[data-pos='end'] .dtl__line--tail { display: none; }
  #shopify-section-{{ sid }} .dtl[data-pos='start'] .dtl__text { order: 1; }
  #shopify-section-{{ sid }} .dtl[data-pos='start'] .dtl__line--tail { order: 2; }
  #shopify-section-{{ sid }} .dtl[data-pos='start'] .dtl__link { order: 3; }
  #shopify-section-{{ sid }} .dtl[data-pos='end'] .dtl__link { order: 1; }
  #shopify-section-{{ sid }} .dtl[data-pos='end'] .dtl__line--lead { order: 2; }
  #shopify-section-{{ sid }} .dtl[data-pos='end'] .dtl__text { order: 3; text-align: end; }
  #shopify-section-{{ sid }} .dtl[data-pos='center'] .dtl__line--lead { order: 1; }
  #shopify-section-{{ sid }} .dtl[data-pos='center'] .dtl__text { order: 2; text-align: center; }
  #shopify-section-{{ sid }} .dtl[data-pos='center'] .dtl__line--tail { order: 3; }
  #shopify-section-{{ sid }} .dtl[data-pos='center'] .dtl__link { order: 4; }

  #shopify-section-{{ sid }} .dtl__text {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 72%;
    margin: 0;
    font-family: var(--dtl-font, var(--body-font, inherit));
    font-weight: var(--subheading-weight, 500);
    font-size: var(--dtl-size-m, 12px);
    line-height: 1.3;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--dtl-tc, var(--color-text));
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  #shopify-section-{{ sid }} .dtl__text[data-style='heading'] {
    font-family: var(--dtl-font, var(--heading-font, inherit));
    font-weight: var(--heading-weight, 700);
    line-height: var(--heading-line-height, 1.2);
    letter-spacing: var(--heading-letter-spacing, normal);
    text-transform: var(--heading-text-transform, none);
    color: var(--dtl-tc, var(--color-heading));
  }
  #shopify-section-{{ sid }} .dtl__link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-family: var(--body-font, inherit);
    font-size: 13px;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--dtl-lc, var(--color-heading));
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .dtl__link span { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .25em; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); transition: text-decoration-color .2s ease; }
  #shopify-section-{{ sid }} .dtl__link svg { width: 14px; height: 14px; flex: none; transition: transform .2s ease; }
  #shopify-section-{{ sid }} .dtl__link svg:dir(rtl) { transform: scaleX(-1); }
  #shopify-section-{{ sid }} a.dtl__link[href]:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
  #shopify-section-{{ sid }} a.dtl__link[href]:active { opacity: .65; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} a.dtl__link[href]:hover span { text-decoration-color: currentColor; }
    #shopify-section-{{ sid }} a.dtl__link[href]:hover svg { transform: translateX(3px); }
    #shopify-section-{{ sid }} a.dtl__link[href]:hover svg:dir(rtl) { transform: scaleX(-1) translateX(3px); }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .dtl { --dtl-edge: 24px; padding-top: var(--dtl-pt, 24px); padding-bottom: var(--dtl-pb, 24px); }
    #shopify-section-{{ sid }} .dtl__text { font-size: var(--dtl-size, 13px); }
    #shopify-section-{{ sid }} .dtl__link { font-size: 14px; }
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ sid }} .dtl[data-width='container'] .dtl__inner { width: 90%; }
    #shopify-section-{{ sid }} .dtl[data-width='fluid_container'] .dtl__inner { width: 95%; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .dtl[data-width='container'] .dtl__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    #shopify-section-{{ sid }} .dtl[data-width='fluid_container'] .dtl__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    #shopify-section-{{ sid }} .dtl[data-width='stretch_width'] { --dtl-edge: 3rem; }
    #shopify-section-{{ sid }} .dtl[data-width='full_width'] { --dtl-edge: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .dtl__link span, #shopify-section-{{ sid }} .dtl__link svg { transition: none; }
    #shopify-section-{{ sid }} a.dtl__link[href]:hover svg { transform: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture dtl_vars -%}
--dtl-pt: {{ st.padding_top | default: 0 }}px; --dtl-pb: {{ st.padding_bottom | default: 0 }}px; --dtl-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --dtl-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --dtl-w: {{ st.width_pct | default: 100 }}%; --dtl-gap: {{ st.label_gap | default: 0 }}px; --dtl-t: {{ st.thickness | default: 1 }}px; --dtl-style: {{ st.style | default: 'solid' }};
{%- if custom -%}
  {%- capture dtl_line -%}{% render 'scheme-color', color: st.color_from, fallback: 'none' %}{%- endcapture -%}
  {%- assign dtl_line = dtl_line | strip -%}
  {%- if dtl_line != 'none' %} --dtl-line: {{ dtl_line }};{% endif -%}
  {%- capture dtl_bg -%}{% render 'scheme-color', color: st.section_bg, fallback: 'none' %}{%- endcapture -%}
  {%- assign dtl_bg = dtl_bg | strip -%}
  {%- if dtl_bg != 'none' %} --dtl-bg: {{ dtl_bg }};{% endif -%}
{%- endif -%}
{%- endcapture -%}
<div
  class="dtl color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}"
  data-r7x="divider-text-line"
  data-r7x-section="{{ sid }}"{% if design %}
  data-r7x-settings="{{ st | json | escape }}"{% endif %}
  data-width="{{ st.section_width | default: 'full_width' }}"
  data-pos="{{ st.text_position | default: 'start' }}"
  data-align="{{ st.align | default: 'center' }}"{% if section.settings.reveal == false %}
  data-ti-no-reveal{% endif %}
  style="{{ dtl_vars | strip | strip_newlines }}"
>
  <div class="dtl__inner">
    <div class="dtl__row">
      <span class="dtl__line dtl__line--lead" aria-hidden="true"></span>
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'label' -%}
            {%- liquid
              assign b_font = false
              if bs.enable_custom_fonts and bs.font.family != blank
                assign b_font = true
              endif
            -%}
            {%- capture b_color -%}{% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'none' %}{% else %}none{% endif %}{%- endcapture -%}
            {%- assign b_color = b_color | strip -%}
            <span class="dtl__text" data-r7x-block="{{ block.id }}" data-r7x-type="label"{% if design %} data-r7x-settings="{{ bs | json | escape }}"{% endif %} data-style="{{ bs.text_style | default: 'label' }}"{% if b_font %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="--dtl-size: {{ bs.size | default: 13 }}px; --dtl-size-m: {{ bs.size_mobile | default: 12 }}px;{% if b_color != 'none' %} --dtl-tc: {{ b_color }};{% endif %}{% if b_font %} --dtl-font: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{% endif %}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</span>
          {%- when 'link' -%}
            {%- capture b_color -%}{% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'none' %}{% else %}none{% endif %}{%- endcapture -%}
            {%- assign b_color = b_color | strip -%}
            <a class="dtl__link" data-r7x-block="{{ block.id }}" data-r7x-type="link"{% if design %} data-r7x-settings="{{ bs | json | escape }}"{% endif %} data-r7x-default-href="{{ routes.all_products_collection_url }}" href="{% if bs.link != blank %}{{ bs.link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"{% if bs.label == blank %} hidden{% endif %}{% if b_color != 'none' %} style="--dtl-lc: {{ b_color }};"{% endif %} {{ block.shopify_attributes }}><span data-r7x-label>{{ bs.label | escape }}</span><svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        {%- endcase -%}
      {%- endfor -%}
      <span class="dtl__line dtl__line--tail" aria-hidden="true"></span>
    </div>
  </div>
</div>
</template>

<schema>
{
  "shopify": {
    "name": "Divider With Text",
    "tag": "section",
    "class": "section-edge-bleed",
    "disabled_on": {
      "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
      { "type": "header", "content": "General" },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          { "value": "container", "label": "Default" },
          { "value": "fluid_container", "label": "Fluid container" },
          { "value": "stretch_width", "label": "Stretched" },
          { "value": "full_width", "label": "Full width" }
        ]
      },
      { "type": "checkbox", "id": "reset_spacing", "label": "Remove space between sections", "default": true },
      { "type": "header", "content": "Layout" },
      {
        "type": "select",
        "id": "text_position",
        "label": "Text position",
        "default": "start",
        "options": [
          { "value": "start", "label": "Start" },
          { "value": "center", "label": "Center" },
          { "value": "end", "label": "End" }
        ],
        "info": "The link sits at the other end of the line."
      },
      { "type": "range", "id": "width_pct", "label": "Line width", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
      {
        "type": "select",
        "id": "align",
        "label": "Alignment",
        "default": "center",
        "visible_if": "{{ section.settings.width_pct < 100 }}",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ]
      },
      { "type": "range", "id": "label_gap", "label": "Gap around text", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 14 },
      { "type": "header", "content": "Appearance" },
      {
        "type": "select",
        "id": "style",
        "label": "Line style",
        "default": "solid",
        "options": [
          { "value": "solid", "label": "Solid" },
          { "value": "dashed", "label": "Dashed" },
          { "value": "dotted", "label": "Dotted" }
        ]
      },
      { "type": "range", "id": "thickness", "label": "Line thickness", "min": 1, "max": 20, "step": 1, "unit": "px", "default": 1 },
      { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false, "info": "Off: colours follow the colour scheme." },
      { "type": "color", "id": "color_from", "label": "Line color", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "section_bg", "label": "Section background", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "header", "content": "Animation" },
      { "type": "checkbox", "id": "reveal", "label": "Reveal on scroll", "default": true },
      { "type": "header", "content": "Desktop spacing" },
      { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
      { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
      { "type": "range", "id": "section_margin_top_desktop", "label": "Top margin (desktop)", "min": 0, "max": 300, "step": 4, "default": 0, "unit": "px", "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_desktop", "label": "Bottom margin (desktop)", "min": 0, "max": 300, "step": 4, "default": 0, "unit": "px", "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "header", "content": "Mobile" },
      { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
      { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
      { "type": "range", "id": "section_margin_top_mobile", "label": "Top margin (mobile)", "min": 0, "max": 300, "step": 4, "default": 0, "unit": "px", "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_mobile", "label": "Bottom margin (mobile)", "min": 0, "max": 300, "step": 4, "default": 0, "unit": "px", "visible_if": "{{ section.settings.reset_spacing == false }}" }
    ],
    "blocks": [
      {
        "type": "label",
        "name": "Text",
        "limit": 1,
        "settings": [
          { "type": "text", "id": "text", "label": "Text", "default": "New in" },
          {
            "type": "select",
            "id": "text_style",
            "label": "Style",
            "default": "label",
            "options": [
              { "value": "label", "label": "Small label" },
              { "value": "heading", "label": "Heading" }
            ]
          },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Text color", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Typography" },
          { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom font", "default": false },
          { "type": "font_picker", "id": "font", "label": "Font", "default": "assistant_n4", "visible_if": "{{ block.settings.enable_custom_fonts }}" },
          { "type": "range", "id": "size", "label": "Text size (desktop)", "min": 10, "max": 48, "step": 1, "unit": "px", "default": 13 },
          { "type": "range", "id": "size_mobile", "label": "Text size (mobile)", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 12 }
        ]
      },
      {
        "type": "link",
        "name": "Link",
        "limit": 1,
        "settings": [
          { "type": "text", "id": "label", "label": "Link label", "default": "Shop all" },
          { "type": "url", "id": "link", "label": "Link", "info": "Empty: all products." },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Link color", "visible_if": "{{ block.settings.enable_custom_style }}" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Divider With Text",
        "category": "Dividers",
        "settings": {
          "section_width": "container",
          "padding_top": 24,
          "padding_bottom": 24,
          "padding_top_mobile": 16,
          "padding_bottom_mobile": 16
        },
        "blocks": [
          { "type": "label" },
          { "type": "link" }
        ]
      }
    ]
  }
}
</schema>
