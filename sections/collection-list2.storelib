<template compat="shopify">
{%- comment -%} Runtime, loaded once per page by layout/theme.storelib: shopify/assets/live-collections.js. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_left_image = 'accessibility.left_image' | t -%}
{%- assign fb_accessibility_right_image = 'accessibility.right_image' | t -%}
{%- comment -%}
  Materia Themes. Collection Hero Pro: a picture or video on each side and a
  text block in the middle (badge, heading, description, button blocks in
  their order). Colours follow the colour scheme, the heading Theme settings
  > Typography and the button Theme settings > Buttons until each block's
  own switches say otherwise. Live builder updates, and videos that stop off
  screen and under reduced motion, are in live-collections.js (loaded on every
  page).
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign has_left = false
  assign has_right = false
  for b in section.blocks
    assign has_media = false
    if request.design_mode or b.settings.image != blank or b.settings.video != blank or b.settings.video_url != blank
      assign has_media = true
    endif
    if b.type == 'media_left' and has_left == false and has_media
      assign has_left = b.id
    endif
    if b.type == 'media_right' and has_right == false and has_media
      assign has_right = b.id
    endif
  endfor
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; }
  }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if st.enable_custom_fonts -%}
    {{ st.heading_font | font_face: font_display: 'swap' }}
    {{ st.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .chp { font-family: var(--body-font, inherit); background: var(--cl-section_bg); color: var(--color-text); padding-top: var(--cl-padding_top_mobile); padding-bottom: var(--cl-padding_bottom_mobile); }
  #shopify-section-{{ sid }} .chp, #shopify-section-{{ sid }} .chp *, #shopify-section-{{ sid }} .chp *::before, #shopify-section-{{ sid }} .chp *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .chp__inner { margin-inline: auto; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .chp[data-width='container'] .chp__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .chp[data-width='fluid_container'] .chp__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .chp[data-width='full_width'] .chp__inner { padding-inline: 0; }
  #shopify-section-{{ sid }} .chp__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--cl-col_gap_mobile); align-items: stretch; }

  /* Media */
  #shopify-section-{{ sid }} .chp__media { position: relative; width: 100%; max-width: var(--cl-media_max_mobile); margin-inline: auto; overflow: hidden; border-radius: var(--clb-radius); background: var(--cl-media_bg); aspect-ratio: var(--clb-aspect_mobile); }
  #shopify-section-{{ sid }} .chp__media :is(img, video, svg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .chp__media svg { fill: color-mix(in srgb, var(--color-text) 25%, transparent); }

  /* Text block */
  #shopify-section-{{ sid }} .chp__content {
    display: flex; flex-direction: column; justify-content: var(--cl-content_align);
    align-items: center; text-align: var(--cl-content_text_align);
    gap: var(--cl-content_gap_mobile); padding: var(--cl-content_padding_mobile) var(--cl-content_padding_x_mobile);
    background: var(--cl-content_bg); border-radius: var(--cl-content_radius); min-width: 0;
  }
  #shopify-section-{{ sid }} .chp[data-text-align='left'] .chp__content { align-items: flex-start; }
  #shopify-section-{{ sid }} .chp[data-text-align='right'] .chp__content { align-items: flex-end; }
  #shopify-section-{{ sid }} .chp__content > * { margin: 0; }
  #shopify-section-{{ sid }} .chp__badge {
    display: inline-flex; align-items: center; margin: var(--clb-gap_top) 0 var(--clb-gap_bottom);
    background: var(--clb-bg); color: var(--clb-color);
    border: var(--clb-border_width) solid var(--clb-border_color); border-radius: var(--clb-radius);
    padding: var(--clb-pad_y) var(--clb-pad_x);
    font-size: var(--clb-size); font-weight: var(--clb-weight); letter-spacing: var(--clb-tracking); text-transform: var(--clb-transform); line-height: 1.2;
  }
  #shopify-section-{{ sid }} .chp__heading {
    margin: var(--clb-gap_top) 0 var(--clb-gap_bottom); font-family: var(--heading-font, inherit);
    color: var(--clb-color); font-weight: var(--clb-weight);
    font-size: var(--clb-size_mobile, var(--type-h2-size, 31px));
    line-height: var(--clb-line_height, var(--heading-line-height, 1.2)); letter-spacing: var(--clb-tracking, var(--heading-letter-spacing, normal));
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .chp__heading[data-case] { --heading-text-transform: var(--clb-transform); text-transform: var(--clb-transform); }
  #shopify-section-{{ sid }} .chp__heading[data-own-size] { --heading-letter-spacing: var(--clb-tracking); --heading-line-height: var(--clb-line_height); }
  #shopify-section-{{ sid }} .chp__desc { margin: var(--clb-gap_top) 0 var(--clb-gap_bottom); color: var(--clb-color); max-width: var(--clb-max_width); font-size: var(--clb-size_mobile, var(--body-font-size, 14px)); line-height: var(--clb-line_height, var(--body-line-height, 1.5)); }
  #shopify-section-{{ sid }} .chp__desc > * { margin: 0; color: inherit; }
  #shopify-section-{{ sid }} .chp__desc > * + * { margin-top: .6em; }
  #shopify-section-{{ sid }} .chp__btn-wrap { margin-top: var(--clb-gap_top); }
  #shopify-section-{{ sid }} .chp__btn { min-width: min(var(--clb-min_width), 100%); justify-content: center; text-decoration: none; cursor: pointer; }
  #shopify-section-{{ sid }} .chp__btn[data-own-shape] { font-size: var(--mb-font-size); padding: var(--mb-padding-y) var(--mb-padding-x); border-radius: var(--mb-radius); border-width: var(--btn-border-width); }
  #shopify-section-{{ sid }} [hidden]:is(.chp__badge, .chp__heading, .chp__desc, .chp__btn-wrap) { display: none !important; }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .chp { padding-top: var(--cl-padding_top_desktop); padding-bottom: var(--cl-padding_bottom_desktop); }
    #shopify-section-{{ sid }} .chp__heading { font-size: var(--clb-size_desktop, var(--type-h2-size, 45px)); }
    #shopify-section-{{ sid }} .chp__desc { font-size: var(--clb-size_desktop, var(--body-font-size, 14px)); }
    #shopify-section-{{ sid }} .chp__btn-wrap { margin-top: var(--clb-gap_top_desktop); }
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .chp__grid { gap: var(--cl-col_gap_desktop); align-items: var(--cl-align_columns); grid-template-columns: minmax(0, var(--cl-center_col_fr)); }
    #shopify-section-{{ sid }} .chp[data-left='true'] .chp__grid { grid-template-columns: minmax(0, var(--cl-left_col_fr)) minmax(0, var(--cl-center_col_fr)); }
    #shopify-section-{{ sid }} .chp[data-right='true'] .chp__grid { grid-template-columns: minmax(0, var(--cl-center_col_fr)) minmax(0, var(--cl-right_col_fr)); }
    #shopify-section-{{ sid }} .chp[data-left='true'][data-right='true'] .chp__grid { grid-template-columns: minmax(0, var(--cl-left_col_fr)) minmax(0, var(--cl-center_col_fr)) minmax(0, var(--cl-right_col_fr)); }
    #shopify-section-{{ sid }} .chp__media { max-width: none; aspect-ratio: var(--clb-aspect_desktop); }
    #shopify-section-{{ sid }} .chp__content { gap: var(--cl-content_gap_desktop); padding: var(--cl-content_padding_desktop) var(--cl-content_padding_x_desktop); }
  }
  #shopify-section-{{ sid }} .chp[data-show-on='mobile'] { display: none; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .chp[data-show-on='mobile'] { display: block; } #shopify-section-{{ sid }} .chp[data-show-on='desktop'] { display: none; } }
{% comment %}{% endcomment %}</style>

<section class="chp color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}" data-width="{{ st.section_width | default: 'container' }}" data-left="{% if has_left %}true{% else %}false{% endif %}" data-right="{% if has_right %}true{% else %}false{% endif %}" data-text-align="{{ st.content_text_align | default: 'center' }}" {% capture cl_json %}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"show_section_on":{{ section.settings.show_section_on | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"align_columns":{{ section.settings.align_columns | append: '' | json }},"left_col_fr":{{ section.settings.left_col_fr | default: 0 | json }},"center_col_fr":{{ section.settings.center_col_fr | default: 0 | json }},"right_col_fr":{{ section.settings.right_col_fr | default: 0 | json }},"content_align":{{ section.settings.content_align | append: '' | json }},"content_text_align":{{ section.settings.content_text_align | append: '' | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"content_bg":{{ section.settings.content_bg | append: '' | json }},"media_bg":{{ section.settings.media_bg | append: '' | json }},"content_radius":{{ section.settings.content_radius | default: 0 | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"col_gap_desktop":{{ section.settings.col_gap_desktop | default: 0 | json }},"content_padding_desktop":{{ section.settings.content_padding_desktop | default: 0 | json }},"content_padding_x_desktop":{{ section.settings.content_padding_x_desktop | default: 0 | json }},"content_gap_desktop":{{ section.settings.content_gap_desktop | default: 0 | json }},"padding_top_desktop":{{ section.settings.padding_top_desktop | default: 0 | json }},"padding_bottom_desktop":{{ section.settings.padding_bottom_desktop | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"col_gap_mobile":{{ section.settings.col_gap_mobile | default: 0 | json }},"content_padding_mobile":{{ section.settings.content_padding_mobile | default: 0 | json }},"content_padding_x_mobile":{{ section.settings.content_padding_x_mobile | default: 0 | json }},"content_gap_mobile":{{ section.settings.content_gap_mobile | default: 0 | json }},"media_max_mobile":{{ section.settings.media_max_mobile | default: 0 | json }},"padding_top_mobile":{{ section.settings.padding_top_mobile | default: 0 | json }},"padding_bottom_mobile":{{ section.settings.padding_bottom_mobile | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-left_col_fr: {{ section.settings.left_col_fr | default: 0 }}fr;--cl-center_col_fr: {{ section.settings.center_col_fr | default: 0 }}fr;--cl-right_col_fr: {{ section.settings.right_col_fr | default: 0 }}fr;--cl-col_gap_desktop: {{ section.settings.col_gap_desktop | default: 0 }}px;--cl-col_gap_mobile: {{ section.settings.col_gap_mobile | default: 0 }}px;--cl-align_columns: {{ section.settings.align_columns }};--cl-content_align: {{ section.settings.content_align }};--cl-content_text_align: {{ section.settings.content_text_align }};--cl-content_radius: {{ section.settings.content_radius | default: 0 }}px;--cl-content_padding_desktop: {{ section.settings.content_padding_desktop | default: 0 }}px;--cl-content_padding_x_desktop: {{ section.settings.content_padding_x_desktop | default: 0 }}px;--cl-content_padding_mobile: {{ section.settings.content_padding_mobile | default: 0 }}px;--cl-content_padding_x_mobile: {{ section.settings.content_padding_x_mobile | default: 0 }}px;--cl-content_gap_desktop: {{ section.settings.content_gap_desktop | default: 0 }}px;--cl-content_gap_mobile: {{ section.settings.content_gap_mobile | default: 0 }}px;--cl-media_max_mobile: {{ section.settings.media_max_mobile | default: 0 }}px;--cl-padding_top_desktop: {{ section.settings.padding_top_desktop | default: 0 }}px;--cl-padding_bottom_desktop: {{ section.settings.padding_bottom_desktop | default: 0 }}px;--cl-padding_top_mobile: {{ section.settings.padding_top_mobile | default: 0 }}px;--cl-padding_bottom_mobile: {{ section.settings.padding_bottom_mobile | default: 0 }}px;{% if section.settings.enable_custom_style %}--cl-section_bg: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};{% else %}--cl-section_bg: var(--color-background);{% endif %}{% if section.settings.enable_custom_style %}--cl-content_bg: {% render 'scheme-color', color: section.settings.content_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %};{% else %}--cl-content_bg: color-mix(in srgb, var(--color-text) 6%, var(--color-background));{% endif %}{% if section.settings.enable_custom_style %}--cl-media_bg: {% render 'scheme-color', color: section.settings.media_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %};{% else %}--cl-media_bg: color-mix(in srgb, var(--color-text) 6%, var(--color-background));{% endif %}{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="collection-list2" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default-color-scheme","section_width":"container","show_section_on":"all","reset_spacing":true,"align_columns":"stretch","left_col_fr":1,"center_col_fr":1.1,"right_col_fr":1,"content_align":"center","content_text_align":"center","enable_custom_style":false,"content_radius":8,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","col_gap_desktop":32,"content_padding_desktop":40,"content_padding_x_desktop":28,"content_gap_desktop":14,"padding_top_desktop":80,"padding_bottom_desktop":48,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"col_gap_mobile":18,"content_padding_mobile":24,"content_padding_x_mobile":18,"content_gap_mobile":12,"media_max_mobile":420,"padding_top_mobile":22,"padding_bottom_mobile":22,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-cl-block-defaults='{"media_left":{"aspect_desktop":"2 / 3","aspect_mobile":"4 / 3","radius":8},"badge":{"text":"NEW DROP","enable_custom_style":false,"border_width":0,"radius":100,"size":12,"weight":"600","tracking":0.4,"transform":"uppercase","pad_x":12,"pad_y":6,"gap_top":0,"gap_bottom":0},"heading":{"text":"NEW COLLECTION","tag":"h2","enable_custom_style":false,"weight":"theme","size_enable":false,"size_desktop":45,"size_mobile":31,"line_height":1.2,"tracking":0,"transform":"none","gap_top":0,"gap_bottom":0},"description":{"text":"<p>Our latest pieces, picked for the season.</p>","enable_custom_style":false,"size_enable":false,"size_desktop":14,"size_mobile":14,"line_height":1.5,"max_width":320,"gap_top":0,"gap_bottom":0},"button":{"text":"Shop Now","link":"/","enable_custom_style":false,"hover_anim":"none","use_theme_button":true,"border_width":0,"radius":6,"size":16,"weight":"500","pad_x":24,"pad_y":12,"min_width":160,"gap_top_desktop":10,"gap_top":5},"media_right":{"aspect_desktop":"2 / 3","aspect_mobile":"4 / 3","radius":8}}' style="{{ cl_vars | strip }}" data-show-on="{{ section.settings.show_section_on }}"{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  <div class="chp__inner">
    <div class="chp__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'media_left' and block.id == has_left -%}
          {%- assign bs = block.settings -%}
          <div class="chp__media chp__media--left" {% capture clb_json %}{"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %},"alt_text":{{ block.settings.alt_text | append: '' | json }},"video":{% if block.settings.video != blank %}"video"{% else %}""{% endif %},"video_url":{{ block.settings.video_url | append: '' | json }},"poster":{% if block.settings.poster != blank %}{"src":{{ block.settings.poster | image_url: width: 1600 | json }},"width":{{ block.settings.poster.width | default: 0 | json }},"height":{{ block.settings.poster.height | default: 0 | json }},"alt":{{ block.settings.poster.alt | append: '' | json }}}{% else %}null{% endif %},"aspect_desktop":{{ block.settings.aspect_desktop | append: '' | json }},"aspect_mobile":{{ block.settings.aspect_mobile | append: '' | json }},"radius":{{ block.settings.radius | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}--clb-aspect_desktop: {{ block.settings.aspect_desktop }};--clb-aspect_mobile: {{ block.settings.aspect_mobile }};--clb-radius: {{ block.settings.radius | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="media_left" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-alt="{{ fb_accessibility_left_image | escape }}" {{ block.shopify_attributes }}>
            {%- if bs.video != blank -%}
              {{ bs.video | video_tag: image_size: '800x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, class: 'chp__video' }}
            {%- elsif bs.video_url != blank -%}
              <video class="chp__video" autoplay muted loop playsinline{% if bs.poster %} poster="{{ bs.poster | image_url: width: 800 }}"{% endif %}><source src="{{ bs.video_url }}" type="video/mp4"></video>
            {%- elsif bs.image != blank -%}
              <img class="chp__img" src="{{ bs.image | image_url: width: 900 }}" alt="{{ bs.alt_text | default: bs.image.alt | default: fb_accessibility_left_image | escape }}" loading="lazy" width="{{ bs.image.width }}" height="{{ bs.image.height }}">
            {%- elsif request.design_mode -%}
              {{ 'collection-1' | placeholder_svg_tag: 'chp__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
            {%- endif -%}
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="chp__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'badge' -%}
              <span class="chp__badge" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"border_width":{{ block.settings.border_width | default: 0 | json }},"radius":{{ block.settings.radius | default: 0 | json }},"size":{{ block.settings.size | default: 0 | json }},"weight":{{ block.settings.weight | append: '' | json }},"tracking":{{ block.settings.tracking | default: 0 | json }},"transform":{{ block.settings.transform | append: '' | json }},"pad_x":{{ block.settings.pad_x | default: 0 | json }},"pad_y":{{ block.settings.pad_y | default: 0 | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }},"gap_bottom":{{ block.settings.gap_bottom | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-bg: {% render 'scheme-color', color: block.settings.bg, fallback: 'var(--color-background)' %};{% else %}--clb-bg: var(--color-background);{% endif %}{% if block.settings.enable_custom_style %}--clb-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-primary)' %};{% else %}--clb-color: var(--color-primary);{% endif %}{% if block.settings.enable_custom_style %}--clb-border_color: {% render 'scheme-color', color: block.settings.border_color, fallback: 'var(--color-border)' %};{% else %}--clb-border_color: var(--color-border);{% endif %}--clb-border_width: {{ block.settings.border_width | default: 0 }}px;--clb-size: {{ block.settings.size | default: 0 }}px;--clb-weight: {{ block.settings.weight }};--clb-tracking: {{ block.settings.tracking | default: 0 }}px;--clb-pad_x: {{ block.settings.pad_x | default: 0 }}px;--clb-pad_y: {{ block.settings.pad_y | default: 0 }}px;--clb-radius: {{ block.settings.radius | default: 0 }}px;--clb-transform: {{ block.settings.transform }};--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;--clb-gap_bottom: {{ block.settings.gap_bottom | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="badge" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</span>
            {%- when 'heading' -%}
              <h2 class="chp__heading" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"tag":{{ block.settings.tag | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"weight":{{ block.settings.weight | append: '' | json }},"size_enable":{% if block.settings.size_enable %}true{% else %}false{% endif %},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }},"line_height":{{ block.settings.line_height | default: 0 | json }},"tracking":{{ block.settings.tracking | default: 0 | json }},"transform":{{ block.settings.transform | append: '' | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }},"gap_bottom":{{ block.settings.gap_bottom | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %};{% else %}--clb-color: var(--color-heading);{% endif %}--clb-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %};{% if block.settings.size_enable %}--clb-size_desktop: {{ block.settings.size_desktop | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-size_mobile: {{ block.settings.size_mobile | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-line_height: {{ block.settings.line_height | default: 0 }};{% endif %}{% if block.settings.size_enable %}--clb-tracking: {{ block.settings.tracking | default: 0 }}px;{% endif %}--clb-transform: {{ block.settings.transform }};--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;--clb-gap_bottom: {{ block.settings.gap_bottom | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="heading" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if block.settings.size_enable %} data-own-size=""{% endif %}{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if bs.transform != blank and bs.transform != 'none' %} data-case{% endif %}{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'description' -%}
              <div class="chp__desc" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_enable":{% if block.settings.size_enable %}true{% else %}false{% endif %},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }},"line_height":{{ block.settings.line_height | default: 0 | json }},"max_width":{{ block.settings.max_width | default: 0 | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }},"gap_bottom":{{ block.settings.gap_bottom | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %};{% else %}--clb-color: var(--color-text);{% endif %}{% if block.settings.size_enable %}--clb-size_desktop: {{ block.settings.size_desktop | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-size_mobile: {{ block.settings.size_mobile | default: 0 }}px;{% endif %}{% if block.settings.size_enable %}--clb-line_height: {{ block.settings.line_height | default: 0 }};{% endif %}--clb-max_width: {{ block.settings.max_width | default: 0 }}px;--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;--clb-gap_bottom: {{ block.settings.gap_bottom | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="description" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'button' -%}
              <div class="chp__btn-wrap" {% capture clb_json %}{"text":{{ block.settings.text | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"hover_anim":{{ block.settings.hover_anim | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"border_width":{{ block.settings.border_width | default: 0 | json }},"radius":{{ block.settings.radius | default: 0 | json }},"size":{{ block.settings.size | default: 0 | json }},"weight":{{ block.settings.weight | append: '' | json }},"pad_x":{{ block.settings.pad_x | default: 0 | json }},"pad_y":{{ block.settings.pad_y | default: 0 | json }},"min_width":{{ block.settings.min_width | default: 0 | json }},"gap_top_desktop":{{ block.settings.gap_top_desktop | default: 0 | json }},"gap_top":{{ block.settings.gap_top | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}--clb-min_width: {{ block.settings.min_width | default: 0 }}px;--clb-gap_top: {{ block.settings.gap_top | default: 0 }}px;--clb-gap_top_desktop: {{ block.settings.gap_top_desktop | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="button" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- capture btn_style -%}{% if bs.enable_custom_style %}{% render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover %}{% endif %}{% unless bs.use_theme_button %}--mb-radius: {{ bs.radius | default: 0 }}px;--mb-padding-y: {{ bs.pad_y | default: 0 }}px;--mb-padding-x: {{ bs.pad_x | default: 0 }}px;--mb-font-size: {{ bs.size | default: 16 }}px;--mb-weight: {{ bs.weight | default: 500 }};--btn-border-width: {{ bs.border_width | default: 0 }}px;{% endunless %}{%- endcapture -%}
                {%- capture btn_hover -%}{% case bs.hover_anim %}{% when 'fade-in' %} data-button-hover="fade"{% when 'light-slide' %} data-button-hover="slide"{% when 'lift' %} data-button-hover="lift"{% endcase %}{%- endcapture -%}
                {%- if bs.link != blank -%}
                  <a class="chp__btn" href="{{ bs.link }}" data-theme-button="primary" data-sl-button{{ btn_hover }}{% unless bs.use_theme_button %} data-own-shape data-own-weight{% endunless %} style="{{ btn_style | strip }}">{{ bs.text | escape }}</a>
                {%- else -%}
                  <button type="button" class="chp__btn" data-theme-button="primary" data-sl-button{{ btn_hover }}{% unless bs.use_theme_button %} data-own-shape data-own-weight{% endunless %} style="{{ btn_style | strip }}">{{ bs.text | escape }}</button>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'media_right' and block.id == has_right -%}
          {%- assign bs = block.settings -%}
          <div class="chp__media chp__media--right" {% capture clb_json %}{"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %},"alt_text":{{ block.settings.alt_text | append: '' | json }},"video":{% if block.settings.video != blank %}"video"{% else %}""{% endif %},"video_url":{{ block.settings.video_url | append: '' | json }},"poster":{% if block.settings.poster != blank %}{"src":{{ block.settings.poster | image_url: width: 1600 | json }},"width":{{ block.settings.poster.width | default: 0 | json }},"height":{{ block.settings.poster.height | default: 0 | json }},"alt":{{ block.settings.poster.alt | append: '' | json }}}{% else %}null{% endif %},"aspect_desktop":{{ block.settings.aspect_desktop | append: '' | json }},"aspect_mobile":{{ block.settings.aspect_mobile | append: '' | json }},"radius":{{ block.settings.radius | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}--clb-aspect_desktop: {{ block.settings.aspect_desktop }};--clb-aspect_mobile: {{ block.settings.aspect_mobile }};--clb-radius: {{ block.settings.radius | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="media_right" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-alt="{{ fb_accessibility_right_image | escape }}" {{ block.shopify_attributes }}>
            {%- if bs.video != blank -%}
              {{ bs.video | video_tag: image_size: '800x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, class: 'chp__video' }}
            {%- elsif bs.video_url != blank -%}
              <video class="chp__video" autoplay muted loop playsinline{% if bs.poster %} poster="{{ bs.poster | image_url: width: 800 }}"{% endif %}><source src="{{ bs.video_url }}" type="video/mp4"></video>
            {%- elsif bs.image != blank -%}
              <img class="chp__img" src="{{ bs.image | image_url: width: 900 }}" alt="{{ bs.alt_text | default: bs.image.alt | default: fb_accessibility_right_image | escape }}" loading="lazy" width="{{ bs.image.width }}" height="{{ bs.image.height }}">
            {%- elsif request.design_mode -%}
              {{ 'collection-1' | placeholder_svg_tag: 'chp__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
            {%- endif -%}
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
</template>

<schema>
{
  "type": "collection-list2",
  "name": "Collection Hero Pro",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
