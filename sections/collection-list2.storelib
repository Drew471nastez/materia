<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_right_image = 'accessibility.right_image' | t -%}
{%- assign fb_accessibility_left_image = 'accessibility.left_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Collection Hero Pro (rewritten)
  Three-column hero (left media | content | right media) where every piece
  of content (badge, heading, description, button) plus each media slot is
  a block. Every slider and color picker is wired directly into inline
  styles on the rendered element so customizer changes always update the
  output. Side media blocks accept either an image OR a video URL with
  their own aspect / radius overrides.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'

  assign has_left  = false
  assign has_right = false
  for b in section.blocks
    if b.type == 'media_left'
      assign has_left = true
    endif
    if b.type == 'media_right'
      assign has_right = true
    endif
  endfor
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .chp {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 24 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 24 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .chp {
      padding-top: {{ st.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 48 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .chp__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .chp__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .chp__inner { padding-inline: 0; }
    {%- else -%}
      #shopify-section-{{ sid }} .chp__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Grid — adapts based on which side media blocks exist */
  #shopify-section-{{ sid }} .chp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.col_gap_mobile | default: 18 }}px;
    align-items: stretch;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .chp__grid {
      grid-template-columns:
        {%- if has_left  %} {{ st.left_col_fr  | default: 1   }}fr {% endif -%}
        {{ st.center_col_fr | default: 1.1 }}fr
        {%- if has_right %} {{ st.right_col_fr | default: 1   }}fr {% endif %};
      gap: {{ st.col_gap_desktop | default: 32 }}px;
      align-items: {{ st.align_columns | default: 'stretch' }};
    }
  }

  /* Media block */
  #shopify-section-{{ sid }} .chp__media {
    width: 100%;
    overflow: hidden;
    background: {% render 'scheme-color', color: st.media_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %};
    position: relative;
  }
  #shopify-section-{{ sid }} .chp__media > img,
  #shopify-section-{{ sid }} .chp__media > video,
  #shopify-section-{{ sid }} .chp__media-video,
  #shopify-section-{{ sid }} .chp__media-video video {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .chp__media {
      max-width: {{ st.media_max_mobile | default: 420 }}px;
      margin-inline: auto;
    }
  }

  /* Center content card */
  #shopify-section-{{ sid }} .chp__content {
    background: {% render 'scheme-color', color: st.content_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %} !important;
    border-radius: {{ st.content_radius | default: 8 }}px;
    padding: {{ st.content_padding_mobile | default: 24 }}px {{ st.content_padding_x_mobile | default: 18 }}px;
    display: flex;
    flex-direction: column;
    align-items: {{ st.content_align | default: 'center' }};
    justify-content: center;
    text-align: {{ st.content_text_align | default: 'center' }};
    gap: {{ st.content_gap_mobile | default: 12 }}px;
    height: 100%;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .chp__content {
      padding: {{ st.content_padding_desktop | default: 40 }}px {{ st.content_padding_x_desktop | default: 28 }}px;
      gap: {{ st.content_gap_desktop | default: 14 }}px;
    }
  }

  /* Reset block defaults */
  #shopify-section-{{ sid }} .chp__content > * { margin: 0; }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .chp { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .chp { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .chp { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .chp { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- comment -%} Block render snippets are inlined for clarity {%- endcomment -%}

<section class="chp color-{{ color_scheme }} gradient" id="chp-{{ sid }}">
  <div class="chp__inner">
    <div class="chp__grid">

      {%- comment -%}========== LEFT MEDIA ==========={%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'media_left' -%}
          {%- assign bs = block.settings -%}
          {%- assign aspect = bs.aspect_desktop | default: '2 / 3' -%}
          {%- assign aspect_m = bs.aspect_mobile | default: '4 / 3' -%}
          <div class="chp__media chp__media--left"
               style="border-radius: {{ bs.radius | default: 8 }}px;"
               {{ block.shopify_attributes }}>
            <style>
              #shopify-section-{{ sid }} [data-cl-{{ block.id }}] { aspect-ratio: {{ aspect_m }}; }
              @media (min-width: 992px) {
                #shopify-section-{{ sid }} [data-cl-{{ block.id }}] { aspect-ratio: {{ aspect }}; }
              }
{% comment %}{% endcomment %}            </style>
            <div data-cl-{{ block.id }} style="width:100%;height:100%;position:relative;overflow:hidden;border-radius: {{ bs.radius | default: 8 }}px;">
              {%- if bs.video != blank -%}
                {{ bs.video | video_tag: image_size: '800x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, class: 'chp__media-video' }}
              {%- elsif bs.video_url != blank -%}
                <video autoplay muted loop playsinline
                       style="width:100%;height:100%;object-fit:cover;display:block;"
                       {% if bs.poster %}poster="{{ bs.poster | image_url: width: 800 }}"{% endif %}>
                  <source src="{{ bs.video_url }}" type="video/mp4">
                </video>
              {%- elsif bs.image -%}
                <img src="{{ bs.image | image_url: width: 800 }}"
                     alt="{{ bs.alt_text | default: bs.image.alt | default: fb_accessibility_left_image | escape }}"
                     style="width:100%;height:100%;object-fit:cover;display:block;"
                     loading="lazy"
                     width="{{ bs.image.width }}" height="{{ bs.image.height }}">
              {%- else -%}
                <img src="{{ placeholder }}" alt="placeholder"
                     style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
              {%- endif -%}
            </div>
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}========== CENTER CONTENT ==========={%- endcomment -%}
      <div class="chp__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'badge' -%}
              {%- if bs.text != blank -%}
                <span id="block-{{ block.id }}" class="chp__badge"
                      {{ block.shopify_attributes }}>{{ bs.text | escape }}</span>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    display: inline-flex;
                    align-items: center;
                    background: {% render 'scheme-color', color: bs.bg, fallback: 'var(--color-background)' %};
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-primary)' %} !important;
                    padding: {{ bs.pad_y | default: 6 }}px {{ bs.pad_x | default: 12 }}px;
                    border-radius: {{ bs.radius | default: 100 }}px;
                    font-size: {{ bs.size | default: 12 }}px;
                    font-weight: {{ bs.weight | default: 600 }};
                    letter-spacing: {{ bs.tracking | default: 0.4 }}px;
                    text-transform: {{ bs.transform | default: 'uppercase' }};
                    {% if bs.border_width and bs.border_width > 0 %}border: {{ bs.border_width }}px solid {% render 'scheme-color', color: bs.border_color, fallback: 'var(--color-border)' %};{% endif %}
                    margin-top: {{ bs.gap_top | default: 0 }}px;
                    margin-bottom: {{ bs.gap_bottom | default: 0 }}px;
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="chp__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %} !important;
                    font-weight: {% if bs.weight == blank or bs.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ bs.weight }}{% endif %};
                    line-height: {{ bs.line_height | default: 1.2 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    text-transform: {{ bs.transform | default: 'none' }};
                    font-size: {{ bs.size_mobile | default: 31 }}px;
                    margin-top: {{ bs.gap_top | default: 0 }}px;
                    margin-bottom: {{ bs.gap_bottom | default: 0 }}px;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} {
                      font-size: {{ bs.size_desktop | default: 45 }}px;
                    }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="chp__desc" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %} !important;
                    font-size: {{ bs.size_mobile | default: 14 }}px;
                    line-height: {{ bs.line_height | default: 1.5 }};
                    max-width: {{ bs.max_width | default: 320 }}px;
                    margin-top: {{ bs.gap_top | default: 0 }}px;
                    margin-bottom: {{ bs.gap_bottom | default: 0 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0; }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 14 }}px; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if bs.text != blank -%}
                <a id="block-{{ block.id }}" class="chp__btn" data-sl-button data-button-role="primary" href="{{ bs.link | default: '/' }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</a>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    text-decoration: none;
                    cursor: pointer;
                    background: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %} !important;
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %} !important;
                    {%- if bs.use_theme_button %}
                    border: var(--btn-border-width, 0px) solid {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-bg-color)' %};
                    border-radius: var(--btn-radius, 6px);
                    font-size: var(--btn-font-size, 16px);
                    font-weight: var(--btn-font-weight, 500);
                    padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 24px);
                    {%- else %}
                    border: {{ bs.border_width | default: 0 }}px solid {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-bg-color)' %};
                    border-radius: {{ bs.radius | default: 6 }}px;
                    font-size: {{ bs.size | default: 16 }}px;
                    font-weight: {{ bs.weight | default: 500 }};
                    padding: {{ bs.pad_y | default: 12 }}px {{ bs.pad_x | default: 24 }}px;
                    {%- endif %}
                    min-width: {{ bs.min_width | default: 160 }}px;
                    margin-top: {{ bs.gap_top | default: 5 }}px;
                    transition: background-color .25s ease, color .25s ease, transform .2s ease, opacity .25s ease;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { margin-top: {{ bs.gap_top_desktop | default: 10 }}px; }
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }}:hover {
                    background: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %} !important;
                    color: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %} !important;
                    {% if bs.hover_anim == 'fade-in' %}opacity: .85;{% endif %}
                    {% if bs.hover_anim == 'light-slide' %}transform: translateX(3px);{% endif %}
                    {% if bs.hover_anim == 'lift' %}transform: translateY(-2px);{% endif %}
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%}========== RIGHT MEDIA ==========={%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'media_right' -%}
          {%- assign bs = block.settings -%}
          {%- assign aspect = bs.aspect_desktop | default: '2 / 3' -%}
          {%- assign aspect_m = bs.aspect_mobile | default: '4 / 3' -%}
          <div class="chp__media chp__media--right"
               style="border-radius: {{ bs.radius | default: 8 }}px;"
               {{ block.shopify_attributes }}>
            <style>
              #shopify-section-{{ sid }} [data-cr-{{ block.id }}] { aspect-ratio: {{ aspect_m }}; }
              @media (min-width: 992px) {
                #shopify-section-{{ sid }} [data-cr-{{ block.id }}] { aspect-ratio: {{ aspect }}; }
              }
{% comment %}{% endcomment %}            </style>
            <div data-cr-{{ block.id }} style="width:100%;height:100%;position:relative;overflow:hidden;border-radius: {{ bs.radius | default: 8 }}px;">
              {%- if bs.video != blank -%}
                {{ bs.video | video_tag: image_size: '800x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, class: 'chp__media-video' }}
              {%- elsif bs.video_url != blank -%}
                <video autoplay muted loop playsinline
                       style="width:100%;height:100%;object-fit:cover;display:block;"
                       {% if bs.poster %}poster="{{ bs.poster | image_url: width: 800 }}"{% endif %}>
                  <source src="{{ bs.video_url }}" type="video/mp4">
                </video>
              {%- elsif bs.image -%}
                <img src="{{ bs.image | image_url: width: 800 }}"
                     alt="{{ bs.alt_text | default: bs.image.alt | default: fb_accessibility_right_image | escape }}"
                     style="width:100%;height:100%;object-fit:cover;display:block;"
                     loading="lazy"
                     width="{{ bs.image.width }}" height="{{ bs.image.height }}">
              {%- else -%}
                <img src="{{ placeholder }}" alt="placeholder"
                     style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy">
              {%- endif -%}
            </div>
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "collection-list2",
  "name": "Collection Hero Pro",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Columns"
    },
    {
      "type": "select",
      "id": "align_columns",
      "label": "Vertical alignment (desktop)",
      "default": "stretch",
      "options": [
        {
          "value": "stretch",
          "label": "Stretch"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "left_col_fr",
      "label": "Left column ratio",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "center_col_fr",
      "label": "Center column ratio",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "right_col_fr",
      "label": "Right column ratio",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Content card"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "content_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_padding_desktop",
      "label": "Padding y (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_x_desktop",
