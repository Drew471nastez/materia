        "visible_if": "{{ section.settings.display_mode == 'carousel' and section.settings.carousel_pagination == 'show_dots' }}"
      },
      {
        "type": "select",
        "id": "pagination_position",
        "label": "Pagination position",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "visible_if": "{{ section.settings.display_mode == 'carousel' and section.settings.carousel_pagination == 'show_dots' }}"
      },
      {
        "type": "header",
        "content": "Tiles"
      },
      {
        "type": "checkbox",
        "id": "show_handle",
        "label": "Show creator handle",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_product",
        "label": "Show tagged product",
        "default": true
      },
      {
        "type": "range",
        "id": "tile_radius",
        "label": "Tile corner radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "overlay_strength",
        "label": "Overlay darkness",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 35
      },
      {
        "type": "select",
        "id": "hover_style",
        "label": "Hover effect",
        "default": "fade",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade overlay"
          },
          {
            "value": "zoom",
            "label": "Zoom"
          },
          {
            "value": "darken",
            "label": "Darken"
          }
        ]
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color",
        "visible_if": "{{ section.settings.enable_custom_style }}",
        "info": "Follow link and avatar letters."
      },
      {
        "type": "color",
        "id": "custom_section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_heading_color",
        "label": "Heading color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_text_color",
        "label": "Tile headline color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "columns_mobile",
        "label": "Tiles per row (mobile)",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
