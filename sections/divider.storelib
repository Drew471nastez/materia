<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Divider section.
  A flexible separator: line, dashed, dotted, double, gradient,
  with optional centered icon/label and adjustable spacing.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign section_width = s.section_width | default: 'full_width'
  assign style_kind = s.style | default: 'solid'
  assign thickness = s.thickness | default: 1
  assign width_pct = s.width_pct | default: 100
  assign align = s.align | default: 'center'
  assign color_from = s.color_from
  assign color_to = s.color_to
  assign label = s.label
  assign icon_svg = s.icon_svg
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top | default: 0 }};
  --section-pb: {{ s.padding_bottom | default: 0 }};
  --div-thickness: {{ thickness }}px;
  --div-color: {{ color_from | default: '#ebebeb' }} !important;
  --div-color-to: {{ color_to | default: 'transparent' }};
  --div-width: {{ width_pct }}%;
  --div-gap: {{ s.label_gap | default: 14 }}px;
  --div-label-color: {{ s.label_color | default: 'inherit' }} !important;
  --div-label-size: {{ s.label_size | default: 12 }}px;
{%- endcapture -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sec__divider-wrap {
    display: flex;
    {%- if align == 'left' -%}justify-content: flex-start;
    {%- elsif align == 'right' -%}justify-content: flex-end;
    {%- else -%}justify-content: center;{%- endif -%}
  }
  #shopify-section-{{ section.id }} .sec__divider-inner {
    width: var(--div-width);
    display: flex;
    align-items: center;
    gap: var(--div-gap);
  }
  #shopify-section-{{ section.id }} .sec__divider-line {
    flex: 1 1 0;
    height: var(--div-thickness);
    {%- case style_kind -%}
      {%- when 'solid' -%}background: var(--div-color);
      {%- when 'dashed' -%}background-image: linear-gradient(to right, var(--div-color) 50%, transparent 50%);
        background-size: 12px var(--div-thickness);
        background-repeat: repeat-x;
      {%- when 'dotted' -%}background-image: radial-gradient(circle, var(--div-color) 40%, transparent 45%);
        background-size: calc(var(--div-thickness) * 4) var(--div-thickness);
        background-repeat: repeat-x;
      {%- when 'double' -%}border-top: var(--div-thickness) solid var(--div-color);
        border-bottom: var(--div-thickness) solid var(--div-color);
        height: calc(var(--div-thickness) * 4);
        background: transparent;
      {%- when 'gradient' -%}background: linear-gradient(to right, transparent, var(--div-color), var(--div-color-to, transparent), transparent);
      {%- when 'shadow' -%}height: 0;
        box-shadow: 0 0 12px 2px var(--div-color);
        background: var(--div-color);
    {%- endcase -%}
  }
  #shopify-section-{{ section.id }} .sec__divider-label {
    font-size: var(--div-label-size);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--div-label-color);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .sec__divider-label svg {
    width: var(--div-label-size);
    height: var(--div-label-size);
  }
{%- endstyle -%}

<div
  class="section sec__divider{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ s.color_scheme | default: 'scheme-1' }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="sec__divider-wrap">
      <div class="sec__divider-inner">
        <div class="sec__divider-line" aria-hidden="true"></div>
        {%- if label != blank or icon_svg != blank -%}
          <span class="sec__divider-label">
            {%- if icon_svg != blank -%}{{ icon_svg }}{%- endif -%}
            {%- if label != blank -%}{{ label }}{%- endif -%}
          </span>
          <div class="sec__divider-line" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "divider",
  "name": "Divider",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Center label",
      "info": "Leave empty for a plain line."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        },
        {
          "value": "gradient",
          "label": "Gradient fade"
        },
        {
          "value": "shadow",
          "label": "Soft glow"
        }
      ]
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Center icon (SVG)",
      "info": "Inline SVG shown next to the label."
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap around label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "width_pct",
      "label": "Line width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "color_from",
      "label": "Line color",
      "default": "#ebebeb"
    },
    {
      "type": "color",
      "id": "color_to",
      "label": "Gradient end color",
      "info": "Used by Gradient fade style.",
      "default": "#ebebeb"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Advanced"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color",
      "info": "Background colour of the whole section. Set transparent to inherit the page.",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Dividers"
    },
    {
      "name": "Divider with label",
      "category": "Dividers",
      "settings": {
        "label": "OR",
        "style": "solid",
        "width_pct": 60
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "overlay"
    ]
  },
  "shopify": {
    "name": "Divider",
    "tag": "section",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
