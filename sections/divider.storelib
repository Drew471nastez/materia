      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color"
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Dividers"
    },
    {
      "name": "Divider with label",
      "category": "Dividers",
      "settings": {
        "label": "OR",
        "style": "solid",
        "width_pct": 60
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "overlay"
    ]
  },
