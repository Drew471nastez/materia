<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  The section wrapper's own rules (spacing, width, background, isolation),
  which need its id. The rest of the divider's CSS is divider-section.css.
{%- endcomment -%}
<style>
  {%- if section.settings.reset_spacing %}
  #shopify-section-{{ section.id }},#shopify-section-{{ section.id }}>.section,#shopify-section-{{ section.id }}>section,#shopify-section-{{ section.id }}>div,#shopify-section-{{ section.id }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ section.id }}+.shopify-section,#shopify-section-{{ section.id }}+section,.shopify-section+#shopify-section-{{ section.id }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ section.id }}{ {%- if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}background-color:{{ section.settings.section_bg }};{%- endif -%}isolation:isolate;font-weight:var(--body-weight,inherit);margin-top:{{ section.settings.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ section.settings.section_margin_bottom_mobile | default: 0 }}px;max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;padding-left:0!important;padding-right:0!important;position:relative!important;box-sizing:border-box!important}
  :where(#shopify-section-{{ section.id }}){font-family:var(--body-font,inherit)}
  :where(#shopify-section-{{ section.id }}) :where(button,input,textarea,select,optgroup){font-family:inherit}
  :where(#shopify-section-{{ section.id }}) :is(h1,h2,h3,h4,h5,h6){font-weight:var(--heading-weight,inherit);font-family:var(--heading-font,inherit)}
  @media (min-width:768px){#shopify-section-{{ section.id }}{margin-top:{{ section.settings.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ section.settings.section_margin_bottom_desktop | default: 0 }}px}}
  #shopify-section-{{ section.id }}>:where(div,section,header,footer,aside,main,article):first-child{max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;box-sizing:border-box!important}
  {%- case section.settings.section_width -%}
    {%- when 'container' %}
  #shopify-section-{{ section.id }} .container,#shopify-section-{{ section.id }}:not(.no-section-width-wrap)>:is(div,section,header,footer,aside,main,article):first-child{max-width:calc(var(--page-width,1300px) + 3rem)!important;margin-inline:auto!important;box-sizing:border-box!important}
    {%- when 'fluid_container' %}
  #shopify-section-{{ section.id }} .fluid_container,#shopify-section-{{ section.id }}:not(.no-section-width-wrap)>:is(div,section,header,footer,aside,main,article):first-child{max-width:calc(var(--fluid-container-width,1500px) + 3rem)!important;margin-inline:auto!important;box-sizing:border-box!important}
    {%- when 'stretch_width' %}
  @media (min-width:1200px){#shopify-section-{{ section.id }} .stretch_width,#shopify-section-{{ section.id }}:not(.no-section-width-wrap)>:is(div,section,header,footer,aside,main,article):first-child{padding-inline:3rem}}
  {%- endcase %}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Divider section.
  A flexible separator: line, dashed, dotted, double, gradient,
  with optional centered icon/label and adjustable spacing.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign section_width = s.section_width | default: 'full_width'
  assign style_kind = s.style | default: 'solid'
  assign thickness = s.thickness | default: 1
  assign width_pct = s.width_pct | default: 100
  assign align = s.align | default: 'center'
  assign color_from = s.color_from
  assign color_to = s.color_to
  assign label = s.label
  assign icon_svg = s.icon_svg
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top | default: 0 }};
  --section-pb: {{ s.padding_bottom | default: 0 }};
  --div-thickness: {{ thickness }}px;
  --div-color: {% render 'scheme-color', color: color_from, fallback: 'var(--color-border)' %} !important;
  --div-color-to: {% render 'scheme-color', color: color_to, fallback: 'var(--color-border)' %};
  --div-width: {{ width_pct }}%;
  --div-gap: {{ s.label_gap | default: 14 }}px;
  --div-label-color: {% render 'scheme-color', color: s.label_color, fallback: 'var(--color-text)' %} !important;
  --div-label-size: {{ s.label_size | default: 12 }}px;
  --div-justify: {% if align == 'left' %}flex-start{% elsif align == 'right' %}flex-end{% else %}center{% endif %};
{%- endcapture -%}
{%- comment -%} The builder also gets it inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'divider-section.css' | inline_asset_content }}</style>{%- endif %}
{{ 'divider-section.css' | asset_url | stylesheet_tag }}

<div
  class="section sec__divider{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  data-div-style="{{ style_kind }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="sec__divider-wrap">
      <div class="sec__divider-inner">
        <div class="sec__divider-line" aria-hidden="true"></div>
        {%- if label != blank or icon_svg != blank -%}
          <span class="sec__divider-label">
            {%- if icon_svg != blank -%}{{ icon_svg }}{%- endif -%}
            {%- if label != blank -%}{{ label }}{%- endif -%}
          </span>
          <div class="sec__divider-line" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "divider",
  "name": "Divider",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Center label"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        },
        {
          "value": "gradient",
          "label": "Gradient fade"
        },
        {
          "value": "shadow",
          "label": "Soft glow"
        }
      ]
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Center icon (SVG)"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap around label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "width_pct",
      "label": "Line width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "color_from",
      "label": "Line color"
    },
    {
      "type": "color",
      "id": "color_to",
      "label": "Gradient end color",
      "info": "Used by Gradient fade style."
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
