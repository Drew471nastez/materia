<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  The section wrapper's own rules (spacing, width, background, isolation),
  which need its id. The rest of the divider's CSS is divider-section.css.
{%- endcomment -%}
<style>
  {%- if section.settings.reset_spacing %}
  #shopify-section-{{ section.id }},#shopify-section-{{ section.id }}>.section,#shopify-section-{{ section.id }}>section,#shopify-section-{{ section.id }}>div,#shopify-section-{{ section.id }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ section.id }}+.shopify-section,#shopify-section-{{ section.id }}+section,.shopify-section+#shopify-section-{{ section.id }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ section.id }}{ {%- if section.settings.enable_custom_style and section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}background-color:{{ section.settings.section_bg }};{%- endif -%}isolation:isolate;font-weight:var(--body-weight,inherit);margin-top:{{ section.settings.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ section.settings.section_margin_bottom_mobile | default: 0 }}px;max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;padding-left:0!important;padding-right:0!important;position:relative!important;box-sizing:border-box!important}
  :where(#shopify-section-{{ section.id }}){font-family:var(--body-font,inherit)}
  :where(#shopify-section-{{ section.id }}) :where(button,input,textarea,select,optgroup){font-family:inherit}
  :where(#shopify-section-{{ section.id }}) :is(h1,h2,h3,h4,h5,h6){font-weight:var(--heading-weight,inherit);font-family:var(--heading-font,inherit)}
  @media (min-width:768px){#shopify-section-{{ section.id }}{margin-top:{{ section.settings.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ section.settings.section_margin_bottom_desktop | default: 0 }}px}}
  #shopify-section-{{ section.id }}>:where(div,section,header,footer,aside,main,article):first-child{max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;box-sizing:border-box!important}
  {%- comment -%} Section width: the .container / .fluid_container / .stretch_width rules are in divider-section.css, so a live change of the inner class is enough. {%- endcomment %}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Divider: a line (solid, dashed, dotted, double, gradient
  fade or soft glow) with an optional label block in the middle. The values
  are --div-* variables on the root; divider-section.css draws them and
  live-social-dividers.js writes the ones a live edit changes.
  Colours follow the colour scheme until Enable custom styling is on.
  A section saved before the label block keeps its Center label settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign section_width = s.section_width | default: 'full_width'
  assign style_kind = s.style | default: 'solid'
  assign align = s.align | default: 'center'
  assign own_colors = s.enable_custom_style
  assign label_block = section.blocks | where: 'type', 'label' | first
  if label_block
    assign lb = label_block.settings
    assign label = lb.text
    assign icon_svg = lb.icon_svg
    assign label_size = lb.size | default: 12
    assign label_color = ''
    if lb.enable_custom_style
      assign label_color = lb.color
    endif
    assign label_font = false
    if lb.enable_custom_fonts and lb.font != blank and lb.font.family != blank
      assign label_font = true
    endif
  else
    assign label = s.label
    assign icon_svg = s.icon_svg
    assign label_size = s.label_size | default: 12
    assign label_color = ''
    if own_colors
      assign label_color = s.label_color
    endif
    assign label_font = false
  endif
  assign line_color = ''
  assign line_color_to = ''
  if own_colors
    assign line_color = s.color_from
    assign line_color_to = s.color_to
  endif
  assign has_label = false
  if label != blank or icon_svg != blank
    assign has_label = true
  endif
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top | default: 0 }};
  --section-pb: {{ s.padding_bottom | default: 0 }};
  --div-thickness: {{ s.thickness | default: 1 }}px;
  --div-color: {% render 'scheme-color', color: line_color, fallback: 'var(--color-border)' %} !important;
  --div-color-to: {% render 'scheme-color', color: line_color_to, fallback: 'var(--color-border)' %};
  --div-width: {{ s.width_pct | default: 100 }}%;
  --div-gap: {{ s.label_gap | default: 14 }}px;
  --div-label-color: {% render 'scheme-color', color: label_color, fallback: 'var(--color-text)' %} !important;
  --div-label-size: {{ label_size }}px;
  --div-justify: {% if align == 'left' %}flex-start{% elsif align == 'right' %}flex-end{% else %}center{% endif %};
{%- endcapture -%}
{%- comment -%} The builder also gets it inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'divider-section.css' | inline_asset_content }}</style>{%- endif %}
{{ 'divider-section.css' | asset_url | stylesheet_tag }}
{%- if label_font -%}<style>{{ lb.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif %}

<div
  class="section sec__divider{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  data-div-style="{{ style_kind }}"
  data-sd-root="divider" data-sd-section="{{ section.id }}" data-sd-settings="{{ section.settings | json | escape }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}" data-sd-width>
    <div class="sec__divider-wrap">
      <div class="sec__divider-inner">
        <div class="sec__divider-line" aria-hidden="true"></div>
        {%- comment -%} An empty label is drawn hidden in the builder only, so typing one shows it live. {%- endcomment -%}
        {%- if has_label or request.design_mode %}
        <span class="sec__divider-label" data-sd-label data-sd-label-part{% unless has_label %} hidden{% endunless %}
          {%- if label_block %} data-sd-block="{{ label_block.id }}" data-sd-type="label" data-sd-settings="{{ label_block.settings | json | escape }}" {{ label_block.shopify_attributes }}{% endif -%}
          {%- if label_font %} data-own-font{% if lb.font.weight != blank %} data-own-weight{% endif %} style="--div-label-font: {{ lb.font.family }}, {{ lb.font.fallback_families }};{% if lb.font.weight != blank %} --div-label-weight: {{ lb.font.weight }};{% endif %}"{% endif -%}
        >
          {%- if icon_svg != blank -%}{{ icon_svg }}{%- endif -%}
          {%- if label != blank -%}{{ label | escape }}{%- endif -%}
        </span>
        <div class="sec__divider-line" aria-hidden="true" data-sd-label-part{% unless has_label %} hidden{% endunless %}></div>
        {%- endif %}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "divider",
  "name": "Divider",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Center label",
      "hidden": true,
      "info": "Legacy: used only when the section has no Label block."
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Center icon (SVG)",
      "hidden": true,
      "info": "Legacy: used only when the section has no Label block."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "width_pct",
      "label": "Line width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap around label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Line"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        },
        {
          "value": "gradient",
          "label": "Gradient fade"
        },
        {
          "value": "shadow",
          "label": "Soft glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "color_from",
      "label": "Line color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "color_to",
      "label": "Gradient end color",
      "info": "Used by the Gradient fade style.",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "hidden": true,
      "info": "Legacy: used only when the section has no Label block."
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12,
      "hidden": true,
      "info": "Legacy: used only when the section has no Label block."
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "label",
      "name": "Label",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Label",
          "default": "Or"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon (SVG)",
          "info": "Shown before the label."
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Label color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_7",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Label size",
          "min": 9,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Dividers"
    },
    {
      "name": "Divider with label",
      "category": "Dividers",
      "settings": {
        "style": "solid",
        "width_pct": 60
      },
      "blocks": [
        {
          "type": "label",
          "settings": {
            "text": "Or"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "overlay"
    ]
  },
  "shopify": {
    "name": "Divider",
    "tag": "section",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "custom.overlay"
