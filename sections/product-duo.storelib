<template compat="shopify">
<script src="{{ 'live-r7-products.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Product Duo: two picked products side by side, for a
  "which one is for you" choice. Each Product block gives a card its picture,
  title, price and link from the product itself; the Point blocks under a
  Product block are that product's points, in the creator's words. The
  button opens the product page, or adds a product that has no options to
  the cart through the theme's own product form (product-form, theme.js);
  a product with options opens its page so the visitor can choose, and a
  sold out one shows the theme's sold out label and no active buy button.
  On phones the two cards stack, or swipe as a native scroller (scroll snap).
  An empty Product block draws a placeholder card in the builder and nothing
  on the store. live-r7-products.js applies the settings in the builder.
{%- endcomment -%}
{{ 'r7-products.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_width = s.section_width | default: 'container'
  assign own = s.enable_custom_style
  assign duo_ratio = '1 / 1'
  if s.image_ratio == 'portrait'
    assign duo_ratio = '4 / 5'
  elsif s.image_ratio == 'landscape'
    assign duo_ratio = '4 / 3'
  endif
  assign duo_seen = 0
  assign duo_cards = 0
  assign duo_points_1 = ''
  assign duo_points_2 = ''
  assign duo_or = s.divider_text | strip
  assign duo_or_mode = 'none'
  if duo_or != blank
    assign duo_or_mode = 'text'
  elsif s.card_style == 'plain'
    assign duo_or_mode = 'line'
  endif
-%}
{%- for block in section.blocks -%}
  {%- if block.type == 'product' -%}
    {%- assign duo_seen = duo_seen | plus: 1 -%}
    {%- if duo_seen < 3 -%}
      {%- if block.settings.product.id != blank or request.design_mode -%}
        {%- assign duo_cards = duo_cards | plus: 1 -%}
      {%- endif -%}
    {%- endif -%}
  {%- elsif block.type == 'point' -%}
    {%- capture duo_pjson -%}{"text":{{ block.settings.text | append: '' | json }}}{%- endcapture -%}
    {%- capture duo_point -%}<li class="r7duo__point" data-r7k-block="{{ block.id }}" data-r7k-type="point"{% if request.design_mode %} data-r7k-settings="{{ duo_pjson | escape }}"{% endif %}{% if block.settings.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endcapture -%}
    {%- if duo_seen > 1 -%}
      {%- assign duo_points_2 = duo_points_2 | append: duo_point -%}
    {%- else -%}
      {%- assign duo_points_1 = duo_points_1 | append: duo_point -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- capture r7k_json -%}{"color_scheme":{{ color_scheme | json }},"section_width":{{ section_width | json }},"reset_spacing":{% if s.reset_spacing %}true{% else %}false{% endif %},"divider_text":{{ s.divider_text | append: '' | json }},"header_alignment":{{ s.header_alignment | append: '' | json }},"header_spacing":{{ s.header_spacing | default: 0 | json }},"content_alignment":{{ s.content_alignment | append: '' | json }},"card_style":{{ s.card_style | append: '' | json }},"column_gap":{{ s.column_gap | default: 0 | json }},"image_ratio":{{ s.image_ratio | append: '' | json }},"enable_custom_style":{% if own %}true{% else %}false{% endif %},"section_bg_override":{{ s.section_bg_override | append: '' | json }},"card_bg":{{ s.card_bg | append: '' | json }},"line_color":{{ s.line_color | append: '' | json }},"title_color":{{ s.title_color | append: '' | json }},"text_color":{{ s.text_color | append: '' | json }},"price_color":{{ s.price_color | append: '' | json }},"button_bg":{{ s.button_bg | append: '' | json }},"button_text":{{ s.button_text | append: '' | json }},"button_bg_hover":{{ s.button_bg_hover | append: '' | json }},"button_text_hover":{{ s.button_text_hover | append: '' | json }},"use_theme_button":{% if s.use_theme_button == false %}false{% else %}true{% endif %},"button_radius":{{ s.button_radius | default: 0 | json }},"button_padding_v":{{ s.button_padding_v | default: 0 | json }},"button_padding_h":{{ s.button_padding_h | default: 0 | json }},"button_font_size":{{ s.button_font_size | default: 0 | json }},"enable_custom_fonts":{% if s.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ s.heading_font.family | append: '' | json }},"fallback_families":{{ s.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ s.body_font.family | append: '' | json }},"fallback_families":{{ s.body_font.fallback_families | append: '' | json }}},"title_size":{{ s.title_size | default: 0 | json }},"text_size":{{ s.text_size | default: 0 | json }},"padding_top":{{ s.padding_top | default: 0 | json }},"padding_bottom":{{ s.padding_bottom | default: 0 | json }},"section_margin_top_desktop":{{ s.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ s.section_margin_bottom_desktop | default: 0 | json }},"mobile_layout":{{ s.mobile_layout | append: '' | json }},"section_margin_top_mobile":{{ s.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ s.section_margin_bottom_mobile | default: 0 | json }}}{%- endcapture -%}
{%- capture duo_vars -%}
  --section-pt: {{ s.padding_top | default: 0 }};--section-pb: {{ s.padding_bottom | default: 0 }};--r7k-hgap: {{ s.header_spacing | default: 0 }}px;--duo-gap: {{ s.column_gap | default: 0 }}px;--duo-ratio: {{ duo_ratio }};--duo-title: {{ s.title_size | default: 22 }}px;--duo-text: {{ s.text_size | default: 15 }}px;
  {%- if own -%}
    --r7k-bg: {% render 'scheme-color', color: s.section_bg_override, fallback: 'var(--color-background)' %};--duo-card-bg: {% render 'scheme-color', color: s.card_bg, fallback: 'color-mix(in srgb, var(--color-heading) 5%, var(--color-background))' %};--duo-line: {% render 'scheme-color', color: s.line_color, fallback: 'var(--color-border)' %};--duo-title-c: {% render 'scheme-color', color: s.title_color, fallback: 'var(--color-heading)' %};--duo-text-c: {% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %};--duo-price-c: {% render 'scheme-color', color: s.price_color, fallback: 'var(--color-heading)' %};
    {%- render 'button-overrides', bg: s.button_bg, text: s.button_text, hover_bg: s.button_bg_hover, hover_text: s.button_text_hover -%}
  {%- endif -%}
  {%- if s.use_theme_button == false -%}--mb-radius: {{ s.button_radius | default: 0 }}px;--mb-padding-y: {{ s.button_padding_v | default: 0 }}px;--mb-padding-x: {{ s.button_padding_h | default: 0 }}px;--mb-font-size: {{ s.button_font_size | default: 15 }}px;{%- endif -%}
  {%- if s.enable_custom_fonts and s.heading_font.family != blank -%}--heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
  {%- if s.enable_custom_fonts and s.body_font.family != blank -%}--body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }}, .shopify-section + #shopify-section-{{ sid }} {
    margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px !important;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}, .shopify-section + #shopify-section-{{ sid }} {
      margin-top: {{ s.section_margin_top_desktop | default: 0 }}px !important;
      margin-bottom: {{ s.section_margin_bottom_desktop | default: 0 }}px !important;
    }
  }
  /* No product picked on the store: the section takes no space at all. */
  #shopify-section-{{ sid }}:has(> .r7duo[hidden]) { display: none !important; }
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<div
  class="section r7k r7duo{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}"
  data-r7k-root="product-duo" data-r7k-section="{{ sid }}"{% if request.design_mode %} data-r7k-settings="{{ r7k_json | escape }}"{% endif %}
  data-align="{{ s.header_alignment | default: 'center' }}" data-width="{{ section_width }}"
  data-content-align="{{ s.content_alignment | default: 'left' }}" data-card="{{ s.card_style | default: 'plain' }}" data-mobile="{{ s.mobile_layout | default: 'stack' }}"
  style="{{ duo_vars | strip }}"
  {%- if duo_cards == 0 and request.design_mode == false %} hidden{% endif %}
>
  <div class="r7k-inner {{ section_width }}" data-r7k-width>
    <div class="r7k-header" data-r7k-header>
      <div class="r7k-header__text">
        {%- for block in section.blocks -%}
          {%- if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading' -%}
            {%- render 'r7-products-text', block: block, sid: sid -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="r7duo__grid" data-r7k-track data-count="{{ duo_cards }}" data-or="{{ duo_or_mode }}">
      {%- liquid
        assign duo_seen = 0
        assign duo_drawn = 0
      -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'product' -%}{%- continue -%}{%- endif -%}
        {%- assign duo_seen = duo_seen | plus: 1 -%}
        {%- if duo_seen > 2 -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign bs = block.settings
          assign duo_p = bs.product
          assign duo_has = false
          if duo_p.id != blank
            assign duo_has = true
          endif
          assign duo_role = 'primary'
          if bs.button_style == 'secondary'
            assign duo_role = 'secondary'
          endif
          assign duo_variant = duo_p.selected_or_first_available_variant
          assign duo_single = false
          if duo_p.has_only_default_variant or duo_p.variants.size == 1
            assign duo_single = true
          endif
          assign duo_href = duo_p.url | default: routes.all_products_collection_url | default: '/collections/all'
          assign duo_img = bs.image | default: duo_p.featured_media.preview_image | default: duo_p.featured_image
          assign duo_alt = duo_img.alt | default: duo_p.title
          assign duo_points = duo_points_1
          if duo_seen == 2
            assign duo_points = duo_points_2
          endif
        -%}
        {%- unless duo_has or request.design_mode -%}{%- continue -%}{%- endunless -%}
        {%- if duo_drawn == 1 -%}
          <p class="r7duo__or" data-r7k-or><span data-r7k-or-text>{{ duo_or | escape }}</span></p>
        {%- endif -%}
        {%- assign duo_drawn = duo_drawn | plus: 1 -%}
        {%- capture duo_bjson -%}{"label":{{ bs.label | append: '' | json }},"button_action":{{ bs.button_action | append: '' | json }},"button_label":{{ bs.button_label | append: '' | json }},"button_style":{{ duo_role | json }}}{%- endcapture -%}
        <article class="r7duo__card" data-r7k-block="{{ block.id }}" data-r7k-type="product"{% if request.design_mode %} data-r7k-settings="{{ duo_bjson | escape }}"{% endif %} {{ block.shopify_attributes }}>
          <a class="r7duo__media" tabindex="-1"{% if duo_has %} href="{{ duo_p.url }}"{% else %} role="link" aria-disabled="true"{% endif %}>
            {%- if duo_img != blank -%}
              <img
                src="{{ duo_img | image_url: width: 900 }}"
                srcset="{{ duo_img | image_url: width: 480 }} 480w, {{ duo_img | image_url: width: 900 }} 900w, {{ duo_img | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 768px) 45vw, 90vw"
                width="{{ duo_img.width | default: 900 }}" height="{{ duo_img.height | default: 900 }}"
                alt="{{ duo_alt | escape }}" loading="lazy" decoding="async"
              >
            {%- else -%}
              {%- render 'placeholder-render' -%}
            {%- endif -%}
          </a>
          <div class="r7duo__body">
            <p class="r7duo__label" data-r7k-label{% if bs.label == blank %} hidden{% endif %}>{{ bs.label | escape }}</p>
            <h3 class="r7duo__title">
              {%- if duo_has -%}
                <a href="{{ duo_p.url }}">{{ duo_p.title | escape }}</a>
              {%- else -%}
                {{ 'onboarding.product_title_example' | t }}
              {%- endif -%}
            </h3>
            <p class="r7duo__price">
              {%- if duo_has -%}
                {%- liquid
                  assign duo_money = duo_p.price | money
                  assign duo_was = duo_p.compare_at_price | money
                  if settings.show_currency_code
                    assign duo_money = duo_p.price | money_with_currency
                    assign duo_was = duo_p.compare_at_price | money_with_currency
                  endif
                  if duo_p.price_varies
                    assign duo_money = 'products.product.price.from_price_html' | t: price: duo_money
                  endif
                -%}
                <span class="r7duo__now">{% if duo_p.compare_at_price > duo_p.price %}<span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>{% endif %}{{ duo_money }}</span>
                {%- if duo_p.compare_at_price > duo_p.price -%}
                  <s class="r7duo__was"><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ duo_was }}</s>
                {%- endif -%}
                {%- unless duo_p.available -%}<span class="r7duo__sold">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
              {%- else -%}
                <span class="r7duo__skeleton" aria-hidden="true"></span>
              {%- endif -%}
            </p>
            <ul class="r7duo__points" role="list" data-r7k-points>{{ duo_points }}</ul>
            <div class="r7duo__action" data-r7k-action="{% if bs.button_action == 'cart' %}cart{% else %}page{% endif %}">
              {%- if duo_has == false -%}
                <a class="r7duo__btn" data-theme-button="{{ duo_role }}" data-sl-button{% if s.use_theme_button == false %} data-own-shape{% endif %} data-r7k-btn role="link" aria-disabled="true"{% if bs.button_action != 'cart' and bs.button_label == blank %} hidden{% endif %}><span data-r7k-btn-label>{% if bs.button_action == 'cart' %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ bs.button_label | escape }}{% endif %}</span></a>
              {%- elsif bs.button_action == 'cart' and duo_p.available == false -%}
                <button type="button" class="r7duo__btn" data-theme-button="{{ duo_role }}" data-sl-button{% if s.use_theme_button == false %} data-own-shape{% endif %} data-r7k-btn disabled><span>{{ 'products.product.sold_out' | t }}</span></button>
              {%- elsif bs.button_action == 'cart' and duo_single -%}
                {%- assign duo_form_id = 'r7duo-form-' | append: sid | append: '-' | append: block.id -%}
                <product-form class="r7duo__form">
                  {%- form 'product', duo_p, id: duo_form_id, class: 'r7duo__form-el', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ duo_variant.id }}">
                    <button type="submit" name="add" class="r7duo__btn product__add-cart" data-theme-button="{{ duo_role }}" data-sl-button{% if s.use_theme_button == false %} data-own-shape{% endif %} data-r7k-btn aria-live="polite">
                      <span class="btn-action">{{ 'products.product.add_to_cart' | t }}</span>
                    </button>
                  {%- endform -%}
                </product-form>
              {%- elsif bs.button_action == 'cart' -%}
                <a class="r7duo__btn" data-theme-button="{{ duo_role }}" data-sl-button{% if s.use_theme_button == false %} data-own-shape{% endif %} data-r7k-btn href="{{ duo_p.url }}"><span>{{ 'products.product.actions.select_options.label' | t }}</span></a>
              {%- else -%}
                <a class="r7duo__btn" data-theme-button="{{ duo_role }}" data-sl-button{% if s.use_theme_button == false %} data-own-shape{% endif %} data-r7k-btn href="{{ duo_href }}"{% if bs.button_label == blank %} hidden{% endif %}><span data-r7k-btn-label>{{ bs.button_label | escape }}</span></a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
      {%- if duo_cards == 0 and request.design_mode -%}
        <p class="r7duo__empty">Add a Product block and pick a product.</p>
      {%- endif -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "product-duo",
  "name": "Product Duo",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove the theme's space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "Word between the products",
      "default": "or",
      "info": "Empty: no word."
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Space below the header",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text in the cards",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "filled",
          "label": "Filled"
        }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between products",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56,
      "info": "Desktop."
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "square",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg_override",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style == 'filled' }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Lines",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Button text (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
