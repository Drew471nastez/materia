<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign custom = s.enable_custom_style
  assign loading = 'eager'
  if s.lazyload
    assign loading = 'lazy'
  endif
  assign max_width = 'none'
  if s.is_fullwidth != true and s.container_max_width > 0
    assign max_width = s.container_max_width | append: 'px'
  endif
  case s.display_section_on
    when 'mobile_only'
      assign show = 'mobile'
    when 'desktop_only'
      assign show = 'desktop'
    when 'no_devices'
      assign show = 'none'
    else
      assign show = 'all'
  endcase
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'media-galleries-a-base', section: section %}
{%- comment -%}
  Materia Themes. Gallery Grid 1: four fixed images or looping videos. On
  desktop a large square sits beside a wide image above two squares; on a phone
  the wide image follows the square and the two small ones share a row.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .mga-g1__frame { max-width: var(--mga-max); margin-inline: auto; background: var(--mga-bg); }
  #shopify-section-{{ section.id }} .mga-g1__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas: "one one" "two two" "three four";
    column-gap: var(--mga-gap);
    row-gap: var(--mga-row-gap-m);
  }
  #shopify-section-{{ section.id }} .mga-g1__side { display: contents; }
  #shopify-section-{{ section.id }} [data-mga-slot] { border-radius: var(--mga-radius); aspect-ratio: 1 / 1; }
  #shopify-section-{{ section.id }} [data-mga-slot="1"] { grid-area: one; }
  #shopify-section-{{ section.id }} [data-mga-slot="2"] { grid-area: two; aspect-ratio: 2 / 1; }
  #shopify-section-{{ section.id }} [data-mga-slot="3"] { grid-area: three; }
  #shopify-section-{{ section.id }} [data-mga-slot="4"] { grid-area: four; }
  #shopify-section-{{ section.id }} [data-mga-slot] .mga-fill { transition: transform 0.4s ease, opacity 0.4s ease; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .mga-g1[data-mga-hover="fade-in"] [data-mga-slot]:hover .mga-fill { opacity: 0.8; }
    #shopify-section-{{ section.id }} .mga-g1[data-mga-hover="zoom-in"] [data-mga-slot]:hover .mga-fill { transform: scale(1.1); }
    #shopify-section-{{ section.id }} .mga-g1[data-mga-hover="scale-up"] [data-mga-slot]:hover .mga-fill { transform: scale(1.03); }
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .mga-g1__grid { grid-template-areas: none; row-gap: 0; align-items: stretch; }
    #shopify-section-{{ section.id }} .mga-g1__side {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: "two two" "three four";
      column-gap: var(--mga-gap);
      row-gap: var(--mga-row-gap-d);
      min-width: 0;
    }
    #shopify-section-{{ section.id }} [data-mga-slot="1"] { grid-area: auto; }
    #shopify-section-{{ section.id }} [data-mga-slot="2"] { aspect-ratio: auto; min-height: 80px; }
  }
{% comment %}{% endcomment %}</style>
<div
  class="mga mga-g1 color-{{ color_scheme }} gradient"
  data-mga-section="{{ section.id }}"
  data-mga-type="gallery-grid1"
  data-mga-settings="{{ section.settings | json | escape }}"
  data-mga-defaults='{"color_scheme":"default-color-scheme","is_fullwidth":false,"display_section_on":"all_devices","reset_spacing":true,"container_max_width":1320,"gutter":10,"vertical_space_desktop":20,"image_border_radius":8,"image_hover_animation":"fade-in","lazyload":true,"enable_custom_style":false,"section_padding_top":50,"section_padding_bottom":50,"padding_left_desktop":25,"padding_right_desktop":25,"vertical_space_mobile":20,"section_padding_top_mobile":50,"section_padding_bottom_mobile":50,"padding_left_mobile":10,"padding_right_mobile":10}'
  data-mga-reset="{% if s.reset_spacing %}true{% else %}false{% endif %}"
  data-mga-hover="{{ s.image_hover_animation | default: 'none' }}"
  data-mga-show="{{ show }}"
  style="--mga-section-bg: {% if custom %}{% render 'scheme-color', color: s.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --mga-bg: {% if custom %}{% render 'scheme-color', color: s.background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --mga-max: {{ max_width }}; --mga-gap: {{ s.gutter }}px; --mga-row-gap-d: {{ s.vertical_space_desktop }}px; --mga-row-gap-m: {{ s.vertical_space_mobile }}px; --mga-radius: {{ s.image_border_radius }}px; --mga-pt-d: {{ s.section_padding_top }}px; --mga-pb-d: {{ s.section_padding_bottom }}px; --mga-pl-d: {{ s.padding_left_desktop }}px; --mga-pr-d: {{ s.padding_right_desktop }}px; --mga-pt-m: {{ s.section_padding_top_mobile }}px; --mga-pb-m: {{ s.section_padding_bottom_mobile }}px; --mga-pl-m: {{ s.padding_left_mobile }}px; --mga-pr-m: {{ s.padding_right_mobile }}px;"
>
  <style data-mga-custom-css>{{ s.custom_css }}</style>
  <div class="mga__frame mga-g1__frame">
    <div class="mga-g1__grid">
      {%- for n in (1..4) -%}
        {%- liquid
          assign key = 'background_image_' | append: n
          assign img = s[key]
          assign key = 'video_url_' | append: n
          assign vid = s[key] | strip_html | strip
          assign key = 'alt_' | append: n
          assign alt = s[key] | strip_html | strip
          if alt == blank
            assign alt = img.alt
          endif
          assign media = 'none'
          if vid != blank
            assign media = 'video'
          elsif img != blank
            assign media = 'image'
          endif
          if n == 1
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          elsif n == 2
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 25vw, 50vw'
          endif
        -%}
        {%- if n == 2 -%}<div class="mga-g1__side">{%- endif -%}
        <div class="mga-media mga-g1__item" data-mga-slot="{{ n }}" data-media="{{ media }}">
          {% render 'media-galleries-a-ph' %}
          <video data-mga-video class="mga-fill" muted loop playsinline autoplay preload="metadata" aria-hidden="true"{% if vid != blank %} src="{{ vid | escape }}"{% else %} hidden{% endif %}></video>
          <img data-mga-img class="mga-fill"{% if img != blank %} src="{{ img | image_url: width: 1500 }}" srcset="{{ img | image_url: width: 490 }} 490w, {{ img | image_url: width: 750 }} 750w, {{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1500 }} 1500w" sizes="{{ sizes }}" width="{{ img.width | default: 1500 }}" height="{{ img.height | default: 1500 }}"{% endif %}{% if img == blank or vid != blank %} hidden{% endif %} alt="{{ alt | escape }}" loading="{{ loading }}" decoding="async">
        </div>
        {%- if n == 4 -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "gallery-grid1",
  "name": "Gallery Grid 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "is_fullwidth",
      "default": false,
      "label": "Full width"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Content width (px)",
      "min": 720,
      "max": 1920,
      "step": 100,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Gallery Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "gutter",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image gap",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image_1",
      "label": "Image 1"
    },
