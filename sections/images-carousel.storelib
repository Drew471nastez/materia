<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Gallery Scrolling Logos: one or two rows of images that
  scroll in a continuous loop. Each row repeats its group of images enough
  times to cover a 2560px wide row, and the track moves by exactly one
  group per loop, so the wrap point lines up to the pixel. The number of
  copies is worked out here from the settings (no measuring), and again by
  media-live-galleries-b.js when a size or gap changes in the editor.
  Under reduced motion the strip stops and the images wrap in place.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.45%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign custom = st.enable_custom_style
  if st.make_images_square
    assign w_base = 200
    assign h_base = 200
  else
    assign w_base = st.image_width | default: 170
    assign h_base = st.image_height | default: 110
  endif
  assign scale_d = st.slider_scale | default: 1 | times: 1.0
  assign scale_m = st.overall_size_mobile | default: 0.9 | times: 1.0
  assign gap_d = st.item_gap | default: 0 | at_least: 0
  assign gap_m = st.item_gap_mobile | default: 0 | at_least: 0
  assign unit_d = w_base | times: scale_d | plus: gap_d | at_least: 1
  assign unit_m = w_base | times: scale_m | plus: gap_m | at_least: 1
  assign total = section.blocks.size
  assign rows = 1
  assign first_count = total
  if st.enable_second_scrolling and total > 1
    assign rows = 2
    assign first_count = total | plus: 1 | divided_by: 2
  endif
  assign second_count = total | minus: first_count
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--mgb-mt-m, {{ st.section_margin_top_mobile | default: 0 }}px) !important; margin-bottom: var(--mgb-mb-m, {{ st.section_margin_bottom_mobile | default: 0 }}px) !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--mgb-mt-d, {{ st.section_margin_top_desktop | default: 0 }}px) !important; margin-bottom: var(--mgb-mb-d, {{ st.section_margin_bottom_desktop | default: 0 }}px) !important; }
  }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) { padding-top: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) + .shopify-section { margin-top: 0 !important; }
  #shopify-section-{{ sid }} .mq {
    --mq-bg: {% if custom %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --mq-wb: {{ w_base }}px;
    --mq-hb: {{ h_base }}px;
    --mq-scale-d: {{ scale_d }};
    --mq-scale-m: {{ scale_m }};
    --mq-gap-d: {{ gap_d }}px;
    --mq-gap-m: {{ gap_m }}px;
    --mq-radius: {{ st.image_border_radius | default: 0 }}px;
    --mq-fit: {{ st.image_fit | default: 'cover' }};
    --mq-dur1-d: {{ st.speed | default: 0 }}s;
    --mq-dur1-m: {{ st.speed_mobile | default: 0 }}s;
    --mq-dur2: {{ st.speed_second_scrolling | default: 0 }}s;
    --mq-row-gap: {{ st.scroll_gap | default: 0 }}px;
    --mq-pt: {{ st.padding_top | default: 0 }}px;
    --mq-pb: {{ st.padding_bottom | default: 0 }}px;
    --mq-scale: var(--mq-scale-m); --mq-gap: var(--mq-gap-m); --mq-dur1: var(--mq-dur1-m);
    display: block;
    position: relative;
    background: var(--mq-bg);
    color: var(--color-text);
    padding-top: var(--mq-pt);
    padding-bottom: var(--mq-pb);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mq { --mq-scale: var(--mq-scale-d); --mq-gap: var(--mq-gap-d); --mq-dur1: var(--mq-dur1-d); }
  }
  #shopify-section-{{ sid }} .mq__inner { width: 100%; margin-inline: auto; position: relative; }
  #shopify-section-{{ sid }} .mq[data-width='container'] .mq__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .mq[data-width='fluid_container'] .mq__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .mq[data-width='stretch_width'] .mq__inner { padding-inline: 3rem; } }
  #shopify-section-{{ sid }} .mq__row { overflow: hidden; width: 100%; }
  #shopify-section-{{ sid }} .mq__row + .mq__row { margin-top: var(--mq-row-gap); }
  #shopify-section-{{ sid }} .mq__track { display: flex; width: max-content; will-change: transform; animation: mgb-mq-{{ sid }} var(--mq-dur1) linear infinite; animation-direction: normal; }
  #shopify-section-{{ sid }} .mq__row[data-mq-row='2'] .mq__track { animation-duration: var(--mq-dur2); }
  #shopify-section-{{ sid }} .mq__row[data-dir='right'] .mq__track { animation-direction: reverse; }
  #shopify-section-{{ sid }} .mq[data-static1='true'] .mq__row[data-mq-row='1'] .mq__track,
  #shopify-section-{{ sid }} .mq[data-static2='true'] .mq__row[data-mq-row='2'] .mq__track { animation-play-state: paused; }
  #shopify-section-{{ sid }} .mq[data-pause-hover='true'] .mq__row:hover .mq__track,
  #shopify-section-{{ sid }} .mq[data-paused='true'] .mq__track,
  #shopify-section-{{ sid }} .mq[data-offscreen='true'] .mq__track { animation-play-state: paused; }
  @keyframes mgb-mq-{{ sid }} { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(calc(-100% / var(--mq-k, 2)), 0, 0); } }
  #shopify-section-{{ sid }} .mq__group { display: flex; flex: 0 0 auto; align-items: center; gap: var(--mq-gap); padding-inline-end: var(--mq-gap); margin: 0; }
  #shopify-section-{{ sid }} .mq__item { flex: 0 0 auto; width: calc(var(--mq-wb) * var(--mq-scale)); height: calc(var(--mq-hb) * var(--mq-scale)); border-radius: var(--mq-radius); overflow: hidden; margin: 0; }
  #shopify-section-{{ sid }} .mq__item img { display: block; width: 100%; height: 100%; margin: 0; object-fit: var(--mq-fit); border-radius: inherit; }
  #shopify-section-{{ sid }} .mq__item img[data-mgb-placeholder] { object-fit: contain; background: color-mix(in srgb, var(--color-text) 8%, var(--mq-bg)); }
  #shopify-section-{{ sid }} .mq__pause { position: absolute; right: 8px; bottom: 8px; z-index: 2; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; margin: 0; border: 1px solid var(--color-border); border-radius: 50%; background: var(--mq-bg); color: var(--color-heading); cursor: pointer; }
  #shopify-section-{{ sid }} .mq__pause:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  #shopify-section-{{ sid }} .mq__pause svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .mq__pause [data-icon='play'], #shopify-section-{{ sid }} .mq[data-paused='true'] .mq__pause [data-icon='pause'] { display: none; }
  #shopify-section-{{ sid }} .mq[data-paused='true'] .mq__pause [data-icon='play'] { display: block; }
  #shopify-section-{{ sid }} .mq[data-pause-button='false'] .mq__pause { display: none; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .mq__track { animation: none !important; transform: none !important; width: auto; justify-content: center; }
    #shopify-section-{{ sid }} .mq__group { flex-wrap: wrap; justify-content: center; flex: 1 1 auto; padding-inline: var(--mq-gap); row-gap: var(--mq-gap); }
    #shopify-section-{{ sid }} .mq__group[aria-hidden='true'] { display: none; }
    #shopify-section-{{ sid }} .mq__pause { display: none; }
  }
{% comment %}{% endcomment %}</style>

<section id="m-section--{{ sid }}" class="mq m-section m-scrolling-image-section color-{{ color_scheme }} gradient" data-mgb="images-carousel" data-mgb-section="{{ sid }}" data-mgb-reset="{{ st.reset_spacing }}" data-mgb-anim="{{ settings.scroll_animation | default: 'none' }}" data-width="{{ st.section_width | default: 'full_width' }}" data-pause-hover="{{ st.pause_on_hover }}" data-pause-button="{{ st.show_pause_button }}" data-static1="{% if st.speed > 0 %}false{% else %}true{% endif %}" data-static2="{% if st.speed_second_scrolling > 0 %}false{% else %}true{% endif %}" data-mgb-placeholder-src="{{ placeholder }}" data-mgb-settings="{{ st | json | escape }}" data-mgb-defaults="{&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;full_width&quot;,&quot;reset_spacing&quot;:true,&quot;make_images_square&quot;:false,&quot;image_width&quot;:170,&quot;image_height&quot;:110,&quot;image_fit&quot;:&quot;cover&quot;,&quot;image_border_radius&quot;:10,&quot;slider_scale&quot;:1,&quot;direction&quot;:&quot;right&quot;,&quot;speed&quot;:176,&quot;pause_on_hover&quot;:true,&quot;show_pause_button&quot;:true,&quot;enable_second_scrolling&quot;:false,&quot;second_direction&quot;:&quot;left&quot;,&quot;speed_second_scrolling&quot;:47,&quot;scroll_gap&quot;:20,&quot;enable_custom_style&quot;:false,&quot;enable_custom_font&quot;:false,&quot;reveal&quot;:true,&quot;item_gap&quot;:20,&quot;padding_top&quot;:30,&quot;padding_bottom&quot;:30,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;overall_size_mobile&quot;:0.9,&quot;speed_mobile&quot;:26,&quot;item_gap_mobile&quot;:16,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0}" data-mgb-block-defaults="{&quot;image_block&quot;:{}}" aria-label="Logos">
  <div class="mq__inner">
    {%- for row in (1..rows) -%}
      {%- liquid
        if row == 1
          assign count = first_count
          assign offset = 0
          assign dir = st.direction | default: 'left'
        else
          assign count = second_count
          assign offset = first_count
          assign dir = st.second_direction | default: 'left'
        endif
        assign group_d = unit_d | times: count
        assign group_m = unit_m | times: count
        assign k_d = 2560.0 | divided_by: group_d | ceil | plus: 1
        assign k_m = 768.0 | divided_by: group_m | ceil | plus: 1
        assign copies = k_d
        if k_m > copies
          assign copies = k_m
        endif
        assign copies = copies | at_least: 2 | at_most: 30
      -%}
      <div class="mq__row m-scrolling-image" data-mq-row="{{ row }}" data-dir="{{ dir }}">
        <div class="mq__track" style="--mq-k: {{ copies }};">
          {%- for copy in (1..copies) -%}
            <div class="mq__group"{% if copy > 1 %} aria-hidden="true" data-mq-clone{% else %} role="list"{% endif %}>
              {%- for block in section.blocks offset: offset limit: count -%}
                {%- assign b = block.settings -%}
                <div class="mq__item" data-mgb-block="{{ block.id }}" data-mgb-type="{{ block.type }}"{% if copy == 1 %} role="listitem" data-mgb-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}{% endif %}>
                  {%- if b.image != blank -%}
                    <img src="{{ b.image | image_url: width: 800 }}" width="{{ w_base }}" height="{{ h_base }}" alt="{% if copy == 1 %}{{ b.image_alt | default: b.image.alt | escape }}{% endif %}" loading="lazy" decoding="async" draggable="false">
                  {%- else -%}
                    <img src="{{ placeholder }}" data-mgb-placeholder width="{{ w_base }}" height="{{ h_base }}" alt="" loading="lazy" decoding="async" draggable="false">
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
  <button class="mq__pause" type="button" data-mq-pause aria-pressed="false" aria-label="Pause scrolling">
    <svg data-icon="pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="3" y="2" width="3.5" height="12" rx="1"/><rect x="9.5" y="2" width="3.5" height="12" rx="1"/></svg>
    <svg data-icon="play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 2.5v11a.8.8 0 0 0 1.2.7l9-5.5a.8.8 0 0 0 0-1.4l-9-5.5A.8.8 0 0 0 4 2.5z"/></svg>
  </button>
</section>
</template>

<schema>
{
  "type": "images-carousel",
  "name": "Gallery Scrolling Logos",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Images"
    },
    {
      "type": "checkbox",
      "id": "make_images_square",
      "label": "Square images",
      "default": false,
      "info": "200 by 200 pixels, before scale."
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "default": 170,
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "visible_if": "{{ section.settings.make_images_square == false }}"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "default": 110,
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "visible_if": "{{ section.settings.make_images_square == false }}"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Fit"
        }
      ],
      "info": "Fit shows the whole logo."
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slider_scale",
      "label": "Image scale (desktop)",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.1
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Scrolling"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Loop time (desktop)",
      "min": 0,
      "max": 200,
      "unit": "s",
      "step": 2,
      "default": 176,
      "info": "Seconds for one full loop. Higher is slower; 0 stops the row."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pause_button",
      "label": "Show pause button",
      "default": true,
      "info": "Lets visitors stop the movement."
    },
    {
      "type": "checkbox",
      "id": "enable_second_scrolling",
      "label": "Second row",
      "default": false,
      "info": "Splits the images into two rows."
    },
    {
      "type": "select",
      "id": "second_direction",
      "label": "Second row direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.enable_second_scrolling }}"
    },
    {
      "type": "range",
      "id": "speed_second_scrolling",
      "label": "Second row loop time",
      "min": 1,
      "max": 100,
      "unit": "s",
      "step": 1,
      "default": 47,
      "visible_if": "{{ section.settings.enable_second_scrolling }}"
    },
    {
      "type": "range",
      "id": "scroll_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.enable_second_scrolling }}"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Override theme font (legacy)",
      "default": false,
      "hidden": true,
      "info": "Kept for saved sections. This section shows no text."
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Google font family (legacy)",
      "hidden": true,
      "info": "Kept for saved sections. This section shows no text."
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses the theme animation from Theme settings."
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between images (desktop)",
      "default": 20,
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "overall_size_mobile",
      "label": "Image scale (mobile)",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "default": 0.9
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "label": "Loop time (mobile)",
      "min": 0,
      "max": 200,
      "unit": "s",
      "step": 2,
      "default": 26,
      "info": "Seconds for one full loop of the first row."
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "label": "Gap between images (mobile)",
      "default": 16,
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "For example the brand name. Leave empty to use the alt text saved with the image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Scrolling Logos",
      "category": "Image and video",
      "blocks": [
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        }
      ]
    }
  ],
  "shopify": {
    "name": "Gallery Scrolling Logos",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section spacing",
        "default": true
      },
      {
        "type": "header",
        "content": "Images"
      },
      {
        "type": "checkbox",
        "id": "make_images_square",
        "label": "Square images",
        "default": false,
        "info": "200 by 200 pixels, before scale."
      },
      {
        "type": "range",
        "id": "image_width",
        "label": "Image width",
        "default": 170,
        "min": 100,
        "max": 800,
        "step": 10,
        "unit": "px",
        "visible_if": "{{ section.settings.make_images_square == false }}"
      },
      {
        "type": "range",
        "id": "image_height",
        "label": "Image height",
        "default": 110,
        "min": 100,
        "max": 800,
        "step": 10,
        "unit": "px",
        "visible_if": "{{ section.settings.make_images_square == false }}"
      },
      {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Fill"
          },
          {
            "value": "contain",
            "label": "Fit"
          }
        ],
        "info": "Fit shows the whole logo."
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "label": "Image corner radius",
        "default": 10,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "slider_scale",
        "label": "Image scale (desktop)",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.1
      },
      {
        "type": "header",
        "content": "Scrolling"
      },
      {
        "type": "select",
        "id": "direction",
        "label": "Direction",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "right"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Loop time (desktop)",
        "min": 0,
        "max": 200,
        "unit": "s",
        "step": 2,
        "default": 176,
        "info": "Seconds for one full loop. Higher is slower; 0 stops the row."
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_pause_button",
        "label": "Show pause button",
        "default": true,
        "info": "Lets visitors stop the movement."
      },
      {
        "type": "checkbox",
        "id": "enable_second_scrolling",
        "label": "Second row",
        "default": false,
        "info": "Splits the images into two rows."
      },
      {
        "type": "select",
        "id": "second_direction",
        "label": "Second row direction",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "visible_if": "{{ section.settings.enable_second_scrolling }}"
      },
      {
        "type": "range",
        "id": "speed_second_scrolling",
        "label": "Second row loop time",
        "min": 1,
        "max": 100,
        "unit": "s",
        "step": 1,
        "default": 47,
        "visible_if": "{{ section.settings.enable_second_scrolling }}"
      },
      {
        "type": "range",
        "id": "scroll_gap",
        "label": "Gap between rows",
        "min": 0,
        "max": 100,
        "step": 10,
        "unit": "px",
        "default": 20,
        "visible_if": "{{ section.settings.enable_second_scrolling }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_font",
        "label": "Override theme font (legacy)",
        "default": false,
        "hidden": true,
        "info": "Kept for saved sections. This section shows no text."
      },
      {
        "type": "text",
        "id": "font_family",
        "label": "Google font family (legacy)",
        "hidden": true,
        "info": "Kept for saved sections. This section shows no text."
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses the theme animation from Theme settings."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "item_gap",
        "label": "Gap between images (desktop)",
        "default": 20,
        "min": 0,
        "max": 180,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 30,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 30,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "overall_size_mobile",
        "label": "Image scale (mobile)",
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "default": 0.9
      },
      {
        "type": "range",
        "id": "speed_mobile",
        "label": "Loop time (mobile)",
        "min": 0,
        "max": 200,
        "unit": "s",
        "step": 2,
        "default": 26,
        "info": "Seconds for one full loop of the first row."
      },
      {
        "type": "range",
        "id": "item_gap_mobile",
        "label": "Gap between images (mobile)",
        "default": 16,
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "image_block",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "image_alt",
            "label": "Image alt text",
            "info": "For example the brand name. Leave empty to use the alt text saved with the image."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Gallery Scrolling Logos",
        "category": "Image and video",
        "blocks": [
