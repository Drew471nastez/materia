<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}


{% liquid
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'section m-section m-scrolling-image-section'

  if section.settings.padding_top < 30
    assign classes = classes | append: ' pt-min'
  endif
  if section.settings.padding_bottom < 30
    assign classes = classes | append: ' pb-min'
  endif

  if section.settings.make_images_square
    assign classes = classes | append: ' make-images-square'
  endif
%}

{%- comment -%} An @import only works first in its stylesheet, so the font gets a style of its own. {%- endcomment -%}
{% if section.settings.enable_custom_font and section.settings.font_family != blank %}
  {% assign first_font = section.settings.font_family | split: ',' | first | strip | remove: "'" | remove: '"' | replace: ' ', '+' %}
<style>
  @import url('https://fonts.googleapis.com/css2?family={{ first_font }}&display=swap');
{% comment %}{% endcomment %}</style>
{% endif %}
<style>

  /* Scoped CSS: All styles are prefixed with the unique section ID */
  #m-section--{{ section.id }} {
    /* CSS Variables */
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --item-gap: {{ section.settings.item_gap }}px;
    --item-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --duration: {{ section.settings.speed }}s;
    --duration_second: {{ section.settings.speed_second_scrolling }}s; /* Added for second scrolling */
    --slider-scale: {{ section.settings.slider_scale }};
    --image-border-radius: {{ section.settings.image_border_radius }}px !important;
    --slider-scale-mobile: {{ section.settings.overall_size_mobile }};
    --duration-mobile: {{ section.settings.speed_mobile }}s;
    --duration-second-mobile: {{ section.settings.speed_second_scrolling_mobile | default: section.settings.speed_second_scrolling }}s; /* Added for second scrolling mobile */
    --scroll-gap: {{ section.settings.scroll_gap }}px; /* New CSS variable for gap between scrollings */

    /* Font Family Handling */
    {% if section.settings.enable_custom_font and section.settings.font_family != blank %}
      --font-family: "{{ section.settings.font_family }}";
      font-family: var(--font-family);
    {% endif %}

    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    width: 100%; /* Ensure full width */
    box-sizing: border-box;
    text-align: center; /* Center content by default */
    position: relative; /* Needed for fading panels */
  }

  /* Container for the scrolling image section */
  #m-section--{{ section.id }} .m-scrolling-image {
    display: flex; /* Aligns items horizontally */
    border-radius: var(--image-border-radius, 10px) !important; /* Default is 10px */
    align-items: center; /* Vertically centers the items */
    overflow: hidden; /* Hides content that overflows the container */
    position: relative; /* Ensure fading panels are positioned correctly */
    transform: scale(var(--slider-scale));
  }

  /* Apply margin between scrolling images if second scrolling is enabled */
  #m-section--{{ section.id }} .m-scrolling-image + .m-scrolling-image {
    margin-top: var(--scroll-gap);
    border-radius: var(--image-border-radius, 10px) !important; /* Default is 10px */
  }

  /* Removed Headline Title and Subheading Styles */

  /* Responsive Adjustments for Headline and Subheading Sizes */
  /* Removed related media queries */

  /* Applies scrolling animation to the image items based on scroll direction */
  #m-section--{{ section.id }} .m-scrolling-image--left .m-image--animated {
    animation-name: scrolling-left-{{ section.id }}; /* Uses the unique keyframe animation */
    animation-duration: var(--duration); /* Desktop speed */
  }

  #m-section--{{ section.id }} .m-scrolling-image--right .m-image--animated {
    animation-name: scrolling-right-{{ section.id }}; /* Uses the unique keyframe animation */
    animation-duration: var(--duration); /* Desktop speed */
  }

  /* Second Scrolling Image Animation */
  #m-section--{{ section.id }} .m-scrolling-image-second--left .m-image--animated {
    animation-name: scrolling-left-{{ section.id }}; /* Uses the unique keyframe animation */
    animation-duration: var(--duration_second); /* Desktop speed for second scrolling */
  }

  #m-section--{{ section.id }} .m-scrolling-image-second--right .m-image--animated {
    animation-name: scrolling-right-{{ section.id }}; /* Uses the unique keyframe animation */
    animation-duration: var(--duration_second); /* Desktop speed for second scrolling */
  }

  /* Controls animation play state based on hover and paused state */
  #m-section--{{ section.id }} .m-scrolling-image--pause-on-hover:hover .m-image--animated {
    animation-play-state: paused; /* Pauses animation on hover if enabled */
  }

  #m-section--{{ section.id }} .m-scrolling-image--paused .m-image--animated {
    animation-play-state: paused; /* Pauses animation when manually paused */
  }

  /* Keeps animation running continuously when not paused */
  #m-section--{{ section.id }} .m-scrolling-image .m-image--animated {
    animation-play-state: running;
  }

  /* Removes padding for the full container inside the scrolling image section */
  #m-section--{{ section.id }} .container-full {
    padding-left: 0;
    padding-right: 0;
  }

  /* Image container styles */
  #m-section--{{ section.id }} .m-image-container {
    display: flex;
    border-radius: var(--image-border-radius, 10px) !important; /* Default is 10px */
    gap: var(--item-gap, 50px); /* Desktop gap */
  }

  /* Styles for individual image items */
  #m-section--{{ section.id }} .m-image__item {
    width: {{ section.settings.image_width | default: 340 }}px;
    height: {{ section.settings.image_height | default: 250 }}px;
    display: flex; /* Aligns items horizontally */
    box-sizing: border-box;
    padding: 20px;
    border-radius: var(--image-border-radius, 10px) !important;
    margin: 0 calc(var(--item-gap) / 2); /* Adds consistent spacing */
  }

  /* Image styling */
  #m-section--{{ section.id }} .m-image__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--image-border-radius, 10px) !important;
    transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease-in-out); /* Smooth transition for zoom effect */
    margin: 0px calc(var(--item-gap) / 2); /* Adds consistent spacing */
  }

  /* Media query: Adjusts styles for mobile devices */
  @media screen and (max-width: 749px) {
    #m-section--{{ section.id }} .m-image-container {
      gap: var(--item-gap-mobile, 20px); /* Mobile item gap */
    }

    #m-section--{{ section.id }} .m-image__item {
      width: calc({{ section.settings.image_width }}px * var(--slider-scale-mobile));
      height: calc({{ section.settings.image_height }}px * var(--slider-scale-mobile));
      margin: 0 calc(var(--item-gap-mobile) / 2); /* Adjusts margin based on mobile gap */
    }

    /* Adjust image size based on the slider */
    #m-section--{{ section.id }} .m-image__item img {
      transform: scale(var(--image_scale_mobile, 1)); /* Applies mobile scaling */
    }

    /* Animation duration for mobile */
    #m-section--{{ section.id }} .m-image--animated {
      animation-duration: var(--duration-mobile) !important;
    }

    /* Second Scrolling Image Animation for Mobile */
    #m-section--{{ section.id }} .m-scrolling-image-second--left .m-image--animated,
    #m-section--{{ section.id }} .m-scrolling-image-second--right .m-image--animated {
      animation-duration: var(--duration-second-mobile) !important;
    }

    /* If Make Images Square is enabled, override mobile image sizes */
    #m-section--{{ section.id }}.make-images-square .m-image__item {
      width: calc(200px * var(--slider-scale-mobile));
      height: calc(200px * var(--slider-scale-mobile));
    }
  }

  /* Animation properties for animated image items */
  #m-section--{{ section.id }} .m-image--animated {
    animation-iteration-count: infinite; /* Animation repeats indefinitely */
    animation-timing-function: linear; /* Creates a smooth animation */
    animation-duration: var(--duration); /* Sets animation duration */
    animation-play-state: running; /* Keeps animation running */
    width: max-content; /* Adjusts width based on content */
    will-change: transform, width; /* Optimizes animation performance */
    display: flex;
    gap: var(--item-gap, 50px); /* Ensures gap consistency */
  }

  /* Keyframe animation for scrolling left */
  @keyframes scrolling-left-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0); /* Starts at original position */
      visibility: visible; /* Ensures visibility */
    }
    100% {
      transform: translate3d(-100%, 0, 0); /* Moves the content left by 100% */
    }
  }

  /* Keyframe animation for scrolling right */
  @keyframes scrolling-right-{{ section.id }} {
    0% {
      transform: translate3d(-100%, 0, 0); /* Starts off-screen to the left */
      visibility: visible; /* Ensures visibility */
    }
    100% {
      transform: translate3d(0, 0, 0); /* Moves the content right to its original position */
    }
  }

  /* Image Format Styles */
  /* Original - No restrictions, no specific styles */
  #m-section--{{ section.id }} .image-format-original {
    /* No changes */
  }

  /* 200x300 */
  #m-section--{{ section.id }} .image-format-200x300 {
    width: 200px;
    height: 300px;
  }

  /* Square (1:1 Ratio) */
  #m-section--{{ section.id }} .image-format-square {
    aspect-ratio: 1 / 1;
  }

  /* Circle */
  #m-section--{{ section.id }} .image-format-circle {
    border-radius: 50%;
  }

  /* Full-Width */
  #m-section--{{ section.id }} .image-format-full-width {
    width: 100%;
    height: auto;
  }

  /* Contain */
  #m-section--{{ section.id }} .image-format-contain {
    object-fit: contain;
  }

  /* Cover */
  #m-section--{{ section.id }} .image-format-cover {
    object-fit: cover;
  }

  /* Landscape (16:9) */
  #m-section--{{ section.id }} .image-format-landscape {
    aspect-ratio: 16 / 9;
  }

  /* Portrait (4:5) */
  #m-section--{{ section.id }} .image-format-portrait {
    aspect-ratio: 4 / 5;
  }

  /* Thumbnail (150x150) */
  #m-section--{{ section.id }} .image-format-thumbnail {
    width: 150px;
    height: 150px;
  }

  /* Wide (4:3 Ratio) */
  #m-section--{{ section.id }} .image-format-wide {
    aspect-ratio: 4 / 3;
  }

  /* Tall (3:4 Ratio) */
  #m-section--{{ section.id }} .image-format-tall {
    aspect-ratio: 3 / 4;
  }

  /* Hexagon */
  #m-section--{{ section.id }} .image-format-hexagon {
    clip-path: polygon(
      25% 5%,
      75% 5%,
      100% 50%,
      75% 95%,
      25% 95%,
      0% 50%
    );
  }

  /* Rounded Corners */
  #m-section--{{ section.id }} .image-format-rounded-corners {
    border-radius: 15px;
  }

  /* Hover Flip */
  #m-section--{{ section.id }} .image-format-hover-flip {
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  #m-section--{{ section.id }} .image-format-hover-flip:hover {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #m-section--{{ section.id }} .m-image--animated { animation-play-state: paused !important; }
    #m-section--{{ section.id }} .image-format-hover-flip { transition: none; }
  }

  /* Make Images Square Styles */
  #m-section--{{ section.id }}.make-images-square .m-image__item {
    width: 200px;
    height: 200px;
  }

  #m-section--{{ section.id }}.make-images-square .m-image__item img {
    width: 100%;
    border-radius: var(--image-border-radius, 10px); /* Default is 10px */
    height: 100%;
    object-fit: cover;
  }

  #m-section--{{ section.id }}.make-images-square .m-image__item {
    width: calc(200px * var(--slider-scale));
    height: calc(200px * var(--slider-scale));
    border-radius: var(--image-border-radius, 10px); /* Default is 10px */
  }

  @media screen and (max-width: 749px) {
    #m-section--{{ section.id }}.make-images-square .m-image__item {
      width: calc(200px * var(--slider-scale-mobile));
      height: calc(200px * var(--slider-scale-mobile));
      border-radius: var(--image-border-radius, 10px); /* Default is 10px */
    }
  }
{% comment %}{% endcomment %}</style>

<section
  id="m-section--{{ section.id }}"
  class="{{ classes }} color-{{ color_scheme }} gradient"
  data-section-type="scrolling-image"
  data-section-id="{{ section.id }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
>
  <div class="{{ container }} m-section-py">
    <!-- Headline Title Removed -->
    <!-- Subheading Removed -->

    <!-- First Scrolling Image -->
    <m-scrolling-image
      class="m-scrolling-image m-scrolling-image--{{ section.settings.direction }}{% if section.settings.pause_on_hover %} m-scrolling-image--pause-on-hover{% endif %}"
      data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    >
      <div class="m-image-container">
        {% assign first_limit = section.settings.enable_second_scrolling %}
        {% if section.settings.enable_second_scrolling %}
          {% assign first_limit = 5 %}
        {% else %}
          {% assign first_limit = section.blocks.size %}
        {% endif %}

        {% for block in section.blocks limit: first_limit %}
          {%- case block.type -%}
            {%- when 'image_block' -%}
              <div class="m-image__item">
                {% if block.settings.image %}
                  <img
                    class="image-format-{{ section.settings.image_format | handleize }}"
                    src="{{ block.settings.image | img_url: '800x600' }}"
                    alt="{{ 'accessibility.scrolling_image' | t }}"
                  >
                {% else %}
                  <img
                    class="image-format-{{ section.settings.image_format | handleize }}"
                    src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
                    alt="{{ 'accessibility.placeholder_image' | t }}"
                  >
                {% endif %}
              </div>
          {%- endcase -%}
        {% endfor %}
      </div>
    </m-scrolling-image>

    <!-- Second Scrolling Image (if enabled) -->
    {% if section.settings.enable_second_scrolling %}
      <m-scrolling-image
        class="m-scrolling-image m-scrolling-image--{{ section.settings.second_direction }} m-scrolling-image-second m-scrolling-image-second--{{ section.settings.second_direction }}{% if section.settings.pause_on_hover %} m-scrolling-image--pause-on-hover{% endif %}"
        data-pause-on-hover="{{ section.settings.pause_on_hover }}"
      >
        <div class="m-image-container">
          {% assign second_limit = 5 %}
          {% assign second_offset = 5 %}
          {% for block in section.blocks offset: second_offset limit: second_limit %}
            {%- case block.type -%}
              {%- when 'image_block' -%}
                <div class="m-image__item">
                  {% if block.settings.image %}
                    <img
                      class="image-format-{{ section.settings.image_format | handleize }}"
                      src="{{ block.settings.image | img_url: '800x600' }}"
                      alt="{{ 'accessibility.scrolling_image' | t }}"
                    >
                  {% else %}
                    <img
                      class="image-format-{{ section.settings.image_format | handleize }}"
                      src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
                      alt="{{ 'accessibility.placeholder_image' | t }}"
                    >
                  {% endif %}
                </div>
            {%- endcase -%}
          {% endfor %}
        </div>
      </m-scrolling-image>
    {% endif %}

    <!-- Fading Panels Removed -->
  </div>
</section>

<script>
  // Scoped JavaScript: Ensures scripts target only elements within this section
  (function() {
    const sectionId = "{{ section.id }}";
    const section = document.getElementById("m-section--" + sectionId);

    if (!section) return;

    // Check if the custom element "m-scrolling-image" is already defined
    if (!customElements.get("m-scrolling-image")) {

      /**
       * Class definition for the custom HTML element <m-scrolling-image>.
       */
      class MScrollingImage extends HTMLElement {

        // Constructor for the MScrollingImage class
        constructor() {
          super();
        }

        /**
         * Called when the element is connected to the DOM.
         * Initializes the image element and its functionality.
         */
        connectedCallback() {
          if (this.dataset.ready === '1') return;
          this.dataset.ready = '1';
          this.imageContainer = this.querySelector(".m-image-container");
          this.pauseOnHover = this.getAttribute('data-pause-on-hover') === 'true';
          this.init();
        }

        /**
         * Initializes the image element.
         * If there is only one child element, it adds multiple clones
         * to create a continuous scrolling effect.
         */
        init() {
          if (this.imageContainer && this.imageContainer.children.length > 0) {
            // Add a class to start animation on the image container
            this.imageContainer.classList.add("m-image--animated");

            // Create multiple clones of the image container for smooth scrolling
            this.createClones();

            // Setup pause on hover functionality if enabled
            if (this.pauseOnHover) {
              this.setupPauseOnHover();
            }

            // Start scrolling the image container
            this.scrollingPlay();
          }
        }

        /**
         * Creates multiple clones of the image container to ensure continuous scrolling.
         */
        createClones() {
          const cloneCount = 10; // Adjust the number of clones as needed
          for (let index = 0; index < cloneCount; index++) {
            // Clone the image container
            const clone = this.imageContainer.cloneNode(true);

            // Mark the clone as hidden for accessibility purposes
            clone.setAttribute("aria-hidden", true);

            // Append the clone to the image container
            this.appendChild(clone);
          }
        }

        /**
         * Keeps the scrolling functionality always active by removing any paused state.
         */
        scrollingPlay() {
          this.classList.remove("m-scrolling-image--paused");
        }

        /**
         * A placeholder function for pausing scrolling.
         * It is intentionally left empty to prevent pausing.
         */
        scrollingPause() {
          // This function is intentionally empty
        }

        /**
         * Sets up event listeners to pause and resume scrolling on hover.
         */
        setupPauseOnHover() {
          this.addEventListener('mouseenter', () => {
            this.classList.add('m-scrolling-image--paused');
          });

          this.addEventListener('mouseleave', () => {
            this.classList.remove('m-scrolling-image--paused');
          });
        }
      }

      // Define the custom HTML element <m-scrolling-image> with the MScrollingImage class
      if (!customElements.get("m-scrolling-image")) customElements.define("m-scrolling-image", MScrollingImage);
    }
  })();
{% comment %}{% endcomment %}</script>



