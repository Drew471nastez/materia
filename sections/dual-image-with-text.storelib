<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_accent_image = 'accessibility.accent_image' | t -%}
{%- assign fb_accessibility_main_image_label = 'accessibility.main_image_label' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image & Text Dual.

  Two overlapping images on one side (Main image and Accent image blocks,
  each with its own corner, size, rotation and focal point) and eyebrow,
  heading, text and button blocks on the other. Colours follow the colour
  scheme and fonts follow Theme settings > Typography until custom styling
  or custom fonts are switched on. Layout lives in
  snippets/media-benefits-style; the builder's live edits in
  assets/media-live-benefits.js.
{%- endcomment -%}
{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign own = st.enable_custom_style
  assign main_block = nil
  assign accent_block = nil
  for blk in section.blocks
    if blk.type == 'main_image' and main_block == nil
      assign main_block = blk
    elsif blk.type == 'accent_image' and accent_block == nil
      assign accent_block = blk
    endif
  endfor
  assign accent_front = false
  if accent_block and accent_block.settings.above_main
    assign accent_front = true
  endif
  assign dot_size = st.dot_size | default: 60
  assign dot_size_b = dot_size | times: 0.6 | round
-%}
{%- capture dot_a -%}{% if own %}{% render 'scheme-color', color: st.dot_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}{%- endcapture -%}
{% render 'media-benefits-style', section: section, bp: 900 %}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .itd__stage { position: relative; width: 100%; aspect-ratio: var(--m-ar); isolation: isolate; }
  #shopify-section-{{ sid }} .itd__img { position: absolute; width: var(--b-size); height: var(--b-size); border-radius: var(--b-r); overflow: hidden; background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); color: var(--color-text); transform: rotate(var(--b-rot)); }
  #shopify-section-{{ sid }} .itd__img > img, #shopify-section-{{ sid }} .itd__img > svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .itd__img > svg.mlb__ph { opacity: .35; padding: 18%; }
  #shopify-section-{{ sid }} .itd__img > img { object-fit: var(--b-fit); object-position: var(--b-px) var(--b-py); }
  #shopify-section-{{ sid }} .itd__img[data-shadow='true'] { box-shadow: 0 24px 60px -20px rgb(0 0 0 / .25); }
  #shopify-section-{{ sid }} .itd__main { top: 0; left: 0; z-index: 2; }
  #shopify-section-{{ sid }} .itd__main[data-anchor='top_right'] { left: auto; right: 0; }
  #shopify-section-{{ sid }} .itd__main[data-anchor='bottom_left'] { top: auto; bottom: 0; }
  #shopify-section-{{ sid }} .itd__main[data-anchor='bottom_right'] { top: auto; left: auto; bottom: 0; right: 0; }
  #shopify-section-{{ sid }} .itd__accent { z-index: 1; bottom: var(--b-oy); right: var(--b-ox); transform: rotate(var(--b-rot)) scale(calc(var(--b-scale) / 100)); border: var(--b-bw) solid var(--b-bc); box-sizing: content-box; }
  #shopify-section-{{ sid }} .itd[data-accent-front='true'] .itd__main { z-index: 1; }
  #shopify-section-{{ sid }} .itd[data-accent-front='true'] .itd__accent { z-index: 2; }
  #shopify-section-{{ sid }} .itd__accent[data-anchor='top_left'] { bottom: auto; right: auto; top: var(--b-oy); left: var(--b-ox); }
  #shopify-section-{{ sid }} .itd__accent[data-anchor='top_right'] { bottom: auto; top: var(--b-oy); }
  #shopify-section-{{ sid }} .itd__accent[data-anchor='bottom_left'] { right: auto; left: var(--b-ox); }
  #shopify-section-{{ sid }} .itd__accent[data-anchor='center'] { bottom: auto; right: auto; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(var(--b-rot)) scale(calc(var(--b-scale) / 100)); }
  #shopify-section-{{ sid }} .itd__accent[data-shadow='true'] { box-shadow: 0 18px 44px -16px rgb(0 0 0 / .3); }
  @media (max-width: 899px) {
    #shopify-section-{{ sid }} .itd__accent { width: var(--b-size-m); height: var(--b-size-m); }
    #shopify-section-{{ sid }} .itd__accent[data-hide-m='true'] { display: none; }
  }
  #shopify-section-{{ sid }} .itd__dot { position: absolute; border-radius: 50%; pointer-events: none; z-index: 0; opacity: calc(var(--itd-do) / 100); display: none; }
  #shopify-section-{{ sid }} .itd[data-dots='true'] .itd__dot { display: block; }
  #shopify-section-{{ sid }} .itd[data-dots-front='true'] .itd__dot { z-index: 3; }
  #shopify-section-{{ sid }} .itd__dot--a { width: var(--itd-ds); height: var(--itd-ds); background: var(--itd-dca); top: var(--itd-ay); left: var(--itd-ax); }
  #shopify-section-{{ sid }} .itd__dot--b { width: var(--itd-ds-b); height: var(--itd-ds-b); background: var(--itd-dcb); top: var(--itd-by); left: var(--itd-bx); }
{% comment %}{% endcomment %}</style>

<div id="itd-{{ sid }}" class="itd mlb section sec__image-text-dual color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-mlb-root="dual-image-with-text" {% render 'media-benefits-root', section: section, part: 'attrs', side: st.image_position, align: st.content_align, align_m: st.content_align_mobile %} data-dots="{% if st.show_dots %}true{% else %}false{% endif %}" data-dots-front="{% if st.dots_behind_main %}false{% else %}true{% endif %}" data-accent-front="{{ accent_front }}" data-mlb-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;container&quot;,&quot;reset_spacing&quot;:true,&quot;image_position&quot;:&quot;left&quot;,&quot;text_column_width&quot;:45,&quot;content_align&quot;:&quot;left&quot;,&quot;content_gap&quot;:16,&quot;aspect_ratio_w&quot;:4,&quot;aspect_ratio_h&quot;:4,&quot;show_dots&quot;:false,&quot;dots_behind_main&quot;:true,&quot;dot_size&quot;:60,&quot;dot_opacity&quot;:60,&quot;dot_a_x&quot;:28,&quot;dot_a_y&quot;:30,&quot;dot_b_x&quot;:60,&quot;dot_b_y&quot;:70,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;gap_desktop&quot;:84,&quot;padding_top_desktop&quot;:100,&quot;padding_bottom_desktop&quot;:100,&quot;side_padding_desktop&quot;:32,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;content_align_mobile&quot;:&quot;left&quot;,&quot;mobile_order&quot;:&quot;media_first&quot;,&quot;gap_mobile&quot;:32,&quot;padding_top_mobile&quot;:60,&quot;padding_bottom_mobile&quot;:60,&quot;side_padding_mobile&quot;:16,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0&#125;" data-mlb-block-defaults="&#123;&quot;main_image&quot;:&#123;&quot;anchor&quot;:&quot;top_left&quot;,&quot;size&quot;:65,&quot;rotation&quot;:0,&quot;fit&quot;:&quot;cover&quot;,&quot;position_x&quot;:50,&quot;position_y&quot;:50,&quot;radius&quot;:12,&quot;shadow&quot;:false&#125;,&quot;accent_image&quot;:&#123;&quot;anchor&quot;:&quot;bottom_right&quot;,&quot;size&quot;:65,&quot;offset_x&quot;:0,&quot;offset_y&quot;:0,&quot;rotation&quot;:0,&quot;scale&quot;:100,&quot;above_main&quot;:true,&quot;fit&quot;:&quot;cover&quot;,&quot;position_x&quot;:50,&quot;position_y&quot;:50,&quot;radius&quot;:12,&quot;shadow&quot;:true,&quot;border_width&quot;:0,&quot;enable_custom_style&quot;:false,&quot;size_mobile&quot;:60,&quot;hide_on_mobile&quot;:false&#125;,&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;New collection&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:12&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Two images, one story&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:44,&quot;size_mobile&quot;:32&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Pair large text with an image to tell a story, explain a detail about your product, or describe a new promotion.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:17,&quot;size_mobile&quot;:15&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;Shop now&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;&#125;" style="{% render 'media-benefits-root', section: section, part: 'vars', tw: st.text_column_width, gap_d: st.gap_desktop, gap_m: st.gap_mobile %}--m-ar: {{ st.aspect_ratio_w | default: 4 }} / {{ st.aspect_ratio_h | default: 4 }};--itd-ds: {{ dot_size }}px;--itd-ds-b: {{ dot_size_b }}px;--itd-do: {{ st.dot_opacity | default: 60 }};--itd-ax: {{ st.dot_a_x | default: 0 }}%;--itd-ay: {{ st.dot_a_y | default: 0 }}%;--itd-bx: {{ st.dot_b_x | default: 0 }}%;--itd-by: {{ st.dot_b_y | default: 0 }}%;--itd-dca: {{ dot_a }};--itd-dcb: {% if own %}{% render 'scheme-color', color: st.dot_color_b, fallback: dot_a %}{% else %}{{ dot_a }}{% endif %};">
  <div class="itd__inner mlb__inner">
    <div class="itd__grid mlb__grid">

      <div class="itd__media mlb__media">
        <div class="itd__stage">
          <span class="itd__dot itd__dot--a" aria-hidden="true"></span>
          <span class="itd__dot itd__dot--b" aria-hidden="true"></span>
          {%- for blk in section.blocks -%}
            {%- assign draw = false -%}
            {%- if blk.type == 'main_image' and blk.id == main_block.id -%}{%- assign draw = true -%}{%- endif -%}
            {%- if blk.type == 'accent_image' and blk.id == accent_block.id -%}{%- assign draw = true -%}{%- endif -%}
            {%- if draw -%}
              {%- assign ib = blk.settings -%}
              {%- assign accent = false -%}
              {%- if blk.type == 'accent_image' -%}{%- assign accent = true -%}{%- endif -%}
              <div class="itd__img {% if accent %}itd__accent{% else %}itd__main{% endif %}" data-mlb-media {% render 'media-benefits-block', block: blk %} data-anchor="{% if accent %}{{ ib.anchor | default: 'bottom_right' }}{% else %}{{ ib.anchor | default: 'top_left' }}{% endif %}" data-shadow="{% if ib.shadow %}true{% else %}false{% endif %}"{% if accent %} data-hide-m="{% if ib.hide_on_mobile %}true{% else %}false{% endif %}"{% endif %} style="--b-size: {{ ib.size | default: 65 }}%;--b-r: {{ ib.radius | default: 0 }}px;--b-rot: {{ ib.rotation | default: 0 }}deg;--b-px: {{ ib.position_x | default: 50 }}%;--b-py: {{ ib.position_y | default: 50 }}%;--b-fit: {{ ib.fit | default: 'cover' }};{% if accent %}--b-size-m: {{ ib.size_mobile | default: 60 }}%;--b-ox: {{ ib.offset_x | default: 0 }}%;--b-oy: {{ ib.offset_y | default: 0 }}%;--b-scale: {{ ib.scale | default: 100 }};--b-bw: {{ ib.border_width | default: 0 }}px;--b-bc: {% if ib.enable_custom_style %}{% render 'scheme-color', color: ib.border_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};{% endif %}">
                {%- if ib.image != blank -%}
                  <img
                    src="{{ ib.image | image_url: width: 1400 }}"
                    srcset="{{ ib.image | image_url: width: 600 }} 600w,
                            {{ ib.image | image_url: width: 900 }} 900w,
                            {{ ib.image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 900px) 40vw, 80vw"
                    alt="{{ ib.alt | default: ib.image.alt | escape }}"
                    width="{{ ib.image.width }}"
                    height="{{ ib.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <svg class="mlb__ph" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g fill="currentColor"><circle cx="172" cy="124" r="14"/><path d="M140 192l40-46 25 28 20-18 35 36z"/></g></svg>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="itd__text mlb__text">
        {%- for block in section.blocks -%}
          {%- unless block.type == 'main_image' or block.type == 'accent_image' -%}
            {%- render 'media-benefits-text', block: block, p: 'itd' -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "dual-image-with-text",
  "name": "Image & Text Dual",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Columns"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between content blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Stage (image area)"
    },
    {
      "type": "range",
      "id": "aspect_ratio_w",
      "label": "Stage aspect — width",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "aspect_ratio_h",
      "label": "Stage aspect — height",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Decorative dots"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show decorative dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots_behind_main",
      "label": "Dots behind images",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color (A)"
    },
    {
      "type": "color",
      "id": "dot_color_b",
      "label": "Dot color (B)"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 20,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "dot_opacity",
      "label": "Dot opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "dot_a_x",
      "label": "Dot A — X",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 28
    },
    {
      "type": "range",
      "id": "dot_a_y",
      "label": "Dot A — Y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "dot_b_x",
      "label": "Dot B — X",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "dot_b_y",
      "label": "Dot B — Y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Custom fonts (optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
