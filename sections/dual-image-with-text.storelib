<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_accent_image = 'accessibility.accent_image' | t -%}
{%- assign fb_accessibility_main_image_label = 'accessibility.main_image_label' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image & Text Dual

  Two overlapping images on one side, copy on the other. Every text
  AND image element is a block — fully reorderable. The accent image
  block has its own offset/scale/rotation/border controls so the same
  liquid produces dramatically different layouts.

  Block types:
    - main_image     (limit 1) — the back/large image
    - accent_image   (limit 1) — the overlay image with full positioning
    - eyebrow        (limit 2)
    - heading        (limit 2)
    - subheading     (limit 2)
    - button         (limit 3)

  All settings work because every CSS property reads its block's own
  settings via `block.settings` and every per-block style is scoped
  by `[data-block-id="{{ block.id }}"]`.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  assign main_block = null
  assign accent_block = null
  for blk in section.blocks
    if blk.type == 'main_image'
      assign main_block = blk
    elsif blk.type == 'accent_image'
      assign accent_block = blk
    endif
  endfor

  case st.image_position
    when 'right'
      assign _flex_dir_d = 'row-reverse'
    else
      assign _flex_dir_d = 'row'
  endcase
  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase
-%}

<style>
  /* Custom fonts (override theme defaults inside this section only) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }

  /* Section margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .itd__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .itd__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .itd__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  /* Outer wrap */
  #shopify-section-{{ sid }} .itd {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 16 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .itd {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .itd__inner { width: 100%; box-sizing: border-box; }

  /* Grid */
  #shopify-section-{{ sid }} .itd__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 32 }}px;
    align-items: center;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .itd__grid {
      flex-direction: {{ _flex_dir_d }};
      gap: {{ st.gap_desktop | default: 64 }}px;
      align-items: center;
    }
  }

  /* Columns */
  #shopify-section-{{ sid }} .itd__media,
  #shopify-section-{{ sid }} .itd__text {
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .itd__text { width: {{ st.text_column_width | default: 45 }}%; }
    #shopify-section-{{ sid }} .itd__media { width: calc(100% - {{ st.text_column_width | default: 45 }}%); }
  }

  /* Stage */
  #shopify-section-{{ sid }} .itd__stage {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.aspect_ratio_w | default: 5 }} / {{ st.aspect_ratio_h | default: 5 }};
    isolation: isolate;
  }

  /* Per-block IMAGE styles */
  {%- if main_block -%}
    {%- assign mb = main_block.settings -%}
    #shopify-section-{{ sid }} .itd__main[data-block-id="{{ main_block.id }}"] {
      position: absolute;
      width: {{ mb.size | default: 78 }}%;
      height: {{ mb.size | default: 78 }}%;
      {%- case mb.anchor -%}
        {%- when 'top_right' -%}top: 0; right: 0;
        {%- when 'bottom_left' -%}bottom: 0; left: 0;
        {%- when 'bottom_right' -%}bottom: 0; right: 0;
        {%- else -%}top: 0; left: 0;
      {%- endcase -%}
      border-radius: {{ mb.radius | default: 12 }}px;
      overflow: hidden;
      background: rgba(0,0,0,0.04);
      z-index: {% if accent_block and accent_block.settings.above_main %}1{% else %}2{% endif %};
      transform: rotate({{ mb.rotation | default: 0 }}deg);
      box-shadow: {%- if mb.shadow -%}0 24px 60px -20px rgba(0,0,0,0.25){%- else -%}none{%- endif -%};
    }
    #shopify-section-{{ sid }} .itd__main[data-block-id="{{ main_block.id }}"] img {
      width: 100%;
      height: 100%;
      object-fit: {{ mb.fit | default: 'cover' }};
      object-position: {{ mb.position_x | default: 50 }}% {{ mb.position_y | default: 50 }}%;
      display: block;
    }
  {%- endif -%}

  {%- if accent_block -%}
    {%- assign ab = accent_block.settings -%}
    #shopify-section-{{ sid }} .itd__accent[data-block-id="{{ accent_block.id }}"] {
      position: absolute;
      width: {{ ab.size | default: 55 }}%;
      height: {{ ab.size | default: 55 }}%;
      {%- case ab.anchor -%}
        {%- when 'top_left' -%}top: {{ ab.offset_y | default: 0 }}%; left: {{ ab.offset_x | default: 0 }}%;
        {%- when 'top_right' -%}top: {{ ab.offset_y | default: 0 }}%; right: {{ ab.offset_x | default: 0 }}%;
        {%- when 'bottom_left' -%}bottom: {{ ab.offset_y | default: 0 }}%; left: {{ ab.offset_x | default: 0 }}%;
        {%- when 'center' -%}top: 50%; left: 50%; transform: translate(-50%, -50%) rotate({{ ab.rotation | default: 0 }}deg) scale({{ ab.scale | default: 100 | divided_by: 100.0 }});
        {%- else -%}bottom: {{ ab.offset_y | default: 0 }}%; right: {{ ab.offset_x | default: 0 }}%;
      {%- endcase -%}
      border-radius: {{ ab.radius | default: 12 }}px;
      overflow: hidden;
      background: rgba(0,0,0,0.06);
      z-index: {% if ab.above_main %}2{% else %}1{% endif %};
      {%- unless ab.anchor == 'center' -%}
        transform: rotate({{ ab.rotation | default: 0 }}deg) scale({{ ab.scale | default: 100 | divided_by: 100.0 }});
      {%- endunless -%}
      box-shadow: {%- if ab.shadow -%}0 18px 44px -16px rgba(0,0,0,0.30){%- else -%}none{%- endif -%};
      {%- if ab.border_width > 0 -%}
        border: {{ ab.border_width }}px solid {% render 'scheme-color', color: ab.border_color, fallback: 'var(--color-background)' %};
        box-sizing: content-box;
      {%- endif -%}
    }
    #shopify-section-{{ sid }} .itd__accent[data-block-id="{{ accent_block.id }}"] img {
      width: 100%;
      height: 100%;
      object-fit: {{ ab.fit | default: 'cover' }};
      object-position: {{ ab.position_x | default: 50 }}% {{ ab.position_y | default: 50 }}%;
      display: block;
    }
    @media (max-width: 899px) {
      #shopify-section-{{ sid }} .itd__accent[data-block-id="{{ accent_block.id }}"] {
        width: {{ ab.size_mobile | default: ab.size | default: 50 }}%;
        height: {{ ab.size_mobile | default: ab.size | default: 50 }}%;
      }
      {%- if ab.hide_on_mobile -%}
        #shopify-section-{{ sid }} .itd__accent[data-block-id="{{ accent_block.id }}"] { display: none; }
      {%- endif -%}
    }
  {%- endif -%}

  /* Decorative dots */
  {%- if st.show_dots -%}
    #shopify-section-{{ sid }} .itd__dot {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      z-index: 3;
    }
    #shopify-section-{{ sid }} .itd__dot--a {
      width: {{ st.dot_size | default: 60 }}px;
      height: {{ st.dot_size | default: 60 }}px;
      background: {% render 'scheme-color', color: st.dot_color, fallback: 'var(--color-border)' %};
      top: {{ st.dot_a_y | default: 30 }}%;
      left: {{ st.dot_a_x | default: 28 }}%;
      opacity: {{ st.dot_opacity | default: 60 | divided_by: 100.0 }};
    }
    #shopify-section-{{ sid }} .itd__dot--b {
      width: {{ st.dot_size | default: 60 | times: 0.6 | round }}px;
      height: {{ st.dot_size | default: 60 | times: 0.6 | round }}px;
      {%- capture _dot_a -%}{% render 'scheme-color', color: st.dot_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
      background: {% render 'scheme-color', color: st.dot_color_b, fallback: _dot_a %};
      top: {{ st.dot_b_y | default: 70 }}%;
      left: {{ st.dot_b_x | default: 60 }}%;
      opacity: {{ st.dot_opacity | default: 60 | divided_by: 100.0 }};
    }
  {%- endif -%}

  /* Content */
  #shopify-section-{{ sid }} .itd__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 16 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .itd__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .itd__text > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .itd__placeholder { display: block; width: 100%; height: 100%; background: rgba(0,0,0,0.04); fill: currentColor; opacity: .5; }

  #shopify-section-{{ sid }} .itd__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .itd__heading {
    font-weight: var(--heading-weight, 700);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .itd__subheading {
    line-height: 1.6;
    max-width: 540px;
  }
  #shopify-section-{{ sid }} .itd__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .itd__subheading p:last-child { margin: 0; }

  /* Per-block text/button styles */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'eyebrow' -%}
      #shopify-section-{{ sid }} .itd__eyebrow[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size | default: 12 }}px;
      }
    {%- endif -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .itd__heading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
        font-size: {{ bs.size_mobile | default: 32 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .itd__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 44 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .itd__subheading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size_mobile | default: 15 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .itd__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 17 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'button' -%}
      {%- capture _btn_bg -%}{% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
      {%- capture _btn_fg -%}{% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}
      {%- capture _btn_bd -%}{% render 'scheme-color', color: bs.border_color, fallback: _btn_bg %}{%- endcapture -%}
      {%- capture _btn_bg_h -%}{% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %}{%- endcapture -%}
      {%- capture _btn_fg_h -%}{% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %}{%- endcapture -%}
      {%- capture _btn_bd_h -%}{% render 'scheme-color', color: bs.border_color_hover, fallback: _btn_bg_h %}{%- endcapture -%}
      #shopify-section-{{ sid }} .itd__btn[data-block-id="{{ block.id }}"] {
        display: {% if bs.full_width %}flex{% else %}inline-flex{% endif %};
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        line-height: 1;
        background-color: {{ _btn_bg }};
        color: {{ _btn_fg }};
        {%- if bs.use_theme_button -%}
        border: var(--btn-border-width, 1px) solid {{ _btn_bd }};
        padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
        border-radius: var(--btn-radius, 8px);
        font-size: var(--btn-font-size, 14px);
        font-weight: var(--btn-font-weight, 600);
        {%- else -%}
        border: {{ bs.border_width | default: 0 }}px solid {{ _btn_bd }};
        padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 26 }}px;
        border-radius: {{ bs.radius | default: 8 }}px;
        font-size: {{ bs.font_size | default: 14 }}px;
        font-weight: {{ bs.font_weight | default: '600' }};
        {%- endif -%}
        letter-spacing: 0.4px;
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
        width: {% if bs.full_width %}100%{% else %}auto{% endif %};
        max-width: {% if bs.full_width %}100%{% else %}max-content{% endif %};
        transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;
      }
      #shopify-section-{{ sid }} .itd__btn[data-block-id="{{ block.id }}"]:hover,
      #shopify-section-{{ sid }} .itd__btn[data-block-id="{{ block.id }}"]:focus-visible {
        background-color: {{ _btn_bg_h }};
        color: {{ _btn_fg_h }};
        border-color: {{ _btn_bd_h }};
        transform: translateY(-1px);
      }
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="itd-{{ sid }}" class="itd section sec__image-text-dual color-{{ color_scheme }} gradient {{ st.section_width }}" data-section-id="{{ sid }}">
  <div class="itd__inner">
    <div class="itd__grid">

      <div class="itd__media">
        <div class="itd__stage">
          {%- if st.show_dots and st.dots_behind_main -%}
            <span class="itd__dot itd__dot--a" aria-hidden="true"></span>
            <span class="itd__dot itd__dot--b" aria-hidden="true"></span>
          {%- endif -%}

          {%- if main_block -%}
            <div class="itd__main" data-block-id="{{ main_block.id }}" {{ main_block.shopify_attributes }}>
              {%- if main_block.settings.image != blank -%}
                <img
                  src="{{ main_block.settings.image | image_url: width: 1400 }}"
                  srcset="{{ main_block.settings.image | image_url: width: 600 }} 600w,
                          {{ main_block.settings.image | image_url: width: 900 }} 900w,
                          {{ main_block.settings.image | image_url: width: 1400 }} 1400w"
                  sizes="(min-width: 900px) 50vw, 100vw"
                  alt="{{ main_block.settings.image.alt | default: fb_accessibility_main_image_label | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'itd__placeholder' }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if accent_block -%}
            <div class="itd__accent" data-block-id="{{ accent_block.id }}" {{ accent_block.shopify_attributes }}>
              {%- if accent_block.settings.image != blank -%}
                <img
                  src="{{ accent_block.settings.image | image_url: width: 1000 }}"
                  srcset="{{ accent_block.settings.image | image_url: width: 500 }} 500w,
                          {{ accent_block.settings.image | image_url: width: 800 }} 800w,
                          {{ accent_block.settings.image | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 900px) 30vw, 60vw"
                  alt="{{ accent_block.settings.image.alt | default: fb_accessibility_accent_image | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'itd__placeholder' }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if st.show_dots and st.dots_behind_main == false -%}
            <span class="itd__dot itd__dot--a" aria-hidden="true"></span>
            <span class="itd__dot itd__dot--b" aria-hidden="true"></span>
          {%- endif -%}
        </div>
      </div>

      <div class="itd__text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="itd__eyebrow" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} class="itd__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="itd__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if bs.label != blank -%}
                <a class="itd__btn" data-block-id="{{ block.id }}" href="{{ bs.link | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "dual-image-with-text",
  "name": "Image & Text Dual",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
