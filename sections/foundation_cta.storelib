.fw__lede{max-width:57ch;margin:16px 0 0;font-size:var(--section-text-size,16px);line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw .fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-weight:var(--type-button-weight,650);font-size:var(--sl-button-size,var(--type-button-size,15px));letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text);border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw .fw__action:hover{background:var(--fw-button-hover,var(--fw-button));border-color:var(--fw-button-hover,var(--fw-button));color:var(--fw-button-hover-text,var(--fw-button-text));}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible,.fw [tabindex]:focus-visible{outline:2px solid currentColor;outline-offset:3px;}
@media(prefers-reduced-motion:reduce){.fw *,.fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-cta__inner{text-align:center;max-width:900px}
.fw-cta__title{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading,var(--heading-font,inherit)));font-size:var(--section-heading-size,clamp(32px,8cqi,70px));font-weight:var(--section-heading-weight,630);line-height:var(--section-heading-line-height,1.1);letter-spacing:var(--section-heading-tracking,-.04em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere}
.fw-cta__body{max-width:540px;margin:16px auto 0;color:var(--fw-muted);line-height:var(--section-text-line-height,1.7);font-size:var(--section-text-size,16px)}
.fw-cta .fw__action{margin-top:28px}
</style>

