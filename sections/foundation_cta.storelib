<template>
<section class="fw fw-cta" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ settings.heading_color }};--fw-text:{{ settings.text_color }};--fw-muted:{{ settings.text_color }};--fw-line:{{ scheme.border }};--fw-accent:{{ settings.overline_color }};--fw-button:{{ settings.button_color }};--fw-button-text:{{ settings.button_text_color }};--fw-button-hover:{{ scheme.primary_btn_hover_bg }};--fw-button-hover-text:{{ scheme.primary_btn_hover_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner fw-cta__inner">
  {% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}
  {% if settings.heading %}<h2 class="fw-cta__title">{{ settings.heading }}</h2>{% endif %}
  {% if settings.body %}<p class="fw-cta__body">{{ settings.body }}</p>{% endif %}
  {% if settings.button_label %}<a class="fw__action" data-theme-button="primary" data-sl-button href="{{ settings.button_url | default: '/products' | url }}">{{ settings.button_label }} <span aria-hidden="true">↗</span></a>{% endif %}
 </div>
</section>
</template>

<style scoped>
