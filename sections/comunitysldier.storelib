        "label": "Bar fill color"
      },
      {
        "type": "range",
        "id": "marker_size",
        "min": 8,
        "max": 28,
        "step": 1,
        "unit": "px",
        "label": "Marker size",
        "default": 18
      },
      {
        "type": "color",
        "id": "marker_color",
