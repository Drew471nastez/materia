        "label": "Show rating header",
        "default": true
      },
      {
        "type": "text",
        "id": "overall_score",
        "label": "Score (display)",
        "default": "4,3"
      },
      {
        "type": "range",
        "id": "overall_score_int",
        "min": 0,
        "max": 5,
        "step": 1,
        "label": "Filled stars",
        "default": 4
      },
      {
        "type": "text",
        "id": "review_count",
        "label": "Review count text",
        "default": "BASED ON 127+ REVIEWS"
      },
      {
        "type": "text",
        "id": "source_note",
        "label": "Source note",
        "default": "All reviews are verified purchasers"
      },
      {
        "type": "color",
        "id": "score_color",
        "label": "Score color"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Filled star color"
      },
      {
        "type": "color",
