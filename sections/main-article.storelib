<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{{ 'blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; 
  --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}

<!-- Desktop Content-Width Control -->
<style>
  #shopify-section-{{ section.id }} .lh-normal.flex.flex-wrap.gap-10.justify-content-center.mt-30.container-min {
    margin-bottom: 4.5px;
  }
  #shopify-section-{{ section.id }} .article-category-pill {
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .article-category-pill:hover { color: var(--color-primary); }
  #shopify-section-{{ section.id }} .author-highlight__image {
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    overflow: hidden;
    background: rgba(var(--color-text-rgb), 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .article-category-pill { transition: none; }
  }

  @media (min-width: 992px) {
    #shopify-section-{{ section.id }} .content-desktop-width {
      max-width: {{ section_st.content_width_desktop }}px;
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .author-highlight {
      margin-left: {{ section_st.author_margin_left }}px;
      margin-right: {{ section_st.author_margin_right }}px;
    }
  }
{% comment %}{% endcomment %}</style>

<div
  id="singleBlogPost"
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__article color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <!-- BEGIN: Main Article Content (No Sidebar) -->
    <article class="article-template single__post-content" itemscope itemtype="http://schema.org/BlogPosting">
      {%- for block in section.blocks -%}
        {% assign block_st = block.settings %}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }} class="single__post-header text-center page-title container-min">
              <h1
                class="heading-letter-spacing article-template__title mb-15 h0 mt-15"
                itemprop="headline"
                style="font-size: {{ block_st.blog_title_font_size }}px !important;"
              >
                {{ article.title | escape }}
              </h1>
            </div>

          {%- when 'category' -%}
            <div class="lh-normal flex flex-wrap gap-10 justify-content-center mt-30 container-min">
              {% assign blog_name = article.handle | split: '/' | first %}
              {% if blog_name != blank %}
                <a
                  href="{{ blog.url }}"
                  aria-label="{{ blog_name | capitalize }}"
                  class="article-category-pill inline-flex fs-13 btn-rounded py-8 px-20 lh-normal no-underline heading-color"
                  style="
                    background-color: {% render 'scheme-color', color: block_st.category_background_color, fallback: 'rgba(var(--color-text-rgb), 0.06)' %} !important;
                    border-radius: {{ block_st.category_border_radius }}px !important;
                  "
                >
                  <span>{{ blog_name | capitalize }}</span>
                </a>
              {% endif %}
            </div>

          {%- when 'blog_meta' -%}
            <div
              class="article_meta lh-normal flex flex-wrap align-center justify-content-center mt-15 container-min blog-meta-pill"
              style="
                background-color: {% render 'scheme-color', color: block_st.blog_meta_background_color, fallback: 'rgba(var(--color-text-rgb), 0.06)' %} !important;
                border-radius: {{ block_st.blog_meta_border_radius }}px !important;
                padding: 15px !important;
                margin: 0 auto;
                gap: 3px;
              "
            >
              <div class="article-card-author inline-flex align-center">
                {{- 'blog_post.post_by' | t }}
                <span class="primary-color heading_weight ms-5">{{ article.author }}</span>
              </div>
              <div
                class="article-card-date inline-flex align-center date-pill"
                itemprop="dateCreated pubdate datePublished"
                style="
                  background-color: {% render 'scheme-color', color: block_st.date_pill_background_color, fallback: 'rgba(var(--color-text-rgb), 0.1)' %} !important;
                  padding: 3px 8px;
                  border-radius: 999px;
                "
              >
                {{ article.published_at | date: '%b %d %Y' }}
              </div>
            </div>

          {%- when 'featured_image' -%}
            {%- if article.image -%}
              <div
                class="text-center mb-40"
                itemprop="image"
                style="
                  padding-top: {{ block_st.featured_image_top_padding }}px;
                  padding-bottom: {{ block_st.featured_image_bottom_padding }}px;
                "
              >
                <!-- Mobile-specific aspect ratio and padding -->
                <style>
                  @media (max-width: 767px) {
                    .article-template__hero-{{ block_st.image_height }} {
                      --aspect-ratio: 16/9 !important;
                      padding-left: 10px !important;
                      padding-right: 10px !important;
                    }
                    .article-template__hero-{{ block_st.image_height }} img {
                      object-fit: cover !important;
                      width: 100% !important;
                      height: 100% !important;
                    }
                  }
{% comment %}{% endcomment %}                </style>

                <div
                  class="rounded-corner-item relative article-template__hero-{{ block_st.image_height }} overflow-hidden media"
                  style="
                    border-radius: {{ block_st.featured_image_border_radius }}px !important;
                    {% if block_st.image_height == 'adapt' %}
                      --aspect-ratio: adapt;
                    {% endif %}
                  "
                >
                  {%- assign image_alt = article.image.alt | default: 'article' -%}
                  {% render 'responsive-image',
                    type: 'banner',
                    class: 'absolute h-full inset-0 object-fit-cover',
                    container: section_width,
                    image: article.image,
                    image_alt: image_alt,
                    lazy_load: true,
                    width: 1920,
                    height: 1080
                  %}
                </div>
              </div>
            {% endif %}

          {%- when 'content_article' -%}
            <div
              class="container-min article-template__content mt-40 rte content-desktop-width"
              itemprop="articleBody"
              {{ block.shopify_attributes }}
            >
              {{ article.content }}
            </div>

          {%- when 'author_highlight' -%}
            <div class="single__post-content-inner container-min">
              <div class="author-highlight" style="display: flex; align-items: center; gap: 10px; margin-top: 40px;">
                {%- if block_st.author_image != blank -%}
                  <img
                    class="author-highlight__image"
                    src="{{ block_st.author_image | image_url: width: 400 }}"
                    alt="{{ article.author | escape }}"
                    width="{{ block_st.author_image_size }}"
                    height="{{ block_st.author_image_size }}"
                    loading="lazy"
                    decoding="async"
                    style="width: {{ block_st.author_image_size }}px; height: {{ block_st.author_image_size }}px;"
                  >
                {%- else -%}
                  <span class="author-highlight__image inline-flex" style="width: {{ block_st.author_image_size }}px; height: {{ block_st.author_image_size }}px;" aria-hidden="true">
                    {{ 'image' | placeholder_svg_tag: 'w-full h-full' }}
                  </span>
                {%- endif -%}
                <div>
                  <p style="margin: 0 0 5px;">{{ block_st.author_text }}</p>
                  <p style="margin: 0;">
                    Written by <strong>{{ article.author }}</strong>
                  </p>
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </article>
    <!-- END: Main Article Content (No Sidebar) -->
  </div>
</div>

<script src="{{ 'blog.js' | asset_url }}" defer="defer"></script>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      "image": [
        {{ article | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "main-article",
  "name": "Main Blog Article",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Other"
    },
    {
      "type": "range",
      "id": "content_width_desktop",
      "label": "Content width",
      "default": 800,
      "min": 600,
      "max": 2000,
      "step": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "author_margin_left",
      "label": "Author margin left",
      "default": 0,
      "min": -200,
      "max": 100,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "author_margin_right",
      "label": "Author margin right",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Article Title",
      "settings": [
        {
          "type": "range",
          "id": "blog_title_font_size",
          "label": "Title size",
          "default": 40,
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "category",
      "name": "Category Display",
      "settings": [
        {
          "type": "color",
          "id": "category_background_color",
          "label": "Background"
        },
        {
          "type": "range",
          "id": "category_border_radius",
          "label": "Corner radius",
          "default": 20,
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "blog_meta",
      "name": "Blog Metadata",
      "settings": [
        {
          "type": "color",
          "id": "blog_meta_background_color",
          "label": "Background"
        },
        {
          "type": "range",
          "id": "blog_meta_border_radius",
          "label": "Corner radius",
          "default": 20,
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "date_pill_background_color",
          "label": "Date background"
        }
      ],
      "limit": 1
    },
    {
      "type": "content_article",
      "name": "Article Content",
      "settings": [],
      "limit": 1
    },
    {
      "type": "featured_image",
      "name": "Featured Image",
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt Height"
            },
            {
              "value": "small",
              "label": "Small Height"
            },
            {
              "value": "medium",
              "label": "Medium Height"
            },
            {
              "value": "large",
              "label": "Large Height"
            }
          ],
          "default": "adapt",
          "label": "Image height"
        },
        {
          "type": "range",
          "id": "featured_image_border_radius",
          "label": "Corner radius",
          "default": 0,
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "featured_image_top_padding",
          "label": "Padding top",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "featured_image_bottom_padding",
          "label": "Padding bottom",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "author_highlight",
      "name": "Author Highlight",
      "settings": [
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author photo"
        },
        {
          "type": "range",
          "id": "author_image_size",
          "label": "Photo size",
          "default": 80,
          "min": 40,
          "max": 200,
          "step": 5,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "author_text",
          "label": "Message",
          "default": "Hope you enjoyed this article and stay tuned!"
        }
      ],
      "limit": 1
    }
  ],
  "shopify": {
    "name": "Main Blog Article",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "stretch_width",
        "label": "Section width"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Other"
      },
      {
        "type": "range",
        "id": "content_width_desktop",
        "label": "Content width",
        "default": 800,
        "min": 600,
        "max": 2000,
        "step": 100,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "author_margin_left",
        "label": "Author margin left",
        "default": 0,
        "min": -200,
        "max": 100,
        "step": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "author_margin_right",
        "label": "Author margin right",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "title",
        "name": "Article Title",
        "limit": 1,
        "settings": [
          {
            "type": "range",
            "id": "blog_title_font_size",
            "label": "Title size",
            "default": 40,
            "min": 10,
            "max": 100,
            "step": 1,
            "unit": "px"
          }
        ]
      },
      {
        "type": "category",
        "name": "Category Display",
        "limit": 1,
        "settings": [
          {
            "type": "color",
            "id": "category_background_color",
            "label": "Background"
          },
          {
            "type": "range",
            "id": "category_border_radius",
            "label": "Corner radius",
            "default": 20,
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px"
          }
        ]
      },
      {
        "type": "blog_meta",
        "name": "Blog Metadata",
        "limit": 1,
        "settings": [
          {
            "type": "color",
            "id": "blog_meta_background_color",
            "label": "Background"
          },
          {
            "type": "range",
            "id": "blog_meta_border_radius",
            "label": "Corner radius",
            "default": 20,
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px"
          },
          {
            "type": "color",
            "id": "date_pill_background_color",
            "label": "Date background"
          }
        ]
      },
      {
        "type": "content_article",
        "name": "Article Content",
        "limit": 1
      },
      {
        "type": "featured_image",
        "name": "Featured Image",
        "limit": 1,
        "settings": [
          {
            "type": "select",
            "id": "image_height",
            "options": [
              {
                "value": "adapt",
                "label": "Adapt Height"
              },
              {
                "value": "small",
                "label": "Small Height"
              },
              {
                "value": "medium",
                "label": "Medium Height"
              },
              {
                "value": "large",
                "label": "Large Height"
              }
            ],
            "default": "adapt",
            "label": "Image height"
          },
          {
            "type": "range",
            "id": "featured_image_border_radius",
            "label": "Corner radius",
            "default": 0,
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px"
          },
          {
            "type": "range",
            "id": "featured_image_top_padding",
            "label": "Padding top",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px"
          },
          {
            "type": "range",
            "id": "featured_image_bottom_padding",
            "label": "Padding bottom",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px"
          }
        ]
      },
      {
        "type": "author_highlight",
        "name": "Author Highlight",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "author_image",
            "label": "Author photo"
          },
          {
            "type": "range",
            "id": "author_image_size",
            "label": "Photo size",
            "default": 80,
            "min": 40,
            "max": 200,
            "step": 5,
            "unit": "px"
          },
          {
            "type": "text",
            "id": "author_text",
            "label": "Message",
            "default": "Hope you enjoyed this article and stay tuned!"
          }
        ]
      }
    ]
  }
}
</schema>
