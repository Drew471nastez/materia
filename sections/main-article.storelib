          "max": 50,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Spacing"
        },
        {
          "type": "range",
          "id": "featured_image_top_padding",
          "label": "Space above",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "featured_image_bottom_padding",
          "label": "Space below",
          "default": 0,
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "author_highlight",
