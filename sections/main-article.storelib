<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{{ 'blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; 
  --section-pb: {{ section_st.padding_bottom }};
  --ma-content-width: {{ section_st.content_width_desktop }}px;
  --ma-author-ml: {{ section_st.author_margin_left }}px;
  --ma-author-mr: {{ section_st.author_margin_right }}px;
{%- endcapture -%}
{%- liquid
  comment
    Storelib has no blog posts yet: an article page with no post shows a short
    note on the storefront, and in the builder each block as a quiet outline
    of where the post's title, picture and text go. Nothing is made up.
  endcomment
  assign ma_has_article = false
  if article.title != blank or article.content != blank
    assign ma_has_article = true
  endif
  assign ma_blog_url = blog.url | default: routes.root_url | default: '/'
  assign ma_back_url = section_st.empty_button_url | default: ma_blog_url
-%}
{%- for block in section.blocks -%}
  {%- if block.settings.enable_custom_fonts -%}<style>{{ block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- endfor -%}

<!-- Desktop Content-Width Control -->
<style>
  #shopify-section-{{ section.id }} .lh-normal.flex.flex-wrap.gap-10.justify-content-center.mt-30.container-min {
    margin-bottom: 4.5px;
  }
  #shopify-section-{{ section.id }} .article-category-pill {
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    background-color: var(--ma-pill-bg) !important;
    border-radius: var(--ma-pill-radius) !important;
  }
  #shopify-section-{{ section.id }} .article-category-pill:hover { color: var(--color-primary); }
  #shopify-section-{{ section.id }} .blog-meta-pill { background-color: var(--ma-meta-bg) !important; border-radius: var(--ma-meta-radius) !important; padding: 15px !important; margin: 0 auto; gap: 3px; }
  #shopify-section-{{ section.id }} .date-pill { background-color: var(--ma-date-bg) !important; padding: 3px 8px; border-radius: 999px; }
  #shopify-section-{{ section.id }} .article-template__title { font-size: var(--ma-title-size) !important; }
  #shopify-section-{{ section.id }} [data-ma-hero] { border-radius: var(--ma-hero-radius) !important; }
  #shopify-section-{{ section.id }} .author-highlight__image {
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    overflow: hidden;
    background: rgba(var(--color-text-rgb), 0.08);
    width: var(--ma-author-size);
    height: var(--ma-author-size);
  }
  #shopify-section-{{ section.id }} .ma-skeleton { display: block; border-radius: 6px; background: color-mix(in srgb, var(--color-text) 12%, transparent); }
  #shopify-section-{{ section.id }} .ma-skeleton--title { height: 0.9em; width: min(70%, 640px); margin: 0.1em auto; }
  #shopify-section-{{ section.id }} .ma-skeleton--pill { height: 34px; width: 110px; border-radius: 999px; }
  #shopify-section-{{ section.id }} .ma-skeleton--line { height: 14px; margin-block: 14px; }
  #shopify-section-{{ section.id }} .ma-skeleton--line:nth-child(3n) { width: 82%; }
  #shopify-section-{{ section.id }} .ma-empty { max-width: 64rem; margin-inline: auto; padding: 56px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  #shopify-section-{{ section.id }} .ma-empty [hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .ma-empty__title { margin: 0; }
  #shopify-section-{{ section.id }} .ma-empty__text { color: var(--color-text); max-width: 46ch; }
  #shopify-section-{{ section.id }} .ma-empty__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .ma-empty__action { margin-top: 8px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .ma-builder-note { margin: 0 auto 8px; text-align: center; font-size: 13px; color: color-mix(in srgb, var(--color-text) 75%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .article-category-pill { transition: none; }
  }
  /* Phones: the featured picture is 16:9 whatever its height setting. */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} [data-ma-hero] {
      --aspect-ratio: 16/9 !important;
      padding-left: 10px !important;
      padding-right: 10px !important;
    }
    #shopify-section-{{ section.id }} [data-ma-hero] img {
      object-fit: cover !important;
      width: 100% !important;
      height: 100% !important;
    }
  }

  @media (min-width: 992px) {
    #shopify-section-{{ section.id }} .content-desktop-width {
      max-width: var(--ma-content-width);
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .author-highlight {
      margin-left: var(--ma-author-ml);
      margin-right: var(--ma-author-mr);
    }
  }
{% comment %}{% endcomment %}</style>

<div
  id="singleBlogPost"
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__article color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
  data-lcp="main-article"
  data-lcp-id="{{ section.id }}"
  data-lcp-back="{{ ma_blog_url }}"{% if request.design_mode %}
  data-lcp-settings="{{ section.settings | json | escape }}"{% endif %}
>
  <div class="{{ section_width }}">
    {%- if ma_has_article == false and request.design_mode != true -%}
      <div class="ma-empty" data-ma-empty>
        <h1 class="ma-empty__title h3"{% if section_st.empty_heading == blank %} hidden{% endif %}>{{ section_st.empty_heading | escape }}</h1>
        <div class="ma-empty__text"{% if section_st.empty_text == blank %} hidden{% endif %}>{{ section_st.empty_text }}</div>
        <a class="ma-empty__action btn btn-primary" href="{{ ma_back_url }}" data-theme-button="primary" data-sl-button{% if section_st.empty_button_label == blank %} hidden{% endif %}>{{ section_st.empty_button_label | escape }}</a>
      </div>
    {%- else -%}
    {%- if ma_has_article == false -%}
      <p class="ma-builder-note">Preview: a post's title, picture and text show here. With no post, visitors see the note set in this section.</p>
    {%- endif -%}
    <!-- BEGIN: Main Article Content (No Sidebar) -->
    <article class="article-template single__post-content" itemscope itemtype="http://schema.org/BlogPosting">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_st = block.settings
          assign block_font = ''
          if block_st.enable_custom_fonts and block_st.font.family != blank
            assign block_font = block_st.font.family
            if block_st.font.fallback_families != blank
              assign block_font = block_font | append: ', ' | append: block_st.font.fallback_families
            endif
          endif
        -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }} class="single__post-header text-center page-title container-min" data-lcp-block="{{ block.id }}" data-lcp-block-type="title"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %} style="--ma-title-size: {{ block_st.blog_title_font_size }}px;">
              <h1
                class="heading-letter-spacing article-template__title mb-15 h0 mt-15"
                itemprop="headline"
                {%- if block_font != blank %} data-own-font style="font-family: {{ block_font }};"{% endif %}
              >
                {%- if ma_has_article -%}
                  {{ article.title | escape }}
                {%- else -%}
                  <span class="ma-skeleton ma-skeleton--title" aria-hidden="true"></span>
                {%- endif -%}
              </h1>
            </div>

          {%- when 'category' -%}
            <div class="lh-normal flex flex-wrap gap-10 justify-content-center mt-30 container-min" data-lcp-block="{{ block.id }}" data-lcp-block-type="category"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %} {{ block.shopify_attributes }} style="--ma-pill-bg: {% if block_st.enable_custom_style %}{% render 'scheme-color', color: block_st.category_background_color, fallback: 'rgba(var(--color-text-rgb), 0.06)' %}{% else %}rgba(var(--color-text-rgb), 0.06){% endif %}; --ma-pill-radius: {{ block_st.category_border_radius }}px;">
              {% assign blog_name = article.handle | split: '/' | first %}
              {% if blog_name != blank %}
                <a
                  href="{{ blog.url }}"
                  aria-label="{{ blog_name | capitalize }}"
                  class="article-category-pill inline-flex fs-13 btn-rounded py-8 px-20 lh-normal no-underline heading-color"
                >
                  <span>{{ blog_name | capitalize }}</span>
                </a>
              {% elsif ma_has_article == false %}
                <span class="article-category-pill ma-skeleton ma-skeleton--pill" aria-hidden="true"></span>
              {% endif %}
            </div>

          {%- when 'blog_meta' -%}
            <div
              class="article_meta lh-normal flex flex-wrap align-center justify-content-center mt-15 container-min blog-meta-pill"
              data-lcp-block="{{ block.id }}" data-lcp-block-type="blog_meta"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %}
              {{ block.shopify_attributes }}
              style="--ma-meta-bg: {% if block_st.enable_custom_style %}{% render 'scheme-color', color: block_st.blog_meta_background_color, fallback: 'rgba(var(--color-text-rgb), 0.06)' %}{% else %}rgba(var(--color-text-rgb), 0.06){% endif %}; --ma-meta-radius: {{ block_st.blog_meta_border_radius }}px; --ma-date-bg: {% if block_st.enable_custom_style %}{% render 'scheme-color', color: block_st.date_pill_background_color, fallback: 'rgba(var(--color-text-rgb), 0.1)' %}{% else %}rgba(var(--color-text-rgb), 0.1){% endif %};"
            >
              {%- if ma_has_article -%}
                <div class="article-card-author inline-flex align-center">
                  {{- 'blog_post.post_by' | t }}
                  <span class="primary-color heading_weight ms-5">{{ article.author }}</span>
                </div>
                <div
                  class="article-card-date inline-flex align-center date-pill"
                  itemprop="dateCreated pubdate datePublished"
                >
                  {{ article.published_at | date: '%b %d %Y' }}
                </div>
              {%- else -%}
                <span class="ma-skeleton" style="width: 120px; height: 14px;" aria-hidden="true"></span>
                <span class="date-pill" aria-hidden="true" style="display: inline-block; width: 84px; height: 20px;"></span>
              {%- endif -%}
            </div>

          {%- when 'featured_image' -%}
            {%- if article.image or ma_has_article == false -%}
              <div
                class="text-center mb-40"
                itemprop="image"
                data-lcp-block="{{ block.id }}" data-lcp-block-type="featured_image"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %}
                {{ block.shopify_attributes }}
                style="
                  padding-top: {{ block_st.featured_image_top_padding }}px;
                  padding-bottom: {{ block_st.featured_image_bottom_padding }}px;
                  --ma-hero-radius: {{ block_st.featured_image_border_radius }}px;
                "
              >

                <div
                  class="rounded-corner-item relative article-template__hero-{{ block_st.image_height }} overflow-hidden media"
                  data-ma-hero
                  {% if block_st.image_height == 'adapt' %}
                    style="--aspect-ratio: {% if article.image %}adapt{% else %}16/9{% endif %};"
                  {% endif %}
                >
                  {%- if article.image -%}
                    {%- assign image_alt = article.image.alt | default: 'article' -%}
                    {% render 'responsive-image',
                      type: 'banner',
                      class: 'absolute h-full inset-0 object-fit-cover',
                      container: section_width,
                      image: article.image,
                      image_alt: image_alt,
                      lazy_load: true,
                      width: 1920,
                      height: 1080
                    %}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'absolute inset-0 w-full h-full placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            {% endif %}

          {%- when 'content_article' -%}
            <div
              class="container-min article-template__content mt-40 rte content-desktop-width"
              itemprop="articleBody"
              data-lcp-block="{{ block.id }}" data-lcp-block-type="content_article"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %}
              {%- if block_font != blank %} data-own-font style="font-family: {{ block_font }};"{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if ma_has_article -%}
                {{ article.content }}
              {%- else -%}
                <div aria-hidden="true">{% for i in (1..6) %}<span class="ma-skeleton ma-skeleton--line"></span>{% endfor %}</div>
              {%- endif -%}
            </div>

          {%- when 'author_highlight' -%}
            <div class="single__post-content-inner container-min" data-lcp-block="{{ block.id }}" data-lcp-block-type="author_highlight"{% if request.design_mode %} data-lcp-block-settings="{{ block.settings | json | escape }}"{% endif %} {{ block.shopify_attributes }} style="--ma-author-size: {{ block_st.author_image_size }}px;">
              <div class="author-highlight" style="display: flex; align-items: center; gap: 10px; margin-top: 40px;">
                {%- if block_st.author_image != blank -%}
                  <img
                    class="author-highlight__image"
                    src="{{ block_st.author_image | image_url: width: 400 }}"
                    alt="{{ article.author | escape }}"
                    width="{{ block_st.author_image_size }}"
                    height="{{ block_st.author_image_size }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <span class="author-highlight__image inline-flex" aria-hidden="true">
                    {{ 'image' | placeholder_svg_tag: 'w-full h-full' }}
                  </span>
                {%- endif -%}
                <div>
                  <p style="margin: 0 0 5px;" data-ma-author-text>{{ block_st.author_text }}</p>
                  {%- if article.author != blank -%}
                    <p style="margin: 0;">
                      Written by <strong>{{ article.author }}</strong>
                    </p>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </article>
    <!-- END: Main Article Content (No Sidebar) -->
    {%- endif -%}
  </div>
</div>

<script src="{{ 'blog.js' | asset_url }}" defer="defer"></script>

{%- if ma_has_article -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      "image": [
        {{ article | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
{% comment %}{% endcomment %}</script>
{%- endif -%}


</template>

<schema>
{
  "type": "main-article",
  "name": "Blog post",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading when the post is missing",
      "default": "This post is not available"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "Text when the post is missing",
      "default": "<p>It may have moved or is not published yet.</p>"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button when the post is missing",
      "default": "Back to the blog",
      "info": "Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Button link when the post is missing",
      "info": "Empty links to the blog."
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "content_width_desktop",
      "label": "Text width (desktop)",
      "default": 800,
      "min": 600,
      "max": 2000,
      "step": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "author_margin_left",
      "label": "Author box shift left (desktop)",
      "default": 0,
      "min": -200,
      "max": 100,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "author_margin_right",
      "label": "Author box shift right (desktop)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Title font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "range",
          "id": "blog_title_font_size",
          "label": "Title size",
          "default": 40,
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "category",
      "name": "Blog name",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "category_background_color",
          "label": "Background",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "category_border_radius",
          "label": "Corner radius",
          "default": 20,
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "blog_meta",
      "name": "Author and date",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "blog_meta_background_color",
          "label": "Background",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "date_pill_background_color",
          "label": "Date background",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "blog_meta_border_radius",
          "label": "Corner radius",
          "default": 20,
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px"
        }
