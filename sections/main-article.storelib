        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Text font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "featured_image",
      "name": "Featured picture",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Layout"
        },
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "Picture shape"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
