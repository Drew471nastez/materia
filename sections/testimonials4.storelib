          "default": "Quality is outstanding and delivery was fast. Will absolutely buy again — every piece feels premium and well-considered."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
