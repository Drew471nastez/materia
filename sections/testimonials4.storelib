<template compat="shopify">
{%- assign fb_accessibility_customer = 'accessibility.customer' | t -%}
{%- comment -%}
  Testimonial Spotlight
  ----------------------------------------------------
  A single hero-style featured customer testimonial with a large quote,
  optional avatar, star rating and an "as seen in" / quote-source line.
  Centered, generous whitespace, designed to highlight ONE standout review.
  Block-driven: heading / eyebrow / subheading / testimonial cards live
  as blocks. The carousel cycles through testimonial blocks.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- liquid
  assign scroll_anim = settings.scroll_animation | default: 'none'
-%}

{%- assign block_eyebrow = blank -%}
{%- assign block_heading = blank -%}
{%- assign block_subheading = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'heading' -%}{%- assign block_heading = b -%}
    {%- when 'subheading' -%}{%- assign block_subheading = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- if scroll_anim != blank and scroll_anim != 'none' and section.settings.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

<style>
  #shopify-section-{{ sid }} { position: static; }
  .tsp-{{ sid }} {
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#111111' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    font-family: var(--body-font, inherit);
  }
  .tsp-{{ sid }} *, .tsp-{{ sid }} *::before, .tsp-{{ sid }} *::after { box-sizing: border-box; }
  .tsp-{{ sid }} .tsp-wrap {
    max-width: {{ section.settings.max_width | default: 880 }}px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
    text-align: {{ section.settings.text_align | default: 'center' }};
  }
  .tsp-{{ sid }} .tsp-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .tsp-{{ sid }} .tsp-heading {
    font-family: var(--heading-font, inherit);
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 14px;
  }
  .tsp-{{ sid }} .tsp-subheading {
    line-height: 1.55;
    margin: 0 0 36px;
  }
  .tsp-{{ sid }} .tsp-rail {
    position: relative;
    overflow: hidden;
  }
  .tsp-{{ sid }} .tsp-track {
    display: flex;
    transition: transform .55s cubic-bezier(.4,0,.2,1);
    will-change: transform;
  }
  .tsp-{{ sid }} .tsp-card {
    flex: 0 0 100%;
    min-width: 0;
    padding-inline: 12px;
  }
  .tsp-{{ sid }} .tsp-stars {
    display: inline-flex; gap: 4px;
    margin: 0 0 22px;
    justify-content: center;
  }
  .tsp-{{ sid }} .tsp-star {
    width: 22px; height: 22px;
    position: relative;
    display: inline-block;
  }
  .tsp-{{ sid }} .tsp-star svg {
    width: 100%; height: 100%;
    fill: {{ section.settings.star_empty_color | default: '#d6d6d6' }};
    display: block;
  }
  /* Half / full overlay using a clipped duplicate star painted with the
     filled color on top of the empty base. */
  .tsp-{{ sid }} .tsp-star::before {
    content: "";
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 0;
    background: {{ section.settings.star_color | default: '#f5b301' }};
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z'/></svg>") no-repeat center / contain;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z'/></svg>") no-repeat center / contain;
  }
  .tsp-{{ sid }} .tsp-star.is-full::before { width: 100%; }
  .tsp-{{ sid }} .tsp-star.is-half::before { width: 50%; }
  .tsp-{{ sid }} .tsp-quote {
    font-family: var(--heading-font, inherit);
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.4;
    font-weight: 600;
    margin: 0 0 30px;
    color: {{ section.settings.quote_color | default: '#111111' }};
  }
  .tsp-{{ sid }} .tsp-quote::before { content: open-quote; }
  .tsp-{{ sid }} .tsp-quote::after  { content: close-quote; }
  .tsp-{{ sid }} .tsp-meta {
    display: inline-flex; align-items: center; gap: 14px;
    justify-content: center;
  }
  .tsp-{{ sid }} .tsp-avatar {
    width: 52px; height: 52px;
    border-radius: 50%;
    overflow: hidden;
    background: #e6eaee;
    flex: 0 0 auto;
  }
  .tsp-{{ sid }} .tsp-avatar img,
  .tsp-{{ sid }} .tsp-avatar svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .tsp-{{ sid }} .tsp-name {
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    margin: 0;
    text-align: left;
  }
  .tsp-{{ sid }} .tsp-role {
    font-size: 13px;
    color: {{ section.settings.role_color | default: '#5b6470' }};
    margin: 2px 0 0;
    text-align: left;
  }
  .tsp-{{ sid }} .tsp-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }
  .tsp-{{ sid }} .tsp-dots {
    display: inline-flex; gap: 8px;
  }
  .tsp-{{ sid }} .tsp-dot {
    width: 8px; height: 8px;
    border: none; padding: 0; margin: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color | default: '#d6d6d6' }};
    cursor: pointer;
    transition: background .25s ease, transform .15s ease;
  }
  .tsp-{{ sid }} .tsp-dot.is-active {
    background: {{ section.settings.dot_active_color | default: '#111111' }};
    transform: scale(1.25);
  }
  .tsp-{{ sid }} .tsp-arrow {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.arrow_border | default: '#dddddd' }};
    background: {{ section.settings.arrow_bg | default: '#ffffff' }};
    color: {{ section.settings.arrow_color | default: '#111111' }};
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;
  }
  .tsp-{{ sid }} .tsp-arrow:hover {
    background: {{ section.settings.arrow_bg_hover | default: '#111111' }};
    color: {{ section.settings.arrow_color_hover | default: '#ffffff' }};
    border-color: {{ section.settings.arrow_bg_hover | default: '#111111' }};
    transform: translateY(-1px);
  }
  .tsp-{{ sid }} .tsp-arrow svg { width: 14px; height: 14px; }
  @media (max-width: 600px) {
    .tsp-{{ sid }} .tsp-meta { flex-direction: column; gap: 8px; }
    .tsp-{{ sid }} .tsp-name, .tsp-{{ sid }} .tsp-role { text-align: center; }
  }
{% comment %}{% endcomment %}</style>

<div class="tsp-{{ sid }}">
  <div class="tsp-wrap">
    {%- if block_eyebrow != blank and block_eyebrow.settings.text != blank -%}
      <p class="tsp-eyebrow"
         style="color: {{ block_eyebrow.settings.color | default: '#666666' }};"
         {{ block_eyebrow.shopify_attributes }}>{{ block_eyebrow.settings.text }}</p>
    {%- endif -%}
    {%- if block_heading != blank and block_heading.settings.text != blank -%}
      <h2 class="tsp-heading"
          style="font-size: clamp(24px, 4.6vw, {{ block_heading.settings.size | default: 44 }}px); color: {{ block_heading.settings.color | default: '#111111' }};"
          {{ block_heading.shopify_attributes }}>{{ block_heading.settings.text }}</h2>
    {%- endif -%}
    {%- if block_subheading != blank and block_subheading.settings.text != blank -%}
      <p class="tsp-subheading"
         style="font-size: {{ block_subheading.settings.size | default: 16 }}px; color: {{ block_subheading.settings.color | default: '#5b6470' }};"
         {{ block_subheading.shopify_attributes }}>{{ block_subheading.settings.text }}</p>
    {%- endif -%}

    {%- assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' -%}
    {%- if testimonial_blocks.size > 0 -%}
      <div class="tsp-rail" data-tsp-rail>
        <div class="tsp-track" data-tsp-track>
          {%- for b in testimonial_blocks -%}
            {%- assign rating = b.settings.rating | default: 5 -%}
            <div class="tsp-card" {{ b.shopify_attributes }}>
              <div class="tsp-stars" aria-label="{{ rating }} out of 5 stars">
                {%- for n in (1..5) -%}
                  {%- assign half_threshold = n | minus: 0.5 -%}
                  {%- if rating >= n -%}
                    {%- assign cls = ' is-full' -%}
                  {%- elsif rating >= half_threshold -%}
                    {%- assign cls = ' is-half' -%}
                  {%- else -%}
                    {%- assign cls = '' -%}
                  {%- endif -%}
                  <span class="tsp-star{{ cls }}" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z"/></svg>
                  </span>
                {%- endfor -%}
              </div>
              <p class="tsp-quote">{{ b.settings.body }}</p>
              <div class="tsp-meta">
                <div class="tsp-avatar">
                  {%- if b.settings.avatar != blank -%}
                    {{ b.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', widths: '52,104,120', sizes: '52px', alt: b.settings.name | default: fb_accessibility_customer }}
                  {%- else -%}
                    <svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="21" r="9" fill="#bfc6cf"/><path d="M6 48c0-10 9-15 20-15s20 5 20 15" fill="#bfc6cf"/></svg>
                  {%- endif -%}
                </div>
                <div>
                  <p class="tsp-name">{{ b.settings.name | default: fb_accessibility_customer }}</p>
                  {%- if b.settings.role != blank -%}
                    <p class="tsp-role">{{ b.settings.role }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if testimonial_blocks.size > 1 -%}
        <div class="tsp-nav">
          <button type="button" class="tsp-arrow" data-tsp-prev aria-label="{{ 'accessibility.previous' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="tsp-dots" data-tsp-dots>
            {%- for b in testimonial_blocks -%}
              <button type="button" class="tsp-dot{% if forloop.first %} is-active{% endif %}" data-tsp-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <button type="button" class="tsp-arrow" data-tsp-next aria-label="{{ 'accessibility.next' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  const sectionId = '{{ sid }}';
  const root = document.querySelector('.tsp-' + sectionId);
  if (!root) return;
  const track = root.querySelector('[data-tsp-track]');
  if (!track) return;
  const slides = track.children;
  const prev = root.querySelector('[data-tsp-prev]');
  const next = root.querySelector('[data-tsp-next]');
  const dots = root.querySelectorAll('[data-tsp-dot]');
  let idx = 0;

  function go(i) {
    idx = (i + slides.length) % slides.length;
    track.style.transform = 'translateX(' + (-100 * idx) + '%)';
    dots.forEach((d, n) => d.classList.toggle('is-active', n === idx));
  }
  if (prev) prev.addEventListener('click', () => go(idx - 1));
  if (next) next.addEventListener('click', () => go(idx + 1));
  dots.forEach((d) => d.addEventListener('click', (e) => go(parseInt(d.getAttribute('data-tsp-dot'), 10))));

  // Auto-advance
  const autoMs = {{ section.settings.autoplay_s | default: 0 }} * 1000;
  if (autoMs > 0 && slides.length > 1) {
    let timer = setInterval(() => go(idx + 1), autoMs);
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', () => { timer = setInterval(() => go(idx + 1), autoMs); });
  }

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail && e.detail.sectionId === sectionId) go(0);
    });
  }
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "testimonials4",
  "name": "Testimonial Spotlight",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "📝 Content lives in blocks below"
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 880
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Stars"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Filled star color",
      "default": "#f5b301"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star color",
      "default": "#d6d6d6"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Quote & meta"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Customer role color",
      "default": "#5b6470"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Carousel"
    },
    {
