      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "arrow_border",
      "label": "Arrow border",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "arrow_bg_hover",
      "label": "Arrow background on hover",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "arrow_color_hover",
      "label": "Arrow icon on hover",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Section style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
