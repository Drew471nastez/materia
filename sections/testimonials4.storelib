          "default": "Sarah Jones"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / title",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Spotlight",
      "category": "Testimonials",
      "blocks": [
