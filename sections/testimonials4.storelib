        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#666666"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Loved by thousands"
