      },
      {
        "type": "range",
        "id": "max_width",
        "min": 480,
        "max": 1200,
        "step": 10,
        "unit": "px",
        "label": "Content max width",
        "default": 880
      },
      {
        "type": "header",
        "content": "Stars"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Filled star color",
        "default": "#f5b301"
      },
      {
        "type": "color",
        "id": "star_empty_color",
        "label": "Empty star color",
        "default": "#d6d6d6"
      },
      {
        "type": "header",
        "content": "Quote & meta"
      },
