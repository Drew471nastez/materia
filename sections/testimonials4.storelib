<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign scroll_anim = settings.scroll_animation | default: 'none'
  assign fb_customer = 'accessibility.customer' | t
-%}
{%- comment -%}
  Materia Themes. Testimonial Spotlight.

  One large customer quote at a time, with stars, an optional photo, a name
  and a role, under eyebrow, heading and subheading blocks. Several
  testimonial blocks make a row that moves one quote at a time, with
  arrows, dots, swipe and keys, and moves on by itself when Auto advance is
  set (only while on screen, never under reduced motion). Colours follow the
  colour scheme and fonts follow Theme settings > Typography until custom
  styling or custom fonts are switched on. Run by shopify/assets/live-testimonials.js.
{%- endcomment -%}
{%- if scroll_anim != blank and scroll_anim != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'live-testimonials-style', sid: sid %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { position: static; }
  #shopify-section-{{ sid }} .tsp { background: var(--tsp-bg); color: var(--tsp-text); padding-top: var(--tsp-pt); padding-bottom: var(--tsp-pb); font-family: var(--tsp-bf); overflow: hidden; }
  #shopify-section-{{ sid }} .tsp *, #shopify-section-{{ sid }} .tsp *::before, #shopify-section-{{ sid }} .tsp *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .tsp__wrap { max-width: var(--tsp-max); margin: 0 auto; padding-inline: clamp(16px, 4vw, 32px); text-align: var(--tsp-align); }
  #shopify-section-{{ sid }} .tsp__eyebrow { margin: 0 0 14px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--b-c); font-family: var(--tsp-bf); font-weight: var(--b-w, 700); }
  #shopify-section-{{ sid }} .tsp__heading { margin: 0 0 14px; color: var(--b-c); font-family: var(--tsp-hf); font-weight: var(--heading-weight, 700); line-height: 1.12; font-size: var(--b-fs-m); }
  #shopify-section-{{ sid }} .tsp__sub { margin: 0 0 36px; color: var(--b-c); font-family: var(--tsp-bf); line-height: 1.55; font-size: var(--b-fs); }
  #shopify-section-{{ sid }} .tsp__sub p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .tsp__sub p + p { margin-top: .6em; }
  #shopify-section-{{ sid }} .tsp__track { display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; touch-action: pan-x pan-y; cursor: grab; }
  #shopify-section-{{ sid }} .tsp__track.is-dragging { cursor: grabbing; }
  #shopify-section-{{ sid }} .tsp__card { flex: 0 0 100%; min-width: 0; padding-inline: 12px; scroll-snap-align: start; }
  #shopify-section-{{ sid }} .tsp__card .lt-stars { margin: 0 0 22px; }
  #shopify-section-{{ sid }} .tsp__quote { margin: 0 0 30px; color: var(--tsp-quote-c); font-family: var(--tsp-hf); font-weight: var(--heading-weight, 600); font-size: var(--tsp-q-m); line-height: 1.4; white-space: pre-line; }
  #shopify-section-{{ sid }} .tsp__quote::before { content: open-quote; }
  #shopify-section-{{ sid }} .tsp__quote::after { content: close-quote; }
  #shopify-section-{{ sid }} .tsp__meta { display: inline-flex; flex-direction: column; align-items: center; gap: 8px; }
  #shopify-section-{{ sid }} .tsp__avatar { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 50%; overflow: hidden; background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); color: color-mix(in srgb, var(--color-text) 35%, var(--color-background)); }
  #shopify-section-{{ sid }} .tsp__avatar img, #shopify-section-{{ sid }} .tsp__avatar svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .tsp__name { margin: 0; color: var(--tsp-name-c); font-family: var(--tsp-hf); font-weight: var(--heading-weight, 700); font-size: 16px; line-height: 1.2; }
  #shopify-section-{{ sid }} .tsp__role { margin: 2px 0 0; color: var(--tsp-role-c); font-size: 13px; }
  #shopify-section-{{ sid }} .tsp__nav { margin-top: 30px; }
  #shopify-section-{{ sid }} .tsp[data-count="1"] .tsp__nav { display: none; }
  #shopify-section-{{ sid }} .tsp[data-align="left"] .tsp__card .lt-stars, #shopify-section-{{ sid }} .tsp[data-align="left"] .tsp__nav { justify-content: flex-start; }
  #shopify-section-{{ sid }} .tsp[data-align="left"] .tsp__meta { align-items: flex-start; }
  @media (min-width: 601px) {
    #shopify-section-{{ sid }} .tsp__meta { flex-direction: row; gap: 14px; }
    #shopify-section-{{ sid }} .tsp__name, #shopify-section-{{ sid }} .tsp__role { text-align: start; }
    #shopify-section-{{ sid }} .tsp__quote { font-size: var(--tsp-q-d); }
    #shopify-section-{{ sid }} .tsp__heading { font-size: var(--b-fs-d); }
  }
{% comment %}{% endcomment %}</style>
{%- assign cards = section.blocks | where: 'type', 'testimonial' -%}
<div class="lt-frame" data-width="{{ st.section_width | default: 'full_width' }}">
<div class="tsp color-{{ color_scheme }} gradient" data-lt-root="testimonials4" data-section-id="{{ sid }}" data-lt-settings="{{ st | json | escape }}" data-align="{{ st.text_align | default: 'center' }}" data-count="{{ cards.size }}"{% if fonts %} data-own-font{% endif %} style="--tsp-bg: {% render 'live-testimonials-color', on: custom, color: st.section_bg, fallback: 'var(--color-background)' %};--tsp-text: {% render 'live-testimonials-color', on: custom, color: st.text_color, fallback: 'var(--color-text)' %};--tsp-quote-c: {% render 'live-testimonials-color', on: custom, color: st.quote_color, fallback: 'var(--color-heading)' %};--tsp-name-c: {% render 'live-testimonials-color', on: custom, color: st.name_color, fallback: 'var(--color-heading)' %};--tsp-role-c: {% render 'live-testimonials-color', on: custom, color: st.role_color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};--lt-star-on: {% render 'live-testimonials-color', on: custom, color: st.star_color, fallback: 'var(--color-primary)' %};--lt-star-off: {% render 'live-testimonials-color', on: custom, color: st.star_empty_color, fallback: 'color-mix(in srgb, var(--color-text) 20%, transparent)' %};--lt-arrow-bg: {% render 'live-testimonials-color', on: custom, color: st.arrow_bg, fallback: 'var(--color-background)' %};--lt-arrow-c: {% render 'live-testimonials-color', on: custom, color: st.arrow_color, fallback: 'var(--color-heading)' %};--lt-arrow-border: {% render 'live-testimonials-color', on: custom, color: st.arrow_border, fallback: 'var(--color-border)' %};--lt-arrow-bg-h: {% render 'live-testimonials-color', on: custom, color: st.arrow_bg_hover, fallback: 'var(--color-heading)' %};--lt-arrow-c-h: {% render 'live-testimonials-color', on: custom, color: st.arrow_color_hover, fallback: 'var(--color-background)' %};--lt-dot: {% render 'live-testimonials-color', on: custom, color: st.dot_color, fallback: 'color-mix(in srgb, var(--color-text) 30%, transparent)' %};--lt-dot-active: {% render 'live-testimonials-color', on: custom, color: st.dot_active_color, fallback: 'var(--color-heading)' %};--tsp-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--tsp-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--tsp-pt: {{ st.padding_top | default: 0 }}px;--tsp-pb: {{ st.padding_bottom | default: 0 }}px;--tsp-max: {{ st.max_width | default: 880 }}px;--tsp-align: {{ st.text_align | default: 'center' }};--tsp-q-d: {{ st.quote_size | default: 28 }}px;--tsp-q-m: {{ st.quote_size_mobile | default: 20 }}px;--lt-star-size: {{ st.star_size | default: 22 }}px;--lt-star-gap: 4px;">
  <div class="tsp__wrap">
    {%- for b in section.blocks -%}
      {%- assign bs = b.settings -%}
      {%- capture b_attrs -%}data-lt-block="{{ b.id }}" data-lt-type="{{ b.type }}" data-lt-settings="{{ bs | json | escape }}" {{ b.shopify_attributes }}{%- endcapture -%}
      {%- case b.type -%}
        {%- when 'eyebrow' -%}
          <p class="tsp__eyebrow" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-text)' %};">{{ bs.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="tsp__heading" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-heading)' %};--b-fs-d: {{ bs.size | default: 44 }}px;--b-fs-m: {{ bs.size_mobile | default: 24 }}px;">{{ bs.text }}</h2>
        {%- when 'subheading' -%}
          <div class="tsp__sub" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-text)' %};--b-fs: {{ bs.size | default: 16 }}px;">{{ bs.text }}</div>
      {%- endcase -%}
    {%- endfor -%}

    {%- if cards.size > 0 -%}
      <div class="tsp__track" data-lt-track data-tsp-track data-testimonial-row tabindex="0" role="region" aria-roledescription="carousel" aria-label="Reviews">
        {%- for b in cards -%}
          {%- assign bs = b.settings -%}
          <div class="tsp__card" data-lt-block="{{ b.id }}" data-lt-type="testimonial" data-lt-settings="{{ bs | json | escape }}" {{ b.shopify_attributes }}>
            {% render 'live-testimonials-stars', rating: bs.rating %}
            <p class="tsp__quote" data-lt-text>{{ bs.body | escape }}</p>
            <div class="tsp__meta">
              <div class="tsp__avatar" data-lt-media>
                {%- if bs.avatar != blank -%}
                  {{ bs.avatar | image_url: width: 120 | image_tag: loading: 'lazy', decoding: 'async', widths: '52,104,120', sizes: '52px', width: 52, height: 52, alt: bs.name | default: fb_customer }}
                {%- else -%}
                  <svg viewBox="0 0 52 52" aria-hidden="true" focusable="false" data-lt-ph><circle cx="26" cy="21" r="9" fill="currentColor"/><path d="M6 48c0-10 9-15 20-15s20 5 20 15" fill="currentColor"/></svg>
                {%- endif -%}
              </div>
              <div>
                <h3 class="tsp__name" data-lt-name>{{ bs.name | default: fb_customer | escape }}</h3>
                <p class="tsp__role" data-lt-role{% if bs.role == blank %} hidden{% endif %}>{{ bs.role | escape }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="tsp__nav lt-nav">
        <button type="button" class="lt-arrow" data-lt-prev data-tsp-prev aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="lt-dots" data-lt-dots data-label="{{ 'accessibility.go_to_slide' | t | default: 'Go to slide' }}">
          {%- for b in cards -%}<button type="button" class="lt-dot" data-index="{{ forloop.index0 }}" aria-label="{{ 'accessibility.go_to_slide' | t | default: 'Go to slide' }} {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
        </div>
        <button type="button" class="lt-arrow" data-lt-next data-tsp-next aria-label="{{ 'accessibility.next' | t | default: 'Next' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>
    {%- endif -%}
  </div>
</div>
</div>
</template>

<schema>
{
  "type": "testimonials4",
  "name": "Testimonial Spotlight",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Content width",
      "default": 880
    },
    {
      "id": "star_size",
      "type": "range",
      "label": "Star size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "id": "name_color",
      "type": "color",
      "label": "Name",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Filled star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_border",
      "label": "Arrow border",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_bg_hover",
      "label": "Arrow background (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_color_hover",
      "label": "Arrow icon (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Typography"
    },
    {
      "id": "enable_custom_fonts",
      "type": "checkbox",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "id": "heading_font",
      "type": "font_picker",
      "label": "Heading and quote font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "id": "body_font",
      "type": "font_picker",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "id": "quote_size",
      "type": "range",
      "label": "Quote size (desktop)",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "id": "quote_size_mobile",
      "type": "range",
      "label": "Quote size (mobile)",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Animation"
    },
    {
      "type": "range",
      "id": "autoplay_s",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Auto advance (seconds)",
      "default": 6,
      "info": "0 turns it off. It pauses on hover, off screen and under reduced motion."
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses Theme settings > Animations."
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "Featured review"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "What customers say"
        },
        {
          "type": "range",
          "id": "size",
          "min": 20,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Font size (desktop)",
          "default": 44
        },
        {
          "id": "size_mobile",
          "type": "range",
          "label": "Font size (mobile)",
          "min": 16,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading",
          "default": "<p>Short quotes from people who bought from your store.</p>"
        },
        {
          "type": "range",
          "id": "size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 16
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "label": "Star rating",
          "info": "Any value from 0.5 to 5; stars fill to the exact rating. 0 shows no stars. Use the rating your customer gave.",
          "default": 0
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Quote",
          "default": "Write what this customer said about your product."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / title",
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Spotlight",
      "category": "Testimonials",
