<template>
<section class="fbg{% if settings.show_dots %} fbg--dots{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --fbg-btn-text: {{ settings.button_text_color }}; --fbg-head-bg: {{ settings.head_bg }}; --s-text: {{ settings.text_color }}; --s-heading: {{ settings.heading_color }}; --s-border: {{ scheme.border }}; --s-card: {{ settings.card_bg }}; --fbg-accent: {{ settings.accent_color }}; --s-radius: {{ settings.card_radius }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="fbg__in fbg__in--{{ settings.max_width }}">

    {% if settings.heading_accent or settings.heading or settings.subheading or settings.button_text %}
      <div class="fbg__head fbg__head--{{ settings.head_layout }}">
        <div class="fbg__head-text">
        <h2 class="fbg__h">
          {% if settings.heading_accent %}<span class="fbg__h-accent">{{ settings.heading_accent | raw }}</span>{% endif %}
          {% if settings.heading %}<span class="fbg__h-main">{{ settings.heading | raw }}</span>{% endif %}
        </h2>
        {% if settings.subheading %}<div class="fbg__sub">{{ settings.subheading | raw }}</div>{% endif %}
        {% if settings.badges %}<ul class="fbg__badges">{% for line in settings.badges | lines %}<li class="fbg__badge"><span class="fbg__chip-mark" aria-hidden="true"></span>{{ line }}</li>{% endfor %}</ul>{% endif %}
        {% if settings.button_text %}<a class="fbg__btn" data-theme-button="primary" data-sl-button style="--mb-bg: var(--fbg-accent); --mb-text: var(--fbg-btn-text);" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
        </div>
        {% if settings.head_layout == 'split' %}
          <div class="fbg__head-media">
            {% if settings.head_image %}<img src="{{ settings.head_image | asset }}" alt="{{ settings.head_image_alt }}" width="800" height="1000" decoding="async">{% elsif page.in_editor %}<div class="fbg__empty fbg__head-empty"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a product photo</span></div>{% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="fbg__grid">{% endif %}
      <article class="fbg__card fbg__card--{{ block.settings.width }}" data-block-id="{{ block.id }}">
        {% if block.settings.image or block.settings.decoration != 'none' or page.in_editor %}
        <div class="fbg__media fbg__media--{{ block.settings.decoration }}">

          {% if block.settings.image %}
            <div class="fbg__pic">
              <img src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" width="960" height="600" loading="lazy" decoding="async">
            </div>
          {% elsif page.in_editor %}
            {% if block.settings.decoration != 'chips' %}
              <div class="fbg__pic fbg__pic--empty">
                <div class="fbg__empty">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg>
                  <span>{{ block.settings.image_hint }}</span>
                </div>
              </div>
            {% endif %}
          {% endif %}

          {% if block.settings.decoration == 'chips' %}
            <svg class="fbg__chart" viewBox="0 0 400 240" preserveAspectRatio="none" aria-hidden="true">
              <polygon class="fbg__area" points="0,240 90,214 170,176 230,150 300,82 370,24 370,240"/>
              <polyline class="fbg__line" points="0,240 90,214 170,176 230,150 300,82 370,24"/>
            </svg>
            <span class="fbg__dot" aria-hidden="true"></span>
            <ul class="fbg__chips">
              {% for line in block.settings.items | lines %}
                <li class="fbg__chip"><span class="fbg__chip-mark" aria-hidden="true"></span>{{ line }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if block.settings.decoration == 'callouts' %}
            <ol class="fbg__pills">
              {% for line in block.settings.items | lines %}
                <li class="fbg__pill">{{ line }}</li>
              {% endfor %}
            </ol>
          {% endif %}

        </div>
        {% endif %}
        <div class="fbg__body">
          {% if block.settings.title %}<h3 class="fbg__title">{{ block.settings.title | raw }}</h3>{% endif %}
          {% if block.settings.text %}<div class="fbg__text">{{ block.settings.text | raw }}</div>{% endif %}
        </div>
      </article>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="fbg__none">Add cards in the sidebar</p>{% endif %}
    {% endfor %}

  </div>
</section>
</template>

<style scoped>
.fbg { container-type: inline-size; position: relative; background-color: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); }
.fbg--dots { background-image: radial-gradient(var(--s-border) 1px, transparent 1.6px); background-size: 24px 24px; background-position: 12px 12px; }
.fbg__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.fbg__in--narrow { max-width: 720px; }
.fbg__in--medium { max-width: 960px; }
.fbg__in--large { max-width: 1120px; }
.fbg__in--wide { max-width: var(--theme-page-width, 1280px); }
.fbg__in--full { max-width: none; }

.fbg__head { max-width: 44rem; margin: 0 auto 40px; text-align: center; }
@container (min-width: 760px) { .fbg__head { margin-bottom: 56px; } }
.fbg__h { margin: 0; font-family: var(--theme-font-heading); font-size: var(--section-heading-size, clamp(30px, 5cqi, 36px)); line-height: var(--section-heading-line-height, 1.15); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.02em); text-transform: var(--section-heading-transform, none); color: var(--s-heading); }
.fbg__h-accent, .fbg__h-main { display: block; }
.fbg__h-accent { color: var(--fbg-accent); }
.fbg__sub { max-width: 34rem; margin: 16px auto 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.65); color: var(--s-text); }
.fbg__sub > :first-child { margin-top: 0; }
.fbg__head--split { max-width: none; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); align-items: center; gap: 16px; text-align: left; background: var(--fbg-head-bg); border-radius: 0; margin-inline: calc(-1 * var(--theme-padding-x, 24px)); padding: 32px 0 32px var(--theme-padding-x, 24px); overflow: hidden; }
.fbg__head--split .fbg__btn { padding: 12px 20px; white-space: nowrap; }
.fbg__head--split .fbg__h { font-size: clamp(30px, 8cqi, 56px); line-height: 1.05; }
.fbg__head--split .fbg__sub { margin-left: 0; font-size: 15px; }
.fbg__head-media { position: relative; align-self: stretch; min-height: 220px; }
.fbg__head-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: var(--s-radius) 0 0 var(--s-radius); }
.fbg__head-empty { position: absolute; inset: 0 16px 0 0; }
.fbg__badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
.fbg__head--center .fbg__badges { justify-content: center; }
.fbg__badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px; font-size: 11px !important; border: 1px solid var(--s-border); border-radius: 8px; background: var(--s-bg); font-size: 12px; font-weight: 500; color: var(--s-heading); }
@container (min-width: 760px) { .fbg__head--split { gap: 32px; padding: 64px 0 64px max(var(--theme-padding-x, 24px), 56px); } .fbg__head--split .fbg__btn { padding: 12px 28px; } .fbg__head-media { min-height: 360px; } .fbg__badge { font-size: 13px !important; padding: 6px 10px; } .fbg__head--split { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }
.fbg__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 24px; padding: 12px 28px; border-radius: 8px; background: var(--fbg-accent); color: var(--fbg-btn-text); font-size: 15px; font-weight: 600; text-decoration: none; transition: opacity 150ms ease; }
.fbg__btn:hover { opacity: 0.88; }
.fbg__btn:focus-visible { outline: 2px solid var(--fbg-accent); outline-offset: 3px; }
.fbg__body:first-child { padding-top: 28px; }
.fbg__sub > :last-child { margin-bottom: 0; }

.fbg__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
@container (min-width: 760px) {
  .fbg__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px; }
  .fbg__card--wide { grid-column: span 4; }
  .fbg__card--narrow { grid-column: span 2; }
}

.fbg__card { display: flex; flex-direction: column; min-width: 0; background: var(--s-card); border: 1px solid var(--s-border); border-radius: var(--s-radius); overflow: hidden; transition: transform 200ms ease; }
.fbg__card:hover { transform: translateY(-2px); }

.fbg__media { position: relative; flex: 1 1 auto; display: grid; min-height: 240px; -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%); mask-image: linear-gradient(to bottom, #000 62%, transparent 100%); }
@container (min-width: 760px) { .fbg__media { min-height: 300px; } }
.fbg__pic { position: relative; grid-area: 1 / 1; min-height: 240px; }
.fbg__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
.fbg__pic--empty { display: grid; padding: 24px 24px 0; }
.fbg__empty { display: grid; place-content: center; justify-items: center; gap: 8px; border: 1px dashed var(--s-border); border-radius: 8px; font-size: 14px; color: var(--s-text); text-align: center; padding: 16px; }
.fbg__empty svg { width: 40px; height: 40px; fill: none; stroke: currentColor; stroke-width: 1.5; opacity: 0.6; }

.fbg__chart { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.fbg__area { fill: var(--fbg-accent); opacity: 0.1; }
.fbg__line { fill: none; stroke: var(--fbg-accent); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
.fbg__dot { position: absolute; left: 92.5%; top: 10%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--s-bg); border: 3px solid var(--fbg-accent); animation: fbg-pulse 2.4s ease-out infinite; }
@keyframes fbg-pulse {
  0% { box-shadow: 0 0 0 0 var(--fbg-accent); }
  70% { box-shadow: 0 0 0 12px transparent; }
  100% { box-shadow: 0 0 0 0 transparent; }
}
.fbg__chips { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
.fbg__chip { position: absolute; display: flex; align-items: center; gap: 8px; max-width: 78%; padding: 10px 14px; background: var(--s-bg); border: 1px solid var(--s-border); border-radius: 8px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05); font-size: 13px; font-weight: 500; line-height: 1.35; color: var(--s-heading); }
.fbg__chip:nth-child(1) { left: 8%; top: 10%; }
.fbg__chip:nth-child(2) { left: 22%; top: 33%; }
.fbg__chip:nth-child(3) { left: 12%; top: 56%; }
.fbg__chip:nth-child(n+4) { display: none; }
.fbg__chip-mark { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--fbg-accent); }

.fbg__media--callouts { grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr); align-items: center; gap: 20px; padding: 24px 0 0 16px; }
@container (min-width: 640px) { .fbg__media--callouts { grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: 32px; padding-left: 32px; } }
.fbg__media--callouts .fbg__pic { grid-area: 1 / 2; }
.fbg__pills { grid-area: 1 / 1; position: relative; z-index: 1; margin: 0; padding: 0; list-style: none; display: grid; gap: 24px; counter-reset: fbg-n; }
.fbg__pill { position: relative; display: flex; align-items: center; gap: 8px; width: fit-content; max-width: 100%; padding: 6px 12px 6px 6px; border-radius: 999px; background: var(--s-heading); color: var(--s-bg); font-size: 12px; font-weight: 500; line-height: 1.3; counter-increment: fbg-n; }
.fbg__pill::before { content: counter(fbg-n); flex: none; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--s-bg); color: var(--s-heading); font-size: 11px; font-weight: 700; }
.fbg__pill::after { content: ""; position: absolute; left: 100%; top: 50%; width: 24px; height: 1px; background: var(--s-border); }
@container (min-width: 640px) { .fbg__pill { font-size: 13px; } .fbg__pill::after { width: 40px; } }

.fbg__body { padding: 8px 20px 24px; }
@container (min-width: 760px) { .fbg__body { padding: 8px 28px 28px; } }
.fbg__title { margin: 0; font-family: var(--theme-font-heading); font-size: clamp(20px, 3cqi, 24px); line-height: 1.2; font-weight: 800; letter-spacing: -0.01em; color: var(--s-heading); }
.fbg__text { max-width: 36rem; margin-top: 12px; font-size: 16px; line-height: 1.6; color: var(--s-text); }
.fbg__text > :first-child { margin-top: 0; }
.fbg__text > :last-child { margin-bottom: 0; }

.fbg__none { margin: 0; padding: 32px 0; text-align: center; font-size: 14px; color: var(--s-text); opacity: 0.7; }

@media (prefers-reduced-motion: reduce) { .fbg__dot { animation: none; } .fbg__card { transition: none; } .fbg__card:hover { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "feature_bento_grid",
  "name": "Feature bento grid",
  "category": "features",
  "description": "A centred two-tone heading over a bento of wide and narrow cards, each with a picture, a title and a line.",
  "version": "1.0.0",
  "icon": "layout",
  "settings": [
    {"type":"header","id":"hdr_content","label":"Content"},
    {"type":"inline_richtext","id":"heading_accent","label":"Heading, first line (accent)","default":"Build & Customize"},
    {"type":"inline_richtext","id":"heading","label":"Heading, second line","default":"your dream online store"},
    {"type":"richtext","id":"subheading","label":"Supporting line","default":"<p>Build a store that looks amazing and sells without code, stress, or limitations.</p>"},
    {"type":"textarea","id":"badges","label":"Small badges, one per line","default":""},
    {"type":"text","id":"button_text","label":"Button","default":""},
    {"type":"url","id":"button_url","label":"Button link","default":"/products"},
    {"type":"header","id":"hdr_layout","label":"Layout"},
    {"type":"select","id":"head_layout","label":"Heading layout","default":"center","options":[{"label":"Centred above the cards","value":"center"},{"label":"Hero band with a picture","value":"split"}]},
    {"type":"image_picker","id":"head_image","label":"Hero picture","default":"","visible_if":"{{ section.settings.head_layout == 'split' }}"},
    {"type":"text","id":"head_image_alt","label":"Hero picture description","default":"The product","visible_if":"{{ section.settings.head_layout == 'split' }}"},
    {"type":"select","id":"max_width","label":"Content width","default":"large","options":[{"label":"Narrow","value":"narrow"},{"label":"Medium","value":"medium"},{"label":"Large","value":"large"},{"label":"Wide","value":"wide"},{"label":"Full","value":"full"}]},
    {"type":"range","id":"card_radius","label":"Card corners","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"header","id":"hdr_style","label":"Style"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"white"},
    {"type":"toggle","id":"show_dots","label":"Dotted background","default":true},
    {"type":"color","id":"accent_color","label":"Accent (first heading line, chart)","default":"#4B5EF0"},
    {"type":"color","id":"heading_color","label":"Headings","default":"scheme.heading"},
    {"type":"color","id":"text_color","label":"Text","default":"scheme.text"},
    {"type":"color","id":"card_bg","label":"Card background","default":"scheme.background_secondary"},
    {"type":"color","id":"head_bg","label":"Hero band background","default":"#fdf0f1"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"scheme.primary_button_text"},
    {"type":"header","id":"hdr_spacing","label":"Spacing"},
    {"type":"range","id":"padding_top","label":"Top padding","default":36,"min":0,"max":160,"step":4,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","default":36,"min":0,"max":160,"step":4,"unit":"px"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 8,
      "settings": [
        {"type":"inline_richtext","id":"title","label":"Title","default":"Card title"},
        {"type":"richtext","id":"text","label":"Description","default":"<p>One or two sentences about this part of what you offer.</p>"},
        {"type":"select","id":"width","label":"Card width","default":"wide","info":"On wider screens a row holds one wide and one narrow card.","options":[{"label":"Wide","value":"wide"},{"label":"Narrow","value":"narrow"}]},
        {"type":"image_picker","id":"image","label":"Picture","default":""},
        {"type":"text","id":"image_alt","label":"Picture description","default":"Preview of the feature"},
        {"type":"text","id":"image_hint","label":"Empty picture note","default":"Add a picture for this card"},
        {"type":"select","id":"decoration","label":"Extra drawing","default":"none","options":[{"label":"None","value":"none"},{"label":"Numbered labels beside the picture","value":"callouts"},{"label":"Notes over a rising line","value":"chips"}]},
        {"type":"textarea","id":"items","label":"Labels, one per line","default":"","visible_if":"{{ block.settings.decoration != 'none' }}"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature bento grid",
      "blocks": [
        {"type":"card","settings":{"title":"Premium Templates","text":"<p>Launch faster with professionally designed templates built for modern brands, and higher conversions.</p>","width":"wide","decoration":"none","image_alt":"A row of store templates","image_hint":"Add a picture of your templates"}},
        {"type":"card","settings":{"title":"CVR Optimized","text":"<p>Carefully designed layouts and well-tested conversion techniques.</p>","width":"narrow","decoration":"chips","items":"Reviews beside the buy button\nBundles shown before checkout\nOrder today, ships by April 21","image_alt":"","image_hint":"Optional picture behind the chart"}},
        {"type":"card","settings":{"title":"Bundles & Upsells","text":"<p>Smart pricing tiers that increase order values and boost revenue.</p>","width":"narrow","decoration":"none","image_alt":"A quantity picker with bundle prices","image_hint":"Add a picture of a pricing-tier picker"}},
        {"type":"card","settings":{"title":"Advanced Cart","text":"<p>Cart drawer with a progress bar, banners, and more.</p>","width":"wide","decoration":"callouts","items":"Cart Header\nFree Shipping Progress\nProduct Summary\nIn-Cart Upsells\nDiscount Code Field","image_alt":"A cart drawer on a phone","image_hint":"Add a picture of your cart drawer"}}
      ]
    },
    {
      "name": "Feature bento grid on dark",
      "settings": {"color_scheme":"dark","show_dots":false},
      "blocks": [
        {"type":"card","settings":{"title":"Premium Templates","text":"<p>Launch faster with professionally designed templates built for modern brands, and higher conversions.</p>","width":"wide","decoration":"none","image_alt":"A row of store templates","image_hint":"Add a picture of your templates"}},
        {"type":"card","settings":{"title":"CVR Optimized","text":"<p>Carefully designed layouts and well-tested conversion techniques.</p>","width":"narrow","decoration":"chips","items":"Reviews beside the buy button\nBundles shown before checkout\nOrder today, ships by April 21","image_alt":"","image_hint":"Optional picture behind the chart"}},
        {"type":"card","settings":{"title":"Bundles & Upsells","text":"<p>Smart pricing tiers that increase order values and boost revenue.</p>","width":"narrow","decoration":"none","image_alt":"A quantity picker with bundle prices","image_hint":"Add a picture of a pricing-tier picker"}},
        {"type":"card","settings":{"title":"Advanced Cart","text":"<p>Cart drawer with a progress bar, banners, and more.</p>","width":"wide","decoration":"callouts","items":"Cart Header\nFree Shipping Progress\nProduct Summary\nIn-Cart Upsells\nDiscount Code Field","image_alt":"A cart drawer on a phone","image_hint":"Add a picture of your cart drawer"}}
      ]
    }
  ]
}
</schema>
