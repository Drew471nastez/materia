  "shopify": {
    "enabled_on": {
      "groups": [
        "header",
        "template"
      ]
    },
    "name": "Marquee Bar",
    "tag": "section",
    "class": "scrollingbar section-edge-bleed",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "Each Marquee block is one item: text, an image or an SVG icon. Drag blocks to reorder them."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "number",
        "id": "inner_width",
        "label": "Strip max width (px)",
        "default": 1920,
        "info": "0 for no limit"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color_background",
        "id": "background_gradient",
        "label": "Background gradient",
        "info": "Used instead of the background colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: the text follows Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "select",
        "id": "text_weight",
        "label": "Text weight",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "100",
            "label": "Thin"
          },
          {
            "value": "200",
            "label": "Extra Light"
          },
          {
            "value": "300",
            "label": "Light"
          },
          {
            "value": "400",
            "label": "Regular"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi Bold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra Bold"
          },
          {
            "value": "900",
            "label": "Black"
          }
        ],
        "default": "theme"
      },
      {
        "type": "range",
        "id": "desktop_text_size",
        "label": "Text size (desktop)",
        "min": 5,
        "max": 145,
        "step": 5,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "number",
        "id": "duration",
        "label": "Loop duration (seconds)",
        "default": 30,
        "info": "Lower is faster. Stops for visitors who reduce motion."
      },
      {
        "type": "select",
        "id": "direction",
        "label": "Direction",
        "options": [
          {
            "label": "To left",
            "value": "normal"
          },
          {
            "label": "To right",
            "value": "reverse"
          }
        ],
        "default": "reverse"
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": true
      },
      {
        "type": "range",
        "id": "repeat_count",
        "label": "Copies of the items",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 3,
        "info": "Enough copies to fill a wide screen with no gap."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "desktop_item_gap",
        "label": "Gap between items (desktop)",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "desktop_top_padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Top padding (desktop)",
        "default": 14
      },
      {
        "type": "range",
        "id": "desktop_bottom_padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Bottom padding (desktop)",
        "default": 14
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "mobile_text_size",
        "label": "Text size (mobile)",
        "min": 8,
        "max": 64,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mobile_item_gap",
        "label": "Gap between items (mobile)",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mobile_top_padding",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Top padding (mobile)",
        "default": 14
      },
      {
        "type": "range",
        "id": "mobile_bottom_padding",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Bottom padding (mobile)",
        "default": 14
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "text",
        "id": "html_id",
        "label": "HTML ID"
      },
      {
        "type": "text",
        "id": "html_class",
        "label": "HTML class",
        "info": "Comma separated list of classes."
      }
    ],
    "blocks": [
      {
        "type": "marquee",
        "name": "Marquee",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Write your message"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Shown when there is no SVG icon"
          },
          {
            "type": "textarea",
            "id": "svg_icon",
            "label": "SVG icon code",
            "info": "Used instead of the image"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "enable_svg_icon_color",
            "label": "Recolour the SVG icon",
            "default": false,
            "visible_if": "{{ block.settings.svg_icon != blank }}"
          },
          {
            "type": "color",
            "id": "svg_icon_color",
            "label": "SVG icon colour",
            "visible_if": "{{ block.settings.svg_icon != blank and block.settings.enable_svg_icon_color }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "header",
            "content": "Icon size"
          },
          {
            "type": "range",
            "id": "svg_icon_size_desktop",
            "label": "SVG icon size (desktop)",
            "min": 0,
            "max": 160,
            "step": 10,
            "default": 40,
            "unit": "px",
            "visible_if": "{{ block.settings.svg_icon != blank }}"
          },
          {
            "type": "range",
            "id": "svg_icon_size_mobile",
            "label": "SVG icon size (mobile)",
            "min": 0,
            "max": 120,
            "step": 10,
            "default": 20,
            "unit": "px",
            "visible_if": "{{ block.settings.svg_icon != blank }}"
          },
          {
            "type": "range",
            "id": "svg_icon_vertical_offset",
            "label": "SVG icon vertical offset",
            "min": -100,
            "max": 100,
            "step": 5,
            "default": 5,
            "unit": "px",
            "visible_if": "{{ block.settings.svg_icon != blank }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Marquee Bar",
        "category": "Announcements",
        "blocks": [
          {
            "type": "marquee",
            "settings": {
              "text": "Your first message"
