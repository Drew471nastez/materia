<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    /* Keep the marquee strictly below the header section in the
       stacking order. The header-group renders the header first
       and the marquee after, but the theme's default rule gives
       non-header header-group children z-index: 12, which can
       cause the marquee's background strip to read as overlapping
       the header (especially when the header has near-zero padding
       and its action icons / count bubbles extend close to the
       section edge). z-index: 5 here is below the header's z-index
       so this can never happen. */
    z-index: 5 !important;
  }
  /* Aggressive typography for marquee */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section width — CSS-only, no HTML wrapper */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} { padding-inline: 1.5rem; box-sizing: border-box; }
      @media (min-width: 1200px) { #shopify-section-{{ section.id }} { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- liquid
  assign __ab_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ab_reveal = section.settings.reveal
-%}
<style>
  /* Theme typography for announcement bars */
  #shopify-section-{{ section.id }} { font-family: var(--body-font, inherit); }
{% comment %}{% endcomment %}</style>
<!-- ab-theme:start -->
{%- comment -%} sections/marquee-bar.liquid {%- endcomment -%}
{% stylesheet %}   
  .scrolling-marquee-1 .scrolling__marquee {
    overflow: hidden;
    padding-block: var(--scrolling-padding-top, 14px) var(--scrolling-padding-bottom, 14px);
    gap: var(--scrolling-item-gap, 40px);
    background: var(--scrolling-background-color, #FFDD00);
    display: flex;
    margin-inline: auto;
    max-width: var(--scrolling-section-width, 1920px);
    width: 100%;
  }

  .scrolling-marquee-1 .scrolling__marquee a { color: inherit; }

  .scrolling-marquee-1 .scrolling__marquee-wrapper {
    animation: scrollingMarqueeRightToLeft var(--scrolling-animation-duration, 30s) linear infinite;
    gap: var(--scrolling-item-gap, 40px);
    width: max-content;
    flex-shrink: 0;
    display: flex;
    animation-direction: var(--scrolling-animation-direction, reverse);
  }

  .scrolling-marquee-1 .scrolling__marquee:hover .scrolling__marquee-wrapper {
    animation-play-state: var(--scrolling-pause-on-hover, paused);
  }

  @keyframes scrollingMarqueeRightToLeft {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc((-100% - var(--scrolling-item-gap)))); }
  }

  .scrolling-marquee-1 .scrolling__marquee-item {
    font-size: var(--scrolling-text-size, 48px);
    font-weight: var(--scrolling-font-weight, 400);
    color: var(--scrolling-text-color, #000000);
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-shrink: 0;
    position: relative;
  }

  .scrolling-marquee-1 .scrolling__marquee-item a { text-decoration: none; }

  .scrolling-marquee-1 .scrolling__marquee-img {
    width: 60px;
  }

  /* SVG support (per-block size, optional colorize, vertical offset) */
  .scrolling-marquee-1 .scrolling__marquee-item--icon {
    transform: translateY(var(--svg-icon-offset-y, 0px)); /* why: allow per-block vertical positioning */
    will-change: transform;
  }

  .scrolling-marquee-1 .scrolling__marquee-svg-wrap svg {
    width: var(--svg-size-mobile, 24px);
    height: auto;
  }
  @media screen and (min-width: 768px) {
    .scrolling-marquee-1 .scrolling__marquee-svg-wrap svg {
      width: var(--svg-size-desktop, 24px);
    }
  }

  /* Only recolor when explicitly enabled; never force fills */
  .scrolling-marquee-1 .scrolling__marquee-svg-wrap[data-colorize="true"] svg,
  .scrolling-marquee-1 .scrolling__marquee-svg-wrap[data-colorize="true"] svg * {
    stroke: var(--svg-color, currentColor) !important; /* why: recolor strokes only, preserve fills */
  }
{% endstylesheet %}

{%- capture html_id -%}
  {%- if section.settings.html_id != blank -%}
    id="{{ section.settings.html_id | handleize }}"
  {%- endif -%}
{%- endcapture -%}

<style>
  #scrolling-{{ section.id }} {
    --scrolling-item-gap: {{ section.settings.mobile_item_gap }}px;
    --scrolling-padding-top: {{ section.settings.mobile_top_padding }}px;
    --scrolling-padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
    --scrolling-background-color: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %}{% endif %} !important;
    --scrolling-text-color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %} !important;
    --scrolling-animation-duration: {{ section.settings.duration }}s;
    --scrolling-text-size: {{ section.settings.mobile_text_size }}px;
    --scrolling-section-width: {% if section.settings.inner_width > 0 %}{{ section.settings.inner_width }}px{% else %}none{% endif %};
    --scrolling-pause-on-hover: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};
    --scrolling-animation-direction: {{ section.settings.direction }};
    --scrolling-font-weight: {% if section.settings.text_weight == 'theme' or section.settings.text_weight == blank %}var(--body-weight, 500){% else %}{{ section.settings.text_weight }}{% endif %};
  }

  @media screen and (min-width: 768px) {
    #scrolling-{{ section.id }} {
      --scrolling-item-gap: {{ section.settings.desktop_item_gap }}px;
      --scrolling-padding-top: {{ section.settings.desktop_top_padding }}px;
      --scrolling-padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
      --scrolling-text-size: {{ section.settings.desktop_text_size }}px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #scrolling-{{ section.id }} .scrolling__marquee { overflow-x: auto; }
    #scrolling-{{ section.id }} .scrolling__marquee-wrapper { animation: none; }
  }
{% comment %}{% endcomment %}</style>

{% capture marquee_wrapper %}
  <div class="scrolling__marquee-wrapper">
    {%- for block in section.blocks -%}
      <div class="scrolling__marquee-item">
        {{ block.settings.text }}
      </div>

      {% if block.settings.svg_icon != blank %}
        <div
          class="scrolling__marquee-item scrolling__marquee-item--icon"
          style="
            --svg-size-mobile: {{ block.settings.svg_icon_size_mobile }}px;
            --svg-size-desktop: {{ block.settings.svg_icon_size_desktop }}px;
            --svg-color: {% render 'scheme-color', color: block.settings.svg_icon_color, fallback: 'currentColor' %} !important;
            --svg-icon-offset-y: {{ block.settings.svg_icon_vertical_offset | default: 0 }}px;
          "
        >
          <div
            class="scrolling__marquee-svg-wrap"
            data-colorize="{% if block.settings.enable_svg_icon_color %}true{% else %}false{% endif %}"
          >
            {{ block.settings.svg_icon }}
          </div>
        </div>
      {% elsif block.settings.image != blank %}
        <div class="scrolling__marquee-item">
          {{ block.settings.image | image_url: width: 60 | image_tag: loading: 'lazy', class: "scrolling__marquee-img" }}
        </div>
      {% else %}
        {%- capture demo_mq -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}
        {%- assign demo_mq = demo_mq | strip -%}
        {%- if demo_mq != blank -%}
          <div class="scrolling__marquee-item">
            <img src="{{ demo_mq }}" class="scrolling__marquee-img" loading="lazy" alt="">
          </div>
        {%- endif -%}
      {% endif %}
    {% endfor %}
  </div>
{% endcapture %}

<div id="scrolling-{{ section.id }}" class="scrolling-{{ section.id }} scrolling-marquee-1 color-{{ color_scheme }} gradient">
  <div {{ html_id }} class="{{ 'scrolling__marquee ' | append: section.settings.html_class | strip }}">
    {%- for i in (1..section.settings.repeat_count) -%}
      {{ marquee_wrapper }}
    {%- endfor -%}
  </div>
</div>



</template>

<schema>
{
  "type": "marquee-bar",
  "name": "Marquee Bar",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "label": "Desktop: text size",
      "min": 5,
      "max": 145,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile: text size",
      "min": 8,
      "max": 64,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "100",
          "label": "Thin"
        },
        {
          "value": "200",
          "label": "Extra Light"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "theme"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "info": "Overrides background color"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Behavior & Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "number",
      "id": "duration",
      "label": "Duration (s)",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "normal",
          "label": "To left"
        },
        {
          "value": "reverse",
          "label": "To right"
        }
      ],
      "default": "reverse"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Number of repetitions",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Layout & Spacing"
    },
    {
      "type": "number",
      "id": "inner_width",
      "label": "Max width (px)",
      "default": 1920,
      "info": "0 for no limit"
    },
    {
      "type": "range",
      "id": "desktop_item_gap",
      "label": "Desktop: item gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_item_gap",
      "label": "Mobile: item gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop: top padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop: bottom padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile: top padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile: bottom padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Advanced"
    },
    {
      "type": "text",
      "id": "html_id",
      "label": "HTML ID"
    },
    {
      "type": "text",
      "id": "html_class",
      "label": "HTML Class",
      "info": "Comma separated list of classes."
    }
  ],
  "blocks": [
    {
      "type": "marquee",
      "name": "Marquee",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Get 15% Off Sale"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "svg_icon",
          "label": "SVG icon code",
          "info": "Overrides the image"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_svg_icon_color",
          "label": "Enable SVG icon custom color",
          "default": false
        },
        {
          "type": "color",
          "id": "svg_icon_color",
          "label": "SVG icon color",
          "visible_if": "{{ block.settings.enable_svg_icon_color }}"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "svg_icon_size_desktop",
          "label": "SVG icon size (desktop)",
          "min": 0,
          "max": 160,
          "step": 10,
          "default": 40,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "svg_icon_size_mobile",
          "label": "SVG icon size (mobile)",
          "min": 0,
          "max": 120,
          "step": 10,
          "default": 20,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "svg_icon_vertical_offset",
          "label": "SVG icon vertical position (Y)",
          "min": -100,
          "max": 100,
          "step": 5,
          "default": 5,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Bar",
      "category": "Announcements",
      "blocks": [
        {
          "type": "marquee",
          "settings": {
            "text": "Get 15% Off Sale"
          }
        },
        {
          "type": "marquee",
          "settings": {
            "text": "Get 15% Off Sale"
          }
        },
        {
          "type": "marquee",
          "settings": {
            "text": "Get 15% Off Sale"
          }
        },
        {
          "type": "marquee",
          "settings": {
            "text": "Get 15% Off Sale"
          }
        },
        {
          "type": "marquee",
          "settings": {
            "text": "Get 15% Off Sale"
          }
        }
      ]
    }
  ],
  "shopify": {
    "enabled_on": { "groups": ["header", "template"] },
    "name": "Marquee Bar",
    "tag": "section",
    "class": "scrollingbar section-edge-bleed",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "desktop_text_size",
        "label": "Desktop: text size",
        "min": 5,
        "max": 145,
        "step": 5,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mobile_text_size",
        "label": "Mobile: text size",
        "min": 8,
        "max": 64,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "text_weight",
        "label": "Text weight",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "100",
