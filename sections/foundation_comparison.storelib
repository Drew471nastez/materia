<template>
<section class="fw fw-compare" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ settings.heading_color }};--fw-text:{{ settings.text_color }};--fw-muted:{{ settings.text_color }};--fw-line:{{ settings.border_color }};--fw-accent:{{ settings.overline_color }};--fw-featured:{{ settings.featured_color }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner">
  {% if settings.eyebrow or settings.heading or settings.body %}<div class="fw-compare__intro">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}{% if settings.heading %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% endif %}{% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}</div>{% endif %}
  {% if blocks.size > 0 %}
  <div class="fw-compare__scroll" role="region" tabindex="0" aria-label="{{ settings.heading | default: settings.ours_heading }}"><table><thead><tr><th scope="col">{{ settings.feature_heading }}</th><th scope="col" class="fw-compare__featured">{{ settings.ours_heading }}</th><th scope="col">{{ settings.theirs_heading }}</th></tr></thead>
  <tbody>{% for block in blocks %}<tr data-block-id="{{ block.id }}"><th scope="row">{{ block.settings.label }}</th><td class="fw-compare__featured">{{ block.settings.ours }}</td><td>{{ block.settings.theirs }}</td></tr>{% endfor %}</tbody></table></div>
  {% elsif page.in_editor %}<p class="fw-compare__empty">Add comparison rows in the sidebar.</p>{% endif %}
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--theme-font-body,var(--body-font,inherit));}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) var(--theme-padding-x,clamp(16px,4cqi,48px)) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:var(--sl-caption-size,12px);font-weight:var(--sl-caption-weight,700);letter-spacing:var(--sl-caption-tracking,.14em);text-transform:var(--sl-caption-transform,uppercase);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading,var(--heading-font,inherit)));font-size:var(--section-heading-size,clamp(28px,6cqi,56px));font-weight:var(--section-heading-weight,650);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.03em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:16px 0 0;font-size:var(--section-text-size,16px);line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw .fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-weight:var(--type-button-weight,650);font-size:var(--sl-button-size,var(--type-button-size,15px));letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text);border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw .fw__action:hover{background:var(--fw-button-hover,var(--fw-button));border-color:var(--fw-button-hover,var(--fw-button));color:var(--fw-button-hover-text,var(--fw-button-text));}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible,.fw [tabindex]:focus-visible{outline:2px solid currentColor;outline-offset:3px;}
@media(prefers-reduced-motion:reduce){.fw *,.fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-compare__intro{max-width:750px;margin:0 auto 36px;text-align:center}
.fw-compare__intro .fw__lede{margin-inline:auto}
.fw-compare__scroll{overflow-x:auto;overscroll-behavior-x:contain;max-width:100%;border-radius:14px;border:1px solid var(--fw-line)}
.fw-compare table{border-collapse:collapse;width:100%;font-size:14px}
.fw-compare th,.fw-compare td{padding:14px 10px;overflow-wrap:anywhere;border-bottom:1px solid var(--fw-line);text-align:left;line-height:1.4}
.fw-compare th{font-weight:var(--subheading-weight,650);color:var(--fw-title)}
.fw-compare thead th{background:color-mix(in srgb,var(--fw-text) 4%,transparent)}
.fw-compare tr:last-child th,.fw-compare tr:last-child td{border-bottom:0}
.fw-compare__featured{background:color-mix(in srgb,var(--fw-featured) 14%,transparent);font-weight:var(--subheading-weight,650);color:var(--fw-title)}
.fw-compare__empty{margin:0;text-align:center;font-size:14px;color:var(--fw-muted)}
@container (min-width:601px){.fw-compare th,.fw-compare td{padding:20px 22px}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_comparison",
  "name": "Foundation / Comparison table",
  "category": "features",
  "description": "Editable two-column comparison with clear rows and mobile-friendly table.",
  "version": "1.0.0",
  "icon": "columns",
  "settings": [
    {
      "type": "header",
      "id": "hdr_general",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "light"
    },
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "THE DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The details, side by side."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Supporting text",
      "default": "How this compares with other options, row by row."
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "First column heading",
      "default": "Features"
    },
    {
      "type": "text",
      "id": "ours_heading",
      "label": "Featured column heading",
      "default": "This collection"
    },
    {
      "type": "text",
      "id": "theirs_heading",
      "label": "Comparison heading",
      "default": "Other options"
    },
    {
      "type": "header",
      "id": "hdr_colours",
      "label": "Colours"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "scheme.text"
    },
    {
      "type": "color",
      "id": "overline_color",
      "label": "Overline",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lines",
      "default": "scheme.border"
    },
    {
      "type": "color",
      "id": "featured_color",
      "label": "Featured column",
      "default": "scheme.accent"
    },
    {
      "type": "header",
      "id": "hdr_animation",
      "label": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "none",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "slide_left",
          "label": "From the right"
        },
        {
          "value": "slide_right",
          "label": "From the left"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [],
  "blocks": [
    {
      "type": "item",
      "name": "Comparison row",
      "limit": 15,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature",
          "default": "Considered design"
        },
        {
          "type": "text",
          "id": "ours",
          "label": "Featured value",
          "default": "Included"
        },
        {
          "type": "text",
          "id": "theirs",
          "label": "Comparison value",
          "default": "Varies"
        }
      ]
    }
  ]
}
</schema>