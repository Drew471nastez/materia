<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia: connect to theme-level scroll-animation hook (matches every
  other Materia section so reveal animations stay in sync).
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign section_width = st.section_width | default: 'container'
  assign color_scheme = st.color_scheme
  assign content_alignment = st.content_alignment | default: 'left'
-%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ sid }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  /* Section margin */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .container { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .container { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .container { padding-inline: 1.5rem; box-sizing: border-box; max-width: none; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .container { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .container { padding-inline: 0; max-width: none; }
  {%- endcase -%}

  /* Section padding (desktop) */
  #shopify-section-{{ sid }} .customer-login,
  #shopify-section-{{ sid }} .customer-forgot {
    padding-top: {{ st.padding_top | default: 60 }}px;
    padding-bottom: {{ st.padding_bottom | default: 60 }}px;
  }
  /* Section padding (mobile) */
  @media (max-width: 767.98px) {
    #shopify-section-{{ sid }} .customer-login,
    #shopify-section-{{ sid }} .customer-forgot {
      padding-top: {{ st.padding_top_mobile | default: 40 }}px;
      padding-bottom: {{ st.padding_bottom_mobile | default: 40 }}px;
    }
  }

  /* Heading / subheading */
  #shopify-section-{{ sid }} .title-customer {
    font-size: {{ st.heading_font_size_mobile | default: 24 }}px;
    {% if st.heading_color != blank %}color: {{ st.heading_color }};{% endif %}
    {% if st.enable_custom_font_weight_heading %}font-weight: {{ st.font_weight_heading | default: 600 }};{% endif %}
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .title-customer {
      font-size: {{ st.heading_font_size_desktop | default: 30 }}px;
    }
  }
  #shopify-section-{{ sid }} .subtext,
  #shopify-section-{{ sid }} .content-register p {
    font-size: {{ st.subtext_font_size_mobile | default: 14 }}px;
    {% if st.subtext_color != blank %}color: {{ st.subtext_color }};{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .subtext,
    #shopify-section-{{ sid }} .content-register p {
      font-size: {{ st.subtext_font_size_desktop | default: 16 }}px;
    }
  }

  /* Column gap & alignment */
  #shopify-section-{{ sid }} .customer-login > .container > .flex,
  #shopify-section-{{ sid }} .customer-forgot > .container > .flex {
    --col-gap-desktop: {{ st.column_gap | default: 60 }}px;
    --col-gap: {{ st.column_gap_mobile | default: 40 }}px;
  }
  #shopify-section-{{ sid }} .customer-form,
  #shopify-section-{{ sid }} .content-register {
    text-align: {{ content_alignment }};
  }

  /* Color scheme paints the section background */
  #shopify-section-{{ sid }} .customer-login,
  #shopify-section-{{ sid }} .customer-forgot {
    background: var(--color-background, transparent);
    color: var(--color-text, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'my-account.css' | asset_url | stylesheet_tag }}
<div class="color-{{ color_scheme }} gradient">
<div class="customer-forgot" id="recover">
  <div class="container">
    <div
      class="flex gap-custom-big flex-cols flex-wrap"
      style="
        --col-gap-desktop: 60px;
        --col-gap: 40px;
        --col-desktop: 2;
        --col-number: 1;
      "
    >
      <div class="recover-form customer-form">
        <h3 class="title-customer mt-0">{{ 'customer.recover_password.title' | t }}</h3>
        <p class="subtext mb-20">
          {{ 'customer.recover_password.subtext' | t }}
        </p>
        {%- form 'recover_customer_password' -%}
          {%- assign recover_success = form.posted_successfully? -%}
          {%- if form.errors -%}
            {%- assign message = form.errors | default_errors | strip_html -%}
            <p class="error lh-normal flex gap-10">
              {%- render 'icon-error' -%}
              {{ message }}
            </p>
          {% endif %}
          <div class="form-field form-group  mb-15 flex flex-column form-floating">
            <input
              type="email"
              value=""
              name="email"
              id="RecoverEmail"
              class="form-control"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ 'customer.login_page.placeholder_email' | t }}"
              aria-required="true"
              aria-invalid="true"
              required
            >
            <label class="form-label mb-3" for="RecoverEmail">
              {{ 'customer.recover_password.email' | t }}
              <span class="required">*</span>
            </label>
          </div>
          <div class="form-actions mt-30">
            <input
              type="submit"
              class="btn-primary text-center w-full" data-theme-button="primary" data-sl-button
              value="{{ 'customer.recover_password.submit' | t }}"
            >
          </div>
        {%- endform -%}
      </div>
      <div class="content-register">
        <h3 class="title-customer mt-0">
          {{ 'customer.register.title_content' | t }}
        </h3>
        <p class="mb-30">
          {{ 'customer.register.content' | t }}
        </p>
        <a
          href="{{ routes.account_register_url }}"
          class="btn btn-primary block no-underline text-center" data-theme-button="primary" data-sl-button
        >
          {{- 'customer.register.submit' | t -}}
        </a>
      </div>
    </div>
  </div>
</div>
<div class="customer-login">
  <div class="container">
    <div
      class="flex gap-custom-big flex-cols flex-wrap"
      style="--col-gap-desktop: 60px; --col-gap: 40px; --col-desktop: 2; --col-number: 1;"
    >
      <div class="login-form customer-form">
        <h3 class="title-customer mt-0">
          {{ 'customer.login_page.title' | t }}
        </h3>
        {%- if recover_success == true -%}
          <p class="success flex gap-5">
            {%- render 'icon-success' -%}
            {{ 'customer.recover_password.success' | t }}
          </p>
        {% endif %}
        {%- form 'customer_login', class: 'customer-login-form' -%}
          {%- if form.errors -%}
            {%- assign message = form.errors.messages.form -%}
            <p class="error lh-normal flex gap-10">
              {%- render 'icon-error' -%}
              {{ message }}
            </p>
          {% endif %}
          <div class="form-group mb-15 flex flex-column form-field form-floating">
            
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              class="form-control"
              placeholder="{{ 'customer.login_page.placeholder_email' | t }}"
              required
            >
            <label class="form-label mb-3" for="CustomerEmail">
              {{ 'customer.login_page.email' | t }}
              <span class="required">*</span>
            </label>
          </div>
          {%- if form.password_needed -%}
            <div class="form-group mb-20 flex flex-column  form-field form-floating">
              
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                class="form-control"
                placeholder="{{ 'customer.login_page.placeholder_pass' | t }}"
                required
              >
              <label class="form-label mb-3" for="CustomerPassword">
                {{ 'customer.login_page.password' | t }}
                <span class="required">*</span>
              </label>
            </div>
          {% endif %}
          <div class="form-actions mt-20">
            <a href="#recover" class="forget-password no-underline">
              <span class="text">{{ 'customer.login_page.forgot_password' | t }}</span>
            </a>
            <input
              type="submit"
              class="btn-primary block no-underline mt-30 w-full" data-theme-button="primary" data-sl-button
              value="{{ 'customer.login_page.submit' | t }}"
            >
          </div>
        {%- endform -%}
      </div>
      <div class="content-register">
        <h3 class="title-customer mt-0">
          {{ 'customer.register.title_content' | t }}
        </h3>
        <p class="mb-30">
          {{ 'customer.register.content' | t }}
        </p>
        <a
          href="{{ routes.account_register_url }}"
          class="btn btn-primary inline-block no-underline text-center w-full" data-theme-button="primary" data-sl-button
        >
          {{- 'customer.register.submit' | t -}}
        </a>
      </div>
    </div>
  </div>
</div>
</div>



</template>

<schema>
{
  "type": "main-login",
