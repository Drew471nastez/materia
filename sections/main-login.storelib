<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Sign in (/account/login). Storelib signs a visitor in with
  a six digit code emailed to them, so this is the store's customer_login
  form with one email field and no password; Storelib sends the code and
  draws the code step. The register column links to the same page, where a
  new email makes the account. Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign section_width = st.section_width | default: 'container'
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
<style>
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  #shopify-section-{{ sid }} .ap-login__grid { display: grid; grid-template-columns: 1fr; gap: var(--ap-gap-m, 40px); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ap-login__grid:has(> .ap-login__side:not([hidden])) { grid-template-columns: 1fr 1fr; gap: var(--ap-gap-d, 60px); }
    #shopify-section-{{ sid }} .ap-login__grid:not(:has(> .ap-login__side:not([hidden]))) { max-width: 560px; margin-inline: auto; }
  }
  #shopify-section-{{ sid }} .ap-login__side .ap__t { margin-bottom: 24px; }
  #shopify-section-{{ sid }} .ap-login__side .ap__btn { display: inline-flex; }
{% comment %}{% endcomment %}</style>
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="ap ap-login color-{{ scheme }} gradient"
  data-ap-root="main-login"
  data-ap-section="{{ sid }}"{% if request.design_mode %}
  data-ap-settings="{{ st | json | escape }}"{% endif %}
  {% if st.reset_spacing %}data-ap-reset{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-hfs-d: {{ st.heading_font_size_desktop | default: 30 }}px; --ap-hfs-m: {{ st.heading_font_size_mobile | default: 24 }}px; --ap-tfs-d: {{ st.subtext_font_size_desktop | default: 16 }}px; --ap-tfs-m: {{ st.subtext_font_size_mobile | default: 14 }}px; --ap-gap-d: {{ st.column_gap | default: 0 }}px; --ap-gap-m: {{ st.column_gap_mobile | default: 0 }}px; --ap-align: {{ st.content_alignment | default: 'left' }};{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.subtext_color != blank %} --ap-t-c: {{ st.subtext_color }};{% endif %}{% if st.enable_custom_font_weight_heading %} --heading-weight: {{ st.font_weight_heading | default: 600 }};{% endif %}{{ fonts }}"
>
  <div class="{{ section_width }}" data-ap-width>
    <div class="ap-login__grid">
      <div class="ap-login__form customer-form">
        <h1 class="ap__h title-customer" data-ap-text="heading" data-ap-opt{% if st.heading == blank %} hidden{% endif %}>{{ st.heading | escape }}</h1>
        <div class="ap__t subtext" data-ap-rich="text" data-ap-opt{% if st.text == blank %} hidden{% endif %}>{{ st.text }}</div>
        {%- form 'customer_login', class: 'customer-login-form ap__form' -%}
          {%- if form.errors -%}
            <div class="ap__msg ap__msg--error error" role="alert">
              {%- render 'icon-error' -%}
              <div>
                <span data-ap-text="error_message">{{ st.error_message | escape }}</span>
                {%- assign message = form.errors.messages.form -%}
                {%- if message != blank -%}<span class="ap__msg-detail"> {{ message }}</span>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
          <div class="ap__field">
            <label for="CustomerEmail-{{ sid }}"><span data-ap-text="email_label">{{ st.email_label | escape }}</span><span class="ap__req" aria-hidden="true">*</span></label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail-{{ sid }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ st.email_placeholder | escape }}"
              data-ap-attr-placeholder="email_placeholder"
              required
              aria-required="true"
            >
          </div>
          <button type="submit" class="btn-primary ap__btn" data-theme-button="primary" data-sl-button><span data-ap-text="button_label">{{ st.button_label | escape }}</span></button>
        {%- endform -%}
      </div>
      <div class="ap-login__side content-register" data-ap-show="show_register"{% unless st.show_register %} hidden{% endunless %}>
        <h2 class="ap__h title-customer" data-ap-text="register_heading" data-ap-opt{% if st.register_heading == blank %} hidden{% endif %}>{{ st.register_heading | escape }}</h2>
        <div class="ap__t" data-ap-rich="register_text" data-ap-opt{% if st.register_text == blank %} hidden{% endif %}>{{ st.register_text }}</div>
        <a href="{{ routes.account_register_url | default: routes.account_login_url }}" class="btn btn-primary ap__btn no-underline" data-theme-button="primary" data-sl-button data-ap-text="register_button_label" data-ap-opt{% if st.register_button_label == blank %} hidden{% endif %}>{{ st.register_button_label | escape }}</a>
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "main-login",
  "name": "Sign in",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign in"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Enter your email and we will send you a code to sign in. There is no password to remember.</p>"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Email me a code"
    },
    {
      "type": "checkbox",
      "id": "show_register",
      "label": "Show new customer column",
      "default": true
    },
    {
      "type": "text",
      "id": "register_heading",
      "label": "New customer heading",
      "default": "New customer?",
      "visible_if": "{{ section.settings.show_register }}"
    },
    {
      "type": "richtext",
      "id": "register_text",
      "label": "New customer text",
      "default": "<p>Sign in with any email and your account is made for you.</p>",
      "visible_if": "{{ section.settings.show_register }}"
    },
    {
      "type": "text",
      "id": "register_button_label",
      "label": "New customer button",
      "default": "Create an account",
      "visible_if": "{{ section.settings.show_register }}"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Messages"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "We could not send a code to that email. Check it and try again."
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.show_register }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading size (desktop)",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font_weight_heading",
      "label": "Custom heading weight",
      "default": false
    },
    {
      "type": "select",
      "id": "font_weight_heading",
      "label": "Heading weight",
      "default": "600",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_font_weight_heading }}"
    },
    {
      "type": "range",
      "id": "subtext_font_size_desktop",
      "label": "Text size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subtext_font_size_mobile",
      "label": "Text size (mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.show_register }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
