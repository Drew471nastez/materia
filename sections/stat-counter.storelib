<template compat="shopify">
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Stat Counter section.
  Modern numbers/stats grid with animated count-up,
  per-stat icon, optional dividers and card layout.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign section_width = s.section_width
  assign color_scheme = s.color_scheme
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign columns = s.columns | default: 4
  assign columns_mobile = s.columns_mobile | default: 2
  assign layout = s.layout | default: 'inline'
  assign divider = s.divider
  assign animate = s.animate
  assign duration = s.duration | default: 1800
  assign value_size = s.value_size | default: 56
  assign label_size = s.label_size | default: 14
  assign value_weight = s.value_weight | default: '700'
  assign accent_color = s.accent_color
  assign show_heading = false
  if s.heading != blank or s.subheading != blank or s.description != blank
    assign show_heading = true
  endif
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top }};
  --section-pb: {{ s.padding_bottom }};
  --counter-cols: {{ columns }};
  --counter-cols-mb: {{ columns_mobile }};
  --counter-gap: {{ s.column_gap | default: 24 }}px;
  --counter-row-gap: {{ s.row_gap | default: 24 }}px;
  --counter-value-size: {{ value_size }}px;
  --counter-value-size-mb: {{ value_size | times: 0.7 | round }}px;
  --counter-label-size: {{ label_size }}px;
  --counter-value-weight: {{ value_weight }};
  {%- if accent_color != blank -%}--counter-accent: {{ accent_color }};{%- endif -%}
  --counter-divider: {{ s.divider_color | default: 'rgba(0,0,0,.12)' }};
  --counter-card-bg: {{ s.card_bg | default: 'rgba(0,0,0,0.03)' }};
  --counter-card-radius: {{ s.card_radius | default: 16 }}px;
  {%- if s.custom_section_bg != blank -%}--counter-section-bg: {{ s.custom_section_bg }};{%- endif -%}
  {%- if s.custom_text_color != blank -%}--counter-text-override: {{ s.custom_text_color }};{%- endif -%}
  {%- if s.custom_label_color != blank -%}--counter-label-override: {{ s.custom_label_color }};{%- endif -%}
  --counter-item-padding: {{ s.custom_inner_padding | default: 8 }}px;
  --counter-max-width: {{ s.custom_max_width | default: 1280 }}px;
{%- endcapture -%}

{%- style -%}
  {%- if s.custom_section_bg != blank -%}
    #shopify-section-{{ section.id }} > .section { background: var(--counter-section-bg) !important; }
  {%- endif -%}
  {%- if s.custom_text_color != blank -%}
    #shopify-section-{{ section.id }} .section__header,
    #shopify-section-{{ section.id }} .stat-counter__value { color: var(--counter-text-override) !important; }
  {%- endif -%}
  {%- if s.custom_label_color != blank -%}
    #shopify-section-{{ section.id }} .stat-counter__label { color: var(--counter-label-override) !important; }
  {%- endif -%}
  {%- if s.custom_uppercase_label -%}
    #shopify-section-{{ section.id }} .stat-counter__label { text-transform: uppercase; letter-spacing: 0.06em; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > .section > [class^="container"],
  #shopify-section-{{ section.id }} > .section > [class*="container"] { max-width: var(--counter-max-width); }
  #shopify-section-{{ section.id }} .stat-counter__item { padding: var(--counter-item-padding) calc(var(--counter-item-padding) * 1.5); }
  #shopify-section-{{ section.id }} .stat-counter {
    display: grid;
    grid-template-columns: repeat(var(--counter-cols-mb), minmax(0, 1fr));
    column-gap: var(--counter-gap);
    row-gap: var(--counter-row-gap);
    align-items: stretch;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .stat-counter {
      grid-template-columns: repeat(var(--counter-cols), minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .stat-counter__item {
    text-align: {{ s.alignment | default: 'center' }};
    padding: 8px 12px;
    position: relative;
    display: flex;
    flex-direction: column;
    {%- if s.alignment == 'left' -%}align-items: flex-start;
    {%- elsif s.alignment == 'right' -%}align-items: flex-end;
    {%- else -%}align-items: center;{%- endif -%}
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .stat-counter__icon {
    width: {{ s.icon_size | default: 44 }}px; height: {{ s.icon_size | default: 44 }}px;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
    color: var(--counter-accent, var(--color-heading));
  }
  #shopify-section-{{ section.id }} .stat-counter__icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .stat-counter__value {
    font-size: var(--counter-value-size-mb);
    line-height: 1;
    font-weight: var(--counter-value-weight);
    color: var(--counter-accent, var(--color-heading));
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .stat-counter__value { font-size: var(--counter-value-size); }
  }
  #shopify-section-{{ section.id }} .stat-counter__suffix,
  #shopify-section-{{ section.id }} .stat-counter__prefix {
    font-size: 0.7em;
    font-weight: 600;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .stat-counter__label {
    font-size: var(--counter-label-size);
    line-height: 1.4;
    opacity: 0.85;
    margin: 0;
  }
  {%- if divider and layout == 'inline' -%}
  #shopify-section-{{ section.id }} .stat-counter__item + .stat-counter__item::before {
    content: '';
    position: absolute;
    left: calc(var(--counter-gap) / -2);
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: var(--counter-divider);
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .stat-counter__item + .stat-counter__item::before { display: none; }
  }
  {%- endif -%}
  {%- if layout == 'cards' -%}
    #shopify-section-{{ section.id }} .stat-counter__item {
      padding: 28px 16px;
      background: var(--counter-card-bg);
      border-radius: var(--counter-card-radius);
    }
  {%- elsif layout == 'outline' -%}
    #shopify-section-{{ section.id }} .stat-counter__item {
      padding: 28px 16px;
      border: 1px solid var(--counter-divider);
      border-radius: var(--counter-card-radius);
    }
  {%- endif -%}
{%- endstyle -%}

<div
  class="section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {% if show_heading %}
      <div class="section__header text-{{ s.header_alignment | default: 'center' }} mb-30 mb-md-40">
        {%- if s.subheading != blank -%}
          <p class="m-0 mb-5 fs-custom subheading_weight">{{ s.subheading }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="section__header-heading heading-letter-spacing mt-0 mb-10">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <div class="section__header-des rich__text-m0">{{ s.description }}</div>
        {%- endif -%}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="stat-counter">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign target_num = b.value | default: '0' | replace: ',', '' | replace: ' ', '' -%}
          <motion-element
            data-motion="fade-up-sm"
            data-motion-delay="{{ forloop.index0 | times: 80 }}"
            {% if scroll_animation != 'slide_in' %}hold{% endif %}
            class="stat-counter__item {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            {{ block.shopify_attributes }}
            style="--animation-order: {{ forloop.index }};"
          >
            {%- if b.icon != blank -%}
              <div class="stat-counter__icon">{{ b.icon }}</div>
            {%- endif -%}
            <div class="stat-counter__value">
              {%- if b.prefix != blank -%}<span class="stat-counter__prefix">{{ b.prefix }}</span>{%- endif -%}
              <span
                class="stat-counter__number"
                data-target="{{ target_num }}"
                data-decimals="{{ b.decimals | default: 0 }}"
                data-duration="{{ duration }}"
                data-animate="{{ animate }}"
              >
                {%- if animate -%}0{%- else -%}{{ b.value | default: 0 }}{%- endif -%}
              </span>
              {%- if b.suffix != blank -%}<span class="stat-counter__suffix">{{ b.suffix }}</span>{%- endif -%}
            </div>
            {%- if b.label != blank -%}
              <p class="stat-counter__label">{{ b.label }}</p>
            {%- endif -%}
          </motion-element>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</div>

{%- if animate -%}
<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var nums = section.querySelectorAll('.stat-counter__number[data-animate="true"]');
    if (!nums.length) return;
    function animateNum(el) {
      var target = parseFloat(el.getAttribute('data-target')) || 0;
      var decimals = parseInt(el.getAttribute('data-decimals'), 10) || 0;
      var duration = parseInt(el.getAttribute('data-duration'), 10) || 1800;
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        var val = target * eased;
        el.textContent = decimals > 0 ? val.toFixed(decimals) : Math.round(val).toLocaleString();
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = decimals > 0 ? target.toFixed(decimals) : Math.round(target).toLocaleString();
      }
      requestAnimationFrame(step);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateNum(entry.target);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      nums.forEach(function (n) { io.observe(n); });
    } else {
      nums.forEach(animateNum);
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

<schema>
{
  "type": "stat-counter",
  "name": "Stat Counter",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Card style",
      "default": "inline",
      "info": "How each stat is framed.",
      "options": [
        {
          "value": "inline",
          "label": "Inline (clean row)"
        },
        {
          "value": "cards",
          "label": "Filled cards"
        },
        {
          "value": "outline",
          "label": "Outlined cards"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow text",
      "default": "By the numbers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Trusted by thousands"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Image / Media"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Animation duration",
      "min": 600,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 1800
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Subtext",
      "default": "<p>Real numbers from a community that keeps coming back.</p>"
    },
    {
      "type": "checkbox",
      "id": "custom_uppercase_label",
      "label": "Uppercase labels",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Number size",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Number weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extrabold"
        }
      ]
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Text color override"
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Vertical dividers between stats",
      "default": true,
      "info": "Inline layout only — desktop."
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider / outline color"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "info": "Used by Filled cards layout."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Number / icon color",
      "info": "Leave empty to use your color scheme heading color."
    },
    {
      "type": "color",
      "id": "custom_section_bg",
      "label": "Section background override",
      "info": "Leave empty to use the color scheme."
    },
    {
      "type": "color",
      "id": "custom_label_color",
      "label": "Label color override"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Items per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "custom_inner_padding",
      "label": "Inner padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Max content width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_38",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Items per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
