        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Count up when in view",
        "default": true,
        "info": "On the live store each number counts up once. The editor and reduced motion show the final values."
      },
