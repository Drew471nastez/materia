<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: the theme's own space between sections is removed; the margin sliders below still apply */
    #shopify-section-{{ section.id }} { padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ section.id }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Stat Counter.

  A header (eyebrow, heading and subheading blocks) above a grid of numbers,
  each with an optional icon, prefix, suffix and label. Every value is a CSS
  variable on the section root, so shopify/assets/live-features-d.js applies
  builder edits in place. On the storefront the numbers count up once, when
  they first come into view; in the builder and under reduced motion they
  show their final values.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign custom = s.enable_custom_style
  assign layout = s.layout | default: 'inline'
  assign pending = false
  if s.animate
    assign pending = true
  endif
  if request.design_mode
    assign pending = false
  endif
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign value_size = s.value_size | default: 56
-%}
{%- capture sc_style -%}
--section-pt: {{ s.padding_top | default: 0 }}; --section-pb: {{ s.padding_bottom | default: 0 }};
--counter-cols: {{ s.columns | default: 4 }}; --counter-cols-mb: {{ s.columns_mobile | default: 2 }};
--counter-gap: {{ s.column_gap | default: 0 }}px; --counter-row-gap: {{ s.row_gap | default: 0 }}px;
--counter-value-size: {{ value_size }}px; --counter-value-size-mb: {{ value_size | times: 0.7 | round }}px;
--counter-label-size: {{ s.label_size | default: 14 }}px; --counter-value-weight: {{ s.value_weight | default: '700' }}; --counter-icon: {{ s.icon_size | default: 44 }}px;
--counter-card-radius: {{ s.card_radius | default: 0 }}px; --counter-item-padding: {{ s.custom_inner_padding | default: 0 }}px; --counter-max-width: {{ s.custom_max_width | default: 1280 }}px;
--counter-align: {{ s.alignment | default: 'center' }}; --counter-ai: {% if s.alignment == 'left' %}flex-start{% elsif s.alignment == 'right' %}flex-end{% else %}center{% endif %};
--counter-case: {% if s.custom_uppercase_label %}uppercase{% else %}none{% endif %}; --counter-tracking: {% if s.custom_uppercase_label %}0.06em{% else %}normal{% endif %};
{%- render 'media-msr-var', name: '--counter-section-bg', color: s.custom_section_bg, on: custom -%}
{%- render 'media-msr-var', name: '--counter-text', color: s.custom_text_color, on: custom -%}
{%- render 'media-msr-var', name: '--counter-accent', color: s.accent_color, on: custom -%}
{%- render 'media-msr-var', name: '--counter-label', color: s.custom_label_color, on: custom -%}
{%- render 'media-msr-var', name: '--counter-divider', color: s.divider_color, on: custom -%}
{%- render 'media-msr-var', name: '--counter-card-bg', color: s.card_bg, on: custom -%}
{%- if s.enable_custom_fonts -%}
  {%- if s.heading_font.family != blank -%}--counter-hfont: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'serif' }};{%- endif -%}
  {%- if s.body_font.family != blank -%}--counter-bfont: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}
<style>
  {%- if s.enable_custom_fonts -%}
    {%- if s.heading_font.family != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.body_font.family != blank -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endif -%}
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} {
    --fd-mt-m: {{ s.section_margin_top_mobile | default: 0 }}px; --fd-mb-m: {{ s.section_margin_bottom_mobile | default: 0 }}px;
    --fd-mt-d: {{ s.section_margin_top_desktop | default: 0 }}px; --fd-mb-d: {{ s.section_margin_bottom_desktop | default: 0 }}px;
    margin-top: var(--fd-mt-m) !important; margin-bottom: var(--fd-mb-m) !important;
  }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .stat-counter-section {
    background: var(--counter-section-bg, var(--color-background)); color: var(--counter-text, var(--color-text));
    font-family: var(--counter-bfont, var(--body-font));
  }
  #shopify-section-{{ sid }} .stat-counter__body { max-width: var(--counter-max-width); margin-inline: auto; }
  #shopify-section-{{ sid }} .full_width > .stat-counter__body { padding-inline: 16px; }
  #shopify-section-{{ sid }} .fd-header { display: flex; flex-direction: column; gap: 8px; margin: 0 0 30px; }
  #shopify-section-{{ sid }} .fd-header.text-center { align-items: center; }
  #shopify-section-{{ sid }} .fd-header.text-right { align-items: flex-end; }
  #shopify-section-{{ sid }} .fd-header.text-left { align-items: flex-start; }
  #shopify-section-{{ sid }} .fd-header > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .fd-eyebrow { color: var(--b-color, var(--counter-text, var(--color-text))); font-size: var(--b-size, inherit); }
  #shopify-section-{{ sid }} .fd-heading {
    font-family: var(--b-font, var(--counter-hfont, var(--heading-font))); font-weight: var(--b-weight, var(--heading-weight, 700));
    color: var(--b-color, var(--counter-text, var(--color-heading))); font-size: var(--b-size-m, calc(var(--heading-font-scale, 1) * var(--h2-size, 3.6rem)));
  }
  #shopify-section-{{ sid }} .fd-sub { color: var(--b-color, var(--counter-text, var(--color-text))); font-size: var(--b-size, inherit); max-width: var(--b-max, 640px); }
  #shopify-section-{{ sid }} .stat-counter {
    display: grid; grid-template-columns: repeat(var(--counter-cols-mb), minmax(0, 1fr));
    column-gap: var(--counter-gap); row-gap: var(--counter-row-gap); align-items: stretch;
  }
  #shopify-section-{{ sid }} .stat-counter__item {
    position: relative; display: flex; flex-direction: column; align-items: var(--counter-ai); justify-content: center;
    text-align: var(--counter-align); padding: var(--counter-item-padding) calc(var(--counter-item-padding) * 1.5); min-width: 0;
  }
  #shopify-section-{{ sid }} .stat-counter__icon {
    width: var(--counter-icon); height: var(--counter-icon); display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 14px; color: var(--counter-accent, var(--color-heading));
  }
  #shopify-section-{{ sid }} .stat-counter__icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .stat-counter__value {
    font-family: var(--counter-hfont, inherit); font-size: var(--counter-value-size-mb); line-height: 1; font-weight: var(--counter-value-weight);
    color: var(--counter-accent, var(--color-heading)); letter-spacing: -0.02em; margin-bottom: 8px;
    display: inline-flex; align-items: baseline; gap: 2px; max-width: 100%; flex-wrap: wrap; justify-content: inherit;
  }
  #shopify-section-{{ sid }} .stat-counter__number { font-variant-numeric: tabular-nums; transition: opacity 0.3s ease; }
  #shopify-section-{{ sid }} .stat-counter__suffix, #shopify-section-{{ sid }} .stat-counter__prefix { font-size: 0.7em; font-weight: 600; opacity: 0.85; }
  #shopify-section-{{ sid }} .stat-counter__label {
    font-size: var(--counter-label-size); line-height: 1.4; opacity: 0.85; margin: 0;
    color: var(--counter-label, inherit); text-transform: var(--counter-case); letter-spacing: var(--counter-tracking);
  }
  #shopify-section-{{ sid }} .stat-counter-section[data-layout='inline'][data-divider='true'] .stat-counter__item + .stat-counter__item::before {
    content: ''; position: absolute; left: calc(var(--counter-gap) / -2); top: 12%; bottom: 12%; width: 1px; background: var(--counter-divider, var(--color-border));
  }
  #shopify-section-{{ sid }} .stat-counter-section[data-layout='cards'] .stat-counter__item { padding: 28px 16px; background: var(--counter-card-bg, color-mix(in srgb, var(--color-text) 6%, transparent)); border-radius: var(--counter-card-radius); }
  #shopify-section-{{ sid }} .stat-counter-section[data-layout='outline'] .stat-counter__item { padding: 28px 16px; border: 1px solid var(--counter-divider, var(--color-border)); border-radius: var(--counter-card-radius); }
  #shopify-section-{{ sid }} .stat-counter-section[data-fd-reveal='pending'] .stat-counter__number { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .stat-counter-section .stat-counter__number { opacity: 1; transition: none; }
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ sid }} .stat-counter__item + .stat-counter__item::before { display: none; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--fd-mt-d) !important; margin-bottom: var(--fd-mb-d) !important; }
    #shopify-section-{{ sid }} .fd-header { margin-bottom: 40px; }
    #shopify-section-{{ sid }} .fd-heading { font-size: var(--b-size-d, calc(var(--heading-font-scale, 1) * var(--h2-size, 3.6rem))); }
    #shopify-section-{{ sid }} .stat-counter { grid-template-columns: repeat(var(--counter-cols), minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .stat-counter__value { font-size: var(--counter-value-size); }
  }
{% comment %}{% endcomment %}</style>
<noscript><style>#shopify-section-{{ sid }} .stat-counter-section[data-fd-reveal='pending'] .stat-counter__number { opacity: 1; }</style></noscript>

<div class="stat-counter-section section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}" data-fd="counter" data-fd-section="{{ sid }}" data-fd-settings="{{ s | json | escape }}" data-layout="{{ layout }}" data-divider="{{ s.divider }}"{% if s.enable_custom_fonts %} data-own-font{% endif %}{% if pending %} data-fd-reveal="pending"{% endif %}{% unless s.reveal %} data-ti-no-reveal{% endunless %} style="{{ sc_style | strip_newlines }}">
  <div class="{{ s.section_width | default: 'full_width' }}">
    <div class="stat-counter__body">
      {%- render 'features-d-header', section: section -%}
      <div class="stat-counter">
        {%- for block in stat_blocks -%}
          {%- liquid
            assign b = block.settings
            assign raw = b.value | default: '0' | strip
            assign target = raw | replace: ',', '' | replace: ' ', ''
          -%}
          <motion-element data-motion="fade-up-sm" data-motion-delay="{{ forloop.index0 | times: 80 }}"{% if b.value == blank %}{% unless request.design_mode or page.in_editor %} hidden{% endunless %}{% endif %}{% if settings.scroll_animation != 'slide_in' %} hold{% endif %} class="stat-counter__item{% if settings.scroll_animation != blank and settings.scroll_animation != 'none' and s.reveal %} scroll-trigger {{ settings.scroll_animation }}{% endif %}" data-fd-block="{{ block.id }}" data-fd-type="stat" data-fd-settings="{{ b | json | escape }}" style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
            <div class="stat-counter__icon"{% if b.icon == blank %} hidden{% endif %}>{{ b.icon }}</div>
            <div class="stat-counter__value">
              <span class="stat-counter__prefix"{% if b.prefix == blank %} hidden{% endif %}>{{ b.prefix | escape }}</span>
              <span class="stat-counter__number" data-fd-count data-to="{{ target | escape }}" data-decimals="{{ b.decimals | default: 0 }}" data-final="{{ raw | escape }}">{{ raw | escape }}</span>
              <span class="stat-counter__suffix"{% if b.suffix == blank %} hidden{% endif %}>{{ b.suffix | escape }}</span>
            </div>
            <p class="stat-counter__label"{% if b.label == blank %} hidden{% endif %}>{{ b.label | escape }}</p>
          </motion-element>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- comment -%} Count up and live edits: shopify/assets/live-features-d.js (loaded on every page). {%- endcomment -%}



</template>
<schema>
{
  "type": "stat-counter",
  "name": "Stat Counter",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove theme spacing between sections",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow text",
      "hidden": true,
      "info": "Legacy: used only when the section has no Eyebrow block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "hidden": true,
      "info": "Legacy: used only when the section has no Heading block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Subtext",
      "hidden": true,
      "info": "Legacy: used only when the section has no Subheading block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Stat style",
      "default": "inline",
      "info": "How each stat is framed.",
      "options": [
        {
          "value": "inline",
          "label": "Inline (clean row)"
        },
        {
          "value": "cards",
          "label": "Filled cards"
        },
        {
          "value": "outline",
          "label": "Outlined cards"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Stat alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Stats per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "custom_inner_padding",
      "label": "Space inside each stat",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Dividers between stats",
      "default": true,
      "info": "Inline layout, desktop only",
      "visible_if": "{{ section.settings.layout == 'inline' }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.layout != 'inline' }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Number size",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "custom_uppercase_label",
      "label": "Uppercase labels",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Number and icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_label_color",
      "label": "Label",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Dividers and outlines",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "info": "Used by Filled cards layout.",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Number weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extrabold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading and number font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Count up when in view",
      "default": true,
      "info": "On the live store each number counts up once. The editor and reduced motion show the final values."
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Count duration",
      "min": 600,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 1800,
      "visible_if": "{{ section.settings.animate }}"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses the theme animation from Theme settings."
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_45",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Stats per row",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin",
      "min": 0,
      "max": 300,
      "step": 4,
