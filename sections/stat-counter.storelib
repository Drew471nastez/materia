  "shopify": {
    "name": "Stat Counter",
    "tag": "section",
    "class": "section-stat-counter",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove theme spacing between sections",
        "default": true
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Eyebrow text",
        "hidden": true,
        "info": "Legacy: used only when the section has no Eyebrow block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Title",
        "hidden": true,
        "info": "Legacy: used only when the section has no Heading block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Subtext",
        "hidden": true,
        "info": "Legacy: used only when the section has no Subheading block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Stat style",
        "default": "inline",
        "info": "How each stat is framed.",
        "options": [
          {
            "value": "inline",
            "label": "Inline (clean row)"
          },
          {
            "value": "cards",
            "label": "Filled cards"
          },
          {
            "value": "outline",
            "label": "Outlined cards"
          }
        ]
      },
      {
        "type": "select",
        "id": "header_alignment",
        "label": "Header alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centered"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Stat alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centered"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "columns",
        "label": "Stats per row",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Column gap",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "row_gap",
        "label": "Row gap",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "custom_inner_padding",
        "label": "Space inside each stat",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "custom_max_width",
        "label": "Content max width",
        "min": 600,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "checkbox",
        "id": "divider",
        "label": "Dividers between stats",
        "default": true,
        "info": "Inline layout, desktop only",
        "visible_if": "{{ section.settings.layout == 'inline' }}"
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.layout != 'inline' }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "range",
        "id": "value_size",
        "label": "Number size",
        "min": 28,
        "max": 96,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "label_size",
        "label": "Label size",
        "min": 10,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 24,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
