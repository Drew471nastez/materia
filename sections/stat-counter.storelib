        "type": "range",
        "id": "duration",
        "label": "Count duration",
        "min": 600,
        "max": 4000,
        "step": 100,
        "unit": "ms",
        "default": 1800,
        "visible_if": "{{ section.settings.animate }}"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
