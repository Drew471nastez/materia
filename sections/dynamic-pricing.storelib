<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


{% if section.settings.enable_custom_fonts %}
  <link
    href="https://fonts.googleapis.com/css2?family={{ section.settings.custom_font | replace: ' ', '+' }}&display=swap"
    rel="stylesheet"
  >
{% endif %}

<div class="discount-price-section color-{{ color_scheme }} gradient {{ section.settings.section_width }}">
  <div class="price-container">
    <div class="original-price">
      <span>{{ section.settings.original_price }}</span>
    </div>
    <div class="discounted-price">
      {{ section.settings.discounted_price }}
    </div>
    {% if section.settings.show_currency_symbol %}
      <div class="currency">
        {{ section.settings.currency }}
      </div>
    {% endif %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .discount-price-section {
      margin: 0 !important;
      padding-top: {{ section.settings.desktop_padding }}px !important;
      padding-bottom: {{ section.settings.desktop_padding }}px !important;
      padding-left: {{ section.settings.left_padding_desktop }}px !important;
      padding-right: {{ section.settings.right_padding_desktop }}px !important;
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      height: {{ section.settings.section_height }}px !important;
      background-color: {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %} !important;
      font-family: {% if section.settings.enable_custom_fonts %}'{{ section.settings.custom_font }}', sans-serif{% else %}var(--body-font, inherit){% endif %} !important;
      transform: scale({{ section.settings.overall_size_desktop | divided_by: 100.0 }}) !important;
      transition: transform 0.3s ease !important;
  }

  {% if section.settings.display_on_devices == 'no_devices' %}
  #shopify-section-{{ section.id }} .discount-price-section {
      display: none !important;
  }
  {% elsif section.settings.display_on_devices == 'mobile_only' %}
  @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .discount-price-section {
          display: none !important;
      }
  }
  {% elsif section.settings.display_on_devices == 'desktop_only' %}
  @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .discount-price-section {
          display: none !important;
      }
  }
  {% endif %}

  #shopify-section-{{ section.id }} .price-container {
      display: flex !important;
      align-items: center !important;
      color: {% render 'scheme-color', color: section.settings.discounted_price_color, fallback: 'var(--color-heading)' %} !important;
      font-size: 5rem !important;
  }

  #shopify-section-{{ section.id }} .original-price {
      color: {% render 'scheme-color', color: section.settings.original_price_color, fallback: 'var(--color-text)' %} !important;
      position: relative !important;
      margin-right: 1rem !important;
  }

  #shopify-section-{{ section.id }} .original-price::before {
      content: '' !important;
      position: absolute !important;
      top: 50% !important;
      transform: translateY(calc(-50% + {{ section.settings.original_price_line_vertical_offset }}px)) rotate(-5deg) !important;
      left: 0 !important;
      right: 0 !important;
      height: {{ section.settings.original_price_line_weight }}px !important;
      background-color: {% render 'scheme-color', color: section.settings.original_price_line_color, fallback: 'var(--color-primary)' %} !important;
      z-index: 2 !important;
      width: {{ section.settings.original_price_line_length }}% !important;
      border-radius: 1px !important;
      box-shadow: none !important;
  }

  #shopify-section-{{ section.id }} .original-price span {
      position: relative !important;
      z-index: 1 !important;
      font-size: {{ section.settings.original_price_size_desktop }}rem !important;
      font-weight: {{ section.settings.original_price_font_weight }} !important;
  }

  #shopify-section-{{ section.id }} .discounted-price {
      font-size: {{ section.settings.discounted_price_size_desktop }}rem !important;
      color: {% render 'scheme-color', color: section.settings.discounted_price_color, fallback: 'var(--color-heading)' %} !important;
      top: {{ section.settings.discounted_price_vertical_position }}px !important;
      position: relative !important;
      font-weight: {{ section.settings.discounted_price_font_weight }} !important;
  }

  #shopify-section-{{ section.id }} .currency {
      font-size: 5rem !important;
      margin-left: 0.5rem !important;
      color: {% render 'scheme-color', color: section.settings.currency_color, fallback: 'var(--color-heading)' %} !important;
  }

  @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .discount-price-section {
          padding-top: {{ section.settings.mobile_padding }}px !important;
          padding-bottom: {{ section.settings.mobile_padding }}px !important;
          padding-left: {{ section.settings.left_padding_mobile }}px !important;
          padding-right: {{ section.settings.right_padding_mobile }}px !important;
          height: {{ section.settings.section_height_mobile }}px !important;
          transform: scale({{ section.settings.overall_size_mobile | divided_by: 100.0 }}) !important;
      }
      #shopify-section-{{ section.id }} .price-container {
          flex-direction: row !important;
          justify-content: center !important;
          align-items: center !important;
          font-size: 3rem !important;
      }
      #shopify-section-{{ section.id }} .original-price,
      #shopify-section-{{ section.id }} .currency {
          margin: 0 0.7rem !important;
      }
      #shopify-section-{{ section.id }} .original-price span {
          font-size: {{ section.settings.original_price_size_mobile }}rem !important;
      }
      #shopify-section-{{ section.id }} .discounted-price {
          font-size: {{ section.settings.discounted_price_size_mobile }}rem !important;
      }
  }
{% comment %}{% endcomment %}</style>

</template>

<schema>
{
  "type": "dynamic-pricing",
  "name": "Discount Price  ",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "display_on_devices",
      "label": "Show on",
      "options": [
        {
          "value": "no_devices",
          "label": "Hidden"
        },
        {
          "value": "all_devices",
          "label": "All devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        }
      ],
      "default": "all_devices"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "original_price",
      "label": "Original price",
      "default": "119,99$"
    },
    {
      "type": "inline_richtext",
      "id": "discounted_price",
      "label": "Discounted price",
      "default": "<strong>85$</strong>"
    },
    {
      "type": "checkbox",
      "id": "show_currency_symbol",
      "label": "Show currency",
      "default": false
    },
    {
      "type": "text",
      "id": "currency",
      "label": "Currency",
      "visible_if": "{{ section.settings.show_currency_symbol }}"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Typography"
    },
    {
