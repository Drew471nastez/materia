<template compat="shopify">
{%- liquid
  comment
    ═══════════════════════════════════════════════════════════════════════
    ORDER NOTIFICATION PRO 1 — block-organised section.
    All configuration lives inside section blocks (no flat
    section.settings). The preset adds all 6 blocks automatically;
    each block has limit:1 so it can only appear once. If a merchant
    removes a block, the section falls back to the defaults assigned
    below, so the notification never breaks visually.
  endcomment
  assign layout_block   = section.blocks | where: 'type', 'layout'     | first
  assign anim_block     = section.blocks | where: 'type', 'animation'  | first
  assign products_block = section.blocks | where: 'type', 'products'   | first
  assign text_block     = section.blocks | where: 'type', 'text'       | first
  assign bg_block       = section.blocks | where: 'type', 'background' | first
  assign colors_block   = section.blocks | where: 'type', 'colors'     | first

  comment
    ── Layout & position
  endcomment
  if layout_block
    assign position             = layout_block.settings.position             | default: 'left'
    assign border_radius        = layout_block.settings.border_radius        | default: 5
    assign show_on_mobile       = layout_block.settings.show_on_mobile_fake_order
    assign disable_progress_bar = layout_block.settings.disable_progress_bar
  else
    assign position             = 'left'
    assign border_radius        = 5
    assign show_on_mobile       = true
    assign disable_progress_bar = false
  endif
  if show_on_mobile == null
    assign show_on_mobile = true
  endif
  if disable_progress_bar == null
    assign disable_progress_bar = false
  endif

  comment
    ── Animation & timing
  endcomment
  if anim_block
    assign notification_animation = anim_block.settings.notification_animation | default: 'Fade-in Fade Out'
    assign animation_duration     = anim_block.settings.animation_duration     | default: 15000
    assign delay_time             = anim_block.settings.delay_time             | default: '500'
    assign show_gap_seconds       = anim_block.settings.show_gap_seconds       | default: 10
  else
    assign notification_animation = 'Fade-in Fade Out'
    assign animation_duration     = 15000
    assign delay_time             = '500'
    assign show_gap_seconds       = 10
  endif

  comment
    ── Products & user pool
  endcomment
  if products_block
    assign list_product_fake = products_block.settings.fake_product
    assign list_user         = products_block.settings.fake_user
  endif
  assign product_available = list_product_fake | where: 'available'
  assign products          = product_available.first
  assign list_user         = list_user | default: 'Liam (USA) | Ethan (USA) | Matteo (USA) | Owen (Canada) | Lucas (Canada) | Rafael (USA) | Mason (USA) | Alex (UK) | Luca (Italy) | Hugo (France) | Elias (Germany) | Sofia (Spain) | Jakob (Sweden) | Matei (Romania) | Ivan (Russia) | Niko (Greece) | Marko (Croatia) | Erik (Norway) | Felix (Denmark) | Tomáš (Czech Republic) | Arnaud (Belgium) | Finn (Ireland)'
  assign list_user         = list_user | replace: ' | ', '|' | replace: ' |', '|' | replace: '| ', '|' | split: '|'

  comment
    ── Text content (heading, verify CTA, close button)
  endcomment
  if text_block
    assign heading_text                       = text_block.settings.heading_text                       | default: 'Latest Orders'
    assign text_verify                        = text_block.settings.text_verify                        | default: 'Verify'
    assign enable_verify_arrow                = text_block.settings.enable_verify_arrow
    assign verify_text_url                    = text_block.settings.verify_text_url                    | default: '/'
    assign verify_text_color                  = text_block.settings.verify_text_color                  | default: '#0000FF'
    assign verify_text_hover_color            = text_block.settings.verify_text_hover_color            | default: '#00008B'
    assign enable_underline_product_name_title = text_block.settings.enable_underline_product_name_title
    assign enable_close_button                = text_block.settings.enable_close_button
    assign close_button_color                 = text_block.settings.close_button_color                 | default: '#0F1729'
  else
    assign heading_text                       = 'Latest Orders'
    assign text_verify                        = 'Verify'
    assign enable_verify_arrow                = true
    assign verify_text_url                    = '/'
    assign verify_text_color                  = '#0000FF'
    assign verify_text_hover_color            = '#00008B'
    assign enable_underline_product_name_title = false
    assign enable_close_button                = true
    assign close_button_color                 = '#0F1729'
  endif
  if enable_verify_arrow == null
    assign enable_verify_arrow = true
  endif
  if enable_underline_product_name_title == null
    assign enable_underline_product_name_title = false
  endif
  if enable_close_button == null
    assign enable_close_button = true
  endif

  comment
    ── Background — gradient + glassmorphism
  endcomment
  if bg_block
    assign enable_gradient            = bg_block.settings.enable_gradient
    assign gradient_start_color       = bg_block.settings.gradient_start_color  | default: '#FAFAFA'
    assign gradient_middle_color      = bg_block.settings.gradient_middle_color | default: '#F7F7F7'
    assign gradient_end_color         = bg_block.settings.gradient_end_color    | default: '#E6E6E6'
    assign gradient_degrees           = bg_block.settings.gradient_degrees      | default: '45'
    assign enable_glassmorphism       = bg_block.settings.enable_glassmorphism
    assign glassmorphism_blur         = bg_block.settings.glassmorphism_blur         | default: 10
    assign glassmorphism_brightness   = bg_block.settings.glassmorphism_brightness   | default: 0.9
    assign glassmorphism_border_width = bg_block.settings.glassmorphism_border_width | default: 1
    assign glassmorphism_border_color = bg_block.settings.glassmorphism_border_color | default: '#ffffff'
  else
    assign enable_gradient            = true
    assign gradient_start_color       = '#FAFAFA'
    assign gradient_middle_color      = '#F7F7F7'
    assign gradient_end_color         = '#E6E6E6'
    assign gradient_degrees           = '45'
    assign enable_glassmorphism       = false
    assign glassmorphism_blur         = 10
    assign glassmorphism_brightness   = 0.9
    assign glassmorphism_border_width = 1
    assign glassmorphism_border_color = '#ffffff'
  endif
  if enable_gradient == null
    assign enable_gradient = true
  endif
  if enable_glassmorphism == null
    assign enable_glassmorphism = false
  endif

  comment
    ── Colors (background, text, progress bar)
  endcomment
  if colors_block
    assign background_color   = colors_block.settings.background_color   | default: '#EFEFEF'
    assign text_color         = colors_block.settings.text_color         | default: '#111111'
    assign progress_bar_color = colors_block.settings.progress_bar_color | default: '#303030'
  else
    assign background_color   = '#EFEFEF'
    assign text_color         = '#111111'
    assign progress_bar_color = '#303030'
  endif

  comment
    ── Master enable toggle. Lives at section.settings level so it's
    always visible at the top of the panel, regardless of which blocks
    the merchant has added. When OFF, the section renders nothing —
    no markup, no JS, no CSS — so it stays in the editor (un-deletable
    from the overlay group) but has zero runtime cost when hidden.
  endcomment
  assign section_enabled = section.settings.section_enabled
  if section_enabled == null
    assign section_enabled = true
  endif
-%}

{%- if section_enabled and product_available.size > 0 -%}
  <style>
    /* Scoped Styles for Fake Order Section */
    .bls-fake-order-section-{{ section.id }} {
      position: fixed;
      z-index: 999;
      padding: 10px;
      border-radius: {{ border_radius }}px;
      font-size: calc(var(--base-font-size) - 2px);
      box-shadow: 0px 5px 30px rgba(0, 0, 0, 0.05);
      transition: all {{ animation_duration }}ms ease;
      color: {{ text_color }};

      {% if enable_glassmorphism %}
        background: rgba(255, 255, 255, 0.4);
        filter: brightness({{ glassmorphism_brightness }});
        backdrop-filter: blur({{ glassmorphism_blur }}px);
        -webkit-backdrop-filter: blur({{ glassmorphism_blur }}px);
        border: {{ glassmorphism_border_width }}px solid {{ glassmorphism_border_color }};
      {% elsif enable_gradient %}
        background: linear-gradient({{ gradient_degrees }}deg, {{ gradient_start_color }}, {{ gradient_middle_color }}, {{ gradient_end_color }});
      {% else %}
        background-color: {{ background_color }};
      {% endif %}

      width: 42rem;
      max-width: 120%;
      min-height: 10rem;
      left: {% if position == 'right' %}unset{% else %}30px{% endif %};
      right: {% if position == 'right' %}35px{% else %}unset{% endif %};
      bottom: 33px;
      display: none; /* Initially hidden */

      {% if notification_animation == 'None' %}
        /* No animation */
      {% elsif notification_animation == 'Fade-in Fade Out' %}
        animation: fadeInFadeOut {{ animation_duration }}ms forwards;
      {% elsif notification_animation == 'Zoom in - Zoom Out' %}
        animation: zoomInZoomOut {{ animation_duration }}ms forwards;
      {% elsif notification_animation == 'Fade Up - Fade Down' %}
        animation: fadeUpFadeDown {{ animation_duration }}ms forwards;
      {% elsif notification_animation == 'Slide In - Slide Out' %}
        animation: slideInSlideOut {{ animation_duration }}ms forwards;
      {% elsif notification_animation == 'Normal Original Animation' %}
        /* Original animation */
        animation: bls-fake-order-{{ section.id }} {{ animation_duration }}ms ease;
      {% elsif notification_animation == 'Reveal In - Reveal Out' %}
        animation: revealInRevealOut {{ animation_duration }}ms forwards;
      {% endif %}
    }

    .bls-fake-order-section-{{ section.id }}.hidden-mobile {
      display: none;
    }

    .bls-fake-order-section-{{ section.id }} .fake-order-close path {
      fill: {{ close_button_color }};
      transition: fill 0.3s ease-in-out;
    }
    .bls-fake-order-section-{{ section.id }} .fake-order-close:hover path {
      fill: darken({{ close_button_color }}, 20%);
    }

    .bls-fake-order-section-{{ section.id }} .product-fake-order {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    /* Ensure the SVG icon color updates dynamically */
    .bls-fake-order-section-{{ section.id }} .verify-arrow path {
      stroke: {{ verify_text_color }};
      transition: stroke 0.3s ease-in-out;
    }
    .bls-fake-order-section-{{ section.id }} .text-verify:hover .verify-arrow path {
      stroke: {{ verify_text_hover_color }};
    }
    .verify-arrow {
      width: 15px;
      height: 15px;
      margin-bottom: 1px;
      margin-right: 3px;
    }

    /* Product Name Title underline toggle */
    .bls-fake-order-section-{{ section.id }} .product-order-title a {
      text-decoration: {% if enable_underline_product_name_title %}underline{% else %}none{% endif %};
      display: block;
      font-size: var(--base-font-size);
      line-height: 1.5;
      width: 100%;
      text-align: left;
      margin: 0 0 0.7rem;
      font-weight: 600 !important;
      color: var(--heading-color);
    }

    .bls-fake-order-section-{{ section.id }} .minutes-ago {
      display: inline-flex;
      margin-bottom: 0;
      margin-right: 15px;
      color: {{ text_color }};
    }

    /* VERIFY TEXT */
    .bls-fake-order-section-{{ section.id }} .text-verify {
      text-transform: capitalize;
      display: inline-flex;
      align-items: center;
      gap: 0 4px;
      text-decoration: none !important;
      color: {{ verify_text_color }};
      cursor: pointer;
    }
    .bls-fake-order-section-{{ section.id }} .text-verify:hover {
      color: {{ verify_text_hover_color }};
      text-decoration: none;
    }

    /* Close button */
    .bls-fake-order-section-{{ section.id }} .fake-order-close {
      position: absolute;
      top: 10px;
      right: 8px;
      cursor: pointer;
      width: 17px;
      height: 17px;
    }
    .bls-fake-order-section-{{ section.id }} .fake-order-close svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .bls-fake-order-section-{{ section.id }} [data-img] {
      border-radius: 5px;
      width: 60px;
      height: 80px;
      object-fit: cover;
    }

    .bls-fake-order-section-{{ section.id }} .user-purchase {
      color: #111111;
    }

    .bls-fake-order-section-{{ section.id }} .fake-list {
      display: flex;
      gap: 3px;
      align-items: center;
    }

    {% unless disable_progress_bar %}
      .bls-fake-order-section-{{ section.id }} .fake-order-progressbar {
        position: absolute;
        left: 0;
        bottom: 0;
        height: 2px;
        width: 100%;
        z-index: 1;
        box-shadow: 0px 7px 30px rgba(0, 0, 0, 0.05);
        border-radius: 5px;
        overflow: hidden;
        background: #e0e0e0;
      }
      .bls-fake-order-section-{{ section.id }} .fake-order-progressbar span {
        display: block;
        height: 100%;
        width: 0;
        border-radius: 0 0 3px 3px;
        background: {{ progress_bar_color }};
        animation: bls-progressbar-{{ section.id }} linear forwards;
      }
    {% endunless %}

    .bls-fake-order-section-{{ section.id }} .w-60 {
      width: 60px;
    }
    .bls-fake-order-section-{{ section.id }} .h-80 {
      height: 80px;
    }

    @keyframes bls-progressbar-{{ section.id }} {
      from { width: 0%; }
      to { width: 100%; }
    }

    /* Notification Animations */
    @keyframes fadeInFadeOut {
      0% { opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { opacity: 0; }
    }
    @keyframes zoomInZoomOut {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1); opacity: 1; }
      100% { transform: scale(0); opacity: 0; }
    }
    @keyframes fadeUpFadeDown {
      0% { opacity: 0; transform: translateY(20px); }
      10% { opacity: 1; transform: translateY(0); }
      90% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(20px); }
    }
    @keyframes slideInSlideOut {
      0% { transform: translateX(100%); opacity: 0; }
      10% { transform: translateX(0); opacity: 1; }
      90% { transform: translateX(0); opacity: 1; }
      100% { transform: translateX(100%); opacity: 0; }
    }
    @keyframes revealInRevealOut {
      0% { clip-path: inset(0 100% 0 0); opacity: 0; }
      10% { clip-path: inset(0 0 0 0); opacity: 1; }
      90% { clip-path: inset(0 0 0 0); opacity: 1; }
      100% { clip-path: inset(0 100% 0 0); opacity: 0; }
    }

    /* ── Mobile responsive — tablet (≤ 767px) ─────────────────────────
       Tighten the notification so it doesn't overflow the viewport on
       small screens. The desktop version uses a fixed 42rem width — on
       phones that's wider than the device, so we switch to a
       calc(100vw - 24px) max-width and adjust insets to a 12px gutter
       from whichever edge the merchant chose. Padding + image size
       trimmed too so text doesn't wrap awkwardly. */
    @media (max-width: 767px) {
      .bls-fake-order-section-{{ section.id }} {
        width: auto !important;
        max-width: calc(100vw - 24px) !important;
        left: {% if position == 'right' %}unset{% else %}12px{% endif %} !important;
        right: {% if position == 'right' %}12px{% else %}unset{% endif %} !important;
        bottom: 73px;
        padding: 8px 10px;
        transform: none;
      }
      .bls-fake-order-section-{{ section.id }} .product-fake-order {
        gap: 10px;
      }
      .bls-fake-order-section-{{ section.id }} [data-img] {
        width: 48px;
        height: 64px;
      }
      .bls-fake-order-section-{{ section.id }} .product-order-title a {
        font-size: 13px;
        margin: 0 0 0.4rem;
      }
      .bls-fake-order-section-{{ section.id }} .fake-list,
      .bls-fake-order-section-{{ section.id }} .minutes-ago,
      .bls-fake-order-section-{{ section.id }} .text-verify {
        font-size: 12px;
      }
      .bls-fake-order-section-{{ section.id }} .fake-order-close {
        top: 6px;
        right: 6px;
        width: 16px;
        height: 16px;
      }
    }

    /* ── Mobile responsive — small phones (≤ 575px) ───────────────────
       Even more compact. Also honours the "show on mobile" toggle —
       when off, the notification is removed entirely on phones. */
    @media (max-width: 575px) {
      .bls-fake-order-section-{{ section.id }} {
        bottom: 80px;
      }
      .bls-fake-order-section-{{ section.id }} [data-img] {
        width: 44px;
        height: 56px;
      }
      {% if show_on_mobile == false %}
        .bls-fake-order-section-{{ section.id }} {
          display: none !important;
        }
      {% endif %}
    }
{% comment %}{% endcomment %}  </style>

  <div
    id="bls__fake-order-{{ section.id }}"
    class="bls-fake-order-section-{{ section.id }} fake-order {% unless show_on_mobile %}hidden-mobile{% endunless %}"
    data-section-id="{{ section.id }}"
    data-time-delay="{{ delay_time }}"
    data-show-gap="{{ show_gap_seconds }}"
    data-anim-duration="{{ animation_duration }}"
  >
    {%- if enable_close_button %}
      <a role="button" class="fake-order-close" aria-label="close fake order">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g id="SVGRepo_iconCarrier">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.29289 5.29289C5.68342 4.90237 6.31658 4.90237 6.70711 5.29289L12 10.5858L17.2929 5.29289C17.6834 4.90237 18.3166 4.90237 18.7071 5.29289C19.0976 5.68342 19.0976 6.31658 18.7071 6.70711L13.4142 12L18.7071 17.2929C19.0976 17.6834 19.0976 18.3166 18.7071 18.7071C18.3166 19.0976 17.6834 19.0976 17.2929 18.7071L12 13.4142L6.70711 18.7071C6.31658 19.0976 5.68342 19.0976 5.29289 18.7071C4.90237 18.3166 4.90237 17.6834 5.29289 17.2929L10.5858 12L5.29289 6.70711C4.90237 6.31658 4.90237 5.68342 5.29289 5.29289Z" fill="{{ close_button_color }}"></path>
          </g>
        </svg>
      </a>
    {%- endif %}

    <div class="product-fake-order">
      <div class="fake-order-image">
        {%- if products.featured_image != blank -%}
          <a href="{{ products.url }}" data-url>
            <img
              data-img
              src="{{ products.featured_image | image_url }}"
              alt="{{ products.title }}"
              loading="lazy"
            >
          </a>
        {%- else -%}
          <a href="#" data-url>
            {%- render 'responsive-image', cls: 'w-60 h-80' -%}
          </a>
        {%- endif -%}
      </div>

      <div class="fake-order-info">
        <div class="fake-list">
          <span data-user class="user-purchase">{{ list_user[0] }}</span>
          <span style="color: #666666;">{{ 'fake_order.purchased' | t }}</span>
        </div>

        <div class="product-order-title">
          <a href="#" data-url data-title-fake>{{ 'general.product_name' | t }}</a>
        </div>

        <div class="flex">
          <div class="minutes-ago">
            <span><span data-time class="minutes-number">8</span> {{ 'fake_order.time_minutes' | t }}</span>
          </div>
          <a href="{{ verify_text_url }}" class="text-verify" data-url>
            <span class="lnr lnr-checkmark-circle mr-5"></span>
            {{ text_verify }}
            {%- if enable_verify_arrow -%}
              <svg class="verify-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 17L17 7M17 7H8M17 7V16" stroke="{{ verify_text_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            {%- endif -%}
          </a>
        </div>
      </div>

      {% unless disable_progress_bar %}
        <div class="fake-order-progressbar">
          <span data-progressbar></span>
        </div>
      {% endunless %}
    </div>

    <script type="application/json" id="bls__data-title-{{ section.id }}">
      {{- product_available | map: 'title' | json -}}
{% comment %}{% endcomment %}    </script>
    <script type="application/json" id="bls__data-url-{{ section.id }}">
      {{- product_available | map: 'url' | json -}}
{% comment %}{% endcomment %}    </script>
    <script type="application/json" id="bls__data-img-{{ section.id }}">
      {{- product_available | map: 'featured_image' | json -}}
{% comment %}{% endcomment %}    </script>
    <script type="application/json" id="bls__data-user-{{ section.id }}">
      {{- list_user | json -}}
{% comment %}{% endcomment %}    </script>

    <script>
      (function() {
        var BlsFakeOrder = {
          init: function() {
            this.showFakeOrderSequence();
          },
          showFakeOrderSequence: function() {
            var sectionId = '{{ section.id }}';
            var prd = document.querySelector('#bls__fake-order-' + sectionId);
            if (!prd) return;

            // Time before the first notification shows
            var delayTime = parseInt(prd.dataset.timeDelay) || 5000;
            // The interval between notifications (in seconds)
            var showGap = parseInt(prd.dataset.showGap) || 10;
            // The progress duration (in ms) – how long the notification stays and the progress bar fills.
            var animDuration = parseInt(prd.dataset.animDuration) || {{ animation_duration }};
            var lastRandomNumber = -1;
            var isManuallyClosed = false;

            // Data
            var u = JSON.parse(document.querySelector('#bls__data-url-' + sectionId).textContent);
            var t = JSON.parse(document.querySelector('#bls__data-title-' + sectionId).textContent);
            var i = JSON.parse(document.querySelector('#bls__data-img-' + sectionId).textContent);
            var c = JSON.parse(document.querySelector('#bls__data-user-' + sectionId).textContent);

            // Elements
            var title = prd.querySelector('[data-title-fake]');
            var urls = prd.querySelectorAll('[data-url]');
            var image = prd.querySelector('[data-img]');
            var user = prd.querySelector('[data-user]');
            var time = prd.querySelector('[data-time]');
            {% unless disable_progress_bar %}
              var prog = prd.querySelector('[data-progressbar]');
            {% endunless %}
            var close = prd.querySelector('.fake-order-close');

            if (close) {
              close.addEventListener('click', function() {
                isManuallyClosed = true;
                clearTimeout(displayTimeout);
                clearTimeout(currentTimeout);
                prd.style.display = 'none';
                {% unless disable_progress_bar %}
                  prog.style.animation = '';
                  prog.style.background = '';
                {% endunless %}
              });
            }

            function randomData() {
              if (isManuallyClosed) return;

              if (u.length > 0) {
                prd.style.display = 'block';

                // Handle animation classes based on the chosen animation style
                {% if notification_animation == 'None' %}
                  // No animation
                {% elsif notification_animation == 'Fade-in Fade Out' %}
                  prd.classList.remove('animate__fadeInDown','animate__zoomIn','animate__fadeUp','animate__slideIn','animate__revealIn');
                  prd.classList.add('animate__fadeInUp');
                {% elsif notification_animation == 'Zoom in - Zoom Out' %}
                  prd.classList.remove('animate__fadeInDown','animate__fadeInUp','animate__fadeUp','animate__slideIn','animate__revealIn');
                  prd.classList.add('animate__zoomIn');
                {% elsif notification_animation == 'Fade Up - Fade Down' %}
                  prd.classList.remove('animate__fadeInDown','animate__fadeInUp','animate__zoomIn','animate__slideIn','animate__revealIn');
                  prd.classList.add('animate__fadeUp');
                {% elsif notification_animation == 'Slide In - Slide Out' %}
                  prd.classList.remove('animate__fadeInDown','animate__fadeInUp','animate__zoomIn','animate__fadeUp','animate__revealIn');
                  prd.classList.add('animate__slideIn');
                {% elsif notification_animation == 'Normal Original Animation' %}
                  prd.classList.remove('animate__fadeInDown','animate__fadeInUp','animate__zoomIn','animate__fadeUp','animate__slideIn');
                  prd.classList.add('animate__original');
                {% elsif notification_animation == 'Reveal In - Reveal Out' %}
                  prd.classList.remove('animate__fadeInDown','animate__fadeInUp','animate__zoomIn','animate__fadeUp','animate__slideIn');
                  prd.classList.add('animate__revealIn');
                {% endif %}

                var randomNumber, randomImg;
                do {
                  randomNumber = Math.floor(Math.random() * c.length);
                  randomImg = Math.floor(Math.random() * i.length);
                } while (randomNumber === lastRandomNumber && randomImg === lastRandomNumber);
                lastRandomNumber = randomNumber;

                // Update content
                title.textContent = t[randomImg];
                user.textContent = c[randomNumber];
                if (image) {
                  image.src = i[randomImg];
                  image.alt = t[randomImg];
                }
                urls.forEach(function(link) {
                  link.href = u[randomImg];
                });

                // Fake minutes
                var fakeTimeOrder = Math.floor(Math.random() * 60 + randomNumber);
                time.textContent = fakeTimeOrder;

                // Set up the progress bar duration to be controlled solely by the animation duration
                {% unless disable_progress_bar %}
                  var barDuration = animDuration;
                  prog.style.animationDuration = barDuration + 'ms';
                  prog.style.animationName = 'bls-progressbar-' + sectionId;
                  prog.style.animationFillMode = 'forwards';
                  prog.style.animationTimingFunction = 'linear';
                  prog.style.background = '{{ progress_bar_color }}';
                {% endunless %}

                // Hide notification after animDuration ms and then schedule the next notification after showGap seconds
                displayTimeout = setTimeout(function() {
                  {% if notification_animation != 'None' %}
                    prd.classList.remove('animate__fadeInUp','animate__zoomIn','animate__fadeUp','animate__slideIn','animate__revealIn');
                    prd.classList.add('animate__fadeInDown');
                  {% endif %}
                  {% unless disable_progress_bar %}
                    prog.style.animation = '';
                    prog.style.background = '';
                  {% endunless %}
                  prd.style.display = 'none';

                  // Schedule the next notification after the specified show popup gap (in seconds)
                  currentTimeout = setTimeout(randomData, showGap * 1000);
                }, animDuration);
              }
            }

            // First appearance after the initial delayTime
            var displayTimeout;
            var currentTimeout = setTimeout(randomData, delayTime);
          }
        };

        document.addEventListener('DOMContentLoaded', function() {
          BlsFakeOrder.init();
        });
      })();
{% comment %}{% endcomment %}    </script>
  </div>
{%- endif -%}


</template>

<schema>
{
  "type": "fake-order",
  "name": "Order Notification Pro 1",
  "settings": [
    {
      "type": "checkbox",
      "id": "section_enabled",
      "label": "Enable section",
      "default": true,
