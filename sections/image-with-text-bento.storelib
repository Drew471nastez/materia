<template compat="shopify">
{%- assign fb_accessibility_tile_image = 'accessibility.tile_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Bento

  A bento-style grid of mixed text-cards and image-cards. Cards can be
  any size (1x1 / 2x1 / 1x2 / 2x2) and each card chooses its own type
  (text card on solid bg, image card, or text-over-image).

  Lavender / purple colour palette by default — easy to retune.

  Custom font picker so the section can use a distinctive heading font
  (the reference uses a slab/curly serif — drop in any Shopify font).
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  assign body_font = st.body_font
  assign heading_font = st.heading_font
-%}

<style>
  #shopify-section-{{ sid }} {
    background-color: {{ st.section_bg | default: '#FFFFFF' }};
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.enable_custom_fonts and body_font -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} :is(p, div, span, a, li) {
      font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
      font-weight: {{ body_font.weight }};
    }
  {%- endif -%}
  {%- if st.enable_custom_fonts and heading_font -%}
    #shopify-section-{{ sid }} .iwb__heading,
    #shopify-section-{{ sid }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-weight: {{ heading_font.weight }};
    }
  {%- endif -%}

  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .iwb__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .iwb__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .iwb__inner { padding-inline: 3rem; }
      }
    {%- when 'custom' -%}
      #shopify-section-{{ sid }} .iwb__inner { max-width: {{ st.custom_max_width_desktop | default: 1200 }}px; margin-inline: auto; }
  {%- endcase -%}

  /* Overall scale (desktop only — keeps mobile native size) */
  {%- assign _scale = st.scale_desktop | default: 100 -%}
  {%- if _scale != 100 -%}
    @media (min-width: 900px) {
      #shopify-section-{{ sid }} .iwb__grid {
        transform: scale({{ _scale | divided_by: 100.0 }});
        transform-origin: center top;
      }
    }
  {%- endif -%}

  #shopify-section-{{ sid }} .iwb {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwb {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwb__inner { width: 100%; box-sizing: border-box; }

  /* Section heading (optional, above the grid) */
  #shopify-section-{{ sid }} .iwb__head {
    text-align: center;
    margin: 0 auto {{ st.head_gap | default: 32 }}px;
    max-width: 760px;
  }
  #shopify-section-{{ sid }} .iwb__head h2 {
    margin: 0 0 8px;
    color: {{ st.section_heading_color | default: '#3F2A5C' }};
    font-size: {{ st.section_heading_size_mobile | default: 28 }}px;
    line-height: 1.15;
    font-weight: 700;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwb__head h2 { font-size: {{ st.section_heading_size_desktop | default: 40 }}px; }
  }
  #shopify-section-{{ sid }} .iwb__head p {
    margin: 0;
    color: {{ st.section_subheading_color | default: '#5B4480' }};
    font-size: 15px;
    line-height: 1.55;
  }

  /* Bento grid — 2 cols on tablet, 3 cols on desktop */
  #shopify-section-{{ sid }} .iwb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.gap_mobile | default: 16 }}px;
  }
  @media (min-width: 600px) {
    #shopify-section-{{ sid }} .iwb__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax({{ st.row_height_desktop | default: 280 }}px, auto);
      grid-auto-flow: dense;
      gap: {{ st.gap_desktop | default: 20 }}px;
    }
  }
  /* Switch to the full multi-column grid at 850px so the layout looks
     consistent at every "desktop-ish" width — no awkward 2-col jump
     between tablet and full-desktop breakpoints. */
  @media (min-width: 850px) {
    #shopify-section-{{ sid }} .iwb__grid {
      grid-template-columns: repeat({{ st.columns | default: 3 }}, minmax(0, 1fr));
    }
  }

  /* Card base */
  #shopify-section-{{ sid }} .iwb__card {
    position: relative;
    overflow: hidden;
    border-radius: {{ st.card_radius | default: 24 }}px;
    min-height: {{ st.row_height_mobile | default: 220 }}px;
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .iwb__card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
    padding: {{ st.card_padding | default: 28 }}px;
    gap: 12px;
  }
  #shopify-section-{{ sid }} .iwb__caption {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0;
  }
  #shopify-section-{{ sid }} .iwb__heading {
    margin: 0;
    font-size: {{ st.card_heading_size_mobile | default: 22 }}px;
    line-height: 1.15;
    font-weight: 700;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwb__heading { font-size: {{ st.card_heading_size_desktop | default: 32 }}px; }
  }
  #shopify-section-{{ sid }} .iwb__body {
    margin: 0;
    line-height: 1.5;
    font-size: {{ st.card_body_size | default: 14 }}px;
    max-width: 320px;
  }
  #shopify-section-{{ sid }} .iwb__body p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iwb__body p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .iwb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ sid }} .iwb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ sid }} .iwb__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Per-block card layout (size + colors) */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'text_card' or block.type == 'image_card' or block.type == 'text_over_image' -%}
      #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] {
        background-color: {{ bs.bg | default: st.tile_bg_a | default: '#3E2C73' }};
        color: {{ bs.text_color | default: '#FFFFFF' }};
      }
      @media (min-width: 600px) {
        #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] {
          grid-column: span {{ bs.col_span_desktop | default: 1 }};
          grid-row: span {{ bs.row_span_desktop | default: 1 }};
        }
      }
      #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] .iwb__caption,
      #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] .iwb__heading,
      #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] .iwb__body {
        color: {{ bs.text_color | default: '#FFFFFF' }};
      }
      {%- if block.type == 'text_over_image' and bs.overlay_color != blank -%}
        #shopify-section-{{ sid }} .iwb__card[data-block-id="{{ block.id }}"] .iwb__overlay {
          background: {{ bs.overlay_color }};
          opacity: {{ bs.overlay_opacity | default: 25 | divided_by: 100.0 }};
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="iwb-{{ sid }}" class="iwb section sec__image-text-bento" data-section-id="{{ sid }}">
  <div class="iwb__inner">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="iwb__head">
        {%- if st.heading != blank -%}<h2>{{ st.heading | escape }}</h2>{%- endif -%}
        {%- if st.subheading != blank -%}<p>{{ st.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="iwb__grid">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <div class="iwb__card iwb__card--{{ block.type }}" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>

          {%- if block.type == 'image_card' or block.type == 'text_over_image' -%}
            <div class="iwb__bg">
              {%- if bs.image != blank -%}
                <img
                  src="{{ bs.image | image_url: width: 1000 }}"
                  srcset="{{ bs.image | image_url: width: 500 }} 500w,
                          {{ bs.image | image_url: width: 800 }} 800w,
                          {{ bs.image | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 1100px) 33vw, 50vw"
                  alt="{{ bs.image.alt | default: bs.heading | default: fb_accessibility_tile_image | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
              {%- endif -%}
            </div>
            {%- if block.type == 'text_over_image' -%}<div class="iwb__overlay" aria-hidden="true"></div>{%- endif -%}
          {%- endif -%}

          {%- if block.type == 'text_card' or block.type == 'text_over_image' -%}
            <div class="iwb__card-content">
              {%- if bs.caption != blank -%}<p class="iwb__caption">{{ bs.caption | escape }}</p>{%- endif -%}
              {%- if bs.heading != blank -%}
                <{{ bs.heading_tag | default: 'h3' }} class="iwb__heading">{{ bs.heading | escape }}</{{ bs.heading_tag | default: 'h3' }}>
              {%- endif -%}
              {%- if bs.body != blank -%}<div class="iwb__body">{{ bs.body }}</div>{%- endif -%}
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-with-text-bento",
  "name": "Image With Text Bento",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Section heading (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "section_heading_color",
      "label": "Heading color",
      "default": "#3F2A5C"
    },
    {
      "type": "color",
      "id": "section_subheading_color",
      "label": "Subheading color",
      "default": "#5B4480"
    },
    {
      "type": "range",
      "id": "section_heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Gap below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom max-width (use slider below)"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_max_width_desktop",
      "label": "Custom max-width (desktop)",
      "info": "Used when Section width = Custom max-width.",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "scale_desktop",
      "label": "Overall scale (desktop)",
      "info": "Zooms the entire bento grid. 100 = no change.",
      "min": 80,
      "max": 120,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop ≥1100px)",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_height_desktop",
      "label": "Row height (desktop)",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "Min height (mobile)",
      "min": 120,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Card typography"
    },
    {
      "type": "range",
      "id": "card_heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_body_size",
      "label": "Body size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Custom fonts (optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "When off, this section uses the theme's global Typography fonts."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "info": "Used for the section heading and every card heading."
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Section colors + spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text_card",
      "name": "Text card",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (small caps)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading HTML tag",
          "default": "h3",
          "options": [
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Short supporting copy that explains this tile.</p>"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Style"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#3E2C73"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Tile size (desktop)"
        },
        {
          "type": "select",
