<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image With Text Bento.
  A bento grid of text cards, image cards and text over an image. Each card
  spans 1 to 3 columns and 1 or 2 rows on desktop and stacks on mobile.
  Colours follow the colour scheme; custom colours and fonts are opt-in.
  Every value below is a --tg-* / --iwb-* variable on the root or the card,
  written again live by media-live-text-grid.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign cols = st.columns | default: '3' | plus: 0
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.5%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign scale = st.scale_desktop | default: 100 | divided_by: 100.0
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign subheading_blocks = section.blocks | where: 'type', 'subheading'
-%}
<style data-tg-margins>{% render 'media-tg-base', st: st, sid: sid, bp: 768, part: 'margins' %}</style>
<style>
{% render 'media-tg-base', st: st, sid: sid, bp: 768 %}
#shopify-section-{{ sid }} .iwb__head { display: grid; gap: 8px; text-align: center; margin: 0 auto var(--iwb-head-gap); max-width: 760px; }
#shopify-section-{{ sid }} .iwb__head:not(:has(> :not([hidden]))) { display: none; }
#shopify-section-{{ sid }} .iwb__title { margin: 0; color: var(--iwb-head-color, var(--color-heading)); font-size: var(--iwb-h2-m); line-height: 1.15; }
#shopify-section-{{ sid }} .iwb__sub { margin: 0; color: var(--iwb-sub-color, var(--color-text)); font-size: var(--iwb-sub-size, 15px); line-height: 1.55; }
#shopify-section-{{ sid }} .iwb__sub p { margin: 0 0 .5em; }
#shopify-section-{{ sid }} .iwb__sub > :last-child { margin-bottom: 0; }
#shopify-section-{{ sid }} .iwb__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--iwb-gap-m); }
#shopify-section-{{ sid }} .iwb__card {
  position: relative; display: flex; overflow: hidden; isolation: isolate; min-width: 0;
  border-radius: var(--iwb-radius); min-height: var(--iwb-row-m);
  background: var(--iwb-card-bg, var(--iwb-d-bg)); border: 1px solid var(--iwb-d-line, transparent);
  --iwb-d-bg: color-mix(in srgb, var(--color-text) 8%, var(--color-background));
  --iwb-d-fg: var(--color-text); --iwb-d-head: var(--color-heading);
}
#shopify-section-{{ sid }} .iwb__card[data-style="inverse"] { --iwb-d-bg: var(--color-heading); --iwb-d-fg: var(--color-background); --iwb-d-head: var(--color-background); }
#shopify-section-{{ sid }} .iwb__card[data-style="tint"] { --iwb-d-bg: color-mix(in srgb, var(--color-primary) 16%, var(--color-background)); }
#shopify-section-{{ sid }} .iwb__card[data-style="outline"] { --iwb-d-bg: transparent; --iwb-d-line: var(--color-border); }
#shopify-section-{{ sid }} .iwb__card--text_over_image { --iwb-d-fg: var(--color-heading); --iwb-d-head: var(--color-heading); }
#shopify-section-{{ sid }} .iwb__card-content {
  position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; align-items: center;
  gap: 12px; width: 100%; padding: var(--iwb-pad); text-align: center; color: var(--iwb-card-fg, var(--iwb-d-fg));
}
#shopify-section-{{ sid }} .iwb__card[data-position="top"] .iwb__card-content { justify-content: flex-start; }
#shopify-section-{{ sid }} .iwb__card[data-position="bottom"] .iwb__card-content { justify-content: flex-end; }
#shopify-section-{{ sid }} .iwb__card--text_over_image .iwb__card-content { text-shadow: 0 1px 3px color-mix(in srgb, var(--iwb-ov-color, var(--color-background)) 70%, transparent); }
#shopify-section-{{ sid }} .iwb__caption { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
#shopify-section-{{ sid }} .iwb__heading { margin: 0; font-size: var(--iwb-h3-m); line-height: 1.15; color: var(--iwb-card-fg, var(--iwb-d-head)); }
#shopify-section-{{ sid }} .iwb__body { margin: 0; max-width: 320px; font-size: var(--iwb-body); line-height: 1.5; }
#shopify-section-{{ sid }} .iwb__body p { margin: 0 0 .5em; }
#shopify-section-{{ sid }} .iwb__body > :last-child { margin-bottom: 0; }
#shopify-section-{{ sid }} .iwb__bg { position: absolute; inset: 0; z-index: 0; }
#shopify-section-{{ sid }} .iwb__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
#shopify-section-{{ sid }} .iwb__overlay { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: var(--iwb-ov-color, var(--color-background)); opacity: var(--iwb-ov-op); }
@media (min-width: 768px) {
  #shopify-section-{{ sid }} .iwb__title { font-size: var(--iwb-h2-d); }
  #shopify-section-{{ sid }} .iwb__heading { font-size: var(--iwb-h3-d); }
  #shopify-section-{{ sid }} .iwb__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(var(--iwb-row-d), auto); grid-auto-flow: dense; gap: var(--iwb-gap-d); }
  #shopify-section-{{ sid }} .iwb__card { min-height: 0; grid-column: span var(--iwb-cs-t, 1); grid-row: span var(--iwb-rs, 1); }
}
@media (min-width: 1024px) {
  #shopify-section-{{ sid }} .iwb__grid { grid-template-columns: repeat(var(--iwb-cols), minmax(0, 1fr)); zoom: var(--iwb-scale, 1); width: calc(100% / var(--iwb-scale, 1)); }
  #shopify-section-{{ sid }} .iwb__card { grid-column: span var(--iwb-cs-d, 1); }
}
{% comment %}{% endcomment %}</style>
<div id="iwb-{{ sid }}" class="tg iwb section sec__image-text-bento color-{{ color_scheme }} gradient" data-tg-root="bento" data-tg-section="{{ sid }}" data-tg-placeholder="{{ placeholder }}" data-tg-settings="{{ st | json | escape }}" data-tg-defaults='{"color_scheme":"default-color-scheme","section_width":"container","custom_max_width_desktop":1200,"reset_spacing":true,"columns":"3","gap_desktop":20,"row_height_desktop":280,"head_gap":32,"card_padding":28,"scale_desktop":100,"card_radius":24,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","section_heading_size_desktop":40,"card_heading_size_desktop":32,"card_body_size":14,"padding_top_desktop":100,"padding_bottom_desktop":100,"side_padding_desktop":32,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"gap_mobile":16,"row_height_mobile":220,"section_heading_size_mobile":28,"card_heading_size_mobile":22,"padding_top_mobile":60,"padding_bottom_mobile":60,"side_padding_mobile":20,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-tg-block-defaults='{"text_card":{"heading":"Card heading","heading_tag":"h3","body":"\u003cp>Short supporting copy that explains this tile.\u003c/p>","card_style":"inverse","col_span_desktop":"1","row_span_desktop":"1","enable_custom_style":false},"image_card":{"col_span_desktop":"1","row_span_desktop":"1"},"text_over_image":{"heading":"Headline","heading_tag":"h3","content_position":"center","col_span_desktop":"1","row_span_desktop":"1","overlay_opacity":50,"enable_custom_style":false},"heading":{"text":"Inside the shop","enable_custom_style":false,"size_enable":false,"size_desktop":40,"size_mobile":28},"subheading":{"enable_custom_style":false,"size_enable":false,"size":15}}'
  style="{% render 'media-tg-vars', st: st %}--iwb-cols:{{ cols }};--iwb-scale:{{ scale }};--iwb-gap-d:{{ st.gap_desktop | default: 20 }}px;--iwb-gap-m:{{ st.gap_mobile | default: 16 }}px;--iwb-row-d:{{ st.row_height_desktop | default: 280 }}px;--iwb-row-m:{{ st.row_height_mobile | default: 220 }}px;--iwb-radius:{{ st.card_radius | default: 0 }}px;--iwb-pad:{{ st.card_padding | default: 28 }}px;--iwb-head-gap:{{ st.head_gap | default: 32 }}px;--iwb-h2-d:{{ st.section_heading_size_desktop | default: 40 }}px;--iwb-h2-m:{{ st.section_heading_size_mobile | default: 28 }}px;--iwb-h3-d:{{ st.card_heading_size_desktop | default: 32 }}px;--iwb-h3-m:{{ st.card_heading_size_mobile | default: 22 }}px;--iwb-body:{{ st.card_body_size | default: 14 }}px;{% if st.enable_custom_style %}--iwb-head-color:{% render 'scheme-color', color: st.section_heading_color, fallback: 'initial' %};--iwb-sub-color:{% render 'scheme-color', color: st.section_subheading_color, fallback: 'initial' %};{% endif %}">
  <div class="tg__inner iwb__inner">
    <div class="iwb__head">
      {%- comment -%} Legacy section heading/subheading: only when the section has no block of that type. {%- endcomment -%}
      {%- if heading_blocks.size == 0 -%}
        <h2 class="tg__h iwb__title" data-iwb-legacy="heading"{% if st.heading == blank %} hidden{% endif %}>{{ st.heading }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- if block.type == 'heading' -%}
          <h2 class="tg__h iwb__title" data-block-id="{{ block.id }}" data-tg-block="{{ block.id }}" data-tg-type="heading" data-tg-settings="{{ bs | json | escape }}" style="{% if bs.enable_custom_style and bs.color != blank %}--iwb-head-color:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{% endif %}{% if bs.size_enable %}--iwb-h2-d:{{ bs.size_desktop | default: 40 }}px;--iwb-h2-m:{{ bs.size_mobile | default: 28 }}px;{% endif %}" {{ block.shopify_attributes }}{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</h2>
        {%- elsif block.type == 'subheading' -%}
          <div class="iwb__sub" data-block-id="{{ block.id }}" data-tg-block="{{ block.id }}" data-tg-type="subheading" data-tg-settings="{{ bs | json | escape }}" style="{% if bs.enable_custom_style and bs.color != blank %}--iwb-sub-color:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{% endif %}{% if bs.size_enable %}--iwb-sub-size:{{ bs.size | default: 15 }}px;{% endif %}" {{ block.shopify_attributes }}{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>
        {%- endif -%}
      {%- endfor -%}
      {%- if subheading_blocks.size == 0 -%}
        <p class="iwb__sub" data-iwb-legacy="subheading"{% if st.subheading == blank %} hidden{% endif %}>{{ st.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="iwb__grid">
      {%- for block in section.blocks -%}
        {%- unless block.type == 'text_card' or block.type == 'image_card' or block.type == 'text_over_image' -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign bs = block.settings
          assign cs = bs.col_span_desktop | default: '1' | plus: 0
          assign cs_d = cs
          if cs_d > cols
            assign cs_d = cols
          endif
          assign cs_t = cs
          if cs_t > 2
            assign cs_t = 2
          endif
          assign rs = bs.row_span_desktop | default: '1' | plus: 0
          assign op = bs.overlay_opacity | default: 0 | divided_by: 100.0
        -%}
        <div class="iwb__card iwb__card--{{ block.type }}" data-block-id="{{ block.id }}" data-tg-block="{{ block.id }}" data-tg-type="{{ block.type }}" data-tg-settings="{{ bs | json | escape }}"{% if block.type == 'text_card' %} data-style="{{ bs.card_style | default: 'inverse' }}"{% endif %}{% if block.type == 'text_over_image' %} data-position="{{ bs.content_position | default: 'center' }}"{% endif %}
          style="--iwb-cs-d:{{ cs_d }};--iwb-cs-t:{{ cs_t }};--iwb-rs:{{ rs }};{% if block.type == 'text_over_image' %}--iwb-ov-op:{{ op }};{% endif %}{% if bs.enable_custom_style %}{% if block.type == 'text_card' %}--iwb-card-bg:{% render 'scheme-color', color: bs.bg, fallback: 'initial' %};{% endif %}{% if block.type != 'image_card' %}--iwb-card-fg:{% render 'scheme-color', color: bs.text_color, fallback: 'initial' %};{% endif %}{% if block.type == 'text_over_image' %}--iwb-ov-color:{% render 'scheme-color', color: bs.overlay_color, fallback: 'initial' %};{% endif %}{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.type == 'image_card' or block.type == 'text_over_image' -%}
            <div class="iwb__bg">
              {%- if bs.image != blank -%}
                <img src="{{ bs.image | image_url: width: 1000 }}" srcset="{{ bs.image | image_url: width: 500 }} 500w, {{ bs.image | image_url: width: 800 }} 800w, {{ bs.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" alt="{{ bs.image.alt | default: bs.heading | strip_html | escape }}" width="{{ bs.image.width | default: 1000 }}" height="{{ bs.image.height | default: 1000 }}" loading="lazy" decoding="async">
              {%- else -%}
                <img class="tg__ph" src="{{ placeholder }}" alt="" width="400" height="300" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
            {%- if block.type == 'text_over_image' -%}<div class="iwb__overlay" aria-hidden="true"></div>{%- endif -%}
          {%- endif -%}
          {%- if block.type == 'text_card' or block.type == 'text_over_image' -%}
            <div class="iwb__card-content">
              <p class="iwb__caption"{% if bs.caption == blank %} hidden{% endif %}>{{ bs.caption | escape }}</p>
              <h3 class="tg__h iwb__heading"{% if bs.heading == blank %} hidden{% endif %}>{{ bs.heading }}</h3>
              <div class="iwb__body"{% if bs.body == blank %} hidden{% endif %}>{{ bs.body }}</div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "image-with-text-bento",
  "name": "Image With Text Bento",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_max_width_desktop",
      "label": "Custom max width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "visible_if": "{{ section.settings.section_width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap between cards",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_height_desktop",
      "label": "Row height",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "scale_desktop",
      "label": "Grid scale (desktop)",
      "min": 80,
      "max": 120,
      "step": 1,
      "unit": "%",
      "default": 100,
      "info": "Zooms the whole grid on screens 1024px and wider."
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "section_heading_color",
      "label": "Heading",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "section_subheading_color",
      "label": "Subheading",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "section_heading_size_desktop",
      "label": "Heading size",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_heading_size_desktop",
      "label": "Card heading size",
      "min": 16,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_body_size",
      "label": "Card text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Side padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between cards (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "Card min height (mobile)",
      "min": 120,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "section_heading_size_mobile",
