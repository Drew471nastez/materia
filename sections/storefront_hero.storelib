<template>
<section class="sfh sfh--{{ settings.media_position }}{% if settings.mobile_media_first %} sfh--mfirst{% endif %}{% if settings.motion %} sfh--motion{% endif %}{% if settings.image %}{% elsif settings.product.image %}{% elsif page.in_editor %}{% else %} sfh--solo{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ settings.text_color }}; --s-heading: {{ settings.heading_color }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ settings.button_color }}; --s-btn-text: {{ settings.button_text_color }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-card: {{ scheme.bg }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --s-pm: {{ settings.padding_mobile }}px;">
  <div class="sfh__in sfh__in--{{ settings.max_width }}">
    <div class="sfh__copy">
      <h1 class="sfh__h sfh__h--{{ settings.heading_size }} sfh__rise">{{ settings.heading }}</h1>
      {% if settings.subheading %}<p class="sfh__sub sfh__rise">{{ settings.subheading }}</p>{% endif %}

      {% if settings.button_text or settings.link_text %}
        <div class="sfh__actions sfh__rise">
          {% if settings.button_text %}
            {% if settings.button_url %}
              <a class="sfh__btn" data-sl-button href="{{ settings.button_url | url }}"><span class="sfh__btn-label">{{ settings.button_text }}</span><svg class="sfh__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"/></svg><span class="sfh__shine" aria-hidden="true"></span></a>
            {% elsif settings.product.url %}
              <a class="sfh__btn" data-sl-button href="{{ settings.product.url | url }}"><span class="sfh__btn-label">{{ settings.button_text }}</span><svg class="sfh__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"/></svg><span class="sfh__shine" aria-hidden="true"></span></a>
            {% else %}
              <a class="sfh__btn" data-sl-button href="{{ settings.button_url | default: '#' | url }}"><span class="sfh__btn-label">{{ settings.button_text }}</span><svg class="sfh__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"/></svg><span class="sfh__shine" aria-hidden="true"></span></a>
            {% endif %}
          {% endif %}
          {% if settings.link_text %}<a class="sfh__link" href="{{ settings.link_url | default: '#' | url }}">{{ settings.link_text }}</a>{% endif %}
        </div>
      {% endif %}

      {% if settings.proof_text %}<p class="sfh__proof sfh__rise">{{ settings.proof_text }}</p>{% endif %}

      {% for block in blocks %}
        {% if forloop.first %}<ul class="sfh__points sfh__rise">{% endif %}
        <li class="sfh__point" data-block-id="{{ block.id }}">
          <span class="sfh__icon" aria-hidden="true">
            {% if block.settings.icon == 'truck' %}
              <svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
            {% elsif block.settings.icon == 'return' %}
              <svg viewBox="0 0 24 24"><path d="M9 7H4V2"/><path d="M4.5 7A8 8 0 1 1 4 13"/></svg>
            {% elsif block.settings.icon == 'lock' %}
              <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            {% endif %}
          </span>
          <span>{{ block.settings.text }}</span>
        </li>
        {% if forloop.last %}</ul>{% endif %}
      {% else %}
        {% if page.in_editor %}<p class="sfh__empty">Add reassurance points in the sidebar</p>{% endif %}
      {% endfor %}
    </div>

    {% if settings.image or settings.product.image or page.in_editor %}
    <div class="sfh__media">
      <div class="sfh__frame" style="aspect-ratio: {{ settings.media_shape }};">
        {% if settings.image %}
          <img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" width="1000" height="1250" loading="eager" decoding="async">
        {% elsif settings.product.image %}
          <img src="{{ settings.product.image | asset }}" alt="{{ settings.product.title }}" width="1000" height="1250" loading="eager" decoding="async">
        {% elsif page.in_editor %}
          <div class="sfh__placeholder">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/></svg>
            <span>{{ settings.image_hint }}</span>
          </div>
        {% endif %}

        {% if settings.show_price_card and settings.product.title %}
          <a class="sfh__card" href="{{ settings.product.url | default: '#' | url }}">
            <span class="sfh__card-title">{{ settings.product.title }}</span>
            <span class="sfh__card-price">
              {{ settings.product.price }}
              {% if settings.product.compare_price %}<s class="sfh__card-was">{{ settings.product.compare_price }}</s>{% endif %}
            </span>
          </a>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.sfh { container-type: inline-size; background: var(--s-bg); color: var(--s-text); overflow: hidden; }
.sfh__in { margin: 0 auto; display: grid; gap: 32px; align-items: center; padding: calc(var(--s-pm) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px); }
.sfh__in--medium { max-width: 960px; }
.sfh__in--wide { max-width: var(--theme-page-width, 1280px); }
.sfh__in--full { max-width: none; }

.sfh__copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
.sfh--mfirst .sfh__media { order: -1; }

.sfh__h { margin: 0; color: var(--s-heading); font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.02em); line-height: var(--section-heading-line-height, 1.08); text-transform: var(--section-heading-transform, none); text-wrap: balance; overflow-wrap: break-word; max-width: 20ch; }
.sfh__h--small { font-size: clamp(30px, 5cqi, 44px); }
.sfh__h--medium { font-size: clamp(34px, 6cqi, 56px); }
.sfh__h--large { font-size: clamp(38px, 7.5cqi, 68px); }

.sfh__sub { margin: 16px 0 0; max-width: 36rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-text); }

.sfh__actions { display: flex; flex-direction: column; align-items: stretch; gap: 12px; margin-top: 32px; width: 100%; }
.sfh__btn { position: relative; overflow: hidden; isolation: isolate; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: var(--sl-button-padding, 14px 28px); font-size: var(--sl-button-size, 16px); font-weight: var(--theme-button-weight, 600); text-decoration: none; background: var(--s-btn); color: var(--s-btn-text); border: 1px solid var(--s-btn); border-radius: var(--s-radius); transition: background-color 200ms ease, color 200ms ease, transform 200ms ease; }
.sfh__btn:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); transform: translateY(-1px); }
.sfh__btn:focus-visible, .sfh__link:focus-visible, .sfh__card:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; }
.sfh__arrow { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms ease; }
.sfh__btn:hover .sfh__arrow { transform: translateX(3px); }
.sfh__shine { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.45) 50%, transparent 70%); transform: translateX(-110%); }
.sfh__btn:hover .sfh__shine { transform: translateX(110%); transition: transform 650ms ease; }

.sfh__link { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 4px; font-size: 15px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; transition: opacity 150ms ease; }
.sfh__link:hover { opacity: 0.7; }

.sfh__proof { margin: 16px 0 0; font-size: 14px; line-height: 1.5; color: var(--s-text); }

.sfh__points { list-style: none; margin: 32px 0 0; padding: 24px 0 0; border-top: 1px solid var(--s-border); display: grid; gap: 12px; width: 100%; }
.sfh__point { display: flex; align-items: center; gap: 12px; font-size: 15px; line-height: 1.4; color: var(--s-heading); }
.sfh__icon { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--s-border); border-radius: var(--s-radius); color: var(--s-heading); }
.sfh__icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.sfh__empty { margin: 24px 0 0; font-size: 14px; opacity: 0.6; }

.sfh__media { min-width: 0; }
.sfh__frame { position: relative; width: 100%; border-radius: var(--theme-image-radius, 8px); overflow: hidden; background: var(--s-border); }
.sfh__frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
.sfh__placeholder { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 8px; border: 1px dashed var(--s-text); border-radius: inherit; font-size: 14px; color: var(--s-text); opacity: 0.7; text-align: center; padding: 24px; }
.sfh__placeholder svg { width: 44px; height: 44px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }

.sfh__card { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; background: var(--s-card); color: var(--s-heading); border: 1px solid var(--s-border); border-radius: var(--s-radius); box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06); text-decoration: none; transition: transform 200ms ease; }
.sfh__card:hover { transform: translateY(-2px); }
.sfh__card-title { font-size: 14px; font-weight: var(--subheading-weight, 600); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.sfh__card-price { flex: none; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 700; }
.sfh__card-was { font-size: 13px; font-weight: 400; color: var(--s-text); opacity: 0.75; }

.sfh--motion .sfh__rise { opacity: 0; animation: sfh-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
.sfh--motion .sfh__copy > .sfh__rise:nth-child(1) { animation-delay: 60ms; }
.sfh--motion .sfh__copy > .sfh__rise:nth-child(2) { animation-delay: 160ms; }
.sfh--motion .sfh__copy > .sfh__rise:nth-child(3) { animation-delay: 260ms; }
.sfh--motion .sfh__copy > .sfh__rise:nth-child(4) { animation-delay: 360ms; }
.sfh--motion .sfh__copy > .sfh__rise:nth-child(5) { animation-delay: 460ms; }
.sfh--motion .sfh__media { opacity: 0; animation: sfh-fade 900ms ease 120ms forwards; }
.sfh--motion .sfh__frame { animation: sfh-float 6s ease-in-out 1s infinite; }
@keyframes sfh-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
@keyframes sfh-fade { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: none; } }
@keyframes sfh-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

@container (min-width: 520px) {
  .sfh__actions { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 24px; width: auto; }
  .sfh__points { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px 24px; }
  .sfh__card { left: 16px; right: auto; bottom: 16px; min-width: 240px; max-width: calc(100% - 32px); }
}
@container (min-width: 760px) {
  .sfh__in { grid-template-columns: 6fr 5fr; gap: 64px; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
  .sfh__copy { order: 1; }
  .sfh__media, .sfh--mfirst .sfh__media { order: 2; }
  .sfh--left .sfh__in { grid-template-columns: 5fr 6fr; }
  .sfh--left .sfh__media, .sfh--left.sfh--mfirst .sfh__media { order: 0; }
  .sfh.sfh--solo .sfh__in { grid-template-columns: minmax(0, 1fr); }
  .sfh__sub { margin-top: 24px; }
}

@media (prefers-reduced-motion: reduce) {
  .sfh--motion .sfh__rise, .sfh--motion .sfh__media { opacity: 1; animation: none; }
  .sfh--motion .sfh__frame { animation: none; }
  .sfh__btn, .sfh__arrow, .sfh__card, .sfh__link { transition: none; }
  .sfh__btn:hover .sfh__shine { transition: none; transform: translateX(-110%); }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "storefront_hero",
  "name": "Storefront Hero",
  "category": "hero",
  "description": "A headline, one clear button and a large product picture with its live price, and reassurance points underneath.",
  "version": "1.0.0",
  "icon": "layout",
  "settings": [
    {"type":"header","id":"hdr_content","label":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Everyday essentials we tested ourselves, delivered to your door"},
    {"type":"textarea","id":"subheading","label":"Supporting line","default":"A small range of things we tried and kept. Fair prices, tracked delivery and easy returns if it isn't right."},
    {"type":"text","id":"button_text","label":"Button","default":"Shop the bestsellers"},
    {"type":"url","id":"button_url","label":"Button link","default":"/products","info":"Left empty, the button goes to the featured product."},
    {"type":"text","id":"link_text","label":"Second link","default":"See how it works"},
    {"type":"url","id":"link_url","label":"Second link address","default":""},
    {"type":"text","id":"proof_text","label":"Proof line","default":"","info":"Only something true, such as a real review count."},
    {"type":"header","id":"hdr_media","label":"Product and picture"},
    {"type":"product_picker","id":"product","label":"Featured product"},
    {"type":"toggle","id":"show_price_card","label":"Show the product's price over the picture","default":true},
    {"type":"image_picker","id":"image","label":"Picture","default":"","info":"Leave empty to use the featured product's photo."},
    {"type":"text","id":"image_alt","label":"Picture description","default":"Our bestselling product"},
    {"type":"text","id":"image_hint","label":"Empty picture note","default":"Choose a product or add a product photo"},
    {"type":"select","id":"media_shape","label":"Picture shape","default":"4 / 5","options":[{"label":"Portrait","value":"4 / 5"},{"label":"Square","value":"1 / 1"},{"label":"Landscape","value":"4 / 3"}]},
    {"type":"header","id":"hdr_layout","label":"Layout"},
    {"type":"radio","id":"media_position","label":"Picture on desktop","default":"right","options":[{"label":"Left","value":"left"},{"label":"Right","value":"right"}]},
    {"type":"toggle","id":"mobile_media_first","label":"Picture above the text on phones","default":false},
    {"type":"select","id":"heading_size","label":"Heading size","default":"medium","options":[{"label":"Small","value":"small"},{"label":"Medium","value":"medium"},{"label":"Large","value":"large"}]},
    {"type":"select","id":"max_width","label":"Content width","default":"wide","options":[{"label":"Medium","value":"medium"},{"label":"Wide","value":"wide"},{"label":"Full","value":"full"}]},
    {"type":"toggle","id":"motion","label":"Entrance and float motion","default":true},
    {"type":"header","id":"hdr_style","label":"Style"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"white"},
    {"type":"color","id":"heading_color","label":"Heading","default":"scheme.heading"},
    {"type":"color","id":"text_color","label":"Text","default":"scheme.text"},
    {"type":"color","id":"button_color","label":"Button","default":"scheme.primary_button_background"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"scheme.primary_button_text"},
    {"type":"header","id":"hdr_spacing","label":"Spacing"},
    {"type":"range","id":"padding_top","label":"Top padding","default":72,"min":0,"max":160,"step":4,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","default":72,"min":0,"max":160,"step":4,"unit":"px"},
    {"type":"range","id":"padding_mobile","label":"Phone padding, top and bottom","default":40,"min":0,"max":120,"step":4,"unit":"px"}
  ],
  "blocks": [
    {"type":"point","name":"Reassurance point","limit":4,"settings":[
      {"type":"text","id":"text","label":"Text","default":"Tracked delivery on every order"},
      {"type":"select","id":"icon","label":"Icon","default":"check","options":[{"label":"Delivery","value":"truck"},{"label":"Returns","value":"return"},{"label":"Secure","value":"lock"},{"label":"Tick","value":"check"}]}
    ]}
  ],
  "max_blocks": 4,
  "presets": [
    {"name":"Storefront Hero","blocks":[
      {"type":"point","settings":{"text":"Tracked delivery on every order","icon":"truck"}},
      {"type":"point","settings":{"text":"Easy returns if it isn't right","icon":"return"}},
      {"type":"point","settings":{"text":"Secure checkout","icon":"lock"}}
    ]},
    {"name":"Storefront Hero on dark","settings":{"color_scheme":"dark"},"blocks":[
      {"type":"point","settings":{"text":"Tracked delivery on every order","icon":"truck"}},
      {"type":"point","settings":{"text":"Easy returns if it isn't right","icon":"return"}},
      {"type":"point","settings":{"text":"Secure checkout","icon":"lock"}}
    ]}
  ]
}
</schema>