      "default": false
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "body_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "Body weight"
        },
        {
          "value": "heading_weight",
          "label": "Heading weight"
        },
        {
          "value": "subheading_weight",
          "label": "Subheading weight"
        }
      ]
    },
