        "id": "custom_link_color",
        "label": "Link color",
        "visible_if": "{{ section.settings.enable_custom_colors }}"
      },
      {
        "type": "color",
        "id": "custom_arrow_color",
        "label": "Arrow color",
        "visible_if": "{{ section.settings.enable_custom_colors }}"
      },
      {
        "type": "select",
        "id": "border_position",
        "label": "Border position",
        "default": "bottom",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          },
          {
            "value": "both",
            "label": "Top & bottom"
          }
        ]
      },
      {
        "type": "range",
        "id": "border_width",
        "label": "Border width",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 1,
        "visible_if": "{{ section.settings.border_position != 'none' }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#e5e5e5",
        "visible_if": "{{ section.settings.enable_custom_colors and section.settings.border_position != 'none' }}"
      },
      {
        "type": "header",
        "content": "Behavior & animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show navigation arrows",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_arrows_mobile",
        "label": "Show arrows on mobile",
        "default": true
      },
      {
        "type": "range",
        "id": "transition_speed",
        "label": "Transition speed",
        "min": 200,
        "max": 1500,
        "step": 50,
        "unit": "ms",
        "default": 700
      },
      {
        "type": "range",
        "id": "change_every",
        "label": "Time per message",
        "min": 2,
        "max": 12,
        "step": 1,
        "unit": "s",
        "default": 5,
        "info": "For Message blocks."
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 10,
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 10,
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_position",
        "label": "Custom position (desktop)",
        "default": false
      },
      {
        "type": "range",
        "id": "desktop_horizontal_offset",
        "label": "Desktop horizontal offset",
        "min": -40,
        "max": 40,
        "step": 1,
        "unit": "%",
        "default": 0,
        "visible_if": "{{ section.settings.enable_custom_position }}"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Advanced spacing"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      }
    ],
    "max_blocks": 10,
    "blocks": [
      {
        "type": "store_information",
        "name": "Contact info",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "This block will display your store information. [Edit Store information](/editor?context=theme&category=store%20information)"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "checkbox",
            "id": "show_email",
            "label": "Show email",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "show_phone",
            "label": "Show phone",
            "default": true
          },
          {
            "type": "header",
            "content": "Mobile layout"
          },
          {
            "type": "checkbox",
            "id": "hidden_on_mobile",
            "label": "Hidden on mobile",
            "default": true
          }
        ]
      },
      {
        "type": "socials",
        "name": "Social media",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "Configure in [Social media setting](/editor?context=theme&category=social%20media)"
          },
          {
            "type": "header",
            "content": "Mobile layout"
          },
          {
            "type": "checkbox",
            "id": "hidden_on_mobile",
            "label": "Hidden on mobile",
            "default": true
          }
        ]
      },
      {
        "type": "message",
        "name": "Message",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Announce shipping, returns or a new arrival here"
          },
          {
            "type": "inline_richtext",
            "id": "text_mobile",
            "label": "Text on phones",
            "info": "Empty: the text above."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colour",
            "default": false
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "text_slider",
        "name": "Announcement messages",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Slide 1"
          },
          {
            "type": "inline_richtext",
            "id": "text1",
            "label": "Text 1 (desktop)",
            "default": "Free shipping on orders over $99"
          },
          {
            "type": "inline_richtext",
            "id": "text1_mobile",
            "label": "Text 1 (mobile)"
          },
          {
            "type": "header",
            "content": "Slide 2"
          },
          {
            "type": "inline_richtext",
            "id": "text2",
            "label": "Text 2 (desktop)",
            "default": "New season collection"
          },
          {
            "type": "inline_richtext",
            "id": "text2_mobile",
            "label": "Text 2 (mobile)"
          },
          {
            "type": "header",
            "content": "Slide 3"
          },
          {
            "type": "inline_richtext",
            "id": "text3",
            "label": "Text 3 (desktop)",
            "default": "Members get 15% off their first order. <a href=\"/account/register\"><strong>Sign up</strong></a>"
          },
          {
            "type": "inline_richtext",
            "id": "text3_mobile",
            "label": "Text 3 (mobile)"
          },
          {
            "type": "header",
            "content": "Behavior & animation"
          },
          {
            "type": "range",
            "id": "change_every",
            "min": 3,
            "max": 6,
            "step": 1,
            "label": "Change every",
            "unit": "s",
            "default": 3
          },
          {
            "type": "header",
            "content": "Mobile layout"
          },
          {
            "type": "checkbox",
            "id": "hidden_on_mobile",
            "label": "Hidden on mobile"
          }
        ]
      },
      {
        "type": "cur_lang",
        "name": "Region & language",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "checkbox",
            "id": "show_currency",
            "label": "Show currency",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "show_language",
            "label": "Show language",
            "default": true
          },
          {
            "type": "header",
            "content": "Mobile layout"
          },
          {
            "type": "checkbox",
            "id": "hidden_on_mobile",
            "label": "Hidden on mobile",
            "default": true
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Announcement Bar Pro 3",
        "blocks": [
          {
            "type": "message",
            "settings": {
              "text": "Announce shipping, returns or a new arrival here"
            }
          },
          {
            "type": "message",
            "settings": {
              "text": "Add a second message, it shows next"
            }
          },
          {
            "type": "cur_lang"
          }
        ],
        "category": "Header & navigation"
      }
    ]
  }
}
