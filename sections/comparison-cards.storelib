        "label": "Check icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "cross_color",
        "label": "Cross icon (your card)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "cross_color_them",
        "label": "Cross icon (other card)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "minus_color",
        "label": "Minus icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "id": "enable_custom_fonts",
        "type": "checkbox",
        "default": false,
        "label": "Enable custom fonts",
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "id": "heading_font",
        "type": "font_picker",
        "default": "assistant_n4",
        "label": "Heading font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "id": "body_font",
        "type": "font_picker",
        "default": "assistant_n4",
        "label": "Body font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "select",
        "id": "card_title_weight",
        "label": "Card title weight",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi-bold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra-bold"
          }
        ]
      },
      {
        "type": "range",
        "id": "card_title_size_desktop",
        "label": "Card title size (desktop)",
        "min": 14,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "row_text_size",
        "label": "Row text size",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "section_max_width_mobile",
        "label": "Content width (mobile)",
        "min": 280,
        "max": 800,
        "step": 10,
        "unit": "px",
        "default": 560
      },
      {
        "type": "range",
        "id": "heading_sub_gap_mobile",
        "label": "Gap heading to subheading (mobile)",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "gap_subheading_content_mobile",
        "label": "Gap header to cards (mobile)",
        "min": 0,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "cards_gap_mobile",
        "label": "Gap between cards (mobile)",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "card_padding_mobile",
        "label": "Card padding y (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "card_padding_x_mobile",
        "label": "Card padding x (mobile)",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "card_title_size_mobile",
        "label": "Card title size (mobile)",
        "min": 12,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Why customers choose us"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              }
            ],
            "hidden": true,
            "info": "Legacy: the heading is always an h2",
            "visible_if": "{{ false }}"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 48
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 30
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.2
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -3,
            "max": 7,
            "step": 0.1,
            "unit": "px",
            "default": 0
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>A clear, honest look at what we do better.</p>"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.1,
            "default": 1.5
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 900,
            "step": 10,
            "unit": "px",
            "default": 600
          }
        ]
      },
      {
        "type": "card_us",
        "name": "Your card",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Our product"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image above title"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "card_them",
        "name": "Other card",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Typical alternative"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image above title"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "row",
        "name": "Row",
        "settings": [
          {
            "type": "header",
            "content": "Your card"
          },
          {
            "type": "inline_richtext",
            "id": "label_us",
            "label": "Text",
            "default": "What yours does"
          },
          {
            "type": "select",
            "id": "icon_us",
            "label": "Icon",
            "default": "check",
            "options": [
              {
                "value": "check",
                "label": "Check"
              },
              {
                "value": "cross",
                "label": "Cross"
              },
              {
                "value": "minus",
                "label": "Minus"
              }
            ]
          },
          {
            "type": "header",
            "content": "Other card"
          },
          {
            "type": "inline_richtext",
            "id": "label_them",
            "label": "Text",
            "default": "What the alternative does"
          },
          {
            "type": "select",
            "id": "icon_them",
            "label": "Icon",
            "default": "cross",
            "options": [
              {
                "value": "check",
                "label": "Check"
              },
              {
                "value": "cross",
                "label": "Cross"
              },
              {
                "value": "minus",
                "label": "Minus"
              }
            ]
          },
          {
            "type": "header",
            "content": "Colours"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color_us",
            "label": "Text colour (your card)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_them",
            "label": "Text colour (other card)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Comparison Cards",
        "category": "Features",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "card_us"
          },
          {
            "type": "card_them"
          },
          {
            "type": "row",
            "settings": {
              "label_us": "Feature 1, how yours works",
              "label_them": "Feature 1, how theirs works"
            }
          },
          {
            "type": "row",
            "settings": {
              "label_us": "Feature 2, how yours works",
              "label_them": "Feature 2, how theirs works"
            }
          },
          {
            "type": "row",
            "settings": {
              "label_us": "Feature 3, how yours works",
              "label_them": "Feature 3, how theirs works",
              "icon_them": "minus"
            }
          },
          {
            "type": "row",
            "settings": {
              "label_us": "Feature 4, how yours works",
              "label_them": "Feature 4, how theirs works"
            }
          }
        ]
      }
    ]
  }
}
</schema>