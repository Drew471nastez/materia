<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_them = 'accessibility.them' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Comparison Cards
  Two side-by-side cards that compare your product against the typical
  alternative. Block-organized: heading, subheading, "us" card, "them"
  card, and paired feature rows. Each row defines text + icon for both
  sides at once. Stacks on mobile. Distinct from Comparison Cards 2 by
  using a clean separated card layout (no overlap), color-tinted "us"
  card to draw the eye, and a flat content-first style.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign rows = section.blocks | where: 'type', 'row'
  assign card_us = nil
  assign card_them = nil
  for b in section.blocks
    if b.type == 'card_us' and card_us == nil
      assign card_us = b
    endif
    if b.type == 'card_them' and card_them == nil
      assign card_them = b
    endif
  endfor
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* ── Section width — CSS-only, no HTML wrapper ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .ccd {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width */
  #shopify-section-{{ sid }} .ccd__inner {
    max-width: {{ st.section_max_width_mobile | default: 560 }}px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd__inner {
      max-width: {{ st.section_max_width_tablet | default: 900 }}px;
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ccd__inner {
      max-width: {{ st.section_max_width_desktop | default: 1100 }}px;
    }
  }

  /* Header */
  #shopify-section-{{ sid }} .ccd__header {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    margin: 0 auto {{ st.gap_subheading_content_mobile | default: 28 }}px;
    gap: {{ st.heading_sub_gap_mobile | default: 8 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd__header {
      margin-bottom: {{ st.gap_subheading_content | default: 48 }}px;
      gap: {{ st.heading_sub_gap_desktop | default: 14 }}px;
    }
  }
  /* Reset margins on header DESCENDANTS only (not the header itself,
     so its margin-bottom gap to the cards is preserved). */
  #shopify-section-{{ sid }} .ccd__header > *,
  #shopify-section-{{ sid }} .ccd__header :is(h1, h2, h3, h4, h5, h6, p, div, span) {
    margin-block: 0 !important;
    margin-block-start: 0 !important;
    margin-block-end: 0 !important;
    padding-block: 0 !important;
  }

  /* Cards grid */
  #shopify-section-{{ sid }} .ccd__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.cards_gap_mobile | default: 16 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd__cards {
      grid-template-columns: 1fr 1fr;
      gap: {{ st.cards_gap_desktop | default: 20 }}px;
      align-items: stretch;
    }
  }

  /* Card */
  #shopify-section-{{ sid }} .ccd__card {
    border-radius: {{ st.card_radius | default: 24 }}px;
    padding: {{ st.card_padding_mobile | default: 28 }}px {{ st.card_padding_x_mobile | default: 22 }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd__card {
      padding: {{ st.card_padding_desktop | default: 40 }}px {{ st.card_padding_x_desktop | default: 36 }}px;
    }
  }
  #shopify-section-{{ sid }} .ccd__card--us {
    background: {% render 'scheme-color', color: st.us_card_bg, fallback: 'var(--color-heading)' %};
    color: {% render 'scheme-color', color: st.us_card_text, fallback: 'var(--color-background)' %};
    box-shadow: {{ st.us_card_shadow | default: '0 28px 56px -24px rgba(15,23,42,.35)' }};
  }
  #shopify-section-{{ sid }} .ccd__card--them {
    background: {% render 'scheme-color', color: st.them_card_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: st.them_card_text, fallback: 'var(--color-text)' %};
    border: {{ st.them_card_border_width | default: 1 }}px solid {% render 'scheme-color', color: st.them_card_border, fallback: 'var(--color-border)' %};
  }

  #shopify-section-{{ sid }} .ccd__card-image {
    display: block;
    margin: 0 auto !important;
    max-width: {{ st.card_image_max | default: 80 }}px;
    height: auto;
  }
  #shopify-section-{{ sid }} .ccd__card-title {
    margin: 0 !important;
    margin-block: 0 !important;
    text-align: center;
    font-weight: {% if st.card_title_weight == blank or st.card_title_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ st.card_title_weight }}{% endif %};
    font-size: {{ st.card_title_size_mobile | default: 22 }}px;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ccd__card-title { font-size: {{ st.card_title_size_desktop | default: 28 }}px; }
  }
  #shopify-section-{{ sid }} .ccd__title-divider {
    border: 0;
    border-top: 1px solid currentColor;
    opacity: .15;
    margin: 0;
  }

  /* Rows */
  #shopify-section-{{ sid }} .ccd__rows {
    list-style: none;
    margin: 0 !important;
    padding: 0 !important;
    display: flex;
    flex-direction: column;
    gap: {{ st.row_gap | default: 16 }}px;
  }
  #shopify-section-{{ sid }} .ccd__row {
    display: grid;
    grid-template-columns: {{ st.icon_size | default: 22 }}px 1fr;
    gap: {{ st.icon_text_gap | default: 14 }}px;
    align-items: center;
    font-size: {{ st.row_text_size | default: 15 }}px;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .ccd__row strong { font-weight: 700; }

  #shopify-section-{{ sid }} .ccd__icon {
    width: {{ st.icon_size | default: 22 }}px;
    height: {{ st.icon_size | default: 22 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .ccd__icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .ccd__card--us   .ccd__icon--check { color: {% render 'scheme-color', color: st.check_color, fallback: 'var(--color-primary)' %}; }
  #shopify-section-{{ sid }} .ccd__card--us   .ccd__icon--cross { color: {% render 'scheme-color', color: st.cross_color, fallback: 'currentColor' %}; }
  #shopify-section-{{ sid }} .ccd__card--us   .ccd__icon--minus { color: {% render 'scheme-color', color: st.minus_color, fallback: 'currentColor' %}; }
  #shopify-section-{{ sid }} .ccd__card--them .ccd__icon--check { color: {% render 'scheme-color', color: st.check_color, fallback: 'var(--color-primary)' %}; }
  #shopify-section-{{ sid }} .ccd__card--them .ccd__icon--cross { color: {% render 'scheme-color', color: st.cross_color_them, fallback: 'var(--color-heading)' %}; }
  #shopify-section-{{ sid }} .ccd__card--them .ccd__icon--minus { color: {% render 'scheme-color', color: st.minus_color, fallback: 'currentColor' %}; }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .ccd { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .ccd { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .ccd { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .ccd { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="ccd color-{{ color_scheme }} gradient {{ st.section_width }}" id="ccd-{{ sid }}">
  <div class="ccd__inner">

    {%- comment -%}========== HEADER ==========={%- endcomment -%}
    {%- assign has_header = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' or block.type == 'subheading' -%}
        {%- assign has_header = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_header -%}
      <div class="ccd__header">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="ccd__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %} !important;
                    font-weight: {% if bs.weight == blank or bs.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ bs.weight }}{% endif %};
                    line-height: {{ bs.line_height | default: 1.15 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    font-size: {{ bs.size_mobile | default: 30 }}px !important;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 48 }}px !important; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="ccd__sub" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %} !important;
                    font-size: {{ bs.size | default: 16 }}px;
                    line-height: {{ bs.line_height | default: 1.5 }};
                    max-width: {{ bs.max_width | default: 600 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0 !important; margin-block: 0 !important; padding: 0 !important; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}========== CARDS ==========={%- endcomment -%}
    <div class="ccd__cards">

      {%- comment -%}---- US card ----{%- endcomment -%}
      <div class="ccd__card ccd__card--us" {% if card_us %}{{ card_us.shopify_attributes }}{% endif %}>
        {%- if card_us and card_us.settings.image -%}
          <img class="ccd__card-image"
               src="{{ card_us.settings.image | image_url: width: 200 }}"
               alt="{{ card_us.settings.title | default: 'Us' | escape }}"
               loading="lazy" width="80" height="80">
        {%- endif -%}
        {%- if card_us and card_us.settings.title != blank -%}
          <h3 class="ccd__card-title" {% if card_us.settings.title_color != blank %}style="color: {{ card_us.settings.title_color }};"{% endif %}>{{ card_us.settings.title | escape }}</h3>
        {%- endif -%}
        <hr class="ccd__title-divider" aria-hidden="true">
        <ul class="ccd__rows">
          {%- for row in rows -%}
            {%- assign rs = row.settings -%}
            {%- assign t = rs.icon_us | default: 'check' -%}
            <li class="ccd__row" {% if rs.color_us != blank %}style="color: {{ rs.color_us }};"{% endif %}>
              <span class="ccd__icon ccd__icon--{{ t }}">
                {%- case t -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'cross' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                  {%- when 'minus' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ rs.label_us }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%}---- THEM card ----{%- endcomment -%}
      <div class="ccd__card ccd__card--them" {% if card_them %}{{ card_them.shopify_attributes }}{% endif %}>
        {%- if card_them and card_them.settings.image -%}
          <img class="ccd__card-image"
               src="{{ card_them.settings.image | image_url: width: 200 }}"
               alt="{{ card_them.settings.title | default: fb_accessibility_them | escape }}"
               loading="lazy" width="80" height="80">
        {%- endif -%}
        {%- if card_them and card_them.settings.title != blank -%}
          <h3 class="ccd__card-title" {% if card_them.settings.title_color != blank %}style="color: {{ card_them.settings.title_color }};"{% endif %}>{{ card_them.settings.title | escape }}</h3>
        {%- endif -%}
        <hr class="ccd__title-divider" aria-hidden="true">
        <ul class="ccd__rows">
          {%- for row in rows -%}
            {%- assign rs = row.settings -%}
            {%- assign t = rs.icon_them | default: 'cross' -%}
            <li class="ccd__row" {% if rs.color_them != blank %}style="color: {{ rs.color_them }};"{% endif %}>
              <span class="ccd__icon ccd__icon--{{ t }}">
                {%- case t -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'cross' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                  {%- when 'minus' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ rs.label_them }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>

    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "comparison-cards",
  "name": "Comparison Cards",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Section width"
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Section width (desktop ≥1024px)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Section width (tablet ≥768px)",
      "min": 500,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "section_max_width_mobile",
      "label": "Section width (mobile)",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Header layout"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_sub_gap_desktop",
      "label": "Gap heading → subheading (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_sub_gap_mobile",
      "label": "Gap heading → subheading (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap_subheading_content",
      "label": "Gap subheading → cards (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_subheading_content_mobile",
      "label": "Gap subheading → cards (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Cards layout"
    },
    {
      "type": "range",
      "id": "cards_gap_desktop",
      "label": "Gap between cards (desktop)",
