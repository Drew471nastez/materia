        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "completed_message_color",
        "label": "Ended message colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
