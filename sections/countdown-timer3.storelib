<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{% style %}
:root {
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-03: #f8f8f8;
--loudz-neutral-01: #fff;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-8: 8px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-48: 48px;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-line-height-140: 1.4;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-border-width-1: var(--loudz-size-1);
--loudz-border-width-2: var(--loudz-size-2);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-bg-surface-tertiary-on-light: var(--loudz-neutral-03);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-font-size-12: var(--loudz-size-12);
--loudz-font-size-14: var(--loudz-size-14);
--loudz-font-size-16: var(--loudz-size-16);
--loudz-font-size-20: var(--loudz-size-20);
--loudz-font-size-24: var(--loudz-size-24);
--loudz-font-size-32: var(--loudz-size-32);
--loudz-font-size-48: var(--loudz-size-48);
}


{% endstyle %}

<!-- --UUID-01a02399-- -->

{%- liquid
	assign timer_block = section.blocks | where: "type", "timer" | first
	assign caption_block = section.blocks | where: "type", "caption" | first
	assign heading_block = section.blocks | where: "type", "heading" | first
	assign text_block = section.blocks | where: "type", "text" | first
	assign button_block = section.blocks | where: "type", "button" | first

	assign is_block_text_empty = false

	assign is_caption_empty = false
	assign is_heading_empty = false
	assign is_text_empty = false
	assign is_button_empty = false

	if caption_block == blank or caption_block.settings.caption == blank
		assign is_caption_empty = true
	endif

	if heading_block == blank or heading_block.settings.heading == blank
		assign is_heading_empty = true
	endif

	if button_block == blank or button_block.settings.primary_button_label == blank
		assign is_text_empty = true
	endif

	if text_block == blank or text_block.settings.description == blank
		assign is_button_empty = true
	endif

	if is_caption_empty == true and is_heading_empty == true and is_text_empty == true and is_button_empty == true
		assign is_block_text_empty = true
	endif
-%}

<section class="loudz-{{ section.id | handle }} loudzFlashTimer color-{{ color_scheme }} gradient" {% if is_heading_empty == false %}aria-labelledby="loudzFlashTimerHeading-{{ section.id }}"{% else %}aria-label="{{ 'accessibility.flash_sale_countdown' | t }}"{% endif %}>
	<div class="loudzFlashTimerContainer">
		<div class="loudzFlashCountdownTimer loudzFlashCountdownTimer--desktopPosition-{{ section.settings.timer_position_desktop }} loudzFlashCountdownTimer--mobilePosition-{{ section.settings.timer_position_mobile }}">
			<div class="loudzFlashCountdownTimer__Content {% if is_block_text_empty == true %}loudzFlashCountdownTimer__Content--onlyTimer{% endif %}">
				<div class="loudzTextBox">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- capture heading_css_variables -%}
                                    --block-heading-size: {{- block.settings.heading_size -}}px;
                                    --block-heading-color: {%- render 'scheme-color', color: block.settings.heading_color, fallback: 'var(--color-heading)' -%} !important;
                                  {%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Heading loudzTextBox__Heading--style-{{ block.settings.heading_style }}"
									id="loudzFlashTimerHeading-{{ section.id }}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "caption" -%}
								{%- capture caption_css_variables -%}
                                    --block-caption-size: {{- block.settings.caption_size -}}px;
                                    --block-caption-color: {%- render 'scheme-color', color: block.settings.caption_color, fallback: 'var(--color-text)' -%} !important;
                                    --block-caption-weight: {{- block.settings.caption_weight -}};
                                  {%- endcapture -%}
								<p
									style="{{- caption_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Caption"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.caption -}}
								</p>
							{%- when "text" -%}
								{%- capture description_css_variables -%}
                                    --block-description-size: {{- block.settings.description_size -}}px;
                                    --block-description-color: {%- render 'scheme-color', color: block.settings.description_color, fallback: 'var(--color-text)' -%} !important;
                                  {%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Description loudzTextBox__Description--alignment-{{ section.settings.text_alignment }}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
							{%- when "button" -%}
								{%- liquid
									assign custom_btn = true
									if block.settings.use_theme_button
										assign custom_btn = false
									endif
								-%}
								{%- capture buttons_css_variables -%}{%- render 'button-overrides', bg: block.settings.primary_background_color, text: block.settings.primary_text_color, border: block.settings.primary_border_color, custom: custom_btn, radius: block.settings.primary_button_corner, padding_y: 16, padding_x: 20, font_size: 14 -%}{%- endcapture -%}
								<div
									class="loudzImgTextButtons"
									{{ block.shopify_attributes }}
								>
									{%- if block.settings.primary_button_label != blank -%}
										<a
											{% if block.settings.primary_new_tab == true %}
												target="_blank"
												rel="noopener noreferrer"
											{% endif %}
											class="loudzImgTextButtons__Primary loudzImgTextButtons__Primary--{{ block.settings.primary_button_style }}"
											{%- unless block.settings.primary_button_style == 'link' %}
											data-theme-button="primary"
											data-button-local-appearance="{{ block.settings.primary_button_style }}"
											style="{{ buttons_css_variables }}"
											{%- else %}
											style="--block-primary-button-text-color: {% render 'scheme-color', color: block.settings.primary_text_color, fallback: 'var(--color-heading)' %};"
											{%- endunless %}
											href="{{ block.settings.primary_button_link | default: "#" }}"
										>
											{{- block.settings.primary_button_label | escape -}}
										</a>
									{%- endif -%}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
			{%- if timer_block -%}
                <loudz-countdown-timer
					class="
						loudzFlashCountdownTimer__Timer
						{% if timer_block.settings.show_numbers == true %}loudzFlashCountdownTimer__Timer--onlyNumbers{% endif %}
						{% if is_block_text_empty == true %}loudzFlashCountdownTimer__Timer--onlyTimer{% endif %}
					"
					{{ timer_block.shopify_attributes }}
				>
					{%- assign end_date = timer_block.settings.end_date -%}
					{%- assign end_time = timer_block.settings.end_time -%}

					{%- capture heading_css_variables -%}
                        --block-numbers-color: {%- render 'scheme-color', color: timer_block.settings.numbers_color, fallback: 'var(--color-heading)' -%} !important;
                        --block-text-color: {%- render 'scheme-color', color: timer_block.settings.text_color, fallback: 'var(--color-text)' -%} !important;
                    {%- endcapture -%}
					<div
						style="{{- heading_css_variables | strip_newlines | escape -}}"
						id="loudzCountdownTimer-{{ section.id }}"
						class="loudzCountdownTimer"
						{%- if end_date != blank and end_time != blank -%}
							data-end-date="{{ end_date }}"
							data-end-time="{{ end_time }}"
						{%- endif -%}
						data-completed-text="{{ section.settings.completed_message }}"
						data-hide-section="{{ section.settings.hide_section }}"
						role="timer"
						aria-live="polite"
						aria-atomic="true"
						aria-label="{{ 'accessibility.time_remaining' | t }}"
					>
						<div
							class="
								loudzCountdownTimerActive
								loudzCountdownTimerActive--{{ timer_block.settings.countdown_size }}
								loudzCountdownTimerActive--{{ timer_block.settings.numbers_style }}
							"
							aria-hidden="true"
						>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzDays">00</h6>
								<span class="loudzCountdownTimerActive__Text">days</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzHours">00</h6>
								<span class="loudzCountdownTimerActive__Text">hours</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzMinutes">00</h6>
								<span class="loudzCountdownTimerActive__Text">min</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzSeconds">00</h6>
								<span class="loudzCountdownTimerActive__Text">sec</span>
							</div>
						</div>
					</div>
				</loudz-countdown-timer>
			{%- endif -%}
		</div>
	</div>
</section>



{% style %}
	.loudz-{{ section.id | handle }} {
	 --section-vertical-margin: {{- section.settings.vertical_margin -}}px;
	 --section-vertical-margin-mobile: {{- section.settings.vertical_margin_mobile -}}px;
	 --section-background-color: {%- render 'scheme-color', color: section.settings.section_background, fallback: 'var(--color-background)' -%} !important;
	    --section-completed-message-color: {%- render 'scheme-color', color: section.settings.completed_message_color, fallback: 'var(--color-text)' -%} !important;
	 --section-vertical-padding: {{- section.settings.vertical_padding -}}px;
	 --section-vertical-padding-mobile: {{- section.settings.vertical_padding_mobile -}}px;
	 --section-text-alignment: {{- section.settings.text_alignment -}};
	 --section-text-alignment-mobile: {{- section.settings.text_alignment_mobile -}};
	 --section-max-width: {{- section.settings.section_max_width -}}px;
	 --section-width: {{- section.settings.inner_width -}}%;
	}

	

.loudz-{{ section.id | handle }}.loudzFlashTimer{margin:var(--section-vertical-margin-mobile) 0;background-color:var(--section-background-color, var(--loudz-color-bg-surface-tertiary-on-light))}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer{margin:var(--section-vertical-margin) 0}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashTimerContainer{padding:var(--section-vertical-padding-mobile) 0;display:flex;max-width:var(--section-max-width);width:var(--section-width);margin:0 auto}@media(max-width: 480px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashTimerContainer{max-width:100%;width:100%;margin:0 auto;padding:var(--section-vertical-padding-mobile) var(--loudz-space-20)}}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashTimerContainer{display:flex;padding:var(--section-vertical-padding) 0;max-width:var(--section-max-width);width:var(--section-width);margin:0 auto}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashTimerContainer--desktopPosition-left{flex-direction:row}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashTimerContainer--desktopPosition-right{flex-direction:row-reverse}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer{display:flex;align-items:center;width:100%;gap:var(--loudz-space-8)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer--mobilePosition-above{flex-direction:column}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer--mobilePosition-bellow{flex-direction:column-reverse}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer--desktopPosition-left{flex-direction:row-reverse}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer--desktopPosition-left .loudzFlashCountdownTimer__Timer{justify-content:flex-start}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer--desktopPosition-right{flex-direction:row}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content{width:100%;display:flex;align-items:center;justify-content:var(--section-text-alignment-mobile)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content--onlyTimer{display:none}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content{justify-content:var(--section-text-alignment)}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox{text-align:var(--section-text-alignment-mobile);display:flex;flex-direction:column;gap:var(--loudz-space-8)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox p:empty,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox div:empty,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox h2:empty{display:none}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox{text-align:var(--section-text-alignment)}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading{margin:0;font-size:calc(var(--block-heading-size)*.75);color:var(--block-heading-color) !important;}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading--style-regular{font-weight:var(--loudz-font-weight-400)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading--style-bold{font-weight:var(--loudz-font-weight-600)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading--style-theme{font-weight:var(--heading-weight, 600)}@media(min-width: 992px){.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading{font-size:var(--block-heading-size);text-align:var(--section-text-alignment)}}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Heading--alternativeFont{font-family:var(--block-heading-font)}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description p,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description ul,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description ol{margin:0;max-width:400px;font-size:calc(var(--block-description-size)*.88);color:var(--block-description-color) !important;}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h1,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h2,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h3,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h4,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h5,.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description h6{color:var(--block-description-color) !important;margin:0;padding:0}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description a{color:var(--block-description-color) !important;margin:0;padding:0;text-decoration:underline;text-underline-offset:var(--loudz-space-2);transition:opacity .3s ease-in}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description a:hover{opacity:.85}.loudz-{{ section.id | handle }}.loudzFlashTimer .loudzFlashCountdownTimer__Content .loudzTextBox__Description ul,.loudz-{{ section.id | handle 