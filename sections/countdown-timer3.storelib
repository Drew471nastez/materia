<schema>
{
  "type": "countdown-timer3",
  "name": "Countdown Timer Pro 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "completed_message_color",
      "label": "Completed message color"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "inner_width",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Inner width",
      "default": 70
    },
    {
      "type": "text",
      "id": "section_max_width",
      "label": "Max width (px)"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "vertical_margin",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Vertical margin (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "timer_position_mobile",
      "label": "Timer position (mobile)",
      "options": [
        {
          "value": "above",
          "label": "Above content"
        },
        {
          "value": "bellow",
          "label": "Below content"
        }
      ],
      "default": "above"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "vertical_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "vertical_margin_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Vertical margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "timer_position_desktop",
      "label": "Timer position (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide section when ended",
      "default": true
    },
    {
      "type": "text",
      "id": "completed_message",
      "label": "Message when ended"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Flash Sale Countdown",
          "label": "Heading text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading font size",
          "options": [
            {
              "value": "24",
              "label": "Small (24px)"
            },
            {
              "value": "32",
              "label": "Medium (32px)"
            },
            {
              "value": "48",
              "label": "Large (48px)"
            }
          ],
          "default": "32"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading text color"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Advanced"
        },
        {
          "type": "select",
          "id": "heading_style",
          "label": "Heading font weight",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "bold",
              "label": "Bold"
            }
          ],
          "default": "theme"
        }
      ],
      "limit": 1
    },
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style"
        },
        {
          "type": "select",
          "id": "caption_size",
          "label": "Caption font size",
          "options": [
            {
              "value": "12",
              "label": "Small (12px)"
            },
            {
              "value": "16",
              "label": "Medium (16px)"
            },
            {
              "value": "20",
              "label": "Large (20px)"
            }
          ],
          "default": "16"
        },
        {
          "type": "select",
          "id": "caption_weight",
          "label": "Caption font weight",
          "options": [
            {
              "value": "400",
              "label": "Regular (400)"
            },
            {
              "value": "600",
              "label": "Semi-bold (600)"
            }
          ],
          "default": "400"
        },
        {
          "type": "color",
          "id": "caption_color",
          "label": "Caption text color"
        }
      ],
      "limit": 1
    },
    {
      "type": "text",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Share details about your exclusive limited-time offer or special promotion.</p>",
          "label": "Description text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style"
        },
        {
          "type": "select",
          "id": "description_size",
          "label": "Description font size",
          "options": [
            {
              "value": "12",
              "label": "Small (12px)"
            },
            {
              "value": "16",
              "label": "Medium (16px)"
            },
            {
              "value": "20",
              "label": "Large (20px)"
            }
          ],
          "default": "16"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description text color"
        }
      ],
      "limit": 1
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "primary_button_label",
          "label": "Button label text"
        },
        {
          "type": "url",
          "id": "primary_button_link",
          "label": "Button link URL"
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Style"
        },
        {
          "type": "color",
          "id": "primary_text_color",
          "label": "Button text color"
        },
        {
          "type": "color",
          "id": "primary_background_color",
          "label": "Button background color",
          "visible_if": "{{ block.settings.primary_button_style == 'solid' }}"
        },
        {
          "type": "color",
          "id": "primary_border_color",
          "label": "Button border color",
          "visible_if": "{{ block.settings.primary_button_style == 'outline' }}"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Advanced"
        },
        {
          "type": "select",
          "id": "primary_button_style",
          "label": "Button style",
          "options": [
            {
              "value": "solid",
              "label": "Filled (solid background)"
            },
            {
              "value": "outline",
              "label": "Outline (border only)"
            },
            {
              "value": "link",
              "label": "Text link (no background)"
            }
          ],
          "default": "solid"
        },
        {
          "type": "checkbox",
          "id": "use_theme_button",
          "label": "Use theme button style",
          "default": true,
          "visible_if": "{{ block.settings.primary_button_style != 'link' }}"
        },
        {
          "type": "range",
          "id": "primary_button_corner",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Button corner radius",
          "visible_if": "{{ block.settings.primary_button_style != 'link' and block.settings.use_theme_button == false }}",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "primary_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ],
      "limit": 1
    },
