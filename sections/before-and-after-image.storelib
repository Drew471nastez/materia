          {
            "value": "scale_in",
            "label": "Scale image card"
          },
          {
            "value": "zoom_in",
            "label": "Zoom picture"
          },
          {
            "value": "shadow",
            "label": "Shadow"
          }
        ],
        "default": "fade_in"
