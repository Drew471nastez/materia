<template compat="shopify">
{% render 'theme-type' %}
<script src="{{ 'hero-benefits.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- comment -%}
  reset_spacing: collapse ONLY this section's own outer vertical margins.
  We deliberately do NOT touch sibling/adjacent sections (no "+ .shopify-section",
  no ":has()", no reaching outside this section's own id) so this section can never
  modify or break the spacing/layout of any other section on the page.
{%- endcomment -%}
<style data-rs-bulletproof>
    #shopify-section-{{ section.id }}:has(> .hb-outer[data-hb-reset-spacing]) {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign sid = section.id
  assign s = section.settings

  assign section_width = s.section_width | default: 'stretch_width'
  assign reset_spacing = s.reset_spacing

  assign section_bg = s.section_bg
  assign text_color = s.text_color
  assign muted_color = s.muted_color

  assign heading_text = s.heading | default: 'Best product in town.'
  assign accent_word = s.accent_word | default: 'town.'
  assign accent_color = s.accent_color
  assign heading_size_desktop = s.heading_size_desktop | default: 64
  assign heading_size_mobile = s.heading_size_mobile | default: 36
  assign heading_weight = s.heading_weight | default: 'inherit'
  assign heading_align_desktop = s.heading_align_desktop | default: 'left'
  assign heading_align_mobile = s.heading_align_mobile | default: 'left'

  assign image_position = s.image_position | default: 'right'
  assign text_column_width = s.text_column_width | default: 55
  assign gap_columns = s.gap_columns | default: 48
  assign max_width_desktop = s.max_width_desktop | default: 960

  assign image_desktop = s.image_desktop
  assign image_mobile = s.image_mobile
  assign image_fit = s.image_fit | default: 'cover'
  assign image_radius = s.image_radius | default: 18
  assign image_height_desktop = s.image_height_desktop | default: 480
  assign image_height_mobile = s.image_height_mobile | default: 360

  assign benefits_columns_desktop = s.benefits_columns_desktop | default: 2
  assign benefits_gap = s.benefits_gap | default: 32
  assign benefit_title_size = s.benefit_title_size | default: 18
  assign benefit_title_weight = s.benefit_title_weight | default: '600'
  assign benefit_desc_size = s.benefit_desc_size | default: 14
  assign benefit_icon_size = s.benefit_icon_size | default: 44
  assign benefit_icon_color = s.benefit_icon_color

  assign enable_fade = s.enable_fade
  assign fade_color = s.fade_color
  assign fade_size = s.fade_size | default: 25

  assign mobile_layout = s.mobile_layout | default: 'stacked'
  assign mobile_overlay_height = s.mobile_overlay_height | default: 640
  assign mobile_overlay_fade_strength = s.mobile_overlay_fade_strength | default: 70

  assign padding_top_desktop = s.padding_top_desktop | default: 80
  assign padding_bottom_desktop = s.padding_bottom_desktop | default: 80
  assign padding_top_mobile = s.padding_top_mobile | default: 56
  assign padding_bottom_mobile = s.padding_bottom_mobile | default: 56
  assign section_margin_top = s.section_margin_top | default: 0
  assign section_margin_bottom = s.section_margin_bottom | default: 0

  unless s.enable_custom_style
    assign section_bg = ''
    assign text_color = ''
    assign muted_color = ''
    assign accent_color = ''
    assign benefit_icon_color = ''
  endunless

  assign mobile_image = image_mobile
  if mobile_image == blank
    assign mobile_image = image_desktop
  endif

  assign heading_html = heading_text | escape
  if accent_word != blank
    assign accent_escaped = accent_word | escape
    assign accent_span = '<span class="hb__accent">' | append: accent_escaped | append: '</span>'
    assign heading_html = heading_html | replace: accent_escaped, accent_span
  endif

  case section_width
    when 'container'
      assign wrap_class = 'hb__wrap hb__wrap--container'
    when 'fluid_container'
      assign wrap_class = 'hb__wrap hb__wrap--fluid'
    when 'stretch_width'
      assign wrap_class = 'hb__wrap hb__wrap--stretch'
    when 'full_width'
      assign wrap_class = 'hb__wrap hb__wrap--full'
    else
      assign wrap_class = 'hb__wrap hb__wrap--full'
  endcase

  if mobile_layout == 'overlay'
    assign mobile_layout_class = 'hb--mobile-overlay'
  else
    assign mobile_layout_class = 'hb--mobile-stacked'
  endif
-%}

{%- if image_desktop == blank -%}{%- assign image_desktop = mobile_image -%}{%- endif -%}
{%- style -%}
  /* ============================================================
     SCOPE & ISOLATION BOUNDARY
     Everything below is prefixed with #shopify-section-{{ sid }} so it can
     never affect another section. The root rule also establishes an isolation
     + containment boundary so this section's stacking contexts, transforms and
     overflow can't bleed into (or be broken by) neighbouring sections.
     ============================================================ */
  #shopify-section-{{ sid }} { container: hero-benefits / inline-size; }
  #shopify-section-{{ sid }} .hb-outer {
    --hb-bg: {% render 'scheme-color', color: section_bg, fallback: 'var(--color-background)' %};
    --hb-text: {% render 'scheme-color', color: text_color, fallback: 'var(--color-text)' %};
    --hb-heading: {% render 'scheme-color', color: text_color, fallback: 'var(--color-heading)' %};
    --hb-muted: {% render 'scheme-color', color: muted_color, fallback: 'var(--color-text)' %};
    --hb-accent: {% render 'scheme-color', color: accent_color, fallback: 'var(--color-primary)' %};
    --hb-icon-color: {% render 'scheme-color', color: benefit_icon_color, fallback: 'var(--color-heading)' %};
    --hb-radius: {% if s.enable_custom_style %}{{ image_radius }}px{% else %}var(--rounded-radius, 0px){% endif %};
    --hb-img-h-d: {{ image_height_desktop }}px;
    --hb-img-h-m: {{ image_height_mobile }}px;
    --hb-text-col: {{ text_column_width }}%;
    --hb-gap-cols: {{ gap_columns }}px;
    --hb-benefits-cols-d: {{ benefits_columns_desktop }};
    --hb-benefits-gap: {{ benefits_gap }}px;
    --hb-bt-size: {% if s.enable_custom_style %}{{ benefit_title_size }}px{% else %}var(--h3-size, 20px){% endif %};
    --hb-bt-weight: {% if s.enable_custom_style %}{{ benefit_title_weight }}{% else %}var(--heading-weight, 600){% endif %};
    --hb-bd-size: {% if s.enable_custom_style %}{{ benefit_desc_size }}px{% else %}var(--body-font-size, 16px){% endif %};
    --hb-bi-size: {{ benefit_icon_size }}px;
    --hb-h-size-d: {% if s.enable_custom_style %}{{ heading_size_desktop }}px{% else %}var(--h2-size, 32px){% endif %};
    --hb-h-size-m: {% if s.enable_custom_style %}{{ heading_size_mobile }}px{% else %}var(--h2-size, 32px){% endif %};
    --hb-h-weight: {% if s.enable_custom_style != true or heading_weight == blank or heading_weight == 'inherit' %}var(--heading-weight, 700){% else %}{{ heading_weight }}{% endif %};
    --hb-fade-color: {% render 'scheme-color', color: fade_color, fallback: 'var(--color-background)' %};
    --hb-fade-size: {{ fade_size }}%;
    --hb-max-width-d: {{ max_width_desktop | default: 1280 }}px;
    --hb-mobile-overlay-h: {{ mobile_overlay_height | default: 640 }}px;
    --hb-mobile-overlay-fade: {{ mobile_overlay_fade_strength | default: 70 }}%;

    position: relative;
    isolation: isolate;           /* own stacking context — z-index can't leak out/in */
    z-index: 0;
    background: var(--hb-bg);
    color: var(--hb-text);
    margin-top: {{ section_margin_top }}px;
    margin-bottom: {{ section_margin_bottom }}px;
    /* reset_spacing removes the section gap (vertical margin / theme defaults)
       but does NOT touch the content padding — those sliders always apply. */
    padding-top: {{ padding_top_mobile }}px;
    padding-bottom: {{ padding_bottom_mobile }}px;
    overflow: hidden;             /* clips fades/overlays to this section only */
    box-sizing: border-box;
  }

  /* Scoped baseline reset: protect this section's OWN elements from theme-level
     global styles (e.g. theme `* { }`, list resets, heading line-heights) leaking
     in. Only targets descendants of this section, so nothing escapes outward. */
  #shopify-section-{{ sid }} .hb,
  #shopify-section-{{ sid }} .hb *,
  #shopify-section-{{ sid }} .hb *::before,
  #shopify-section-{{ sid }} .hb *::after {
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .hb {
    font-family: inherit;
  }

  #shopify-section-{{ sid }} .hb__wrap {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .hb__wrap--container { max-width: var(--container-width, var(--page-width, 1200px)); padding-left: 16px; padding-right: 16px; }
  #shopify-section-{{ sid }} .hb__wrap--fluid { max-width: var(--fluid-container-width, 1440px); padding-left: 24px; padding-right: 24px; }
  #shopify-section-{{ sid }} .hb__wrap--stretch { max-width: var(--stretch-width, 1600px); padding-left: 24px; padding-right: 24px; }
  #shopify-section-{{ sid }} .hb__wrap--full { max-width: 100%; padding-left: 16px; padding-right: 16px; }

  #shopify-section-{{ sid }} .hb__inner {
    width: 100%;
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .hb__grid {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 24px;
  }

  #shopify-section-{{ sid }} .hb__media {
    position: relative;
    width: 100%;
    height: var(--hb-img-h-m);
    border-radius: var(--hb-radius);
    overflow: hidden;
    background: rgba(255,255,255,0.04);
    order: 1;
  }
  #shopify-section-{{ sid }} .hb__media img,
  #shopify-section-{{ sid }} .hb__media .hb__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ image_fit }};
  }
  #shopify-section-{{ sid }} .hb__media .hb__placeholder svg { width: 100%; height: 100%; }

  #shopify-section-{{ sid }} .hb__text {
    order: 2;
    min-width: 0;
    overflow-wrap: anywhere;
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: {{ s.text_gap_mobile | default: 24 }}px;
  }

  #shopify-section-{{ sid }} .hb__heading {
    margin: 0;
    color: var(--hb-heading);
    font-size: var(--hb-h-size-m);
    font-weight: var(--hb-h-weight);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-align: {{ heading_align_mobile }};
  }
  #shopify-section-{{ sid }} .hb__accent { color: var(--hb-accent); }

  #shopify-section-{{ sid }} .hb__benefits {
    display: grid;
    grid-template-columns: repeat({{ s.benefits_columns_mobile | default: 2 }}, minmax(0, 1fr));
    gap: var(--hb-benefits-gap);
  }

  #shopify-section-{{ sid }} .hb__benefit {
    display: flex;
    flex-direction: column;
    gap: {{ s.benefit_content_gap | default: 10 }}px;
  }
  #shopify-section-{{ sid }} .hb__icon {
    width: var(--hb-bi-size);
    height: var(--hb-bi-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--hb-icon-color);
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .hb__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ sid }} .hb__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  #shopify-section-{{ sid }} .hb__icon--svg svg,
  #shopify-section-{{ sid }} .hb__icon--image svg {
    fill: currentColor;
  }
  #shopify-section-{{ sid }} .hb__icon--library svg {
    fill: none;
    stroke: currentColor;
  }
  #shopify-section-{{ sid }} .hb__icon--emoji {
    font-size: calc(var(--hb-bi-size) * 0.8);
    line-height: 1;
  }

  #shopify-section-{{ sid }} .hb__benefit-title {
    margin: 0;
    color: var(--hb-heading);
    font-size: var(--hb-bt-size);
    font-weight: var(--hb-bt-weight);
    line-height: 1.3;
  }
  #shopify-section-{{ sid }} .hb__benefit-desc {
    margin: 0;
    color: var(--hb-muted);
    font-size: var(--hb-bd-size);
    line-height: 1.55;
  }
  #shopify-section-{{ sid }} .hb__benefit-desc > * { margin: 0; }

  #shopify-section-{{ sid }} .hb__media-mobile { display: block; }
  #shopify-section-{{ sid }} .hb__media-desktop { display: none; }

  #shopify-section-{{ sid }} .hb__media::before {
    display: none;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--hb-fade-size);
    background: linear-gradient(to bottom, transparent, var(--hb-fade-color));
    pointer-events: none;
    z-index: 1;
  }
  #shopify-section-{{ sid }} [data-hb-bottom-fade] .hb__media::before { display: block; }

  /* Mobile overlay layout */
  @container hero-benefits (max-width: 1023px) {
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay {
      padding-top: 0;
      padding-bottom: 0;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__wrap {
      padding-left: 0;
      padding-right: 0;
      max-width: 100%;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__inner {
      position: relative;
      min-height: var(--hb-mobile-overlay-h);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      border-radius: var(--hb-radius);
      order: 0;
      background: transparent;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__media img,
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__media .hb__placeholder {
      width: 100%;
      height: 100%;
      object-fit: {{ image_fit }};
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__media::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: var(--hb-mobile-overlay-fade);
      background: linear-gradient(to bottom, transparent, var(--hb-bg));
      pointer-events: none;
      z-index: 1;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__grid {
      position: relative;
      z-index: 1;
      min-height: var(--hb-mobile-overlay-h);
      justify-content: flex-end;
      gap: 20px;
      padding: {{ padding_top_mobile }}px 16px {{ padding_bottom_mobile }}px;
      box-sizing: border-box;
    }
    #shopify-section-{{ sid }} .hb-outer.hb--mobile-overlay .hb__text {
      position: relative;
      z-index: 2;
      margin-top: auto;
    }
  }

  @container hero-benefits (min-width: 1024px) {
    #shopify-section-{{ sid }} .hb-outer {
      /* Desktop padding sliders always apply (reset_spacing only affects margins) */
      padding-top: {{ padding_top_desktop }}px;
      padding-bottom: {{ padding_bottom_desktop }}px;
    }

    #shopify-section-{{ sid }} .hb__inner {
      max-width: var(--hb-max-width-d);
    }

    #shopify-section-{{ sid }} .hb__grid {
      flex-direction: row;
      align-items: center;
      gap: var(--hb-gap-cols);
      {%- if image_position == 'left' -%}
      flex-direction: row-reverse;
      {%- endif -%}
    }

    #shopify-section-{{ sid }} .hb__text {
      order: 0;
      flex: 0 0 var(--hb-text-col);
      max-width: var(--hb-text-col);
      gap: {{ s.text_gap | default: 40 }}px;
    }

    #shopify-section-{{ sid }} .hb__media {
      order: 0;
      flex: 1 1 0;
      min-width: 0;
      height: var(--hb-img-h-d);
    }

    #shopify-section-{{ sid }} .hb__heading {
      font-size: var(--hb-h-size-d);
      text-align: {{ heading_align_desktop }};
    }

    #shopify-section-{{ sid }} .hb__benefits {
      grid-template-columns: repeat(var(--hb-benefits-cols-d), minmax(0, 1fr));
    }

    #shopify-section-{{ sid }} .hb__media-mobile { display: none; }
    #shopify-section-{{ sid }} .hb__media-desktop { display: block; }
  }
  {%- if s.enable_custom_fonts -%}
  {% if s.heading_font.family != blank %}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {% for face in s.heading_font.variants %}{{ face | font_face: font_display: 'swap' }}{% endfor %}
  {% endif %}
  {% if s.body_font.family != blank %}
    {{ s.body_font | font_face: font_display: 'swap' }}
    {% for face in s.body_font.variants %}{{ face | font_face: font_display: 'swap' }}{% endfor %}
  {% endif %}
  {%- endif -%}

  /* Explicit controls must also win when global typography priority is enabled. */
  #shopify-section-{{ sid }} .hb__heading {
    font-family: var(--hb-heading-font, var(--heading-font, inherit)) !important;
    font-size: var(--hb-h-size-m) !important;
    font-weight: var(--hb-h-weight) !important;
    line-height: {% if s.enable_custom_style %}{{ s.heading_line_height | default: 1.2 }}{% else %}var(--heading-line-height, 1.2){% endif %} !important;
    letter-spacing: {% if s.enable_custom_style %}{{ s.heading_letter_spacing | default: 0 }}px{% else %}var(--heading-letter-spacing, normal){% endif %} !important;
    text-transform: {% if s.enable_custom_style and s.heading_transform != 'theme' %}{{ s.heading_transform | default: 'none' }}{% else %}var(--heading-text-transform, none){% endif %} !important;
  }
  #shopify-section-{{ sid }} .hb-outer {
    --hb-heading-font: {% if s.enable_custom_style and s.heading_font_source == 'body' %}var(--body-font, inherit){% else %}var(--heading-font, inherit){% endif %};
    --hb-title-font: var(--heading-font, inherit);
    --hb-body-font: var(--body-font, inherit);
    {% if s.enable_custom_fonts and s.heading_font.family != blank %}
      --hb-heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};
      --hb-title-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};
    {% endif %}
    {% if s.enable_custom_fonts and s.body_font.family != blank %}
      --hb-body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};
    {% endif %}
    {% if s.enable_custom_style and s.heading_font_source == 'body' %}--hb-heading-font: var(--hb-body-font);{% endif %}
  }
  #shopify-section-{{ sid }} .hb__benefit-title {
    font-family: var(--hb-title-font) !important;
    font-size: var(--hb-bt-size) !important;
    font-weight: var(--hb-bt-weight) !important;
    line-height: {% if s.enable_custom_style %}{{ s.benefit_title_line_height | default: 1.3 }}{% else %}var(--heading-line-height, 1.2){% endif %} !important;
    letter-spacing: var(--heading-letter-spacing, normal) !important;
    text-transform: var(--heading-text-transform, none) !important;
  }
  #shopify-section-{{ sid }} .hb__benefit-desc,
  #shopify-section-{{ sid }} .hb__benefit-desc :is(p,li,a,strong,em) {
    font-family: var(--hb-body-font) !important;
    font-size: var(--hb-bd-size) !important;
    line-height: {% if s.enable_custom_style %}{{ s.benefit_desc_line_height | default: 1.6 }}{% else %}var(--body-line-height, 1.5){% endif %} !important;
  }
  #shopify-section-{{ sid }} .hb__benefit-desc { font-weight: var(--body-weight, 400) !important; }
  #shopify-section-{{ sid }} .hb__benefit-desc :is(p,li,a,strong,em) { color: inherit; }
  #shopify-section-{{ sid }} .hb__media .hb__media-desktop { display: none; }
  #shopify-section-{{ sid }} .hb__media .hb__media-mobile { display: block; }
  @container hero-benefits (min-width: 1024px) {
    #shopify-section-{{ sid }} .hb__heading { font-size: var(--hb-h-size-d) !important; }
    #shopify-section-{{ sid }} .hb__media .hb__media-desktop { display: block; }
    #shopify-section-{{ sid }} .hb__media .hb__media-mobile { display: none; }
  }
  {% for block in section.blocks %}
    {% assign b = block.settings %}
    {% if b.enable_custom_style %}
      #shopify-section-{{ sid }} [data-benefit-id="{{ block.id }}"] {
        {% if b.icon_color != blank %}--hb-icon-color: {% render 'scheme-color', color: b.icon_color, fallback: 'var(--color-heading)' %};{% endif %}
        --hb-bi-size: {{ b.icon_size | default: 44 }}px;
        --hb-bt-size: {{ b.title_size | default: 18 }}px;
        --hb-bd-size: {{ b.description_size | default: 14 }}px;
        {% if b.title_color != blank %}--hb-heading: {% render 'scheme-color', color: b.title_color, fallback: 'var(--color-heading)' %};{% endif %}
        {% if b.description_color != blank %}--hb-muted: {% render 'scheme-color', color: b.description_color, fallback: 'var(--color-text)' %};{% endif %}
        {% if b.title_font == 'body' %}--hb-title-font: var(--hb-body-font);{% endif %}
        {% if b.title_weight != blank and b.title_weight != 'theme' %}--hb-bt-weight: {{ b.title_weight }};{% endif %}
        text-align: {{ b.alignment | default: 'left' }};
        align-items: {% case b.alignment %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
        gap: {{ b.content_gap | default: 10 }}px;
      }
      #shopify-section-{{ sid }} [data-benefit-id="{{ block.id }}"] .hb__benefit-title {
        letter-spacing: {{ b.letter_spacing | default: 0 }}px !important;
        {% if b.text_case != blank and b.text_case != 'theme' %}text-transform: {{ b.text_case }} !important;{% endif %}
      }
    {% endif %}
  {% endfor %}
  {% if request.design_mode %}
  #shopify-section-{{ sid }}.scroll-trigger { animation: none !important; opacity: 1 !important; transform: none !important; visibility: visible !important; }
  {% endif %}
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }}.scroll-trigger { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
{%- endstyle -%}
<div class="hb-outer color-{{ color_scheme }} gradient {{ mobile_layout_class }}" data-hero-benefits="{{ sid }}" data-hero-settings="{{ s | json | escape }}"{% if section.settings.reset_spacing != false %} data-hb-reset-spacing{% endif %}{% if enable_fade %} data-hb-bottom-fade{% endif %}>
<div class="hb {{ wrap_class }}">
  <div class="hb__inner">
    <div class="hb__grid">
      <div class="hb__text">
        {%- if heading_text != blank -%}
          <h2 class="hb__heading">{{ heading_html }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="hb__benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' and block.hidden != true -%}
                {%- liquid
                  assign b = block.settings
                  assign block_icon_color = b.icon_color
                -%}
                <div class="hb__benefit" data-benefit-id="{{ block.id }}" data-benefit-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
                  {%- case b.icon_type -%}
                    {%- when 'image' -%}
                      {%- if b.icon_image != blank -%}
                        <span class="hb__icon hb__icon--image">
                          <img src="{% render 'offer-image-url', image: b.icon_image, escaped: true %}" alt="{{ b.icon_image.alt | escape }}" width="200" height="200" loading="lazy" decoding="async">
                        </span>
                      {%- else -%}
                        <span class="hb__icon hb__icon--placeholder">
                          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2L3 7v6c0 5 3.8 8.4 9 9 5.2-.6 9-4 9-9V7l-9-5z" fill="currentColor"/>
                          </svg>
                        </span>
                      {%- endif -%}
                    {%- when 'svg' -%}
                      {%- if b.icon_svg != blank -%}
                        <span class="hb__icon hb__icon--svg">{{ b.icon_svg }}</span>
                      {%- else -%}
                        <span class="hb__icon hb__icon--placeholder">
                          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2L3 7v6c0 5 3.8 8.4 9 9 5.2-.6 9-4 9-9V7l-9-5z" fill="currentColor"/>
                          </svg>
                        </span>
                      {%- endif -%}
                    {%- when 'emoji' -%}
                      {%- if b.icon_emoji != blank -%}
                        <span class="hb__icon hb__icon--emoji" aria-hidden="true">{{ b.icon_emoji | escape }}</span>
                      {%- else -%}
                        <span class="hb__icon hb__icon--emoji" aria-hidden="true">{{ '⭐' }}</span>
                      {%- endif -%}
                    {%- when 'library' -%}
                      <span class="hb__icon hb__icon--library" aria-hidden="true">
                        {%- case b.icon_library -%}
                          {%- when 'star' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          {%- when 'heart' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                          {%- when 'check' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          {%- when 'shield' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                          {%- when 'lock' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                          {%- when 'zap' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                          {%- when 'award' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 22 12 19 17 22 15.79 13.88"/></svg>
                          {%- when 'crown' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7l5 5 5-7 5 7 5-5-2 13H4z"/><path d="M4 20h16"/></svg>
                          {%- when 'sparkle' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3z"/></svg>
                          {%- when 'flame' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                          {%- when 'truck' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                          {%- when 'package' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                          {%- when 'tag' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                          {%- when 'gift' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                          {%- when 'cart' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                          {%- when 'credit-card' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                          {%- when 'receipt' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
                          {%- when 'refresh' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                          {%- when 'clock' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          {%- when 'calendar' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                          {%- when 'timer' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="2" x2="14" y2="2"/><line x1="12" y1="14" x2="15" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
                          {%- when 'thumbs-up' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                          {%- when 'smile' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                          {%- when 'verified' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2l2.4 2.4 3.4-.4.4 3.4L20.6 9.6 18.2 12l2.4 2.4-2.4 2.4-.4 3.4-3.4-.4L12 22l-2.4-2.4-3.4.4-.4-3.4L3.4 14.4 5.8 12 3.4 9.6l2.4-2.4.4-3.4 3.4.4z"/></svg>
                          {%- when 'trophy' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
                          {%- when 'leaf' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96c1 7.85-2.62 12.46-7.65 12.94"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
                          {%- when 'sun' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                          {%- when 'moon' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                          {%- when 'droplet' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                          {%- when 'wind' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                          {%- when 'flower' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 9V3"/><path d="M12 15v6"/><path d="M9 12H3"/><path d="M15 12h6"/><path d="M9.88 9.88L5.64 5.64"/><path d="M14.12 14.12l4.24 4.24"/><path d="M14.12 9.88l4.24-4.24"/><path d="M9.88 14.12l-4.24 4.24"/></svg>
                          {%- when 'apple' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06z"/><path d="M10 2c1 .5 2 2 2 5"/></svg>
                          {%- when 'wifi' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                          {%- when 'battery' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/></svg>
                          {%- when 'phone' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                          {%- when 'mail' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                          {%- when 'globe' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                          {%- when 'compass' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                          {%- when 'map' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                          {%- when 'headphones' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                          {%- when 'rocket' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                          {%- when 'magnet' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v8a6 6 0 0 0 12 0V3"/><line x1="2" y1="3" x2="10" y2="3"/><line x1="14" y1="3" x2="22" y2="3"/></svg>
                          {%- when 'book' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                          {%- when 'cake' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s1-1 4-1 5 2 8 2 4-1 4-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/></svg>
                          {%- when 'coffee' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                          {%- when 'music' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                          {%- when 'camera' -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                          {%- else -%}
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3z"/></svg>
                        {%- endcase -%}
                      </span>
                  {%- endcase -%}

                  {%- if b.title != blank -%}
                    <h3 class="hb__benefit-title">{{ b.title | escape }}</h3>
                  {%- endif -%}

                  {%- if b.description != blank -%}
                    <div class="hb__benefit-desc">{{ b.description }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hb__media">
        {%- if image_desktop != blank -%}
          <img
            class="hb__media-desktop"
            src="{% render 'offer-image-url', image: image_desktop, escaped: true %}"
            srcset="{% render 'offer-image-url', image: image_desktop, escaped: true %} 600w, {% render 'offer-image-url', image: image_desktop, escaped: true %} 900w, {% render 'offer-image-url', image: image_desktop, escaped: true %} 1200w, {% render 'offer-image-url', image: image_desktop, escaped: true %} 1600w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt="{{ image_desktop.alt | escape }}"
            width="{{ image_desktop.width | default: 1400 }}"
            height="{{ image_desktop.height | default: 1000 }}"
            loading="eager"
            fetchpriority="high">
        {%- endif -%}
        {%- if mobile_image != blank -%}
          <img
            class="hb__media-mobile"
            src="{% render 'offer-image-url', image: mobile_image, escaped: true %}"
            srcset="{% render 'offer-image-url', image: mobile_image, escaped: true %} 480w, {% render 'offer-image-url', image: mobile_image, escaped: true %} 720w, {% render 'offer-image-url', image: mobile_image, escaped: true %} 1024w"
            sizes="100vw"
            alt="{{ mobile_image.alt | escape }}"
            width="{{ mobile_image.width | default: 1400 }}"
            height="{{ mobile_image.height | default: 1000 }}"
            loading="eager">
        {%- endif -%}

        {%- if image_desktop == blank and mobile_image == blank -%}
          <img
            src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E"
            alt="{{ 'accessibility.placeholder' | t }}"
            loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
</div>

</template>

