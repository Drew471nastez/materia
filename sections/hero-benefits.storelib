  "presets": [
    {
      "name": "Hero Benefits",
      "category": "Hero and banners",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_type": "library",
            "icon_library": "shield",
            "title": "Benefit 1",
            "description": "<p>Describe your first key benefit and how it helps your customers.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "library",
            "icon_library": "zap",
            "title": "Benefit 2",
            "description": "<p>Explain your second important benefit and its value.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "library",
            "icon_library": "sparkle",
            "title": "Benefit 3",
            "description": "<p>Highlight your third benefit and why it matters.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "library",
            "icon_library": "heart",
            "title": "Benefit 4",
            "description": "<p>Detail your fourth benefit and its advantages.</p>"
          }
        }
      ]
    }
  ],
