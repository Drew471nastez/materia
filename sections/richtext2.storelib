              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "header",
            "content": "Custom styling"
          },
          {
            "type": "color",
            "id": "button_color",
