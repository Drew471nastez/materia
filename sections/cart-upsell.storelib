<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed, no constraints */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- if recommendations.products_count > 0 -%}
<div class="cart-upsell color-{{ color_scheme }} gradient">
  <div class="swiper-wrapper">
    {%- for product in recommendations.products -%}
      <div
        class="swiper-slide"
      >
        {% render 'product-item',
          card_product: product,
          template_enable_price: true,
          template_enable_add_cart: true,
          template_enable_product_vendor: false,
          template_enable_rate: false,
          template_enable_product_short_description: false,
          template_enable_color_swatches: false,
          type: 'list'
        %}
      </div>
    {%- endfor -%}
  </div>
  <div class="cart-upsell-wrapper">
    {%- for product in recommendations.products -%}
      <div
        class="cart-upsell-item w-full"
      >
        {% render 'product-item',
          card_product: product,
          template_enable_price: true,
          template_enable_add_cart: true,
          template_enable_product_vendor: false,
          template_enable_rate: false,
          template_enable_product_short_description: false,
          template_enable_color_swatches: false,
          type: 'list'
        %}
      </div>
    {%- endfor -%}
  </div>
</div>
{% endif %}

</template>

<schema>
{
  "type": "cart-upsell",
  "name": "Cart upsell",
  "settings": [],
  "shopify": {
    "name": "Cart upsell",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      }
    ]
  }
}
</schema>
