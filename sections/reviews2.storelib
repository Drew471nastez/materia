            "id": "space_above",
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px",
            "label": "Space above",
            "default": 0
          },
          {
            "type": "range",
            "id": "space_below",
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px",
            "label": "Space below",
            "default": 0
          }
        ]
      },
      {
        "type": "review",
        "name": "Review card",
        "settings": [
          {
            "type": "header",
            "content": "Review"
          },
          {
            "type": "textarea",
            "id": "body",
            "label": "Review body",
            "default": "Write what this customer said about your product."
          },
          {
            "type": "range",
            "id": "rating",
            "min": 0.5,
            "max": 5,
            "step": 0.5,
            "label": "Star rating",
            "info": "Any value from 0.5 to 5; stars fill to the exact rating.",
            "default": 5
          },
          {
            "type": "header",
            "content": "Customer"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Customer name"
          },
          {
            "type": "text",
            "id": "role",
            "label": "Role / title",
            "default": "Verified buyer"
          },
          {
            "type": "image_picker",
            "id": "avatar",
            "label": "Avatar"
          }
        ]
      },
      {
        "type": "cta",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Read more reviews"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Button link"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_hover",
            "label": "Text (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button style",
            "default": true,
            "info": "Off: set this button's size and corners here."
          },
          {
            "type": "range",
            "id": "size",
            "min": 12,
            "max": 20,
            "step": 1,
            "unit": "px",
            "label": "Font size",
            "default": 15,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "min": 16,
            "max": 60,
            "step": 2,
            "unit": "px",
            "label": "Side padding",
            "default": 28,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "min": 8,
            "max": 30,
            "step": 1,
            "unit": "px",
            "label": "Top and bottom padding",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Corner radius",
            "info": "100px = pill shape.",
            "default": 100,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonial Carousel Pro",
        "category": "Testimonials",
        "blocks": [
          {
            "type": "eyebrow"
          },
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "review",
            "settings": {
              "rating": 5
            }
          },
          {
            "type": "review",
            "settings": {
              "rating": 4.5
            }
          },
          {
            "type": "review",
            "settings": {
              "rating": 5
            }
          },
          {
            "type": "review",
            "settings": {
              "rating": 4
            }
          },
          {
            "type": "review",
            "settings": {
              "rating": 5
            }
          },
          {
            "type": "review",
            "settings": {
              "rating": 4.5
            }
          },
          {
            "type": "cta"
          }
        ]
      }
    ]
  }
