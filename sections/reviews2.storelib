              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ]
        },
        {
          "type": "range",
          "id": "space_above",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space above",
          "default": 0
        },
        {
          "type": "range",
          "id": "space_below",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space below",
          "default": 12
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading",
          "default": "Hear from the customers who love what we do."
        },
        {
          "type": "range",
          "id": "size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 16
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#555555"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 11,
          "max": 22,
          "step": 1,
          "unit": "px",
          "label": "Font size (mobile)",
          "default": 15
        },
        {
          "type": "checkbox",
          "id": "enable_custom_weight",
          "label": "Enable custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "400",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
