<template compat="shopify">
{%- comment -%}
  Testimonial Carousel Pro
  ----------------------------------------------------
  Block-driven section. Content (heading / eyebrow / subheading / CTA) lives
  in blocks; only popup-wide visuals (background, card colors, scroll speed,
  star colors) live at the section level. Cards auto-scroll horizontally in
  two rows, looping infinitely. Stars support half-step ratings (0.5 → 5).
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- liquid
  assign scroll_anim = settings.scroll_animation | default: 'none'
-%}

{%- assign block_eyebrow = blank -%}
{%- assign block_heading = blank -%}
{%- assign block_subheading = blank -%}
{%- assign block_cta = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'heading' -%}{%- assign block_heading = b -%}
    {%- when 'subheading' -%}{%- assign block_subheading = b -%}
    {%- when 'cta' -%}{%- assign block_cta = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- if scroll_anim != blank and scroll_anim != 'none' and section.settings.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

<style>
  #shopify-section-{{ sid }} { position: static; }
  .tcp-{{ sid }} {
    background: {{ section.settings.section_bg | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#111111' }};
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: var(--body-font, inherit);
    overflow: hidden;
  }
  .tcp-{{ sid }} *, .tcp-{{ sid }} *::before, .tcp-{{ sid }} *::after { box-sizing: border-box; }

  .tcp-{{ sid }} .tcp-head {
    max-width: 900px;
    margin: 0 auto {{ section.settings.heading_to_grid_gap | default: 36 }}px;
    padding-inline: 24px;
  }
  .tcp-{{ sid }} .tcp-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .tcp-{{ sid }} .tcp-heading {
    font-family: var(--heading-font, inherit);
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 12px;
  }
  .tcp-{{ sid }} .tcp-subheading {
    line-height: 1.55;
    margin: 0;
  }

  /* Marquee rows */
  .tcp-{{ sid }} .tcp-rows {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap | default: 16 }}px;
  }
  .tcp-{{ sid }} .tcp-row {
    display: flex;
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  {%- if section.settings.edge_fade != false -%}
  .tcp-{{ sid }} .tcp-row::before,
  .tcp-{{ sid }} .tcp-row::after {
    content: ""; position: absolute; top: 0; bottom: 0; z-index: 3;
    width: {{ section.settings.edge_fade_size | default: 8 }}%;
    pointer-events: none;
  }
  .tcp-{{ sid }} .tcp-row::before { left: 0;  background: linear-gradient(90deg, {{ section.settings.edge_fade_color | default: section.settings.section_bg | default: '#ffffff' }}, transparent); }
  .tcp-{{ sid }} .tcp-row::after  { right: 0; background: linear-gradient(270deg, {{ section.settings.edge_fade_color | default: section.settings.section_bg | default: '#ffffff' }}, transparent); }
  {%- endif -%}
  .tcp-{{ sid }} .tcp-track {
    display: flex;
    gap: {{ section.settings.card_gap | default: 16 }}px;
    flex-shrink: 0;
    padding-right: {{ section.settings.card_gap | default: 16 }}px;
    will-change: transform;
    animation: tcp-scroll-{{ sid }} {{ section.settings.speed_s | default: 60 }}s linear infinite;
  }
  .tcp-{{ sid }} .tcp-row--reverse .tcp-track { animation-direction: reverse; }
  .tcp-{{ sid }} .tcp-row:hover .tcp-track { animation-play-state: paused; }
  @keyframes tcp-scroll-{{ sid }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tcp-{{ sid }} .tcp-track { animation: none; }
  }

  /* Card */
  .tcp-{{ sid }} .tcp-card {
    flex: 0 0 auto;
    width: {{ section.settings.card_width | default: 320 }}px;
    background: {{ section.settings.card_bg | default: '#f3faf6' }};
    border-radius: {{ section.settings.card_radius | default: 10 }}px;
    padding: 22px 22px;
    display: flex;
    flex-direction: column;
    color: {{ section.settings.card_text_color | default: '#0e1620' }};
    box-shadow: 0 1px 0 rgba(0,0,0,.03);
  }
  @media (max-width: 600px) {
    .tcp-{{ sid }} .tcp-card { width: 280px; padding: 18px; }
  }
  .tcp-{{ sid }} .tcp-card-head {
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 14px;
  }
  .tcp-{{ sid }} .tcp-avatar {
    width: 54px; height: 54px;
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
    background: #ffffff;
  }
  .tcp-{{ sid }} .tcp-avatar img,
  .tcp-{{ sid }} .tcp-avatar svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .tcp-{{ sid }} .tcp-name {
    font-weight: 800;
    font-size: 17px;
    line-height: 1.2;
    margin: 0 0 2px;
  }
  .tcp-{{ sid }} .tcp-role {
    font-size: 14px;
    color: {{ section.settings.role_color | default: '#5b6470' }};
    line-height: 1.3;
    margin: 0;
  }
  .tcp-{{ sid }} .tcp-body {
    font-size: 15px;
    line-height: 1.55;
    margin: 0 0 18px;
    flex: 1;
  }

  /* Star strip (supports half stars) */
  .tcp-{{ sid }} .tcp-stars {
    display: flex; gap: 4px;
    margin-top: auto;
  }
  .tcp-{{ sid }} .tcp-star {
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 2px;
    flex: 0 0 auto;
    background: {{ section.settings.star_bg | default: '#00b67a' }};
    position: relative;
    overflow: hidden;
  }
  .tcp-{{ sid }} .tcp-star.is-empty { background: {{ section.settings.star_empty_bg | default: '#d6e4dd' }}; }
  .tcp-{{ sid }} .tcp-star.is-half {
    background: {{ section.settings.star_empty_bg | default: '#d6e4dd' }};
  }
  .tcp-{{ sid }} .tcp-star.is-half::before {
    content: "";
    position: absolute;
    left: 0; top: 0;
    width: 50%; height: 100%;
    background: {{ section.settings.star_bg | default: '#00b67a' }};
  }
  .tcp-{{ sid }} .tcp-star svg {
    width: 65%; height: 65%;
    fill: #ffffff;
    position: relative;
    z-index: 1;
  }

  /* CTA */
  .tcp-{{ sid }} .tcp-cta {
    text-align: center;
    margin-top: {{ section.settings.cta_top_gap | default: 36 }}px;
  }
  .tcp-{{ sid }} .tcp-cta a {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    transition: background-color .3s ease, color .3s ease, transform .15s ease;
  }
  .tcp-{{ sid }} .tcp-cta a:hover {
    transform: translateY(-1px);
  }
{% comment %}{% endcomment %}</style>

<div class="tcp-{{ sid }}">
  {%- comment -%}
    Heading area is rendered only if at least one head block exists.
  {%- endcomment -%}
  {%- if block_eyebrow != blank or block_heading != blank or block_subheading != blank -%}
    {%- assign head_align = section.settings.heading_align | default: 'center' -%}
    <div class="tcp-head" style="text-align: {{ head_align }};">
      {%- if block_eyebrow != blank and block_eyebrow.settings.text != blank -%}
        {%- assign e = block_eyebrow.settings -%}
        <style>
          #shopify-section-{{ section.id }} [data-bid="{{ block_eyebrow.id }}"]{font-size:{{ e.size_mobile | default: 12 }}px;{% if e.enable_custom_weight %}font-weight:{{ e.font_weight }};{% endif %}margin:{{ e.space_above | default: 0 }}px 0 {{ e.space_below | default: 10 }}px;}
          @media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block_eyebrow.id }}"]{font-size:{{ e.size_desktop | default: 12 }}px;}}
{% comment %}{% endcomment %}        </style>
        <p class="tcp-eyebrow" data-bid="{{ block_eyebrow.id }}"
           style="color: {{ e.color | default: '#666666' }};"
           {{ block_eyebrow.shopify_attributes }}>{{ e.text }}</p>
      {%- endif -%}
      {%- if block_heading != blank and block_heading.settings.text != blank -%}
        {%- assign h = block_heading.settings -%}
        <style>
          #shopify-section-{{ section.id }} [data-bid="{{ block_heading.id }}"]{font-size:{{ h.size_mobile | default: 26 }}px;{% if h.enable_custom_weight %}font-weight:{{ h.font_weight }};{% endif %}margin:{{ h.space_above | default: 0 }}px 0 {{ h.space_below | default: 12 }}px;}
          @media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block_heading.id }}"]{font-size:{{ h.size | default: 44 }}px;}}
{% comment %}{% endcomment %}        </style>
        <h2 class="tcp-heading" data-bid="{{ block_heading.id }}"
            style="color: {{ h.color | default: '#111111' }};"
            {{ block_heading.shopify_attributes }}>{{ h.text }}</h2>
      {%- endif -%}
      {%- if block_subheading != blank and block_subheading.settings.text != blank -%}
        {%- assign sh = block_subheading.settings -%}
        <style>
          #shopify-section-{{ section.id }} [data-bid="{{ block_subheading.id }}"]{font-size:{{ sh.size_mobile | default: 15 }}px;{% if sh.enable_custom_weight %}font-weight:{{ sh.font_weight }};{% endif %}margin:{{ sh.space_above | default: 0 }}px 0 {{ sh.space_below | default: 0 }}px;}
          @media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block_subheading.id }}"]{font-size:{{ sh.size | default: 16 }}px;}}
{% comment %}{% endcomment %}        </style>
        <p class="tcp-subheading" data-bid="{{ block_subheading.id }}"
           style="color: {{ sh.color | default: '#555555' }};"
           {{ block_subheading.shopify_attributes }}>{{ sh.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  {%- assign total = review_blocks.size -%}
  {%- if total > 0 -%}
    {%- assign half = total | divided_by: 2 | at_least: 1 -%}
    <div class="tcp-rows">
      <div class="tcp-row">
        <div class="tcp-track">
          {%- for i in (1..2) -%}
            {%- for b in review_blocks limit: half -%}
              {%- render 'tcp-review-card', b: b, section_settings: section.settings -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
      {%- if total > 1 -%}
        <div class="tcp-row tcp-row--reverse">
          <div class="tcp-track">
            {%- for i in (1..2) -%}
              {%- for b in review_blocks offset: half -%}
                {%- render 'tcp-review-card', b: b, section_settings: section.settings -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block_cta != blank and block_cta.settings.label != blank -%}
    <div class="tcp-cta" {{ block_cta.shopify_attributes }}>
      <a href="{{ block_cta.settings.link | default: '#' }}"
         style="padding: {{ block_cta.settings.padding_y | default: 14 }}px {{ block_cta.settings.padding_x | default: 28 }}px;
                border-radius: {{ block_cta.settings.radius | default: 999 }}px;
                font-size: {{ block_cta.settings.size | default: 15 }}px;
                background: {{ block_cta.settings.bg | default: '#111111' }};
                color: {{ block_cta.settings.text_color | default: '#ffffff' }};"
         onmouseover="this.style.background='{{ block_cta.settings.bg_hover | default: '#000000' }}';this.style.color='{{ block_cta.settings.text_hover | default: '#ffffff' }}';"
         onmouseout="this.style.background='{{ block_cta.settings.bg | default: '#111111' }}';this.style.color='{{ block_cta.settings.text_color | default: '#ffffff' }}';">
        {{ block_cta.settings.label }}
      </a>
    </div>
  {%- endif -%}
</div>



</template>

<schema>
{
  "type": "reviews2",
  "name": "Testimonial Carousel Pro",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "📝 Content lives in blocks below"
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_to_grid_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap below heading",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "info": "Use a very light shade for the Trustpilot-style look.",
      "default": "#f3faf6"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#0e1620"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role / sub-label color",
      "default": "#5b6470"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 220,
      "max": 440,
      "step": 10,
      "unit": "px",
      "label": "Card width (desktop)",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between rows",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Stars"
    },
    {
      "type": "color",
      "id": "star_bg",
      "label": "Filled star background",
      "default": "#00b67a"
    },
    {
      "type": "color",
      "id": "star_empty_bg",
      "label": "Empty star background",
      "default": "#d6e4dd"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "info": "Applied to every review card in the section.",
      "default": 26
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Scroll animation"
    },
    {
      "type": "range",
      "id": "speed_s",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "One full loop duration",
      "info": "Higher = slower scroll. Cards loop infinitely; rows scroll in opposite directions.",
      "default": 60
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Section style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Edge fade"
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade carousel edges",
      "default": true
    },
    {
      "type": "range",
      "id": "edge_fade_size",
      "label": "Fade width",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "color",
      "id": "edge_fade_color",
      "label": "Fade color",
      "info": "Match your section background for a clean fade.",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "TESTIMONIALS"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#666666"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "min": 9,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size (desktop)",
          "default": 12
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 8,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Font size (mobile)",
          "default": 12
        },
        {
          "type": "checkbox",
          "id": "enable_custom_weight",
          "label": "Enable custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "700",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ]
        },
        {
          "type": "range",
          "id": "space_above",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space above",
          "default": 0
        },
        {
          "type": "range",
          "id": "space_below",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space below",
          "default": 10
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Thousands of trusted reviews"
        },
        {
          "type": "range",
          "id": "size",
          "min": 20,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Max font size (desktop)",
          "default": 44
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#111111"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 16,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Font size (mobile)",
          "default": 26
        },
        {
          "type": "checkbox",
          "id": "enable_custom_weight",
          "label": "Enable custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "800",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
