<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign scroll_anim = settings.scroll_animation | default: 'none'
  assign fb_customer = 'accessibility.customer' | t
-%}
{%- comment -%}
  Materia Themes. Testimonial Carousel Pro.

  Eyebrow, heading, subheading and button blocks around two rows of review
  cards that drift sideways in opposite directions, looping (each row is
  printed four times so a short row still fills a wide screen). The rows pause
  on hover, on keyboard focus and off screen, and stand still (and scroll by
  hand) under reduced motion. Colours follow the colour scheme and fonts
  follow Theme settings > Typography until custom styling or custom fonts
  are switched on; the button is a theme button. Live edits and the off
  screen pause come from assets/live-testimonials.js.
{%- endcomment -%}
{%- if scroll_anim != blank and scroll_anim != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'live-testimonials-style', sid: sid %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { position: static; }
  #shopify-section-{{ sid }} .tcp { background: var(--tcp-bg); color: var(--tcp-text); padding-top: var(--tcp-pt); padding-bottom: var(--tcp-pb); font-family: var(--tcp-bf); overflow: hidden; }
  #shopify-section-{{ sid }} .tcp *, #shopify-section-{{ sid }} .tcp *::before, #shopify-section-{{ sid }} .tcp *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .tcp__head { max-width: 900px; margin: 0 auto var(--tcp-head-gap); padding-inline: 24px; text-align: var(--tcp-align); }
  #shopify-section-{{ sid }} .tcp__head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .tcp__eyebrow, #shopify-section-{{ sid }} .tcp__heading, #shopify-section-{{ sid }} .tcp__sub { color: var(--b-c); margin: var(--b-above, 0) 0 var(--b-below, 0); font-size: var(--b-fs-m); }
  #shopify-section-{{ sid }} .tcp__eyebrow { letter-spacing: .12em; text-transform: uppercase; font-family: var(--tcp-bf); font-weight: var(--b-w, 700); }
  #shopify-section-{{ sid }} .tcp__heading { font-family: var(--tcp-hf); font-weight: var(--b-w, var(--heading-weight, 700)); line-height: 1.12; }
  #shopify-section-{{ sid }} .tcp__sub { font-family: var(--tcp-bf); font-weight: var(--b-w, var(--body-weight, 400)); line-height: 1.55; }
  #shopify-section-{{ sid }} .tcp__sub p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .tcp__sub p + p { margin-top: .6em; }
  #shopify-section-{{ sid }} .tcp__rows { display: flex; flex-direction: column; gap: var(--tcp-row-gap); }
  #shopify-section-{{ sid }} .tcp__row { position: relative; display: flex; width: 100%; overflow: hidden; }
  #shopify-section-{{ sid }} .tcp[data-fade="true"] .tcp__row::before, #shopify-section-{{ sid }} .tcp[data-fade="true"] .tcp__row::after { content: ""; position: absolute; top: 0; bottom: 0; z-index: 3; width: var(--tcp-fade-size); pointer-events: none; }
  #shopify-section-{{ sid }} .tcp[data-fade="true"] .tcp__row::before { left: 0; background: linear-gradient(90deg, var(--tcp-fade), transparent); }
  #shopify-section-{{ sid }} .tcp[data-fade="true"] .tcp__row::after { right: 0; background: linear-gradient(270deg, var(--tcp-fade), transparent); }
  #shopify-section-{{ sid }} .tcp__track { display: flex; flex-shrink: 0; gap: var(--tcp-gap); padding-right: var(--tcp-gap); will-change: transform; animation: tcp-drift-{{ sid }} var(--tcp-speed) linear infinite; }
  #shopify-section-{{ sid }} .tcp__row--reverse .tcp__track { animation-direction: reverse; }
  #shopify-section-{{ sid }} .tcp__row:hover .tcp__track, #shopify-section-{{ sid }} .tcp__row:focus-within .tcp__track, #shopify-section-{{ sid }} .tcp[data-lt-paused] .tcp__track { animation-play-state: paused; }
  @keyframes tcp-drift-{{ sid }} { from { transform: translateX(0); } to { transform: translateX(-25%); } }
  #shopify-section-{{ sid }} .tcp__card { display: flex; flex: 0 0 auto; flex-direction: column; width: var(--tcp-card-w-m); padding: 18px; background: var(--tcp-card-bg); color: var(--tcp-card-c); border-radius: var(--tcp-radius); box-shadow: 0 1px 0 rgba(0, 0, 0, .03); }
  #shopify-section-{{ sid }} .tcp__card-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  #shopify-section-{{ sid }} .tcp__avatar { flex: 0 0 auto; width: 54px; height: 54px; border-radius: 50%; overflow: hidden; background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); color: color-mix(in srgb, var(--color-text) 35%, var(--color-background)); }
  #shopify-section-{{ sid }} .tcp__avatar img, #shopify-section-{{ sid }} .tcp__avatar svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .tcp__name { margin: 0 0 2px; color: inherit; font-family: var(--tcp-hf); font-weight: var(--heading-weight, 700); font-size: 17px; line-height: 1.2; }
  #shopify-section-{{ sid }} .tcp__role { margin: 0; color: var(--tcp-role-c); font-size: 14px; line-height: 1.3; }
  #shopify-section-{{ sid }} .tcp__body { flex: 1; margin: 0 0 18px; font-size: 15px; line-height: 1.55; color: inherit; white-space: pre-line; }
  #shopify-section-{{ sid }} .tcp__card .lt-stars { gap: 4px; margin-top: auto; }
  #shopify-section-{{ sid }} .tcp__card .lt-star { border-radius: 2px; background: linear-gradient(90deg, var(--lt-star-on) var(--lt-fill), var(--lt-star-off) var(--lt-fill)); }
  #shopify-section-{{ sid }} .tcp__card .lt-star::before { content: none; }
  #shopify-section-{{ sid }} .tcp__card .lt-star svg { width: 65%; height: 65%; margin: 17.5%; fill: var(--btn-primary-color, #fff); }
  #shopify-section-{{ sid }} .tcp__cta { margin-top: 36px; text-align: center; }
  #shopify-section-{{ sid }} .tcp__cta[hidden] { display: none; }
  #shopify-section-{{ sid }} .tcp__btn { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .tcp__eyebrow, #shopify-section-{{ sid }} .tcp__heading, #shopify-section-{{ sid }} .tcp__sub { font-size: var(--b-fs-d); }
    #shopify-section-{{ sid }} .tcp__card { width: var(--tcp-card-w); padding: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .tcp__track { animation: none; transform: none; padding-inline: 16px; }
    #shopify-section-{{ sid }} .tcp__row { overflow-x: auto; scroll-snap-type: x proximity; }
    #shopify-section-{{ sid }} .tcp__row::before, #shopify-section-{{ sid }} .tcp__row::after { display: none; }
    #shopify-section-{{ sid }} .tcp__card[data-copy] { display: none; }
    #shopify-section-{{ sid }} .tcp__card { scroll-snap-align: start; }
  }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign total = reviews.size
  assign half = total | plus: 1 | divided_by: 2 | at_least: 1
-%}
<div class="lt-frame" data-width="{{ st.section_width | default: 'full_width' }}">
<div class="tcp color-{{ color_scheme }} gradient" data-lt-root="reviews2" data-section-id="{{ sid }}" data-lt-settings="{{ st | json | escape }}" data-fade="{% if st.edge_fade %}true{% else %}false{% endif %}"{% if fonts %} data-own-font{% endif %} style="--tcp-bg: {% render 'live-testimonials-color', on: custom, color: st.section_bg, fallback: 'var(--color-background)' %};--tcp-text: {% render 'live-testimonials-color', on: custom, color: st.text_color, fallback: 'var(--color-text)' %};--tcp-card-bg: {% render 'live-testimonials-color', on: custom, color: st.card_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};--tcp-card-c: {% render 'live-testimonials-color', on: custom, color: st.card_text_color, fallback: 'var(--color-text)' %};--tcp-role-c: {% render 'live-testimonials-color', on: custom, color: st.role_color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %};--lt-star-on: {% render 'live-testimonials-color', on: custom, color: st.star_bg, fallback: 'var(--color-primary)' %};--lt-star-off: {% render 'live-testimonials-color', on: custom, color: st.star_empty_bg, fallback: 'color-mix(in srgb, var(--color-primary) 20%, var(--color-background))' %};--tcp-fade: {% render 'live-testimonials-color', on: custom, color: st.edge_fade_color, fallback: 'var(--tcp-bg)' %};--tcp-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--tcp-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--tcp-pt: {{ st.padding_top | default: 0 }}px;--tcp-pb: {{ st.padding_bottom | default: 0 }}px;--tcp-align: {{ st.heading_align | default: 'center' }};--tcp-head-gap: {{ st.heading_to_grid_gap | default: 0 }}px;--tcp-row-gap: {{ st.row_gap | default: 0 }}px;--tcp-gap: {{ st.card_gap | default: 16 }}px;--tcp-card-w: {{ st.card_width | default: 320 }}px;--tcp-card-w-m: {{ st.card_width_mobile | default: 280 }}px;--tcp-radius: {{ st.card_radius | default: 0 }}px;--lt-star-size: {{ st.star_size | default: 26 }}px;--tcp-speed: {{ st.speed_s | default: 60 }}s;--tcp-fade-size: {{ st.edge_fade_size | default: 8 }}%;">
  <div class="tcp__head">
    {%- for b in section.blocks -%}
      {%- assign bs = b.settings -%}
      {%- unless b.type == 'eyebrow' or b.type == 'heading' or b.type == 'subheading' -%}{%- continue -%}{%- endunless -%}
      {%- liquid
        if b.type == 'heading'
          assign fb_c = 'var(--color-heading)'
          assign fs_d = bs.size | default: 44
          assign fs_m = bs.size_mobile | default: 26
        elsif b.type == 'eyebrow'
          assign fb_c = 'var(--color-text)'
          assign fs_d = bs.size_desktop | default: 12
          assign fs_m = bs.size_mobile | default: 12
        else
          assign fb_c = 'var(--color-text)'
          assign fs_d = bs.size | default: 16
          assign fs_m = bs.size_mobile | default: 15
        endif
      -%}
      {%- capture b_attrs -%}data-lt-block="{{ b.id }}" data-lt-type="{{ b.type }}" data-lt-settings="{{ bs | json | escape }}"{% if bs.enable_custom_weight %} data-own-weight{% endif %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: fb_c %};{% if bs.enable_custom_weight %}--b-w: {{ bs.font_weight }};{% endif %}--b-fs-d: {{ fs_d }}px;--b-fs-m: {{ fs_m }}px;--b-above: {{ bs.space_above | default: 0 }}px;--b-below: {{ bs.space_below | default: 0 }}px;" {{ b.shopify_attributes }}{%- endcapture -%}
      {%- case b.type -%}
        {%- when 'eyebrow' -%}<p class="tcp__eyebrow" {{ b_attrs }}>{{ bs.text | escape }}</p>
        {%- when 'heading' -%}<h2 class="tcp__heading" {{ b_attrs }}>{{ bs.text }}</h2>
        {%- when 'subheading' -%}<div class="tcp__sub" {{ b_attrs }}>{{ bs.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if total > 0 -%}
    <div class="tcp__rows" data-lt-marquee>
      {%- for r in (1..2) -%}
        {%- if r == 2 and total < 2 -%}{%- break -%}{%- endif -%}
        <div class="tcp__row{% if r == 2 %} tcp__row--reverse{% endif %}">
          <div class="tcp__track">
            {%- for copy in (1..4) -%}
              {%- if r == 1 -%}{%- assign list_offset = 0 -%}{%- assign list_limit = half -%}{%- else -%}{%- assign list_offset = half -%}{%- assign list_limit = total -%}{%- endif -%}
              {%- for b in reviews limit: list_limit offset: list_offset -%}
                {%- assign bs = b.settings -%}
                <div class="tcp__card" data-lt-block="{{ b.id }}" data-lt-type="review" data-lt-settings="{{ bs | json | escape }}"{% if copy > 1 %} data-copy aria-hidden="true"{% else %} {{ b.shopify_attributes }}{% endif %}>
                  <div class="tcp__card-head">
                    <div class="tcp__avatar" data-lt-media>
                      {%- if bs.avatar != blank -%}
                        {{ bs.avatar | image_url: width: 150 | image_tag: loading: 'lazy', decoding: 'async', widths: '60,90,120,150', sizes: '54px', width: 54, height: 54, alt: bs.name | default: fb_customer }}
                      {%- else -%}
                        <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false" data-lt-ph><circle cx="32" cy="26" r="10" fill="currentColor"/><path d="M14 56c0-10 9-16 18-16s18 6 18 16" fill="currentColor"/></svg>
                      {%- endif -%}
                    </div>
                    <div>
                      <h3 class="tcp__name" data-lt-name>{{ bs.name | default: fb_customer | escape }}</h3>
                      <p class="tcp__role" data-lt-role{% if bs.role == blank %} hidden{% endif %}>{{ bs.role | escape }}</p>
                    </div>
                  </div>
                  <p class="tcp__body" data-lt-text{% if bs.body == blank %} hidden{% endif %}>{{ bs.body | escape }}</p>
                  {% render 'live-testimonials-stars', rating: bs.rating %}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- for b in section.blocks -%}
    {%- if b.type != 'cta' -%}{%- continue -%}{%- endif -%}
    {%- assign bs = b.settings -%}
    {%- capture btn_style -%}
      {%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.text_color, hover_bg: bs.bg_hover, hover_text: bs.text_hover -%}{%- endif -%}
      {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius }}px;--mb-padding-y: {{ bs.padding_y }}px;--mb-padding-x: {{ bs.padding_x }}px;--mb-font-size: {{ bs.size }}px;{%- endif -%}
    {%- endcapture -%}
    {%- capture btn_attrs -%}class="tcp__btn" data-theme-button="primary" data-sl-button data-lt-button{% if bs.use_theme_button == false %} data-own-shape{% endif %} style="{{ btn_style }}"{%- endcapture -%}
    <div class="tcp__cta" data-lt-block="{{ b.id }}" data-lt-type="cta" data-lt-settings="{{ bs | json | escape }}"{% if bs.label == blank %} hidden{% endif %} {{ b.shopify_attributes }}>
      {%- if bs.link != blank -%}
        <a href="{{ bs.link }}" {{ btn_attrs }}>{{ bs.label | escape }}</a>
      {%- else -%}
        <button type="button" {{ btn_attrs }}>{{ bs.label | escape }}</button>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
</div>
</template>

<schema>
{
  "type": "reviews2",
  "name": "Testimonial Carousel Pro",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_to_grid_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap below heading",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role color"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 220,
      "max": 440,
      "step": 10,
      "unit": "px",
      "label": "Card width (desktop)",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between rows",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Stars"
    },
    {
      "type": "color",
      "id": "star_bg",
      "label": "Filled star background"
    },
    {
      "type": "color",
      "id": "star_empty_bg",
      "label": "Empty star background"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 26
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Scroll animation"
    },
    {
      "type": "range",
      "id": "speed_s",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Loop duration",
      "default": 60
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Section style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Edge fade"
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade carousel edges",
      "default": true
    },
    {
      "type": "range",
      "id": "edge_fade_size",
      "label": "Fade width",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "color",
      "id": "edge_fade_color",
      "label": "Fade color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "TESTIMONIALS"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "min": 9,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size (desktop)",
          "default": 12
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 8,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Font size (mobile)",
          "default": 12
        },
        {
          "type": "checkbox",
          "id": "enable_custom_weight",
          "label": "Enable custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "700",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ]
        },
        {
          "type": "range",
          "id": "space_above",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space above",
          "default": 0
        },
        {
          "type": "range",
          "id": "space_below",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Space below",
          "default": 10
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Thousands of trusted reviews"
        },
        {
          "type": "range",
          "id": "size",
          "min": 20,
          "max": 72,
          "step": 1,
          "unit": "px",
