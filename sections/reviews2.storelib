  "presets": [
    {
      "name": "Testimonial Carousel Pro",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "review",
          "settings": {
            "name": "Sarah Jones",
            "role": "Teacher",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "David Lee",
            "role": "Marketing Manager",
            "rating": 5,
            "body": "I was blown away by the attention to detail. The craftsmanship is evident in every stitch, and the pieces are incredibly comfortable to wear. I'm a loyal customer now!"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Amanda Martinez",
            "role": "Travel Blogger",
            "rating": 5,
            "body": "I always pack their pieces when I travel. They're lightweight, versatile, and wrinkle-resistant — perfect for exploring new destinations. They've become my travel essentials."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Sarah Jones",
            "role": "Teacher",
            "rating": 4.5
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Alice Smith",
            "role": "Marketing Manager",
            "rating": 5,
            "body": "Their pieces are timeless and elegant, and they would complement any wardrobe. I especially love their attention to detail in the finishing touches."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Emily Chen",
            "role": "Fashion Blogger",
            "rating": 4.5,
            "body": "I've been following them for a while now, and I'm always impressed by their innovative designs. They're not afraid to push boundaries, and they always manage to create pieces that are both stylish and wearable."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Michael Brown",
            "role": "Project Manager",
            "rating": 5,
            "body": "I love the unique and edgy vibe of this brand. Their pieces are perfect for expressing my individuality, and they always make me feel like a rockstar. I'm a huge fan!"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Alice Smith",
            "role": "Marketing Manager",
            "rating": 4
          }
        },
        {
          "type": "cta"
        }
      ]
    }
  ],
