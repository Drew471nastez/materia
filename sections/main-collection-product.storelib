<template compat="shopify">
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} { font-weight: var(--body-weight, inherit); isolation: isolate; position: relative; }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) { font-weight: var(--heading-weight, inherit); }
{% comment %}{% endcomment %}</style>

{%- comment -%} HORIZONTAL FILTER PILLS — EVEN GAP FIX (12px desktop / 8px mobile) {%- endcomment -%}
{%- if section.settings.enable_filtering and section.settings.filter_layout == 'horizontal' -%}
<style>
  #shopify-section-{{ section.id }} .collection-sidebar.horizontal,
  #shopify-section-{{ section.id }} .filter-horizontal,
  #shopify-section-{{ section.id }} .filter-layout-horizontal,
  #shopify-section-{{ section.id }} [data-filter-layout="horizontal"],
  #shopify-section-{{ section.id }} .horizontal-filter,
  #shopify-section-{{ section.id }} .horizontal-filters,
  #shopify-section-{{ section.id }} .filters-toolbar__inputs,
  #shopify-section-{{ section.id }} .filter-list,
  #shopify-section-{{ section.id }} ul.filter-list,
  #shopify-section-{{ section.id }} .collection-filters-horizontal,
  #shopify-section-{{ section.id }} .collection-filters-horizontal > ul,
  #shopify-section-{{ section.id }} .collection-filters > .filters,
  #shopify-section-{{ section.id }} .horizontal .filter-vertical {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 12px !important;
    row-gap: 12px !important;
    margin: 0 0 1.5rem 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  #shopify-section-{{ section.id }} .collection-sidebar.horizontal > *,
  #shopify-section-{{ section.id }} .filter-horizontal > *,
  #shopify-section-{{ section.id }} .filter-layout-horizontal > *,
  #shopify-section-{{ section.id }} .horizontal-filter > *,
  #shopify-section-{{ section.id }} .horizontal-filters > *,
  #shopify-section-{{ section.id }} .filters-toolbar__inputs > *,
  #shopify-section-{{ section.id }} .filter-list > li,
  #shopify-section-{{ section.id }} ul.filter-list > li,
  #shopify-section-{{ section.id }} .collection-filters-horizontal > ul > li,
  #shopify-section-{{ section.id }} .collection-filters > .filters > *,
  #shopify-section-{{ section.id }} .horizontal .filter-vertical > * {
    margin: 0 !important;
    flex: 0 0 auto !important;
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .collection-sidebar.horizontal,
    #shopify-section-{{ section.id }} .filter-horizontal,
    #shopify-section-{{ section.id }} .horizontal-filter,
    #shopify-section-{{ section.id }} .horizontal-filters,
    #shopify-section-{{ section.id }} .filters-toolbar__inputs,
    #shopify-section-{{ section.id }} .filter-list,
    #shopify-section-{{ section.id }} .collection-filters-horizontal {
      gap: 8px !important;
      row-gap: 8px !important;
    }
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}

{%- comment -%}
  === FADED CARD FIX (CSS + editor-only JS) ===

  Two-part strategy:

  PART A — CSS:
  Force opacity:1 + visibility:visible + transform:none on the OUTER
  wrapper chain of each card (anywhere from .grid__item down through
  motion-element / .scroll-trigger / .product-item / .card-wrapper).
  Uses both direct child (>) AND descendant ( ) selectors but limited
  to the wrapper classes — never touches inner action/hover elements.

  PART B — JS (editor re-render only):
  When `shopify:section:load` fires (Shopify editor's event when it
  swaps section HTML after an edit), walk the cards and clear any
  inline opacity / transform / visibility styles. This is the moment
  the fade happens in the editor — so we only fix it then. We do NOT
  bind to scroll, hover, click, or any user-facing event — so hovers
  and AJAX states stay completely untouched.

  Result:
    - Live storefront: CSS keeps cards visible at all times
    - Editor preview: CSS + section:load JS catches the re-render fade
    - Hovers / AJAX / loading state: never touched
{%- endcomment -%}
<style>
  /* Outer wrapper chain — force visible. Uses > AND descendant for safety. */
  #shopify-section-{{ section.id }} #product-grid .grid__item,
  #shopify-section-{{ section.id }} #product-grid .grid__item > motion-element,
  #shopify-section-{{ section.id }} #product-grid .grid__item motion-element:not(.product-item__action *):not(.product-item__hover *),
  #shopify-section-{{ section.id }} #product-grid .grid__item > .product-item,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .product-card,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .card-wrapper,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .scroll-trigger,
  #shopify-section-{{ section.id }} #product-grid .grid__item.scroll-trigger,
  #shopify-section-{{ section.id }} #product-grid .grid__item > motion-element > .product-item,
  #shopify-section-{{ section.id }} #product-grid .grid__item > motion-element > .product-card,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .product-item > motion-element:first-child,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .product-card > motion-element:first-child {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }
  /* Theme's specific pre-reveal classes — neutralize on outer wrappers only */
  #shopify-section-{{ section.id }} #product-grid .grid__item.scroll-trigger,
  #shopify-section-{{ section.id }} #product-grid .grid__item.fade-in-up,
  #shopify-section-{{ section.id }} #product-grid .grid__item.fade-in,
  #shopify-section-{{ section.id }} #product-grid .grid__item.slide-in,
  #shopify-section-{{ section.id }} #product-grid .grid__item[data-reveal],
  #shopify-section-{{ section.id }} #product-grid .grid__item[data-cascade] {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }
  /* Theme's "before-reveal" wrapper that holds opacity-0 — but ONLY at the
     outer wrapper level. Inner .invisible (used by Add-to-Cart hover toggle)
     stays untouched. */
  #shopify-section-{{ section.id }} #product-grid .grid__item > .invisible,
  #shopify-section-{{ section.id }} #product-grid .grid__item > .opacity-0,
  #shopify-section-{{ section.id }} #product-grid .grid__item > [class*="opacity-0"]:not(.product-item__action):not(.product-item__hover) {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  /* === FADE FIX — EDITOR RE-RENDER ONLY ===
     Binds ONLY to shopify:section:load (the editor's section-swap event).
     Doesn't run on scroll, hover, click, mousemove, focus — so hover and
     AJAX states are guaranteed untouched.

     On the event: walk each .grid__item in this section and clear any
     inline opacity/transform/visibility styles the theme's scroll-anim JS
     set during initial render. Strip pre-reveal class only from outer
     wrappers, never from descendants. */
  var SID = {{ section.id | json }};
  function fixFadedCards(){
    var sec = document.getElementById('shopify-section-' + SID);
    if (!sec) return;
    var items = sec.querySelectorAll('#product-grid .grid__item');
    items.forEach(function(card){
      // Clear inline style only on the OUTER card + its direct motion-element child
      card.style.opacity = '';
      card.style.visibility = '';
      card.style.transform = '';
      var directWrappers = card.querySelectorAll(
        ':scope > motion-element, ' +
        ':scope > .product-item, ' +
        ':scope > .product-card, ' +
        ':scope > .card-wrapper, ' +
        ':scope > .scroll-trigger'
      );
      directWrappers.forEach(function(w){
        w.style.opacity = '';
        w.style.visibility = '';
        w.style.transform = '';
      });
      // Strip pre-reveal class ONLY from the outer card and direct wrappers
      ['scroll-trigger','fade-in-up','fade-in','slide-in'].forEach(function(cls){
        if (card.classList.contains(cls) && card.style.opacity !== '0') {
          // leave the class but clear inline opacity (above)
        }
      });
    });
  }

  // Fire ONLY on Shopify editor section reload event
  document.addEventListener('shopify:section:load', function(e){
    if (e.detail && e.detail.sectionId === SID) {
      // Small delay so theme's own init runs first, then we clean up
      setTimeout(fixFadedCards, 50);
      setTimeout(fixFadedCards, 300);
    }
  });

  // Also fire ONCE on initial DOMContentLoaded — for the case where the editor
  // navigates between sections and the scroll-trigger observer never inits
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixFadedCards);
  } else {
    setTimeout(fixFadedCards, 100);
  }
})();
{% comment %}{% endcomment %}</script>

<style>
  /* === COLOR SCHEME INHERITANCE === */
  #shopify-section-{{ section.id }} {
    --mci-bg: var(--color-background, #ffffff);
    --mci-text: var(--color-text, #111111);
    --mci-text-soft: rgba(0, 0, 0, 0.55);
    --mci-border: var(--color-border, rgba(0, 0, 0, 0.12));
    --mci-active: var(--color-primary, var(--color-text, #111111));
    --mci-row-hover: rgba(0, 0, 0, 0.04);
  }
  .mci-{{ section.id }}-trigger,
  .mci-{{ section.id }}-sheet,
  .mci-{{ section.id }}-sheet *,
  .mci-{{ section.id }}-backdrop { box-sizing: border-box; }
  .mci-hide-duplicate { display: none !important; }

  .mci-{{ section.id }}-mobile-row { display: none; }
  @media (max-width: 767.98px) {
    .mci-{{ section.id }}-mobile-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      padding: 0 15px 16px;
      align-items: center;
    }
  }

  .mci-{{ section.id }}-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: var(--mci-bg);
    border: 1px solid var(--mci-border);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--mci-text);
    font-family: inherit;
    cursor: pointer;
    line-height: 1;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.1s ease;
    white-space: nowrap;
  }
  .mci-{{ section.id }}-trigger:hover { border-color: var(--mci-text); }
  .mci-{{ section.id }}-trigger:active { transform: scale(0.97); background: var(--mci-row-hover); }
  .mci-{{ section.id }}-trigger svg { width: 14px; height: 14px; flex-shrink: 0; stroke: currentColor; }
  .mci-{{ section.id }}-trigger-label { color: var(--mci-text-soft); }
  .mci-{{ section.id }}-trigger-value { font-weight: 600; }

  .mci-{{ section.id }}-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.32s cubic-bezier(0.32, 0.72, 0, 1);
    -webkit-tap-highlight-color: transparent;
  }
  .mci-{{ section.id }}-backdrop.is-open { opacity: 1; pointer-events: auto; }
  .mci-{{ section.id }}-backdrop.is-dragging { transition: none; }

  .mci-{{ section.id }}-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 100%;
    max-height: 85vh;
    background: var(--mci-bg);
    color: var(--mci-text);
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.18);
    z-index: 999999;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: env(safe-area-inset-bottom, 0);
    touch-action: pan-y;
    /* Closed sheet must not intercept pointer events. On desktop it is only
       hidden via opacity:0 while parked center-screen at z-index:999999, so
       without this it formed an invisible wall over the product grid that
       blocked card hover/clicks and made the page feel frozen. Children
       inherit pointer-events, so disabling it here covers the whole sheet. */
    pointer-events: none;
  }
  .mci-{{ section.id }}-sheet.is-open { transform: translateY(0); pointer-events: auto; }
  .mci-{{ section.id }}-sheet.is-dragging { transition: none; }

  @media (min-width: 768px) {
    .mci-{{ section.id }}-sheet {
      left: 50%;
      right: auto;
      bottom: 50%;
      transform: translate(-50%, calc(50% + 40px));
      width: min(440px, 92vw);
      max-height: 80vh;
      border-radius: 16px;
      opacity: 0;
    }
    .mci-{{ section.id }}-sheet.is-open {
      transform: translate(-50%, 50%);
      opacity: 1;
    }
    .mci-{{ section.id }}-sheet-handle-wrap { display: none; }
  }

  .mci-{{ section.id }}-sheet-handle-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0 4px;
    flex-shrink: 0;
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .mci-{{ section.id }}-sheet-handle-wrap:active { cursor: grabbing; }
  .mci-{{ section.id }}-sheet-handle {
    width: 40px;
    height: 4px;
    background: rgba(0, 0, 0, 0.22);
    border-radius: 999px;
    pointer-events: none;
  }

  .mci-{{ section.id }}-sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px 14px;
    border-bottom: 1px solid var(--mci-border);
    flex-shrink: 0;
  }
  .mci-{{ section.id }}-sheet-title {
    font-size: 17px;
    font-weight: 600;
    margin: 0;
    color: var(--mci-text);
    font-family: inherit;
    line-height: 1.2;
  }
  .mci-{{ section.id }}-sheet-close {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    color: var(--mci-text);
    transition: background 0.15s ease;
  }
  .mci-{{ section.id }}-sheet-close:hover,
  .mci-{{ section.id }}-sheet-close:active { background: var(--mci-row-hover); }
  .mci-{{ section.id }}-sheet-close svg { width: 20px; height: 20px; stroke: currentColor; }

  .mci-{{ section.id }}-sheet-list {
    list-style: none;
    margin: 0;
    padding: 6px 0 20px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    flex: 1 1 auto;
  }
  .mci-{{ section.id }}-sheet-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 15px 20px;
    background: transparent;
    border: 0;
    text-align: left;
    font-size: 16px;
    font-weight: 400;
    color: var(--mci-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.12s ease;
    text-decoration: none;
    font-family: inherit;
    line-height: 1.3;
  }
  .mci-{{ section.id }}-sheet-option:hover,
  .mci-{{ section.id }}-sheet-option:active { background: var(--mci-row-hover); }
  .mci-{{ section.id }}-sheet-option.is-active {
    font-weight: 600;
    color: var(--mci-active);
  }
  .mci-{{ section.id }}-sheet-option.is-active::after {
    content: '';
    display: inline-block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    color: var(--mci-active);
  }

  body.mci-{{ section.id }}-locked { overflow: hidden !important; touch-action: none; }
{% comment %}{% endcomment %}</style>

{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign sort_options = collection.sort_options

  assign current_label = ''
  for opt in sort_options
    if opt.value == current_sort
      assign current_label = opt.name
      break
    endif
  endfor
  if current_label == blank
    assign current_label = sort_options.first.name
    assign current_sort = sort_options.first.value
  endif
-%}

<div class="mci-{{ section.id }}-mobile-row">
  {%- if section.settings.enable_filtering -%}
    <button type="button" class="mci-{{ section.id }}-trigger" data-mci-open="filter" aria-haspopup="dialog" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"/>
        <line x1="7" y1="12" x2="17" y2="12"/>
        <line x1="10" y1="18" x2="14" y2="18"/>
      </svg>
      <span style="font-weight: 600;">Filter</span>
    </button>
  {%- endif -%}
  {%- if section.settings.sorting -%}
    <button type="button" class="mci-{{ section.id }}-trigger" data-mci-open="sort" aria-haspopup="dialog" aria-expanded="false">
      <span class="mci-{{ section.id }}-trigger-label">Sort:</span>
      <span class="mci-{{ section.id }}-trigger-value" data-mci-current-sort-label>{{ current_label }}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  {%- endif -%}
</div>

{%- if section.settings.sorting -%}
<template id="mci-{{ section.id }}-sort-template">
  <div class="mci-{{ section.id }}-backdrop" data-mci-backdrop="sort" aria-hidden="true"></div>
  <div class="mci-{{ section.id }}-sheet" data-mci-sheet="sort" role="dialog" aria-modal="true" aria-labelledby="mci-{{ section.id }}-sort-title">
    <div class="mci-{{ section.id }}-sheet-handle-wrap" data-mci-drag-handle>
      <div class="mci-{{ section.id }}-sheet-handle" aria-hidden="true"></div>
    </div>
    <div class="mci-{{ section.id }}-sheet-header">
      <h3 class="mci-{{ section.id }}-sheet-title" id="mci-{{ section.id }}-sort-title">Sort by</h3>
      <button type="button" class="mci-{{ section.id }}-sheet-close" data-mci-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <ul class="mci-{{ section.id }}-sheet-list" role="listbox">
      {%- for opt in sort_options -%}
        <li role="presentation">
          <a href="{{ collection.url }}?sort_by={{ opt.value }}"
             class="mci-{{ section.id }}-sheet-option{% if opt.value == current_sort %} is-active{% endif %}"
             role="option"
             aria-selected="{% if opt.value == current_sort %}true{% else %}false{% endif %}"
             data-sort-value="{{ opt.value }}">
            <span>{{ opt.name }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{% comment %}{% endcomment %}</template>
{%- endif -%}

{%- if section.settings.enable_filtering -%}
<template id="mci-{{ section.id }}-filter-template">
  <div class="mci-{{ section.id }}-backdrop" data-mci-backdrop="filter" aria-hidden="true"></div>
  <div class="mci-{{ section.id }}-sheet" data-mci-sheet="filter" role="dialog" aria-modal="true" aria-labelledby="mci-{{ section.id }}-filter-title" style="max-height: 92vh;">
    <div class="mci-{{ section.id }}-sheet-handle-wrap" data-mci-drag-handle>
      <div class="mci-{{ section.id }}-sheet-handle" aria-hidden="true"></div>
    </div>
    <div class="mci-{{ section.id }}-sheet-header">
      <h3 class="mci-{{ section.id }}-sheet-title" id="mci-{{ section.id }}-filter-title">Filters</h3>
      <button type="button" class="mci-{{ section.id }}-sheet-close" data-mci-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="mci-{{ section.id }}-sheet-list" data-mci-filter-host style="padding: 16px 20px 32px;"></div>
  </div>
{% comment %}{% endcomment %}</template>
{%- endif -%}

<script>
(function(){
  var SID = {{ section.id | json }};
  var section = document.getElementById('shopify-section-' + SID);
  if (!section) return;

  var prefix = 'mci-' + SID;

  function hideThemeDuplicates(){
    if (window.matchMedia('(min-width: 768px)').matches) return;
    var ours = section.querySelectorAll('.mci-' + SID + '-trigger, .mci-' + SID + '-mobile-row');
    var oursSet = new Set();
    ours.forEach(function(el){
      var n = el;
      while (n && n !== document) { oursSet.add(n); n = n.parentElement; }
    });
    var candidates = section.querySelectorAll(
      'button, a[role="button"], summary, [role="button"], ' +
      '.btn, .button, [data-toggle], [data-open], [data-drawer-trigger], ' +
      'details:not([data-mci-sheet]), .collection-toolbar *, .toolbar *'
    );
    candidates.forEach(function(el){
      if (oursSet.has(el)) return;
      if (el.classList.contains('mci-hide-duplicate')) return;
      if (el.closest('.mci-' + SID + '-mobile-row')) return;
      if (el.closest('[data-mci-sheet]')) return;
      if (el.closest('[data-mci-backdrop]')) return;
      var txt = (el.textContent || '').trim().toLowerCase().replace(/\s+/g, ' ');
      var aria = (el.getAttribute('aria-label') || '').toLowerCase();
      var matchTxt =
        /^filter\b/.test(txt) || /^sort\b/.test(txt) || /^sort by\b/.test(txt) ||
        txt === 'filter' || txt === 'sort' || txt === 'sort by' || txt === 'sort by:' ||
        /^filter\b/.test(aria) || /^sort\b/.test(aria);
      if (matchTxt && txt.length < 40) {
        var wrapper = el.closest('.collection-toolbar > *, .toolbar > *, [class*="filter-by"], [class*="sort-by"], [class*="mobile-filter"], [class*="mobile-sort"]') || el;
        wrapper.classList.add('mci-hide-duplicate');
      }
    });
    var mobileWrappers = section.querySelectorAll(
      '.toolbar-mobile, .collection-toolbar__mobile, .mobile-toolbar, ' +
      '[class*="filter-by-mobile"], [class*="sort-by-mobile"], ' +
      '[class*="mobile-filter"], [class*="mobile-sort"]'
    );
    mobileWrappers.forEach(function(w){
      if (!w.closest('.mci-' + SID + '-mobile-row')) w.classList.add('mci-hide-duplicate');
    });
  }
  hideThemeDuplicates();
  window.addEventListener('resize', hideThemeDuplicates);
  document.addEventListener('shopify:section:load', function(e){
    if (e.detail && e.detail.sectionId === SID) hideThemeDuplicates();
  });
  var mo = new MutationObserver(function(){ hideThemeDuplicates(); });
  mo.observe(section, { childList: true, subtree: true });

  function portal(tplId) {
    var tpl = document.getElementById(tplId);
    if (!tpl) return;
    var frag = tpl.content.cloneNode(true);
    while (frag.firstChild) document.body.appendChild(frag.firstChild);
    tpl.remove();
  }
  portal(prefix + '-sort-template');
  portal(prefix + '-filter-template');

  function $sheet(kind){ return document.querySelector('[data-mci-sheet="' + kind + '"]'); }
  function $backdrop(kind){ return document.querySelector('[data-mci-backdrop="' + kind + '"]'); }

  function pushSchemeVars(){
    var cs = getComputedStyle(section);
    ['--mci-bg','--mci-text','--mci-text-soft','--mci-border','--mci-active','--mci-row-hover'].forEach(function(k){
      var v = cs.getPropertyValue(k);
      if (v) document.body.style.setProperty(k, v);
    });
  }
  pushSchemeVars();

  function open(kind){
    var sheet = $sheet(kind), bd = $backdrop(kind);
    if (!sheet || !bd) return;
    ['sort','filter'].forEach(function(k){ if (k !== kind) close(k, true); });
    document.body.classList.add(prefix + '-locked');
    pushSchemeVars();
    if (kind === 'filter') hydrateFilters();
    bd.classList.add('is-open');
    bd.setAttribute('aria-hidden','false');
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ sheet.classList.add('is-open'); });
    });
    var trig = section.querySelector('[data-mci-open="' + kind + '"]');
    if (trig) trig.setAttribute('aria-expanded','true');
  }
  function close(kind, silent){
    var sheet = $sheet(kind), bd = $backdrop(kind);
    if (!sheet || !bd) return;
    sheet.classList.remove('is-open');
    sheet.classList.remove('is-dragging');
    sheet.style.transform = '';
    bd.classList.remove('is-open');
    bd.classList.remove('is-dragging');
    bd.style.opacity = '';
    bd.setAttribute('aria-hidden','true');
    var stillOpen = document.querySelector('[data-mci-sheet].is-open');
    if (!stillOpen) document.body.classList.remove(prefix + '-locked');
    var trig = section.querySelector('[data-mci-open="' + kind + '"]');
    if (trig) trig.setAttribute('aria-expanded','false');
  }

  document.addEventListener('click', function(e){
    var t = e.target.closest('[data-mci-open]');
    if (t && section.contains(t)) {
      e.preventDefault();
      open(t.getAttribute('data-mci-open'));
      return;
    }
    var bd = e.target.closest('[data-mci-backdrop]');
    if (bd) { close(bd.getAttribute('data-mci-backdrop')); return; }
    var x = e.target.closest('[data-mci-close]');
    if (x) {
      var s = x.closest('[data-mci-sheet]');
      if (s) close(s.getAttribute('data-mci-sheet'));
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') {
      var o = document.querySelector('[data-mci-sheet].is-open');
      if (o) close(o.getAttribute('data-mci-sheet'));
    }
  });

  function isMobile(){ return window.matchMedia('(max-width: 767.98px)').matches; }

  function setupDrag(kind){
    var sheet = $sheet(kind), bd = $backdrop(kind);
    if (!sheet || !bd) return;
    var handleWrap = sheet.querySelector('[data-mci-drag-handle]');
    if (!handleWrap) return;
    var dragging = false, startY = 0, startX = 0, lastY = 0;
    var samples = [], sheetHeight = 0, pointerId = null;
    function onDown(e){
      if (!isMobile()) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true;
      pointerId = e.pointerId;
      startY = e.clientY; startX = e.clientX; lastY = e.clientY;
      samples = [{ y: e.clientY, t: performance.now() }];
      sheetHeight = sheet.getBoundingClientRect().height;
      sheet.classList.add('is-dragging');
      bd.classList.add('is-dragging');
      try { handleWrap.setPointerCapture(e.pointerId); } catch (err) {}
      e.preventDefault();
    }
    function onMove(e){
      if (!dragging || e.pointerId !== pointerId) return;
      var dy = e.clientY - startY;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > Math.abs(dy) * 1.5 && Math.abs(dy) < 8) return;
      if (dy < 0) dy = dy * 0.25;
      sheet.style.transform = 'translateY(' + dy + 'px)';
      var prog = Math.min(1, Math.max(0, dy / sheetHeight));
      bd.style.opacity = String(1 - prog * 0.85);
      lastY = e.clientY;
      var now = performance.now();
      samples.push({ y: e.clientY, t: now });
      if (samples.length > 5) samples.shift();
      e.preventDefault();
    }
    function onUp(e){
      if (!dragging || e.pointerId !== pointerId) return;
      dragging = false;
      try { handleWrap.releasePointerCapture(e.pointerId); } catch (err) {}
      var v = 0;
      if (samples.length >= 2) {
        var a = samples[0], b = samples[samples.length - 1];
        var dt = b.t - a.t;
        if (dt > 0) v = (b.y - a.y) / dt;
      }
      var dy = lastY - startY;
      var threshold = sheetHeight * 0.4;
      var flickDown = v > 0.6;
      sheet.classList.remove('is-dragging');
      bd.classList.remove('is-dragging');
      if (dy > threshold || flickDown) {
        sheet.style.transform = 'translateY(100%)';
        bd.style.opacity = '0';
        setTimeout(function(){ close(kind); }, 280);
      } else {
        sheet.style.transform = '';
        bd.style.opacity = '';
      }
    }
    function onCancel(){
      if (!dragging) return;
      dragging = false;
      sheet.classList.remove('is-dragging');
      bd.classList.remove('is-dragging');
      sheet.style.transform = '';
      bd.style.opacity = '';
    }
    handleWrap.addEventListener('pointerdown', onDown);
    handleWrap.addEventListener('pointermove', onMove);
    handleWrap.addEventListener('pointerup', onUp);
    handleWrap.addEventListener('pointercancel', onCancel);
  }
  setupDrag('sort');
  setupDrag('filter');

  var filterHydrated = false;
  function hydrateFilters(){
    if (filterHydrated) return;
    var host = document.querySelector('[data-mci-filter-host]');
    if (!host) return;
    var src = section.querySelector(
      'facet-filters-form, ' +
      '.collection-sidebar:not(.horizontal):not([data-mci-sheet]) form, ' +
      'form#FacetFiltersForm, ' +
      'form.facet-filters-form, ' +
      '.collection-sidebar:not([data-mci-sheet]) form, ' +
      '.filter-vertical form, ' +
      '#facets-wrapper form, ' +
      '.collection-filter form'
    );
    if (!src) {
      src = section.querySelector('.collection-sidebar:not(.horizontal):not([data-mci-sheet]), .filter-vertical, #facets-wrapper');
    }
    if (src) {
      var clone = src.cloneNode(true);
      clone.style.maxWidth = '100%';
      clone.style.width = '100%';
      clone.style.flex = 'unset';
      clone.style.position = 'static';
      host.appendChild(clone);
      filterHydrated = true;
    } else {
      host.innerHTML = '<p style="text-align:center;padding:40px 20px;color:var(--mci-text-soft, #666);">No filters available.</p>';
      filterHydrated = true;
    }
  }
})();
{% comment %}{% endcomment %}</script>

{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'collection-page.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable ContentForHeaderModification %}
{%- capture content_for_query_string -%}
  {{ content_for_header }}
{%- endcapture -%}
{% # theme-check-enable ContentForHeaderModification %}

{%- assign page_url = content_for_query_string
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: request.host
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}
{%- assign page_query_string = page_url | split: '?' | last -%}
{%- liquid
  assign section_st = section.settings
  assign section_block = section.blocks
  assign section_width = section_st.section_width
  assign enable_filtering = section_st.enable_filtering
  assign vertical_posion = section_st.vertical_posion
  assign filter_layout = section_st.filter_layout
  assign number_products = section_st.items_to_show
  assign default_filter = section_st.default_filter
  assign products_column = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign pagination = section_st.pagination
  assign column = section_st.items_per_row
  assign view = 'grid'
  if page_query_string contains 'view='
    assign view = page_query_string | split: 'view=' | last | split: '&' | first
  endif
  assign scroll_animation = settings.scroll_animation
  if section.blocks.size < 1
    assign enable_filtering = false
  else
    assign column = products_column | plus: 1
  endif
-%}
{%- capture style_padding -%}
--section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- capture style -%}
{% if enable_filtering and filter_layout == 'vertical' %}--col-width: 27rem;--col-gap: 3rem;{% endif %} {% if enable_filtering and filter_layout == 'vertical' and section_width != 'default' %}--col-gap-desktop: 6rem;{% endif %}{% if enable_filtering and filter_layout == 'vertical' and section_width == 'default' %}--col-gap: 3rem;{% endif %}  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- assign collection_scheme_id = section_st.color_scheme.id | default: section_st.color_scheme -%}
{%- assign collection_scheme_class = '' -%}
{%- if collection_scheme_id != blank -%}
  {%- assign collection_scheme_class = ' color-' | append: collection_scheme_id | append: ' gradient' -%}
{%- endif -%}
<section
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-main {{ scroll_animation }} bls-image-js{{ collection_scheme_class }}"
  data-section-id="{{ section.id }}"
  style="{{ style_padding | strip | strip_newlines }}"
>
  {%- if enable_filtering and filter_layout == 'drawer' -%}
    {%- render 'collection-sidebar',
      section_st: section_st,
      section_block: section_block,
      filter_layout: filter_layout,
      default_filter: default_filter,
      collection_url: collection.url
    -%}
    {% endif %}
  <grid-list
    {% if scroll_animation != 'slide_in' %}
      hold
    {% endif %}
  >
    <div class="{{ section_width }}">
      <div
        class="{% if enable_filtering and filter_layout == 'vertical' %} flex flex-nowrap gap{% if vertical_posion == 'right' %} flex-row-reverse{% endif %}{% endif %}"
        {% if enable_filtering and filter_layout == 'vertical' %}
          style="{{ style | strip | strip_newlines }}"
        {% endif %}
      >
        {%- if enable_filtering and filter_layout == 'vertical' -%}
          {%- render 'collection-sidebar',
            section_st: section_st,
            section_block: section_block,
            default_filter: default_filter,
            filter_layout: filter_layout,
            collection_url: collection.url
          -%}
        {% endif %}
        <div
          id="productgridcontainer"
          class="w-full {% if enable_filtering and filter_layout == 'vertical' %}col-1025-remaining{% endif %}"
        >
          {% if enable_filtering and filter_layout == 'vertical' %}<div class="sticky-1025 top-30">{% endif %}
          {%- if enable_filtering and filter_layout == 'horizontal' -%}
            {%- render 'collection-sidebar',
              section_st: section_st,
              section_block: section_block,
              filter_layout: filter_layout,
              default_filter: default_filter,
              collection_url: collection.url
            -%}
          {% endif %}
          {%- render 'collection-toolbar',
            section_st: section_st,
            pageurl: view,
            enable_filtering: enable_filtering,
            filter_layout: filter_layout,
            products_column: products_column
          -%}
          {%- if enable_filtering and filter_layout -%}
            {%- render 'filter-current', class: 'mb-30' -%}
          {% endif %}

          <div
            class="product-grid-container relative"
          >
            {%- paginate collection.products by number_products -%}
              {%- if collection.products.size == 0 -%}
                <div
                  class="collection collection--empty page-width"
                  id="product-grid"
                  data-id="{{ section.id }}"
                >
                  <div class="empty-state-card">
                    <div class="empty-state-card__icon" aria-hidden="true">
                      <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
                        <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <path d="M8 11h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <p class="empty-state-card__title">
                      {{ 'sections.collection_template.empty' | t }}
                    </p>
                    <p class="empty-state-card__body">
                      {{
                        'sections.collection_template.use_fewer_filters_html'
                        | t: link: collection.url, class: 'empty-state-card__link'
                      }}
                    </p>
                  </div>
                </div>
              {%- else -%}
                <div
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="{% if view == 'list' %}list product-type-list flex flex-column {% else %}grid grid-cols row-gap-custom product-grid grid-columns-{{ products_column }} {% endif %}gap container-products-switch{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
                  {% if view == 'list' %}
                    style="--gap: 3rem;"
                  {% else %}
                    style="{% if section_st.column_gap < 31 %}--row-gap: 3rem;{% else %}--row-gap: {{  section_st.column_gap }};{% endif %}--col-desktop: {{ products_column }};--col-tablet: 3;--col-desktop-small: 3;--col-number: {{ items_per_row_mobile }};{% if section_st.column_gap < 15 %}--col-gap: {{ section_st.column_gap }}px;--col-gap-desktop: {{  section_st.column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  section_st.column_gap }}px;{% endif %};"
                  {% endif %}
                  data-view-mode="{{ products_column }}"
                >
                  {%- for product in collection.products -%}
                    <div
                      class="grid__item{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-item{% endif %}"
                    >
                      {%- if view == 'list' -%}
                        {% render 'product-item',
                          scroll_animation: scroll_animation,
                          card_product: product,
                          section_id: section.id,
                          template_enable_action: true,
                          template_enable_price: true,
                          template_enable_product_vendor: true,
                          template_enable_rate: true,
                          template_enable_add_cart: true,
                          template_enable_product_short_description: true,
                          enable_short_description: true,
                          template_enable_color_swatches: true,
                          template_enable_product_badges: true,
                          type: 'list',
                          indexFor: forloop.index,
                          type_collections: 'true',
                          container: section_width,
                          colunm: column,
                          colunm_mobile: section_st.items_per_row_mobile,
                          padding: section_st.column_gap,
                          collection_product: true
                        %}
                      {%- else -%}
                        {% render 'product-item',
                          scroll_animation: scroll_animation,
                          card_product: product,
                          section_id: section.id,
                          template_enable_action: true,
                          template_enable_price: true,
                          template_enable_product_vendor: true,
                          template_enable_rate: true,
                          template_enable_add_cart: true,
                          template_enable_color_swatches: true,
                          template_enable_product_badges: true,
                          template_enable_product_short_description: true,
                          type: 'grid',
                          type_collections: 'true',
                          indexFor: forloop.index,
                          container: section_width,
                          colunm: column,
                          colunm_mobile: section_st.items_per_row_mobile,
                          padding: section_st.column_gap,
                          collection_product: true
                        %}
                      {% endif %}
                    </div>
                  {%- endfor -%}
                </div>
                {%- if paginate.pages > 1 -%}
                  {% render 'pagination',
                    paginate: paginate,
                    section_st: section_st,
                    pagination: pagination,
                    number_page: number_products,
                    paginate: paginate
                  %}
                {% endif %}
              {% endif %}
            {%- endpaginate -%}
            <div
              class="loading-overlay absolute inset-0 invisible transition pointer-none z-2 gradient color-default"
            ></div>
          </div>

          {% if enable_filtering and filter_layout == 'vertical' %}</div>{% endif %}
        </div>
      </div>
    </div>
  </grid-list>
</section>



</template>

<schema>
{
  "type": "main-collection-product",
  "name": "Main collection product",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Pick a color scheme to apply to the entire collection grid + filters + pagination.",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "default": "fluid_container",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Product grid"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between products",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Page numbers"
        },
        {
          "value": "load_more_button",
          "label": "Load-more button"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load-more button label",
      "default": "Show more"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "label": "Show product counts next to each filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "default": "vertical",
      "label": "Filter layout (desktop)",
      "info": "On mobile the drawer layout is always used.",
      "options": [
        {
          "value": "vertical",
          "label": "Sidebar (vertical, beside products)"
        },
        {
          "value": "horizontal",
          "label": "Dropdowns above products"
        },
        {
          "value": "drawer",
          "label": "Drawer (opens on click)"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_posion",
      "default": "left",
      "label": "Sidebar position (vertical layout only)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "default_filter",
      "default": "open_all",
      "label": "Default filter state",
      "info": "Controls whether the filter panels start expanded or collapsed.",
      "options": [
        {
          "value": "open_all",
          "label": "All filters open"
        },
        {
          "value": "close_all",
          "label": "All filters closed"
        },
        {
          "value": "first_open",
          "label": "Only first filter open"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Toolbar"
    },
    {
      "type": "checkbox",
      "id": "number_products_per_page",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sorting",
      "label": "Show Sort-by dropdown",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "items_per_row_mobile",
      "label": "Products per row (mobile)",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "categories",
      "name": "Categories",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ],
      "limit": 1
    },
    {
      "type": "filter",
      "name": "Filter",
