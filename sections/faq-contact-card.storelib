  "presets": [
    {
      "name": "FAQ With Contact Card",
      "category": "FAQ",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I place an order?",
            "answer": "<p>Add what you want to your cart and go to checkout. You get an email as soon as the order is placed.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Delivery options and times are shown at checkout. A tracking link follows by email once the order leaves.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I return an item?",
            "answer": "<p>Yes. The returns page explains the steps and how long you have to send something back.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Which payment methods can I use?",
            "answer": "<p>The payment methods you can use are listed at checkout, before you pay.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I contact you?",
            "answer": "<p>Use the contact page or reply to your order email and we will get back to you.</p>"
          }
        },
        {
          "type": "card_text"
        },
        {
          "type": "button",
          "settings": {
            "label": "Contact us",
            "link": "/pages/contact"
          }
        },
        {
          "type": "contact_line",
          "settings": {
            "label": "Email",
            "text": "Add your support email"
          }
        },
        {
          "type": "contact_line",
          "settings": {
            "label": "Phone",
            "text": "Add your phone number"
          }
        },
        {
          "type": "contact_line",
          "settings": {
            "label": "Hours",
            "text": "Add the days and hours you answer"
          }
        }
      ]
    }
  ],
