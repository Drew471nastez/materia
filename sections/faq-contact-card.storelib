            "label": "Heading",
            "default": "Did not find your answer?"
          },
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Send us a message and we will help you with your order.</p>"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Contact us"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              },
              {
                "value": "text",
                "label": "Link"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width",
            "default": true
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: colours follow Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_color_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "select",
            "id": "size",
            "label": "Size",
            "default": "medium",
            "options": [
              {
                "value": "small",
                "label": "Small"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "large",
                "label": "Large"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      },
      {
        "type": "contact_line",
        "name": "Contact line",
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Email"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Add your support email"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Optional. Left empty, an email address or a phone number in Text becomes a link by itself."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ With Contact Card",
        "category": "FAQ",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How do I place an order?",
              "answer": "<p>Add what you want to your cart and go to checkout. You get an email as soon as the order is placed.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "When will my order ship?",
              "answer": "<p>Delivery options and times are shown at checkout. A tracking link follows by email once the order leaves.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Can I return an item?",
              "answer": "<p>Yes. The returns page explains the steps and how long you have to send something back.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Which payment methods can I use?",
              "answer": "<p>The payment methods you can use are listed at checkout, before you pay.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How do I contact you?",
              "answer": "<p>Use the contact page or reply to your order email and we will get back to you.</p>"
            }
          },
          {
            "type": "card_text"
          },
          {
            "type": "button",
            "settings": {
              "label": "Contact us",
              "link": "/pages/contact"
            }
          },
          {
            "type": "contact_line",
            "settings": {
              "label": "Email",
              "text": "Add your support email"
            }
          },
          {
            "type": "contact_line",
            "settings": {
              "label": "Phone",
              "text": "Add your phone number"
            }
          },
          {
            "type": "contact_line",
            "settings": {
              "label": "Hours",
              "text": "Add the days and hours you answer"
            }
          }
        ]
      }
    ]
  }
}
</schema>
