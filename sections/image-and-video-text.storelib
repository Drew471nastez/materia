<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image & Video with Text

  Two-column layout with media (image, uploaded Shopify video, or
  external video URL) on one side and reorderable text/button blocks
  on the other.

  Custom font selector lets the section override the body / heading
  fonts theme-wide for this section's text.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.image_position
    when 'right'
      assign _flex_dir_d = 'row-reverse'
    else
      assign _flex_dir_d = 'row'
  endcase
  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase

  assign body_font = st.body_font
  assign heading_font = st.heading_font
-%}

<style>
  /* Section base */
  #shopify-section-{{ sid }} .ivt {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %};
  }
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* Custom fonts (override theme defaults inside this section only) */
  {%- if st.enable_custom_fonts and body_font -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} :is(p, div, span, a, li, button, input, textarea) {
      font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
      font-style: {{ body_font.style }};
      font-weight: {{ body_font.weight }};
    }
  {%- endif -%}
  {%- if st.enable_custom_fonts and heading_font -%}
    #shopify-section-{{ sid }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-style: {{ heading_font.style }};
      font-weight: {{ heading_font.weight }};
    }
  {%- endif -%}

  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .ivt__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .ivt__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .ivt__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  /* Outer wrap */
  #shopify-section-{{ sid }} .ivt {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ivt {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .ivt__inner { width: 100%; box-sizing: border-box; }

  /* Grid */
  #shopify-section-{{ sid }} .ivt__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 32 }}px;
    align-items: stretch;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .ivt__grid {
      flex-direction: {{ _flex_dir_d }};
      gap: {{ st.gap_desktop | default: 64 }}px;
      align-items: center;
    }
  }
  #shopify-section-{{ sid }} .ivt__media,
  #shopify-section-{{ sid }} .ivt__text {
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .ivt__text  { width: {{ st.text_column_width | default: 50 }}%; }
    #shopify-section-{{ sid }} .ivt__media { width: calc(100% - {{ st.text_column_width | default: 50 }}%); }
  }

  /* Media */
  #shopify-section-{{ sid }} .ivt__media {
    border-radius: {{ st.image_radius | default: 12 }}px;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
    aspect-ratio: {{ st.aspect_w | default: 4 }} / {{ st.aspect_h | default: 5 }};
  }
  #shopify-section-{{ sid }} .ivt__media img,
  #shopify-section-{{ sid }} .ivt__media video,
  #shopify-section-{{ sid }} .ivt__media .video-wrapper,
  #shopify-section-{{ sid }} .ivt__media .video-wrapper > * {
    width: 100%;
    height: 100%;
    object-fit: {{ st.image_fit | default: 'cover' }};
    display: block;
  }
  {%- if st.enable_overlay -%}
    #shopify-section-{{ sid }} .ivt__media { position: relative; }
    #shopify-section-{{ sid }} .ivt__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %};
      opacity: {{ st.overlay_opacity | default: 30 | divided_by: 100.0 }};
      pointer-events: none;
    }
  {%- endif -%}

  /* Text */
  #shopify-section-{{ sid }} .ivt__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 16 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .ivt__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .ivt__text > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .ivt__eyebrow {
    font-size: 12px;
    font-weight: var(--subheading-weight, 700);
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .ivt__heading {
    font-weight: var(--heading-weight, 700);
    line-height: var(--heading-line-height, 1.1);
    letter-spacing: var(--heading-letter-spacing, -0.01em);
  }
  #shopify-section-{{ sid }} .ivt__subheading {
    line-height: 1.6;
    max-width: 560px;
  }
  #shopify-section-{{ sid }} .ivt__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .ivt__subheading p:last-child { margin: 0; }

  /* Per-block style overrides */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'eyebrow' -%}
      #shopify-section-{{ sid }} .ivt__eyebrow[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size | default: 12 }}px;
      }
    {%- endif -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .ivt__heading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
        font-size: {{ bs.size_mobile | default: 32 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .ivt__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 44 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .ivt__subheading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size_mobile | default: 15 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .ivt__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 17 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'button' -%}
      #shopify-section-{{ sid }} .ivt__btn[data-block-id="{{ block.id }}"] {
        display: {% if bs.full_width %}flex{% else %}inline-flex{% endif %};
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        line-height: 1;
        background-color: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %};
        --mb-bg: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %};
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %};
        --mb-text: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %};
        border-style: solid;
        border-color: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
        --mb-border: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
        {%- if bs.use_theme_button -%}
        border-width: var(--btn-border-width, 1px);
        padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
        border-radius: var(--btn-radius, 8px);
        font-size: var(--btn-font-size, 14px);
        font-weight: var(--btn-font-weight, 600);
        {%- else -%}
        border-width: {{ bs.border_width | default: 0 }}px;
        padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 26 }}px;
        border-radius: {{ bs.radius | default: 8 }}px;
        font-size: {{ bs.font_size | default: 14 }}px;
        font-weight: {{ bs.font_weight | default: '600' }};
        {%- endif -%}
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
        width: {% if bs.full_width %}100%{% else %}auto{% endif %};
        max-width: {% if bs.full_width %}100%{% else %}max-content{% endif %};
        transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;
      }
      #shopify-section-{{ sid }} .ivt__btn[data-block-id="{{ block.id }}"]:hover,
      #shopify-section-{{ sid }} .ivt__btn[data-block-id="{{ block.id }}"]:focus-visible {
        background-color: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
        --mb-hover-bg: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
        color: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %};
        --mb-hover-text: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %};
        border-color: {% render 'scheme-color', color: bs.border_color_hover, fallback: 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))' %};
        --mb-hover-border: {% render 'scheme-color', color: bs.border_color_hover, fallback: 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))' %};
        transform: translateY(-1px);
      }
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="ivt-{{ sid }}" class="ivt section sec__image-video-text color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="ivt__inner">
    <div class="ivt__grid">

      <div class="ivt__media">
        {%- assign demo_src = '' -%}
        {%- if st.image == blank and st.video == blank and st.video_url == blank -%}
          {%- capture demo_src -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_src = demo_src | strip -%}
        {%- endif -%}
        {%- if st.media_type == 'video' and st.video != blank -%}
          {{ st.video | video_tag: autoplay: true, muted: true, playsinline: true, loop: true, controls: false, image_size: '1400x' }}
        {%- elsif st.media_type == 'video' and st.video_url != blank -%}
          <video src="{{ st.video_url }}" autoplay muted loop playsinline></video>
        {%- elsif st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1400 }}"
            srcset="{{ st.image | image_url: width: 600 }} 600w,
                    {{ st.image | image_url: width: 900 }} 900w,
                    {{ st.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ st.image.alt | default: fb_accessibility_image | escape }}"
            loading="lazy"
          >
        {%- elsif demo_src != blank -%}
          {%- if st.media_type == 'video' or st.media_type == 'video_url' -%}
            <video src="{{ demo_src }}" autoplay muted loop playsinline></video>
          {%- else -%}
            <img src="{{ demo_src }}" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
          {%- endif -%}
        {%- else -%}
          <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
        {%- endif -%}
      </div>

      <div class="ivt__text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="ivt__eyebrow" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} class="ivt__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="ivt__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if bs.label != blank -%}
                <a class="ivt__btn" data-theme-button="primary" data-sl-button data-block-id="{{ block.id }}" href="{{ bs.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-and-video-text",
  "name": "Image & Video with Text",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (alternate)",
      "info": "Direct .mp4 link"
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Aspect ratio — width",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "aspect_h",
      "label": "Aspect ratio — height",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable color overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Custom fonts (optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "id": "hdr_28",
