<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image & Video with Text.

  Media (an image, an uploaded video or a video address) on one side and
  reorderable eyebrow, heading, text and button blocks on the other.
  Colours follow the colour scheme and fonts follow Theme settings >
  Typography until custom styling or custom fonts are switched on.
  Layout lives in snippets/media-benefits-style; the builder's live edits
  in assets/media-live-benefits.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign media_type = st.media_type | default: 'image'
-%}
{% render 'media-benefits-style', section: section, bp: 900 %}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .ivt[data-overlay='true'] .ivt__media::after { content: ''; position: absolute; inset: 0; background: var(--ivt-ov); opacity: calc(var(--ivt-ov-op) / 100); pointer-events: none; }
{% comment %}{% endcomment %}</style>

<div id="ivt-{{ sid }}" class="ivt mlb section sec__image-video-text color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-mlb-root="image-and-video-text" {% render 'media-benefits-root', section: section, part: 'attrs', side: st.image_position, align: st.content_align, align_m: st.content_align_mobile %} data-mlb-fallback-href="{{ routes.all_products_collection_url }}" data-overlay="{% if st.enable_overlay %}true{% else %}false{% endif %}" data-mlb-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;container&quot;,&quot;reset_spacing&quot;:true,&quot;image_position&quot;:&quot;left&quot;,&quot;text_column_width&quot;:50,&quot;content_align&quot;:&quot;left&quot;,&quot;content_gap&quot;:16,&quot;media_type&quot;:&quot;image&quot;,&quot;video_autoplay&quot;:true,&quot;video_loop&quot;:true,&quot;video_controls&quot;:false,&quot;aspect_w&quot;:5,&quot;aspect_h&quot;:5,&quot;image_fit&quot;:&quot;cover&quot;,&quot;image_radius&quot;:12,&quot;enable_overlay&quot;:false,&quot;overlay_opacity&quot;:30,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;gap_desktop&quot;:64,&quot;padding_top_desktop&quot;:100,&quot;padding_bottom_desktop&quot;:100,&quot;side_padding_desktop&quot;:32,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;content_align_mobile&quot;:&quot;left&quot;,&quot;mobile_order&quot;:&quot;media_first&quot;,&quot;gap_mobile&quot;:32,&quot;padding_top_mobile&quot;:60,&quot;padding_bottom_mobile&quot;:60,&quot;side_padding_mobile&quot;:20,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0&#125;" data-mlb-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;New collection&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:12&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Image &amp; Video with Text&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:44,&quot;size_mobile&quot;:32&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Pair text with media to highlight a feature, tell a story, or showcase a product detail.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:17,&quot;size_mobile&quot;:15&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;Shop now&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;&#125;" style="{% render 'media-benefits-root', section: section, part: 'vars', tw: st.text_column_width, gap_d: st.gap_desktop, gap_m: st.gap_mobile %}--m-ar: {{ st.aspect_w | default: 4 }} / {{ st.aspect_h | default: 5 }};--m-r: {{ st.image_radius | default: 0 }}px;--m-fit: {{ st.image_fit | default: 'cover' }};--ivt-ov: {% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %};--ivt-ov-op: {{ st.overlay_opacity | default: 30 }};">
  <div class="ivt__inner mlb__inner">
    <div class="ivt__grid mlb__grid">

      <div class="ivt__media mlb__media mlb__frame" data-mlb-media data-autoplay="{% if media_type == 'video' and st.video_autoplay %}true{% else %}false{% endif %}">
        {%- assign demo_src = '' -%}
        {%- if st.image == blank and st.video == blank and st.video_url == blank -%}
          {%- capture demo_src -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_src = demo_src | strip -%}
        {%- endif -%}
        {%- if media_type == 'video' and st.video != blank -%}
          {{ st.video | video_tag: autoplay: st.video_autoplay, muted: true, playsinline: true, loop: st.video_loop, controls: st.video_controls, image_size: '1400x' }}
        {%- elsif media_type == 'video' and st.video_url != blank -%}
          <video src="{{ st.video_url }}" {% if st.video_autoplay %}autoplay {% endif %}muted {% if st.video_loop %}loop {% endif %}{% if st.video_controls %}controls {% endif %}playsinline preload="metadata"></video>
        {%- elsif st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1400 }}"
            srcset="{{ st.image | image_url: width: 600 }} 600w,
                    {{ st.image | image_url: width: 900 }} 900w,
                    {{ st.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ st.image_alt | default: st.image.alt | escape }}"
            width="{{ st.image.width }}"
            height="{{ st.image.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- elsif demo_src != blank -%}
          {%- if media_type == 'video' -%}
            <video src="{{ demo_src }}" {% if st.video_autoplay %}autoplay {% endif %}muted {% if st.video_loop %}loop {% endif %}{% if st.video_controls %}controls {% endif %}playsinline preload="metadata"></video>
          {%- else -%}
            <img src="{{ demo_src }}" alt="" loading="lazy" decoding="async">
          {%- endif -%}
        {%- else -%}
          <svg class="mlb__ph" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g fill="currentColor"><circle cx="172" cy="124" r="14"/><path d="M140 192l40-46 25 28 20-18 35 36z"/></g></svg>
        {%- endif -%}
      </div>

      <div class="ivt__text mlb__text">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            {%- assign bs = block.settings -%}
            {%- capture btn_style -%}
              {%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
              {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius }}px;--mb-padding-y: {{ bs.padding_y }}px;--mb-padding-x: {{ bs.padding_x }}px;--mb-font-size: {{ bs.font_size }}px;--mb-weight: {{ bs.font_weight | default: 600 }};--btn-border-width: {{ bs.border_width }}px;{%- endif -%}
              {%- if bs.uppercase -%}--btn-text-transform: uppercase;{%- endif -%}
            {%- endcapture -%}
            {%- capture btn_attrs -%}class="ivt__btn mlb__btn" data-theme-button="{% if bs.button_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-full="{% if bs.full_width %}true{% else %}false{% endif %}" {% render 'media-benefits-block', block: block %}{% if bs.label == blank %} hidden{% endif %} style="{{ btn_style }}"{%- endcapture -%}
            {%- comment -%} A Shop button with no link of its own goes to the all products page. {%- endcomment -%}
            {%- if bs.link != blank or routes.all_products_collection_url != blank -%}
              <a href="{{ bs.link | default: routes.all_products_collection_url }}" {{ btn_attrs }}>{{ bs.label | escape }}</a>
            {%- else -%}
              <button type="button" {{ btn_attrs }}>{{ bs.label | escape }}</button>
            {%- endif -%}
          {%- else -%}
            {%- render 'media-benefits-text', block: block, p: 'ivt' -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "image-and-video-text",
  "name": "Image & Video with Text",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (alternate)",
      "info": "Direct .mp4 link"
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Aspect ratio — width",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "aspect_h",
      "label": "Aspect ratio — height",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable color overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Custom fonts (optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Section colors + spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New collection"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 9,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 12
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Image & Video with Text"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 22,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 44
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 18,
          "max": 56,
          "step": 1,
          "unit": "px",
          "default": 32
        }
      ],
      "limit": 2
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading",
          "default": "<p>Pair text with media to highlight a feature, tell a story, or showcase a product detail.</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 17
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 15
        }
      ],
      "limit": 2
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Default colors"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border color"
        },
        {
          "type": "header",
          "id": "hdr_7",
          "label": "Hover colors"
        },
        {
          "type": "color",
          "id": "bg_hover",
          "label": "Background on hover"
        },
        {
          "type": "color",
          "id": "color_hover",
          "label": "Text color on hover"
        },
        {
          "type": "color",
          "id": "border_color_hover",
          "label": "Border color on hover"
        },
        {
          "type": "header",
          "id": "hdr_11",
          "label": "Style"
        },
        {
          "type": "checkbox",
          "id": "use_theme_button",
          "label": "Use theme button style",
          "default": true
        },
        {
          "type": "range",
          "id": "padding_x",
          "label": "Horizontal padding",
          "min": 8,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 26,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "padding_y",
          "label": "Vertical padding",
          "min": 6,
          "max": 40,
          "step": 1,
          "unit": "px",
