<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* ── Section width ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Video 2
  Single video section. Video-only — no overlay text or button.
  Supports Shopify-uploaded video, external video URL, or poster image fallback.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
-%}

<style>
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} { background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}; }
  #shopify-section-{{ sid }} .vid2 {
    padding: {{ st.padding_top_mobile | default: 40 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .vid2 {
      padding: {{ st.padding_top_desktop | default: 60 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 60 }}px;
    }
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .vid2 { padding-left: 0; padding-right: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .vid2__inner {
    {%- unless st.full_bleed -%}
      max-width: var(--page-width, 1300px);
      margin-inline: auto;
    {%- endunless -%}
    width: 100%;
  }
  #shopify-section-{{ sid }} .vid2__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.aspect_w | default: 16 }} / {{ st.aspect_h | default: 9 }};
    border-radius: {{ st.radius | default: 16 }}px;
    overflow: hidden;
    background: #0F172A;
    isolation: isolate;
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .vid2__media { border-radius: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .vid2__media video,
  #shopify-section-{{ sid }} .vid2__media img,
  #shopify-section-{{ sid }} .vid2__media iframe,
  #shopify-section-{{ sid }} .vid2__media .video-wrapper,
  #shopify-section-{{ sid }} .vid2__media .video-wrapper > * {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block; border: 0;
  }

  /* Floating mute button */
  #shopify-section-{{ sid }} .vid2__mute {
    position: absolute; right: 14px; bottom: 14px;
    width: 40px; height: 40px;
    border-radius: 999px; border: 0;
    background: rgba(0,0,0,0.55);
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  #shopify-section-{{ sid }} .vid2__mute:hover { background: rgba(0,0,0,0.75); }
  #shopify-section-{{ sid }} .vid2__mute:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .vid2__mute { transition: none; } }
  #shopify-section-{{ sid }} .vid2__mute svg { width: 18px; height: 18px; fill: currentColor; }
{% comment %}{% endcomment %}</style>

<div id="vid2-{{ sid }}" class="vid2 section sec__video-2 color-{{ color_scheme }} gradient {{ section.settings.section_width }}" data-section-id="{{ sid }}">
  <div class="vid2__inner">
    <div class="vid2__media" data-vid2-media>
      {%- if st.video != blank -%}
        {{ st.video | video_tag: autoplay: st.autoplay, muted: st.muted, playsinline: true, loop: st.loop, controls: st.show_controls, image_size: '1800x' }}
      {%- elsif st.video_url != blank -%}
        <video
          src="{{ st.video_url }}"
          {% if st.autoplay %}autoplay{% endif %}
          {% if st.muted %}muted{% endif %}
          {% if st.loop %}loop{% endif %}
          {% if st.show_controls %}controls{% endif %}
          {% if st.poster != blank %}poster="{{ st.poster | image_url: width: 1800 }}"{% endif %}
          playsinline></video>
      {%- elsif st.poster != blank -%}
        <img src="{{ st.poster | image_url: width: 1800 }}" alt="{{ st.poster.alt | escape }}" width="{{ st.poster.width }}" height="{{ st.poster.height }}" decoding="async">
      {%- else -%}
        <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
      {%- endif -%}

      {%- if st.show_mute_btn -%}
        <button type="button" class="vid2__mute" data-vid2-mute aria-label="{{ 'accessibility.toggle_mute' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-muted style="display:none"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M16 9l5 5M21 9l-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-on><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a4 4 0 010 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var sec = document.getElementById('vid2-{{ sid }}');
    if (!sec || sec.dataset.vid2Init) return;
    sec.dataset.vid2Init = '1';
    var v = sec.querySelector('video');
    /* Autoplay video plays only while on screen */
    if (v && v.autoplay && 'IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) { var pr = v.play(); if (pr && pr.catch) pr.catch(function(){}); }
          else { v.pause(); }
        });
      }, { threshold: 0.15 }).observe(v);
    }
    var btn = sec.querySelector('[data-vid2-mute]');
    if (!btn) return;
    if (!v) { btn.style.display = 'none'; return; }
    function syncIcons() {
      var muted = sec.querySelector('[data-icon-muted]');
      var on    = sec.querySelector('[data-icon-on]');
      if (!muted || !on) return;
      muted.style.display = v.muted ? '' : 'none';
      on.style.display    = v.muted ? 'none' : '';
    }
    syncIcons();
    btn.addEventListener('click', function() { v.muted = !v.muted; syncIcons(); });
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "video-2",
  "name": "Video 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section gap",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Video source"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (.mp4)"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true,
      "info": "Needed for autoplay."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Player controls",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_mute_btn",
      "label": "Mute button",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Video shape"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Edge to edge",
      "default": false
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Ratio width",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "aspect_h",
      "label": "Ratio height",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Colors and spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Video 2",
      "category": "Image and video"
    }
  ],
  "shopify": {
    "name": "Video 2",
    "tag": "section",
    "class": "section sec__video-2",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section gap",
        "default": true
      },
      {
        "type": "header",
        "content": "Video source"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video"
      },
      {
        "type": "url",
        "id": "video_url",
        "label": "Video URL (.mp4)"
      },
      {
        "type": "image_picker",
        "id": "poster",
        "label": "Poster image"
      },
      {
        "type": "header",
        "content": "Playback"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "muted",
        "label": "Muted",
        "default": true,
        "info": "Needed for autoplay."
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_controls",
        "label": "Player controls",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_mute_btn",
        "label": "Mute button",
        "default": true
      },
      {
        "type": "header",
        "content": "Video shape"
      },
      {
        "type": "checkbox",
        "id": "full_bleed",
        "label": "Edge to edge",
        "default": false
      },
      {
        "type": "range",
        "id": "aspect_w",
        "label": "Ratio width",
        "min": 1,
        "max": 32,
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "aspect_h",
        "label": "Ratio height",
        "min": 1,
        "max": 32,
        "step": 1,
        "default": 9
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Colors and spacing"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "side_padding_desktop",
        "label": "Horizontal padding (desktop)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "side_padding_mobile",
