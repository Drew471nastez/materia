<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Video 2
  Single video section. Video-only — no overlay text or button.
  Supports Shopify-uploaded video, external video URL, or poster image fallback.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
-%}

<style>
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} { background-color: {{ st.section_bg | default: '#FFFFFF' }}; }
  #shopify-section-{{ sid }} .vid2 {
    padding: {{ st.padding_top_mobile | default: 40 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .vid2 {
      padding: {{ st.padding_top_desktop | default: 60 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 60 }}px;
    }
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .vid2 { padding-left: 0; padding-right: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .vid2__inner {
    {%- unless st.full_bleed -%}
      max-width: var(--page-width, 1300px);
      margin-inline: auto;
    {%- endunless -%}
    width: 100%;
  }
  #shopify-section-{{ sid }} .vid2__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.aspect_w | default: 16 }} / {{ st.aspect_h | default: 9 }};
    border-radius: {{ st.radius | default: 16 }}px;
    overflow: hidden;
    background: #0F172A;
    isolation: isolate;
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .vid2__media { border-radius: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .vid2__media video,
  #shopify-section-{{ sid }} .vid2__media img,
  #shopify-section-{{ sid }} .vid2__media iframe,
  #shopify-section-{{ sid }} .vid2__media .video-wrapper,
  #shopify-section-{{ sid }} .vid2__media .video-wrapper > * {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block; border: 0;
  }

  /* Floating mute button */
  #shopify-section-{{ sid }} .vid2__mute {
    position: absolute; right: 14px; bottom: 14px;
    width: 40px; height: 40px;
    border-radius: 999px; border: 0;
    background: rgba(0,0,0,0.55);
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  #shopify-section-{{ sid }} .vid2__mute svg { width: 18px; height: 18px; fill: currentColor; }
{% comment %}{% endcomment %}</style>

<div id="vid2-{{ sid }}" class="vid2 section sec__video-2" data-section-id="{{ sid }}">
  <div class="vid2__inner">
    <div class="vid2__media" data-vid2-media>
      {%- if st.video != blank -%}
        {{ st.video | video_tag: autoplay: st.autoplay, muted: st.muted, playsinline: true, loop: st.loop, controls: st.show_controls, image_size: '1800x' }}
      {%- elsif st.video_url != blank -%}
        <video
          src="{{ st.video_url }}"
          {% if st.autoplay %}autoplay{% endif %}
          {% if st.muted %}muted{% endif %}
          {% if st.loop %}loop{% endif %}
          {% if st.show_controls %}controls{% endif %}
          {% if st.poster != blank %}poster="{{ st.poster | image_url: width: 1800 }}"{% endif %}
          playsinline></video>
      {%- elsif st.poster != blank -%}
        <img src="{{ st.poster | image_url: width: 1800 }}" alt="{{ st.poster.alt | escape }}" loading="lazy">
      {%- else -%}
        <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
      {%- endif -%}

      {%- if st.show_mute_btn -%}
        <button type="button" class="vid2__mute" data-vid2-mute aria-label="{{ 'accessibility.toggle_mute' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-muted style="display:none"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M16 9l5 5M21 9l-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-on><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a4 4 0 010 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var sec = document.getElementById('vid2-{{ sid }}');
    if (!sec) return;
    var v = sec.querySelector('video');
    var btn = sec.querySelector('[data-vid2-mute]');
    if (!btn) return;
    if (!v) { btn.style.display = 'none'; return; }
    function syncIcons() {
      var muted = sec.querySelector('[data-icon-muted]');
      var on    = sec.querySelector('[data-icon-on]');
      if (!muted || !on) return;
      muted.style.display = v.muted ? '' : 'none';
      on.style.display    = v.muted ? 'none' : '';
    }
    syncIcons();
    btn.addEventListener('click', function() { v.muted = !v.muted; syncIcons(); });
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "video-2",
  "name": "Video 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Video source"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded to Shopify)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "External video URL (.mp4)"
