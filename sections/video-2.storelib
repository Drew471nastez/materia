      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full bleed (edge-to-edge)",
      "default": false
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Aspect ratio — width",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
