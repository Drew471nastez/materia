<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign background_image = section_st.background_image
  assign show_collection_image = section_st.show_collection_image

  assign image_bg = background_image
  if show_collection_image and collection.image != blank
    assign image_bg = collection.image
  endif
  assign alt = image_bg.alt | default: collection.title | escape
  assign height = section_st.height
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};{%- if image_bg != blank and height == 'adapt' -%}--aspect-ratio: {{ image_bg.aspect_ratio }}{% endif %};--overlay-opacity: {{ section_st.overlay_opacity }}%;
{%- endcapture -%}
{%- if section.blocks.size > 0 -%}
  <div
    class="section remove_spacing sec__page-heading color-{{ color_scheme }} gradient{% if image_bg != blank %} bg-transparent relative mb-60{% else %} mb-60{% endif %} flex align-center justify-content-{{ section_st.alignment }}"
    style="{{ style | strip | strip_newlines }}"
  >
    {% if show_collection_image or background_image != blank %}
      <div class="overlay-bg">
        {%- if image_bg != blank -%}
          {% render 'responsive-image',
            type: 'banner',
            container: section_width,
            image: image_bg,
            image_alt: alt,
            class: 'background-heading absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover'
          %}
        {%- else -%}
          {% render 'placeholder-render' | type: "collection", class: 'background-heading absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover' %}
        {% endif %}
      </div>
    {% endif %}
    <div class="{{ section_width }}">
      <div class="heading-content relative text-{{ section_st.alignment }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
            assign header_size = ''
            if block_st.header_size == 'small'
              assign header_size = 'h3'
            elsif block_st.header_size == 'large'
              assign header_size = 'h1-size'
            endif
          -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <motion-element
                data-motion="fade-up-lg"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class=" {% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
              >
              <h1 class="heading-title heading-letter-spacing h2 mt-8 mb-0 {{ header_size }}">
                {%- if block_st.page_title != blank -%}
                  {{ block_st.page_title }}
                {%- else -%}
                  {{ collection.title }}
                {% endif %}
              </h1>
            </motion-element>
            {%- when 'description' -%}
              {% if collection.description != blank %}
                <motion-element
                  data-motion="fade-up-lg"
                  {% if scroll_animation != 'slide_in' %}
                    hold
                  {% endif %}
                  data-motion-delay="{{ forloop.index0 | times: 50   }}"                             
                  class="heading-description mt-10 block {% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} rich__text-m0">
                  {{ collection.description }}
                </motion-element>
              {% endif %}
            {%- when 'breadcrumb' -%}
              <motion-element
                data-motion="fade-up-lg"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                data-motion-delay="{{ forloop.index0 | times: 50   }}"
                class="{% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
               >
              <div class="page-title-breadcrumb">
                {%- render 'breadcrumbs' -%}
              </div>
            </motion-element>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}

</template>

<schema>
{
  "type": "main-collection-heading",
  "name": "Main collection heading",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "based_on_content",
          "label": "Based on content"
        }
      ],
      "default": "adapt",
      "label": "Height"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "settings": [],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "page_title",
          "label": "Page title"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "select",
          "id": "header_size",
          "label": "Header size",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Advanced"
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Advanced"
        }
      ],
      "limit": 1
    }
  ],
  "max_blocks": 3,
  "shopify": {
    "name": "t:sections.collection_banner.name",
    "tag": "section",
    "class": "page-title",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.color_scheme.label",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ],
        "default": "stretch_width",
        "label": "t:sections.all.section_width.label"
      },
      {
        "type": "header",
        "content": "Image / Media"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "t:sections.all.image.background_image.label"
      },
      {
        "type": "checkbox",
        "id": "show_collection_image",
        "label": "t:sections.all.page_heading.use_collection_image",
        "info": "t:sections.all.page_heading.info",
        "default": false
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "t:sections.all.image.overlay_opacity.label",
        "default": 0
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "select",
        "id": "height",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.all.page_heading.height.option__1"
          },
          {
            "value": "based_on_content",
            "label": "t:sections.all.page_heading.height.option__2"
          }
        ],
        "default": "adapt",
        "label": "t:sections.all.page_heading.height.label"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.all.section_padding.top.label",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.all.section_padding.bottom.label",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "t:sections.all.section_header.alignment.label",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "t:sections.all.content_settings.content_alignment.left.label"
          },
          {
            "value": "center",
            "label": "t:sections.all.content_settings.content_alignment.center.label"
          },
          {
            "value": "right",
            "label": "t:sections.all.content_settings.content_alignment.right.label"
          }
        ]
      }
    ],
    "max_blocks": 3,
    "blocks": [
      {
        "type": "breadcrumb",
        "name": "t:sections.all.page_heading.breadcrumb.label",
        "limit": 1
      },
      {
        "type": "heading",
        "name": "t:sections.all.page_heading.heading.label",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "page_title",
            "label": "t:sections.all.page_heading.heading.label"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "select",
            "id": "header_size",
            "label": "t:sections.all.content_settings.font_size.label",
            "default": "default",
            "options": [
              {
                "value": "default",
                "label": "t:sections.all.content_settings.font_size.default.label"
              },
              {
                "value": "small",
                "label": "t:sections.all.content_settings.font_size.small.label"
              },
              {
                "value": "large",
                "label": "t:sections.all.content_settings.font_size.large.label"
              }
            ]
          },
          {
            "type": "header",
            "content": "Advanced"
          },
          {
            "type": "paragraph",
            "content": "t:sections.all.page_heading.heading.info"
          }
        ]
      },
      {
        "type": "description",
        "name": "t:sections.all.page_heading.description.label",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Advanced"
          },
          {
            "type": "paragraph",
            "content": "t:sections.all.page_heading.description.info"
          }
        ]
      }
    ]
  }
}
</schema>
