<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Popup must escape section stacking contexts so it can render above all
     other content (Comparison Table 4 etc. were overlapping it). */
  #shopify-section-{{ section.id }} {
    position: static;
  }
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Block resolution: image settings can come from an Image block (limit 1).
  Fall back to legacy section settings when no block exists so existing
  instances render unchanged.
{%- endcomment -%}
{%- assign block_image = blank -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'image' -%}{%- assign block_image = b -%}{%- endif -%}
{%- endfor -%}

{%- liquid
  assign display_options = section.settings.display_options
  assign seconds = section.settings.seconds
  assign percent = section.settings.percent
  assign hide_promobanner_days = section.settings.hide_promobanner_days

  assign promobanner_width = section.settings.promobanner_width
  assign promobanner_width_mobile = section.settings.promobanner_width_mobile
  assign promobanner_radius = section.settings.promobanner_radius
  assign promobanner_border_thickness = section.settings.promobanner_border_thickness
  assign promobanner_overlay = section.settings.promobanner_overlay
  assign promobanner_horizontal_position = section.settings.promobanner_horizontal_position
  assign promobanner_horizontal_position_mobile = section.settings.promobanner_horizontal_position_mobile
  assign promobanner_vertical_position = section.settings.promobanner_vertical_position
  assign promobanner_vertical_position_mobile = section.settings.promobanner_vertical_position_mobile

  if block_image != blank
    assign image_desktop = block_image.settings.image_desktop
    assign image_mobile = block_image.settings.image_mobile
    assign image_link = block_image.settings.image_link
    assign image_border_radius = block_image.settings.image_border_radius
    assign image_width_desktop = block_image.settings.image_width_desktop
    assign image_height_desktop = block_image.settings.image_height_desktop
    assign image_width_mobile = block_image.settings.image_width_mobile
    assign image_height_mobile = block_image.settings.image_height_mobile
    assign lazy = block_image.settings.lazy
    assign image_hover_animation = block_image.settings.image_hover_animation
  else
    assign image_desktop = section.settings.image_desktop
    assign image_mobile = section.settings.image_mobile
    assign image_link = section.settings.image_link
    assign image_border_radius = section.settings.image_border_radius
    assign image_width_desktop = section.settings.image_width_desktop
    assign image_height_desktop = section.settings.image_height_desktop
    assign image_width_mobile = section.settings.image_width_mobile
    assign image_height_mobile = section.settings.image_height_mobile
    assign lazy = section.settings.lazy
    assign image_hover_animation = section.settings.image_hover_animation
  endif

  assign close_button_color = section.settings.close_button_color
  assign hide_on_mobile = section.settings.hide_on_mobile

  assign section_padding_top = section.settings.section_padding_top
  assign section_padding_bottom = section.settings.section_padding_bottom

  assign popup_container_background_color = section.settings.popup_container_background_color
-%}

{%- style -%}
  /* The section wrapper is invisible unless display mode is "Open on button click" —
     we don't want it to occupy any layout space under the footer when the popup is
     auto-triggered (delay / scroll / exit-intent). The popup overlay is position:fixed
     and renders on top regardless. */
  {% if display_options == 'click' %}
    .section-{{ section.id }} {
      text-align: center;
      padding-top: {{ section_padding_top }}px;
      padding-bottom: {{ section_padding_bottom }}px;
    }
  {% else %}
    .section-{{ section.id }} {
      display: none !important;
      height: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    /* Make sure the parent <section> tag the theme renders also collapses */
    #shopify-section-{{ section.id }} {
      height: 0 !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  {% endif %}
  .promobanner-button-{{ section.id }} {
    cursor: pointer;
  }

  /* Popup container (overlay) */
  .promobanner-popup-{{ section.id }} {
    width: 100% !important;
    height: 100% !important;
    top: 0;
    left: 0;
    position: fixed;
    display: flex;
    align-items: {{ promobanner_vertical_position_mobile }};
    justify-content: {{ promobanner_horizontal_position_mobile }};
    opacity: 0;
    visibility: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: none;
    background: rgba(0, 0, 0, {{ promobanner_overlay | times: 0.01 }});
    padding: 16px;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
    z-index: 2147483646;
  }
  .promobanner-popup-{{ section.id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .promobanner-popup-{{ section.id }} .promobanner-popup-inner-{{ section.id }} {
    transform: translateY(16px) scale(.98);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .promobanner-popup-{{ section.id }}.active .promobanner-popup-inner-{{ section.id }} { transform: none; }
  /* Popup inner container (where the image stays) */
  .promobanner-popup-inner-{{ section.id }} {
    position: relative;
    max-width: {{ promobanner_width_mobile }}%;
    border: {{ promobanner_border_thickness }}px solid var(--color-border);
    background: {% render 'scheme-color', color: popup_container_background_color, fallback: 'var(--color-background)' %};
    border-radius: {{ promobanner_radius }}px;
    overflow: hidden;
    max-width: 100%;
  }
  .promobanner-popup-inner-{{ section.id }} .promobanner-placeholder { width: 100%; height: 100%; display: block; background: color-mix(in srgb, var(--color-heading) 8%, var(--color-background)); fill: color-mix(in srgb, var(--color-text) 30%, transparent); }

  /* Image containers (only one is shown at a time) */
  .promobanner-popup-image-desktop-{{ section.id }},
  .promobanner-popup-image-mobile-{{ section.id }} {
    margin: 0 auto;
  }
  .promobanner-popup-image-desktop-{{ section.id }} img,
  .promobanner-popup-image-mobile-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ image_border_radius }}px;
  }
  @media (min-width: 1024px) {
    .promobanner-popup-inner-{{ section.id }} {
      max-width: {{ promobanner_width }}%;
    }
    .promobanner-popup-image-desktop-{{ section.id }} {
      display: block;
      width: {{ image_width_desktop }}%;
      height: {{ image_height_desktop }}px;
    }
    .promobanner-popup-image-mobile-{{ section.id }} {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    .promobanner-popup-image-mobile-{{ section.id }} {
      display: block;
      width: {{ image_width_mobile }}%;
      height: {{ image_height_mobile }}px;
    }
    .promobanner-popup-image-desktop-{{ section.id }} {
      display: none;
    }
  }

  /* Close icon */
  .promobanner-popup-close-{{ section.id }} {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, .35);
    border: none;
    cursor: pointer;
    z-index: 2147483647;
  }
  /* The popup container itself sits at maximum z-index */
  .promobanner-popup-inner-{{ section.id }} {
    z-index: 2147483647;
  }
  .promobanner-popup-close-{{ section.id }} svg {
    width: 24px;
    height: 24px;
  }
  .promobanner-popup-close-{{ section.id }} svg path {
    fill: {% render 'scheme-color', color: close_button_color, fallback: '#ffffff' %};
    transition: filter var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  .promobanner-popup-close-{{ section.id }}:hover { background: rgba(0, 0, 0, .55); }

  /* Hide section on mobile if enabled */
  {% if hide_on_mobile %}
  @media (max-width: 1023px) {
    .section-{{ section.id }},
    .promobanner-popup-{{ section.id }} {
      display: none !important;
    }
  }
  {% endif %}

  /* Image Hover Animations */
  {% if image_hover_animation == 'smooth_fade' %}
    .promobanner-popup-image-desktop-{{ section.id }} img,
    .promobanner-popup-image-mobile-{{ section.id }} img {
      transition: opacity 0.3s ease;
    }
    .promobanner-popup-image-desktop-{{ section.id }} img:hover,
    .promobanner-popup-image-mobile-{{ section.id }} img:hover {
      opacity: 0.8;
    }
  {% elsif image_hover_animation == 'smooth_blink' %}
    .promobanner-popup-image-desktop-{{ section.id }} img,
    .promobanner-popup-image-mobile-{{ section.id }} img {
      transition: opacity 0.3s ease;
    }
    .promobanner-popup-image-desktop-{{ section.id }} img:hover,
    .promobanner-popup-image-mobile-{{ section.id }} img:hover {
      animation: blink 1s linear infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
  {% elsif image_hover_animation == 'smooth_shadow' %}
    .promobanner-popup-image-desktop-{{ section.id }} img,
    .promobanner-popup-image-mobile-{{ section.id }} img {
      transition: box-shadow 0.3s ease;
    }
    .promobanner-popup-image-desktop-{{ section.id }} img:hover,
    .promobanner-popup-image-mobile-{{ section.id }} img:hover {
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
    }
  {% endif %}
  .promobanner-popup-close-{{ section.id }}:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .promobanner-popup-{{ section.id }},
    .promobanner-popup-{{ section.id }} img,
    .promobanner-popup-close-{{ section.id }} svg path,
    .promobanner-popup-{{ section.id }} .promobanner-popup-inner-{{ section.id }} { transition: none !important; animation: none !important; transform: none !important; }
  }
{%- endstyle -%}

{%- liquid
  case display_options
    when 'after_seconds'
      assign ib_mode = 'delay'
    when 'after_scrolling'
      assign ib_mode = 'scroll'
    when 'mouse_close'
      assign ib_mode = 'exit'
    when 'pageviews'
      assign ib_mode = 'pageviews'
    else
      assign ib_mode = 'manual'
  endcase
  assign ib_alt = 'accessibility.banner_image' | t
  if section.settings.image_alt != blank
    assign ib_alt = section.settings.image_alt
  endif
-%}
{%- capture ib_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ section.settings.show_in_builder | json }}, "phoneOff": {{ hide_on_mobile | json }},
   "trigger": {"mode": {{ ib_mode | json }}, "delay": {{ seconds | default: 0 | json }}, "scroll": {{ percent | default: 50 | json }}, "views": {{ section.settings.page_views | default: 2 | json }} },
   "frequency": {"mode": {% if hide_promobanner_days > 0 %}"after_days"{% else %}"always"{% endif %}, "days": {{ hide_promobanner_days | default: 0 | json }} } }
{%- endcapture -%}
<div class="section-{{ section.id }} promobanner-{{ section.id }} color-{{ color_scheme }}">
  <div class="section-{{ section.id }}-settings">
    {% if display_options == 'click' %}
      <button type="button" class="btn-primary promobanner-button-{{ section.id }}" data-theme-button="primary" data-sl-button data-popup-open="{{ section.id }}" aria-haspopup="dialog">{{ section.settings.button_label | default: 'See the offer' }}</button>
    {% endif %}
  </div>
</div>

<div class="promobanner-popup-{{ section.id }}" data-popup-root="{{ section.id }}" data-popup-config="{{ ib_config | strip_newlines | escape }}" aria-hidden="true">
  <div class="promobanner-popup-inner-{{ section.id }} color-{{ color_scheme }}" role="dialog" aria-modal="true" aria-label="{{ ib_alt | escape }}" tabindex="-1">
    {%- for ib_view in (1..2) -%}
      {%- if ib_view == 1 -%}{%- assign ib_img = image_desktop -%}{%- assign ib_class = 'desktop' -%}{%- assign ib_sizes = '(min-width: 1024px) 60vw' -%}{%- else -%}{%- assign ib_img = image_mobile | default: image_desktop -%}{%- assign ib_class = 'mobile' -%}{%- assign ib_sizes = '100vw' -%}{%- endif -%}
    <div class="promobanner-popup-image-{{ ib_class }}-{{ section.id }}">
      {% if image_link != blank %}<a href="{{ image_link }}">{% endif %}
      {%- if ib_img != blank -%}
        {%- if lazy -%}
          {{ ib_img | image_url: width: 1600 | image_tag: alt: ib_alt, loading: 'lazy', decoding: 'async', sizes: ib_sizes, widths: '480,750,1100,1600' }}
        {%- else -%}
          {{ ib_img | image_url: width: 1600 | image_tag: alt: ib_alt, sizes: ib_sizes, widths: '480,750,1100,1600' }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'promobanner-placeholder' }}
      {%- endif -%}
      {% if image_link != blank %}</a>{% endif %}
    </div>
    {%- endfor -%}
    <button type="button" class="promobanner-popup-close-{{ section.id }}" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 10.586l-7.293-7.293-1.414 1.414L10.586 12l-7.293 7.293 1.414 1.414L12 13.414l7.293 7.293 1.414-1.414L13.414 12l7.293-7.293-1.414-1.414L12 10.586z"></path>
      </svg>
    </button>
  </div>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__ib) return;
    root.__ib = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    // "Hide on phones": the banner is not offered below 1024px.
    if (CFG.phoneOff && !CFG.design && window.matchMedia && matchMedia('(max-width: 1023px)').matches) return;
    P.register({
      id: SID, root: root, dialog: root.querySelector('.promobanner-popup-inner-' + SID), backdrop: root,
      design: CFG.design, preview: CFG.preview, trigger: CFG.trigger, frequency: CFG.frequency,
      open: function(){ root.classList.add('active'); },
      close: function(){ root.classList.remove('active'); }
    });
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>


</template>

<schema>
{
  "type": "promotional-image-popup",
  "name": "Image Banner Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "display_options",
      "label": "Activation Method",
      "default": "after_scrolling",
      "options": [
        {
          "value": "mouse_close",
          "label": "Exit Intent (mouse leaves window)"
        },
        {
          "value": "after_seconds",
          "label": "After a few seconds"
        },
        {
          "value": "after_scrolling",
          "label": "After scrolling a percentage"
        },
        {
          "value": "click",
          "label": "On Button Click"
        }
      ]
    },
    {
      "type": "range",
      "id": "seconds",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "s",
      "label": "Delay Before Display (Seconds)",
      "default": 10
    },
    {
      "type": "range",
      "id": "hide_promobanner_days",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "d",
      "label": "Suppress Banner for Days",
      "default": 0
    },
    {
      "type": "range",
      "id": "percent",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Scroll Trigger Percentage",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Popup"
    },
    {
      "type": "range",
      "id": "promobanner_width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "%",
      "label": "Desktop Popup Width (%)",
      "default": 60
    },
    {
      "type": "range",
      "id": "promobanner_width_mobile",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Mobile Popup Width (%)",
      "default": 100
    },
    {
      "type": "range",
      "id": "promobanner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Popup Corner Radius (px)",
      "default": 4
    },
    {
      "type": "range",
      "id": "promobanner_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Popup Border Width (px)",
      "default": 0
    },
    {
      "type": "range",
      "id": "promobanner_overlay",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Overlay Transparency (%)",
      "default": 50
    },
    {
      "type": "select",
      "id": "promobanner_horizontal_position_mobile",
      "label": "Horizontal alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "promobanner_vertical_position_mobile",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop Image Width (%)",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop Image Height (px)",
      "default": 300
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile Image Width (%)",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 50,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Mobile Image Height (px)",
      "default": 200
    },
    {
      "type": "checkbox",
      "id": "lazy",
      "label": "Lazy load image",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Section Top Padding (px)",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Section Bottom Padding (px)",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Advanced"
    },
    {
      "type": "color",
      "id": "close_button_color",
      "label": "Close button color"
    },
    {
      "type": "color",
      "id": "popup_container_background_color",
      "label": "Popup background"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Banner image",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop banner image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile banner image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "lazy",
          "label": "Lazy load",
          "default": true
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Sizing"
        },
        {
          "type": "range",
          "id": "image_width_desktop",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Desktop width",
          "default": 100
        },
        {
          "type": "range",
          "id": "image_height_desktop",
          "min": 50,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "label": "Desktop height",
          "default": 300
        },
        {
          "type": "range",
          "id": "image_width_mobile",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mobile width",
          "default": 100
        },
        {
          "type": "range",
          "id": "image_height_mobile",
          "min": 50,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Mobile height",
          "default": 200
        },
        {
          "type": "range",
          "id": "image_border_radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Border radius",
          "default": 0
        },
        {
          "type": "header",
          "id": "hdr_12",
          "label": "Hover"
        },
        {
