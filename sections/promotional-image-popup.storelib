<template compat="shopify">
<script src="{{ 'live-page-popups.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Image Banner Popup: a picture (with an optional link) in a
  native <dialog> (snippets/page-popup-dialog). Every setting reaches the
  page as a CSS variable or an attribute on the root, so
  shopify/assets/live-page-popups.js applies a builder edit in place, the
  same as this Liquid draws it. The Banner image block's settings win over
  the section's old ones (kept, hidden, for popups saved without the block).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign block_image = section.blocks | where: 'type', 'image' | first
  assign im = st
  if block_image != blank
    assign im = block_image.settings
  endif
  assign ib_custom = false
  if st.enable_custom_style == true
    assign ib_custom = true
  endif
  assign ib_bg = ''
  assign ib_close = ''
  if ib_custom
    assign ib_bg = st.popup_container_background_color
    assign ib_close = st.close_button_color
  endif
  case st.display_options
    when 'after_seconds'
      assign ib_mode = 'delay'
    when 'after_scrolling'
      assign ib_mode = 'scroll'
    when 'mouse_close'
      assign ib_mode = 'exit'
    when 'pageviews'
      assign ib_mode = 'pageviews'
    else
      assign ib_mode = 'manual'
  endcase
  assign ib_alt_default = 'accessibility.banner_image' | t
  assign ib_alt = ib_alt_default
  if st.image_alt != blank
    assign ib_alt = st.image_alt
  endif
  assign ib_frequency = 'always'
  if st.hide_promobanner_days > 0
    assign ib_frequency = 'after_days'
  endif
-%}
<style>
  #shopify-section-{{ section.id }} { position: static; }
  :where(#shopify-section-{{ section.id }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) { font-family: inherit; }
  /* "Open on button click" draws its button in the page; otherwise the
     section takes no room (the popup itself is fixed over the page). */
  #shopify-section-{{ section.id }} .section-{{ section.id }} {
    text-align: center;
    padding-top: var(--ib-pad-t, 10px);
    padding-bottom: var(--ib-pad-b, 10px);
  }
  #shopify-section-{{ section.id }} [data-pg-root]:not([data-ib-mode="click"]) .section-{{ section.id }} {
    display: none !important;
  }
  {%- unless request.design_mode %}
  #shopify-section-{{ section.id }}:has([data-pg-root]:not([data-ib-mode="click"])) {
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  {%- endunless %}
  .promobanner-button-{{ section.id }} { cursor: pointer; }

  /* Popup container (overlay) */
  .promobanner-popup-{{ section.id }} {
    width: 100% !important;
    height: 100% !important;
    top: 0;
    left: 0;
    position: fixed;
    display: flex;
    align-items: var(--ib-v, center);
    justify-content: var(--ib-h, center);
    opacity: 0;
    visibility: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: none;
    background: rgba(0, 0, 0, var(--ib-overlay-o, .5));
    padding: 16px;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
    z-index: 2147483646;
  }
  .promobanner-popup-{{ section.id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .promobanner-popup-{{ section.id }} .promobanner-popup-inner-{{ section.id }} {
    transform: translateY(16px) scale(.98);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .promobanner-popup-{{ section.id }}.active .promobanner-popup-inner-{{ section.id }} { transform: none; }
  .promobanner-popup-inner-{{ section.id }} {
    position: relative;
    max-width: var(--ib-w-m, 100%);
    border: var(--ib-border, 0px) solid var(--color-border);
    background: var(--ib-bg, var(--color-background));
    border-radius: var(--ib-radius, 0px);
    overflow: hidden;
    z-index: 2147483647;
  }
  .promobanner-popup-inner-{{ section.id }} .promobanner-placeholder { width: 100%; height: 100%; display: block; background: color-mix(in srgb, var(--color-heading) 8%, var(--color-background)); fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
  .promobanner-popup-inner-{{ section.id }} [data-ib-link] { display: contents; }

  .promobanner-popup-image-desktop-{{ section.id }},
  .promobanner-popup-image-mobile-{{ section.id }} { margin: 0 auto; }
  .promobanner-popup-image-desktop-{{ section.id }} img,
  .promobanner-popup-image-mobile-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--ib-img-radius, 0px);
  }
  @media (min-width: 1024px) {
    .promobanner-popup-inner-{{ section.id }} { max-width: var(--ib-w-d, 60%); }
    .promobanner-popup-image-desktop-{{ section.id }} { display: block; width: var(--ib-iw-d, 100%); height: var(--ib-ih-d, 300px); }
    .promobanner-popup-image-mobile-{{ section.id }} { display: none; }
  }
  @media (max-width: 1023px) {
    .promobanner-popup-image-mobile-{{ section.id }} { display: block; width: var(--ib-iw-m, 100%); height: var(--ib-ih-m, 200px); }
    .promobanner-popup-image-desktop-{{ section.id }} { display: none; }
    #shopify-section-{{ section.id }} [data-ib-phone-off] .section-{{ section.id }},
    #shopify-section-{{ section.id }} [data-ib-phone-off] .promobanner-popup-{{ section.id }} { display: none !important; }
  }

  .promobanner-popup-close-{{ section.id }} {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, .35);
    border: none;
    cursor: pointer;
    z-index: 2147483647;
  }
  .promobanner-popup-close-{{ section.id }} svg { width: 24px; height: 24px; }
  .promobanner-popup-close-{{ section.id }} svg path {
    fill: var(--ib-close, #ffffff);
    transition: filter var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  .promobanner-popup-close-{{ section.id }}:hover { background: rgba(0, 0, 0, .55); }

  /* Picture on hover */
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_fade"] .promobanner-popup-inner-{{ section.id }} img,
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_blink"] .promobanner-popup-inner-{{ section.id }} img { transition: opacity 0.3s ease; }
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_fade"] .promobanner-popup-inner-{{ section.id }} img:hover { opacity: 0.8; }
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_blink"] .promobanner-popup-inner-{{ section.id }} img:hover { animation: ib-blink-{{ section.id }} 1s linear infinite; }
  @keyframes ib-blink-{{ section.id }} { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_shadow"] .promobanner-popup-inner-{{ section.id }} img { transition: box-shadow 0.3s ease; }
  #shopify-section-{{ section.id }} [data-ib-hover="smooth_shadow"] .promobanner-popup-inner-{{ section.id }} img:hover { box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5); }

  .promobanner-popup-close-{{ section.id }}:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .promobanner-popup-{{ section.id }},
    .promobanner-popup-{{ section.id }} img,
    .promobanner-popup-close-{{ section.id }} svg path,
    .promobanner-popup-{{ section.id }} .promobanner-popup-inner-{{ section.id }} { transition: none !important; animation: none !important; transform: none !important; }
  }
{% comment %}{% endcomment %}</style>
{%- capture ib_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ st.show_in_builder | json }}, "phoneOff": {{ st.hide_on_mobile | json }},
   "trigger": {"mode": {{ ib_mode | json }}, "delay": {{ st.seconds | default: 0 | json }}, "scroll": {{ st.percent | default: 50 | json }}, "views": {{ st.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ ib_frequency | json }}, "days": {{ st.hide_promobanner_days | default: 0 | json }} } }
{%- endcapture -%}
{%- capture ib_vars -%}
--ib-pad-t: {{ st.section_padding_top | default: 0 }}px; --ib-pad-b: {{ st.section_padding_bottom | default: 0 }}px; --ib-v: {{ st.promobanner_vertical_position_mobile | default: 'center' }}; --ib-h: {{ st.promobanner_horizontal_position_mobile | default: 'center' }}; --ib-overlay-o: {{ st.promobanner_overlay | default: 0 | times: 0.01 }}; --ib-w-m: {{ st.promobanner_width_mobile | default: 100 }}%; --ib-w-d: {{ st.promobanner_width | default: 60 }}%; --ib-border: {{ st.promobanner_border_thickness | default: 0 }}px; --ib-radius: {{ st.promobanner_radius | default: 0 }}px; --ib-img-radius: {{ im.image_border_radius | default: 0 }}px; --ib-iw-d: {{ im.image_width_desktop | default: 100 }}%; --ib-ih-d: {{ im.image_height_desktop | default: 300 }}px; --ib-iw-m: {{ im.image_width_mobile | default: 100 }}%; --ib-ih-m: {{ im.image_height_mobile | default: 200 }}px;
{%- if ib_custom -%} --ib-bg: {% render 'scheme-color', color: ib_bg, fallback: 'var(--color-background)' %}; --ib-close: {% render 'scheme-color', color: ib_close, fallback: '#ffffff' %};{%- endif -%}
{%- render 'page-popup-fonts', st: st -%}
{%- endcapture -%}
{% render 'page-popup-dialog', sid: section.id, st: st %}
<div class="pg-root" data-pg-root="promotional-image-popup" data-pg-section="{{ section.id }}"{% if request.design_mode %} data-pg-settings="{{ st | json | escape }}"{% endif %} data-pg-i18n="{{ ib_alt_default | escape }}"{% if st.enable_custom_fonts %} data-pg-fonts data-own-font{% endif %} data-ib-mode="{{ st.display_options }}"{% if st.hide_on_mobile %} data-ib-phone-off{% endif %} data-ib-hover="{{ im.image_hover_animation | default: 'none' }}" style="{{ ib_vars | strip_newlines | strip }}">
<div class="section-{{ section.id }} promobanner-{{ section.id }} color-{{ color_scheme }}" data-pg-scheme>
  <div class="section-{{ section.id }}-settings">
    <button type="button" class="btn-primary promobanner-button-{{ section.id }}" data-theme-button="primary" data-sl-button data-popup-open="{{ section.id }}" aria-haspopup="dialog" data-ib-button>{{ st.button_label | default: 'See the offer' }}</button>
  </div>
</div>

<dialog class="pg-dialog" data-pg-dialog aria-label="{{ ib_alt | escape }}">
<div class="promobanner-popup-{{ section.id }}" data-popup-root="{{ section.id }}" data-pg-frame data-popup-config="{{ ib_config | strip_newlines | escape }}" aria-hidden="true">
  <div class="promobanner-popup-inner-{{ section.id }} color-{{ color_scheme }}" data-pg-card data-pg-scheme tabindex="-1"{% if block_image != blank %} data-pg-block="{{ block_image.id }}" data-pg-type="image"{% if request.design_mode %} data-pg-settings="{{ block_image.settings | json | escape }}"{% endif %} {{ block_image.shopify_attributes }}{% endif %}>
    {%- for ib_view in (1..2) -%}
      {%- if ib_view == 1 -%}{%- assign ib_img = im.image_desktop -%}{%- assign ib_class = 'desktop' -%}{%- assign ib_sizes = '(min-width: 1024px) 60vw' -%}{%- else -%}{%- assign ib_img = im.image_mobile | default: im.image_desktop -%}{%- assign ib_class = 'mobile' -%}{%- assign ib_sizes = '100vw' -%}{%- endif -%}
    <div class="promobanner-popup-image-{{ ib_class }}-{{ section.id }}" data-ib-view="{{ ib_class }}">
      <template data-pg-ph>{{ 'lifestyle-2' | placeholder_svg_tag: 'promobanner-placeholder' }}</template>
      <a data-ib-link{% if im.image_link != blank %} href="{{ im.image_link }}"{% endif %}>
      {%- if ib_img != blank -%}
        {%- if im.lazy -%}
          {{ ib_img | image_url: width: 1600 | image_tag: alt: ib_alt, loading: 'lazy', decoding: 'async', sizes: ib_sizes, widths: '480,750,1100,1600' }}
        {%- else -%}
          {{ ib_img | image_url: width: 1600 | image_tag: alt: ib_alt, sizes: ib_sizes, widths: '480,750,1100,1600' }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'promobanner-placeholder' }}
      {%- endif -%}
      </a>
    </div>
    {%- endfor -%}
    <button type="button" class="promobanner-popup-close-{{ section.id }}" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 10.586l-7.293-7.293-1.414 1.414L10.586 12l-7.293 7.293 1.414 1.414L12 13.414l7.293 7.293 1.414-1.414L13.414 12l7.293-7.293-1.414-1.414L12 10.586z"></path>
      </svg>
    </button>
  </div>
</div>
</dialog>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__ib) return;
    root.__ib = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    // "Hide on phones": the banner is not offered below 1024px.
    if (CFG.phoneOff && !CFG.design && window.matchMedia && matchMedia('(max-width: 1023px)').matches) return;
    P.register({
      id: SID, root: root, dialog: root.querySelector('.promobanner-popup-inner-' + SID), backdrop: root,
      design: CFG.design, preview: CFG.preview, trigger: CFG.trigger, frequency: CFG.frequency,
      open: function(){ root.classList.add('active'); },
      close: function(){ root.classList.remove('active'); }
    });
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>


</template>

<schema>
{
  "type": "promotional-image-popup",
  "name": "Image Banner Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "display_options",
      "label": "Opens",
      "default": "after_scrolling",
      "options": [
        {
          "value": "after_seconds",
          "label": "After a delay"
        },
        {
          "value": "after_scrolling",
          "label": "On scroll"
        },
        {
          "value": "mouse_close",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "click",
          "label": "From a link"
        }
      ]
    },
    {
      "type": "range",
      "id": "seconds",
      "label": "Delay",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "s",
      "default": 10,
      "visible_if": "{{ section.settings.display_options == 'after_seconds' }}"
    },
    {
      "type": "range",
      "id": "percent",
      "label": "Scrolled",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.display_options == 'after_scrolling' }}"
    },
    {
      "type": "range",
      "id": "page_views",
      "label": "Page views",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.display_options == 'pageviews' }}"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See the offer",
      "visible_if": "{{ section.settings.display_options == 'click' }}"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Behaviour"
    },
    {
      "type": "range",
      "id": "hide_promobanner_days",
      "label": "Hide after showing for",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "d",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on phones",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_in_builder",
      "label": "Show in the builder",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image",
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image on phones",
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Link",
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "checkbox",
      "id": "lazy",
      "label": "Load when needed",
      "default": true,
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Height",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 300,
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Width on phones",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Height on phones",
      "min": 50,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200,
      "hidden": true,
      "info": "Legacy: used only when the popup has no Banner image block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "promobanner_width",
      "label": "Popup width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "promobanner_width_mobile",
      "label": "Popup width on phones",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "promobanner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "promobanner_border_thickness",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "promobanner_horizontal_position_mobile",
      "label": "Across",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "promobanner_vertical_position_mobile",
      "label": "Down",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Button top padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.display_options == 'click' }}"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Button bottom padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.display_options == 'click' }}"
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Custom colours",
      "default": false,
      "info": "Off, the popup follows its colour scheme."
    },
    {
      "type": "color",
      "id": "popup_container_background_color",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style == true }}"
    },
    {
      "type": "color",
      "id": "close_button_color",
      "label": "Close icon",
      "visible_if": "{{ section.settings.enable_custom_style == true }}"
    },
    {
      "type": "range",
      "id": "promobanner_overlay",
      "label": "Backdrop opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Typography"
    },
