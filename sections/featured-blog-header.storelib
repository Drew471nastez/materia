<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_featured_article = 'accessibility.featured_article' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance: inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation: prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* AGGRESSIVE theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Reveal-on-scroll */
  #shopify-section-{{ section.id }}.ti-reveal-ready {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  #shopify-section-{{ section.id }}.ti-reveal-in {
    opacity: 1;
    transform: translateY(0);
  }
  /* The ti-section-wrap inherits container/fluid_container/stretch_width/full_width
     from the theme's existing CSS. We just ensure the wrapper itself doesn't
     double-pad the section. */
  #shopify-section-{{ section.id }} > .ti-section-wrap {
    box-sizing: border-box;
  }
  /* Reset spacing: flatten margins between adjacent sections when toggled */
  {% if section.settings.reset_spacing %}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {% endif %}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia: the hero promotes an article. With no block pointing at a published
  article it would show an empty title and a Read more link to nowhere, so
  visitors see nothing until one is picked. The builder shows where the post's
  picture, title and text go, without making any up (Storelib has no blog
  posts yet).
{%- endcomment -%}
{%- liquid
  assign fbh_has_article = false
  for block in section.blocks
    if block.settings.article.url != blank
      assign fbh_has_article = true
    endif
  endfor
  assign st = section.settings
  comment
    Theme first: the scheme's background, the theme's button colours, white
    words over the darkened picture and the scheme's text on the cards. The
    colours picked here apply only while Enable custom styling is on.
  endcomment
  assign fbh_bg = 'var(--color-background)'
  assign fbh_btn_bg = 'var(--btn-primary-bg-color)'
  assign fbh_btn_bg_hover = 'var(--btn-primary-hover-bg-color)'
  assign fbh_btn_color = 'var(--btn-primary-color)'
  assign fbh_btn_color_hover = 'var(--btn-primary-hover-color)'
  assign fbh_btn_border = 'var(--btn-primary-border-color, var(--btn-primary-bg-color))'
  assign fbh_btn_border_hover = 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))'
  assign fbh_overlay_text = '#ffffff'
  assign fbh_overlay_title = '#ffffff'
  assign fbh_card_text = 'var(--color-text)'
  if st.enable_custom_style
    capture fbh_bg
      render 'scheme-color', color: st.section_bg_color, fallback: fbh_bg
    endcapture
    capture fbh_btn_bg
      render 'scheme-color', color: st.button_bg_color, fallback: fbh_btn_bg
    endcapture
    capture fbh_btn_bg_hover
      render 'scheme-color', color: st.button_bg_hover_color, fallback: fbh_btn_bg_hover
    endcapture
    capture fbh_btn_color
      render 'scheme-color', color: st.button_text_color, fallback: fbh_btn_color
    endcapture
    capture fbh_btn_color_hover
      render 'scheme-color', color: st.button_text_color, fallback: fbh_btn_color_hover
    endcapture
    capture fbh_btn_border
      render 'scheme-color', color: st.button_border_color, fallback: fbh_btn_border
    endcapture
    capture fbh_btn_border_hover
      render 'scheme-color', color: st.button_border_hover_color, fallback: fbh_btn_border_hover
    endcapture
    capture fbh_overlay_text
      render 'scheme-color', color: st.description_maintext_color, fallback: fbh_overlay_text
    endcapture
    capture fbh_overlay_title
      render 'scheme-color', color: st.featured_title_text_color, fallback: fbh_overlay_title
    endcapture
    capture fbh_card_text
      render 'scheme-color', color: st.description_maintext_color, fallback: fbh_card_text
    endcapture
  endif
  assign fbh_own_fonts = false
  if st.use_theme_fonts == false
    assign fbh_own_fonts = true
  endif
  assign fbh_ratio = st.article_image_ratio_mobile | default: '16-9' | split: '-'
-%}
{%- capture fbh_vars -%}
  --fbh-bg: {{ fbh_bg | strip }};
  --fbh-btn-bg: {{ fbh_btn_bg | strip }}; --fbh-btn-bg-hover: {{ fbh_btn_bg_hover | strip }};
  --fbh-btn-color: {{ fbh_btn_color | strip }}; --fbh-btn-color-hover: {{ fbh_btn_color_hover | strip }};
  --fbh-btn-border: {{ fbh_btn_border | strip }}; --fbh-btn-border-hover: {{ fbh_btn_border_hover | strip }};
  --fbh-overlay-text: {{ fbh_overlay_text | strip }}; --fbh-overlay-title: {{ fbh_overlay_title | strip }}; --fbh-card-text: {{ fbh_card_text | strip }};
  {%- if st.use_theme_button != false -%}
  --fbh-btn-radius: var(--btn-radius, 25px); --fbh-btn-bw: var(--btn-border-width, 2px); --fbh-btn-weight: var(--btn-font-weight, 600);
  {%- else -%}
  --fbh-btn-radius: {{ st.button_border_radius }}px; --fbh-btn-bw: {{ st.read_more_button_border_weight }}px; --fbh-btn-weight: {{ st.read_more_font_weight }};
  {%- endif -%}
  --fbh-pt: {{ st.section_top_padding }}px; --fbh-pb: {{ st.section_bottom_padding }}px;
  --fbh-mt-d: {{ st.section_margin_top_desktop }}px; --fbh-mb-d: {{ st.section_margin_bottom_desktop }}px; --fbh-mt-m: {{ st.section_margin_top_mobile }}px; --fbh-mb-m: {{ st.section_margin_bottom_mobile }}px;
  --fbh-read-d: {{ st.read_more_font_size_desktop }}px; --fbh-read-m: {{ st.read_more_font_size_mobile }}px;
  --fbh-title-d: {{ st.featured_title_font_size_desktop }}px; --fbh-title-m: {{ st.featured_title_font_size_mobile }}px;
  --fbh-img-w-d: {{ st.desktop_article_image_width }}%; --fbh-img-h-d: {{ st.desktop_article_image_height }}px; --fbh-img-w-m: {{ st.mobile_article_image_width }}%; --fbh-img-h-m: {{ st.mobile_article_image_height }}px;
  --fbh-brightness: {{ st.article_image_brightness }}; --fbh-img-radius: {{ st.article_image_border_radius }}px; --fbh-card-img-radius: {{ st.custom_article_image_border_radius }}px;
  --fbh-img-z-m: {{ st.article_image_z_index_mobile }}; --fbh-img-y-m: {{ st.article_image_y_index_mobile }}px; --fbh-img-y-d: {{ st.article_image_y_index_desktop }}px;
  --fbh-img-ratio-m: {{ fbh_ratio[0] }} / {{ fbh_ratio[1] }};
  {%- if fbh_own_fonts -%}
  --fbh-title-font: {{ st.title_font.family }}, {{ st.title_font.fallback_families }}; --fbh-title-weight: {{ st.title_font.weight | default: 600 }};
  --fbh-desc-font: {{ st.description_font.family }}, {{ st.description_font.fallback_families }}; --fbh-desc-weight: {{ st.description_font.weight | default: 400 }};
  {%- endif -%}
{%- endcapture -%}
{%- if fbh_own_fonts -%}<style>{{ st.title_font | font_face: font_display: 'swap' }}{{ st.description_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
<style>
  #hero-banner-2-{{ section.id }} [hidden] { display: none !important; }
  #hero-banner-2-{{ section.id }} .fbh-skeleton { display: block; height: 0.8em; width: min(420px, 60vw); max-width: 100%; margin: 0.1em auto; border-radius: 6px; background: rgb(255 255 255 / 0.35); }
  #hero-banner-2-{{ section.id }} .fbh-skeleton--line { height: 12px; width: min(520px, 70vw); margin: 10px auto; }
  #hero-banner-2-{{ section.id }} .featured_main3-image.fbh-empty { background-color: color-mix(in srgb, var(--color-background) 35%, rgb(0 0 0)); }
  #hero-banner-2-{{ section.id }} .featured_link3:not([href]) { cursor: default; }
  #hero-banner-2-{{ section.id }} .featured_link3[data-own-shape] { --mb-radius: var(--fbh-btn-radius); --mb-border-width: var(--fbh-btn-bw); --mb-weight: var(--fbh-btn-weight); --mb-font-size: var(--fbh-read-d); }
  @media (max-width: 767px) { #hero-banner-2-{{ section.id }} .featured_link3[data-own-shape] { --mb-font-size: var(--fbh-read-m); } }
  #hero-banner-2-{{ section.id }} .featured_link3:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }}.ti-reveal-ready { opacity: 1; transform: none; transition: none; }
    #hero-banner-2-{{ section.id }} :is(.featured_link3, .featured_main3-image, .featured_item-info3 a) { transition: none !important; }
  }
{%- comment -%} Every value below is a variable on #hero-banner-2, printed with the page and changed in place by shopify/assets/live-collection-pages.js. {%- endcomment -%}
  /* ✅ Strong, unambiguous targeting using the unique section ID */
  #hero-banner-2-{{ section.id }} {
    background-color: var(--fbh-bg) !important;
    padding-top: var(--fbh-pt) !important;
    padding-bottom: var(--fbh-pb) !important;

    /* Desktop margins (default) */
    margin-top: var(--fbh-mt-d) !important;
    margin-bottom: var(--fbh-mb-d) !important;

    /* Prevent margin-collapsing weirdness at the top */
    display: block;
    overflow: visible;
  }

  /* Mobile overrides for margins */
  @media (max-width: 767px) {
    #hero-banner-2-{{ section.id }} {
      margin-top: var(--fbh-mt-m) !important;
      margin-bottom: var(--fbh-mb-m) !important;
    }
  }

  /* Enhance Featured Article Readability */
  {%- if section.settings.make_more_readable -%}
  #hero-banner-2-{{ section.id }} .featured_main3 {
    box-shadow: inset 0 0 0 1000px rgba(0,0,0,.2);
  }
  {%- endif -%}

  /* Legacy Reverse Setting */
  {%- if section.settings.reverse -%}
  #hero-banner-2-{{ section.id }} .featured_wrapper3 {
    flex-direction: row-reverse;
  }
  {%- endif -%}

  /* Button Styles */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    color: var(--fbh-btn-border);
    background-color: transparent;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
    border-radius: var(--fbh-btn-radius);
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    transition: all 0.3s ease;
    font-size: var(--fbh-read-d);
    font-weight: var(--fbh-btn-weight);
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    --mb-bg: var(--fbh-btn-bg); --mb-text: var(--fbh-btn-color); --mb-border: var(--fbh-btn-border);
    --mb-hover-bg: var(--fbh-btn-bg-hover); --mb-hover-text: var(--fbh-btn-color-hover); --mb-hover-border: var(--fbh-btn-border-hover);
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border-radius: var(--fbh-btn-radius);
    border: var(--fbh-btn-bw) solid transparent;
    transition: all 0.3s ease;
    max-width: 180px !important;
    max-width: 145px !important;
    padding: 0.4em 0.1em !important;
    font-size: var(--fbh-read-d);
    font-weight: var(--fbh-btn-weight);
  }
  #hero-banner-2-{{ section.id }} .featured_link3:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-bg);
  }

  /* Description Text Color */
  #hero-banner-2-{{ section.id }} .featured_description3 { color: var(--fbh-overlay-text) !important; }
  #hero-banner-2-{{ section.id }} .featured_item-info3 p { color: var(--fbh-card-text) !important; }
  #hero-banner-2-{{ section.id }} .featured_article3 { color: var(--fbh-overlay-text) !important; }

  /* Title Fonts */
  #hero-banner-2-{{ section.id }} .featured_title3,
  #hero-banner-2-{{ section.id }} .featured_item-info3 h3 {
    font-family: var(--fbh-title-font, var(--heading-font, inherit));
    font-weight: var(--fbh-title-weight, var(--heading-weight, 600));
  }
  #hero-banner-2-{{ section.id }} .featured_description3,
  #hero-banner-2-{{ section.id }} .featured_item-info3 p {
    font-family: var(--fbh-desc-font, var(--body-font, inherit));
    font-weight: var(--fbh-desc-weight, var(--body-weight, 400));
  }

  /* Article Title Colors */
  #hero-banner-2-{{ section.id }} .featured_title3 {
    color: var(--fbh-overlay-title) !important;
    font-size: var(--fbh-title-d);
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 h3 {
    color: var(--color-heading);
    font-size: 16px;
    padding: 10px;
    text-transform: uppercase;
    margin: 0;
    margin-bottom: 5px;
    font-weight: var(--fbh-title-weight, var(--heading-weight, 600));
  }

  /* Button Customizations */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a,
  #hero-banner-2-{{ section.id }} .featured_link3 {
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border-radius: var(--fbh-btn-radius);
    transition: background-color 0.3s ease, color 0.3s ease, border 0.3s ease;
  }

  /* Read More Button Border Colors */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    border-width: var(--fbh-btn-bw);
    border-color: var(--fbh-btn-border) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    border-width: var(--fbh-btn-bw);
    border-color: var(--fbh-btn-border) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover { border-color: var(--fbh-btn-border-hover) !important; }
  #hero-banner-2-{{ section.id }} .featured_link3:hover { border-color: var(--fbh-btn-border-hover) !important; }

  /* Featured Main Image Customizations */
  #hero-banner-2-{{ section.id }} .featured_main3 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 400px;
  }

  #hero-banner-2-{{ section.id }} .featured_main3-image {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: var(--fbh-img-w-d);
    height: var(--fbh-img-h-d);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    filter: brightness(var(--fbh-brightness));
    border-radius: var(--fbh-img-radius);
    z-index: 0;
    transition: all 0.3s ease;
  }

  #hero-banner-2-{{ section.id }} .featured_main3 > *:not(.featured_main3-image) {
    position: relative;
    z-index: 1;
  }

  #hero-banner-2-{{ section.id }} .featured_blocks3 {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }
  #hero-banner-2-{{ section.id }} .featured_item3 {
    flex: 0 1 32%;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border: 1px solid rgba(164, 162, 163, .3);
    box-shadow: 0 2px 6px #0000000d;
  }

  #hero-banner-2-{{ section.id }} .featured_item-info3 { text-align: center; }
  #hero-banner-2-{{ section.id }} .featured_item-info3 h3 {
    font-size: 16px;
    padding: 10px;
    text-transform: uppercase;
    margin: 0;
    margin-bottom: 5px;
    font-weight: var(--fbh-title-weight, var(--heading-weight, 600));
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 p {
    padding-bottom: 10px;
    line-height: 1.2;
    max-width: 80%;
    margin: 0 auto !important;
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    font-size: var(--fbh-read-d);
    font-weight: var(--fbh-btn-weight);
    text-decoration: none;
    border-radius: var(--fbh-btn-radius);
    padding: 2px 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 120px;
    margin: 0 auto;
    width: 100%;
    transition: all 0.3s ease;
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border-color: var(--fbh-btn-border-hover) !important;
  }

  #hero-banner-2-{{ section.id }} .featured_item3 img {
    max-width: 100%;
    max-height: 200px;
    object-fit: cover;
    object-position: center;
    border-radius: var(--fbh-card-img-radius);
  }

  #hero-banner-2-{{ section.id }} .featured_article3 {
    font-size: 16px;
    text-transform: uppercase;
    line-height: 1;
  }
  #hero-banner-2-{{ section.id }} .featured_title3 {
    font-weight: var(--fbh-title-weight, var(--heading-weight, 600));
    text-transform: uppercase;
    font-size: var(--fbh-title-d);
    margin: 0;
    max-width: 60% !important;
    color: var(--fbh-overlay-title)!important;
    padding: 10px 0;
  }
  #hero-banner-2-{{ section.id }} .featured_description3 {
    font-size: 16px;
    line-height: 1.2;
    max-width: 80%;
    margin: 0 auto;
    text-align: center;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    text-decoration: none;
    font-size: var(--fbh-read-d);
    font-weight: var(--fbh-btn-weight);
    text-transform: uppercase;
    border-radius: var(--fbh-btn-radius);
    padding: 5px 0;
    margin-top: 20px;
    text-align: center;
    max-width: 200px;
    width: 100%;
    transition: all 0.3s ease;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
    display: inline-block;
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border-hover);
  }

  /* Mobile Responsiveness */
  @media (max-width: 767px) {
    #hero-banner-2-{{ section.id }} .featured_blocks3 { flex-direction: column; }
    #hero-banner-2-{{ section.id }} .featured_container3 { padding: 0 20px; }
    #hero-banner-2-{{ section.id }} .featured_main3 { min-height: 500px; }
    #hero-banner-2-{{ section.id }} .featured_wrapper3 { flex-direction: column; }
    #hero-banner-2-{{ section.id }} .featured_item3 { margin-top: 0px; }
    #hero-banner-2-{{ section.id }} .featured_article3 { font-size: 16px; }
    #hero-banner-2-{{ section.id }} .featured_title3 { font-size: var(--fbh-title-m); }
    #hero-banner-2-{{ section.id }} .featured_description3 { font-size: 16px; max-width: 90%; }
    #hero-banner-2-{{ section.id }} .featured_item-info3 a { font-size: var(--fbh-read-m); }

    #hero-banner-2-{{ section.id }} .featured_main3-image {
      z-index: var(--fbh-img-z-m);
      top: var(--fbh-img-y-m);

      aspect-ratio: var(--fbh-img-ratio-m);

      width: var(--fbh-img-w-m);
      height: var(--fbh-img-h-m);
      /* Allow auto height if aspect-ratio applies */
      height: auto;
    }

          #hero-banner-2-{{ section.id }} .featured_link3 { font-size: var(--fbh-read-m); }
      #hero-banner-2-{{ section.id }} .featured_item-info3 a { font-size: var(--fbh-read-m); }

    /* A wide or square picture (Picture shape (mobile)) is too short on a phone
       to hold the text over it: the picture sits on top at its shape and the
       text follows in its own panel, in the section's colour scheme. A tall
       picture keeps the text over it, as on desktop. The shape is read from
       --fbh-img-ratio-m, so a live edit and a redraw draw the same. */
    @container style(--fbh-img-ratio-m: 1 / 1) or style(--fbh-img-ratio-m: 4 / 3) or style(--fbh-img-ratio-m: 16 / 9) or style(--fbh-img-ratio-m: 3 / 2) or style(--fbh-img-ratio-m: 2 / 1) or style(--fbh-img-ratio-m: 21 / 9) {
      #hero-banner-2-{{ section.id }} .featured_main3 {
        min-height: 0;
        justify-content: flex-start;
        gap: 12px;
        padding-bottom: 8px;
        --fbh-panel-title: var(--fbh-overlay-title);
        --fbh-panel-text: var(--fbh-overlay-text);
      }
      #hero-banner-2-{{ section.id }} .featured_main3-image {
        position: relative;
        top: auto;
        left: auto;
        transform: none;
        flex: none;
        align-self: center;
        margin: var(--fbh-img-y-m) 0 4px;
      }
      #hero-banner-2-{{ section.id }} .featured_title3 { color: var(--fbh-panel-title) !important; max-width: 100% !important; }
      #hero-banner-2-{{ section.id }} :is(.featured_article3, .featured_description3) { color: var(--fbh-panel-text) !important; }
      /* the white meant for text over the picture gives way to the scheme in the panel */
      @container style(--fbh-overlay-title: #ffffff) {
        #hero-banner-2-{{ section.id }} .featured_main3 { --fbh-panel-title: var(--color-heading); }
      }
      @container style(--fbh-overlay-text: #ffffff) {
        #hero-banner-2-{{ section.id }} .featured_main3 { --fbh-panel-text: var(--color-text); }
      }
    }
  }

  /* Desktop Y Offset for the featured image */
  @media (min-width: 768px) {
    #hero-banner-2-{{ section.id }} .featured_main3-image { top: var(--fbh-img-y-d); }
  }
{% comment %}{% endcomment %}</style>
{%- if fbh_has_article or request.design_mode -%}
{%- if __ti_reveal and __ti_scroll_animation != 'none' and request.design_mode != true -%}
<script>
  (function(){
    var sec = document.getElementById('shopify-section-{{ section.id }}');
    if (!sec) return;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sec.classList.add('ti-reveal-ready');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) {
            e.target.classList.add('ti-reveal-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      io.observe(sec);
    } else {
      sec.classList.add('ti-reveal-in');
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<div
  class="ti-section-wrap {{ section.settings.section_width | default: 'container' }} color-{{ color_scheme }} gradient"
  data-lcp="featured-blog-header"
  data-lcp-id="{{ section.id }}"
  data-lcp-settings="{{ section.settings | json | escape }}"
>
<div id="hero-banner-2-{{ section.id }}" class="loudecomz custom-blog" style="{{ fbh_vars | strip_newlines | strip }}">
  <div class="featured_custom3">
    <div class="featured_container3">
      <div class="featured_wrapper3">
        {%- for block in section.blocks limit: 1 -%}
          {%- assign fbh_article = block.settings.article -%}
          <!-- Featured article -->
          <div class="featured_main3" data-lcp-block="{{ block.id }}" data-lcp-block-type="article" data-lcp-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>
            <!-- Inner div to handle the background image + brightness, size, etc. -->
            <div
              {% if block.settings.custom_image %}
                class="featured_main3-image"
                style="background-image: url({{ block.settings.custom_image | image_url: width: 1600 }});"
              {% elsif fbh_article.image %}
                class="featured_main3-image"
                style="background-image: url({{ fbh_article.image | image_url: width: 1600 }});"
              {% else %}
                class="featured_main3-image fbh-empty"
              {% endif %}
            ></div>

            <!-- Editable label for 'Featured Article' text -->
            <span class="featured_article3" data-lcp-fallback="{{ fb_accessibility_featured_article | escape }}">
              {{ section.settings.featured_article_label | default: fb_accessibility_featured_article }}
            </span>

            <!-- Title -->
            <h2 class="featured_title3"{% if fbh_own_fonts %} data-own-font data-own-weight{% endif %}>
              {%- if fbh_article.title != blank -%}
                {{ fbh_article.title | escape }}
              {%- else -%}
                <span class="fbh-skeleton" aria-hidden="true"></span>
              {%- endif -%}
            </h2>

            <!-- Description -->
            <div class="featured_description3"{% if fbh_own_fonts %} data-own-font data-own-weight{% endif %}{% if section.settings.remove_description_text %} hidden{% endif %}>
              {%- if fbh_article.content != blank -%}
                {{ fbh_article.content | truncate: 200 }}
              {%- else -%}
                <span class="fbh-skeleton fbh-skeleton--line" aria-hidden="true"></span><span class="fbh-skeleton fbh-skeleton--line" aria-hidden="true"></span>
              {%- endif -%}
            </div>

            <!-- Button -->
            <a {% if fbh_article.url != blank %}href="{{ fbh_article.url }}" {% endif %}class="featured_link3" data-theme-button="primary" data-sl-button{% if section.settings.use_theme_button == false %} data-own-shape{% endif %}{% if section.settings.hide_read_more_button %} hidden{% endif %}>{{ section.settings.button_text }}</a>
          </div>
        {%- endfor -%}

        <!-- Additional blocks (the section holds one block; kept for saved pages) -->
        <div class="featured_blocks3">
          {%- for block in section.blocks offset: 1 -%}
            <div class="featured_blocks-block3 featured_item3">
              {%- if block.settings.custom_image -%}
                {{
                  block.settings.custom_image
                  | image_url: width: 1600
                  | image_tag: alt: block.settings.article.title
                }}
              {%- elsif block.settings.article.image -%}
                {{
                  block.settings.article.image
                  | image_url: width: 1600
                  | image_tag: alt: block.settings.article.title
                }}
              {%- else -%}
                <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E" alt="" width="400" height="300" loading="lazy">
              {%- endif -%}

              <div class="featured_item-info3">
                <h3>{{ block.settings.article.title | escape }}</h3>
                <p{% if section.settings.remove_description_text %} hidden{% endif %}>{{ block.settings.article.excerpt | strip_html }}</p>
                <a {% if block.settings.article.url != blank %}href="{{ block.settings.article.url }}" {% endif %}class="featured_link3" data-theme-button="primary" data-sl-button{% if section.settings.use_theme_button == false %} data-own-shape{% endif %}{% if section.settings.hide_read_more_button %} hidden{% endif %}>{{ section.settings.button_text }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

</div>
{%- endif -%}
<!-- ti-theme:end -->


</template>

