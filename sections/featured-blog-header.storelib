      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_border_color",
        "label": "Button border",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_border_hover_color",
        "label": "Button border (hover)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Buttons"
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Use theme button shape",
        "default": true
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button corner radius",
        "default": 25,
        "min": 0,
        "max": 50,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "read_more_button_border_weight",
        "label": "Button border width",
        "default": 2,
        "min": 0,
        "max": 5,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "read_more_font_weight",
        "label": "Button text weight",
        "default": 600,
        "min": 100,
        "max": 900,
        "step": 100,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "use_theme_fonts",
        "label": "Use theme fonts",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "title_font",
        "default": "assistant_n4",
        "label": "Title font",
        "visible_if": "{{ section.settings.use_theme_fonts == false }}"
      },
      {
        "type": "font_picker",
        "id": "description_font",
        "default": "assistant_n4",
        "label": "Text font",
        "visible_if": "{{ section.settings.use_theme_fonts == false }}"
      },
      {
        "type": "range",
        "id": "featured_title_font_size_desktop",
        "label": "Title size",
        "default": 30,
        "min": 16,
        "max": 60,
        "step": 1
      },
      {
        "type": "range",
        "id": "featured_title_font_size_mobile",
        "label": "Title size (mobile)",
        "default": 24,
        "min": 16,
        "max": 60,
        "step": 1
      },
      {
        "type": "range",
        "id": "read_more_font_size_desktop",
        "label": "Button text size",
        "default": 16,
        "min": 10,
        "max": 30,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "read_more_font_size_mobile",
        "label": "Button text size (mobile)",
        "default": 14,
        "min": 10,
        "max": 30,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Follows the theme animation setting; off under reduced motion."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "section_top_padding",
        "label": "Top padding",
        "default": 0,
        "min": 0,
        "max": 200,
        "step": 10
      },
      {
        "type": "range",
        "id": "section_bottom_padding",
        "label": "Bottom padding",
        "default": 0,
        "min": 0,
        "max": 200,
        "step": 10
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin",
        "default": 0,
        "min": -200,
        "max": 400,
        "step": 10
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin",
        "default": 0,
        "min": -200,
        "max": 400,
        "step": 10
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "mobile_article_image_width",
        "label": "Picture width (mobile, %)",
        "default": 100,
        "min": 10,
        "max": 200,
        "step": 10
      },
      {
        "type": "range",
        "id": "mobile_article_image_height",
        "label": "Picture height (mobile)",
        "default": 300,
        "min": 50,
        "max": 800,
        "step": 10,
        "hidden": true,
        "info": "Legacy: on phones the picture takes its mobile shape.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "select",
        "id": "article_image_ratio_mobile",
        "label": "Picture shape (mobile)",
        "default": "16-9",
        "options": [
          {
            "value": "1-1",
            "label": "1:1"
          },
          {
            "value": "4-3",
            "label": "4:3"
          },
          {
            "value": "16-9",
            "label": "16:9"
          },
          {
            "value": "3-2",
            "label": "3:2"
          },
          {
            "value": "2-1",
            "label": "2:1"
          },
          {
            "value": "21-9",
            "label": "21:9"
          },
          {
            "value": "9-16",
            "label": "9:16"
          },
          {
            "value": "3-4",
            "label": "3:4"
          },
          {
            "value": "2-3",
            "label": "2:3"
          },
          {
            "value": "4-5",
            "label": "4:5"
          },
          {
            "value": "5-7",
            "label": "5:7"
          }
        ]
      },
      {
        "type": "range",
        "id": "article_image_z_index_mobile",
        "label": "Picture layer (mobile)",
        "default": 0,
        "min": 0,
        "max": 990,
        "step": 10
      },
      {
        "type": "range",
        "id": "article_image_y_index_mobile",
        "label": "Picture offset from top (mobile)",
        "default": 0,
        "min": -200,
        "max": 200,
        "step": 10
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "default": 0,
        "min": -200,
        "max": 400,
        "step": 10
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "default": 0,
        "min": -200,
        "max": 400,
        "step": 10
      }
    ],
    "blocks": [
      {
        "type": "article",
        "name": "Post",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "article",
            "id": "article",
            "label": "Post"
          },
          {
            "type": "header",
            "content": "Media"
          },
          {
            "type": "image_picker",
            "id": "custom_image",
            "label": "Picture",
            "info": "Empty uses the post's own picture."
          }
        ]
      }
    ]
  }
}
</schema>