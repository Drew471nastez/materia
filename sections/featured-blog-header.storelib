<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_featured_article = 'accessibility.featured_article' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* AGGRESSIVE theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Reveal-on-scroll */
  #shopify-section-{{ section.id }}.ti-reveal-ready {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  #shopify-section-{{ section.id }}.ti-reveal-in {
    opacity: 1;
    transform: translateY(0);
  }
  /* The ti-section-wrap inherits container/fluid_container/stretch_width/full_width
     from the theme's existing CSS. We just ensure the wrapper itself doesn't
     double-pad the section. */
  #shopify-section-{{ section.id }} > .ti-section-wrap {
    box-sizing: border-box;
  }
  /* Reset spacing — flatten margins between adjacent sections when toggled */
  {% if section.settings.reset_spacing %}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {% endif %}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia: the hero promotes an article. With no block pointing at a published
  article it would show "Featured Blog Title" and a Read more link to nowhere,
  so visitors see nothing until one is picked; the builder still shows it.
{%- endcomment -%}
{%- liquid
  assign fbh_has_article = false
  for block in section.blocks
    if block.settings.article.url != blank
      assign fbh_has_article = true
    endif
  endfor
-%}
{%- if fbh_has_article or request.design_mode -%}
{%- if __ti_reveal and __ti_scroll_animation != 'none' -%}
<script>
  (function(){
    var sec = document.getElementById('shopify-section-{{ section.id }}');
    if (!sec) return;
    sec.classList.add('ti-reveal-ready');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) {
            e.target.classList.add('ti-reveal-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      io.observe(sec);
    } else {
      sec.classList.add('ti-reveal-in');
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<div class="ti-section-wrap {{ section.settings.section_width | default: 'container' }} color-{{ color_scheme }} gradient">
{%- comment -%}
  /sections/hero-banner-2.liquid
  WHY: `presets` removed so this section is hidden from the Theme Editor's “Add section” search.
{%- endcomment -%}

<div id="hero-banner-2-{{ section.id }}" class="loudecomz custom-blog">
  <div class="featured_custom3">
    <div class="featured_container3">
      <div class="featured_wrapper3">
        {%- for block in section.blocks limit: 1 -%}
          <!-- Featured article -->
          <div class="featured_main3">
            <!-- Inner div to handle the background image + brightness, size, etc. -->
            <div
              class="featured_main3-image"
              {% if block.settings.custom_image %}
                style="
                  background-image: url({{ block.settings.custom_image | image_url: width: 1600 }});
                "
              {% elsif block.settings.article.image %}
                style="
                  background-image: url({{ block.settings.article.image | image_url: width: 1600 }});
                "
              {% else %}
                style="background-color: rgba(var(--color-heading-rgb), 0.08);"
              {% endif %}
            ></div>

            <!-- Editable label for 'Featured Article' text -->
            <span class="featured_article3">
              {{ section.settings.featured_article_label | default: fb_accessibility_featured_article }}
            </span>

            <!-- Title -->
            <h3 class="featured_title3">
              {%- liquid
                if block.settings.article.title
                  echo block.settings.article.title
                else
                  echo 'Featured Blog Title'
                endif
              -%}
            </h3>

            <!-- Description -->
            <div class="featured_description3">
              {%- liquid
                unless section.settings.remove_description_text
                  if block.settings.article.content
                    echo block.settings.article.content | truncate: 200
                  else
                    echo 'Lorem ipsum dolor, sit amet consectetur adipisicing elit. Molestias iste corporis cumque perspiciatis tenetur reprehenderit nam, ipsum consequatur laudantium optio.'
                  endif
                endunless
              -%}
            </div>

            <!-- Button -->
            {% unless section.settings.hide_read_more_button %}
              <a href="{{ block.settings.article.url }}" class="featured_link3" data-theme-button="primary" data-sl-button>
                {{ section.settings.button_text }}
              </a>
            {% endunless %}
          </div>
        {%- endfor -%}

        <!-- Additional blocks -->
        <div class="featured_blocks3">
          {%- for block in section.blocks offset: 1 -%}
            <div class="featured_blocks-block3 featured_item3">
              {%- if block.settings.custom_image -%}
                {{
                  block.settings.custom_image
                  | image_url: width: 1600
                  | image_tag: alt: block.settings.article.title
                }}
              {%- elsif block.settings.article.image -%}
                {{
                  block.settings.article.image
                  | image_url: width: 1600
                  | image_tag: alt: block.settings.article.title
                }}
              {%- else -%}
                <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E" alt="" width="400" height="300" loading="lazy">
              {%- endif -%}

              <div class="featured_item-info3">
                <h4>
                  {%- liquid
                    if block.settings.article.title
                      echo block.settings.article.title
                    else
                      echo 'Article Title'
                    endif
                  -%}
                </h4>
                <p>
                  {%- liquid
                    unless section.settings.remove_description_text
                      if block.settings.article.excerpt
                        echo block.settings.article.excerpt
                      else
                        echo 'Intro to article'
                      endif
                    endunless
                  -%}
                </p>
                {% unless section.settings.hide_read_more_button %}
                  <a href="{{ block.settings.article.url }}" class="featured_link3" data-theme-button="primary" data-sl-button>
                    {{ section.settings.button_text }}
                  </a>
                {% endunless %}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

</div>
{%- endif -%}
<!-- ti-theme:end -->



{% style %}
  {%- if section.settings.use_theme_fonts == false -%}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.description_font | font_face: font_display: 'swap' }}
  {%- endif -%}


  #hero-banner-2-{{ section.id }} {
    --fbh-btn-bg: {% render 'scheme-color', color: section.settings.button_bg_color, fallback: 'var(--btn-primary-bg-color)' %};
    --fbh-btn-bg-hover: {% render 'scheme-color', color: section.settings.button_bg_hover_color, fallback: 'var(--btn-primary-hover-bg-color)' %};
    --fbh-btn-color: {% render 'scheme-color', color: section.settings.button_text_color, fallback: 'var(--btn-primary-color)' %};
    --fbh-btn-color-hover: {% render 'scheme-color', color: section.settings.button_text_color, fallback: 'var(--btn-primary-hover-color)' %};
    --fbh-btn-border: {% render 'scheme-color', color: section.settings.button_border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
    --fbh-btn-border-hover: {% render 'scheme-color', color: section.settings.button_border_hover_color, fallback: 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))' %};
    --fbh-overlay-text: {% render 'scheme-color', color: section.settings.description_maintext_color, fallback: '#ffffff' %};
    --fbh-overlay-title: {% render 'scheme-color', color: section.settings.featured_title_text_color, fallback: '#ffffff' %};
    {%- if section.settings.use_theme_button != false -%}
    --fbh-btn-radius: var(--btn-radius, 25px);
    --fbh-btn-bw: var(--btn-border-width, 2px);
    --fbh-btn-weight: var(--btn-font-weight, 600);
    {%- else -%}
    --fbh-btn-radius: {{ section.settings.button_border_radius }}px;
    --fbh-btn-bw: {{ section.settings.read_more_button_border_weight }}px;
    --fbh-btn-weight: {{ section.settings.read_more_font_weight }};
    {%- endif -%}
  }
  /* ✅ Strong, unambiguous targeting using the unique section ID */
  #hero-banner-2-{{ section.id }} {
    background-color: {% render 'scheme-color', color: section.settings.section_bg_color, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ section.settings.section_top_padding }}px !important;
    padding-bottom: {{ section.settings.section_bottom_padding }}px !important;

    /* Desktop margins (default) */
    margin-top: {{ section.settings.section_margin_top_desktop }}px !important;
    margin-bottom: {{ section.settings.section_margin_bottom_desktop }}px !important;

    /* Prevent margin-collapsing weirdness at the top */
    display: block;
    overflow: visible;
  }

  /* Mobile overrides for margins */
  @media (max-width: 767px) {
    #hero-banner-2-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_mobile }}px !important;
      margin-bottom: {{ section.settings.section_margin_bottom_mobile }}px !important;
    }
  }

  /* Enhance Featured Article Readability */
  {%- if section.settings.make_more_readable -%}
  #hero-banner-2-{{ section.id }} .featured_main3 {
    box-shadow: inset 0 0 0 1000px rgba(0,0,0,.2);
  }
  {%- endif -%}

  /* Legacy Reverse Setting */
  {%- if section.settings.reverse -%}
  #hero-banner-2-{{ section.id }} .featured_wrapper3 {
    flex-direction: row-reverse;
  }
  {%- endif -%}

  /* Button Styles */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    color: var(--fbh-btn-border);
    background-color: transparent;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
    border-radius: var(--fbh-btn-radius);
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    transition: all 0.3s ease;
    font-size: {{ section.settings.read_more_font_size_desktop }}px;
    font-weight: var(--fbh-btn-weight);
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    --mb-bg: var(--fbh-btn-bg); --mb-text: var(--fbh-btn-color); --mb-border: var(--fbh-btn-border);
    --mb-hover-bg: var(--fbh-btn-bg-hover); --mb-hover-text: var(--fbh-btn-color-hover); --mb-hover-border: var(--fbh-btn-border-hover);
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border-radius: var(--fbh-btn-radius);
    border: var(--fbh-btn-bw) solid transparent;
    transition: all 0.3s ease;
    max-width: 180px !important;
    max-width: 145px !important;
    padding: 0.4em 0.1em !important;
    font-size: {{ section.settings.read_more_font_size_desktop }}px;
    font-weight: var(--fbh-btn-weight);
  }
  #hero-banner-2-{{ section.id }} .featured_link3:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-bg);
  }

  /* Description Text Color */
  #hero-banner-2-{{ section.id }} .featured_description3 { color: var(--fbh-overlay-text) !important; }
  #hero-banner-2-{{ section.id }} .featured_item-info3 p { color: {% render 'scheme-color', color: section.settings.description_maintext_color, fallback: 'var(--color-text)' %} !important; }
  #hero-banner-2-{{ section.id }} .featured_article3 { color: var(--fbh-overlay-text) !important; }

  /* Title Fonts */
  #hero-banner-2-{{ section.id }} .featured_title3,
  #hero-banner-2-{{ section.id }} .featured_item-info3 h4 {
    {%- if section.settings.use_theme_fonts != false -%}
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 600);
    {%- else -%}
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-weight: {{ section.settings.title_font.weight }};
    {%- endif -%}
  }
  #hero-banner-2-{{ section.id }} .featured_description3,
  #hero-banner-2-{{ section.id }} .featured_item-info3 p {
    {%- if section.settings.use_theme_fonts != false -%}
    font-family: var(--body-font, inherit);
    font-weight: var(--body-weight, 400);
    {%- else -%}
    font-family: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
    font-weight: {{ section.settings.description_font.weight }};
    {%- endif -%}
  }

  /* Article Title Colors */
  #hero-banner-2-{{ section.id }} .featured_title3 {
    color: var(--fbh-overlay-title) !important;
    font-size: {{ section.settings.featured_title_font_size_desktop }}px;
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 h4 {
    color: var(--color-heading);
    font-size: 16px;
    padding: 10px;
    text-transform: uppercase;
    margin: 0;
    margin-bottom: 5px;
    font-weight: {% if section.settings.use_theme_fonts != false %}var(--heading-weight, 600){% else %}{{ section.settings.title_font.weight | default: 600 }}{% endif %};
  }

  /* Button Customizations */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a,
  #hero-banner-2-{{ section.id }} .featured_link3 {
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border-radius: var(--fbh-btn-radius);
    transition: background-color 0.3s ease, color 0.3s ease, border 0.3s ease;
  }

  /* Read More Button Border Colors */
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    border-width: var(--fbh-btn-bw);
    border-color: var(--fbh-btn-border) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    border-width: var(--fbh-btn-bw);
    border-color: var(--fbh-btn-border) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover { border-color: var(--fbh-btn-border-hover) !important; }
  #hero-banner-2-{{ section.id }} .featured_link3:hover { border-color: var(--fbh-btn-border-hover) !important; }

  /* Featured Main Image Customizations */
  #hero-banner-2-{{ section.id }} .featured_main3 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 400px;
  }

  #hero-banner-2-{{ section.id }} .featured_main3-image {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.desktop_article_image_width }}%;
    height: {{ section.settings.desktop_article_image_height }}px;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    filter: brightness({{ section.settings.article_image_brightness }});
    border-radius: {{ section.settings.article_image_border_radius }}px;
    z-index: 0;
    transition: all 0.3s ease;
  }

  #hero-banner-2-{{ section.id }} .featured_main3 > *:not(.featured_main3-image) {
    position: relative;
    z-index: 1;
  }

  #hero-banner-2-{{ section.id }} .featured_blocks3 {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }
  #hero-banner-2-{{ section.id }} .featured_item3 {
    flex: 0 1 32%;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border: 1px solid rgba(164, 162, 163, .3);
    box-shadow: 0 2px 6px #0000000d;
  }

  #hero-banner-2-{{ section.id }} .featured_item-info3 { text-align: center; }
  #hero-banner-2-{{ section.id }} .featured_item-info3 h4 {
    font-size: 16px;
    padding: 10px;
    text-transform: uppercase;
    margin: 0;
    margin-bottom: 5px;
    font-weight: {% if section.settings.use_theme_fonts != false %}var(--heading-weight, 600){% else %}{{ section.settings.title_font.weight | default: 600 }}{% endif %};
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 p {
    padding-bottom: 10px;
    line-height: 1.2;
    max-width: 80%;
    margin: 0 auto !important;
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a {
    font-size: {{ section.settings.read_more_font_size_desktop }}px;
    font-weight: var(--fbh-btn-weight);
    text-decoration: none;
    border-radius: var(--fbh-btn-radius);
    padding: 2px 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 120px;
    margin: 0 auto;
    width: 100%;
    transition: all 0.3s ease;
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
  }
  #hero-banner-2-{{ section.id }} .featured_item-info3 a:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border-color: var(--fbh-btn-border-hover) !important;
  }

  #hero-banner-2-{{ section.id }} .featured_item3 img {
    max-width: 100%;
    max-height: 200px;
    object-fit: cover;
    object-position: center;
    border-radius: {{ section.settings.custom_article_image_border_radius }}px;
  }

  #hero-banner-2-{{ section.id }} .featured_article3 {
    font-size: 16px;
    text-transform: uppercase;
    line-height: 1;
  }
  #hero-banner-2-{{ section.id }} .featured_title3 {
    font-weight: {% if section.settings.use_theme_fonts != false %}var(--heading-weight, 600){% else %}{{ section.settings.title_font.weight | default: 600 }}{% endif %};
    text-transform: uppercase;
    font-size: {{ section.settings.featured_title_font_size_desktop }}px;
    margin: 0;
    max-width: 60% !important;
    color: var(--fbh-overlay-title)!important;
    padding: 10px 0;
  }
  #hero-banner-2-{{ section.id }} .featured_description3 {
    font-size: 16px;
    line-height: 1.2;
    max-width: 80%;
    margin: 0 auto;
    text-align: center;
  }
  #hero-banner-2-{{ section.id }} .featured_link3 {
    text-decoration: none;
    font-size: {{ section.settings.read_more_font_size_desktop }}px;
    font-weight: var(--fbh-btn-weight);
    text-transform: uppercase;
    border-radius: var(--fbh-btn-radius);
    padding: 5px 0;
    margin-top: 20px;
    text-align: center;
    max-width: 200px;
    width: 100%;
    transition: all 0.3s ease;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border);
    display: inline-block;
    background-color: var(--fbh-btn-bg) !important;
    color: var(--fbh-btn-color) !important;
  }
  #hero-banner-2-{{ section.id }} .featured_link3:hover {
    background-color: var(--fbh-btn-bg-hover) !important;
    color: var(--fbh-btn-color-hover) !important;
    border: var(--fbh-btn-bw) solid var(--fbh-btn-border-hover);
  }

  /* Mobile Responsiveness */
  @media (max-width: 767px) {
    #hero-banner-2-{{ section.id }} .featured_blocks3 { flex-direction: column; }
    #hero-banner-2-{{ section.id }} .featured_container3 { padding: 0 20px; }
    #hero-banner-2-{{ section.id }} .featured_main3 { min-height: 500px; }
    #hero-banner-2-{{ section.id }} .featured_wrapper3 { flex-direction: column; }
    #hero-banner-2-{{ section.id }} .featured_item3 { margin-top: 0px; }
    #hero-banner-2-{{ section.id }} .featured_article3 { font-size: 16px; }
    #hero-banner-2-{{ section.id }} .featured_title3 { font-size: {{ section.settings.featured_title_font_size_mobile }}px; }
    #hero-banner-2-{{ section.id }} .featured_description3 { font-size: 16px; max-width: 90%; }
    #hero-banner-2-{{ section.id }} .featured_item-info3 a { font-size: {{ section.settings.read_more_font_size_mobile }}px; }

    #hero-banner-2-{{ section.id }} .featured_main3-image {
      z-index: {{ section.settings.article_image_z_index_mobile }};
      top: {{ section.settings.article_image_y_index_mobile }}px;

      {% assign ratio_value = section.settings.article_image_ratio_mobile %}
      {% assign ratio_split = ratio_value | split: '-' %}
      {% assign ratio_w = ratio_split[0] %}
      {% assign ratio_h = ratio_split[1] %}
      aspect-ratio: {{ ratio_w }} / {{ ratio_h }};

      width: {{ section.settings.mobile_article_image_width }}%;
      height: {{ section.settings.mobile_article_image_height }}px;
      /* Allow auto height if aspect-ratio applies */
      height: auto;
    }

    {% unless section.settings.hide_read_more_button %}
      #hero-banner-2-{{ section.id }} .featured_link3 { font-size: {{ section.settings.read_more_font_size_mobile }}px; }
      #hero-banner-2-{{ section.id }} .featured_item-info3 a { font-size: {{ section.settings.read_more_font_size_mobile }}px; }
    {% endunless %}
  }

  /* Desktop Y Offset for the featured image */
  @media (min-width: 768px) {
    #hero-banner-2-{{ section.id }} .featured_main3-image { top: {{ section.settings.article_image_y_index_desktop }}px; }
  }
{% endstyle %}

{% javascript %}
  /* You can add additional JS here if needed */
{% endjavascript %}

