                "label": "Heart"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "check",
                "label": "Check (guarantee)"
              },
              {
                "value": "headphones",
                "label": "Headphones (support)"
              },
              {
                "value": "envelope",
                "label": "Envelope (email)"
              },
              {
                "value": "chat",
                "label": "Chat bubble"
              },
              {
                "value": "tag",
                "label": "Tag (price)"
              },
              {
                "value": "gift",
                "label": "Gift box"
              },
              {
                "value": "globe",
                "label": "Globe (worldwide)"
              },
              {
                "value": "leaf",
                "label": "Leaf (eco)"
              },
              {
                "value": "award",
                "label": "Award"
              },
              {
                "value": "clock",
                "label": "Clock (24/7)"
              },
              {
                "value": "card",
                "label": "Card (payment)"
              },
              {
                "value": "wallet",
                "label": "Wallet"
              },
              {
                "value": "lightning",
                "label": "Lightning (fast)"
              },
              {
                "value": "recycle",
                "label": "Recycle"
              },
              {
                "value": "sparkle",
                "label": "Sparkle (new)"
              },
              {
                "value": "box",
                "label": "Box (package)"
              },
              {
                "value": "refresh",
                "label": "Refresh (returns)"
              },
              {
                "value": "user",
                "label": "User (account)"
              },
              {
                "value": "calendar",
                "label": "Calendar"
              },
              {
                "value": "handshake",
                "label": "Handshake (trust)"
              },
              {
                "value": "gem",
                "label": "Gem (premium)"
              },
              {
                "value": "organic",
                "label": "Organic (natural)"
              },
              {
                "value": "fire",
                "label": "Fire (hot)"
              },
              {
                "value": "crown",
                "label": "Crown (luxury)"
              }
            ],
            "visible_if": "{{ block.settings.icon_source == 'icon' }}"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "visible_if": "{{ block.settings.icon_source == 'image' }}"
          },
          {
            "type": "checkbox",
            "id": "image_cover",
            "label": "Fill icon box",
            "default": false,
            "visible_if": "{{ block.settings.icon_source == 'image' }}"
          },
          {
            "type": "html",
            "id": "svg_code",
            "label": "SVG code",
            "visible_if": "{{ block.settings.icon_source == 'svg' }}"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Quality you can feel"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Made with materials chosen for comfort, durability, and a refined feel."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Benefits 2",
        "category": "Features",
        "blocks": [
          {
            "type": "top_text"
          },
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "tab",
            "settings": {
              "icon": "shield",
              "title": "Built to last",
              "description": "Premium materials and honest construction — designed to wear in beautifully."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "leaf",
              "title": "Sustainably made",
              "description": "Responsibly sourced and produced with respect for people and planet."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "truck",
              "title": "Free shipping",
              "description": "Complimentary shipping on every order over $50, delivered straight to you."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "refresh",
              "title": "Easy 30-day returns",
              "description": "Not the right fit? Send it back within 30 days for a full refund — no questions."
            }
          }
        ]
