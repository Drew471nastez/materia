            "label": "Accent color"
          },
          {
            "type": "checkbox",
            "id": "accent_italic",
            "label": "Italic accent",
            "default": false
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Thoughtful materials, considered details, and honest pricing — without compromise."
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16
          }
        ]
      },
      {
        "type": "tab",
        "name": "Benefit tab",
        "limit": 8,
        "settings": [
          {
            "type": "header",
            "content": "Visual"
          },
          {
            "type": "select",
            "id": "icon_source",
            "label": "Icon source",
            "default": "icon",
            "options": [
              {
                "value": "icon",
                "label": "Icon from library"
              },
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "svg",
                "label": "Custom SVG code"
              },
              {
                "value": "none",
                "label": "No icon"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "sparkle",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "truck",
                "label": "Truck"
              },
              {
                "value": "shipping",
