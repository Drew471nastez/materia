        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 14,
        "max": 48,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "header",
        "content": "Tab colors"
