        "type": "color",
        "id": "benefit_icon_color",
        "label": "Icon color"
      },
      {
        "type": "color",
        "id": "benefit_icon_box_bg",
        "label": "Icon box background"
      },
      {
        "type": "color",
        "id": "benefit_title_color",
        "label": "Title color"
      },
      {
        "type": "color",
        "id": "benefit_desc_color",
        "label": "Description color"
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background"
      },
      {
        "type": "color",
        "id": "tab_bg",
        "label": "Tab background"
      },
      {
        "type": "color",
        "id": "tab_border",
        "label": "Tab border"
      },
      {
        "type": "color",
        "id": "tab_accent",
        "label": "Tab accent"
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
