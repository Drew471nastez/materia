        "max": 200,
        "step": 4,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "top_text",
        "name": "Top text",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Why customers love it"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 13
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
