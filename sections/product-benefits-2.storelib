<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_product_benefits_image = 'accessibility.product_benefits_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Product Benefits 2: a product picture between two columns
  of benefit blocks, under top text, heading and subheading blocks. Five
  benefit styles, eleven picture shapes, and three phone layouts. Colours
  follow the colour scheme and fonts follow Theme settings > Typography until
  custom styling or custom fonts are switched on. Every value is a CSS
  variable printed here; assets/live-features-c.js works out the same
  variables for live edits.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign style_variant = st.style_variant | default: 'clean'
  assign image_shape = st.image_shape | default: 'soft'
  assign content_align = st.content_alignment | default: 'center'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Ccircle cx=%22172%22 cy=%22174%22 r=%2214%22 fill=%22%23888%22 fill-opacity=%22.35%22/%3E%3Cpath d=%22M140 242l40-46 25 28 20-18 35 36z%22 fill=%22%23888%22 fill-opacity=%22.35%22/%3E%3C/svg%3E'
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign tab_count = tab_blocks.size
  assign half = tab_count | divided_by: 2
  case image_shape
    when 'square'
      assign shape_radius = '0px'
    when 'rounded'
      assign shape_radius = '32px'
    when 'extra-rounded'
      assign shape_radius = '56px'
    when 'pill'
      assign shape_radius = '999px'
    when 'circle'
      assign shape_radius = '50%'
    when 'tab-top'
      assign shape_radius = '999px 999px 16px 16px'
    when 'arch'
      assign shape_radius = '999px 999px 0 0'
    when 'leaf'
      assign shape_radius = '0 80% 0 80%'
    when 'blob'
      assign shape_radius = '60% 40% 50% 50% / 50% 60% 40% 50%'
    else
      assign shape_radius = '16px'
  endcase
  if st.image_radius_custom_enabled
    assign shape_radius = st.image_radius_custom | append: 'px'
  endif
  case content_align
    when 'left'
      assign header_items = 'flex-start'
    when 'right'
      assign header_items = 'flex-end'
    else
      assign header_items = 'center'
  endcase
  assign soft = 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))'
-%}
{%- if fonts -%}{% style %}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% endstyle %}{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .pb2c-wrap {
    display: block;
    margin-top: var(--pb2-mt-m);
    margin-bottom: var(--pb2-mb-m);
    font-family: var(--pb2-bf);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2c-wrap { margin-top: var(--pb2-mt-d); margin-bottom: var(--pb2-mb-d); }
  }
  #shopify-section-{{ sid }} .pb2c {
    background-color: var(--pb2-bg);
    padding-top: var(--pb2-pt-m);
    padding-bottom: var(--pb2-pb-m);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2c { padding-top: var(--pb2-pt-d); padding-bottom: var(--pb2-pb-d); }
  }
  /* Section width */
  #shopify-section-{{ sid }} .pb2c__inner { padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} [data-width='container'] .pb2c__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} [data-width='fluid_container'] .pb2c__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} [data-width='full_width'] .pb2c__inner { padding-inline: 1rem; }
  @media (min-width: 992px) { #shopify-section-{{ sid }} [data-width='full_width'] .pb2c__inner { padding-inline: 0; } }

  /* Header (top text / heading / subheading blocks) */
  #shopify-section-{{ sid }} .pb2c__header {
    text-align: var(--pb2-align);
    margin-bottom: var(--pb2-header-gap);
    display: flex;
    flex-direction: column;
    align-items: var(--pb2-items);
    gap: var(--pb2-block-gap);
  }
  #shopify-section-{{ sid }} .pb2c__header:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .pb2c__top { margin: 0; font-family: var(--pb2-bf); font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; line-height: 1.3; font-size: var(--pb2-top-size); color: var(--pb2-top-color); }
  #shopify-section-{{ sid }} .pb2c__heading { margin: 0; line-height: 1.15; font-family: var(--pb2-hf); font-weight: var(--pb2-h-weight, var(--heading-weight, 700)); color: var(--pb2-h-color); font-size: var(--pb2-h-m); }
  #shopify-section-{{ sid }} .pb2c__accent { color: var(--pb2-acc-color); font-style: var(--pb2-acc-style); }
  #shopify-section-{{ sid }} .pb2c__sub { margin: 0; line-height: 1.55; max-width: 720px; font-family: var(--pb2-bf); font-size: var(--pb2-sub-size); color: var(--pb2-sub-color); }
  #shopify-section-{{ sid }} :is(.pb2c__top, .pb2c__heading, .pb2c__sub, .pb2c__tab-title, .pb2c__tab-desc, .pb2c__tab-icon)[hidden] { display: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2c__heading { font-size: var(--pb2-h-d); }
  }

  /* Main grid: tabs + image */
  #shopify-section-{{ sid }} .pb2c__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pb2-gap);
    align-items: center;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__grid {
      grid-template-columns: 1fr var(--pb2-img-d) 1fr;
      gap: var(--pb2-gap-d);
    }
  }
  #shopify-section-{{ sid }} .pb2c__image-wrap {
    width: var(--pb2-img-m);
    max-width: 100%;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--pb2-radius);
    background-color: var(--pb2-img-bg);
    grid-row: 2;
  }
  #shopify-section-{{ sid }} [data-shape='pill'] .pb2c__image-wrap { aspect-ratio: 3 / 4; }
  #shopify-section-{{ sid }} [data-shape='tilt'] .pb2c__image-wrap { transform: rotate(-2deg); }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__image-wrap {
      width: 100%;
      max-width: var(--pb2-img-d);
      grid-column: 2;
      grid-row: 1 / span 4;
    }
  }
  #shopify-section-{{ sid }} .pb2c__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Phones: where the picture sits among the benefits */
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .pb2c__col--left  { grid-row: 1; }
    #shopify-section-{{ sid }} .pb2c__image-wrap { grid-row: 2; }
    #shopify-section-{{ sid }} .pb2c__col--right { grid-row: 3; }
    #shopify-section-{{ sid }} [data-mobile='image_top'] .pb2c__image-wrap { grid-row: 1; }
    #shopify-section-{{ sid }} [data-mobile='image_top'] .pb2c__col--left  { grid-row: 2; }
    #shopify-section-{{ sid }} [data-mobile='image_bottom'] .pb2c__col--right { grid-row: 2; }
    #shopify-section-{{ sid }} [data-mobile='image_bottom'] .pb2c__image-wrap { grid-row: 3; }
  }

  /* Benefit tabs: five styles */
  #shopify-section-{{ sid }} .pb2c__tab {
    text-align: start;
    padding: var(--pb2-tab-pad);
    background-color: var(--pb2-tab-bg);
    border-radius: var(--pb2-tab-radius);
    box-shadow: 0 4px 12px -8px rgba(0,0,0,.06);
  }
  #shopify-section-{{ sid }} [data-variant='soft-card'] .pb2c__tab { box-shadow: 0 8px 22px -10px rgba(0,0,0,.08); }
  #shopify-section-{{ sid }} [data-variant='outlined'] .pb2c__tab { background-color: transparent; box-shadow: none; border: 1px solid var(--pb2-tab-line); }
  #shopify-section-{{ sid }} [data-variant='minimal'] .pb2c__tab { background-color: transparent; box-shadow: none; border-bottom: 1px solid var(--pb2-tab-line); border-radius: 0; padding-inline: 0; }
  #shopify-section-{{ sid }} [data-variant='accent'] .pb2c__tab { box-shadow: none; border-inline-start: 3px solid var(--pb2-tab-accent); }
  #shopify-section-{{ sid }} .pb2c__tab-row { display: flex; align-items: flex-start; gap: 14px; }
  #shopify-section-{{ sid }} .pb2c__tab-icon {
    flex-shrink: 0;
    width: var(--pb2-ib);
    height: var(--pb2-ib);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--pb2-ib-r);
    background: var(--pb2-ib-bg);
    color: var(--pb2-icon-color);
  }
  #shopify-section-{{ sid }} .pb2c__tab-icon svg,
  #shopify-section-{{ sid }} .pb2c__tab-icon img {
    width: var(--pb2-icon);
    height: var(--pb2-icon);
    object-fit: contain;
  }
  /* Cover-fit picture: it fills the whole icon box, clipped to its corners */
  #shopify-section-{{ sid }} .pb2c__tab-icon.is-cover { overflow: hidden; padding: 0; }
  #shopify-section-{{ sid }} .pb2c__tab-icon.is-cover img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  #shopify-section-{{ sid }} .pb2c__tab-title {
    margin: 0 0 6px;
    font-family: var(--pb2-hf);
    font-size: var(--pb2-title-size);
    line-height: 1.25;
    font-weight: var(--heading-weight, 700);
    color: var(--pb2-title-color);
  }
  #shopify-section-{{ sid }} .pb2c__tab-desc {
    margin: 0;
    font-family: var(--pb2-bf);
    font-size: var(--pb2-desc-size);
    line-height: 1.5;
    color: var(--pb2-desc-color);
  }
  #shopify-section-{{ sid }} .pb2c__col--left,
  #shopify-section-{{ sid }} .pb2c__col--right { grid-column: 1; display: flex; flex-direction: column; gap: var(--pb2-gap); }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__col--left  { grid-column: 1; align-items: flex-end; text-align: right; }
    #shopify-section-{{ sid }} .pb2c__col--right { grid-column: 3; align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .pb2c__col--right .pb2c__tab,
    #shopify-section-{{ sid }} .pb2c__col--left .pb2c__tab { width: 100%; }
  }
{% comment %}{% endcomment %}</style>
{%- capture root_vars -%}
  --pb2-bg: {% if custom %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
  --pb2-img-bg: {% if custom %}{% render 'scheme-color', color: st.image_bg, fallback: soft %}{% else %}{{ soft }}{% endif %};
  --pb2-tab-bg: {% if custom %}{% render 'scheme-color', color: st.tab_bg, fallback: soft %}{% else %}{{ soft }}{% endif %};
  --pb2-tab-line: {% if custom %}{% render 'scheme-color', color: st.tab_border, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
  --pb2-tab-accent: {% if custom %}{% render 'scheme-color', color: st.tab_accent, fallback: 'var(--color-primary)' %}{% else %}var(--color-primary){% endif %};
  --pb2-ib-bg: {% if custom %}{% render 'scheme-color', color: st.benefit_icon_box_bg, fallback: soft %}{% else %}{{ soft }}{% endif %};
  --pb2-icon-color: {% if custom %}{% render 'scheme-color', color: st.benefit_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --pb2-title-color: {% if custom %}{% render 'scheme-color', color: st.benefit_title_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --pb2-desc-color: {% if custom %}{% render 'scheme-color', color: st.benefit_desc_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
  --pb2-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
  --pb2-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
  --pb2-radius: {{ shape_radius }}; --pb2-img-d: {{ st.image_size_desktop | default: 460 }}px; --pb2-img-m: {{ st.image_size_mobile | default: 280 }}px;
  --pb2-align: {{ content_align }}; --pb2-items: {{ header_items }}; --pb2-header-gap: {{ st.gap_header_to_grid | default: 0 }}px; --pb2-block-gap: {{ st.gap_between_header_blocks | default: 0 }}px;
  --pb2-gap: {{ st.tab_gap | default: 0 }}px; --pb2-gap-d: {{ st.tab_gap_desktop | default: 0 }}px;
  --pb2-tab-pad: {{ st.tab_padding | default: 18 }}px; --pb2-tab-radius: {{ st.tab_radius | default: 0 }}px; --pb2-title-size: {{ st.tab_title_size | default: 16 }}px; --pb2-desc-size: {{ st.tab_desc_size | default: 14 }}px;
  --pb2-ib: {{ st.icon_box_size | default: 44 }}px; --pb2-ib-r: {{ st.icon_box_radius | default: 0 }}px; --pb2-icon: {{ st.icon_size | default: 22 }}px;
  --pb2-pt-d: {{ st.padding_top_desktop | default: 0 }}px; --pb2-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px; --pb2-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --pb2-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
  --pb2-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px; --pb2-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px; --pb2-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px; --pb2-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
{%- endcapture -%}
<section class="pb2c-wrap color-{{ color_scheme }} gradient" data-fc-root="product-benefits-2" data-fc-section="{{ sid }}" data-fc-settings="{{ st | json | escape }}" data-width="{{ st.section_width | default: 'container' }}" data-variant="{{ style_variant }}" data-shape="{{ image_shape }}" data-mobile="{{ st.mobile_layout | default: 'image_middle' }}"{% if fonts %} data-own-font{% endif %}{% unless st.reveal %} data-ti-no-reveal{% endunless %} style="{{ root_vars | strip_newlines }}">
  <div class="pb2c">
    <div class="pb2c__inner">
      <div class="pb2c__header">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- capture battrs -%}data-fc-block="{{ block.id }}" data-fc-type="{{ block.type }}" data-fc-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.text == blank %} hidden{% endif %}{%- endcapture -%}
          {%- case block.type -%}
            {%- when 'top_text' -%}
              <p class="pb2c__top" {{ battrs }} style="--pb2-top-size: {{ bs.size | default: 13 }}px; --pb2-top-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-primary)' %}{% else %}var(--color-primary){% endif %};">{{ bs.text | escape }}</p>
            {%- when 'heading' -%}
              {%- assign pb2_h = bs.text -%}
              {%- if bs.enable_accent and bs.accent_text != blank -%}
                {%- assign pb2_acc = bs.accent_text | escape -%}
                {%- capture pb2_acc_html -%}<span class="pb2c__accent">{{ pb2_acc }}</span>{%- endcapture -%}
                {%- assign pb2_h = pb2_h | replace: pb2_acc, pb2_acc_html -%}
              {%- endif -%}
              {%- assign own_w = false -%}
              {%- if bs.weight != blank and bs.weight != 'theme' -%}{%- assign own_w = true -%}{%- endif -%}
              <h2 class="pb2c__heading" {{ battrs }}{% if own_w %} data-own-weight{% endif %} style="--pb2-h-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pb2-h-d: {{ bs.size_desktop | default: 42 }}px; --pb2-h-m: {{ bs.size_mobile | default: 28 }}px;{% if own_w %} --pb2-h-weight: {{ bs.weight }};{% endif %} --pb2-acc-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.accent_color, fallback: 'var(--color-primary)' %}{% else %}var(--color-primary){% endif %}; --pb2-acc-style: {% if bs.accent_italic %}italic{% else %}normal{% endif %};">{{ pb2_h }}</h2>
            {%- when 'subheading' -%}
              <p class="pb2c__sub" {{ battrs }} style="--pb2-sub-size: {{ bs.size | default: 16 }}px; --pb2-sub-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};">{{ bs.text | escape }}</p>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="pb2c__grid">
        {%- for col in (1..2) -%}
          {%- if col == 2 -%}
            <div class="pb2c__image-wrap" data-fc-media>
              {%- if st.image -%}
                <img
                  src="{{ st.image | image_url: width: 900 }}"
                  srcset="{{ st.image | image_url: width: 400 }} 400w,
                          {{ st.image | image_url: width: 700 }} 700w,
                          {{ st.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 992px) {{ st.image_size_desktop | default: 460 }}px, 100vw"
                  alt="{{ st.image.alt | default: fb_accessibility_product_benefits_image | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ st.image.width }}"
                  height="{{ st.image.height }}"
                >
              {%- else -%}
                <img data-fc-ph src="{{ placeholder }}" alt="" loading="lazy" decoding="async" width="900" height="900">
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="pb2c__col--{% if col == 1 %}left{% else %}right{% endif %}">
            {%- assign idx = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                {%- liquid
                  assign show = false
                  if col == 1 and idx < half
                    assign show = true
                  elsif col == 2 and idx >= half
                    assign show = true
                  endif
                  assign idx = idx | plus: 1
                -%}
                {%- if show -%}
                  {%- liquid
                    assign bs = block.settings
                    assign icon_source = bs.icon_source | default: 'icon'
                  -%}
                  <div class="pb2c__tab" data-fc-block="{{ block.id }}" data-fc-type="tab" data-fc-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}>
                    <div class="pb2c__tab-row">
                      <span class="pb2c__tab-icon{% if bs.image_cover and icon_source == 'image' and bs.image != blank %} is-cover{% endif %}" aria-hidden="true"{% if icon_source == 'none' %} hidden{% endif %}>
                        {%- case icon_source -%}
                          {%- when 'image' -%}
                            {%- if bs.image -%}
                              <img src="{{ bs.image | image_url: width: 120 }}" alt="" loading="lazy" decoding="async" width="40" height="40">
                            {%- endif -%}
                          {%- when 'svg' -%}
                            {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                          {%- when 'none' -%}
                          {%- else -%}
                            {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
                        {%- endcase -%}
                      </span>
                      <div class="pb2c__tab-body">
                        <h3 class="pb2c__tab-title"{% if bs.title == blank %} hidden{% endif %}>{{ bs.title | escape }}</h3>
                        <p class="pb2c__tab-desc"{% if bs.description == blank %} hidden{% endif %}>{{ bs.description | escape }}</p>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if request.design_mode -%}<template data-fc-icons>{%- assign fc_icons = 'truck,shipping,shield,lock,heart,star,check,headphones,envelope,chat,tag,gift,globe,leaf,award,clock,card,wallet,lightning,recycle,sparkle,box,refresh,user,calendar,handshake,gem,organic,fire,crown' | split: ',' -%}{%- for name in fc_icons -%}<span data-icon="{{ name }}">{% render 'benefits-icon', icon: name, size: 22 %}</span>{%- endfor -%}</template>{%- endif -%}
</section>
</template>

<schema>
{
  "type": "product-benefits-2",
  "name": "Product Benefits 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
