        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "style_variant",
        "label": "Benefit style",
        "default": "clean",
        "options": [
          {
            "value": "clean",
            "label": "Clean (subtle shadow)"
          },
          {
            "value": "soft-card",
            "label": "Soft card"
          },
          {
            "value": "outlined",
            "label": "Outlined"
          },
          {
            "value": "minimal",
            "label": "Minimal (underline only)"
          },
          {
            "value": "accent",
            "label": "Accent stripe"
          }
        ]
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Header alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "tab_padding",
        "label": "Benefit padding",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "tab_radius",
        "label": "Benefit corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 14,
        "visible_if": "{{ section.settings.style_variant != 'minimal' }}"
      },
      {
        "type": "range",
        "id": "icon_box_size",
        "label": "Icon box size",
        "min": 28,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "range",
        "id": "icon_box_radius",
        "label": "Icon box corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 14,
        "max": 48,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "tab_gap",
        "label": "Gap between benefits",
        "min": 6,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "gap_header_to_grid",
        "label": "Space below header",
        "min": 8,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "gap_between_header_blocks",
        "label": "Gap between header blocks",
        "min": 4,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Product image"
      },
      {
        "type": "select",
        "id": "image_shape",
        "label": "Image shape",
        "default": "soft",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "soft",
            "label": "Soft corners"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "extra-rounded",
            "label": "Extra rounded"
          },
          {
            "value": "pill",
            "label": "Pill"
          },
          {
            "value": "circle",
            "label": "Circle"
          },
          {
            "value": "tab-top",
            "label": "Tab top (rounded top)"
          },
          {
            "value": "arch",
            "label": "Arch (flat bottom)"
          },
          {
            "value": "leaf",
            "label": "Leaf (diagonal)"
          },
          {
            "value": "tilt",
            "label": "Tilted"
          },
          {
            "value": "blob",
            "label": "Blob (organic)"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "image_radius_custom_enabled",
        "label": "Custom corner radius",
        "default": false
      },
      {
        "type": "range",
        "id": "image_radius_custom",
        "label": "Corner radius",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 24,
        "visible_if": "{{ section.settings.image_radius_custom_enabled }}"
      },
      {
        "type": "range",
        "id": "image_size_desktop",
        "label": "Image size (desktop)",
        "min": 240,
        "max": 720,
        "step": 10,
        "unit": "px",
        "default": 460
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "image_bg",
        "label": "Image background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "tab_bg",
        "label": "Benefit background",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.style_variant != 'outlined' and section.settings.style_variant != 'minimal' }}"
      },
      {
        "type": "color",
        "id": "tab_border",
        "label": "Benefit border",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.style_variant == 'outlined' or section.settings.enable_custom_style and section.settings.style_variant == 'minimal' }}"
      },
      {
        "type": "color",
        "id": "tab_accent",
        "label": "Benefit accent",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.style_variant == 'accent' }}"
      },
      {
        "type": "color",
        "id": "benefit_icon_color",
        "label": "Icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "benefit_icon_box_bg",
        "label": "Icon box",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "benefit_title_color",
        "label": "Benefit title",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "benefit_desc_color",
        "label": "Benefit text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "tab_title_size",
        "label": "Benefit title size",
        "min": 12,
        "max": 26,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "tab_desc_size",
        "label": "Benefit text size",
        "min": 11,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses Theme settings > Animations."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "tab_gap_desktop",
        "label": "Column gap (desktop)",
        "min": 8,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "select",
        "id": "mobile_layout",
        "label": "Image position (mobile)",
        "default": "image_middle",
        "options": [
          {
            "value": "image_middle",
            "label": "Image in middle"
          },
          {
            "value": "image_top",
            "label": "Image first"
          },
          {
            "value": "image_bottom",
            "label": "Image last"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_size_mobile",
        "label": "Image size (mobile)",
        "min": 200,
        "max": 500,
        "step": 10,
        "unit": "px",
        "default": 280
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "top_text",
        "name": "Top text",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Why customers love it"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 13
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Built for everyday use"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              }
            ],
            "hidden": true,
            "info": "Kept for saved content. The heading is an h2.",
            "visible_if": "{{ false }}"
          },
          {
            "type": "checkbox",
            "id": "enable_accent",
            "label": "Show accent words",
            "default": false
          },
          {
            "type": "text",
            "id": "accent_text",
            "label": "Accent words",
            "info": "Words from the heading to show in the accent colour.",
            "visible_if": "{{ block.settings.enable_accent }}"
          },
          {
            "type": "checkbox",
            "id": "accent_italic",
            "label": "Italic accent",
            "default": false,
            "visible_if": "{{ block.settings.enable_accent }}"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "accent_color",
            "label": "Accent color",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_accent }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 2,
            "unit": "px",
            "default": 42
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 28
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ]
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Thoughtful materials, considered details and honest pricing."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16
          }
        ]
      },
      {
        "type": "tab",
        "name": "Benefit tab",
        "limit": 8,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Quality you can feel"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Made with materials chosen for comfort, durability, and a refined feel."
          },
          {
            "type": "header",
            "content": "Icon"
          },
          {
            "type": "select",
            "id": "icon_source",
            "label": "Icon source",
            "default": "icon",
            "options": [
              {
                "value": "icon",
                "label": "Icon from library"
              },
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "svg",
                "label": "Custom SVG code"
              },
              {
                "value": "none",
                "label": "No icon"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "sparkle",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "truck",
                "label": "Truck"
              },
              {
                "value": "shipping",
                "label": "Shipping arrow"
              },
              {
                "value": "shield",
                "label": "Shield (security)"
              },
              {
                "value": "lock",
                "label": "Lock (privacy)"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "check",
                "label": "Check (guarantee)"
              },
              {
                "value": "headphones",
                "label": "Headphones (support)"
              },
              {
                "value": "envelope",
                "label": "Envelope (email)"
              },
              {
                "value": "chat",
                "label": "Chat bubble"
              },
              {
                "value": "tag",
                "label": "Tag (price)"
              },
              {
                "value": "gift",
                "label": "Gift box"
              },
              {
                "value": "globe",
                "label": "Globe (worldwide)"
              },
              {
                "value": "leaf",
                "label": "Leaf (eco)"
              },
              {
                "value": "award",
                "label": "Award"
              },
              {
                "value": "clock",
                "label": "Clock (24/7)"
              },
              {
                "value": "card",
                "label": "Card (payment)"
              },
              {
                "value": "wallet",
                "label": "Wallet"
              },
              {
                "value": "lightning",
                "label": "Lightning (fast)"
              },
              {
                "value": "recycle",
                "label": "Recycle"
              },
              {
                "value": "sparkle",
                "label": "Sparkle (new)"
              },
              {
                "value": "box",
                "label": "Box (package)"
              },
              {
                "value": "refresh",
                "label": "Refresh (returns)"
              },
              {
                "value": "user",
                "label": "User (account)"
              },
              {
                "value": "calendar",
                "label": "Calendar"
              },
              {
                "value": "handshake",
                "label": "Handshake (trust)"
              },
              {
                "value": "gem",
                "label": "Gem (premium)"
              },
              {
                "value": "organic",
                "label": "Organic (natural)"
              },
              {
                "value": "fire",
                "label": "Fire (hot)"
              },
              {
                "value": "crown",
                "label": "Crown (luxury)"
              }
            ],
            "visible_if": "{{ block.settings.icon_source == 'icon' }}"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Picture",
            "visible_if": "{{ block.settings.icon_source == 'image' }}"
          },
          {
            "type": "checkbox",
            "id": "image_cover",
            "label": "Fill icon box",
            "default": false,
            "visible_if": "{{ block.settings.icon_source == 'image' }}"
          },
          {
            "type": "html",
            "id": "svg_code",
            "label": "SVG code",
            "visible_if": "{{ block.settings.icon_source == 'svg' }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Benefits 2",
        "category": "Features",
        "blocks": [
          {
            "type": "top_text"
          },
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "tab",
            "settings": {
              "icon": "shield",
              "title": "Built to last",
              "description": "Premium materials and honest construction, made to wear in well."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "leaf",
              "title": "Sustainably made",
              "description": "Responsibly sourced and produced with respect for people and planet."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "truck",
              "title": "Shipping",
              "description": "Tell customers how and when their order ships."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "refresh",
              "title": "Easy returns",
              "description": "Explain your return policy in a sentence."
            }
          }
        ]
      }
    ]
  }
}
</schema>