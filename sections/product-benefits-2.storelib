            "min": 16,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 28
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
