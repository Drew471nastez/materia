              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ]
          },
          {
            "type": "header",
            "content": "Accent"
          },
          {
            "type": "checkbox",
            "id": "enable_accent",
