<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_product_benefits_image = 'accessibility.product_benefits_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Product Benefits 2
  A flexible product-image + benefit-tabs section. Supports:
    • 5 visual style variants (clean / soft-card / outlined / minimal / accent)
    • 6 image shape options (square / soft / rounded / pill / circle / blob)
    • Adjustable image size + radius + gap between tabs + tab count
    • Mobile layout: 2 tabs above image / 2 below (auto if more, all below image)
    • Heading / top-text / subheading as blocks
    • Tabs as blocks — each tab supports image picker, custom SVG, OR icon from
      the 30-icon library, plus title / description / colors per tab
    • Default placeholder image when none uploaded
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign style_variant = st.style_variant | default: 'clean'
  assign image_shape = st.image_shape | default: 'soft'
  assign content_align = st.content_alignment | default: 'center'
  assign mobile_layout = st.mobile_layout | default: 'image_middle'

  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E'

  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign content_blocks = section.blocks | where: 'type', 'top_text'
  assign content_blocks2 = section.blocks | where: 'type', 'heading'
  assign content_blocks3 = section.blocks | where: 'type', 'subheading'

  assign tab_count = tab_blocks.size
  assign half = tab_count | divided_by: 2

  case image_shape
    when 'square'
      assign image_radius = 0
    when 'soft'
      assign image_radius = 16
    when 'rounded'
      assign image_radius = 32
    when 'extra-rounded'
      assign image_radius = 56
    when 'pill'
      assign image_radius = 999
    when 'circle'
      assign image_radius = 9999
    when 'tab-top'
      assign image_radius = 0
    when 'arch'
      assign image_radius = 0
    when 'leaf'
      assign image_radius = 0
    when 'tilt'
      assign image_radius = 16
    when 'blob'
      assign image_radius = 0
    else
      assign image_radius = 16
  endcase

  if st.image_radius_custom_enabled
    assign image_radius = st.image_radius_custom
  endif
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Margins + reset spacing */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Section wrapper */
  #shopify-section-{{ sid }} .pb2c {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2c {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb2c__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb2c__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .pb2c__inner { padding-inline: 1rem; }
      @media (min-width: 992px) { #shopify-section-{{ sid }} .pb2c__inner { padding-inline: 0; } }
    {%- else -%}
      #shopify-section-{{ sid }} .pb2c__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Header (top text / heading / subheading blocks) */
  #shopify-section-{{ sid }} .pb2c__header {
    text-align: {{ content_align }};
    margin-bottom: {{ st.gap_header_to_grid | default: 36 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if content_align == 'left' -%} flex-start
      {%- elsif content_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    gap: {{ st.gap_between_header_blocks | default: 10 }}px;
  }
  #shopify-section-{{ sid }} .pb2c__top { margin: 0; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; line-height: 1.3; }
  #shopify-section-{{ sid }} .pb2c__heading { margin: 0; line-height: 1.15; }
  #shopify-section-{{ sid }} .pb2c__sub { margin: 0; line-height: 1.55; max-width: 720px; }

  /* Main grid: tabs + image */
  #shopify-section-{{ sid }} .pb2c__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.tab_gap | default: 20 }}px;
    align-items: center;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__grid {
      grid-template-columns: 1fr {{ st.image_size_desktop | default: 460 }}px 1fr;
      gap: {{ st.tab_gap_desktop | default: 32 }}px;
    }
  }

  /* Image — with shape-based radius (or custom) */
  #shopify-section-{{ sid }} .pb2c__image-wrap {
    width: {{ st.image_size_mobile | default: 280 }}px;
    max-width: 100%;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ image_radius }}px;
    {%- if image_shape == 'blob' -%}
      border-radius: 60% 40% 50% 50% / 50% 60% 40% 50%;
    {%- elsif image_shape == 'tab-top' -%}
      border-radius: 999px 999px 16px 16px;
    {%- elsif image_shape == 'arch' -%}
      border-radius: 999px 999px 0 0;
    {%- elsif image_shape == 'leaf' -%}
      border-radius: 0 80% 0 80%;
    {%- elsif image_shape == 'tilt' -%}
      border-radius: 16px;
      transform: rotate(-2deg);
    {%- endif -%}
    background-color: {% render 'scheme-color', color: st.image_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
    grid-row: 2;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__image-wrap {
      width: 100%;
      max-width: {{ st.image_size_desktop | default: 460 }}px;
      grid-column: 2;
      grid-row: 1 / span 4;
    }
  }
  #shopify-section-{{ sid }} .pb2c__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile layout: image position relative to tabs */
  @media (max-width: 991.98px) {
    {%- case mobile_layout -%}
      {%- when 'image_top' -%}
        /* Image first, then all tabs */
        #shopify-section-{{ sid }} .pb2c__image-wrap { grid-row: 1; order: 1; }
        #shopify-section-{{ sid }} .pb2c__col--left  { grid-row: 2; order: 2; }
        #shopify-section-{{ sid }} .pb2c__col--right { grid-row: 3; order: 3; }
      {%- when 'image_bottom' -%}
        /* All tabs first, then image */
        #shopify-section-{{ sid }} .pb2c__col--left  { grid-row: 1; order: 1; }
        #shopify-section-{{ sid }} .pb2c__col--right { grid-row: 2; order: 2; }
        #shopify-section-{{ sid }} .pb2c__image-wrap { grid-row: 3; order: 3; }
      {%- else -%}
        /* image_middle (default): half tabs - image - other half tabs */
        #shopify-section-{{ sid }} .pb2c__col--left  { grid-row: 1; order: 1; }
        #shopify-section-{{ sid }} .pb2c__image-wrap { grid-row: 2; order: 2; }
        #shopify-section-{{ sid }} .pb2c__col--right { grid-row: 3; order: 3; }
    {%- endcase -%}
  }

  /* Tabs */
  #shopify-section-{{ sid }} .pb2c__tab {
    text-align: left;
    padding: {{ st.tab_padding | default: 18 }}px;
    {%- case style_variant -%}
      {%- when 'soft-card' -%}
        background-color: {% render 'scheme-color', color: st.tab_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
        border-radius: {{ st.tab_radius | default: 16 }}px;
        box-shadow: 0 8px 22px -10px rgba(0,0,0,.08);
      {%- when 'outlined' -%}
        background-color: rgba(0,0,0,0);
        border: 1px solid {% render 'scheme-color', color: st.tab_border, fallback: 'var(--color-border)' %};
        border-radius: {{ st.tab_radius | default: 16 }}px;
      {%- when 'minimal' -%}
        background-color: rgba(0,0,0,0);
        border-bottom: 1px solid {% render 'scheme-color', color: st.tab_border, fallback: 'var(--color-border)' %};
        border-radius: 0;
        padding-inline: 0;
      {%- when 'accent' -%}
        background-color: {% render 'scheme-color', color: st.tab_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
        border-left: 3px solid {% render 'scheme-color', color: st.tab_accent, fallback: 'var(--color-primary)' %};
        border-radius: {{ st.tab_radius | default: 12 }}px;
      {%- else -%}
        /* clean */
        background-color: {% render 'scheme-color', color: st.tab_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
        border-radius: {{ st.tab_radius | default: 14 }}px;
        box-shadow: 0 4px 12px -8px rgba(0,0,0,.06);
    {%- endcase -%}
  }
  #shopify-section-{{ sid }} .pb2c__tab-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  #shopify-section-{{ sid }} .pb2c__tab-icon {
    flex-shrink: 0;
    width: {{ st.icon_box_size | default: 44 }}px;
    height: {{ st.icon_box_size | default: 44 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ st.icon_box_radius | default: 12 }}px;
    background: {% render 'scheme-color', color: st.benefit_icon_box_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
    color: {% render 'scheme-color', color: st.benefit_icon_color, fallback: 'var(--color-heading)' %};
  }
  #shopify-section-{{ sid }} .pb2c__tab-icon svg,
  #shopify-section-{{ sid }} .pb2c__tab-icon img {
    width: {{ st.icon_size | default: 22 }}px;
    height: {{ st.icon_size | default: 22 }}px;
    object-fit: contain;
  }
  /* Cover-fit image: image fills the whole icon box, clipped to its radius */
  #shopify-section-{{ sid }} .pb2c__tab-icon.is-cover { overflow: hidden; padding: 0; }
  #shopify-section-{{ sid }} .pb2c__tab-icon.is-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  #shopify-section-{{ sid }} .pb2c__tab-title {
    margin: 0 0 6px;
    font-size: {{ st.tab_title_size | default: 16 }}px;
    line-height: 1.25;
    font-weight: var(--heading-weight, 700);
    color: {% render 'scheme-color', color: st.benefit_title_color, fallback: 'var(--color-heading)' %} !important;
  }
  #shopify-section-{{ sid }} .pb2c__tab-desc {
    margin: 0;
    font-size: {{ st.tab_desc_size | default: 14 }}px;
    line-height: 1.5;
    color: {% render 'scheme-color', color: st.benefit_desc_color, fallback: 'var(--color-text)' %} !important;
  }

  /* Mobile layout: 2 tabs above + image + 2 below (when 4 tabs).
     With more or fewer tabs, all tabs go below the image for predictability. */
  #shopify-section-{{ sid }} .pb2c__col--left  { grid-column: 1; display: flex; flex-direction: column; gap: {{ st.tab_gap | default: 20 }}px; }
  #shopify-section-{{ sid }} .pb2c__col--right { grid-column: 1; display: flex; flex-direction: column; gap: {{ st.tab_gap | default: 20 }}px; }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb2c__col--left  { grid-column: 1; align-items: flex-end;   text-align: right; }
    #shopify-section-{{ sid }} .pb2c__col--right { grid-column: 3; align-items: flex-start; text-align: left;  }
    #shopify-section-{{ sid }} .pb2c__col--right .pb2c__tab,
    #shopify-section-{{ sid }} .pb2c__col--left  .pb2c__tab {
      width: 100%;
    }
  }
{% comment %}{% endcomment %}</style>

<section class="pb2c-wrap color-{{ color_scheme }} gradient"{% unless st.reveal %} data-ti-no-reveal{% endunless %}>
  <div class="pb2c">
    <div class="pb2c__inner">
      {%- if content_blocks.size > 0 or content_blocks2.size > 0 or content_blocks3.size > 0 -%}
        <div class="pb2c__header">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'top_text' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb2c__top"
                     style="font-size: {{ block.settings.size | default: 13 }}px; color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-primary)' %} !important;"
                     {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </p>
                {%- endif -%}
              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  {%- assign pb2_h = block.settings.text | escape -%}
                  {%- if block.settings.enable_accent and block.settings.accent_text != blank -%}
                    {%- assign pb2_acc = block.settings.accent_text | escape -%}
                    {%- capture pb2_acc_html -%}<span class="pb2c__accent">{{ pb2_acc }}</span>{%- endcapture -%}
                    {%- assign pb2_h = pb2_h | replace: pb2_acc, pb2_acc_html -%}
                  {%- endif -%}
                  <{{ block.settings.tag | default: 'h2' }}
                     id="block-{{ block.id }}"
                     class="pb2c__heading"
                     style="
                       color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
                       font-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %};
                     "
                     {{ block.shopify_attributes }}>
                    {{ pb2_h }}
                  </{{ block.settings.tag | default: 'h2' }}>
                  <style>
                    #block-{{ block.id }} { font-size: {{ block.settings.size_mobile | default: 28 }}px; }
                    @media (min-width: 768px) {
                      #block-{{ block.id }} { font-size: {{ block.settings.size_desktop | default: 42 }}px; }
                    }
                    {%- if block.settings.enable_accent -%}
                    #block-{{ block.id }} .pb2c__accent {
                      color: {% render 'scheme-color', color: block.settings.accent_color, fallback: 'var(--color-primary)' %};
                      {% if block.settings.accent_italic %}font-style: italic;{% endif %}
                    }
                    {%- endif -%}
{% comment %}{% endcomment %}                  </style>
                {%- endif -%}
              {%- when 'subheading' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb2c__sub"
                     style="font-size: {{ block.settings.size | default: 16 }}px; color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %} !important;"
                     {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </p>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="pb2c__grid">
        {%- comment -%}On mobile: image first, then all tabs. On desktop: split into left/right columns around image.{%- endcomment -%}

        {%- comment -%}Left column tabs — first half (rounded down){%- endcomment -%}
        {%- assign half = tab_count | divided_by: 2 -%}
        <div class="pb2c__col--left">
          {%- assign idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' and idx < half -%}
              {%- liquid
                assign bs = block.settings
                assign icon_source = bs.icon_source | default: 'icon'
              -%}
              <div class="pb2c__tab" {{ block.shopify_attributes }}>
                <div class="pb2c__tab-row">
                  {%- if icon_source != 'none' -%}
                    <span class="pb2c__tab-icon{% if bs.image_cover and icon_source == 'image' and bs.image != blank %} is-cover{% endif %}">
                      {%- case icon_source -%}
                        {%- when 'icon' -%}
                          {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
                        {%- when 'image' -%}
                          {%- if bs.image -%}
                            <img src="{{ bs.image | image_url: width: 80 }}" alt="{{ bs.title | default: 'icon' | escape }}" loading="lazy" width="40" height="40">
                          {%- endif -%}
                        {%- when 'svg' -%}
                          {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <div class="pb2c__tab-body">
                    {%- if bs.title != blank -%}
                      <h3 class="pb2c__tab-title">{{ bs.title | escape }}</h3>
                    {%- endif -%}
                    {%- if bs.description != blank -%}
                      <p class="pb2c__tab-desc">{{ bs.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- assign idx = idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pb2c__image-wrap">
          {%- if st.image -%}
            <img
              src="{{ st.image | image_url: width: 900 }}"
              srcset="{{ st.image | image_url: width: 400 }} 400w,
                      {{ st.image | image_url: width: 700 }} 700w,
                      {{ st.image | image_url: width: 900 }} 900w"
              sizes="(min-width: 992px) {{ st.image_size_desktop | default: 460 }}px, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_product_benefits_image | escape }}"
              loading="lazy"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            <img
              src="{{ placeholder }}"
              alt="{{ 'accessibility.product_benefits_placeholder' | t }}"
              loading="lazy"
              width="900"
              height="900"
            >
          {%- endif -%}
        </div>

        {%- comment -%}Right column tabs — remaining{%- endcomment -%}
        <div class="pb2c__col--right">
          {%- assign idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- if idx >= half -%}
                {%- liquid
                assign bs = block.settings
                assign icon_source = bs.icon_source | default: 'icon'
              -%}
              <div class="pb2c__tab" {{ block.shopify_attributes }}>
                <div class="pb2c__tab-row">
                  {%- if icon_source != 'none' -%}
                    <span class="pb2c__tab-icon{% if bs.image_cover and icon_source == 'image' and bs.image != blank %} is-cover{% endif %}">
                      {%- case icon_source -%}
                        {%- when 'icon' -%}
                          {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
                        {%- when 'image' -%}
                          {%- if bs.image -%}
                            <img src="{{ bs.image | image_url: width: 80 }}" alt="{{ bs.title | default: 'icon' | escape }}" loading="lazy" width="40" height="40">
                          {%- endif -%}
                        {%- when 'svg' -%}
                          {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <div class="pb2c__tab-body">
                    {%- if bs.title != blank -%}
                      <h3 class="pb2c__tab-title">{{ bs.title | escape }}</h3>
                    {%- endif -%}
                    {%- if bs.description != blank -%}
                      <p class="pb2c__tab-desc">{{ bs.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- endif -%}
              {%- assign idx = idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "product-benefits-2",
  "name": "Product Benefits 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
