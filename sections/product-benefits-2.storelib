        "min": 8,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "gap_header_to_grid",
        "label": "Header spacing",
        "min": 8,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "gap_between_header_blocks",
