<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<section class="sls color-{{ color_scheme }} gradient sls--{{ section.settings.logo_style }} {% if section.settings.edge_fade %}sls--fade{% endif %} {% if section.settings.pause_on_hover %}sls--pause{% endif %} {% unless section.settings.auto_scroll %}sls--static{% endunless %} sls--{{ section.settings.direction }}" data-scheme="{{ color_scheme }}" style="--s-bg: var(--color-background); --s-text: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %}; --s-heading: {% render 'scheme-color', color: section.settings.heading_color, fallback: 'var(--color-heading)' %}; --s-border: var(--color-border); --s-radius: var(--rounded-normal, 8px); --s-pt: {{ section.settings.padding_top }}px; --s-pb: {{ section.settings.padding_bottom }}px; --sls-speed: {{ section.settings.speed }}s; --sls-h: {{ section.settings.logo_height }}px; --sls-h-m: {{ section.settings.logo_height_mobile }}px; --sls-w: {{ section.settings.logo_max_width }}px; --sls-w-m: {{ section.settings.logo_max_width_mobile }}px; --sls-gap: {{ section.settings.gap }}px; --sls-gap-m: {{ section.settings.gap_mobile }}px; --sls-fade: {{ section.settings.edge_fade_width }}%; --sls-head-width: {{ section.settings.heading_width }}px; --sls-head-gap: {{ section.settings.heading_gap }}px; --sls-head-gap-m: {{ section.settings.heading_gap_mobile }}px; --sls-align: {{ section.settings.heading_alignment }}; --sls-item-px: {{ section.settings.logo_padding_horizontal }}px; --sls-item-py: {{ section.settings.logo_padding_vertical }}px; --sls-item-radius: {{ section.settings.logo_radius }}px; --sls-item-border: {{ section.settings.logo_border_width }}px; --sls-item-bg: {% render 'scheme-color', color: section.settings.logo_background, fallback: 'transparent' %}; --sls-item-border-color: {% render 'scheme-color', color: section.settings.logo_border_color, fallback: 'var(--color-border)' %}; --sls-mono-opacity: {{ section.settings.monochrome_opacity }}%; --sls-hover-scale: {{ section.settings.hover_scale }};">
  <div class="sls__in sls__in--{{ section.settings.max_width }}">
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="sls__head">
        {% if section.settings.heading != blank %}<h2 class="sls__h">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div class="sls__p">{{ section.settings.text }}</div>{% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 or request.design_mode %}
    <div class="sls__viewport">
      <div class="sls__track">
        <ul class="sls__group" role="list">
          {% for block in section.blocks %}
            {% if block.settings.logo != blank or request.design_mode %}
            <li class="sls__item" data-block-id="{{ block.id }}">
              {% if block.settings.logo != blank %}
                {% if block.settings.url != blank %}
                  <a class="sls__link" href="{{ block.settings.url | url }}"><img class="sls__img" src="{{ block.settings.logo | image_url: width: 800 }}" alt="{{ block.settings.alt | escape }}" width="200" height="80" loading="lazy" decoding="async"></a>
                {% else %}
                  <img class="sls__img" src="{{ block.settings.logo | image_url: width: 800 }}" alt="{{ block.settings.alt | escape }}" width="200" height="80" loading="lazy" decoding="async">
                {% endif %}
              {% else %}
                <span class="sls__ph">{{ block.settings.name | escape }}</span>
              {% endif %}
            </li>
            {% endif %}
          {% else %}
            {% if request.design_mode %}<li class="sls__item"><span class="sls__ph">{{ section.settings.empty_note | escape }}</span></li>{% endif %}
          {% endfor %}
        </ul>
        <ul class="sls__group sls__group--copy" role="list" aria-hidden="true">
          {% for block in section.blocks %}
            {% if block.settings.logo != blank or request.design_mode %}
            <li class="sls__item" data-block-id="{{ block.id }}">
              {% if block.settings.logo != blank %}
                {% if block.settings.url != blank %}
                  <a class="sls__link" href="{{ block.settings.url | url }}" tabindex="-1"><img class="sls__img" src="{{ block.settings.logo | image_url: width: 800 }}" alt="" width="200" height="80" loading="lazy" decoding="async"></a>
                {% else %}
                  <img class="sls__img" src="{{ block.settings.logo | image_url: width: 800 }}" alt="" width="200" height="80" loading="lazy" decoding="async">
                {% endif %}
              {% else %}
                <span class="sls__ph">{{ block.settings.name | escape }}</span>
              {% endif %}
            </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .sls { box-sizing: border-box; container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
#shopify-section-{{ section.id }} .sls__in { box-sizing: border-box; margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
#shopify-section-{{ section.id }} .sls__in--narrow { max-width: 720px; }
#shopify-section-{{ section.id }} .sls__in--medium { max-width: 960px; }
#shopify-section-{{ section.id }} .sls__in--wide { max-width: var(--theme-page-width, 1280px); }
#shopify-section-{{ section.id }} .sls__in--full { max-width: none; }
#shopify-section-{{ section.id }} .sls__head { max-width: var(--sls-head-width); margin: 0 auto var(--sls-head-gap-m); text-align: var(--sls-align); }
#shopify-section-{{ section.id }} .sls__h { margin: 0; color: var(--s-heading); font-size: clamp(22px, 4cqi, var(--section-heading-size, 32px)); line-height: var(--section-heading-line-height, 1.15); font-weight: var(--section-heading-weight, var(--heading-weight, 700)); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); font-family: var(--section-heading-font, var(--heading-font, inherit)); }
#shopify-section-{{ section.id }} .sls__p { margin: 12px auto 0; max-width: 36rem; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-text); }
#shopify-section-{{ section.id }} .sls__p > :first-child { margin-top: 0; }
#shopify-section-{{ section.id }} .sls__p > :last-child { margin-bottom: 0; }
#shopify-section-{{ section.id }} .sls__viewport { container-type: inline-size; overflow: hidden; width: 100%; }
#shopify-section-{{ section.id }} .sls--fade .sls__viewport { -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--sls-fade), #000 calc(100% - var(--sls-fade)), transparent); mask-image: linear-gradient(to right, transparent, #000 var(--sls-fade), #000 calc(100% - var(--sls-fade)), transparent); }
#shopify-section-{{ section.id }} .sls__track { display: flex; width: max-content; animation: sls-scroll-{{ section.id }} var(--sls-speed, 30s) linear infinite; }
#shopify-section-{{ section.id }} .sls--right .sls__track { animation-direction: reverse; }
#shopify-section-{{ section.id }} .sls--pause .sls__viewport:hover .sls__track { animation-play-state: paused; }
#shopify-section-{{ section.id }} .sls--pause .sls__viewport:focus-within .sls__track { animation-play-state: paused; }
#shopify-section-{{ section.id }} .sls--static .sls__track { width: 100%; animation: none; }
#shopify-section-{{ section.id }} .sls--static .sls__group { flex: 1; min-width: 0; flex-wrap: wrap; justify-content: center; padding-right: 0; }
#shopify-section-{{ section.id }} .sls--static .sls__group--copy { display: none; }
#shopify-section-{{ section.id }} .sls--static .sls__viewport { overflow: visible; mask-image: none; -webkit-mask-image: none; }
#shopify-section-{{ section.id }} .sls__group { --g: var(--sls-gap-m); display: flex; flex: 0 0 auto; align-items: center; justify-content: space-around; gap: var(--g); min-width: 100cqi; margin: 0; padding: 0 var(--g) 0 0; list-style: none; }
#shopify-section-{{ section.id }} .sls__item { flex: 0 0 auto; display: flex; align-items: center; min-height: 44px; padding: var(--sls-item-py) var(--sls-item-px); background: var(--sls-item-bg); border: var(--sls-item-border) solid var(--sls-item-border-color); border-radius: var(--sls-item-radius); }
#shopify-section-{{ section.id }} .sls__link { display: flex; align-items: center; min-height: 44px; border-radius: 4px; }
#shopify-section-{{ section.id }} .sls__link:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 4px; }
#shopify-section-{{ section.id }} .sls__img { display: block; height: var(--sls-h-m); width: auto; max-width: var(--sls-w-m); object-fit: contain; transition: filter var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); }
#shopify-section-{{ section.id }} .sls--mono .sls__img { filter: grayscale(1); opacity: var(--sls-mono-opacity); }
#shopify-section-{{ section.id }} .sls__item:hover .sls__img { transform: scale(var(--sls-hover-scale)); }
#shopify-section-{{ section.id }} .sls--mono .sls__item:hover .sls__img { filter: none; opacity: 1; }
#shopify-section-{{ section.id }} .sls__ph { display: flex; align-items: center; justify-content: center; height: max(44px, var(--sls-h-m)); min-width: 120px; padding: 0 16px; border: 1px dashed var(--s-border); border-radius: var(--s-radius, 8px); font-size: 13px; color: var(--s-text); white-space: nowrap; }
@container (min-width: 760px) {
  #shopify-section-{{ section.id }} .sls__head { margin-bottom: var(--sls-head-gap); }
  #shopify-section-{{ section.id }} .sls__group { --g: var(--sls-gap); }
  #shopify-section-{{ section.id }} .sls__img { height: var(--sls-h); max-width: var(--sls-w); }
  #shopify-section-{{ section.id }} .sls__ph { height: max(44px, var(--sls-h)); }
}
@keyframes sls-scroll-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .sls__track { animation: none; }
  #shopify-section-{{ section.id }} .sls__group--copy { display: none; }
  #shopify-section-{{ section.id }} .sls__viewport { overflow-x: auto; }
  #shopify-section-{{ section.id }} .sls__img { transition: none; }
}
</style>
</template>

<schema>
{
  "type": "logo_scroll_strip",
  "name": "Scrolling Logo Strip",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Stocked by shops we're proud to work with"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting line"
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Empty strip note (builder only)",
      "default": "Add a logo in the sidebar"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading width",
      "min": 320,
      "max": 960,
      "step": 40,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Space below heading on phones",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Scroll"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "label": "Automatically scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time for one loop",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height on phones",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Maximum logo width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "label": "Maximum logo width on phones",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between logos",
      "min": 16,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between logos on phones",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo style",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Original colours"
        },
        {
          "value": "mono",
          "label": "Greyscale, colour on hover"
        }
      ]
    },
    {
      "type": "range",
      "id": "monochrome_opacity",
      "label": "Greyscale logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Logo scale on hover",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade the edges",
      "default": true
    },
    {
      "type": "range",
      "id": "edge_fade_width",
      "label": "Edge fade width",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Logo containers"
    },
    {
      "type": "range",
      "id": "logo_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "logo_border_color",
      "label": "Border"
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Logo description",
          "default": "Stockist logo"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name (shown in the builder until a logo is added)",
          "default": "Add a logo"
        }
      ],
      "limit": 30
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Scrolling Logo Strip",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    },
    {
      "name": "Scrolling Logo Strip on dark",
      "settings": {
        "logo_style": "mono"
      },
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ],
  "shopify": {
    "name": "Scrolling Logo Strip",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "max_width",
        "label": "Section width",
        "default": "wide",
        "options": [
          {
            "label": "Narrow",
            "value": "narrow"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Wide",
            "value": "wide"
          },
          {
            "label": "Full",
            "value": "full"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading",
        "default": "Stocked by shops we're proud to work with"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Supporting line"
      },
      {
        "type": "text",
        "id": "empty_note",
        "label": "Empty strip note",
        "default": "Add a logo in the sidebar"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "center",
        "options": [
          {
            "label": "Left",
            "value": "left"
          },
          {
            "label": "Centre",
            "value": "center"
          },
          {
            "label": "Right",
            "value": "right"
          }
        ]
      },
      {
        "type": "range",
        "id": "heading_width",
        "label": "Heading width",
        "min": 320,
        "max": 960,
        "step": 40,
        "unit": "px",
        "default": 640
      },
      {
        "type": "range",
        "id": "heading_gap",
        "label": "Space below heading",
        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "heading_gap_mobile",
        "label": "Space below heading on phones",
        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "header",
        "content": "Scroll"
      },
      {
        "type": "checkbox",
        "id": "auto_scroll",
        "label": "Automatically scroll",
        "default": true
      },
      {
        "type": "select",
        "id": "direction",
        "label": "Direction",
        "default": "left",
        "options": [
          {
            "label": "Left",
            "value": "left"
          },
          {
            "label": "Right",
            "value": "right"
          }
        ]
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Time for one loop",
        "min": 10,
        "max": 90,
        "step": 5,
        "unit": "s",
        "default": 35
      },
