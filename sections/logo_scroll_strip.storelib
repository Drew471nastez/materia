          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 11,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 15
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "See all stockists"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width button",
            "default": false
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color_hover",
            "label": "Border on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button shape",
            "default": true
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Horizontal padding",
            "min": 8,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 26,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Vertical padding",
            "min": 6,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 4,
            "step": 1,
            "unit": "px",
            "default": 1,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Font size",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "600",
            "visible_if": "{{ block.settings.use_theme_button == false }}",
            "options": [
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase text",
            "default": false
          }
        ]
      },
      {
        "type": "logo",
        "name": "Logo",
        "limit": 30,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "image_picker",
            "id": "logo",
