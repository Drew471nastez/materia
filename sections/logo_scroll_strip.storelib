<template compat="shopify">
<script src="{{ 'live-logos.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Scrolling logo strip: stockist or press logos moving in a
  loop, or standing still in a row.

  Eyebrow, heading, subheading and button blocks above the strip; one logo
  block per logo. Colours follow the colour scheme and fonts follow Theme
  settings > Typography until custom styling or custom fonts are switched
  on. The older heading and supporting line settings are kept for saved
  pages and shown only while the section has no heading or subheading
  block. The strip pauses off screen and stands still under reduced motion
  (assets/live-logos.js, which also applies the builder's live edits).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign has_heading = false
  assign has_sub = false
  assign logos = 0
  for block in section.blocks
    case block.type
      when 'heading'
        assign has_heading = true
      when 'subheading'
        assign has_sub = true
      when 'logo'
        assign logos = logos | plus: 1
    endcase
  endfor
-%}
{% render 'logos-style', section: section, bp: 768 %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .sls .lg-head { max-width: var(--sls-head-width); }
  #shopify-section-{{ sid }} .sls__viewport { overflow: hidden; width: 100%; }
  #shopify-section-{{ sid }} .sls[data-fade='true'][data-auto='true'] .sls__viewport { -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--sls-fade), #000 calc(100% - var(--sls-fade)), transparent); mask-image: linear-gradient(to right, transparent, #000 var(--sls-fade), #000 calc(100% - var(--sls-fade)), transparent); }
  #shopify-section-{{ sid }} .sls__track { display: flex; width: max-content; animation: sls-scroll-{{ sid }} var(--sls-speed, 30s) linear infinite; }
  #shopify-section-{{ sid }} .sls[data-direction='right'] .sls__track { animation-direction: reverse; }
  #shopify-section-{{ sid }} .sls[data-paused] .sls__track { animation-play-state: paused; }
  #shopify-section-{{ sid }} .sls[data-pause-hover='true'] .sls__viewport:is(:hover, :focus-within) .sls__track { animation-play-state: paused; }
  #shopify-section-{{ sid }} .sls[data-auto='false'] .sls__track { width: 100%; animation: none; }
  #shopify-section-{{ sid }} .sls[data-auto='false'] .sls__group { flex: 1; min-width: 0; flex-wrap: wrap; justify-content: center; padding-right: 0; }
  #shopify-section-{{ sid }} .sls[data-auto='false'] .sls__group--copy { display: none; }
  #shopify-section-{{ sid }} .sls__group { --g: var(--sls-gap-m); display: flex; flex: 0 0 auto; align-items: center; justify-content: space-around; gap: var(--g); min-width: 100vw; min-width: 100cqi; margin: 0; padding: 0 var(--g) 0 0; list-style: none; }
  #shopify-section-{{ sid }} .sls__viewport { container-type: inline-size; }
  #shopify-section-{{ sid }} .sls__item { flex: 0 0 auto; display: flex; align-items: center; min-height: 44px; padding: var(--sls-item-py) var(--sls-item-px); background: var(--sls-item-bg); border: var(--sls-item-border) solid var(--sls-item-border-color); border-radius: var(--sls-item-radius); }
  #shopify-section-{{ sid }} .sls__link { display: flex; align-items: center; min-height: 44px; border-radius: 4px; color: inherit; }
  #shopify-section-{{ sid }} .sls__img { display: block; height: var(--sls-h-m); width: auto; max-width: var(--sls-w-m); object-fit: contain; transition: filter var(--btn-anim-duration, .3s) ease, opacity var(--btn-anim-duration, .3s) ease, transform var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .sls[data-style='mono'] .sls__img { filter: grayscale(1); opacity: var(--sls-mono-opacity); }
  #shopify-section-{{ sid }} .sls__item:hover .sls__img { transform: scale(var(--sls-hover-scale)); }
  #shopify-section-{{ sid }} .sls[data-style='mono'] .sls__item:hover .sls__img { filter: none; opacity: 1; }
  #shopify-section-{{ sid }} .sls__ph { display: flex; align-items: center; justify-content: center; height: max(44px, var(--sls-h-m)); min-width: 120px; padding: 0 16px; border: 1px dashed var(--color-border); border-radius: var(--rounded-radius, 8px); font-size: 13px; color: var(--lg-text); white-space: nowrap; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .sls__group { --g: var(--sls-gap); }
    #shopify-section-{{ sid }} .sls__img { height: var(--sls-h); max-width: var(--sls-w); }
    #shopify-section-{{ sid }} .sls__ph { height: max(44px, var(--sls-h)); }
  }
  @keyframes sls-scroll-{{ sid }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .sls__track { animation: none; }
    #shopify-section-{{ sid }} .sls__group--copy { display: none; }
    #shopify-section-{{ sid }} .sls__viewport { overflow-x: auto; -webkit-mask-image: none !important; mask-image: none !important; }
    #shopify-section-{{ sid }} .sls__img { transition: none; }
  }
{% comment %}{% endcomment %}</style>
<section class="lg sls color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'logo_scroll_strip', width: st.max_width, fonts: fonts %} data-head-align="{{ st.heading_alignment | default: 'center' }}" data-style="{{ st.logo_style | default: 'original' }}" data-auto="{% if st.auto_scroll %}true{% else %}false{% endif %}" data-direction="{{ st.direction | default: 'left' }}" data-pause-hover="{% if st.pause_on_hover %}true{% else %}false{% endif %}" data-fade="{% if st.edge_fade %}true{% else %}false{% endif %}"{% if request.design_mode %} data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;max_width&quot;:&quot;wide&quot;,&quot;heading_alignment&quot;:&quot;center&quot;,&quot;heading_width&quot;:640,&quot;empty_note&quot;:&quot;Add a logo in the sidebar&quot;,&quot;heading&quot;:&quot;Stocked by shops we're proud to work with&quot;,&quot;logo_height&quot;:48,&quot;logo_max_width&quot;:220,&quot;gap&quot;:72,&quot;logo_style&quot;:&quot;original&quot;,&quot;monochrome_opacity&quot;:60,&quot;hover_scale&quot;:1,&quot;edge_fade&quot;:true,&quot;edge_fade_width&quot;:8,&quot;logo_padding_horizontal&quot;:0,&quot;logo_padding_vertical&quot;:0,&quot;logo_border_width&quot;:0,&quot;logo_radius&quot;:0,&quot;enable_custom_style&quot;:false,&quot;logo_background&quot;:&quot;rgba(0,0,0,0)&quot;,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;auto_scroll&quot;:true,&quot;direction&quot;:&quot;left&quot;,&quot;speed&quot;:35,&quot;pause_on_hover&quot;:true,&quot;padding_top&quot;:56,&quot;padding_bottom&quot;:56,&quot;heading_gap&quot;:40,&quot;logo_height_mobile&quot;:32,&quot;logo_max_width_mobile&quot;:180,&quot;gap_mobile&quot;:44,&quot;heading_gap_mobile&quot;:32&#125;"{% endif %}{% if request.design_mode %} data-lg-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Stockists&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:13,&quot;uppercase&quot;:true&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Stocked by shops we're proud to work with&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:32,&quot;size_mobile&quot;:26&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Find our pieces in these shops.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:16,&quot;size_mobile&quot;:15&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;See all stockists&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;,&quot;logo&quot;:&#123;&quot;alt&quot;:&quot;Stockist logo&quot;,&quot;name&quot;:&quot;Add a logo&quot;&#125;&#125;"{% endif %} style="{% render 'logos-root', section: section, custom: own, text: st.text_color, heading: st.heading_color, fonts: fonts, hfont: st.heading_font, bfont: st.body_font, pt_d: st.padding_top, pb_d: st.padding_bottom, pt_m: st.padding_top, pb_m: st.padding_bottom, px_d: 24, px_m: 20 %}--lg-hmb-d: {{ st.heading_gap | default: 0 }}px;--lg-hmb-m: {{ st.heading_gap_mobile | default: 0 }}px;--sls-head-width: {{ st.heading_width | default: 640 }}px;--sls-speed: {{ st.speed | default: 35 }}s;--sls-h: {{ st.logo_height | default: 48 }}px;--sls-h-m: {{ st.logo_height_mobile | default: 32 }}px;--sls-w: {{ st.logo_max_width | default: 220 }}px;--sls-w-m: {{ st.logo_max_width_mobile | default: 180 }}px;--sls-gap: {{ st.gap | default: 72 }}px;--sls-gap-m: {{ st.gap_mobile | default: 44 }}px;--sls-fade: {{ st.edge_fade_width | default: 8 }}%;--sls-item-px: {{ st.logo_padding_horizontal | default: 0 }}px;--sls-item-py: {{ st.logo_padding_vertical | default: 0 }}px;--sls-item-radius: {{ st.logo_radius | default: 0 }}px;--sls-item-border: {{ st.logo_border_width | default: 0 }}px;--sls-item-bg: {% if own %}{% render 'scheme-color', color: st.logo_background, fallback: 'transparent' %}{% else %}transparent{% endif %};--sls-item-border-color: {% if own %}{% render 'scheme-color', color: st.logo_border_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};--sls-mono-opacity: {{ st.monochrome_opacity | default: 60 }}%;--sls-hover-scale: {{ st.hover_scale | default: 1 }};">
  <div class="lg__inner sls__in">
    <div class="lg-head sls__head">
      {%- for block in section.blocks -%}
        {%- unless block.type == 'logo' -%}{%- render 'logos-text', block: block -%}{%- endunless -%}
      {%- endfor -%}
      {%- if has_heading == false and st.heading != blank -%}<h2 class="lg__heading sls__h" data-lg-legacy="heading" style="--b-c: var(--lg-heading);--b-fs-m: 24px;--b-fs-d: 32px;">{{ st.heading }}</h2>{%- endif -%}
      {%- if has_sub == false and st.text != blank -%}<div class="lg__sub sls__p" data-lg-legacy="subheading" style="--b-c: var(--lg-text);--b-fs-m: 15px;--b-fs-d: 16px;">{{ st.text }}</div>{%- endif -%}
    </div>
    {%- if logos > 0 or request.design_mode -%}
    <div class="sls__viewport">
      <div class="sls__track">
        {%- assign groups = 'main,copy' | split: ',' -%}
        {%- for g in groups -%}
        <ul class="sls__group{% if g == 'copy' %} sls__group--copy{% endif %}" role="list"{% if g == 'copy' %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              {%- assign b = block.settings -%}
              {%- if b.logo != blank or request.design_mode -%}
              <li class="sls__item" {% if g == 'copy' %}data-lg-copy="{{ block.id }}"{% else %}{% render 'logos-block', block: block %}{% endif %}>
                {%- capture inner -%}{%- if b.logo != blank -%}<img class="sls__img" src="{{ b.logo | image_url: width: 800 }}" alt="{% if g == 'main' %}{{ b.alt | escape }}{% endif %}" width="200" height="80" loading="lazy" decoding="async">{%- else -%}<span class="sls__ph">{{ b.name | escape }}</span>{%- endif -%}{%- endcapture -%}
                {%- if b.url != blank -%}
                  <a class="sls__link" data-lg-no-link="SPAN" href="{{ b.url | url }}"{% if g == 'copy' %} tabindex="-1"{% endif %}>{{ inner }}</a>
                {%- else -%}
                  <span class="sls__link" data-lg-no-link="SPAN">{{ inner }}</span>
                {%- endif -%}
              </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if logos == 0 and request.design_mode and g == 'main' -%}<li class="sls__item" data-lg-empty><span class="sls__ph">{{ st.empty_note | escape }}</span></li>{%- endif -%}
        </ul>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</section>
</template>

<schema>
{
  "type": "logo_scroll_strip",
  "name": "Scrolling Logo Strip",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Section width",
      "default": "wide",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading width",
      "min": 320,
      "max": 960,
      "step": 40,
      "unit": "px",
      "default": 640
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Note when there are no logos",
      "default": "Add a logo in the sidebar",
      "info": "Shown in the editor only"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Stocked by shops we're proud to work with",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting line",
      "hidden": true,
      "info": "Legacy: used only when the section has no subheading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Media"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (desktop)",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width (desktop)",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos (desktop)",
      "min": 16,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo style",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Original colours"
        },
        {
          "value": "mono",
          "label": "Greyscale, colour on hover"
        }
      ]
    },
    {
      "type": "range",
      "id": "monochrome_opacity",
      "label": "Greyscale opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ section.settings.logo_style == 'mono' }}"
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Logo scale on hover",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Fade the edges",
      "default": true,
      "visible_if": "{{ section.settings.auto_scroll }}"
    },
    {
      "type": "range",
      "id": "edge_fade_width",
      "label": "Edge fade width",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 8,
      "visible_if": "{{ section.settings.auto_scroll and section.settings.edge_fade }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "logo_padding_horizontal",
      "label": "Logo box padding (sides)",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_padding_vertical",
      "label": "Logo box padding (top and bottom)",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_border_width",
      "label": "Logo box border",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_radius",
      "label": "Logo box corners",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Logo box background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "logo_border_color",
      "label": "Logo box border colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "label": "Scroll automatically",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ section.settings.auto_scroll }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time for one loop",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 35,
      "visible_if": "{{ section.settings.auto_scroll }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true,
      "visible_if": "{{ section.settings.auto_scroll }}"
    },
    {
      "type": "header",
      "id": "hdr_38",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "id": "hdr_42",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "label": "Logo max width (mobile)",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between logos (mobile)",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Space below heading (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Stockists"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
