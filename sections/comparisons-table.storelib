<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_brand_uppercase = 'accessibility.brand_uppercase' | t -%}
{%- assign fb_accessibility_brand = 'accessibility.brand' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Comparison Table 4

  Layout
    LEFT  → text-column blocks (Eyebrow / Heading / Subheading)
    RIGHT → CSS-grid comparison table with brown vertical capsule
            overlay highlighting the brand column. Capsule settings
            live on the brand Column Header block.

  Bottom of section has a layered cream + tan wave pattern that fully
  fills the pattern area (no transparent strip).

  Settings are organised mostly per-block. The section-level settings
  cover only truly global concerns: layout, section background/spacing,
  table styling, default mark colors/sizes, and the bottom pattern.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  assign _text_w  = st.text_col_width | default: 50
  assign _table_w = 100 | minus: _text_w

  comment
    Column vertical alignment: respect the saved/selected value.
    Default to center when blank.
  endcomment
  assign _valign = st.column_valign | default: 'center'

  case st.text_align
    when 'left'
      assign _ai = 'flex-start'
      assign _ta = 'left'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'center'
      assign _ta = 'center'
  endcase

  assign columns           = section.blocks | where: 'type', 'column_header'
  assign rows              = section.blocks | where: 'type', 'row'
  assign col_count = columns | size
  if col_count == 0
    assign col_count = 3
  endif

  assign brand_index = -1
  for col in columns
    if col.settings.is_brand
      assign brand_index = forloop.index0
      break
    endif
  endfor

  assign brand_col = nil
  if brand_index >= 0
    assign brand_col = columns[brand_index]
  endif

  comment
    Brand-capsule settings live on the brand column block; pull with sensible fallbacks.
  endcomment
  if brand_col
    assign cap_w             = brand_col.settings.cap_width         | default: 130
    assign cap_w_mobile      = brand_col.settings.cap_width_mobile  | default: 88
    assign cap_overhang      = brand_col.settings.cap_overhang      | default: 56
    assign cap_overhang_mob  = brand_col.settings.cap_overhang_mobile | default: 42
    assign cap_logo_top      = brand_col.settings.logo_top_offset   | default: 44
    assign cap_logo_size     = brand_col.settings.logo_size         | default: 24
    assign cap_logo_rotate   = brand_col.settings.logo_rotate       | default: -3
  else
    assign cap_w = 130
    assign cap_w_mobile = 88
    assign cap_overhang = 56
    assign cap_overhang_mob = 42
    assign cap_logo_top = 44
    assign cap_logo_size = 24
    assign cap_logo_rotate = -3
  endif
-%}
{%- capture cap_bg -%}{% render 'scheme-color', color: brand_col.settings.cap_bg, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture cap_text -%}{% render 'scheme-color', color: brand_col.settings.cap_text, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}

<style>
  #shopify-section-{{ sid }} {
    position: relative;
    overflow: hidden;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    /* Cap section stacking below mobile nav bar (which uses 2147483640).
       isolation creates a stacking context so the inner capsule
       (z-index: 1) can never escape and overlap the fixed nav bar. */
    z-index: 0;
    isolation: isolate;
  }
  {%- if st.reset_spacing -%}
  #shopify-section-{{ sid }} {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed: no constraints */
  {%- endcase -%}
  #shopify-section-{{ sid }},
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *::before,
  #shopify-section-{{ sid }} *::after { box-sizing: border-box; }

  #shopify-section-{{ sid }} .cmp {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
    position: relative;
    width: 100%;
    padding-top:    {{ st.padding_top_mobile     | default: 80 }}px !important;
    padding-bottom: {{ st.padding_bottom_mobile  | default: 120 }}px !important;
    padding-left:   {{ st.left_padding_mobile    | default: st.side_padding_mobile | default: 12 }}px !important;
    padding-right:  {{ st.right_padding_mobile   | default: st.side_padding_mobile | default: 12 }}px !important;
    container-type: inline-size;
    container-name: cmp;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp {
      padding-top:    {{ st.padding_top_desktop    | default: 120 }}px !important;
      padding-bottom: {{ st.padding_bottom_desktop | default: 140 }}px !important;
      padding-left:   {{ st.left_padding_desktop   | default: st.side_padding_desktop | default: 48 }}px !important;
      padding-right:  {{ st.right_padding_desktop  | default: st.side_padding_desktop | default: 48 }}px !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp {
      padding-top:    {{ st.padding_top_desktop    | default: 120 }}px !important;
      padding-bottom: {{ st.padding_bottom_desktop | default: 140 }}px !important;
      padding-left:   {{ st.left_padding_desktop   | default: st.side_padding_desktop | default: 48 }}px !important;
      padding-right:  {{ st.right_padding_desktop  | default: st.side_padding_desktop | default: 48 }}px !important;
    }
  }

  /* Flexbox layout — simpler and more predictable than grid here.
     Mobile: column (stacked). Desktop: row (side by side). */
  #shopify-section-{{ sid }} .cmp__inner {
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
    display: flex !important;
    flex-direction: column !important;
    gap: {{ st.col_gap_mobile | default: 40 }}px;
    align-items: stretch;
    justify-content: flex-start;
    text-align: center;
    position: relative;
    z-index: 2;
    width: 100%;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__inner {
      flex-direction: {% if st.text_position == 'right' %}row-reverse{% else %}row{% endif %} !important;
      gap: {{ st.col_gap_desktop | default: 60 }}px;
      align-items: {{ _valign }} !important;
      text-align: left;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp__inner {
      flex-direction: {% if st.text_position == 'right' %}row-reverse{% else %}row{% endif %} !important;
      gap: {{ st.col_gap_desktop | default: 60 }}px;
      align-items: {{ _valign }} !important;
      text-align: left;
    }
  }

  /* Text column */
  #shopify-section-{{ sid }} .cmp__text {
    display: flex !important;
    flex-direction: column !important;
    align-items: center;
    justify-content: flex-start !important;
    text-align: center;
    gap: {{ st.text_gap | default: 24 }}px;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    flex: 0 0 auto;
    align-self: stretch;
    margin: 0 !important;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__text {
      flex: 0 1 {{ _text_w }}%;
      max-width: {{ _text_w }}%;
      align-items: {{ _ai }};
      text-align: {{ _ta }};
      align-self: {{ _valign }} !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp__text {
      flex: 0 1 {{ _text_w }}%;
      max-width: {{ _text_w }}%;
      align-items: {{ _ai }};
      text-align: {{ _ta }};
      align-self: {{ _valign }} !important;
    }
  }

  /* Eyebrow */
  #shopify-section-{{ sid }} .cmp__eyebrow {
    margin: 0;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Heading wrap — block-level so width is bound by parent column */
  #shopify-section-{{ sid }} .cmp__heading-wrap {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 !important;
    padding: 0 !important;
  }
  /* Defeat any global theme h-tag margins that push the heading down */
  #shopify-section-{{ sid }} .cmp__heading,
  #shopify-section-{{ sid }} .cmp__sub,
  #shopify-section-{{ sid }} .cmp__eyebrow {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  #shopify-section-{{ sid }} .cmp__heading {
    margin: 0;
    font-weight: var(--heading-weight, 900);
    line-height: 0.95;
    letter-spacing: 0.005em;
    /* Sizes driven directly by the heading block's sliders via CSS vars
       (set inline on .cmp__heading-wrap when the heading block renders). */
    font-size: var(--h-size-mob, 40px);
    white-space: normal !important;
    overflow-wrap: break-word !important;
    word-break: normal;
    hyphens: none;
    max-width: 100%;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__heading {
      font-size: var(--h-size-desk, 72px);
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp__heading {
      font-size: var(--h-size-desk, 72px);
    }
  }

  /* Highlighted word(s) inside the heading — anchor for the swoosh */
  #shopify-section-{{ sid }} .cmp__heading-hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  /* Swoosh — positioned absolutely under the highlighted word(s).
     If no highlight word is set, swoosh is a block-level element under
     the entire heading and right-aligns by default. */
  #shopify-section-{{ sid }} .cmp__swoosh--under {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, var(--swoosh-y, -2px)) scaleX(var(--swoosh-sx, 1));
    width: var(--swoosh-w, 110%);
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .cmp__swoosh--block {
    display: block;
    margin: -8px 0 0 auto;
    width: var(--swoosh-w, 260px);
    max-width: 75%;
  }
  #shopify-section-{{ sid }} .cmp__swoosh svg {
    width: 100%; height: auto; display: block;
    fill: none; stroke: currentColor;
    stroke-width: 6; stroke-linecap: round; stroke-linejoin: round;
  }
  #shopify-section-{{ sid }} .cmp__swoosh img { width: 100%; height: auto; display: block; }

  /* Subheading — sizes & spacing pulled from block CSS variables.
     padding-top creates breathing room beneath the swoosh underline. */
  #shopify-section-{{ sid }} .cmp__sub {
    margin: 0;
    line-height: 1.55;
    font-size: var(--sub-size-mob, 14px);
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__sub {
      font-size: var(--sub-size-desk, 16px);
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp__sub {
      font-size: var(--sub-size-desk, 16px);
    }
  }
  #shopify-section-{{ sid }} .cmp__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .cmp__sub p:last-child { margin: 0; }

  /* Table column — flex-shrinkable, takes the remaining space on desktop. */
  #shopify-section-{{ sid }} .cmp__table-col {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
    flex: 0 0 auto;
    align-self: stretch;
    margin: 0 !important;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__table-col {
      flex: 0 1 {{ _table_w }}%;
      max-width: {{ _table_w }}%;
      align-self: {{ _valign }} !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cmp__table-col {
      flex: 0 1 {{ _table_w }}%;
      max-width: {{ _table_w }}%;
      align-self: {{ _valign }} !important;
    }
  }

  /* Wrap defines the visual area + sets CSS vars used by the grid */
  #shopify-section-{{ sid }} .cmp__table-wrap {
    position: relative;
    width: 100%;
    max-width: {{ st.table_max_width | default: 600 }}px;
    --feature-col: {{ st.label_col_pct | default: 36 }}%;
    --col-count: {{ col_count }};
    --brand-index: {{ brand_index | default: 0 }};
    --capsule-w: {{ cap_w }}px;
    --capsule-overhang: {{ cap_overhang }}px;
  }

  #shopify-section-{{ sid }} .cmp__table {
    display: grid;
    grid-template-columns: var(--feature-col) repeat(var(--col-count), minmax(0, 1fr));
    background: {% render 'scheme-color', color: st.table_bg, fallback: 'var(--color-background)' %};
    border-radius: {{ st.table_radius | default: 18 }}px;
    position: relative;
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
  }

  /* Brand capsule overlay — positioned absolutely relative to the table */
  #shopify-section-{{ sid }} .cmp__capsule {
    position: absolute;
    top: calc(0px - var(--capsule-overhang));
    bottom: calc(0px - var(--capsule-overhang));
    width: var(--capsule-w);
    left: calc(
      var(--feature-col)
      + ((100% - var(--feature-col)) / var(--col-count)) * var(--brand-index)
      + ((100% - var(--feature-col)) / var(--col-count) - var(--capsule-w)) / 2
    );
    background: {{ cap_bg }};
    border-radius: 999px;
    z-index: 1;
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
  }
  #shopify-section-{{ sid }} .cmp__capsule-logo {
    position: absolute;
    top: {{ cap_logo_top }}px;
    left: 0; right: 0;
    text-align: center;
    color: {{ cap_text }};
    font-style: italic;
    font-weight: 900;
    font-size: {{ cap_logo_size }}px;
    line-height: 1;
    letter-spacing: -0.005em;
    pointer-events: none;
    transform: rotate({{ cap_logo_rotate }}deg);
    text-shadow: 0 1px 0 rgba(0,0,0,0.15);
  }
  #shopify-section-{{ sid }} .cmp__capsule-logo img {
    max-width: 80%;
    max-height: {{ cap_logo_size | plus: 18 }}px;
    width: auto; height: auto;
    object-fit: contain;
    display: inline-block;
    transform: rotate({{ cap_logo_rotate | times: -1 }}deg);
  }

  /* Cells */
  #shopify-section-{{ sid }} .cmp__cell {
    padding: {{ st.cell_pad_y | default: 18 }}px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid {% render 'scheme-color', color: st.table_divider, fallback: 'var(--color-border)' %};
    position: relative;
    z-index: 2;
    color: {% render 'scheme-color', color: st.feature_color, fallback: 'var(--color-heading)' %};
    text-align: center;
    min-width: 0;
  }
  #shopify-section-{{ sid }} .cmp__cell.is-last-row { border-bottom: 0; }
  #shopify-section-{{ sid }} .cmp__cell.cmp__head {
    font-weight: 700;
    font-size: {{ st.col_head_size | default: 16 }}px;
    color: {% render 'scheme-color', color: st.table_head_color, fallback: 'var(--color-heading)' %};
    background: {% render 'scheme-color', color: st.table_head_bg, fallback: 'transparent' %};
    padding-top: 14px;
    padding-bottom: 14px;
  }
  #shopify-section-{{ sid }} .cmp__cell.cmp__head.is-brand-col {
    visibility: hidden;
  }
  #shopify-section-{{ sid }} .cmp__cell.cmp__feature {
    justify-content: flex-start;
    padding-left: 22px;
    padding-right: 6px;
    text-align: left;
    font-weight: 700;
    font-size: {{ st.feature_size | default: 16 }}px;
    color: {% render 'scheme-color', color: st.feature_color, fallback: 'var(--color-heading)' %};
    line-height: 1.25;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: none;
  }

  /* Cell mark badges */
  #shopify-section-{{ sid }} .cmp__mark {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: {{ st.mark_size | default: 30 }}px;
    height: {{ st.mark_size | default: 30 }}px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: st.mark_bg_neutral, fallback: 'color-mix(in srgb, var(--color-text) 10%, transparent)' %};
    color: {% render 'scheme-color', color: st.mark_color_neutral, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .cmp__mark--brand {
    background: {% render 'scheme-color', color: st.mark_bg_brand, fallback: 'var(--btn-primary-color)' %};
    color: {% render 'scheme-color', color: st.mark_color_brand, fallback: 'var(--btn-primary-bg-color)' %};
  }
  #shopify-section-{{ sid }} .cmp__mark--minimal {
    background: transparent;
    color: {% render 'scheme-color', color: st.mark_color_neutral, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .cmp__mark--brand.cmp__mark--minimal {
    background: transparent;
    color: {% render 'scheme-color', color: st.mark_bg_brand, fallback: 'var(--btn-primary-color)' %};
  }
  #shopify-section-{{ sid }} .cmp__mark--no {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: {{ st.mark_size | default: 30 }}px;
    height: {{ st.mark_size | default: 30 }}px;
    color: {% render 'scheme-color', color: st.mark_color_no, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .cmp__mark svg     { width: 60%; height: 60%; fill: currentColor; }
  #shopify-section-{{ sid }} .cmp__mark--no svg { width: 70%; height: 70%; }

  /* Mobile / narrow-container tweaks — driven by container width so
     they fire correctly inside the editor's mobile preview iframe. */
  #shopify-section-{{ sid }} .cmp__table-wrap {
    --capsule-w: {{ cap_w_mobile }}px;
    --capsule-overhang: {{ cap_overhang_mob }}px;
  }
  @container cmp (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__table-wrap {
      --capsule-w: {{ cap_w }}px;
      --capsule-overhang: {{ cap_overhang }}px;
    }
  }

  @container cmp (max-width: 600px) {
    #shopify-section-{{ sid }} .cmp__cell { padding: 12px 4px; }
    #shopify-section-{{ sid }} .cmp__cell.cmp__feature { padding-left: 12px; padding-right: 4px; font-size: 13px; }
    #shopify-section-{{ sid }} .cmp__cell.cmp__head { font-size: 13px; padding-top: 12px; padding-bottom: 12px; }
    #shopify-section-{{ sid }} .cmp__mark,
    #shopify-section-{{ sid }} .cmp__mark--no { width: 24px; height: 24px; }
    /* Anchor the BRAND logo to just above the table top edge —
       previous default left it floating high in the capsule. */
    #shopify-section-{{ sid }} .cmp__capsule-logo {
      font-size: 16px;
      top: calc({{ cap_overhang_mob }}px - 18px) !important;
    }
  }
  /* Stacked layout (mobile / narrow container) — extra vertical gap
     between text column and the capsule that extends above the table,
     so the subheading doesn't touch the brand capsule. */
  @container cmp (max-width: 759px) {
    #shopify-section-{{ sid }} .cmp__inner {
      gap: calc({{ st.col_gap_mobile | default: 40 }}px + {{ cap_overhang_mob }}px + 16px) !important;
    }
  }
  @media (max-width: 759px) {
    #shopify-section-{{ sid }} .cmp__inner {
      gap: calc({{ st.col_gap_mobile | default: 40 }}px + {{ cap_overhang_mob }}px + 16px) !important;
    }
    #shopify-section-{{ sid }} .cmp__capsule-logo {
      top: calc({{ cap_overhang_mob }}px - 18px) !important;
    }
  }
  @container cmp (max-width: 380px) {
    #shopify-section-{{ sid }} .cmp__cell.cmp__feature { font-size: 12px; padding-left: 8px; }
    #shopify-section-{{ sid }} .cmp__cell { padding: 10px 2px; }
    #shopify-section-{{ sid }} .cmp__mark,
    #shopify-section-{{ sid }} .cmp__mark--no { width: 20px; height: 20px; }
  }
  /* Viewport fallbacks for older browsers */
  @supports not (container-type: inline-size) {
    @media (max-width: 600px) {
      #shopify-section-{{ sid }} .cmp__cell { padding: 12px 4px; }
      #shopify-section-{{ sid }} .cmp__cell.cmp__feature { padding-left: 12px; font-size: 13px; }
      #shopify-section-{{ sid }} .cmp__cell.cmp__head { font-size: 13px; }
      #shopify-section-{{ sid }} .cmp__mark,
      #shopify-section-{{ sid }} .cmp__mark--no { width: 24px; height: 24px; }
      #shopify-section-{{ sid }} .cmp__capsule-logo { font-size: 16px; top: 8px; }
      #shopify-section-{{ sid }} .cmp__sub { font-size: 14px; }
    }
  }

  /* Bottom wave/dune pattern — fills entire pattern area */
  #shopify-section-{{ sid }} .cmp__pattern {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    pointer-events: none;
    height: {{ st.pattern_height | default: 80 }}px;
    overflow: hidden;
    z-index: 0;
  }
  #shopify-section-{{ sid }} .cmp__pattern svg {
    position: absolute; left: 0; bottom: 0;
    width: 100%; height: 100%;
    display: block;
  }
{% comment %}{% endcomment %}</style>

<div id="cmp-{{ sid }}" class="cmp section sec__comparisons color-{{ color_scheme }} gradient {{ st.section_width }}{% if st.reset_spacing %} remove_spacing{% endif %}" data-section-id="{{ sid }}">
  <div class="cmp__inner">

    <div class="cmp__text">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'eyebrow' -%}
              {%- assign bs = block.settings -%}
              {%- if bs.text != blank -%}
                <p class="cmp__eyebrow"
                   style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
                          font-size: {{ bs.size | default: 13 }}px;
                          letter-spacing: {{ bs.letter_spacing | default: 0.18 }}em;
                          text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};"
                   {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- assign bs = block.settings -%}
              {%- if bs.text != blank -%}
                {%- assign h_text = bs.text -%}
                {%- assign h_tag  = bs.tag | default: 'h2' -%}
                {%- assign h_hl   = bs.highlight_text | strip -%}
                {%- assign show_swoosh   = bs.show_swoosh -%}
                {%- capture swoosh_color -%}{% render 'scheme-color', color: bs.swoosh_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
                {%- assign swoosh_width  = bs.swoosh_width  | default: 260 -%}
                {%- assign swoosh_y      = bs.swoosh_y_offset      | default: -2 -%}
                {%- assign swoosh_scale  = bs.swoosh_x_scale       | default: 100 -%}
                {%- assign swoosh_under_w = bs.swoosh_under_width  | default: 110 -%}
                {%- assign h_size_mob    = bs.size_mobile          | default: 40 -%}
                {%- assign h_size_desk   = bs.size_desktop         | default: 72 -%}
                <div class="cmp__heading-wrap" style="--h-size-mob: {{ h_size_mob }}px; --h-size-desk: {{ h_size_desk }}px;" {{ block.shopify_attributes }}>
                  <{{ h_tag }} class="cmp__heading"
                     style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
                            text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};">
                  {%- if h_hl != blank and h_text contains h_hl -%}
                    {%- assign parts = h_text | split: h_hl -%}
                    {%- assign before = parts | first -%}
                    {%- assign after = '' -%}
                    {%- for p in parts offset: 1 -%}
                      {%- if forloop.first -%}
                        {%- assign after = p -%}
                      {%- else -%}
                        {%- assign after = after | append: h_hl | append: p -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {{ before | escape }}<span class="cmp__heading-hl" style="--swoosh-w: {{ swoosh_under_w }}%; --swoosh-y: {{ swoosh_y }}px; --swoosh-sx: {{ swoosh_scale | divided_by: 100.0 }};">{{ h_hl | escape }}{%- if show_swoosh -%}<span class="cmp__swoosh cmp__swoosh--under" aria-hidden="true" style="color: {{ swoosh_color }};">{%- if bs.swoosh_image != blank -%}<img src="{{ bs.swoosh_image | image_url: width: 600 }}" alt="" loading="lazy">{%- else -%}<svg viewBox="0 0 320 32" preserveAspectRatio="none" aria-hidden="true"><path d="M8 18 C 50 30, 110 6, 170 22 S 270 26, 312 14"/></svg>{%- endif -%}</span>{%- endif -%}</span>{{ after | escape }}
                  {%- else -%}
                    {{ h_text | escape }}
                  {%- endif -%}
                  </{{ h_tag }}>
                  {%- if show_swoosh and h_hl == blank -%}
                    <span class="cmp__swoosh cmp__swoosh--block" aria-hidden="true" style="color: {{ swoosh_color }}; --swoosh-w: {{ swoosh_width }}px;">
                      {%- if bs.swoosh_image != blank -%}
                        <img src="{{ bs.swoosh_image | image_url: width: 600 }}" alt="" loading="lazy">
                      {%- else -%}
                        <svg viewBox="0 0 320 32" preserveAspectRatio="none" aria-hidden="true">
                          <path d="M8 18 C 50 30, 110 6, 170 22 S 270 26, 312 14"/>
                        </svg>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- assign bs = block.settings -%}
              {%- if bs.text != blank -%}
                <div class="cmp__sub"
                     style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
                            max-width: {{ bs.max_width | default: 480 }}px;
                            padding-top: {{ bs.padding_top | default: 20 }}px;
                            --sub-size-mob: {{ bs.size_mobile | default: 14 }}px;
                            --sub-size-desk: {{ bs.size | default: 16 }}px;"
                     {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="cmp__table-col">
      <div class="cmp__table-wrap">
        <div class="cmp__table">
          {%- if brand_index >= 0 -%}
            <div class="cmp__capsule">
              <span class="cmp__capsule-logo">
                {%- if brand_col.settings.logo_image != blank -%}
                  <img src="{{ brand_col.settings.logo_image | image_url: width: 220 }}" alt="{{ brand_col.settings.title | default: fb_accessibility_brand | escape }}">
                {%- else -%}
                  {{ brand_col.settings.title | default: fb_accessibility_brand_uppercase | escape }}
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}

          <div class="cmp__cell cmp__head" aria-hidden="true">&nbsp;</div>
          {%- for col in columns -%}
            <div class="cmp__cell cmp__head{% if col.settings.is_brand %} is-brand-col{% endif %}" {{ col.shopify_attributes }}>{{ col.settings.title | escape }}</div>
          {%- endfor -%}

          {%- if rows.size > 0 -%}
            {%- for row in rows -%}
              {%- assign rb = row.settings -%}
              {%- assign vals = rb.values | default: '' | split: ',' -%}
              {%- assign last_class = '' -%}
              {%- if forloop.last -%}{%- assign last_class = ' is-last-row' -%}{%- endif -%}
              <div class="cmp__cell cmp__feature{{ last_class }}" {{ row.shopify_attributes }}>{{ rb.feature | escape }}</div>
              {%- for col in columns -%}
                {%- assign v = vals[forloop.index0] | default: 'no' | strip -%}
                {%- assign is_brand_col = col.settings.is_brand -%}
                <div class="cmp__cell{{ last_class }}{% if is_brand_col %} is-brand-col{% endif %}">
                  {%- if v == 'yes' -%}
                    {%- assign yes_style = st.yes_icon_style | default: 'check_filled' -%}
                    {%- assign mark_extra_class = '' -%}
                    {%- if yes_style == 'check_minimal' or yes_style == 'star_minimal' -%}{%- assign mark_extra_class = ' cmp__mark--minimal' -%}{%- endif -%}
                    <span class="cmp__mark{% if is_brand_col %} cmp__mark--brand{% endif %}{{ mark_extra_class }}" aria-label="{{ 'accessibility.yes' | t }}">
                      {%- case yes_style -%}
                        {%- when 'check_filled' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2l-3.5-3.5L4 14.2l5 5L20 8.2l-1.5-1.5z"/></svg>
                        {%- when 'check_bold' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M5 12 l5 5 L20 7"/></svg>
                        {%- when 'check_minimal' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M5 12 l5 5 L20 7"/></svg>
                        {%- when 'circle_dot' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" fill="currentColor"/></svg>
                        {%- when 'star' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2 L14.6 9 22 9.5 16.3 14.3 18.2 22 12 18 5.8 22 7.7 14.3 2 9.5 9.4 9 Z"/></svg>
                        {%- when 'star_minimal' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="none"><path d="M12 2 L14.6 9 22 9.5 16.3 14.3 18.2 22 12 18 5.8 22 7.7 14.3 2 9.5 9.4 9 Z"/></svg>
                        {%- when 'thumbs_up' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M2 21h3V9H2v12zm19-12h-6.3l.9-4.3v-.3c0-.4-.2-.8-.4-1.1L14.2 2 7.6 8.6c-.4.4-.6.9-.6 1.4V19c0 1.1.9 2 2 2h8.5c.8 0 1.5-.5 1.8-1.2l3-7c.1-.3.2-.5.2-.8v-2c0-.6-.4-1-1-1z"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2l-3.5-3.5L4 14.2l5 5L20 8.2l-1.5-1.5z"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- else -%}
                    <span class="cmp__mark--no" aria-label="No">
                      {%- assign no_style = st.no_icon_style | default: 'x_bold' -%}
                      {%- case no_style -%}
                        {%- when 'x_bold' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none"><path d="M5 5l14 14M19 5L5 19"/></svg>
                        {%- when 'x_thin' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"><path d="M5 5l14 14M19 5L5 19"/></svg>
                        {%- when 'dash' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none"><path d="M5 12h14"/></svg>
                        {%- when 'circle_empty' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="6"/></svg>
                        {%- when 'thumbs_down' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M22 3h-3v12h3V3zM3 15h6.3l-.9 4.3v.3c0 .4.2.8.4 1.1L10.8 22l6.6-6.6c.4-.4.6-.9.6-1.4V5c0-1.1-.9-2-2-2H7.5c-.8 0-1.5.5-1.8 1.2l-3 7c-.1.3-.2.5-.2.8v2c0 .6.4 1 1 1z"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" fill="none"><path d="M5 5l14 14M19 5L5 19"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>

  {%- if st.pattern_style != 'none' -%}
    <div class="cmp__pattern" aria-hidden="true">
      {%- case st.pattern_style -%}
        {%- when 'wave' -%}
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_2, fallback: 'color-mix(in srgb, var(--color-text) 9%, var(--color-background))' %}" d="M0,20 C160,0 320,40 480,20 C640,0 800,40 960,20 C1120,0 1280,40 1440,20 L1440,80 L0,80 Z"/>
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_1, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %}" d="M0,50 C180,30 360,68 540,50 C720,32 900,68 1080,50 C1260,34 1380,62 1440,50 L1440,80 L0,80 Z"/>
          </svg>
        {%- when 'scallop' -%}
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_2, fallback: 'color-mix(in srgb, var(--color-text) 9%, var(--color-background))' %}" d="M0,30 Q90,5 180,30 T360,30 T540,30 T720,30 T900,30 T1080,30 T1260,30 T1440,30 L1440,80 L0,80 Z"/>
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_1, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %}" d="M0,55 Q90,30 180,55 T360,55 T540,55 T720,55 T900,55 T1080,55 T1260,55 T1440,55 L1440,80 L0,80 Z"/>
          </svg>
        {%- when 'angle' -%}
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_2, fallback: 'color-mix(in srgb, var(--color-text) 9%, var(--color-background))' %}" d="M0,15 L1440,40 L1440,80 L0,80 Z"/>
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_1, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %}" d="M0,55 L1440,30 L1440,80 L0,80 Z"/>
          </svg>
        {%- when 'tilt' -%}
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_2, fallback: 'color-mix(in srgb, var(--color-text) 9%, var(--color-background))' %}" d="M0,20 L1440,40 L1440,80 L0,80 Z"/>
            <path style="fill: {% render 'scheme-color', color: st.pattern_color_1, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %}" d="M0,40 L1440,60 L1440,80 L0,80 Z"/>
          </svg>
        {%- when 'flat' -%}
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <rect x="0" y="20" width="1440" height="60" style="fill: {% render 'scheme-color', color: st.pattern_color_2, fallback: 'color-mix(in srgb, var(--color-text) 9%, var(--color-background))' %}"/>
            <rect x="0" y="50" width="1440" height="30" style="fill: {% render 'scheme-color', color: st.pattern_color_1, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %}"/>
          </svg>
      {%- endcase -%}
    </div>
  {%- endif -%}
</div>



</template>

<schema>
{
  "type": "comparisons-table",
  "name": "Comparison Table 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Columns"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text column position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Column vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_col_width",
      "label": "Text column width (desktop)",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Text column gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Table"
    },
    {
      "type": "color",
      "id": "table_bg",
      "label": "Table background"
    },
    {
      "type": "color",
      "id": "table_divider",
      "label": "Row divider color"
    },
    {
      "type": "color",
      "id": "table_head_bg",
      "label": "Header row background"
    },
    {
      "type": "color",
      "id": "table_head_color",
      "label": "Header text color"
    },
    {
      "type": "color",
      "id": "feature_color",
      "label": "Feature label color"
    },
    {
      "type": "range",
      "id": "feature_size",
      "label": "Feature label size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "col_head_size",
      "label": "Column header size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "cell_pad_y",
      "label": "Cell vertical padding",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "table_radius",
      "label": "Table corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "table_max_width",
      "label": "Table max width",
      "min": 360,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "label_col_pct",
      "label": "Feature column width",
      "min": 24,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Yes / No icons"
    },
    {
      "type": "select",
      "id": "yes_icon_style",
      "label": "Yes icon style",
      "default": "check_filled",
      "options": [
        {
          "value": "check_filled",
          "label": "Filled circle + check"
        },
        {
          "value": "check_bold",
          "label": "Bold check"
        },
        {
          "value": "check_minimal",
          "label": "Minimal check (no bg)"
        },
        {
          "value": "circle_dot",
          "label": "Filled dot"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "star_minimal",
          "label": "Outlined star"
        },
        {
          "value": "thumbs_up",
          "label": "Thumbs up"
        }
      ]
    },
    {
      "type": "select",
      "id": "no_icon_style",
      "label": "No icon style",
      "default": "x_bold",
      "options": [
        {
          "value": "x_bold",
          "label": "Bold X"
        },
        {
          "value": "x_thin",
          "label": "Thin X"
        },
        {
          "value": "dash",
          "label": "Dash"
        },
        {
          "value": "circle_empty",
          "label": "Empty circle"
        },
        {
          "value": "thumbs_down",
          "label": "Thumbs down"
        }
      ]
    },
    {
      "type": "range",
      "id": "mark_size",
      "label": "Icon size",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "mark_bg_neutral",
      "label": "Yes bg (other columns)"
    },
    {
      "type": "color",
      "id": "mark_color_neutral",
      "label": "Yes color (other columns)"
    },
    {
      "type": "color",
      "id": "mark_bg_brand",
      "label": "Yes bg (brand column)"
    },
    {
      "type": "color",
      "id": "mark_color_brand",
      "label": "Yes color (brand column)"
    },
    {
      "type": "color",
      "id": "mark_color_no",
      "label": "No icon color"
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Bottom pattern"
    },
    {
      "type": "select",
      "id": "pattern_style",
      "label": "Pattern",
      "default": "wave",
      "options": [
        {
          "value": "wave",
          "label": "Smooth waves"
        },
        {
          "value": "scallop",
          "label": "Scalloped"
        },
        {
          "value": "angle",
          "label": "Angled layers"
        },
        {
          "value": "tilt",
          "label": "Soft tilt"
        },
        {
          "value": "flat",
          "label": "Flat band"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "color",
      "id": "pattern_color_1",
      "label": "Pattern color (front)"
    },
    {
      "type": "color",
      "id": "pattern_color_2",
      "label": "Pattern color (back)"
    },
    {
      "type": "range",
      "id": "pattern_height",
      "label": "Pattern height",
      "min": 40,
      "max": 220,
