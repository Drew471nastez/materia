<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Comparison Table 4.

  Eyebrow, heading (with an optional underline swoosh under a word) and
  subheading blocks beside a table: one column block per brand, the one
  marked as yours drawn as a filled capsule that runs past the table's top
  and bottom, one row block per feature with yes/no values. The table
  scrolls sideways inside its own frame when it does not fit (feature
  labels stay in view). A wave, scallop or angled band closes the section.
  Colours follow the colour scheme until Enable custom styling is on.
  Live edits: assets/live-features-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign columns = section.blocks | where: 'type', 'column_header'
  assign rows = section.blocks | where: 'type', 'row'
  assign col_count = columns.size
  assign brand_index = -1
  for col in columns
    if col.settings.is_brand
      assign brand_index = forloop.index0
      break
    endif
  endfor
  assign brand_col = nil
  if brand_index >= 0
    assign brand_col = columns[brand_index]
  endif
  assign title_done = false
  assign yes_styles = 'check_filled,check_bold,check_minimal,circle_dot,star,star_minimal,thumbs_up' | split: ','
  assign no_styles = 'x_bold,x_thin,dash,circle_empty,thumbs_down' | split: ','
  assign pat_styles = 'wave,scallop,angle,tilt,flat' | split: ','
  assign spx = 'text_col_width:%,col_gap_desktop,col_gap_mobile,text_gap,feature_size,col_head_size,cell_pad_y,table_radius,table_max_width,label_col_pct:%,mark_size,pattern_height,padding_top_desktop,padding_bottom_desktop,padding_top_mobile,padding_bottom_mobile,left_padding_desktop,right_padding_desktop,left_padding_mobile,right_padding_mobile'
  assign sc = 'section_bg,text_color,table_bg,table_divider,table_head_bg,table_head_color,feature_color,mark_bg_neutral,mark_color_neutral,mark_bg_brand,mark_color_brand,mark_color_no,pattern_color_1,pattern_color_2'
  assign sf = 'enable_custom_fonts:heading_font,enable_custom_fonts:body_font'
  assign sa = 'section_width,text_position,text_align,column_valign,yes_icon_style,no_icon_style,pattern_style,reset_spacing'
  assign sa_list = sa | split: ','
  assign stx = 'check_label,cross_label'
  assign e_px = 'size,letter_spacing:em'
  assign h_px = 'size_desktop,size_mobile,swoosh_width,swoosh_under_width:%,swoosh_y_offset,swoosh_x_scale:n'
  assign s_px = 'size,size_mobile,max_width,padding_top'
  assign c_px = 'cap_width,cap_width_mobile,cap_overhang,cap_overhang_mobile,logo_top_offset,logo_size,logo_rotate:deg'
-%}
{%- capture swoosh_svg -%}<svg viewBox="0 0 320 32" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M8 18 C 50 30, 110 6, 170 22 S 270 26, 312 14"/></svg>{%- endcapture -%}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { position: relative; isolation: isolate; z-index: 0; }
  #shopify-section-{{ sid }} .cmp { --hf: var(--fb-heading_font, var(--heading-font)); --bf: var(--fb-body_font, var(--body-font)); container-type: inline-size; position: relative; overflow: hidden; background: var(--fb-section_bg, var(--color-background)); color: var(--fb-text_color, var(--color-text)); font-family: var(--bf); padding: var(--fb-padding_top_mobile) var(--fb-right_padding_mobile) var(--fb-padding_bottom_mobile) var(--fb-left_padding_mobile); }
  #shopify-section-{{ sid }} .cmp *, #shopify-section-{{ sid }} .cmp *::before, #shopify-section-{{ sid }} .cmp *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cmp[data-section_width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cmp[data-section_width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cmp[data-section_width='fluid_container'] .cmp__inner { max-width: var(--fluid-container-width, 1500px); }
  #shopify-section-{{ sid }} .cmp[data-section_width='stretch_width'] .cmp__inner { max-width: none; }
  #shopify-section-{{ sid }} .cmp__inner { position: relative; z-index: 2; margin-inline: auto; max-width: var(--page-width, 1300px); display: flex; flex-direction: column; gap: var(--fb-col_gap_mobile); text-align: center; }
  #shopify-section-{{ sid }} .cmp__text { display: flex; flex-direction: column; align-items: center; gap: var(--fb-text_gap); min-width: 0; }
  #shopify-section-{{ sid }} .cmp__eyebrow { margin: 0; color: var(--fb-color, var(--color-text)); font-size: var(--fb-size); letter-spacing: var(--fb-letter_spacing); text-transform: none; }
  #shopify-section-{{ sid }} .cmp__eyebrow[data-uppercase='true'] { text-transform: uppercase; }
  #shopify-section-{{ sid }} .cmp__hwrap { position: relative; width: 100%; min-width: 0; }
  #shopify-section-{{ sid }} .cmp__heading { margin: 0; color: var(--fb-color, var(--color-heading)); font-family: var(--hf); font-size: var(--fb-size_mobile); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .cmp__hwrap[data-uppercase='true'] .cmp__heading { text-transform: uppercase !important; }
  #shopify-section-{{ sid }} .cmp__hl { position: relative; display: inline-block; white-space: nowrap; }
  #shopify-section-{{ sid }} .cmp__swoosh { color: var(--fb-swoosh_color, var(--color-primary)); pointer-events: none; }
  #shopify-section-{{ sid }} .cmp__swoosh--under { position: absolute; left: 50%; top: 100%; width: var(--fb-swoosh_under_width); transform: translate(-50%, var(--fb-swoosh_y_offset)) scaleX(calc(var(--fb-swoosh_x_scale) / 100)); }
  #shopify-section-{{ sid }} .cmp__swoosh--block { display: block; margin: -8px 0 0 auto; width: var(--fb-swoosh_width); max-width: 75%; }
  #shopify-section-{{ sid }} .cmp__hwrap[data-hl='true'] .cmp__swoosh--block, #shopify-section-{{ sid }} .cmp__hwrap[data-show_swoosh='false'] .cmp__swoosh { display: none; }
  #shopify-section-{{ sid }} .cmp__swoosh svg { width: 100%; height: auto; display: block; fill: none; stroke: currentColor; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ sid }} .cmp__swoosh img { width: 100%; height: auto; display: block; }
  #shopify-section-{{ sid }} .cmp__sub { margin: 0; padding-top: var(--fb-padding_top); max-width: var(--fb-max_width); color: var(--fb-color, var(--color-text)); font-size: var(--fb-size_mobile); line-height: 1.55; }
  #shopify-section-{{ sid }} .cmp__sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .cmp__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .cmp__tablecol { min-width: 0; display: flex; justify-content: center; }
  #shopify-section-{{ sid }} .cmp__scroll { position: relative; width: 100%; max-width: var(--fb-table_max_width); overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
  #shopify-section-{{ sid }} .cmp__scroll[data-overflow] { cursor: grab; }
  #shopify-section-{{ sid }} .cmp__scroll[data-dragging] { cursor: grabbing; user-select: none; }
  #shopify-section-{{ sid }} .cmp__scroll:focus-visible { outline: 2px solid var(--color-heading); outline-offset: -2px; }
  #shopify-section-{{ sid }} .cmp__box { --ov: var(--fb-cap_overhang_mobile, 0px); --cw: var(--fb-cap_width_mobile, 0px); position: relative; padding-block: var(--ov); min-width: calc(120px + var(--n) * 64px); }
  #shopify-section-{{ sid }} :where(.cmp__table, .cmp__table th, .cmp__table td) { border: 0; padding: 0; font-weight: inherit; }
  #shopify-section-{{ sid }} .cmp__table { position: relative; width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; background: var(--fb-table_bg, var(--color-background)); border-radius: var(--fb-table_radius); box-shadow: 0 8px 28px rgba(0, 0, 0, .12); }
  #shopify-section-{{ sid }} .cmp__table col.cmp__c0 { width: var(--fb-label_col_pct); }
  #shopify-section-{{ sid }} .cmp__capsule { --cwx: min(var(--cw), (100% - var(--fb-label_col_pct)) / var(--n) - 4px); position: absolute; z-index: 1; top: 0; bottom: 0; width: var(--cwx); left: calc(var(--fb-label_col_pct) + (100% - var(--fb-label_col_pct)) / var(--n) * var(--bi) + ((100% - var(--fb-label_col_pct)) / var(--n) - var(--cwx)) / 2); background: var(--fb-cap_bg, var(--btn-primary-bg-color)); border-radius: 999px; box-shadow: 0 8px 24px rgba(0, 0, 0, .18); }
  #shopify-section-{{ sid }} .cmp__logo { position: absolute; top: calc(var(--ov) - 18px); left: 0; right: 0; text-align: center; color: var(--fb-cap_text, var(--btn-primary-color)); font-family: var(--hf); font-style: italic; font-weight: 900; font-size: 16px; line-height: 1; transform: rotate(var(--fb-logo_rotate)); overflow-wrap: anywhere; padding-inline: 4px; }
  #shopify-section-{{ sid }} .cmp__logo img { max-width: 80%; max-height: calc(var(--fb-logo_size) + 18px); width: auto; height: auto; object-fit: contain; display: inline-block; }
  #shopify-section-{{ sid }} .cmp__logo img[hidden] { display: none; }
  #shopify-section-{{ sid }} .cmp__logo:has(img:not([hidden])) .cmp__logo-text { display: none; }
  #shopify-section-{{ sid }} .cmp__table :is(th, td) { position: relative; z-index: 2; padding: 12px 4px; text-align: center; vertical-align: middle; border-bottom: 1px solid var(--fb-table_divider, var(--color-border)); color: var(--fb-feature_color, var(--color-heading)); }
  #shopify-section-{{ sid }} .cmp__table tbody tr:last-child > * { border-bottom: 0; }
  #shopify-section-{{ sid }} .cmp__head { font-weight: var(--subheading-weight, 700); font-size: 13px; color: var(--fb-table_head_color, var(--color-heading)) !important; background: var(--fb-table_head_bg, transparent); }
  #shopify-section-{{ sid }} .cmp__head[data-brand] > span { visibility: hidden; }
  #shopify-section-{{ sid }} .cmp__feature { position: sticky !important; left: 0; z-index: 3 !important; background: var(--fb-table_bg, var(--color-background)); text-align: start !important; padding-left: 12px !important; font-weight: var(--subheading-weight, 700); font-size: 13px; line-height: 1.25; overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .cmp__table thead .cmp__feature { background: var(--fb-table_head_bg, var(--fb-table_bg, var(--color-background))); }
  #shopify-section-{{ sid }} .cmp__table tbody tr:first-child .cmp__feature { border-top-left-radius: 0; }
  #shopify-section-{{ sid }} .cmp__m { display: inline-flex; vertical-align: middle; }
  #shopify-section-{{ sid }} .cmp__m > span { display: none; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 999px; }
  #shopify-section-{{ sid }} .cmp__m[data-v='yes'] > .cmp__yes, #shopify-section-{{ sid }} .cmp__m:not([data-v='yes']) > .cmp__no { display: inline-flex; }
  #shopify-section-{{ sid }} .cmp__yes { background: var(--fb-mark_bg_neutral, color-mix(in srgb, var(--color-text) 10%, transparent)); color: var(--fb-mark_color_neutral, var(--color-text)); }
  #shopify-section-{{ sid }} td[data-brand] .cmp__yes { background: var(--fb-mark_bg_brand, var(--btn-primary-color)); color: var(--fb-mark_color_brand, var(--btn-primary-bg-color)); }
  #shopify-section-{{ sid }} .cmp:is([data-yes_icon_style='check_minimal'], [data-yes_icon_style='star_minimal']) .cmp__yes { background: transparent; }
  #shopify-section-{{ sid }} .cmp:is([data-yes_icon_style='check_minimal'], [data-yes_icon_style='star_minimal']) td[data-brand] .cmp__yes { color: var(--fb-mark_bg_brand, var(--btn-primary-color)); }
  #shopify-section-{{ sid }} .cmp__no { color: var(--fb-mark_color_no, var(--color-text)); opacity: .7; }
  #shopify-section-{{ sid }} .cmp__m svg { width: 60%; height: 60%; display: block; overflow: visible; }
  #shopify-section-{{ sid }} .cmp__no svg { width: 70%; height: 70%; }
  #shopify-section-{{ sid }} .cmp__m use { display: none; }
  {%- for y in yes_styles %}
  #shopify-section-{{ sid }} .cmp[data-yes_icon_style='{{ y }}'] .cmp__yes use.u-{{ y }} { display: inline; }
  {%- endfor -%}
  {%- for n in no_styles %}
  #shopify-section-{{ sid }} .cmp[data-no_icon_style='{{ n }}'] .cmp__no use.u-{{ n }} { display: inline; }
  {%- endfor %}
  #shopify-section-{{ sid }} .fb-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #shopify-section-{{ sid }} .cmp__pattern { position: absolute; left: 0; right: 0; bottom: 0; height: var(--fb-pattern_height); pointer-events: none; overflow: hidden; z-index: 0; }
  #shopify-section-{{ sid }} .cmp[data-pattern_style='none'] .cmp__pattern, #shopify-section-{{ sid }} .cmp__pattern svg { display: none; }
  {%- for p in pat_styles %}
  #shopify-section-{{ sid }} .cmp[data-pattern_style='{{ p }}'] .cmp__pattern svg.p-{{ p }} { display: block; }
  {%- endfor %}
  #shopify-section-{{ sid }} .cmp__pattern svg { position: absolute; left: 0; bottom: 0; width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .cmp__pattern .p2 { fill: var(--fb-pattern_color_2, color-mix(in srgb, var(--color-text) 9%, var(--color-background))); }
  #shopify-section-{{ sid }} .cmp__pattern .p1 { fill: var(--fb-pattern_color_1, color-mix(in srgb, var(--color-text) 4%, var(--color-background))); }
  @container (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp__inner { flex-direction: row; gap: var(--fb-col_gap_desktop); align-items: center; text-align: start; }
    #shopify-section-{{ sid }} .cmp[data-text_position='right'] .cmp__inner { flex-direction: row-reverse; }
    #shopify-section-{{ sid }} .cmp[data-column_valign='flex-start'] .cmp__inner { align-items: flex-start; }
    #shopify-section-{{ sid }} .cmp[data-column_valign='flex-end'] .cmp__inner { align-items: flex-end; }
    #shopify-section-{{ sid }} .cmp__text { flex: 0 1 var(--fb-text_col_width); max-width: var(--fb-text_col_width); align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .cmp[data-text_align='center'] .cmp__text { align-items: center; text-align: center; }
    #shopify-section-{{ sid }} .cmp[data-text_align='right'] .cmp__text { align-items: flex-end; text-align: right; }
    #shopify-section-{{ sid }} .cmp__tablecol { flex: 1 1 0; }
    #shopify-section-{{ sid }} .cmp__heading { font-size: var(--fb-size_desktop); }
    #shopify-section-{{ sid }} .cmp__sub { font-size: var(--fb-size); }
    #shopify-section-{{ sid }} .cmp__box { --ov: var(--fb-cap_overhang, 0px); --cw: var(--fb-cap_width, 0px); }
    #shopify-section-{{ sid }} .cmp__logo { top: var(--fb-logo_top_offset); font-size: var(--fb-logo_size); }
    #shopify-section-{{ sid }} .cmp__table :is(th, td) { padding: var(--fb-cell_pad_y) 12px; }
    #shopify-section-{{ sid }} .cmp__head { font-size: var(--fb-col_head_size); padding-block: 14px !important; }
    #shopify-section-{{ sid }} .cmp__feature { padding-left: 22px !important; font-size: var(--fb-feature_size); }
    #shopify-section-{{ sid }} .cmp__m > span { width: var(--fb-mark_size); height: var(--fb-mark_size); }
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .cmp { padding: var(--fb-padding_top_desktop) var(--fb-right_padding_desktop) var(--fb-padding_bottom_desktop) var(--fb-left_padding_desktop); }
    }
{% comment %}{% endcomment %}</style>
{%- capture spec -%}{"px":"{{ spx }}","c":"{{ sc }}","f":"{{ sf }}","a":"{{ sa }}","t":"{{ stx }}"}{%- endcapture -%}
{%- capture bspec -%}{"eyebrow":{"px":"{{ e_px }}","c":"color","a":"uppercase","t":"text"},"heading":{"px":"{{ h_px }}","c":"color,swoosh_color","a":"uppercase,show_swoosh","split":"text:highlight_text"},"subheading":{"px":"{{ s_px }}","c":"color","r":"text"},"column_header":{"px":"{{ c_px }}","c":"cap_bg,cap_text","t":"title","i":"logo_image"},"row":{"t":"feature","csv":"values"}}{%- endcapture -%}
<div class="cmp color-{{ color_scheme }} gradient" data-fb-root="comparisons-table" data-fb-section="{{ sid }}" data-fb-settings="{{ st | json | escape }}" data-fb-spec="{{ spec | escape }}" data-fb-bspec="{{ bspec | escape }}"{% for k in sa_list %} data-{{ k }}="{{ st[k] }}"{% endfor %}{% if st.enable_custom_fonts and st.body_font.family != blank %} data-own-font{% endif %} data-fb-f="body_font" style="{% render 'features-b-vars', s: st, px: spx, c: sc, f: sf, gate: st.enable_custom_style %}">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="fbcmp-{{ sid }}-check_filled" viewBox="0 0 24 24"><path fill="currentColor" d="M9 16.2l-3.5-3.5L4 14.2l5 5L20 8.2l-1.5-1.5z"/></symbol>
    <symbol id="fbcmp-{{ sid }}-check_bold" viewBox="0 0 24 24"><path d="M5 12 l5 5 L20 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-check_minimal" viewBox="0 0 24 24"><path d="M5 12 l5 5 L20 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-circle_dot" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" fill="currentColor"/></symbol>
    <symbol id="fbcmp-{{ sid }}-star" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2 L14.6 9 22 9.5 16.3 14.3 18.2 22 12 18 5.8 22 7.7 14.3 2 9.5 9.4 9 Z"/></symbol>
    <symbol id="fbcmp-{{ sid }}-star_minimal" viewBox="0 0 24 24"><path d="M12 2 L14.6 9 22 9.5 16.3 14.3 18.2 22 12 18 5.8 22 7.7 14.3 2 9.5 9.4 9 Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-thumbs_up" viewBox="0 0 24 24"><path fill="currentColor" d="M2 21h3V9H2v12zm19-12h-6.3l.9-4.3v-.3c0-.4-.2-.8-.4-1.1L14.2 2 7.6 8.6c-.4.4-.6.9-.6 1.4V19c0 1.1.9 2 2 2h8.5c.8 0 1.5-.5 1.8-1.2l3-7c.1-.3.2-.5.2-.8v-2c0-.6-.4-1-1-1z"/></symbol>
    <symbol id="fbcmp-{{ sid }}-x_bold" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-x_thin" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-dash" viewBox="0 0 24 24"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></symbol>
    <symbol id="fbcmp-{{ sid }}-circle_empty" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="fbcmp-{{ sid }}-thumbs_down" viewBox="0 0 24 24"><path fill="currentColor" d="M22 3h-3v12h3V3zM3 15h6.3l-.9 4.3v.3c0 .4.2.8.4 1.1L10.8 22l6.6-6.6c.4-.4.6-.9.6-1.4V5c0-1.1-.9-2-2-2H7.5c-.8 0-1.5.5-1.8 1.2l-3 7c-.1.3-.2.5-.2.8v2c0 .6.4 1 1 1z"/></symbol>
  </svg>
  <div class="cmp__inner">
    <div class="cmp__text">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="cmp__eyebrow" data-fb-block="{{ block.id }}" data-fb-type="eyebrow" data-fb-bs="{{ bs | json | escape }}" data-fb-bt="{{ block.id }}:text" data-uppercase="{{ bs.uppercase }}" style="{% render 'features-b-vars', s: bs, px: e_px, c: 'color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
          {%- when 'heading' -%}
            {%- assign h_text = bs.text | default: '' -%}
            {%- assign h_hl = bs.highlight_text | strip -%}
            {%- assign has_hl = false -%}
            {%- if h_hl != blank and h_text contains h_hl -%}{%- assign has_hl = true -%}{%- endif -%}
            {%- capture swoosh -%}{%- if bs.swoosh_image != blank -%}<img src="{{ bs.swoosh_image | image_url: width: 600 }}" alt="" width="300" height="30" loading="lazy">{%- else -%}{{ swoosh_svg }}{%- endif -%}{%- endcapture -%}
            <div class="cmp__hwrap" data-fb-block="{{ block.id }}" data-fb-type="heading" data-fb-bs="{{ bs | json | escape }}" data-uppercase="{{ bs.uppercase }}" data-show_swoosh="{{ bs.show_swoosh }}" data-hl="{{ has_hl }}" style="{% render 'features-b-vars', s: bs, px: h_px, c: 'color,swoosh_color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>
              <h2{% unless title_done %} id="fb-title-{{ sid }}"{% assign title_done = true %}{% endunless %} class="cmp__heading" data-fb-bsplit="{{ block.id }}:text" data-fb-f="heading_font"{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %}>
                {%- if has_hl -%}
                  {%- assign parts = h_text | split: h_hl -%}
                  {%- assign before = parts | first -%}
                  {%- assign after = '' -%}
                  {%- for p in parts offset: 1 -%}{%- if forloop.first -%}{%- assign after = p -%}{%- else -%}{%- assign after = after | append: h_hl | append: p -%}{%- endif -%}{%- endfor -%}
                  {%- if h_text == h_hl -%}{%- assign before = '' -%}{%- endif -%}
                  {{ before | escape }}<span class="cmp__hl">{{ h_hl | escape }}<span class="cmp__swoosh cmp__swoosh--under" aria-hidden="true">{{ swoosh }}</span></span>{{ after | escape }}
                {%- else -%}{{ h_text | escape }}{%- endif -%}
              </h2>
              <template class="cmp__swoosh-tpl"><span class="cmp__swoosh cmp__swoosh--under" aria-hidden="true">{{ swoosh }}</span></template>
              <span class="cmp__swoosh cmp__swoosh--block" aria-hidden="true">{{ swoosh }}</span>
            </div>
          {%- when 'subheading' -%}
            <div class="cmp__sub" data-fb-block="{{ block.id }}" data-fb-type="subheading" data-fb-bs="{{ bs | json | escape }}" data-fb-bt="{{ block.id }}:text" style="{% render 'features-b-vars', s: bs, px: s_px, c: 'color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if col_count > 0 -%}
    <div class="cmp__tablecol">
      <div class="cmp__scroll" data-fb-scroll role="region" {% if title_done %}aria-labelledby="fb-title-{{ sid }}"{% else %}aria-label="{{ columns.first.settings.title | escape }}"{% endif %} tabindex="0">
        <div class="cmp__box"{% if brand_col %} data-fb-block="{{ brand_col.id }}" style="--n: {{ col_count }}; --bi: {{ brand_index }}; {% render 'features-b-vars', s: brand_col.settings, px: c_px, c: 'cap_bg,cap_text', gate: brand_col.settings.enable_custom_style %}"{% else %} style="--n: {{ col_count }}; --bi: 0;"{% endif %}>
          {%- if brand_col -%}
            <div class="cmp__capsule" aria-hidden="true">
              <span class="cmp__logo"><img data-fb-bi="{{ brand_col.id }}:logo_image" src="{% if brand_col.settings.logo_image != blank %}{{ brand_col.settings.logo_image | image_url: width: 220 }}{% endif %}" alt="" width="110" height="40" loading="lazy"{% if brand_col.settings.logo_image == blank %} hidden data-fb-empty{% endif %}><span class="cmp__logo-text" data-fb-bt="{{ brand_col.id }}:title">{{ brand_col.settings.title | escape }}</span></span>
            </div>
          {%- endif -%}
          <table class="cmp__table">
            <colgroup><col class="cmp__c0">{% for col in columns %}<col>{% endfor %}</colgroup>
            <thead>
              <tr>
                <td class="cmp__head cmp__feature"></td>
                {%- for col in columns -%}
                  <th scope="col" class="cmp__head" data-fb-block="{{ col.id }}" data-fb-type="column_header" data-fb-bs="{{ col.settings | json | escape }}"{% if col.settings.is_brand %} data-brand{% endif %} style="{% render 'features-b-vars', s: col.settings, px: c_px, c: 'cap_bg,cap_text', gate: col.settings.enable_custom_style %}" {{ col.shopify_attributes }}><span data-fb-bt="{{ col.id }}:title">{{ col.settings.title | escape }}</span></th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in rows -%}
                {%- assign rb = row.settings -%}
                {%- assign vals = rb.values | default: '' | split: ',' -%}
                <tr data-fb-block="{{ row.id }}" data-fb-type="row" data-fb-bs="{{ rb | json | escape }}" {{ row.shopify_attributes }}>
                  <th scope="row" class="cmp__feature" data-fb-bt="{{ row.id }}:feature">{{ rb.feature | escape }}</th>
                  {%- for col in columns -%}
                    {%- assign v = vals[forloop.index0] | default: 'no' | strip -%}
                    {%- if v == blank -%}{%- assign v = 'no' -%}{%- endif -%}
                    <td{% if col.settings.is_brand %} data-brand{% endif %}>
                      <span class="cmp__m" data-fb-bcsv="{{ row.id }}:values" data-i="{{ forloop.index0 }}" data-v="{{ v }}">
                        <span class="cmp__yes"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">{% for y in yes_styles %}<use class="u-{{ y }}" href="#fbcmp-{{ sid }}-{{ y }}"/>{% endfor %}</svg><span class="fb-vh" data-fb-t="check_label">{{ st.check_label }}</span></span>
                        <span class="cmp__no"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">{% for n in no_styles %}<use class="u-{{ n }}" href="#fbcmp-{{ sid }}-{{ n }}"/>{% endfor %}</svg><span class="fb-vh" data-fb-t="cross_label">{{ st.cross_label }}</span></span>
                      </span>
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>
  <div class="cmp__pattern" aria-hidden="true">
    <svg class="p-wave" viewBox="0 0 1440 80" preserveAspectRatio="none"><path class="p2" d="M0,20 C160,0 320,40 480,20 C640,0 800,40 960,20 C1120,0 1280,40 1440,20 L1440,80 L0,80 Z"/><path class="p1" d="M0,50 C180,30 360,68 540,50 C720,32 900,68 1080,50 C1260,34 1380,62 1440,50 L1440,80 L0,80 Z"/></svg>
    <svg class="p-scallop" viewBox="0 0 1440 80" preserveAspectRatio="none"><path class="p2" d="M0,30 Q90,5 180,30 T360,30 T540,30 T720,30 T900,30 T1080,30 T1260,30 T1440,30 L1440,80 L0,80 Z"/><path class="p1" d="M0,55 Q90,30 180,55 T360,55 T540,55 T720,55 T900,55 T1080,55 T1260,55 T1440,55 L1440,80 L0,80 Z"/></svg>
    <svg class="p-angle" viewBox="0 0 1440 80" preserveAspectRatio="none"><path class="p2" d="M0,15 L1440,40 L1440,80 L0,80 Z"/><path class="p1" d="M0,55 L1440,30 L1440,80 L0,80 Z"/></svg>
    <svg class="p-tilt" viewBox="0 0 1440 80" preserveAspectRatio="none"><path class="p2" d="M0,20 L1440,40 L1440,80 L0,80 Z"/><path class="p1" d="M0,40 L1440,60 L1440,80 L0,80 Z"/></svg>
    <svg class="p-flat" viewBox="0 0 1440 80" preserveAspectRatio="none"><rect class="p2" x="0" y="20" width="1440" height="60"/><rect class="p1" x="0" y="50" width="1440" height="30"/></svg>
  </div>
</div>
</template>

<schema>
{
  "type": "comparisons-table",
  "name": "Comparison Table 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "id": "check_label",
      "type": "text",
      "default": "Included",
      "label": "Check label (screen readers)"
    },
    {
      "id": "cross_label",
      "type": "text",
      "default": "Not included",
      "label": "Cross label (screen readers)"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_col_width",
      "label": "Text column width (desktop)",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Gap text to table (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between text blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "table_max_width",
      "label": "Table max width",
      "min": 360,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "label_col_pct",
      "label": "Feature column width",
      "min": 24,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 36
    },
    {
      "type": "range",
      "id": "cell_pad_y",
      "label": "Row padding y (desktop)",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "table_radius",
      "label": "Table corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Icons"
    },
    {
      "type": "select",
      "id": "yes_icon_style",
      "label": "Yes icon",
      "default": "check_filled",
      "options": [
        {
          "value": "check_filled",
          "label": "Check"
        },
        {
          "value": "check_bold",
          "label": "Bold check"
        },
        {
          "value": "check_minimal",
          "label": "Thin check"
        },
        {
          "value": "circle_dot",
          "label": "Dot"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "star_minimal",
          "label": "Star outline"
        },
        {
          "value": "thumbs_up",
          "label": "Thumb up"
        }
      ]
    },
    {
      "type": "select",
      "id": "no_icon_style",
      "label": "No icon",
      "default": "x_bold",
      "options": [
        {
          "value": "x_bold",
          "label": "Bold cross"
        },
        {
          "value": "x_thin",
          "label": "Thin cross"
        },
        {
          "value": "dash",
          "label": "Dash"
        },
        {
          "value": "circle_empty",
          "label": "Empty circle"
        },
        {
          "value": "thumbs_down",
          "label": "Thumb down"
        }
      ]
    },
    {
      "type": "range",
      "id": "mark_size",
      "label": "Icon size (desktop)",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Bottom pattern"
    },
    {
      "type": "select",
      "id": "pattern_style",
      "label": "Pattern",
      "default": "wave",
      "options": [
        {
          "value": "wave",
          "label": "Smooth waves"
        },
        {
          "value": "scallop",
          "label": "Scalloped"
        },
        {
          "value": "angle",
          "label": "Angled layers"
        },
        {
          "value": "tilt",
          "label": "Soft tilt"
        },
        {
          "value": "flat",
          "label": "Flat band"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "range",
      "id": "pattern_height",
      "label": "Pattern height",
      "min": 40,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.pattern_style != 'none' }}"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Appearance"
    },
    {
      "id": "enable_custom_style",
      "type": "checkbox",
      "default": false,
      "label": "Enable custom styling",
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "table_bg",
      "label": "Table background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "table_divider",
      "label": "Row divider color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "table_head_bg",
      "label": "Header row background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "table_head_color",
      "label": "Header text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "feature_color",
      "label": "Feature label color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "mark_bg_neutral",
      "label": "Yes bg (other columns)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "mark_color_neutral",
      "label": "Yes color (other columns)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "mark_bg_brand",
      "label": "Yes bg (brand column)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "mark_color_brand",
      "label": "Yes color (brand column)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "mark_color_no",
      "label": "No icon color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "pattern_color_1",
      "label": "Pattern color (front)",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.pattern_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "pattern_color_2",
      "label": "Pattern color (back)",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.pattern_style != 'none' }}"
    },
    {
      "type": "header",
      "id": "hdr_42",
      "label": "Typography"
    },
    {
      "id": "enable_custom_fonts",
      "type": "checkbox",
      "default": false,
      "label": "Enable custom fonts",
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "id": "heading_font",
      "type": "font_picker",
      "default": "assistant_n4",
      "label": "Heading font",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "id": "body_font",
      "type": "font_picker",
      "default": "assistant_n4",
      "label": "Body font",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "feature_size",
      "label": "Feature label size (desktop)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "col_head_size",
      "label": "Column title size (desktop)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_48",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "left_padding_desktop",
      "label": "Left padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "right_padding_desktop",
      "label": "Right padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48,
      "hidden": true,
      "info": "Legacy: left and right padding are used",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_54",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Gap text to table (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "left_padding_mobile",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "right_padding_mobile",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12,
      "hidden": true,
      "info": "Legacy: left and right padding are used",
      "visible_if": "{{ false }}"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "Comparison"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": true
        },
        {
          "id": "enable_custom_style",
          "type": "checkbox",
          "default": false,
          "label": "Enable custom styling"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 10,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": 0,
          "max": 0.4,
          "step": 0.1,
          "unit": "em",
          "default": 0.2
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "How we stack up"
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Underlined words",
          "info": "Part of the heading to underline. Empty: the swoosh sits under the whole heading."
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Heading tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
