        "type": "range",
        "id": "side_padding_mobile",
        "label": "Horizontal padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 12,
        "hidden": true,
        "info": "Legacy: left and right padding are used",
        "visible_if": "{{ false }}"
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Eyebrow text",
            "default": "Comparison"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase",
            "default": true
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 13
          },
          {
            "type": "range",
            "id": "letter_spacing",
            "label": "Letter spacing",
            "min": 0,
            "max": 0.4,
            "step": 0.1,
            "unit": "em",
            "default": 0.2
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Heading text",
            "default": "How we stack up"
          },
          {
            "type": "text",
            "id": "highlight_text",
            "label": "Underlined words",
            "info": "Part of the heading to underline. Empty: the swoosh sits under the whole heading."
          },
          {
            "type": "select",
            "id": "tag",
            "label": "Heading tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              }
            ],
            "hidden": true,
            "info": "Legacy: the heading is always an h2",
            "visible_if": "{{ false }}"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase",
            "default": true
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 28,
            "max": 120,
            "step": 1,
            "unit": "px",
            "default": 72
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 22,
            "max": 72,
            "step": 1,
            "unit": "px",
            "default": 40
          },
          {
            "type": "header",
            "content": "Swoosh underline"
          },
          {
            "type": "checkbox",
            "id": "show_swoosh",
            "label": "Show swoosh",
            "default": true
          },
          {
            "type": "color",
            "id": "swoosh_color",
            "label": "Swoosh color",
            "visible_if": "{{ block.settings.show_swoosh and block.settings.enable_custom_style }}"
          },
          {
            "type": "image_picker",
            "id": "swoosh_image",
            "label": "Custom swoosh image (optional)",
            "visible_if": "{{ block.settings.show_swoosh }}"
          },
          {
            "type": "range",
            "id": "swoosh_width",
            "label": "Swoosh width",
            "min": 80,
            "max": 400,
            "step": 4,
            "unit": "px",
            "default": 260,
            "visible_if": "{{ block.settings.show_swoosh and block.settings.highlight_text == blank }}"
          },
          {
            "type": "range",
            "id": "swoosh_under_width",
            "label": "Swoosh width (under words)",
            "min": 60,
            "max": 200,
            "step": 2,
            "unit": "%",
            "default": 110,
            "visible_if": "{{ block.settings.show_swoosh and block.settings.highlight_text != blank }}"
          },
          {
            "type": "range",
            "id": "swoosh_y_offset",
            "label": "Swoosh vertical offset",
            "min": -30,
            "max": 30,
            "step": 1,
            "unit": "px",
            "default": -2,
            "visible_if": "{{ block.settings.show_swoosh and block.settings.highlight_text != blank }}"
          },
          {
            "type": "range",
            "id": "swoosh_x_scale",
            "label": "Swoosh stretch",
            "min": 50,
            "max": 200,
            "step": 5,
            "unit": "%",
            "default": 100,
            "visible_if": "{{ block.settings.show_swoosh and block.settings.highlight_text != blank }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Subheading text",
            "default": "<p>Skip the chalky aftertaste and sugar spikes. Our blend hits your macros and tastes like the real thing.</p>"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size (desktop)",
            "min": 12,
            "max": 26,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 240,
            "max": 720,
            "step": 10,
            "unit": "px",
            "default": 480
          },
          {
            "type": "range",
            "id": "padding_top",
            "label": "Top spacing",
            "min": 0,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 20
          }
        ]
      },
      {
        "type": "column_header",
        "name": "Column",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Others"
          },
          {
            "type": "checkbox",
            "id": "is_brand",
            "label": "Your brand (filled capsule)",
            "default": false
          },
          {
            "type": "header",
            "content": "Brand capsule"
          },
          {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo",
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "id": "enable_custom_style",
            "type": "checkbox",
            "default": false,
            "label": "Enable custom styling",
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "color",
            "id": "cap_bg",
            "label": "Capsule background",
            "visible_if": "{{ block.settings.is_brand and block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "cap_text",
            "label": "Capsule text",
            "visible_if": "{{ block.settings.is_brand and block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "cap_width",
            "label": "Capsule width (desktop)",
            "min": 70,
            "max": 240,
            "step": 2,
            "unit": "px",
            "default": 130,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "cap_width_mobile",
            "label": "Capsule width (mobile)",
            "min": 60,
            "max": 180,
            "step": 2,
            "unit": "px",
            "default": 88,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "cap_overhang",
            "label": "Capsule overhang (desktop)",
            "min": 20,
            "max": 120,
            "step": 2,
            "unit": "px",
            "default": 56,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "cap_overhang_mobile",
            "label": "Capsule overhang (mobile)",
            "min": 16,
            "max": 80,
            "step": 2,
            "unit": "px",
            "default": 42,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "logo_top_offset",
            "label": "Logo top offset (desktop)",
            "min": 4,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 44,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "logo_size",
            "label": "Logo size (desktop)",
            "min": 12,
            "max": 48,
            "step": 1,
            "unit": "px",
            "default": 24,
            "visible_if": "{{ block.settings.is_brand }}"
          },
          {
            "type": "range",
            "id": "logo_rotate",
            "label": "Logo rotation",
            "min": -15,
            "max": 15,
            "step": 1,
            "unit": "deg",
            "default": -3,
            "visible_if": "{{ block.settings.is_brand }}"
          }
        ]
      },
      {
        "type": "row",
        "name": "Row",
        "settings": [
          {
            "type": "text",
            "id": "feature",
            "label": "Feature label",
            "default": "Feature"
          },
          {
            "type": "text",
            "id": "values",
            "label": "Values",
            "default": "yes,no,yes",
            "info": "yes or no for each column, in order, comma separated"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Comparison Table 4",
        "category": "Features",
        "blocks": [
          {
            "type": "eyebrow",
            "settings": {
              "text": "Comparison"
            }
          },
          {
            "type": "heading",
            "settings": {
              "text": "How we compare",
              "highlight_text": "compare"
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>Your product next to two common alternatives, feature by feature.</p>"
            }
          },
          {
            "type": "column_header",
            "settings": {
              "title": "Ours",
              "is_brand": true
            }
          },
          {
            "type": "column_header",
            "settings": {
              "title": "Brand A",
              "is_brand": false
            }
          },
          {
            "type": "column_header",
            "settings": {
              "title": "Brand B",
              "is_brand": false
            }
          },
          {
            "type": "row",
            "settings": {
              "feature": "Feature 1",
              "values": "yes,no,yes"
            }
          },
          {
            "type": "row",
            "settings": {
              "feature": "Feature 2",
              "values": "yes,yes,no"
            }
          },
          {
            "type": "row",
            "settings": {
              "feature": "Feature 3",
              "values": "yes,no,no"
            }
          },
          {
            "type": "row",
            "settings": {
              "feature": "Feature 4",
              "values": "yes,yes,yes"
            }
          }
        ]
      }
    ]
  }
}
