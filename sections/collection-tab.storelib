        "min": 1,
        "max": 24,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Products per row (desktop)",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Products per row (mobile)",
        "info": "1.5 lets the row scroll sideways on phones.",
        "min": 1,
        "max": 2,
        "step": 0.5,
        "default": 2
      },
      {
        "type": "range",
        "id": "rows",
