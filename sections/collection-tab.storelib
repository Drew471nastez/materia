          },
          {
            "value": "fade-in",
            "label": "Fade in"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "slide-in",
            "label": "Slide in"
          },
          {
            "value": "blur_up",
            "label": "Blur up"
          },
          {
            "value": "slide_side",
            "label": "Slide from side"
          },
          {
            "value": "mask_reveal",
            "label": "Mask reveal"
          },
          {
            "value": "smooth-fade-up",
            "label": "Smooth fade up"
          }
