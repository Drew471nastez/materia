<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_no_products_found = 'accessibility.no_products_found' | t -%}
{%- assign fb_accessibility_add_collection_tab_hint = 'accessibility.add_collection_tab_hint' | t -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign section_width = st.section_width
  assign content_alignment = st.content_alignment | default: 'center'

  assign items_to_show = st.items_to_show | default: 8
  assign items_per_row = st.items_per_row | default: 4
  assign items_per_row_mobile = st.items_per_row_mobile | default: 2
  assign rows = st.rows | default: 1
  assign column_gap = st.column_gap | default: 20

  assign show_load_more_button = st.show_load_more_button
  assign button_label = st.button_label
  assign use_outline_button_style = st.use_outline_button_style

  assign reveal = st.reveal
  assign scroll_animation = st.scroll_animation | default: 'none'
  assign tab_switch_animation = st.tab_switch_animation | default: 'fade'

  assign tab_style = st.tab_style | default: 'pill'
  assign tabs_alignment = st.tabs_alignment | default: 'center'
  assign tabs_full_width = st.tabs_full_width

  assign data_free_scroll = 'false'
  if items_per_row_mobile > 1 and items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif

  # --- Blocks: one heading, one subheading, the collection tabs ---
  assign col_count = 0
  assign heading_found = false
  assign subheading_found = false
  for block in section.blocks
    case block.type
      when 'view_more'
        assign view_more_block = block
        assign show_load_more_button = block.settings.enabled
        assign button_label = block.settings.label
        assign use_outline_button_style = false
        if block.settings.appearance == 'outline'
          assign use_outline_button_style = true
        endif
      when 'collection'
        assign col_count = col_count | plus: 1
      when 'heading'
        unless heading_found
          assign heading_block = block
          assign heading_found = true
        endunless
      when 'subheading'
        unless subheading_found
          assign subheading_block = block
          assign subheading_found = true
        endunless
    endcase
  endfor
  if heading_found
    assign hb = heading_block.settings
  endif
  if subheading_found
    assign sb = subheading_block.settings
  endif
  assign show_heading = false
  if heading_found and hb.heading != blank
    assign show_heading = true
  endif
  assign show_subheading = false
  if subheading_found and sb.subheading != blank
    assign show_subheading = true
  endif

  # --- Heading + subheading: theme typography unless the block's own style is on ---
  assign c_heading = ''
  assign c_sub = ''
  assign h_custom = false
  assign h_style = 'h2'
  if heading_found
    assign h_style = hb.heading_size | default: 'h2'
    if hb.custom_style
      assign h_custom = true
      assign c_heading = hb.heading_color
    endif
  endif
  assign s_custom = false
  assign s_style = 'body'
  if subheading_found
    assign s_style = sb.text_size | default: 'body'
    if sb.custom_style
      assign s_custom = true
      assign c_sub = sb.subheading_color
    endif
  endif
  case h_style
    when 'h1'
      assign h_fb = 56
      assign h_fb_m = 36
    when 'h3'
      assign h_fb = 24
      assign h_fb_m = 20
    else
      assign h_fb = 36
      assign h_fb_m = 30
  endcase
  case s_style
    when 'body_large'
      assign s_fb = 18
    when 'body_small'
      assign s_fb = 14
    else
      assign s_fb = 16
  endcase

  # --- Tabs: theme buttons and scheme unless custom styling is on ---
  assign custom = st.enable_custom_styling
  assign c_tab_bg = ''
  assign c_tab_bg_on = ''
  assign c_tab_text = ''
  assign c_tab_text_on = ''
  assign c_tab_border = ''
  assign c_tab_border_on = ''
  assign c_line = ''
  assign c_empty = ''
  if custom
    assign c_tab_bg = st.tab_unchecked_bg_color
    assign c_tab_bg_on = st.tab_checked_bg_color
    assign c_tab_text = st.tab_unchecked_text_color
    assign c_tab_text_on = st.tab_checked_text_color
    assign c_tab_border = st.tab_unchecked_border_color
    assign c_tab_border_on = st.tab_checked_border_color
    assign c_line = st.nav_bottom_border_color
    assign c_empty = st.empty_state_text_color
  endif

  if tab_style == 'pill' or tab_style == 'button'
    assign tab_text_fb = 'var(--btn-secondary-color, var(--color-text))'
    assign tab_active_text_fb = 'var(--btn-primary-color)'
    assign tab_active_border_fb = 'var(--btn-primary-bg-color)'
  else
    assign tab_text_fb = 'var(--color-text)'
    assign tab_active_text_fb = 'var(--color-heading)'
    assign tab_active_border_fb = 'var(--color-heading)'
  endif

  assign bw_off = st.tab_unchecked_border_thickness | default: 0
  assign bw_on = st.tab_checked_border_thickness | default: 0
  assign ul_on = bw_on
  if ul_on < 1
    assign ul_on = 2
  endif
  if tab_style == 'pill'
    assign tab_radius = 999
  else
    assign tab_radius = st.tab_border_radius | default: 8
  endif
-%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};
  --col-number: {{ items_per_row_mobile }};
  {% if items_per_row > 3 %}
    --col-tablet: 3;
  {% else %}
    --col-tablet: {{ items_per_row }};
  {% endif %}
  {% if column_gap < 15 %}
    --col-gap: {{ column_gap }}px;
  {% else %}
    --col-gap: 15px;
    --col-gap-desktop: {{ column_gap }}px;
  {% endif %}
  --repeat: {{ items_to_show }};
  --col-mobile: {{ items_per_row_mobile }};
{%- endcapture -%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); font-weight: var(--body-weight, inherit); }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) { font-family: inherit; }

  /* Section margins (mobile first, then desktop) */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Width: only the inner content is constrained; the scheme background spans the page. */
  {%- case section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .ti-tabs__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .ti-tabs__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .ti-tabs__inner { padding-inline: 1.5rem; box-sizing: border-box; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .ti-tabs__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
  {%- endcase -%}

  #shopify-section-{{ sid }} .pt-section { padding-top: {{ st.padding_top | default: 30 }}px; }
  #shopify-section-{{ sid }} .pb-section { padding-bottom: {{ st.padding_bottom | default: 30 }}px; }

  /* Reveal on scroll (live site only) */
  {%- if reveal and scroll_animation != 'none' and request.design_mode != true -%}
    #shopify-section-{{ sid }} .ti-tabs { opacity: 0; will-change: opacity, transform; }
    #shopify-section-{{ sid }} .ti-tabs.is-revealed { opacity: 1; }
    {%- case scroll_animation -%}
      {%- when 'fade-in', 'fade' -%}
        #shopify-section-{{ sid }} .ti-tabs { transition: opacity .8s ease; }
      {%- when 'slide-in' -%}
        #shopify-section-{{ sid }} .ti-tabs { transform: translateX(-20px); transition: opacity .8s ease, transform .8s ease; }
        #shopify-section-{{ sid }} .ti-tabs.is-revealed { transform: none; }
      {%- when 'smooth-fade-up' -%}
        #shopify-section-{{ sid }} .ti-tabs { transform: translateY(20px); transition: opacity .8s ease, transform .8s ease; }
        #shopify-section-{{ sid }} .ti-tabs.is-revealed { transform: none; }
      {%- when 'blur_up' -%}
        #shopify-section-{{ sid }} .ti-tabs { transform: translateY(12px); filter: blur(4px); transition: opacity .8s ease, transform .8s ease, filter .8s ease; }
        #shopify-section-{{ sid }} .ti-tabs.is-revealed { transform: none; filter: none; }
      {%- when 'slide_side' -%}
        #shopify-section-{{ sid }} .ti-tabs { transform: translateX(-28px); transition: opacity .8s ease, transform .8s ease; }
        #shopify-section-{{ sid }} .ti-tabs.is-revealed { transform: none; }
      {%- when 'mask_reveal' -%}
        #shopify-section-{{ sid }} .ti-tabs { opacity: 1; clip-path: inset(0 0 100% 0); transform: translateY(10px); transition: clip-path .8s ease, transform .8s ease; }
        #shopify-section-{{ sid }} .ti-tabs.is-revealed { clip-path: inset(0 0 0 0); transform: none; }
    {%- endcase -%}
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .ti-tabs { transition: none !important; transform: none !important; opacity: 1 !important; filter: none !important; clip-path: none !important; }
    }
  {%- endif -%}

  /* ===== Header: Theme settings > Typography by default ===== */
  #shopify-section-{{ sid }} .ti-tabs__header {
    text-align: {{ content_alignment }};
    margin-bottom: {{ st.vertical_gap_subheading_section_mobile | default: 18 }}px;
  }
  #shopify-section-{{ sid }} .ti-tabs__header > * + * { margin-top: {{ st.vertical_gap_heading_subheading | default: 10 }}px; }
  #shopify-section-{{ sid }} .ti-tabs__heading {
    margin: 0;
    font-family: var(--type-{{ h_style }}-font, var(--heading-font, inherit));
    font-size: var(--type-{{ h_style }}-size, {{ h_fb_m }}px);
    font-weight: var(--type-{{ h_style }}-weight, var(--heading-weight, 700));
    line-height: var(--type-{{ h_style }}-line-height, 1.2);
    letter-spacing: var(--type-{{ h_style }}-letter-spacing, normal);
    text-transform: var(--type-{{ h_style }}-transform, none);
    color: {% render 'scheme-color', color: c_heading, fallback: 'var(--color-heading)' %} !important;
    text-wrap: balance;
  }
  #shopify-section-{{ sid }} .ti-tabs__subheading {
    max-width: {{ sb.max_width | default: 640 }}px;
    font-family: var(--type-{{ s_style }}-font, var(--body-font, inherit));
    font-size: var(--type-{{ s_style }}-size, {{ s_fb }}px);
    font-weight: var(--type-{{ s_style }}-weight, 400);
    line-height: var(--type-{{ s_style }}-line-height, 1.6);
    color: {% render 'scheme-color', color: c_sub, fallback: 'var(--color-text)' %} !important;
    text-wrap: pretty;
    {%- if content_alignment == 'center' %} margin-inline: auto;{% elsif content_alignment == 'right' %} margin-left: auto; margin-right: 0;{% endif %}
  }
  {%- if h_custom %}
  #shopify-section-{{ sid }} .ti-tabs__heading {
    font-weight: {{ hb.heading_font_weight | default: '700' }};
    font-size: {{ hb.heading_font_size_mobile | default: 24 }}px;
    line-height: 1.2;
  }
  {%- endif %}
  {%- if s_custom %}
  #shopify-section-{{ sid }} .ti-tabs__subheading {
    font-weight: {{ sb.subheading_font_weight | default: '400' }};
    font-size: {{ sb.subheading_font_size_mobile | default: 14 }}px;
    line-height: 1.5;
  }
  {%- endif %}
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ti-tabs__header { margin-bottom: {{ st.vertical_gap_subheading_section_desktop | default: 25 }}px; }
    #shopify-section-{{ sid }} .ti-tabs__heading {
      {%- if h_custom %}
      font-size: {{ hb.heading_font_size_desktop | default: 28 }}px;
      {%- else %}
      font-size: var(--type-{{ h_style }}-size, {{ h_fb }}px);
      {%- endif %}
    }
    {%- if s_custom %}
    #shopify-section-{{ sid }} .ti-tabs__subheading { font-size: {{ sb.subheading_font_size_desktop | default: 16 }}px; }
    {%- endif %}
  }
  #shopify-section-{{ sid }} .ti-tabs__subheading > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .ti-tabs__subheading > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .ti-tabs__subheading p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .ti-tabs__subheading p + p { margin-top: .6em; }
  #shopify-section-{{ sid }} .ti-tabs__rt strong, #shopify-section-{{ sid }} .ti-tabs__rt b { font-weight: 700; }
  #shopify-section-{{ sid }} .ti-tabs__rt em { font-style: italic; }
  #shopify-section-{{ sid }} .ti-tabs__rt a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  #shopify-section-{{ sid }} .ti-tabs__rt a:hover { opacity: .75; }

  /* ===== Tab row ===== */
  #shopify-section-{{ sid }} .ti-tabs__nav {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 16px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    gap: {{ st.tab_gap | default: 10 }}px;
    margin: 0 0 {{ st.gap_tabs_to_products | default: 30 }}px;
    padding: 4px 16px;
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    position: relative;
    isolation: isolate;
    justify-content: flex-start;
    {%- if st.show_nav_bottom_border %}
    border-bottom: {{ st.nav_bottom_border_thickness | default: 1 }}px solid {% render 'scheme-color', color: c_line, fallback: 'var(--color-border)' %};
    {%- endif %}
  }
  #shopify-section-{{ sid }} .ti-tabs__nav::-webkit-scrollbar { display: none; }
  {%- if tabs_alignment != 'left' -%}
    #shopify-section-{{ sid }} .ti-tabs__nav > .ti-tabs__btn:first-of-type { margin-inline-start: auto; }
  {%- endif -%}
  {%- if tabs_alignment == 'center' -%}
    #shopify-section-{{ sid }} .ti-tabs__nav > .ti-tabs__btn:last-of-type { margin-inline-end: auto; }
  {%- endif -%}
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .ti-tabs__nav > .ti-tabs__btn:first-of-type { margin-inline-start: 0; }
    #shopify-section-{{ sid }} .ti-tabs__nav > .ti-tabs__btn:last-of-type { margin-inline-end: 0; }
    {%- if tabs_full_width %}
    #shopify-section-{{ sid }} .ti-tabs__nav { width: 100%; }
    #shopify-section-{{ sid }} .ti-tabs__btn { flex: 1 1 auto; min-width: max-content; }
    {%- endif %}
  }

  #shopify-section-{{ sid }} .ti-tabs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    scroll-snap-align: center;
    flex: 0 0 auto;
    min-height: 44px;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    margin: 0;
    padding: {{ st.tab_padding_y | default: 10 }}px {{ st.tab_padding_x | default: 22 }}px;
    border: 0;
    background: transparent;
    color: {% render 'scheme-color', color: c_tab_text, fallback: tab_text_fb %} !important;
    {%- if custom %}
    font-size: {{ st.tab_font_size | default: 14 }}px;
    font-weight: {{ st.tab_font_weight | default: 500 }};
    {%- else %}
    font-family: var(--type-button-font, inherit);
    font-size: var(--type-button-size, 15px);
    font-weight: var(--type-button-weight, 500);
    letter-spacing: var(--type-button-letter-spacing, normal);
    text-transform: var(--type-button-transform, none);
    {%- endif %}
    line-height: 1.2;
    -webkit-tap-highlight-color: transparent;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease, opacity .25s ease;
  }
  #shopify-section-{{ sid }} .ti-tabs__btn-text { white-space: nowrap; }
  #shopify-section-{{ sid }} .ti-tabs__btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  {%- if tab_style == 'pill' or tab_style == 'button' %}
  #shopify-section-{{ sid }} .ti-tabs__btn {
    background-color: {% render 'scheme-color', color: c_tab_bg, fallback: 'var(--btn-secondary-bg-color, transparent)' %} !important;
    border: {{ bw_off }}px solid {% render 'scheme-color', color: c_tab_border, fallback: 'var(--btn-secondary-border-color, var(--color-border))' %};
    border-radius: {{ tab_radius }}px;
  }
  #shopify-section-{{ sid }} .ti-tabs__btn.is-active {
    background-color: {% render 'scheme-color', color: c_tab_bg_on, fallback: 'var(--btn-primary-bg-color)' %} !important;
    color: {% render 'scheme-color', color: c_tab_text_on, fallback: tab_active_text_fb %} !important;
    border: {{ bw_on }}px solid {% render 'scheme-color', color: c_tab_border_on, fallback: tab_active_border_fb %};
  }
  {%- endif %}

  {%- if tab_style == 'underline' %}
  #shopify-section-{{ sid }} .ti-tabs__btn {
    border-radius: 0;
    border-bottom: {{ ul_on }}px solid transparent;
  }
  #shopify-section-{{ sid }} .ti-tabs__btn.is-active {
    color: {% render 'scheme-color', color: c_tab_text_on, fallback: tab_active_text_fb %} !important;
    border-bottom-color: {% render 'scheme-color', color: c_tab_border_on, fallback: tab_active_border_fb %};
  }
  {%- endif %}

  {%- if tab_style == 'text' %}
  #shopify-section-{{ sid }} .ti-tabs__btn { border-radius: 0; }
  #shopify-section-{{ sid }} .ti-tabs__btn.is-active {
    color: {% render 'scheme-color', color: c_tab_text_on, fallback: tab_active_text_fb %} !important;
    font-weight: 700;
  }
  #shopify-section-{{ sid }} .ti-tabs__btn-text { display: inline-flex; flex-direction: column; align-items: center; }
  #shopify-section-{{ sid }} .ti-tabs__btn-text::after {
    content: attr(data-text);
    font-weight: 700;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    user-select: none;
  }
  {%- endif %}

  /* Hover on tabs that are not open */
  {%- if custom and st.tab_hover_bg_color != blank or custom and st.tab_hover_text_color != blank %}
  #shopify-section-{{ sid }} .ti-tabs__btn:not(.is-active):hover {
    {%- if st.tab_hover_bg_color != blank %} background-color: {{ st.tab_hover_bg_color }} !important;{% endif %}
    {%- if st.tab_hover_text_color != blank %} color: {{ st.tab_hover_text_color }} !important;{% endif %}
  }
  {%- else %}
  #shopify-section-{{ sid }} .ti-tabs__btn:not(.is-active):hover { opacity: .7; }
  {%- endif %}

  #shopify-section-{{ sid }} .ti-tabs__icon {
    width: {{ st.tab_icon_size | default: 22 }}px;
    height: {{ st.tab_icon_size | default: 22 }}px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  #shopify-section-{{ sid }} .ti-tabs__count { opacity: .7; font-weight: inherit; }

  /* ===== Panels: one shared grid cell, so switching never changes the height ===== */
  #shopify-section-{{ sid }} .ti-tabs__panels { display: grid; grid-template-columns: minmax(0, 1fr); }
  #shopify-section-{{ sid }} .ti-tabs__panels > .ti-tabs__panel { grid-area: 1 / 1; display: block !important; min-width: 0; }
  #shopify-section-{{ sid }} .ti-tabs__panel:not(.is-active) { visibility: hidden; pointer-events: none; z-index: 0; }
  #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel:not(.is-active) {
    transition: none;
  }
  /* Animate the panel once, not every card/action inside it. Inactive hearts
     must not escape a hidden panel through their own visibility rules. */
  #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] .product-item__wrapper.scroll-trigger {
    opacity:1!important; transform:none!important; animation:none!important;
  }
  #shopify-section-{{ sid }} .ti-tabs__panel:not(.is-active) :is(.product-item__action,.product-item__button-action,.product-item__button-wishlist) { visibility:hidden!important; }
  #shopify-section-{{ sid }} .ti-tabs__panel.is-active { visibility: visible; z-index: 1; }
  #shopify-section-{{ sid }} .ti-tabs__panel:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  {%- case tab_switch_animation -%}
    {%- when 'fade' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-fade-{{ sid }} .35s ease both; }
      @keyframes ti-tabs-fade-{{ sid }} { from { opacity: .65; } to { opacity: 1; } }
    {%- when 'fade-in' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-fadein-{{ sid }} .4s ease-in-out both; }
      @keyframes ti-tabs-fadein-{{ sid }} { from { opacity: .65; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    {%- when 'slide-up' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-slideup-{{ sid }} .4s ease both; }
      @keyframes ti-tabs-slideup-{{ sid }} { from { opacity: .65; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    {%- when 'slide-down' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-slidedown-{{ sid }} .4s ease both; }
      @keyframes ti-tabs-slidedown-{{ sid }} { from { opacity: .65; transform: translateY(-20px); } to { opacity: 1; transform: none; } }
    {%- when 'zoom-in' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-zoomin-{{ sid }} .4s ease both; }
      @keyframes ti-tabs-zoomin-{{ sid }} { from { opacity: .65; transform: scale(.95); } to { opacity: 1; transform: none; } }
    {%- when 'zoom-out' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-zoomout-{{ sid }} .4s ease both; }
      @keyframes ti-tabs-zoomout-{{ sid }} { from { opacity: .65; transform: scale(1.05); } to { opacity: 1; transform: none; } }
    {%- when 'flip-x' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-flipx-{{ sid }} .55s ease both; }
      @keyframes ti-tabs-flipx-{{ sid }} { from { opacity: .65; transform: perspective(600px) rotateX(60deg); } to { opacity: 1; transform: perspective(600px) rotateX(0deg); } }
    {%- when 'flip-y' -%}
      #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: ti-tabs-flipy-{{ sid }} .55s ease both; }
      @keyframes ti-tabs-flipy-{{ sid }} { from { opacity: .65; transform: perspective(600px) rotateY(60deg); } to { opacity: 1; transform: perspective(600px) rotateY(0deg); } }
  {%- endcase -%}
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ti-tabs__btn { transition: none; }
    #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel,
    #shopify-section-{{ sid }} .ti-tabs__panels[data-switched] > .ti-tabs__panel.is-active { animation: none !important; transition: none !important; }
  }

  #shopify-section-{{ sid }} .ti-tabs__empty {
    text-align: center;
    padding: 60px 20px;
    color: {% render 'scheme-color', color: c_empty, fallback: 'var(--color-text)' %} !important;
    font-size: {{ st.empty_state_font_size | default: 16 }}px;
  }
  #shopify-section-{{ sid }} .ti-tabs__loadmore-wrap { margin-top: {{ st.gap_loadmore | default: 30 }}px; text-align: center; }
{% comment %}{% endcomment %}</style>

{%- capture header_html -%}
  {%- if show_heading or show_subheading -%}
    <div class="ti-tabs__header">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' and show_heading and block.id == heading_block.id -%}
          <h2 class="ti-tabs__heading ti-tabs__rt" {{ block.shopify_attributes }}>{{ hb.heading }}</h2>
        {%- elsif block.type == 'subheading' and show_subheading and block.id == subheading_block.id -%}
          <div class="ti-tabs__subheading ti-tabs__rt" {{ block.shopify_attributes }}>{{ sb.subheading }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div
  id="section-{{ sid }}"
  class="section ti-tabs sec__collection-tab color-{{ color_scheme }} gradient pt-section pb-section{% if st.reset_spacing %} remove_spacing{% endif %}{% if reveal %} overflow-hidden{% endif %}"
>
  <div class="ti-tabs__inner">
    {%- if col_count == 0 -%}
      {{ header_html }}
      <div class="ti-tabs__empty">
        {{ st.empty_state_message | default: fb_accessibility_add_collection_tab_hint }}
      </div>
    {%- else -%}
      <div class="ti-tabs__root" data-ti-tabs data-section-id="{{ sid }}">
        {{ header_html }}

        <div class="ti-tabs__nav collection-tab__ta" role="tablist" aria-orientation="horizontal"{% if show_heading %} aria-label="{{ hb.heading | strip_html | escape }}"{% endif %}>
          {%- assign tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign tab_i = tab_i | plus: 1
                assign bs = block.settings
                assign col_obj = bs.collection
                if col_obj.id == blank
                  assign col_obj = collections[bs.collection]
                endif
                assign col_title = bs.collection_title
                if col_title == blank
                  if col_obj != blank and col_obj.title != blank
                    assign col_title = col_obj.title
                  else
                    assign col_title = 'Collection'
                  endif
                endif
                assign tab_icon = bs.tab_icon
                if tab_icon == blank and col_obj != blank
                  assign tab_icon = col_obj.image
                endif
              -%}
              <button
                type="button"
                id="ti-tabs-btn-{{ sid }}-{{ block.id }}"
                class="ti-tabs__btn collection-tab__tab-item{% if tab_i == 1 %} is-active active{% endif %}"
                data-block-id="{{ block.id }}"
                role="tab"
                aria-selected="{% if tab_i == 1 %}true{% else %}false{% endif %}"
                tabindex="{% if tab_i == 1 %}0{% else %}-1{% endif %}"
                aria-controls="ti-tabs-panel-{{ sid }}-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if st.show_tab_icon and tab_icon != blank -%}
                  {{ tab_icon | image_url: width: 120 | image_tag: class: 'ti-tabs__icon', alt: '', loading: 'lazy', width: st.tab_icon_size, height: st.tab_icon_size }}
                {%- endif -%}
                <span class="ti-tabs__btn-text" data-text="{{ col_title | escape }}">{{ col_title }}</span>
                {%- if st.show_product_count and col_obj != blank -%}
                  <span class="ti-tabs__count">({{ col_obj.products_count | default: col_obj.products.size }})</span>
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="ti-tabs__panels relative tab-content">
          {%- assign tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign tab_i = tab_i | plus: 1
                assign bs = block.settings
                assign col_obj = bs.collection
                if col_obj.id == blank
                  assign col_obj = collections[bs.collection]
                endif
                assign panel_id = 'ti-tabs-panel-' | append: sid | append: '-' | append: block.id
                assign all_product_visible = rows | times: items_per_row
                assign products_avail = 0
                if col_obj.id != blank
                  assign products_avail = col_obj.products.size
                endif
              -%}
              <div
                id="{{ panel_id }}"
                class="ti-tabs__panel collection-tab__tab-content collection-tab-{{ block.id }}{% if tab_i == 1 %} is-active active{% endif %}"
                data-block-id="{{ block.id }}"
                role="tabpanel"
                aria-labelledby="ti-tabs-btn-{{ sid }}-{{ block.id }}"
                tabindex="0"
                {% if tab_i != 1 %}inert aria-hidden="true"{% endif %}
              >
                {%- if products_avail > 0 -%}
                  {%- liquid
                    assign products_to_show = items_to_show
                    if products_avail < items_to_show
                      assign products_to_show = products_avail
                    endif
                    assign initial_paginate = all_product_visible
                    if products_to_show < initial_paginate
                      assign initial_paginate = products_to_show
                    endif
                  -%}
                  {%- if show_load_more_button and button_label != blank and products_to_show > all_product_visible -%}
                    {%- paginate col_obj.products by initial_paginate -%}
                      <grid-custom
                        class="swiper products-grid__items flex flex-cols{% if column_gap < 31 %} row-gap-20 row-gap-md-30{% endif %} product-ajax__append flex-wrap"
                        style="{{ col_style | strip | strip_newlines }}"
                        data-enable="false"
                        data-section-id="{{ sid }}"
                        data-mobile="{{ items_per_row_mobile }}"
                        data-mobile-rows="{{ st.rows_mobile | default: 1 }}"
                        data-spacing="{{ column_gap }}"
                        data-free-scroll="{{ data_free_scroll }}"
                      >
                        {%- for product in col_obj.products -%}
                          {%- render 'product-item',
                            card_product: product,
                            container: section_width,
                            colunm: items_per_row,
                            colunm_mobile: items_per_row_mobile,
                            padding: column_gap,
                            scroll_animation: scroll_animation,
                            section_id: sid,
                            class: 'grid-custom-item',
                            template_enable_action: true,
                            template_enable_product_vendor: true,
                            template_enable_rate: true,
                            template_enable_product_short_description: true,
                            template_enable_color_swatches: true,
                            template_enable_price: true,
                            template_enable_add_cart: true,
                            indexFor: forloop.index,
                            template_enable_product_badges: true
                          -%}
                        {%- endfor -%}
                      </grid-custom>
                      <div class="ti-tabs__loadmore-wrap"{% if view_more_block %} {{ view_more_block.shopify_attributes }}{% endif %}>
                        <loadmore-function
                          data-all-products="{{ products_to_show }}"
                          data-section-id="{{ sid }}"
                          data-limit="{{ initial_paginate }}"
                          data-collection-url="{{ col_obj.url }}"
                          data-url="?page={{ paginate.current_page | plus: 1 }}"
                          class="block text-center"
                          data-block-id="{{ block.id }}"
                        >
                          <button class="btn-{% if use_outline_button_style %}outline{% else %}primary{% endif %} load-more relative" data-sl-button data-button-role="{{ view_more_block.settings.button_role | default: 'primary' }}" data-button-outline="{{ use_outline_button_style }}"{% if view_more_block.settings.custom_style %} style="{% if view_more_block.settings.button_background != blank %}--mb-bg:{{ view_more_block.settings.button_background }};{% endif %}{% if view_more_block.settings.button_text != blank %}--mb-text:{{ view_more_block.settings.button_text }};{% endif %}{% if view_more_block.settings.button_border != blank %}--mb-border:{{ view_more_block.settings.button_border }};{% endif %}"{% endif %}>
                            <span class="hidden-on-load">{{ button_label }}</span>
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="spin opacity-0 icon-load">
                              <use href="#icon-load"></use>
                            </svg>
                          </button>
                        </loadmore-function>
                      </div>
                    {%- endpaginate -%}
                  {%- else -%}
                    <grid-custom
                      class="swiper products-grid__items flex flex-cols{% if column_gap < 31 %} row-gap-20 row-gap-md-30{% endif %} flex-wrap"
                      style="{{ col_style | strip | strip_newlines }}"
                      data-enable="false"
                      data-section-id="{{ sid }}"
                      data-mobile="{{ items_per_row_mobile }}"
                      data-mobile-rows="{{ st.rows_mobile | default: 1 }}"
                      data-spacing="{{ column_gap }}"
                      data-free-scroll="{{ data_free_scroll }}"
                    >
                      {%- for product in col_obj.products limit: products_to_show -%}
                        {%- render 'product-item',
                          card_product: product,
                          container: section_width,
                          colunm: items_per_row,
                          colunm_mobile: items_per_row_mobile,
                          padding: column_gap,
                          scroll_animation: scroll_animation,
                          section_id: sid,
                          class: 'grid-custom-item',
                          template_enable_action: true,
                          template_enable_product_vendor: true,
                          template_enable_rate: true,
                          template_enable_product_short_description: true,
                          template_enable_color_swatches: true,
                          template_enable_price: true,
                          template_enable_add_cart: true,
                          indexFor: forloop.index,
                          template_enable_product_badges: true
                        -%}
                      {%- endfor -%}
                    </grid-custom>
                  {%- endif -%}
                {%- else -%}
                  <div class="ti-tabs__empty">
                    {{ st.empty_state_message | default: fb_accessibility_no_products_found }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var sectionEl = document.getElementById('section-{{ sid }}');
    if (!sectionEl) return;

    function initTabs(root) {
      if (!root || root.__tiTabs) return;
      root.__tiTabs = true;
      var nav = root.querySelector('.ti-tabs__nav');
      var panelsWrap = root.querySelector('.ti-tabs__panels');
      var btns = Array.prototype.slice.call(root.querySelectorAll('.ti-tabs__btn'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.ti-tabs__panel'));
      if (!nav || !btns.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var isRtl = function () { return getComputedStyle(nav).direction === 'rtl'; };
      var current = function () { return btns.filter(function (b) { return b.classList.contains('is-active'); })[0] || btns[0]; };

      function reveal(btn, smooth) {
        if (nav.scrollWidth <= nav.clientWidth + 1) return;
        var left = btn.offsetLeft - (nav.clientWidth - btn.offsetWidth) / 2;
        nav.scrollTo({ left: left, behavior: smooth && !reduce.matches ? 'smooth' : 'auto' });
      }

      function activate(btn, focus) {
        if (!btn) return;
        if (focus) btn.focus({ preventScroll: true });
        if (btn.classList.contains('is-active')) return;
        var blockId = btn.getAttribute('data-block-id');
        btns.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('is-active', on);
          b.classList.toggle('active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1;
        });
        if (panelsWrap) panelsWrap.setAttribute('data-switched', '');
        panels.forEach(function (p) {
          var on = p.getAttribute('data-block-id') === blockId;
          p.classList.toggle('is-active', on);
          p.classList.toggle('active', on);
          p.removeAttribute('hidden');
          if (on) { p.removeAttribute('inert'); p.removeAttribute('aria-hidden'); }
          else { p.setAttribute('inert', ''); p.setAttribute('aria-hidden', 'true'); }
        });
        reveal(btn, true);
      }

      nav.addEventListener('click', function (e) {
        var btn = e.target.closest('.ti-tabs__btn');
        if (btn && nav.contains(btn)) activate(btn, false);
      });
      nav.addEventListener('keydown', function (e) {
        var i = btns.indexOf(e.target.closest('.ti-tabs__btn'));
        if (i < 0) return;
        var step = isRtl() ? -1 : 1, next = null;
        if (e.key === 'ArrowRight') next = btns[(i + step + btns.length) % btns.length];
        else if (e.key === 'ArrowLeft') next = btns[(i - step + btns.length) % btns.length];
        else if (e.key === 'Home') next = btns[0];
        else if (e.key === 'End') next = btns[btns.length - 1];
        if (!next) return;
        e.preventDefault();
        activate(next, true);
      });
      if (current() !== btns[0]) {
        if ('ResizeObserver' in window) {
          var firstSize = new ResizeObserver(function () { firstSize.disconnect(); reveal(current(), false); });
          firstSize.observe(nav);
        } else {
          window.requestAnimationFrame(function () { reveal(current(), false); });
        }
      }
      root.addEventListener('shopify:block:select', function (e) {
        var id = e.target && e.target.getAttribute && e.target.getAttribute('data-block-id');
        var btn = id && btns.filter(function (b) { return b.getAttribute('data-block-id') === id; })[0];
        if (btn) activate(btn, false);
      });
    }
    initTabs(sectionEl.querySelector('[data-ti-tabs]'));
    ['storelib:section-load', 'shopify:section:load'].forEach(function (name) {
      document.addEventListener(name, function (e) {
        if (!e.detail || e.detail.sectionId !== {{ sid | json }}) return;
        var el = document.getElementById('section-{{ sid }}');
        if (el) initTabs(el.querySelector('[data-ti-tabs]'));
      });
    });

    var animation = '{{ scroll_animation }}';
    var revealTarget = sectionEl.classList.contains('ti-tabs') ? sectionEl : sectionEl.querySelector('.ti-tabs');
    if (document.body.classList.contains('shopify-design-mode') || !('IntersectionObserver' in window)) {
      if (revealTarget) revealTarget.classList.add('is-revealed');
    } else if (animation && animation !== 'none' && revealTarget) {
      var io = new IntersectionObserver(function(entries, obs) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            revealTarget.classList.add('is-revealed');
            obs.unobserve(revealTarget);
          }
        });
      }, { threshold: 0.1 });
      io.observe(revealTarget);
    } else if (revealTarget) {
      revealTarget.classList.add('is-revealed');
    }
  })();
{% comment %}{% endcomment %}</script>
</template>

<schema>
{
  "type": "collection-tab",
  "name": "Product Tabs Navigation ",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_styling",
      "label": "Use custom tab colours and type",
      "info": "Off: tabs follow the colour scheme, Theme settings > Buttons and Theme settings > Typography. On: the Custom tab style controls below are used.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Heading area"
    },
    {
      "type": "paragraph",
      "id": "para_7",
      "label": "Add a Heading and a Subheading block to write the title. Each follows your theme typography until you turn on its own style.",
      "content": "Add a Heading and a Subheading block to write the title. Each follows your theme typography until you turn on its own style."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "vertical_gap_heading_subheading",
      "label": "Gap between heading and subheading",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "vertical_gap_subheading_section_desktop",
      "label": "Space above tabs (desktop)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "vertical_gap_subheading_section_mobile",
      "label": "Space above tabs (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Tabs"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "text",
          "label": "Plain text"
        }
      ]
    },
    {
      "type": "select",
      "id": "tabs_alignment",
      "label": "Tabs alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "tabs_full_width",
      "label": "Stretch tabs across the row on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "tab_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.tab_style == 'button' }}"
    },
    {
      "type": "range",
      "id": "tab_padding_x",
      "label": "Side padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "tab_padding_y",
      "label": "Top and bottom padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_gap",
      "label": "Gap between tabs",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "tab_unchecked_border_thickness",
      "label": "Border thickness (inactive)",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.tab_style == 'pill' or section.settings.tab_style == 'button' }}"
    },
    {
      "type": "range",
      "id": "tab_checked_border_thickness",
      "label": "Border thickness (active)",
      "info": "Underline style: thickness of the line under the open tab (0 uses 2px).",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.tab_style != 'text' }}"
    },
    {
      "type": "checkbox",
      "id": "show_tab_icon",
      "label": "Show collection picture in tab",
      "default": false
    },
    {
      "type": "range",
      "id": "tab_icon_size",
      "label": "Picture size",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 22,
      "visible_if": "{{ section.settings.show_tab_icon }}"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_nav_bottom_border",
      "label": "Show line under tabs",
      "default": false
    },
    {
      "type": "range",
      "id": "nav_bottom_border_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.show_nav_bottom_border }}"
    },
    {
      "type": "range",
      "id": "gap_tabs_to_products",
      "label": "Space between tabs and products",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "tab_switch_animation",
      "label": "Switch animation",
      "default": "fade",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade-in",
          "label": "Fade in up"
        },
        {
          "value": "slide-up",
          "label": "Slide up"
        },
        {
          "value": "slide-down",
          "label": "Slide down"
        },
        {
          "value": "zoom-in",
          "label": "Zoom in"
        },
        {
          "value": "zoom-out",
          "label": "Zoom out"
