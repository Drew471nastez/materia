        "default": false
      },
      {
        "type": "range",
        "id": "tab_icon_size",
        "label": "Picture size",
        "min": 14,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 22,
        "visible_if": "{{ section.settings.show_tab_icon }}"
