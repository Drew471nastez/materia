        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 22,
        "visible_if": "{{ section.settings.show_tab_icon }}"
      },
      {
        "type": "checkbox",
        "id": "show_product_count",
        "label": "Show product count",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_nav_bottom_border",
        "label": "Show line under tabs",
        "default": false
      },
      {
        "type": "range",
        "id": "nav_bottom_border_thickness",
        "label": "Line thickness",
        "min": 1,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 1,
        "visible_if": "{{ section.settings.show_nav_bottom_border }}"
      },
      {
        "type": "range",
        "id": "gap_tabs_to_products",
        "label": "Space between tabs and products",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 30
      },
      {
        "type": "select",
        "id": "tab_switch_animation",
        "label": "Switch animation",
        "default": "fade",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "fade-in",
            "label": "Fade in up"
          },
          {
            "value": "slide-up",
            "label": "Slide up"
          },
          {
            "value": "slide-down",
            "label": "Slide down"
          },
          {
            "value": "zoom-in",
            "label": "Zoom in"
          },
          {
            "value": "zoom-out",
            "label": "Zoom out"
          },
          {
            "value": "flip-x",
            "label": "Flip X"
          },
          {
            "value": "flip-y",
            "label": "Flip Y"
          }
        ]
      },
      {
        "type": "header",
        "content": "Custom tab style"
      },
      {
        "type": "paragraph",
        "content": "Turn on Use custom tab colours and type (Layout) to use these."
      },
      {
        "type": "range",
        "id": "tab_font_size",
        "label": "Tab text size",
        "min": 10,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 14,
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "select",
        "id": "tab_font_weight",
        "label": "Tab text weight",
        "default": "500",
        "visible_if": "{{ section.settings.enable_custom_styling }}",
        "options": [
          {
            "value": "300",
            "label": "Light"
          },
          {
            "value": "400",
            "label": "Normal"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semibold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "color",
        "id": "tab_unchecked_bg_color",
        "label": "Background (inactive)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_checked_bg_color",
        "label": "Background (active)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_unchecked_text_color",
        "label": "Text (inactive)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_checked_text_color",
        "label": "Text (active)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_hover_bg_color",
        "label": "Background (hover)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_hover_text_color",
        "label": "Text (hover)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_unchecked_border_color",
        "label": "Border (inactive)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "tab_checked_border_color",
        "label": "Border or underline (active)",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "nav_bottom_border_color",
        "label": "Line under tabs",
        "visible_if": "{{ section.settings.enable_custom_styling and section.settings.show_nav_bottom_border }}"
      },
      {
        "type": "color",
        "id": "empty_state_text_color",
        "label": "Empty message",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "header",
        "content": "Products"
      },
      {
        "type": "range",
        "id": "items_to_show",
        "label": "Products per tab",
        "min": 1,
        "max": 24,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Products per row (desktop)",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Products per row (mobile)",
        "info": "1.5 lets the row scroll sideways on phones.",
        "min": 1,
        "max": 2,
        "step": 0.5,
        "default": 2
      },
      {
        "type": "range",
        "id": "rows",
        "label": "Rows before Load more (desktop)",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "rows_mobile",
        "label": "Rows (mobile)",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between products",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Load more"
      },
      {
        "type": "checkbox",
        "id": "show_load_more_button",
        "label": "Show Load more button",
        "info": "Used when no View more button block is present.",
        "default": true
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "View More",
        "visible_if": "{{ section.settings.show_load_more_button }}"
      },
      {
        "type": "checkbox",
        "id": "use_outline_button_style",
        "label": "Outline button",
        "default": false,
        "visible_if": "{{ section.settings.show_load_more_button }}"
      },
      {
        "type": "range",
        "id": "gap_loadmore",
        "label": "Space above button",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 30,
        "visible_if": "{{ section.settings.show_load_more_button }}"
      },
      {
        "type": "header",
        "content": "Empty tab"
      },
      {
        "type": "text",
        "id": "empty_state_message",
        "label": "Message",
        "default": "No products found in this collection."
      },
      {
        "type": "range",
        "id": "empty_state_font_size",
        "label": "Message size",
        "min": 10,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal section on scroll",
        "default": true
      },
      {
        "type": "select",
        "id": "scroll_animation",
        "label": "Reveal style",
        "default": "smooth-fade-up",
        "visible_if": "{{ section.settings.reveal }}",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade-in",
            "label": "Fade in"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "slide-in",
            "label": "Slide in"
          },
          {
            "value": "blur_up",
            "label": "Blur up"
          },
          {
            "value": "slide_side",
            "label": "Slide from side"
          },
          {
            "value": "mask_reveal",
            "label": "Mask reveal"
          },
          {
            "value": "smooth-fade-up",
            "label": "Smooth fade up"
          }
        ]
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      }
    ],
    "max_blocks": 10,
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Featured Products"
          },
          {
            "type": "select",
            "id": "heading_size",
            "label": "Theme text style",
            "info": "Follows Theme settings > Typography.",
            "default": "h2",
            "visible_if": "{{ block.settings.custom_style == false }}",
            "options": [
              {
                "value": "h1",
                "label": "Heading 1"
              },
              {
                "value": "h2",
                "label": "Heading 2"
              },
              {
                "value": "h3",
                "label": "Heading 3"
              }
            ]
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Use custom style",
            "info": "Off: colour, size and weight follow the colour scheme and Theme settings > Typography. On: the controls below are used.",
            "default": false
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading color",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "select",
            "id": "heading_font_weight",
            "label": "Heading font weight",
            "default": "700",
            "visible_if": "{{ block.settings.custom_style }}",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "heading_font_size_desktop",
            "label": "Heading size (desktop)",
            "min": 14,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 28,
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "range",
            "id": "heading_font_size_mobile",
            "label": "Heading size (mobile)",
            "min": 12,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 24,
            "visible_if": "{{ block.settings.custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "subheading",
            "label": "Subheading",
            "default": "<p>Pick a collection to see what is in it.</p>"
          },
          {
            "type": "select",
            "id": "text_size",
            "label": "Theme text style",
            "info": "Follows Theme settings > Typography.",
            "default": "body",
            "visible_if": "{{ block.settings.custom_style == false }}",
            "options": [
              {
                "value": "body_large",
                "label": "Body large"
              },
              {
                "value": "body",
                "label": "Body"
              },
              {
                "value": "body_small",
                "label": "Body small"
              }
            ]
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 320,
            "max": 1200,
            "step": 20,
            "unit": "px",
            "default": 640
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Use custom style",
            "info": "Off: colour, size and weight follow the colour scheme and Theme settings > Typography. On: the controls below are used.",
            "default": false
          },
          {
            "type": "color",
            "id": "subheading_color",
            "label": "Subheading color",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "select",
            "id": "subheading_font_weight",
            "label": "Subheading font weight",
            "default": "400",
            "visible_if": "{{ block.settings.custom_style }}",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "subheading_font_size_desktop",
            "label": "Subheading size (desktop)",
            "min": 10,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "range",
            "id": "subheading_font_size_mobile",
            "label": "Subheading size (mobile)",
            "min": 10,
            "max": 32,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.custom_style }}"
          }
        ]
      },
      {
        "type": "collection",
        "name": "Collection Tab",
        "limit": 8,
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "text",
            "id": "collection_title",
            "label": "Tab title",
            "info": "Leave empty to use the collection's name."
          },
          {
            "type": "image_picker",
            "id": "tab_icon",
            "label": "Tab picture",
            "info": "Shown when Show collection picture in tab is on. Leave empty to use the collection's picture."
          }
        ]
      },
      {
        "type": "view_more",
        "name": "View more button",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "Loads more products from the active collection. Appears only when more products are available. This block overrides the section’s legacy load-more settings."
          },
          {
            "type": "checkbox",
            "id": "enabled",
            "label": "Show button",
            "default": true
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "View more"
          },
          {
            "type": "select",
            "id": "button_role",
            "label": "Theme button",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "select",
            "id": "appearance",
            "label": "Appearance",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme setting"
              },
              {
                "value": "outline",
                "label": "Outline"
              }
            ]
          },
          {
            "type": "header",
            "content": "Custom style"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Enable custom colors",
            "default": false
          },
          {
            "type": "color",
            "id": "button_background",
            "label": "Background",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "Text",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "color",
            "id": "button_border",
            "label": "Border",
            "visible_if": "{{ block.settings.custom_style }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Tabs Navigation",
        "category": "Products",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "collection"
          },
          {
            "type": "collection"
          },
          {
            "type": "collection"
          }
        ]
      }
    ]
  }
}
