      "label": "Display"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Total Products per Tab",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Products per Row (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Products per Row (Mobile)",
      "info": "1.5 enables free-scroll on mobile.",
      "min": 1,
