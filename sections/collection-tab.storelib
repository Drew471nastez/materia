          "type": "color",
          "id": "button_text",
          "label": "Text",
          "visible_if": "{{ block.settings.custom_style }}"
        },
        {
          "type": "color",
          "id": "button_border",
          "label": "Border",
          "visible_if": "{{ block.settings.custom_style }}"
        }
      ],
      "limit": 1
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Product Tabs Navigation",
      "category": "Products",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "overlay"
    ]
  },
  "shopify": {
    "name": "Product Tabs Navigation ",
    "tag": "section",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_styling",
        "label": "Use custom tab colours and type",
        "info": "Off: tabs follow the colour scheme, Theme settings > Buttons and Theme settings > Typography. On: the Custom tab style controls below are used.",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Heading area"
      },
      {
        "type": "paragraph",
        "content": "Add a Heading and a Subheading block to write the title. Each follows your theme typography until you turn on its own style."
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "vertical_gap_heading_subheading",
        "label": "Gap between heading and subheading",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "vertical_gap_subheading_section_desktop",
        "label": "Space above tabs (desktop)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 25
      },
      {
        "type": "range",
        "id": "vertical_gap_subheading_section_mobile",
        "label": "Space above tabs (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 18
      },
      {
        "type": "header",
        "content": "Tabs"
      },
      {
        "type": "select",
        "id": "tab_style",
        "label": "Tab style",
        "default": "pill",
        "options": [
          {
            "value": "pill",
            "label": "Pill"
          },
          {
            "value": "button",
            "label": "Button"
          },
          {
            "value": "underline",
            "label": "Underline"
          },
          {
            "value": "text",
            "label": "Plain text"
          }
        ]
      },
      {
        "type": "select",
        "id": "tabs_alignment",
        "label": "Tabs alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "tabs_full_width",
        "label": "Stretch tabs across the row on mobile",
        "default": true
      },
      {
        "type": "range",
        "id": "tab_border_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ section.settings.tab_style == 'button' }}"
      },
      {
        "type": "range",
        "id": "tab_padding_x",
        "label": "Side padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "tab_padding_y",
        "label": "Top and bottom padding",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "tab_gap",
        "label": "Gap between tabs",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "tab_unchecked_border_thickness",
        "label": "Border thickness (inactive)",
        "min": 0,
        "max": 5,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.tab_style == 'pill' or section.settings.tab_style == 'button' }}"
      },
      {
        "type": "range",
        "id": "tab_checked_border_thickness",
        "label": "Border thickness (active)",
        "info": "Underline style: thickness of the line under the open tab (0 uses 2px).",
        "min": 0,
        "max": 5,
        "step": 1,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.tab_style != 'text' }}"
      },
      {
        "type": "checkbox",
        "id": "show_tab_icon",
