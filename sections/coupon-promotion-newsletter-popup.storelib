        "type": "checkbox",
        "id": "gate_coupon",
        "label": "Show the code after signup",
        "default": true
      },
      {
        "type": "range",
        "id": "post_subscribe_duration_s",
        "label": "Builder: show the code for",
        "min": 5,
        "max": 60,
        "step": 5,
        "unit": "s",
        "default": 15,
        "visible_if": "{{ section.settings.gate_coupon == true }}"
      },
      {
        "type": "checkbox",
        "id": "editor_mode",
        "label": "Show in the builder",
        "default": false
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "image_side",
        "label": "Image",
        "default": "image-right",
        "options": [
          {
            "value": "image-right",
            "label": "Right"
          },
          {
            "value": "image-left",
            "label": "Left"
          }
        ]
      },
      {
        "type": "select",
        "id": "mobile_image_position",
        "label": "Image on phones",
        "default": "above",
        "options": [
          {
            "value": "above",
            "label": "Above"
          },
          {
            "value": "below",
            "label": "Below"
          },
          {
            "value": "hidden",
            "label": "Hidden"
          }
        ]
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Image shape",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Auto (fills column)"
          },
          {
            "value": "square",
            "label": "Square (1:1)"
          },
          {
            "value": "portrait",
            "label": "Portrait (3:4)"
          },
          {
            "value": "landscape",
            "label": "Landscape (4:3)"
          },
          {
            "value": "wide",
            "label": "Wide (16:9)"
          }
        ]
      },
      {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Fill"
          },
          {
            "value": "contain",
            "label": "Fit"
          }
        ]
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image focus",
        "default": "center",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "mobile_image_height_mode",
        "label": "Phone image height",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Auto"
          },
          {
            "value": "fixed",
            "label": "Fixed"
          }
        ]
      },
      {
        "type": "range",
        "id": "mobile_image_height",
        "label": "Height",
        "min": 100,
        "max": 400,
        "step": 10,
        "unit": "px",
        "default": 180,
        "visible_if": "{{ section.settings.mobile_image_height_mode == 'fixed' }}"
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "Text",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "select",
        "id": "dismiss_align",
        "label": "No-thanks link",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "popup_width",
        "label": "Width",
        "min": 360,
        "max": 1100,
        "step": 10,
        "unit": "px",
        "default": 770
      },
      {
        "type": "range",
        "id": "popup_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "card_padding_v",
        "label": "Top and bottom padding",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "card_padding_h",
        "label": "Side padding",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "mobile_gutter",
        "label": "Phone side space",
        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Custom colours",
        "default": false,
        "info": "Off, the popup follows its colour scheme."
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "close_color",
        "label": "Close icon",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Backdrop",
        "default": "#000000",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Backdrop opacity",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "%",
        "default": 50
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Custom fonts",
        "default": false,
        "info": "Off, the popup uses the theme fonts."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts == true }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts == true }}"
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Welcome offer"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "range",
            "id": "size_desktop",
