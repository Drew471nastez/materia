            "min": 10,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 12
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "headline",
        "name": "Headline",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Headline",
            "default": "A code for your first order"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size",
            "min": 20,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 32
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra Bold"
              },
              {
                "value": "900",
                "label": "Black"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Subscribe and get your coupon."
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 15
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "coupon",
        "name": "Coupon code",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "USE CODE"
          },
          {
            "type": "text",
            "id": "code",
            "label": "Code",
            "info": "Your own discount code. Empty, no code is shown."
          }
        ]
      },
      {
        "type": "form",
        "name": "Signup form",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "placeholder",
            "label": "Email placeholder",
            "default": "Enter your email"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button label",
            "default": "Subscribe"
          },
          {
            "type": "text",
            "id": "success_text",
            "label": "Thank-you text",
            "default": "Thanks! Here is your code:"
          },
          {
            "type": "header",
            "content": "Phone"
          },
          {
            "type": "checkbox",
            "id": "collect_phone",
            "label": "Ask for a phone number",
            "default": false
          },
          {
            "type": "text",
            "id": "phone_placeholder",
            "label": "Phone placeholder",
            "default": "Phone number",
            "visible_if": "{{ block.settings.collect_phone == true }}"
          },
          {
            "type": "text",
            "id": "phone_default_country",
            "label": "Country code",
            "default": "US",
            "visible_if": "{{ block.settings.collect_phone == true }}"
          },
          {
            "type": "checkbox",
            "id": "phone_required",
            "label": "Phone required",
            "default": false,
            "visible_if": "{{ block.settings.collect_phone == true }}"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "use_theme_field",
            "label": "Theme field style",
            "default": true
          },
          {
            "type": "range",
            "id": "input_radius",
            "label": "Field radius",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_field == false }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Theme button style",
            "default": true
          },
          {
            "type": "select",
            "id": "button_weight",
            "label": "Button weight",
            "default": "700",
            "options": [
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra Bold"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "button_radius",
            "label": "Button radius",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "button_bg",
            "label": "Button background",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "button_text_color",
            "label": "Button text",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "button_bg_hover",
            "label": "Hover background",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "button_text_hover",
            "label": "Hover text",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "alt",
            "label": "Alt text",
            "default": "Promotion"
          }
        ]
      },
      {
        "type": "dismiss",
        "name": "No-thanks link",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "No thanks"
          }
        ]
      }
    ],
    "presets": []
  }
}
