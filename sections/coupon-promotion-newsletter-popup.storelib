  "shopify": {
    "name": "Coupon Promo Popup",
    "tag": "section",
    "class": "cpnb-section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Coupon access"
      },
      {
        "type": "checkbox",
        "id": "gate_coupon",
        "label": "Reveal coupon after signup",
        "default": true
      },
      {
        "type": "range",
        "id": "post_subscribe_duration_s",
        "min": 5,
        "max": 60,
        "step": 5,
        "unit": "s",
        "label": "Show coupon for",
        "default": 15
      },
      {
        "type": "header",
        "content": "Trigger / When to open"
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "When to open",
        "default": "delay",
        "options": [
          {
            "value": "immediate",
            "label": "Immediately"
          },
          {
            "value": "delay",
            "label": "After delay"
          },
          {
            "value": "exit",
            "label": "Exit intent (desktop)"
          },
          {
            "value": "manual",
            "label": "Manual (button click)"
