<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_promotion_image = 'accessibility.promotion_image' | t -%}
{%- assign fb_accessibility_subscribe = 'accessibility.subscribe' | t -%}
{%- assign fb_accessibility_enter_your_email = 'accessibility.enter_your_email' | t -%}
{%- comment -%}
  Coupon Promotion Newsletter Banner Popup
  --------------------------------------------------------------
  A clean, block-based promotional popup that combines an eyebrow,
  headline, subheading, coupon code, newsletter form and an image.
  Built from scratch to live in the Promotional Popup category.
  Renders above all theme content via maximum 32-bit z-index and a
  position-static section wrapper (no isolation: isolate stacking
  context trap).
{%- endcomment -%}

{%- assign block_eyebrow   = blank -%}
{%- assign block_headline  = blank -%}
{%- assign block_subheading = blank -%}
{%- assign block_coupon    = blank -%}
{%- assign block_form      = blank -%}
{%- assign block_image     = blank -%}
{%- assign block_dismiss   = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'headline' -%}{%- assign block_headline = b -%}
    {%- when 'subheading' -%}{%- assign block_subheading = b -%}
    {%- when 'coupon' -%}{%- assign block_coupon = b -%}
    {%- when 'form' -%}{%- assign block_form = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
    {%- when 'dismiss' -%}{%- assign block_dismiss = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign open_mode = section.settings.open_mode -%}
{%- assign delay_s = section.settings.delay_s | default: 0 -%}
{%- assign hide_days = section.settings.hide_days | default: 1 -%}
{%- assign mobile_gutter = section.settings.mobile_gutter | default: 32 -%}

<style>
  /* No section stacking context — popup must escape and render above all */
  #shopify-section-{{ section.id }} { position: static; }

  .cpnb-{{ section.id }} { font-family: var(--body-font, inherit); }
  .cpnb-{{ section.id }} *,
  .cpnb-{{ section.id }} *::before,
  .cpnb-{{ section.id }} *::after { box-sizing: border-box; }

  /* Overlay (backdrop) */
  .cpnb-overlay-{{ section.id }} {
    position: fixed; inset: 0;
    background: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s ease;
    z-index: 2147483646;
  }
  .cpnb-{{ section.id }}.cpnb-open .cpnb-overlay-{{ section.id }} {
    opacity: {{ section.settings.overlay_opacity | default: 50 | times: 0.01 }};
    pointer-events: auto;
  }

  /* Card (popup container) */
  .cpnb-card-{{ section.id }} {
    position: fixed; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.96);
    opacity: 0; pointer-events: none;
    transition: transform .3s ease, opacity .3s ease;
    z-index: 2147483647;
    width: min(calc(100vw - {{ mobile_gutter }}px), {{ section.settings.popup_width | default: 880 }}px);
    /* Hard-cap to viewport so popup never requires page scroll.
       Internal layout is sized so it fits inside this without overflowing. */
    max-height: min(560px, calc(100vh - 24px));
    overflow: hidden;
    background: {% render 'scheme-color', color: section.settings.card_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ section.settings.popup_radius | default: 14 }}px;
    box-shadow: 0 12px 40px rgba(0,0,0,.15);
  }
  .cpnb-{{ section.id }}.cpnb-open .cpnb-card-{{ section.id }} {
    opacity: 1; pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (min-width: 750px) {
    .cpnb-card-{{ section.id }} {
      width: min(92vw, {{ section.settings.popup_width | default: 880 }}px);
      max-height: min(520px, calc(100vh - 32px));
    }
  }

  /* Layout — two columns on desktop, single column on mobile.
     Each column owns half the card height so neither side scrolls. */
  .cpnb-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: {% if section.settings.image_side == 'image-left' %}.95fr 1.05fr{% else %}1.05fr .95fr{% endif %};
    align-items: stretch;
    gap: 0;
    height: 100%;
  }
  .cpnb-grid-{{ section.id }}.cpnb-image-left .cpnb-text-{{ section.id }} { order: 2; }
  .cpnb-grid-{{ section.id }}.cpnb-image-left .cpnb-image-{{ section.id }} { order: 1; }
  @media (max-width: 749px) {
    .cpnb-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: auto;
    }
    {% if section.settings.mobile_image_position == 'above' %}
    .cpnb-grid-{{ section.id }} .cpnb-text-{{ section.id }} { order: 2; }
    .cpnb-grid-{{ section.id }} .cpnb-image-{{ section.id }} { order: 1; }
    {% elsif section.settings.mobile_image_position == 'below' %}
    .cpnb-grid-{{ section.id }} .cpnb-text-{{ section.id }} { order: 1; }
    .cpnb-grid-{{ section.id }} .cpnb-image-{{ section.id }} { order: 2; }
    {% elsif section.settings.mobile_image_position == 'hidden' %}
    .cpnb-grid-{{ section.id }} .cpnb-image-{{ section.id }} { display: none; }
    .cpnb-grid-{{ section.id }} { grid-template-rows: 1fr; }
    {% endif %}
  }

  /* Text column */
  .cpnb-text-{{ section.id }} {
    padding: {{ section.settings.card_padding_v | default: 24 }}px {{ section.settings.card_padding_h | default: 28 }}px;
    display: flex; flex-direction: column;
    justify-content: center;
    text-align: {{ section.settings.text_align | default: 'left' }};
    {% if section.settings.text_align == 'center' %}align-items: center;{% endif %}
    min-height: 0;
    overflow: hidden;
  }
  @media (max-width: 749px) {
    .cpnb-text-{{ section.id }} {
      padding: 18px 20px;
      justify-content: flex-start;
    }
  }

  /* Image column — fixed sizing so it never overflows the card */
  .cpnb-image-{{ section.id }} {
    background: #f3f3f3;
    overflow: hidden;
    min-height: 0;
    {%- case section.settings.image_ratio -%}
      {%- when 'square' -%} aspect-ratio: 1 / 1;
      {%- when 'portrait' -%} aspect-ratio: 3 / 4;
      {%- when 'landscape' -%} aspect-ratio: 4 / 3;
      {%- when 'wide' -%} aspect-ratio: 16 / 9;
      {%- when 'auto' -%}
      {%- else -%}
    {%- endcase -%}
  }
  .cpnb-image-{{ section.id }} .cpnb-placeholder { display: block; width: 100%; height: 100%; min-height: 200px; opacity: .5; }
  .cpnb-image-{{ section.id }} img {
    width: 100%; height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    object-position: {{ section.settings.image_position | default: 'center' }};
    display: block;
  }
  @media (max-width: 749px) {
    .cpnb-image-{{ section.id }} {
      {%- if section.settings.mobile_image_height_mode == 'fixed' -%}
        height: {{ section.settings.mobile_image_height | default: 180 }}px;
        aspect-ratio: auto;
      {%- else -%}
        aspect-ratio: 16 / 10;
      {%- endif -%}
    }
  }

  /* Close */
  .cpnb-close-{{ section.id }} {
    position: absolute; top: 10px; right: 10px;
    width: 32px; height: 32px;
    border: none; border-radius: 50%;
    background: var(--color-background, #fff);
    color: {% render 'scheme-color', color: section.settings.close_color, fallback: 'var(--color-heading)' %};
    font-size: 18px; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
    transition: transform .2s ease, background .2s ease;
    z-index: 2;
  }
  .cpnb-close-{{ section.id }}:hover { transform: scale(1.05); }

  /* Block typography — compact sizes so 2-column popup fits without scroll */
  .cpnb-eyebrow-{{ section.id }} { font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .85; margin: 0 0 6px; }
  .cpnb-headline-{{ section.id }} { font-weight: var(--heading-weight, 800); line-height: 1.1; margin: 0 0 8px; }
  .cpnb-subheading-{{ section.id }} { line-height: 1.45; margin: 0 0 12px; max-width: 480px; }
  @media (max-width: 749px) {
    .cpnb-headline-{{ section.id }} { font-size: 24px !important; }
    .cpnb-subheading-{{ section.id }} { font-size: 14px !important; margin-bottom: 10px; }
  }

  /* Coupon visibility. When gating is ON, coupon is hidden until subscribe.
     When gating is OFF, coupon is visible from the start. */
  {% if section.settings.gate_coupon %}
    .cpnb-coupon-{{ section.id }}.cpnb-coupon-gated { display: none; }
    .cpnb-{{ section.id }}.cpnb-subscribed .cpnb-coupon-{{ section.id }}.cpnb-coupon-gated { display: flex; }
    .cpnb-coupon-{{ section.id }}.cpnb-coupon-ungated { display: none !important; }
  {% else %}
    .cpnb-coupon-{{ section.id }}.cpnb-coupon-gated { display: none !important; }
    .cpnb-coupon-{{ section.id }}.cpnb-coupon-ungated { display: flex; }
  {% endif %}
  .cpnb-code-row-{{ section.id }} {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    margin: 0 0 10px;
    {% if section.settings.text_align == 'center' %}justify-content: center;{% endif %}
  }
  .cpnb-code-label-{{ section.id }} { font-weight: 600; opacity: .9; font-size: 13px; letter-spacing: .08em; }
  .cpnb-code-{{ section.id }} {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700; letter-spacing: .12em; font-size: 15px;
    padding: 8px 12px; border-radius: 6px;
    border: 2px dashed currentColor;
    cursor: pointer; user-select: all;
    background: transparent;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .cpnb-code-{{ section.id }}.is-copied { background: #1c8d3a; color: #fff; border-color: #1c8d3a; }

  /* Pre-subscribe form: hidden after subscribe */
  .cpnb-prepane-{{ section.id }} { display: block; }
  .cpnb-{{ section.id }}.cpnb-subscribed .cpnb-prepane-{{ section.id }} { display: none; }
  /* Post-subscribe success: hidden until subscribe */
  .cpnb-postpane-{{ section.id }} { display: none; }
  .cpnb-{{ section.id }}.cpnb-subscribed .cpnb-postpane-{{ section.id }} { display: block; }

  /* Form — gap between input and button is enforced on the inner <form> too */
  .cpnb-form-{{ section.id }} { max-width: 420px; {% if section.settings.text_align == 'center' %}margin-inline: auto;{% endif %} }
  .cpnb-form-{{ section.id }} > form,
  .cpnb-form-{{ section.id }} form.cpnb-formel-{{ section.id }} {
    display: flex; flex-direction: column; gap: 12px;
  }
  .cpnb-form-{{ section.id }} input[type="email"] {
    width: 100%; padding: 12px 14px;
    border-radius: var(--input-radius, 8px);
    border: 1px solid var(--color-border);
    font-size: 15px;
    background: var(--color-background); color: var(--color-text);
    outline: none;
  }
  .cpnb-form-{{ section.id }} input[type="email"]:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 1px;
  }
  .cpnb-form-{{ section.id }} button[type="submit"] {
    width: 100%; padding: 12px 20px;
    border-radius: var(--cpnb-btn-radius, 8px); border: none;
    font-weight: var(--cpnb-btn-weight, 700); font-size: 15px;
    background: var(--cpnb-btn-bg); color: var(--cpnb-btn-fg);
    cursor: pointer;
    /* Smooth hover transition with ease-out — buttery feel */
    transition: background-color .35s cubic-bezier(.4,0,.2,1),
                color .35s cubic-bezier(.4,0,.2,1),
                transform .15s ease-out,
                box-shadow .35s ease;
  }
  {%- if block_form.settings.use_theme_button != false -%}
  .cpnb-form-{{ section.id }} button[type="submit"] {
    padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 20px);
    font-size: var(--btn-font-size, 15px);
    border: var(--btn-border-width, 0px) solid var(--cpnb-btn-bg);
  }
  {%- endif -%}
  .cpnb-form-{{ section.id }} button[type="submit"]:hover,
  .cpnb-form-{{ section.id }} button[type="submit"]:focus-visible {
    background: var(--cpnb-btn-bg-h); color: var(--cpnb-btn-fg-h);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
  }
  .cpnb-form-{{ section.id }} button[type="submit"]:active {
    transform: translateY(0);
    box-shadow: none;
  }
  /* Loading state — shown while the fetch is in-flight */
  .cpnb-form-{{ section.id }} button[type="submit"].is-loading {
    pointer-events: none;
    opacity: .7;
  }
  .cpnb-form-{{ section.id }} button[type="submit"].is-loading::after {
    content: '';
    display: inline-block;
    width: 14px; height: 14px;
    margin-left: 10px;
    vertical-align: middle;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: cpnb-spin-{{ section.id }} .8s linear infinite;
  }
  @keyframes cpnb-spin-{{ section.id }} {
    to { transform: rotate(360deg); }
  }

  /* Body scroll lock helper — applied by JS while the popup is open */
  body.cpnb-no-scroll-{{ section.id }} {
    overflow: hidden;
  }

  /* Respect prefers-reduced-motion: disable animations for visitors who opted out. */
  @media (prefers-reduced-motion: reduce) {
    .cpnb-card-{{ section.id }},
    .cpnb-overlay-{{ section.id }},
    .cpnb-form-{{ section.id }} button[type="submit"],
    .cpnb-code-{{ section.id }},
    .cpnb-close-{{ section.id }} {
      transition: none !important;
      animation: none !important;
    }
    .cpnb-form-{{ section.id }} button[type="submit"]:hover {
      transform: none;
    }
  }

  /* Dismiss link — alignment is configurable */
  .cpnb-dismiss-wrap-{{ section.id }} {
    margin-top: 10px;
    text-align: {{ section.settings.dismiss_align | default: 'center' }};
  }
  .cpnb-dismiss-{{ section.id }} {
    background: none; border: none; cursor: pointer;
    font-size: 13px;
    text-decoration: underline;
    color: inherit; opacity: .7;
    padding: 4px 0;
    transition: opacity .2s ease;
  }
  .cpnb-dismiss-{{ section.id }}:hover { opacity: 1; }
{% comment %}{% endcomment %}</style>

<section class="cpnb-{{ section.id }} color-{{ color_scheme }}"
         data-cpnb-section="{{ section.id }}"
         data-section-id="{{ section.id }}"
         aria-hidden="true">
  <div class="cpnb-overlay-{{ section.id }}" aria-hidden="true"></div>
  <div class="cpnb-card-{{ section.id }}"
       role="dialog"
       aria-modal="true"
       aria-labelledby="cpnb-title-{{ section.id }}"
       tabindex="-1">
    <button type="button" class="cpnb-close-{{ section.id }}" aria-label="{{ 'accessibility.close_popup' | t }}">×</button>

    <div class="cpnb-grid-{{ section.id }}{% if section.settings.image_side == 'image-left' %} cpnb-image-left{% endif %}">
      <div class="cpnb-text-{{ section.id }}">
        {%- if block_eyebrow != blank and block_eyebrow.settings.text != blank -%}
          <div class="cpnb-eyebrow-{{ section.id }}"
               style="font-size: {{ block_eyebrow.settings.size_desktop | default: 12 }}px; color: {% render 'scheme-color', color: block_eyebrow.settings.color, fallback: 'var(--color-text)' %};"
               {{ block_eyebrow.shopify_attributes }}>{{ block_eyebrow.settings.text }}</div>
        {%- endif -%}

        {%- if block_headline != blank and block_headline.settings.text != blank -%}
          <h2 class="cpnb-headline-{{ section.id }}" id="cpnb-title-{{ section.id }}"
              style="font-size: {{ block_headline.settings.size_desktop | default: 32 }}px; color: {% render 'scheme-color', color: block_headline.settings.color, fallback: 'var(--color-heading)' %}; font-weight: {% if block_headline.settings.weight == blank or block_headline.settings.weight == 'theme' %}var(--heading-weight, 800){% else %}{{ block_headline.settings.weight }}{% endif %};"
              {{ block_headline.shopify_attributes }}>{{ block_headline.settings.text }}</h2>
        {%- endif -%}

        {%- if block_subheading != blank and block_subheading.settings.text != blank -%}
          <p class="cpnb-subheading-{{ section.id }}"
             style="font-size: {{ block_subheading.settings.size_desktop | default: 15 }}px; color: {% render 'scheme-color', color: block_subheading.settings.color, fallback: 'var(--color-text)' %};"
             {{ block_subheading.shopify_attributes }}>{{ block_subheading.settings.text }}</p>
        {%- endif -%}

        {%- comment -%}
          Pre-subscribe pane: show the newsletter form. Coupon is hidden until
          the visitor subscribes.
        {%- endcomment -%}
        <div class="cpnb-prepane-{{ section.id }}">
          {%- comment -%} Ungated coupon: visible immediately when gate_coupon is OFF {%- endcomment -%}
          {%- unless section.settings.gate_coupon -%}
            {%- if block_coupon != blank and block_coupon.settings.code != blank -%}
              <div class="cpnb-code-row-{{ section.id }} cpnb-coupon-{{ section.id }} cpnb-coupon-ungated" {{ block_coupon.shopify_attributes }}>
                {%- if block_coupon.settings.label != blank -%}
                  <span class="cpnb-code-label-{{ section.id }}">{{ block_coupon.settings.label }}</span>
                {%- endif -%}
                <button type="button" class="cpnb-code-{{ section.id }}" data-code="{{ block_coupon.settings.code | escape }}" aria-label="{{ 'accessibility.copy_coupon_code' | t }}">{{ block_coupon.settings.code | escape }}</button>
              </div>
            {%- endif -%}
          {%- endunless -%}

          {%- if block_form != blank -%}
            {%- assign cpnb_form_id = 'cpnb-form-' | append: section.id -%}
            {%- assign cpnb_form_class = 'cpnb-formel-' | append: section.id -%}
            <div class="cpnb-form-{{ section.id }}" {{ block_form.shopify_attributes }}>
              {%- form 'customer', id: cpnb_form_id, class: cpnb_form_class -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="{{ block_form.settings.placeholder | default: fb_accessibility_enter_your_email | escape }}" required
                       {% if block_form.settings.use_theme_field == false %}style="border-radius: {{ block_form.settings.input_radius | default: 8 }}px;"{% endif %}>
                {%- if block_form.settings.collect_phone -%}
                  {%- if block_form.settings.phone_required -%}{%- assign cpnb_phone_req = 'true' -%}{%- else -%}{%- assign cpnb_phone_req = 'false' -%}{%- endif -%}
                  {%- render 'cpnb-phone-field',
                      scope: section.id,
                      default_country: block_form.settings.phone_default_country,
                      phone_placeholder: block_form.settings.phone_placeholder,
                      required: cpnb_phone_req -%}
                {%- endif -%}
                <button type="submit"
                        style="--cpnb-btn-bg: {% render 'scheme-color', color: block_form.settings.button_bg, fallback: 'var(--btn-primary-bg-color)' %}; --cpnb-btn-fg: {% render 'scheme-color', color: block_form.settings.button_text_color, fallback: 'var(--btn-primary-color)' %}; --cpnb-btn-bg-h: {% render 'scheme-color', color: block_form.settings.button_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %}; --cpnb-btn-fg-h: {% render 'scheme-color', color: block_form.settings.button_text_hover, fallback: 'var(--btn-primary-hover-color)' %};{% if block_form.settings.use_theme_button == false %} --cpnb-btn-radius: {{ block_form.settings.button_radius | default: 8 }}px; --cpnb-btn-weight: {{ block_form.settings.button_weight | default: '700' }};{% else %} --cpnb-btn-radius: var(--btn-radius, 8px); --cpnb-btn-weight: var(--btn-font-weight, 700);{% endif %}">
                  {{ block_form.settings.button_text | default: fb_accessibility_subscribe }}
                </button>
                {%- comment -%}
                  When Shopify POSTs the form, the page reloads with form.posted_successfully?
                  set. We render an invisible flag here that the JS picks up on next load to
                  re-open the popup in the post-pane (coupon) state for a short window.
                {%- endcomment -%}
                {%- if form.posted_successfully? -%}
                  <span data-cpnb-just-subscribed="true" style="display:none;"></span>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if block_dismiss != blank and block_dismiss.settings.text != blank -%}
            <div class="cpnb-dismiss-wrap-{{ section.id }}" {{ block_dismiss.shopify_attributes }}>
              <button type="button" class="cpnb-dismiss-{{ section.id }}" data-sl-button data-button-role="secondary">{{ block_dismiss.settings.text }}</button>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          Post-subscribe pane: reveal the coupon code + success message.
        {%- endcomment -%}
        {%- comment -%} Post-subscribe pane only renders when gating is ON {%- endcomment -%}
        {%- if section.settings.gate_coupon -%}
          <div class="cpnb-postpane-{{ section.id }}" aria-live="polite">
            {%- if block_form != blank -%}
              <p style="color:#1c8d3a; margin:0 0 12px; font-size:14px; font-weight:600;">{{ block_form.settings.success_text | default: 'Thanks! Here is your code:' }}</p>
            {%- endif -%}

            {%- if block_coupon != blank and block_coupon.settings.code != blank -%}
              <div class="cpnb-code-row-{{ section.id }} cpnb-coupon-{{ section.id }} cpnb-coupon-gated" {{ block_coupon.shopify_attributes }}>
                {%- if block_coupon.settings.label != blank -%}
                  <span class="cpnb-code-label-{{ section.id }}">{{ block_coupon.settings.label }}</span>
                {%- endif -%}
                <button type="button" class="cpnb-code-{{ section.id }}" data-code="{{ block_coupon.settings.code | escape }}" aria-label="{{ 'accessibility.copy_coupon_code' | t }}">{{ block_coupon.settings.code | escape }}</button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if block_image != blank -%}
        <div class="cpnb-image-{{ section.id }}" {{ block_image.shopify_attributes }}>
          {%- if block_image.settings.image != blank -%}
            {{ block_image.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block_image.settings.alt | default: fb_accessibility_promotion_image, sizes: '(min-width: 750px) 50vw, 100vw', widths: '360,540,720,900' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'cpnb-placeholder' }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function(){
  // Per-section constants (rendered from Liquid)
  const SECTION_ID = '{{ section.id }}';
  const I18N_COPIED = {{ 'accessibility.copied' | t | json }};
  const lsKey = 'cpnb_dismissed_' + SECTION_ID;
  const subKey = 'cpnb_subscribed_' + SECTION_ID;
  const subTimeKey = 'cpnb_subtime_' + SECTION_ID;
  const couponShownKey = 'cpnb_coupon_shown_' + SECTION_ID;
  const neverKey = 'cpnb_never_' + SECTION_ID;
  const bodyLockClass = 'cpnb-no-scroll-' + SECTION_ID;
  const afterDismiss = '{{ section.settings.after_dismiss | default: "after_days" }}';
  const hideDays = {{ section.settings.hide_days | default: 1 }};
  const postSubscribeMs = {{ section.settings.post_subscribe_duration_s | default: 15 }} * 1000;
  const editorModeOn = {% if section.settings.editor_mode %}true{% else %}false{% endif %};
  const openMode = '{{ section.settings.open_mode }}';
  const delayMs = {{ section.settings.delay_s | default: 0 }} * 1000;

  // Safe localStorage wrapper (private mode / quota exhausted)
  const LS = {
    get(k){ try { return localStorage.getItem(k); } catch(_){ return null; } },
    set(k,v){ try { localStorage.setItem(k, v); } catch(_){} },
    rm(k){ try { localStorage.removeItem(k); } catch(_){} }
  };

  // Active controller for the current instance — kept around so we can fully
  // tear down listeners when Shopify unloads the section in the editor.
  let controller = null;

  function init() {
    const root = document.querySelector('.cpnb-' + SECTION_ID);
    if (!root) return;
    if (root.__cpnbInited) return;          // already initialised
    root.__cpnbInited = true;

    const card = root.querySelector('.cpnb-card-' + SECTION_ID);
    const overlay = root.querySelector('.cpnb-overlay-' + SECTION_ID);
    const closeBtn = root.querySelector('.cpnb-close-' + SECTION_ID);
    const dismissBtn = root.querySelector('.cpnb-dismiss-' + SECTION_ID);
    const codeBtn = root.querySelector('.cpnb-code-' + SECTION_ID);
    const formEl = root.querySelector('.cpnb-formel-' + SECTION_ID);
    const submitBtn = formEl ? formEl.querySelector('button[type="submit"]') : null;
    const inDesign = !!(window.Shopify && Shopify.designMode);
    const forceEditor = editorModeOn && inDesign;
    const wasSubscribed = LS.get(subKey) === '1';

    // Liquid marker — fallback if the form posted as a real reload
    const justSubmittedMarker = root.querySelector('[data-cpnb-just-subscribed]');
    if (justSubmittedMarker && LS.get(couponShownKey) !== '1') {
      LS.set(subKey, '1');
      LS.set(subTimeKey, String(Date.now()));
    }

    const subTime = parseInt(LS.get(subTimeKey) || '0', 10);
    const elapsed = subTime > 0 ? Date.now() - subTime : Infinity;
    const justSubscribed = subTime > 0 && elapsed < postSubscribeMs && LS.get(couponShownKey) !== '1';

    // ----- Helpers -----------------------------------------------------------
    function isSuppressed() {
      if (forceEditor) return false;
      if (wasSubscribed) return true;
      if (LS.get(neverKey) === '1') return true;
      if (afterDismiss === 'every_visit') return false;
      const until = parseInt(LS.get(lsKey) || '0', 10);
      return !!(until && Date.now() < until);
    }
    function persistDismiss() {
      if (forceEditor) return;
      if (afterDismiss === 'never') LS.set(neverKey, '1');
      else if (afterDismiss === 'after_days' && hideDays > 0) {
        LS.set(lsKey, String(Date.now() + hideDays * 24 * 60 * 60 * 1000));
      }
    }

    // Body scroll lock — only while the popup is open
    function lockBody() { document.body.classList.add(bodyLockClass); }
    function unlockBody() { document.body.classList.remove(bodyLockClass); }

    // Focus management — trap focus inside the card, restore focus on close.
    let prevActive = null;
    function focusableElements() {
      if (!card) return [];
      // Visible focusable descendants. Use getClientRects() for visibility — works
      // for elements inside position:fixed/sticky parents where offsetParent is null.
      return Array.from(card.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter(el => {
        if (el.hidden || el.getAttribute('aria-hidden') === 'true') return false;
        return el.getClientRects().length > 0;
      });
    }
    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      const focusables = focusableElements();
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    function show() {
      if (isSuppressed()) return;
      root.classList.add('cpnb-open');
      root.setAttribute('aria-hidden', 'false');
      lockBody();
      prevActive = document.activeElement;
      // Give the dialog role/title a chance to be announced by screen readers
      // before moving focus into the first interactive control.
      if (card && typeof card.focus === 'function') {
        try { card.focus({ preventScroll: true }); } catch(_) {}
      }
      // Then move focus to the email input (or first focusable) for keyboard users
      requestAnimationFrame(() => {
        const focusables = focusableElements();
        const target = focusables.find(el => el.tagName === 'INPUT' && el.type === 'email') || focusables[0];
        if (target) {
          try { target.focus({ preventScroll: true }); } catch(_) {}
        }
      });
    }
    function hide() {
      root.classList.remove('cpnb-open');
      root.setAttribute('aria-hidden', 'true');
      unlockBody();
      if (prevActive && typeof prevActive.focus === 'function') {
        try { prevActive.focus({ preventScroll: true }); } catch(_) {}
      }
      persistDismiss();
    }

    // ----- Event listeners (tracked so we can clean up) ----------------------
    const listeners = [];
    function on(target, type, fn, opts) {
      if (!target) return;
      target.addEventListener(type, fn, opts);
      listeners.push({ target, type, fn, opts });
    }

    on(closeBtn, 'click', hide);
    on(dismissBtn, 'click', hide);
    on(overlay, 'click', hide);
    on(document, 'keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('cpnb-open')) hide();
      else if (e.key === 'Tab' && root.classList.contains('cpnb-open')) trapFocus(e);
    });

    // Bulletproof copy-to-clipboard. Tries the async Clipboard API first; on
    // any failure (insecure context, permission denied, lack of user activation)
    // falls back to a visible-but-tiny textarea + execCommand('copy'). Some
    // browsers reject execCommand on display:none source elements, so the
    // textarea is rendered with opacity:0 (still in the layout tree).
    function cpnbCopy(text) {
      return new Promise((resolve, reject) => {
        if (!text) { reject(new Error('empty')); return; }
        const useAsync = navigator.clipboard
          && typeof navigator.clipboard.writeText === 'function'
          && (window.isSecureContext === true || window.isSecureContext === undefined);
        const fallback = () => {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '0'; ta.style.left = '0';
            ta.style.width = '2em'; ta.style.height = '2em';
            ta.style.padding = '0'; ta.style.border = 'none';
            ta.style.outline = 'none'; ta.style.boxShadow = 'none';
            ta.style.background = 'transparent'; ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus(); ta.select(); ta.setSelectionRange(0, text.length);
            const ok = document.execCommand && document.execCommand('copy');
            document.body.removeChild(ta);
            if (ok) resolve(); else reject(new Error('execCommand failed'));
          } catch (err) { reject(err); }
        };
        if (useAsync) {
          navigator.clipboard.writeText(text).then(resolve).catch(fallback);
        } else {
          fallback();
        }
      });
    }

    // Coupon copy-to-clipboard
    if (codeBtn) {
      on(codeBtn, 'click', () => {
        const code = (codeBtn.dataset.code || '').trim();
        if (!code) return;
        const original = codeBtn.textContent;
        const finishOk = () => {
          codeBtn.classList.add('is-copied');
          codeBtn.textContent = I18N_COPIED;
          setTimeout(() => { codeBtn.classList.remove('is-copied'); codeBtn.textContent = original; }, 2200);
        };
        cpnbCopy(code).then(finishOk).catch(() => {
          // Still show feedback so the visitor sees something happened. The
          // code remains visible/selectable for manual Cmd-C / Ctrl-C copy.
          finishOk();
        });
      });
    }

    // Form submit ---------------------------------------------------------
    if (formEl) {
      if (forceEditor) {
        // EDITOR MODE: never POST anywhere. Cycle: submit → coupon → reset → form.
        on(formEl, 'submit', (e) => {
          e.preventDefault();
          root.classList.add('cpnb-subscribed');
          setTimeout(() => { root.classList.remove('cpnb-subscribed'); }, postSubscribeMs);
        });
      } else {
        // LIVE MODE: AJAX submit, no page reload.
        on(formEl, 'submit', (e) => {
          // (1) Persist state synchronously so even a failed preventDefault recovers
          LS.set(subKey, '1');
          LS.set(subTimeKey, String(Date.now()));
          // (2) Flip UI immediately
          root.classList.add('cpnb-subscribed');
          // (3) Block default form submission + sibling handlers
          e.preventDefault();
          if (e.stopImmediatePropagation) e.stopImmediatePropagation();
          e.stopPropagation();
          // (4) Loading state on the button
          if (submitBtn) { submitBtn.classList.add('is-loading'); submitBtn.disabled = true; }
          // (5) Background POST so Shopify still records the subscriber
          const formData = new FormData(formEl);
          try {
            fetch(formEl.action || '/contact', {
              method: 'POST',
              headers: { 'Accept': 'application/json, text/html;q=0.9, */*;q=0.8' },
              body: formData,
              credentials: 'same-origin',
              redirect: 'manual'
            }).catch(() => {});
          } catch(_) {}
          setTimeout(() => {
            if (submitBtn) { submitBtn.classList.remove('is-loading'); submitBtn.disabled = false; }
          }, 1500);
          return false;
        }, true); // capture phase
      }
    }

    // Manual hooks (always available regardless of trigger mode)
    window['CPNB_open_' + SECTION_ID] = show;
    window['CPNB_close_' + SECTION_ID] = hide;
    window['CPNB_reset_' + SECTION_ID] = function() {
      [lsKey, subKey, subTimeKey, couponShownKey, neverKey].forEach(LS.rm);
      root.classList.remove('cpnb-subscribed');
    };

    // ----- Initial state -----------------------------------------------------
    if (forceEditor) {
      root.classList.add('cpnb-open');
      root.setAttribute('aria-hidden', 'false');
      // Don't lock body scroll in the editor — merchants need to scroll settings panel
    } else if (justSubscribed) {
      // Just-subscribed replay — open in coupon state, stay open until visitor closes
      root.classList.add('cpnb-subscribed');
      root.classList.add('cpnb-open');
      root.setAttribute('aria-hidden', 'false');
      lockBody();
      const finalize = () => {
        LS.set(couponShownKey, '1');
        LS.rm(subTimeKey);
      };
      on(closeBtn, 'click', finalize, { once: true });
      on(overlay, 'click', finalize, { once: true });
      on(dismissBtn, 'click', finalize, { once: true });
      on(document, 'keydown', function escFinalize(e) {
        if (e.key === 'Escape') finalize();
      });
    } else if (!isSuppressed()) {
      // Normal trigger flow
      if (openMode === 'immediate') show();
      else if (openMode === 'delay') setTimeout(show, delayMs > 0 ? delayMs : 0);
      else if (openMode === 'exit') {
        const exitHandler = (e) => {
          if (e.clientY <= 8) { show(); document.removeEventListener('mousemove', exitHandler); }
        };
        on(document, 'mousemove', exitHandler, { passive: true });
      } else if (openMode === 'manual') {
        document.querySelectorAll('[data-cpnb-trigger="' + SECTION_ID + '"]').forEach(el => {
          on(el, 'click', (ev) => { ev.preventDefault(); show(); });
        });
      }
    }

    // Build the controller for external teardown
    controller = {
      destroy() {
        listeners.forEach(({ target, type, fn, opts }) => {
          target.removeEventListener(type, fn, opts);
        });
        unlockBody();
        delete window['CPNB_open_' + SECTION_ID];
        delete window['CPNB_close_' + SECTION_ID];
        delete window['CPNB_reset_' + SECTION_ID];
        root.__cpnbInited = false;
      }
    };
  }

  // ----- Lifecycle ----------------------------------------------------------
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }

  // bfcache (back/forward cache restore) — re-evaluate the popup state
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      if (controller) controller.destroy();
      controller = null;
      init();
    }
  });

  // Storelib builder — re-init when this section is drawn again in place
  document.addEventListener('storelib:section-load', (e) => {
    if (e.detail && String(e.detail.sectionId) === SECTION_ID) {
      if (controller) controller.destroy();
      controller = null;
      init();
    }
  });

  // Shopify Theme Editor — re-init when this section is added/edited, tear down on removal
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail && e.detail.sectionId === SECTION_ID) {
        if (controller) controller.destroy();
        controller = null;
        init();
      }
    });
    document.addEventListener('shopify:section:unload', (e) => {
      if (e.detail && e.detail.sectionId === SECTION_ID && controller) {
        controller.destroy();
        controller = null;
      }
    });
  }
})();
{% comment %}{% endcomment %}</script>



