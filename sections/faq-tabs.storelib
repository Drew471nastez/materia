    "presets": [
      {
        "name": "FAQ Tabs",
        "category": "FAQ",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "faq_item",
            "settings": {
              "tab": "1",
              "question": "How do I place an order?",
              "answer": "<p>Add what you want to your cart and go to checkout. You get an email as soon as the order is placed.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "tab": "1",
              "question": "How do I contact you?",
              "answer": "<p>Use the contact page or reply to your order email and we will get back to you.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "tab": "2",
              "question": "When will my order ship?",
              "answer": "<p>Delivery options and times are shown at checkout. A tracking link follows by email once the order leaves.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "tab": "3",
              "question": "Can I return an item?",
              "answer": "<p>Yes. The returns page explains the steps and how long you have to send something back.</p>"
            }
          }
        ]
