  "presets": [
    {
      "name": "FAQ Tabs",
      "category": "FAQ",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Where is my order?",
            "answer": "<p>Sign in to your account → Orders to see real-time status. You'll also get a tracking link by email when it ships.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "How do I sign in?",
            "answer": "<p>Use the account icon in the header. New customers can create an account in under a minute.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Where can I find a store?",
            "answer": "<p>Use the store locator in the footer to find the nearest physical retailer.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How long does shipping take?",
            "answer": "<p>Standard: 3–5 business days. Faster options available at checkout.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Do you ship internationally?",
            "answer": "<p>We ship to 40+ countries. Rates and times vary by destination.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "What is your return policy?",
            "answer": "<p>Free returns within 30 days of delivery. Item must be unused.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I exchange an item?",
            "answer": "<p>Yes — start an exchange from your order page. We'll cover the return shipping.</p>"
          }
        }
      ]
    }
  ],
