<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. FAQ Tabs: heading and subheading blocks, a strip of tab
  pills and the questions of the chosen tab. The tabs are hidden radio
  inputs with :checked rules, so they switch with no script and from the
  keyboard (arrow keys). Each question block picks its tab. live-faq.js
  opens and closes the questions, opens the one picked in the builder (and
  its tab) and applies live edits to the --fqt-* variables on the root.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign own = st.enable_custom_style
  assign items = section.blocks | where: 'type', 'faq_item'
  assign tab_count = 0
  for i in (1..5)
    assign key = 'tab_' | append: i | append: '_label'
    if st[key] != blank
      assign tab_count = tab_count | plus: 1
    endif
  endfor
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
-%}
{%- capture fqt_vars -%}
--fqt-bg:{% if own %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--fqt-pt-m:{{ st.padding_top_mobile | default: 56 }}px;--fqt-pb-m:{{ st.padding_bottom_mobile | default: 56 }}px;--fqt-pt-d:{{ st.padding_top_desktop | default: 96 }}px;--fqt-pb-d:{{ st.padding_bottom_desktop | default: 96 }}px;
--fqt-w-m:{{ st.section_max_width_mobile | default: 560 }}px;--fqt-w-t:{{ st.section_max_width_tablet | default: 800 }}px;--fqt-w-d:{{ st.section_max_width_desktop | default: 920 }}px;
--fqt-align:{{ align }};--fqt-flex:{{ flex_align }};
--fqt-hgap-m:{{ st.heading_sub_gap_mobile | default: 12 }}px;--fqt-hgap-d:{{ st.heading_sub_gap_desktop | default: 16 }}px;--fqt-gap-tabs-m:{{ st.gap_subheading_tabs_mobile | default: 24 }}px;--fqt-gap-tabs-d:{{ st.gap_subheading_tabs | default: 32 }}px;--fqt-gap-list:{{ st.gap_tabs_list | default: 32 }}px;
--fqt-track:{% if own %}{% render 'scheme-color', color: st.tabs_track_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--fqt-shadow:{{ st.tabs_shadow | default: 'none' }};
--fqt-active-bg:{% if own %}{% render 'scheme-color', color: st.tab_active_bg, fallback: 'var(--btn-primary-bg-color)' %}{% else %}var(--btn-primary-bg-color){% endif %};--fqt-active:{% if own %}{% render 'scheme-color', color: st.tab_active_color, fallback: 'var(--btn-primary-color)' %}{% else %}var(--btn-primary-color){% endif %};--fqt-inactive:{% if own %}{% render 'scheme-color', color: st.tab_inactive_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--fqt-tab-w:{{ st.tab_weight | default: 600 }};--fqt-tab-s:{{ st.tab_size | default: 15 }}px;
--fqt-divider:{% if own %}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};--fqt-py:{{ st.item_padding_y | default: 22 }}px;--fqt-plus:{% if own %}{% render 'scheme-color', color: st.plus_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
--fqt-q-color:{% if own %}{% render 'scheme-color', color: st.q_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--fqt-q-w:{{ st.q_weight | default: 700 }};--fqt-q-s:{{ st.q_size | default: 18 }}px;
--fqt-a-color:{% if own %}{% render 'scheme-color', color: st.a_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--fqt-a-s:{{ st.a_size | default: 16 }}px;
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--fqt-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--fqt-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: 0; margin-bottom: 0; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :where(button) { font-family: inherit; }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }}, #shopify-section-{{ sid }} > section, #shopify-section-{{ sid }} > div { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section, .shopify-section + #shopify-section-{{ sid }} { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .fqt { background: var(--fqt-bg) !important; padding-top: var(--fqt-pt-m); padding-bottom: var(--fqt-pb-m); }
  #shopify-section-{{ sid }} .fqt[data-fqt-width="container"] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .fqt[data-fqt-width="fluid_container"] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .fqt__inner { max-width: var(--fqt-w-m); margin-inline: auto; padding-inline: 1.25rem; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fqt { padding-top: var(--fqt-pt-d); padding-bottom: var(--fqt-pb-d); }
    #shopify-section-{{ sid }} .fqt__inner { max-width: var(--fqt-w-t); padding-inline: 1.5rem; }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .fqt__inner { max-width: var(--fqt-w-d); }
  }

  #shopify-section-{{ sid }} .fqt__header { display: flex; flex-direction: column; align-items: var(--fqt-flex); text-align: var(--fqt-align); margin: 0 auto var(--fqt-gap-tabs-m); gap: var(--fqt-hgap-m); width: 100%; }
  #shopify-section-{{ sid }} .fqt__header:empty { display: none; }
  #shopify-section-{{ sid }} .fqt__header > [hidden] { display: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fqt__header { margin-bottom: var(--fqt-gap-tabs-d); gap: var(--fqt-hgap-d); }
  }
  #shopify-section-{{ sid }} .fqt__header > *, #shopify-section-{{ sid }} .fqt__header :is(h2, p) { margin-block: 0 !important; padding-block: 0 !important; }
  #shopify-section-{{ sid }} .fqt__heading {
    margin: 0 !important; padding: 0 !important;
    color: var(--fb-c, var(--color-heading)) !important;
    font-family: var(--fb-ff, var(--fqt-hf, var(--heading-font, inherit)));
    font-weight: var(--fb-fw, var(--heading-weight, 700));
    line-height: var(--fb-lh, 1.2);
    font-size: var(--fb-fs-m, 36px) !important;
  }
  #shopify-section-{{ sid }} .fqt__heading[data-own-size] { letter-spacing: var(--fb-ls, normal); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fqt__heading { font-size: var(--fb-fs-d, 56px) !important; }
  }
  #shopify-section-{{ sid }} .fqt__sub {
    margin: 0 !important; padding: 0 !important;
    color: var(--fb-c, var(--color-text)) !important;
    font-family: var(--fb-ff, var(--fqt-bf, inherit));
    font-size: var(--fb-fs, 16px);
    line-height: 1.55;
    max-width: var(--fb-mw, 540px);
  }
  #shopify-section-{{ sid }} .fqt__sub > * { margin: 0 !important; padding: 0 !important; }
  #shopify-section-{{ sid }} :is(.fqt__sub, .fqt__answer) :is(p, li, strong, em) { font-family: inherit; }

  /* Tab strip: hidden radios, a scroll viewport, a centred row and the pill. */
  #shopify-section-{{ sid }} .fqt__tab-radio { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  #shopify-section-{{ sid }} .fqt__tabs-wrap {
    position: relative; width: auto; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    margin: 0 -1.25rem var(--fqt-gap-list); padding: 4px 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fqt__tabs-wrap { margin-left: -1.5rem; margin-right: -1.5rem; padding-left: 1.5rem; padding-right: 1.5rem; }
  }
  #shopify-section-{{ sid }} .fqt__tabs-wrap::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .fqt__tabs-row { display: flex; justify-content: center; min-width: max-content; }
  #shopify-section-{{ sid }} .fqt__tabs { display: inline-flex; flex-wrap: nowrap; flex-shrink: 0; gap: 6px; background: var(--fqt-track); padding: 6px; border-radius: 999px; box-shadow: var(--fqt-shadow); }
  #shopify-section-{{ sid }} .fqt__tab {
    position: relative;
    cursor: pointer; user-select: none; padding: 10px 22px; border-radius: 999px;
    font-weight: var(--fqt-tab-w); font-size: var(--fqt-tab-s); color: var(--fqt-inactive);
    transition: background .25s ease, color .25s ease; white-space: nowrap;
  }
  /* a 44px tap target around each pill, without changing the pill */
  #shopify-section-{{ sid }} .fqt__tab::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 44px; transform: translateY(-50%); }
  @media (max-width: 600px) {
    #shopify-section-{{ sid }} .fqt__tab { padding: 8px 12px; font-size: calc(var(--fqt-tab-s) * .8); }
    #shopify-section-{{ sid }} .fqt__tabs { padding: 4px; gap: 4px; }
  }
  {%- for i in (1..5) %}
  #shopify-section-{{ sid }} .fqt__r--{{ i }}:checked ~ .fqt__shell .fqt__tab--{{ i }} { background: var(--fqt-active-bg); color: var(--fqt-active); }
  #shopify-section-{{ sid }} .fqt__r--{{ i }}:focus-visible ~ .fqt__shell .fqt__tab--{{ i }} { outline: 2px solid var(--fqt-active-bg); outline-offset: 2px; }
  #shopify-section-{{ sid }} .fqt__r--{{ i }}:checked ~ .fqt__shell .fqt__panel--{{ i }} { display: block; }
  {%- endfor %}
  #shopify-section-{{ sid }} .fqt__panel { display: none; }

  #shopify-section-{{ sid }} .fqt__list { display: flex; flex-direction: column; }
  #shopify-section-{{ sid }} .fqt__item { border-top: 1px solid var(--fqt-divider); padding: var(--fqt-py) 0; }
  #shopify-section-{{ sid }} .fqt__item:last-of-type { border-bottom: 1px solid var(--fqt-divider); }
  #shopify-section-{{ sid }} .fqt__summary {
    cursor: pointer; display: grid; grid-template-columns: 1fr 24px; align-items: center; gap: 16px;
    width: 100%; background: transparent; border: 0; text-align: start;
    padding: 10px 0; margin: -10px 0; /* a 44px tap target inside the question's own padding */
    font-family: var(--fqt-hf, inherit); font-weight: var(--fqt-q-w); font-size: var(--fqt-q-s); color: var(--fqt-q-color); line-height: 1.4;
  }
  #shopify-section-{{ sid }} .fqt__summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  #shopify-section-{{ sid }} .fqt__plus { width: 24px; height: 24px; position: relative; flex-shrink: 0; }
  #shopify-section-{{ sid }} .fqt__plus::before, #shopify-section-{{ sid }} .fqt__plus::after { content: ''; position: absolute; left: 50%; top: 50%; background: var(--fqt-plus); transform-origin: center; transition: transform .35s cubic-bezier(0.4, 0, 0.2, 1), opacity .25s ease; }
  #shopify-section-{{ sid }} .fqt__plus::before { width: 16px; height: 2px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .fqt__plus::after { width: 2px; height: 16px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .fqt__item[open] .fqt__plus::after { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
  /* Smooth open and close: the answer's row grows from 0fr to 1fr. */
  #shopify-section-{{ sid }} .fqt__answer-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .42s cubic-bezier(.4, 0, .2, 1); }
  #shopify-section-{{ sid }} .fqt__item[open] .fqt__answer-wrap { grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .fqt__answer-inner { overflow: hidden; min-height: 0; }
  #shopify-section-{{ sid }} .fqt__answer { margin: 0; padding-top: 14px; color: var(--fqt-a-color); font-family: var(--fqt-bf, inherit); font-size: var(--fqt-a-s); line-height: 1.6; max-width: 720px; }
  #shopify-section-{{ sid }} .fqt__answer > * { margin: 0; }
  #shopify-section-{{ sid }} .fqt__answer > * + * { margin-top: 8px; }
  #shopify-section-{{ sid }} .fqt__answer a { color: inherit; text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.fqt__answer-wrap, .fqt__tab), #shopify-section-{{ sid }} .fqt__plus::before, #shopify-section-{{ sid }} .fqt__plus::after { transition: none !important; }
  }

  #shopify-section-{{ sid }} .fqt[data-fqt-show="mobile"], #shopify-section-{{ sid }} .fqt[data-fqt-show="desktop"] { display: none; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .fqt[data-fqt-show="mobile"] { display: block; } }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .fqt[data-fqt-show="desktop"] { display: block; } }
{% comment %}{% endcomment %}</style>
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<section class="fqt color-{{ color_scheme }} gradient" id="fqt-{{ sid }}" data-faq-root="faq-tabs" data-faq-section="{{ section.id }}" data-faq-settings="{{ section.settings | json | escape }}" data-fqt-width="{{ st.section_width | default: 'full_width' }}" data-fqt-show="{{ st.show_section_on | default: 'all' }}" style="{{ fqt_vars | strip_newlines }}">
  <div class="fqt__inner" data-faq-list data-multiple="{% if st.allow_multiple_open %}true{% else %}false{% endif %}">
    <div class="fqt__header">
      {%- comment -%} data-own-font / data-own-weight / data-own-size keep a block's own font, weight and line height ahead of Theme settings > Typography priority. {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- assign w = bs.weight | default: 'theme' -%}
            {%- capture fb_vars -%}
              {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
              {%- if w != 'theme' -%}--fb-fw:{{ w }};{%- endif -%}
              --fb-fs-d:{{ bs.size_desktop | default: 56 }}px;--fb-fs-m:{{ bs.size_mobile | default: 36 }}px;
              {%- if bs.size_enable -%}--fb-lh:{{ bs.line_height | default: 1.2 }};--fb-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
            {%- endcapture -%}
            {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <h2 id="block-{{ block.id }}" class="fqt__heading" data-faq-block="{{ block.id }}" data-faq-type="heading" data-faq-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if w != 'theme' %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ fb_vars | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
          {%- when 'subheading' -%}
            {%- capture fb_vars -%}
              {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
              --fb-fs:{{ bs.size | default: 16 }}px;--fb-mw:{{ bs.max_width | default: 540 }}px;
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
            {%- endcapture -%}
            {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <div id="block-{{ block.id }}" class="fqt__sub" data-faq-block="{{ block.id }}" data-faq-type="subheading" data-faq-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ fb_vars | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if tab_count > 0 -%}
      {%- assign first_tab = 0 -%}
      {%- for i in (1..5) -%}
        {%- assign label_key = 'tab_' | append: i | append: '_label' -%}
        {%- if st[label_key] != blank -%}
          {%- if first_tab == 0 -%}{%- assign first_tab = i -%}{%- endif -%}
          <input class="fqt__tab-radio fqt__r--{{ i }}" type="radio" name="fqt-{{ sid }}" id="fqt-{{ sid }}-{{ i }}" value="{{ i }}" data-fqt-radio="{{ i }}"{% if i == first_tab %} checked{% endif %}>
        {%- endif -%}
      {%- endfor -%}
      <div class="fqt__shell">
        <div class="fqt__tabs-wrap">
          <div class="fqt__tabs-row">
            <div class="fqt__tabs">
              {%- for i in (1..5) -%}
                {%- assign label_key = 'tab_' | append: i | append: '_label' -%}
                {%- if st[label_key] != blank -%}
                  <label class="fqt__tab fqt__tab--{{ i }}" for="fqt-{{ sid }}-{{ i }}" data-fqt-label="{{ i }}">{{ st[label_key] | escape }}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
        {%- for i in (1..5) -%}
          {%- assign label_key = 'tab_' | append: i | append: '_label' -%}
          {%- if st[label_key] != blank -%}
            {%- assign tab_str = i | append: '' -%}
            {%- assign opened = false -%}
            <div class="fqt__panel fqt__panel--{{ i }}" data-fqt-panel="{{ i }}">
              <div class="fqt__list">
                {%- for item in items -%}
                  {%- if item.settings.tab == tab_str -%}
                    {%- assign is_open = false -%}
                    {%- if st.open_first and opened == false -%}{%- assign is_open = true -%}{%- assign opened = true -%}{%- endif -%}
                    {%- render 'faq-live-tab-item', item: item, sid: sid, is_open: is_open, sec_font: sec_font -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="fqt__list">
        {%- for item in items -%}
          {%- assign is_open = false -%}
          {%- if st.open_first and forloop.first -%}{%- assign is_open = true -%}{%- endif -%}
          {%- render 'faq-live-tab-item', item: item, sid: sid, is_open: is_open, sec_font: sec_font -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if st.structured_data -%}{% render 'faq-live-jsonld', items: items %}{%- endif -%}
</section>
</template>

<schema>
{
  "type": "faq-tabs",
  "name": "FAQ Tabs",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "default": "all",
      "options": [
