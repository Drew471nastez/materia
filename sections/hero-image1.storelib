<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_hero_background = 'accessibility.hero_background' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Hero Image 1 (block-based)

  Full-bleed hero with a background image / video and centered content.
  Every text/badge/button is a block — fully reorderable.

  Blocks:
    - eyebrow         (small text above heading)
    - heading         (main title)
    - subheading      (supporting paragraph)
    - primary_button  (CTA — supports full-width toggle)
    - secondary_button
    - badge           (pill / chip above heading)

  Section settings: section_width, alignment, image, video URL,
  overlay, padding, margin, reset_spacing, section_bg.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign content_align = st.content_align | default: 'center'
  assign vert_align = st.vertical_align | default: 'center'
-%}

<style>
  /* Custom fonts (toggle in section settings; off by default) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }

  /* Section margins + reset spacing */
  #shopify-section-{{ sid }} {
    {%- if st.section_bg != blank and st.section_bg.alpha != 0 %}
    background-color: {{ st.section_bg }};
    {%- endif %}
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    .shopify-section:has(+ #shopify-section-{{ sid }}) {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }
  {%- endif -%}

  #shopify-section-{{ sid }} .hi1 {
    position: relative;
    overflow: hidden;
    border-radius: {{ st.card_radius | default: 0 }}px;
    min-height: {{ st.min_height_mobile | default: 480 }}px;
    padding: {{ st.padding_top_mobile | default: 80 }}px {{ st.side_padding_mobile | default: 24 }}px {{ st.padding_bottom_mobile | default: 80 }}px;
    display: flex;
    align-items:
      {%- if vert_align == 'top' -%} flex-start
      {%- elsif vert_align == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    justify-content:
      {%- if content_align == 'left' -%} flex-start
      {%- elsif content_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .hi1 {
      min-height: {{ st.min_height_desktop | default: 640 }}px;
      padding: {{ st.padding_top_desktop | default: 120 }}px {{ st.side_padding_desktop | default: 48 }}px {{ st.padding_bottom_desktop | default: 120 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .hi1 { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .hi1 { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  {%- endcase -%}

  /* Background image / video */
  #shopify-section-{{ sid }} .hi1__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ sid }} .hi1__bg img,
  #shopify-section-{{ sid }} .hi1__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ st.image_position_x | default: 50 }}% {{ st.image_position_y | default: 50 }}%;
    display: block;
  }

  /* Overlay tint */
  {%- if st.enable_overlay -%}
    #shopify-section-{{ sid }} .hi1__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {{ st.overlay_color | default: '#000000' }};
      opacity: {{ st.overlay_opacity | default: 30 | divided_by: 100.0 }};
      pointer-events: none;
    }
  {%- endif -%}

  /* Content stack */
  #shopify-section-{{ sid }} .hi1__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ st.content_max_width | default: 720 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if content_align == 'left' -%} flex-start
      {%- elsif content_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    text-align: {{ content_align }};
    gap: {{ st.content_gap | default: 16 }}px;
  }

  /* Block — eyebrow */
  #shopify-section-{{ sid }} .hi1__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.3;
  }

  /* Block — badge */
  #shopify-section-{{ sid }} .hi1__badge {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Block — heading */
  #shopify-section-{{ sid }} .hi1__heading {
    margin: 0;
    line-height: 1.05;
    font-weight: var(--heading-weight, 700);
  }

  /* Block — subheading */
  #shopify-section-{{ sid }} .hi1__subheading {
    margin: 0;
    line-height: 1.5;
    max-width: 520px;
  }
  #shopify-section-{{ sid }} .hi1__subheading p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .hi1__subheading p:last-child { margin: 0; }

  /* Buttons row */
  #shopify-section-{{ sid }} .hi1__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: {{ st.buttons_margin_top | default: 8 }}px;
    {%- if content_align == 'center' -%}justify-content: center;{%- endif -%}
    {%- if content_align == 'right' -%}justify-content: flex-end;{%- endif -%}
  }
  #shopify-section-{{ sid }} .hi1__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    /* Theme settings → Buttons */
    padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
    border-radius: var(--btn-radius, 999px);
    font-size: var(--btn-font-size, 14px);
    font-weight: var(--btn-font-weight, 600);
    letter-spacing: var(--btn-letter-spacing, 0px);
    text-transform: var(--btn-text-transform, none);
    border: var(--btn-border-width, 1px) solid transparent;
    transition: transform .15s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  #shopify-section-{{ sid }} .hi1__btn:hover {
    transform: translateY(-1px);
  }

  /* Per-block button hover colors (rendered inline below per block) */
  {%- for block in section.blocks -%}
    {%- if block.type == 'primary_button' or block.type == 'secondary_button' -%}
      #shopify-section-{{ sid }} .hi1__btn[data-btn-id="{{ block.id }}"]:hover,
      #shopify-section-{{ sid }} .hi1__btn[data-btn-id="{{ block.id }}"]:focus-visible {
        {%- if block.type == 'primary_button' -%}
          {%- assign hi1_hbg = 'var(--btn-primary-hover-bg-color)' -%}
          {%- assign hi1_htx = 'var(--btn-primary-hover-color)' -%}
          {%- assign hi1_hbd = 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))' -%}
        {%- else -%}
          {%- assign hi1_hbg = '#FFFFFF' -%}
          {%- assign hi1_htx = '#0F172A' -%}
          {%- assign hi1_hbd = '#FFFFFF' -%}
        {%- endif -%}
        background-color: {% render 'scheme-color', color: block.settings.bg_hover, fallback: hi1_hbg %} !important;
        color:            {% render 'scheme-color', color: block.settings.text_color_hover, fallback: hi1_htx %} !important;
        border-color:     {% render 'scheme-color', color: block.settings.border_color_hover, fallback: hi1_hbd %} !important;
      }
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="hi1-{{ sid }}" class="hi1 section sec__hero-image-1 color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="hi1__bg">
    {%- if st.video_url != blank -%}
      <video src="{{ st.video_url }}" autoplay muted loop playsinline></video>
    {%- elsif st.image != blank -%}
      <img
        src="{{ st.image | image_url: width: 1920 }}"
        srcset="{{ st.image | image_url: width: 800 }} 800w,
                {{ st.image | image_url: width: 1200 }} 1200w,
                {{ st.image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ st.image.alt | default: fb_accessibility_hero_background | escape }}"
        width="{{ st.image.width }}"
        height="{{ st.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="eager">
    {%- endif -%}
  </div>

  <div class="hi1__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'badge' -%}
          {%- if block.settings.text != blank -%}
            <span
              class="hi1__badge"
              style="background-color: {% render 'scheme-color', color: block.settings.bg, fallback: 'var(--color-background)' %}; color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %};"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
              {{ block.settings.text | escape }}
            </span>
          {%- endif -%}

        {%- when 'eyebrow' -%}
          {%- if block.settings.text != blank -%}
            <p
              class="hi1__eyebrow"
              style="color: {% render 'scheme-color', color: block.settings.color, fallback: '#FFFFFF' %};"
              {{ block.shopify_attributes }}
            >{{ block.settings.text | escape }}</p>
          {%- endif -%}

        {%- when 'heading' -%}
          {%- if block.settings.text != blank -%}
            <{{ block.settings.tag | default: 'h1' }}
              class="hi1__heading"
              data-block-id="{{ block.id }}"
              style="font-size: {{ block.settings.size_mobile | default: 36 }}px; color: {% render 'scheme-color', color: block.settings.color, fallback: '#FFFFFF' %};"
              {{ block.shopify_attributes }}
            >{{ block.settings.text }}</{{ block.settings.tag | default: 'h1' }}>
            <style>
              @media (min-width: 768px) {
                #shopify-section-{{ sid }} .hi1__heading[data-block-id="{{ block.id }}"] {
                  font-size: {{ block.settings.size_desktop | default: 64 }}px !important;
                }
              }
{% comment %}{% endcomment %}            </style>
          {%- endif -%}

        {%- when 'subheading' -%}
          {%- if block.settings.text != blank -%}
            <div
              class="hi1__subheading"
              style="font-size: {{ block.settings.size | default: 16 }}px; color: {% render 'scheme-color', color: block.settings.color, fallback: '#FFFFFF' %};"
              {{ block.shopify_attributes }}
            >{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'primary_button' -%}
          {%- if block.settings.label != blank -%}
            {%- assign p_full = block.settings.full_width -%}
            <a
              class="hi1__btn"
              data-btn-id="{{ block.id }}"
              href="{{ block.settings.link | default: '#' }}"
              style="
                background-color: {% render 'scheme-color', color: block.settings.bg, fallback: 'var(--btn-primary-bg-color)' %};
                color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--btn-primary-color)' %};
                border-color: {% render 'scheme-color', color: block.settings.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
                {%- if p_full -%}display: flex; width: 100%; max-width: 100%;{%- else -%}display: inline-flex; width: auto; max-width: max-content;{%- endif -%}
              "
              {{ block.shopify_attributes }}
            >{{ block.settings.label | escape }}</a>
          {%- endif -%}

        {%- when 'secondary_button' -%}
          {%- if block.settings.label != blank -%}
            {%- assign s_full = block.settings.full_width -%}
            <a
              class="hi1__btn"
              data-btn-id="{{ block.id }}"
              href="{{ block.settings.link | default: '#' }}"
              style="
                background-color: {% render 'scheme-color', color: block.settings.bg, fallback: 'transparent' %};
                color: {% render 'scheme-color', color: block.settings.text_color, fallback: '#FFFFFF' %};
                border-color: {% render 'scheme-color', color: block.settings.border_color, fallback: '#FFFFFF' %};
                {%- if s_full -%}display: flex; width: 100%; max-width: 100%;{%- else -%}display: inline-flex; width: auto; max-width: max-content;{%- endif -%}
              "
              {{ block.shopify_attributes }}
            >{{ block.settings.label | escape }}</a>
          {%- endif -%}

        {%- when 'benefits_stack' -%}
          {%- render 'benefits-stack', block: block -%}
        {%- when 'happy_customers' -%}
          {%- render 'happy-customers', block: block -%}
        {%- when 'simple_rating' -%}
          {%- render 'simple-rating', block: block -%}
        {%- when 'lod_rating_badge' -%}
          {%- render 'lod-rating-badge', block: block -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>



</template>

<schema>
{
  "type": "hero-image1",
  "name": "Hero Image 1",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment (horizontal)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content alignment (vertical)",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Min height (desktop)",
      "min": 240,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min height (mobile)",
      "min": 240,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max-width",
      "min": 320,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap (between blocks)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Background media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Background video URL",
      "info": "Optional .mp4 URL — auto-plays muted in place of the image."
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable colour overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "buttons_margin_top",
      "label": "Buttons row top margin",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
