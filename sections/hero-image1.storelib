        "type": "badge",
        "name": "Badge",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "NEW"
          },
          {
            "type": "text",
            "id": "icon",
            "label": "Icon (emoji or symbol)",
            "default": "✨"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_source",
            "label": "Font",
            "options": [
              {
                "value": "heading",
                "label": "Heading font"
              },
              {
                "value": "body",
                "label": "Body font"
              }
            ],
            "default": "body",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra bold"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "text_case",
            "label": "Text case",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "none",
                "label": "Original"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              },
              {
                "value": "lowercase",
                "label": "Lowercase"
              },
              {
                "value": "capitalize",
                "label": "Capitalize"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "letter_spacing",
            "label": "Letter spacing",
            "min": -2,
            "max": 8,
            "step": 0.1,
            "default": 0,
            "unit": "px",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.8,
            "max": 2.4,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Font size (desktop)",
            "min": 10,
            "max": 48,
            "step": 1,
            "default": 16,
            "unit": "px",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Font size (mobile)",
