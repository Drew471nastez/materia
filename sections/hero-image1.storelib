          {
            "value": "contain",
            "label": "Contain"
          }
        ],
        "default": "cover"
      },
      {
        "type": "range",
        "id": "image_position_x",
        "label": "Image horizontal focus",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "image_position_y",
        "label": "Image vertical focus",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "enable_overlay",
        "label": "Enable colour overlay",
        "default": true
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Overlay colour",
