<template compat="shopify">
{% render 'theme-type' %}
{{ 'hero-image-one.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script>
{%- assign c = section.settings -%}
{%- assign scheme = c.color_scheme.id | default: c.color_scheme | default: 'default-color-scheme' -%}
{%- if c.enable_custom_fonts -%}<style>{% if c.heading_font.family %}{{ c.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if c.body_font.family %}{{ c.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{%- endif -%}
<section id="hi1-{{ section.id }}" class="hi1-shell color-{{ scheme }}" data-hero-image-one="{{ section.id }}" data-hi1-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-hi1-button-font="{{ settings.button_font | default: 'body_font' }}" data-hi1-settings="{{ c | json | escape }}" data-hi1-motion="{{ settings.scroll_animation | default: 'none' }}" data-hi1-duration="{{ settings.animation_duration | default: 700 }}" data-hi1-delay="{{ settings.animation_delay | default: 0 }}" style="{% render 'hero-image-one-vars', controls: c, kind: 'section' %}">
  <div class="hi1"><div class="hi1__bg"{% if c.image == blank and c.video_url == blank and c.image_mobile == blank %} hidden{% endif %}>
    <picture{% if c.video_url != blank %} hidden{% endif %}>{% if c.image_mobile != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: c.image_mobile, escaped: true %}">{% endif %}<img{% if c.image != blank %} src="{% render 'offer-image-url', image: c.image, escaped: true %}"{% elsif c.image_mobile != blank %} src="{% render 'offer-image-url', image: c.image_mobile, escaped: true %}"{% endif %} alt="{{ c.image_alt | default: c.image.alt | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async"></picture>
    <video{% if c.video_url != blank %} src="{{ c.video_url | url | escape }}"{% else %} hidden{% endif %} muted playsinline{% unless c.video_autoplay == false %} autoplay{% endunless %}{% unless c.video_loop == false %} loop{% endunless %}{% if c.video_controls %} controls{% endif %}></video>
    <span class="hi1__overlay" aria-hidden="true"{% if c.enable_overlay == false %} hidden{% endif %}></span>
  </div><div class="hi1__content">
  {% for block in section.blocks %}{% unless block.hidden %}<div class="hi1__block" data-hi1-block="{{ block.id }}" data-hi1-kind="{{ block.type }}" data-hi1-block-settings="{{ block.settings | json | escape }}" style="{% render 'hero-image-one-vars', controls: block.settings, kind: block.type %}" {{ block.shopify_attributes }}>{% render 'hero-image-one-block', block: block %}</div>{% endunless %}{% endfor %}
  </div></div>
  {% assign icon_names = 'badge_check,check_circle,check,shield_check,star,heart,leaf,lock,truck,package,credit_card,refresh,globe,tag,gift,thumbs_up,award,clock,phone,none' | split: ',' %}{% for icon in icon_names %}<template data-hi1-icon="{{ icon }}">{% render 'guarantee-icon', icon: icon, stroke: 1.8 %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "hero-image1",
  "name": "Hero Image 1",
  "settings": [
