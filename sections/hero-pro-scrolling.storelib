<template compat="shopify">
{% render 'theme-type' %}
{{ 'hero-image-one.css' | asset_url | stylesheet_tag }}
{{ 'hero-pro-scrolling.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script>
<script src="{{ 'hero-pro-scrolling.js' | asset_url }}" defer></script>
{%- assign c = section.settings -%}
{%- assign scheme = c.color_scheme.id | default: c.color_scheme | default: 'default-color-scheme' -%}
{%- assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' -%}
{%- if c.enable_custom_fonts -%}<style>{% if c.heading_font.family %}{{ c.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if c.body_font.family %}{{ c.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{%- endif -%}
<section id="hps-{{ section.id }}" class="hi1-shell hps-shell color-{{ scheme }}" data-hero-scrolling="{{ section.id }}" data-hero-image-one="{{ section.id }}" data-hi1-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-hi1-button-font="{{ settings.button_font | default: 'body_font' }}" data-hi1-block-defaults='{"eyebrow":{"text":"New season","enable_custom_style":false,"size_desktop":13,"size_mobile":12,"letter_spacing":24,"font_source":"body","font_weight":"theme","text_case":"theme","line_height":1.5},"heading":{"text":"Headline goes here","enable_custom_style":false,"size_desktop":64,"size_mobile":36,"line_height":105,"font_weight":"inherit","accent_italic":false,"font_source":"heading","text_case":"theme","letter_spacing":0,"tag":"h2"},"subheading":{"text":"<p>Add a short supporting line of copy beneath your headline.</p>","enable_custom_style":false,"size_desktop":16,"size_mobile":15,"line_height":150,"enable_custom_weight":false,"font_weight":"400","font_source":"body","text_case":"theme","letter_spacing":0},"primary_button":{"label":"Shop now","enable_custom_style":false,"use_theme_button":true,"padding_x":26,"padding_y":14,"radius":100,"border_width":1,"font_size":14,"letter_spacing":4,"font_weight":"600","uppercase":false,"full_width":false},"benefits_stack":{"text_1":"Pore minimizing","text_2":"Instant glass skin","text_3":"Reduces sagging","text_4":"Improves skin","icon_1":"badge_check","icon_2":"badge_check","icon_3":"badge_check","icon_4":"badge_check","icon_5":"badge_check","icon_6":"badge_check","enable_custom_style":false,"font_size_desktop":14,"font_size_mobile":13,"font_weight":"500","padding_top":8,"padding_bottom":8,"columns":"2","gap_x":16,"gap_y":10,"icon_size":20},"happy_customers":{"show_avatars":true,"show_stars":true,"show_rating_text":false,"heading":"100K+ Happy Customers","rating_text":"4.7","total_stars":5,"filled_stars":5,"enable_custom_style":false,"font_weight":"600","font_size_desktop":16,"font_size_mobile":14,"filled_color":"#22c55e","unfilled_color":"#e5e7eb","padding_top":12,"padding_bottom":12,"avatar_count":4,"avatar_size":40,"avatar_overlap":35,"star_size":14},"simple_rating":{"text":"4.9 / 5","total_stars":5,"filled_stars":5,"enable_custom_style":false,"font_size_desktop":16,"font_size_mobile":14,"font_weight":"500","filled_color":"#fbbf24","unfilled_color":"#e5e7eb","padding_top":8,"padding_bottom":8,"alignment":"left","star_size":18},"lod_rating_badge":{"enable_link":false,"label_text":"Excellent 4.7 / 5","rating":4,"enable_custom_style":false,"font_weight":"600","text_size":16,"stars_color":"#36A45C","star_icon_color":"#FFFFFF","star_radius":0,"star_tile_size_m":16,"star_tile_size_d":16,"star_icon_scale_m":100,"star_icon_scale_d":100,"section_mt_d":8,"section_mb_d":8,"section_pl_d":0,"section_pr_d":0,"section_mt_m":6,"section_mb_m":6,"section_pl_m":0,"section_pr_m":0}}' data-hi1-defaults='{"section_width":"full_width","color_scheme":"default-color-scheme","reset_spacing":true,"enable_custom_style":false,"card_radius":0,"overlay_color":"#000000","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","content_align":"center","vertical_align":"center","content_gap":14,"content_max_width":720,"use_background_color":false,"aria_label":"Scrolling hero gallery","enable_scrolling":true,"direction":"left","speed_desktop":60,"pane_width_desktop":70,"image_gap":0,"fade_edges":false,"enable_overlay":true,"overlay_opacity":30,"animation":"theme","pause_on_hover":false,"show_motion_control":true,"pause_label":"Pause gallery","resume_label":"Play gallery","hero_height_desktop":680,"content_padding_desktop":64,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"hero_height_mobile":520,"pane_width_mobile":100,"speed_mobile":40,"content_padding_mobile":32,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-hi1-settings="{{ c | json | escape }}" data-hi1-motion="{{ settings.scroll_animation | default: 'none' }}" data-hi1-duration="{{ settings.animation_duration | default: 700 }}" data-hi1-delay="{{ settings.animation_delay | default: 0 }}" style="{% render 'hero-image-one-vars', controls: c, kind: 'section' %}--hi1-height-m:{{ c.hero_height_mobile | default: 520 }}px;--hi1-height-d:{{ c.hero_height_desktop | default: 680 }}px;--hi1-pt-m:{{ c.content_padding_mobile | default: 32 }}px;--hi1-pb-m:{{ c.content_padding_mobile | default: 32 }}px;--hi1-px-m:{{ c.content_padding_mobile | default: 32 }}px;--hi1-pt-d:{{ c.content_padding_desktop | default: 64 }}px;--hi1-pb-d:{{ c.content_padding_desktop | default: 64 }}px;--hi1-px-d:{{ c.content_padding_desktop | default: 64 }}px;--hi1-buttons-mt:0px;">
 <div class="hi1">
  <div class="hps-marquee" role="region" aria-label="{{ c.aria_label | default: 'Scrolling hero gallery' | escape }}"{% if c.use_background_color %} hidden{% endif %}>
   <div class="hps-track"><div class="hps-group" data-hps-originals>
    {% assign images = section.blocks | where: 'type', 'image' %}
    {% for block in images %}{% unless block.hidden %}{% render 'hero-scrolling-image', block: block, placeholder: placeholder, first: forloop.first %}{% endunless %}{% endfor %}
    {% if images.size == 0 %}{% for n in (1..4) %}<div class="hps-pane" data-hps-fallback aria-hidden="true"><picture><img data-hps-empty="true" src="{{ placeholder | escape }}" alt="" width="1600" height="1200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async"></picture></div>{% endfor %}{% endif %}
   </div></div>
  </div>
  <span class="hi1__overlay hps-overlay" aria-hidden="true"{% if c.enable_overlay == false or c.use_background_color %} hidden{% endif %}></span>
  <div class="hi1__content">
   {% for block in section.blocks %}{% unless block.hidden or block.type == 'image' %}{% assign kind = block.type %}{% if kind == 'button' %}{% assign kind = 'primary_button' %}{% endif %}<div class="hi1__block" data-hi1-block="{{ block.id }}" data-hi1-kind="{{ kind }}" data-hi1-block-settings="{{ block.settings | json | escape }}" style="{% render 'hero-image-one-vars', controls: block.settings, kind: kind %}" {{ block.shopify_attributes }}>{% render 'hero-image-one-block', block: block, kind: kind %}</div>{% endunless %}{% endfor %}
  </div>
  <button type="button" class="hps-motion" data-hps-motion aria-pressed="false"{% if c.show_motion_control == false or c.use_background_color %} hidden{% endif %}>{{ c.pause_label | default: 'Pause gallery' | escape }}</button>
 </div>
 {% assign icons = 'badge_check,check_circle,check,shield_check,star,heart,leaf,lock,truck,package,credit_card,refresh,globe,tag,gift,thumbs_up,award,clock,phone,none' | split: ',' %}{% for icon in icons %}<template data-hi1-icon="{{ icon }}">{% render 'guarantee-icon', icon: icon, stroke: 1.8 %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "hero-pro-scrolling",
  "name": "Hero Pro Scrolling",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Horizontal alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max-width",
      "min": 320,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "checkbox",
      "id": "use_background_color",
      "label": "Use background color",
      "default": false,
      "info": "Hide background images and video. Uses the color scheme, or your custom section background when custom styling is enabled."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Screen-reader label",
      "default": "Scrolling hero gallery"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Scrolling Gallery"
    },
    {
      "type": "checkbox",
      "id": "enable_scrolling",
      "label": "Enable automatic scrolling",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left  ←"
        },
        {
          "value": "right",
          "label": "Right →"
        }
      ]
    },
    {
      "type": "range",
      "id": "speed_desktop",
      "label": "Speed — desktop (loop seconds)",
      "min": 20,
      "max": 240,
      "step": 5,
      "unit": "s",
      "default": 60
    },
    {
      "type": "range",
      "id": "pane_width_desktop",
      "label": "Pane width — desktop",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vw",
      "default": 70
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Image gap",
      "default": 0,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Soft edge fade (mask)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable colour overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Animation & Behavior"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "default": "theme",
      "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_motion_control",
      "label": "Show pause control",
      "default": true
    },
    {
      "type": "text",
      "id": "pause_label",
      "label": "Pause label",
      "default": "Pause gallery"
    },
    {
      "type": "text",
      "id": "resume_label",
      "label": "Resume label",
      "default": "Play gallery"
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "label": "Hero height (desktop)",
      "min": 320,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "content_padding_desktop",
      "label": "Content padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Hero height (mobile)",
      "min": 240,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "pane_width_mobile",
      "label": "Pane width — mobile",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vw",
      "default": 100
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "label": "Speed — mobile (loop seconds)",
      "info": "Lower = faster.",
      "min": 15,
      "max": 180,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Content padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Hero image",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Image Layout"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "default": "cover",
          "options": [
            {
              "value": "cover",
              "label": "Cover"
            },
            {
              "value": "contain",
              "label": "Contain"
            }
          ]
        },
        {
          "type": "range",
          "id": "image_position_x",
          "label": "Horizontal focus",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_position_y",
          "label": "Vertical focus",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "id": "hdr_9",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "background",
          "label": "Image background",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Corner radius",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow (small caps)",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New season"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 10,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 13,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 9,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing (×10)",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 24,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_source",
          "label": "Font",
          "options": [
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            }
          ],
          "default": "body",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ],
          "default": "theme",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "text_case",
          "label": "Text case",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "none",
              "label": "Original"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "theme",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.8,
          "max": 2.4,
          "step": 0.1,
          "default": 1.5,
