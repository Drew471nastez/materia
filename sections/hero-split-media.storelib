<template compat="shopify">
<script src="{{ 'live-r7-hero.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Hero Split: the text (eyebrow, heading, text and up to two
  buttons, all blocks) in one half and one picture or video filling the other
  half edge to edge (inside the page width the media takes the theme's
  corner radius). The side is a setting; on phones the two stack, media
  first or last. The top and bottom padding belong to the text half, so the
  media always reaches the edges. Styles for the text come from
  snippets/r7-hero-style, the blocks from snippets/r7-hero-text, and
  shopify/assets/live-r7-hero.js paints live edits and plays the video only
  while it is on screen.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id

  comment
    The heading is the page's h1 when this section opens the page (or when the
    page does not say where the section is, as the other heroes do), else h2.
  endcomment
  assign r7_tag = 'h2'
  assign r7_eager = true
  if section.index == blank
    assign r7_tag = 'h1'
  elsif section.index == 1
    assign r7_tag = 'h1'
  elsif section.index > 2
    assign r7_eager = false
  endif

  assign r7_ph = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.4%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'

  assign r7_video = st.video.sources | first
  for source in st.video.sources
    if source.mime_type == 'video/mp4' or source.format == 'mp4'
      assign r7_video = source
      break
    endif
  endfor
  assign r7_video_src = r7_video.url | default: st.video.url | default: st.video.src
  if r7_video_src == blank and st.video != blank and st.video.sources == blank
    assign r7_video_src = st.video
  endif
  assign r7_video_src = r7_video_src | default: st.video_url

  assign r7_side = 'right'
  if st.image_position == 'left'
    assign r7_side = 'left'
  endif
  assign r7_align = 'left'
  assign r7_items = 'flex-start'
  if st.content_align == 'center'
    assign r7_align = 'center'
    assign r7_items = 'center'
  elsif st.content_align == 'right'
    assign r7_align = 'right'
    assign r7_items = 'flex-end'
  endif
  assign r7_valign = 'center'
  if st.vertical_align == 'top'
    assign r7_valign = 'flex-start'
  elsif st.vertical_align == 'bottom'
    assign r7_valign = 'flex-end'
  endif

  assign r7_hf = ''
  assign r7_bf = ''
  if st.enable_custom_fonts and st.heading_font.family
    assign r7_fallback = st.heading_font.fallback_families | default: 'sans-serif'
    assign r7_hf = st.heading_font.family | append: ', ' | append: r7_fallback
  endif
  if st.enable_custom_fonts and st.body_font.family
    assign r7_fallback = st.body_font.fallback_families | default: 'sans-serif'
    assign r7_bf = st.body_font.family | append: ', ' | append: r7_fallback
  endif
-%}
{%- if st.enable_custom_fonts -%}<style>{% if st.heading_font.family %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if st.body_font.family %}{{ st.body_font | font_face: font_display: 'swap' }}{% endif %}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- render 'r7-hero-style', section: section -%}
<style>
  #shopify-section-{{ sid }} .hsm__grid{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(var(--hsm-media-h-m,320px),1fr)}
  #shopify-section-{{ sid }} .hsm[data-full] .hsm__grid{min-height:calc(var(--sl-vh,1svh)*100)}
  #shopify-section-{{ sid }} .hsm__media{position:relative;min-width:0;min-height:0;overflow:hidden;border-radius:var(--hsm-radius,0px);background:color-mix(in srgb,var(--color-heading) 7%,var(--color-background))}
  #shopify-section-{{ sid }} .hsm__frame:is(.container,.fluid_container) .hsm__media{border-radius:var(--hsm-radius,var(--rounded-radius,0px))}
  #shopify-section-{{ sid }} .hsm__media :is(.hsm__img,.hsm__video){position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:var(--hsm-fx,50%) var(--hsm-fy,50%);display:block}
  #shopify-section-{{ sid }} .hsm__media .hsm__img[data-r7h-empty]{object-fit:none;object-position:50% 50%}
  #shopify-section-{{ sid }} .hsm__media [hidden]{display:none}
  #shopify-section-{{ sid }} .hsm__toggle{position:absolute;inset-block-end:12px;inset-inline-end:12px;z-index:1;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border:1px solid var(--color-border);border-radius:var(--btn-radius,0px);background:var(--color-background);color:var(--color-heading);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:opacity .2s ease}
  #shopify-section-{{ sid }} .hsm__toggle:active{opacity:.7}
  #shopify-section-{{ sid }} .hsm__toggle:focus-visible{outline:2px solid var(--color-heading);outline-offset:2px}
  #shopify-section-{{ sid }} .hsm__toggle svg{width:16px;height:16px;fill:currentColor}
  #shopify-section-{{ sid }} .hsm__toggle[aria-pressed="true"] .hsm__icon-play,#shopify-section-{{ sid }} .hsm__toggle[aria-pressed="false"] .hsm__icon-pause{display:none}
  #shopify-section-{{ sid }} .hsm__content{display:flex;flex-direction:column;align-items:var(--r7h-items,flex-start);justify-content:center;min-width:0;padding:calc(var(--r7h-pt-m,40px)*var(--sl-space-scale,1)) var(--r7h-px-m,24px) calc(var(--r7h-pb-m,40px)*var(--sl-space-scale,1))}
  #shopify-section-{{ sid }} .hsm[data-empty-text] .hsm__content{display:none}
  @media (max-width:767px){
    #shopify-section-{{ sid }} .hsm__media{order:2}
    #shopify-section-{{ sid }} .hsm[data-media-first] .hsm__grid{grid-template-rows:minmax(var(--hsm-media-h-m,320px),1fr) auto}
    #shopify-section-{{ sid }} .hsm[data-media-first] .hsm__media{order:0}
    #shopify-section-{{ sid }} .hsm[data-empty-text] .hsm__grid{grid-template-rows:minmax(var(--hsm-media-h-m,320px),1fr)}
  }
  @media (min-width:768px){
    #shopify-section-{{ sid }} .hsm__grid{grid-template-columns:minmax(0,1fr) minmax(0,var(--hsm-media,50%));grid-template-rows:minmax(0,1fr);min-height:var(--hsm-min-d,560px)}
    #shopify-section-{{ sid }} .hsm__media{order:2}
    #shopify-section-{{ sid }} .hsm[data-side="left"] .hsm__grid{grid-template-columns:minmax(0,var(--hsm-media,50%)) minmax(0,1fr)}
    #shopify-section-{{ sid }} .hsm[data-side="left"] .hsm__media{order:0}
    #shopify-section-{{ sid }} .hsm[data-empty-text] .hsm__grid{grid-template-columns:minmax(0,1fr)}
    #shopify-section-{{ sid }} .hsm__content{justify-content:var(--hsm-valign,center);padding:calc(var(--r7h-pt-d,80px)*var(--sl-space-scale,1)) var(--r7h-px-d,64px) calc(var(--r7h-pb-d,80px)*var(--sl-space-scale,1))}
  }
  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ sid }} .hsm__toggle{transition:none}
  }
{% comment %}{% endcomment %}</style>
{%- assign r7_text_blocks = 0 -%}
{%- for block in section.blocks -%}{%- unless block.hidden or block.type == 'image' -%}{%- assign r7_text_blocks = r7_text_blocks | plus: 1 -%}{%- endunless -%}{%- endfor -%}
<div class="r7h hsm color-{{ color_scheme }}" data-r7h="split" data-r7h-section="{{ sid }}"{% if request.design_mode %} data-r7h-settings="{{ st | json | escape }}"{% endif %} data-r7h-placeholder="{{ r7_ph | escape }}" data-side="{{ r7_side }}"{% if st.full_height %} data-full{% endif %}{% if st.mobile_image_first %} data-media-first{% endif %}{% if st.reset_spacing %} data-reset-spacing{% endif %}{% if r7_hf != '' or r7_bf != '' %} data-own-font{% endif %}{% if r7_text_blocks == 0 and request.design_mode != true %} data-empty-text{% endif %} style="--r7h-gap:{{ st.content_gap | default: 16 }}px;--r7h-max:{{ st.content_max_width | default: 520 }}px;--r7h-align:{{ r7_align }};--r7h-items:{{ r7_items }};--r7h-pt-d:{{ st.padding_top_desktop | default: 0 }}px;--r7h-pb-d:{{ st.padding_bottom_desktop | default: 0 }}px;--r7h-px-d:{{ st.side_padding_desktop | default: 0 }}px;--r7h-pt-m:{{ st.padding_top_mobile | default: 0 }}px;--r7h-pb-m:{{ st.padding_bottom_mobile | default: 0 }}px;--r7h-px-m:{{ st.side_padding_mobile | default: 0 }}px;--hsm-media:{{ st.media_width_desktop | default: 50 }}%;--hsm-min-d:{{ st.min_height_desktop | default: 560 }}px;--hsm-media-h-m:{{ st.media_height_mobile | default: 320 }}px;--hsm-valign:{{ r7_valign }};--hsm-fx:{{ st.image_position_x | default: 0 }}%;--hsm-fy:{{ st.image_position_y | default: 0 }}%;{% if st.enable_custom_style %}--r7h-bg:{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};--hsm-radius:{{ st.image_radius | default: 0 }}px;{% endif %}{% if r7_hf != '' %}--r7h-hf:{{ r7_hf | escape }};{% endif %}{% if r7_bf != '' %}--r7h-bf:{{ r7_bf | escape }};{% endif %}">
  <div class="hsm__frame {{ st.section_width | default: 'full_width' }}" data-r7h-frame>
    <div class="hsm__grid">
      <div class="hsm__media">
        <img class="hsm__img" data-r7h-image{% if st.image != blank %} src="{{ st.image | image_url: width: 1600 }}" srcset="{{ st.image | image_url: width: 750 }} 750w, {{ st.image | image_url: width: 1100 }} 1100w, {{ st.image | image_url: width: 1600 }} 1600w, {{ st.image | image_url: width: 2200 }} 2200w" sizes="(min-width: 768px) {{ st.media_width_desktop | default: 50 }}vw, 100vw" width="{{ st.image.width | default: 1600 }}" height="{{ st.image.height | default: 1200 }}"{% else %} src="{{ r7_ph | escape }}" data-r7h-empty width="400" height="300"{% endif %} alt="{{ st.image_alt | default: st.image.alt | escape }}"{% if r7_eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
        <video class="hsm__video" data-r7h-video{% if r7_video_src != blank %} src="{{ r7_video_src | url | escape }}"{% else %} hidden{% endif %} muted loop playsinline preload="metadata" tabindex="-1" aria-hidden="true"></video>
        <button type="button" class="hsm__toggle" data-r7h-video-toggle aria-pressed="false" aria-label="{{ 'accessibility.play_pause' | t }}" hidden><svg class="hsm__icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 2h4v12H3zM9 2h4v12H9z"/></svg><svg class="hsm__icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2l10 6-10 6z"/></svg></button>
      </div>
      <div class="hsm__content">
        {%- render 'r7-hero-text', section: section, tag: r7_tag, name: 'Hero Split' -%}
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "hero-split-media",
  "name": "Hero Split",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Media side (desktop)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_width_desktop",
      "label": "Media width (desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Text position (desktop)",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Text max width",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between blocks",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Fill the screen height",
      "default": false,
      "info": "The section is at least as tall as the screen."
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560,
      "visible_if": "{{ section.settings.full_height == false }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Picture description",
      "info": "Read aloud by screen readers. Leave empty when the picture is decoration."
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Focus point (horizontal)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "The part of the picture or video that stays in view when it is cropped."
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Focus point (vertical)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop in place of the picture, only while it is on screen. The picture shows until it loads."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video address",
      "info": "Used when no video is uploaded."
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "Padding belongs to the text half. The media always reaches the edges of its half."
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Text side padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Media first on phones",
      "default": true
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Media height (mobile)",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Text side padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New arrivals"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Fresh styles for the season"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
