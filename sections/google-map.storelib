<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- render 'contact-live-width', sid: section.id -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
  Google map: an optional heading and subheading (blocks; the older Heading
  and Description settings show when there are none), then the map from the
  embed code pasted in Map embed code, as pasted. live-contact.js applies
  live edits (colour scheme, width, height, alignment, spacing, header
  blocks); a new embed code is drawn by the builder's redraw.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign scroll_animation = settings.scroll_animation | default: 'none'
  if section_st.reveal == false
    assign scroll_animation = 'none'
  endif
  assign sec_font = false
  if section_st.enable_custom_fonts
    assign sec_font = true
  endif
  assign gm_has_header = false
  for b in section.blocks
    if b.settings.text != blank
      assign gm_has_header = true
    endif
  endfor
  assign gm_heading_blocks = section.blocks | where: 'type', 'heading'
  assign gm_sub_blocks = section.blocks | where: 'type', 'subheading'
  if gm_heading_blocks.size == 0 and section_st.heading != blank
    assign gm_has_header = true
  endif
  if gm_sub_blocks.size == 0 and section_st.description != blank
    assign gm_has_header = true
  endif
  assign gm_map_h = section_st.map_height | default: 500
  assign gm_map_h_m = section_st.map_height_mobile | default: 0
  if gm_map_h_m == 0
    assign gm_map_h_m = gm_map_h
  endif
-%}
{%- capture gm_vars -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  {%- if sec_font and section_st.heading_font.family != blank %} --ct-hf: {{ section_st.heading_font.family }}, {{ section_st.heading_font.fallback_families }};{%- endif -%}
  {%- if sec_font and section_st.body_font.family != blank %} --ct-bf: {{ section_st.body_font.family }}, {{ section_st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
{%- if sec_font -%}<style>{{ section_st.heading_font | font_face: font_display: 'swap' }}{{ section_st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
<style>
  #shopify-section-{{ section.id }} .sec__google-map .sec__content { border-radius: var(--gm-radius, 0px); overflow: hidden; }
  #shopify-section-{{ section.id }} .sec__google-map .sec__content iframe {
    width: 100%;
    height: var(--map-height-m, var(--map-height));
  }
  #shopify-section-{{ section.id }} .ct-map__empty {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
    height: var(--map-height-m, var(--map-height));
    padding: 24px;
    text-align: center;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    border: 1px dashed color-mix(in srgb, var(--color-text) 30%, transparent);
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .ct-map__empty svg { width: 40px; height: 40px; opacity: .6; }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .sec__google-map .sec__content iframe,
    #shopify-section-{{ section.id }} .ct-map__empty { height: var(--map-height); }
  }
{% comment %}{% endcomment %}</style>
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__google-map color-{{ color_scheme }} gradient{{ reset_spacing }}"
  data-ct-root="google-map" data-ct-section="{{ section.id }}" data-ct-settings="{{ section.settings | json | escape }}" data-ct-w="{{ section_width }}"
  style="{{ gm_vars | strip | strip_newlines }}"
>
  <div class="{{ section_width }}" data-ct-width>
    <div class="sec__inner relative" data-ct-inner style="--map-height: {{ gm_map_h }}px;{% if gm_map_h_m != gm_map_h %} --map-height-m: {{ gm_map_h_m }}px;{% endif %}{% if section_st.map_radius > 0 %} --gm-radius: {{ section_st.map_radius }}px;{% endif %}">
      <div class="section__header ct-header mb-33 mb-sm-20 text-{{ section_st.header_alignment }}{% if section_st.section_width == 'full_width' %} px-20{% endif %}" data-ct-header{% unless gm_has_header %} hidden{% endunless %}>
        {%- render 'contact-live-header', section: section, anim: scroll_animation, size_class: header_size, sec_font: sec_font -%}
      </div>
      <div class="sec__content" data-ct-map>
        {%- if section_st.map_iframe != blank -%}
          {{ section_st.map_iframe }}
        {%- elsif request.design_mode -%}
          {%- comment -%} Builder only: where the map goes until an embed code is pasted. {%- endcomment -%}
          <div class="ct-map__empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
            <span>Paste the map's embed code in Map embed code.</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>


</template>

<schema>
{
  "type": "google-map",
  "name": "Google map",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Google map",
      "label": "Heading",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "hidden": true,
      "info": "Legacy: used only when the section has no subheading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "textarea",
      "id": "map_iframe",
      "label": "Map embed code",
      "info": "Google Maps > Share > Embed a map > Copy HTML, then paste it here."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "map_height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500,
      "label": "Map height (desktop)"
    },
    {
      "type": "range",
      "id": "map_height_mobile",
      "label": "Map height (mobile)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 uses the desktop height."
    },
    {
      "type": "range",
      "id": "map_radius",
      "label": "Map corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Heading size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "default": "assistant_n4",
      "id": "heading_font",
      "label": "Heading font",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "default": "assistant_n4",
      "id": "body_font",
      "label": "Body font",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px",
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Find us"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "hidden": true,
          "info": "Legacy: the heading is always an h2 (the hero holds the page's h1).",
          "options": [
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "visible_if": "{{ false }}"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "default": "assistant_n4",
          "id": "font",
          "label": "Font",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "700",
          "visible_if": "{{ block.settings.weight_enable }}",
          "options": [
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 16,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 36,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 14,
          "max": 56,
          "step": 1,
          "unit": "px",
          "default": 26,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.9,
          "max": 2,
          "step": 0.05,
          "default": 1.15,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "tracking",
          "label": "Letter spacing",
          "min": -2,
          "max": 6,
          "step": 0.5,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Visit the store or get directions on the map.</p>"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "default": "assistant_n4",
          "id": "font",
          "label": "Font",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "400",
          "visible_if": "{{ block.settings.weight_enable }}",
          "options": [
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 16,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 1,
          "max": 2,
          "step": 0.05,
          "default": 1.5,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Google map",
      "category": "Contact",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "overlay"
    ]
  },
  "shopify": {
    "name": "Google map",
    "tag": "section",
    "disabled_on": {
      "groups": [
        "header",
        "footer",
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "default": "Google map",
        "label": "Heading",
        "hidden": true,
        "info": "Legacy: used only when the section has no heading block",
        "visible_if": "{{ false }}"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "hidden": true,
        "info": "Legacy: used only when the section has no subheading block",
        "visible_if": "{{ false }}"
      },
      {
        "type": "textarea",
        "id": "map_iframe",
        "label": "Map embed code",
        "info": "Google Maps > Share > Embed a map > Copy HTML, then paste it here."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "header_alignment",
        "label": "Header alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "map_height",
        "min": 400,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "default": 500,
        "label": "Map height (desktop)"
      },
      {
        "type": "range",
        "id": "map_height_mobile",
        "label": "Map height (mobile)",
        "min": 0,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "default": 0,
        "info": "0 uses the desktop height."
      },
      {
        "type": "range",
        "id": "map_radius",
        "label": "Map corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "select",
        "id": "header_size",
        "label": "Heading size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "default": "assistant_n4",
        "id": "heading_font",
        "label": "Heading font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "default": "assistant_n4",
        "id": "body_font",
        "label": "Body font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "presets": [
      {
        "name": "Google map",
        "category": "Contact",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          }
        ]
      }
    ],
    "blocks": [
      {
        "type": "heading",
