<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_benefit = 'accessibility.benefit' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Benefits Tabs
  Row of expand/collapse benefit cards using <details> with a smooth height
  animation (grid-template-rows trick + cubic-bezier ease). Heading, subheading,
  optional top-icon, tabs, and CTA button are all blocks for full reorderability.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign cols_desktop = st.cols_desktop | default: 4
  assign cols_mobile = st.cols_mobile | default: '1'
  assign open_default = st.open_first_by_default
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .btab {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .btab {
      padding-top: {{ st.padding_top_desktop | default: 88 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 88 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .btab__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .btab__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- else -%}
      #shopify-section-{{ sid }} .btab__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Header */
  #shopify-section-{{ sid }} .btab__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ st.gap_header_blocks | default: 14 }}px;
    margin-bottom: {{ st.gap_header_to_tabs | default: 32 }}px;
  }
  #shopify-section-{{ sid }} .btab__top-icon {
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .btab__heading { margin: 0; line-height: 1.15; }
  #shopify-section-{{ sid }} .btab__sub { margin: 0; line-height: 1.55; max-width: 720px; }

  /* Tabs grid */
  #shopify-section-{{ sid }} .btab__list {
    display: grid;
    grid-template-columns: repeat({{ cols_mobile }}, minmax(0, 1fr));
    gap: {{ st.tab_gap | default: 16 }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .btab__list {
      grid-template-columns: repeat({{ cols_desktop }}, minmax(0, 1fr));
      gap: {{ st.tab_gap_desktop | default: 20 }}px;
    }
  }

  /* Tab card — JS-controlled <details> for guaranteed smooth open AND close
     animations across browsers. The native `details` element toggles `open`
     instantly which can skip the closing transition; our JS animates first,
     then commits the state. */
  #shopify-section-{{ sid }} .btab__item {
    background-color: {% render 'scheme-color', color: st.tab_bg, fallback: 'var(--color-background)' %} !important;
    border: {{ st.tab_border_width | default: 0 }}px solid {{ st.tab_border_color | default: 'rgba(0,0,0,0.08)' }};
    border-radius: {{ st.tab_radius | default: 14 }}px;
    overflow: hidden;
    transition: box-shadow .55s cubic-bezier(0.22, 1, 0.36, 1), background-color .35s ease;
    will-change: box-shadow;
  }
  #shopify-section-{{ sid }} .btab__item[open] {
    box-shadow: 0 12px 28px -14px rgba(0,0,0,.14);
  }
  #shopify-section-{{ sid }} .btab__item summary {
    list-style: none;
    cursor: pointer;
    padding: {{ st.tab_padding | default: 18 }}px;
    display: flex;
    align-items: center;
    gap: 12px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .btab__item summary::-webkit-details-marker,
  #shopify-section-{{ sid }} .btab__item summary::marker { display: none; content: ''; }

  #shopify-section-{{ sid }} .btab__icon {
    flex-shrink: 0;
    width: {{ st.icon_box_size | default: 40 }}px;
    height: {{ st.icon_box_size | default: 40 }}px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ sid }} .btab__icon svg,
  #shopify-section-{{ sid }} .btab__icon img {
    width: {{ st.icon_size | default: 22 }}px;
    height: {{ st.icon_size | default: 22 }}px;
  }

  #shopify-section-{{ sid }} .btab__title {
    margin: 0;
    flex: 1;
    line-height: 1.25;
    font-size: {{ st.tab_title_size | default: 16 }}px;
    font-weight: 700;
  }

  #shopify-section-{{ sid }} .btab__chev {
    flex-shrink: 0;
    width: 24px; height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {% render 'scheme-color', color: st.tab_chev_color, fallback: 'var(--color-primary)' %};
    transition: transform .55s cubic-bezier(0.34, 1.16, 0.64, 1);
    will-change: transform;
  }
  #shopify-section-{{ sid }} .btab__item[open] .btab__chev {
    transform: rotate(45deg);
  }
  #shopify-section-{{ sid }} .btab__chev svg { width: 100%; height: 100%; }

  /* Smooth expand/collapse — JS sets a real pixel max-height for guaranteed
     smooth motion on open AND close (the grid-template-rows trick is fine on
     open, but is unreliable on close in Safari/Chrome with <details>). */
  #shopify-section-{{ sid }} .btab__panel {
    overflow: hidden;
    max-height: 0;
    will-change: max-height;
    transition: max-height .55s cubic-bezier(0.32, 0.72, 0, 1);
  }
  #shopify-section-{{ sid }} .btab__item.is-animating .btab__panel,
  #shopify-section-{{ sid }} .btab__item[open] .btab__panel {
    /* Set inline style by JS during transitions; default open shows content. */
  }
  #shopify-section-{{ sid }} .btab__panel > div {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity .35s cubic-bezier(0.32, 0.72, 0, 1), transform .35s cubic-bezier(0.32, 0.72, 0, 1);
  }
  #shopify-section-{{ sid }} .btab__item[open] .btab__panel > div {
    opacity: 1;
    transform: translateY(0);
    transition-delay: .18s;
  }
  #shopify-section-{{ sid }} .btab__desc {
    padding: 0 {{ st.tab_padding | default: 18 }}px {{ st.tab_padding | default: 18 }}px;
    margin: 0;
    line-height: 1.55;
    font-size: {{ st.tab_desc_size | default: 14 }}px;
    color: {% render 'scheme-color', color: st.tab_desc_color, fallback: 'var(--color-text)' %} !important;
  }

  /* CTA block button */
  #shopify-section-{{ sid }} .btab__cta-wrap {
    margin-top: {{ st.gap_tabs_to_cta | default: 32 }}px;
    text-align: center;
  }
  #shopify-section-{{ sid }} .btab__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: .5px;
    transition: transform .15s ease, background-color .25s ease, color .25s ease;
  }
  #shopify-section-{{ sid }} .btab__cta:hover { transform: translateY(-1px); }

  /* Reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .btab__panel,
    #shopify-section-{{ sid }} .btab__panel > div,
    #shopify-section-{{ sid }} .btab__chev,
    #shopify-section-{{ sid }} .btab__item {
      transition: none;
    }
  }
{% comment %}{% endcomment %}</style>

<section class="btab-wrap color-{{ color_scheme }} gradient {{ section.settings.section_width }}">
  <div class="btab">
    <div class="btab__inner">
      <div class="btab__header">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'top_icon' -%}
              {%- if block.settings.image -%}
                <img class="btab__top-icon"
                     style="width:{{ block.settings.size | default: 64 }}px;height:{{ block.settings.size | default: 64 }}px;"
                     src="{{ block.settings.image | image_url: width: 200 }}"
                     alt=""
                     loading="lazy"
                     {{ block.shopify_attributes }}>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                <{{ block.settings.tag | default: 'h2' }}
                  id="block-{{ block.id }}"
                  class="btab__heading"
                  style="color: {{ block.settings.color | default: '#0F0F0F' }} !important; font-weight: {{ block.settings.weight | default: 700 }};"
                  {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </{{ block.settings.tag | default: 'h2' }}>
                <style>
                  #block-{{ block.id }} { font-size: {{ block.settings.size_mobile | default: 32 }}px; }
                  @media (min-width: 768px) { #block-{{ block.id }} { font-size: {{ block.settings.size_desktop | default: 44 }}px; } }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}
            {%- when 'subheading' -%}
              {%- if block.settings.text != blank -%}
                <p id="block-{{ block.id }}"
                   class="btab__sub"
                   style="color: {{ block.settings.color | default: '#555555' }} !important;"
                   {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </p>
                <style>
                  #block-{{ block.id }} { font-size: {{ block.settings.size_mobile | default: 15 }}px; }
                  @media (min-width: 768px) { #block-{{ block.id }} { font-size: {{ block.settings.size_desktop | default: 17 }}px; } }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
      {%- if tab_blocks.size > 0 -%}
        <ul class="btab__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign bs = block.settings -%}
              <li>
                <details class="btab__item"{% if open_default and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary>
                    {%- if bs.icon_source != 'none' -%}
                      <span class="btab__icon" style="background:{{ bs.icon_box_bg | default: '#F0F0F0' }};color:{{ bs.icon_color | default: '#0F0F0F' }};">
                        {%- case bs.icon_source -%}
                          {%- when 'icon' -%}
                            {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
                          {%- when 'image' -%}
                            {%- if bs.image -%}<img src="{{ bs.image | image_url: width: 80 }}" alt="" loading="lazy">{%- endif -%}
                          {%- when 'svg' -%}
                            {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                    <h3 class="btab__title" style="color: {{ bs.title_color | default: '#0F0F0F' }} !important;">
                      {{ bs.title | default: fb_accessibility_benefit | escape }}
                    </h3>
                    <span class="btab__chev" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="btab__panel">
                    <div>
                      {%- if bs.description != blank -%}
                        <p class="btab__desc">{{ bs.description | escape }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </details>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%}CTA block — rendered if user adds the cta block{%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'cta' and block.settings.label != blank -%}
          {%- assign bs = block.settings -%}
          <div class="btab__cta-wrap" {{ block.shopify_attributes }}>
            <a class="btab__cta"
               href="{{ bs.link | default: '#' }}"
               style="
                 background-color: {{ bs.bg | default: '#0F0F0F' }} !important;
                 color: {{ bs.text_color | default: '#FFFFFF' }} !important;
                 padding: {{ bs.pad_y | default: 14 }}px {{ bs.pad_x | default: 32 }}px;
                 border-radius: {{ bs.radius | default: 100 }}px;
                 font-size: {{ bs.size | default: 14 }}px;
               ">
              {{ bs.label | escape }}
            </a>
            <style>
              #shopify-section-{{ sid }} [data-cta-{{ block.id }}]:hover,
              #shopify-section-{{ sid }} .btab__cta:hover {
                background-color: {{ bs.bg_hover | default: '#444444' }} !important;
                color: {{ bs.text_color_hover | default: '#FFFFFF' }} !important;
              }
{% comment %}{% endcomment %}            </style>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function() {
  var root = document.querySelector('#shopify-section-{{ sid }} .btab');
  if (!root) return;
  var items = root.querySelectorAll('.btab__item');

  function getInner(item) { return item.querySelector('.btab__panel > div'); }

  function animateOpen(item) {
    var panel = item.querySelector('.btab__panel');
    var inner = getInner(item);
    if (!panel || !inner) { item.setAttribute('open',''); return; }
    item.setAttribute('open','');
    panel.style.maxHeight = '0px';
    // Force reflow
    void panel.offsetHeight;
    var target = inner.scrollHeight;
    panel.style.maxHeight = target + 'px';
    var done = function() {
      panel.style.maxHeight = 'none';
      panel.removeEventListener('transitionend', done);
    };
    panel.addEventListener('transitionend', done);
  }

  function animateClose(item) {
    var panel = item.querySelector('.btab__panel');
    var inner = getInner(item);
    if (!panel || !inner) { item.removeAttribute('open'); return; }
    var current = panel.scrollHeight;
    panel.style.maxHeight = current + 'px';
    void panel.offsetHeight;
    panel.style.maxHeight = '0px';
    var done = function() {
      item.removeAttribute('open');
      panel.style.maxHeight = '';
      panel.removeEventListener('transitionend', done);
    };
    panel.addEventListener('transitionend', done);
  }

  items.forEach(function(item) {
    var summary = item.querySelector('summary');
    if (!summary) return;
    // If preset open by default, set max-height to none so layout is correct
    if (item.hasAttribute('open')) {
      var panel = item.querySelector('.btab__panel');
      if (panel) panel.style.maxHeight = 'none';
    }
    summary.addEventListener('click', function(e) {
      e.preventDefault();
      if (item.hasAttribute('open')) {
        animateClose(item);
      } else {
        animateOpen(item);
      }
    });
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "benefits-tabs",
  "name": "Benefits Tabs",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "open_first_by_default",
      "label": "Open first tab by default",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Tabs"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Columns (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "tab_gap",
      "label": "Gap between tabs (mobile)",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tab_gap_desktop",
      "label": "Gap between tabs (desktop)",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "tab_padding",
      "label": "Tab inner padding",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "tab_radius",
      "label": "Tab corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "tab_border_width",
      "label": "Tab border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Tab border color"
    },
    {
      "type": "range",
      "id": "tab_title_size",
      "label": "Title size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tab_desc_size",
      "label": "Description size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Icon (per tab default fallback)"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "label": "Icon box size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "tab_bg",
      "label": "Tab background"
    },
    {
      "type": "color",
      "id": "tab_chev_color",
      "label": "Toggle (+/×) color"
    },
    {
      "type": "color",
      "id": "tab_desc_color",
      "label": "Description color"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "gap_header_blocks",
      "label": "Gap between header blocks",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
