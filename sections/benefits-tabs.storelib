            "type": "color",
            "id": "color",
            "label": "Colour",
            "default": "#0F0F0F",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Open any tab to see what we use and what we leave out."
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 17
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 11,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 15
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Colour",
            "default": "#555555",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "tab",
        "name": "Tab",
        "limit": 12,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Benefit"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Text shown when open",
            "default": "A short description that appears when the merchant expands this benefit tab."
          },
          {
            "type": "select",
            "id": "icon_source",
            "label": "Icon",
            "default": "icon",
            "options": [
              {
                "value": "icon",
                "label": "Icon from library"
              },
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "svg",
                "label": "Custom SVG code"
              },
              {
                "value": "none",
                "label": "No icon"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon",
            "label": "Library icon",
            "default": "shield",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "truck",
                "label": "Truck"
              },
              {
                "value": "shield",
                "label": "Shield"
              },
              {
                "value": "lock",
                "label": "Lock"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "check",
                "label": "Check"
              },
              {
                "value": "headphones",
                "label": "Headphones"
              },
              {
                "value": "envelope",
                "label": "Envelope"
              },
              {
                "value": "chat",
                "label": "Chat"
              },
              {
                "value": "tag",
                "label": "Tag"
              },
              {
                "value": "gift",
                "label": "Gift"
              },
              {
                "value": "globe",
                "label": "Globe"
              },
              {
                "value": "leaf",
                "label": "Leaf"
              },
              {
                "value": "award",
                "label": "Award"
              },
              {
                "value": "clock",
                "label": "Clock"
              },
              {
                "value": "card",
                "label": "Card"
              },
              {
                "value": "wallet",
                "label": "Wallet"
              },
              {
                "value": "lightning",
                "label": "Lightning"
              },
              {
                "value": "recycle",
                "label": "Recycle"
              },
              {
                "value": "sparkle",
                "label": "Sparkle"
              },
              {
                "value": "box",
                "label": "Box"
              },
              {
                "value": "refresh",
                "label": "Refresh"
              },
              {
                "value": "user",
                "label": "User"
              },
              {
                "value": "calendar",
                "label": "Calendar"
              },
              {
                "value": "handshake",
                "label": "Handshake"
              },
              {
                "value": "gem",
                "label": "Gem"
              },
              {
                "value": "organic",
                "label": "Organic"
              },
              {
                "value": "fire",
                "label": "Fire"
              },
              {
                "value": "crown",
                "label": "Crown"
              }
            ],
            "visible_if": "{{ block.settings.icon_source == 'icon' }}"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "visible_if": "{{ block.settings.icon_source == 'image' }}"
          },
          {
            "type": "html",
            "id": "svg_code",
            "label": "SVG code",
            "visible_if": "{{ block.settings.icon_source == 'svg' }}"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "icon_color",
            "label": "Icon",
            "default": "#0F0F0F",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "icon_box_bg",
            "label": "Icon circle",
            "default": "#F0F0F0",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title",
            "default": "#0F0F0F",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "cta",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: colours follow Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "default": "#0F0F0F",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Hover background",
            "default": "#444444",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "default": "#FFFFFF",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color_hover",
            "label": "Hover text",
            "default": "#FFFFFF",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button size and shape",
            "default": true
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 11,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_x",
            "label": "Horizontal padding",
            "min": 12,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 32,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_y",
            "label": "Vertical padding",
            "min": 6,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Benefits Tabs",
        "category": "Features",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "tab",
            "settings": {
              "icon": "leaf",
              "title": "Ingredients",
              "description": "Each ingredient is listed on the label."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "box",
              "title": "Packaging",
              "description": "How we pack each order before it ships."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "truck",
              "title": "Delivery",
              "description": "Delivery options and times are shown at checkout."
            }
          },
          {
            "type": "tab",
            "settings": {
              "icon": "refresh",
              "title": "Returns",
              "description": "How to send something back if it is not right."
            }
          },
          {
            "type": "cta"
          }
        ]
      }
    ]
  }
}
