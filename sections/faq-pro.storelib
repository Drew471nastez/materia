                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra bold"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 36,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 26,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.8,
            "max": 2,
            "step": 0.05,
            "default": 1.15,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -2,
            "max": 10,
            "step": 0.5,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Have a question? We're here to help.</p>"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 11,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2.2,
            "step": 0.05,
            "default": 1.5,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "faq_item",
        "name": "Question",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "Question goes here"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer",
            "default": "<p>Answer goes here.</p>"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Contact us"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              },
              {
                "value": "text",
                "label": "Link"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width",
            "default": false
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: colours follow Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_color_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "select",
            "id": "size",
            "label": "Size",
            "default": "medium",
            "options": [
              {
                "value": "small",
                "label": "Small"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "large",
                "label": "Large"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ 4",
        "category": "FAQ",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How do I place an order?",
              "answer": "<p>Add what you want to your cart and go to checkout. You get an email as soon as the order is placed.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "When will my order ship?",
              "answer": "<p>Delivery options and times are shown at checkout. A tracking link follows by email once the order leaves.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "Can I return an item?",
              "answer": "<p>Yes. The returns page explains the steps and how long you have to send something back.</p>"
            }
          },
          {
            "type": "faq_item",
            "settings": {
              "question": "How do I contact you?",
              "answer": "<p>Use the contact page or reply to your order email and we will get back to you.</p>"
            }
          },
          {
            "type": "button",
            "settings": {
              "label": "Contact us"
            }
          }
        ]
      }
    ]
  }
}
