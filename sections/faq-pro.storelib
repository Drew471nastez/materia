<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_question_goes_here = 'accessibility.question_goes_here' | t -%}
{%- assign fb_accessibility_learn_more = 'accessibility.learn_more' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — FAQ 7 (clean, scoped, smooth open/close, theme-connected).
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign heading = st.heading
  assign subheading = st.subheading

  assign content_alignment = st.content_alignment | default: 'left'
  assign allow_multiple_open = st.allow_multiple_open
  assign first_item_open = st.first_item_open
  assign open_icon = st.open_icon | default: 'plus'

  assign heading_size_d = st.heading_size_desktop | default: 36
  assign heading_size_m = st.heading_size_mobile | default: 26
  assign subheading_size_d = st.subheading_size_desktop | default: 16
  assign subheading_size_m = st.subheading_size_mobile | default: 14
  assign question_size_d = st.question_size_desktop | default: 18
  assign question_size_m = st.question_size_mobile | default: 15
  assign answer_size_d = st.answer_size_desktop | default: 15
  assign answer_size_m = st.answer_size_mobile | default: 14


  assign max_content_width = st.max_content_width | default: 800

  assign reveal = st.reveal
  assign scroll_animation = st.scroll_animation | default: 'inherit'
  if scroll_animation == 'inherit'
    assign scroll_animation = settings.scroll_animation | default: 'none'
  endif
-%}
{%- capture heading_color -%}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture subheading_color -%}{% render 'scheme-color', color: st.subheading_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture question_color -%}{% render 'scheme-color', color: st.question_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture answer_color -%}{% render 'scheme-color', color: st.answer_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture divider_color -%}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture icon_color -%}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture card_bg -%}{% render 'scheme-color', color: st.card_bg, fallback: 'rgba(var(--color-heading-rgb), 0.04)' %}{%- endcapture -%}
{%- capture card_border_color -%}{% render 'scheme-color', color: st.card_border_color, fallback: 'transparent' %}{%- endcapture -%}
{%- capture hover_color -%}{% render 'scheme-color', color: st.hover_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- capture section_bg -%}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{%- endcapture -%}

<style>
  /* ===== FAQ 7 — fully scoped to #shopify-section-{{ sid }} ===== */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, inherit);
  }

  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Background applied to the section wrapper so it spans full viewport
     even when mobile auto-padding is applied to the inner content. */
  #shopify-section-{{ sid }} .faq7 {
    background-color: {{ section_bg }} !important;
    padding-top: {{ st.padding_top | default: 60 }}px;
    padding-bottom: {{ st.padding_bottom | default: 60 }}px;
  }

  #shopify-section-{{ sid }} .faq7__inner {
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: 1.5rem;
  }
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .faq7__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .faq7__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .faq7__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}

  /* Two-column layout: header on left, accordion on right (desktop only) */
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq7__layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ st.col_gap | default: 60 }}px;
      align-items: start;
    }
    #shopify-section-{{ sid }} .faq7__header { margin-bottom: 0; position: sticky; top: 20px; }
  }

  #shopify-section-{{ sid }} .faq7__header {
    text-align: {{ content_alignment }};
    margin-bottom: {{ st.gap_header_to_items | default: 32 }}px;
    max-width: {{ max_content_width }}px;
    margin-inline: {% if content_alignment == 'center' %}auto{% else %}0{% endif %};
  }
  #shopify-section-{{ sid }} .faq7__heading {
    margin: 0;
    font-size: {{ heading_size_m }}px;
    line-height: 1.15;
    color: {{ heading_color }} !important;
    {% if st.enable_custom_heading_weight %}font-weight: {{ st.heading_weight | default: 600 }};{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq7__heading { font-size: {{ heading_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq7__subheading {
    margin: {{ st.gap_heading_to_subheading | default: 12 }}px 0 0;
    font-size: {{ subheading_size_m }}px;
    color: {{ subheading_color }} !important;
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq7__subheading { font-size: {{ subheading_size_d }}px; }
  }

  #shopify-section-{{ sid }} .faq7__list {
    max-width: {{ max_content_width }}px;
    margin-inline: {% if content_alignment == 'center' %}auto{% else %}0{% endif %};
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_between_items | default: 0 }}px;
    list-style: none;
    padding: 0;
  }
  #shopify-section-{{ sid }} .faq7__item {
    background: {{ card_bg }} !important;
    border: 1px solid {{ card_border_color }};
    border-radius: {{ st.item_radius | default: 0 }}px;
    {% if st.show_dividers and st.gap_between_items == 0 %}
      border-bottom: 1px solid {{ divider_color }};
    {% endif %}
  }
  {% if st.show_dividers and st.gap_between_items == 0 %}
    #shopify-section-{{ sid }} .faq7__item:first-child { border-top: 1px solid {{ divider_color }}; }
  {% endif %}



  #shopify-section-{{ sid }} .faq7__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: {{ st.item_padding_y | default: 20 }}px {{ st.item_padding_x | default: 4 }}px;
    text-align: start;
    color: {{ question_color }} !important;
    font-size: {{ question_size_m }}px;
    line-height: 1.4;
    transition: color .2s ease;
    {% if st.enable_custom_question_weight %}font-weight: {{ st.question_weight | default: 600 }};{% else %}font-weight: var(--heading-weight, 600);{% endif %}
  }
  #shopify-section-{{ sid }} .faq7__q:hover { color: {{ hover_color }} !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq7__q { font-size: {{ question_size_d }}px; }
  }

  #shopify-section-{{ sid }} .faq7__icon {
    flex-shrink: 0; width: 22px; height: 22px;
    color: {{ icon_color }} !important;
    transition: transform .35s cubic-bezier(.4,0,.2,1);
    display: inline-flex; align-items: center; justify-content: center;
    position: relative;
  }
  #shopify-section-{{ sid }} .faq7__icon svg {
    width: 100%; height: 100%;
    stroke: currentColor; stroke-width: 2; fill: none;
  }
  #shopify-section-{{ sid }} .faq7__item[open] .faq7__icon-chevron {
    transform: rotate(180deg);
  }
  #shopify-section-{{ sid }} .faq7__icon-plus .v,
  #shopify-section-{{ sid }} .faq7__icon-plus .h {
    position: absolute; background: currentColor;
    transition: transform .35s cubic-bezier(.4,0,.2,1), opacity .25s ease;
  }
  #shopify-section-{{ sid }} .faq7__icon-plus .v { width: 2px; height: 14px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq7__icon-plus .h { width: 14px; height: 2px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq7__item[open] .faq7__icon-plus .v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }

  #shopify-section-{{ sid }} .faq7__a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1);
  }
  #shopify-section-{{ sid }} .faq7__item[open] .faq7__a-wrap { grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .faq7__a-inner { overflow: hidden; }
  #shopify-section-{{ sid }} .faq7__a {
    margin: 0;
    padding: 0 {{ st.item_padding_x | default: 4 }}px {{ st.item_padding_y | default: 20 }}px;
    color: {{ answer_color }} !important;
    font-size: {{ answer_size_m }}px;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq7__a { font-size: {{ answer_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq7__a a { color: inherit; text-decoration: underline; }

  {%- if reveal and scroll_animation != 'none' and request.design_mode != true -%}
    #shopify-section-{{ sid }} .faq7 {
      opacity: 0;
      transition: opacity .8s ease, transform .8s ease, filter .8s ease, clip-path .8s ease;
      will-change: opacity, transform;
    }
    {%- case scroll_animation -%}
      {%- when 'slide-in' -%}
        #shopify-section-{{ sid }} .faq7 { transform: translateX(-20px); }
        #shopify-section-{{ sid }} .faq7.is-revealed { transform: translateX(0); }
      {%- when 'smooth-fade-up' -%}
        #shopify-section-{{ sid }} .faq7 { transform: translateY(20px); }
        #shopify-section-{{ sid }} .faq7.is-revealed { transform: translateY(0); }
      {%- when 'blur_up' -%}
        #shopify-section-{{ sid }} .faq7 { transform: translateY(12px); filter: blur(4px); }
        #shopify-section-{{ sid }} .faq7.is-revealed { transform: none; filter: none; }
      {%- when 'slide_side' -%}
        #shopify-section-{{ sid }} .faq7 { transform: translateX(-28px); }
        #shopify-section-{{ sid }} .faq7.is-revealed { transform: none; }
      {%- when 'mask_reveal' -%}
        #shopify-section-{{ sid }} .faq7 { opacity: 1; clip-path: inset(0 0 100% 0); transform: translateY(10px); }
        #shopify-section-{{ sid }} .faq7.is-revealed { clip-path: inset(0 0 0 0); transform: none; }
    {%- endcase -%}
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .faq7 { filter: none !important; clip-path: none !important; }
    }
    #shopify-section-{{ sid }} .faq7.is-revealed { opacity: 1; }
  {%- endif -%}

  /* CTA button block — renders inside the header, under heading / subheading */
  #shopify-section-{{ sid }} .faq7__cta-row {
    margin-top: 18px;
    display: flex;
    justify-content: {% if content_alignment == 'left' %}flex-start{% elsif content_alignment == 'right' %}flex-end{% else %}center{% endif %};
  }
  #shopify-section-{{ sid }} .faq7__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--faq7-btn-radius, 100px);
    font-family: inherit;
    font-weight: var(--faq7-btn-weight, 600);
    border-width: var(--faq7-btn-border-width, 1px) !important;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .15s ease;
    box-sizing: border-box;
    text-align: center;
  }
  #shopify-section-{{ sid }} .faq7__btn--small  { padding: 10px 18px; font-size: 13px; }
  #shopify-section-{{ sid }} .faq7__btn--medium { padding: 13px 24px; font-size: 14px; }
  #shopify-section-{{ sid }} .faq7__btn--large  { padding: 16px 32px; font-size: 16px; }
  #shopify-section-{{ sid }} .faq7__btn--theme { padding: var(--btn-padding-y, 13px) var(--btn-padding-x, 24px); font-size: var(--btn-font-size, 14px); }
  #shopify-section-{{ sid }} .faq7__btn--primary {
    background: var(--faq7-btn-bg);
    color: var(--faq7-btn-color);
    border: 1px solid var(--faq7-btn-border);
  }
  #shopify-section-{{ sid }} .faq7__btn--primary:hover {
    background: var(--faq7-btn-bg-hover);
    color: var(--faq7-btn-color-hover);
  }
  #shopify-section-{{ sid }} .faq7__btn--secondary {
    background: transparent;
    color: var(--faq7-btn-bg);
    border: 1px solid var(--faq7-btn-border);
  }
  #shopify-section-{{ sid }} .faq7__btn--secondary:hover {
    background: var(--faq7-btn-bg);
    color: var(--faq7-btn-color);
  }
  #shopify-section-{{ sid }} .faq7__btn--text {
    background: transparent;
    color: var(--faq7-btn-bg);
    border: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
    padding-inline: 4px;
  }
  #shopify-section-{{ sid }} .faq7__btn--disabled { opacity: .5; cursor: not-allowed; }
  #shopify-section-{{ sid }} .faq7__btn:active { transform: translateY(1px); }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.faq7__a-wrap, .faq7__icon, .faq7__icon-plus *, .faq7, .faq7__btn) {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
{% comment %}{% endcomment %}</style>

{%- liquid
  comment
    Split blocks so we can render Button blocks under the header,
    then only iterate FAQ items in the accordion list.
  endcomment
  assign faq_items = section.blocks | where: 'type', 'faq_item'
  assign button_blocks = section.blocks | where: 'type', 'button'
-%}

<div class="faq7 color-{{ color_scheme }} gradient">
  <div class="faq7__inner">
    <div class="faq7__layout">
    {%- if heading != blank or subheading != blank or button_blocks.size > 0 -%}
      <div class="faq7__header">
        {%- if heading != blank -%}<h2 class="faq7__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<div class="faq7__subheading">{{ subheading }}</div>{%- endif -%}
        {%- for btn in button_blocks -%}
          {%- liquid
            assign bbs = btn.settings
            assign btn_label = bbs.label | default: fb_accessibility_learn_more
            assign btn_link  = bbs.link
            assign btn_style = bbs.style | default: 'primary'
            assign btn_size  = bbs.size  | default: 'medium'
            if bbs.use_theme_button != false
              assign btn_size = 'theme'
            endif
          -%}
          {%- capture btn_vars -%}
            --mb-bg: var(--faq7-btn-bg); --mb-text: var(--faq7-btn-color); --mb-border: var(--faq7-btn-border);
            --mb-hover-bg: var(--faq7-btn-bg-hover); --mb-hover-text: var(--faq7-btn-color-hover);
            --faq7-btn-bg: {% render 'scheme-color', color: bbs.bg_color, fallback: 'var(--btn-primary-bg-color)' %};
            --faq7-btn-color: {% render 'scheme-color', color: bbs.text_color, fallback: 'var(--btn-primary-color)' %};
            --faq7-btn-border: {% render 'scheme-color', color: bbs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
            --faq7-btn-bg-hover: {% render 'scheme-color', color: bbs.bg_color_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
            --faq7-btn-color-hover: {% render 'scheme-color', color: bbs.text_color_hover, fallback: 'var(--btn-primary-hover-color)' %};
            {%- if bbs.use_theme_button != false -%}
              --faq7-btn-radius: var(--btn-radius, 100px); --faq7-btn-weight: var(--btn-font-weight, 600); --faq7-btn-border-width: var(--btn-border-width, 1px);
            {%- else -%}
              --faq7-btn-radius: {{ bbs.radius | default: 100 }}px;
              --mb-radius: {{ bbs.radius | default: 100 }}px;
              {%- case btn_size -%}
                {%- when 'small' -%}--mb-font-size: 13px; --mb-padding-y: 10px; --mb-padding-x: 18px;
                {%- when 'large' -%}--mb-font-size: 16px; --mb-padding-y: 16px; --mb-padding-x: 32px;
                {%- else -%}--mb-font-size: 14px; --mb-padding-y: 13px; --mb-padding-x: 24px;
              {%- endcase -%}
            {%- endif -%}
            {%- if bbs.full_width %} width: 100%;{%- endif -%}
          {%- endcapture -%}
          <div class="faq7__cta-row" id="block-{{ btn.id }}" {{ btn.shopify_attributes }}>
            {%- if btn_link != blank -%}
              <a class="faq7__btn faq7__btn--{{ btn_style }} faq7__btn--{{ btn_size }}" data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button
                 data-button-local-appearance="{% if btn_style == 'text' %}underline{% else %}theme{% endif %}" href="{{ btn_link }}"
                 style="{{ btn_vars | strip_newlines }}">
                {{ btn_label }}
              </a>
            {%- else -%}
              <span class="faq7__btn faq7__btn--{{ btn_style }} faq7__btn--{{ btn_size }} faq7__btn--disabled" data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button
                    style="{{ btn_vars | strip_newlines }}">
                {{ btn_label }}
              </span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if faq_items.size > 0 -%}
      <div class="faq7__list" data-faq7-list data-multiple="{% if allow_multiple_open %}true{% else %}false{% endif %}">
        {%- for block in faq_items -%}
          {%- liquid
            assign bs = block.settings
            assign open_first = false
            if first_item_open and forloop.first
              assign open_first = true
            endif
          -%}
          <div class="faq7__item" {% if open_first %}open{% endif %} data-faq7-item id="block-{{ block.id }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="faq7__q"
              aria-expanded="{% if open_first %}true{% else %}false{% endif %}"
              aria-controls="faq7-a-{{ sid }}-{{ forloop.index }}"
              data-faq7-trigger
            >
              <span>{{ bs.question | default: fb_accessibility_question_goes_here }}</span>
              <span class="faq7__icon" aria-hidden="true">
                {%- if open_icon == 'chevron' -%}
                  <svg class="faq7__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif open_icon == 'arrow' -%}
                  <svg class="faq7__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
                {%- else -%}
                  <span class="faq7__icon-plus"><span class="v"></span><span class="h"></span></span>
                {%- endif -%}
              </span>
            </button>
            <div class="faq7__a-wrap" id="faq7-a-{{ sid }}-{{ forloop.index }}">
              <div class="faq7__a-inner">
                <div class="faq7__a">{{ bs.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ sid }}');
    if (!section) return;
    var list = section.querySelector('[data-faq7-list]');
    if (!list) return;
    var multiple = list.dataset.multiple === 'true';
    list.addEventListener('click', function (e) {
      var trig = e.target.closest('[data-faq7-trigger]');
      if (!trig) return;
      var item = trig.closest('[data-faq7-item]');
      if (!item) return;
      var isOpen = item.hasAttribute('open');
      if (!multiple) {
        list.querySelectorAll('[data-faq7-item][open]').forEach(function (it) {
          if (it !== item) {
            it.removeAttribute('open');
            var btn = it.querySelector('[data-faq7-trigger]');
            if (btn) btn.setAttribute('aria-expanded', 'false');
          }
        });
      }
      if (isOpen) { item.removeAttribute('open'); trig.setAttribute('aria-expanded', 'false'); }
      else { item.setAttribute('open', ''); trig.setAttribute('aria-expanded', 'true'); }
    });
    var animation = '{{ scroll_animation }}';
    var revealEl = section.querySelector('.faq7');
    if (document.body.classList.contains('shopify-design-mode')) {
      if (revealEl) revealEl.classList.add('is-revealed');
    } else if (animation && animation !== 'none' && revealEl) {
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            revealEl.classList.add('is-revealed');
            obs.unobserve(revealEl);
          }
        });
      }, { threshold: 0.12 });
      io.observe(revealEl);
    } else if (revealEl) {
      revealEl.classList.add('is-revealed');
    }
  })();
{% comment %}{% endcomment %}</script>



