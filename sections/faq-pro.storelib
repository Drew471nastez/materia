<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_question_goes_here = 'accessibility.question_goes_here' | t -%}
{%- assign fb_accessibility_learn_more = 'accessibility.learn_more' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes — FAQ 7 (clean, scoped, smooth open/close, theme-connected).
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign heading = st.heading
  assign subheading = st.subheading

  assign content_alignment = st.content_alignment | default: 'left'
  assign allow_multiple_open = st.allow_multiple_open
  assign first_item_open = st.first_item_open
  assign open_icon = st.open_icon | default: 'plus'

  assign heading_size_d = st.heading_size_desktop | default: 36
  assign heading_size_m = st.heading_size_mobile | default: 26
  assign subheading_size_d = st.subheading_size_desktop | default: 16
  assign subheading_size_m = st.subheading_size_mobile | default: 14
  assign question_size_d = st.question_size_desktop | default: 18
  assign question_size_m = st.question_size_mobile | default: 15
  assign answer_size_d = st.answer_size_desktop | default: 15
  assign answer_size_m = st.answer_size_mobile | default: 14


  assign max_content_width = st.max_content_width | default: 800

  assign reveal = st.reveal
  assign scroll_animation = st.scroll_animation | default: 'inherit'
  if scroll_animation == 'inherit'
    assign scroll_animation = settings.scroll_animation | default: 'none'
  endif
-%}
{%- capture heading_color -%}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture subheading_color -%}{% render 'scheme-color', color: st.subheading_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture question_color -%}{% render 'scheme-color', color: st.question_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture answer_color -%}{% render 'scheme-color', color: st.answer_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture divider_color -%}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture icon_color -%}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture card_bg -%}{% render 'scheme-color', color: st.card_bg, fallback: 'rgba(var(--color-heading-rgb), 0.04)' %}{%- endcapture -%}
{%- capture card_border_color -%}{% render 'scheme-color', color: st.card_border_color, fallback: 'transparent' %}{%- endcapture -%}
{%- capture hover_color -%}{% render 'scheme-color', color: st.hover_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- capture section_bg -%}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{%- endcapture -%}

<style>
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }},#shopify-section-{{ sid }}>.section,#shopify-section-{{ sid }}>section,#shopify-section-{{ sid }}>div,#shopify-section-{{ sid }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ sid }}+.shopify-section,#shopify-section-{{ sid }}+section,.shopify-section+#shopify-section-{{ sid }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ sid }}{isolation:isolate;position:relative;margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}
  :where(#shopify-section-{{ sid }}){font-family:var(--body-font,inherit)}
  :where(#shopify-section-{{ sid }}) :where(button,input,textarea,select,optgroup){font-family:inherit}
  #shopify-section-{{ sid }} *,#shopify-section-{{ sid }} *:before,#shopify-section-{{ sid }} *:after{box-sizing:border-box}
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6){font-family:var(--heading-font,inherit);font-weight:var(--heading-weight,inherit)}
  @media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}
{% comment %}{% endcomment %}</style>
{%- comment -%} The builder also gets it inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'faq-pro.css' | inline_asset_content }}</style>{%- endif %}
{{ 'faq-pro.css' | asset_url | stylesheet_tag }}
{%- comment -%} The values faq-pro.css reads, on this instance's root. {%- endcomment -%}
{%- capture faq7_vars -%}
--faq7-bg:{{ section_bg }};--faq7-pt:{{ st.padding_top | default: 60 }}px;--faq7-pb:{{ st.padding_bottom | default: 60 }}px;
--faq7-col-gap:{{ st.col_gap | default: 60 }}px;
--faq7-align:{{ content_alignment }};--faq7-mi:{% if content_alignment == 'center' %}auto{% else %}0{% endif %};
--faq7-cta-justify:{% if content_alignment == 'left' %}flex-start{% elsif content_alignment == 'right' %}flex-end{% else %}center{% endif %};
--faq7-gap-header:{{ st.gap_header_to_items | default: 32 }}px;--faq7-maxw:{{ max_content_width }}px;
--faq7-h-m:{{ heading_size_m }}px;--faq7-h-d:{{ heading_size_d }}px;--faq7-heading-color:{{ heading_color }};
{%- if st.enable_custom_heading_weight -%}--faq7-hw:{{ st.heading_weight | default: 600 }};{%- endif -%}
--faq7-gap-sub:{{ st.gap_heading_to_subheading | default: 12 }}px;--faq7-sub-m:{{ subheading_size_m }}px;--faq7-sub-d:{{ subheading_size_d }}px;--faq7-sub-color:{{ subheading_color }};
--faq7-gap-items:{{ st.gap_between_items | default: 0 }}px;
--faq7-card-bg:{{ card_bg }};--faq7-card-border:{{ card_border_color }};--faq7-radius:{{ st.item_radius | default: 0 }}px;--faq7-divider:{{ divider_color }};
--faq7-py:{{ st.item_padding_y | default: 20 }}px;--faq7-px:{{ st.item_padding_x | default: 4 }}px;
--faq7-q-color:{{ question_color }};--faq7-q-m:{{ question_size_m }}px;--faq7-q-d:{{ question_size_d }}px;
{%- if st.enable_custom_question_weight -%}--faq7-qw:{{ st.question_weight | default: 600 }};{%- endif -%}
--faq7-hover:{{ hover_color }};--faq7-icon-color:{{ icon_color }};
--faq7-a-color:{{ answer_color }};--faq7-a-m:{{ answer_size_m }}px;--faq7-a-d:{{ answer_size_d }}px;
{%- endcapture -%}

{%- liquid
  comment
    Split blocks so we can render Button blocks under the header,
    then only iterate FAQ items in the accordion list.
  endcomment
  assign faq_items = section.blocks | where: 'type', 'faq_item'
  assign button_blocks = section.blocks | where: 'type', 'button'
-%}

<div class="faq7 color-{{ color_scheme }} gradient" data-faq7-root data-faq7-anim="{{ scroll_animation }}" data-faq7-width="{{ st.section_width }}"{% if st.enable_custom_heading_weight %} data-faq7-hw{% endif %}{% if st.enable_custom_question_weight %} data-faq7-qw{% endif %}{% if st.show_dividers and st.gap_between_items == 0 %} data-faq7-dividers{% endif %}{% if reveal and scroll_animation != 'none' and request.design_mode != true %} data-faq7-reveal="{{ scroll_animation }}"{% endif %} style="{{ faq7_vars | strip_newlines }}">
  <div class="faq7__inner">
    <div class="faq7__layout">
    {%- if heading != blank or subheading != blank or button_blocks.size > 0 -%}
      <div class="faq7__header">
        {%- if heading != blank -%}<h2 class="faq7__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<div class="faq7__subheading">{{ subheading }}</div>{%- endif -%}
        {%- for btn in button_blocks -%}
          {%- liquid
            assign bbs = btn.settings
            assign btn_label = bbs.label | default: fb_accessibility_learn_more
            assign btn_link  = bbs.link
            assign btn_style = bbs.style | default: 'primary'
            assign btn_size  = bbs.size  | default: 'medium'
            if bbs.use_theme_button != false
              assign btn_size = 'theme'
            endif
          -%}
          {%- capture btn_vars -%}
            --mb-bg: var(--faq7-btn-bg); --mb-text: var(--faq7-btn-color); --mb-border: var(--faq7-btn-border);
            --mb-hover-bg: var(--faq7-btn-bg-hover); --mb-hover-text: var(--faq7-btn-color-hover);
            --faq7-btn-bg: {% render 'scheme-color', color: bbs.bg_color, fallback: 'var(--btn-primary-bg-color)' %};
            --faq7-btn-color: {% render 'scheme-color', color: bbs.text_color, fallback: 'var(--btn-primary-color)' %};
            --faq7-btn-border: {% render 'scheme-color', color: bbs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};
            --faq7-btn-bg-hover: {% render 'scheme-color', color: bbs.bg_color_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
            --faq7-btn-color-hover: {% render 'scheme-color', color: bbs.text_color_hover, fallback: 'var(--btn-primary-hover-color)' %};
            {%- if bbs.use_theme_button != false -%}
              --faq7-btn-radius: var(--btn-radius, 100px); --faq7-btn-weight: var(--btn-font-weight, 600); --faq7-btn-border-width: var(--btn-border-width, 1px);
            {%- else -%}
              --faq7-btn-radius: {{ bbs.radius | default: 100 }}px;
              --mb-radius: {{ bbs.radius | default: 100 }}px;
              {%- case btn_size -%}
                {%- when 'small' -%}--mb-font-size: 13px; --mb-padding-y: 10px; --mb-padding-x: 18px;
                {%- when 'large' -%}--mb-font-size: 16px; --mb-padding-y: 16px; --mb-padding-x: 32px;
                {%- else -%}--mb-font-size: 14px; --mb-padding-y: 13px; --mb-padding-x: 24px;
              {%- endcase -%}
            {%- endif -%}
            {%- if bbs.full_width %} width: 100%;{%- endif -%}
          {%- endcapture -%}
          <div class="faq7__cta-row" id="block-{{ btn.id }}" {{ btn.shopify_attributes }}>
            {%- if btn_link != blank -%}
              <a class="faq7__btn faq7__btn--{{ btn_style }} faq7__btn--{{ btn_size }}" data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button
                 data-button-local-appearance="{% if btn_style == 'text' %}underline{% else %}theme{% endif %}" href="{{ btn_link }}"
                 style="{{ btn_vars | strip_newlines }}">
                {{ btn_label }}
              </a>
            {%- else -%}
              <span class="faq7__btn faq7__btn--{{ btn_style }} faq7__btn--{{ btn_size }} faq7__btn--disabled" data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button
                    style="{{ btn_vars | strip_newlines }}">
                {{ btn_label }}
              </span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if faq_items.size > 0 -%}
      <div class="faq7__list" data-faq7-list data-multiple="{% if allow_multiple_open %}true{% else %}false{% endif %}">
        {%- for block in faq_items -%}
          {%- liquid
            assign bs = block.settings
            assign open_first = false
            if first_item_open and forloop.first
              assign open_first = true
            endif
          -%}
          <div class="faq7__item" {% if open_first %}open{% endif %} data-faq7-item id="block-{{ block.id }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="faq7__q"
              aria-expanded="{% if open_first %}true{% else %}false{% endif %}"
              aria-controls="faq7-a-{{ sid }}-{{ forloop.index }}"
              data-faq7-trigger
            >
              <span>{{ bs.question | default: fb_accessibility_question_goes_here }}</span>
              <span class="faq7__icon" aria-hidden="true">
                {%- if open_icon == 'chevron' -%}
                  <svg class="faq7__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif open_icon == 'arrow' -%}
                  <svg class="faq7__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
                {%- else -%}
                  <span class="faq7__icon-plus"><span class="v"></span><span class="h"></span></span>
                {%- endif -%}
              </span>
            </button>
            <div class="faq7__a-wrap" id="faq7-a-{{ sid }}-{{ forloop.index }}">
              <div class="faq7__a-inner">
                <div class="faq7__a">{{ bs.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'faq-pro.js' | asset_url }}" defer></script>
{%- if request.design_mode -%}
{%- comment -%} The builder runs a redrawn or newly added section's inline scripts: load the script if this page did not have it yet, or set this section up again. {%- endcomment -%}
<script>(function(){if(window.MateriaFaqPro)return window.MateriaFaqPro.init();if(document.querySelector('script[data-faq7-boot]'))return;var s=document.createElement('script');s.src="{{ 'faq-pro.js' | asset_url }}";s.setAttribute('data-faq7-boot','');document.head.appendChild(s);})();{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

<schema>
{
  "type": "faq-pro",
  "name": "FAQ 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Max content width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Heading & Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Have a question? We're here to help.</p>"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading size (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "enable_custom_heading_weight",
      "label": "Override theme heading weight",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "600",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Items"
    },
    {
      "type": "checkbox",
      "id": "first_item_open",
      "label": "Open the first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open at once",
      "default": false
    },
    {
      "type": "select",
      "id": "open_icon",
      "label": "Toggle icon",
      "default": "plus",
      "options": [
        {
          "value": "plus",
          "label": "Plus / Minus"
        },
        {
          "value": "chevron",
          "label": "Chevron arrow"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color"
    },
    {
      "type": "range",
      "id": "gap_between_items",
      "label": "Space between items",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "label": "Item vertical padding",
      "min": 6,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding_x",
      "label": "Item horizontal padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_radius",
      "label": "Item corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Item background"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Item border color"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Question typography"
    },
    {
      "type": "range",
      "id": "question_size_desktop",
      "label": "Question size (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "question_size_mobile",
      "label": "Question size (mobile)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "enable_custom_question_weight",
      "label": "Override theme question weight",
      "default": false
    },
    {
      "type": "select",
      "id": "question_weight",
      "label": "Question weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question color"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Question hover color"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Toggle icon color"
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Answer typography"
    },
    {
      "type": "range",
      "id": "answer_size_desktop",
      "label": "Answer size (desktop)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "answer_size_mobile",
      "label": "Answer size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color"
    },
    {
      "type": "header",
      "id": "hdr_43",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal section on scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "scroll_animation",
      "label": "Reveal animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit from theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
