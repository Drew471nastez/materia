    },
    {
      "type": "range",
      "id": "answer_size_desktop",
      "label": "Answer size (desktop)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "answer_size_mobile",
      "label": "Answer size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_51",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "select",
      "id": "scroll_animation",
      "label": "Reveal style",
      "default": "inherit",
      "options": [
