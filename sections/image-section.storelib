<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign sec_id = section.id -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .loudecomz-section__{{ section.id }} {
    background: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %};
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
{% comment %}{% endcomment %}</style>
{%- style -%}
  /* Box Sizing and Image Defaults */
  .loudecomz-section__{{ sec_id }} *,
  .loudecomz-section__{{ sec_id }} *:after,
  .loudecomz-section__{{ sec_id }} *:before {
    box-sizing: border-box;
  }

  .loudecomz-section__{{ sec_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Container Styles */
  .loudecomz-container,
  .loudecomz-container-fluid {
    width: 100%;
    padding-right: var(--loudecomz-gutter-x, 15px);
    padding-left: var(--loudecomz-gutter-x, 15px);
    margin-right: auto;
    margin-left: auto;
  }

  /* Responsive Container Widths */
  @media (min-width: 576px) {
    .loudecomz-container {
      max-width: 540px;
    }
  }

  @media (min-width: 750px) {
    .loudecomz-container {
      max-width: 720px;
    }
  }

  @media (min-width: 992px) {
    .loudecomz-container {
      max-width: 960px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 960 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  @media (min-width: 1200px) {
    .loudecomz-container {
      max-width: 1140px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 1140 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  @media (min-width: 1400px) {
    .loudecomz-container {
      max-width: 1320px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width != 1320 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  /* Gutter X Adjustment for Desktop and Mobile */
  .loudecomz-section__{{ sec_id }} .loudecomz-container,
  .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
    --loudecomz-gutter-x: {{ section.settings.padding_lr_desktop }}px;
  }

  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} .loudecomz-container,
    .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
      --loudecomz-gutter-x: {{ section.settings.padding_lr_mobile }}px;
    }
  }

  /* Section Styles */
  .loudecomz-section__{{ sec_id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    position: relative;
    line-height: 1.5;
    {% if section.settings.display_on == 'mobile' %}
      display: none;
    {% elsif section.settings.display_on == 'desktop' %}
      display: none;
    {% elsif section.settings.display_on == 'none' %}
      display: none;
    {% endif %}
  }

  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }
  }

  {% if section.settings.is_fullwidth == true %}
    .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
      padding-left: 0;
      padding-right: 0;
    }
  {% endif %}

  /* Image/Video Wrapper Styles with Adjustable Margins */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper {
    position: relative;
    min-height: {{ section.settings.img_min_height }}vh;
    margin-top: {{ section.settings.image_margin_top }}px;
    margin-bottom: {{ section.settings.image_margin_bottom }}px;
  }

  /* Media (Image) Positioning */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position_x }}% {{ section.settings.background_position_y }}%;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Video Styles */
  .loudecomz-section__{{ sec_id }} .loudecomz-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position_x }}% {{ section.settings.background_position_y }}%;
  }

  /* Image Text Overlay */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text {
    position: absolute;
    max-width: 90%;
    bottom: 50px;
    z-index: 1;
    text-align: center;
    color: {% render 'scheme-color', color: section.settings.image_description_text_color, fallback: '#ffffff' %};
    border-radius: {{ section.settings.image_text_border_radius }}px;
    padding: 10px 15px;
    font-size: {{ section.settings.image_description_fz }}px;
    {% if section.settings.enable_image_text_background %}
      /* Background handled by pseudo-element */
    {% else %}
      background: none;
    {% endif %}
    /* CSS Variables for Positioning */
    left: var(--image-text-horizontal-position, {{ section.settings.image_text_horizontal_position_desktop }}%);
    right: var(--image-text-horizontal-position-right, auto);
    transform: translateX(var(--image-text-translateX, 0));
  }

  /* Pseudo-element for Background with Opacity */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {% render 'scheme-color', color: section.settings.image_text_background_color, fallback: 'transparent' %};
    opacity: {{ section.settings.image_text_background_opacity | divided_by: 100.0 }};
    border-radius: {{ section.settings.image_text_border_radius }}px;
    z-index: -1;
    display: {% if section.settings.enable_image_text_background %} block {% else %} none {% endif %};
  }

  /* Position Selector Classes */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-left {
    --image-text-horizontal-position: {{ section.settings.image_text_horizontal_position_desktop }}%;
    --image-text-horizontal-position-right: auto;
    --image-text-translateX: 0;
  }

  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-center {
    left: 50%;
    right: auto;
    --image-text-translateX: -50%;
  }

  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
    --image-text-horizontal-position: auto;
    --image-text-horizontal-position-right: {{ section.settings.image_text_horizontal_position_desktop }}%;
    --image-text-translateX: 0;
  }

  /* Responsive Styles for Mobile */
  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper {
      min-height: {{ section.settings.img_min_height_mobile }}vh;
      margin-top: {{ section.settings.image_margin_top }}px;
      margin-bottom: {{ section.settings.image_margin_bottom }}px;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper img,
    .loudecomz-section__{{ sec_id }} .loudecomz-video {
      object-position: {{ section.settings.background_position_x_mobile }}% {{ section.settings.background_position_y_mobile }}%;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text {
      font-size: {{ section.settings.image_description_fz_mobile }}px;
      bottom: 30px;
      /* Override horizontal position for mobile */
      left: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      right: auto;
      transform: translateX(-50%);
    }
    /* Adjust horizontal positioning based on mobile settings */
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-left,
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
      left: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      right: auto;
      --image-text-translateX: -50%;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
      left: auto;
      right: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      --image-text-translateX: 0;
    }
  }

  /* Display Section On Classes */
  {% if section.settings.display_on == 'mobile' %}
    /* Mobile Only */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
    @media only screen and (max-width: 749px) {
      .loudecomz-section__{{ sec_id }} {
        display: block;
      }
    }
  {% elsif section.settings.display_on == 'desktop' %}
    /* Desktop Only */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
    @media only screen and (min-width: 750px) {
      .loudecomz-section__{{ sec_id }} {
        display: block;
      }
    }
  {% elsif section.settings.display_on == 'none' %}
    /* No Devices */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
  {% endif %}
{%- endstyle -%}

{% if section.settings.custom_css != blank %}
  {%- style -%}
    .loudecomz-section__{{ sec_id }} {
      {{ section.settings.custom_css }}
    }
  {%- endstyle -%}
{% endif %}

{% if section.settings.is_fullwidth == true %}
  {% assign container = 'loudecomz-container-fluid' %}
{% else %}
  {% assign container = 'loudecomz-container' %}
{% endif %}

{% if section.settings.lazyload == true %}
  {% assign loading = 'lazy' %}
{% else %}
  {% assign loading = 'eager' %}
{% endif %}

<div class="loudecomz-section__{{ sec_id }} color-{{ color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="{{ container }}">
    <div class="loudecomz-img-wrapper">
      {% if section.settings.use_video %}
        {% if section.settings.video_url != blank %}
          <video autoplay muted loop playsinline class="loudecomz-video">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {% endif %}
      {% else %}
        {% if section.settings.background_image == blank %}
          <img
            src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
            alt=""
            loading="{{ loading }}"
            sizes="100vw"
          >
        {% else %}
          {{
            section.settings.background_image
            | image_url: width: 1920
            | image_tag: widths: '490, 750, 992, 1200, 1920', sizes: '100vw', loading: loading
          }}
        {% endif %}
      {% endif %}
      {% if section.settings.image_description != blank %}
        <div class="loudecomz-img-text position-{{ section.settings.image_description_position | downcase | replace: ' ', '-' }}">
          {{ section.settings.image_description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-section",
  "name": "Image ",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "is_fullwidth",
      "default": true,
      "label": "Full width"
    },
    {
      "type": "number",
      "id": "container_max_width",
      "label": "Max width (px)",
      "default": 1300
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "background_position_x",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Focal point X (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "background_position_y",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Focal point Y (desktop)",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "image_description",
      "label": "Caption",
      "default": "Caption text "
    },
    {
      "type": "range",
      "id": "image_description_fz",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 23
    },
    {
      "type": "range",
      "id": "image_description_fz_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 17
    },
    {
      "type": "color",
      "id": "image_description_text_color",
      "label": "Caption text"
    },
    {
      "type": "color",
      "id": "image_text_background_color",
      "label": "Caption background"
    },
    {
      "type": "range",
      "id": "image_text_background_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Background opacity",
      "default": 19
    },
    {
      "type": "checkbox",
      "id": "enable_image_text_background",
      "default": true,
      "label": "Show caption background"
    },
    {
      "type": "select",
      "id": "image_description_position",
      "label": "Caption alignment",
      "default": "bottom-left",
      "options": [
        {
          "value": "bottom-left",
          "label": "Left"
        },
        {
          "value": "bottom-center",
          "label": "Center"
        },
        {
          "value": "bottom-right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_text_horizontal_position_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Caption position (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "image_text_horizontal_position_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Caption position (mobile)",
      "default": 26
    },
    {
      "type": "range",
      "id": "image_text_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Caption corner radius",
      "default": 8
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_lr_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Side padding (desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "img_min_height",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "label": "Image height (desktop)",
      "default": 70
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Desktop"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_lr_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Side padding (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "img_min_height_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "label": "Image height (mobile)",
      "default": 50
    },
    {
      "type": "range",
      "id": "background_position_x_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Focal point X (mobile)",
      "default": 50
    },
    {
      "type": "range",
      "id": "background_position_y_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Focal point Y (mobile)",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Advanced Media"
    },
    {
      "type": "range",
      "id": "image_margin_top",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_margin_bottom",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image bottom margin",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "use_video",
      "default": false,
      "label": "Use video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "placeholder": "https://example.com/video.mp4"
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Customization"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    },
    {
      "type": "select",
      "id": "display_on",
      "label": "Show on",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Mobile Devices Only"
        },
        {
          "value": "desktop",
          "label": "Desktop/Larger Screens Only"
        },
        {
          "value": "none",
          "label": "No Devices"
        }
      ],
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "lazyload",
      "default": true,
      "label": "Lazy load image"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background"
    }
  ],
  "presets": [
    {
      "name": "Image ",
      "category": "Image and video",
      "settings": {
        "is_fullwidth": false,
        "section_padding_top": 50,
        "section_padding_bottom": 50
      }
    }
  ],
  "shopify": {
    "name": "Image ",
    "tag": "section",
    "class": "simple-image-1",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
