<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_product_label = 'accessibility.product_label' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Comparison Table 2
  Highlighted "us vs. them" comparison table with up to N product columns
  and a configurable list of feature rows. Each column is a block (image,
  title, highlighted state, per-feature values). Each row is a block (label,
  show toggle). Mobile: horizontal scroll with a subtle live progress bar.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .ct2 {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct2 {
      padding-top: {{ st.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 80 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .ct2__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .ct2__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'full_width' -%}
      /* full bleed: no constraints */
    {%- else -%}
      #shopify-section-{{ sid }} .ct2__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Header */
  #shopify-section-{{ sid }} .ct2__header {
    text-align: {{ st.header_align | default: 'center' }};
    max-width: 760px;
    margin: 0 auto {{ st.gap_header | default: 40 }}px;
  }
  #shopify-section-{{ sid }} .ct2__heading {
    margin: 0;
    color: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %} !important;
    font-weight: {% if st.heading_weight == blank or st.heading_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ st.heading_weight }}{% endif %};
    line-height: 1.15;
    font-size: {{ st.heading_size_mobile | default: 28 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct2__heading { font-size: {{ st.heading_size_desktop | default: 40 }}px; }
  }
  #shopify-section-{{ sid }} .ct2__sub {
    margin: {{ st.gap_heading_sub | default: 12 }}px auto 0;
    color: {% render 'scheme-color', color: st.sub_color, fallback: 'var(--color-text)' %} !important;
    font-size: {{ st.sub_size | default: 16 }}px;
    line-height: 1.55;
  }
  #shopify-section-{{ sid }} .ct2__sub p { margin: 0; }

  /* Table area */
  #shopify-section-{{ sid }} .ct2__viewport {
    position: relative;
  }
  #shopify-section-{{ sid }} .ct2__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: default;
  }
  #shopify-section-{{ sid }} .ct2__scroll::-webkit-scrollbar { display: none; }
  /* Only show grab cursor + enable drag when the scroller actually overflows */
  #shopify-section-{{ sid }} .ct2__scroll.is-overflowing { cursor: grab; }
  #shopify-section-{{ sid }} .ct2__scroll.is-dragging { cursor: grabbing; }

  /* Constrain overall table width so it doesn't stretch edge-to-edge on
     wide screens — matches the compact look in the reference. */
  #shopify-section-{{ sid }} .ct2__viewport {
    max-width: {{ st.table_max_width | default: 1080 }}px;
    margin-inline: auto;
  }

  /* Grid: row-labels column + N product columns */
  #shopify-section-{{ sid }} .ct2__grid {
    display: grid;
    grid-template-columns: {{ st.label_col_width | default: 180 }}px repeat(var(--ct2-cols, 3), minmax({{ st.col_min_width | default: 170 }}px, 1fr));
    gap: {{ st.col_gap | default: 16 }}px;
    align-items: stretch;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .ct2__grid {
      grid-template-columns: {{ st.label_col_width_mobile | default: 140 }}px repeat(var(--ct2-cols, 3), {{ st.col_width_mobile | default: 160 }}px);
      gap: {{ st.col_gap_mobile | default: 10 }}px;
    }
  }

  /* Label column — sticky on desktop only. On mobile the entire table
     scrolls as a single unit so the layout never appears "split". */
  #shopify-section-{{ sid }} .ct2__label-col {
    display: grid;
    grid-template-rows: {{ st.header_row_height | default: 200 }}px repeat(var(--ct2-rows, 5), 1fr);
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};
    z-index: 2;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ct2__label-col {
      {% if st.sticky_labels_desktop %}position: sticky; left: 0;{% endif %}
    }
  }
  #shopify-section-{{ sid }} .ct2__label-empty { /* empty cell above row labels */ }
  #shopify-section-{{ sid }} .ct2__row-label {
    display: flex;
    align-items: center;
    color: {% render 'scheme-color', color: st.row_label_color, fallback: 'var(--color-heading)' %};
    font-weight: {{ st.row_label_weight | default: 700 }};
    font-size: {{ st.row_label_size | default: 14 }}px;
    line-height: 1.3;
    padding: {{ st.row_label_pad | default: 12 }}px 8px {{ st.row_label_pad | default: 12 }}px 0;
    border-top: {{ st.divider_width | default: 1 }}px solid {% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %};
  }
  #shopify-section-{{ sid }} .ct2__row-label:first-of-type { border-top: 0; }

  /* Product column */
  #shopify-section-{{ sid }} .ct2__col {
    display: grid;
    grid-template-rows: {{ st.header_row_height | default: 200 }}px repeat(var(--ct2-rows, 5), 1fr);
    border-radius: {{ st.col_radius | default: 18 }}px;
    overflow: visible;
    position: relative;
  }
  #shopify-section-{{ sid }} .ct2__col-bg {
    position: absolute;
    inset: 80px 0 0 0;
    border: {{ st.col_border_width | default: 2 }}px solid {% render 'scheme-color', color: st.col_border_color, fallback: 'var(--color-border)' %};
    border-radius: {{ st.col_radius | default: 18 }}px;
    background: {% render 'scheme-color', color: st.col_bg, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %};
    z-index: 0;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .ct2__col--highlight .ct2__col-bg {
    background: {% render 'scheme-color', color: st.col_bg_highlight, fallback: 'color-mix(in srgb, var(--color-primary) 8%, var(--color-background))' %};
    border-color: {% render 'scheme-color', color: st.col_border_highlight, fallback: 'var(--color-primary)' %};
  }
  #shopify-section-{{ sid }} .ct2__col-header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 14px;
    text-align: center;
    background:
      linear-gradient({% render 'scheme-color', color: st.col_bg_top, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: st.col_bg_top, fallback: 'var(--color-background)' %} 40%, transparent);
  }
  #shopify-section-{{ sid }} .ct2__col-image {
    width: {{ st.col_image_size | default: 110 }}px;
    height: {{ st.col_image_size | default: 110 }}px;
    object-fit: contain;
    margin-bottom: 8px;
  }
  #shopify-section-{{ sid }} .ct2__col-title {
    margin: 0;
    color: {% render 'scheme-color', color: st.col_title_color, fallback: 'var(--color-heading)' %};
    font-size: {{ st.col_title_size | default: 16 }}px;
    font-weight: {% if st.col_title_weight == blank or st.col_title_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ st.col_title_weight }}{% endif %};
  }

  /* Cells */
  #shopify-section-{{ sid }} .ct2__cell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 8px;
    color: {% render 'scheme-color', color: st.cell_color, fallback: 'var(--color-text)' %};
    font-weight: {{ st.cell_weight | default: 700 }};
    font-size: {{ st.cell_size | default: 16 }}px;
    text-align: center;
    border-top: {{ st.divider_width | default: 1 }}px solid {% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %};
  }
  #shopify-section-{{ sid }} .ct2__cell:first-of-type { border-top: 0; }
  #shopify-section-{{ sid }} .ct2__col--highlight .ct2__cell {
    color: {% render 'scheme-color', color: st.cell_color_highlight, fallback: 'var(--color-primary)' %};
    border-top-color: {% render 'scheme-color', color: st.divider_color_highlight, fallback: 'color-mix(in srgb, var(--color-primary) 40%, var(--color-background))' %};
  }
  #shopify-section-{{ sid }} .ct2__cell svg { width: 22px; height: 22px; }
  #shopify-section-{{ sid }} .ct2__cell--check { color: {% render 'scheme-color', color: st.check_color, fallback: 'var(--color-primary)' %}; }
  #shopify-section-{{ sid }} .ct2__col--highlight .ct2__cell--check { color: {% render 'scheme-color', color: st.check_color_highlight, fallback: 'var(--color-primary)' %}; }
  #shopify-section-{{ sid }} .ct2__cell--cross { color: {% render 'scheme-color', color: st.cross_color, fallback: 'var(--color-text)' %}; }

  /* Progress bar */
  #shopify-section-{{ sid }} .ct2__progress {
    position: relative;
    height: {{ st.progress_height | default: 3 }}px;
    background: {% render 'scheme-color', color: st.progress_track_color, fallback: 'color-mix(in srgb, var(--color-text) 8%, transparent)' %};
    border-radius: 999px;
    margin-top: {{ st.gap_progress | default: 18 }}px;
    overflow: hidden;
    opacity: 0;
    transition: opacity .25s ease;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .ct2__progress.is-visible { opacity: 1; }
  #shopify-section-{{ sid }} .ct2__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0;
    background: {% render 'scheme-color', color: st.progress_color, fallback: 'var(--color-heading)' %};
    border-radius: 999px;
    transform-origin: left center;
    transition: width .12s linear;
  }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .ct2 { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .ct2 { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .ct2 { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .ct2 { display: block; } }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ct2__progress-bar { transition: none; }
  }
{% comment %}{% endcomment %}</style>

{%- liquid
  assign cols = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign cols_count = cols.size
  assign rows_count = rows.size
-%}

<section class="ct2 color-{{ color_scheme }} gradient {{ st.section_width }}" id="ct2-{{ sid }}">
  <div class="ct2__inner">

    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="ct2__header">
        {%- if st.heading != blank -%}
          <{{ st.heading_tag | default: 'h2' }} class="ct2__heading">{{ st.heading | escape }}</{{ st.heading_tag | default: 'h2' }}>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <div class="ct2__sub">{{ st.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if cols_count > 0 and rows_count > 0 -%}
      <div class="ct2__viewport">
        <div class="ct2__scroll" data-ct2-scroll>
          <div class="ct2__grid" style="--ct2-cols: {{ cols_count }}; --ct2-rows: {{ rows_count }};">

            {%- comment -%} Label column {%- endcomment -%}
            <div class="ct2__label-col">
              <div class="ct2__label-empty"></div>
              {%- for row in rows -%}
                <div class="ct2__row-label">{{ row.settings.label | escape }}</div>
              {%- endfor -%}
            </div>

            {%- comment -%} Product columns {%- endcomment -%}
            {%- for col in cols -%}
              {%- assign cs = col.settings -%}
              <div class="ct2__col {% if cs.highlight %}ct2__col--highlight{% endif %}" {{ col.shopify_attributes }}>
                <div class="ct2__col-bg" aria-hidden="true"></div>
                <div class="ct2__col-header">
                  {%- if cs.image -%}
                    <img class="ct2__col-image" src="{{ cs.image | image_url: width: 220 }}" alt="{{ cs.title | escape }}" loading="lazy">
                  {%- else -%}
                    <img class="ct2__col-image" src="{{ placeholder }}" alt="" loading="lazy">
                  {%- endif -%}
                  <h3 class="ct2__col-title">{{ cs.title | default: fb_accessibility_product_label | escape }}</h3>
                </div>

                {%- for row in rows -%}
                  {%- assign idx = forloop.index -%}
                  {%- assign type_key = 'type_' | append: idx -%}
                  {%- assign val_key  = 'value_' | append: idx -%}
                  {%- assign cell_type = cs[type_key] | default: 'text' -%}
                  {%- assign cell_text = cs[val_key] -%}
                  <div class="ct2__cell {% if cell_type == 'check' %}ct2__cell--check{% endif %}{% if cell_type == 'cross' %}ct2__cell--cross{% endif %}">
                    {%- case cell_type -%}
                      {%- when 'check' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      {%- when 'cross' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                      {%- else -%}
                        {%- if cell_text != blank -%}{{ cell_text | escape }}{%- else -%}—{%- endif -%}
                    {%- endcase -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endfor -%}

          </div>
        </div>

        {%- if st.show_progress -%}
          <div class="ct2__progress" data-ct2-progress aria-hidden="true">
            <div class="ct2__progress-bar" data-ct2-bar></div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  function init() {
    var section = document.querySelector('#shopify-section-{{ sid }}');
    if (!section) return;
    var scroller = section.querySelector('[data-ct2-scroll]');
    if (!scroller) return;
    if (scroller.dataset.ct2Init === '1') return;
    scroller.dataset.ct2Init = '1';

    var bar      = section.querySelector('[data-ct2-bar]');
    var progress = section.querySelector('[data-ct2-progress]');

    function update() {
      var maxScroll = scroller.scrollWidth - scroller.clientWidth;
      var canScroll = maxScroll > 1;
      scroller.classList.toggle('is-overflowing', canScroll);
      if (progress) progress.classList.toggle('is-visible', canScroll);
      if (!canScroll) {
        if (bar) bar.style.width = '0%';
        return;
      }
      var p = Math.max(0, Math.min(1, scroller.scrollLeft / maxScroll));
      if (bar) bar.style.width = (p * 100) + '%';
    }

    var raf = 0;
    scroller.addEventListener('scroll', function() {
      if (raf) return;
      raf = requestAnimationFrame(function() { raf = 0; update(); });
    }, { passive: true });

    var resizeRaf = 0;
    window.addEventListener('resize', function() {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(function() { resizeRaf = 0; update(); });
    });

    // Pointer drag-to-scroll for mouse / pen (touch uses native scroll)
    var DRAG_THRESHOLD = 6;
    var pointerActive = false;
    var pointerId = null;
    var startX = 0;
    var startScroll = 0;
    var moved = false;

    function onPointerDown(e) {
      if (e.pointerType === 'touch') return;
      if (e.button !== undefined && e.button !== 0) return;
      // Only enable drag-to-scroll when the table actually overflows
      // horizontally — on wide desktops the whole table fits and dragging
      // would feel broken.
      if (scroller.scrollWidth <= scroller.clientWidth + 1) return;
      pointerActive = true;
      pointerId = e.pointerId;
      moved = false;
      startX = e.clientX;
      startScroll = scroller.scrollLeft;
      scroller.classList.add('is-dragging');
      if (scroller.setPointerCapture && e.pointerId != null) {
        try { scroller.setPointerCapture(e.pointerId); } catch (err) {}
      }
    }
    function onPointerMove(e) {
      if (!pointerActive) return;
      if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;
      var dx = e.clientX - startX;
      if (!moved && Math.abs(dx) >= DRAG_THRESHOLD) moved = true;
      if (!moved) return;
      if (e.cancelable) e.preventDefault();
      scroller.scrollLeft = startScroll - dx;
    }
    function onPointerUp(e) {
      if (!pointerActive) return;
      pointerActive = false;
      pointerId = null;
      scroller.classList.remove('is-dragging');
      if (scroller.releasePointerCapture && e.pointerId != null) {
        try { scroller.releasePointerCapture(e.pointerId); } catch (err) {}
      }
    }
    if (window.PointerEvent) {
      scroller.addEventListener('pointerdown',   onPointerDown);
      scroller.addEventListener('pointermove',   onPointerMove);
      scroller.addEventListener('pointerup',     onPointerUp);
      scroller.addEventListener('pointercancel', onPointerUp);
    }
    scroller.addEventListener('dragstart', function(e) { e.preventDefault(); });

    requestAnimationFrame(update);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('storelib:section-load', function(e) {
    if (e.detail && e.detail.sectionId === '{{ sid }}') init();
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "comparison-table-2",
  "name": "Comparison Table 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Alignment",
      "default": "center",
