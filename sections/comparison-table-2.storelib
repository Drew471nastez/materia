<template compat="shopify">
<script src="{{ 'live-features-b.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Comparison Table 2.

  Product columns side by side: each column block has a picture, a title,
  a highlighted state and one value per feature row (text, check or cross);
  each row block names a feature. Drawn as a real table that scrolls
  sideways inside its own frame on a phone (row labels stay in view), with a
  scroll progress bar. Heading and subheading are blocks; a saved section
  without them keeps its heading and subheading settings. Colours follow the
  colour scheme until Enable custom styling is on. Live edits and the
  scroller: assets/live-features-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign cols = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign has_heading_block = false
  assign has_sub_block = false
  for b in section.blocks
    if b.type == 'heading'
      assign has_heading_block = true
    elsif b.type == 'subheading'
      assign has_sub_block = true
    endif
  endfor
  assign title_done = false
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 120 120%22%3E%3Crect width=%22120%22 height=%22120%22 rx=%2216%22 fill=%22%23888%22 fill-opacity=%22.14%22/%3E%3Cpath d=%22M38 78l16-19 11 12 8-7 14 14z%22 fill=%22%23888%22 fill-opacity=%22.45%22/%3E%3Ccircle cx=%2272%22 cy=%2246%22 r=%227%22 fill=%22%23888%22 fill-opacity=%22.45%22/%3E%3C/svg%3E'
  assign spx = 'heading_size_desktop,heading_size_mobile,sub_size,gap_heading_sub,gap_header,table_max_width,label_col_width,label_col_width_mobile,col_min_width,col_width_mobile,col_gap,col_gap_mobile,header_row_height,col_image_size,col_title_size,col_radius,col_border_width,row_label_weight:n,row_label_size,row_label_pad,cell_weight:n,cell_size,divider_width,progress_height,gap_progress,padding_top_desktop,padding_bottom_desktop,section_margin_top_desktop,section_margin_bottom_desktop,padding_top_mobile,padding_bottom_mobile,section_margin_top_mobile,section_margin_bottom_mobile'
  assign sc = 'section_bg,heading_color,sub_color,col_title_color,col_bg_top,col_bg,col_border_color,col_bg_highlight,col_border_highlight,row_label_color,cell_color,cell_color_highlight,check_color,check_color_highlight,cross_color,divider_color,divider_color_highlight,progress_color,progress_track_color'
  assign sw = 'heading_weight,col_title_weight'
  assign sf = 'enable_custom_fonts:heading_font,enable_custom_fonts:body_font'
  assign sa = 'section_width,show_section_on,header_align,sticky_labels_desktop,show_progress,reset_spacing'
  assign sa_list = sa | split: ','
  assign stx = 'check_label,cross_label'
  assign srx = 'heading,subheading'
  assign h_px = 'size_desktop,size_mobile'
-%}
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .fbt2 { --fbt2-hf: var(--fb-heading_font, var(--heading-font)); --fbt2-bf: var(--fb-body_font, var(--body-font)); background: var(--fb-section_bg, var(--color-background)); color: var(--color-text); font-family: var(--fbt2-bf); padding: var(--fb-padding_top_mobile) 0 var(--fb-padding_bottom_mobile); margin: var(--fb-section_margin_top_mobile) 0 var(--fb-section_margin_bottom_mobile); }
  #shopify-section-{{ sid }} .fbt2[data-reset_spacing='true'] { margin-block: 0; }
  #shopify-section-{{ sid }} .fbt2 *, #shopify-section-{{ sid }} .fbt2 *::before, #shopify-section-{{ sid }} .fbt2 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .fbt2__inner { margin-inline: auto; padding-inline: 16px; }
  #shopify-section-{{ sid }} .fbt2[data-section_width='container'] .fbt2__inner { max-width: calc(var(--page-width, 1300px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .fbt2[data-section_width='fluid_container'] .fbt2__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .fbt2[data-section_width='full_width'] .fbt2__inner { padding-inline: 0; }
  #shopify-section-{{ sid }} .fbt2[data-show_section_on='desktop'] { display: none; }
  #shopify-section-{{ sid }} .fbt2__head { max-width: 760px; margin: 0 auto var(--fb-gap_header); text-align: var(--fbt2-align, center); display: flex; flex-direction: column; gap: var(--fb-gap_heading_sub); }
  #shopify-section-{{ sid }} .fbt2[data-header_align='left'] { --fbt2-align: left; }
  #shopify-section-{{ sid }} .fbt2[data-header_align='right'] { --fbt2-align: right; }
  #shopify-section-{{ sid }} .fbt2[data-header_align='left'] .fbt2__head { margin-left: 0; }
  #shopify-section-{{ sid }} .fbt2[data-header_align='right'] .fbt2__head { margin-right: 0; }
  #shopify-section-{{ sid }} .fbt2__heading { margin: 0; color: var(--fb-color, var(--fb-heading_color, var(--color-heading))); font-family: var(--fbt2-hf); font-weight: var(--fb-weight, var(--fb-heading_weight, var(--heading-weight, 700))); font-size: var(--fb-size_mobile, var(--fb-heading_size_mobile)); line-height: 1.15; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt2__sub { color: var(--fb-color, var(--fb-sub_color, var(--color-text))); font-size: var(--fb-size, var(--fb-sub_size)); line-height: 1.55; }
  #shopify-section-{{ sid }} .fbt2__sub :is(p, li) { margin: 0; font-family: inherit; }
  #shopify-section-{{ sid }} .fbt2__sub p + p { margin-top: .5em; }
  #shopify-section-{{ sid }} .fbt2__viewport { max-width: var(--fb-table_max_width); margin-inline: auto; }
  #shopify-section-{{ sid }} .fbt2__scroll { position: relative; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; scrollbar-width: none; border-radius: 4px; }
  #shopify-section-{{ sid }} .fbt2__scroll::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .fbt2__scroll[data-overflow] { cursor: grab; }
  #shopify-section-{{ sid }} .fbt2__scroll[data-dragging] { cursor: grabbing; user-select: none; }
  #shopify-section-{{ sid }} .fbt2__scroll:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  #shopify-section-{{ sid }} .fbt2__table { --gap: var(--fb-col_gap_mobile); --lw: var(--fb-label_col_width_mobile); --cw: var(--fb-col_width_mobile); --line: var(--fb-divider_width) solid var(--fb-divider_color, var(--color-border)); border-collapse: separate; border-spacing: var(--gap) 0; width: 100%; min-width: calc(var(--lw) + var(--fbt2-n) * (var(--cw) + var(--gap)) + var(--gap)); table-layout: fixed; }
  #shopify-section-{{ sid }} :where(.fbt2__table, .fbt2__table th, .fbt2__table td) { border: 0; font-weight: inherit; }
  #shopify-section-{{ sid }} .fbt2__table col.fbt2__c0 { width: var(--lw); }
  #shopify-section-{{ sid }} .fbt2__label { position: sticky; left: 0; z-index: 2; background: var(--fb-section_bg, var(--color-background)); text-align: left; vertical-align: middle; color: var(--fb-row_label_color, var(--color-heading)); font-weight: var(--fb-row_label_weight); font-size: var(--fb-row_label_size); line-height: 1.3; padding: var(--fb-row_label_pad) 8px var(--fb-row_label_pad) 0; border-top: var(--line); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt2__table tbody tr:first-child > * { border-top: 0; }
  #shopify-section-{{ sid }} .fbt2__table thead .fbt2__label { border: 0; }
  #shopify-section-{{ sid }} .fbt2__col { --bg: var(--fb-col_bg, color-mix(in srgb, var(--color-text) 4%, var(--color-background))); --bd: var(--fb-col_border_color, var(--color-border)); height: var(--fb-header_row_height); padding: 12px 8px 14px; vertical-align: bottom; text-align: center; background: linear-gradient(var(--fb-col_bg_top, var(--bg)) 0 45%, var(--bg) 45%); border: var(--fb-col_border_width) solid var(--bd); border-bottom: 0; border-radius: var(--fb-col_radius) var(--fb-col_radius) 0 0; }
  #shopify-section-{{ sid }} .fbt2__col[data-highlight='true'], #shopify-section-{{ sid }} .fbt2__cell[data-highlight='true'] { --bg: var(--fb-col_bg_highlight, color-mix(in srgb, var(--color-primary) 10%, var(--color-background))); --bd: var(--fb-col_border_highlight, var(--color-primary)); }
  #shopify-section-{{ sid }} .fbt2__img { display: block; margin: 0 auto 8px; width: var(--fb-col_image_size); height: var(--fb-col_image_size); max-width: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .fbt2__ct { display: block; margin: 0; color: var(--fb-col_title_color, var(--color-heading)); font-family: var(--fbt2-hf); font-weight: var(--fb-col_title_weight, var(--heading-weight, 700)); font-size: var(--fb-col_title_size); line-height: 1.25; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt2__cell { --bg: var(--fb-col_bg, color-mix(in srgb, var(--color-text) 4%, var(--color-background))); --bd: var(--fb-col_border_color, var(--color-border)); background: var(--bg); border-inline: var(--fb-col_border_width) solid var(--bd); border-top: var(--line); padding: 12px 8px; text-align: center; vertical-align: middle; color: var(--fb-cell_color, var(--color-text)); font-weight: var(--fb-cell_weight); font-size: var(--fb-cell_size); line-height: 1.3; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .fbt2__cell[data-highlight='true'] { color: var(--fb-cell_color_highlight, var(--color-primary)); border-top-color: var(--fb-divider_color_highlight, color-mix(in srgb, var(--color-primary) 40%, var(--color-background))); }
  #shopify-section-{{ sid }} .fbt2__table tbody tr:last-child .fbt2__cell { border-bottom: var(--fb-col_border_width) solid var(--bd); border-radius: 0 0 var(--fb-col_radius) var(--fb-col_radius); }
  #shopify-section-{{ sid }} .fbt2__v { display: inline-flex; align-items: center; justify-content: center; min-height: 24px; }
  #shopify-section-{{ sid }} .fbt2__v > span { display: none; }
  #shopify-section-{{ sid }} .fbt2__v[data-v='check'] .fbt2__ok, #shopify-section-{{ sid }} .fbt2__v[data-v='cross'] .fbt2__no, #shopify-section-{{ sid }} .fbt2__v:not([data-v='check']):not([data-v='cross']) .fbt2__txt { display: inline-flex; }
  #shopify-section-{{ sid }} .fbt2__ok { color: var(--fb-check_color, var(--color-primary)); }
  #shopify-section-{{ sid }} .fbt2__cell[data-highlight='true'] .fbt2__ok { color: var(--fb-check_color_highlight, var(--color-primary)); }
  #shopify-section-{{ sid }} .fbt2__no { color: var(--fb-cross_color, color-mix(in srgb, var(--color-text) 70%, transparent)); }
  #shopify-section-{{ sid }} .fbt2__v svg { display: block; width: 24px; height: 24px; }
  #shopify-section-{{ sid }} .fb-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #shopify-section-{{ sid }} .fbt2__progress { position: relative; height: var(--fb-progress_height); margin-top: var(--fb-gap_progress); border-radius: 999px; overflow: hidden; background: var(--fb-progress_track_color, color-mix(in srgb, var(--color-text) 12%, transparent)); }
  #shopify-section-{{ sid }} .fbt2__progress[data-fit] { visibility: hidden; }
  #shopify-section-{{ sid }} .fbt2[data-show_progress='false'] .fbt2__progress { display: none; }
  #shopify-section-{{ sid }} .fbt2__bar { position: absolute; inset: 0 auto 0 0; width: 100%; background: var(--fb-progress_color, var(--color-heading)); border-radius: inherit; transform-origin: left center; transform: scaleX(var(--fb-p, 0)); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .fbt2 { padding: var(--fb-padding_top_desktop) 0 var(--fb-padding_bottom_desktop); margin: var(--fb-section_margin_top_desktop) 0 var(--fb-section_margin_bottom_desktop); }
    #shopify-section-{{ sid }} .fbt2[data-reset_spacing='true'] { margin-block: 0; }
    #shopify-section-{{ sid }} .fbt2[data-show_section_on='desktop'] { display: block; }
    #shopify-section-{{ sid }} .fbt2[data-show_section_on='mobile'] { display: none; }
    #shopify-section-{{ sid }} .fbt2__heading { font-size: var(--fb-size_desktop, var(--fb-heading_size_desktop)); }
    #shopify-section-{{ sid }} .fbt2__table { --gap: var(--fb-col_gap); --lw: var(--fb-label_col_width); --cw: var(--fb-col_min_width); }
    #shopify-section-{{ sid }} .fbt2__progress:not([data-overflow]) { visibility: hidden; }
    #shopify-section-{{ sid }} .fbt2__label { position: static; }
    #shopify-section-{{ sid }} .fbt2[data-sticky_labels_desktop='true'] .fbt2__label { position: sticky; }
  }
{% comment %}{% endcomment %}</style>
{%- capture spec -%}{"px":"{{ spx }}","c":"{{ sc }}","w":"{{ sw }}","f":"{{ sf }}","a":"{{ sa }}","t":"{{ stx }}","r":"{{ srx }}"}{%- endcapture -%}
{%- capture bspec -%}{"heading":{"px":"{{ h_px }}","c":"color","w":"weight","r":"text"},"subheading":{"px":"size","c":"color","r":"text"},"row":{"t":"label"},"column":{"t":"title,value_1,value_2,value_3,value_4,value_5,value_6,value_7,value_8","v":"type_1,type_2,type_3,type_4,type_5,type_6,type_7,type_8","a":"highlight","i":"image"}}{%- endcapture -%}
<section class="fbt2 color-{{ color_scheme }} gradient" data-fb-root="comparison-table-2" data-fb-section="{{ sid }}"{% if request.design_mode %} data-fb-settings="{{ st | json | escape }}"{% endif %}{% if request.design_mode %} data-fb-spec="{{ spec | escape }}"{% endif %}{% if request.design_mode %} data-fb-bspec="{{ bspec | escape }}"{% endif %}{% for k in sa_list %} data-{{ k }}="{{ st[k] }}"{% endfor %}{% if st.enable_custom_fonts and st.body_font.family != blank %} data-own-font{% endif %} data-fb-f="body_font" style="{% render 'features-b-vars', s: st, px: spx, c: sc, w: sw, f: sf, gate: st.enable_custom_style %}">
  <div class="fbt2__inner">
    <div class="fbt2__head">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- if block.type == 'heading' -%}
          <h2{% unless title_done %} id="fb-title-{{ sid }}"{% assign title_done = true %}{% endunless %} class="fbt2__heading" data-fb-block="{{ block.id }}" data-fb-type="heading"{% if request.design_mode %} data-fb-bs="{{ bs | json | escape }}"{% endif %} data-fb-bt="{{ block.id }}:text" data-fb-bw="{{ block.id }}:weight" data-fb-f="heading_font"{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %} style="{% render 'features-b-vars', s: bs, px: h_px, c: 'color', w: 'weight', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
        {%- elsif block.type == 'subheading' -%}
          <div class="fbt2__sub" data-fb-block="{{ block.id }}" data-fb-type="subheading"{% if request.design_mode %} data-fb-bs="{{ bs | json | escape }}"{% endif %} data-fb-bt="{{ block.id }}:text" style="{% render 'features-b-vars', s: bs, px: 'size', c: 'color', gate: bs.enable_custom_style %}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endif -%}
      {%- endfor -%}
      {%- unless has_heading_block -%}
        {%- if st.heading != blank -%}{%- assign title_done = true -%}<h2 id="fb-title-{{ sid }}" class="fbt2__heading" data-fb-t="heading" data-fb-w="heading_weight" data-fb-f="heading_font"{% if st.heading_weight != blank and st.heading_weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %}>{{ st.heading | escape }}</h2>{%- endif -%}
      {%- endunless -%}
      {%- unless has_sub_block -%}
        {%- if st.subheading != blank -%}<div class="fbt2__sub" data-fb-t="subheading">{{ st.subheading }}</div>{%- endif -%}
      {%- endunless -%}
    </div>

    {%- if cols.size > 0 and rows.size > 0 -%}
      <div class="fbt2__viewport">
        <div class="fbt2__scroll" data-fb-scroll role="region" {% if title_done %}aria-labelledby="fb-title-{{ sid }}"{% else %}aria-label="{{ cols.first.settings.title | escape }}"{% endif %} tabindex="0">
          <table class="fbt2__table" style="--fbt2-n: {{ cols.size }};">
            <colgroup><col class="fbt2__c0">{% for col in cols %}<col>{% endfor %}</colgroup>
            <thead>
              <tr>
                <td class="fbt2__label"></td>
                {%- for col in cols -%}
                  {%- assign cs = col.settings -%}
                  <th scope="col" class="fbt2__col" data-fb-block="{{ col.id }}" data-fb-type="column"{% if request.design_mode %} data-fb-bs="{{ cs | json | escape }}"{% endif %} data-highlight="{{ cs.highlight }}" {{ col.shopify_attributes }}>
                    <img class="fbt2__img" data-fb-bi="{{ col.id }}:image" data-fb-ph="{{ placeholder }}" src="{% if cs.image != blank %}{{ cs.image | image_url: width: 440 }}{% else %}{{ placeholder }}{% endif %}" alt="" width="220" height="220" loading="lazy"{% if cs.image == blank %} data-fb-empty{% endif %}>
                    <span class="fbt2__ct" data-fb-bt="{{ col.id }}:title" data-fb-w="col_title_weight" data-fb-f="heading_font"{% if st.col_title_weight != blank and st.col_title_weight != 'theme' %} data-own-weight{% endif %}{% if st.enable_custom_fonts and st.heading_font.family != blank %} data-own-font{% endif %}>{{ cs.title | escape }}</span>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in rows -%}
                {%- assign idx = forloop.index -%}
                {%- assign type_key = 'type_' | append: idx -%}
                {%- assign val_key = 'value_' | append: idx -%}
                <tr>
                  <th scope="row" class="fbt2__label" data-fb-block="{{ row.id }}" data-fb-type="row"{% if request.design_mode %} data-fb-bs="{{ row.settings | json | escape }}"{% endif %} data-fb-bt="{{ row.id }}:label" {{ row.shopify_attributes }}>{{ row.settings.label | escape }}</th>
                  {%- for col in cols -%}
                    {%- assign cs = col.settings -%}
                    <td class="fbt2__cell" data-fb-block="{{ col.id }}" data-highlight="{{ cs.highlight }}">
                      <span class="fbt2__v" data-fb-bv="{{ col.id }}:{{ type_key }}" data-v="{{ cs[type_key] | default: 'text' }}">
                        <span class="fbt2__ok"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11" fill="currentColor" opacity=".16"/><path d="M6.5 12.5l3.6 3.6 7.4-8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="fb-vh" data-fb-t="check_label">{{ st.check_label }}</span></span>
                        <span class="fbt2__no"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.5 7.5l9 9M16.5 7.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="fb-vh" data-fb-t="cross_label">{{ st.cross_label }}</span></span>
                        <span class="fbt2__txt" data-fb-bt="{{ col.id }}:{{ val_key }}">{{ cs[val_key] | escape }}</span>
                      </span>
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="fbt2__progress" data-fb-progress aria-hidden="true"><span class="fbt2__bar"></span></div>
      </div>
    {%- endif -%}
  </div>
</section>
</template>

<schema>
{
  "type": "comparison-table-2",
  "name": "Comparison Table 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
