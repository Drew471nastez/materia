        {
          "type": "heading",
          "settings": {
            "text": "REAL BENEFITS, REAL RESULTS"
          }
        },
        {
          "type": "benefits_group"
        },
        {
          "type": "benefit",
          "settings": {
            "icon_source": "library",
            "icon_name": "drop",
            "heading": "Deep hydration",
            "text": "<p>Locks in moisture for up to 24 hours so skin stays soft and supple.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_source": "library",
            "icon_name": "leaf",
            "heading": "Clean ingredients",
            "text": "<p>Plant-based formula, free from parabens, sulfates, and synthetic dyes.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_source": "library",
            "icon_name": "sparkle",
            "heading": "Visible glow",
            "text": "<p>Brightens dull skin and restores a radiant, healthy-looking finish.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_source": "library",
            "icon_name": "shield",
            "heading": "All-day protection",
            "text": "<p>A lightweight barrier that defends against pollution and dryness.</p>"
          }
        },
        {
          "type": "footnote",
          "settings": {
            "text": "Tested on 20,000+ customers"
          }
        }
      ]
    }
  ],
