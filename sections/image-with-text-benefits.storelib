            "type": "header",
            "content": "Video playback"
          },
          {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Autoplay",
            "default": true,
            "info": "Stops when visitors ask for reduced motion.",
            "visible_if": "{{ block.settings.media_type != 'image' }}"
          },
          {
            "type": "checkbox",
            "id": "muted",
            "label": "Muted",
            "default": true,
            "visible_if": "{{ block.settings.media_type != 'image' }}"
          },
          {
            "type": "checkbox",
            "id": "loop",
            "label": "Loop",
            "default": true,
            "visible_if": "{{ block.settings.media_type != 'image' }}"
          },
          {
            "type": "checkbox",
