<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_media = 'accessibility.media' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Benefits

  Two-column layout: media on the left, heading + benefits grid on the right.
  Benefits render as a responsive grid (default 2 per row → 2×2 with 4 blocks).

  Block types:
    • media       — image OR video (image_picker, Shopify video, video URL,
                    + per-block: show controls, autoplay, muted, loop)
    • heading     — section heading text
    • subheading  — supporting copy under the heading
    • footnote    — small line under the benefits
    • benefit     — icon + heading + body. Icon source: library / image / SVG code.

  Media layout (same as IWT Stats):
    • Auto: 1 → single, 2 → side-by-side, 3+ → carousel
    • Or pick exact per-row count: 1 / 1.2 / 1.5 / 2 / 2.5 / 3
    • 3+ slots = horizontal scroll with slim light-gray progress bar
    • Mouse-drag + native touch swipe enabled
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.media_position
    when 'right'
      assign _flex_dir = 'row-reverse'
    else
      assign _flex_dir = 'row'
  endcase

  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase

  assign media_blocks = section.blocks | where: 'type', 'media'
  assign media_count  = media_blocks | size

  assign per_row = st.per_row | default: '1.2'
  if per_row == 'auto'
    if media_count <= 1
      assign per_row_value = 1
      assign final_layout = 'single'
    elsif media_count == 2
      assign per_row_value = 2
      assign final_layout = 'side_by_side'
    else
      assign per_row_value = 2.5
      assign final_layout = 'carousel'
    endif
  else
    assign per_row_value = per_row | times: 1.0
    if media_count > per_row_value
      assign final_layout = 'carousel'
    elsif per_row_value <= 1
      assign final_layout = 'single'
    elsif media_count <= 1
      assign final_layout = 'single'
    else
      assign final_layout = 'side_by_side'
    endif
  endif

  assign slot_width_pct = 100.0 | divided_by: per_row_value

  assign benefits_per_row_d = st.benefits_per_row_desktop | default: 2
  assign benefits_per_row_m = st.benefits_per_row_mobile  | default: 1
-%}

<style>
  /* Custom fonts (toggle, off by default) */
  {%- if st.enable_custom_fonts and st.body_font -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} :is(p, div, span, a, li) {
      font-family: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};
      font-weight: {{ st.body_font.weight }};
    }
  {%- endif -%}
  {%- if st.enable_custom_fonts and st.heading_font -%}
    #shopify-section-{{ sid }} :is(h1, h2, h3, h4, h5, h6),
    #shopify-section-{{ sid }} .iwb__heading,
    #shopify-section-{{ sid }} .iwb__benefit-heading {
      font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
      font-weight: {{ st.heading_font.weight }};
    }
  {%- endif -%}

  {%- if st.section_bg != blank and st.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .iwb { background: {{ st.section_bg }}; }
  {%- endif -%}
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .iwb__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .iwb__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .iwb__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  #shopify-section-{{ sid }} .iwb {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwb {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwb__inner { width: 100%; box-sizing: border-box; }

  /* Two-column grid */
  #shopify-section-{{ sid }} .iwb__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 32 }}px;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwb__grid {
      flex-direction: {{ _flex_dir }};
      gap: {{ st.gap_desktop | default: 64 }}px;
      align-items: center;
    }
  }
  #shopify-section-{{ sid }} .iwb__media,
  #shopify-section-{{ sid }} .iwb__text { width: 100%; box-sizing: border-box; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwb__media { width: {{ st.media_column_width | default: 50 }}%; }
    #shopify-section-{{ sid }} .iwb__text  { width: calc(100% - {{ st.media_column_width | default: 50 }}%); }
  }
  #iwb-{{ sid }}.iwb--no-media .iwb__media { display: none; }
  @media (min-width: 900px) {
    #iwb-{{ sid }}.iwb--no-media .iwb__text {
      width: 100%;
      max-width: {{ st.text_max_width | default: 900 }}px;
      margin-inline: auto;
    }
  }

  /* Media area */
  #shopify-section-{{ sid }} .iwb__media-grid {
    display: flex;
    gap: {{ st.media_gap | default: 12 }}px;
    width: 100%;
  }
  #shopify-section-{{ sid }} .iwb__media-grid--single { flex-direction: column; }
  #shopify-section-{{ sid }} .iwb__media-grid--side_by_side { flex-direction: row; }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel {
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 6px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-x;
  }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel.iwb--dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel.iwb--dragging * { pointer-events: none !important; }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel img,
  #shopify-section-{{ sid }} .iwb__media-grid--carousel video { -webkit-user-drag: none; user-drag: none; }

  #shopify-section-{{ sid }} .iwb__slot {
    flex: 0 0 auto;
    border-radius: {{ st.media_radius | default: 16 }}px;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
    aspect-ratio: {{ st.media_aspect_w | default: 3 }} / {{ st.media_aspect_h | default: 4 }};
    position: relative;
    isolation: isolate;
    contain: layout paint;
  }
  #shopify-section-{{ sid }} .iwb__media-grid--single .iwb__slot { width: 100%; }
  #shopify-section-{{ sid }} .iwb__media-grid--side_by_side .iwb__slot {
    flex: 1 1 calc({{ slot_width_pct }}% - {{ st.media_gap | default: 12 }}px);
    min-width: 0;
  }
  #shopify-section-{{ sid }} .iwb__media-grid--carousel .iwb__slot {
    width: calc({{ slot_width_pct }}% - {{ st.media_gap | default: 12 | times: 0.5 | round: 1 }}px);
    scroll-snap-align: start;
  }
  #shopify-section-{{ sid }} .iwb__slot img,
  #shopify-section-{{ sid }} .iwb__slot video,
  #shopify-section-{{ sid }} .iwb__slot .video-wrapper,
  #shopify-section-{{ sid }} .iwb__slot .video-wrapper > * {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Slim light-gray progress bar */
  #shopify-section-{{ sid }} .iwb__progress {
    position: relative;
    width: 100%;
    height: {{ st.progress_height | default: 2 }}px;
    margin-top: {{ st.progress_margin | default: 18 }}px;
    background: {% render 'scheme-color', color: st.progress_track, fallback: 'var(--color-border)' %};
    border-radius: 999px;
    overflow: hidden;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .iwb__progress-fill {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 0%;
    background: {% render 'scheme-color', color: st.progress_fill, fallback: 'var(--color-heading)' %};
    border-radius: 999px;
    transition: width .15s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .iwb__progress-fill { transition: none; }
    #shopify-section-{{ sid }} .iwb__media-grid--carousel { scroll-behavior: auto; }
  }

  /* Right column */
  #shopify-section-{{ sid }} .iwb__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 24 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwb__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .iwb__text > * { margin: 0; max-width: 100%; }

  #shopify-section-{{ sid }} .iwb__heading {
    font-weight: var(--heading-weight, 800);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .iwb__subheading {
    line-height: 1.6;
    max-width: 540px;
  }
  #shopify-section-{{ sid }} .iwb__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iwb__subheading p:last-child { margin: 0; }

  /* Per-block heading / subheading / footnote styling */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .iwb__heading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
        font-size: {{ bs.size_mobile | default: 32 }}px;
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwb__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 48 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .iwb__subheading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size_mobile | default: 14 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwb__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 16 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'footnote' -%}
      #shopify-section-{{ sid }} .iwb__footnote[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size | default: 13 }}px;
        margin-top: {{ bs.margin_top | default: 12 }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  /* Benefits grid */
  #shopify-section-{{ sid }} .iwb__benefits {
    display: grid;
    grid-template-columns: repeat({{ benefits_per_row_m }}, minmax(0, 1fr));
    gap: {{ st.benefit_gap_mobile | default: 20 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwb__benefits {
      grid-template-columns: repeat({{ benefits_per_row_d }}, minmax(0, 1fr));
      gap: {{ st.benefit_gap_desktop | default: 28 }}px;
    }
  }

  #shopify-section-{{ sid }} .iwb__benefit {
    display: flex;
    flex-direction: {% if st.benefit_layout == 'horizontal' %}row{% else %}column{% endif %};
    align-items: {% if st.benefit_layout == 'horizontal' %}flex-start{% else %}flex-start{% endif %};
    gap: {{ st.benefit_inner_gap | default: 12 }}px;
    padding: {{ st.benefit_padding | default: 0 }}px;
    background: {% render 'scheme-color', color: st.benefit_bg, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %};
    border: {{ st.benefit_border_width | default: 0 }}px solid {% render 'scheme-color', color: st.benefit_border_color, fallback: 'var(--color-border)' %};
    border-radius: {{ st.benefit_radius | default: 12 }}px;
    text-align: {% if st.benefit_layout == 'horizontal' %}left{% else %}{{ _ta }}{% endif %};
  }
  #shopify-section-{{ sid }} .iwb__benefit-icon {
    flex-shrink: 0;
    width: {{ st.icon_size | default: 40 }}px;
    height: {{ st.icon_size | default: 40 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-primary)' %};
    background: {% render 'scheme-color', color: st.icon_bg, fallback: 'transparent' %};
    border-radius: {{ st.icon_radius | default: 8 }}px;
    padding: {{ st.icon_padding | default: 0 }}px;
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .iwb__benefit-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #shopify-section-{{ sid }} .iwb__benefit-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ sid }} .iwb__benefit-icon svg[data-iwb-fill] {
    fill: currentColor;
    stroke: none;
  }
  #shopify-section-{{ sid }} .iwb__benefit-body {
    flex: 1 1 auto;
    min-width: 0;
  }
  #shopify-section-{{ sid }} .iwb__benefit-heading {
    font-size: {{ st.benefit_heading_size | default: 17 }}px;
    font-weight: var(--heading-weight, 700);
    color: {% render 'scheme-color', color: st.benefit_heading_color, fallback: 'var(--color-heading)' %};
    line-height: 1.3;
    margin: 0 0 {{ st.benefit_heading_gap | default: 6 }}px 0;
  }
  #shopify-section-{{ sid }} .iwb__benefit-text {
    font-size: {{ st.benefit_text_size | default: 14 }}px;
    color: {% render 'scheme-color', color: st.benefit_text_color, fallback: 'var(--color-text)' %};
    line-height: 1.5;
  }
  #shopify-section-{{ sid }} .iwb__benefit-text p { margin: 0 0 0.5em 0; }
  #shopify-section-{{ sid }} .iwb__benefit-text p:last-child { margin: 0; }
{% comment %}{% endcomment %}</style>

<div id="iwb-{{ sid }}" class="iwb section sec__image-text-benefits color-{{ color_scheme }} gradient{% if media_count == 0 %} iwb--no-media{% endif %}" data-section-id="{{ sid }}">
  <div class="iwb__inner">
    <div class="iwb__grid">

      {%- if media_count > 0 -%}
        <div class="iwb__media">
          <div class="iwb__media-grid iwb__media-grid--{{ final_layout }}" {% if final_layout == 'carousel' %}data-iwb-carousel="1"{% endif %}>
            {%- for blk in media_blocks -%}
              {%- assign mb = blk.settings -%}
              <div class="iwb__slot" {{ blk.shopify_attributes }}>
                {%- liquid
                  assign use_video = false
                  if mb.media_type == 'video' or mb.media_type == 'video_url'
                    assign use_video = true
                  endif
                  assign autoplay = mb.autoplay
                  if autoplay == nil
                    assign autoplay = true
                  endif
                  assign muted = mb.muted
                  if muted == nil
                    assign muted = true
                  endif
                  assign loop_video = mb.loop
                  if loop_video == nil
                    assign loop_video = true
                  endif
                -%}
                {%- if mb.media_type == 'video' and mb.video != blank -%}
                  {{ mb.video | video_tag: autoplay: autoplay, muted: muted, playsinline: true, loop: loop_video, controls: mb.show_controls, image_size: '1200x' }}
                {%- elsif mb.media_type == 'video_url' and mb.video_url != blank -%}
                  <video
                    src="{{ mb.video_url }}"
                    {% if autoplay %}autoplay{% endif %}
                    {% if muted %}muted{% endif %}
                    {% if loop_video %}loop{% endif %}
                    {% if mb.show_controls %}controls{% endif %}
                    playsinline></video>
                {%- elsif mb.image != blank -%}
                  <img
                    src="{{ mb.image | image_url: width: 1200 }}"
                    srcset="{{ mb.image | image_url: width: 600 }} 600w,
                            {{ mb.image | image_url: width: 900 }} 900w,
                            {{ mb.image | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 900px) {{ slot_width_pct | round: 1 }}vw, {{ slot_width_pct | round: 1 }}vw"
                    alt="{{ mb.image.alt | default: fb_accessibility_media | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if final_layout == 'carousel' and media_count > 1 -%}
            <div class="iwb__progress" data-iwb-progress role="progressbar" aria-label="{{ 'accessibility.carousel_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="iwb__progress-fill" data-iwb-progress-fill></div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="iwb__text">
        {%- assign all_benefits     = section.blocks | where: 'type', 'benefit' -%}
        {%- assign benefits_anchors = section.blocks | where: 'type', 'benefits_group' -%}
        {%- assign has_anchor       = false -%}
        {%- if benefits_anchors.size > 0 -%}{%- assign has_anchor = true -%}{%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- assign htag = bs.tag | default: 'h2' -%}
              <{{ htag }} class="iwb__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text | escape }}{%- else -%}Heading text{%- endif -%}</{{ htag }}>

            {%- when 'subheading' -%}
              <div class="iwb__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text }}{%- else -%}<p>{{ 'accessibility.add_supporting_copy' | t }}</p>{%- endif -%}</div>

            {%- when 'benefits_group' -%}
              <div class="iwb__benefits" {{ block.shopify_attributes }}>
                {%- if all_benefits.size > 0 -%}
                  {%- for ben in all_benefits -%}
                    {%- assign bb = ben.settings -%}
                    <div class="iwb__benefit" {{ ben.shopify_attributes }}>
                      <div class="iwb__benefit-icon">{%- render 'iwb-icon', bb: bb -%}</div>
                      <div class="iwb__benefit-body">
                        <div class="iwb__benefit-heading">{%- if bb.heading != blank -%}{{ bb.heading | escape }}{%- else -%}Benefit heading{%- endif -%}</div>
                        <div class="iwb__benefit-text">{%- if bb.text != blank -%}{{ bb.text }}{%- else -%}<p>{{ 'accessibility.describe_benefit' | t }}</p>{%- endif -%}</div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="iwb__benefit"><div class="iwb__benefit-body" style="opacity:.6">{{ 'accessibility.add_benefit_blocks' | t }}</div></div>
                {%- endif -%}
              </div>

            {%- when 'benefit' -%}
              {%- if has_anchor == false -%}
                {%- assign prev_index = forloop.index0 | minus: 1 -%}
                {%- assign prev_block = section.blocks[prev_index] -%}
                {%- assign open_group = false -%}
                {%- if forloop.first -%}{%- assign open_group = true -%}{%- elsif prev_block.type != 'benefit' -%}{%- assign open_group = true -%}{%- endif -%}
                {%- if open_group -%}<div class="iwb__benefits iwb__benefits--orphan">{%- endif -%}

                {%- assign bb = bs -%}
                <div class="iwb__benefit" {{ block.shopify_attributes }}>
                  <div class="iwb__benefit-icon">{%- render 'iwb-icon', bb: bb -%}</div>
                  <div class="iwb__benefit-body">
                    <div class="iwb__benefit-heading">{%- if bb.heading != blank -%}{{ bb.heading | escape }}{%- else -%}Benefit heading{%- endif -%}</div>
                    <div class="iwb__benefit-text">{%- if bb.text != blank -%}{{ bb.text }}{%- else -%}<p>{{ 'accessibility.describe_benefit' | t }}</p>{%- endif -%}</div>
                  </div>
                </div>

                {%- assign next_index = forloop.index0 | plus: 1 -%}
                {%- assign next_block = section.blocks[next_index] -%}
                {%- assign close_group = false -%}
                {%- if forloop.last -%}{%- assign close_group = true -%}{%- elsif next_block.type != 'benefit' -%}{%- assign close_group = true -%}{%- endif -%}
                {%- if close_group -%}</div>{%- endif -%}
              {%- endif -%}

            {%- when 'footnote' -%}
              <p class="iwb__footnote" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text | escape }}{%- else -%}Add a small note here.{%- endif -%}</p>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var SID = {{ sid | json }};
    window.__iwbInit = window.__iwbInit || {};
    function init() {
    var section = document.getElementById('iwb-' + SID);
    if (!section) return;

    var carousel = section.querySelector('[data-iwb-carousel="1"]');
    if (!carousel || carousel.__iwbReady) return;
    carousel.__iwbReady = true;
    if (window.__iwbInit[SID]) window.__iwbInit[SID].abort();
    var ac = typeof AbortController !== 'undefined' ? new AbortController() : null;
    window.__iwbInit[SID] = ac;
    var sig = ac ? ac.signal : undefined;
    var progress = section.querySelector('[data-iwb-progress]');
    var fill     = section.querySelector('[data-iwb-progress-fill]');

    function update() {
      if (!progress || !fill) return;
      var max = carousel.scrollWidth - carousel.clientWidth;
      if (max <= 0) { fill.style.width = '100%'; progress.setAttribute('aria-valuenow', '100'); return; }
      var pct = Math.max(0, Math.min(100, (carousel.scrollLeft / max) * 100));
      fill.style.width = pct + '%';
      progress.setAttribute('aria-valuenow', Math.round(pct));
    }
    if (progress) {
      progress.addEventListener('click', function(e) {
        var rect = progress.getBoundingClientRect();
        var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        var max = carousel.scrollWidth - carousel.clientWidth;
        carousel.scrollTo({ left: max * pct, behavior: 'smooth' });
      });
    }
    var ticking = false;
    carousel.addEventListener('scroll', function() {
      if (!ticking) { window.requestAnimationFrame(function(){ update(); ticking = false; }); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', update, { signal: sig });
    update();

    var isDown = false, moved = false, startX = 0, startScroll = 0, lastX = 0, velocity = 0, lastT = 0;
    var DRAG_THRESHOLD = 5;
    function onDown(e) {
      if (e.button !== undefined && e.button !== 0) return;
      isDown = true; moved = false;
      startX = e.pageX; lastX = e.pageX; lastT = Date.now(); velocity = 0;
      startScroll = carousel.scrollLeft;
    }
    function onMove(e) {
      if (!isDown) return;
      var dx = e.pageX - startX;
      if (!moved && Math.abs(dx) < DRAG_THRESHOLD) return;
      if (!moved) { moved = true; carousel.classList.add('iwb--dragging'); }
      e.preventDefault();
      var now = Date.now();
      var dt = Math.max(1, now - lastT);
      velocity = (e.pageX - lastX) / dt;
      lastX = e.pageX; lastT = now;
      carousel.scrollLeft = startScroll - dx;
    }
    function onUp() {
      if (!isDown) return;
      isDown = false;
      if (moved) {
        var v = velocity * 18;
        var start = carousel.scrollLeft;
        var target = start - v;
        var max = carousel.scrollWidth - carousel.clientWidth;
        target = Math.max(0, Math.min(max, target));
        carousel.scrollTo({ left: target, behavior: 'smooth' });
        setTimeout(function(){ carousel.classList.remove('iwb--dragging'); }, 320);
        var swallow = function(ev){ ev.stopPropagation(); ev.preventDefault(); };
        carousel.addEventListener('click', swallow, { capture: true, once: true });
      } else {
        carousel.classList.remove('iwb--dragging');
      }
    }
    carousel.addEventListener('mousedown', onDown);
    window.addEventListener('mousemove', onMove, { passive: false, signal: sig });
    window.addEventListener('mouseup', onUp, { signal: sig });
    window.addEventListener('blur', onUp, { signal: sig });
    carousel.addEventListener('dragstart', function(e){ e.preventDefault(); });

    carousel.setAttribute('tabindex', '0');
    carousel.addEventListener('keydown', function(e) {
      var slots = carousel.querySelectorAll('.iwb__slot');
      if (!slots.length) return;
      var step = slots[0].offsetWidth + 12;
      if (e.key === 'ArrowLeft')  { e.preventDefault(); carousel.scrollBy({ left: -step, behavior: 'smooth' }); }
      if (e.key === 'ArrowRight') { e.preventDefault(); carousel.scrollBy({ left:  step, behavior: 'smooth' }); }
    });
    }
    init();
    if (!window['__iwbLoad' + SID]) {
      window['__iwbLoad' + SID] = true;
      document.addEventListener('storelib:section-load', function(ev) {
        if (ev.detail && ev.detail.sectionId == SID) init();
      });
    }
  })();
{% comment %}{% endcomment %}</script>



</template>

