          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 18,
          "max": 56,
          "step": 1,
          "unit": "px",
          "default": 32
