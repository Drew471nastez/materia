    "blocks": [
      {
        "type": "media",
        "name": "Image / Video",
        "settings": [
          {
            "type": "header",
            "content": "Media"
          },
          {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "image",
            "options": [
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "video",
                "label": "Video (uploaded to Storelib)"
              },
              {
                "value": "video_url",
                "label": "Video URL (external .mp4)"
              }
            ]
          },
          {
            "type": "image_picker",
            "id": "image",
