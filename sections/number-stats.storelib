<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>

<style>
  /* ── Theme typography (from your Typography Preset) ── */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  
  /* ── Section margin sliders ── */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* ── Section width — CSS-only, no HTML wrapper ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}

  /* ── Reset spacing ── */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} {
      margin-bottom: 0 !important;
      margin-top: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->

<style>
  {%- capture sp_content -%}
  {% if section.settings.override_fonts %}
      {{ section.settings.text_font | font_face }}
      {{ section.settings.headline_font | font_face }}
  {% endif %}

  /* Text Elements */
  #loudecoms-{{ section.id }} p {
      font-size: {{ section.settings.description_size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
      {% endif %}
      margin: 0 0 {{ section.settings.element_spacing }}px 0;
      padding: 0;
      color: {% render 'scheme-color', color: section.settings.description_text_color, fallback: 'var(--color-text)' %} !important;
  }

  #loudecoms-{{ section.id }} ul,
  #loudecoms-{{ section.id }} ol {
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
  }

  #loudecoms-{{ section.id }} li {
    font-size: {{ section.settings.description_size }}px;
    {% if section.settings.override_fonts %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
    margin: 0 0 5px 0;
    padding: 0;
    color: {% render 'scheme-color', color: section.settings.description_text_color, fallback: 'var(--color-text)' %} !important;
  }

  #loudecoms-{{ section.id }} li:last-child {
    margin: 0;
  }

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} p,
      #loudecoms-{{ section.id }} li {
        font-size: {{ section.settings.mobile_description_size }}px;
      }
  }

  /* Section Container */
  #loudecoms-{{ section.id }} {
      position: relative;
      background-color: {% render 'scheme-color', color: section.settings.section_background_custom_color, fallback: 'var(--color-background)' %} !important;
      isolation: isolate;
      width: 100%;
      box-sizing: border-box;
      padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_left_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_right }}px;
      overflow: hidden;
  }

  {% if section.settings.section_background_image %}
  #loudecoms-{{ section.id }}::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url({{ section.settings.section_background_image | image_url }});
      background-repeat: no-repeat;
      background-position: center;
      background-size: {{ section.settings.section_background_size }};
      filter: brightness({{ section.settings.section_bg_image_brightness }}%);
      z-index: -1;
  }
  {% endif %}

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} {
        padding: {{ section.settings.mobile_section_padding_top }}px {{ section.settings.mobile_section_padding_left_right }}px {{ section.settings.mobile_section_padding_bottom }}px {{ section.settings.mobile_section_padding_left_right }}px;
      }
  }

  {% if section.settings.show_on_device == 'mobile' %}
    @media (min-width: 801px) {
        #loudecoms-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  {% if section.settings.show_on_device == 'desktop' %}
    @media (max-width: 800px) {
        #loudecoms-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  /* Inner Container */
  #loudecoms-{{ section.id }} .loudecoms-container {
      position: relative;
      margin: 0 auto;
      background: {{ section.settings.container_background_color | default: 'transparent' }};
      border-radius: {{ section.settings.container_radius }}px;
      border: {{ section.settings.container_border_size }}px solid {% render 'scheme-color', color: section.settings.container_border_color, fallback: 'var(--color-border)' %};
      max-width: {{ section.settings.container_max_width }}px;
      padding: {{ section.settings.container_padding_top_bottom }}px {{ section.settings.container_padding_left_right }}px;
  }

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .loudecoms-container {
        padding: {{ section.settings.mobile_container_padding_top_bottom }}px {{ section.settings.mobile_container_padding_left_right }}px;
      }
  }

  #loudecoms-{{ section.id }} .loudecoms-headline {
    margin: 0;
    padding: 0 0 {{ section.settings.headline_spacing }}px 0;
  }

  #loudecoms-{{ section.id }} .loudecoms-headline * {
    text-align: {{ section.settings.text_alignment }};
  }

  @media only screen and (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-headline * {
      text-align: {{ section.settings.mobile_text_alignment }};
    }
  }

  /* Grid Layout */
  #loudecoms-{{ section.id }} .loudecoms-grid {
    margin: {{ section.settings.vertical_gap }}px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    max-width: 1000px;
    gap: 20px;
  }

  @media only screen and (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-grid {
      grid-template-columns: 1fr;
      margin: {{ section.settings.mobile_vertical_gap | default: section.settings.vertical_gap }}px 10px 0;
    }
  }

  /* Count Display */
  #loudecoms-{{ section.id }} .loudecoms-col h3 {
    font-size: {{ section.settings.count_size }}px;
    font-weight: {% case section.settings.count_font_weight %}{% when 'light' %}300{% when 'normal' %}400{% when 'bold' %}700{% else %}var(--heading-weight, 600){% endcase %} !important;
    color: {% render 'scheme-color', color: section.settings.count_color, fallback: 'var(--color-heading)' %} !important;
    padding: 0;
    margin: 0 0 {{ section.settings.count_spacing }}px 0;
    text-align: {{ section.settings.count_alignment }};
    line-height: 1;
    display: flex;
    align-items: baseline;
    justify-content: {{ section.settings.count_alignment }};
  }

  @media (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-col h3 {
      font-size: {{ section.settings.mobile_count_size }}px;
    }
  }

  #loudecoms-{{ section.id }} .loudecoms-col p {
    padding: 0;
    margin: 0;
    color: {% render 'scheme-color', color: section.settings.description_text_color, fallback: 'var(--color-text)' %} !important;
    text-align: {{ section.settings.count_alignment }};
    line-height: 1;
    font-size: {{ section.settings.description_size }}px;
    {% if section.settings.override_fonts %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
  }

  @media (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-col p {
      font-size: {{ section.settings.mobile_description_size }}px;
    }
  }

  /* Plus Sign for Count Display */
  #loudecoms-{{ section.id }} .loudecoms-plus {
      font-size: {{ section.settings.plus_size }}px !important;
      color: {% render 'scheme-color', color: section.settings.count_color, fallback: 'var(--color-heading)' %} !important;
      margin-left: 5px;
  }

  {% for block in section.blocks %}
    {% if block.type == 'headline' %}
    #loudecoms-{{ section.id }} .headline-{{ block.id }} {
      font-size: {{ block.settings.size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.headline_font.family }}, {{ section.settings.headline_font.fallback_families }};
      {% endif %}
      font-weight: {% if block.settings.font_weight == 'inherit' or block.settings.font_weight == blank %}var(--heading-weight, inherit){% else %}{{ block.settings.font_weight }}{% endif %};
      {% if block.settings.line_height != 'inherit' %}line-height: {{ block.settings.line_height }};{% endif %}
      margin: 0 0 {{ section.settings.heading_subheading_gap }}px 0;
      padding: 0;
      color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
    }

    @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .headline-{{ block.id }} {
        font-size: {{ block.settings.mobile_size }}px;
        margin: 0 0 {{ section.settings.mobile_heading_subheading_gap }}px 0;
      }
    }
    {% elsif block.type == 'subheadline' %}
    #loudecoms-{{ section.id }} .subheadline-{{ block.id }} {
      font-size: {{ block.settings.size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
      {% endif %}
      {% if block.settings.line_height != 'inherit' %}line-height: {{ block.settings.line_height }};{% endif %}
      margin: 0;
      padding: 0;
      color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %} !important;
    }

    @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .subheadline-{{ block.id }} {
        font-size: {{ block.settings.mobile_size }}px;
      }
    }
    {% endif %}
  {% endfor %}

  {%- endcapture -%}
  {%- liquid
    assign chunks = sp_content | strip_newlines | split: ' ' | join: ' ' | split: '*/'
    for chunk in chunks
      assign mini = chunk | split: '/*' | first | strip | replace: ': ', ':' | replace: '; ', ';' | replace: '} ', '}' | replace: '{ ', '{' | replace: ' {', '{' | replace: ';}', '}'
      echo mini
    endfor
  %}
{% comment %}{% endcomment %}</style>

<div id="loudecoms-{{ section.id }}" class="loudecoms-section color-{{ color_scheme }} gradient" loudecoms-section>
  <div class="loudecoms-container" loudecoms-container>
    <div class="loudecoms-headline">
      {% for block in section.blocks %}
        {% if block.type == 'headline' %}
          <h2 class="headline-{{ block.id }}">{{ block.settings.content }}</h2>
        {% elsif block.type == 'subheadline' %}
          <p class="subheadline-{{ block.id }}">{{ block.settings.content }}</p>
        {% endif %}
      {% endfor %}
    </div>

    <div class="loudecoms-grid">
      {% for block in section.blocks %}
        {% if block.type == 'count_box' %}
          <div class="loudecoms-col">
            <h3>
              <span class="loudecoms-count-up" data-value="{{ block.settings.number }}">
                {{- block.settings.number -}}
              </span>
              {% if section.settings.enable_plus_sign %}
                <span class="loudecoms-plus">+</span>
              {% endif %}
            </h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  const enableDotSpacer = {{ section.settings.enable_dot_spacer | default: false | json }};

  // easeOutExpo — starts fast, decelerates smoothly toward the end. Feels natural for counting.
  function easeOutExpo(t) {
    return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
  }

  function formatValue(value) {
    let formatted = value.toLocaleString();
    if (enableDotSpacer) formatted = formatted.replace(/,/g, '.');
    return formatted;
  }

  function animateCount(el) {
    const endVal = Math.round(Number(el.dataset.value) || 0);
    const startVal = 0;
    const duration = 2000; // 2s — feels right at any number magnitude

    // Reduced motion — show final value instantly, no animation
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = formatValue(endVal);
      return;
    }

    let startTime = null;
    let lastRendered = -1;

    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const t = Math.min(elapsed / duration, 1);
      const eased = easeOutExpo(t);
      const current = Math.round(startVal + (endVal - startVal) * eased);

      // Only repaint when the displayed integer actually changes — avoids redundant DOM writes
      if (current !== lastRendered) {
        el.textContent = formatValue(current);
        lastRendered = current;
      }

      if (t < 1) {
        requestAnimationFrame(step);
      } else {
        // Snap to exact end value at the end
        el.textContent = formatValue(endVal);
      }
    }
    requestAnimationFrame(step);
  }

  function countStart(root) {
    root.querySelectorAll('.loudecoms-count-up').forEach(animateCount);
  }

  function init() {
    const el = document.querySelector('#loudecoms-{{ section.id }}');
    if (!el || el.dataset.countInit) return;
    el.dataset.countInit = '1';

    // Initialize all counters at 0 immediately so they don't flash the final value before animating
    el.querySelectorAll('.loudecoms-count-up').forEach((item) => {
      item.textContent = formatValue(0);
    });

    new IntersectionObserver(([entry], observer) => {
      if (entry.isIntersecting) {
        countStart(el);
        observer.disconnect();
      }
    }, { threshold: 0.5, rootMargin: '0px 0px -10% 0px' }).observe(el);
  }
  init();

  const key = '__countUp_{{ section.id }}';
  if (!window[key]) {
    window[key] = true;
    document.addEventListener('storelib:section-load', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') init();
    });
  }
})();
{% comment %}{% endcomment %}</script>


</template>

<schema>
{
  "type": "number-stats",
  "name": "Count Up Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "enable_plus_sign",
      "label": "Enable Plus Sign",
      "default": false,
      "info": "Toggle to show a plus sign next to each count number."
    },
    {
      "type": "checkbox",
      "id": "enable_dot_spacer",
      "label": "Use Dot as Thousands Separator",
      "default": false,
      "info": "Toggle to use dots instead of commas for thousands separators in counts."
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "section_background_image",
      "label": "Section Background Image",
      "info": "Select an image for the section background."
    },
    {
      "type": "range",
      "id": "section_bg_image_brightness",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Section Background Image Brightness",
      "default": 100,
      "info": "Adjust the brightness of the section background image."
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "override_fonts",
      "label": "Use Custom Fonts",
      "default": false,
      "info": "Toggle to override the default theme fonts."
    },
    {
      "type": "font_picker",
      "id": "headline_font",
      "label": "Headline Font Family",
      "default": "sans-serif",
      "info": "Select the font for headline text."
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Body Text Font Family",
      "default": "sans-serif",
      "info": "Select the font for body text."
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Description Text Size",
      "default": 15,
      "info": "Set the text size for count descriptions."
    },
    {
      "type": "range",
      "id": "count_size",
      "min": 10,
      "max": 75,
      "step": 1,
      "unit": "px",
      "label": "Count Number Size (Desktop)",
      "default": 48,
      "info": "Set the count number size for desktop devices."
    },
    {
      "type": "select",
      "id": "count_font_weight",
      "label": "Count Number Font Weight",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "default": "normal",
      "info": "Choose the font weight for the count numbers."
    },
    {
      "type": "color",
      "id": "count_color",
      "default": "#111",
      "label": "Count Number Color"
    },
    {
      "type": "color",
      "id": "description_text_color",
      "default": "#111",
      "label": "Box Description Text Color"
    },
    {
      "type": "text_alignment",
      "id": "count_alignment",
      "default": "center",
      "label": "Count Alignment",
      "info": "Set the alignment for the count numbers."
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Headline Alignment",
      "default": "center",
      "info": "Set the alignment for the headline text."
    },
    {
      "type": "range",
      "id": "plus_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Plus Sign Size",
      "default": 37,
      "info": "Set the size for the plus sign."
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_background_custom_color",
      "default": "#FFFFFF",
      "label": "Section Background Color",
      "info": "Choose the section background color."
    },
    {
      "type": "select",
      "id": "section_background_size",
      "default": "cover",
      "label": "Background Image Size",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "info": "Determine how the background image scales."
    },
    {
      "type": "color_background",
      "id": "container_background_color",
      "label": "Container Background",
      "info": "Set the container background color."
    },
    {
      "type": "range",
      "id": "container_border_size",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Container Border Thickness",
      "default": 0,
      "info": "Define the container border thickness."
    },
    {
      "type": "color",
      "id": "container_border_color",
      "default": "#888",
      "label": "Container Border Color"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Layout & Spacing"
    },
    {
