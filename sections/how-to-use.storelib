          "type": "step",
          "settings": {
            "title": "Select Speed",
            "description": "<p>Select your ideal speed. Slower for a gentler, comfortable experience. Or, select higher speeds for a more intense, deeper effect.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Hover",
            "description": "<p>Float it over the target area and let it get to work, penetrating deep, loosening tightness and promoting blood flow.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Relax",
            "description": "<p>Sit back and continue to let it work its magic for 2-3 minutes per area and a 10-minute session.</p>"
          }
        }
      ]
    }
