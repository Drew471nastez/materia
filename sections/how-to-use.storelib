<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes — How to use
  A heading + repeatable "step" blocks (framed image, number, title, description).
  • Connected to the theme's global scroll-animation settings + typography vars.
  • Section-isolated so it never bleeds into / paints over other sections.
  • Fully responsive; on mobile the steps become a swipeable scroll-snap carousel.
{%- endcomment -%}

{%- comment -%} Theme-level scroll animation (settings.scroll_animation / duration / delay) {%- endcomment -%}
{%- if section.settings.reveal and settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Isolation — keep this section in the base stacking layer (below the
     sticky header, z-index 11) and stop CSS/JS bleed between sections. */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
    z-index: 0;
  }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }

  /* Margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.margin_top | default: 0 }}px;
    margin-bottom: {{ st.margin_bottom | default: 0 }}px;
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .htu {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %};
    padding-top: {{ st.padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .htu {
      padding-top: {{ st.padding_top_desktop | default: 64 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 64 }}px;
    }
  }

  /* Width */
  {%- case st.section_width -%}
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .htu__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .htu__inner { padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .htu__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .htu__inner { padding-inline: 1.5rem; }
    {%- else -%}
      #shopify-section-{{ sid }} .htu__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Heading is a block — its size / color / alignment / gap are emitted
     per-block (see the heading loop below). Only structural base here. */
  #shopify-section-{{ sid }} .htu__heading {
    font-weight: var(--heading-weight, 700);
    line-height: 1.15;
  }

  /* Grid (mobile: stacked; desktop: N columns) */
  #shopify-section-{{ sid }} .htu__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.gap_mobile | default: 24 }}px {{ st.col_gap_mobile | default: 16 }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .htu__grid {
      grid-template-columns: repeat({{ st.cols_desktop | default: 3 }}, minmax(0, 1fr));
      gap: {{ st.gap_desktop | default: 32 }}px {{ st.col_gap_desktop | default: 32 }}px;
    }
  }

  /* Mobile carousel (optional) — single-row swipeable scroll-snap track */
  {%- if st.enable_mobile_carousel -%}
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .htu__grid {
      display: flex;
      grid-template-columns: none;
      flex-wrap: nowrap;
      gap: {{ st.col_gap_mobile | default: 16 }}px;
      --htu-ipv: {{ st.mobile_items_per_view | default: 1.1 }};
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 4px;
    }
    #shopify-section-{{ sid }} .htu__grid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .htu__step {
      scroll-snap-align: start;
      flex: 0 0 calc((100% - {{ st.col_gap_mobile | default: 16 }}px * (var(--htu-ipv) - 1)) / var(--htu-ipv));
    }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .htu__grid { scroll-behavior: auto; }
  }
  {%- endif -%}

  /* Step */
  #shopify-section-{{ sid }} .htu__step {
    display: flex;
    flex-direction: column;
    text-align: {{ st.content_align | default: 'left' }};
    align-items: {% if st.content_align == 'center' %}center{% else %}stretch{% endif %};
    min-width: 0;
  }

  /* Image frame */
  #shopify-section-{{ sid }} .htu__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.image_ratio | default: '4/3' }};
    background: {% render 'scheme-color', color: st.image_bg, fallback: 'var(--color-background)' %};
    border-radius: {{ st.image_radius | default: 10 }}px;
    overflow: hidden;
    {%- if st.image_border -%}border: 1px solid {% render 'scheme-color', color: st.image_border_color, fallback: 'var(--color-border)' %};{%- endif -%}
  }
  #shopify-section-{{ sid }} .htu__img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: {{ st.image_fit | default: 'cover' }};
    object-position: center;
    display: block;
  }

  /* Number + title */
  #shopify-section-{{ sid }} .htu__head {
    display: flex;
    align-items: baseline;
    {% if st.content_align == 'center' %}justify-content: center;{% endif %}
    gap: 10px;
    margin: 18px 0 0;
  }
  #shopify-section-{{ sid }} .htu__num {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 700);
    line-height: 1;
    color: {% render 'scheme-color', color: st.number_color, fallback: 'var(--color-primary)' %};
    font-size: {{ st.number_size | default: 22 }}px;
  }
  #shopify-section-{{ sid }} .htu__title {
    margin: 0;
    font-weight: var(--heading-weight, 700);
    line-height: 1.2;
    color: {% render 'scheme-color', color: st.title_color, fallback: 'var(--color-heading)' %};
    font-size: {{ st.title_size_mobile | default: 18 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .htu__title { font-size: {{ st.title_size_desktop | default: 20 }}px; }
  }
  #shopify-section-{{ sid }} .htu__desc {
    margin: 10px 0 0;
    line-height: 1.6;
    color: {% render 'scheme-color', color: st.desc_color, fallback: 'var(--color-text)' %};
    font-size: {{ st.desc_size_mobile | default: 15 }}px;
  }
  #shopify-section-{{ sid }} .htu__desc > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .htu__desc > :last-child { margin-bottom: 0; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .htu__desc { font-size: {{ st.desc_size_desktop | default: 16 }}px; }
  }
{% comment %}{% endcomment %}</style>

<section class="htu-wrap color-{{ color_scheme }} gradient">
  <div class="htu">
    <div class="htu__inner">
      {%- comment -%} Heading block(s) — rendered above the steps grid, fully self-contained {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          {%- assign hs = block.settings -%}
          {%- if hs.text != blank -%}
            {%- assign h_text = hs.text | escape -%}
            {%- if hs.enable_accent and hs.accent_text != blank -%}
              {%- assign acc = hs.accent_text | escape -%}
              {%- capture acc_html -%}<span class="htu__accent">{{ acc }}</span>{%- endcapture -%}
              {%- assign h_text = h_text | replace: acc, acc_html -%}
            {%- endif -%}
            <h2 class="htu__heading" id="htu-h-{{ block.id }}" {{ block.shopify_attributes }}>{{ h_text }}</h2>
            <style>
              #shopify-section-{{ sid }} #htu-h-{{ block.id }} {
                text-align: {{ hs.align | default: 'center' }};
                color: {% render 'scheme-color', color: hs.color, fallback: 'var(--color-heading)' %};
                font-size: {{ hs.size_mobile | default: 28 }}px;
                margin: 0 0 {{ hs.gap_below | default: 48 }}px;
              }
              @media (min-width: 768px) {
                #shopify-section-{{ sid }} #htu-h-{{ block.id }} { font-size: {{ hs.size_desktop | default: 40 }}px; }
              }
              {%- if hs.enable_accent -%}
              #shopify-section-{{ sid }} #htu-h-{{ block.id }} .htu__accent {
                color: {% render 'scheme-color', color: hs.accent_color, fallback: 'var(--color-primary)' %};
                {% if hs.accent_italic %}font-style: italic;{% endif %}
              }
              {%- endif -%}
{% comment %}{% endcomment %}            </style>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <ul class="htu__grid"{% if st.enable_mobile_carousel and st.carousel_autoplay %} data-htu-autoplay="{{ st.carousel_autoplay_speed | default: 4 | times: 1000 }}"{% endif %}>
        {%- assign step_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_n = step_n | plus: 1 -%}
            {%- assign bs = block.settings -%}
            <li class="htu__step" {{ block.shopify_attributes }}>
              <div class="htu__media">
                {%- if bs.image != blank -%}
                  <img class="htu__img"
                       src="{{ bs.image | image_url: width: 900 }}"
                       srcset="{{ bs.image | image_url: width: 450 }} 450w, {{ bs.image | image_url: width: 900 }} 900w"
                       sizes="(min-width: 768px) 33vw, 90vw"
                       width="{{ bs.image.width }}" height="{{ bs.image.height }}"
                       alt="{{ bs.title | default: 'Step' | escape }}" loading="lazy">
                {%- else -%}
                  <img class="htu__img" src="{{ placeholder }}" width="900" height="675" alt="" loading="lazy">
                {%- endif -%}
              </div>
              <div class="htu__head">
                <span class="htu__num">{{ bs.number | default: step_n }}</span>
                {%- if bs.title != blank -%}<h3 class="htu__title">{{ bs.title | escape }}</h3>{%- endif -%}
              </div>
              {%- if bs.description != blank -%}
                <div class="htu__desc">{{ bs.description }}</div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{%- comment -%} Mobile carousel autoplay — loaded only when carousel + autoplay are on. {%- endcomment -%}
{%- if st.enable_mobile_carousel and st.carousel_autoplay -%}
<script>
  (function () {
    var key = '__htuAutoplay_{{ sid }}';
    function init() {
      if (typeof window[key] === 'function') { window[key](); window[key] = null; }
      var root = document.getElementById('shopify-section-{{ sid }}');
      if (!root) return;
      var grid = root.querySelector('.htu__grid[data-htu-autoplay]');
      if (!grid) return;
      var mq = window.matchMedia('(max-width: 767px)');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var delay = parseInt(grid.getAttribute('data-htu-autoplay'), 10) || 4000;
      var timer = null, paused = false, visible = true, io = null;
      function step() {
        var item = grid.querySelector('.htu__step');
        if (!item) return grid.clientWidth;
        var gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
        return item.getBoundingClientRect().width + gap;
      }
      function tick() {
        if (!grid.isConnected) { cleanup(); return; }
        if (paused || !mq.matches) return;
        var max = grid.scrollWidth - grid.clientWidth;
        if (grid.scrollLeft >= max - 2) { grid.scrollTo({ left: 0, behavior: 'smooth' }); }
        else { grid.scrollBy({ left: step(), behavior: 'smooth' }); }
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { stop(); if (mq.matches && !reduce.matches && visible && !paused && !document.hidden) { timer = setInterval(tick, delay); } }
      function pause() { paused = true; stop(); }
      function resume() { paused = false; start(); }
      function onVis() { if (document.hidden) { stop(); } else { start(); } }
      ['pointerdown', 'touchstart', 'mouseenter', 'focusin'].forEach(function (ev) { grid.addEventListener(ev, pause, { passive: true }); });
      ['touchend', 'mouseleave', 'focusout'].forEach(function (ev) { grid.addEventListener(ev, resume, { passive: true }); });
      document.addEventListener('visibilitychange', onVis);
      if (mq.addEventListener) { mq.addEventListener('change', start); } else if (mq.addListener) { mq.addListener(start); }
      if ('IntersectionObserver' in window) {
        io = new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; if (visible) { start(); } else { stop(); } });
        io.observe(grid);
      }
      function cleanup() {
        stop();
        if (io) { io.disconnect(); io = null; }
        document.removeEventListener('visibilitychange', onVis);
        if (mq.removeEventListener) { mq.removeEventListener('change', start); } else if (mq.removeListener) { mq.removeListener(start); }
      }
      window[key] = cleanup;
      start();
    }
    init();
    if (!window[key + '_bound']) {
      window[key + '_bound'] = true;
      document.addEventListener('storelib:section-load', function (e) {
        if (e.detail && String(e.detail.sectionId) === '{{ sid }}') { init(); }
      });
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

<schema>
{
  "type": "how-to-use",
  "name": "How To Use",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Step text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Mobile carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Enable carousel on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_items_per_view",
      "label": "Items per view (peek next)",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Step image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "4/3",
      "options": [
        {
          "value": "4/3",
          "label": "4:3"
        },
        {
          "value": "3/2",
          "label": "3:2"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "1/1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill)"
        },
        {
          "value": "contain",
          "label": "Contain (no crop)"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "image_border",
      "label": "Show image border",
      "default": true
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border color"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image background"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Step text"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title size (desktop)",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color"
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "label": "Description size (desktop)",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "label": "Description size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Colors & spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Row gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Row gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
