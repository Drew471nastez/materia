<template compat="shopify">
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign t = template | split: '.' | first
-%}

{%- if section_st.enable_custom_padding -%}
  <style>
    @media (min-width: 1024px) {
      #shopify-section-{{ section.id }} .breadcrumbs {
        padding-top: {{ section_st.padding_top_desktop | default: 20 }}px !important;
        padding-bottom: {{ section_st.padding_bottom_desktop | default: 20 }}px !important;
      }
    }
    @media (max-width: 1023px) {
      #shopify-section-{{ section.id }} .breadcrumbs {
        padding-top: {{ section_st.padding_top_mobile | default: 12 }}px !important;
        padding-bottom: {{ section_st.padding_bottom_mobile | default: 12 }}px !important;
      }
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list,
  #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list a,
  #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list span {
    font-size: {{ section_st.font_size | default: 13 }}px;
  }
  {%- if section_st.uppercase -%}
    #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list,
    #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list a,
    #shopify-section-{{ section.id }} .breadcrumbs .breadcrumb-list span {
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
  {%- endif -%}
  {%- if section_st.next_prev_icon == 'arrow' -%}
    #shopify-section-{{ section.id }} .breadcrumbs .nav-pr svg { display: none; }
    #shopify-section-{{ section.id }} .breadcrumbs .nav-pr {
      width: 18px;
      height: 18px;
      position: relative;
    }
    #shopify-section-{{ section.id }} .breadcrumbs .previous-product::after,
    #shopify-section-{{ section.id }} .breadcrumbs .next-product::after {
      content: "";
      position: absolute;
      inset: 0;
      background: currentColor;
      -webkit-mask-position: center;
              mask-position: center;
      -webkit-mask-repeat: no-repeat;
              mask-repeat: no-repeat;
      -webkit-mask-size: 18px 18px;
              mask-size: 18px 18px;
    }
    #shopify-section-{{ section.id }} .breadcrumbs .previous-product::after {
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='12' x2='5' y2='12'/><polyline points='12 19 5 12 12 5'/></svg>");
              mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><line x1='19' y1='12' x2='5' y2='12'/><polyline points='12 19 5 12 12 5'/></svg>");
    }
    #shopify-section-{{ section.id }} .breadcrumbs .next-product::after {
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><line x1='5' y1='12' x2='19' y2='12'/><polyline points='12 5 19 12 12 19'/></svg>");
              mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><line x1='5' y1='12' x2='19' y2='12'/><polyline points='12 5 19 12 12 19'/></svg>");
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="breadcrumbs color-{{ color_scheme }} gradien fs-small{% if t == 'product' and section.settings.next_prev %} py-20{% else %} py-25{% endif %}">
  <div class="{{ section_width }}">
    {% render 'breadcrumbs' | next_prev: section_st.next_prev %}
  </div>
</section>


</template>

<schema>
{
  "type": "breadcrumb",
  "name": "Breadcrumbs",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "next_prev",
      "label": "Show previous / next product navigation",
      "info": "Only appears on the product page.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "next_prev_icon",
      "label": "Navigation icon style",
      "default": "chevron",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron (default)"
        },
        {
          "value": "arrow",
          "label": "Long arrow"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase breadcrumb text",
      "default": false
    }
  ],
  "shopify": {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
