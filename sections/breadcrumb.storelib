<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; z-index: 6; overflow: visible; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign t = template | split: '.' | first
-%}

{%- liquid
  assign sep = section_st.separator | default: 'chevron'
  assign align = section_st.alignment | default: 'left'
  assign show_nav = false
  if t == 'product' and section_st.next_prev
    assign show_nav = true
  endif
  assign pad_top_d = 18
  assign pad_bottom_d = 18
  assign pad_top_m = 12
  assign pad_bottom_m = 12
  if section_st.enable_custom_padding
    assign pad_top_d = section_st.padding_top_desktop | default: 20
    assign pad_bottom_d = section_st.padding_bottom_desktop | default: 20
    assign pad_top_m = section_st.padding_top_mobile | default: 12
    assign pad_bottom_m = section_st.padding_bottom_mobile | default: 12
  endif
-%}
<style>
  #shopify-section-{{ section.id }} .bc {
    --bc-link: {% render 'scheme-color', color: section_st.link_color, fallback: 'color-mix(in srgb, var(--color-text) 72%, transparent)' %};
    --bc-current: {% render 'scheme-color', color: section_st.current_color, fallback: 'var(--color-heading)' %};
    --bc-line: var(--color-border);
    padding-block: {{ pad_top_m }}px {{ pad_bottom_m }}px;
    font-family: var(--body-font, inherit);
    font-size: {{ section_st.font_size | default: 13 }}px;
    font-weight: var(--body-weight, 400);
    line-height: 1.4;
    position: relative;
    z-index: 3;
    overflow: visible;
    {%- if section_st.uppercase %} text-transform: uppercase; letter-spacing: 0.06em;{% endif %}
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .bc { padding-block: {{ pad_top_d }}px {{ pad_bottom_d }}px; }
  }
  #shopify-section-{{ section.id }} .bc__row { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-width: 0; }
  #shopify-section-{{ section.id }} .bc__trail {
    display: flex; align-items: center; flex-wrap: nowrap; gap: 0; min-width: 0;
    margin: 0; padding: 0; list-style: none;
    justify-content: {% case align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
    {%- unless show_nav %} flex: 1;{% endunless %}
  }
  #shopify-section-{{ section.id }} .bc__item { display: inline-flex; align-items: center; min-width: 0; flex: none; }
  #shopify-section-{{ section.id }} .bc__item:last-child { flex: 0 1 auto; }
  #shopify-section-{{ section.id }} .bc__item + .bc__item::before {
    flex: none;
    margin-inline: 10px;
    color: color-mix(in srgb, var(--bc-link) 70%, transparent);
    {%- case sep -%}
      {%- when 'slash' %} content: "/";
      {%- when 'dot' %} content: ""; width: 3px; height: 3px; border-radius: 50%; background: currentColor;
      {%- else %} content: ""; width: 6px; height: 6px; border: solid currentColor; border-width: 1.5px 1.5px 0 0; transform: rotate(45deg); margin-inline: 9px 11px;
    {%- endcase %}
  }
  #shopify-section-{{ section.id }} .bc__link {
    color: var(--bc-link); text-decoration: none; white-space: nowrap;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: color .2s ease, background-size .3s cubic-bezier(.2,.7,.2,1);
  }
  #shopify-section-{{ section.id }} .bc__link:hover,
  #shopify-section-{{ section.id }} .bc__link:focus-visible { color: var(--bc-current); background-size: 100% 1px; }
  #shopify-section-{{ section.id }} .bc__current {
    color: var(--bc-current); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
  }
  #shopify-section-{{ section.id }} .bc__nav { position: relative; z-index: 8; display: inline-flex; align-items: center; gap: 6px; flex: none; pointer-events: auto; }
  #shopify-section-{{ section.id }} .bc__btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    color: var(--bc-current); text-decoration: none;
    border: 1px solid transparent;
    transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
    pointer-events: auto;
    touch-action: manipulation;
  }
  #shopify-section-{{ section.id }} .bc__btn:hover,
  #shopify-section-{{ section.id }} .bc__btn:focus-visible {
    background: color-mix(in srgb, var(--color-heading) 7%, transparent);
    border-color: var(--bc-line);
  }
  #shopify-section-{{ section.id }} .bc__btn:focus-visible { outline: 2px solid var(--bc-current); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .bc__btn[aria-disabled="true"] { opacity: .3; pointer-events: none; }
  #shopify-section-{{ section.id }} .bc__btn svg { width: 18px; height: 18px; display: block; }
  #shopify-section-{{ section.id }} .bc__peek {
    position: absolute; top: calc(100% + 8px); inset-inline-end: 0; z-index: 5;
    display: flex; gap: 12px; align-items: center; width: min(260px, calc(100vw - 32px)); padding: 10px;
    background: var(--color-background); color: var(--color-text);
    border: 1px solid var(--bc-line); border-radius: var(--card-radius, 10px);
    box-shadow: 0 12px 32px -16px rgba(0,0,0,.28);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s;
    text-transform: none; letter-spacing: normal; pointer-events: none;
  }
  #shopify-section-{{ section.id }} .bc__btn:hover .bc__peek,
  #shopify-section-{{ section.id }} .bc__btn:focus-visible .bc__peek {
    opacity: 1; visibility: visible; transform: none; transition-delay: 0s;
  }
  #shopify-section-{{ section.id }} .bc__peek img { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; flex: none; }
  #shopify-section-{{ section.id }} .bc__peek-title { display: block; color: var(--color-heading); font-weight: var(--subheading-weight, 500); line-height: 1.3; }
  #shopify-section-{{ section.id }} .bc__peek .price { font-size: .95em; }
  @media (hover: none), (max-width: 749px) {
    #shopify-section-{{ section.id }} .bc__peek { display: none; }
    #shopify-section-{{ section.id }} .bc__btn { width: 40px; height: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} :is(.bc__link, .bc__btn, .bc__peek) { transition: none; }
  }
{% comment %}{% endcomment %}</style>

{%- unless template == 'index' or template == '404' -%}
<nav class="bc color-{{ color_scheme }} gradient" aria-label="{{ 'general.breadcrumb.home' | t | escape }}">
  <div class="{{ section_width }}">
    <div class="bc__row">
      <ol class="bc__trail">
        <li class="bc__item"><a class="bc__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a></li>
        {%- case t -%}
          {%- when 'product' -%}
            {%- if collection.url -%}
              <li class="bc__item"><a class="bc__link" href="{{ collection.url }}">{{ collection.title }}</a></li>
            {%- endif -%}
            <li class="bc__item"><span class="bc__current" aria-current="page">{{ product.title }}</span></li>
          {%- when 'collection' -%}
            {%- if current_tags -%}
              <li class="bc__item"><a class="bc__link" href="{{ collection.url }}">{{ collection.title }}</a></li>
              <li class="bc__item"><span class="bc__current" aria-current="page">{{ current_tags | join: ' + ' }}</span></li>
            {%- else -%}
              <li class="bc__item"><span class="bc__current" aria-current="page">{{ collection.title }}</span></li>
            {%- endif -%}
          {%- when 'blog' -%}
            {%- if current_tags -%}
              <li class="bc__item"><a class="bc__link" href="{{ blog.url }}">{{ blog.title }}</a></li>
              <li class="bc__item"><span class="bc__current" aria-current="page">{{ current_tags | join: ' + ' }}</span></li>
            {%- else -%}
              <li class="bc__item"><span class="bc__current" aria-current="page">{{ blog.title }}</span></li>
            {%- endif -%}
          {%- when 'article' -%}
            <li class="bc__item"><a class="bc__link" href="{{ blog.url }}">{{ blog.title }}</a></li>
            <li class="bc__item"><span class="bc__current" aria-current="page">{{ article.title }}</span></li>
          {%- when 'page' -%}
            <li class="bc__item"><span class="bc__current" aria-current="page">{{ page.title }}</span></li>
          {%- else -%}
            <li class="bc__item"><span class="bc__current" aria-current="page">{{ page_title }}</span></li>
        {%- endcase -%}
      </ol>
      {%- if show_nav -%}
        {%- liquid
          comment
            The products on either side of this one. The collection it was
            opened from first; on Storelib that may be empty on a product
            page, so then the product's first collection, then all products.
          endcomment
          assign previous_product = nil
          assign next_product = nil
          assign collection_list = nil
          assign nb_found = false
          if collection.previous_product or collection.next_product
            assign previous_product = collection.previous_product
            assign next_product = collection.next_product
            assign collection_list = collection
            assign nb_found = true
          endif
          for nb_source in (1..3)
            if nb_found
              break
            endif
            assign nb_list = nil
            if nb_source == 1
              assign nb_list = collection
            elsif nb_source == 2
              assign nb_list = product.collections.first
            else
              assign nb_list = collections.all
            endif
            assign nb_prev = nil
            assign nb_next = nil
            assign nb_hit = false
            assign nb_products = nil
            if nb_list != blank
              assign nb_products = nb_list.products
            endif
            for p in nb_products
              if nb_hit
                assign nb_next = p
                break
              endif
              if p.handle == product.handle
                assign nb_hit = true
              else
                assign nb_prev = p
              endif
            endfor
            if nb_hit
              assign previous_product = nb_prev
              assign next_product = nb_next
              assign nb_found = true
              if nb_source < 3
                assign collection_list = nb_list
              endif
            endif
          endfor
          assign all_url = collection_list.url | default: routes.all_products_collection_url | default: '/collections/all'
          if section_st.next_prev_icon == 'arrow'
            assign prev_path = '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>'
            assign next_path = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>'
          else
            assign prev_path = '<path d="m15 18-6-6 6-6"/>'
            assign next_path = '<path d="m9 18 6-6-6-6"/>'
          endif
        -%}
        <div class="bc__nav">
          {%- for dir in (1..2) -%}
            {%- if dir == 1 -%}
              {%- assign item = previous_product -%}{%- assign path = prev_path -%}{%- assign label = 'accessibility.previous' | t -%}
            {%- else -%}
              {%- assign item = next_product -%}{%- assign path = next_path -%}{%- assign label = 'accessibility.next' | t -%}
            {%- endif -%}
            {%- if dir == 2 -%}
              <a class="bc__btn" href="{{ all_url }}" aria-label="{{ 'products.product.back_to_product' | t | escape }}" title="{{ 'products.product.back_to_product' | t | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
              </a>
            {%- endif -%}
            {%- if item != blank -%}
              <a class="bc__btn" href="{{ item.url }}" aria-label="{{ label | escape }}: {{ item.title | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ path }}</svg>
                <span class="bc__peek" aria-hidden="true">
                  {%- if item.featured_image != blank -%}
                    {{ item.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}
                  {%- endif -%}
                  <span>
                    <span class="bc__peek-title">{{ item.title }}</span>
                    {%- unless settings.hidden_price -%}{%- render 'price', scope: 'item', product: item, show_badges: false -%}{%- endunless -%}
                  </span>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nav>
{%- endunless -%}

</template>

<schema>
{
  "type": "breadcrumb",
  "name": "Breadcrumbs",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Trail"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator",
      "default": "chevron",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "slash",
          "label": "Slash"
        },
        {
          "value": "dot",
          "label": "Dot"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Current page color"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Product navigation"
    },
    {
      "type": "checkbox",
      "id": "next_prev",
      "label": "Previous / next product",
      "default": false
    },
    {
      "type": "select",
      "id": "next_prev_icon",
      "label": "Arrow style",
      "default": "chevron",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ],
      "visible_if": "{{ section.settings.next_prev }}"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Custom padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.enable_custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.enable_custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs",
      "category": "Text"
    }
  ],
  "shopify": {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Trail"
      },
      {
        "type": "select",
        "id": "separator",
        "label": "Separator",
        "default": "chevron",
        "options": [
          {
            "value": "chevron",
            "label": "Chevron"
          },
          {
            "value": "slash",
            "label": "Slash"
          },
          {
            "value": "dot",
            "label": "Dot"
          }
        ]
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Alignment",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "font_size",
        "label": "Font size",
        "min": 10,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "checkbox",
        "id": "uppercase",
        "label": "Uppercase",
        "default": false
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Link color"
      },
      {
        "type": "color",
        "id": "current_color",
        "label": "Current page color"
      },
      {
        "type": "header",
        "content": "Product navigation"
      },
      {
        "type": "checkbox",
        "id": "next_prev",
        "label": "Previous / next product",
        "default": false
      },
      {
        "type": "select",
        "id": "next_prev_icon",
        "label": "Arrow style",
        "default": "chevron",
        "options": [
          {
            "value": "chevron",
            "label": "Chevron"
          },
          {
            "value": "arrow",
            "label": "Arrow"
          }
        ],
        "visible_if": "{{ section.settings.next_prev }}"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_padding",
        "label": "Custom padding",
        "default": false
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20,
        "visible_if": "{{ section.settings.enable_custom_padding }}"
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
