<template compat="shopify">
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Steps (Benefits category)

  Vertical step list with optional heading/subheading. Multiple marker
  styles (dot, outlined dot, numbered, outlined numbered, prefixed, icon).
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign step_blocks    = section.blocks | where: 'type', 'step'
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks     = section.blocks | where: 'type', 'subheading'
  assign eyebrow_blocks = section.blocks | where: 'type', 'eyebrow'
  assign button_blocks  = section.blocks | where: 'type', 'button'

  assign step_style = s.step_style | default: 'numbered'
-%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .stp {
    container-type: inline-size;
    container-name: stp;
    padding: {{ s.padding_top | default: 60 }}px {{ s.side_padding_desktop | default: 24 }}px {{ s.padding_bottom | default: 60 }}px;
    background: {{ s.section_bg | default: '#FFFFFF' }};
  }
  @container stp (max-width: 760px) {
    #shopify-section-{{ sid }} .stp {
      padding-left: {{ s.side_padding_mobile | default: 16 }}px;
      padding-right: {{ s.side_padding_mobile | default: 16 }}px;
    }
  }

  #shopify-section-{{ sid }} .stp__inner {
    max-width: var(--page-width, 1100px);
    margin-inline: auto;
    text-align: {{ s.text_align | default: 'left' }};
  }

  #shopify-section-{{ sid }} .stp__head {
    margin: 0 0 {{ s.head_gap | default: 32 }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: {% if s.text_align == 'center' %}center{% elsif s.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #shopify-section-{{ sid }} .stp__eyebrow {
    margin: 0; text-transform: uppercase; letter-spacing: 0.18em;
  }
  #shopify-section-{{ sid }} .stp__heading {
    margin: 0; font-weight: 700; line-height: 1.1;
  }
  #shopify-section-{{ sid }} .stp__sub {
    margin: 0; line-height: 1.55;
  }
  #shopify-section-{{ sid }} .stp__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .stp__sub p:last-child { margin: 0; }

  #shopify-section-{{ sid }} .stp__steps {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 0;
    max-width: {{ s.steps_max_width | default: 720 }}px;
  }
  {%- if s.text_align == 'center' -%}
    #shopify-section-{{ sid }} .stp__steps { margin-left: auto; margin-right: auto; }
  {%- endif -%}

  #shopify-section-{{ sid }} .stp__step {
    position: relative;
    display: grid;
    grid-template-columns: {{ s.marker_size | default: 36 }}px 1fr;
    gap: {{ s.step_gap_inline | default: 18 }}px;
    padding: 0 0 {{ s.step_gap_below | default: 28 }}px 0;
  }
  #shopify-section-{{ sid }} .stp__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: {{ s.marker_size | default: 36 }}px;
    bottom: 0;
    left: calc({{ s.marker_size | default: 36 | divided_by: 2 }}px - {{ s.line_thickness | default: 2 | divided_by: 2 }}px);
    border-left: {{ s.line_thickness | default: 2 }}px {{ s.line_style | default: 'solid' }} {{ s.line_color | default: '#3D5947' }};
  }
  #shopify-section-{{ sid }} .stp__step-marker {
    width: {{ s.marker_size | default: 36 }}px;
    height: {{ s.marker_size | default: 36 }}px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.marker_text_color | default: '#FFFFFF' }};
    font-weight: 700;
    font-size: {{ s.marker_font_size | default: 15 }}px;
    line-height: 1;
    border-radius: 999px;
    background: {{ s.marker_color | default: '#3D5947' }};
    border: {{ s.line_thickness | default: 2 }}px solid {{ s.marker_color | default: '#3D5947' }};
  }
  #shopify-section-{{ sid }} .stp__step--dot .stp__step-marker {
    width: {{ s.marker_size | default: 36 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 36 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 36 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 36 | divided_by: 4 }}px);
    border: 0;
  }
  #shopify-section-{{ sid }} .stp__step--dot_outline .stp__step-marker {
    background: transparent;
    width: {{ s.marker_size | default: 36 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 36 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 36 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 36 | divided_by: 4 }}px);
  }
  #shopify-section-{{ sid }} .stp__step--numbered_outline .stp__step-marker {
    background: transparent;
    color: {{ s.marker_color | default: '#3D5947' }};
  }
  #shopify-section-{{ sid }} .stp__step--icon .stp__step-marker {
    background: transparent;
    border: 0;
    color: {{ s.marker_color | default: '#3D5947' }};
  }
  #shopify-section-{{ sid }} .stp__step-marker img,
  #shopify-section-{{ sid }} .stp__step-marker svg {
    width: 100%; height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .stp__step-content {
    min-width: 0;
    display: flex; flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ sid }} .stp__step-title {
    margin: 0;
    font-weight: 700;
    font-size: {{ s.step_title_size | default: 20 }}px;
    line-height: 1.3;
    color: {{ s.step_title_color | default: '#1F2A24' }};
    font-family: {{ s.step_title_font_family | default: 'inherit' }};
  }
  #shopify-section-{{ sid }} .stp__step-prefix {
    color: {{ s.marker_color | default: '#3D5947' }};
    margin-right: 6px;
    font-feature-settings: 'tnum';
  }
  #shopify-section-{{ sid }} .stp__step-desc {
    margin: 0;
    font-size: {{ s.step_desc_size | default: 14 }}px;
    line-height: 1.55;
    color: {{ s.step_desc_color | default: '#7A8580' }};
  }
  #shopify-section-{{ sid }} .stp__step-desc p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .stp__step-desc p:last-child { margin: 0; }

  /* Button */
  #shopify-section-{{ sid }} .stp__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: {{ s.button_margin_top | default: 16 }}px;
    padding: {{ s.button_pad_y | default: 14 }}px {{ s.button_pad_x | default: 26 }}px;
    background: {{ s.button_bg | default: '#3D5947' }};
    color: {{ s.button_color | default: '#FFFFFF' }};
    border-radius: {{ s.button_radius | default: 999 }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: {{ s.button_size | default: 15 }}px;
    transition: transform 0.18s ease, background 0.18s ease;
    width: max-content;
  }
  #shopify-section-{{ sid }} .stp__btn:hover {
    background: {{ s.button_bg_hover | default: '#2A3F32' }};
    transform: translateY(-1px);
  }
{% comment %}{% endcomment %}</style>

<div class="section{{ reset_spacing }}">
  <div class="stp" data-section-id="{{ sid }}">
    <div class="stp__inner">

      {%- assign eyebrow_block = eyebrow_blocks | first -%}
      {%- assign heading_block = heading_blocks | first -%}
      {%- assign sub_block     = sub_blocks | first -%}
      {%- if eyebrow_block or heading_block or sub_block -%}
        <header class="stp__head">
          {%- if eyebrow_block and eyebrow_block.settings.text != blank -%}
            {%- assign eb = eyebrow_block.settings -%}
            <p class="stp__eyebrow"
               style="color: {{ eb.color | default: '#000000' }}; font-size: {{ eb.size | default: 12 }}px;"
               {{ eyebrow_block.shopify_attributes }}>{{ eb.text | escape }}</p>
          {%- endif -%}
          {%- if heading_block and heading_block.settings.text != blank -%}
            {%- assign hb = heading_block.settings -%}
            <{{ hb.tag | default: 'h2' }} class="stp__heading"
               style="color: {{ hb.color | default: '#000000' }}; font-size: {{ hb.size_mobile | default: 28 }}px;"
               {{ heading_block.shopify_attributes }}>{{ hb.text | escape }}</{{ hb.tag | default: 'h2' }}>
          {%- endif -%}
          {%- if sub_block and sub_block.settings.text != blank -%}
            {%- assign sb = sub_block.settings -%}
            <div class="stp__sub"
                 style="color: {{ sb.color | default: '#000000' }}; font-size: {{ sb.size | default: 15 }}px; max-width: {{ sb.max_width | default: 600 }}px;"
                 {{ sub_block.shopify_attributes }}>{{ sb.text }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if step_blocks.size > 0 -%}
        <ul class="stp__steps">
          {%- for block in step_blocks -%}
            {%- assign sb = block.settings -%}
            {%- assign step_class = step_style -%}
            {%- if sb.icon != blank -%}{%- assign step_class = 'icon' -%}{%- endif -%}
            <li class="stp__step stp__step--{{ step_class }}" {{ block.shopify_attributes }}>
              <div class="stp__step-marker"
                   style="{% if sb.marker_color != blank %}background: {{ sb.marker_color }}; border-color: {{ sb.marker_color }};{% endif %}">
                {%- if sb.icon != blank -%}
                  {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
                {%- elsif step_style == 'numbered' or step_style == 'numbered_outline' -%}
                  {{ forloop.index }}
                {%- endif -%}
              </div>
              <div class="stp__step-content">
                <p class="stp__step-title" style="{% if sb.title_color != blank %}color: {{ sb.title_color }};{% endif %}">
                  {%- if step_style == 'prefixed' -%}
                    <span class="stp__step-prefix">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  {%- endif -%}
                  {{ sb.title | default: fb_accessibility_step_title | escape }}
                </p>
                {%- if sb.description != blank -%}
                  <div class="stp__step-desc" style="{% if sb.description_color != blank %}color: {{ sb.description_color }};{% endif %}">{{ sb.description }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- for block in button_blocks -%}
        {%- assign bs = block.settings -%}
        {%- if bs.label != blank -%}
          <a class="stp__btn" href="{{ bs.url | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "steps",
  "name": "Steps",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Space below text",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "steps_max_width",
      "label": "Steps max width",
      "min": 320,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Step style"
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Marker style",
      "default": "numbered",
      "options": [
        {
          "value": "dot",
          "label": "Filled dot"
        },
        {
          "value": "dot_outline",
          "label": "Outlined dot"
        },
        {
          "value": "numbered",
          "label": "Numbered (filled)"
        },
        {
          "value": "numbered_outline",
          "label": "Numbered (outline)"
        },
        {
          "value": "prefixed",
          "label": "Prefix in title (01.)"
        },
        {
          "value": "icon",
          "label": "Custom icon (per step)"
        }
      ]
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker color",
      "default": "#733BFF"
    },
    {
      "type": "color",
      "id": "marker_text_color",
      "label": "Marker text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Connecting line color",
      "default": "#733BFF"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ]
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "marker_font_size",
      "label": "Marker text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "step_gap_inline",
      "label": "Marker → text gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "step_gap_below",
      "label": "Vertical gap between steps",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Step text"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title color",
      "default": "#1F2A24"
    },
    {
      "type": "color",
      "id": "step_desc_color",
      "label": "Step description color",
      "default": "#7A8580"
    },
    {
      "type": "range",
      "id": "step_title_size",
      "label": "Step title size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "step_desc_size",
      "label": "Step description size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Button styling"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#733BFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (hover)",
      "default": "#2A3F32"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_pad_x",
      "label": "Button padding X",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "button_pad_y",
      "label": "Button padding Y",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Space above button",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Section spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "How it works"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 9,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "How it works"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Heading tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 18,
          "max": 56,
          "step": 1,
          "unit": "px",
          "default": 28
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading text"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 12,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 15
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width",
          "min": 240,
          "max": 720,
          "step": 10,
          "unit": "px",
          "default": 600
        }
      ],
      "limit": 1
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Step description",
          "default": "<p>Add a short description that explains this step.</p>"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (overrides marker style)"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color override (optional)"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description color override (optional)"
        },
        {
          "type": "color",
          "id": "marker_color",
          "label": "Marker color override (optional)"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
