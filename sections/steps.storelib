  "presets": [
    {
      "name": "Steps",
      "category": "Features",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "How it works"
          }
        },
        {
          "type": "subheading",
          "settings": {
            "text": "<p>Three steps from choosing to receiving your order.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Choose your product",
            "description": "<p>Pick what fits you and add it to your cart.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Check out",
            "description": "<p>Pay securely and get an order confirmation by email.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Receive your order",
            "description": "<p>Add how and when your order arrives.</p>"
          }
        }
      ]
    }
  ],
