            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "marker_color",
            "label": "Marker",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "description_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Get started"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Steps",
        "category": "Features",
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "How it works"
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>Three steps from choosing to receiving your order.</p>"
            }
          },
          {
            "type": "step",
            "settings": {
              "title": "Choose your product",
              "description": "<p>Pick what fits you and add it to your cart.</p>"
            }
          },
          {
            "type": "step",
            "settings": {
