<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: the theme's own space between sections is removed; the margin sliders below still apply */
    #shopify-section-{{ section.id }} { padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ section.id }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Steps.

  A header (eyebrow, heading and subheading blocks), a vertical list of steps
  with a marker and a connecting line, and optional buttons. Every value is a
  CSS variable on the section root, so shopify/assets/live-features-d.js
  applies builder edits in place. Phone layout follows the section's own
  width (container query), not the window.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign custom = s.enable_custom_style
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign button_blocks = section.blocks | where: 'type', 'button'
  assign step_style = s.step_style | default: 'numbered'
  assign geo = false
  if s.use_theme_button == false
    assign geo = true
  endif
  case s.section_width
    when 'fluid_container'
      assign max_w = 'var(--fluid-container-width, 1500px)'
    when 'stretch_width'
      assign max_w = 'none'
    else
      assign max_w = 'var(--page-width, 1100px)'
  endcase
  case s.text_align
    when 'center'
      assign _ai = 'center'
    when 'right'
      assign _ai = 'flex-end'
    else
      assign _ai = 'flex-start'
  endcase
-%}
{%- capture stp_style -%}
--stp-max: {{ max_w }}; --stp-align: {{ s.text_align | default: 'left' }}; --stp-ai: {{ _ai }}; --stp-steps-ml: {% if s.text_align == 'center' %}auto{% elsif s.text_align == 'right' %}auto{% else %}0{% endif %}; --stp-steps-mr: {% if s.text_align == 'center' %}auto{% else %}0{% endif %};
--stp-pt: {{ s.padding_top | default: 0 }}px; --stp-pb: {{ s.padding_bottom | default: 0 }}px; --stp-px-d: {{ s.side_padding_desktop | default: 0 }}px; --stp-px-m: {{ s.side_padding_mobile | default: 0 }}px;
--stp-head-gap: {{ s.head_gap | default: 0 }}px; --stp-steps-max: {{ s.steps_max_width | default: 720 }}px;
--stp-mk: {{ s.marker_size | default: 36 }}px; --stp-mk-font: {{ s.marker_font_size | default: 15 }}px; --stp-line-w: {{ s.line_thickness | default: 2 }}px; --stp-line-style: {{ s.line_style | default: 'solid' }};
--stp-gap-inline: {{ s.step_gap_inline | default: 0 }}px; --stp-gap-below: {{ s.step_gap_below | default: 0 }}px;
--stp-title-size: {{ s.step_title_size | default: 20 }}px; --stp-desc-size: {{ s.step_desc_size | default: 14 }}px; --stp-btn-mt: {{ s.button_margin_top | default: 0 }}px;
{%- render 'media-msr-var', name: '--stp-bg', color: s.section_bg, on: custom -%}
{%- render 'media-msr-var', name: '--stp-marker', color: s.marker_color, on: custom -%}
{%- render 'media-msr-var', name: '--stp-marker-text', color: s.marker_text_color, on: custom -%}
{%- render 'media-msr-var', name: '--stp-line', color: s.line_color, on: custom -%}
{%- render 'media-msr-var', name: '--stp-title', color: s.step_title_color, on: custom -%}
{%- render 'media-msr-var', name: '--stp-desc', color: s.step_desc_color, on: custom -%}
{%- if s.enable_custom_fonts -%}
  {%- if s.heading_font.family != blank -%}--stp-hfont: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'serif' }};{%- endif -%}
  {%- if s.body_font.family != blank -%}--stp-bfont: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}
{%- capture btn_style -%}
{%- if custom -%}{%- render 'button-overrides', bg: s.button_bg, text: s.button_color, hover_bg: s.button_bg_hover, hover_text: s.button_color -%}{%- endif -%}
{%- if geo -%}--mb-radius: {{ s.button_radius | default: 999 }}px; --mb-padding-y: {{ s.button_pad_y | default: 14 }}px; --mb-padding-x: {{ s.button_pad_x | default: 26 }}px; --mb-font-size: {{ s.button_size | default: 15 }}px;{%- endif -%}
{%- endcapture -%}
<style>
  {%- if s.enable_custom_fonts -%}
    {%- if s.heading_font.family != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.body_font.family != blank -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endif -%}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .stp {
    container: stp / inline-size; background: var(--stp-bg, var(--color-background)); color: var(--color-text);
    font-family: var(--stp-bfont, var(--body-font)); padding: var(--stp-pt) 0 var(--stp-pb); --stp-mk-c: var(--stp-marker, var(--color-primary));
  }
  #shopify-section-{{ sid }} .stp *, #shopify-section-{{ sid }} .stp *::before, #shopify-section-{{ sid }} .stp *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .stp__inner { max-width: var(--stp-max); margin-inline: auto; padding-inline: var(--stp-px-d); text-align: var(--stp-align); }
  @container stp (max-width: 760px) {
    #shopify-section-{{ sid }} .stp__inner { padding-inline: var(--stp-px-m); }
  }
  @container stp (min-width: 1200px) {
    #shopify-section-{{ sid }} .stp[data-width='stretch_width'] .stp__inner { padding-inline: max(var(--stp-px-d), 3rem); }
  }
  #shopify-section-{{ sid }} .stp__head { margin: 0 0 var(--stp-head-gap); display: flex; flex-direction: column; gap: 8px; align-items: var(--stp-ai); }
  #shopify-section-{{ sid }} .stp__head > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .stp__eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: var(--b-size, 12px); color: var(--b-color, var(--stp-mk-c)); }
  #shopify-section-{{ sid }} .stp__heading {
    font-family: var(--stp-hfont, var(--heading-font)); font-weight: var(--heading-weight, 700); line-height: var(--heading-line-height, 1.1);
    color: var(--b-color, var(--color-heading)); font-size: var(--b-size-d, calc(var(--heading-font-scale, 1) * var(--h2-size, 3.6rem)));
  }
  @container stp (max-width: 760px) {
    #shopify-section-{{ sid }} .stp__heading { font-size: var(--b-size-m, calc(var(--heading-font-scale, 1) * var(--h2-size, 3.6rem))); }
  }
  #shopify-section-{{ sid }} .stp__sub { line-height: 1.55; color: var(--b-color, var(--color-text)); font-size: var(--b-size, 15px); max-width: var(--b-max, 600px); }
  #shopify-section-{{ sid }} .stp__sub p, #shopify-section-{{ sid }} .stp__step-desc p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .stp__sub p:last-child, #shopify-section-{{ sid }} .stp__step-desc p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .stp__steps {
    margin: 0 var(--stp-steps-mr) 0 var(--stp-steps-ml); padding: 0; list-style: none; display: flex; flex-direction: column; max-width: var(--stp-steps-max); text-align: left;
  }
  #shopify-section-{{ sid }} .stp__step {
    position: relative; display: grid; grid-template-columns: var(--stp-mk) minmax(0, 1fr); gap: var(--stp-gap-inline); padding: 0 0 var(--stp-gap-below);
    --stp-mk-s: var(--b-mk, var(--stp-mk-c));
  }
  #shopify-section-{{ sid }} .stp__step:not(:last-child)::before {
    content: ''; position: absolute; top: var(--stp-mk); bottom: 0; left: calc(var(--stp-mk) / 2 - var(--stp-line-w) / 2);
    border-left: var(--stp-line-w) var(--stp-line-style) var(--stp-line, var(--color-border));
  }
  #shopify-section-{{ sid }} .stp__step-marker {
    width: var(--stp-mk); height: var(--stp-mk); flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    color: var(--stp-marker-text, var(--color-background)); font-weight: 700; font-size: var(--stp-mk-font); line-height: 1; border-radius: 999px;
    background: var(--stp-mk-s); border: var(--stp-line-w) solid var(--stp-mk-s);
  }
  #shopify-section-{{ sid }} .stp__step--dot .stp__step-marker,
  #shopify-section-{{ sid }} .stp__step--dot_outline .stp__step-marker {
    width: calc(var(--stp-mk) / 2); height: calc(var(--stp-mk) / 2); margin: calc(var(--stp-mk) / 4) 0 0 calc(var(--stp-mk) / 4);
  }
  #shopify-section-{{ sid }} .stp__step--dot .stp__step-marker { border: 0; }
  #shopify-section-{{ sid }} .stp__step--dot_outline .stp__step-marker { background: transparent; }
  #shopify-section-{{ sid }} .stp__step--numbered_outline .stp__step-marker { background: transparent; color: var(--stp-mk-s); }
  #shopify-section-{{ sid }} .stp__step--icon .stp__step-marker { background: transparent; border: 0; color: var(--stp-mk-s); }
  #shopify-section-{{ sid }} .stp__step-num { display: none; }
  #shopify-section-{{ sid }} :is(.stp__step--numbered, .stp__step--numbered_outline) .stp__step-num { display: inline; }
  #shopify-section-{{ sid }} .stp__step-marker img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ sid }} .stp__step-content { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  #shopify-section-{{ sid }} .stp__step-title {
    margin: 0; font-family: var(--stp-hfont, var(--heading-font)); font-weight: var(--heading-weight, 700); font-size: var(--stp-title-size);
    line-height: var(--heading-line-height, 1.3); color: var(--b-title, var(--stp-title, var(--color-heading)));
  }
  #shopify-section-{{ sid }} .stp__step-prefix { display: none; color: var(--stp-mk-s); margin-right: 6px; font-feature-settings: 'tnum'; }
  #shopify-section-{{ sid }} .stp__step--prefixed .stp__step-prefix { display: inline; }
  #shopify-section-{{ sid }} .stp__step-desc { margin: 0; font-size: var(--stp-desc-size); line-height: 1.55; color: var(--b-desc, var(--stp-desc, var(--color-text))); }
  #shopify-section-{{ sid }} .stp__buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: var(--stp-ai); margin-top: var(--stp-btn-mt); }
  #shopify-section-{{ sid }} .stp__btn { text-decoration: none; max-width: 100%; }
{% comment %}{% endcomment %}</style>

<div class="section{% if s.reset_spacing %} remove_spacing{% endif %} color-{{ color_scheme }} gradient {{ s.section_width | default: 'full_width' }}" data-fd="steps" data-fd-section="{{ sid }}" data-fd-settings="{{ s | json | escape }}"{% if s.enable_custom_fonts %} data-own-font{% endif %}>
  <div class="stp" data-section-id="{{ sid }}" data-width="{{ s.section_width | default: 'full_width' }}" style="{{ stp_style | strip_newlines }}">
    <div class="stp__inner">
      {%- liquid
        assign head_count = 0
        for block in section.blocks
          if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading'
            assign head_count = head_count | plus: 1
          endif
        endfor
      -%}
      <header class="stp__head"{% if head_count == 0 %} hidden{% endif %}>
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="stp__eyebrow" data-fd-block="{{ block.id }}" data-fd-type="eyebrow" data-fd-settings="{{ bs | json | escape }}" style="--b-size: {{ bs.size | default: 12 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
            {%- when 'heading' -%}
              <h2 class="stp__heading" data-fd-block="{{ block.id }}" data-fd-type="heading" data-fd-settings="{{ bs | json | escape }}" style="{% if bs.size_enable %}--b-size-m: {{ bs.size_mobile | default: 28 }}px; --b-size-d: {{ bs.size_desktop | default: 40 }}px;{% endif %}{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="stp__sub" data-fd-block="{{ block.id }}" data-fd-type="subheading" data-fd-settings="{{ bs | json | escape }}" style="--b-size: {{ bs.size | default: 15 }}px; --b-max: {{ bs.max_width | default: 600 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </header>

      {%- if step_blocks.size > 0 -%}
        <ol class="stp__steps" data-style="{{ step_style }}">
          {%- for block in step_blocks -%}
            {%- assign sb = block.settings -%}
            {%- assign step_class = step_style -%}
            {%- if sb.icon != blank -%}{%- assign step_class = 'icon' -%}{%- endif -%}
            <li class="stp__step stp__step--{{ step_class }}" data-fd-block="{{ block.id }}" data-fd-type="step" data-fd-settings="{{ sb | json | escape }}" style="{% render 'media-msr-var', name: '--b-mk', color: sb.marker_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-title', color: sb.title_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-desc', color: sb.description_color, on: sb.enable_custom_style %}" {{ block.shopify_attributes }}>
              <div class="stp__step-marker" aria-hidden="true">
                {%- if sb.icon != blank -%}
                  {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 40, height: 40 }}
                {%- endif -%}
                <span class="stp__step-num">{{ forloop.index }}</span>
              </div>
              <div class="stp__step-content">
                <h3 class="stp__step-title"><span class="stp__step-prefix">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><span class="stp__step-text">{{ sb.title | default: fb_accessibility_step_title | escape }}</span></h3>
                <div class="stp__step-desc"{% if sb.description == blank %} hidden{% endif %}>{{ sb.description }}</div>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if button_blocks.size > 0 -%}
        <div class="stp__buttons">
          {%- for block in button_blocks -%}
            {%- assign bs = block.settings -%}
            {%- if bs.url != blank -%}
              <a class="stp__btn" data-theme-button="primary" data-sl-button href="{{ bs.url }}" data-fd-block="{{ block.id }}" data-fd-type="button" data-fd-settings="{{ bs | json | escape }}"{% if geo %} data-own-shape{% endif %} style="{{ btn_style | strip_newlines }}"{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
            {%- else -%}
              <button type="button" class="stp__btn" data-theme-button="primary" data-sl-button data-fd-block="{{ block.id }}" data-fd-type="button" data-fd-settings="{{ bs | json | escape }}"{% if geo %} data-own-shape{% endif %} style="{{ btn_style | strip_newlines }}"{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.label | escape }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- comment -%} Live edits: shopify/assets/live-features-d.js (loaded on every page). {%- endcomment -%}



</template>
<schema>
{
  "type": "steps",
  "name": "Steps",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove theme spacing between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Space below header",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "steps_max_width",
      "label": "Steps max width",
      "min": 320,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Marker style",
      "default": "numbered",
      "options": [
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "dot_outline",
          "label": "Outlined dot"
        },
        {
          "value": "numbered",
          "label": "Number"
        },
        {
          "value": "numbered_outline",
          "label": "Outlined number"
        },
        {
          "value": "prefixed",
          "label": "Number before title"
        },
        {
          "value": "icon",
          "label": "Icon (outlined)"
        }
      ]
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ]
    },
    {
      "type": "range",
      "id": "step_gap_inline",
      "label": "Marker to text gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "step_gap_below",
      "label": "Gap between steps",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Space above buttons",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "marker_font_size",
      "label": "Marker number size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "step_title_size",
      "label": "Step title size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "step_desc_size",
      "label": "Step text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "marker_text_color",
      "label": "Marker number",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title",
