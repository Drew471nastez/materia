    {
      "type": "text",
      "id": "end_iso",
      "label": "End date and time",
      "default": "",
      "info": "Format: 2026-12-31T23:59:00, or 2026-12-31T23:59:00+02:00 for one moment everywhere. An impossible date such as 2026-02-30 hides the timer. Daylight saving: a date with an offset (+02:00) stays fixed; one without counts to the visitor's own clock. Bucharest is +03:00 in summer and +02:00 in winter, so use the offset in force on the end date.",
      "placeholder": "2026-12-31T23:59:00"
    },
