<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- assign fb_accessibility_hours = 'accessibility.hours' | t -%}
{%- assign fb_accessibility_days = 'accessibility.days' | t -%}
{%- assign fb_accessibility_seconds = 'accessibility.seconds' | t -%}
{%- assign fb_accessibility_minutes = 'accessibility.minutes' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Countdown Timer Flip
  Flip-clock-style countdown with split-flap digits. Each unit (days,
  hours, minutes, seconds) renders as a card with two stacked halves
  divided by a thin gap line, evoking a mechanical flip counter.

  Block-organized: heading + subheading + button (CTA) + per-unit
  toggle blocks. End-time configurable as a fixed date/time string. JS
  recomputes the digits each tick. Section can render as inline (small)
  or hero (centered with CTA). Renders fully without JS — server prints
  the initial digits so previews and crawlers see numbers.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign cta = nil
  for b in section.blocks
    if b.type == 'cta' and cta == nil
      assign cta = b
    endif
  endfor
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase

  comment
    Compute initial digits server-side so the section is never empty on
    first paint. We derive remaining seconds from end_iso when possible;
    fallback to a fixed 24h example.
  endcomment
  assign end_iso = st.end_iso | default: ''
  assign initial_seconds = st.initial_seconds_fallback | default: 86400
  if end_iso != blank
    assign end_time_t = end_iso | date: '%s' | plus: 0
    assign now_t = 'now' | date: '%s' | plus: 0
    assign initial_seconds = end_time_t | minus: now_t
    if initial_seconds < 0
      assign initial_seconds = 0
    endif
  endif
  assign d = initial_seconds | divided_by: 86400
  assign rem = initial_seconds | modulo: 86400
  assign h = rem | divided_by: 3600
  assign rem = rem | modulo: 3600
  assign m = rem | divided_by: 60
  assign s = rem | modulo: 60
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .cdf {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width */
  #shopify-section-{{ sid }} .cdf__inner {
    max-width: {{ st.section_max_width_mobile | default: 560 }}px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf__inner {
      max-width: {{ st.section_max_width_tablet | default: 800 }}px;
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .cdf__inner {
      max-width: {{ st.section_max_width_desktop | default: 960 }}px;
    }
  }

  /* Header */
  #shopify-section-{{ sid }} .cdf__header {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    margin: 0 auto {{ st.gap_subheading_clock_mobile | default: 28 }}px;
    gap: {{ st.heading_sub_gap_mobile | default: 8 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf__header {
      margin-bottom: {{ st.gap_subheading_clock | default: 40 }}px;
      gap: {{ st.heading_sub_gap_desktop | default: 14 }}px;
    }
  }
  #shopify-section-{{ sid }} .cdf__header > *,
  #shopify-section-{{ sid }} .cdf__header :is(h1, h2, h3, h4, h5, h6, p, div, span) {
    margin-block: 0 !important;
    margin-block-start: 0 !important;
    margin-block-end: 0 !important;
    padding-block: 0 !important;
  }

  /* Clock row */
  #shopify-section-{{ sid }} .cdf__clock {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ flex_align }};
    align-items: stretch;
    gap: {{ st.unit_gap_mobile | default: 10 }}px;
    text-align: center;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf__clock {
      gap: {{ st.unit_gap_desktop | default: 16 }}px;
    }
  }

  /* One unit (Days, Hours...) */
  #shopify-section-{{ sid }} .cdf__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* The flip card itself */
  #shopify-section-{{ sid }} .cdf__card {
    position: relative;
    background: {% render 'scheme-color', color: st.card_bg, fallback: 'var(--color-heading)' %};
    color: {% render 'scheme-color', color: st.digit_color, fallback: 'var(--color-background)' %};
    border-radius: {{ st.card_radius | default: 10 }}px;
    box-shadow: {{ st.card_shadow | default: '0 6px 16px -8px rgba(0,0,0,.35)' }};
    overflow: hidden;
    width: {{ st.card_width_mobile | default: 70 }}px;
    height: {{ st.card_height_mobile | default: 80 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf__card {
      width: {{ st.card_width_desktop | default: 100 }}px;
      height: {{ st.card_height_desktop | default: 100 }}px;
    }
  }

  /* Split horizontal line in the middle (flip-clock illusion) */
  #shopify-section-{{ sid }} .cdf__card::before {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    height: {{ st.card_split_height | default: 2 }}px;
    background: {% render 'scheme-color', color: st.card_split_color, fallback: 'rgba(0,0,0,0.65)' %};
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 2;
  }

  /* Optional inset highlight on top half */
  {%- if st.show_highlight -%}
    #shopify-section-{{ sid }} .cdf__card::after {
      content: '';
      position: absolute;
      inset: 0 0 50% 0;
      background: linear-gradient(180deg, rgba(255,255,255,.06) 0%, rgba(255,255,255,0) 100%);
      pointer-events: none;
      z-index: 1;
    }
  {%- endif -%}

  /* Digits */
  #shopify-section-{{ sid }} .cdf__digits {
    position: relative;
    z-index: 0;
    font-weight: {{ st.digit_weight | default: 800 }};
    font-size: {{ st.digit_size_mobile | default: 30 }}px;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cdf__digits {
      font-size: {{ st.digit_size_desktop | default: 44 }}px;
    }
  }

  /* Unit labels */
  #shopify-section-{{ sid }} .cdf__label {
    font-size: {{ st.label_size | default: 12 }}px;
    font-weight: {{ st.label_weight | default: 500 }};
    color: {% render 'scheme-color', color: st.label_color, fallback: 'var(--color-text)' %};
    text-transform: {{ st.label_transform | default: 'capitalize' }};
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  /* Optional separator dots between units */
  {%- if st.show_separators -%}
    #shopify-section-{{ sid }} .cdf__sep {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 8px;
      color: {% render 'scheme-color', color: st.separator_color, fallback: 'var(--color-heading)' %};
      font-size: {{ st.digit_size_mobile | default: 30 }}px;
      font-weight: {{ st.digit_weight | default: 800 }};
      align-self: center;
      min-height: {{ st.card_height_mobile | default: 80 }}px;
    }
    @media (min-width: 768px) {
      #shopify-section-{{ sid }} .cdf__sep {
        font-size: {{ st.digit_size_desktop | default: 44 }}px;
        min-height: {{ st.card_height_desktop | default: 100 }}px;
      }
    }
  {%- else -%}
    #shopify-section-{{ sid }} .cdf__sep { display: none; }
  {%- endif -%}

  /* CTA button */
  #shopify-section-{{ sid }} .cdf__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: {{ flex_align }};
    text-decoration: none;
    background: {% render 'scheme-color', color: st.cta_bg, fallback: 'var(--btn-secondary-bg-color)' %};
    color: {% render 'scheme-color', color: st.cta_color, fallback: 'var(--btn-secondary-color)' %};
    {%- if st.use_theme_button -%}
    border: var(--btn-border-width, 1px) solid {% render 'scheme-color', color: st.cta_border_color, fallback: 'var(--btn-secondary-border-color)' %};
    padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 28px);
    border-radius: var(--btn-radius, 999px);
    font-weight: var(--btn-font-weight, 600);
    font-size: var(--btn-font-size, 15px);
    {%- else -%}
    border: {{ st.cta_border_width | default: 1 }}px solid {% render 'scheme-color', color: st.cta_border_color, fallback: 'var(--btn-secondary-border-color)' %};
    padding: {{ st.cta_pad_y | default: 12 }}px {{ st.cta_pad_x | default: 28 }}px;
    border-radius: {{ st.cta_radius | default: 999 }}px;
    font-weight: var(--btn-font-weight, 600);
    font-size: {{ st.cta_size | default: 15 }}px;
    {%- endif -%}
    margin-top: {{ st.gap_clock_cta | default: 24 }}px;
    transition: background .2s ease, color .2s ease, transform .15s ease;
  }
  #shopify-section-{{ sid }} .cdf__cta:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  #shopify-section-{{ sid }} .cdf__cta:hover {
    background: {% render 'scheme-color', color: st.cta_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
    color: {% render 'scheme-color', color: st.cta_color_hover, fallback: 'var(--btn-primary-hover-color)' %};
    transform: translateY(-1px);
  }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .cdf { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .cdf { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .cdf { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .cdf { display: block; } }
  {%- endif -%}

  /* When timer expires, optionally hide whole section or show only the
     "expired" message */
  #shopify-section-{{ sid }}.cdf-expired .cdf__clock,
  #shopify-section-{{ sid }}.cdf-expired .cdf__cta { display: none; }
  #shopify-section-{{ sid }} .cdf__expired-msg { display: none; }
  #shopify-section-{{ sid }}.cdf-expired .cdf__expired-msg {
    display: block;
    text-align: {{ align }};
    color: {% render 'scheme-color', color: st.expired_color, fallback: 'var(--color-text)' %};
    font-size: 16px;
    margin-top: 16px;
  }
{% comment %}{% endcomment %}</style>

<section class="cdf color-{{ color_scheme }} gradient {{ section.settings.section_width }}" id="cdf-{{ sid }}">
  <div class="cdf__inner" style="display:flex;flex-direction:column;align-items:{{ flex_align }};">

    {%- comment -%}========== HEADER ==========={%- endcomment -%}
    {%- assign has_header = false -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'heading' or b.type == 'subheading' -%}
        {%- assign has_header = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_header -%}
      <div class="cdf__header">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="cdf__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %} !important;
                    font-weight: {% if bs.weight == blank or bs.weight == 'theme' %}var(--heading-weight, 600){% else %}{{ bs.weight }}{% endif %};
                    line-height: {{ bs.line_height | default: 1.2 }};
                    font-size: {{ bs.size_mobile | default: 24 }}px !important;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 32 }}px !important; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="cdf__sub" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %} !important;
                    font-size: {{ bs.size | default: 16 }}px;
                    line-height: 1.5;
                    max-width: {{ bs.max_width | default: 600 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0 !important; padding: 0 !important; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}========== CLOCK ==========={%- endcomment -%}
    {%- liquid
      comment
        Build a list of visible units so separators only render between
        consecutive visible cards (never trailing).
      endcomment
      assign units_visible = '' | split: ','
      if st.show_days
        assign units_visible = units_visible | concat: 'd' | split: ''
      endif
      assign visible_count = 0
      if st.show_days
        assign visible_count = visible_count | plus: 1
      endif
      if st.show_hours
        assign visible_count = visible_count | plus: 1
      endif
      if st.show_minutes
        assign visible_count = visible_count | plus: 1
      endif
      if st.show_seconds
        assign visible_count = visible_count | plus: 1
      endif
    -%}
    <div class="cdf__clock"
         data-cdf-clock
         data-end="{{ end_iso | escape }}">

      {%- assign rendered_count = 0 -%}

      {%- if st.show_days -%}
        <div class="cdf__unit">
          <div class="cdf__card"><span class="cdf__digits" data-cdf-d>{%- if d < 10 -%}0{%- endif -%}{{ d }}</span></div>
          <div class="cdf__label">{{ st.label_days | default: fb_accessibility_days }}</div>
        </div>
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count < visible_count -%}<div class="cdf__sep" aria-hidden="true">:</div>{%- endif -%}
      {%- endif -%}

      {%- if st.show_hours -%}
        <div class="cdf__unit">
          <div class="cdf__card"><span class="cdf__digits" data-cdf-h>{%- if h < 10 -%}0{%- endif -%}{{ h }}</span></div>
          <div class="cdf__label">{{ st.label_hours | default: fb_accessibility_hours }}</div>
        </div>
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count < visible_count -%}<div class="cdf__sep" aria-hidden="true">:</div>{%- endif -%}
      {%- endif -%}

      {%- if st.show_minutes -%}
        <div class="cdf__unit">
          <div class="cdf__card"><span class="cdf__digits" data-cdf-m>{%- if m < 10 -%}0{%- endif -%}{{ m }}</span></div>
          <div class="cdf__label">{{ st.label_minutes | default: fb_accessibility_minutes }}</div>
        </div>
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count < visible_count -%}<div class="cdf__sep" aria-hidden="true">:</div>{%- endif -%}
      {%- endif -%}

      {%- if st.show_seconds -%}
        <div class="cdf__unit">
          <div class="cdf__card"><span class="cdf__digits" data-cdf-s>{%- if s < 10 -%}0{%- endif -%}{{ s }}</span></div>
          <div class="cdf__label">{{ st.label_seconds | default: fb_accessibility_seconds }}</div>
        </div>
      {%- endif -%}
    </div>

    {%- if cta and cta.settings.text != blank -%}
      <a class="cdf__cta" href="{{ cta.settings.link | default: '#' }}" {{ cta.shopify_attributes }}>{{ cta.settings.text }}</a>
    {%- endif -%}

    {%- if st.expired_message != blank -%}
      <div class="cdf__expired-msg">{{ st.expired_message }}</div>
    {%- endif -%}

  </div>
</section>

<script>
(function(){
function init(){
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var clock = root.querySelector('[data-cdf-clock]');
  if (!clock || clock.__cdfInit) return;
  clock.__cdfInit = true;
  if (root.__cdfIv) clearInterval(root.__cdfIv);
  root.classList.remove('cdf-expired');
  var endRaw = clock.getAttribute('data-end');
  if (!endRaw) return;
  var end = Date.parse(endRaw);
  if (isNaN(end)) return;

  var dEl = clock.querySelector('[data-cdf-d]');
  var hEl = clock.querySelector('[data-cdf-h]');
  var mEl = clock.querySelector('[data-cdf-m]');
  var sEl = clock.querySelector('[data-cdf-s]');

  function pad(n){ n = String(Math.max(0, Math.floor(n))); return n.length < 2 ? '0' + n : n; }

  function tick(){
    var diff = Math.max(0, Math.floor((end - Date.now()) / 1000));
    var d = Math.floor(diff / 86400);
    var h = Math.floor((diff % 86400) / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    if (dEl) dEl.textContent = pad(d);
    if (hEl) hEl.textContent = pad(h);
    if (mEl) mEl.textContent = pad(m);
    if (sEl) sEl.textContent = pad(s);
    if (diff <= 0) {
      root.classList.add('cdf-expired');
      clearInterval(iv);
    }
  }
  var iv = setInterval(tick, 1000);
  root.__cdfIv = iv;
  tick();
}
init();
if (!window['__cdfLoad_{{ sid }}']) {
  window['__cdfLoad_{{ sid }}'] = true;
  document.addEventListener('storelib:section-load', function(e){
    if (e.detail && String(e.detail.sectionId) === '{{ sid }}') init();
  });
}
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "countdown-flip",
  "name": "Countdown Timer Flip",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
