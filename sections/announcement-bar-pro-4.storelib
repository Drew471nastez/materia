<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        width: 100%;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        width: 100%;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- assign fb_accessibility_close = 'accessibility.close' | t -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  /* Defensive baseline so the bar is always visible at static render
     (Shopify section-picker preview, no-JS, etc.) */
  #shopify-section-{{ section.id }} .abp4 {
    opacity: 1;
    visibility: visible;
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Announcement Bar Pro 4
  Stacked layout: message on top, countdown + button below on the same line.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign message = st.message
  assign show_countdown = st.show_countdown
  assign show_button = st.show_button
  assign show_close = st.show_close
  assign button_label = st.button_label
  assign button_url = st.button_url

  assign end_date = st.end_date
  assign end_time = st.end_time
  assign on_end = st.on_end | default: 'freeze'

  assign days_fallback = 'accessibility.days' | t
  assign hours_fallback = 'accessibility.hours' | t
  assign mins_fallback = 'accessibility.mins' | t
  assign secs_fallback = 'accessibility.secs' | t
  assign label_days = st.label_days | default: days_fallback
  assign label_hours = st.label_hours | default: hours_fallback
  assign label_minutes = st.label_minutes | default: mins_fallback
  assign label_seconds = st.label_seconds | default: secs_fallback

  assign bg_color = st.bg_color
  if bg_color == blank or bg_color.alpha == 0
    assign bg_color = 'var(--color-background)'
  endif
  assign text_color = st.text_color
  if text_color == blank or text_color.alpha == 0
    assign text_color = 'var(--color-text)'
  endif
  assign digit_color = st.digit_color
  if digit_color == blank or digit_color.alpha == 0
    assign digit_color = 'var(--color-heading)'
  endif
  assign digit_label_color = st.digit_label_color
  if digit_label_color == blank or digit_label_color.alpha == 0
    assign digit_label_color = 'var(--color-text)'
  endif
  assign separator_color = st.separator_color
  if separator_color == blank or separator_color.alpha == 0
    assign separator_color = 'var(--color-border)'
  endif
  assign close_color = st.close_color
  if close_color == blank or close_color.alpha == 0
    assign close_color = 'var(--color-heading)'
  endif
  assign btn_bg = st.btn_bg
  if btn_bg == blank or btn_bg.alpha == 0
    assign btn_bg = 'var(--btn-primary-bg-color)'
  endif
  assign btn_bg_hover = st.btn_bg_hover
  if btn_bg_hover == blank or btn_bg_hover.alpha == 0
    assign btn_bg_hover = 'var(--btn-primary-hover-bg-color)'
  endif
  assign btn_text = st.btn_text
  if btn_text == blank or btn_text.alpha == 0
    assign btn_text = 'var(--btn-primary-color)'
  endif
  assign btn_text_hover = st.btn_text_hover
  if btn_text_hover == blank or btn_text_hover.alpha == 0
    assign btn_text_hover = 'var(--btn-primary-hover-color)'
  endif
  assign btn_radius = st.btn_radius | default: 6

  assign content_alignment = st.content_alignment | default: 'center'
  assign message_size_d = st.message_size_desktop | default: 16
  assign message_size_m = st.message_size_mobile | default: 13

  assign digit_size_d = st.digit_size_desktop | default: 22
  assign digit_size_m = st.digit_size_mobile | default: 16

  assign btn_size_d = st.btn_size_desktop | default: 14
  assign btn_size_m = st.btn_size_mobile | default: 11

  # Font-weight: inherit from theme unless user explicitly enables custom override
  if st.enable_custom_message_weight and st.message_weight != blank
    assign message_weight = st.message_weight
  else
    assign message_weight = 'var(--heading-weight, 700)'
  endif
  if st.enable_custom_digit_weight and st.digit_weight != blank
    assign digit_weight = st.digit_weight
  else
    assign digit_weight = 'var(--heading-weight, 700)'
  endif
  if st.enable_custom_btn_weight and st.btn_weight != blank
    assign btn_weight = st.btn_weight
  else
    assign btn_weight = 'var(--btn-font-weight, var(--heading-weight, 700))'
  endif

  assign row_gap = st.row_gap | default: 8
  assign group_gap_d = st.group_gap_desktop | default: 16
  assign group_gap_m = st.group_gap_mobile | default: 10
  assign pad_y_desktop = st.pad_y_desktop | default: 14
  assign pad_y_mobile = st.pad_y_mobile | default: 10
  assign pad_x_desktop = st.pad_x_desktop | default: 24
  assign pad_x_mobile = st.pad_x_mobile | default: 14

  assign btn_pad_x = st.btn_pad_x | default: 22
  assign btn_pad_y = st.btn_pad_y | default: 10

  assign align_value = 'center'
  if content_alignment == 'left'
    assign align_value = 'flex-start'
  elsif content_alignment == 'right'
    assign align_value = 'flex-end'
  endif

  assign storage_key = 'abp4-dismissed-' | append: sid
-%}

<style>
  /* ============================================================
     Announcement Bar Pro 4 — fully scoped to #shopify-section-{{ sid }}
     ============================================================ */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
    max-width: 100% !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* Bar — Mobile: stacked column (message on top). Desktop: single inline row. */
  #shopify-section-{{ sid }} .abp4 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: {{ align_value }};
    gap: {{ row_gap }}px;
    background-color: {{ bg_color }} !important;
    color: {{ text_color }} !important;
    width: 100%;
    box-sizing: border-box;
    padding: {{ pad_y_mobile }}px {{ pad_x_mobile }}px;
    {% if show_close %}padding-right: calc({{ pad_x_mobile }}px + 28px);{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4 {
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: {{ align_value }};
      align-items: center;
      gap: {{ group_gap_d }}px;
      padding: {{ pad_y_desktop }}px {{ pad_x_desktop }}px;
      {% if show_close %}padding-right: calc({{ pad_x_desktop }}px + 36px);{% endif %}
    }
  }
  #shopify-section-{{ sid }} .abp4[data-ended="true"][data-on-end="hide"],
  #shopify-section-{{ sid }} .abp4.is-dismissed {
    display: none !important;
  }

  /* Mobile: message takes full row above. Desktop: message is just one of three flex children. */
  #shopify-section-{{ sid }} .abp4__message {
    margin: 0;
    font-size: {{ message_size_m }}px;
    font-weight: {{ message_weight }};
    line-height: 1.3;
    color: {{ text_color }} !important;
    text-align: {{ content_alignment }};
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__message {
      font-size: {{ message_size_d }}px;
      width: auto;
      flex-shrink: 1;
      min-width: 0;
      text-align: left;
    }
  }

  /* Mobile: countdown+button group lives on its own row. Desktop: contents flow inline with message. */
  #shopify-section-{{ sid }} .abp4__group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: {{ align_value }};
    gap: {{ group_gap_m }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__group {
      width: auto;
      flex-shrink: 0;
      gap: {{ group_gap_d }}px;
    }
  }

  /* Countdown */
  #shopify-section-{{ sid }} .abp4__countdown {
    display: inline-flex;
    align-items: flex-start;
    gap: 4px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__countdown { gap: 8px; }
  }
  #shopify-section-{{ sid }} .abp4__unit {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 2em;
  }
  #shopify-section-{{ sid }} .abp4__digit {
    font-size: {{ digit_size_m }}px;
    font-weight: {{ digit_weight }};
    color: {{ digit_color }} !important;
    line-height: 1;
  }
  #shopify-section-{{ sid }} .abp4__label {
    font-size: 9px;
    font-weight: 500;
    color: {{ digit_label_color }} !important;
    margin-top: 3px;
    text-transform: capitalize;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
  #shopify-section-{{ sid }} .abp4__sep {
    color: {{ separator_color }} !important;
    font-size: {{ digit_size_m }}px;
    font-weight: {{ digit_weight }};
    opacity: 0.7;
    line-height: 1;
    align-self: flex-start;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__digit,
    #shopify-section-{{ sid }} .abp4__sep {
      font-size: {{ digit_size_d }}px;
    }
    #shopify-section-{{ sid }} .abp4__label {
      font-size: 11px;
      margin-top: 4px;
    }
  }

  /* Button — stays inline with countdown on every screen size */
  #shopify-section-{{ sid }} .abp4__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background-color: {{ btn_bg }} !important;
    color: {{ btn_text }} !important;
    {%- if st.use_theme_button -%}
    font-size: var(--btn-font-size, 14px);
    font-weight: var(--btn-font-weight, 500);
    font-family: var(--btn-font, var(--body-font));
    padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
    border-radius: var(--btn-radius, 8px);
    letter-spacing: var(--btn-letter-spacing, 0);
    text-transform: var(--btn-text-transform, none);
    {%- else -%}
    font-size: {{ btn_size_m }}px;
    font-weight: {{ btn_weight }};
    padding: 7px 14px;
    border-radius: {{ btn_radius }}px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    {%- endif -%}
    border: 0;
    line-height: 1;
    transition: background-color .2s ease, color .2s ease, transform .15s ease;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__btn {
      {%- if st.use_theme_button -%}
      font-size: var(--btn-font-size, 14px);
      padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
      {%- else -%}
      font-size: {{ btn_size_d }}px;
      padding: {{ btn_pad_y }}px {{ btn_pad_x }}px;
      {%- endif -%}
    }
  }
  #shopify-section-{{ sid }} .abp4__btn:hover {
    background-color: {{ btn_bg_hover }} !important;
    color: {{ btn_text_hover }} !important;
    transform: translateY(-1px);
  }

  /* Close icon — top-right, very subtle */
  #shopify-section-{{ sid }} .abp4__close {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
    color: {{ close_color }} !important;
    opacity: 0.55;
    transition: opacity .15s ease, background-color .15s ease;
    border-radius: 50%;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .abp4__close:hover,
  #shopify-section-{{ sid }} .abp4__close:focus-visible {
    opacity: 1;
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }
  #shopify-section-{{ sid }} .abp4__close svg {
    width: 11px;
    height: 11px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abp4__close {
      top: 50%;
      right: 14px;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
    }
    #shopify-section-{{ sid }} .abp4__close svg { width: 14px; height: 14px; }
  }

  /* Reveal-on-load.
     Gated behind `.abp4--armed` (added by JS) so previews and no-JS render
     stays visible. Without --armed, .abp4 keeps its default opacity:1 + no
     transform — no animation, no blank preview thumbnail. */
  {%- if st.reveal -%}
    #shopify-section-{{ sid }} .abp4--armed {
      animation: abp4-reveal-{{ sid }} .55s cubic-bezier(.2,.7,.2,1) both;
    }
    @keyframes abp4-reveal-{{ sid }} {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .abp4--armed { animation: none; }
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<div
  class="abp4 color-{{ color_scheme }} gradient {{ section.settings.section_width | default: 'full_width' }}"
  id="abp4-{{ sid }}"
  data-section-id="{{ sid }}"
  data-end-date="{{ end_date }}"
  data-end-time="{{ end_time }}"
  data-on-end="{{ on_end }}"
  data-show-countdown="{% if show_countdown %}true{% else %}false{% endif %}"
  data-storage-key="{{ storage_key }}"
>
  {%- if message != blank -%}
    <p class="abp4__message">{{ message }}</p>
  {%- endif -%}

  {%- if show_countdown or show_button -%}
    <div class="abp4__group">
      {%- if show_countdown -%}
        <div class="abp4__countdown" role="timer" aria-live="polite">
          <div class="abp4__unit"><span class="abp4__digit" data-unit="d">00</span><span class="abp4__label">{{ label_days }}</span></div>
          <span class="abp4__sep">:</span>
          <div class="abp4__unit"><span class="abp4__digit" data-unit="h">00</span><span class="abp4__label">{{ label_hours }}</span></div>
          <span class="abp4__sep">:</span>
          <div class="abp4__unit"><span class="abp4__digit" data-unit="m">00</span><span class="abp4__label">{{ label_minutes }}</span></div>
          <span class="abp4__sep">:</span>
          <div class="abp4__unit"><span class="abp4__digit" data-unit="s">00</span><span class="abp4__label">{{ label_seconds }}</span></div>
        </div>
      {%- endif -%}
      {%- if show_button and button_label != blank -%}
        <a class="abp4__btn" href="{{ button_url | default: '#' }}">{{ button_label }}</a>
      {%- endif -%}

      {%- comment -%}========== EXTRA LINK BLOCKS + APP BLOCKS ==========={%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'extra_link' -%}
          {%- if block.settings.label != blank -%}
            <a class="abp4__extra-link" href="{{ block.settings.link | default: '#' }}"
               style="color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %}; font-size: {{ block.settings.size | default: 13 }}px; font-weight: {{ block.settings.weight | default: 500 }};"
               {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endif -%}
        {%- elsif block.type == '@app' -%}
          {% render block %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if show_close -%}
    <button type="button" class="abp4__close" aria-label="{{ 'general.close' | t | default: fb_accessibility_close }}">
      <svg viewBox="0 0 14 14" aria-hidden="true">
        <path d="M2 2L12 12M12 2L2 12" stroke-linecap="round"/>
      </svg>
    </button>
  {%- endif -%}
</div>

<script>
  (function () {
    var bar = document.getElementById('abp4-{{ sid }}');
    if (!bar) return;

    var storageKey = bar.dataset.storageKey;
    var inDesignMode = document.body.classList.contains('shopify-design-mode');

    // Arm the reveal animation now that JS is loaded. Without this the bar
    // stays at its default visible state (no animation), which keeps section
    // picker previews visible.
    if (!inDesignMode) bar.classList.add('abp4--armed');

    var closeBtn = bar.querySelector('.abp4__close');
    if (closeBtn) {
      if (!inDesignMode) {
        try {
          if (storageKey && window.localStorage && localStorage.getItem(storageKey) === '1') {
            bar.classList.add('is-dismissed');
          }
        } catch (e) {}
      }
      closeBtn.addEventListener('click', function () {
        bar.classList.add('is-dismissed');
        try {
          if (storageKey && window.localStorage) {
            localStorage.setItem(storageKey, '1');
          }
        } catch (e) {}
      });
    }

    if (bar.dataset.showCountdown !== 'true') return;
    var endDate = bar.dataset.endDate || '';
    var endTime = bar.dataset.endTime || '00:00';
    if (!endDate) return;

    var iso = endDate + 'T' + endTime + ':00';
    var target = new Date(iso).getTime();
    if (isNaN(target)) return;

    var unitEls = {
      d: bar.querySelector('[data-unit="d"]'),
      h: bar.querySelector('[data-unit="h"]'),
      m: bar.querySelector('[data-unit="m"]'),
      s: bar.querySelector('[data-unit="s"]')
    };

    function pad(n) { return n < 10 ? '0' + n : String(n); }
    function setVal(el, v) {
      if (!el) return;
      var s = pad(v);
      if (el.textContent !== s) el.textContent = s;
    }
    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) {
        setVal(unitEls.d, 0); setVal(unitEls.h, 0); setVal(unitEls.m, 0); setVal(unitEls.s, 0);
        bar.setAttribute('data-ended', 'true');
        clearInterval(bar._abp4Interval);
        return;
      }
      var s = Math.floor(diff / 1000);
      var d = Math.floor(s / 86400);
      var h = Math.floor((s % 86400) / 3600);
      var m = Math.floor((s % 3600) / 60);
      var sec = s % 60;
      setVal(unitEls.d, d);
      setVal(unitEls.h, h);
      setVal(unitEls.m, m);
      setVal(unitEls.s, sec);
    }
    tick();
    bar._abp4Interval = setInterval(tick, 1000);
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "announcement-bar-pro-4",
  "name": "Announcement Bar Pro 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on load",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Enable close button",
      "default": false,
      "info": "Adds a subtle close icon at the top-right. When clicked, the bar is dismissed for that visitor and won't reappear (saved in their browser)."
    },
    {
