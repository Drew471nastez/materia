        "default": "2026-12-31",
        "visible_if": "{{ section.settings.show_countdown }}"
      },
      {
        "type": "text",
        "id": "end_time",
        "label": "End time",
        "info": "24-hour HH:MM",
        "default": "23:59",
        "visible_if": "{{ section.settings.show_countdown }}"
      },
      {
        "type": "select",
        "id": "on_end",
