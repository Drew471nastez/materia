  "enabled_on": {
    "groups": [
      "header",
      "template"
    ]
  },
  "shopify": {
    "name": "Announcement Bar Pro 4",
    "class": "section-announcement-bar-pro-4 section-edge-bleed",
    "limit": 1,
    "enabled_on": {
      "groups": [
