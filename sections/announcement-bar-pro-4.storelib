      {
        "type": "range",
        "id": "pad_x_mobile",
        "label": "Horizontal padding (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "message",
        "name": "Message",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Write your announcement. Ends in"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Empty: the button goes to all products."
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: the button follows Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Theme button size and shape",
            "default": true
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Horizontal padding",
            "min": 6,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 22,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Vertical padding",
            "min": 2,
            "max": 30,
            "step": 1,
            "unit": "px",
            "default": 10,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 6,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Weight",
            "default": "700",
            "options": [
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      },
      {
        "type": "extra_link",
        "name": "Extra link",
        "limit": 4,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Delivery details"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 10,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "500",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Announcement Bar Pro 4",
        "category": "Announcements",
        "settings": {
          "show_countdown": true
        },
        "blocks": [
          {
            "type": "message",
