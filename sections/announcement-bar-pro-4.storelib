<template compat="shopify">
{%- comment -%} Runtime, loaded once per page by layout/theme.storelib: shopify/assets/announcement-pro-4.css, shopify/assets/announcement-pro-4.js (live edits, the countdown, paused off screen, and the close button). {%- endcomment -%}
{% render 'theme-type' %}
{%- comment -%} announcement-pro-4.css and announcement-pro-4.js are linked once for every page from layout/theme.storelib's <head>. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' -%}
{%- assign msg_blocks = section.blocks | where: 'type', 'message' -%}
{%- assign btn_blocks = section.blocks | where: 'type', 'button' -%}
{%- if s.enable_custom_fonts and s.body_font.family != blank -%}<style>{{ s.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
<div id="abp4-{{ section.id }}" class="abp4 color-{{ scheme }}" style="{% render 'announcement-four-vars', controls: s %}" data-announcement-pro-four="{{ section.id }}" data-section-id="{{ section.id }}" data-sticky-announcement="false" data-reset="{% if s.reset_spacing %}true{% else %}false{% endif %}" data-reveal="{% if s.reveal %}true{% else %}false{% endif %}" data-announcement-settings="{{ s | json | escape }}"{% if s.enable_custom_fonts %} data-own-font data-own-weight{% endif %}>
  <div class="abp4__inner">
    {%- if msg_blocks.size > 0 -%}
      <div class="abp4__message">{%- for block in msg_blocks -%}<span class="abp4__msg" data-announcement-block="{{ block.id }}" data-block-type="message" data-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}{% if block.settings.text == blank %} hidden{% endif %} style="{% if block.settings.enable_custom_style %}color:{% render 'scheme-color', color: block.settings.color, fallback: 'var(--ab-text,var(--color-text))' %}{% endif %}">{{ block.settings.text }}</span>{%- endfor -%}</div>
    {%- else -%}
      <div class="abp4__message" data-legacy>{{ s.message }}</div>
    {%- endif -%}
    <div class="abp4__group">
      <div class="abp4__countdown" role="timer" aria-live="off"{% if s.show_countdown == false %} hidden{% endif %}>
        <div class="abp4__unit"><span class="abp4__digit" data-unit="d">00</span><span class="abp4__label" data-label="label_days">{{ s.label_days | default: 'Days' | escape }}</span></div><span class="abp4__sep" aria-hidden="true">:</span>
        <div class="abp4__unit"><span class="abp4__digit" data-unit="h">00</span><span class="abp4__label" data-label="label_hours">{{ s.label_hours | default: 'Hrs' | escape }}</span></div><span class="abp4__sep" aria-hidden="true">:</span>
        <div class="abp4__unit"><span class="abp4__digit" data-unit="m">00</span><span class="abp4__label" data-label="label_minutes">{{ s.label_minutes | default: 'Mins' | escape }}</span></div><span class="abp4__sep" aria-hidden="true">:</span>
        <div class="abp4__unit"><span class="abp4__digit" data-unit="s">00</span><span class="abp4__label" data-label="label_seconds">{{ s.label_seconds | default: 'Secs' | escape }}</span></div>
      </div>
      {%- if btn_blocks.size > 0 -%}
        {%- for block in btn_blocks -%}
          {%- assign bs = block.settings -%}
          {%- capture bstyle -%}{%- if bs.enable_custom_style -%}{% render 'button-overrides', bg: bs.bg, text: bs.color, hover_bg: bs.bg_hover, hover_text: bs.color_hover %}{%- endif -%}{%- if bs.use_theme_button == false -%}--mb-radius:{{ bs.radius }}px;--mb-padding-y:{{ bs.padding_y }}px;--mb-padding-x:{{ bs.padding_x }}px;--mb-font-size:{{ bs.font_size }}px;--mb-weight:{{ bs.font_weight | default: 700 }};{%- endif -%}{%- endcapture -%}
          {%- assign href = bs.link | default: routes.all_products_collection_url | default: '/collections/all' -%}
          <a class="abp4__btn abp4__btn--block" href="{{ href | url | escape }}" data-theme-button="{% if bs.button_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-announcement-block="{{ block.id }}" data-block-type="button" data-fallback-href="{{ routes.all_products_collection_url | default: '/collections/all' }}" data-block-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.use_theme_button == false %} data-own-shape data-own-weight{% endif %}{% if bs.label == blank %} hidden{% endif %} style="{{ bstyle | strip }}">{{ bs.label | escape }}</a>
        {%- endfor -%}
      {%- elsif s.button_url != blank and s.button_url != '#' -%}
        <a class="abp4__btn" data-legacy style="{% render 'announcement-four-vars', controls: s, kind: 'button' %}" data-theme-button="primary" data-sl-button href="{{ s.button_url | url | escape }}"{% if s.use_theme_button == false %} data-own-shape data-own-weight{% endif %}{% if s.show_button == false %} hidden{% endif %}>{{ s.button_label | escape }}</a>
      {%- else -%}
        <button type="button" class="abp4__btn" data-legacy style="{% render 'announcement-four-vars', controls: s, kind: 'button' %}" data-theme-button="primary" data-sl-button{% if s.use_theme_button == false %} data-own-shape data-own-weight{% endif %}{% if s.show_button == false %} hidden{% endif %}>{{ s.button_label | escape }}</button>
      {%- endif -%}
      {%- for block in section.blocks -%}{%- unless block.hidden -%}
        {%- if block.type == 'extra_link' -%}<a class="abp4__extra-link" data-announcement-link="{{ block.id }}" data-link-settings="{{ block.settings | json | escape }}" href="{{ block.settings.link | default: '#' | url | escape }}" style="font-size:{{ block.settings.size | default: 13 }}px;font-weight:{{ block.settings.weight | default: 500 }};color:{% if block.settings.enable_custom_style != false %}{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- elsif block.type == '@app' -%}{% render block %}{%- endif -%}
      {%- endunless -%}{%- endfor -%}
    </div>
  </div>
  <p class="abp4__date-error" role="status" hidden>{{ s.invalid_date_label | escape }}</p>
  <button type="button" class="abp4__close" aria-label="{{ s.close_label | default: 'Close announcement' | escape }}"{% unless s.show_close %} hidden{% endunless %}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
</div>
</template>

<schema>
{
  "type": "announcement-bar-pro-4",
  "name": "Announcement Bar Pro 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "paragraph",
      "id": "para_6",
      "label": "Message and Button blocks sit around the countdown; Extra link blocks sit beside it.",
      "content": "Message and Button blocks sit around the countdown; Extra link blocks sit beside it."
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "info": "Format: YYYY-MM-DD (e.g. 2026-12-31). Counts to the visitor's own clock. An impossible date such as 2026-02-30 hides the timer.",
      "default": "2026-12-31",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time",
      "info": "24-hour HH:MM",
      "default": "23:59",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "select",
      "id": "on_end",
      "label": "When the countdown ends",
      "default": "freeze",
      "options": [
        {
          "value": "freeze",
          "label": "Show zeros"
        },
        {
          "value": "hide",
          "label": "Hide the bar"
        }
      ],
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days label",
      "default": "Days",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours label",
      "default": "Hrs",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes label",
      "default": "Mins",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds label",
      "default": "Secs",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "invalid_date_label",
      "label": "Message for a date it cannot read (builder only)",
      "default": "Set a valid end date and time.",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "inline_richtext",
      "id": "message",
      "label": "Message",
      "default": "Last call! Save 50% sitewide — ends in",
      "hidden": true,
      "info": "Legacy: used only when the section has no Message block."
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true,
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Legacy: the section button, used only when the section has no Button block.",
      "hidden": true
    },
    {
      "type": "checkbox",
      "id": "use_theme_button",
      "label": "Match theme button",
      "default": true,
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "color",
      "id": "btn_bg_hover",
      "label": "Button background (hover)",
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "color",
      "id": "btn_text_hover",
      "label": "Button text (hover)",
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "checkbox",
      "id": "enable_custom_btn_weight",
      "label": "Override theme font weight (button)",
      "default": true,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "select",
      "id": "btn_weight",
      "label": "Button font weight",
      "default": "700",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "range",
      "id": "btn_size_desktop",
      "label": "Button text size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "range",
      "id": "btn_size_mobile",
      "label": "Button text size (mobile)",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "range",
      "id": "btn_pad_x",
      "label": "Button horizontal padding (desktop)",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 22,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "range",
      "id": "btn_pad_y",
      "label": "Button vertical padding (desktop)",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ section.settings.use_theme_button == false }}",
      "hidden": true,
      "info": "Legacy: the section button, used only when the section has no Button block."
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between message and countdown",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Message",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "digit_color",
      "label": "Countdown digits",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "digit_label_color",
      "label": "Countdown labels",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Countdown separators",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "close_color",
      "label": "Close icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_43",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: the bar follows Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "message_size_desktop",
      "label": "Message size (desktop)",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "digit_size_desktop",
      "label": "Digit size (desktop)",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "checkbox",
      "id": "enable_custom_message_weight",
      "label": "Custom message weight",
      "default": false
    },
    {
      "type": "select",
      "id": "message_weight",
      "label": "Message weight",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_message_weight }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_digit_weight",
      "label": "Custom digit weight",
      "default": false
    },
    {
      "type": "select",
      "id": "digit_weight",
      "label": "Digit weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_digit_weight }}"
    },
    {
      "type": "header",
      "id": "hdr_52",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on load",
      "default": true,
      "info": "Storefront entrance only; the editor stays visible while customizing."
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Close button",
      "default": false
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "default": "Close announcement",
      "info": "Read by screen readers.",
      "visible_if": "{{ section.settings.show_close }}"
    },
    {
      "type": "select",
      "id": "dismissal",
