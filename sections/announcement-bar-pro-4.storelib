      },
      {
        "type": "checkbox",
        "id": "enable_custom_digit_weight",
        "label": "Override theme font weight (digits)",
        "default": false
      },
      {
        "type": "select",
        "id": "digit_weight",
        "label": "Digit font weight",
        "default": "700",
        "options": [
          {
            "value": "400",
            "label": "Normal"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi-Bold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra Bold"
          }
        ],
        "visible_if": "{{ section.settings.enable_custom_digit_weight }}"
