<template compat="shopify">
<script src="{{ 'live-r7-promo.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Announcement Code Bar: a slim bar that names an offer and
  shows its discount code. A tap on the code copies it and says so (on the
  code and to screen readers); the bar never invents a code: with none set,
  visitors see the message alone and the builder shows where the code goes.
  It sits in the header group above the header like the other bars
  (data-sticky-announcement="false": it scrolls away and the sticky header
  takes its place, snippets/header-sticky-controller).

  Theme first: colours from the colour scheme, the body font from Theme
  settings > Typography; custom colours and fonts only while their switch is
  on. Every value is a CSS variable or data attribute on the root, printed
  here for the first paint and written again by live-r7-promo.js on a live
  edit (same names, same fallbacks). The copy button is 44px tall on every
  screen; its visible chip is smaller and the bar's padding takes the rest.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign mt_d = st.section_margin_top_desktop | default: 0
  assign mb_d = st.section_margin_bottom_desktop | default: 0
  assign mt_m = st.section_margin_top_mobile | default: 0
  assign mb_m = st.section_margin_bottom_mobile | default: 0
  if st.reset_spacing
    assign mt_d = 0
    assign mb_d = 0
    assign mt_m = 0
    assign mb_m = 0
  endif
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if fonts and st.body_font.family != blank -%}<style>{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- for block in section.blocks -%}{%- if block.settings.enable_custom_fonts and block.settings.font.family != blank -%}<style>{{ block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}{%- endfor -%}
<style>
  #shopify-section-{{ sid }} { position: relative; isolation: isolate; z-index: 5; }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--acb-mt-m, {{ mt_m }}px) !important; margin-bottom: var(--acb-mb-m, {{ mb_m }}px) !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--acb-mt-d, {{ mt_d }}px) !important; margin-bottom: var(--acb-mb-d, {{ mb_d }}px) !important; }
  }
  #shopify-section-{{ sid }}:has(> .acb[data-reset='true']) { padding-top: 0 !important; padding-bottom: 0 !important; --section-spacing: 0px; }
  #shopify-section-{{ sid }}:has(> .acb[data-reset='true']) + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
  #shopify-section-{{ sid }} .acb, #shopify-section-{{ sid }} .acb *, #shopify-section-{{ sid }} .acb *::before, #shopify-section-{{ sid }} .acb *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .acb [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .acb {
    display: block;
    width: 100%;
    margin-inline: auto;
    background: var(--acb-bg);
    color: var(--acb-text);
    font-family: var(--acb-ff);
    font-size: var(--acb-fs-m);
    line-height: 1.4;
    border-bottom: var(--acb-lw) solid var(--acb-line);
    padding: var(--acb-pt-m) 0 var(--acb-pb-m);
  }
  #shopify-section-{{ sid }} .acb[data-width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .acb[data-width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .acb[data-width='stretch_width'] { max-width: calc(100% - 3rem); }
  #shopify-section-{{ sid }} .acb__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 14px;
    row-gap: 0;
    min-height: 30px;
    padding-inline: 16px;
    text-align: center;
  }
  #shopify-section-{{ sid }} .acb[data-align='left'] .acb__row { justify-content: flex-start; text-align: start; }
  #shopify-section-{{ sid }} .acb__msg { min-width: 0; color: var(--b-c, inherit); font-family: var(--b-f, inherit); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .acb__msg :is(strong, em, a, span) { font-family: inherit; color: inherit; }
  #shopify-section-{{ sid }} .acb__msg a { text-decoration: underline; text-underline-offset: 3px; }
  /* The button is the 44px target; the chip inside is what shows. Negative block margins keep the bar slim. */
  #shopify-section-{{ sid }} .acb__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: -7px 0;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .acb__chip {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 8px;
    min-height: 30px;
    padding: 3px 10px;
    border: 1px dashed var(--acb-chip-line);
    border-radius: var(--rounded-radius, 4px);
    background: var(--acb-chip-bg);
    color: var(--acb-chip-text);
    font-weight: var(--heading-weight, 700);
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }
  #shopify-section-{{ sid }} .acb__swap { display: grid; justify-items: center; }
  #shopify-section-{{ sid }} .acb__swap > * { grid-area: 1 / 1; transition: opacity 0.2s ease; }
  #shopify-section-{{ sid }} .acb__done { opacity: 0; }
  #shopify-section-{{ sid }} .acb__icon { display: inline-flex; opacity: 0.75; }
  #shopify-section-{{ sid }} .acb__icon svg { display: block; }
  #shopify-section-{{ sid }} .acb__icon .acb__icon-done { display: none; }
  #shopify-section-{{ sid }} .acb__code[data-copied] .acb__value { opacity: 0; }
  #shopify-section-{{ sid }} .acb__code[data-copied] .acb__done { opacity: 1; }
  #shopify-section-{{ sid }} .acb__code[data-copied] .acb__icon .acb__icon-copy { display: none; }
  #shopify-section-{{ sid }} .acb__code[data-copied] .acb__icon .acb__icon-done { display: block; }
  #shopify-section-{{ sid }} .acb__code:hover .acb__chip { background: var(--acb-chip-hover); }
  #shopify-section-{{ sid }} .acb__code:active .acb__chip { transform: scale(0.97); }
  #shopify-section-{{ sid }} .acb__code:focus-visible { outline: none; }
  #shopify-section-{{ sid }} .acb__code:focus-visible .acb__chip { outline: 2px solid currentColor; outline-offset: 2px; }
  /* Builder only: the place the code goes, while none is set. */
  #shopify-section-{{ sid }} .acb__code[data-empty] { cursor: default; }
  #shopify-section-{{ sid }} .acb__code[data-empty] .acb__chip { font-weight: inherit; letter-spacing: 0; font-style: italic; opacity: 0.7; }
  #shopify-section-{{ sid }} .acb__code[data-empty] .acb__icon { display: none; }
  #shopify-section-{{ sid }} .acb__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -7px 0;
    color: var(--b-c, inherit);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .acb__link:hover { text-decoration-thickness: 2px; }
  #shopify-section-{{ sid }} .acb__link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #shopify-section-{{ sid }} .acb__status { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .acb[data-show='desktop'] { display: none; } }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .acb { font-size: var(--acb-fs-d); padding: var(--acb-pt-d) 0 var(--acb-pb-d); }
    #shopify-section-{{ sid }} .acb[data-show='mobile'] { display: none; }
    #shopify-section-{{ sid }} .acb__row { padding-inline: 24px; column-gap: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .acb__chip, #shopify-section-{{ sid }} .acb__swap > * { transition: none; }
    #shopify-section-{{ sid }} .acb__code:active .acb__chip { transform: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture acb_vars -%}
--acb-bg: {% if custom %}{% render 'scheme-color', color: st.background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--acb-text: {% if custom %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--acb-line: {% if custom %}{% render 'scheme-color', color: st.line_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
--acb-lw: {% if st.show_separator_line %}1px{% else %}0px{% endif %};
--acb-ff: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
--acb-fs-d: {{ st.font_size | default: 14 }}px; --acb-fs-m: {{ st.mobile_font_size | default: 13 }}px;
--acb-pt-d: {{ st.padding_top }}px; --acb-pb-d: {{ st.padding_bottom }}px; --acb-pt-m: {{ st.padding_top_mobile }}px; --acb-pb-m: {{ st.padding_bottom_mobile }}px;
{%- endcapture -%}
<div
  class="acb color-{{ color_scheme }} gradient"
  role="region"
  aria-label="Announcement"
  data-r7p="announcement-code-bar"
  data-r7p-section="{{ sid }}"
  {% if request.design_mode %}data-r7p-settings="{{ st | json | escape }}" data-r7p-editor{% endif %}
  data-sticky-announcement="false"
  data-width="{{ st.section_width | default: 'full_width' }}"
  data-show="{{ st.show_section_on | default: 'all' }}"
  data-reset="{% if st.reset_spacing %}true{% else %}false{% endif %}"
  data-align="{{ st.content_alignment | default: 'center' }}"
  {% if fonts %}data-own-font{% endif %}
  {% unless st.reveal %}data-ti-no-reveal{% endunless %}
  style="{{ acb_vars | strip_newlines }}"
>
  <div class="acb__row">
    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      {%- case block.type -%}
        {%- when 'message' -%}
          {%- assign bfont = false -%}{%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign bfont = true -%}{%- endif -%}
          <span class="acb__msg" data-r7p-block="{{ block.id }}" data-r7p-type="message"{% if request.design_mode %} data-r7p-settings="{{ bs | json | escape }}"{% endif %}{% if bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{% if bs.enable_custom_style %}--b-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--acb-text)' %};{% endif %}{% if bfont %}--b-f: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{% endif %}" {{ block.shopify_attributes }}>{{ bs.text }}</span>
        {%- when 'code' -%}
          {%- assign code = bs.code | strip -%}
          {%- if code != blank or request.design_mode -%}
            {%- capture chip_vars -%}
              --acb-chip-bg: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.bg_color, fallback: 'transparent' %}{% else %}transparent{% endif %};
              --acb-chip-hover: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.bg_color, fallback: 'color-mix(in srgb, currentColor 8%, transparent)' %}{% else %}color-mix(in srgb, currentColor 8%, transparent){% endif %};
              --acb-chip-text: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
              --acb-chip-line: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.border_color, fallback: 'currentColor' %}{% else %}currentColor{% endif %};
            {%- endcapture -%}
            <span class="acb__codewrap" data-r7p-block="{{ block.id }}" data-r7p-type="code"{% if request.design_mode %} data-r7p-settings="{{ bs | json | escape }}"{% endif %} style="{{ chip_vars | strip_newlines }}" {{ block.shopify_attributes }}>
              <button type="button" class="acb__code" data-r7p-copy data-code="{{ code | escape }}"{% if code == blank %} data-empty{% endif %} aria-label="{% if code != blank %}{{ bs.copy_label | default: 'Copy code' | escape }}: {{ code | escape }}{% else %}No code set yet{% endif %}">
                <span class="acb__chip">
                  <span class="acb__swap">
                    <span class="acb__value" data-r7p-code>{% if code != blank %}{{ code | escape }}{% else %}Add a code{% endif %}</span>
                    <span class="acb__done" data-r7p-done aria-hidden="true">{{ bs.copied_text | default: 'Copied' | escape }}</span>
                  </span>
                  <span class="acb__icon" aria-hidden="true">
                    <svg class="acb__icon-copy" width="14" height="14" viewBox="0 0 14 14" focusable="false"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M9.5 2.5v-.2c0-.7-.6-1.3-1.3-1.3H2.3C1.6 1 1 1.6 1 2.3v5.9c0 .7.6 1.3 1.3 1.3h.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    <svg class="acb__icon-done" width="14" height="14" viewBox="0 0 14 14" focusable="false"><path d="m2.5 7.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </span>
              </button>
              <span class="acb__status" role="status" data-r7p-status></span>
            </span>
          {%- endif -%}
        {%- when 'link' -%}
          <a class="acb__link" data-r7p-block="{{ block.id }}" data-r7p-type="link"{% if request.design_mode %} data-r7p-settings="{{ bs | json | escape }}"{% endif %}{% if bs.link != blank %} href="{{ bs.link }}"{% endif %}{% if bs.label == blank %} hidden{% endif %} style="{% if bs.enable_custom_style %}--b-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--acb-text)' %};{% endif %}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
</template>

<schema>
{
  "type": "announcement-code-bar",
  "name": "Announcement Code Bar",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true,
      "info": "Turn off to set top and bottom margins under Desktop spacing and Mobile."
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "show_separator_line",
      "label": "Line under the bar",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_separator_line }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: the font follows Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size (desktop)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Text size (mobile)",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Say what the code gives, for example free delivery"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        }
      ],
      "limit": 2
    },
    {
      "type": "code",
      "name": "Discount code",
      "settings": [
        {
