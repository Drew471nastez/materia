        "visible_if": "{{ section.settings.menu_mobile_title_type == 'custom_logo' }}"
      },
      {
        "type": "range",
        "id": "menu_mobile_logo_height",
        "min": 16,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Logo height",
        "default": 28,
        "visible_if": "{{ section.settings.menu_mobile_title_type != 'text' }}"
      },
      {
        "type": "color",
        "id": "menu_mobile_color",
        "label": "Mobile title text color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "menu_mobile_background",
        "label": "Mobile title background",
        "default": "#242424"
      },
      {
        "type": "header",
        "content": "Advanced spacing"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "select",
        "id": "header_layout",
        "default": "stretch_width",
        "label": "Header layout (legacy)",
        "options": [
          {
            "value": "narrow_container",
            "label": "Narrow (max 1100px)"
          },
          {
            "value": "container",
            "label": "Standard (page width)"
          },
          {
            "value": "fluid_container",
            "label": "Fluid (wider)"
          },
          {
            "value": "wide_container",
            "label": "Wide (max 1600px)"
          },
          {
            "value": "stretch_width",
            "label": "Stretch (edge padding)"
          },
          {
            "value": "full_width",
            "label": "Full width (edge to edge)"
          }
        ],
        "info": "Compatibility fallback for older exports. Use Section width under Size and layout.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "checkbox",
        "id": "transparent_mobile",
