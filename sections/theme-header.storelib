6 3.58638C4.20826 2.95846 4.94485 2.46337 5.77805 2.10111C6.62332 1.72677 7.52897 1.53961 8.495 1.53961C9.46103 1.53961 10.3606 1.72677 11.1938 2.10111C12.0391 2.46337 12.7817 2.95846 13.4217 3.58638C14.0497 4.21429 14.5447 4.95089 14.907 5.79616C15.2693 6.64144 15.4504 7.54105 15.4504 8.495ZM7.71614 3.85807V8.495C7.71614 8.65198 7.75237 8.79085 7.82482 8.9116C7.90935 9.03235 8.01802 9.12292 8.15085 9.1833L11.2482 10.741C11.4293 10.8376 11.6225 10.8557 11.8278 10.7954C12.0331 10.7229 12.184 10.5901 12.2806 10.3969C12.3772 10.2037 12.3893 10.0044 12.3168 9.79914C12.2565 9.59386 12.1297 9.44291 11.9365 9.34631L9.27386 8.02406V3.85807C9.27386 3.65279 9.19537 3.4777 9.03839 3.33279C8.89349 3.17581 8.71236 3.09732 8.495 3.09732C8.27764 3.09732 8.09048 3.17581 7.9335 3.33279C7.78859 3.4777 7.71614 3.65279 7.71614 3.85807Z"/>
            </symbol>
            <symbol id="icon-search">
             <path fill="currentColor" d="M11.2 11.04c-.094 0-.094 0 0 0l-.094.095c-.47.467-1.035.842-1.788 1.122-.66.281-1.412.375-2.165.375-.753 0-1.506-.188-2.165-.468A5.52 5.52 0 0 1 3.2 10.947 5.993 5.993 0 0 1 1.976 9.17C1.694 8.608 1.6 7.953 1.6 7.205c0-.749.188-1.497.47-2.152.283-.749.66-1.31 1.13-1.872.565-.468 1.13-.842 1.788-1.123.66-.28 1.412-.467 2.165-.467.753 0 1.506.187 2.165.467.658.281 1.317.655 1.788 1.217.47.468.847 1.123 1.223 1.778.283.655.471 1.31.471 2.152 0 .748-.188 1.497-.47 2.152a8.78 8.78 0 0 1-1.13 1.684Zm4.518 3.463-2.918-2.9c.47-.656.847-1.31 1.13-2.06.282-.748.376-1.59.376-2.432 0-1.03-.188-1.965-.565-2.807-.376-.842-.847-1.59-1.506-2.246-.659-.654-1.412-1.122-2.259-1.497C9.13.187 8.188 0 7.153 0 6.212 0 5.27.187 4.329.561c-.847.375-1.6.843-2.258 1.497-.66.655-1.13 1.404-1.506 2.34C.188 5.24 0 6.175 0 7.205c0 .935.188 1.871.565 2.807.376.842.94 1.59 1.6 2.245.659.655 1.411 1.123 2.259 1.591.847.28 1.788.468 2.729.468.847 0 1.694-.094 2.447-.375.753-.28 1.506-.655 2.07-1.122l2.918 2.9c.189.187.377.281.565.281.188 0 .376-.094.565-.28.188-.188.282-.375.282-.562 0-.28-.094-.468-.282-.655Z"/>
            </symbol>
            <symbol id="icon-account">
            <path fill="currentColor" d="M15.899 14.84a9.143 9.143 0 0 0-3.35-3.292 9.203 9.203 0 0 0-9.101 0 9.143 9.143 0 0 0-3.35 3.293.773.773 0 0 0 .067.855c.064.08.145.146.238.193a.784.784 0 0 0 .39.101.737.737 0 0 0 .671-.373 7.57 7.57 0 0 1 2.774-2.727 7.619 7.619 0 0 1 7.537 0 7.57 7.57 0 0 1 2.773 2.727.78.78 0 0 0 1.062.28.716.716 0 0 0 .36-.458.772.772 0 0 0-.071-.598ZM8 9.6a4.777 4.777 0 0 0 3.363-1.387A4.866 4.866 0 0 0 12.8 4.844a4.867 4.867 0 0 0-1.406-3.425A4.778 4.778 0 0 0 8 0C6.727 0 5.506.51 4.606 1.419A4.867 4.867 0 0 0 3.2 4.844a4.866 4.866 0 0 0 1.436 3.369A4.777 4.777 0 0 0 8 9.6ZM4.8 4.844c0-.856.337-1.678.937-2.283A3.185 3.185 0 0 1 8 1.615c.848 0 1.662.34 2.262.946a3.245 3.245 0 0 1 0 4.567c-.6.606-1.414.946-2.262.946-.849 0-1.663-.34-2.263-.946A3.245 3.245 0 0 1 4.8 4.844Z"/>
              </symbol>
              <symbol id="icon-bag">
                <path d="M12.7518 2.91374L11.6276 1.44835H3.37237L2.24824 2.91374H12.7518ZM14.8419 3.18637V3.20341C14.8419 3.20341 14.8478 3.20341 14.8595 3.20341C14.8946 3.27157 14.9239 3.33972 14.9473 3.40788C14.9824 3.47604 15 3.54988 15 3.62939V13.819C15 14.1143 14.9356 14.3983 14.8068 14.6709C14.6897 14.9322 14.5316 15.1594 14.3326 15.3525C14.1335 15.557 13.8934 15.716 13.6124 15.8296C13.3431 15.9432 13.0562 16 12.7518 16H2.24824C1.94379 16 1.65105 15.9375 1.37002 15.8126C1.1007 15.699 0.866511 15.5456 0.667447 15.3525C0.456674 15.1594 0.29274 14.9322 0.175644 14.6709C0.058548 14.3983 0 14.1143 0 13.819V3.62939C0 3.58395 0.0058548 3.53852 0.0175644 3.49308C0.029274 3.43628 0.0468384 3.37948 0.0702576 3.32268C0.0819672 3.29996 0.0936768 3.27725 0.105386 3.25453C0.128806 3.23181 0.14637 3.20909 0.15808 3.18637L2.40632 0.28967C2.47658 0.198793 2.5644 0.130635 2.66979 0.085197C2.77518 0.028399 2.88642 0 3.00351 0H11.9965C12.1136 0 12.2248 0.028399 12.3302 0.085197C12.4356 0.130635 12.5234 0.198793 12.5937 0.28967L14.8419 3.18637ZM1.51054 4.36209V13.819C1.51054 13.9098 1.5281 14.0007 1.56323 14.0916C1.59836 14.1825 1.65105 14.262 1.72131 14.3301C1.79157 14.3983 1.87354 14.4494 1.96721 14.4835C2.06089 14.5176 2.15457 14.5346 2.24824 14.5346H12.7518C12.8571 14.5346 12.9508 14.5176 13.0328 14.4835C13.1265 14.4494 13.2084 14.3983 13.2787 14.3301C13.3489 14.262 13.4016 14.1825 13.4368 14.0916C13.4719 14.0007 13.4895 13.9098 13.4895 13.819V4.36209H1.51054ZM9.74824 6.54313C9.74824 6.33866 9.8185 6.16826 9.95902 6.03195C10.1112 5.88427 10.2927 5.81044 10.5035 5.81044C10.7026 5.81044 10.8724 5.88427 11.0129 6.03195C11.1651 6.16826 11.2412 6.33866 11.2412 6.54313C11.2412 7.04295 11.1417 7.51438 10.9426 7.9574C10.7553 8.40043 10.4918 8.78665 10.1522 9.11608C9.81265 9.44551 9.41452 9.70678 8.95785 9.89989C8.50117 10.0816 8.01522 10.1725 7.5 10.1725C6.98478 10.1725 6.49883 10.0816 6.04215 9.89989C5.58548 9.70678 5.18735 9.44551 4.84777 9.11608C4.5082 8.78665 4.23888 8.40043 4.03981 7.9574C3.85246 7.51438 3.75878 7.04295 3.75878 6.54313C3.75878 6.33866 3.82904 6.16826 3.96956 6.03195C4.12178 5.88427 4.29742 5.81044 4.49649 5.81044C4.70726 5.81044 4.8829 5.88427 5.02342 6.03195C5.17564 6.16826 5.25176 6.33866 5.25176 6.54313C5.25176 6.84984 5.3103 7.13383 5.4274 7.3951C5.5445 7.65637 5.70843 7.88356 5.9192 8.07668C6.11827 8.28115 6.35246 8.44018 6.62178 8.55378C6.8911 8.66738 7.18384 8.72417 7.5 8.72417C7.81616 8.72417 8.1089 8.66738 8.37822 8.55378C8.64754 8.44018 8.88173 8.28115 9.0808 8.07668C9.29157 7.88356 9.4555 7.65637 9.5726 7.3951C9.6897 7.13383 9.74824 6.84984 9.74824 6.54313Z" fill="currentColor"/>
                  </symbol>
          </svg>
          {% if show_language or show_country %}
            <div class="lang__currency-desktop hidden flex-1025 align-center">
              {% if show_country %}
                {% render 'country-switcher', compact: true %}
              {% endif %}
              {% if show_language %}
                {% render 'language-switcher' %}
              {% endif %}
            </div>
          {% endif %}
          {%- liquid
            if top_search
              render 'top-search-header', as_text: actions_as_text, text_class: header_text_class
            endif
            if my_account
              render 'my-account', as_text: actions_as_text, text_class: header_text_class
            endif
            if wishlist
              render 'wishlist'
            endif
            if minicart and theme_st.enable_catalog_mode == false
              render 'minicart_header', as_text: actions_as_text, text_class: header_text_class
            endif
          -%}
        </div>
      </header-inner>
    </div>
  </div>
</header>
{%- comment -%}
  ── Header actions as text (Search / Account / Cart) ──
  Styling for the `actions_as_text` toggle. Only active when the action
  snippets render `.header-action-text` (icon markup is untouched otherwise).
{%- endcomment -%}
{%- if section_st.actions_as_text -%}
  <style>
    /* Layout only — text labels are auto-width (vs the 44px icon squares), so
       give the action row a gap and let each button flex to fit its label.
       Typography is NOT set here: the label inherits the menu-link font via the
       heading-style / uppercase classes added in Liquid, so it matches the
       header nav rather than the body type. */
    #shopify-section-{{ section.id }} .header__action {
      column-gap: 1.8rem;
    }
    #shopify-section-{{ section.id }} .header-action-text-btn {
      width: auto;
      min-width: 0;
      height: 4.4rem;
      padding: 0;
      white-space: nowrap;
      text-decoration: none; /* kill the default <a> underline on the account link */
    }
    #shopify-section-{{ section.id }} .header-action-text {
      position: relative;
      display: inline-flex;
      align-items: center;
      line-height: 1;
      white-space: nowrap;
    }
    /* Live cart count sits inline (no floating bubble) in text mode. */
    #shopify-section-{{ section.id }} .header-action-text .cart-count {
      position: static;
      display: inline;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      background: none !important;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      border-radius: 0;
      overflow: visible;
    }

    /* ── Menu-link hover animations, mirrored from navigation.css ──
       Driven by the SAME [data-menu-hover] value on the header root, so the
       labels animate exactly like the top-level menu links the merchant picked.
       Desktop only — matches the menu (no hover state on touch). */
    @media screen and (min-width: 1025px) {
      /* default 'underline' / 'underline_reverse' sweep */
      #shopify-section-{{ section.id }} .header-action-text::after {
        content: '';
        position: absolute;
        display: block;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 1px;
        background-color: currentColor;
        transform: scaleX(0);
        transform-origin: 100% 0;
        transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
      }
      #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text::after {
        transform: scaleX(1);
        transform-origin: 0 100%;
      }
      /* hide the sweep on variants that animate differently */
      [data-menu-hover='none'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='fade'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='scale'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='background'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='color'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='uppercase'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='subtle_fade'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='slide_up'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='glow'] #shopify-section-{{ section.id }} .header-action-text::after {
        display: none !important;
      }
      /* subtle_fade (theme default) — dim sibling labels when hovering the row */
      [data-menu-hover='subtle_fade'] #shopify-section-{{ section.id }} .header-action-text {
        transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), color 0.6s ease;
      }
      [data-menu-hover='subtle_fade'] #shopify-section-{{ section.id }} .header__action:hover .header-action-text {
        opacity: 0.92;
      }
      [data-menu-hover='subtle_fade'] #shopify-section-{{ section.id }} .header__action .header-action-text-btn:hover .header-action-text {
        opacity: 1;
      }
      /* fade */
      [data-menu-hover='fade'] #shopify-section-{{ section.id }} .header-action-text {
        transition: opacity 0.3s ease, color 0.3s ease;
      }
      [data-menu-hover='fade'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        opacity: 0.55;
      }
      /* scale */
      [data-menu-hover='scale'] #shopify-section-{{ section.id }} .header-action-text {
        transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.3s ease;
        transform-origin: center;
      }
      [data-menu-hover='scale'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        transform: scale(1.08);
      }
      /* background — pill behind the label */
      [data-menu-hover='background'] #shopify-section-{{ section.id }} .header-action-text {
        border-radius: 999px;
        padding: 4px 14px;
        transition: background-color 0.25s ease, color 0.25s ease;
      }
      [data-menu-hover='background'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        background-color: color-mix(in srgb, currentColor 10%, transparent);
      }
      /* color */
      [data-menu-hover='color'] #shopify-section-{{ section.id }} .header-action-text {
        transition: color 0.25s ease;
      }
      [data-menu-hover='color'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        color: var(--color-primary);
      }
      /* underline_reverse — sweep from the left */
      [data-menu-hover='underline_reverse'] #shopify-section-{{ section.id }} .header-action-text::after {
        transform-origin: 0 0;
      }
      [data-menu-hover='underline_reverse'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text::after {
        transform: scaleX(1);
        transform-origin: 0 0;
      }
      /* uppercase — letter-spacing + uppercase on hover */
      [data-menu-hover='uppercase'] #shopify-section-{{ section.id }} .header-action-text {
        transition: letter-spacing 0.25s ease, color 0.25s ease;
      }
      [data-menu-hover='uppercase'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      /* slide_up */
      [data-menu-hover='slide_up'] #shopify-section-{{ section.id }} .header-action-text {
        transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.3s ease;
      }
      [data-menu-hover='slide_up'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        transform: translateY(-3px);
        color: var(--color-primary);
      }
      /* glow */
      [data-menu-hover='glow'] #shopify-section-{{ section.id }} .header-action-text {
        transition: text-shadow 0.3s ease, color 0.3s ease;
      }
      [data-menu-hover='glow'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text {
        text-shadow: 0 0 14px color-mix(in srgb, currentColor 45%, transparent);
        color: var(--color-primary);
      }
      /* double_line — top + bottom rules grow on hover */
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text {
        transition: color 0.3s ease;
      }
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text::after,
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: 50% 50%;
        transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
        display: block !important;
      }
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text::after { bottom: -2px; }
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text::before { top: -2px; }
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text::after,
      [data-menu-hover='double_line'] #shopify-section-{{ section.id }} .header-action-text-btn:hover .header-action-text::before {
        transform: scaleX(1);
      }
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{% render 'header-sticky-controller', pgs: pgs %}
<script>
  (function () {
    var sec = document.getElementById('shopify-section-{{ section.id }}');
    if (!sec) return;
    /* A sticky announcement bar stays on screen, so the sticky header sits right under it
       instead of sliding beneath it. */
    /* Anything pinned to the top of the screen above the header (a sticky or fixed
       announcement bar, wherever its sticky style sits) is measured live, so the header
       always sits exactly under its bottom edge. */
    function pinned(el) {
      if (!el || el.nodeType !== 1) return null;
      var p = getComputedStyle(el).position;
      if (p === 'sticky' || p === 'fixed') return el;
      var c = el.firstElementChild;
      if (c) { var cp = getComputedStyle(c).position; if (cp === 'sticky' || cp === 'fixed') return c; }
      return null;
    }
    var last = -1;
    function measure() {
      var h = 0;
      var list = [];
      var el = sec.previousElementSibling;
      while (el) { list.push(el); el = el.previousElementSibling; }
      document.querySelectorAll('[data-sticky-announcement="true"]').forEach(function (bar) {
        list.push(bar.closest('.shopify-section') || bar);
      });
      list.forEach(function (node) {
        var t = pinned(node);
        if (!t) return;
        var r = t.getBoundingClientRect();
        if (r.height > 0 && r.top <= 1 && r.bottom > h) h = r.bottom;
      });
      h = Math.max(0, Math.round(h));
      if (h !== last) { last = h; sec.style.setProperty('--sl-header-offset', h + 'px'); }
    }
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; measure(); });
    }
    measure();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('load', measure);
    if ('ResizeObserver' in window) {
      var ro = new ResizeObserver(measure);
      document.querySelectorAll('[data-sticky-announcement="true"]').forEach(function (bar) { ro.observe(bar); });
    }
    /* Switching between resting and sticky happens without animation; only the real
       hide and show on scroll slides. */
    function isSticky() {
      return sec.classList.contains('shopify-section-header-sticky') || sec.classList.contains('shopify-section-header-hidden');
    }
    /* Show on scroll up: this section decides when the header hides, with a small dead zone
       so a trackpad's jitter never leaves it half way. */
    if ('{{ sticky_header_type }}' === 'on-scroll-up') {
      var stickyMobile = {% if sticky_mobile %}true{% else %}false{% endif %};
      var mq = window.matchMedia('(min-width: 1025px)');
      var lastY = Math.max(0, window.scrollY || 0);
      var hidden = false;
      var pending = false;
      function setHidden(v) {
        if (v === hidden) return;
        hidden = v;
        sec.classList.toggle('sl-hdr-hidden', v);
      }
      function headerHeight() {
        var h = sec.querySelector('header.header');
        return h ? h.offsetHeight : 0;
      }
      function update() {
        pending = false;
        var y = Math.max(0, window.scrollY || 0);
        if ((!stickyMobile && !mq.matches) || document.documentElement.classList.contains('nav-open')) {
          setHidden(false);
          lastY = y;
          return;
        }
        var d = y - lastY;
        if (y <= headerHeight()) { setHidden(false); lastY = y; return; }
        if (d > 8) { setHidden(true); lastY = y; }
        else if (d < -8) { setHidden(false); lastY = y; }
      }
      window.addEventListener('scroll', function () {
        if (pending) return;
        pending = true;
        requestAnimationFrame(update);
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
    var was = isSticky();
    new MutationObserver(function () {
      var now = isSticky();
      if (now === was) return;
      was = now;
      sec.classList.add('sl-header-snap');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { sec.classList.remove('sl-header-snap'); });
      });
    }).observe(sec, { attributes: true, attributeFilter: ['class'] });
  })();
</script>
</template>

<schema>
{
  "type": "theme-header",
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Size & layout"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 48,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo size",
      "min": 30,
      "max": 400,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo size mobile & tablets",
      "min": 30,
      "max": 300,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "Logo for transparent header"
    },
    {
      "type": "select",
      "id": "logo_position",
      "default": "left",
      "label": "Logo position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Main navigation"
    },
    {
      "type": "link_list",
      "id": "mega_menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "select",
      "id": "menu_hover_style",
      "label": "Menu link hover style",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit (theme default)"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "underline_reverse",
          "label": "Underline (reverse)"
        },
        {
          "value": "fade",
          "label": "Fade siblings"
        },
        {
          "value": "scale",
          "label": "Scale up"
        },
        {
          "value": "background",
          "label": "Pill background"
        },
        {
          "value": "color",
          "label": "Accent color"
        },
        {
          "value": "uppercase",
          "label": "Uppercase + spaced"
