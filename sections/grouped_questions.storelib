<template>
{# Grouped Questions: a heading column beside questions in <details>, split into topics. #}
<section class="gq gq--{{ settings.heading_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-heading: {{ settings.heading_color }}; --s-text: {{ settings.text_color }}; --s-border: {{ settings.border_color }}; --s-accent: {{ scheme.accent }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --s-ptm: {{ settings.padding_top_mobile }}px; --s-pbm: {{ settings.padding_bottom_mobile }}px;">
  <div class="gq__in gq__in--{{ settings.max_width }}">
    <div class="gq__grid">

      <div class="gq__head{% if settings.sticky_heading %} gq__head--sticky{% endif %}">
        {% if settings.heading %}<h2 class="gq__h">{{ settings.heading | raw }}</h2>{% endif %}
        {% if settings.text %}<div class="gq__text">{{ settings.text | raw }}</div>{% endif %}
        {% if settings.contact_label %}
          <p class="gq__contact">
            {% if settings.contact_intro %}<span>{{ settings.contact_intro }}</span>{% endif %}
            <a class="gq__link" href="{{ settings.contact_url | default: '#' | url }}">{{ settings.contact_label }}</a>
          </p>
        {% endif %}
      </div>

      <div class="gq__list">
        {% for block in blocks %}
          <div class="gq__item" data-block-id="{{ block.id }}">
            {% if block.settings.topic %}<h3 class="gq__topic">{{ block.settings.topic }}</h3>{% endif %}
            <details class="gq__q"{% if settings.one_open %} name="{{ section.id }}-faq"{% endif %}{% if block.settings.open or forloop.first and settings.open_first %} open{% endif %}>
              <summary class="gq__sum">
                <span class="gq__qt">{{ block.settings.question }}</span>
                <span class="gq__mark" aria-hidden="true"></span>
              </summary>
              <div class="gq__a">{{ block.settings.answer | raw }}</div>
            </details>
          </div>
        {% else %}
          {% if page.in_editor %}<p class="gq__empty">{{ settings.empty_note }}</p>{% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>
</template>

<style>
.gq { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.gq__in { margin: 0 auto; padding: calc(var(--s-ptm) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pbm) * var(--theme-spacing-scale, 1)); }
.gq__in--medium { max-width: 960px; }
.gq__in--wide { max-width: var(--theme-page-width, 1280px); }
.gq__in--full { max-width: none; }

.gq__grid { display: grid; gap: 32px; align-items: start; }

.gq__h { margin: 0; color: var(--s-heading); font-size: var(--section-heading-size, 36px); line-height: var(--section-heading-line-height, 1.15); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif); }
.gq__text { margin-top: 16px; max-width: 36rem; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-text); }
.gq__text > :first-child { margin-top: 0; }
.gq__text > :last-child { margin-bottom: 0; }

.gq__contact { margin: 24px 0 0; font-size: 15px; line-height: 1.6; display: flex; flex-wrap: wrap; gap: 4px 8px; }
.gq__link { color: var(--s-heading); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; transition: text-underline-offset 160ms ease, opacity 160ms ease; }
.gq__link:hover { text-underline-offset: 5px; }
.gq__link:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; border-radius: 2px; }

.gq__list { min-width: 0; }
.gq__item:first-child .gq__q { border-top: 1px solid var(--s-border); }
.gq__item:first-child .gq__topic + .gq__q { border-top: 0; }

.gq__topic { margin: 40px 0 0; padding-bottom: 12px; border-bottom: 1px solid var(--s-border); font-size: 12px; font-weight: var(--subheading-weight, 600); letter-spacing: 0.1em; text-transform: uppercase; color: var(--s-text); }
.gq__item:first-child .gq__topic { margin-top: 0; }

.gq__q { border-bottom: 1px solid var(--s-border); }
.gq__sum { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 16px 2px; cursor: pointer; list-style: none; font-size: 16px; line-height: 1.4; font-weight: var(--subheading-weight, 600); color: var(--s-heading); border-radius: 4px; }
.gq__sum::-webkit-details-marker { display: none; }
.gq__sum::marker { content: ""; }
.gq__sum:hover .gq__qt { opacity: 0.75; }
.gq__qt { transition: opacity 160ms ease; }
.gq__sum:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 2px; }

.gq__mark { position: relative; flex: none; width: 14px; height: 14px; }
.gq__mark::before, .gq__mark::after { content: ""; position: absolute; inset: 0; margin: auto; background: currentColor; transition: transform 180ms ease, opacity 180ms ease; }
.gq__mark::before { width: 14px; height: 1.5px; }
.gq__mark::after { width: 1.5px; height: 14px; }
.gq__q[open] .gq__mark::after { transform: scaleY(0); opacity: 0; }

.gq__a { padding: 0 2px 20px; max-width: 40rem; font-size: 16px; line-height: 1.65; color: var(--s-text); }
.gq__a > :first-child { margin-top: 0; }
.gq__a > :last-child { margin-bottom: 0; }
.gq__a a { color: var(--s-heading); text-underline-offset: 3px; }
.gq__q[open] .gq__a { animation: gq-reveal 220ms ease both; }
@keyframes gq-reveal { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

.gq__empty { margin: 0; padding: 32px 16px; text-align: center; font-size: 14px; border: 1px dashed var(--s-border); border-radius: var(--s-radius); }

@container (min-width: 760px) {
  .gq__in { padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
  .gq__grid { grid-template-columns: 4fr 8fr; gap: 64px; }
  .gq--right .gq__grid { grid-template-columns: 8fr 4fr; }
  .gq--right .gq__head { order: 2; }
  .gq__head--sticky { position: sticky; top: 24px; }
  .gq__sum { font-size: 17px; padding: 20px 2px; }
}

@media (prefers-reduced-motion: reduce) {
  .gq__mark::before, .gq__mark::after, .gq__qt, .gq__link { transition: none; }
  .gq__q[open] .gq__a { animation: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "grouped_questions",
  "name": "Grouped Questions",
  "category": "faq",
  "description": "Questions split into topics beside a heading and a contact link.",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions before you order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The things people ask us most, grouped by topic. Tap a question to read the answer.</p>"
    },
    {
      "type": "text",
      "id": "contact_intro",
      "label": "Contact line",
      "default": "Still unsure about something?"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link wording",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Empty list note (editor only)",
      "default": "Add questions in the sidebar"
    },
    {
      "type": "header",
      "id": "hdr_behaviour",
      "label": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "one_open",
      "label": "Keep one question open at a time",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "radio",
      "id": "heading_side",
      "label": "Heading sits",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky_heading",
      "label": "Sticky heading",
      "default": true
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings and questions",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and answers",
      "default": "scheme.text"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Dividing lines",
      "default": "scheme.border"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding on phones",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding on phones",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 40,
      "settings": [
        {
          "type": "text",
          "id": "topic",
          "label": "Start a new topic here",
          "default": "",
          "info": "Leave empty to keep this question in the topic above."
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write the answer in two or three sentences.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": []
}
</schema>