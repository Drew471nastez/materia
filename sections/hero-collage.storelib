<template compat="shopify">
<script src="{{ 'live-r7-hero.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Hero Collage: the text (eyebrow, heading, text and up to
  two buttons, all blocks) beside one to four picture blocks. On desktop the
  pictures sit in an offset grid: two side by side with the second lower,
  three as one tall picture beside two stacked, four as two columns with the
  second lower. On phones they become one row the finger swipes, with scroll
  snap; the arrows only call scrollBy. Styles for the text come from
  snippets/r7-hero-style, the blocks from snippets/r7-hero-text, and
  shopify/assets/live-r7-hero.js paints live edits and runs the arrows.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id

  comment
    The heading is the page's h1 when this section opens the page (or when the
    page does not say where the section is, as the other heroes do), else h2.
  endcomment
  assign r7_tag = 'h2'
  assign r7_eager = true
  if section.index == blank
    assign r7_tag = 'h1'
  elsif section.index == 1
    assign r7_tag = 'h1'
  elsif section.index > 2
    assign r7_eager = false
  endif

  assign r7_ph = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.4%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'

  assign r7_count = 0
  for block in section.blocks
    if block.type == 'image' and r7_count < 4
      unless block.hidden
        assign r7_count = r7_count | plus: 1
      endunless
    endif
  endfor

  assign r7_side = 'right'
  if st.image_position == 'left'
    assign r7_side = 'left'
  endif
  assign r7_align = 'left'
  assign r7_items = 'flex-start'
  if st.content_align == 'center'
    assign r7_align = 'center'
    assign r7_items = 'center'
  elsif st.content_align == 'right'
    assign r7_align = 'right'
    assign r7_items = 'flex-end'
  endif
  assign r7_ratio = '1 / 1'
  if st.image_aspect_ratio == 'portrait'
    assign r7_ratio = '4 / 5'
  elsif st.image_aspect_ratio == 'landscape'
    assign r7_ratio = '4 / 3'
  endif

  assign r7_hf = ''
  assign r7_bf = ''
  if st.enable_custom_fonts and st.heading_font.family
    assign r7_fallback = st.heading_font.fallback_families | default: 'sans-serif'
    assign r7_hf = st.heading_font.family | append: ', ' | append: r7_fallback
  endif
  if st.enable_custom_fonts and st.body_font.family
    assign r7_fallback = st.body_font.fallback_families | default: 'sans-serif'
    assign r7_bf = st.body_font.family | append: ', ' | append: r7_fallback
  endif
-%}
{%- if st.enable_custom_fonts -%}<style>{% if st.heading_font.family %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if st.body_font.family %}{{ st.body_font | font_face: font_display: 'swap' }}{% endif %}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- render 'r7-hero-style', section: section -%}
<style>
  #shopify-section-{{ sid }} .hcl{padding-block:calc(var(--r7h-pt-m,40px)*var(--sl-space-scale,1)) calc(var(--r7h-pb-m,40px)*var(--sl-space-scale,1))}
  #shopify-section-{{ sid }} .hcl__grid{display:flex;flex-direction:column;gap:calc(32px*var(--sl-space-scale,1))}
  #shopify-section-{{ sid }} .hcl__content{display:flex;justify-content:var(--r7h-items,flex-start);min-width:0}
  #shopify-section-{{ sid }} .hcl__media{min-width:0}
  #shopify-section-{{ sid }} .hcl__media[hidden]{display:none}
  #shopify-section-{{ sid }} .hcl__track{display:flex;gap:var(--hcl-gap,16px);margin:0;padding:0;list-style:none}
  #shopify-section-{{ sid }} .hcl__tile{position:relative;display:block;min-width:0;aspect-ratio:var(--hcl-ratio,1 / 1);overflow:hidden;border-radius:var(--hcl-radius,var(--rounded-radius,0px));background:color-mix(in srgb,var(--color-heading) 7%,var(--color-background));color:inherit;text-decoration:none;-webkit-tap-highlight-color:transparent}
  #shopify-section-{{ sid }} .hcl__img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;display:block;transition:transform .35s ease}
  #shopify-section-{{ sid }} .hcl__img[data-r7h-empty]{object-fit:contain}
  #shopify-section-{{ sid }} a.hcl__tile:active{opacity:.85}
  #shopify-section-{{ sid }} a.hcl__tile:focus-visible{outline:2px solid var(--color-heading);outline-offset:-2px}
  @media (hover:hover){
    #shopify-section-{{ sid }} a.hcl__tile:hover .hcl__img{transform:scale(1.04)}
  }
  #shopify-section-{{ sid }} .hcl__nav{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}
  #shopify-section-{{ sid }} .hcl__nav[hidden]{display:none}
  #shopify-section-{{ sid }} .hcl__arrow{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border:1px solid var(--color-border);border-radius:var(--btn-radius,0px);background:transparent;color:var(--color-heading);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:opacity .2s ease}
  #shopify-section-{{ sid }} .hcl__arrow svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  #shopify-section-{{ sid }} .hcl__arrow:active{opacity:.6}
  #shopify-section-{{ sid }} .hcl__arrow:focus-visible{outline:2px solid var(--color-heading);outline-offset:2px}
  #shopify-section-{{ sid }} .hcl__arrow:disabled{opacity:.35;cursor:default}
  #shopify-section-{{ sid }} .hcl__frame:dir(rtl) .hcl__arrow svg{transform:scaleX(-1)}
  @media (max-width:767px){
    #shopify-section-{{ sid }} .hcl__frame{padding-inline:1.5rem}
    #shopify-section-{{ sid }} .hcl[data-media-first] .hcl__media{order:-1}
    #shopify-section-{{ sid }} .hcl__track{overflow-x:auto;overflow-y:hidden;margin-inline:-1.5rem;padding-inline:1.5rem;scroll-padding-inline:1.5rem;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;scrollbar-width:none;touch-action:pan-x pan-y}
    #shopify-section-{{ sid }} .hcl__track::-webkit-scrollbar{display:none}
    #shopify-section-{{ sid }} .hcl__track:focus-visible{outline:2px solid var(--color-heading);outline-offset:-2px}
    #shopify-section-{{ sid }} .hcl__tile{flex:0 0 var(--hcl-tile-m,75%);scroll-snap-align:start}
    #shopify-section-{{ sid }} .hcl[data-count="1"] .hcl__tile{flex-basis:100%}
  }
  @media (min-width:768px){
    #shopify-section-{{ sid }} .hcl{padding-block:calc(var(--r7h-pt-d,80px)*var(--sl-space-scale,1)) calc(var(--r7h-pb-d,80px)*var(--sl-space-scale,1))}
    #shopify-section-{{ sid }} .hcl__frame.stretch_width{padding-inline:3rem}
    #shopify-section-{{ sid }} .hcl__frame.full_width .hcl__content{padding-inline-start:3rem}
    #shopify-section-{{ sid }} .hcl[data-side="left"] .hcl__frame.full_width .hcl__content{padding-inline:0 3rem}
    #shopify-section-{{ sid }} .hcl__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,var(--hcl-media,45%));align-items:center;gap:calc(48px*var(--sl-space-scale,1))}
    #shopify-section-{{ sid }} .hcl[data-side="left"] .hcl__grid{grid-template-columns:minmax(0,var(--hcl-media,45%)) minmax(0,1fr)}
    #shopify-section-{{ sid }} .hcl[data-side="left"] .hcl__media{order:-1}
    #shopify-section-{{ sid }} .hcl[data-count="0"] .hcl__grid{grid-template-columns:minmax(0,1fr)}
    #shopify-section-{{ sid }} .hcl__track{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;padding-bottom:var(--hcl-offset,32px)}
    #shopify-section-{{ sid }} .hcl__tile:nth-child(even){top:var(--hcl-offset,32px)}
    #shopify-section-{{ sid }} .hcl[data-count="1"] .hcl__track{grid-template-columns:minmax(0,1fr);padding-bottom:0}
    #shopify-section-{{ sid }} .hcl[data-count="3"] .hcl__tile:nth-child(1){grid-column:1;grid-row:1 / span 2;aspect-ratio:auto;height:100%}
    #shopify-section-{{ sid }} .hcl[data-count="3"] .hcl__tile:nth-child(n+2){grid-column:2;top:var(--hcl-offset,32px)}
    #shopify-section-{{ sid }} .hcl__nav{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ sid }} .hcl__img,#shopify-section-{{ sid }} .hcl__arrow{transition:none}
    #shopify-section-{{ sid }} a.hcl__tile:hover .hcl__img{transform:none}
  }
{% comment %}{% endcomment %}</style>
<div class="r7h hcl color-{{ color_scheme }}" data-r7h="collage" data-r7h-section="{{ sid }}"{% if request.design_mode %} data-r7h-settings="{{ st | json | escape }}"{% endif %} data-r7h-placeholder="{{ r7_ph | escape }}" data-side="{{ r7_side }}" data-count="{{ r7_count }}"{% if st.mobile_image_first %} data-media-first{% endif %}{% if st.reset_spacing %} data-reset-spacing{% endif %}{% if r7_hf != '' or r7_bf != '' %} data-own-font{% endif %} style="--r7h-gap:{{ st.content_gap | default: 16 }}px;--r7h-max:{{ st.content_max_width | default: 520 }}px;--r7h-align:{{ r7_align }};--r7h-items:{{ r7_items }};--r7h-pt-d:{{ st.padding_top_desktop | default: 0 }}px;--r7h-pb-d:{{ st.padding_bottom_desktop | default: 0 }}px;--r7h-pt-m:{{ st.padding_top_mobile | default: 0 }}px;--r7h-pb-m:{{ st.padding_bottom_mobile | default: 0 }}px;--hcl-media:{{ st.media_width_desktop | default: 45 }}%;--hcl-ratio:{{ r7_ratio }};--hcl-gap:{{ st.collage_gap | default: 0 }}px;--hcl-offset:{{ st.collage_offset_desktop | default: 0 }}px;--hcl-tile-m:{{ st.tile_width_mobile | default: 75 }}%;{% if st.enable_custom_style %}--r7h-bg:{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};--hcl-radius:{{ st.image_radius | default: 0 }}px;{% endif %}{% if r7_hf != '' %}--r7h-hf:{{ r7_hf | escape }};{% endif %}{% if r7_bf != '' %}--r7h-bf:{{ r7_bf | escape }};{% endif %}">
  <div class="hcl__frame {{ st.section_width | default: 'container' }}" data-r7h-frame>
    <div class="hcl__grid">
      <div class="hcl__content">
        {%- render 'r7-hero-text', section: section, tag: r7_tag, name: 'Hero Collage' -%}
      </div>
      <div class="hcl__media"{% if r7_count == 0 %} hidden{% endif %}>
        <div class="hcl__track" data-r7h-track>
          {%- assign r7_n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'image' or block.hidden or r7_n >= 4 -%}{%- continue -%}{%- endif -%}
            {%- assign r7_n = r7_n | plus: 1 -%}
            {%- assign b = block.settings -%}
            {%- capture r7_tile %} class="hcl__tile" data-r7h-block="{{ block.id }}" data-r7h-type="image"{% if request.design_mode %} data-r7h-block-settings="{{ b | json | escape }}"{% endif %} {{ block.shopify_attributes }}{% endcapture -%}
            {%- capture r7_img -%}
              <img class="hcl__img" data-r7h-image{% if b.image != blank %} src="{{ b.image | image_url: width: 900 }}" srcset="{{ b.image | image_url: width: 450 }} 450w, {{ b.image | image_url: width: 900 }} 900w, {{ b.image | image_url: width: 1400 }} 1400w" sizes="(min-width: 768px) 30vw, 75vw" width="{{ b.image.width | default: 900 }}" height="{{ b.image.height | default: 1125 }}"{% else %} src="{{ r7_ph | escape }}" data-r7h-empty width="400" height="300"{% endif %} alt="{{ b.alt | default: b.image.alt | escape }}"{% if r7_eager and r7_n == 1 %} loading="eager"{% else %} loading="lazy"{% endif %} decoding="async">
            {%- endcapture -%}
            {%- if b.link != blank and b.link != '#' -%}<a href="{{ b.link | url | escape }}"{{ r7_tile }}>{{ r7_img }}</a>{%- else -%}<div{{ r7_tile }}>{{ r7_img }}</div>{%- endif -%}
          {%- endfor -%}
        </div>
        <div class="hcl__nav" data-r7h-nav{% if st.show_arrows == false or r7_count < 2 %} hidden{% endif %}>
          <button type="button" class="hcl__arrow" data-r7h-prev aria-label="{{ 'accessibility.previous' | t }}" disabled><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3L5 8l5 5"/></svg></button>
          <button type="button" class="hcl__arrow" data-r7h-next aria-label="{{ 'accessibility.next' | t }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5"/></svg></button>
        </div>
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "hero-collage",
  "name": "Hero Collage",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Pictures side (desktop)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_width_desktop",
      "label": "Pictures width (desktop)",
      "min": 35,
      "max": 65,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Text max width",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between blocks",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Pictures"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Picture shape",
      "default": "square",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "collage_gap",
      "label": "Gap between pictures",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "collage_offset_desktop",
      "label": "Offset (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32,
      "info": "How far the second column sits below the first."
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Picture corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Pictures first on phones",
      "default": false
    },
    {
      "type": "range",
      "id": "tile_width_mobile",
      "label": "Picture width (mobile)",
      "min": 55,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 75,
      "info": "Less than 100% leaves the next picture peeking in, so the row reads as swipeable."
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows on phones",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "The lookbook"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "See it worn, then make it yours"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
