<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Popup must escape section stacking contexts to render above all other content */
  #shopify-section-{{ section.id }} {
    position: static;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<style>
  /* Theme typography for popup section — no reveal animation, popups must remain visible at all times */
  #shopify-section-{{ section.id }} { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  /* Hard-disable any leftover reveal-on-scroll classes that would hide a popup */
  #shopify-section-{{ section.id }} { opacity: 1 !important; transform: none !important; contain: none !important; isolation: auto !important; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Block lookup: each content piece (heading, description, image, form) is a
  block with limit:1. If a block is missing, fall back to legacy section
  settings so existing instances keep rendering.
{%- endcomment -%}
{%- assign block_heading = blank -%}
{%- assign block_description = blank -%}
{%- assign block_image = blank -%}
{%- assign block_form = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'heading' -%}{%- assign block_heading = b -%}
    {%- when 'description' -%}{%- assign block_description = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
    {%- when 'form' -%}{%- assign block_form = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- if block_heading != blank -%}
  {%- assign pp2_heading = block_heading.settings.text -%}
  {%- assign pp2_heading_color = block_heading.settings.color -%}
  {%- assign pp2_heading_size_d = block_heading.settings.size_desktop -%}
  {%- assign pp2_heading_size_m = block_heading.settings.size_mobile -%}
  {%- assign pp2_heading_weight = block_heading.settings.weight -%}
  {%- assign pp2_heading_padding_top = block_heading.settings.padding_top -%}
{%- else -%}
  {%- assign pp2_heading = section.settings.heading -%}
  {%- assign pp2_heading_color = section.settings.heading_color -%}
  {%- assign pp2_heading_size_d = section.settings.desktop_heading_size -%}
  {%- assign pp2_heading_size_m = section.settings.mobile_heading_size -%}
  {%- assign pp2_heading_weight = section.settings.heading_font_weight -%}
  {%- assign pp2_heading_padding_top = section.settings.heading_padding_top -%}
{%- endif -%}

{%- if block_description != blank -%}
  {%- assign pp2_description = block_description.settings.text -%}
  {%- assign pp2_description_color = block_description.settings.color -%}
  {%- assign pp2_description_size_d = block_description.settings.size_desktop -%}
  {%- assign pp2_description_size_m = block_description.settings.size_mobile -%}
  {%- assign pp2_description_weight = block_description.settings.weight -%}
  {%- assign pp2_description_padding_top = block_description.settings.padding_top -%}
{%- else -%}
  {%- assign pp2_description = section.settings.description -%}
  {%- assign pp2_description_color = section.settings.description_color -%}
  {%- assign pp2_description_size_d = section.settings.desktop_description_size -%}
  {%- assign pp2_description_size_m = section.settings.mobile_description_size -%}
  {%- assign pp2_description_weight = section.settings.description_font_weight -%}
  {%- assign pp2_description_padding_top = section.settings.description_padding_top -%}
{%- endif -%}

{%- if block_image != blank -%}
  {%- assign pp2_image = block_image.settings.image -%}
  {%- assign pp2_image_filter_id = block_image.settings.filter -%}
{%- else -%}
  {%- assign pp2_image = section.settings.image -%}
  {%- assign pp2_image_filter_id = section.settings.image_filter -%}
{%- endif -%}

{%- if block_form != blank -%}
  {%- assign pp2_email_placeholder = block_form.settings.email_placeholder -%}
  {%- assign pp2_button_text = block_form.settings.button_text -%}
  {%- assign pp2_button_bg = block_form.settings.button_background -%}
  {%- assign pp2_button_text_color = block_form.settings.button_text_color -%}
  {%- assign pp2_button_bg_hover = block_form.settings.button_background_hover -%}
  {%- assign pp2_button_text_hover = block_form.settings.button_text_hover -%}
  {%- assign pp2_input_size_d = block_form.settings.input_size_desktop -%}
  {%- assign pp2_input_size_m = block_form.settings.input_size_mobile -%}
  {%- assign pp2_input_weight = block_form.settings.input_weight -%}
  {%- assign pp2_input_padding_top = block_form.settings.input_padding_top -%}
  {%- assign pp2_input_border_radius = block_form.settings.input_border_radius -%}
  {%- assign pp2_input_color = block_form.settings.input_color -%}
  {%- assign pp2_input_background = block_form.settings.input_background -%}
  {%- assign pp2_input_placeholder = block_form.settings.input_placeholder -%}
  {%- assign pp2_input_border = block_form.settings.input_border -%}
  {%- assign pp2_button_size_d = block_form.settings.button_size_desktop -%}
  {%- assign pp2_button_size_m = block_form.settings.button_size_mobile -%}
  {%- assign pp2_button_weight = block_form.settings.button_weight -%}
  {%- assign pp2_button_padding_top = block_form.settings.button_padding_top -%}
  {%- assign pp2_button_border_radius = block_form.settings.button_border_radius -%}
  {%- assign pp2_button_border = block_form.settings.button_border -%}
{%- else -%}
  {%- assign pp2_email_placeholder = section.settings.email_placeholder -%}
  {%- assign pp2_button_text = section.settings.button_text -%}
  {%- assign pp2_button_bg = section.settings.button_background_color -%}
  {%- assign pp2_button_text_color = section.settings.button_text_color -%}
  {%- assign pp2_button_bg_hover = section.settings.button_background_color -%}
  {%- assign pp2_button_text_hover = section.settings.button_text_color -%}
  {%- assign pp2_input_size_d = section.settings.desktop_input_font_size -%}
  {%- assign pp2_input_size_m = section.settings.mobile_input_font_size -%}
  {%- assign pp2_input_weight = section.settings.input_font_weight -%}
  {%- assign pp2_input_padding_top = section.settings.input_padding_top -%}
  {%- assign pp2_input_border_radius = section.settings.input_border_radius -%}
  {%- assign pp2_input_color = section.settings.input_color -%}
  {%- assign pp2_input_background = section.settings.input_background_color_default -%}
  {%- assign pp2_input_placeholder = section.settings.input_placeholder_color -%}
  {%- assign pp2_input_border = section.settings.input_border_color -%}
  {%- assign pp2_button_size_d = section.settings.desktop_button_font_size -%}
  {%- assign pp2_button_size_m = section.settings.mobile_button_font_size -%}
  {%- assign pp2_button_weight = section.settings.button_font_weight -%}
  {%- assign pp2_button_padding_top = section.settings.button_padding_top -%}
  {%- assign pp2_button_border_radius = section.settings.button_border_radius -%}
  {%- assign pp2_button_border = section.settings.button_border_color -%}
{%- endif -%}

{%- liquid
  if pp2_image_filter_id and pp2_image_filter_id != 'none'
    assign image_filter = 'loudz__filter--' | append: pp2_image_filter_id
  else
    assign image_filter = ''
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign pp2_use_theme_fields = true
  assign pp2_use_theme_button = true
  if block_form != blank
    if block_form.settings.use_theme_fields == false
      assign pp2_use_theme_fields = false
    endif
    if block_form.settings.use_theme_button == false
      assign pp2_use_theme_button = false
    endif
  endif
-%}

<style>
  .loudz-newsletter-4 * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .loudz__content-inner {
    padding: 0 32px;
  }

  .loudz-newsletter-4 .loudz__popup {
    align-items: var(--loudz-popup-align);
    justify-content: var(--loudz-popup-justify);
    inset: var(--loudz-popup-inset);
    height: var(--loudz-popup-height);
    width: var(--loudz-popup-width);
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    position: fixed;
    display: flex;
    max-height: calc(var(--sl-vh, 1vh) * 100);
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 2147483647;
  }
  .loudz-newsletter-4 .loudz__content-box {
    transform: translateY(16px) scale(.98);
    transition: transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .loudz-newsletter-4 .loudz__popup.active .loudz__content-box { transform: none; }

  .loudz-newsletter-4 .loudz__popup.loudz__popup--center {
    align-items: center;
    justify-content: center;
    inset: 0;
    height: calc(var(--sl-vh, 1vh) * 100);
    padding: 20px;
  }

  .loudz-newsletter-4 .loudz__popup.loudz__popup--left {
    left: 40px;
    bottom: 40px;
    right: auto;
    top: auto;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .loudz-newsletter-4 .loudz__popup.loudz__popup--right {
    right: 40px;
    bottom: 40px;
    left: auto;
    top: auto;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .loudz-newsletter-4 .loudz__popup.active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .loudz-newsletter-4 .loudz__popup:after {
    z-index: -1;
  }

  .loudz-newsletter-4 .loudz__popup:after {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--loudz-overlay-color, #000000);
  opacity: var(--loudz-overlay-opacity, 0.5);
  z-index: -1;
  }

  .loudz-newsletter-4 .loudz__content-box {
    border-radius: var(--loudz-border-radius);
    max-width: var(--loudz-section-width);
    background: var(--loudz-background-color);
    width: 100%;
    box-shadow: 0 6px 32px 0 rgba(16, 24, 40, 0.18);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    margin: auto;
    max-height: calc(var(--sl-vh, 1vh) * 100 - 40px);
    overflow-y: auto;
  }
  /* Mobile: always center the popup with a safe gutter, regardless of the
     desktop `popup_position` setting. This guarantees the popup never sticks
     to the right/left edge on phones. */
  @media (max-width: 767px) {
    .loudz-newsletter-4 .loudz__popup {
      align-items: center !important;
      justify-content: center !important;
      inset: 0 !important;
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: calc(var(--sl-vh, 1vh) * 100) !important;
      padding: 16px;
    }
    .loudz-newsletter-4 .loudz__content-box {
      width: calc(100vw - var(--loudz-mobile-gutter, 32px)) !important;
      max-width: calc(100vw - var(--loudz-mobile-gutter, 32px)) !important;
      margin: auto !important;
    }
  }

  .loudz-newsletter-4 .loudz__description {
    font-size: var(--loudz-description-size);
    padding-top: var(--loudz-description-padding-top);
    font-weight: var(--loudz-description-font-weight);
    color: var(--loudz-description-color);
    text-align: var(--loudz-content-alignment);
    line-height: 1.5;
  }

  .loudz-newsletter-4 .loudz__image-wrapper {
    border-top-left-radius: var(--loudz-border-radius);
    border-top-right-radius: var(--loudz-border-radius);
    width: 100%;
    overflow: hidden;
    height: 220px;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-heading) 8%, var(--color-background));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loudz-newsletter-4 .loudz__image-wrapper img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .loudz-newsletter-4 .loudz__filter--grayscale { filter: grayscale(100%); }
  .loudz-newsletter-4 .loudz__filter--sepia { filter: sepia(100%) contrast(1.2); }
  .loudz-newsletter-4 .loudz__filter--invert { filter: invert(100%); }

  .loudz-newsletter-4 .loudz__heading {
    font-size: var(--loudz-heading-size);
    font-weight: var(--loudz-heading-weight);
    padding-top: var(--loudz-heading-padding-top);
    color: var(--loudz-heading-color);
    text-align: var(--loudz-content-alignment);
    line-height: 1.2;
  }

  .loudz-newsletter-4 input[type="email"] {
    font-size: var(--loudz-input-font-size);
    font-weight: var(--loudz-input-font-weight);
    margin-top: var(--loudz-input-padding-top);
    border-radius: var(--loudz-input-border-radius);
    background-color: var(--loudz-input-background-color);
    color: var(--loudz-input-color);
    border: var(--loudz-input-border-width, 1px) solid var(--loudz-input-border-color);
    width: 100%;
    min-height: var(--loudz-input-height, 0px);
    padding: var(--loudz-input-padding, 16px 18px);
    outline: none;
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  .loudz-newsletter-4 input[type="email"]:focus-visible {
    border-color: var(--color-heading);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent);
  }

  .loudz-newsletter-4 input[type="email"]::placeholder {
    color: var(--loudz-input-placeholder-color);
    opacity: 1;
  }

  /* The submit is a theme button (theme-button-contract.css): Theme settings >
     Buttons draw it; the form's colours, and its shape when the theme style is
     off, reach it as --mb-* tokens. */
  .loudz-newsletter-4 .loudz__button {
    margin-top: var(--loudz-button-padding-top);
    width: 100%;
    cursor: pointer;
    --mb-bg: var(--loudz-button-background-color);
    --mb-text: var(--loudz-button-text-color);
    --mb-border: var(--loudz-button-border-color);
    --mb-hover-bg: var(--loudz-button-background-color-hover);
    --mb-hover-text: var(--loudz-button-text-color-hover);
    --mb-hover-border: var(--loudz-button-border-color-hover);
    --mb-radius: var(--loudz-button-border-radius);
    --mb-font-size: var(--loudz-button-font-size);
    --mb-weight: var(--loudz-button-font-weight);
  }

  .loudz-newsletter-4 .loudz__success { margin-top: 12px; color: var(--loudz-description-color); text-align: var(--loudz-content-alignment); }
  .loudz-newsletter-4 .loudz__placeholder-image { width: 100%; height: 100%; fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
  .loudz-newsletter-4 .loudz__button:focus-visible,
  .loudz-newsletter-4 .loudz__close:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .loudz-newsletter-4 .loudz__popup,
    .loudz-newsletter-4 .loudz__close,
    .loudz-newsletter-4 input[type="email"],
    .loudz-newsletter-4 .loudz__content-box { transition: none; transform: none; }
  }

  .loudz-newsletter-4 .loudz__close {
    position: absolute;
    top: 20px;
    width: 44px;
    height: 44px;
    background: var(--color-background);
    border-radius: 50%;
    border: none;
    box-shadow: 0 2px 8px 0 rgba(16, 24, 40, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--color-heading);
    cursor: pointer;
    z-index: 2;
    transition: box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  
  .loudz-newsletter-4 .loudz__close--right {
    right: 20px;
    left: auto;
  }

  .loudz-newsletter-4 .loudz__close--left {
    left: 20px;
    right: auto;
  }

  .loudz-newsletter-4 .loudz__popup::-webkit-scrollbar {
    width: 8px;
}

.loudz-newsletter-4 .loudz__popup::-webkit-scrollbar-track {
    background: transparent;
}

.loudz-newsletter-4 .loudz__popup::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

.loudz-newsletter-4 .loudz__popup::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.3);
}
{% comment %}{% endcomment %}</style>

<style>
  #loudz-{{ section.id }} {
    --loudz-background-color: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %}{% endif %} !important;
    --loudz-overlay-color: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %} !important;
    --loudz-overlay-opacity: {{ section.settings.overlay_opacity }};
    --loudz-border-radius: {{ section.settings.border_radius }}px;
    --loudz-section-width: {{ section.settings.inner_width_px }}px;
    --loudz-content-alignment: {{ section.settings.content_alignment }};
    --loudz-heading-size: {{ pp2_heading_size_m }}px;
    --loudz-heading-weight: {{ pp2_heading_weight }};
    --loudz-heading-padding-top: {{ pp2_heading_padding_top }}px;
    --loudz-description-padding-top: {{ pp2_description_padding_top }}px;
    --loudz-button-padding-top: {{ pp2_button_padding_top }}px;
    --loudz-input-padding-top: {{ pp2_input_padding_top }}px;
    --loudz-heading-color: {% render 'scheme-color', color: pp2_heading_color, fallback: 'var(--color-heading)' %} !important;
    --loudz-description-size: {{ pp2_description_size_m }}px;
    --loudz-description-font-weight: {{ pp2_description_weight }};
    --loudz-description-color: {% render 'scheme-color', color: pp2_description_color, fallback: 'var(--color-text)' %} !important;
    --loudz-input-font-size: {% if pp2_use_theme_fields %}var(--input-font-size, {{ pp2_input_size_m }}px){% else %}{{ pp2_input_size_m }}px{% endif %};
    --loudz-input-color: {% render 'scheme-color', color: pp2_input_color, fallback: 'var(--input-color)' %} !important;
    --loudz-input-background-color: {% render 'scheme-color', color: pp2_input_background, fallback: 'var(--input-bg)' %} !important;
    --loudz-input-placeholder-color: {% render 'scheme-color', color: pp2_input_placeholder, fallback: 'var(--input-placeholder-color)' %} !important;
    --loudz-input-border-color: {% render 'scheme-color', color: pp2_input_border, fallback: 'var(--color-border)' %} !important;
    {%- if pp2_use_theme_fields %}
    --loudz-input-border-radius: var(--input-border-radius, {{ pp2_input_border_radius | default: 6 }}px);
    --loudz-input-border-width: var(--inputs-border-width, 1px);
    --loudz-input-height: var(--input-height, 0px);
    --loudz-input-padding: var(--input-padding, 16px 18px);
    {%- else %}
    --loudz-input-border-radius: {{ pp2_input_border_radius }}px;
    {%- endif %}
    --loudz-input-font-weight: {{ pp2_input_weight }};
    --loudz-button-font-size: {% if pp2_use_theme_button %}var(--btn-font-size, {{ pp2_button_size_m }}px){% else %}{{ pp2_button_size_m }}px{% endif %};
    --loudz-button-font-weight: {{ pp2_button_weight }};
    --loudz-button-text-color: {% render 'scheme-color', color: pp2_button_text_color, fallback: 'var(--btn-primary-color)' %} !important;
    --loudz-button-background-color: {% render 'scheme-color', color: pp2_button_bg, fallback: 'var(--btn-primary-bg-color)' %} !important;
    --loudz-button-text-color-hover: {% render 'scheme-color', color: pp2_button_text_hover, fallback: 'var(--btn-primary-hover-color)' %};
    --loudz-button-background-color-hover: {% render 'scheme-color', color: pp2_button_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
    --loudz-button-border-color: {% render 'scheme-color', color: pp2_button_border, fallback: 'var(--btn-primary-border-color, transparent)' %} !important;
    --loudz-button-border-color-hover: {% if pp2_button_border != blank and pp2_button_border.alpha != 0 %}{{ pp2_button_border }}{% else %}var(--btn-primary-hover-border-color, transparent){% endif %};
    {%- if pp2_use_theme_button %}
    --loudz-button-border-radius: var(--btn-radius, {{ pp2_button_border_radius | default: 6 }}px);
    --loudz-button-border-width: var(--btn-border-width, 1px);
    --loudz-button-padding: var(--btn-padding-y, 16px) var(--btn-padding-x, 0px);
    --loudz-button-font-weight: var(--btn-font-weight, {{ pp2_button_weight | default: 700 }});
    {%- else %}
    --loudz-button-border-radius: {{ pp2_button_border_radius }}px;
    {%- endif %}

    --loudz-popup-align: center;
    --loudz-popup-justify: center;
    --loudz-popup-inset: 0;
    --loudz-popup-height: calc(var(--sl-vh, 1vh) * 100);
    --loudz-popup-width: 100vw;
  }

  @media (min-width: 768px) {
    #loudz-{{ section.id }} {
      --loudz-heading-size: {{ pp2_heading_size_d }}px;
      --loudz-heading-weight: {{ pp2_heading_weight }};
      --loudz-description-size: {{ pp2_description_size_d }}px;
      --loudz-description-font-weight: {{ pp2_description_weight }};
      --loudz-input-font-size: {% if pp2_use_theme_fields %}var(--input-font-size, {{ pp2_input_size_d }}px){% else %}{{ pp2_input_size_d }}px{% endif %};
      --loudz-input-font-weight: {{ pp2_input_weight }};
      --loudz-button-font-size: {% if pp2_use_theme_button %}var(--btn-font-size, {{ pp2_button_size_d }}px){% else %}{{ pp2_button_size_d }}px{% endif %};
      --loudz-button-font-weight: {% if pp2_use_theme_button %}var(--btn-font-weight, {{ pp2_button_weight | default: 700 }}){% else %}{{ pp2_button_weight }}{% endif %};

      {% case section.settings.content_alignment %}
      {% when 'center' %}
        --loudz-popup-align: flex-end;
        --loudz-popup-justify: center;
      {% when 'left' %}
        --loudz-popup-align: flex-end;
        --loudz-popup-justify: flex-start;
      {% when 'right' %}
        --loudz-popup-align: flex-end;
        --loudz-popup-justify: flex-end;
      {% else %}
        --loudz-popup-align: center;
        --loudz-popup-justify: center;
    {% endcase %}

      --loudz-popup-justify: {% case section.settings.popup_position %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      --loudz-popup-inset: {% case section.settings.popup_position %}{% when 'left' %}auto auto 40px 40px{% when 'right' %}auto 40px 40px auto{% else %}auto 0 40px auto{% endcase %};
      --loudz-popup-height: {% case section.settings.popup_position %}{% when 'left' %}auto{% when 'right' %}auto{% else %}calc(var(--sl-vh, 1vh) * 100){% endcase %};
      --loudz-popup-width: {% case section.settings.popup_position %}{% when 'left' %}auto{% when 'right' %}auto{% else %}100vw{% endcase %};
    }
  }
{% comment %}{% endcomment %}</style>

{%- capture pp2_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ section.settings.enable_customization_mode | json }},
   "trigger": {"mode": {{ section.settings.open_mode | default: 'delay' | json }}, "delay": {{ section.settings.popup_delay | default: 0 | json }}, "scroll": {{ section.settings.scroll_pct | default: 50 | json }}, "views": {{ section.settings.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ section.settings.after_dismiss | default: 'after_days' | json }}, "days": {{ section.settings.hide_days | default: 1 | json }} } }
{%- endcapture -%}
<div id="loudz-{{ section.id }}" class="loudz-newsletter-4 loudz-{{ section.id }} color-{{ color_scheme }}"
     data-popup-root="{{ section.id }}" data-popup-config="{{ pp2_config | strip_newlines | escape }}" aria-hidden="true">
  <div class="loudz__popup loudz__popup--{{ section.settings.popup_position | default: 'center' }}">
    <div class="loudz__content-box" role="dialog" aria-modal="true"{% if pp2_heading != blank %} aria-labelledby="loudz-title-{{ section.id }}"{% endif %} tabindex="-1">
      <button type="button" class="loudz__close loudz__close--{{ section.settings.close_button_position }}" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M15 9L9 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M9 9L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="loudz__image-wrapper"{% if block_image != blank %} {{ block_image.shopify_attributes }}{% endif %}>
        {% if pp2_image == blank %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'loudz__placeholder-image' }}
        {% else %}
          {{ pp2_image | image_url: width: 900 | image_tag: loading: 'lazy', class: image_filter, sizes: '(min-width: 768px) 480px, 100vw', widths: '400,600,900' }}
        {% endif %}
      </div>

      <div class="loudz__content-inner" style="padding-block: {{ section.settings.padding_block }}px; padding-inline: {{ section.settings.padding_inline }}px;">
        {% if pp2_heading != blank %}
          <{{ heading_tag }} class="loudz__heading" id="loudz-title-{{ section.id }}"{% if block_heading != blank %} {{ block_heading.shopify_attributes }}{% endif %}>{{ pp2_heading }}</{{ heading_tag }}>
        {% endif %}

        {% if pp2_description != blank %}
          <p class="loudz__description"{% if block_description != blank %} {{ block_description.shopify_attributes }}{% endif %}>{{ pp2_description }}</p>
        {% endif %}

        <form class="loudz__form" data-storelib-form="subscribe">
          <input type="email" name="email" autocomplete="email" placeholder="{{ pp2_email_placeholder | escape }}" aria-label="{{ pp2_email_placeholder | default: 'Email' | escape }}" required data-popup-autofocus>
          <button type="submit" class="loudz__button btn-primary" data-theme-button="primary" data-sl-button{% if block_form != blank %} {{ block_form.shopify_attributes }}{% endif %}>{{ pp2_button_text }}</button>
          <p class="loudz__success" data-storelib-success hidden>{% if block_form != blank %}{{ block_form.settings.success_text | default: 'Thanks, you are on the list.' }}{% else %}Thanks, you are on the list.{% endif %}</p>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__pp2) return;
    root.__pp2 = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var popup = root.querySelector('.loudz__popup');
    var form = root.querySelector('form');
    var api = P.register({
      id: SID, root: root, dialog: root.querySelector('.loudz__content-box'), backdrop: popup,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-loudz-open="' + SID + '"]' }, CFG.trigger),
      frequency: { mode: CFG.frequency.mode === 'every_visit' ? 'always' : CFG.frequency.mode, days: CFG.frequency.days },
      open: function(){ popup.classList.add('active'); },
      close: function(){ popup.classList.remove('active'); }
    });
    // Signed up (Storelib marks the form done): thank them, then not again for 20 days.
    if (form) new MutationObserver(function(){
      if (form.getAttribute('data-state') === 'done' && api) api.done(20);
    }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>


</template>

