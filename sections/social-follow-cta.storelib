<template compat="shopify">
<script src="{{ 'live-r7-connect.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Follow Us: heading and subheading blocks, then one large
  follow button for every social network the store has in Theme settings >
  Social media (its icon and its name), then up to six pictures, each linking
  where its block says. With no network set the buttons are left out; the
  builder shows a hint in their place. The pictures sit in one row on
  desktop and become a row a finger swipes on a phone (native scroll snap),
  with arrows that live-r7-connect.js moves. Styles: r7-connect.css, reading
  the --r7c-* variables on the root (snippets/r7-connect-vars).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign header_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign header_count = header_blocks.size | plus: sub_blocks.size
  assign tiles = section.blocks | where: 'type', 'image'
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign own_shape = false
  if st.use_theme_button == false
    assign own_shape = true
  endif
  assign btn_style = st.button_style | default: 'secondary'
  assign btn_size = st.button_size | default: 'medium'
  assign net_target = '_self'
  if settings.social_open_new_tab
    assign net_target = '_blank'
  endif
  assign net_keys = 'facebook,instagram,twitter,youtube,tiktok,pinterest,vimeo,linkedin,whatsapp,tumblr,snapchat,social_threads,social_x,social_telegram,social_discord,social_spotify,social_reddit' | split: ','
  assign net_count = 0
  for key in net_keys
    assign net_url = settings[key] | strip
    if net_url != blank and net_url != '#'
      assign net_count = net_count | plus: 1
    endif
  endfor
-%}
<style>
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }},#shopify-section-{{ sid }}>.section,#shopify-section-{{ sid }}>section,#shopify-section-{{ sid }}>div,#shopify-section-{{ sid }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ sid }}+.shopify-section,#shopify-section-{{ sid }}+section,.shopify-section+#shopify-section-{{ sid }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ sid }}{isolation:isolate;position:relative;margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}
  @media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}
{% comment %}{% endcomment %}</style>
{%- comment -%} The builder also gets the styles inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'r7-connect.css' | inline_asset_content }}</style>{%- endif %}
{{ 'r7-connect.css' | asset_url | stylesheet_tag }}
{%- capture r7c_vars -%}{% render 'r7-connect-vars', section: section, kind: 'follow' %}{%- endcapture -%}
{%- capture btn_vars -%}
  {%- if st.enable_custom_style -%}{% render 'button-overrides', bg: st.button_bg, text: st.button_text, border: st.button_border, hover_bg: st.button_bg_hover, hover_text: st.button_text_hover %}{%- endif -%}
  {%- if own_shape -%}
    --mb-radius:{{ st.button_radius | default: 4 }}px;
    {%- case btn_size -%}
      {%- when 'small' -%}--mb-font-size:14px;--mb-padding-y:10px;--mb-padding-x:18px;
      {%- when 'large' -%}--mb-font-size:18px;--mb-padding-y:18px;--mb-padding-x:30px;
      {%- else -%}--mb-font-size:16px;--mb-padding-y:14px;--mb-padding-x:24px;
    {%- endcase -%}
  {%- endif -%}
  {%- if sec_font and st.body_font.family != blank -%}--mb-font:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
{%- capture btn_attrs -%}data-r7c-fbtn data-theme-button="{% if btn_style == 'primary' %}primary{% else %}secondary{% endif %}" data-sl-button{% if own_shape %} data-own-shape{% endif %}{% if sec_font %} data-own-font{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}{%- endcapture -%}
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<div class="r7c r7c--follow color-{{ color_scheme }} gradient" data-r7c="social-follow-cta" data-r7c-section="{{ sid }}"{% if request.design_mode %} data-r7c-settings="{{ st | json | escape }}"{% endif %} data-r7c-width="{{ st.section_width | default: 'fluid_container' }}" data-r7c-show="{{ st.show_section_on | default: 'all' }}" data-r7c-align="{{ st.content_alignment | default: 'center' }}" data-r7c-buttons="{{ st.buttons_layout | default: 'inline' }}" data-r7c-ratio="{{ st.image_ratio | default: 'square' }}" data-r7c-arrows="{% if st.show_arrows == false %}false{% else %}true{% endif %}" data-r7c-count="{{ tiles.size }}" style="{{ r7c_vars | strip_newlines }}">
  <div class="r7c__inner">
    {%- if header_count > 0 -%}
      <div class="r7c__header">
        {%- for block in section.blocks -%}
          {%- if block.type == 'heading' or block.type == 'subheading' -%}{%- render 'r7-connect-block', block: block, section: section -%}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if net_count > 0 -%}
      <ul class="r7c__follow" role="list" data-r7c-follow>
        {%- for key in net_keys -%}
          {%- assign net_url = settings[key] | strip -%}
          {%- if net_url != blank and net_url != '#' -%}{%- render 'r7-connect-network', key: key, url: net_url, target: net_target, prefix: st.button_prefix, attrs: btn_attrs -%}{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="r7c__hint-box" data-r7c-nohint>Add your social links in Theme settings &gt; Social media and a follow button shows here for each one.</p>
    {%- endif -%}
    {%- if tiles.size > 0 -%}
      <div class="r7c__gallery" data-r7c-gallery>
        <div class="r7c__track" id="r7c-track-{{ sid }}" data-r7c-track tabindex="0" role="region" aria-label="{{ 'accessibility.images' | t | escape }}">
          {%- for block in tiles -%}{%- render 'r7-connect-block', block: block, section: section -%}{%- endfor -%}
        </div>
        <div class="r7c__nav" data-r7c-nav>
          <button type="button" class="r7c__arrow" data-r7c-prev aria-controls="r7c-track-{{ sid }}" aria-label="{{ 'accessibility.previous' | t | escape }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"/></svg></button>
          <button type="button" class="r7c__arrow" data-r7c-next aria-controls="r7c-track-{{ sid }}" aria-label="{{ 'accessibility.next' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- if request.design_mode -%}
{%- comment -%} The builder runs a redrawn or newly added section's inline scripts: load the controller if this page did not have it yet, or set this section up. {%- endcomment -%}
<script>(function(){if(window.MateriaR7Connect)return window.MateriaR7Connect.scan();if(document.querySelector('script[data-r7c-boot]'))return;var s=document.createElement('script');s.src="{{ 'live-r7-connect.js' | asset_url }}";s.setAttribute('data-r7c-boot','');document.head.appendChild(s);})();{% comment %}{% endcomment %}</script>
{%- endif -%}
</template>

<schema>
{
  "shopify": {
    "name": "Follow Us",
    "class": "section-r7c",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "show_section_on",
        "label": "Show section on",
        "default": "all",
        "options": [
          {
            "value": "all",
            "label": "All"
          },
          {
            "value": "mobile",
            "label": "Mobile"
          },
          {
            "value": "desktop",
            "label": "Desktop"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "A follow button shows for each link in Theme settings > Social media."
      },
      {
        "type": "text",
        "id": "button_prefix",
        "label": "Words before the network name",
        "info": "For example Follow us on. Empty shows the name only."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "select",
        "id": "buttons_layout",
        "label": "Buttons",
        "default": "inline",
        "options": [
          {
            "value": "inline",
            "label": "In a row"
          },
          {
            "value": "grid",
            "label": "Equal width"
          }
        ]
      },
      {
        "type": "header",
        "content": "Pictures"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Picture shape",
        "default": "square",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_gap",
        "label": "Gap between pictures",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show arrows on mobile",
        "default": true,
        "info": "On a phone the pictures swipe sideways."
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "default": "secondary",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "secondary",
            "label": "Secondary"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Match theme button",
        "default": true
      },
      {
        "type": "select",
        "id": "button_size",
        "label": "Size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ],
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 4,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme and Theme settings > Buttons."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text",
        "label": "Button text and icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_border",
        "label": "Button border",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg_hover",
        "label": "Button background on hover",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_hover",
        "label": "Button text on hover",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text and button font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Follows Theme settings > Animations."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Follow us"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra bold"
              }
            ],
            "visible_if": "{{ block.settings.weight_enable }}"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 36,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 26,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.8,
            "max": 2,
            "step": 0.05,
            "default": 1.15,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -2,
            "max": 10,
            "step": 0.5,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>New arrivals, restocks and the stories behind them, first on our socials.</p>"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ block.settings.weight_enable }}"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 11,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
