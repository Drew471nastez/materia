<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Benefits Bar 2
  A clean horizontal row of benefit columns (FREE SHIPPING / WARRANTY /
  SECURE PAYMENT / FREE RETURNS style). Block-based — each column is a
  block with icon (from 30-icon library / image / SVG), title, description.
  Vertical dividers between columns are optional.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer wrapper */
  #shopify-section-{{ sid }} .bb2 {
    background-color: {{ st.section_bg | default: '#FFFFFF' }} !important;
    padding-top: {{ st.padding_top_mobile | default: 32 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 32 }}px;
    {%- if st.show_top_border -%}border-top: 1px solid {{ st.divider_color | default: 'rgba(0,0,0,0.08)' }};{%- endif -%}
    {%- if st.show_bottom_border -%}border-bottom: 1px solid {{ st.divider_color | default: 'rgba(0,0,0,0.08)' }};{%- endif -%}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bb2 {
      padding-top: {{ st.padding_top_desktop | default: 48 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 48 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .bb2__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .bb2__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- else -%}
      #shopify-section-{{ sid }} .bb2__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Grid */
  #shopify-section-{{ sid }} .bb2__grid {
    display: grid;
    grid-template-columns: repeat({{ st.cols_mobile | default: 2 }}, minmax(0, 1fr));
    gap: {{ st.gap_mobile | default: 24 }}px {{ st.col_gap_mobile | default: 16 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bb2__grid {
      grid-template-columns: repeat({{ st.cols_desktop | default: 4 }}, minmax(0, 1fr));
      gap: {{ st.gap_desktop | default: 0 }}px {{ st.col_gap_desktop | default: 0 }}px;
    }
  }

  /* Item */
  #shopify-section-{{ sid }} .bb2__item {
    display: flex;
    flex-direction: {% if st.layout == 'horizontal' %}row{% else %}column{% endif %};
    align-items: {% if st.alignment == 'left' %}flex-start{% elsif st.alignment == 'right' %}flex-end{% else %}center{% endif %};
    text-align: {{ st.alignment | default: 'center' }};
    gap: {{ st.item_gap | default: 12 }}px;
    padding: {{ st.item_padding | default: 0 }}px {{ st.item_pad_x | default: 16 }}px;
    position: relative;
  }
  @media (min-width: 768px) {
    {%- if st.show_dividers -%}
      #shopify-section-{{ sid }} .bb2__item:not(:last-child)::after {
        content: '';
        position: absolute;
        right: 0;
        top: 12%;
        bottom: 12%;
        width: 1px;
        background-color: {{ st.divider_color | default: 'rgba(0,0,0,0.08)' }};
      }
    {%- endif -%}
  }
  #shopify-section-{{ sid }} .bb2__icon {
    flex-shrink: 0;
    width: {{ st.icon_box_size | default: 40 }}px;
    height: {{ st.icon_box_size | default: 40 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ st.icon_box_radius | default: 999 }}px;
  }
  #shopify-section-{{ sid }} .bb2__icon svg,
  #shopify-section-{{ sid }} .bb2__icon img {
    width: {{ st.icon_size | default: 22 }}px;
    height: {{ st.icon_size | default: 22 }}px;
  }
  #shopify-section-{{ sid }} .bb2__title {
    margin: 0 0 4px;
    line-height: 1.25;
    font-size: {{ st.title_size | default: 14 }}px;
    font-weight: 700;
    letter-spacing: {{ st.title_letter_spacing | default: 0 }}px;
    {%- if st.title_uppercase -%}text-transform: uppercase;{%- endif -%}
  }
  #shopify-section-{{ sid }} .bb2__desc {
    margin: 0;
    line-height: 1.5;
    font-size: {{ st.desc_size | default: 13 }}px;
  }

  /* ── Mobile carousel (optional) ───────────────────────────────
     When enabled, the grid becomes a single-row, scroll-snap,
     swipeable track on mobile only — desktop is untouched. The
     peek (items-per-view 1.0–3.0) makes the next item visible so
     it reads as swipeable. No layout shift: this only overrides
     the mobile grid when the toggle is on. */
  {%- if st.enable_mobile_carousel -%}
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .bb2__grid {
      display: flex;
      grid-template-columns: none;
      flex-wrap: nowrap;
      gap: {{ st.col_gap_mobile | default: 16 }}px;
      --bb2-ipv: {{ st.mobile_items_per_view | default: 1.2 }};
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 2px;
    }
    #shopify-section-{{ sid }} .bb2__grid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .bb2__item {
      scroll-snap-align: start;
      flex: 0 0 calc((100% - {{ st.col_gap_mobile | default: 16 }}px * (var(--bb2-ipv) - 1)) / var(--bb2-ipv));
    }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .bb2__grid { scroll-behavior: auto; }
  }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="bb2-wrap">
  <div class="bb2">
    <div class="bb2__inner">
      <ul class="bb2__grid" style="list-style:none; margin:0; padding:0;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            {%- assign bs = block.settings -%}
            <li class="bb2__item" {{ block.shopify_attributes }}>
              {%- if bs.icon_source != 'none' -%}
                <span class="bb2__icon" style="background:{{ bs.icon_box_bg | default: 'rgba(0,0,0,0)' }};color:{{ bs.icon_color | default: '#0F0F0F' }};">
                  {%- case bs.icon_source -%}
                    {%- when 'icon' -%}
                      {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
                    {%- when 'image' -%}
                      {%- if bs.image -%}<img src="{{ bs.image | image_url: width: 80 }}" alt="" loading="lazy">{%- endif -%}
                    {%- when 'svg' -%}
                      {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                  {%- endcase -%}
                </span>
              {%- endif -%}
              <div class="bb2__text">
                {%- if bs.title != blank -%}
                  <h3 class="bb2__title" style="color: {{ bs.title_color | default: '#0F0F0F' }} !important;">{{ bs.title | escape }}</h3>
                {%- endif -%}
                {%- if bs.description != blank -%}
                  <p class="bb2__desc" style="color: {{ bs.desc_color | default: '#555555' }} !important;">{{ bs.description | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{%- comment -%} Mobile carousel autoplay — only loaded when both carousel and autoplay are on. {%- endcomment -%}
{%- if st.enable_mobile_carousel and st.carousel_autoplay -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;
    var grid = root.querySelector('.bb2__grid');
    if (!grid) return;
    var mq = window.matchMedia('(max-width: 767px)');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var delay = {{ st.carousel_autoplay_speed | default: 4 | times: 1000 }};
    var timer = null, paused = false;
    function step() {
      var item = grid.querySelector('.bb2__item');
      if (!item) return grid.clientWidth;
      var gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
      return item.getBoundingClientRect().width + gap;
    }
    function tick() {
      if (paused || !mq.matches) return;
      var max = grid.scrollWidth - grid.clientWidth;
      if (grid.scrollLeft >= max - 2) {
        grid.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        grid.scrollBy({ left: step(), behavior: 'smooth' });
      }
    }
    function start() { stop(); if (mq.matches && !reduce.matches) { timer = setInterval(tick, delay); } }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function pause() { paused = true; stop(); }
    function resume() { paused = false; start(); }
    ['pointerdown', 'touchstart', 'mouseenter', 'focusin'].forEach(function (ev) { grid.addEventListener(ev, pause, { passive: true }); });
    ['touchend', 'mouseleave', 'focusout'].forEach(function (ev) { grid.addEventListener(ev, resume, { passive: true }); });
    document.addEventListener('visibilitychange', function () { if (document.hidden) { stop(); } else { start(); } });
    if (mq.addEventListener) { mq.addEventListener('change', start); } else if (mq.addListener) { mq.addListener(start); }
    start();
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

<schema>
{
  "type": "benefits-bar-2",
  "name": "Benefits Bar 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Item layout",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical (icon on top)"
        },
        {
          "value": "horizontal",
          "label": "Horizontal (icon left)"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "Columns (mobile)",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "paragraph",
      "id": "para_8",
      "label": "Mobile columns are ignored when the mobile carousel below is enabled.",
      "content": "Mobile columns are ignored when the mobile carousel below is enabled."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Mobile carousel"
    },
    {
      "type": "paragraph",
      "id": "para_10",
      "label": "Turns the benefits into a single-row, swipeable carousel on mobile only. Desktop layout is unaffected.",
      "content": "Turns the benefits into a single-row, swipeable carousel on mobile only. Desktop layout is unaffected."
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Enable carousel on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_items_per_view",
      "label": "Items per view (peek next)",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.2,
      "info": "1.2 shows one item plus a peek of the next, so it reads as swipeable."
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Borders & dividers"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Vertical dividers between columns (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider / border color"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Icon"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "label": "Icon box size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_box_radius",
      "label": "Icon box corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title letter spacing",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase title",
      "default": true
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Description size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Spacing — items"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between icon and text",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item vertical padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "item_pad_x",
      "label": "Item horizontal padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Spacing — grid gaps"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Row gap (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Row gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Spacing — section (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Section bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_45",
      "label": "Spacing — section (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_50",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "icon_source",
          "label": "Icon source",
          "default": "icon",
          "options": [
            {
              "value": "icon",
              "label": "Icon from library"
            },
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "svg",
              "label": "Custom SVG code"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
