<template compat="shopify">
{%- assign fb_accessibility_view_all = 'accessibility.view_all' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Products Listing section.
  A clean, simple grid of products that uses the theme's product card
  + product card settings (badges, swatches, price, add-to-cart, etc.).
  No carousel — just a responsive grid.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign section_width = s.section_width | default: 'container'
  assign color_scheme = s.color_scheme | default: 'scheme-1'
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign collection_obj = s.collection
  assign items_to_show = s.items_to_show | default: 8
  assign items_per_row = s.items_per_row | default: 4
  assign items_per_row_mobile = s.items_per_row_mobile | default: 2
  assign column_gap = s.column_gap | default: 24
  assign row_gap = s.row_gap | default: 30
  assign show_view_all = s.show_view_all
  assign view_all_label = s.view_all_label | default: fb_accessibility_view_all
  assign view_all_position = s.view_all_position | default: 'bottom'
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top }};
  --section-pb: {{ s.padding_bottom }};
  --pl-cols: {{ items_per_row }};
  --pl-cols-mb: {{ items_per_row_mobile }};
  --pl-col-gap: {{ column_gap }}px;
  --pl-row-gap: {{ row_gap }}px;
  --pl-heading-size: {{ s.heading_font_size | default: 32 }}px;
  --pl-heading-subtext-gap: {{ s.heading_subtext_gap | default: 8 }}px;
{%- endcapture -%}
{%- style -%}
  #shopify-section-{{ section.id }} .pl-grid {
    display: grid;
    grid-template-columns: repeat(var(--pl-cols-mb), minmax(0, 1fr));
    column-gap: var(--pl-col-gap);
    row-gap: var(--pl-row-gap);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pl-grid {
      grid-template-columns: repeat(var(--pl-cols), minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .pl-header {
    margin-bottom: 30px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pl-header { margin-bottom: 40px; }
  }
  #shopify-section-{{ section.id }} .pl-header__heading {
    font-size: var(--pl-heading-size);
    margin: 0 0 var(--pl-heading-subtext-gap);
  }
  #shopify-section-{{ section.id }} .pl-header__row {
    display: flex; flex-wrap: wrap; gap: 16px;
    align-items: end; justify-content: space-between;
  }
  #shopify-section-{{ section.id }} .pl-header__row--center {
    justify-content: center; text-align: center;
  }
  #shopify-section-{{ section.id }} .pl-viewall {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--color-heading);
    color: var(--color-background);
    transition: transform .15s ease, opacity .15s ease;
  }
  #shopify-section-{{ section.id }} .pl-viewall:hover { transform: translateX(2px); opacity: 0.9; }
  #shopify-section-{{ section.id }} .pl-viewall--bottom {
    margin: 30px auto 0;
    display: flex; width: max-content;
  }
{%- endstyle -%}

<div
  class="section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if s.heading != blank or s.subheading != blank or s.description != blank or show_view_all -%}
      <div class="pl-header text-{{ s.header_alignment | default: 'left' }}">
        <div class="pl-header__row {% if s.header_alignment == 'center' %}pl-header__row--center{% endif %}">
          <div>
            {%- if s.subheading != blank -%}
              <p class="m-0 mb-5 fs-custom subheading_weight">{{ s.subheading }}</p>
            {%- endif -%}
            {%- if s.heading != blank -%}
              <h2 class="pl-header__heading heading-letter-spacing">{{ s.heading }}</h2>
            {%- endif -%}
            {%- if s.description != blank -%}
              <div class="pl-header__description rich__text-m0">{{ s.description }}</div>
            {%- endif -%}
          </div>
          {%- if show_view_all and view_all_position == 'header' and s.header_alignment != 'center' -%}
            <a class="pl-viewall" href="{% if collection_obj != blank %}{{ collection_obj.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" aria-label="{{ view_all_label }}">
              {{ view_all_label }}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
      <div class="pl-grid">
        {%- for product in collection_obj.products limit: items_to_show -%}
          {% render 'product-item',
            card_product: product,
            section_id: section.id,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_action: s.show_action,
            template_enable_product_vendor: s.show_vendor,
            template_enable_rate: s.show_rating,
            template_enable_product_short_description: s.show_short_description,
            template_enable_color_swatches: s.show_swatches,
            template_enable_price: s.show_price,
            template_enable_add_cart: s.show_add_to_cart,
            scroll_animation: scroll_animation,
            indexFor: forloop.index,
            template_enable_product_badges: s.show_badges
          %}
        {%- endfor -%}
      </div>

      {%- if show_view_all and view_all_position == 'bottom' -%}
        <a class="pl-viewall pl-viewall--bottom" href="{{ collection_obj.url }}" aria-label="{{ view_all_label }}">
          {{ view_all_label }}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </a>
      {%- endif -%}
    {%- else -%}
      <div class="pl-grid">
        {%- for i in (1..items_to_show) -%}
          {% render 'product-item',
            card_product: blank,
            section_id: section.id,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_action: s.show_action,
            template_enable_product_vendor: s.show_vendor,
            template_enable_rate: s.show_rating,
            template_enable_product_short_description: s.show_short_description,
            template_enable_color_swatches: s.show_swatches,
            template_enable_price: s.show_price,
            template_enable_add_cart: s.show_add_to_cart,
            scroll_animation: scroll_animation,
            indexFor: i,
            template_enable_product_badges: s.show_badges
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>



</template>

<schema>
{
  "type": "products-listing",
  "name": "Products Listing",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges (sale, new, sold out)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show review stars",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_action",
      "label": "Show quick actions (wishlist / quickview)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Featured products"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Subtext"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "View all products"
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to cart button",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Style & Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Display & Grid"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Total products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Items per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "heading_subtext_gap",
      "label": "Gap between heading and subtext",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Vertical gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 49
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 49
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Items per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "id": "hdr_42",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "view_all_position",
      "label": "Link position",
      "default": "bottom",
      "options": [
        {
          "value": "header",
          "label": "In the header (right side)"
        },
        {
          "value": "bottom",
          "label": "Below the grid (centered)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products Listing",
      "category": "Products",
      "settings": {
        "heading": "Featured products",
        "items_to_show": 8,
        "items_per_row": 4
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "shopify": {
    "name": "Products Listing",
    "tag": "section",
    "class": "section-products-listing",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_badges",
        "label": "Show product badges (sale, new, sold out)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor name",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show review stars",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_short_description",
        "label": "Show short description",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_swatches",
        "label": "Show color swatches",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_price",
        "label": "Show price",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_action",
        "label": "Show quick actions (wishlist / quickview)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": "Show 'View all' link",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
