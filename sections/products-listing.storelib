<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_view_all = 'accessibility.view_all' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Materia Themes. Products Listing: a grid of the theme's own product cards
  (snippets/product-item), so Theme settings > Product cards (ratio, radius,
  badges, quick add, hover picture, wishlist) draw every card. The header is
  blocks (Eyebrow, Heading, Subheading, Button); a section saved before it
  had blocks keeps its own heading, eyebrow, text and View all link.
  live-products-b.js applies every style setting in the builder.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign section_width = s.section_width | default: 'container'
  assign collection_obj = s.collection
  assign items_to_show = s.items_to_show | default: 8
  assign items_per_row = s.items_per_row | default: 4
  assign items_per_row_mobile = s.items_per_row_mobile | default: 2
  assign column_gap = s.column_gap | default: 24
  assign scroll_animation = settings.scroll_animation
  if s.reveal == false
    assign scroll_animation = 'none'
  endif
  assign fallback_href = routes.all_products_collection_url | default: '/collections/all'
  if collection_obj != blank and collection_obj.url != blank
    assign fallback_href = collection_obj.url
  endif
  assign has_eyebrow = false
  assign has_heading = false
  assign has_sub = false
  assign has_button = false
  assign header_buttons = false
  for block in section.blocks
    case block.type
      when 'eyebrow'
        assign has_eyebrow = true
      when 'heading'
        assign has_heading = true
      when 'subheading'
        assign has_sub = true
      when 'button'
        assign has_button = true
        if block.settings.position == 'header' and block.settings.text != blank
          assign header_buttons = true
        endif
    endcase
  endfor
  assign legacy_view_all = false
  if has_button == false and s.show_view_all
    assign legacy_view_all = true
    if s.view_all_position == 'header' and s.header_alignment != 'center'
      assign header_buttons = true
    endif
  endif
  assign header_text = false
  for block in section.blocks
    if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading'
      if block.settings.text != blank
        assign header_text = true
      endif
    endif
  endfor
  if has_eyebrow == false and s.subheading != blank
    assign header_text = true
  endif
  if has_heading == false and s.heading != blank
    assign header_text = true
  endif
  if has_sub == false and s.description != blank
    assign header_text = true
  endif
-%}
{%- capture pb_json -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"items_to_show":{{ section.settings.items_to_show | default: 0 | json }},"subheading":{{ section.settings.subheading | append: '' | json }},"heading":{{ section.settings.heading | append: '' | json }},"description":{{ section.settings.description | append: '' | json }},"show_view_all":{% if section.settings.show_view_all %}true{% else %}false{% endif %},"view_all_label":{{ section.settings.view_all_label | append: '' | json }},"view_all_position":{{ section.settings.view_all_position | append: '' | json }},"heading_font_size":{{ section.settings.heading_font_size | default: 0 | json }},"show_badges":{% if section.settings.show_badges %}true{% else %}false{% endif %},"show_vendor":{% if section.settings.show_vendor %}true{% else %}false{% endif %},"show_rating":{% if section.settings.show_rating %}true{% else %}false{% endif %},"show_short_description":{% if section.settings.show_short_description %}true{% else %}false{% endif %},"show_swatches":{% if section.settings.show_swatches %}true{% else %}false{% endif %},"show_price":{% if section.settings.show_price %}true{% else %}false{% endif %},"show_add_to_cart":{% if section.settings.show_add_to_cart %}true{% else %}false{% endif %},"show_action":{% if section.settings.show_action %}true{% else %}false{% endif %},"header_alignment":{{ section.settings.header_alignment | append: '' | json }},"heading_subtext_gap":{{ section.settings.heading_subtext_gap | default: 0 | json }},"items_per_row":{{ section.settings.items_per_row | default: 0 | json }},"column_gap":{{ section.settings.column_gap | default: 0 | json }},"row_gap":{{ section.settings.row_gap | default: 0 | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"reveal":{% if section.settings.reveal %}true{% else %}false{% endif %},"padding_top":{{ section.settings.padding_top | default: 0 | json }},"padding_bottom":{{ section.settings.padding_bottom | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"items_per_row_mobile":{{ section.settings.items_per_row_mobile | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} {
    margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px !important;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ s.section_margin_top_desktop | default: 0 }}px !important;
      margin-bottom: {{ s.section_margin_bottom_desktop | default: 0 }}px !important;
    }
  }
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #shopify-section-{{ sid }} .pl {
    background: var(--pb-bg, var(--gradient-background, var(--color-background)));
    color: var(--color-text);
    font-family: var(--body-font);
  }
  #shopify-section-{{ sid }} .pl-grid {
    display: grid;
    grid-template-columns: repeat(var(--pl-cols-mb), minmax(0, 1fr));
    column-gap: var(--pl-col-gap);
    row-gap: var(--pl-row-gap);
  }
  #shopify-section-{{ sid }} .pl-grid > [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .pl-header { margin-bottom: 30px; }
  #shopify-section-{{ sid }} .pl-header[hidden] { display: none; }
  #shopify-section-{{ sid }} .pl-header__row {
    display: flex; flex-wrap: wrap; gap: 16px 24px;
    align-items: flex-end; justify-content: space-between;
  }
  #shopify-section-{{ sid }} .pl-header__text {
    display: flex; flex-direction: column; gap: var(--pl-hgap, 8px);
    min-width: 0; max-width: 720px;
  }
  #shopify-section-{{ sid }} .pl[data-align='center'] .pl-header__row { flex-direction: column; align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .pl[data-align='center'] .pl-header__text { align-items: center; }
  #shopify-section-{{ sid }} .pl[data-align='right'] .pl-header__row { flex-direction: row-reverse; text-align: right; }
  #shopify-section-{{ sid }} .pl[data-align='right'] .pl-header__text { align-items: flex-end; }
  #shopify-section-{{ sid }} .pl-header__actions:not(:has(> :not([hidden]))),
  #shopify-section-{{ sid }} .pl-bottom:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .pl-header__actions,
  #shopify-section-{{ sid }} .pl-bottom { display: flex; flex-wrap: wrap; gap: 12px; }
  #shopify-section-{{ sid }} .pl-bottom { justify-content: center; margin-top: 30px; }
  #shopify-section-{{ sid }} .pb-eyebrow { margin: 0; font-size: var(--pb-fs, 13px); color: var(--pb-c, var(--color-text)); text-transform: uppercase; letter-spacing: .12em; font-weight: var(--subheading-weight, 500); }
  #shopify-section-{{ sid }} .pb-heading { margin: 0; font-size: var(--pb-fs-m, 26px); color: var(--pb-c, var(--color-heading)); line-height: var(--heading-line-height, 1.2); }
  #shopify-section-{{ sid }} .pb-sub { margin: 0; font-size: var(--pb-fs, 16px); color: var(--pb-c, var(--color-text)); }
  #shopify-section-{{ sid }} .pb-sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .pb-sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} [hidden].pb-eyebrow,
  #shopify-section-{{ sid }} [hidden].pb-heading,
  #shopify-section-{{ sid }} [hidden].pb-sub,
  #shopify-section-{{ sid }} [hidden].pl-btn { display: none !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pl-grid { grid-template-columns: repeat(var(--pl-cols), minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .pl-header { margin-bottom: 40px; }
    #shopify-section-{{ sid }} .pb-heading { font-size: var(--pb-fs-d, 32px); }
  }
{% comment %}{% endcomment %}</style>
<div
  class="section pl{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}"
  data-pb-root="products-listing" data-pb-section="{{ sid }}" data-pb-settings="{{ pb_json | escape }}" data-pb-fallback-href="{{ fallback_href }}" data-pb-defaults='{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"items_to_show":8,"heading":"Featured products","show_view_all":true,"view_all_label":"View all products","view_all_position":"bottom","heading_font_size":32,"show_badges":true,"show_vendor":false,"show_rating":true,"show_short_description":false,"show_swatches":true,"show_price":true,"show_add_to_cart":true,"show_action":true,"header_alignment":"left","heading_subtext_gap":8,"items_per_row":4,"column_gap":24,"row_gap":30,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":true,"padding_top":49,"padding_bottom":49,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"items_per_row_mobile":2,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-pb-block-defaults='{"eyebrow":{"text":"Shop the collection","enable_custom_style":false,"size":13},"heading":{"text":"Featured products","enable_custom_style":false,"size_desktop":32,"size_mobile":26},"subheading":{"text":"&lt;p>Browse the pieces from this collection.&lt;/p>","enable_custom_style":false,"size":16},"button":{"text":"View all products","position":"bottom","button_style":"primary","enable_custom_style":false,"use_theme_button":true,"radius":8,"pad_x":26,"pad_y":14,"size":15,"border_width":1}}'
  data-align="{{ s.header_alignment | default: 'left' }}"
  style="--section-pt: {{ s.padding_top }};--section-pb: {{ s.padding_bottom }};--pl-cols: {{ items_per_row }};--pl-cols-mb: {{ items_per_row_mobile }};--pl-col-gap: {{ column_gap }}px;--pl-row-gap: {{ s.row_gap | default: 30 }}px;--pl-hgap: {{ s.heading_subtext_gap | default: 8 }}px;{% if s.enable_custom_style %}--pb-bg: {% render 'scheme-color', color: s.section_bg, fallback: 'var(--color-background)' %};{% endif %}{% if s.enable_custom_fonts and s.heading_font.family != blank %}--heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if s.enable_custom_fonts and s.body_font.family != blank %}--body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{% endif %}"
>
  <div class="pb-inner {{ section_width }}" data-pb-width>
    <div class="pl-header" data-pb-header{% unless header_text or header_buttons %} hidden{% endunless %}>
      <div class="pl-header__row">
        <div class="pl-header__text">
          {%- if has_eyebrow == false and s.subheading != blank -%}
            <p class="pb-eyebrow" data-pb-legacy>{{ s.subheading }}</p>
          {%- endif -%}
          {%- if has_heading == false and s.heading != blank -%}
            <h2 class="pb-heading heading-letter-spacing" data-pb-legacy style="--pb-fs-d: {{ s.heading_font_size | default: 32 }}px;--pb-fs-m: {{ s.heading_font_size | default: 32 }}px;">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if has_sub == false and s.description != blank -%}
            <div class="pb-sub rich__text-m0" data-pb-legacy>{{ s.description }}</div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading' -%}
              {%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'button' -%}{"text":{{ block.settings.text | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"button_style":{{ block.settings.button_style | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"pad_x":{{ block.settings.pad_x | default: 0 | json }},"pad_y":{{ block.settings.pad_y | default: 0 | json }},"size":{{ block.settings.size | default: 0 | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}
              {%- render 'products-b-text', block: block, json: pb_bjson -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="pl-header__actions" data-pb-slot="header">
          {%- for block in section.blocks -%}{%- if block.type == 'button' and block.settings.position == 'header' -%}{%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'button' -%}{"text":{{ block.settings.text | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"button_style":{{ block.settings.button_style | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"pad_x":{{ block.settings.pad_x | default: 0 | json }},"pad_y":{{ block.settings.pad_y | default: 0 | json }},"size":{{ block.settings.size | default: 0 | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}{%- render 'products-b-listing-button', block: block, json: pb_bjson, href: fallback_href, order: forloop.index -%}{%- endif -%}{%- endfor -%}
          {%- if legacy_view_all and s.view_all_position == 'header' and s.header_alignment != 'center' -%}
            <a class="pl-btn" data-theme-button="primary" data-sl-button data-pb-legacy href="{{ fallback_href }}">{{ s.view_all_label | default: fb_accessibility_view_all | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="pl-grid" data-pb-grid>
      {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
        {%- for product in collection_obj.products limit: items_to_show -%}
          {% render 'product-item',
            card_product: product,
            section_id: sid,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_action: s.show_action,
            template_enable_product_vendor: s.show_vendor,
            template_enable_rate: s.show_rating,
            template_enable_product_short_description: s.show_short_description,
            template_enable_color_swatches: s.show_swatches,
            template_enable_price: s.show_price,
            template_enable_add_cart: s.show_add_to_cart,
            scroll_animation: scroll_animation,
            indexFor: forloop.index,
            template_enable_product_badges: s.show_badges
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..items_to_show) -%}
          {% render 'product-item',
            card_product: blank,
            section_id: sid,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_action: s.show_action,
            template_enable_product_vendor: s.show_vendor,
            template_enable_rate: s.show_rating,
            template_enable_product_short_description: s.show_short_description,
            template_enable_color_swatches: s.show_swatches,
            template_enable_price: s.show_price,
            template_enable_add_cart: s.show_add_to_cart,
            scroll_animation: scroll_animation,
            indexFor: i,
            template_enable_product_badges: s.show_badges
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="pl-bottom" data-pb-slot="bottom">
      {%- for block in section.blocks -%}{%- if block.type == 'button' and block.settings.position != 'header' -%}{%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'button' -%}{"text":{{ block.settings.text | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"button_style":{{ block.settings.button_style | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"pad_x":{{ block.settings.pad_x | default: 0 | json }},"pad_y":{{ block.settings.pad_y | default: 0 | json }},"size":{{ block.settings.size | default: 0 | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}{%- render 'products-b-listing-button', block: block, json: pb_bjson, href: fallback_href, order: forloop.index -%}{%- endif -%}{%- endfor -%}
      {%- if legacy_view_all and s.view_all_position != 'header' or legacy_view_all and s.header_alignment == 'center' -%}
        <a class="pl-btn" data-theme-button="primary" data-sl-button data-pb-legacy href="{{ fallback_href }}">{{ s.view_all_label | default: fb_accessibility_view_all | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "products-listing",
  "name": "Products Listing",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
