            "label": "Border width",
            "min": 0,
            "max": 6,
            "step": 1,
            "unit": "px",
            "default": 1,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ]
  }
}
</schema>
