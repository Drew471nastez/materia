<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<div class="ti-section-wrap {{ section.settings.section_width | default: 'container' }}">
{% comment %}
  Section: Contact Form Pro (2-column)
  - Left: Title, description, contact details (block-based with icons)
  - Right: Native Shopify contact form (name, email, website [optional], message)
  - Gradient submit button
  - Fully responsive; tablet stacks nicely; mobile becomes single column
{% endcomment %}

<section id="contact-{{ section.id }}" class="contact-pro color-{{ color_scheme }} gradient">
  <style>
    #contact-{{ section.id }}{
      --cp-bg: {% render 'scheme-color', color: section.settings.bg_color, fallback: 'var(--color-background)' %};
      --cp-grad-a: {% render 'scheme-color', color: section.settings.bg_grad_a, fallback: 'var(--color-primary)' %};
      --cp-grad-b: {% render 'scheme-color', color: section.settings.bg_grad_b, fallback: 'var(--color-heading)' %};
      --cp-card: {% render 'scheme-color', color: section.settings.card_color, fallback: 'var(--color-background)' %};
      --cp-text: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %};
      --cp-muted: {% render 'scheme-color', color: section.settings.muted_color, fallback: 'color-mix(in srgb, var(--color-text) 72%, transparent)' %};
      --cp-input: {% render 'scheme-color', color: section.settings.input_bg, fallback: 'var(--color-background)' %};
      --cp-input-border: {% render 'scheme-color', color: section.settings.input_border, fallback: 'var(--color-border)' %};
      --cp-input-text: {% render 'scheme-color', color: section.settings.input_text, fallback: 'var(--color-text)' %};
      --cp-accent: {% render 'scheme-color', color: section.settings.accent_color, fallback: 'var(--color-primary)' %};
      --cp-icon-color: {% render 'scheme-color', color: section.settings.icon_color, fallback: 'var(--color-primary)' %} !important;
      --cp-button-bg: {% render 'scheme-color', color: section.settings.button_bg, fallback: 'var(--btn-primary-bg-color)' %};
      --cp-radius: {{ section.settings.radius }}px;
      --cp-pad-x: {{ section.settings.pad_x }}px;
      --cp-pad-top: {{ section.settings.pad_top }}px;
      --cp-pad-bottom: {{ section.settings.pad_bottom }}px;
      --cp-gap: {{ section.settings.col_gap }}px;
      --cp-desc-info-gap: {{ section.settings.desc_info_gap }}px;
      --cp-info-gap: {{ section.settings.info_gap }}px;
      --cp-field-gap: {{ section.settings.field_gap }}px;
      --cp-btn-gap: {{ section.settings.btn_gap }}px;
      --cp-icon-size: clamp({{ section.settings.icon_size_mobile }}px, 4vw, {{ section.settings.icon_size_desktop }}px);
      --cp-shadow: {% if section.settings.enable_shadow %}0 6px 24px rgba(0,0,0,.08){% else %}none{% endif %};
      --cp-maxw: {{ section.settings.max_width }}px;
      --cp-field-h: 46px;
      --cp-heading: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-heading)' %};
    }
    #contact-{{ section.id }} .cp-wrap{
      max-width: var(--cp-maxw);
      margin: 0 auto;
      padding: var(--cp-pad-top) var(--cp-pad-x) var(--cp-pad-bottom) var(--cp-pad-x);
      color: var(--cp-text);
    }
    #contact-{{ section.id }} .cp-grid{
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--cp-gap);
      align-items: start;
    }
    @media (max-width: 1024px){
      #contact-{{ section.id }} .cp-grid{ grid-template-columns: 1fr; }
    }

    /* Background */
    #contact-{{ section.id }}{
      background:
        {% if section.settings.enable_bg_gradient %}
          linear-gradient(135deg,var(--cp-grad-a),var(--cp-grad-b))
        {% else %}
          var(--cp-bg)
        {% endif %};
    }

    /* Left panel */
    #contact-{{ section.id }} .cp-left h2{
      margin: 0 0 .5rem;
      line-height: 1.15;
      color: var(--cp-heading);
    }
    #contact-{{ section.id }} .cp-desc{
      color: var(--cp-muted);
      max-width: 42ch;
      margin-bottom: var(--cp-desc-info-gap);
      line-height: 1.6;
    }
    #contact-{{ section.id }} .cp-list{
      display: grid;
      gap: var(--cp-info-gap);
    }
    #contact-{{ section.id }} .cp-item{
      display: grid;
      grid-template-columns: var(--cp-icon-size) 1fr;
      gap: .75rem;
      align-items: start;
      color: var(--cp-text);
    }
    #contact-{{ section.id }} .cp-icon{
      width: var(--cp-icon-size); height: var(--cp-icon-size);
      display: inline-grid; place-items: center;
      border-radius: 8px;
      background: color-mix(in srgb, var(--color-background) 60%, transparent);
      box-shadow: var(--cp-shadow);
      color: var(--cp-icon-color);
    }
    #contact-{{ section.id }} .cp-icon svg{
      width: 62%; height: 62%;
    }
    #contact-{{ section.id }} .cp-item p{
      margin: 0; line-height: 1.5;
      color: var(--cp-text);
      opacity: .9;
    }

    /* Right panel card + form */
    #contact-{{ section.id }} .cp-card{
      background: var(--cp-card);
      border-radius: var(--cp-radius);
      box-shadow: var(--cp-shadow);
      padding: 18px;
    }
    #contact-{{ section.id }} .cp-fields{
      display: grid;
      gap: var(--cp-field-gap);
    }
    #contact-{{ section.id }} .cp-input,
    #contact-{{ section.id }} .cp-textarea{
      width: 100%;
      background: var(--cp-input);
      border: var(--inputs-border-width, 1px) solid var(--cp-input-border);
      color: var(--cp-input-text);
      border-radius: var(--input-radius, var(--input-border-radius, 10px));
      padding: 0 12px;
      height: var(--cp-field-h);
      outline: none;
      transition: box-shadow .15s ease, border-color .15s ease, transform .02s ease;
    }
    #contact-{{ section.id }} .cp-textarea{
      padding: 10px 12px;
      min-height: 120px;
      height: 120px;
      resize: vertical;
    }
    #contact-{{ section.id }} .cp-input:focus,
    #contact-{{ section.id }} .cp-textarea:focus{
      border-color: var(--cp-accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--cp-accent) 25%, transparent);
    }

    /* Submit button with gradient */
    #contact-{{ section.id }} .cp-submit{
      margin-top: var(--cp-btn-gap);
      width: 100%;
      min-height: 46px;
      padding: var(--btn-padding-y, 0) var(--btn-padding-x, 1rem);
      border: var(--btn-border-width, 0px) solid {% if section.settings.button_bg != blank and section.settings.button_bg.alpha != 0 %}transparent{% else %}var(--btn-primary-border-color, transparent){% endif %};
      border-radius: var(--btn-radius, 12px);
      color: var(--btn-primary-color, #fff);
      font-weight: var(--btn-font-weight, 600);
      font-size: var(--btn-font-size, inherit);
      cursor: pointer;
      background: {% if section.settings.enable_button_gradient %}linear-gradient(135deg, var(--cp-grad-a), var(--cp-grad-b)){% else %}var(--cp-button-bg){% endif %};
      transition: transform .05s ease, filter .3s ease, opacity .3s ease;
    }
    #contact-{{ section.id }} .cp-submit:hover{ 
      filter: brightness(0.95); 
      opacity: 0.95; 
    }
    {%- unless section.settings.enable_button_gradient -%}{%- if section.settings.button_bg == blank or section.settings.button_bg.alpha == 0 -%}
    #contact-{{ section.id }} .cp-submit:hover{ background: var(--btn-primary-hover-bg-color, var(--cp-button-bg)); color: var(--btn-primary-hover-color, var(--btn-primary-color, #fff)); filter: none; opacity: 1; }
    {%- endif -%}{%- endunless -%}
    #contact-{{ section.id }} .cp-submit:focus-visible{ outline: 2px solid var(--cp-accent); outline-offset: 3px; }
    #contact-{{ section.id }} .cp-submit:active{ transform: translateY(1px); }

    /* Alerts */
    #contact-{{ section.id }} .cp-alert{
      margin-bottom: .8rem; padding: .6rem .8rem; border-radius: 10px; font-size: clamp(14px, 4vw, 15px);
    }
    #contact-{{ section.id }} .cp-alert--ok{ 
      background: #e8f8ef; 
      color: #0f6b3e; 
      border: 1px solid #bde8cf; 
      font-size: clamp(14px, 4vw, 17px);
    }
    #contact-{{ section.id }} .cp-alert--err{ background: #fdecec; color: #7a1f1f; border: 1px solid #f4caca; }

    /* Optional outer card around right panel */
    {% if section.settings.enable_right_card == false %}
      #contact-{{ section.id }} .cp-card{ background: transparent; box-shadow: none; padding: 0; }
    {% endif %}
{% comment %}{% endcomment %}  </style>

  <div class="cp-wrap">
    <div class="cp-grid">
      <!-- Left column -->
      <div class="cp-left">
        {% for block in section.blocks %}
          {% if block.type == 'heading' %}
            <h2 {{ block.shopify_attributes }} style="
              font-weight: {% if block.settings.font_weight == blank or block.settings.font_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.font_weight }}{% endif %};
              font-size: clamp({{ block.settings.font_size_mobile }}px, 3.2vw, {{ block.settings.font_size_desktop }}px);
            ">{{ block.settings.text }}</h2>
          {% elsif block.type == 'description' %}
            <div class="cp-desc" {{ block.shopify_attributes }} style="
              font-size: clamp({{ block.settings.font_size_mobile }}px, 4vw, {{ block.settings.font_size_desktop }}px);
            ">{{ block.settings.text }}</div>
          {% endif %}
        {% endfor %}
        <div class="cp-list">
          {% for block in section.blocks %}
            {% if block.type == 'info' %}
              <div class="cp-item" {{ block.shopify_attributes }}>
                <div class="cp-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'mail' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"/></svg>
                    {% when 'map' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/></svg>
                    {% when 'phone' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.23c1.2.48 2.6.75 4 .75a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C11.85 21 3 12.15 3 2a1 1 0 0 1 1-1h2.28a1 1 0 0 1 1 1c0 1.37.27 2.77.75 4a1 1 0 0 1-.23 1.1L6.6 10.8Z"/></svg>
                    {% when 'dot' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="7"/></svg>
                    {% when 'clock' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13h-1v6l5.25 3.15.75-1.23-4.5-2.67v-5.5h1v1z"/></svg>
                    {% when 'user' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    {% when 'globe' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18V4a8 8 0 1 1 0 16zM12 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm0 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm0 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
                    {% when 'calendar' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M19 3h-1V1H6v2H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                    {% when 'message' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M20 2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4l4 4 4-4h4a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
                    {% when 'briefcase' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M19 7V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2Zm0 12V9H5v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2Z"/></svg>
                    {% when 'home' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    {% when 'download' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M12 16l-6-6h4V4h2v6h4l-6 6zm-2-2V8l-4 4h8l-4-4zM4 20h16v2H4z"/></svg>
                    {% when 'heart' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    {% when 'star' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="7"/></svg>
                  {% endcase %}
                </div>
                <div>
                  {% if block.settings.line1 != blank %}
                    <p style="
                      font-size: clamp({{ block.settings.line1_size_mobile }}px, 3.5vw, {{ block.settings.line1_size_desktop }}px);
                    ">{{ block.settings.line1 }}</p>
                  {% endif %}
                  {% if block.settings.line2 != blank %}
                    <p style="
                      color:var(--cp-muted);
                      font-size: clamp({{ block.settings.line2_size_mobile }}px, 3.5vw, {{ block.settings.line2_size_desktop }}px);
                    ">{{ block.settings.line2 }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- Right column -->
      <div class="cp-right">
        <div class="cp-card">
          {%- assign cp_form_id = 'contact-form-' | append: section.id -%}
          {% form 'contact', id: cp_form_id %}
            {% if form.posted_successfully? %}
              <div class="cp-alert cp-alert--ok">{{ section.settings.success_text }}</div>
            {% endif %}

            {% if form.errors %}
              <div class="cp-alert cp-alert--err">
                {{ 'templates.contact.form.error_heading' | t }}
                <ul style="margin:.25rem 0 0 .9rem;">
                  {% for field in form.errors %}
                    <li>{{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="cp-fields" aria-live="polite">
              <label class="visually-hidden" for="ContactName-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
              <input class="cp-input" id="ContactName-{{ section.id }}" type="text" name="contact[name]" placeholder="{{ section.settings.ph_name }}" value="{{ form.contact.name | default: customer.name }}">

              <label class="visually-hidden" for="ContactEmail-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
              <input class="cp-input" id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ section.settings.ph_email }}" value="{{ form.contact.email | default: customer.email }}" required>

              {% if section.settings.show_website %}
                <label class="visually-hidden" for="ContactWebsite-{{ section.id }}">{{ 'accessibility.website' | t }}</label>
                <input class="cp-input" id="ContactWebsite-{{ section.id }}" type="url" name="contact[website]" placeholder="{{ section.settings.ph_website }}">
              {% endif %}

              <label class="visually-hidden" for="ContactMessage-{{ section.id }}">{{ 'templates.contact.form.message' | t }}</label>
              <textarea class="cp-textarea" id="ContactMessage-{{ section.id }}" name="contact[body]" placeholder="{{ section.settings.ph_message }}"></textarea>

              <button type="submit" class="cp-submit" data-sl-button data-button-role="primary">
                {{ section.settings.btn_text }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Small helpers */
    #contact-{{ section.id }} .visually-hidden{
      position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }
{% comment %}{% endcomment %}  </style>
</section>

</div>
<!-- ti-theme:end -->


