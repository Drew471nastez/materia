<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- render 'contact-live-width', sid: section.id -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Contact Form Simple 2 (two columns).
  Left: the heading, description and contact info blocks, in their order.
  Right: the store's contact form (the theme's contact form tag): name, email,
  website (optional) and message, each with a label. The section follows the
  colour scheme, Theme settings > Typography, Buttons and Forms and fields;
  Enable custom styling, Enable custom fonts, Match theme button and Match
  theme fields switch the section's own values on. live-contact.js applies
  live edits without a redraw.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign cp_custom = st.enable_custom_style
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign cp_own_shape = false
  if st.use_theme_button == false
    assign cp_own_shape = true
  endif
  assign cp_own_field = false
  if st.use_theme_fields == false
    assign cp_own_field = true
  endif
  assign cp_btn_set = false
  if cp_custom and st.button_bg != blank and st.button_bg.alpha != 0
    assign cp_btn_set = true
  endif
-%}
{%- capture cp_vars -%}
  {%- if cp_custom -%}
    --cp-bg: {% render 'scheme-color', color: st.bg_color, fallback: 'var(--color-background)' %};
    --cp-grad-a: {% render 'scheme-color', color: st.bg_grad_a, fallback: 'var(--color-primary)' %};
    --cp-grad-b: {% render 'scheme-color', color: st.bg_grad_b, fallback: 'var(--color-heading)' %};
    --cp-card: {% render 'scheme-color', color: st.card_color, fallback: 'var(--color-background)' %};
    --cp-text: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
    --cp-heading: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-heading)' %};
    --cp-muted: {% render 'scheme-color', color: st.muted_color, fallback: 'color-mix(in srgb, var(--color-text) 72%, transparent)' %};
    --cp-accent: {% render 'scheme-color', color: st.accent_color, fallback: 'var(--color-primary)' %};
    --cp-icon-color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-primary)' %};
    --cp-surface: {% if st.enable_bg_gradient %}linear-gradient(135deg, var(--cp-grad-a), var(--cp-grad-b)){% else %}var(--cp-bg){% endif %};
  {%- endif -%}
  --cp-radius: {{ st.radius }}px;
  --cp-pad-x: {{ st.pad_x }}px;
  --cp-pad-top: {{ st.pad_top }}px;
  --cp-pad-bottom: {{ st.pad_bottom }}px;
  --cp-gap: {{ st.col_gap }}px;
  --cp-desc-info-gap: {{ st.desc_info_gap }}px;
  --cp-info-gap: {{ st.info_gap }}px;
  --cp-field-gap: {{ st.field_gap }}px;
  --cp-btn-gap: {{ st.btn_gap }}px;
  --cp-icon-min: {{ st.icon_size_mobile }}px;
  --cp-icon-max: {{ st.icon_size_desktop }}px;
  --cp-shadow: {% if st.enable_shadow %}0 6px 24px rgba(0,0,0,.08){% else %}none{% endif %};
  --cp-maxw: {{ st.max_width }}px;
  {%- if sec_font and st.heading_font.family != blank %} --ct-hf: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
  {%- if sec_font and st.body_font.family != blank %} --ct-bf: {{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
{%- capture cp_field_vars -%}
  {%- if cp_own_field -%}
    {%- if st.input_bg != blank and st.input_bg.alpha != 0 -%}--input-bg:{% render 'scheme-color', color: st.input_bg, fallback: 'var(--color-background)' %};{%- endif -%}
    {%- if st.input_text != blank and st.input_text.alpha != 0 -%}--field-text:{% render 'scheme-color', color: st.input_text, fallback: 'var(--color-text)' %};--field-placeholder:{% render 'scheme-color', color: st.input_text, fallback: 'var(--color-text)' %};{%- endif -%}
    {%- if st.input_border != blank and st.input_border.alpha != 0 -%}--input-border-color:{% render 'scheme-color', color: st.input_border, fallback: 'var(--color-border)' %};{%- endif -%}
    --input-border-radius:{{ st.field_radius | default: 10 }}px;--input-height:{{ st.field_height | default: 46 }}px;
  {%- endif -%}
{%- endcapture -%}
{%- capture cp_button_vars -%}
  {%- if cp_custom -%}
    {%- if st.enable_button_gradient -%}--mb-bg:linear-gradient(135deg, var(--cp-grad-a), var(--cp-grad-b));--mb-hover-bg:linear-gradient(135deg, var(--cp-grad-a), var(--cp-grad-b));--mb-border:transparent;--mb-hover-border:transparent;
    {%- elsif cp_btn_set -%}--mb-bg:{{ st.button_bg }};--mb-hover-bg:{{ st.button_bg }};--mb-border:{{ st.button_bg }};--mb-hover-border:{{ st.button_bg }};
    {%- endif -%}
    {%- if st.button_text != blank and st.button_text.alpha != 0 -%}--mb-text:{{ st.button_text }};--mb-hover-text:{{ st.button_text }};{%- endif -%}
  {%- endif -%}
  {%- if cp_own_shape -%}--mb-radius:{{ st.button_radius | default: 12 }}px;--mb-font-size:{{ st.button_size | default: 16 }}px;--mb-padding-y:{{ st.button_pad_y | default: 12 }}px;{%- endif -%}
  {%- if sec_font and st.body_font.family != blank -%}--mb-font:var(--ct-bf);{%- endif -%}
{%- endcapture -%}
{%- if sec_font -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
<div class="ti-section-wrap {{ section.settings.section_width | default: 'container' }}" data-ct-root="contactformsimple2" data-ct-section="{{ section.id }}"{% if request.design_mode %} data-ct-settings="{{ section.settings | json | escape }}"{% endif %} data-ct-w="{{ section.settings.section_width | default: 'container' }}" data-ct-width>
<section id="contact-{{ section.id }}" class="contact-pro color-{{ color_scheme }} gradient" data-ct-scheme style="{{ cp_vars | strip_newlines }}"{% if cp_btn_set or st.enable_button_gradient and cp_custom %} data-cp-own-button{% endif %}{% unless st.enable_right_card %} data-cp-flat{% endunless %}>
  <style>
    #contact-{{ section.id }}{
      --cp-icon-size: clamp(var(--cp-icon-min), 4vw, var(--cp-icon-max));
      --cp-field-h: 46px;
      background: var(--cp-surface, var(--cp-bg, var(--color-background)));
    }
    #contact-{{ section.id }} .cp-wrap{
      max-width: var(--cp-maxw);
      margin: 0 auto;
      padding: var(--cp-pad-top) var(--cp-pad-x) var(--cp-pad-bottom) var(--cp-pad-x);
      color: var(--cp-text, var(--color-text));
    }
    #contact-{{ section.id }} .cp-grid{
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--cp-gap);
      align-items: start;
    }
    @media (max-width: 1024px){
      #contact-{{ section.id }} .cp-grid{ grid-template-columns: 1fr; }
    }

    /* Left panel */
    #contact-{{ section.id }} .cp-left h2{
      margin: 0 0 .5rem;
      line-height: 1.15;
      color: var(--cp-h-c, var(--cp-heading, var(--color-heading)));
      font-size: clamp(var(--cp-h-m), 3.2vw, var(--cp-h-d));
    }
    #contact-{{ section.id }} .cp-left h2[data-own-weight]{ font-weight: var(--cp-h-fw); }
    #contact-{{ section.id }} .cp-left h2[data-own-font]{ font-family: var(--cp-ff, var(--ct-hf, var(--heading-font))); }
    #contact-{{ section.id }} .cp-desc{
      color: var(--cp-d-c, var(--cp-muted, color-mix(in srgb, var(--color-text) 72%, transparent)));
      max-width: 42ch;
      margin-bottom: var(--cp-desc-info-gap);
      line-height: 1.6;
      font-size: clamp(var(--cp-d-m), 4vw, var(--cp-d-d));
    }
    #contact-{{ section.id }} [data-own-font]:not(h2){ font-family: var(--cp-ff, var(--ct-bf, var(--body-font))); }
    #contact-{{ section.id }} [data-cp-fields][data-own-font]{ --body-font: var(--ct-bf); }
    #contact-{{ section.id }} [data-ct-block][hidden]{ display: none !important; }
    #contact-{{ section.id }} .cp-list{
      display: grid;
      gap: var(--cp-info-gap);
    }
    #contact-{{ section.id }} .cp-item{
      display: grid;
      grid-template-columns: var(--cp-icon-size) 1fr;
      gap: .75rem;
      align-items: start;
      color: var(--cp-text, var(--color-text));
    }
    #contact-{{ section.id }} .cp-icon{
      width: var(--cp-icon-size); height: var(--cp-icon-size);
      display: inline-grid; place-items: center;
      border-radius: 8px;
      background: color-mix(in srgb, var(--color-background) 60%, transparent);
      box-shadow: var(--cp-shadow);
      color: var(--cp-i-c, var(--cp-icon-color, var(--color-primary)));
    }
    #contact-{{ section.id }} .cp-icon svg{
      width: 62%; height: 62%;
    }
    #contact-{{ section.id }} .cp-item p{
      margin: 0; line-height: 1.5;
      color: var(--cp-text, var(--color-text));
      opacity: .9;
    }
    #contact-{{ section.id }} .cp-item .cp-line1{ color: var(--cp-l1-c, var(--cp-text, var(--color-text))); font-size: clamp(var(--cp-l1-m), 3.5vw, var(--cp-l1-d)); }
    #contact-{{ section.id }} .cp-item .cp-line2{ color: var(--cp-l2-c, var(--cp-muted, color-mix(in srgb, var(--color-text) 72%, transparent))); font-size: clamp(var(--cp-l2-m), 3.5vw, var(--cp-l2-d)); }
    #contact-{{ section.id }} .cp-item [hidden]{ display: none; }

    /* Right panel card + form */
    #contact-{{ section.id }} .cp-card{
      background: var(--cp-card, var(--color-background));
      border-radius: var(--cp-radius);
      box-shadow: var(--cp-shadow);
      padding: 18px;
    }
    #contact-{{ section.id }}[data-cp-flat] .cp-card{ background: transparent; box-shadow: none; padding: 0; }
    #contact-{{ section.id }} .cp-fields{
      display: grid;
      gap: var(--cp-field-gap);
    }
    #contact-{{ section.id }} .cp-label{ font-size: 14px; color: var(--cp-text, var(--color-text)); margin: 0 0 calc(6px - var(--cp-field-gap)); }
    #contact-{{ section.id }} .cp-input,
    #contact-{{ section.id }} .cp-textarea{
      width: 100%;
      outline: none;
      transition: box-shadow .15s ease, border-color .15s ease;
    }
    #contact-{{ section.id }} .cp-textarea{
      min-height: 120px;
      height: 120px;
      resize: vertical;
    }
    #contact-{{ section.id }} .cp-input:focus,
    #contact-{{ section.id }} .cp-textarea:focus{
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--cp-accent, var(--color-primary)) 25%, transparent);
    }

    /* Submit button: the theme button, or this section's colours and shape */
    #contact-{{ section.id }} .cp-submit{
      margin-top: var(--cp-btn-gap);
      width: 100%;
      min-height: 46px;
      cursor: pointer;
    }
    #contact-{{ section.id }}[data-cp-own-button] .cp-submit:hover{ filter: brightness(0.95); opacity: 0.95; }
    #contact-{{ section.id }} .cp-submit:focus-visible{ outline: 2px solid var(--cp-accent, var(--color-primary)); outline-offset: 3px; }
    #contact-{{ section.id }} .cp-submit:active{ transform: translateY(1px); }
    @media (prefers-reduced-motion: reduce){
      #contact-{{ section.id }} .cp-input, #contact-{{ section.id }} .cp-textarea{ transition: none; }
      #contact-{{ section.id }} .cp-submit:active{ transform: none; }
    }

    /* Alerts */
    #contact-{{ section.id }} .cp-alert{
      margin-bottom: .8rem; padding: .6rem .8rem; border-radius: 10px; font-size: clamp(14px, 4vw, 15px);
    }
    #contact-{{ section.id }} .cp-alert--ok{
      background: #e8f8ef;
      color: #0f6b3e;
      border: 1px solid #bde8cf;
      font-size: clamp(14px, 4vw, 17px);
    }
    #contact-{{ section.id }} .cp-alert--err{ background: #fdecec; color: #7a1f1f; border: 1px solid #f4caca; }
    #contact-{{ section.id }} .visually-hidden{
      position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }
{% comment %}{% endcomment %}  </style>

  <div class="cp-wrap">
    <div class="cp-grid">
      <!-- Left column -->
      <div class="cp-left">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- if block.type == 'heading' or block.type == 'description' -%}
            {%- assign b_font = false -%}
            {%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign b_font = true -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
          {%- endif -%}
          {%- if block.type == 'heading' -%}
            {%- capture b_vars -%}
              --cp-h-m: {{ bs.font_size_mobile }}px; --cp-h-d: {{ bs.font_size_desktop }}px;
              {%- if bs.font_weight != blank and bs.font_weight != 'theme' %} --cp-h-fw: {{ bs.font_weight }};{%- endif -%}
              {%- if bs.enable_custom_style %} --cp-h-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--cp-heading, var(--color-heading))' %};{%- endif -%}
              {%- if b_font %} --cp-ff: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
            {%- endcapture -%}
            <h2 id="block-{{ block.id }}" data-ct-block="{{ block.id }}" data-ct-type="heading"{% if request.design_mode %} data-ct-settings="{{ bs | json | escape }}"{% endif %}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.font_weight != blank and bs.font_weight != 'theme' %} data-own-weight{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
          {%- elsif block.type == 'description' -%}
            {%- capture b_vars -%}
              --cp-d-m: {{ bs.font_size_mobile }}px; --cp-d-d: {{ bs.font_size_desktop }}px;
              {%- if bs.enable_custom_style %} --cp-d-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--cp-muted, var(--color-text))' %};{%- endif -%}
              {%- if b_font %} --cp-ff: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
            {%- endcapture -%}
            <div class="cp-desc" id="block-{{ block.id }}" data-ct-block="{{ block.id }}" data-ct-type="description"{% if request.design_mode %} data-ct-settings="{{ bs | json | escape }}"{% endif %}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
          {%- endif -%}
        {%- endfor -%}
        <div class="cp-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'info' -%}
              {%- assign bs = block.settings -%}
              {%- assign b_font = false -%}
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign b_font = true -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
              {%- capture b_vars -%}
                --cp-l1-m: {{ bs.line1_size_mobile }}px; --cp-l1-d: {{ bs.line1_size_desktop }}px; --cp-l2-m: {{ bs.line2_size_mobile }}px; --cp-l2-d: {{ bs.line2_size_desktop }}px;
                {%- if bs.enable_custom_style %} --cp-i-c: {% render 'scheme-color', color: bs.icon_color, fallback: 'var(--cp-icon-color, var(--color-primary))' %}; --cp-l1-c: {% render 'scheme-color', color: bs.line1_color, fallback: 'var(--cp-text, var(--color-text))' %}; --cp-l2-c: {% render 'scheme-color', color: bs.line2_color, fallback: 'var(--cp-muted, var(--color-text))' %};{%- endif -%}
                {%- if b_font %} --cp-ff: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
              {%- endcapture -%}
              <div class="cp-item" id="block-{{ block.id }}" data-ct-block="{{ block.id }}" data-ct-type="info"{% if request.design_mode %} data-ct-settings="{{ bs | json | escape }}"{% endif %}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.line1 == blank and bs.line2 == blank %} hidden{% endif %} style="{{ b_vars | strip_newlines }}" {{ block.shopify_attributes }}>
                <div class="cp-icon" aria-hidden="true" data-cp-icon>{% render 'contact-live-icons', set: 'cfs2', name: bs.icon %}</div>
                <div>
                  <p class="cp-line1"{% if bs.line1 == blank %} hidden{% endif %}>{{ bs.line1 }}</p>
                  <p class="cp-line2"{% if bs.line2 == blank %} hidden{% endif %}>{{ bs.line2 }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Right column -->
      <div class="cp-right">
        <div class="cp-card">
          {%- assign cp_form_id = 'contact-form-' | append: section.id -%}
          {% form 'contact', id: cp_form_id %}
            {% if form.posted_successfully? %}
              <div class="cp-alert cp-alert--ok" role="status">{{ st.success_text }}</div>
            {% endif %}

            {% if form.errors %}
              <div class="cp-alert cp-alert--err" role="alert">
                {{ st.error_text | default: 'Please check the following:' }}
                <ul style="margin:.25rem 0 0 .9rem;">
                  {% for field in form.errors %}
                    <li>{{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="cp-fields" aria-live="polite" data-cp-fields style="{{ cp_field_vars | strip | strip_newlines }}"{% if sec_font %} data-own-font{% endif %}>
              <label class="cp-label{% unless st.show_labels %} visually-hidden{% endunless %}" for="ContactName-{{ section.id }}" data-cp-label="name">{{ st.label_name | default: 'Name' }}</label>
              <input class="cp-input" id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" placeholder="{{ st.ph_name }}" value="{{ form.contact.name | default: customer.name }}">

              <label class="cp-label{% unless st.show_labels %} visually-hidden{% endunless %}" for="ContactEmail-{{ section.id }}" data-cp-label="email">{{ st.label_email | default: 'Email' }}</label>
              <input class="cp-input" id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ st.ph_email }}" value="{{ form.contact.email | default: customer.email }}" required>

              <label class="cp-label{% unless st.show_labels %} visually-hidden{% endunless %}" for="ContactWebsite-{{ section.id }}" data-cp-label="website"{% unless st.show_website %} hidden{% endunless %}>{{ st.label_website | default: 'Website' }}</label>
              <input class="cp-input" id="ContactWebsite-{{ section.id }}" type="url" name="contact[website]" autocomplete="url" placeholder="{{ st.ph_website }}"{% unless st.show_website %} hidden disabled{% endunless %}>

              <label class="cp-label{% unless st.show_labels %} visually-hidden{% endunless %}" for="ContactMessage-{{ section.id }}" data-cp-label="message">{{ st.label_message | default: 'Message' }}</label>
              <textarea class="cp-textarea" id="ContactMessage-{{ section.id }}" name="contact[body]" placeholder="{{ st.ph_message }}"></textarea>

              <button type="submit" class="cp-submit" data-theme-button="primary" data-sl-button data-button-role="primary"{% if cp_own_shape %} data-own-shape{% endif %}{% if sec_font %} data-own-font{% endif %} style="{{ cp_button_vars | strip | strip_newlines }}">
                {{- st.btn_text -}}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
  {%- render 'contact-live-icons', set: 'cfs2', all: true -%}
</section>

</div>
<!-- ti-theme:end -->


</template>

