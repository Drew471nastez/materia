          "unit": "px",
          "default": 100
        },
        {
          "type": "range",
          "id": "pill_padding_x",
          "label": "Pill horizontal padding",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "pill_padding_y",
          "label": "Pill vertical padding",
          "min": 0,
          "max": 24,
