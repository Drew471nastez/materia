      {
        "type": "review_and_sold",
        "name": "Reviews & sold counter",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "review_label",
            "label": "Review label",
            "default": "reviews"
          },
          {
            "type": "select",
            "id": "review_source",
            "label": "Review source",
            "default": "product",
            "options": [
              {
                "value": "product",
                "label": "Product data"
              },
              {
                "value": "manual",
                "label": "Verified manual values"
              }
            ],
            "info": "Product data changes per product. Manual values are shared by this template unless bound to a dynamic source."
          },
          {
            "type": "number",
            "id": "manual_review_count",
            "label": "Verified review count",
            "default": 0,
            "visible_if": "{{ block.settings.review_source == 'manual' }}"
          },
          {
            "type": "range",
            "id": "manual_review_rating",
            "label": "Verified rating",
            "min": 0,
            "max": 5,
            "step": 0.1,
            "default": 0,
            "visible_if": "{{ block.settings.review_source == 'manual' }}"
          },
          {
            "type": "select",
            "id": "sold_source",
            "label": "Sold count source",
            "default": "product",
            "options": [
              {
                "value": "product",
                "label": "Product field"
              },
              {
                "value": "manual",
                "label": "Verified manual count"
              }
            ],
            "info": "Product field reads custom.sold_count for each product. Manual accepts one verified count, not a random values pool."
          },
          {
            "type": "text",
            "id": "sold_label",
            "label": "Sold label",
            "default": "sold"
          },
          {
            "type": "checkbox",
            "id": "show_review",
            "default": true,
            "label": "Show reviews"
          },
          {
            "type": "checkbox",
            "id": "show_sold_products",
            "default": true,
            "label": "Show sold counter"
          },
          {
            "type": "checkbox",
            "id": "show_live_dot",
            "label": "Show status dot",
            "default": true
          },
          {
            "type": "textarea",
            "id": "sold",
            "label": "Verified sold count",
            "default": "",
            "info": "Used only in Verified manual count mode. Enter one whole number.",
            "visible_if": "{{ block.settings.sold_source == 'manual' }}"
          },
          {
            "type": "textarea",
            "id": "hours",
            "label": "Verified period (hours)",
            "default": "",
            "info": "Optional. One exact verified period, not a random values pool.",
            "visible_if": "{{ block.settings.sold_source == 'manual' }}"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "range",
            "id": "padding_top",
