          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "item1_subtitle",
          "label": "Subtitle",
          "default": "Expected delivery between 2–3 days"
        },
        {
          "type": "checkbox",
          "id": "item1_use_image",
          "label": "Enable Image (instead of SVG)",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "item1_image",
          "label": "Image",
          "visible_if": "{{ block.settings.item1_use_image }}"
        },
