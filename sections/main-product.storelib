              "label": "Minimal"
            },
            {
              "value": "compact",
              "label": "Compact rows"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_images",
          "label": "Show pictures",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_compare",
          "label": "Show compare at prices",
          "default": true
        },
        {
          "type": "color",
          "id": "accent_color",
          "visible_if": "{{ block.settings.custom_style }}",
