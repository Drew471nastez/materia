      {
        "type": "modern_collapsible_row",
        "name": "Modern Collapsible Row",
        "limit": 10,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Modern Collapsible Heading",
            "default": "Materials"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Modern Collapsible Content"
          },
          {
            "type": "header",
            "content": "Icons"
          },
          {
            "type": "checkbox",
            "id": "enable_left_icon",
            "label": "Enable icon on the left",
            "default": false
          },
          {
            "type": "text",
            "id": "icon_svg_custom",
            "label": "Paste inline SVG (overrides preset when filled)"
          },
          {
            "type": "color",
            "id": "icon_color",
            "label": "Icon color",
            "default": "#222222"
          },
          {
            "type": "range",
            "id": "icon_gap",
            "label": "Gap between icon and text",
            "min": 0,
            "max": 32,
            "step": 1,
            "default": 10,
            "unit": "px"
          },
          {
            "type": "select",
            "id": "icon_preset",
            "label": "Icon preset",
            "default": "materials",
            "options": [
              {
                "value": "materials",
                "label": "Materials"
              },
              {
                "value": "shipping",
                "label": "Shipping"
              },
              {
                "value": "returns",
                "label": "Returns"
              },
              {
                "value": "heart",
                "label": "Heart / Care"
              },
              {
                "value": "dimensions",
                "label": "Dimensions / Size"
              },
              {
                "value": "warranty",
                "label": "Warranty / Shield"
              },
              {
                "value": "care",
                "label": "Care / Sparkle"
              },
              {
                "value": "info",
                "label": "Info"
              },
              {
                "value": "package",
                "label": "Package / Box"
              }
            ]
          },
          {
            "type": "range",
            "id": "icon_size",
            "label": "Icon size",
            "min": 12,
            "max": 64,
            "step": 1,
            "default": 20,
            "unit": "px"
          },
          {
            "type": "header",
            "content": "Options"
          },
          {
            "type": "checkbox",
            "id": "use_product_description",
            "label": "Use product description",
            "default": false,
            "info": "Content shows when empty"
          }
        ]
      },
      {
        "type": "size_table",
        "name": "Size chart",
        "limit": 3,
        "settings": [
          {
            "type": "checkbox",
            "id": "use_storelib_chart",
            "label": "Use assigned Storelib size chart",
            "default": true,
            "info": "The chart assigned to each product is used first. Manual table data below is a fallback."
          },
          {
            "type": "header",
            "content": "How it works"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Size Guide"
          },
          {
            "type": "textarea",
            "id": "table_data",
            "label": "Table data",
            "info": "Optional fallback: first line is the header. Separate cells with |. Never enter guessed measurements."
          },
          {
            "type": "header",
            "content": "Per-product data (optional)"
          },
          {
            "type": "checkbox",
            "id": "use_metafield",
            "label": "Use the product's custom field",
            "default": false
          },
          {
            "type": "text",
            "id": "metafield_namespace",
            "label": "Custom field namespace",
            "default": "custom",
            "visible_if": "{{ block.settings.use_metafield }}"
          },
          {
            "type": "text",
            "id": "metafield_key",
            "label": "Custom field key",
            "default": "size_table",
            "visible_if": "{{ block.settings.use_metafield }}"
          },
          {
            "type": "header",
            "content": "Collapsible"
          },
          {
            "type": "checkbox",
            "id": "collapsible",
            "label": "Collapsible",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "start_open",
            "label": "Open by default",
            "default": false
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Header background",
            "default": "#E5E7EB"
          },
          {
            "type": "color",
            "id": "header_text_color",
            "label": "Header text",
            "default": "#111827"
          },
          {
            "type": "color",
            "id": "body_text_color",
            "label": "Body text",
            "default": "#374151"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title color",
            "default": "#111111"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "default": "#E5E7EB"
          },
          {
            "type": "checkbox",
            "id": "zebra",
            "label": "Striped rows",
            "default": true
          },
          {
            "type": "color",
            "id": "zebra_color",
            "label": "Stripe color",
            "default": "#F9FAFB"
          },
          {
            "type": "range",
            "id": "title_size",
            "label": "Title size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "cell_size",
            "label": "Cell text size",
            "min": 11,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 14
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 10
          },
          {
            "type": "range",
            "id": "space_above",
            "label": "Space above",
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 8
          },
          {
            "type": "range",
            "id": "space_below",
            "label": "Space below",
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 8
          }
        ]
      }
    ]
  }
