          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 16
        },
        {
          "type": "header",
          "id": "hdr_13",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Buy it together"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "A short line above the box, such as Bundle & save."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Optional, on the box's top edge, such as Best value."
        },
