<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The section's markup is in snippets/main-product-body so
  this file stays well under Storelib's 1 MB limit with its schema.
{%- endcomment -%}
{%- render 'main-product-body', section: section, product: product -%}
</template>

<schema>
{
  "type": "main-product",
  "name": "Product information",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid"
        },
        {
          "value": "stretch_width",
          "label": "Stretch"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_width_mobile",
      "label": "Section width (mobile)",
      "default": "stretch_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid"
        },
        {
          "value": "stretch_width",
          "label": "Stretch"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "No gap between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Display"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content_on_desktop",
      "default": true,
      "label": "Enable sticky content on desktop"
    },
    {
      "type": "checkbox",
      "id": "media_square",
      "label": "Square images",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_nav_dots_mobile",
      "label": "Dots on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Custom side padding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": true,
      "label": "Enable video looping"
    },
    {
      "type": "checkbox",
      "id": "enable_video_autoplay",
      "default": true,
      "label": "Enable video autoplay",
      "info": "Videos are muted automatically to allow autoplay"
    },
    {
      "type": "checkbox",
      "id": "enable_video_controls",
      "label": "Show video controls",
      "default": true,
      "info": "Play, timeline, sound and full screen on each product video."
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Sticky Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "enable_on_desktop",
      "default": true,
      "label": "Enable on desktop"
    },
    {
      "type": "checkbox",
      "id": "enable_on_mobile",
      "default": true,
      "label": "Enable on mobile"
    },
    {
      "type": "checkbox",
      "id": "sticky_show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_variant_picker",
      "label": "Show variant picker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_quantity",
      "label": "Show quantity",
      "default": true
    },
    {
      "type": "range",
      "id": "sticky_padding_y",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "sticky_button_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Button radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "sticky_bar_bg",
      "label": "Bar background"
    },
    {
      "type": "color",
      "id": "sticky_border_color",
      "label": "Top border"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Image / Media"
    },
    {
      "type": "range",
      "id": "desktop_media_width",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "Desktop media width",
      "default": 40
    },
    {
      "type": "select",
      "id": "image_zoom",
      "options": [
        {
          "value": "no_zoom",
          "label": "No zoom"
        },
        {
          "value": "open_lightbox",
          "label": "Open lightbox"
        },
        {
          "value": "inner_zoom_circle",
          "label": "Inner zoom circle"
        },
        {
          "value": "inner_zoom_square",
          "label": "Inner zoom square"
        },
        {
          "value": "external_zoom",
          "label": "External zoom"
        }
      ],
      "default": "no_zoom",
      "label": "Image zoom"
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Layout & Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_media_gap",
      "label": "Override theme media gap",
      "info": "When off, follow Theme settings > Layout and spacing.",
      "default": false
    },
    {
      "type": "range",
      "id": "content_gap_desktop",
      "label": "Media gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.enable_custom_media_gap }}"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Left padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Right padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "options": [
        {
          "value": "thumbnail_left",
          "label": "Thumbnail left"
        },
        {
          "value": "thumbnail_bottom",
          "label": "Thumbnail bottom"
        },
        {
          "value": "hidden_thumbnail",
          "label": "Hidden thumbnail"
        },
        {
          "value": "grid_1_column",
          "label": "Grid 1 column"
        },
        {
          "value": "grid_2_column",
          "label": "Grid 2 column"
        },
        {
          "value": "stack",
          "label": "Stack"
        }
      ],
      "default": "thumbnail_bottom",
      "label": "Desktop layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_slides_per_view",
      "label": "Images per row (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 (full image)"
        },
        {
          "value": "1.1",
          "label": "1.1 (subtle peek)"
        },
        {
          "value": "1.2",
          "label": "1.2 (peek next)"
        },
        {
          "value": "1.3",
          "label": "1.3"
        },
        {
          "value": "1.5",
          "label": "1.5 (half peek)"
        },
        {
          "value": "1.8",
          "label": "1.8"
        },
        {
          "value": "2",
          "label": "2 (two per row)"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "mobile_options",
      "options": [
        {
          "value": "show_thumbnails",
          "label": "Show thumbnails"
        },
        {
          "value": "hidden_thumbnail",
          "label": "Hidden thumbnails"
        }
      ],
      "default": "show_thumbnails",
      "label": "Mobile options",
      "info": "Ony work when you choose Thumbnail left or Thumbnail bottom in Desktop layout settings"
    }
  ],
  "blocks": [
    {
      "type": "delivery_pills",
      "name": "Delivery & warranty pills",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Layout"
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "label": "Columns (desktop)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2
        },
        {
          "type": "select",
          "id": "columns_mobile",
          "label": "Columns (mobile)",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            }
          ]
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Gap between pills",
          "min": 4,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "select",
          "id": "align",
          "label": "Content alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ]
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Top margin",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Bottom margin",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Pill style"
        },
        {
          "type": "color",
          "id": "pill_bg",
          "label": "Pill background",
          "default": "#EEF4FB"
        },
        {
          "type": "range",
          "id": "pill_radius",
          "label": "Corner radius",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "pill_padding_y",
          "label": "Vertical padding",
          "min": 4,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "pill_padding_x",
          "label": "Horizontal padding",
          "min": 4,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "pill_border_width",
          "label": "Border width",
          "min": 0,
          "max": 4,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "pill_border_color",
          "label": "Border color"
        },
        {
          "type": "header",
          "id": "hdr_15",
          "label": "Icon & text"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 14,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 22
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#1B1B1B"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Title color",
          "default": "#1B1B1B"
        },
        {
          "type": "range",
          "id": "subtitle_size",
          "label": "Subtitle size",
          "min": 10,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle color",
          "default": "#5B6470"
        },
        {
          "type": "header",
          "id": "hdr_22",
          "label": "Pill 1"
        },
        {
          "type": "checkbox",
          "id": "pill_1_enable",
          "label": "Show pill 1",
          "default": true
        },
        {
