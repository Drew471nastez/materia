    {
      "type": "quantity_offer",
      "name": "Quantity offer",
      "settings": [
        {
          "type": "paragraph",
          "id": "para_1",
          "label": "Lets the buyer choose how many to add, such as Buy 1, Buy 2 get 1 free, Buy 3 get 2 free. The chosen tier sets the quantity added and prices come from the product. Storelib checkout does not take a qu",
          "content": "Lets the buyer choose how many to add, such as Buy 1, Buy 2 get 1 free, Buy 3 get 2 free. The chosen tier sets the quantity added and prices come from the product. Storelib checkout does not take a quantity saving or free items off by itself yet: create a discount code per tier in Storelib, enter it below, and keep the saving shown the same. Without a code every item is charged at its price."
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Style"
