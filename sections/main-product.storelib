          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "font_size_desktop",
            "label": "Font size (desktop)",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 14
          },
          {
