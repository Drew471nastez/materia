              }
            ]
          },
          {
            "type": "range",
            "id": "heading_margin_bottom",
            "label": "Space below heading",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 12
          },
          {
            "type": "range",
            "id": "cols_desktop",
            "label": "Columns (desktop)",
            "min": 2,
            "max": 6,
            "step": 1,
            "default": 4
          },
          {
            "type": "range",
            "id": "gap_x",
            "label": "Horizontal gap",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 12
          },
          {
            "type": "range",
            "id": "gap_y",
            "label": "Vertical gap (when wrapping)",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 12
          },
          {
            "type": "range",
            "id": "padding_top",
            "label": "Top padding",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 12
          },
