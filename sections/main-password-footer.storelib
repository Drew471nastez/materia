<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The password page's footer (layout/password, shown when the page is not the
  Coming soon section): the store's social links, a line of text and the
  owner's sign in link.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} .password__footer { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding-inline: 20px; }
  #shopify-section-{{ sid }} .list-social { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .list-social__link { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: var(--ap-h-c, var(--color-heading)); }
  #shopify-section-{{ sid }} .list-social__link svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .password__footer-text { margin: 0; max-width: 720px; font-size: var(--ap-tfs-d, 13px); }
  #shopify-section-{{ sid }} .password__footer-text a { text-decoration: underline; text-underline-offset: 4px; }
{% comment %}{% endcomment %}</style>
<div
  class="ap password__footer color-{{ scheme }} gradient"
  data-ap-root="main-password-footer"
  data-ap-section="{{ sid }}"
  data-ap-settings="{{ st | json | escape }}"
  {% if st.show_footer == false %}hidden{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-tfs-d: {{ st.text_size | default: 13 }}px; --ap-tfs-m: {{ st.text_size | default: 13 }}px; --ap-align: center;{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  <ul class="list-social list-unstyled" role="list">
    {%- if settings.social_twitter_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_twitter_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-twitter' -%}
          <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_facebook_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_facebook_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-facebook' -%}
          <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_pinterest_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_pinterest_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-pinterest' -%}
          <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_instagram_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_instagram_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-instagram' -%}
          <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_tiktok_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_tiktok_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-tiktok' -%}
          <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_tumblr_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_tumblr_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-tumblr' -%}
          <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_snapchat_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_snapchat_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-snapchat' -%}
          <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_youtube_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_youtube_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-youtube' -%}
          <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
        </a>
      </li>
    {% endif %}
    {%- if settings.social_vimeo_link != blank -%}
      <li class="list-social__item">
        <a href="{{ settings.social_vimeo_link }}" class="link list-social__link" target="_blank" rel="noopener">
          {%- render 'icon-vimeo' -%}
          <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
        </a>
      </li>
    {% endif %}
  </ul>
  <div class="ap__t password__footer-text" data-ap-rich="footer_text" data-ap-opt{% if st.footer_text == blank %} hidden{% endif %}>{{ st.footer_text }}</div>
  <a class="ap__link password__footer-text" href="{{ st.owner_login_url | default: 'https://storelib.com' | url }}" target="_blank" rel="noopener" data-ap-text="owner_login_label" data-ap-href="owner_login_url"{% unless st.show_owner_login %} hidden{% endunless %}>{{ st.owner_login_label | escape }}</a>
</div>
</template>

<schema>
{
  "type": "main-password-footer",
  "name": "Main password footer",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Other"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show password footer",
      "info": "Toggle off to hide the entire password page footer (store caption + owner login link).",
      "default": true
    }
  ],
  "shopify": {
    "name": "Password footer",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "show_footer",
        "label": "Show footer",
        "info": "Toggle off to hide the entire password page footer (store caption + owner login link).",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "richtext",
        "id": "footer_text",
        "label": "Text",
        "info": "Social links come from Theme settings > Social media."
      },
      {
        "type": "checkbox",
        "id": "show_owner_login",
        "label": "Show owner sign in link",
        "default": true
      },
      {
        "type": "text",
        "id": "owner_login_label",
        "label": "Owner link label",
        "default": "Website owner? Log in",
        "visible_if": "{{ section.settings.show_owner_login }}"
      },
      {
        "type": "url",
        "id": "owner_login_url",
        "label": "Owner link",
        "default": "https://storelib.com",
        "visible_if": "{{ section.settings.show_owner_login }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Icon and link color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Text size",
        "min": 10,
        "max": 20,
        "step": 1,
        "default": 13,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 28,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 28,
        "unit": "px"
      }
    ]
  }
}
</schema>
