<template compat="shopify">
<script src="{{ 'live-r7-text.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Sticky Heading Text: two columns from 990px up. The heading
  side (eyebrow, heading, subheading and button blocks) stays in view under
  the sticky header while the longer list of Text blocks scrolls past on the
  other side. It is plain CSS: position: sticky, with its top at --sticky-top
  (the bottom edge of what is pinned now, written on <html> by
  snippets/header-sticky-controller) plus the section's own space. Below
  990px it is one column and nothing is pinned.

  Theme first: colours from the colour scheme, fonts and weights from Theme
  settings > Typography, the button from Theme settings > Buttons. Custom
  colours and fonts only while their switch is on. Every value is a CSS
  variable on the root, printed here for the first paint and written again by
  live-r7-text.js on a live edit (the same names and fallbacks). Shared
  styles: snippets/r7-text-base. Header blocks: snippets/r7-text-header.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign heading_width = st.heading_width | default: 40
  assign list_width = 100 | minus: heading_width
  assign item_count = 0
  for block in section.blocks
    if block.type == 'text'
      assign item_count = item_count | plus: 1
    endif
  endfor
  case st.section_width
    when 'container'
      assign r7_max = 'calc(var(--page-width, 1300px) + 48px)'
      assign r7_pad = '24px'
    when 'stretch_width'
      assign r7_max = 'none'
      assign r7_pad = '30px'
    when 'full_width'
      assign r7_max = 'none'
      assign r7_pad = 'max(24px, 4vw)'
    else
      assign r7_max = 'calc(var(--fluid-container-width, 1500px) + 48px)'
      assign r7_pad = '24px'
  endcase
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.enable_custom_fonts -%}
<style>
  {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- render 'r7-text-base', section: section, p: 'sht' -%}
<style>
  #shopify-section-{{ section.id }} .sht__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 40px;
  }
  /* One size up from the theme's section heading, moving with the screen the way the theme's own headings do. */
  #shopify-section-{{ section.id }} .sht .sht__heading { --size: clamp(3.2rem, calc(3.2rem + 12 * var(--responsive-rate, 0px)), 4.4rem); }
  #shopify-section-{{ section.id }} .sht__list { min-width: 0; counter-reset: sht-n; }
  #shopify-section-{{ section.id }} .sht__item {
    counter-increment: sht-n;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 20px;
    align-items: baseline;
  }
  #shopify-section-{{ section.id }} .sht__item + .sht__item { margin-top: calc(var(--sht-item-gap) * 0.75); }
  #shopify-section-{{ section.id }} .sht[data-dividers="true"] .sht__item + .sht__item {
    padding-top: calc(var(--sht-item-gap) * 0.75);
    border-top: 1px solid var(--sht-divider);
  }
  /* The number sits above its text on a phone and beside it from 768px. */
  #shopify-section-{{ section.id }} .sht[data-numbers="true"] .sht__item { row-gap: 6px; }
  #shopify-section-{{ section.id }} .sht__num {
    display: none;
    font-size: 14px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    font-weight: var(--subheading-weight, 500);
    color: var(--sht-num-ink);
  }
  #shopify-section-{{ section.id }} .sht[data-numbers="true"] .sht__num { display: block; }
  #shopify-section-{{ section.id }} .sht__num::before { content: counter(sht-n, decimal-leading-zero); }
  #shopify-section-{{ section.id }} .sht__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .sht .sht__title {
    margin: 0;
    max-width: 100%;
    font-family: var(--r7t-heading-font);
    font-size: var(--sht-title-m);
    color: var(--sht-title-ink);
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .sht[data-numbers="true"] .sht__item { grid-template-columns: 2.4em minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .sht .sht__title { font-size: var(--sht-title-d); }
    #shopify-section-{{ section.id }} .sht__item + .sht__item { margin-top: var(--sht-item-gap); }
    #shopify-section-{{ section.id }} .sht[data-dividers="true"] .sht__item + .sht__item { padding-top: var(--sht-item-gap); }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .sht__inner {
      grid-template-columns: var(--sht-cols);
      column-gap: var(--sht-col-gap);
      align-items: start;
    }
    #shopify-section-{{ section.id }} .sht[data-side="right"] .sht__header { order: 2; }
  }
  /* Pinned only where there is room for it: two columns, and a screen tall enough to hold the heading side. */
  @media (min-width: 990px) and (min-height: 560px) {
    #shopify-section-{{ section.id }} .sht[data-sticky="true"] .sht__header {
      position: sticky;
      top: calc(var(--sticky-top, 0px) + var(--sht-offset));
      transition: top 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
  }
{% comment %}{% endcomment %}</style>
{%- capture r7_bg -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
{%- capture sht_num -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.number_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}{%- endcapture -%}
{%- capture sht_title -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.item_heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}{%- endcapture -%}
{%- capture r7_text -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.text_color, fallback: 'unset' %}{% else %}unset{% endif %}{%- endcapture -%}
{%- assign r7_text = r7_text | strip -%}
{%- capture r7_link -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.link_color, fallback: 'var(--color-link, var(--color-heading))' %}{% else %}var(--color-link, var(--color-heading)){% endif %}{%- endcapture -%}
{%- capture sht_divider -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}{%- endcapture -%}
{%- capture r7_heading_font -%}{% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %}{%- endcapture -%}
{%- capture r7_body_font -%}{% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %}{%- endcapture -%}
<div
  class="sht color-{{ color_scheme }} gradient"
  data-r7t="sticky-heading-text"
  data-r7t-section="{{ section.id }}"
  {% if request.design_mode %} data-r7t-settings="{{ st | json | escape }}"{% endif %}
  data-side="{{ st.heading_position | default: 'left' }}"
  data-sticky="{% if st.sticky %}true{% else %}false{% endif %}"
  data-dividers="{% if st.show_dividers %}true{% else %}false{% endif %}"
  data-numbers="{% if st.show_numbers %}true{% else %}false{% endif %}"
  {% if st.enable_custom_fonts %}data-own-font{% endif %}
  {% unless st.reveal %}data-ti-no-reveal{% endunless %}
  style="--r7t-bg: {{ r7_bg | strip }}; {% if r7_text != 'unset' %}--r7t-text-ink: {{ r7_text }}; {% endif %}--r7t-link-ink: {{ r7_link | strip }}; --sht-num-ink: {{ sht_num | strip }}; --sht-title-ink: {{ sht_title | strip }}; --sht-divider: {{ sht_divider | strip }}; --r7t-heading-font: {{ r7_heading_font | strip }}; --r7t-body-font: {{ r7_body_font | strip }}; --r7t-max: {{ r7_max }}; --r7t-pad-wide: {{ r7_pad }}; --sht-cols: {% if st.heading_position == 'right' %}minmax(0, {{ list_width }}fr) minmax(0, {{ heading_width }}fr){% else %}minmax(0, {{ heading_width }}fr) minmax(0, {{ list_width }}fr){% endif %}; --sht-col-gap: {{ st.column_gap | default: 80 }}px; --sht-offset: {{ st.sticky_offset | default: 32 }}px; --sht-item-gap: {{ st.item_gap | default: 32 }}px; --sht-title-d: {{ st.item_heading_size | default: 24 }}px; --sht-title-m: {{ st.item_heading_size_mobile | default: 20 }}px; --r7t-pt-d: {{ st.padding_top }}px; --r7t-pb-d: {{ st.padding_bottom }}px; --r7t-pt-m: {{ st.padding_top_mobile }}px; --r7t-pb-m: {{ st.padding_bottom_mobile }}px;"
>
  <div class="sht__inner">
    {%- render 'r7-text-header', section: section, p: 'sht' -%}
    {%- if item_count > 0 -%}
      <div class="sht__list" data-r7t-list>
        {%- for block in section.blocks -%}
          {%- if block.type != 'text' -%}{%- continue -%}{%- endif -%}
          {%- assign bs = block.settings -%}
          <div class="sht__item" data-r7t-block="{{ block.id }}" data-r7t-type="text"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="sht__num" aria-hidden="true"></span>
            <div class="sht__body">
              <h3 class="sht__title" data-r7t-title{% if bs.heading == blank %} hidden{% endif %}>{{ bs.heading }}</h3>
              <div class="sht__text" data-r7t-text{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>
              <a class="sht__link" data-r7t-link{% if bs.link != blank %} href="{{ bs.link }}"{% endif %}{% if bs.link_label == blank %} hidden{% endif %}>{{ bs.link_label | escape }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "shopify": {
    "name": "Sticky Heading Text",
    "tag": "section",
    "class": "section-sticky-heading-text",
    "max_blocks": 16,
    "settings": [
      { "type": "header", "content": "General" },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
      {
        "type": "select",
        "id": "section_width",
        "label": "Width",
        "default": "fluid_container",
        "options": [
          { "value": "container", "label": "Default" },
          { "value": "fluid_container", "label": "Fluid container" },
          { "value": "stretch_width", "label": "Stretched" },
          { "value": "full_width", "label": "Full width" }
        ]
      },
      { "type": "checkbox", "id": "reset_spacing", "label": "Remove space between sections", "default": true, "info": "Turn off to set top and bottom margins under Desktop spacing and Mobile." },
      { "type": "header", "content": "Layout" },
      {
        "type": "select",
        "id": "heading_position",
        "label": "Heading side (desktop)",
        "default": "left",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      { "type": "range", "id": "heading_width", "label": "Heading side width (desktop)", "min": 30, "max": 50, "step": 5, "unit": "%", "default": 40 },
      { "type": "range", "id": "column_gap", "label": "Gap between sides (desktop)", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 80 },
      { "type": "checkbox", "id": "sticky", "label": "Keep the heading in view (desktop)", "default": true, "info": "The heading side stays under the header while the texts scroll past. On tablets and phones the section is one column." },
      { "type": "range", "id": "sticky_offset", "label": "Space above pinned heading", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32, "visible_if": "{{ section.settings.sticky }}" },
      { "type": "range", "id": "item_gap", "label": "Space between texts", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 32 },
      { "type": "checkbox", "id": "show_dividers", "label": "Lines between texts", "default": true },
      { "type": "checkbox", "id": "show_numbers", "label": "Number the texts", "default": true },
      { "type": "header", "content": "Appearance" },
      { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false, "info": "Off: colours follow the colour scheme." },
      { "type": "color", "id": "section_bg", "label": "Background", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "number_color", "label": "Numbers", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "item_heading_color", "label": "Text heading", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "text_color", "label": "Text", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "link_color", "label": "Link", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "divider_color", "label": "Lines", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "header", "content": "Typography" },
      { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom fonts", "default": false, "info": "Off: fonts follow Theme settings > Typography." },
      { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },
      { "type": "font_picker", "id": "body_font", "label": "Text font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },
      { "type": "range", "id": "item_heading_size", "label": "Text heading size (desktop)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
      { "type": "header", "content": "Animation" },
      { "type": "checkbox", "id": "reveal", "label": "Reveal on scroll", "default": true },
      { "type": "header", "content": "Desktop spacing" },
      { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
      { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
      { "type": "range", "id": "section_margin_top_desktop", "label": "Top margin (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_desktop", "label": "Bottom margin (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "header", "content": "Mobile" },
      { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },
      { "type": "range", "id": "item_heading_size_mobile", "label": "Text heading size (mobile)", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 20 },
      { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "section_margin_top_mobile", "label": "Top margin (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_mobile", "label": "Bottom margin (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          { "type": "text", "id": "text", "label": "Text", "default": "About us" },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Color", "visible_if": "{{ block.settings.enable_custom_style }}" }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          { "type": "inline_richtext", "id": "text", "label": "Heading", "default": "How we work" },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Color", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Typography" },
          { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom font", "default": false },
          { "type": "font_picker", "id": "font", "label": "Font", "default": "assistant_n4", "visible_if": "{{ block.settings.enable_custom_fonts }}" },
          { "type": "checkbox", "id": "weight_enable", "label": "Custom font weight", "default": false },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              { "value": "300", "label": "Light" },
              { "value": "400", "label": "Regular" },
              { "value": "500", "label": "Medium" },
              { "value": "600", "label": "Semibold" },
              { "value": "700", "label": "Bold" },
              { "value": "800", "label": "Extra bold" }
            ]
          },
          { "type": "checkbox", "id": "size_enable", "label": "Custom size", "default": false, "info": "Off: one step above the theme's heading size." },
          { "type": "range", "id": "size_desktop", "label": "Size (desktop)", "min": 18, "max": 80, "step": 1, "unit": "px", "default": 44, "visible_if": "{{ block.settings.size_enable }}" },
          { "type": "range", "id": "size_mobile", "label": "Size (mobile)", "min": 16, "max": 60, "step": 1, "unit": "px", "default": 32, "visible_if": "{{ block.settings.size_enable }}" },
          { "type": "range", "id": "line_height", "label": "Line height", "min": 0.8, "max": 2, "step": 0.05, "default": 1.15, "visible_if": "{{ block.settings.size_enable }}" },
          { "type": "range", "id": "tracking", "label": "Letter spacing", "min": -2, "max": 10, "step": 0.5, "unit": "px", "default": 0, "visible_if": "{{ block.settings.size_enable }}" }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Keep this side short. The longer story scrolls past on the other side.</p>" },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Color", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Typography" },
          { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom font", "default": false },
          { "type": "font_picker", "id": "font", "label": "Font", "default": "assistant_n4", "visible_if": "{{ block.settings.enable_custom_fonts }}" },
          { "type": "checkbox", "id": "weight_enable", "label": "Custom font weight", "default": false },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              { "value": "300", "label": "Light" },
              { "value": "400", "label": "Regular" },
              { "value": "500", "label": "Medium" },
              { "value": "600", "label": "Semibold" },
              { "value": "700", "label": "Bold" }
            ]
          },
          { "type": "checkbox", "id": "size_enable", "label": "Custom size", "default": false, "info": "Off: the theme's text size." },
          { "type": "range", "id": "size", "label": "Size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 18, "visible_if": "{{ block.settings.size_enable }}" },
          { "type": "range", "id": "line_height", "label": "Line height", "min": 1, "max": 2.2, "step": 0.05, "default": 1.5, "visible_if": "{{ block.settings.size_enable }}" }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          { "type": "text", "id": "label", "label": "Label", "default": "Shop all products" },
          { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" },
          {
            "type": "select",
            "id": "style",
            "label": "Style",
            "default": "primary",
            "options": [
              { "value": "primary", "label": "Primary" },
              { "value": "secondary", "label": "Secondary" }
            ]
          },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false, "info": "Off: colours follow Theme settings > Buttons." },
          { "type": "color", "id": "bg_color", "label": "Background", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "color", "id": "text_color", "label": "Text", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "color", "id": "border_color", "label": "Border", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "color", "id": "bg_color_hover", "label": "Background on hover", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "color", "id": "text_color_hover", "label": "Text on hover", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Shape" },
          { "type": "checkbox", "id": "use_theme_button", "label": "Match theme button", "default": true },
          { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 6, "visible_if": "{{ block.settings.use_theme_button == false }}" },
          { "type": "range", "id": "size", "label": "Text size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ block.settings.use_theme_button == false }}" },
          { "type": "range", "id": "pad_x", "label": "Side padding", "min": 8, "max": 60, "step": 1, "unit": "px", "default": 28, "visible_if": "{{ block.settings.use_theme_button == false }}" },
          { "type": "range", "id": "pad_y", "label": "Top and bottom padding", "min": 6, "max": 28, "step": 1, "unit": "px", "default": 14, "visible_if": "{{ block.settings.use_theme_button == false }}" }
        ]
      },
      {
        "type": "text",
        "name": "Text",
        "settings": [
          { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Text heading" },
          { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a paragraph or two. Texts added here scroll past the heading on desktop.</p>" },
          { "type": "text", "id": "link_label", "label": "Link label" },
          { "type": "url", "id": "link", "label": "Link" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Sticky Heading Text",
        "category": "Text",
        "blocks": [
          { "type": "eyebrow" },
          { "type": "heading" },
          { "type": "subheading" },
          { "type": "button" },
          { "type": "text", "settings": { "heading": "What we make", "text": "<p>Describe your products in a few plain sentences: what they are, who they are for and what sets them apart.</p>" } },
          { "type": "text", "settings": { "heading": "How it is made", "text": "<p>Write about the materials, the people who make your products and the steps between an idea and a finished piece.</p>" } },
          { "type": "text", "settings": { "heading": "How we send it", "text": "<p>Say where orders ship from, how they are packed and how long they take to arrive.</p>" } },
          { "type": "text", "settings": { "heading": "After you buy", "text": "<p>Explain returns and repairs, and how a customer reaches you when something is not right.</p>" } }
        ]
      }
    ]
  }
}
