<template compat="shopify">
<script src="{{ 'live-testimonials.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign sid = section.id
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
  assign custom = section.settings.enable_custom_style
  assign hfont = section.settings.heading_custom
  assign tfont = section.settings.text_custom
  assign words = section.settings.card_count_words | default: 20
  assign view = section.settings.slider_view | default: 3
  assign view_t = view | times: 0.5 | round | at_least: 1
  assign shape = false
  if section.settings.use_theme_button == false
    assign shape = true
  endif
  assign cards = section.blocks | where: 'type', 'testimonials'
-%}
{%- comment -%}
  Materia Themes. Testimonials 4.

  A heading, an overall rating line (text, score, profile circles), a short
  text with an optional picture, a row of review cards (stars filled to the
  exact count, heading, review with a Read more button on small screens,
  author and date) and an optional theme button. The row is a native
  scroller with arrows, dots, swipe and keys (assets/live-testimonials.js,
  which also applies live edits). Colours follow the colour scheme until
  custom styling is on; fonts follow Theme settings > Typography until a
  custom heading or text font is on. Mobile spacing is three quarters of
  the desktop spacing.
  The builder shows 120 settings, so the rating text and card headings use
  the heading font, and the reviews, author lines and button the text font.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if section.settings.reset_spacing -%}
<style>
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{% render 'live-testimonials-style', sid: sid %}
<style>
  {%- if hfont -%}{{ section.settings.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if tfont -%}{{ section.settings.text_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .t4 { box-sizing: border-box; overflow: hidden; background-color: var(--t4-bg); background-image: var(--t4-bg-img); border-block: var(--t4-border-w) solid var(--t4-border); margin-block: calc(var(--t4-mt) * .75) calc(var(--t4-mb) * .75); color: var(--t4-text); }
  #shopify-section-{{ sid }} .t4 *, #shopify-section-{{ sid }} .t4 *::before, #shopify-section-{{ sid }} .t4 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .t4__inner { margin: 0 auto; max-width: var(--t4-max); padding: calc(var(--t4-pt) * .75) var(--t4-px-m) calc(var(--t4-pb) * .75); text-align: var(--t4-align); }
  #shopify-section-{{ sid }} .t4__heading { margin: 0; color: var(--t4-heading-c); font-family: var(--t4-hf); font-weight: var(--t4-hw); font-size: var(--t4-h-m); line-height: var(--t4-h-lh); text-align: var(--t4-align); }
  #shopify-section-{{ sid }} .t4__rating { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--t4-justify); gap: 5px; margin-top: calc(var(--t4-rating-mt) * .75); }
  #shopify-section-{{ sid }} .t4__rating[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4__rating-text, #shopify-section-{{ sid }} .t4__score { margin: 0; color: var(--t4-rating-c); font-family: var(--t4-hf); font-size: var(--t4-r-m); line-height: var(--t4-h-lh); }
  #shopify-section-{{ sid }} .t4__score b { font-size: 1.25em; }
  #shopify-section-{{ sid }} .t4__profiles { display: flex; align-items: center; gap: var(--t4-prof-gap); padding-inline-start: 5px; }
  #shopify-section-{{ sid }} .t4__profiles[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4__profile { flex-shrink: 0; width: var(--t4-prof-m); height: var(--t4-prof-m); overflow: hidden; border-radius: 50%; border: 2px solid var(--t4-card-bg); background: color-mix(in srgb, var(--color-text) 12%, var(--color-background)); }
  #shopify-section-{{ sid }} .t4__profile + .t4__profile { margin-inline-start: calc(var(--t4-overlap) * -1); }
  #shopify-section-{{ sid }} .t4__profile img, #shopify-section-{{ sid }} .t4__profile svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .t4__text { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--t4-justify); gap: 10px; margin-top: calc(var(--t4-text-mt) * .75); }
  #shopify-section-{{ sid }} .t4__text[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4__copy, #shopify-section-{{ sid }} .t4__copy * { margin: 0; color: var(--t4-text); font-family: var(--t4-tf); font-size: var(--t4-t-m); line-height: var(--t4-t-lh); }
  #shopify-section-{{ sid }} .t4__copy strong { text-decoration: underline; }
  #shopify-section-{{ sid }} .t4__text-img { width: 100px; height: 32px; }
  #shopify-section-{{ sid }} .t4__text-img img { display: block; width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .t4__slider { position: relative; width: 100%; max-width: 100%; margin: calc(var(--t4-slider-mt) * .75) auto 0; }
  #shopify-section-{{ sid }} .t4__track { display: flex; gap: var(--t4-gap); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; touch-action: pan-x pan-y; cursor: grab; padding: 20px 12px; margin: -20px -12px; scroll-padding-inline: 12px; }
  #shopify-section-{{ sid }} .t4__track.is-dragging { cursor: grabbing; }
  #shopify-section-{{ sid }} .t4__card { display: flex; flex: 0 0 calc((100% - var(--t4-gap) * (var(--t4-pv-m) - 1)) / var(--t4-pv-m)); flex-direction: column; justify-content: space-between; gap: calc(var(--t4-card-mt) * .75); min-width: 0; scroll-snap-align: center; padding: calc(var(--t4-cpy) * .75) calc(var(--t4-cpx) * .6); border-radius: var(--t4-card-r); border: var(--t4-card-bw) solid var(--t4-card-border); background-color: var(--t4-card-bg); box-shadow: var(--t4-shadow); text-align: var(--t4-card-align); }
  #shopify-section-{{ sid }} .t4__card-top { display: flex; flex-direction: column; align-items: stretch; width: 100%; }
  #shopify-section-{{ sid }} .t4__card .lt-stars, #shopify-section-{{ sid }} .t4__stars { display: flex; justify-content: var(--t4-card-justify); gap: var(--lt-star-gap); }
  #shopify-section-{{ sid }} .t4__card .lt-stars[hidden], #shopify-section-{{ sid }} .t4__stars[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4 .lt-star { --lt-star-size: var(--t4-star-m); background: linear-gradient(90deg, var(--lt-star-on) var(--lt-fill), var(--lt-star-off) var(--lt-fill)); }
  #shopify-section-{{ sid }} .t4 .lt-star::before { content: none; }
  #shopify-section-{{ sid }} .t4 .lt-star svg { width: 68.75%; height: 68.75%; margin: 15.625%; fill: var(--t4-star-glyph); }
  #shopify-section-{{ sid }} .t4__stars img { width: var(--t4-star-m); height: var(--t4-star-m); object-fit: contain; }
  #shopify-section-{{ sid }} .t4__card-heading { margin: calc(var(--t4-card-mt) * .75) 0 0; color: var(--t4-ch-c); font-family: var(--t4-hf); font-weight: var(--t4-hw); font-size: var(--t4-ch-m); line-height: var(--t4-h-lh); text-align: var(--t4-card-align); }
  #shopify-section-{{ sid }} .t4__review { margin: calc(var(--t4-card-mt) * .75) 0 0; color: var(--t4-ct-c); font-family: var(--t4-tf); font-size: var(--t4-ct); line-height: var(--t4-ct-lh); text-align: var(--t4-card-align); }
  #shopify-section-{{ sid }} .t4__review .t4__full { display: none; }
  #shopify-section-{{ sid }} .t4__review[data-open] .t4__full { display: inline; }
  #shopify-section-{{ sid }} .t4__review[data-open] .t4__short { display: none; }
  #shopify-section-{{ sid }} .t4__more { display: block; width: fit-content; min-height: 44px; margin: 4px 0 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-weight: 700; cursor: pointer; }
  #shopify-section-{{ sid }} .t4__more[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4[data-card-align="center"] .t4__more { margin-inline: auto; }
  #shopify-section-{{ sid }} .t4[data-card-align="right"] .t4__more { margin-inline-start: auto; }
  #shopify-section-{{ sid }} .t4__more:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #shopify-section-{{ sid }} .t4__author { margin: 0; color: var(--t4-au-c); font-family: var(--t4-tf); font-size: var(--t4-au); line-height: var(--t4-t-lh); text-align: var(--t4-card-align); }
  #shopify-section-{{ sid }} .t4__arrow { position: absolute; top: 50%; z-index: 2; display: none; align-items: center; justify-content: center; width: var(--t4-arrow); height: var(--t4-arrow); padding: 0; transform: translateY(-50%); border: var(--t4-arrow-bw) solid var(--t4-arrow-border); border-radius: 50%; background: var(--t4-arrow-bg); color: var(--t4-arrow-c); box-shadow: 0 0 10px rgba(0, 0, 0, .15); cursor: pointer; transition: background-color var(--btn-anim-duration, .3s) ease, border-color var(--btn-anim-duration, .3s) ease, color var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .t4__arrow::before { content: ""; position: absolute; inset: min(0px, calc((var(--t4-arrow) - 44px) / 2)); }
  #shopify-section-{{ sid }} .t4__arrow:hover { background: var(--t4-arrow-bg-h); border-color: var(--t4-arrow-border-h); color: var(--t4-arrow-c-h); }
  #shopify-section-{{ sid }} .t4__arrow:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ sid }} .t4__arrow svg { width: var(--t4-arrow-icon); height: var(--t4-arrow-icon); fill: currentColor; }
  #shopify-section-{{ sid }} .t4__arrow--prev { left: 4px; }
  #shopify-section-{{ sid }} .t4__arrow--next { right: 4px; }
  #shopify-section-{{ sid }} .t4__arrow--next svg { transform: scaleX(-1); }
  #shopify-section-{{ sid }} .t4[data-arrows-m="true"] .t4__arrow { display: flex; }
  #shopify-section-{{ sid }} .t4__dots { display: none; margin-top: 12px; }
  #shopify-section-{{ sid }} .t4[data-dots-m="true"] .t4__dots { display: flex; }
  #shopify-section-{{ sid }} .t4 .lt-dot { width: max(24px, calc(var(--t4-dot) + 8px)); }
  #shopify-section-{{ sid }} .t4 .lt-dot::before { width: var(--t4-dot); height: var(--t4-dot); background: var(--t4-dot-c); opacity: .35; }
  #shopify-section-{{ sid }} .t4 .lt-dot[aria-current="true"]::before { background: var(--t4-dot-c); opacity: 1; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .t4__btn-row { margin-top: var(--t4-btn-mt); text-align: var(--t4-align); }
  #shopify-section-{{ sid }} .t4__btn-row[hidden] { display: none; }
  #shopify-section-{{ sid }} .t4__btn { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .t4__card { flex-basis: calc((100% - var(--t4-gap) * (var(--t4-pv-t) - 1)) / var(--t4-pv-t)); }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .t4 { margin-block: var(--t4-mt) var(--t4-mb); }
    #shopify-section-{{ sid }} .t4__inner { padding: var(--t4-pt) var(--t4-px) var(--t4-pb); }
    #shopify-section-{{ sid }} .t4__heading { font-size: var(--t4-h); }
    #shopify-section-{{ sid }} .t4__rating { margin-top: var(--t4-rating-mt); }
    #shopify-section-{{ sid }} .t4__rating-text, #shopify-section-{{ sid }} .t4__score { font-size: var(--t4-r); }
    #shopify-section-{{ sid }} .t4__profile { width: var(--t4-prof); height: var(--t4-prof); }
    #shopify-section-{{ sid }} .t4__text { margin-top: var(--t4-text-mt); }
    #shopify-section-{{ sid }} .t4__copy, #shopify-section-{{ sid }} .t4__copy * { font-size: var(--t4-t); }
    #shopify-section-{{ sid }} .t4 .lt-star, #shopify-section-{{ sid }} .t4__stars img { --lt-star-size: var(--t4-star); width: var(--t4-star); height: var(--t4-star); }
    #shopify-section-{{ sid }} .t4__slider { max-width: var(--t4-slider-w); margin-top: var(--t4-slider-mt); }
    #shopify-section-{{ sid }} .t4__card { flex-basis: calc((100% - var(--t4-gap) * (var(--t4-pv) - 1)) / var(--t4-pv)); gap: var(--t4-card-mt); padding: var(--t4-cpy) var(--t4-cpx); }
    #shopify-section-{{ sid }} .t4__card-heading { margin-top: var(--t4-card-mt); font-size: var(--t4-ch); }
    #shopify-section-{{ sid }} .t4__review { margin-top: var(--t4-card-mt); }
    #shopify-section-{{ sid }} .t4__review .t4__short, #shopify-section-{{ sid }} .t4__more { display: none; }
    #shopify-section-{{ sid }} .t4__review .t4__full { display: inline; }
    #shopify-section-{{ sid }} .t4__arrow--prev { left: calc(var(--t4-arrow) * -.5); }
    #shopify-section-{{ sid }} .t4__arrow--next { right: calc(var(--t4-arrow) * -.5); }
    #shopify-section-{{ sid }} .t4[data-arrows-d] .t4__arrow { display: none; }
    #shopify-section-{{ sid }} .t4[data-arrows-d="true"] .t4__arrow { display: flex; }
    #shopify-section-{{ sid }} .t4[data-dots-d] .t4__dots { display: none; }
    #shopify-section-{{ sid }} .t4[data-dots-d="true"] .t4__dots { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .t4__arrow { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture t4_shadow -%}{%- if section.settings.card_shadow -%}0 0 20px 0 color-mix(in srgb, {% render 'live-testimonials-color', on: custom, color: section.settings.card_shadow_color, fallback: 'var(--color-text)' %} 20%, transparent){%- else -%}none{%- endif -%}{%- endcapture -%}
{%- case section.settings.heading_align -%}
  {%- when 'left' -%}{%- assign justify = 'flex-start' -%}
  {%- when 'right' -%}{%- assign justify = 'flex-end' -%}
  {%- else -%}{%- assign justify = 'center' -%}
{%- endcase -%}
{%- case section.settings.card_heading_align -%}
  {%- when 'left' -%}{%- assign cjustify = 'flex-start' -%}
  {%- when 'right' -%}{%- assign cjustify = 'flex-end' -%}
  {%- else -%}{%- assign cjustify = 'center' -%}
{%- endcase -%}
<div class="t4 color-{{ color_scheme }} gradient" data-lt-root="testimon4" data-section-id="{{ sid }}"{% if request.design_mode %} data-lt-settings="{{ section.settings | json | escape }}"{% endif %} data-card-align="{{ section.settings.card_heading_align | default: 'center' }}" data-arrows-d="{{ section.settings.arrow_show_desktop }}" data-arrows-m="{{ section.settings.arrow_show_mobile }}" data-dots-d="{{ section.settings.dots_show_desktop }}" data-dots-m="{{ section.settings.dots_show_mobile }}" data-words="{{ words }}"{% if hfont or tfont %} data-own-font{% endif %} style="--t4-bg: {% render 'live-testimonials-color', on: custom, color: section.settings.background_color, fallback: 'var(--color-background)' %};--t4-bg-img: {% if custom and section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}none{% endif %};--t4-border: {% render 'live-testimonials-color', on: custom, color: section.settings.border_color, fallback: 'var(--color-border)' %};--t4-border-w: {{ section.settings.border_thickness | default: 0 }}px;--t4-heading-c: {% render 'live-testimonials-color', on: custom, color: section.settings.heading_color, fallback: 'var(--color-heading)' %};--t4-rating-c: {% render 'live-testimonials-color', on: custom, color: section.settings.rating_text_color, fallback: 'var(--color-heading)' %};--t4-text: {% render 'live-testimonials-color', on: custom, color: section.settings.text_color, fallback: 'var(--color-text)' %};--t4-star-glyph: {% render 'live-testimonials-color', on: custom, color: section.settings.stars_color, fallback: 'var(--btn-primary-color, #fff)' %};--lt-star-on: {% render 'live-testimonials-color', on: custom, color: section.settings.stars_bg_color, fallback: 'var(--color-primary)' %};--lt-star-off: {% render 'live-testimonials-color', on: custom, color: section.settings.stars_bg_half_color, fallback: 'var(--color-border)' %};--t4-card-bg: {% render 'live-testimonials-color', on: custom, color: section.settings.card_bg_color, fallback: 'var(--color-background)' %};--t4-card-border: {% render 'live-testimonials-color', on: custom, color: section.settings.card_border_color, fallback: 'var(--color-border)' %};--t4-shadow: {{ t4_shadow }};--t4-ch-c: {% render 'live-testimonials-color', on: custom, color: section.settings.card_heading_color, fallback: 'var(--color-heading)' %};--t4-ct-c: {% render 'live-testimonials-color', on: custom, color: section.settings.card_text_color, fallback: 'var(--color-text)' %};--t4-au-c: {% render 'live-testimonials-color', on: custom, color: section.settings.card_author_date_text_color, fallback: 'var(--color-text)' %};--t4-arrow-c: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_color, fallback: 'var(--color-heading)' %};--t4-arrow-c-h: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_hover_color, fallback: 'var(--color-heading)' %};--t4-arrow-bg: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_bg_color, fallback: 'var(--color-background)' %};--t4-arrow-bg-h: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_bg_hover_color, fallback: 'var(--color-background)' %};--t4-arrow-border: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_border_color, fallback: 'var(--color-border)' %};--t4-arrow-border-h: {% render 'live-testimonials-color', on: custom, color: section.settings.arrow_border_hover_color, fallback: 'var(--color-heading)' %};--t4-dot-c: {% render 'live-testimonials-color', on: custom, color: section.settings.dots_color, fallback: 'var(--color-heading)' %};--t4-hf: {% if hfont and section.settings.heading_font.family != blank %}{{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--t4-hw: {% if hfont and section.settings.heading_font.weight != blank %}{{ section.settings.heading_font.weight }}{% else %}var(--heading-weight, 700){% endif %};--t4-tf: {% if tfont and section.settings.text_font.family != blank %}{{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--t4-h-lh: {% if hfont %}{{ section.settings.heading_height | default: 130 | divided_by: 100.0 }}{% else %}var(--heading-line-height, 1.2){% endif %};--t4-t-lh: {{ section.settings.text_height | default: 130 | divided_by: 100.0 }};--t4-ct-lh: {{ section.settings.card_text_height | default: 150 | divided_by: 100.0 }};--t4-max: {% if section.settings.full_width %}none{% else %}{{ section.settings.content_width | default: 1500 }}px{% endif %};--t4-align: {{ section.settings.heading_align | default: 'center' }};--t4-justify: {{ justify }};--t4-card-align: {{ section.settings.card_heading_align | default: 'center' }};--t4-card-justify: {{ cjustify }};--t4-mt: {{ section.settings.margin_top | default: 0 }}px;--t4-mb: {{ section.settings.margin_bottom | default: 0 }}px;--t4-pt: {{ section.settings.padding_top | default: 0 }}px;--t4-pb: {{ section.settings.padding_bottom | default: 0 }}px;--t4-px: {{ section.settings.padding_horizontal | default: 0 }}rem;--t4-px-m: {{ section.settings.padding_horizontal_mobile | default: 0 }}rem;--t4-h: {{ section.settings.heading_size | default: 40 }}px;--t4-h-m: {{ section.settings.heading_size_mobile | default: 24 }}px;--t4-r: {{ section.settings.rating_text_size | default: 22 }}px;--t4-r-m: {{ section.settings.rating_text_size_mobile | default: 20 }}px;--t4-rating-mt: {{ section.settings.rating_text_mt | default: 0 }}px;--t4-prof: {{ section.settings.profile_size | default: 34 }}px;--t4-prof-m: {{ section.settings.profile_size_mobile | default: 32 }}px;--t4-overlap: {{ section.settings.profile_overlap | default: 0 }}px;--t4-prof-gap: {{ section.settings.profile_gap | default: 0 }}px;--t4-t: {{ section.settings.text_size | default: 20 }}px;--t4-t-m: {{ section.settings.text_size | default: 20 | times: 0.8 | round }}px;--t4-text-mt: {{ section.settings.text_mt | default: 0 }}px;--t4-star: {{ section.settings.stars_size | default: 20 }}px;--t4-star-m: {{ section.settings.stars_size | default: 20 | times: 0.8 | round }}px;--lt-star-gap: {{ section.settings.stars_gap | default: 0 }}px;--t4-slider-w: {{ section.settings.slider_width | default: 100 }}%;--t4-slider-mt: {{ section.settings.slider_mt | default: 0 }}px;--t4-gap: {{ section.settings.slider_gap | default: 0 }}px;--t4-pv: {{ view }};--t4-pv-t: {{ view_t }};--t4-pv-m: {{ section.settings.slider_view_mobile | default: 1 }};--t4-cpy: {{ section.settings.card_padding_vertical | default: 0 }}px;--t4-cpx: {{ section.settings.card_padding_horizontal | default: 0 }}px;--t4-card-r: {{ section.settings.card_radius | default: 0 }}px;--t4-card-bw: {{ section.settings.card_border_thickness | default: 0 }}px;--t4-card-mt: {{ section.settings.card_heading_mt | default: 0 }}px;--t4-ch: {{ section.settings.card_heading_size | default: 24 }}px;--t4-ch-m: {{ section.settings.card_heading_size_mobile | default: 20 }}px;--t4-ct: {{ section.settings.card_text_size | default: 14 }}px;--t4-au: {{ section.settings.card_author_date_text_size | default: 16 }}px;--t4-arrow: {{ section.settings.arrow_size | default: 50 }}px;--t4-arrow-icon: {{ section.settings.arrow_icon_size | default: 28 }}px;--t4-arrow-bw: {{ section.settings.arrow_border_thickness | default: 0 }}px;--t4-dot: {{ section.settings.dots_size | default: 12 }}px;--t4-btn-mt: {{ section.settings.button_mt | default: 0 }}px;">
  <div class="t4__inner">
    <h2 class="t4__heading" data-lt-heading{% if hfont %} data-own-size data-own-weight{% endif %}{% if section.settings.heading == blank %} hidden{% endif %}>{{ section.settings.heading | escape }}</h2>
    <div class="t4__rating" data-lt-rating{% if section.settings.rating_text_hide and section.settings.rating_hide %} hidden{% endif %}>
      <p class="t4__rating-text" data-lt-rating-text{% if section.settings.rating_text_hide %} hidden{% endif %}>{{ section.settings.rating_text | escape }}</p>
      <p class="t4__score" data-lt-score{% if section.settings.rating_hide or section.settings.rating <= 0 %} hidden{% endif %}><b>{{ section.settings.rating }}</b> <strong>/ 5</strong></p>
      <div class="t4__profiles" data-lt-profiles{% unless section.settings.enable_profile_images %} hidden{% endunless %}>
        {%- for n in (1..4) -%}
          {%- assign pkey = 'profile_image_' | append: n -%}
          {%- case n -%}
            {%- when 1 -%}{%- assign pimg = section.settings.profile_image_1 -%}
            {%- when 2 -%}{%- assign pimg = section.settings.profile_image_2 -%}
            {%- when 3 -%}{%- assign pimg = section.settings.profile_image_3 -%}
            {%- else -%}{%- assign pimg = section.settings.profile_image_4 -%}
          {%- endcase -%}
          <span class="t4__profile" data-lt-profile="{{ pkey }}">
            {%- if pimg != blank -%}
              {{ pimg | image_url: width: 100 | image_tag: loading: 'lazy', decoding: 'async', width: 50, height: 50, alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 52 52" aria-hidden="true" focusable="false" data-lt-ph><circle cx="26" cy="21" r="9" fill="currentColor" opacity=".45"/><path d="M6 48c0-10 9-15 20-15s20 5 20 15" fill="currentColor" opacity=".45"/></svg>
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
    <div class="t4__text" data-lt-textrow{% if section.settings.text == blank %} hidden{% endif %}>
      <div class="t4__copy" data-lt-copy>{{ section.settings.text }}</div>
      <div class="t4__text-img" data-lt-media{% if section.settings.text_right_image == blank %} hidden{% endif %}>
        {%- if section.settings.text_right_image != blank -%}
          {{ section.settings.text_right_image | image_url: width: 300 | image_tag: loading: 'lazy', decoding: 'async', alt: section.settings.text_right_image.alt }}
        {%- endif -%}
      </div>
    </div>

    {%- if cards.size > 0 -%}
      <div class="t4__slider">
        <div class="t4__track" data-lt-track data-testimonial-row tabindex="0" role="region" aria-roledescription="carousel" aria-label="Reviews">
          {%- for b in cards -%}
            {%- assign bs = b.settings -%}
            {%- assign plain = bs.text | strip_html | strip -%}
            {%- assign count = plain | split: ' ' | size -%}
            <div class="t4__card" data-lt-block="{{ b.id }}" data-lt-type="testimonials"{% if request.design_mode %} data-lt-settings="{{ bs | json | escape }}"{% endif %} {{ b.shopify_attributes }}>
              <div class="t4__card-top">
                {%- if section.settings.stars_icon != blank -%}
                  {%- assign stars_round = bs.stars_count | round -%}
                  <div class="t4__stars" data-lt-icon-stars role="img" aria-label="{{ bs.stars_count }} / 5"{% if stars_round == 0 %} hidden{% endif %}>
                    {%- for i in (1..stars_round) -%}{{ section.settings.stars_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{%- endfor -%}
                  </div>
                {%- else -%}
                  {%- assign no_stars = false -%}{%- if bs.stars_count == 0 -%}{%- assign no_stars = true -%}{%- endif -%}
                  {% render 'live-testimonials-stars', rating: bs.stars_count, hidden: no_stars %}
                {%- endif -%}
                <h3 class="t4__card-heading" data-lt-card-heading{% if hfont %} data-own-size data-own-weight{% endif %}{% if bs.heading == blank %} hidden{% endif %}>{{ bs.heading | escape }}</h3>
                <p class="t4__review" data-lt-review{% if plain == blank %} hidden{% endif %}>
                  <span class="t4__short">{{ plain | truncatewords: words }}</span><span class="t4__full">{{ plain }}</span>
                  <button type="button" class="t4__more" data-lt-more aria-expanded="false" data-more="{{ section.settings.card_text_more | escape }}" data-less="{{ section.settings.card_text_less | escape }}"{% if count <= words %} hidden{% endif %}>{{ section.settings.card_text_more | escape }}</button>
                </p>
              </div>
              <p class="t4__author" data-lt-author{% if bs.author_date == blank %} hidden{% endif %}>{{ bs.author_date | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
        <button type="button" class="t4__arrow t4__arrow--prev" data-lt-prev aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14,17a1,1,0,0,1-.707-.293l-4-4a1,1,0,0,1,0-1.414l4-4a1,1,0,1,1,1.414,1.414L11.414,12l3.293,3.293A1,1,0,0,1,14,17Z"/></svg></button>
        <button type="button" class="t4__arrow t4__arrow--next" data-lt-next aria-label="{{ 'accessibility.next' | t | default: 'Next' }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14,17a1,1,0,0,1-.707-.293l-4-4a1,1,0,0,1,0-1.414l4-4a1,1,0,1,1,1.414,1.414L11.414,12l3.293,3.293A1,1,0,0,1,14,17Z"/></svg></button>
        <div class="t4__dots lt-nav"><div class="lt-dots" data-lt-dots data-label="{{ 'accessibility.go_to_slide' | t | default: 'Go to slide' }}"></div></div>
      </div>
    {%- endif -%}

    {%- capture btn_style -%}
      {%- if custom -%}{%- render 'button-overrides', bg: section.settings.button_bg_color, text: section.settings.button_color, border: section.settings.button_border_color, hover_bg: section.settings.button_bg_hover_color, hover_text: section.settings.button_hover_color, hover_border: section.settings.button_border_hover_color -%}{%- endif -%}
      {%- if shape -%}--mb-radius: {{ section.settings.button_radius }}px;--mb-padding-y: {{ section.settings.button_padding_vertical }}px;--mb-padding-x: {{ section.settings.button_padding_horizontal }}px;--mb-font-size: {{ section.settings.button_size }}px;--mb-border-width: {{ section.settings.button_border_thickness }}px;--btn-border-width: {{ section.settings.button_border_thickness }}px;{%- endif -%}
      {%- if tfont and section.settings.text_font.family != blank -%}--mb-font: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
    {%- endcapture -%}
    {%- capture btn_attrs -%}class="t4__btn" data-theme-button="primary" data-sl-button data-lt-button{% if shape %} data-own-shape{% endif %}{% if tfont %} data-own-font{% endif %} style="{{ btn_style }}"{%- endcapture -%}
    <div class="t4__btn-row" data-lt-btn-row{% if section.settings.button == blank %} hidden{% endif %}>
      {%- if section.settings.button_url != blank -%}
        <a href="{{ section.settings.button_url }}" {{ btn_attrs }}{% if section.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button | escape }}</a>
      {%- else -%}
        <button type="button" {{ btn_attrs }}>{{ section.settings.button | escape }}</button>
      {%- endif -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "testimon4",
  "name": "Testimonials 4",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Content width",
      "default": 1500,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our customers tell it better than we do!"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": ""
    },
    {
      "type": "range",
      "id": "rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Rating",
      "default": 0,
      "info": "Your average rating from your own reviews. 0 shows no score."
    },
    {
      "type": "checkbox",
      "id": "rating_text_hide",
      "label": "Hide rating text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rating_hide",
      "label": "Hide rating",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "image_picker",
      "label": "Picture beside the text",
      "id": "text_right_image"
    },
    {
      "type": "checkbox",
      "id": "enable_profile_images",
      "label": "Show profile circles",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "profile_image_1",
      "label": "Profile 1",
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "image_picker",
      "id": "profile_image_2",
      "label": "Profile 2",
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "image_picker",
      "id": "profile_image_3",
      "label": "Profile 3",
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "image_picker",
      "id": "profile_image_4",
      "label": "Profile 4",
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "image_picker",
      "id": "stars_icon",
      "label": "Custom star icon"
    },
    {
      "type": "text",
      "id": "card_text_more",
      "label": "Read more label",
      "default": "View more"
    },
    {
      "type": "text",
      "id": "card_text_less",
      "label": "Read less label",
      "default": "View less"
    },
    {
      "type": "range",
      "id": "card_count_words",
      "min": 5,
      "max": 40,
      "step": 1,
      "label": "Words before Read more",
      "default": 20,
      "info": "Phones and tablets show this many words first."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Open link in a new tab",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Also lines up the rating, stars, text and button."
    },
    {
      "type": "range",
      "id": "rating_text_mt",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above rating",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_mt",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above text",
      "default": 16
    },
    {
      "type": "range",
      "id": "slider_width",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Slider width",
      "default": 80
    },
    {
      "type": "range",
      "id": "slider_view",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Cards per view (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slider_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "slider_mt",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space above slider",
      "default": 48
    },
    {
      "type": "range",
      "id": "stars_size",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Star size",
      "default": 20,
      "info": "On mobile, 80% of this."
    },
    {
      "type": "range",
      "id": "stars_gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Gap between stars",
      "default": 4
    },
    {
      "type": "range",
      "id": "profile_size",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Profile size",
      "default": 34,
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "range",
      "id": "profile_overlap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Profile overlap",
      "default": 18,
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "range",
      "id": "profile_gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Space before profiles",
      "default": 5,
      "visible_if": "{{ section.settings.enable_profile_images }}"
    },
    {
      "type": "range",
      "id": "card_padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Card padding (top and bottom)",
      "default": 32,
      "info": "On mobile, 75% of this."
    },
    {
      "type": "range",
      "id": "card_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Card padding (sides)",
      "default": 40,
      "info": "On mobile, 60% of this."
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Card border",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": true
    },
    {
      "type": "select",
      "id": "card_heading_align",
      "label": "Card alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_heading_mt",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space inside cards",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "arrow_show_desktop",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "range",
      "id": "arrow_size",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Arrow size",
      "default": 50,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_icon_size",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Arrow icon size",
      "default": 28,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "range",
      "id": "arrow_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Arrow border",
      "default": 0,
      "visible_if": "{{ section.settings.arrow_show_desktop or section.settings.arrow_show_mobile }}"
    },
    {
      "type": "checkbox",
      "id": "dots_show_desktop",
      "label": "Show dots (desktop)",
      "default": false
    },
    {
      "type": "range",
      "id": "dots_size",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
