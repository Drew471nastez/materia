<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes. Benefits Bar 3: a heading block on the left and a row of
  item blocks (line icon or picture, top label, bold bottom label). One row
  on desktop with arrows when it overflows, the heading above the items on
  tablets, and a swipe row, grid or stack on phones. Colours follow the
  colour scheme and fonts follow Theme settings > Typography until custom
  styling or custom fonts are switched on. Every value is a CSS variable
  printed here; assets/live-features-c.js works out the same variables for
  live edits and runs the arrows.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign custom = s.use_custom_background
  assign fonts = s.enable_custom_fonts
  assign scroll_animation = settings.scroll_animation | default: 'none'
  case s.section_width
    when 'container'
      assign width_class = 'container'
    when 'fluid_container'
      assign width_class = 'fluid_container'
    when 'stretch_width'
      assign width_class = 'stretch_width'
    else
      assign width_class = 'full_width'
  endcase
-%}
{%- if fonts -%}{% style %}{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% endstyle %}{%- endif -%}
{%- style -%}
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  #shopify-section-{{ sid }} .ihb {
    --ihb-gap: var(--ihb-gap-d);
    --ihb-icon-size: var(--ihb-icon-d);
    --ihb-pt: var(--ihb-pt-d);
    --ihb-pb: var(--ihb-pb-d);
    display: block;
    background: var(--ihb-bg);
    font-family: var(--ihb-bf);
  }
  #shopify-section-{{ sid }} .ihb__accent {
    height: var(--ihb-accent-h);
    background: var(--ihb-accent-color);
    width: 100%;
  }
  #shopify-section-{{ sid }} .ihb__accent[hidden] { display: none; }
  #shopify-section-{{ sid }} .ihb__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    padding-top: var(--ihb-pt);
    padding-bottom: var(--ihb-pb);
    padding-inline: clamp(20px, 5vw, 64px);
    box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .ihb__heading {
    margin: 0;
    flex: 0 0 auto;
    max-width: 38%;
    line-height: 1.05;
    font-family: var(--ihb-hf);
    font-size: var(--ihb-h-size, 26px);
    font-weight: var(--ihb-h-weight, var(--heading-weight, 800));
    letter-spacing: var(--ihb-h-ls, normal);
    text-transform: var(--heading-text-transform, none);
    color: var(--ihb-h-color, var(--color-heading));
  }
  #shopify-section-{{ sid }} .ihb__heading[hidden] { display: none; }
  #shopify-section-{{ sid }} .ihb__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--ihb-gap);
    flex: 1 1 auto;
    min-width: 0;
  }
  #shopify-section-{{ sid }} .ihb__items:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  /* Scroller wrapper: the items list plus the desktop arrow buttons */
  #shopify-section-{{ sid }} .ihb__scroller {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex: 1 1 auto;
  }
  #shopify-section-{{ sid }} .ihb__arrow {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.15));
    background: var(--color-background, #fff);
    color: var(--color-heading);
    border-radius: 999px;
    cursor: pointer;
    line-height: 1;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ihb__arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  #shopify-section-{{ sid }} .ihb__arrow:hover { opacity: 0.7; }
  #shopify-section-{{ sid }} .ihb__arrow:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ihb__arrow { transition: none; }
  }
  /* A hidden arrow keeps its place, so the row does not move when the arrows appear. */
  #shopify-section-{{ sid }} .ihb__arrow[hidden] { display: inline-flex; visibility: hidden; }
  #shopify-section-{{ sid }} .ihb__item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  #shopify-section-{{ sid }} .ihb__icon {
    flex: 0 0 auto;
    width: var(--ihb-icon-size);
    height: var(--ihb-icon-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ihb-icon-color);
  }
  #shopify-section-{{ sid }} .ihb__icon svg {
    width: 100%;
    height: 100%;
    display: block;
    stroke: currentColor;
    stroke-width: var(--ihb-stroke);
    fill: none;
  }
  /* An uploaded picture stays inside the icon box. */
  #shopify-section-{{ sid }} .ihb__icon img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    display: block !important;
    margin: 0 !important;
  }
  #shopify-section-{{ sid }} .ihb__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
    color: var(--ihb-text-color);
  }
  #shopify-section-{{ sid }} .ihb__top,
  #shopify-section-{{ sid }} .ihb__bottom {
    font-family: var(--ihb-bf);
    font-size: var(--ihb-label-size);
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .ihb__top { font-weight: var(--ihb-top-w); opacity: .92; }
  #shopify-section-{{ sid }} .ihb__bottom { font-weight: var(--ihb-bottom-w); }
  #shopify-section-{{ sid }} :is(.ihb__top, .ihb__bottom, .ihb__text)[hidden] { display: none; }
  /* ---- Tablet: heading drops above the items ---- */
  @media (max-width: 991px) {
    #shopify-section-{{ sid }} .ihb__inner {
      flex-direction: column;
      align-items: var(--ihb-malign);
      gap: 20px;
      text-align: var(--ihb-malign);
    }
    #shopify-section-{{ sid }} .ihb__heading {
      max-width: 100%;
      font-size: var(--ihb-h-size-m, 22px);
    }
    #shopify-section-{{ sid }} .ihb__items {
      justify-content: center;
      width: 100%;
    }
    #shopify-section-{{ sid }} .ihb__scroller {
      display: block;
      width: 100%;
      flex: 0 0 auto;
    }
    #shopify-section-{{ sid }} .ihb__arrow { display: none !important; }
  }
  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .ihb {
      --ihb-pt: var(--ihb-pt-m);
      --ihb-pb: var(--ihb-pb-m);
      --ihb-icon-size: var(--ihb-icon-m);
      --ihb-gap: var(--ihb-gap-m);
    }
    #shopify-section-{{ sid }} .ihb__heading[data-hide-mobile='true'] { display: none; }
    #shopify-section-{{ sid }} [data-mobile-layout='stack'] .ihb__items {
      flex-direction: column;
      align-items: var(--ihb-malign);
    }
    #shopify-section-{{ sid }} [data-mobile-layout='grid'] .ihb__items {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--ihb-gap);
    }
    #shopify-section-{{ sid }} [data-mobile-layout='grid'] .ihb__item { justify-content: var(--ihb-mjustify); }
    #shopify-section-{{ sid }} [data-mobile-layout='scroll'] .ihb__items {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-bottom: 6px;
      scrollbar-width: none;
      scroll-padding-left: 4px;
    }
    #shopify-section-{{ sid }} [data-mobile-layout='scroll'] .ihb__items::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} [data-mobile-layout='scroll'] .ihb__item {
      /* Per-view width, never narrower than 170px so items cannot crowd small screens */
      flex: 0 0 max(170px, calc((100% - ((var(--ihb-mpv) - 1) * var(--ihb-gap))) / var(--ihb-mpv)));
      scroll-snap-align: start;
    }
  }
  /* ---- Desktop: ONE row; scroll sideways with arrows when it overflows ---- */
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .ihb__items {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      justify-content: var(--ihb-justify-d);
    }
    #shopify-section-{{ sid }} .ihb__items::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .ihb__item { flex: 0 0 auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ihb__items { scroll-behavior: auto !important; }
  }
{%- endstyle -%}
{%- if scroll_animation != 'none' -%}
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ sid }}');
      if (el && !el.classList.contains('scroll-trigger')) {
        el.classList.add('scroll-trigger', {{ scroll_animation | json }});
      }
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- capture root_vars -%}
  --ihb-bg: {% if custom %}{% render 'scheme-color', color: s.background_color, fallback: 'var(--gradient-background, var(--color-background))' %}{% else %}var(--gradient-background, var(--color-background)){% endif %};
  --ihb-icon-color: {% if custom %}{% render 'scheme-color', color: s.icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --ihb-text-color: {% if custom %}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
  --ihb-accent-color: {% if custom %}{% render 'scheme-color', color: s.accent_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
  --ihb-hf: {% if fonts and s.heading_font.family != blank %}{{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
  --ihb-bf: {% if fonts and s.body_font.family != blank %}{{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
  --ihb-accent-h: {{ s.accent_height | default: 6 }}px; --ihb-stroke: {{ s.icon_stroke | default: 1.6 }};
  --ihb-icon-d: {{ s.icon_size | default: 40 }}px; --ihb-icon-m: {{ s.icon_size_mobile | default: 34 }}px;
  --ihb-gap-d: {{ s.item_gap_desktop | default: 28 }}px; --ihb-gap-m: {{ s.item_gap_mobile | default: 16 }}px;
  --ihb-pt-d: {{ s.padding_top_desktop | default: 0 }}px; --ihb-pb-d: {{ s.padding_bottom_desktop | default: 0 }}px; --ihb-pt-m: {{ s.padding_top_mobile | default: 0 }}px; --ihb-pb-m: {{ s.padding_bottom_mobile | default: 0 }}px;
  --ihb-label-size: {{ s.label_size | default: 16 }}px; --ihb-top-w: {{ s.label_top_weight | default: 400 }}; --ihb-bottom-w: {{ s.label_bottom_weight | default: 700 }};
  --ihb-mpv: {{ s.mobile_per_view | default: 2.2 }}; --ihb-malign: {{ s.mobile_align | default: 'center' }}; --ihb-mjustify: {% if s.mobile_align == 'flex-start' %}flex-start{% else %}center{% endif %};
  --ihb-justify-d: {% if s.center_items %}safe center{% else %}safe flex-end{% endif %};
{%- endcapture -%}
<section class="ihb color-{{ color_scheme }} gradient" data-fc-root="ingredients-highlight-bar" data-fc-section="{{ sid }}" data-fc-settings="{{ s | json | escape }}" data-mobile-layout="{{ s.mobile_layout | default: 'scroll' }}"{% if fonts %} data-own-font{% endif %} style="{{ root_vars | strip_newlines }}">
  <div class="ihb__accent" aria-hidden="true"{% unless s.show_accent_bar %} hidden{% endunless %}></div>
  <div class="ihb__inner {{ width_class }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' -%}
        {%- liquid
          assign hb = block.settings
          assign own_weight = false
          if hb.heading_weight != 'theme' and hb.heading_weight != blank
            assign own_weight = true
          endif
          assign own_size = false
          if hb.heading_letter_spacing != 0 and hb.heading_letter_spacing != blank
            assign own_size = true
          endif
        -%}
        <h2 class="ihb__heading" data-fc-block="{{ block.id }}" data-fc-type="heading" data-fc-settings="{{ hb | json | escape }}" data-hide-mobile="{% if hb.heading_hide_mobile %}true{% else %}false{% endif %}"{% if own_weight %} data-own-weight{% endif %}{% if own_size %} data-own-size{% endif %} {{ block.shopify_attributes }}{% if hb.heading == blank %} hidden{% endif %} style="--ihb-h-size: {{ hb.heading_size_desktop | default: 26 }}px; --ihb-h-size-m: {{ hb.heading_size_mobile | default: 22 }}px; --ihb-h-color: {% if hb.enable_custom_style %}{% render 'scheme-color', color: hb.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};{% if own_weight %} --ihb-h-weight: {{ hb.heading_weight }};{% endif %}{% if own_size %} --ihb-h-ls: {{ hb.heading_letter_spacing }}px;{% endif %}{% if hb.heading_uppercase %} --heading-text-transform: uppercase;{% endif %}">{{ hb.heading }}</h2>
      {%- endif -%}
    {%- endfor -%}
    <div class="ihb__scroller" data-ihb-scroller>
      <button type="button" class="ihb__arrow ihb__arrow--prev" aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}" hidden>
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <ul class="ihb__items" role="list" data-ihb-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- liquid
            assign b = block.settings
            assign top = b.top_label
            assign bottom = b.bottom_label
          -%}
          <li class="ihb__item" data-fc-block="{{ block.id }}" data-fc-type="item" data-fc-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
            <span class="ihb__icon" aria-hidden="true">
              {%- if b.icon_source == 'image' and b.custom_image != blank -%}
                {{ b.custom_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 40, height: 40, widths: '40,80,120,160', sizes: '40px', alt: '' }}
              {%- else -%}
                <span class="ihb__svg" data-fc-icon="{{ b.icon }}">{%- render 'features-c-bar-icon', icon: b.icon -%}</span>
              {%- endif -%}
            </span>
            <span class="ihb__text"{% if top == blank and bottom == blank %} hidden{% endif %}>
              <span class="ihb__top"{% if top == blank %} hidden{% endif %}>{{ top | escape }}</span>
              <span class="ihb__bottom"{% if bottom == blank %} hidden{% endif %}>{{ bottom | escape }}</span>
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
      </ul>
      <button type="button" class="ihb__arrow ihb__arrow--next" aria-label="{{ 'accessibility.next' | t | default: 'Next' }}" hidden>
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
  {%- if request.design_mode -%}<template data-fc-icons>{%- assign fc_icons = 'check,shield,award,medal,star,thumbs_up,microscope,test_tube,flask,leaf,sprout,hand_plant,paw,bone,heart,target,dumbbell,fire,bolt,bottle,shaker,cup,droplet,sparkles,gift,truck,clock' | split: ',' -%}{%- for name in fc_icons -%}<span data-icon="{{ name }}">{% render 'features-c-bar-icon', icon: name %}</span>{%- endfor -%}</template>{%- endif -%}
</section>
</template>

<schema>
{
  "type": "ingredients-highlight-bar",
  "name": "Benefits Bar 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "center_items",
      "label": "Center items (desktop)",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Icon size (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Icon size (mobile)",
      "default": 34
    },
    {
      "type": "range",
      "id": "icon_stroke",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Icon line thickness",
      "default": 1.6
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Labels"
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 16
    },
    {
      "type": "select",
      "id": "label_top_weight",
      "label": "Top label weight",
      "default": "400",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "label_bottom_weight",
      "label": "Bottom label weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Label color"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Accent line"
    },
    {
      "type": "checkbox",
      "id": "show_accent_bar",
      "label": "Show accent line",
      "default": false
    },
    {
      "type": "range",
      "id": "accent_height",
      "min": 1,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Accent line height",
      "default": 6,
      "visible_if": "{{ section.settings.show_accent_bar }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent line color",
      "visible_if": "{{ section.settings.show_accent_bar }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Background"
    },
    {
      "type": "checkbox",
      "id": "use_custom_background",
      "label": "Custom background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.use_custom_background }}"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "item_gap_desktop",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Gap between items (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "min": 6,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between items (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile item layout",
      "default": "scroll",
      "options": [
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        },
        {
          "value": "grid",
