<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Product information tabs: one tab per block, in block
  order. The product is the page's product. A tab with nothing to show is
  left out on the storefront and drawn with a short note in the builder.
  Tabs (click, arrow keys, Home and End) and every live edit in the builder
  are shopify/assets/live-products-a.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign own = st.enable_custom_style
  assign pit_product = product
  if pit_product == blank
    assign pit_product = page.product
  endif
  assign infomation_meta = pit_product.metafields.custom.information_product_tab
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign pit_design = request.design_mode
  comment
    The tabs that have something to show, as ,id, so one id never matches part of another.
  endcomment
  assign pit_ids = ','
  for block in section.blocks
    assign bk_st = block.settings
    assign show = pit_design
    case block.type
      when '@app', 'review'
        assign show = true
      when 'description'
        if pit_product.description != blank
          assign show = true
        endif
      when 'custom_tab'
        assign tab_content = bk_st.tab_content | default: 'content'
        if tab_content == 'content' and bk_st.content_rich != blank
          assign show = true
        elsif tab_content == 'content_page' and bk_st.page != blank
          assign show = true
        elsif tab_content == 'content_custom'
          if infomation_meta.value.information_text != blank or infomation_meta.value.information_in_page != blank
            assign show = true
          endif
        endif
    endcase
    if show
      assign pit_ids = pit_ids | append: block.id | append: ','
    endif
  endfor
  assign pit_first = ''
  for block in section.blocks
    assign key = ',' | append: block.id | append: ','
    if pit_ids contains key
      assign pit_first = block.id
      break
    endif
  endfor
-%}
{%- if pit_first != blank -%}
  <div
    id="{{ section.id }}"
    class="section color-{{ color_scheme }} gradient {{ reset_spacing }} bls__product-tabs pit{% if st.padding_top < 30 %} pt-min{% endif %}{% if st.padding_bottom < 30 %} pb-min{% endif %}"
    {% unless st.reveal %}data-ti-no-reveal{% endunless %}
    data-section-type="tabs"
    data-section-id="{{ section.id }}"
    data-pa-root="product-information-tab" data-pa-section="{{ section.id }}" data-pa-settings="{{ st | json | escape }}"
    data-align="{{ st.tab_alignment | default: 'left' }}"
    style="--section-pt: {{ st.padding_top | default: 0 }};--section-pb: {{ st.padding_bottom | default: 0 }};--pit-tab: {% if own %}{% render 'scheme-color', color: st.tab_color, fallback: 'color-mix(in srgb, var(--color-heading) 60%, transparent)' %}{% else %}color-mix(in srgb, var(--color-heading) 60%, transparent){% endif %};--pit-tab-active: {% if own %}{% render 'scheme-color', color: st.tab_active_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--pit-text: {% if own %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--pit-tab-fs: {{ st.tab_size | default: 16 }}px;--pit-gap-d: {{ st.tab_gap | default: 60 }}px;--pit-gap-m: {{ st.tab_gap_mobile | default: 30 }}px;"
  >
    <div class="{{ st.section_width }} section-full" data-pit-width>
      <div class="product info detailed">
        <div class="product data items">
          <ul class="nav nav-tabs list-none p-0 flex mt-0 pit__tabs" role="tablist">
            {%- for block in section.blocks %}
              {%- assign key = ',' | append: block.id | append: ',' -%}
              {%- unless pit_ids contains key -%}{%- continue -%}{%- endunless -%}
              {%- assign bk_st = block.settings -%}
              {%- assign active = false -%}
              {%- if block.id == pit_first -%}{%- assign active = true -%}{%- endif -%}
              <li class="data item{% if active %} active{% endif %}" role="presentation" data-pa-block="{{ block.id }}" data-pa-type="{{ block.type | replace: '@', 'app' }}" data-pa-settings="{{ bk_st | json | escape }}" {{ block.shopify_attributes }}>
                <a
                  class="is-nav-tabs heading-weight relative whitespace-nowrap heading-color py-15 inline-block border-animation pit__tab"
                  href="#proTabs{{ block.id }}"
                  id="pit-tab-{{ block.id }}"
                  role="tab"
                  aria-selected="{{ active }}"
                  aria-controls="proTabs{{ block.id }}"
                  tabindex="{% if active %}0{% else %}-1{% endif %}"
                  data-block-id="proTabs{{ block.id }}"
                  {%- if block.type == 'review' %} tab-review{% endif -%}
                  {%- if block.type == '@app' %} tab-review-app{% endif -%}
                >
                  {%- if block.type == '@app' -%}
                    {{ 'products.product.review_app' | t }}
                  {%- elsif block.type == 'description' and bk_st.title == blank -%}
                    Description
                  {%- else -%}
                    {{- bk_st.title | escape -}}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
          <div class="tab-content pit__content">
            {%- for block in section.blocks %}
              {%- assign key = ',' | append: block.id | append: ',' -%}
              {%- unless pit_ids contains key -%}{%- continue -%}{%- endunless -%}
              {%- assign bk_st = block.settings -%}
              <div id="proTabs{{ block.id }}" class="tab-item transition{% if block.id == pit_first %} active{% endif %}" role="tabpanel" aria-labelledby="pit-tab-{{ block.id }}" tabindex="0"{% unless block.id == pit_first %} hidden{% endunless %}>
                <div class="tab-panel"{% if block.id == pit_first %} style="display: block;"{% else %} style="display: none;"{% endif %}>
                  {%- case block.type -%}
                    {%- when '@app' -%}
                      {% render block %}
                    {%- when 'description' -%}
                      {%- if pit_product.description != blank -%}
                        <div class="rte">{{ pit_product.description }}</div>
                      {%- else -%}
                        <p class="pit__note">The product's description shows here on a product page.</p>
                      {%- endif -%}
                    {%- when 'review' -%}
                      <div id="shopify-product-reviews" data-id="{{ pit_product.id }}">
                        {{ pit_product.metafields.spr.reviews }}
                      </div>
                    {%- when 'custom_tab' -%}
                      {%- assign tab_content = bk_st.tab_content | default: 'content' -%}
                      {%- case tab_content -%}
                        {%- when 'content' -%}
                          <div class="rte" data-pit-rich>{{ bk_st.content_rich }}</div>
                          {%- if bk_st.content_rich == blank -%}<p class="pit__note" data-pit-empty>Add this tab's text in its settings.</p>{%- endif -%}
                        {%- when 'content_page' -%}
                          {%- if bk_st.page != blank -%}
                            <div class="rte">{{ pages[bk_st.page].content | default: bk_st.page.content }}</div>
                          {%- else -%}
                            <p class="pit__note">Choose the page this tab shows.</p>
                          {%- endif -%}
                        {%- when 'content_custom' -%}
                          {%- if infomation_meta.value.information_text != blank -%}
                            <div class="rte">{{ infomation_meta.value.information_text }}</div>
                          {%- elsif infomation_meta.value.information_in_page != blank -%}
                            <div class="rte">{{ pages[infomation_meta.value.information_in_page].content }}</div>
                          {%- else -%}
                            <p class="pit__note">Shows the product's Information tab field when it has one.</p>
                          {%- endif -%}
                      {%- endcase -%}
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
<style>
  #shopify-section-{{ section.id }} .pit__tabs {
    gap: var(--pit-gap-m);
    justify-content: flex-start;
    margin-bottom: 40px;
    --height: 2px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    border-bottom: 1px solid var(--color-border);
  }
  #shopify-section-{{ section.id }} .pit__tabs::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .pit[data-align="center"] .pit__tabs { justify-content: safe center; }
  #shopify-section-{{ section.id }} .pit[data-align="right"] .pit__tabs { justify-content: safe flex-end; }
  #shopify-section-{{ section.id }} .pit__tabs > li { flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .pit__tab {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--pit-tab-fs);
    color: var(--pit-tab);
    background-image: linear-gradient(to right, var(--pit-tab-active) 0%, var(--pit-tab-active) 98%);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .data.item.active .pit__tab,
  #shopify-section-{{ section.id }} .pit__tab:hover { color: var(--pit-tab-active); background-size: 100% var(--height, 2px); }
  #shopify-section-{{ section.id }} .pit__tab:focus-visible { outline: 2px solid var(--pit-tab-active); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .pit__content { color: var(--pit-text); }
  #shopify-section-{{ section.id }} .tab-item:focus-visible { outline: 2px solid var(--pit-tab-active); outline-offset: 4px; }
  #shopify-section-{{ section.id }} .pit__content .rte { overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .pit__content .rte:empty { display: none; }
  #shopify-section-{{ section.id }} .pit__note { margin: 0; opacity: .7; font-style: italic; }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .pit__tabs { margin-bottom: 24px; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .pit__tabs { gap: var(--pit-gap-d); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pit__tab { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}

</template>

<schema>
{
  "type": "product-information-tab",
  "name": "Product information tab",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab title"
        }
      ],
      "limit": 1
    },
    {
      "type": "custom_tab",
      "name": "Custom tab",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Custom tab"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "content_rich",
          "label": "Content rich",
          "default": "<p>abd</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Advanced"
        },
        {
          "type": "select",
          "id": "tab_content",
          "label": "Tab content",
          "options": [
            {
              "value": "content",
              "label": "Content"
            },
            {
              "value": "content_page",
              "label": "Content page"
            },
            {
              "value": "content_custom",
              "label": "Content custom"
            }
          ]
        }
      ],
      "limit": 4
    }
  ],
  "presets": [
    {
      "name": "Product information tab",
      "category": "Products",
      "blocks": [
        {
          "type": "description",
          "settings": {
            "title": "Description"
          }
        },
        {
          "type": "custom_tab"
        }
      ]
    }
  ],
  "shopify": {
    "name": "t:sections.product-information-tabs.name",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "tab_alignment",
        "label": "Tab alignment",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: tabs and text use the colour scheme."
      },
      {
        "type": "color",
        "id": "tab_color",
        "label": "Tab",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "tab_active_color",
        "label": "Open tab and underline",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Panel text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "tab_size",
        "label": "Tab title size",
        "min": 12,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "tab_gap",
        "label": "Gap between tabs (desktop)",
        "min": 8,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40,
        "info": "A little less on a phone."
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "tab_gap_mobile",
        "label": "Gap between tabs (mobile)",
        "min": 8,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "description",
        "name": "Description",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Tab title",
            "placeholder": "Description",
            "info": "Shows the product's description."
          }
        ]
      },
      {
        "type": "custom_tab",
        "name": "Custom tab",
        "limit": 4,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Tab title",
            "default": "Custom tab"
          },
          {
            "type": "select",
            "id": "tab_content",
            "label": "Content",
            "options": [
              {
                "value": "content",
                "label": "Text"
              },
              {
                "value": "content_page",
                "label": "A page"
              },
              {
                "value": "content_custom",
                "label": "Product field"
              }
            ],
            "default": "content",
            "info": "Product field: the product's Information tab field."
          },
          {
            "type": "richtext",
            "id": "content_rich",
            "label": "Text",
            "default": "<p>Add care notes, sizing or shipping details for this product.</p>",
            "visible_if": "{{ block.settings.tab_content == 'content' }}"
          },
          {
            "type": "page",
            "id": "page",
            "label": "Page",
            "visible_if": "{{ block.settings.tab_content == 'content_page' }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.product-information-tabs.name",
        "category": "Products",
        "blocks": [
          {
            "type": "description",
            "settings": {
              "title": "Description"
            }
          },
          {
            "type": "custom_tab"
          }
        ]
      }
    ]
  }
}
</schema>
