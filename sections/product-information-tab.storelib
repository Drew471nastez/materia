<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign pit_product = product
  if pit_product == blank
    assign pit_product = page.product
  endif
  assign infomation_meta = pit_product.metafields.custom.information_product_tab
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- if section.blocks.size > 0 -%}
  <div
    id="{{ section.id }}"
    class="section color-{{ color_scheme }} gradient {{ reset_spacing }} bls__product-tabs "
    {% unless st.reveal %}data-ti-no-reveal{% endunless %}
    data-section-type="tabs"
    data-section-id="{{ section.id }}"
  >
    <div class="{{ st.section_width }} section-full">
      <div class="product info detailed">
        <div class="product data items">
          <ul
            class="nav nav-tabs list-none text-center gap-30 gap-xl-60 p-0 flex  justify-content-start mb-big mt-0"
            style="--space-bottom: 40;--height: 2px;"
          >
            {%- for block in section.blocks %}
              {% liquid
                assign bk_st = block.settings
                assign hidden = ''
                if block.type == 'custom_tab' and bk_st.tab_content == 'content_custom'
                  assign hidden = 'hidden'
                  if infomation_meta.value.information_text != blank or infomation_meta.value.information_in_page != blank
                    assign hidden = ''
                  endif
                endif
              %}
              <li class="data {{ hidden }} item{% if forloop.first %} active{% endif %}">
                <a
                  class="is-nav-tabs heading-weight relative whitespace-nowrap heading-color py-15 inline-block border-animation"
                  href="#{{ block.id }}"
                  data-block-id="proTabs{{ block.id }}"
                  {%- if block.type == 'review' -%}
                    tab-review
                  {%- endif -%}
                  {%- if block.type == '@app' -%}
                    tab-review-app
                  {%- endif -%}
                >
                  {%- if block.type == 'description' and bk_st.title == blank -%}
                    Description
                  {%- else -%}
                    {{- bk_st.title -}}
                  {%- endif -%}
                  {%- if block.type == '@app' -%}
                    {{ 'products.product.review_app' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
          <div class="tab-content">
            {%- for block in section.blocks %}
              {% assign bk_st = block.settings %}
              <div
                id="proTabs{{ block.id }}"
                class="tab-item transition{% if forloop.first  %} active{% endif %}"
              >
                <div
                  class="tab-panel"
                  {% if forloop.first %}
                    style="display: block;"
                  {% else %}
                    style="display: none;"
                  {% endif %}
                >
                  {%- case block.type -%}
                    {%- when '@app' -%}
                      {% render block %}
                    {%- when 'description' -%}
                      <div class="rte">{{ pit_product.description }}</div>
                    {%- when 'review' -%}
                      <div id="shopify-product-reviews" data-id="{{ pit_product.id }}">
                        {{ pit_product.metafields.spr.reviews }}
                      </div>
                    {%- when 'custom_tab' -%}
                      {% assign tab_content = bk_st.tab_content %}
                      {%- case tab_content -%}
                        {%- when 'content' -%}
                          {% if bk_st.content_rich == blank %}
                            No content available.
                          {% else %}
                            {{ bk_st.content_rich }}
                          {% endif %}
                        {%- when 'content_page' -%}
                          {%- if bk_st.page != blank -%}
                            {{ pages[bk_st.page].content }}
                          {%- endif -%}
                        {% when 'content_custom' %}
                          {% if infomation_meta.value.information_text != blank %}
                            {{ infomation_meta.value.information_text }}
                          {% elsif infomation_meta.value.information_in_page != blank %}
                            {{ pages[infomation_meta.value.information_in_page].content }}
                          {% endif %}
                      {%- endcase -%}
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<script src="{{ 'product_tab.js' | asset_url }}" defer></script>
<script>
  (function () {
    /* product_tab.js binds once on load; a section redrawn in the builder binds its own tabs here. */
    function bindTabs(root) {
      if (!root || root.__pitTabs) return;
      root.__pitTabs = true;
      root.addEventListener('click', function (e) {
        var a = e.target.closest('.nav-tabs a[data-block-id]');
        if (!a || !root.contains(a)) return;
        e.preventDefault();
        var li = a.closest('.data.item');
        if (li && li.classList.contains('active')) return;
        root.querySelectorAll('.nav-tabs .data.item').forEach(function (it) { it.classList.remove('active'); });
        root.querySelectorAll('.tab-content .tab-item').forEach(function (it) {
          it.classList.remove('active');
          var p = it.querySelector('.tab-panel'); if (p) p.style.display = 'none';
        });
        var panel = root.querySelector('#' + a.getAttribute('data-block-id'));
        if (panel) {
          panel.classList.add('active');
          var pp = panel.querySelector('.tab-panel'); if (pp) pp.style.display = 'block';
        }
        if (li) li.classList.add('active');
      });
    }
    if (window.__pitListen) return;
    window.__pitListen = true;
    document.addEventListener('storelib:section-load', function (e) {
      var sec = e.target && e.target.closest ? e.target.closest('.shopify-section') : null;
      if (!sec && e.detail && e.detail.sectionId) sec = document.getElementById('shopify-section-' + e.detail.sectionId);
      if (sec && sec.querySelector('.bls__product-tabs')) bindTabs(sec.querySelector('.bls__product-tabs'));
    });
  })();
{% comment %}{% endcomment %}</script>


</template>

<schema>
{
  "type": "product-information-tab",
  "name": "Product information tab",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "info": "Animates the section into view using Theme settings → Animations.",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout & Spacing"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ],
      "limit": 1
    },
    {
      "type": "custom_tab",
      "name": "Custom tab",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Custom tab"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "content_rich",
          "label": "Content rich",
          "default": "<p>abd</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Advanced"
        },
        {
          "type": "select",
          "id": "tab_content",
          "label": "Tab content",
          "options": [
            {
              "value": "content",
              "label": "Content"
            },
            {
              "value": "content_page",
              "label": "Content page"
            },
            {
              "value": "content_custom",
              "label": "Content custom"
            }
          ]
        }
      ],
      "limit": 4
    }
  ],
  "shopify": {
    "name": "t:sections.product-information-tabs.name",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "description",
        "name": "t:sections.product-information-tabs.settings.description",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Section Header"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Tab title"
          }
        ]
      },
      {
        "type": "custom_tab",
        "name": "t:sections.product-information-tabs.blocks.custom_tab.name",
        "limit": 4,
        "settings": [
          {
            "type": "header",
            "content": "Section Header"
          },
          {
            "type": "text",
            "id": "title",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.title.label",
            "default": "Custom tab"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "content_rich",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.content.label",
            "default": "<p>abd</p>"
          },
          {
            "type": "page",
            "id": "page",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.page.label"
          },
          {
            "type": "header",
            "content": "Advanced"
          },
          {
            "type": "select",
            "id": "tab_content",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.label",
            "options": [
              {
                "value": "content",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__1.label"
              },
              {
                "value": "content_page",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__2.label"
              },
              {
                "value": "content_custom",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__3.label"
              }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.product-information-tabs.name",
        "category": "Products",
        "blocks": [
          {
            "type": "description",
            "settings": {
              "title": "Description"
            }
          },
          {
            "type": "custom_tab"
          }
        ]
      }
    ]
  }
}
</schema>
