<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The 404 page: an icon or picture, then the blocks in their
  order (picture, heading, subheading, text, button). Live edits:
  shopify/assets/live-account-pages.js; a new picture waits for the
  builder's redraw.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign st = section_st
  assign sid = section.id
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign section_width = section_st.section_width
  assign show_icon = section_st.show_404_icon
  assign custom_image = section_st.custom_404_image
  assign icon_size = section_st.icon_size | default: 120
  assign icon_color = section_st.icon_color
  assign icon_spacing = section_st.icon_spacing_bottom | default: 24
  assign custom = section_st.enable_custom_style
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
<style>
  #shopify-section-{{ sid }} > [data-ap-reset] { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} .page-404__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 0 auto var(--ap-icon-gap, 24px);
  }
  #shopify-section-{{ sid }} .page-404__icon-wrap :is(img, svg) {
    display: block;
    width: var(--ap-icon, 96px);
    max-width: 100%;
    height: auto;
  }
  #shopify-section-{{ sid }} .page-404__icon-wrap svg { color: var(--ap-icon-c, var(--color-heading)); }
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .page-404__icon-wrap :is(img, svg) { max-width: min(var(--ap-icon, 96px), 70vw); }
  }
  #shopify-section-{{ sid }} :is(.sec__content-heading, .sec__content-subheading) { color: var(--ap-h-c, var(--color-heading)); }
  #shopify-section-{{ sid }} .sec__content-des { color: var(--ap-t-c, inherit); }
  #shopify-section-{{ sid }} :is(.sec__content-heading, .sec__content-subheading, .sec__content-des).uppercase { text-transform: uppercase !important; }
  /* a block's own weight (Custom weight on) wins over the section's heading weight rule (snippets/theme-type) */
  #shopify-section-{{ sid }} [data-own-weight].body_weight { font-weight: var(--body-weight); }
  #shopify-section-{{ sid }} [data-own-weight].subheading_weight { font-weight: var(--subheading-weight, 600); }
  #shopify-section-{{ sid }} [data-own-weight].heading_weight { font-weight: var(--heading-weight, 600); }
  #shopify-section-{{ sid }} .page-404__image { width: 440px; max-width: 100%; margin-bottom: 40px; }
{% comment %}{% endcomment %}</style>
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list color-{{ color_scheme }} gradient"
  data-ap-root="page-404"
  data-ap-section="{{ sid }}"
  data-ap-settings="{{ st | json | escape }}"
  {% if st.reset_spacing %}data-ap-reset{% endif %}
  style="--section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --max-width: 50rem; --ap-icon: {{ icon_size }}px; --ap-icon-gap: {{ icon_spacing }}px;{% if custom and icon_color != blank %} --ap-icon-c: {% render 'scheme-color', color: icon_color, fallback: 'var(--color-heading)' %};{% endif %}{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  <div class="{{ section_width }} flex justify-center align-center flex-column text-center" data-ap-width>
    <div class="page-404__icon-wrap" data-ap-show="show_404_icon"{% unless show_icon %} hidden{% endunless %}>
      {%- if custom_image != blank -%}
        {%- assign img_alt = custom_image.alt | default: '' | escape -%}
        <img
          src="{{ custom_image | image_url: width: 800 }}"
          alt="{{ img_alt }}"
          width="{{ icon_size }}"
          height="{{ icon_size | divided_by: custom_image.aspect_ratio | round }}"
          fetchpriority="high"
        >
      {%- else -%}
        <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="32" cy="32" r="26" stroke-opacity="0.85"/>
          <path d="M22 26h.02"/>
          <path d="M42 26h.02"/>
          <path d="M22 42c2.5-3 6-4.5 10-4.5s7.5 1.5 10 4.5"/>
        </svg>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- liquid
        assign block_st = block.settings
        assign image = block_st.image
        assign open_link = block_st.open_link
        if block_st.spacing_bottom > 41
          assign mb_custom = 'mb-big'
        elsif block_st.spacing_bottom > 30
          assign mb_custom = 'mb-medium'
        else
          assign mb_custom = 'mb-custom'
        endif
        assign uppercase = ''
        if block_st.uppercase
          assign uppercase = 'uppercase'
        endif
        if block_st.font_size > 41
          assign fs_custom = 'fs-big'
        elsif block_st.font_size > 24
          assign fs_custom = 'fs-medium'
        else
          assign fs_custom = 'fs-custom'
        endif
        assign font_weight = ''
        if block_st.custom_weight
          assign font_weight = block_st.font_weight
        endif
      -%}
      {%- case block.type -%}
        {%- when 'image' -%}
          <div class="page-404__image" style="--aspect-ratio: {{ image.aspect_ratio | default: 1.5 }};" data-ap-block="{{ block.id }}" data-ap-type="image" data-ap-settings="{{ block_st | json | escape }}"{% if image == blank and request.design_mode != true %} hidden{% endif %} {{ block.shopify_attributes }}>
            {%- if image != blank -%}
              {%- assign image_alt = image.alt | escape -%}
              {% render 'responsive-image', image: image, image_alt: image_alt, no_animate: true %}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-auto' }}
            {%- endif -%}
          </div>
        {%- when 'heading' -%}
          <h2
            class="sec__content-heading heading-letter-spacing mt-0 {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
            data-ap-block="{{ block.id }}" data-ap-type="heading" data-ap-settings="{{ block_st | json | escape }}" data-ap-btext="heading" data-ap-opt
            {% if block_st.custom_weight %}data-own-weight{% endif %}
            {% if block_st.heading == blank %}hidden{% endif %}
            {{ block.shopify_attributes }}
          >{{ block_st.heading }}</h2>
        {%- when 'subheading' -%}
          <div
            class="sec__content-subheading heading {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
            data-ap-block="{{ block.id }}" data-ap-type="subheading" data-ap-settings="{{ block_st | json | escape }}" data-ap-btext="subheading" data-ap-opt
            {% if block_st.custom_weight %}data-own-weight{% endif %}
            {% if block_st.subheading == blank %}hidden{% endif %}
            {{ block.shopify_attributes }}
          >{{ block_st.subheading | escape }}</div>
        {%- when 'description' -%}
          <div
            class="sec__content-des rich__text-m0 {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ block_st.font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
            data-ap-block="{{ block.id }}" data-ap-type="description" data-ap-settings="{{ block_st | json | escape }}" data-ap-brich="description" data-ap-opt
            {% if block_st.description == blank %}hidden{% endif %}
            {{ block.shopify_attributes }}
          >{{ block_st.description }}</div>
        {%- when 'button' -%}
          <div
            class="sec__content-btn align-center flex flex-wrap gap-15 justify-content-center {{ mb_custom }}"
            style="--space-bottom: {{ block_st.spacing_bottom }}"
            data-ap-block="{{ block.id }}" data-ap-type="button" data-ap-settings="{{ block_st | json | escape }}"
            {% if block_st.first_button_label == blank %}hidden{% endif %}
            {{ block.shopify_attributes }}
          >
            <a
              {% if block_st.first_button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block_st.first_button_link | url }}"{% endif %}
              {% if open_link %}target="_blank" rel="noopener"{% endif %}
              class="inline-flex no-underline btn-{{ block_st.first_button_type }}"
              data-theme-button="primary" data-sl-button
              data-button-local-appearance="{% if block_st.first_button_type == 'outline' %}outline{% else %}theme{% endif %}"
            >{{ block_st.first_button_label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>
</template>

<schema>
{
  "type": "page-404",
  "name": "404 page",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Media"
    },
    {
      "type": "checkbox",
      "id": "show_404_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "custom_404_image",
      "label": "Picture instead of the icon",
      "info": "Overrides the default 404 icon.",
      "visible_if": "{{ section.settings.show_404_icon }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96,
      "visible_if": "{{ section.settings.show_404_icon }}"
    },
    {
      "type": "range",
      "id": "icon_spacing_bottom",
      "label": "Space below the icon",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.show_404_icon }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_404_icon and section.settings.custom_404_image == blank }}",
      "info": "Colours the theme's icon, used while no custom image is picked."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 80,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Picture",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Page not found"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Text size",
          "default": 36,
          "min": 24,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "custom_weight",
          "label": "Custom weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Weight",
          "default": "heading_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading"
            },
            {
              "value": "heading_weight",
              "label": "Heading"
            }
          ],
          "visible_if": "{{ block.settings.custom_weight }}"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Desktop spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Space below",
          "default": 24,
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Error 404"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Text size",
          "default": 14,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "custom_weight",
          "label": "Custom weight",
          "default": false
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Weight",
          "default": "subheading_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading"
            },
            {
              "value": "heading_weight",
              "label": "Heading"
            }
          ],
          "visible_if": "{{ block.settings.custom_weight }}"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Desktop spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Space below",
          "default": 15,
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Text",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Sorry for the inconvenience. Go to our <a href=\"/\">homepage</a> or check out our <a href=\"/collections\">latest collections</a>.</p>",
          "label": "Text"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Text size",
          "default": 14,
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Weight",
          "default": "body_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading"
            },
            {
              "value": "heading_weight",
              "label": "Heading"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Desktop spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Space below",
          "default": 25,
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 3
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "first_button_label",
          "default": "Back to homepage",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "first_button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "open_link",
          "label": "Open in a new tab",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Appearance"
        },
        {
          "type": "select",
          "id": "first_button_type",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_7",
          "label": "Desktop spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Space below",
          "default": 24,
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 1
    }
  ],
  "shopify": {
    "name": "404 page",
    "tag": "section",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "checkbox",
        "id": "show_404_icon",
        "label": "Show icon",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "custom_404_image",
        "label": "Picture instead of the icon",
        "info": "Overrides the default 404 icon.",
        "visible_if": "{{ section.settings.show_404_icon }}"
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 96,
        "visible_if": "{{ section.settings.show_404_icon }}"
      },
      {
        "type": "range",
        "id": "icon_spacing_bottom",
        "label": "Space below the icon",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 24,
        "visible_if": "{{ section.settings.show_404_icon }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon color",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_404_icon and section.settings.custom_404_image == blank }}",
        "info": "Colours the theme's icon, used while no custom image is picked."
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 60,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 80,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Picture",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Media"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Picture"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Page not found"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "default": 36,
            "min": 24,
            "max": 100,
            "step": 1,
            "unit": "px"
          },
          {
            "type": "checkbox",
            "id": "custom_weight",
            "label": "Custom weight",
            "default": false
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Weight",
            "default": "heading_weight",
            "options": [
              {
                "value": "body_weight",
                "label": "Body"
              },
              {
                "value": "subheading_weight",
                "label": "Subheading"
              },
              {
                "value": "heading_weight",
                "label": "Heading"
              }
            ],
            "visible_if": "{{ block.settings.custom_weight }}"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase",
            "default": false
          },
          {
            "type": "header",
            "content": "Desktop spacing"
          },
          {
            "type": "range",
            "id": "spacing_bottom",
            "label": "Space below",
            "default": 24,
            "min": 0,
            "max": 30,
            "step": 1,
            "unit": "px"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Error 404"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "default": 14,
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px"
          },
          {
            "type": "checkbox",
            "id": "custom_weight",
            "label": "Custom weight",
            "default": false
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Weight",
            "default": "subheading_weight",
            "options": [
              {
                "value": "body_weight",
                "label": "Body"
              },
              {
                "value": "subheading_weight",
                "label": "Subheading"
              },
              {
                "value": "heading_weight",
                "label": "Heading"
              }
            ],
            "visible_if": "{{ block.settings.custom_weight }}"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase",
            "default": false
          },
          {
            "type": "header",
            "content": "Desktop spacing"
          },
          {
            "type": "range",
            "id": "spacing_bottom",
            "label": "Space below",
            "default": 15,
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px"
          }
        ]
      },
      {
        "type": "description",
        "name": "Text",
        "limit": 3,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "description",
            "default": "<p>Sorry for the inconvenience. Go to our <a href=\"/\">homepage</a> or check out our <a href=\"/collections\">latest collections</a>.</p>",
            "label": "Text"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "default": 14,
            "min": 10,
            "max": 30,
            "step": 1,
            "unit": "px"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Weight",
            "default": "body_weight",
            "options": [
              {
                "value": "body_weight",
                "label": "Body"
              },
              {
                "value": "subheading_weight",
                "label": "Subheading"
              },
              {
                "value": "heading_weight",
                "label": "Heading"
              }
            ]
          },
          {
            "type": "header",
            "content": "Desktop spacing"
          },
          {
            "type": "range",
            "id": "spacing_bottom",
            "label": "Space below",
            "default": 25,
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "first_button_label",
            "default": "Back to homepage",
            "label": "Button label"
          },
          {
            "type": "url",
            "id": "first_button_link",
            "label": "Button link"
          },
          {
            "type": "checkbox",
            "id": "open_link",
            "label": "Open in a new tab",
            "default": false
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "select",
            "id": "first_button_type",
            "label": "Button style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Solid"
              },
              {
                "value": "outline",
                "label": "Outline"
              },
              {
                "value": "link",
                "label": "Link"
              }
            ]
          },
          {
            "type": "header",
            "content": "Desktop spacing"
          },
          {
            "type": "range",
            "id": "spacing_bottom",
            "label": "Space below",
            "default": 24,
            "min": 0,
            "max": 30,
            "step": 1,
            "unit": "px"
          }
        ]
      }
    ]
  }
}
