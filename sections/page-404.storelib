<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign show_icon = section_st.show_404_icon
  assign custom_image = section_st.custom_404_image
  assign icon_size = section_st.icon_size | default: 120
  assign icon_color = section_st.icon_color
  assign icon_spacing = section_st.icon_spacing_bottom | default: 24
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--max-width: 50rem;
{%- endcapture -%}

{% render 'theme-type' %}
<style>
  .page-404__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 0 auto;
  }
  .page-404__icon-wrap img,
  .page-404__icon-wrap svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 749px) {
    .page-404__icon-wrap img,
    .page-404__icon-wrap svg {
      max-width: min({{ icon_size }}px, 70vw);
    }
  }
{% comment %}{% endcomment %}</style>

<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }} flex justify-center align-center flex-column text-center">
    {%- if show_icon -%}
      <div class="page-404__icon-wrap" style="margin-bottom: {{ icon_spacing }}px;">
        {%- if custom_image != blank -%}
          {%- assign img_alt = custom_image.alt | default: '404 not found' | escape -%}
          <img
            src="{{ custom_image | image_url: width: 800 }}"
            alt="{{ img_alt }}"
            width="{{ icon_size }}"
            loading="lazy"
            style="width: {{ icon_size }}px; height: auto; max-width: 100%;"
          />
        {%- else -%}
          <svg
            width="{{ icon_size }}"
            height="{{ icon_size }}"
            viewBox="0 0 64 64"
            fill="none"
            stroke="{% if icon_color != blank %}{{ icon_color }}{% else %}currentColor{% endif %}"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            style="{% if icon_color != blank %}color: {{ icon_color }} !important;{% endif %}"
          >
            <circle cx="32" cy="32" r="26" stroke-opacity="0.85"/>
            <path d="M22 26h.02"/>
            <path d="M42 26h.02"/>
            <path d="M22 42c2.5-3 6-4.5 10-4.5s7.5 1.5 10 4.5"/>
          </svg>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign block_st = block.settings
        assign image = block_st.image
        assign open_link = block_st.open_link
        assign mb_custom = ''
        if block_st.spacing_bottom > 41
          assign mb_custom = 'mb-big'
        elsif block_st.spacing_bottom > 30
          assign mb_custom = 'mb-medium'
        else
          assign mb_custom = 'mb-custom'
        endif
        assign uppercase = ''
        if block_st.uppercase
          assign uppercase = 'uppercase'
        endif
        assign fs_custom = ''
        if block_st.font_size > 41
          assign fs_custom = 'fs-big'
        elsif block_st.font_size > 24
          assign fs_custom = 'fs-medium'
        else
          assign fs_custom = 'fs-custom'
        endif
        assign font_weight = block_st.font_weight
      -%}
      {%- case block.type -%}
        {%- when 'image' -%}
          {% if image != blank %}
            <div
              class="mb-40 max-w-100"
              style="{%- if image != blank -%}--aspect-ratio: {{ image.aspect_ratio }};{% endif %}; width: 440px"
            >
              {%- assign image_alt = image.alt | escape | default: 'image' -%}
              {% render 'responsive-image', image: image, image_alt: image_alt, no_animate: true %}
            </div>
          {% endif %}
        {%- when 'heading' -%}
          <h2
            class="sec__content-heading heading-letter-spacing mt-0 {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
            {{ block.shopify_attributes }}
          >
            {{ block_st.heading }}
          </h2>
        {%- when 'subheading' -%}
          <div
            class="sec__content-subheading heading  {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
          >
            {{ block_st.subheading | escape }}
          </div>
        {%- when 'description' -%}
          <div
            class="sec__content-des rich__text-m0 {{ mb_custom }} {{ uppercase }} {{ fs_custom }} {{ font_weight }}"
            style="--font-size: {{ block_st.font_size }};--space-bottom: {{ block_st.spacing_bottom }}"
            {{ block.shopify_attributes }}
          >
            {{ block_st.description }}
          </div>
        {%- when 'button' -%}
          {% if block_st.first_button_label != blank or block_st.second_button_label != blank %}
            <div
              class="sec__content-btn align-center flex flex-wrap gap-15 justify-content-{{ section_st.content_alignment_mobile }} justify-content-md-{{ section_st.content_alignment }} {{ mb_custom }}"
              style="--space-bottom: {{ block_st.spacing_bottom }}"
            >
              {% if block_st.first_button_label != blank %}
                <a
                  {% if block_st.first_button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block_st.first_button_link | default: "#" }}"
                  {% endif %}
                  aria-label="{{ block_st.first_button_label }}"
                  {%- if open_link != blank -%}
                    target="_blank"
                  {% endif %}
                  class="inline-flex no-underline btn-{{ block_st.first_button_type }}"
                  data-theme-button="{% if block_st.first_button_type == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button
                  data-button-local-appearance="{% if block_st.first_button_type == 'outline' %}outline{% else %}theme{% endif %}"
                >
                  {{ block_st.first_button_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>



</template>

<schema>
{
  "type": "page-404",
  "name": "404 page",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_404_icon",
      "label": "Show 404 icon",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "custom_404_image",
      "label": "Custom image (optional)",
      "info": "Overrides the default 404 icon."
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Only applies to the default icon (not custom images). Leave blank to inherit the page text color."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "icon_spacing_bottom",
      "label": "Spacing below icon",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 80,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Advanced"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Image / Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Page not found"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "default": 36,
          "min": 24,
          "max": 100,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "heading_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body weight"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading weight"
            },
            {
              "value": "heading_weight",
              "label": "Heading weight"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Spacing bottom",
          "default": 24,
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Advanced"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Error 404"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "default": 14,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "subheading_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body weight"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading weight"
            },
            {
              "value": "heading_weight",
              "label": "Heading weight"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Spacing bottom",
          "default": 15,
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Advanced"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase"
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Sorry for the inconvenience. Go to our <a href=\"/\">homepage</a> or check out our <a href=\"/collections\">latest collections</a>.</p>",
          "label": "Description"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "default": 14,
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "body_weight",
          "options": [
            {
              "value": "body_weight",
              "label": "Body weight"
            },
            {
              "value": "subheading_weight",
              "label": "Subheading weight"
            },
            {
              "value": "heading_weight",
              "label": "Heading weight"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Spacing bottom",
          "default": 25,
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px"
        }
      ],
      "limit": 3
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "first_button_link",
          "label": "First button link"
        },
        {
          "type": "checkbox",
          "id": "open_link",
          "label": "Open link",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Buttons"
        },
        {
          "type": "text",
          "id": "first_button_label",
          "default": "Back to homepage",
          "label": "First button label"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
          "label": "Spacing bottom",
          "default": 24,
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px"
        },
        {
