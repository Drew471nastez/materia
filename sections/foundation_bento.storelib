<template>
<section class="fw fw-bento" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ settings.heading_color }};--fw-text:{{ settings.text_color }};--fw-muted:{{ settings.text_color }};--fw-line:{{ settings.border_color }};--fw-accent:{{ settings.overline_color }};--fw-card:{{ settings.card_color }};--fw-card-text:{{ settings.card_text_color }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner">
  {% if settings.eyebrow or settings.heading or settings.intro %}<div class="fw-bento__intro"><div>{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}{% if settings.heading %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% endif %}</div>{% if settings.intro %}<p>{{ settings.intro }}</p>{% endif %}</div>{% endif %}
  {% for block in blocks %}
   {% if forloop.first %}<div class="fw-bento__grid">{% endif %}
   <a class="fw-bento__card" href="{{ block.settings.url | default: '/products' | url }}" data-block-id="{{ block.id }}">
    {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" width="1200" height="1200" loading="lazy" decoding="async" alt="{{ block.settings.image_alt }}">{% else %}<span class="fw-bento__figure" aria-hidden="true"><span></span></span>{% endif %}
    <span class="fw-bento__veil"></span><span class="fw-bento__content">{% if block.settings.kicker %}<small>{{ block.settings.kicker }}</small>{% endif %}<strong>{{ block.settings.title }}</strong><span aria-hidden="true">↗</span></span>
   </a>
   {% if forloop.last %}</div>{% endif %}
  {% else %}
   {% if page.in_editor %}<p class="fw-bento__empty">Add cards in the sidebar.</p>{% endif %}
  {% endfor %}
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--theme-font-body,var(--body-font,inherit));}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) var(--theme-padding-x,clamp(16px,4cqi,48px)) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:var(--sl-caption-size,12px);font-weight:var(--sl-caption-weight,700);letter-spacing:var(--sl-caption-tracking,.14em);text-transform:var(--sl-caption-transform,uppercase);color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading,var(--heading-font,inherit)));font-size:var(--section-heading-size,clamp(28px,6cqi,56px));font-weight:var(--section-heading-weight,650);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.03em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:16px 0 0;font-size:var(--section-text-size,16px);line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-weight:var(--type-button-weight,650);font-size:var(--sl-button-size,var(--type-button-size,15px));letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text);border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw__action:hover{background:var(--fw-button-hover,var(--fw-button));border-color:var(--fw-button-hover,var(--fw-button));color:var(--fw-button-hover-text,var(--fw-button-text));}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible,.fw [tabindex]:focus-visible{outline:2px solid currentColor;outline-offset:3px;}
@media(prefers-reduced-motion:reduce){.fw *,.fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-bento__intro{margin-bottom:28px}
.fw-bento__intro>p{max-width:37ch;font-size:15px;line-height:1.7;color:var(--fw-muted);margin:12px 0 0}
.fw-bento__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:15px}
.fw-bento__card{position:relative;display:block;min-height:310px;overflow:hidden;border-radius:var(--sl-image-radius,16px);text-decoration:none;isolation:isolate;background:var(--fw-card)}
.fw-bento__card img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;transition:transform .55s cubic-bezier(.2,.8,.2,1)}
.fw-bento__card:hover img{transform:scale(1.045)}
.fw-bento__figure{position:absolute;inset:0;background:radial-gradient(circle at 70% 28%,color-mix(in srgb,var(--fw-bg) 55%,transparent),transparent 41%),linear-gradient(120deg,var(--fw-card),color-mix(in srgb,var(--fw-card) 70%,var(--fw-title)))}
.fw-bento__figure>span{position:absolute;inset:16% 25% 13%;border-radius:50% 50% 12% 12%;transform:rotate(-19deg);background:linear-gradient(120deg,color-mix(in srgb,var(--fw-card) 75%,var(--fw-title)),color-mix(in srgb,var(--fw-card) 60%,var(--fw-bg)));box-shadow:18px 30px 44px color-mix(in srgb,var(--fw-title) 15%,transparent)}
.fw-bento__veil{position:absolute;inset:0;background:linear-gradient(transparent 48%,rgb(0 0 0 / .55))}
.fw-bento__content{position:absolute;bottom:23px;left:23px;right:24px;color:var(--fw-card-text);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:end}
.fw-bento__content small{grid-column:1/-1;font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.9}
.fw-bento__content strong{font-family:var(--section-heading-font,var(--theme-font-heading,var(--heading-font,inherit)));font-size:clamp(23px,2.7cqi,38px);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.03em);font-weight:var(--section-heading-weight,650);overflow-wrap:anywhere}
.fw-bento__content>span{font-size:25px}
.fw-bento__card:focus-visible{outline-offset:4px}
.fw-bento__empty{margin:0;font-size:14px;color:var(--fw-muted)}
@container (min-width:651px){
 .fw-bento__intro{display:flex;align-items:end;justify-content:space-between;gap:24px}
 .fw-bento__intro>p{margin:0}
 .fw-bento__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .fw-bento__card{min-height:300px}
 .fw-bento__card:first-child{grid-row:span 2;min-height:615px}
 .fw-bento__card:nth-child(4){grid-column:span 2;min-height:330px}
 .fw-bento__content{bottom:26px;left:30px}
}
@media (prefers-reduced-motion:reduce){.fw-bento__card:hover img{transform:none}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_bento",
  "name": "Foundation / Editorial bento",
  "category": "images",
  "description": "Materia-inspired asymmetrical bento cards with image placeholders and editable links.",
  "version": "1.0.0",
  "icon": "grid",
  "settings": [
    {
      "type": "header",
      "id": "hdr_general",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "BROWSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Supporting text",
      "default": "Pick a category to see what is in it."
    },
    {
      "type": "header",
      "id": "hdr_colours",
      "label": "Colours"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "scheme.text"
    },
    {
      "type": "color",
      "id": "overline_color",
      "label": "Overline",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lines",
      "default": "scheme.border"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card without a picture",
      "default": "scheme.background_secondary"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card words",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "id": "hdr_animation",
      "label": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "none",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "slide_left",
          "label": "From the right"
        },
        {
          "value": "slide_right",
          "label": "From the left"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Editorial tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Overline",
          "default": "COLLECTION"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "All products"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/products"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Picture description",
          "default": ""
        }
      ]
    }
  ]
}
</schema>
