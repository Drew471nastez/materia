<template>
<section class="fw fw-bento" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.heading }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner">
  <div class="fw-bento__intro"><div>{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2></div>{% if settings.intro %}<p>{{ settings.intro }}</p>{% endif %}</div>
  <div class="fw-bento__grid">
   {% for block in blocks %}<a class="fw-bento__card" href="{{ block.settings.url | default: '/products' | url }}" data-block-id="{{ block.id }}">
    {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" loading="lazy" decoding="async" alt="{{ block.settings.image_alt }}">{% else %}<span class="fw-bento__figure" aria-hidden="true"><span></span></span>{% endif %}
    <span class="fw-bento__veil"></span><span class="fw-bento__content"><small>{{ block.settings.kicker }}</small><strong>{{ block.settings.title }}</strong><span aria-hidden="true">↗</span></span>
   </a>{% endfor %}
  </div>
  {% if blocks.size == 0 and page.in_editor %}<p>Add cards in the sidebar.</p>{% endif %}
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--theme-font-body),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) clamp(18px,4vw,48px) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:11px;font-weight:var(--subheading-weight,800);letter-spacing:.16em;text-transform:uppercase;color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading)),sans-serif;font-size:var(--section-heading-size,clamp(30px,4.2cqi,56px));font-weight:var(--section-heading-weight,650);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.044em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--theme-font-body),sans-serif;font-size:var(--section-text-size,clamp(15px,1.45cqi,18px));line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-family:var(--theme-font-body),sans-serif;font-weight:var(--type-button-weight,650);font-size:var(--type-button-size,14px);letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text)!important;border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw__action:hover{background:var(--scheme-button-primary-hover,var(--fw-button));color:var(--scheme-button-primary-hover-text,var(--fw-button-text))!important;}
.fw__action--secondary{background:transparent!important;color:var(--fw-title)!important;border-color:var(--fw-line);}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-bento__intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.fw-bento__intro>p{max-width:37ch;font-size:14px;line-height:1.7;color:var(--fw-muted);margin:0}.fw-bento__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.fw-bento__card{position:relative;display:block;min-height:300px;overflow:hidden;border-radius:16px;text-decoration:none;isolation:isolate;background:#d6ded5}.fw-bento__card:first-child{grid-row:span 2;min-height:615px}.fw-bento__card:nth-child(2){background:#d8d2c8}.fw-bento__card:nth-child(3){background:#d3d9da}.fw-bento__card img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;transition:transform .55s cubic-bezier(.2,.8,.2,1)}.fw-bento__card:hover img{transform:scale(1.045)}.fw-bento__figure{position:absolute;inset:0;background:radial-gradient(circle at 70% 28%,#ffffff89,transparent 41%),linear-gradient(120deg,#bbcfc3,#769985)}.fw-bento__figure>span{position:absolute;inset:16% 25% 13%;border-radius:50% 50% 12% 12%;transform:rotate(-19deg);background:linear-gradient(120deg,#7f9d8e,#e0e7dc);box-shadow:18px 30px 44px #26362b27}.fw-bento__veil{position:absolute;inset:0;background:linear-gradient(transparent 48%,#0000008c);}.fw-bento__content{position:absolute;bottom:26px;left:30px;right:24px;color:white;display:grid;grid-template-columns:1fr auto;gap:6px;align-items:end}.fw-bento__content small{grid-column:1/-1;font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.85}.fw-bento__content strong{font-family:var(--section-heading-font,var(--theme-font-heading)),sans-serif;font-size:clamp(23px,2.7cqi,38px);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.03em);font-weight:var(--section-heading-weight,650)}.fw-bento__content>span{font-size:25px}.fw-bento__card:nth-child(4){grid-column:span 2;min-height:330px}
@container(max-width:650px){.fw-bento__intro{display:block}.fw-bento__intro>p{margin-top:12px}.fw-bento__grid{grid-template-columns:1fr}.fw-bento__card,.fw-bento__card:first-child,.fw-bento__card:nth-child(4){min-height:310px;grid-column:auto;grid-row:auto}.fw-bento__content{bottom:23px;left:23px}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_bento",
  "name": "Foundation / Editorial bento",
  "category": "images",
  "description": "Materia-inspired asymmetrical bento cards with image placeholders and editable links.",
  "version": "1.0.0",
  "icon": "grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "BROWSE BY INTEREST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next favourite."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Supporting text",
      "default": "A little something for every mood and moment."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "none",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "slide_left",
          "label": "From the right"
        },
        {
          "value": "slide_right",
          "label": "From the left"
        }
      ]
    }
  ],
  "presets": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Editorial tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Overline",
          "default": "COLLECTION"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The essentials"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/products"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description",
          "default": "Collection photo"
        }
      ]
    }
  ]
}
</schema>
