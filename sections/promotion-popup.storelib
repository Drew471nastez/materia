<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<style>
  /* Theme editor: force popup-style sections (fixed/centered) to render inline so a preview shows */
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="-popup"],
  .shopify-design-mode #shopify-section-{{ section.id }} .popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .modal,
  .shopify-design-mode #shopify-section-{{ section.id }} [data-popup],
  .shopify-design-mode #shopify-section-{{ section.id }} > .promotional,
  .shopify-design-mode #shopify-section-{{ section.id }} .age-verifier-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotion-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promobanner,
  .shopify-design-mode #shopify-section-{{ section.id }} .newsletter-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promo-newsletter-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotional-image-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotional-popup {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    display: block !important;
    margin: 20px auto !important;
    z-index: auto !important;
    pointer-events: auto !important;
  }
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="overlay"],
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="backdrop"] {
    display: none !important;
  }
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign show_promotion_mobile = section_st.show_promotion_mobile
  assign code = section_st.promotion_code
  assign width = section_st.promotion_width
  assign heading = section_st.promotion_title
  assign sub_title = section_st.promotion_sub_title
  assign background_image = section_st.promotion_banner
  assign promotion_content = section_st.promotion_content
  assign show_promotion_select = section_st.show_promotion_select

  assign show = 'hidden'
  if show_promotion_select == 'show_promotion_homepage'
    if request.page_type == 'index'
      assign show = 'show-on-homepage'
    endif
  elsif show_promotion_select == 'hide_promotion'
    assign show = 'hidden'
  else
    assign show = 'show-on-all-pages'
  endif
-%}
{%- capture style -%}
--popup-max-width: {{ width }}px;
{%- endcapture -%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if lis_language_rtl contains iso_code
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<promotion-popup
  id="promotion-popup"
  data-show="{{ show }}"
  data-show-mb="{{ show_promotion_mobile }}"
  style="display: none;"
  {% if show_promotion_mobile != blank %}
    class="hidden block-md"
  {% endif %}
>
  <div
    class="popup-content flex{% if enable_rtl %} flex-row-reverse{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    {% if background_image != blank %}
      <div
        class="newsletter-popup__banner relative hidden block-md col-w-custom"
        style="--col-width: {{ section.settings.banner_width }}%;--aspect-ratio: {{ background_image.aspect_ratio }}"
      >
        {%- assign image_alt = background_image.alt | default: 'product' | escape -%}
        {% render 'responsive-image',
          type: 'other',
          image: background_image,
          image_alt: image_alt,
          class: 'absolute inset-0 w-full h-full object-fit-cover'
        %}
      </div>
    {% endif %}
    <div class="promotion__popup-content flex-1 relative">
      <div class="content-promotion text-center p-1025-40 p-30 {% if background_image != blank %}absolute-md inset-0 flex flex-column{% endif %} overflow-y-auto custom-scrollbar h-full w-full">
        <div class="my-auto">
          <div class="section-header">
            {%- if sub_title != blank -%}
              <div class="section-des mb-10 lh-normal h6 mt-0">
                {{ sub_title }}
              </div>
            {% endif %}
            {%- if heading != blank -%}
              <h2 class="section-heading mt-0 mb-15 heading-letter-spacing">{{ heading }}</h2>
            {% endif %}
          </div>
          {%- if promotion_content != blank -%}
            <div class="promotion-content">
              {{ promotion_content | replace: '[promotion_code]', code }}
            </div>
          {% endif %}
          <a
            href="#"
            class="btn-primary w-full discount btn-promotion my-25 inline-flex content-center gap-5 no-underline uppercase"
            data-code="{{ code }}"
            aria-label="{{ 'popup.copy' | t }}"
          >
            <svg width="16" height="14" fill="none">
              <path fill="currentColor" fill-rule="evenodd" d="M14.286 4.667v7.583H4.57V4.667h9.715ZM16 4.375c0-.805-.64-1.458-1.429-1.458H4.286c-.79 0-1.429.653-1.429 1.458v8.167c0 .805.64 1.458 1.429 1.458H14.57c.79 0 1.429-.653 1.429-1.458V4.375Z" clip-rule="evenodd"/><path fill="currentColor" fill-rule="evenodd" d="M13.43.875A.866.866 0 0 0 12.573 0H1.43C1.05 0 .687.154.42.427A1.474 1.474 0 0 0 0 1.458V10.5c0 .484.384.875.857.875a.866.866 0 0 0 .857-.875V1.75h10.857a.866.866 0 0 0 .858-.874Z" clip-rule="evenodd"/>
            </svg>
            <span class="text relative">
              <span class="copied-action">
                {{ code }}
              </span>
              <span class="copied-success absolute invisible inset-y-0 left-0 inline-flex content-center">
                {{- 'popup.copied' | t -}}
              </span>
            </span>
          </a>
          <div class="do-not-show-again pointer fs-small">
            <span class="border-bottom">{{ 'popup.do_not' | t }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</promotion-popup>


</template>

<schema>
{
  "type": "promotion-popup",
  "name": "Promotion popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "promotion_width",
      "label": "Promotion width",
      "max": 800,
      "min": 400,
      "step": 10,
      "unit": "px",
      "default": 690
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Trigger / Display Behavior"
    },
    {
      "type": "select",
      "id": "show_promotion_select",
      "label": "Show promotion select",
      "default": "show_promotion_homepage",
      "options": [
        {
          "value": "show_promotion_homepage",
          "label": "Show promotion homepage"
        },
        {
          "value": "show_promotion_all_page",
          "label": "Show promotion all page"
        },
        {
          "value": "hide_promotion",
          "label": "Hide promotion"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_promotion_mobile",
      "label": "Show promotion mobile",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "promotion_sub_title",
      "label": "Promotion sub title",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "promotion_title",
      "label": "Promotion title",
      "default": "Cyber <br/> Monday"
    },
    {
      "type": "textarea",
      "id": "promotion_content",
      "label": "Promotion content",
      "default": "Up to <span>50% Off</span> when using code [promotion_code]"
    },
    {
      "type": "text",
      "id": "promotion_code",
      "label": "Promotion code"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "promotion_banner",
      "label": "Promotion banner"
    },
    {
      "type": "range",
      "id": "banner_width",
      "label": "Banner width",
      "max": 50,
      "min": 20,
      "step": 0.5,
      "unit": "%",
      "default": 36.5
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Promo — Promotion Popup",
      "category": "Promotional Popup"
    }
  ],
  "enabled_on": {
    "groups": [
      "overlay"
    ]
  },
  "shopify": {
    "name": "t:sections.promotion-popup.name",
    "tag": "section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "limit": 1,
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "range",
        "id": "promotion_width",
        "label": "t:sections.promotion-popup.settings.width.label",
        "max": 800,
        "min": 400,
        "step": 10,
        "unit": "px",
        "default": 690
      },
      {
        "type": "header",
        "content": "Trigger / Display Behavior"
      },
      {
        "type": "select",
        "id": "show_promotion_select",
        "label": "t:sections.promotion-popup.settings.show.label",
        "default": "show_promotion_homepage",
        "options": [
          {
            "value": "show_promotion_homepage",
            "label": "t:sections.promotion-popup.settings.show.show_homepage.label"
          },
          {
            "value": "show_promotion_all_page",
            "label": "t:sections.promotion-popup.settings.show.show_all_page.label"
          },
          {
            "value": "hide_promotion",
            "label": "t:sections.promotion-popup.settings.show.hide.label"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_promotion_mobile",
        "label": "t:sections.promotion-popup.settings.show_on_mobile.label",
        "default": false
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "promotion_sub_title",
        "label": "t:sections.all.contents.subheading.label",
        "default": "Special Offer"
      },
      {
        "type": "text",
        "id": "promotion_title",
        "label": "t:sections.all.contents.heading.label",
        "default": "Cyber <br/> Monday"
      },
      {
        "type": "textarea",
        "id": "promotion_content",
        "label": "t:sections.promotion-popup.settings.promotion_content.label",
        "default": "Up to <span>50% Off</span> when using code [promotion_code]",
        "info": "t:sections.promotion-popup.settings.promotion_content.info"
      },
      {
        "type": "text",
        "id": "promotion_code",
        "label": "t:sections.promotion-popup.settings.promotion_code.label"
      },
      {
        "type": "header",
        "content": "Image / Media"
      },
      {
        "type": "image_picker",
        "id": "promotion_banner",
        "label": "t:sections.newsletter_popup.settings.banner_image",
        "info": "t:sections.newsletter_popup.settings.info"
      },
      {
        "type": "range",
        "id": "banner_width",
        "label": "t:sections.newsletter_popup.settings.banner_width",
        "max": 50,
        "min": 20,
        "step": 0.5,
        "unit": "%",
        "default": 36.5
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses your global Animations & motion setting."
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Promo — Promotion Popup",
        "category": "Promotional Popup"
      }
    ]
  }
}
</schema>
