  "presets": [
    {
      "name": "Promo — Promotion Popup",
      "category": "Promotional Popup"
    }
  ],
  "enabled_on": {
    "groups": [
      "overlay"
    ]
  },
  "shopify": {
    "name": "t:sections.promotion-popup.name",
    "tag": "section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "hidden": true,
        "info": "Not used: the popup sets its own width (Popup width)."
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section spacing",
        "default": true,
        "hidden": true,
        "info": "Not used: a popup takes no space in the page."
      },
      {
        "type": "header",
        "content": "Display"
      },
      {
        "type": "select",
        "id": "show_promotion_select",
        "label": "Show on",
        "default": "show_promotion_homepage",
        "options": [
          {
            "value": "show_promotion_homepage",
            "label": "Home page"
          },
          {
            "value": "show_promotion_all_page",
            "label": "All pages"
          },
          {
            "value": "hide_promotion",
            "label": "Nowhere"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_promotion_mobile",
        "label": "Show on phones",
        "default": false
      },
      {
        "type": "range",
        "id": "delay",
        "label": "Open after",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "s",
        "default": 15
      },
      {
        "type": "range",
        "id": "hide_days",
        "label": "Ask again after",
        "min": 1,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 1,
        "info": "Days, once a visitor copies the code or clicks don't show again."
      },
      {
        "type": "checkbox",
        "id": "editor_preview",
        "label": "Show in the builder",
        "default": true,
        "info": "Draws the popup in the page while you edit. Off, it shows while the section is selected."
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "promotion_sub_title",
        "label": "t:sections.all.contents.subheading.label",
        "default": "Special Offer",
        "hidden": true,
        "info": "Legacy: used only when the section has no Subheading block."
      },
      {
        "type": "text",
        "id": "promotion_title",
        "label": "t:sections.all.contents.heading.label",
        "default": "Cyber <br/> Monday",
        "hidden": true,
        "info": "Legacy: used only when the section has no Heading block."
      },
      {
        "type": "textarea",
        "id": "promotion_content",
        "label": "t:sections.promotion-popup.settings.promotion_content.label",
        "default": "Up to <span>50% Off</span> when using code [promotion_code]",
        "hidden": true,
        "info": "Legacy: used only when the section has no Text block."
      },
      {
        "type": "text",
        "id": "promotion_code",
        "label": "t:sections.promotion-popup.settings.promotion_code.label",
        "hidden": true,
        "info": "Legacy: used only when the section has no Code block."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "promotion_width",
        "label": "Popup width",
        "max": 800,
        "min": 400,
        "step": 10,
        "unit": "px",
        "default": 690
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
