      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Backdrop",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
