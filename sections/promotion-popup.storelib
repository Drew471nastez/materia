        "unit": "%",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "popup_bg",
        "label": "Popup background",
