<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Promotion popup: a native <dialog> with a picture, the
  section's blocks (subheading, heading, text, the code to copy, the "don't
  show again" link) and a 44px close button. Escape, the close button and a
  click outside the card close it.

  On the live site shopify/assets/live-popups-code.js opens it with
  showModal() after "Open after" seconds on the pages chosen in "Show on",
  once per visit, and not again for "Ask again after" days once "don't show
  again" is clicked or the code is copied. In the builder nothing opens on a
  timer: with "Show in the builder" on, the card is drawn in the page; off,
  it opens in the page while the section or one of its blocks is selected.
  Neither blocks the page.

  Old sections kept their words in section settings (Subheading, Heading,
  Content, Code). Those are hidden now and drawn only when the section has no
  block of that kind, so saved popups keep their text.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign pp_custom = false
  if st.enable_custom_style
    assign pp_custom = true
  endif
  assign pp_fonts = false
  if st.enable_custom_fonts
    assign pp_fonts = true
  endif
  assign show = 'hidden'
  if st.show_promotion_select == 'show_promotion_homepage'
    if request.page_type == 'index'
      assign show = 'show-on-homepage'
    endif
  elsif st.show_promotion_select == 'hide_promotion'
    assign show = 'hidden'
  else
    assign show = 'show-on-all-pages'
  endif
  assign pp_preview = true
  if st.editor_preview == false
    assign pp_preview = false
  endif
  assign pp_align = st.text_align | default: 'center'

  assign b_sub = section.blocks | where: 'type', 'subheading' | first
  assign b_heading = section.blocks | where: 'type', 'heading' | first
  assign b_text = section.blocks | where: 'type', 'text' | first
  assign b_coupon = section.blocks | where: 'type', 'coupon' | first
  assign b_dismiss = section.blocks | where: 'type', 'dismiss' | first
  assign pp_code = st.promotion_code
  if b_coupon
    assign pp_code = b_coupon.settings.code
  endif
  assign pp_dismiss_text = 'popup.do_not' | t
  assign pp_copied_text = 'popup.copied' | t
  assign banner = st.promotion_banner
-%}
{%- capture pp_vars -%}
--pp-w: {{ st.promotion_width | default: 690 }}px; --pp-banner: {{ st.banner_width | default: 36.5 }}%; --pp-align: {{ pp_align }}; --pp-overlay-o: {{ st.overlay_opacity | default: 50 }};
{%- if pp_custom -%}
--pp-bg: {% render 'scheme-color', color: st.popup_bg, fallback: 'var(--color-background)' %}; --pp-heading: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}; --pp-text: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}; --pp-overlay: {% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %}; --pp-radius: {{ st.popup_radius | default: 0 }}px;
{%- endif -%}
{%- if pp_fonts -%}
{%- if st.heading_font.family != blank -%}--pp-hf: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.body_font.family != blank -%}--pp-bf: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}
{%- if pp_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- for block in section.blocks -%}
  {%- if block.settings.enable_custom_fonts and block.settings.font.family != blank -%}<style>{{ block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- endfor -%}
<style>
  #shopify-section-{{ sid }} .pp {
    --pp-pad: 30px;
  }
  #shopify-section-{{ sid }} .pp__dialog {
    box-sizing: border-box;
    width: min(var(--pp-w, 690px), calc(100vw - 32px));
    max-width: none;
    max-height: calc(var(--sl-vh, 1vh) * 100 - 32px);
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: var(--pp-text, var(--color-text));
  }
  #shopify-section-{{ sid }} .pp__dialog::backdrop {
    background: var(--pp-overlay, #000);
    opacity: calc(var(--pp-overlay-o, 50) / 100);
  }
  #shopify-section-{{ sid }} .pp__dialog[open] { animation: pc-pp-in .25s ease both; }
  @keyframes pc-pp-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  #shopify-section-{{ sid }} .pp__card {
    position: relative;
    display: flex;
    align-items: stretch;
    max-height: calc(var(--sl-vh, 1vh) * 100 - 32px);
    overflow: hidden;
    background: var(--pp-bg, var(--color-background));
    border-radius: var(--pp-radius, var(--rounded-radius, 0px));
    font-family: var(--pp-bf, var(--body-font, inherit));
    box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
  }
  #shopify-section-{{ sid }} .pp__media {
    position: relative;
    display: none;
    flex: 0 0 var(--pp-banner, 36.5%);
    min-height: 100%;
    background: color-mix(in srgb, var(--color-text) 8%, var(--color-background));
  }
  #shopify-section-{{ sid }} .pp__media img,
  #shopify-section-{{ sid }} .pp__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .pp__media svg { color: var(--pp-text, var(--color-text)); opacity: .5; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pp__media:not([hidden]) { display: block; }
  }
  #shopify-section-{{ sid }} .pp__body {
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--pp-pad);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: var(--pp-align, center);
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ sid }} .pp__body { padding: 40px; }
  }
  #shopify-section-{{ sid }} .pp__close {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--pp-heading, var(--color-heading));
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .pp__close svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .pp__close:focus-visible { outline: 2px solid currentColor; outline-offset: -6px; }
  #shopify-section-{{ sid }} .pp__sub {
    margin: 0 0 10px;
    line-height: normal;
    color: var(--pb-c, var(--pp-text, var(--color-text)));
    font-family: var(--pb-ff, var(--pp-bf, inherit));
    font-size: var(--pb-fs, var(--h6-size, 1.6rem));
  }
  #shopify-section-{{ sid }} .pp__heading {
    margin: 0 0 15px;
    border: 0;
    color: var(--pb-c, var(--pp-heading, var(--color-heading)));
    font-family: var(--pb-ff, var(--pp-hf, var(--heading-font, inherit)));
    font-weight: var(--pb-fw, var(--heading-weight, 700));
    font-size: var(--pb-fs-m, var(--h3-size, 3rem));
    line-height: var(--pb-lh, var(--heading-line-height, 1.2));
    letter-spacing: var(--pb-ls, var(--heading-letter-spacing, normal));
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pp__heading { font-size: var(--pb-fs-d, var(--h2-size, 3.6rem)); }
  }
  #shopify-section-{{ sid }} .pp__text {
    color: var(--pb-c, var(--pp-text, var(--color-text)));
    font-family: var(--pb-ff, var(--pp-bf, inherit));
    font-size: var(--pb-fs, inherit);
  }
  #shopify-section-{{ sid }} .pp__text :is(p, li) { font-family: inherit; font-size: inherit; color: inherit; }
  #shopify-section-{{ sid }} .pp__text > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .pp__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .pp__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 100%;
    margin: 25px 0;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .pp__code-text { position: relative; display: inline-grid; }
  #shopify-section-{{ sid }} .pp__code-text > * { grid-area: 1 / 1; transition: opacity .2s ease; }
  #shopify-section-{{ sid }} .pp__code-done { opacity: 0; }
  #shopify-section-{{ sid }} .pp__code[data-copied] .pp__code-value { opacity: 0; }
  #shopify-section-{{ sid }} .pp__code[data-copied] .pp__code-done { opacity: 1; }
  #shopify-section-{{ sid }} .pp__dismiss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 0 auto;
    padding: 0 8px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: var(--pb-fs, var(--small-font-size, 1.3rem));
    font-family: var(--pb-ff, var(--pp-bf, inherit));
    color: var(--pb-c, var(--pp-text, var(--color-text)));
  }
  #shopify-section-{{ sid }} .pp__dismiss span { border-bottom: 1px solid currentColor; }
  #shopify-section-{{ sid }} [data-pp-align='left'] .pp__dismiss { margin-left: 0; }
  #shopify-section-{{ sid }} [data-pp-align='right'] .pp__dismiss { margin-right: 0; }
  #shopify-section-{{ sid }} .pp__empty { opacity: .7; font-style: italic; }
  /* In the builder the card sits in the page (never over it) */
  #shopify-section-{{ sid }} .pp__dialog[open]:not(:modal) {
    position: relative;
    inset: auto;
    display: block;
    margin: 24px auto;
    z-index: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pp__dialog[open],
    #shopify-section-{{ sid }} .pp__code-text > * { animation: none !important; transition: none !important; }
  }
  html.pc-lock { overflow: hidden; }
{% comment %}{% endcomment %}</style>

<div
  class="pp color-{{ color_scheme }}"
  data-pc-root="promotion-popup"
  data-pc-section="{{ sid }}"
  data-pc-settings="{{ st | json | escape }}"
  data-pp-show="{{ show }}"
  data-pp-index="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
  data-pp-i18n='{"copied":{{ pp_copied_text | json | escape }}}'
  data-pp-mobile="{% if st.show_promotion_mobile %}true{% else %}false{% endif %}"
  data-pp-preview="{{ pp_preview }}"
  data-pp-align="{{ pp_align }}"
  data-pp-delay="{{ st.delay | default: 15 }}"
  data-pp-days="{{ st.hide_days | default: 1 }}"
  style="{{ pp_vars | strip | strip_newlines }}"
>
  <dialog class="pp__dialog" aria-labelledby="pp-title-{{ sid }}" data-pp-dialog{% if request.design_mode and pp_preview %} open{% endif %}>
    <div class="pp__card">
      <button type="button" class="pp__close" data-pp-close aria-label="{{ 'accessibility.close' | t }}">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="pp__media" data-pp-media{% if banner == blank and request.design_mode != true %} hidden{% endif %}>
        {%- if banner != blank -%}
          <img src="{{ banner | image_url: width: 900 }}" alt="{{ banner.alt | escape }}" width="{{ banner.width }}" height="{{ banner.height }}" loading="lazy" decoding="async">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pp__placeholder' }}
        {%- endif -%}
      </div>
      <div class="pp__body" id="pp-title-{{ sid }}-wrap">
        {%- unless b_sub -%}
          {%- if st.promotion_sub_title != blank -%}<div class="pp__sub" data-pc-legacy="promotion_sub_title">{{ st.promotion_sub_title }}</div>{%- endif -%}
        {%- endunless -%}
        {%- unless b_heading -%}
          {%- if st.promotion_title != blank -%}<h2 class="pp__heading" id="pp-title-{{ sid }}" data-pc-legacy="promotion_title">{{ st.promotion_title }}</h2>{%- endif -%}
        {%- endunless -%}
        {%- unless b_text -%}
          {%- if st.promotion_content != blank -%}<div class="pp__text" data-pc-legacy="promotion_content">{{ st.promotion_content | replace: '[promotion_code]', pp_code }}</div>{%- endif -%}
        {%- endunless -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign bs = block.settings
            assign b_own = false
            if bs.enable_custom_style
              assign b_own = true
            endif
            assign b_font = false
            if bs.enable_custom_fonts and bs.font.family != blank
              assign b_font = true
            endif
            assign b_size = false
            if bs.size_enable
              assign b_size = true
            endif
          -%}
          {%- capture b_vars -%}
            {%- if b_own -%}{%- if block.type == 'heading' -%}--pb-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--pp-heading, var(--color-heading))' %};{%- else -%}--pb-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--pp-text, var(--color-text))' %};{%- endif -%}{%- endif -%}
            {%- if b_font -%}--pb-ff: {{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
            {%- if block.type == 'heading' -%}
              {%- if bs.weight_enable -%}--pb-fw: {{ bs.weight | default: 700 }};{%- endif -%}
              {%- if b_size -%}--pb-fs-d: {{ bs.size_desktop | default: 40 }}px; --pb-fs-m: {{ bs.size_mobile | default: 30 }}px; --pb-lh: {{ bs.line_height | default: 1.15 }}; --pb-ls: {{ bs.tracking | default: 0 }}px;{%- endif -%}
            {%- elsif block.type == 'subheading' or block.type == 'text' or block.type == 'dismiss' -%}
              {%- if b_size -%}--pb-fs: {{ bs.size | default: 16 }}px;{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              <div class="pp__sub" data-pc-block="{{ block.id }}" data-pc-type="subheading" data-pc-settings="{{ bs | json | escape }}"{% if b_font %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'heading' -%}
              <h2 class="pp__heading" id="pp-title-{{ sid }}" data-pc-block="{{ block.id }}" data-pc-type="heading" data-pc-settings="{{ bs | json | escape }}"{% if b_font or pp_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if b_size %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip }}" {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'text' -%}
              <div class="pp__text" data-pc-block="{{ block.id }}" data-pc-type="text" data-pc-settings="{{ bs | json | escape }}"{% if b_font or pp_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip }}" {{ block.shopify_attributes }}>{{ bs.text | replace: '[promotion_code]', pp_code }}</div>
            {%- when 'coupon' -%}
              {%- liquid
                assign b_shape = false
                if bs.use_theme_button == false
                  assign b_shape = true
                endif
              -%}
              <div class="pp__coupon" data-pc-block="{{ block.id }}" data-pc-type="coupon" data-pc-settings="{{ bs | json | escape }}"{% if bs.code == blank and request.design_mode != true %} hidden{% endif %} {{ block.shopify_attributes }}>
                <button type="button" class="pp__code btn-primary" data-theme-button="primary" data-sl-button data-pp-copy data-code="{{ bs.code | escape }}"{% if b_font %} data-own-font{% endif %}{% if b_shape %} data-own-shape{% endif %} aria-label="{{ bs.copy_label | default: 'Copy the code' | escape }}" style="{% if b_font %}--mb-font: {{ bs.font.family }}, {{ bs.font.fallback_families }};{% endif %}{%- if b_own -%}{% render 'button-overrides', bg: bs.bg_color, text: bs.text_color, hover_bg: bs.bg_color_hover, hover_text: bs.text_color_hover %}{%- endif -%}{%- if b_shape -%}--mb-radius: {{ bs.radius | default: 0 }}px; --mb-font-size: {{ bs.font_size | default: 14 }}px; --mb-padding-y: {{ bs.padding_y | default: 14 }}px; --mb-padding-x: {{ bs.padding_x | default: 26 }}px;{%- endif -%}">
                  <svg width="16" height="14" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M14.286 4.667v7.583H4.57V4.667h9.715ZM16 4.375c0-.805-.64-1.458-1.429-1.458H4.286c-.79 0-1.429.653-1.429 1.458v8.167c0 .805.64 1.458 1.429 1.458H14.57c.79 0 1.429-.653 1.429-1.458V4.375Z" clip-rule="evenodd"/><path fill="currentColor" fill-rule="evenodd" d="M13.43.875A.866.866 0 0 0 12.573 0H1.43C1.05 0 .687.154.42.427A1.474 1.474 0 0 0 0 1.458V10.5c0 .484.384.875.857.875a.866.866 0 0 0 .857-.875V1.75h10.857a.866.866 0 0 0 .858-.874Z" clip-rule="evenodd"/></svg>
                  <span class="pp__code-text">
                    <span class="pp__code-value" data-pp-code-value>{% if bs.code != blank %}{{ bs.code }}{% else %}<span class="pp__empty">Add a code in this block</span>{% endif %}</span>
                    <span class="pp__code-done" data-pp-code-done aria-hidden="true">{{ bs.copied_text | default: pp_copied_text }}</span>
                  </span>
                </button>
                <span class="visually-hidden" role="status" aria-live="polite" data-pp-status></span>
              </div>
            {%- when 'dismiss' -%}
              <button type="button" class="pp__dismiss" data-pc-block="{{ block.id }}" data-pc-type="dismiss" data-pc-settings="{{ bs | json | escape }}" data-pp-dismiss{% if b_font %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars | strip }}" {{ block.shopify_attributes }}><span>{{ bs.text }}</span></button>
          {%- endcase -%}
        {%- endfor -%}
        {%- unless b_coupon -%}
          {%- if st.promotion_code != blank -%}
            <div class="pp__coupon" data-pc-legacy="promotion_code">
              <button type="button" class="pp__code btn-primary" data-theme-button="primary" data-sl-button data-pp-copy data-code="{{ st.promotion_code | escape }}" aria-label="{{ 'popup.copy' | t | escape }}">
                <svg width="16" height="14" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M14.286 4.667v7.583H4.57V4.667h9.715ZM16 4.375c0-.805-.64-1.458-1.429-1.458H4.286c-.79 0-1.429.653-1.429 1.458v8.167c0 .805.64 1.458 1.429 1.458H14.57c.79 0 1.429-.653 1.429-1.458V4.375Z" clip-rule="evenodd"/></svg>
                <span class="pp__code-text"><span class="pp__code-value" data-pp-code-value>{{ st.promotion_code }}</span><span class="pp__code-done" data-pp-code-done aria-hidden="true">{{ pp_copied_text }}</span></span>
              </button>
              <span class="visually-hidden" role="status" aria-live="polite" data-pp-status></span>
            </div>
          {%- endif -%}
        {%- endunless -%}
        {%- unless b_dismiss -%}
          {%- if section.blocks.size == 0 -%}
            <button type="button" class="pp__dismiss" data-pp-dismiss data-pc-legacy="dismiss"><span>{{ pp_dismiss_text }}</span></button>
          {%- endif -%}
        {%- endunless -%}
      </div>
    </div>
  </dialog>
</div>
</template>

<schema>
{
  "type": "promotion-popup",
  "name": "Promotion popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "range",
      "id": "promotion_width",
      "label": "Promotion width",
      "max": 800,
      "min": 400,
      "step": 10,
      "unit": "px",
      "default": 690
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Trigger / Display Behavior"
    },
    {
      "type": "select",
      "id": "show_promotion_select",
      "label": "Show promotion select",
      "default": "show_promotion_homepage",
      "options": [
        {
          "value": "show_promotion_homepage",
          "label": "Show promotion homepage"
        },
        {
          "value": "show_promotion_all_page",
          "label": "Show promotion all page"
        },
        {
          "value": "hide_promotion",
          "label": "Hide promotion"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_promotion_mobile",
      "label": "Show promotion mobile",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "promotion_sub_title",
      "label": "Promotion sub title",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "promotion_title",
      "label": "Promotion title",
      "default": "Cyber <br/> Monday"
    },
    {
      "type": "textarea",
      "id": "promotion_content",
      "label": "Promotion content",
      "default": "Up to <span>50% Off</span> when using code [promotion_code]"
    },
    {
      "type": "text",
      "id": "promotion_code",
      "label": "Promotion code"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "promotion_banner",
      "label": "Promotion banner"
    },
    {
      "type": "range",
      "id": "banner_width",
      "label": "Banner width",
      "max": 50,
      "min": 20,
      "step": 0.5,
