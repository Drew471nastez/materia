  "shopify": {
    "name": "Mobile navigation bar",
    "tag": "section",
    "limit": 1,
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "hidden": true,
        "info": "Not used: the bar always spans the screen."
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "Shows on phones only, fixed to the bottom of the screen. Each block is one tab."
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "show_labels",
        "label": "Show labels",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "height",
        "min": 48,
        "max": 96,
        "step": 2,
        "unit": "px",
        "label": "Height",
        "default": 62
      },
      {
        "type": "range",
        "id": "icon_size",
        "min": 16,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Icon size",
        "default": 22
      },
      {
        "type": "range",
        "id": "radius_top",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Top corner radius",
        "default": 0
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "border_top",
        "label": "Show top border",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "shadow_enabled",
        "label": "Shadow",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "use_custom_colors",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "visible_if": "{{ section.settings.use_custom_colors }}"
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icons",
        "visible_if": "{{ section.settings.use_custom_colors }}"
      },
      {
        "type": "color",
        "id": "label_color",
        "label": "Labels",
        "visible_if": "{{ section.settings.use_custom_colors }}"
      },
      {
        "type": "color",
        "id": "active_color",
        "label": "Current page and hover",
        "visible_if": "{{ section.settings.use_custom_colors }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Top border",
        "visible_if": "{{ section.settings.use_custom_colors and section.settings.border_top }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "label_font",
        "label": "Label font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "info": "Not used: the bar stays fixed on screen and never animates in.",
        "default": true,
        "visible_if": "{{ false }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "hidden": true,
        "info": "Not used: the bar shows on phones only."
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "hidden": true,
        "info": "Not used: the bar shows on phones only."
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      }
