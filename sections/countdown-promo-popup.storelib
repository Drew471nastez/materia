<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Countdown Promo Popup: a picture beside an eyebrow, a
  headline, a code to copy, a countdown to the creator's own end date, a
  button and small print, in a native <dialog> (snippets/page-popup-dialog).
  Every setting reaches the page as a CSS variable, an attribute or a text
  on its element, so shopify/assets/live-page-popups.js applies a builder
  edit in place, the same as this Liquid draws it. Each block is always
  drawn (hidden while empty) so it can be filled in live.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign fb_accessibility_completed = 'accessibility.completed' | t
  assign fb_accessibility_promotion = 'accessibility.promotion' | t
  assign block_eyebrow = section.blocks | where: 'type', 'eyebrow' | first
  assign block_headline = section.blocks | where: 'type', 'headline' | first
  assign block_coupon = section.blocks | where: 'type', 'coupon' | first
  assign block_countdown = section.blocks | where: 'type', 'countdown' | first
  assign block_cta = section.blocks | where: 'type', 'cta' | first
  assign block_disclaimer = section.blocks | where: 'type', 'disclaimer' | first
  assign block_image = section.blocks | where: 'type', 'image' | first
  assign cdp_custom_style = false
  if st.enable_custom_style == true
    assign cdp_custom_style = true
  endif
-%}
<style>
  #shopify-section-{{ sid }} { position: static; }
  .cdp-{{ sid }} { font-family: var(--body-font, inherit); }
  .cdp-{{ sid }} *, .cdp-{{ sid }} *::before, .cdp-{{ sid }} *::after { box-sizing: border-box; }

  .cdp-overlay-{{ sid }} {
    position: fixed; inset: 0;
    background: var(--cdp-overlay, #000000);
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: opacity .3s ease, visibility 0s linear .3s;
    z-index: 2147483646;
  }
  .cdp-{{ sid }}.cdp-open .cdp-overlay-{{ sid }} {
    opacity: var(--cdp-overlay-o, .6);
    pointer-events: auto; visibility: visible; transition-delay: 0s;
  }

  .cdp-card-{{ sid }} {
    position: fixed; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.96);
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s ease, visibility 0s linear .35s;
    z-index: 2147483647;
    width: min(calc(100vw - var(--cdp-gutter, 32px)), var(--cdp-w, 900px));
    max-height: calc(var(--sl-vh, 1vh) * 100 - 24px);
    overflow: hidden auto; overscroll-behavior: contain;
    background: var(--cdp-bg, var(--color-background));
    color: var(--cdp-text, var(--color-text));
    border-radius: var(--cdp-radius, 12px);
    box-shadow: 0 12px 40px rgba(0,0,0,.35);
  }
  .cdp-{{ sid }}.cdp-open .cdp-card-{{ sid }} {
    opacity: 1; pointer-events: auto; visibility: visible; transition-delay: 0s;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (min-width: 750px) {
    .cdp-card-{{ sid }} { width: min(92vw, var(--cdp-w, 900px)); }
  }

  /* Two columns: the picture on the chosen side (desktop) */
  .cdp-grid-{{ sid }} {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    align-items: stretch;
    gap: 0;
  }
  .cdp-{{ sid }}[data-cdp-side="image-right"] .cdp-grid-{{ sid }} { grid-template-columns: 1.05fr .95fr; }
  .cdp-{{ sid }}[data-cdp-side="image-right"] .cdp-text-{{ sid }} { order: 1; }
  .cdp-{{ sid }}[data-cdp-side="image-right"] .cdp-image-{{ sid }} { order: 2; }
  @media (max-width: 749px) {
    .cdp-grid-{{ sid }} { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .cdp-{{ sid }}[data-cdp-side] .cdp-grid-{{ sid }} { grid-template-columns: 1fr; }
    .cdp-{{ sid }}[data-cdp-side] .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { order: 1; }
    .cdp-{{ sid }}[data-cdp-side] .cdp-grid-{{ sid }} .cdp-text-{{ sid }} { order: 2; }
    .cdp-{{ sid }}[data-cdp-mobile-image="hidden"] .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { display: none; }
    .cdp-{{ sid }}[data-cdp-mobile-image="hidden"] .cdp-grid-{{ sid }} { grid-template-rows: 1fr; }
  }

  .cdp-image-{{ sid }} {
    background: color-mix(in srgb, var(--color-heading) 10%, var(--color-background));
    overflow: hidden;
    min-height: 0;
  }
  .cdp-image-{{ sid }} img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .cdp-image-{{ sid }} .cdp-placeholder { width: 100%; height: 100%; min-height: 240px; display: block; fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
  @media (max-width: 749px) {
    .cdp-image-{{ sid }} { aspect-ratio: 16 / 10; }
  }

  .cdp-text-{{ sid }} {
    padding: clamp(24px, 5vw, 44px);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center;
    min-height: 0;
  }
  .cdp-text-{{ sid }} > [hidden] { display: none !important; }

  .cdp-close-{{ sid }} {
    position: absolute; top: 14px; right: 14px;
    width: 44px; height: 44px; padding: 0;
    border: none; border-radius: 50%;
    background: transparent;
    color: var(--cdp-close, var(--color-heading));
    font-size: 22px; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    z-index: 2;
    transition: transform .2s ease, background .2s ease;
  }
  .cdp-close-{{ sid }}:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .cdp-close-{{ sid }} svg { width: 18px; height: 18px; }
  .cdp-close-{{ sid }}:focus-visible, .cdp-coupon-{{ sid }}:focus-visible, .cdp-cta-{{ sid }}:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .cdp-eyebrow-{{ sid }} {
    font-size: 13px;
    font-weight: var(--subheading-weight, 600);
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 var(--cdp-gap-e, 18px);
  }
  .cdp-headline-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 800);
    line-height: var(--heading-line-height, 1.05);
    letter-spacing: var(--heading-letter-spacing, .04em);
    text-transform: var(--heading-text-transform, uppercase);
    margin: 0 0 var(--cdp-gap-h, 22px);
  }
  .cdp-headline-{{ sid }} { font-size: clamp(min(22px, var(--cdp-h-size, 32px)), 4vw, var(--cdp-h-size, 32px)); }
  @media (max-width: 749px) {
    .cdp-headline-{{ sid }} { font-size: min(var(--cdp-h-size, 32px), clamp(20px, 6vw, 28px)); }
    .cdp-{{ sid }}:not([data-cdp-mobile-image="hidden"]) .cdp-close-{{ sid }} { background: color-mix(in srgb, var(--cdp-bg, var(--color-background)) 75%, transparent); }
  }

  .cdp-coupon-{{ sid }} {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0 0 var(--cdp-gap-c, 24px);
    min-height: 44px; padding: 12px 24px;
    border: 1px dashed currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700; font-size: 15px; letter-spacing: .1em;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .cdp-coupon-{{ sid }}:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
  .cdp-coupon-{{ sid }}.is-copied { background: #1c8d3a; color: #fff; border-color: #1c8d3a; border-style: solid; }
  .cdp-coupon-{{ sid }} svg { width: 14px; height: 14px; flex-shrink: 0; }

  .cdp-countdown-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--cdp-cd-gap, 8px);
    width: 100%;
    max-width: 360px;
    margin: 0 0 var(--cdp-gap-cd, 24px);
  }
  .cdp-cd-cell-{{ sid }} {
    background: var(--cdp-cell-bg, color-mix(in srgb, var(--color-heading) 8%, var(--color-background)));
    color: var(--cdp-cell-color, var(--color-heading));
    border-radius: var(--cdp-cell-radius, 4px);
    padding: 14px 8px 10px;
    text-align: center;
  }
  .cdp-cd-num-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-size: clamp(22px, 4vw, 30px);
    font-weight: var(--heading-weight, 800);
    line-height: 1;
    letter-spacing: .02em;
  }
  .cdp-cd-label-{{ sid }} {
    font-size: 10px;
    font-weight: var(--subheading-weight, 700);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: .85;
  }
  .cdp-cd-status-{{ sid }} {
    font-size: 13px;
    color: var(--cdp-status, color-mix(in srgb, var(--color-text) 75%, transparent));
    margin: 6px 0 var(--cdp-gap-cd, 24px);
  }
  .cdp-cta-{{ sid }} { margin: 0 0 var(--cdp-gap-cta, 16px); }
  .cdp-{{ sid }}[data-cd-ended] .cdp-countdown-{{ sid }} { display: none; }

  .cdp-disclaimer-{{ sid }} {
    font-size: 12px;
    line-height: 1.55;
    opacity: .85;
    margin: 0;
    max-width: 340px;
  }

  @media (max-width: 749px) {
    .cdp-eyebrow-{{ sid }} { margin-bottom: clamp(min(10px, var(--cdp-gap-e, 18px)), 3vw, var(--cdp-gap-e, 18px)); }
    .cdp-headline-{{ sid }} { margin-bottom: clamp(min(12px, var(--cdp-gap-h, 22px)), 3.2vw, var(--cdp-gap-h, 22px)); }
    .cdp-coupon-{{ sid }} { margin-bottom: clamp(min(14px, var(--cdp-gap-c, 24px)), 3.4vw, var(--cdp-gap-c, 24px)); }
    .cdp-countdown-{{ sid }} { margin-bottom: clamp(min(14px, var(--cdp-gap-cd, 24px)), 3.4vw, var(--cdp-gap-cd, 24px)); }
    .cdp-cta-{{ sid }} { margin-bottom: clamp(min(10px, var(--cdp-gap-cta, 16px)), 3vw, var(--cdp-gap-cta, 16px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cdp-card-{{ sid }}, .cdp-overlay-{{ sid }}, .cdp-coupon-{{ sid }} { transition: none !important; }
    .cdp-card-{{ sid }} { transform: translate(-50%, -50%) !important; }
  }
{% comment %}{% endcomment %}</style>

{%- capture cdp_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ st.editor_mode | json }}, "hideEnded": {% if st.hide_when_ended == false %}false{% else %}true{% endif %},
   "trigger": {"mode": {{ st.open_mode | default: 'delay' | json }}, "delay": {{ st.delay_s | default: 5 | json }}, "scroll": {{ st.scroll_pct | default: 50 | json }}, "views": {{ st.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ st.after_dismiss | default: 'after_days' | json }}, "days": {{ st.hide_days | default: 1 | json }} } }
{%- endcapture -%}
{%- capture cdp_vars -%}
--cdp-overlay-o: {{ st.overlay_opacity | default: 60 | times: 0.01 }}; --cdp-w: {{ st.popup_width | default: 900 }}px; --cdp-gutter: {{ st.mobile_gutter | default: 32 }}px; --cdp-radius: {{ st.popup_radius | default: 12 }}px; --cdp-cell-radius: {{ st.cd_cell_radius | default: 4 }}px; --cdp-cd-gap: {{ st.cd_gap | default: 8 }}px; --cdp-gap-e: {{ st.gap_after_eyebrow | default: 18 }}px; --cdp-gap-h: {{ st.gap_after_headline | default: 22 }}px; --cdp-gap-c: {{ st.gap_after_coupon | default: 24 }}px; --cdp-gap-cd: {{ st.gap_after_countdown | default: 24 }}px; --cdp-gap-cta: {{ st.gap_after_cta | default: 16 }}px;
{%- if cdp_custom_style %} --cdp-overlay: {% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %}; --cdp-bg: {% render 'scheme-color', color: st.card_bg, fallback: 'var(--color-background)' %}; --cdp-text: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}; --cdp-close: {% render 'scheme-color', color: st.close_color, fallback: 'var(--color-heading)' %}; --cdp-cell-bg: {% render 'scheme-color', color: st.cd_cell_bg, fallback: 'color-mix(in srgb, var(--color-heading) 8%, var(--color-background))' %}; --cdp-cell-color: {% render 'scheme-color', color: st.cd_cell_color, fallback: 'var(--color-heading)' %}; --cdp-status: {% render 'scheme-color', color: st.cd_status_color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};{%- endif -%}
{%- render 'page-popup-fonts', st: st -%}
{%- endcapture -%}
{% render 'page-popup-dialog', sid: sid, st: st %}
<section class="cdp-{{ sid }} color-{{ color_scheme }}" data-pg-root="countdown-promo-popup" data-pg-section="{{ sid }}" data-pg-settings="{{ st | json | escape }}"{% if st.enable_custom_fonts %} data-pg-fonts data-own-font{% endif %}
         data-pg-i18n="{{ fb_accessibility_promotion | escape }}" data-cdp-side="{{ st.image_side | default: 'image-left' }}" data-cdp-mobile-image="{{ st.mobile_image_position | default: 'above' }}"
         data-cdp-section="{{ sid }}" data-popup-root="{{ sid }}"
         data-popup-config="{{ cdp_config | strip_newlines | escape }}"
         style="{{ cdp_vars | strip_newlines | strip }}"
         aria-hidden="true">
  <dialog class="pg-dialog" data-pg-dialog aria-labelledby="cdp-title-{{ sid }}">
  <div class="cdp-overlay-{{ sid }}" data-pg-backdrop aria-hidden="true"></div>
  <div class="cdp-card-{{ sid }} gradient" data-pg-card tabindex="-1">
    <button type="button" class="cdp-close-{{ sid }}" data-popup-close aria-label="{{ 'accessibility.close_popup' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

    <div class="cdp-grid-{{ sid }}">
      {%- if block_image != blank -%}
        {%- capture demo_cdp -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
        {%- assign demo_cdp = demo_cdp | strip -%}
        {%- assign cdp_alt = block_image.settings.alt | default: fb_accessibility_promotion -%}
        <div class="cdp-image-{{ sid }}" data-pg-block="{{ block_image.id }}" data-pg-type="image" data-pg-settings="{{ block_image.settings | json | escape }}" {{ block_image.shopify_attributes }}>
          <template data-pg-ph>{%- if demo_cdp != blank -%}<img src="{{ demo_cdp }}" alt="{{ fb_accessibility_promotion }}" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'cdp-placeholder' }}{%- endif -%}</template>
          {%- if block_image.settings.image != blank -%}
            {{ block_image.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                alt: cdp_alt,
                sizes: '(min-width: 750px) 50vw, 100vw',
                widths: '360,540,720,900' }}
          {%- elsif demo_cdp != blank -%}
            <img src="{{ demo_cdp }}" alt="{{ fb_accessibility_promotion }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'cdp-placeholder' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cdp-text-{{ sid }}">
        {%- if block_eyebrow != blank -%}
          {%- liquid
            assign c = ''
            if block_eyebrow.settings.enable_custom_style == true
              assign c = block_eyebrow.settings.color
            endif
          -%}
          <p class="cdp-eyebrow-{{ sid }}" data-pg-block="{{ block_eyebrow.id }}" data-pg-type="eyebrow" data-pg-settings="{{ block_eyebrow.settings | json | escape }}"{% if block_eyebrow.settings.text == blank %} hidden{% endif %}
             style="color: {% render 'scheme-color', color: c, fallback: 'var(--color-text)' %}; font-size: {{ block_eyebrow.settings.size | default: 13 }}px;"
             {{ block_eyebrow.shopify_attributes }}>{{ block_eyebrow.settings.text }}</p>
        {%- endif -%}

        {%- if block_headline != blank -%}
          {%- liquid
            assign c = ''
            if block_headline.settings.enable_custom_style == true
              assign c = block_headline.settings.color
            endif
          -%}
          <h2 class="cdp-headline-{{ sid }}" id="cdp-title-{{ sid }}" data-pg-block="{{ block_headline.id }}" data-pg-type="headline" data-pg-settings="{{ block_headline.settings | json | escape }}"{% if block_headline.settings.text == blank %} hidden{% endif %}
              style="--cdp-h-size: {{ block_headline.settings.size | default: 32 }}px; color: {% render 'scheme-color', color: c, fallback: 'var(--color-heading)' %};"
              {{ block_headline.shopify_attributes }}>{{ block_headline.settings.text }}</h2>
        {%- endif -%}

        {%- if block_coupon != blank -%}
          {%- liquid
            assign c = ''
            if block_coupon.settings.enable_custom_style == true
              assign c = block_coupon.settings.color
            endif
          -%}
          <button type="button" class="cdp-coupon-{{ sid }}" data-pg-block="{{ block_coupon.id }}" data-pg-type="coupon" data-pg-settings="{{ block_coupon.settings | json | escape }}" data-cdp-code="{{ block_coupon.settings.code | escape }}"{% if block_coupon.settings.code == blank %} hidden{% endif %}
                  style="color: {% render 'scheme-color', color: c, fallback: 'var(--color-heading)' %};"
                  aria-label="{{ 'accessibility.copy_coupon_code' | t }}" {{ block_coupon.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span data-cdp-code-text>{{ block_coupon.settings.code }}</span>
          </button>
        {%- endif -%}

        {%- if block_countdown != blank -%}
          {%- assign cd_target = block_countdown.settings.end_datetime -%}
          {%- assign cd_status = block_countdown.settings.completed_text | default: fb_accessibility_completed -%}
          <div class="cdp-countdown-{{ sid }}"
               data-cdp-countdown
               data-pg-block="{{ block_countdown.id }}" data-pg-type="countdown" data-pg-settings="{{ block_countdown.settings | json | escape }}"
               data-pg-i18n="{{ fb_accessibility_completed | escape }}"
               data-cdp-end="{{ cd_target }}"
               data-cdp-status="{{ cd_status | escape }}"
               {%- if cd_target == blank %} hidden style="display: none"{% endif %}
               {{ block_countdown.shopify_attributes }}>
            {%- assign labels = block_countdown.settings.labels | default: 'DAYS|HOURS|MIN|SEC' | split: '|' -%}
            {%- assign cd_default_labels = 'DAYS|HOURS|MIN|SEC' | split: '|' -%}
            {%- for i in (0..3) -%}
              {%- assign piece = labels[i] | default: cd_default_labels[i] | strip -%}
              <div class="cdp-cd-cell-{{ sid }}">
                <div class="cdp-cd-num-{{ sid }}" data-cdp-num="{{ forloop.index0 }}">00</div>
                <div class="cdp-cd-label-{{ sid }}" data-cdp-label="{{ forloop.index0 }}">{{ piece }}</div>
              </div>
            {%- endfor -%}
          </div>
          <p class="cdp-cd-status-{{ sid }}" data-cdp-status data-pg-block="{{ block_countdown.id }}" data-pg-type="countdown" hidden>{{ cd_status }}</p>
        {%- endif -%}

        {%- if block_cta != blank -%}
          {%- liquid
            assign cdp_custom = false
            if block_cta.settings.use_theme_button == false
              assign cdp_custom = true
            endif
            assign b_bg = ''
            assign b_tx = ''
            assign b_bgh = ''
            assign b_txh = ''
            if block_cta.settings.enable_custom_style == true
              assign b_bg = block_cta.settings.bg
              assign b_tx = block_cta.settings.text_color
              assign b_bgh = block_cta.settings.bg_hover
              assign b_txh = block_cta.settings.text_hover
            endif
          -%}
          <a class="cdp-cta-{{ sid }} btn-primary" data-theme-button="primary" data-sl-button{% if cdp_custom %} data-own-shape{% endif %}
             data-pg-block="{{ block_cta.id }}" data-pg-type="cta" data-pg-settings="{{ block_cta.settings | json | escape }}" data-pg-default-href="{{ routes.all_products_collection_url }}"{% if block_cta.settings.label == blank %} hidden{% endif %}
             {% if block_cta.settings.link != blank %}href="{{ block_cta.settings.link }}"{% else %}href="{{ routes.all_products_collection_url }}"{% endif %}
             style="{%- render 'button-overrides', bg: b_bg, text: b_tx, hover_bg: b_bgh, hover_text: b_txh, custom: cdp_custom, radius: block_cta.settings.radius, padding_y: block_cta.settings.padding_y, padding_x: block_cta.settings.padding_x, font_size: block_cta.settings.size -%}"
             {{ block_cta.shopify_attributes }}>{{ block_cta.settings.label }}</a>
        {%- endif -%}

        {%- if block_disclaimer != blank -%}
          {%- liquid
            assign c = ''
            if block_disclaimer.settings.enable_custom_style == true
              assign c = block_disclaimer.settings.color
            endif
          -%}
          <p class="cdp-disclaimer-{{ sid }}" data-pg-block="{{ block_disclaimer.id }}" data-pg-type="disclaimer" data-pg-settings="{{ block_disclaimer.settings | json | escape }}"{% if block_disclaimer.settings.text == blank %} hidden{% endif %}
             style="color: {% render 'scheme-color', color: c, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};"
             {{ block_disclaimer.shopify_attributes }}>{{ block_disclaimer.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
  </dialog>
</section>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ sid | json }};
  var I18N_COPIED = {{ 'accessibility.copied' | t | json }};

  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__cdp) return;
    root.__cdp = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var card = root.querySelector('.cdp-card-' + SID);
    var overlay = root.querySelector('.cdp-overlay-' + SID);
    var codeBtn = root.querySelector('[data-cdp-code]');
    var cdEl = root.querySelector('[data-cdp-countdown]');
    var cdStatus = root.querySelector('p[data-cdp-status]');
    var timer = 0;

    // Countdown: counts down to the end date (the visitor's own clock and zone).
    function calendarOk(s){var m=/^\s*(\d{4})-(\d{1,2})-(\d{1,2})/.exec(String(s||''));if(!m)return true;var y=+m[1],mo=+m[2],d=+m[3];return mo>=1&&mo<=12&&d>=1&&d<=new Date(Date.UTC(y,mo,0)).getUTCDate();}
    // The end is read on every tick, so a builder edit of it is followed at once.
    function target(){ return cdEl && calendarOk(cdEl.dataset.cdpEnd) ? Date.parse(cdEl.dataset.cdpEnd || '') : NaN; }
    var targetMs = target();
    var nums = cdEl ? cdEl.querySelectorAll('[data-cdp-num]') : [];
    if (cdEl && isNaN(targetMs)) { cdEl.style.display = 'none'; }
    function pad(n){ return n < 10 ? '0' + n : String(n); }
    function ended(){ return !isNaN(targetMs) && targetMs - Date.now() <= 0; }
    function tick(){
      targetMs = target();
      if (!cdEl || isNaN(targetMs)) return false;
      var diff = targetMs - Date.now();
      if (diff <= 0) {
        root.setAttribute('data-cd-ended', '');
        if (cdStatus) cdStatus.hidden = false;
        nums.forEach(function(n){ n.textContent = '00'; });
        return false;
      }
      root.removeAttribute('data-cd-ended');
      if (cdStatus) cdStatus.hidden = true;
      var s = Math.floor(diff / 1000);
      var vals = [Math.floor(s / 86400), Math.floor(s % 86400 / 3600), Math.floor(s % 3600 / 60), s % 60];
      nums.forEach(function(n, i){ if (vals[i] != null) n.textContent = pad(vals[i]); });
      return true;
    }
    function start(){ stop(); tick(); timer = setInterval(tick, 1000); }
    function stop(){ clearInterval(timer); timer = 0; }
    tick();

    // An offer that has ended is not offered: the popup stays closed on the site.
    if (CFG.hideEnded && ended() && !CFG.design) return;

    var api = P.register({
      id: SID, root: root, dialog: card, backdrop: overlay,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-cdp-trigger="' + SID + '"]' }, CFG.trigger),
      frequency: { mode: CFG.frequency.mode === 'every_visit' ? 'always' : CFG.frequency.mode, days: CFG.frequency.days },
      open: function(){ root.classList.add('cdp-open'); root.setAttribute('aria-hidden', 'false'); start(); },
      close: function(){ root.classList.remove('cdp-open'); root.setAttribute('aria-hidden', 'true'); stop(); }
    });

    if (codeBtn) {
      var codeText = codeBtn.querySelector('[data-cdp-code-text]');
      codeBtn.addEventListener('click', function(){
        var code = (codeBtn.dataset.cdpCode || '').trim();
        if (!code) return;
        P.copy(code).catch(function(){}).then(function(){
          codeBtn.classList.add('is-copied');
          if (codeText) codeText.textContent = I18N_COPIED;
          setTimeout(function(){ codeBtn.classList.remove('is-copied'); if (codeText) codeText.textContent = codeBtn.dataset.cdpCode || ''; }, 2200);
        });
      });
    }
    window['CDP_open_' + SID] = function(){ api && api.show(); };
    window['CDP_close_' + SID] = function(){ api && api.hide(); };
    window['CDP_reset_' + SID] = function(){ api && api.reset(); };
  }

  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>



