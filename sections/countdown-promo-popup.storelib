            "min": 11,
            "max": 18,
            "step": 1,
            "unit": "px",
            "label": "Font size",
            "default": 13,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "min": 16,
            "max": 60,
            "step": 2,
            "unit": "px",
            "label": "Horizontal padding",
            "default": 36,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "min": 8,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Vertical padding",
            "default": 12,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "label": "Corner radius",
            "default": 4,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background on hover"
          },
          {
            "type": "color",
            "id": "text_hover",
            "label": "Text on hover"
          }
        ]
      },
      {
        "type": "disclaimer",
        "name": "Disclaimer / footnote",
        "limit": 1,
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Footnote text",
            "default": "Final discount, cannot be combined with other offers."
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "alt",
            "label": "Alt text",
            "default": "Promotion"
          }
        ]
      }
    ],
    "presets": []
  }
}
</schema>
