<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_completed = 'accessibility.completed' | t -%}
{%- assign fb_accessibility_promotion = 'accessibility.promotion' | t -%}
{%- comment -%}
  Countdown Promo Popup
  ----------------------------------------------------
  Side-image popup with: eyebrow, big headline, copyable coupon code,
  countdown timer (DD HH MM SS), CTA button, footer disclaimer. No
  newsletter form — this is a pure promo banner.

  Design ref: dark-bg popup with cream text, image on the left
  (above text on mobile), countdown blocks under the code, yellow CTA.
{%- endcomment -%}

{%- assign sid = section.id -%}

{%- assign block_eyebrow = blank -%}
{%- assign block_headline = blank -%}
{%- assign block_coupon = blank -%}
{%- assign block_countdown = blank -%}
{%- assign block_cta = blank -%}
{%- assign block_disclaimer = blank -%}
{%- assign block_image = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'headline' -%}{%- assign block_headline = b -%}
    {%- when 'coupon' -%}{%- assign block_coupon = b -%}
    {%- when 'countdown' -%}{%- assign block_countdown = b -%}
    {%- when 'cta' -%}{%- assign block_cta = b -%}
    {%- when 'disclaimer' -%}{%- assign block_disclaimer = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign open_mode = section.settings.open_mode | default: 'delay' -%}
{%- assign delay_s = section.settings.delay_s | default: 5 -%}
{%- assign after_dismiss = section.settings.after_dismiss | default: 'after_days' -%}
{%- assign hide_days = section.settings.hide_days | default: 1 -%}
{%- assign mobile_gutter = section.settings.mobile_gutter | default: 32 -%}

<style>
  #shopify-section-{{ sid }} { position: static; }
  .cdp-{{ sid }} { font-family: var(--body-font, inherit); }
  .cdp-{{ sid }} *, .cdp-{{ sid }} *::before, .cdp-{{ sid }} *::after { box-sizing: border-box; }

  .cdp-overlay-{{ sid }} {
    position: fixed; inset: 0;
    background: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %};
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: opacity .3s ease, visibility 0s linear .3s;
    z-index: 2147483646;
  }
  .cdp-{{ sid }}.cdp-open .cdp-overlay-{{ sid }} {
    opacity: {{ section.settings.overlay_opacity | default: 60 | times: 0.01 }};
    pointer-events: auto; visibility: visible; transition-delay: 0s;
  }

  .cdp-card-{{ sid }} {
    position: fixed; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.96);
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s ease, visibility 0s linear .35s;
    z-index: 2147483647;
    width: min(calc(100vw - {{ mobile_gutter }}px), {{ section.settings.popup_width | default: 900 }}px);
    max-height: calc(var(--sl-vh, 1vh) * 100 - 24px);
    overflow: hidden auto; overscroll-behavior: contain;
    background: {% render 'scheme-color', color: section.settings.card_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ section.settings.popup_radius | default: 12 }}px;
    box-shadow: 0 12px 40px rgba(0,0,0,.35);
  }
  .cdp-{{ sid }}.cdp-open .cdp-card-{{ sid }} {
    opacity: 1; pointer-events: auto; visibility: visible; transition-delay: 0s;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (min-width: 750px) {
    .cdp-card-{{ sid }} {
      width: min(92vw, {{ section.settings.popup_width | default: 900 }}px);
    }
  }

  /* Two-column layout: image left, content right (desktop) */
  .cdp-grid-{{ sid }} {
    display: grid;
    grid-template-columns: {% if section.settings.image_side == 'image-right' %}1.05fr .95fr{% else %}.95fr 1.05fr{% endif %};
    align-items: stretch;
    gap: 0;
  }
  .cdp-grid-{{ sid }}.cdp-image-right .cdp-text-{{ sid }} { order: 1; }
  .cdp-grid-{{ sid }}.cdp-image-right .cdp-image-{{ sid }} { order: 2; }
  @media (max-width: 749px) {
    .cdp-grid-{{ sid }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { order: 1; }
    .cdp-grid-{{ sid }} .cdp-text-{{ sid }} { order: 2; }
    {% if section.settings.mobile_image_position == 'hidden' %}
    .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { display: none; }
    .cdp-grid-{{ sid }} { grid-template-rows: 1fr; }
    {% endif %}
  }

  /* Image column */
  .cdp-image-{{ sid }} {
    background: color-mix(in srgb, var(--color-heading) 10%, var(--color-background));
    overflow: hidden;
    min-height: 0;
  }
  .cdp-image-{{ sid }} img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }
  .cdp-image-{{ sid }} .cdp-placeholder { width: 100%; height: 100%; min-height: 240px; display: block; fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
  @media (max-width: 749px) {
    .cdp-image-{{ sid }} { aspect-ratio: 16 / 10; }
  }

  /* Text column */
  .cdp-text-{{ sid }} {
    padding: clamp(24px, 5vw, 44px);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center;
    min-height: 0;
  }

  /* Close button (top-right of card) */
  .cdp-close-{{ sid }} {
    position: absolute; top: 14px; right: 14px;
    width: 44px; height: 44px; padding: 0;
    border: none; border-radius: 50%;
    background: transparent;
    color: {% render 'scheme-color', color: section.settings.close_color, fallback: 'var(--color-heading)' %};
    font-size: 22px; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    z-index: 2;
    transition: transform .2s ease, background .2s ease;
  }
  .cdp-close-{{ sid }}:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .cdp-close-{{ sid }} svg { width: 18px; height: 18px; }
  .cdp-close-{{ sid }}:focus-visible, .cdp-coupon-{{ sid }}:focus-visible, .cdp-cta-{{ sid }}:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* Eyebrow */
  .cdp-eyebrow-{{ sid }} {
    font-size: 13px;
    font-weight: var(--subheading-weight, 600);
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 {{ section.settings.gap_after_eyebrow | default: 18 }}px;
  }
  /* Headline */
  .cdp-headline-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 800);
    line-height: var(--heading-line-height, 1.05);
    letter-spacing: var(--heading-letter-spacing, .04em);
    text-transform: var(--heading-text-transform, uppercase);
    margin: 0 0 {{ section.settings.gap_after_headline | default: 22 }}px;
  }
  @media (max-width: 749px) {
    .cdp-headline-{{ sid }} { font-size: clamp(20px, 6vw, 28px) !important; }
  }

  /* Coupon code button */
  .cdp-coupon-{{ sid }} {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0 0 {{ section.settings.gap_after_coupon | default: 24 }}px;
    min-height: 44px; padding: 12px 24px;
    border: 1px dashed currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700; font-size: 15px; letter-spacing: .1em;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .cdp-coupon-{{ sid }}:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
  .cdp-coupon-{{ sid }}.is-copied {
    background: #1c8d3a; color: #fff; border-color: #1c8d3a; border-style: solid;
  }
  .cdp-coupon-{{ sid }} svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* Countdown grid */
  .cdp-countdown-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ section.settings.cd_gap | default: 8 }}px;
    width: 100%;
    max-width: 360px;
    margin: 0 0 {{ section.settings.gap_after_countdown | default: 24 }}px;
  }
  .cdp-cd-cell-{{ sid }} {
    background: {% render 'scheme-color', color: section.settings.cd_cell_bg, fallback: 'color-mix(in srgb, var(--color-heading) 8%, var(--color-background))' %};
    color: {% render 'scheme-color', color: section.settings.cd_cell_color, fallback: 'var(--color-heading)' %};
    border-radius: {{ section.settings.cd_cell_radius | default: 4 }}px;
    padding: 14px 8px 10px;
    text-align: center;
  }
  .cdp-cd-num-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-size: clamp(22px, 4vw, 30px);
    font-weight: var(--heading-weight, 800);
    line-height: 1;
    letter-spacing: .02em;
  }
  .cdp-cd-label-{{ sid }} {
    font-size: 10px;
    font-weight: var(--subheading-weight, 700);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: .85;
  }
  .cdp-cd-status-{{ sid }} {
    font-size: 13px;
    color: {% render 'scheme-color', color: section.settings.cd_status_color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};
    margin: 6px 0 {{ section.settings.gap_after_countdown | default: 24 }}px;
  }

  /* CTA button: paint, type and shape come from the theme button contract
     (Theme settings > Buttons); this section's own values arrive as --mb-* tokens. */
  .cdp-cta-{{ sid }} { margin: 0 0 {{ section.settings.gap_after_cta | default: 16 }}px; }
  .cdp-{{ sid }}[data-cd-ended] .cdp-countdown-{{ sid }} { display: none; }

  /* Disclaimer */
  .cdp-disclaimer-{{ sid }} {
    font-size: 12px;
    line-height: 1.55;
    opacity: .85;
    margin: 0;
    max-width: 340px;
  }

  /* Tighter mobile spacing override */
  @media (max-width: 749px) {
    .cdp-eyebrow-{{ sid }} { margin-bottom: clamp(10px, 3vw, {{ section.settings.gap_after_eyebrow | default: 18 }}px); }
    .cdp-headline-{{ sid }} { margin-bottom: clamp(12px, 3.2vw, {{ section.settings.gap_after_headline | default: 22 }}px); }
    .cdp-coupon-{{ sid }} { margin-bottom: clamp(14px, 3.4vw, {{ section.settings.gap_after_coupon | default: 24 }}px); }
    .cdp-countdown-{{ sid }} { margin-bottom: clamp(14px, 3.4vw, {{ section.settings.gap_after_countdown | default: 24 }}px); }
    .cdp-cta-{{ sid }} { margin-bottom: clamp(10px, 3vw, {{ section.settings.gap_after_cta | default: 16 }}px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cdp-card-{{ sid }}, .cdp-overlay-{{ sid }}, .cdp-coupon-{{ sid }} {
      transition: none !important;
    }
    .cdp-card-{{ sid }} { transform: translate(-50%, -50%) !important; }
  }
{% comment %}{% endcomment %}</style>

{%- capture cdp_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ section.settings.editor_mode | json }}, "hideEnded": {% if section.settings.hide_when_ended == false %}false{% else %}true{% endif %},
   "trigger": {"mode": {{ open_mode | json }}, "delay": {{ delay_s | json }}, "scroll": {{ section.settings.scroll_pct | default: 50 | json }}, "views": {{ section.settings.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ after_dismiss | json }}, "days": {{ hide_days | json }} } }
{%- endcapture -%}
<section class="cdp-{{ sid }} color-{{ color_scheme }}"
         data-cdp-section="{{ sid }}" data-popup-root="{{ sid }}"
         data-popup-config="{{ cdp_config | strip_newlines | escape }}"
         aria-hidden="true">
  <div class="cdp-overlay-{{ sid }}" aria-hidden="true"></div>
  <div class="cdp-card-{{ sid }} gradient" role="dialog" aria-modal="true"
       aria-labelledby="cdp-title-{{ sid }}" tabindex="-1">
    <button type="button" class="cdp-close-{{ sid }}" data-popup-close aria-label="{{ 'accessibility.close_popup' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

    <div class="cdp-grid-{{ sid }}{% if section.settings.image_side == 'image-right' %} cdp-image-right{% endif %}">
      {%- if block_image != blank -%}
        <div class="cdp-image-{{ sid }}" {{ block_image.shopify_attributes }}>
          {%- if block_image.settings.image != blank -%}
            {{ block_image.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                alt: block_image.settings.alt | default: fb_accessibility_promotion,
                sizes: '(min-width: 750px) 50vw, 100vw',
                widths: '360,540,720,900' }}
          {%- else -%}
            {%- capture demo_cdp -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
            {%- assign demo_cdp = demo_cdp | strip -%}
            {%- if demo_cdp != blank -%}
              <img src="{{ demo_cdp }}" alt="{{ fb_accessibility_promotion }}" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'cdp-placeholder' }}
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cdp-text-{{ sid }}">
        {%- if block_eyebrow != blank and block_eyebrow.settings.text != blank -%}
          <p class="cdp-eyebrow-{{ sid }}"
             style="color: {% render 'scheme-color', color: block_eyebrow.settings.color, fallback: 'var(--color-text)' %}; font-size: {{ block_eyebrow.settings.size | default: 13 }}px;"
             {{ block_eyebrow.shopify_attributes }}>{{ block_eyebrow.settings.text }}</p>
        {%- endif -%}

        {%- if block_headline != blank and block_headline.settings.text != blank -%}
          <h2 class="cdp-headline-{{ sid }}" id="cdp-title-{{ sid }}"
              style="font-size: clamp(22px, 4vw, {{ block_headline.settings.size | default: 32 }}px); color: {% render 'scheme-color', color: block_headline.settings.color, fallback: 'var(--color-heading)' %};"
              {{ block_headline.shopify_attributes }}>{{ block_headline.settings.text }}</h2>
        {%- endif -%}

        {%- if block_coupon != blank and block_coupon.settings.code != blank -%}
          <button type="button" class="cdp-coupon-{{ sid }}" data-cdp-code="{{ block_coupon.settings.code | escape }}"
                  style="color: {% render 'scheme-color', color: block_coupon.settings.color, fallback: 'var(--color-heading)' %};"
                  aria-label="{{ 'accessibility.copy_coupon_code' | t }}" {{ block_coupon.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span data-cdp-code-text>{{ block_coupon.settings.code }}</span>
          </button>
        {%- endif -%}

        {%- if block_countdown != blank -%}
          {%- assign cd_target = block_countdown.settings.end_datetime -%}
          <div class="cdp-countdown-{{ sid }}"
               data-cdp-countdown
               data-cdp-end="{{ cd_target }}"
               data-cdp-status="{{ block_countdown.settings.completed_text | default: fb_accessibility_completed | escape }}"
               {{ block_countdown.shopify_attributes }}>
            {%- assign labels = block_countdown.settings.labels | default: 'DAYS|HOURS|MIN|SEC' | split: '|' -%}
            {%- for piece in labels -%}
              <div class="cdp-cd-cell-{{ sid }}">
                <div class="cdp-cd-num-{{ sid }}" data-cdp-num="{{ forloop.index0 }}">00</div>
                <div class="cdp-cd-label-{{ sid }}">{{ piece }}</div>
              </div>
            {%- endfor -%}
          </div>
          <p class="cdp-cd-status-{{ sid }}" data-cdp-status hidden>{{ block_countdown.settings.completed_text | default: fb_accessibility_completed }}</p>
        {%- endif -%}

        {%- if block_cta != blank and block_cta.settings.label != blank -%}
          {%- assign cdp_custom = false -%}{%- if block_cta.settings.use_theme_button == false -%}{%- assign cdp_custom = true -%}{%- endif -%}
          <a class="cdp-cta-{{ sid }} btn-primary" data-theme-button="primary" data-sl-button
             {% if block_cta.settings.link != blank %}href="{{ block_cta.settings.link }}"{% else %}href="{{ routes.all_products_collection_url }}"{% endif %}
             style="{%- render 'button-overrides', bg: block_cta.settings.bg, text: block_cta.settings.text_color, hover_bg: block_cta.settings.bg_hover, hover_text: block_cta.settings.text_hover, custom: cdp_custom, radius: block_cta.settings.radius, padding_y: block_cta.settings.padding_y, padding_x: block_cta.settings.padding_x, font_size: block_cta.settings.size -%}"
             {{ block_cta.shopify_attributes }}>{{ block_cta.settings.label }}</a>
        {%- endif -%}

        {%- if block_disclaimer != blank and block_disclaimer.settings.text != blank -%}
          <p class="cdp-disclaimer-{{ sid }}"
             style="color: {% render 'scheme-color', color: block_disclaimer.settings.color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};"
             {{ block_disclaimer.shopify_attributes }}>{{ block_disclaimer.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ sid | json }};
  var I18N_COPIED = {{ 'accessibility.copied' | t | json }};

  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__cdp) return;
    root.__cdp = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var card = root.querySelector('.cdp-card-' + SID);
    var overlay = root.querySelector('.cdp-overlay-' + SID);
    var codeBtn = root.querySelector('[data-cdp-code]');
    var cdEl = root.querySelector('[data-cdp-countdown]');
    var cdStatus = root.querySelector('p[data-cdp-status]');
    var timer = 0;

    // Countdown: counts down to the end date (the visitor's own clock and zone).
    var targetMs = cdEl ? Date.parse(cdEl.dataset.cdpEnd || '') : NaN;
    var nums = cdEl ? cdEl.querySelectorAll('[data-cdp-num]') : [];
    function pad(n){ return n < 10 ? '0' + n : String(n); }
    function ended(){ return !isNaN(targetMs) && targetMs - Date.now() <= 0; }
    function tick(){
      if (!cdEl || isNaN(targetMs)) return false;
      var diff = targetMs - Date.now();
      if (diff <= 0) {
        root.setAttribute('data-cd-ended', '');
        if (cdStatus) cdStatus.hidden = false;
        nums.forEach(function(n){ n.textContent = '00'; });
        return false;
      }
      var s = Math.floor(diff / 1000);
      var vals = [Math.floor(s / 86400), Math.floor(s % 86400 / 3600), Math.floor(s % 3600 / 60), s % 60];
      nums.forEach(function(n, i){ if (vals[i] != null) n.textContent = pad(vals[i]); });
      return true;
    }
    function start(){ stop(); if (tick()) timer = setInterval(function(){ if (!tick()) stop(); }, 1000); }
    function stop(){ clearInterval(timer); timer = 0; }
    tick();

    // An offer that has ended is not offered: the popup stays closed on the site.
    if (CFG.hideEnded && ended() && !CFG.design) return;

    var api = P.register({
      id: SID, root: root, dialog: card, backdrop: overlay,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-cdp-trigger="' + SID + '"]' }, CFG.trigger),
      frequency: { mode: CFG.frequency.mode === 'every_visit' ? 'always' : CFG.frequency.mode, days: CFG.frequency.days },
      open: function(){ root.classList.add('cdp-open'); start(); },
      close: function(){ root.classList.remove('cdp-open'); stop(); }
    });

    if (codeBtn) {
      var codeText = codeBtn.querySelector('[data-cdp-code-text]');
      var original = codeText ? codeText.textContent : '';
      codeBtn.addEventListener('click', function(){
        var code = (codeBtn.dataset.cdpCode || '').trim();
        if (!code) return;
        P.copy(code).catch(function(){}).then(function(){
          codeBtn.classList.add('is-copied');
          if (codeText) codeText.textContent = I18N_COPIED;
          setTimeout(function(){ codeBtn.classList.remove('is-copied'); if (codeText) codeText.textContent = original; }, 2200);
        });
      });
    }
    window['CDP_open_' + SID] = function(){ api && api.show(); };
    window['CDP_close_' + SID] = function(){ api && api.hide(); };
    window['CDP_reset_' + SID] = function(){ api && api.reset(); };
  }

  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "countdown-promo-popup",
  "name": "Countdown Promo Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "open_mode",
      "label": "Opens",
      "default": "delay",
      "options": [
        {
          "value": "immediate",
          "label": "On page load"
        },
        {
          "value": "delay",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        },
        {
          "value": "exit",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "manual",
          "label": "From a link"
        }
      ]
    },
    {
      "type": "range",
      "id": "delay_s",
      "label": "Delay",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "scroll_pct",
      "label": "Scrolled",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "page_views",
      "label": "Page views",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
