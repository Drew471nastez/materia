        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Custom colours",
        "default": false,
        "info": "Off, the popup follows its colour scheme."
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "close_color",
        "label": "Close icon",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Backdrop",
        "default": "#000000",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Backdrop opacity",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "%",
        "default": 60
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Custom fonts",
        "default": false,
        "info": "Off, the popup uses the theme fonts."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts == true }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts == true }}"
      },
      {
        "type": "header",
        "content": "Countdown"
      },
      {
        "type": "color",
        "id": "cd_cell_bg",
        "label": "Cell background",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "color",
        "id": "cd_cell_color",
        "label": "Cell text",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "range",
        "id": "cd_cell_radius",
        "label": "Cell radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 4
      },
      {
        "type": "range",
        "id": "cd_gap",
        "label": "Cell gap",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "color",
        "id": "cd_status_color",
        "label": "Ended text",
        "visible_if": "{{ section.settings.enable_custom_style == true }}"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "gap_after_eyebrow",
        "label": "After eyebrow",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "gap_after_headline",
        "label": "After headline",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "gap_after_coupon",
        "label": "After code",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "gap_after_countdown",
        "label": "After countdown",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "gap_after_cta",
        "label": "After button",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Special offer"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 10,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "headline",
        "name": "Headline",
        "limit": 1,
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Headline",
            "default": "Shop the offer while the timer runs"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 18,
            "max": 48,
            "step": 1,
            "unit": "px",
            "default": 32
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "coupon",
        "name": "Coupon code",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "code",
            "label": "Code",
            "info": "Your own discount code. Empty, no code is shown."
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "countdown",
        "name": "Countdown",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "end_datetime",
            "label": "Ends at",
            "placeholder": "2026-12-31T23:59",
            "info": "When your offer ends, for example 2026-12-31T23:59. Empty, no timer is shown."
          },
          {
            "type": "text",
            "id": "labels",
            "label": "Labels",
            "default": "DAYS|HOURS|MIN|SEC",
            "info": "Days|Hours|Min|Sec"
          },
          {
            "type": "text",
            "id": "completed_text",
            "label": "Ended text",
            "default": "Completed"
          }
        ]
      },
      {
        "type": "cta",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "SHOP NOW"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Theme button style",
            "default": true
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 11,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Side padding",
            "min": 16,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 36,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Height padding",
            "min": 8,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 12,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 4,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Hover background",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          },
          {
            "type": "color",
            "id": "text_hover",
            "label": "Hover text",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "disclaimer",
        "name": "Small print",
        "limit": 1,
        "settings": [
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Terms of the offer"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "alt",
            "label": "Alt text",
            "default": "Promotion"
          }
        ]
      }
    ],
    "presets": []
  }
}
</schema>