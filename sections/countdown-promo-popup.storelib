<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_completed = 'accessibility.completed' | t -%}
{%- assign fb_accessibility_promotion = 'accessibility.promotion' | t -%}
{%- comment -%}
  Countdown Promo Popup
  ----------------------------------------------------
  Side-image popup with: eyebrow, big headline, copyable coupon code,
  countdown timer (DD HH MM SS), CTA button, footer disclaimer. No
  newsletter form — this is a pure promo banner.

  Design ref: dark-bg popup with cream text, image on the left
  (above text on mobile), countdown blocks under the code, yellow CTA.
{%- endcomment -%}

{%- assign sid = section.id -%}

{%- assign block_eyebrow = blank -%}
{%- assign block_headline = blank -%}
{%- assign block_coupon = blank -%}
{%- assign block_countdown = blank -%}
{%- assign block_cta = blank -%}
{%- assign block_disclaimer = blank -%}
{%- assign block_image = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'headline' -%}{%- assign block_headline = b -%}
    {%- when 'coupon' -%}{%- assign block_coupon = b -%}
    {%- when 'countdown' -%}{%- assign block_countdown = b -%}
    {%- when 'cta' -%}{%- assign block_cta = b -%}
    {%- when 'disclaimer' -%}{%- assign block_disclaimer = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign open_mode = section.settings.open_mode | default: 'delay' -%}
{%- assign delay_s = section.settings.delay_s | default: 5 -%}
{%- assign after_dismiss = section.settings.after_dismiss | default: 'after_days' -%}
{%- assign hide_days = section.settings.hide_days | default: 1 -%}
{%- assign mobile_gutter = section.settings.mobile_gutter | default: 32 -%}

<style>
  #shopify-section-{{ sid }} { position: static; }
  .cdp-{{ sid }} { font-family: var(--body-font, inherit); }
  .cdp-{{ sid }} *, .cdp-{{ sid }} *::before, .cdp-{{ sid }} *::after { box-sizing: border-box; }

  .cdp-overlay-{{ sid }} {
    position: fixed; inset: 0;
    background: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %};
    opacity: 0; pointer-events: none;
    transition: opacity .3s ease;
    z-index: 2147483646;
  }
  .cdp-{{ sid }}.cdp-open .cdp-overlay-{{ sid }} {
    opacity: {{ section.settings.overlay_opacity | default: 60 | times: 0.01 }};
    pointer-events: auto;
  }

  .cdp-card-{{ sid }} {
    position: fixed; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.96);
    opacity: 0; pointer-events: none;
    transition: transform .3s ease, opacity .3s ease;
    z-index: 2147483647;
    width: min(calc(100vw - {{ mobile_gutter }}px), {{ section.settings.popup_width | default: 900 }}px);
    max-height: calc(100vh - 24px);
    overflow: hidden;
    background: {% render 'scheme-color', color: section.settings.card_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ section.settings.popup_radius | default: 12 }}px;
    box-shadow: 0 12px 40px rgba(0,0,0,.35);
  }
  .cdp-{{ sid }}.cdp-open .cdp-card-{{ sid }} {
    opacity: 1; pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (min-width: 750px) {
    .cdp-card-{{ sid }} {
      width: min(92vw, {{ section.settings.popup_width | default: 900 }}px);
    }
  }

  /* Two-column layout: image left, content right (desktop) */
  .cdp-grid-{{ sid }} {
    display: grid;
    grid-template-columns: {% if section.settings.image_side == 'image-right' %}1.05fr .95fr{% else %}.95fr 1.05fr{% endif %};
    align-items: stretch;
    gap: 0;
  }
  .cdp-grid-{{ sid }}.cdp-image-right .cdp-text-{{ sid }} { order: 1; }
  .cdp-grid-{{ sid }}.cdp-image-right .cdp-image-{{ sid }} { order: 2; }
  @media (max-width: 749px) {
    .cdp-grid-{{ sid }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { order: 1; }
    .cdp-grid-{{ sid }} .cdp-text-{{ sid }} { order: 2; }
    {% if section.settings.mobile_image_position == 'hidden' %}
    .cdp-grid-{{ sid }} .cdp-image-{{ sid }} { display: none; }
    .cdp-grid-{{ sid }} { grid-template-rows: 1fr; }
    {% endif %}
  }

  /* Image column */
  .cdp-image-{{ sid }} {
    background: color-mix(in srgb, var(--color-heading) 10%, var(--color-background));
    overflow: hidden;
    min-height: 0;
  }
  .cdp-image-{{ sid }} img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }
  .cdp-image-{{ sid }} .cdp-placeholder { width: 100%; height: 100%; min-height: 240px; display: block; fill: color-mix(in srgb, var(--color-text) 30%, transparent); }
  @media (max-width: 749px) {
    .cdp-image-{{ sid }} { aspect-ratio: 16 / 10; }
  }

  /* Text column */
  .cdp-text-{{ sid }} {
    padding: clamp(24px, 5vw, 44px);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center;
    min-height: 0;
  }

  /* Close button (top-right of card) */
  .cdp-close-{{ sid }} {
    position: absolute; top: 14px; right: 14px;
    width: 34px; height: 34px;
    border: none; border-radius: 50%;
    background: transparent;
    color: {% render 'scheme-color', color: section.settings.close_color, fallback: 'var(--color-heading)' %};
    font-size: 22px; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    z-index: 2;
    transition: transform .2s ease, background .2s ease;
  }
  .cdp-close-{{ sid }}:hover { background: color-mix(in srgb, currentColor 10%, transparent); transform: scale(1.05); }
  .cdp-close-{{ sid }}:focus-visible, .cdp-coupon-{{ sid }}:focus-visible, .cdp-cta-{{ sid }}:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* Eyebrow */
  .cdp-eyebrow-{{ sid }} {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 {{ section.settings.gap_after_eyebrow | default: 18 }}px;
  }
  /* Headline */
  .cdp-headline-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 800);
    line-height: 1.05;
    letter-spacing: .04em;
    text-transform: uppercase;
    margin: 0 0 {{ section.settings.gap_after_headline | default: 22 }}px;
  }
  @media (max-width: 749px) {
    .cdp-headline-{{ sid }} { font-size: clamp(20px, 6vw, 28px) !important; }
  }

  /* Coupon code button */
  .cdp-coupon-{{ sid }} {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0 0 {{ section.settings.gap_after_coupon | default: 24 }}px;
    padding: 12px 24px;
    border: 1px dashed currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700; font-size: 15px; letter-spacing: .1em;
    cursor: pointer;
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .cdp-coupon-{{ sid }}:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
  .cdp-coupon-{{ sid }}.is-copied {
    background: #1c8d3a; color: #fff; border-color: #1c8d3a; border-style: solid;
  }
  .cdp-coupon-{{ sid }} svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* Countdown grid */
  .cdp-countdown-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ section.settings.cd_gap | default: 8 }}px;
    width: 100%;
    max-width: 360px;
    margin: 0 0 {{ section.settings.gap_after_countdown | default: 24 }}px;
  }
  .cdp-cd-cell-{{ sid }} {
    background: {% render 'scheme-color', color: section.settings.cd_cell_bg, fallback: 'color-mix(in srgb, var(--color-heading) 8%, var(--color-background))' %};
    color: {% render 'scheme-color', color: section.settings.cd_cell_color, fallback: 'var(--color-heading)' %};
    border-radius: {{ section.settings.cd_cell_radius | default: 4 }}px;
    padding: 14px 8px 10px;
    text-align: center;
  }
  .cdp-cd-num-{{ sid }} {
    font-family: var(--heading-font, inherit);
    font-size: clamp(22px, 4vw, 30px);
    font-weight: var(--heading-weight, 800);
    line-height: 1;
    letter-spacing: .02em;
  }
  .cdp-cd-label-{{ sid }} {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: .85;
  }
  .cdp-cd-status-{{ sid }} {
    font-size: 13px;
    color: {% render 'scheme-color', color: section.settings.cd_status_color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};
    margin: 6px 0 {{ section.settings.gap_after_countdown | default: 24 }}px;
  }

  /* CTA button */
  .cdp-cta-{{ sid }} {
    display: inline-block;
    text-decoration: none;
    padding: var(--cdp-cta-py, 12px) var(--cdp-cta-px, 36px);
    border-radius: var(--cdp-cta-r, 4px);
    border: var(--cdp-cta-bw, 0px) solid var(--btn-primary-border-color, transparent);
    background: var(--cdp-cta-bg);
    color: var(--cdp-cta-c);
    font-weight: var(--btn-font-weight, 700);
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: var(--cdp-cta-fs, 13px);
    transition: background-color .25s ease, color .25s ease, transform .15s ease;
    margin: 0 0 {{ section.settings.gap_after_cta | default: 16 }}px;
  }
  .cdp-cta-{{ sid }}:hover { transform: translateY(-1px); background: var(--cdp-cta-bgh); color: var(--cdp-cta-ch); }

  /* Disclaimer */
  .cdp-disclaimer-{{ sid }} {
    font-size: 12px;
    line-height: 1.55;
    opacity: .85;
    margin: 0;
    max-width: 340px;
  }

  /* Tighter mobile spacing override */
  @media (max-width: 749px) {
    .cdp-eyebrow-{{ sid }} { margin-bottom: clamp(10px, 3vw, {{ section.settings.gap_after_eyebrow | default: 18 }}px); }
    .cdp-headline-{{ sid }} { margin-bottom: clamp(12px, 3.2vw, {{ section.settings.gap_after_headline | default: 22 }}px); }
    .cdp-coupon-{{ sid }} { margin-bottom: clamp(14px, 3.4vw, {{ section.settings.gap_after_coupon | default: 24 }}px); }
    .cdp-countdown-{{ sid }} { margin-bottom: clamp(14px, 3.4vw, {{ section.settings.gap_after_countdown | default: 24 }}px); }
    .cdp-cta-{{ sid }} { margin-bottom: clamp(10px, 3vw, {{ section.settings.gap_after_cta | default: 16 }}px); }
  }

  body.cdp-no-scroll-{{ sid }} { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .cdp-card-{{ sid }}, .cdp-overlay-{{ sid }}, .cdp-coupon-{{ sid }}, .cdp-cta-{{ sid }} {
      transition: none !important;
    }
  }
{% comment %}{% endcomment %}</style>

<section class="cdp-{{ sid }} color-{{ color_scheme }}"
         data-cdp-section="{{ sid }}"
         aria-hidden="true">
  <div class="cdp-overlay-{{ sid }}" aria-hidden="true"></div>
  <div class="cdp-card-{{ sid }} gradient" role="dialog" aria-modal="true"
       aria-labelledby="cdp-title-{{ sid }}" tabindex="-1">
    <button type="button" class="cdp-close-{{ sid }}" aria-label="{{ 'accessibility.close_popup' | t }}">✕</button>

    <div class="cdp-grid-{{ sid }}{% if section.settings.image_side == 'image-right' %} cdp-image-right{% endif %}">
      {%- if block_image != blank -%}
        <div class="cdp-image-{{ sid }}" {{ block_image.shopify_attributes }}>
          {%- if block_image.settings.image != blank -%}
            {{ block_image.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                alt: block_image.settings.alt | default: fb_accessibility_promotion,
                sizes: '(min-width: 750px) 50vw, 100vw',
                widths: '360,540,720,900' }}
          {%- else -%}
            {%- capture demo_cdp -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
            {%- assign demo_cdp = demo_cdp | strip -%}
            {%- if demo_cdp != blank -%}
              <img src="{{ demo_cdp }}" alt="{{ fb_accessibility_promotion }}" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'cdp-placeholder' }}
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cdp-text-{{ sid }}">
        {%- if block_eyebrow != blank and block_eyebrow.settings.text != blank -%}
          <p class="cdp-eyebrow-{{ sid }}"
             style="color: {% render 'scheme-color', color: block_eyebrow.settings.color, fallback: 'var(--color-text)' %}; font-size: {{ block_eyebrow.settings.size | default: 13 }}px;"
             {{ block_eyebrow.shopify_attributes }}>{{ block_eyebrow.settings.text }}</p>
        {%- endif -%}

        {%- if block_headline != blank and block_headline.settings.text != blank -%}
          <h2 class="cdp-headline-{{ sid }}" id="cdp-title-{{ sid }}"
              style="font-size: clamp(22px, 4vw, {{ block_headline.settings.size | default: 32 }}px); color: {% render 'scheme-color', color: block_headline.settings.color, fallback: 'var(--color-heading)' %};"
              {{ block_headline.shopify_attributes }}>{{ block_headline.settings.text }}</h2>
        {%- endif -%}

        {%- if block_coupon != blank and block_coupon.settings.code != blank -%}
          <button type="button" class="cdp-coupon-{{ sid }}" data-cdp-code="{{ block_coupon.settings.code | escape }}"
                  style="color: {% render 'scheme-color', color: block_coupon.settings.color, fallback: 'var(--color-heading)' %};"
                  aria-label="{{ 'accessibility.copy_coupon_code' | t }}" {{ block_coupon.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span data-cdp-code-text>{{ block_coupon.settings.code }}</span>
          </button>
        {%- endif -%}

        {%- if block_countdown != blank -%}
          {%- assign cd_target = block_countdown.settings.end_datetime -%}
          <div class="cdp-countdown-{{ sid }}"
               data-cdp-countdown
               data-cdp-end="{{ cd_target }}"
               data-cdp-status="{{ block_countdown.settings.completed_text | default: fb_accessibility_completed | escape }}"
               {{ block_countdown.shopify_attributes }}>
            {%- assign labels = block_countdown.settings.labels | default: 'DAYS|HOURS|MIN|SEC' | split: '|' -%}
            {%- for piece in labels -%}
              <div class="cdp-cd-cell-{{ sid }}">
                <div class="cdp-cd-num-{{ sid }}" data-cdp-num="{{ forloop.index0 }}">00</div>
                <div class="cdp-cd-label-{{ sid }}">{{ piece }}</div>
              </div>
            {%- endfor -%}
          </div>
          <p class="cdp-cd-status-{{ sid }}" data-cdp-status hidden>{{ block_countdown.settings.completed_text | default: fb_accessibility_completed }}</p>
        {%- endif -%}

        {%- if block_cta != blank and block_cta.settings.label != blank -%}
          <a class="cdp-cta-{{ sid }}"
             href="{{ block_cta.settings.link | default: '#' }}"
             style="--cdp-cta-bg: {% render 'scheme-color', color: block_cta.settings.bg, fallback: 'var(--btn-primary-bg-color)' %}; --cdp-cta-c: {% render 'scheme-color', color: block_cta.settings.text_color, fallback: 'var(--btn-primary-color)' %}; --cdp-cta-bgh: {% render 'scheme-color', color: block_cta.settings.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %}; --cdp-cta-ch: {% render 'scheme-color', color: block_cta.settings.text_hover, fallback: 'var(--btn-primary-hover-color)' %}; {% if block_cta.settings.use_theme_button %}--cdp-cta-r: var(--btn-radius, 4px); --cdp-cta-py: var(--btn-padding-y, 12px); --cdp-cta-px: var(--btn-padding-x, 36px); --cdp-cta-fs: var(--btn-font-size, 13px); --cdp-cta-bw: var(--btn-border-width, 0px);{% else %}--cdp-cta-r: {{ block_cta.settings.radius | default: 4 }}px; --cdp-cta-py: {{ block_cta.settings.padding_y | default: 12 }}px; --cdp-cta-px: {{ block_cta.settings.padding_x | default: 36 }}px; --cdp-cta-fs: {{ block_cta.settings.size | default: 13 }}px;{% endif %}"
             {{ block_cta.shopify_attributes }}>{{ block_cta.settings.label }}</a>
        {%- endif -%}

        {%- if block_disclaimer != blank and block_disclaimer.settings.text != blank -%}
          <p class="cdp-disclaimer-{{ sid }}"
             style="color: {% render 'scheme-color', color: block_disclaimer.settings.color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};"
             {{ block_disclaimer.shopify_attributes }}>{{ block_disclaimer.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const SECTION_ID = '{{ sid }}';
  const I18N_COPIED = {{ 'accessibility.copied' | t | json }};
  const lsKey = 'cdp_dismissed_' + SECTION_ID;
  const neverKey = 'cdp_never_' + SECTION_ID;
  const bodyLock = 'cdp-no-scroll-' + SECTION_ID;
  const afterDismiss = '{{ after_dismiss }}';
  const hideDays = {{ hide_days }};
  const openMode = '{{ open_mode }}';
  const delayMs = {{ delay_s }} * 1000;
  const editorModeOn = {% if section.settings.editor_mode %}true{% else %}false{% endif %};

  const LS = {
    get(k){ try { return localStorage.getItem(k); } catch(_){ return null; } },
    set(k,v){ try { localStorage.setItem(k, v); } catch(_){} },
    rm(k){ try { localStorage.removeItem(k); } catch(_){} }
  };

  function init() {
    const root = document.querySelector('.cdp-' + SECTION_ID);
    if (!root) return;
    if (root.__cdpInited) return;
    root.__cdpInited = true;

    const card = root.querySelector('.cdp-card-' + SECTION_ID);
    const overlay = root.querySelector('.cdp-overlay-' + SECTION_ID);
    const closeBtn = root.querySelector('.cdp-close-' + SECTION_ID);
    const codeBtn = root.querySelector('[data-cdp-code]');
    const cdEl = root.querySelector('[data-cdp-countdown]');
    const cdStatus = root.querySelector('p[data-cdp-status]');
    const inDesign = !!(window.Shopify && Shopify.designMode);
    const forceEditor = editorModeOn && inDesign;

    function isSuppressed(){
      if (forceEditor) return false;
      if (LS.get(neverKey) === '1') return true;
      if (afterDismiss === 'every_visit') return false;
      const until = parseInt(LS.get(lsKey) || '0', 10);
      return !!(until && Date.now() < until);
    }
    function persistDismiss(){
      if (forceEditor) return;
      if (afterDismiss === 'never') LS.set(neverKey, '1');
      else if (afterDismiss === 'after_days' && hideDays > 0) {
        LS.set(lsKey, String(Date.now() + hideDays * 24*60*60*1000));
      }
    }
    function lockBody(){ if (!inDesign) document.body.classList.add(bodyLock); }
    function unlockBody(){ document.body.classList.remove(bodyLock); }

    let prevActive = null;
    function show(){
      if (isSuppressed()) return;
      root.classList.add('cdp-open');
      root.setAttribute('aria-hidden','false');
      lockBody();
      prevActive = document.activeElement;
      if (card && card.focus) try { card.focus({preventScroll: true}); } catch(_){}
    }
    function hide(){
      root.classList.remove('cdp-open');
      root.setAttribute('aria-hidden','true');
      unlockBody();
      if (prevActive && prevActive.focus) try { prevActive.focus({preventScroll: true}); } catch(_){}
      persistDismiss();
    }

    const listeners = [];
    function on(t, e, f, o){ if(!t) return; t.addEventListener(e,f,o); listeners.push({t,e,f,o}); }
    on(closeBtn,'click',hide);
    on(overlay,'click',hide);
    on(document,'keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('cdp-open')) hide(); });

    // Bulletproof copy
    function copy(text){
      return new Promise((resolve, reject) => {
        if (!text) return reject('empty');
        const useAsync = navigator.clipboard
          && typeof navigator.clipboard.writeText === 'function'
          && (window.isSecureContext !== false);
        const fallback = () => {
          try {
            const ta = document.createElement('textarea');
            ta.value = text; ta.setAttribute('readonly','');
            Object.assign(ta.style, { position:'fixed', top:'0', left:'0', width:'2em', height:'2em', padding:'0', border:'none', outline:'none', boxShadow:'none', background:'transparent', opacity:'0' });
            document.body.appendChild(ta); ta.focus(); ta.select(); ta.setSelectionRange(0, text.length);
            const ok = document.execCommand && document.execCommand('copy');
            document.body.removeChild(ta);
            ok ? resolve() : reject('execCommand failed');
          } catch(err) { reject(err); }
        };
        useAsync ? navigator.clipboard.writeText(text).then(resolve).catch(fallback) : fallback();
      });
    }
    if (codeBtn) {
      const codeTextEl = codeBtn.querySelector('[data-cdp-code-text]');
      on(codeBtn, 'click', () => {
        const code = (codeBtn.dataset.cdpCode || '').trim();
        if (!code) return;
        const original = codeTextEl ? codeTextEl.textContent : codeBtn.textContent;
        const done = () => {
          codeBtn.classList.add('is-copied');
          if (codeTextEl) codeTextEl.textContent = I18N_COPIED;
          else codeBtn.textContent = I18N_COPIED;
          setTimeout(() => {
            codeBtn.classList.remove('is-copied');
            if (codeTextEl) codeTextEl.textContent = original;
            else codeBtn.textContent = original;
          }, 2200);
        };
        copy(code).then(done).catch(done);
      });
    }

    // Countdown
    if (cdEl) {
      const targetStr = cdEl.dataset.cdpEnd;
      const numEls = cdEl.querySelectorAll('[data-cdp-num]');
      const targetMs = targetStr ? Date.parse(targetStr) : NaN;

      function pad(n){ return n < 10 ? '0' + n : '' + n; }
      function tick(){
        if (isNaN(targetMs)) {
          numEls.forEach(n => n.textContent = '00');
          return;
        }
        let diff = targetMs - Date.now();
        if (diff <= 0) {
          numEls.forEach(n => n.textContent = '00');
          if (cdStatus) cdStatus.hidden = false;
          return false;
        }
        const days = Math.floor(diff / 86400000); diff -= days * 86400000;
        const hours = Math.floor(diff / 3600000); diff -= hours * 3600000;
        const mins = Math.floor(diff / 60000); diff -= mins * 60000;
        const secs = Math.floor(diff / 1000);
        const vals = [days, hours, mins, secs];
        numEls.forEach((n, i) => n.textContent = pad(vals[i]));
        return true;
      }
      if (tick()) {
        const timer = setInterval(() => { if (!tick()) clearInterval(timer); }, 1000);
      }
    }

    // Manual / external hooks
    window['CDP_open_' + SECTION_ID] = show;
    window['CDP_close_' + SECTION_ID] = hide;
    window['CDP_reset_' + SECTION_ID] = function() {
      [lsKey, neverKey].forEach(LS.rm);
    };

    // Initial state
    if (forceEditor) {
      root.classList.add('cdp-open');
      root.setAttribute('aria-hidden','false');
    } else if (!isSuppressed()) {
      if (openMode === 'immediate') show();
      else if (openMode === 'delay') setTimeout(show, delayMs > 0 ? delayMs : 0);
      else if (openMode === 'exit') {
        const h = (e) => { if (e.clientY <= 8) { show(); document.removeEventListener('mousemove', h); } };
        on(document, 'mousemove', h, { passive: true });
      } else if (openMode === 'manual') {
        document.querySelectorAll('[data-cdp-trigger="' + SECTION_ID + '"]').forEach(el => {
          on(el, 'click', (e) => { e.preventDefault(); show(); });
        });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else { init(); }
  window.addEventListener('pageshow', (e) => { if (e.persisted) init(); });
  document.addEventListener('storelib:section-load', (e) => {
    if (e.detail && String(e.detail.sectionId) === SECTION_ID) init();
  });
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail && e.detail.sectionId === SECTION_ID) init();
    });
  }
})();
{% comment %}{% endcomment %}</script>



