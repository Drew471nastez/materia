<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Quote Banner: one quote and its author on a card. Theme
  first: the card is the colour scheme turned over (heading colour behind,
  background colour for the words), fonts and weights from Theme settings >
  Typography. Custom colours, corners, shadow and fonts only when their switch
  is on. Every value is a CSS variable printed here for the first paint and
  repainted live by live-text.js with the same names and fallbacks.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign quote_block = section.blocks | where: 'type', 'quote' | first
  assign author_block = section.blocks | where: 'type', 'author' | first
  case st.section_width
    when 'container'
      assign qb_wrap_max = 'calc(var(--page-width, 1300px) + 3rem)'
    when 'fluid_container'
      assign qb_wrap_max = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
    else
      assign qb_wrap_max = 'none'
  endcase
  if st.section_width == 'full_width'
    assign qb_wrap_pad = '0px'
    assign qb_wrap_pad_wide = '0px'
  elsif st.section_width == 'stretch_width'
    assign qb_wrap_pad = '1.5rem'
    assign qb_wrap_pad_wide = '3rem'
  else
    assign qb_wrap_pad = '1.5rem'
    assign qb_wrap_pad_wide = '1.5rem'
  endif
-%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.reset_spacing -%}
<style data-rs-bulletproof>
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if st.enable_custom_fonts -%}
<style>
  {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if quote_block and quote_block.settings.enable_custom_fonts and quote_block.settings.font.family != blank -%}
<style>{{ quote_block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--qb-wrap-max, none);
    margin-inline: auto;
    padding-inline: var(--qb-wrap-pad, 0px);
    margin-top: var(--qb-mt-m, 0px) !important;
    margin-bottom: var(--qb-mb-m, 0px) !important;
    --qb-mt-m: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_top_mobile | default: 0 }}{% endif %}px;
    --qb-mb-m: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_bottom_mobile | default: 0 }}{% endif %}px;
    --qb-mt-d: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_top_desktop | default: 0 }}{% endif %}px;
    --qb-mb-d: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_bottom_desktop | default: 0 }}{% endif %}px;
    --qb-wrap-max: {{ qb_wrap_max }};
    --qb-wrap-pad: {{ qb_wrap_pad }};
    --qb-wrap-pad-wide: {{ qb_wrap_pad_wide }};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} { margin-top: var(--qb-mt-d, 0px) !important; margin-bottom: var(--qb-mb-d, 0px) !important; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} { padding-inline: var(--qb-wrap-pad-wide, 0px); }
  }
  #shopify-section-{{ section.id }} .quote-banner { background: var(--qb-section-bg); font-family: var(--qb-body-font); container-type: inline-size; }
  #shopify-section-{{ section.id }} .qb-wrap { display: flex; justify-content: center; padding: 20px; box-sizing: border-box; }
  #shopify-section-{{ section.id }} .qb-card {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--qb-max);
    background: var(--qb-bg);
    border-radius: var(--qb-radius);
    box-shadow: var(--qb-shadow);
    padding: var(--qb-pt-m) var(--qb-px-m) var(--qb-pb-m);
    text-align: var(--qb-align-m);
  }
  #shopify-section-{{ section.id }} .qb-content { margin: 0 auto; max-width: 100%; }
  #shopify-section-{{ section.id }} .quote-banner .qb-quote {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    quotes: none;
    line-height: 1.3;
    letter-spacing: 0.2px;
    font-family: var(--qb-quote-font, var(--qb-heading-font));
    font-size: var(--qb-quote-size-m);
    font-weight: var(--qb-quote-weight);
    font-style: normal;
    color: var(--qb-quote-ink);
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .qb-quote--curly::before { content: "\201C"; }
  #shopify-section-{{ section.id }} .qb-quote--curly::after { content: "\201D"; }
  #shopify-section-{{ section.id }} .qb-author {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: inherit;
    gap: 12px;
    max-width: 100%;
    margin-top: var(--qb-gap-top);
    font-size: var(--qb-author-size-m);
    font-weight: 600;
    color: var(--qb-author-ink);
  }
  #shopify-section-{{ section.id }} .qb-avatar {
    display: inline-flex;
    flex: 0 0 auto;
    width: var(--qb-avatar);
    height: var(--qb-avatar);
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 25%, transparent);
  }
  #shopify-section-{{ section.id }} .qb-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .qb-author-name { font-weight: 700; }
  #shopify-section-{{ section.id }} .qb-author-role { opacity: .95; font-weight: 500; }
  #shopify-section-{{ section.id }} .quote-banner .qb-signature img { display: block; max-width: var(--qb-sig-m) !important; height: auto; }
  #shopify-section-{{ section.id }} .qb-signature--inline { display: none; }
  #shopify-section-{{ section.id }} .qb-signature--below { margin-top: 12px; display: flex; justify-content: var(--qb-justify-m); }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .qb-card { padding: var(--qb-pt-d) var(--qb-px-d) var(--qb-pb-d); text-align: var(--qb-align-d); }
    #shopify-section-{{ section.id }} .qb-content { max-width: var(--qb-text-max); }
    #shopify-section-{{ section.id }} .quote-banner .qb-quote { font-size: var(--qb-quote-size-d); }
    #shopify-section-{{ section.id }} .qb-author { font-size: var(--qb-author-size-d); }
    #shopify-section-{{ section.id }} .quote-banner .qb-signature img { max-width: var(--qb-sig-d) !important; }
    #shopify-section-{{ section.id }} .qb-signature--below { justify-content: var(--qb-justify-d); }
    #shopify-section-{{ section.id }} [data-signature-position='right'] .qb-signature--inline { display: inline-block; }
    #shopify-section-{{ section.id }} [data-signature-position='right'] ~ .qb-signature--below { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .quote-banner, #shopify-section-{{ section.id }} .quote-banner * { animation: none !important; transition: none !important; }
  }
  #shopify-section-{{ section.id }} .quote-banner [hidden] { display: none !important; }
{% comment %}{% endcomment %}</style>
{%- capture qb_section_bg -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
{%- capture qb_bg -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.bg_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}{%- endcapture -%}
{%- capture qb_heading_font -%}{% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %}{%- endcapture -%}
{%- capture qb_body_font -%}{% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %}{%- endcapture -%}
<section
  id="qb-{{ section.id }}"
  class="quote-banner color-{{ color_scheme }} gradient"
  data-live-text="quotebanner"
  data-lt-section="{{ section.id }}"
  data-lt-settings="{{ section.settings | json | escape }}"
  {% if st.enable_custom_fonts %}data-own-font{% endif %}
  style="--qb-section-bg: {{ qb_section_bg | strip }}; --qb-bg: {{ qb_bg | strip }}; --qb-radius: {% if st.enable_custom_style %}{{ st.radius }}px{% else %}var(--rounded-radius, 0px){% endif %}; --qb-shadow: {% if st.enable_custom_style and st.enable_shadow %}0 8px 28px rgba(0,0,0,.18){% else %}none{% endif %}; --qb-max: {% if st.max_width == 'full' %}100%{% else %}{{ st.custom_max_width }}px{% endif %}; --qb-text-max: {{ st.text_max_width }}px; --qb-gap-top: {{ st.gap_top }}px; --qb-align-d: {{ st.text_align_desktop }}; --qb-align-m: {{ st.text_align_mobile }}; --qb-justify-d: {% if st.text_align_desktop == 'center' %}center{% else %}flex-start{% endif %}; --qb-justify-m: {% if st.text_align_mobile == 'center' %}center{% else %}flex-start{% endif %}; --qb-pt-d: {{ st.top_padding_desktop }}px; --qb-pb-d: {{ st.bottom_padding_desktop }}px; --qb-px-d: {{ st.pad_x_desktop }}px; --qb-pt-m: {{ st.top_padding_mobile }}px; --qb-pb-m: {{ st.bottom_padding_mobile }}px; --qb-px-m: {{ st.pad_x_mobile }}px; --qb-heading-font: {{ qb_heading_font | strip }}; --qb-body-font: {{ qb_body_font | strip }};"
>
  <div class="qb-wrap">
    <div class="qb-card">
      <div class="qb-content">
        {%- if quote_block -%}
          {%- assign qs = quote_block.settings -%}
          {%- capture qb_ink -%}{% if qs.enable_custom_style %}{% render 'scheme-color', color: qs.quote_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
          <blockquote
            class="qb-quote{% if qs.use_curly_quotes %} qb-quote--curly{% endif %}"
            data-lt-block="{{ quote_block.id }}" data-lt-type="quote" data-lt-settings="{{ qs | json | escape }}" {{ quote_block.shopify_attributes }}
            {% if qs.enable_custom_fonts or st.enable_custom_fonts %}data-own-font{% endif %}
            style="--qb-quote-ink: {{ qb_ink | strip }}; --qb-quote-size-d: {{ qs.quote_size }}px; --qb-quote-size-m: {{ qs.quote_size_mobile }}px; --qb-quote-weight: {% if qs.quote_weight == 'theme' or qs.quote_weight == blank %}var(--heading-weight, 700){% else %}{{ qs.quote_weight }}{% endif %};{% if qs.enable_custom_fonts and qs.font.family != blank %} --qb-quote-font: {{ qs.font.family }}, {{ qs.font.fallback_families | default: 'sans-serif' }};{% endif %}"
          >{{ qs.quote_text | escape | newline_to_br }}</blockquote>
        {%- endif -%}
        {%- if author_block -%}
          {%- assign as = author_block.settings -%}
          {%- assign avatar = as.avatar -%}
          {%- assign show_signature = false -%}
          {%- if as.enable_signature and as.signature_image != blank -%}{%- assign show_signature = true -%}{%- endif -%}
          {%- capture qb_author_ink -%}{% if as.enable_custom_style %}{% render 'scheme-color', color: as.author_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
          <div
            class="qb-author"
            data-lt-block="{{ author_block.id }}" data-lt-type="author" data-lt-settings="{{ as | json | escape }}" {{ author_block.shopify_attributes }}
            data-signature-position="{{ as.signature_position | default: 'right' }}"
            style="--qb-author-ink: {{ qb_author_ink | strip }}; --qb-author-size-d: {{ as.author_size }}px; --qb-author-size-m: {{ as.author_size_mobile }}px; --qb-avatar: {{ as.avatar_size }}px; --qb-sig-d: {{ as.signature_size_desktop }}px; --qb-sig-m: {{ as.signature_size_mobile }}px;"
          >
            <span class="qb-avatar"{% if avatar == blank %} hidden{% endif %}>
              {%- if avatar != blank -%}
                <img src="{{ avatar | image_url: width: 200 }}" alt="{{ as.author_name | escape }}" loading="lazy" decoding="async" width="{{ as.avatar_size }}" height="{{ as.avatar_size }}">
              {%- endif -%}
            </span>
            <span class="qb-author-text">
              <span class="qb-author-name">{{ as.author_name | escape }}</span>
              <span class="qb-author-sep" aria-hidden="true"{% if as.author_role == blank %} hidden{% endif %}> · </span>
              <span class="qb-author-role"{% if as.author_role == blank %} hidden{% endif %}>{{ as.author_role | escape }}</span>
            </span>
            <span class="qb-signature qb-signature--inline"{% unless show_signature %} hidden{% endunless %}>
              {%- if show_signature -%}<img src="{{ as.signature_image | image_url: width: 600 }}" alt="{{ 'accessibility.signature' | t }}" loading="lazy" decoding="async" width="{{ as.signature_image.width | default: 300 }}" height="{{ as.signature_image.height | default: 100 }}">{%- endif -%}
            </span>
          </div>
          <div class="qb-signature qb-signature--below"{% unless show_signature %} hidden{% endunless %} data-lt-signature-below style="--qb-sig-d: {{ as.signature_size_desktop }}px; --qb-sig-m: {{ as.signature_size_mobile }}px;">
            {%- if show_signature -%}<img src="{{ as.signature_image | image_url: width: 600 }}" alt="{{ 'accessibility.signature' | t }}" loading="lazy" decoding="async" width="{{ as.signature_image.width | default: 300 }}" height="{{ as.signature_image.height | default: 100 }}">{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
</template>

<schema>
{
  "type": "quotebanner",
  "name": "Quote Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Content alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Card max width",
      "default": "custom",
      "options": [
        {
          "value": "custom",
          "label": "Set width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Custom card max width (px)",
      "min": 600,
      "max": 2000,
      "step": 20,
      "default": 1080
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width (px)",
      "min": 600,
      "max": 1400,
      "step": 10,
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap_top",
      "label": "Gap above author row (px)",
      "min": 8,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Custom styling"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 56,
      "step": 2,
      "default": 28,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Soft shadow",
      "default": true,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Custom fonts"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "label": "Top padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "bottom_padding_desktop",
      "label": "Bottom padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "pad_x_desktop",
      "label": "Horizontal padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "label": "Top padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "label": "Bottom padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "pad_x_mobile",
      "label": "Horizontal padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Content"
        },
        {
          "type": "textarea",
          "id": "quote_text",
          "label": "Quote text",
          "default": "Based on ingredients, NutraCore offers a well-rounded approach to skin health and reducing dryness."
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Typography"
        },
        {
          "type": "color",
          "id": "quote_color",
          "label": "Quote color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "quote_weight",
          "label": "Quote font weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "Light"
            },
