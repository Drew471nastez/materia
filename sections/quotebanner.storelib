<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>

<style>
  /* ── Theme typography (from your Typography Preset) ── */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }

  /* ── Section margin sliders ── */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* ── Section width — CSS-only, no HTML wrapper ── */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}

  /* ── Reset spacing ── */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} {
      margin-bottom: 0 !important;
      margin-top: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->

{% comment %}
  Quote Banner — 1:1 like screenshot
  - Text sits directly on the blue card (no white quote box anywhere)
  - Reset theme defaults on <blockquote> (no bg, no border, no padding)
  - Centered content with max text width for perfect measure
{% endcomment %}
<section id="qb-{{ section.id }}" class="quote-banner color-{{ color_scheme }} gradient {{ section.settings.section_width }}">
  <div class="qb-wrap">
    <div class="qb-card">
      <div class="qb-content">
        {%- assign quote_block = section.blocks | where: 'type', 'quote' | first -%}
        {%- assign author_block = section.blocks | where: 'type', 'author' | first -%}
        {%- if quote_block -%}
          <blockquote class="qb-quote{% if quote_block.settings.use_curly_quotes %} qb-quote--curly{% endif %}">
            {{ quote_block.settings.quote_text }}
          </blockquote>
        {%- endif -%}
        {%- if author_block -%}
          {%- comment -%} No signature picture, no signature: never a demo one from another server. {%- endcomment -%}
          {%- assign show_signature = false -%}
          {%- if author_block.settings.enable_signature and author_block.settings.signature_image != blank -%}
            {%- assign show_signature = true -%}
          {%- endif -%}
          {%- assign signature_src = author_block.settings.signature_image | img_url: 'master' -%}
          {%- assign avatar = author_block.settings.avatar -%}
          {%- assign avatar_fallback = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' -%}
          <div class="qb-author">
            <span class="qb-avatar">
              <img
                src="{{ avatar | img_url: '200x200' | default: avatar_fallback }}"
                alt="{{ author_block.settings.author_name | escape }}"
                loading="lazy"
                width="{{ author_block.settings.avatar_size }}"
                height="{{ author_block.settings.avatar_size }}"
              >
            </span>
            <span class="qb-author-text">
              <span class="qb-author-name">{{ author_block.settings.author_name }}</span>
              {%- if author_block.settings.author_role != blank -%}
                <span class="qb-author-sep"> – </span>
                <span class="qb-author-role">{{ author_block.settings.author_role }}</span>
              {%- endif -%}
              {%- if show_signature and author_block.settings.signature_position == 'right' -%}
                <span class="qb-signature qb-signature--inline">
                  <img
                    src="{{ signature_src }}"
                    alt="{{ 'accessibility.signature' | t }}"
                    loading="lazy"
                    style="max-width: var(--qb-sig-size); height: auto;"
                  >
                </span>
              {%- endif -%}
            </span>
          </div>
          {%- if show_signature -%}
            <div class="qb-signature-block{% if author_block.settings.signature_position == 'below' %} qb-visible-desktop{% endif %}">
              <img
                src="{{ signature_src }}"
                alt="{{ 'accessibility.signature' | t }}"
                loading="lazy"
                style="max-width: var(--qb-sig-size); height: auto;"
              >
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
  <style>
    #qb-{{ section.id }} {
      --qb-bg: {% render 'scheme-color', color: section.settings.bg_color, fallback: 'var(--color-primary)' %};
      --qb-radius: {{ section.settings.radius }}px;
      --qb-pad-top: {{ section.settings.top_padding_desktop }}px;
      --qb-pad-bottom: {{ section.settings.bottom_padding_desktop }}px;
      --qb-pad-x: {{ section.settings.pad_x_desktop }}px;
      --qb-max: {% if section.settings.max_width == 'full' %}100%{% else %}{{ section.settings.custom_max_width }}px{% endif %};
      --qb-shadow: {% if section.settings.enable_shadow %}0 8px 28px rgba(0,0,0,.18){% else %}none{% endif %};
      --qb-align: {{ section.settings.text_align_desktop }};
      --qb-text-max: {{ section.settings.text_max_width }}px;
      --qb-gap-top: {{ section.settings.gap_top }}px;
      --qb-quote-color: {% render 'scheme-color', color: quote_block.settings.quote_color, fallback: 'var(--color-background)' %} !important;
      --qb-quote-size: {{ quote_block.settings.quote_size }}px;
      --qb-quote-size-mobile: {{ quote_block.settings.quote_size_mobile }}px;
      --qb-quote-weight: {{ quote_block.settings.quote_weight }};
      --qb-author-color: {% render 'scheme-color', color: author_block.settings.author_color, fallback: 'var(--color-background)' %} !important;
      --qb-author-size: {{ author_block.settings.author_size }}px;
      --qb-author-size-mobile: {{ author_block.settings.author_size_mobile }}px;
      --qb-avatar: {{ author_block.settings.avatar_size }}px;
      --qb-sig-size: {{ author_block.settings.signature_size_desktop }}px;
      --qb-sig-size-mobile: {{ author_block.settings.signature_size_mobile }}px;
    }
    #qb-{{ section.id }} {
      background-color: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};
    }
    #qb-{{ section.id }} .qb-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 20px;
    }
    #qb-{{ section.id }} .qb-card {
      width: 100%;
      max-width: var(--qb-max);
      background: var(--qb-bg);
      border-radius: var(--qb-radius);
      padding: var(--qb-pad-top) var(--qb-pad-x) var(--qb-pad-bottom);
      box-shadow: var(--qb-shadow);
      text-align: var(--qb-align);
    }
    /* Inner width so the text line-length matches the screenshot */
    #qb-{{ section.id }} .qb-content {
      margin: 0 auto;
      max-width: var(--qb-text-max);
    }
    /* Kill all theme defaults that add white boxes/borders */
    #qb-{{ section.id }} .qb-quote {
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      margin: 0;
      line-height: 1.3;
      font-size: var(--qb-quote-size);
      letter-spacing: 0.2px;
      color: var(--qb-quote-color) !important;
      font-weight: var(--qb-quote-weight);
    }
    #qb-{{ section.id }} .qb-quote--curly:before,
    #qb-{{ section.id }} .qb-quote--curly:after {
      content: "“";
      font-weight: var(--qb-quote-weight);
    }
    #qb-{{ section.id }} .qb-quote--curly:after { content: "”"; }
    #qb-{{ section.id }} .qb-author {
      margin-top: var(--qb-gap-top);
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: var(--qb-author-size);
      font-weight: 600;
      color: var(--qb-author-color);
    }
    #qb-{{ section.id }} .qb-avatar {
      display: inline-flex;
      width: var(--qb-avatar);
      height: var(--qb-avatar);
      border-radius: 9999px;
      overflow: hidden;
      flex: 0 0 auto;
      box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 25%, transparent); /* subtle rim like screenshot */
    }
    #qb-{{ section.id }} .qb-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    #qb-{{ section.id }} .qb-author-name { font-weight: 700; }
    #qb-{{ section.id }} .qb-author-role { opacity: .95; font-weight: 500; }
    #qb-{{ section.id }} .qb-author-sep { opacity: .9; }
    #qb-{{ section.id }} .qb-signature-block {
      display: none;
      margin-top: 12px;
      text-align: var(--qb-align);
    }
    #qb-{{ section.id }} .qb-signature--inline {
      display: none;
      margin-left: 8px;
      vertical-align: middle;
    }
    @media (min-width: 769px) {
      #qb-{{ section.id }} .qb-visible-desktop {
        display: block;
      }
      #qb-{{ section.id }} .qb-signature--inline {
        display: inline-block;
      }
    }
    @media (max-width: 768px) {
      #qb-{{ section.id }} {
        --qb-pad-top: {{ section.settings.top_padding_mobile }}px;
        --qb-pad-bottom: {{ section.settings.bottom_padding_mobile }}px;
        --qb-pad-x: {{ section.settings.pad_x_mobile }}px;
        --qb-align: {{ section.settings.text_align_mobile }};
        --qb-sig-size: var(--qb-sig-size-mobile);
      }
      #qb-{{ section.id }} .qb-card {
        padding: var(--qb-pad-top) var(--qb-pad-x) var(--qb-pad-bottom);
      }
      #qb-{{ section.id }} .qb-content { max-width: 100%; }
      #qb-{{ section.id }} .qb-quote { font-size: var(--qb-quote-size-mobile); }
      #qb-{{ section.id }} .qb-author { font-size: var(--qb-author-size-mobile); }
      #qb-{{ section.id }} .qb-signature-block {
        display: block;
      }
      #qb-{{ section.id }} .qb-signature--inline {
        display: none;
      }
    }
{% comment %}{% endcomment %}  </style>
</section>

</template>

<schema>
{
  "type": "quotebanner",
  "name": "Quote Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Content alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background color"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Soft shadow",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 56,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "label": "Top padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "bottom_padding_desktop",
      "label": "Bottom padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "pad_x_desktop",
      "label": "Horizontal padding (desktop px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 72
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Card max width",
      "default": "custom",
      "options": [
        {
          "value": "custom",
          "label": "Custom (set below)"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_max_width",
      "label": "Custom card max width (px)",
      "min": 600,
      "max": 2000,
      "step": 20,
      "default": 1080
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width (px)",
      "min": 600,
      "max": 1400,
      "step": 10,
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap_top",
      "label": "Gap above author row (px)",
      "min": 8,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Content alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "label": "Top padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "label": "Bottom padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "pad_x_mobile",
      "label": "Horizontal padding (mobile px)",
      "min": 12,
      "max": 120,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "textarea",
          "id": "quote_text",
          "label": "Quote text",
          "default": "Based on ingredients, NutraCore offers a well-rounded approach to skin health and reducing dryness."
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "color",
          "id": "quote_color",
          "label": "Quote color"
        },
        {
          "type": "select",
          "id": "quote_weight",
          "label": "Quote font weight",
          "default": "600",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi Bold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra Bold"
            }
          ]
        },
        {
          "type": "range",
          "id": "quote_size",
          "label": "Quote font size (desktop px)",
          "min": 24,
          "max": 72,
          "step": 1,
          "default": 32
        },
        {
          "type": "header",
          "id": "hdr_7",
          "label": "Mobile"
        },
        {
          "type": "range",
          "id": "quote_size_mobile",
          "label": "Quote font size (mobile px)",
          "min": 16,
          "max": 40,
          "step": 1,
          "default": 20
        },
        {
          "type": "header",
          "id": "hdr_9",
          "label": "Advanced"
        },
        {
          "type": "checkbox",
          "id": "use_curly_quotes",
          "label": "Auto add curly quote marks",
          "default": true
        }
      ],
      "limit": 1
    },
    {
      "type": "author",
      "name": "Author",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "General"
        },
        {
          "type": "checkbox",
          "id": "enable_signature",
          "label": "Enable Signature",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Image / Media"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author avatar (optional)"
        },
        {
          "type": "image_picker",
          "id": "signature_image",
          "label": "Signature image",
          "info": "The signature shows once a picture is set."
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Andrew Schulz"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author role / title",
          "default": "Technologist"
        },
        {
          "type": "header",
          "id": "hdr_9",
          "label": "Typography"
        },
        {
          "type": "color",
          "id": "author_color",
          "label": "Author color"
        },
        {
          "type": "range",
          "id": "author_size",
          "label": "Author font size (desktop px)",
          "min": 12,
