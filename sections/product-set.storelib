<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Products set.

  Outfits built around a product: each slide is the product of the page
  (large) with up to four products that go with it, drawn with the theme's
  own product card (snippets/product-item), so Theme settings > Product
  cards apply. A slide comes from a Set block's products, or, when no Set
  block has products, from the product's custom.product_set metafield.
  The carousel is scroll snap with arrows, pagination, keyboard and swipe,
  per section, run by assets/live-products-d.js (auto-rotate stops off
  screen, in a hidden tab, on hover or focus and under reduced motion).
{%- endcomment -%}
{%- comment -%}pd-gen:settings{%- endcomment -%}{%- capture pd_settings -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | json }},"reset_spacing":{{ section.settings.reset_spacing | json }},"heading":{{ section.settings.heading | json }},"description":{{ section.settings.description | json }},"items_per_row":{{ section.settings.items_per_row | json }},"column_gap":{{ section.settings.column_gap | json }},"header_alignment":{{ section.settings.header_alignment | json }},"header_size":{{ section.settings.header_size | json }},"show_arrow":{{ section.settings.show_arrow | json }},"carousel_pagination":{{ section.settings.carousel_pagination | json }},"pagination_style":{{ section.settings.pagination_style | json }},"pagination_position":{{ section.settings.pagination_position | json }},"infinite":{{ section.settings.infinite | json }},"autoplay":{{ section.settings.autoplay | json }},"autorotate_speed":{{ section.settings.autorotate_speed | json }},"enable_custom_fonts":{{ section.settings.enable_custom_fonts | json }},"heading_font":{"family":{{ section.settings.heading_font.family | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | json }}},"body_font":{"family":{{ section.settings.body_font.family | json }},"fallback_families":{{ section.settings.body_font.fallback_families | json }}},"reveal":{{ section.settings.reveal | json }},"padding_top":{{ section.settings.padding_top | json }},"padding_bottom":{{ section.settings.padding_bottom | json }},"items_per_row_mobile":{{ section.settings.items_per_row_mobile | json }}}{%- endcapture -%}{%- capture pd_defaults -%}{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"heading":"How to wear it?","items_per_row":2,"column_gap":30,"header_alignment":"left","header_size":"medium","show_arrow":false,"carousel_pagination":"disable","pagination_style":"pill","pagination_position":"right","infinite":false,"autoplay":false,"autorotate_speed":5,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":false,"padding_top":0,"padding_bottom":0,"items_per_row_mobile":1.5}{%- endcapture -%}{%- capture pd_block_defaults -%}{"heading":{"text":"How to wear it","enable_custom_style":false,"size_enable":false,"size_desktop":32,"size_mobile":28},"subheading":{"text":"<p>Pieces that go with this one.</p>","enable_custom_style":false,"size_enable":false,"size":18},"set":{}}{%- endcapture -%}{%- comment -%}/pd-gen{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign main = product
  if main.id == blank
    assign main = nil
  endif
  assign main_id = main.id | append: ''
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign set_blocks = section.blocks | where: 'type', 'set'
  assign slides = 0
  for block in set_blocks
    if block.settings.products.size > 0
      assign slides = slides | plus: 1
    endif
  endfor
  assign source = 'blocks'
  if slides == 0
    assign source = 'metafield'
    assign metafield_list = main.metafields.custom.product_set.value
    assign slides = metafield_list.size | default: 0
  endif
  if slides == 0 and request.design_mode
    assign source = 'preview'
    assign slides = set_blocks.size | at_least: 2
  endif
  assign per_d = s.items_per_row | default: 2
  assign per_m = s.items_per_row_mobile | default: 1
  assign gap_m = s.column_gap | at_most: 15
  assign hs = '2rem'
  if s.header_size == 'small'
    assign hs = '1.8rem'
  elsif s.header_size == 'large'
    assign hs = '3rem'
  endif
  assign maxw = 'none'
  if s.section_width == 'container'
    assign maxw = 'calc(var(--page-width, 1300px) + 3rem)'
  elsif s.section_width == 'fluid_container'
    assign maxw = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
  endif
  assign px = '1.5rem'
  if s.section_width == 'full_width'
    assign px = '0px'
  endif
  assign hf = 'var(--heading-font)'
  assign bf = 'var(--body-font)'
  if s.enable_custom_fonts
    if s.heading_font.family != blank
      assign hf = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families
      if s.heading_font.fallback_families == blank
        assign hf = s.heading_font.family | append: ', sans-serif'
      endif
    endif
    if s.body_font.family != blank
      assign bf = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
      if s.body_font.fallback_families == blank
        assign bf = s.body_font.family | append: ', sans-serif'
      endif
    endif
  endif
  assign pager = s.carousel_pagination | default: 'disable'
  assign label_text = s.heading | strip_html
  if heading_blocks.size > 0
    assign label_text = heading_blocks.first.settings.text | strip_html
  endif
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if s.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if s.enable_custom_fonts %}{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}
  #shopify-section-{{ sid }} .pd-set { box-sizing: border-box; padding: var(--pd-pt) 0 var(--pd-pb); background: var(--color-background); color: var(--color-text); font-family: var(--pd-bf); }
  #shopify-section-{{ sid }} .pd-set__inner { box-sizing: border-box; max-width: var(--pd-maxw); margin-inline: auto; padding-inline: var(--pd-px); }
  #shopify-section-{{ sid }} .pd-set__header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-bottom: 20px; }
  #shopify-section-{{ sid }} .pd-set[data-align='right'] .pd-set__header { flex-direction: row-reverse; text-align: right; }
  #shopify-section-{{ sid }} .pd-set__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  #shopify-section-{{ sid }} .pd-set__text:empty { display: none; }
  #shopify-section-{{ sid }} .pd-set__heading { margin: 0; color: var(--pd-c, var(--color-heading)); font-family: var(--pd-hf); font-size: var(--pd-fs-m, var(--pd-hs)); line-height: var(--heading-line-height, 1.2); letter-spacing: var(--heading-letter-spacing, normal); }
  #shopify-section-{{ sid }} .pd-set__sub { margin: 0; color: var(--pd-c, var(--color-text)); font-family: var(--pd-bf); font-size: var(--pd-fs, inherit); }
  #shopify-section-{{ sid }} .pd-set__sub > :first-child { margin-top: 0; } #shopify-section-{{ sid }} .pd-set__sub > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .pd-set__pager { display: inline-flex; align-items: center; justify-content: center; gap: 0; color: var(--color-heading); }
  #shopify-section-{{ sid }} .pd-set[data-pager='disable'] .pd-set__pager { display: none; }
  #shopify-section-{{ sid }} .pd-set__dot { position: relative; width: 28px; height: 44px; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; color: inherit; flex: 0 0 auto; }
  #shopify-section-{{ sid }} .pd-set__dot::after { content: ''; position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; transform: translate(-50%, -50%); border-radius: 50%; background: color-mix(in srgb, currentColor 38%, transparent); transition: width .25s ease, background-color .25s ease, transform .25s ease; }
  #shopify-section-{{ sid }} .pd-set__dot[aria-current='true']::after { background: currentColor; transform: translate(-50%, -50%) scale(1.25); }
  #shopify-section-{{ sid }} .pd-set__dot:focus-visible { outline: 2px solid currentColor; outline-offset: -6px; border-radius: 8px; }
  #shopify-section-{{ sid }} [data-style='pill'] .pd-set__dot::after { width: 10px; height: 10px; border-radius: 999px; }
  #shopify-section-{{ sid }} [data-style='pill'] .pd-set__dot[aria-current='true'] { width: 44px; }
  #shopify-section-{{ sid }} [data-style='pill'] .pd-set__dot[aria-current='true']::after { width: 34px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} [data-style='line'] .pd-set__dot { width: 34px; }
  #shopify-section-{{ sid }} [data-style='line'] .pd-set__dot::after { width: 28px; height: 3px; border-radius: 0; }
  #shopify-section-{{ sid }} [data-style='line'] .pd-set__dot[aria-current='true']::after { height: 4px; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} [data-style='square'] .pd-set__dot::after { width: 10px; height: 10px; border-radius: 2px; }
  #shopify-section-{{ sid }} [data-style='square'] .pd-set__dot[aria-current='true']::after { transform: translate(-50%, -50%) rotate(45deg); }
  #shopify-section-{{ sid }} [data-style='ring'] .pd-set__dot::after { width: 12px; height: 12px; box-sizing: border-box; background: transparent; border: 2px solid color-mix(in srgb, currentColor 45%, transparent); }
  #shopify-section-{{ sid }} [data-style='ring'] .pd-set__dot[aria-current='true']::after { background: currentColor; border-color: currentColor; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .pd-set__count, #shopify-section-{{ sid }} .pd-set__bar { display: none; }
  #shopify-section-{{ sid }} :is([data-style='number'], [data-style='progress']) .pd-set__dots { display: none; }
  #shopify-section-{{ sid }} [data-style='number'] .pd-set__count { display: inline-flex; align-items: center; min-height: 32px; padding: 0 20px; border: 1px solid var(--color-border); border-radius: 999px; font-size: 1.4rem; line-height: 1; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} [data-style='progress'] .pd-set__bar { display: block; position: relative; width: 120px; height: 3px; background: color-mix(in srgb, currentColor 20%, transparent); }
  #shopify-section-{{ sid }} .pd-set__bar > span { position: absolute; inset: 0 auto 0 0; width: var(--pd-progress, 0%); background: currentColor; }
  #shopify-section-{{ sid }} .pd-set__dots { display: inline-flex; }
  #shopify-section-{{ sid }} .pd-set__viewport { position: relative; }
  #shopify-section-{{ sid }} .pd-set__track { display: flex; gap: var(--pd-gap-m); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  #shopify-section-{{ sid }} .pd-set__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .pd-set__track:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  #shopify-section-{{ sid }} .pd-set__slide { flex: 0 0 calc((100% - (var(--pd-n-m) - 1) * var(--pd-gap-m)) / var(--pd-n-m)); min-width: 0; scroll-snap-align: start; }
  #shopify-section-{{ sid }} .pd-set__arrow { position: absolute; top: 50%; z-index: 2; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-top: -22px; padding: 0; border: 1px solid var(--color-border); border-radius: 50%; background: var(--color-background); color: var(--color-heading); cursor: pointer; }
  #shopify-section-{{ sid }} .pd-set__arrow--prev { left: 8px; } #shopify-section-{{ sid }} .pd-set__arrow--next { right: 8px; }
  #shopify-section-{{ sid }} .pd-set__arrow:disabled { opacity: .4; cursor: default; }
  #shopify-section-{{ sid }} .pd-set__arrow:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ sid }} .pd-set[data-arrows='false'] .pd-set__arrow { display: none; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .pd-set[data-fit-m='true'] :is(.pd-set__arrow, .pd-set__pager) { display: none !important; } }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .pd-set[data-fit-d='true'] :is(.pd-set__arrow, .pd-set__pager) { display: none !important; } }
  #shopify-section-{{ sid }} .pd-set__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 5px; aspect-ratio: 2 / 1; }
  #shopify-section-{{ sid }} .pd-set__grid > .product-item { position: relative; min-width: 0; min-height: 0; grid-area: span 1 / span 1; }
  #shopify-section-{{ sid }} .pd-set__grid > .product-item:first-child { grid-area: 1 / 1 / 3 / 3; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-1 { aspect-ratio: 1 / 1; grid-template-columns: 1fr; grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-1 > .product-item:first-child { grid-area: 1 / 1 / 2 / 2; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-2 > .product-item:nth-child(2) { grid-area: 1 / 3 / 3 / 5; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-3 > .product-item:nth-child(2) { grid-area: 1 / 3 / 2 / 5; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-3 > .product-item:nth-child(3) { grid-area: 2 / 3 / 3 / 5; }
  #shopify-section-{{ sid }} .pd-set__grid.grid-4 > .product-item:nth-child(4) { grid-area: 2 / 3 / 3 / 5; }
  #shopify-section-{{ sid }} .pd-set__grid > .product-item:first-child .product-item__action, #shopify-section-{{ sid }} .pd-set__grid .product-item__information, #shopify-section-{{ sid }} .pd-set__grid .loading_image { display: none; }
  #shopify-section-{{ sid }} .pd-set__grid .product-item :is(.product-item__wrapper, .product-item__inner, .product__media, .product-item__media, .product-item__media > a, .product-item__media--ratio) { height: 100%; }
  #shopify-section-{{ sid }} .pd-set__grid .product-item :is(.product__media, .product-item__media--ratio) { position: relative; display: block; overflow: hidden; border-radius: var(--card-radius, 0px); }
  #shopify-section-{{ sid }} .pd-set__grid .product-item :is(.product__media, .product-item__media--ratio) > :is(img, .placeholder-image, svg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .pd-set__grid [style*='--aspect-ratio']::before { padding: 0; content: none; }
  #shopify-section-{{ sid }} .pd-set__grid .label-set { background-color: #666; }
  #shopify-section-{{ sid }} .pd-set__note { margin: 12px 0 0; font-size: 1.3rem; opacity: .75; }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .pd-set[data-pager='show_dots_on_mobile'] .pd-set__pager { display: inline-flex; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pd-set[data-pager='show_dots_on_mobile'] .pd-set__pager { display: none; }
    #shopify-section-{{ sid }} .pd-set__header { margin-bottom: 25px; }
    #shopify-section-{{ sid }} .pd-set[data-pager-pos='left'] .pd-set__header { justify-content: flex-start; }
    #shopify-section-{{ sid }} .pd-set[data-pager-pos='center'] .pd-set__header { justify-content: center; }
    #shopify-section-{{ sid }} .pd-set__heading { font-size: var(--pd-fs-d, var(--pd-hs)); }
    #shopify-section-{{ sid }} .pd-set__track { gap: var(--pd-gap-d); }
    #shopify-section-{{ sid }} .pd-set__slide { flex-basis: calc((100% - (var(--pd-n-d) - 1) * var(--pd-gap-d)) / var(--pd-n-d)); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pd-set__track { scroll-behavior: auto; }
    #shopify-section-{{ sid }} .pd-set__dot::after { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- if slides > 0 -%}
<div class="pd-set sec__products-set color-{{ color_scheme }} gradient" data-pd-root="set" data-pd-section="{{ sid }}" data-pd-settings="{{ pd_settings | escape }}" data-pd-defaults="{{ pd_defaults | escape }}" data-pd-block-defaults="{{ pd_block_defaults | escape }}" data-source="{{ source }}" data-align="{{ s.header_alignment | default: 'left' }}" data-pager="{{ pager }}" data-pager-pos="{{ s.pagination_position | default: 'right' }}" data-arrows="{{ s.show_arrow }}" data-loop="{{ s.infinite }}" data-autoplay="{{ s.autoplay }}" data-speed="{{ s.autorotate_speed | default: 5 }}" data-fit-d="{% if slides <= per_d %}true{% else %}false{% endif %}" data-fit-m="{% if slides <= per_m %}true{% else %}false{% endif %}" style="--pd-pt: {{ s.padding_top | default: 0 }}px; --pd-pb: {{ s.padding_bottom | default: 0 }}px; --pd-n-d: {{ per_d }}; --pd-n-m: {{ per_m }}; --pd-gap-d: {{ s.column_gap | default: 0 }}px; --pd-gap-m: {{ gap_m | default: 0 }}px; --pd-hs: {{ hs }}; --pd-maxw: {{ maxw }}; --pd-px: {{ px }}; --pd-hf: {{ hf }}; --pd-bf: {{ bf }};">
  <div class="pd-set__inner">
    <div class="pd-set__header">
      <div class="pd-set__text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- if block.type == 'heading' or block.type == 'subheading' -%}
            {%- comment -%}pd-gen:block{%- endcomment -%}{%- case block.type -%}{%- when 'heading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size_enable":{{ block.settings.size_enable | json }},"size_desktop":{{ block.settings.size_desktop | json }},"size_mobile":{{ block.settings.size_mobile | json }}}{%- endcapture -%}{%- when 'subheading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size_enable":{{ block.settings.size_enable | json }},"size":{{ block.settings.size | json }}}{%- endcapture -%}{%- when 'set' -%}{%- capture pd_b -%}{}{%- endcapture -%}{%- endcase -%}{%- comment -%}/pd-gen{%- endcomment -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.color, fallback: 'none' %}{%- endcapture -%}
            {%- capture bvars -%}{%- if bs.enable_custom_style and c != 'none' -%}--pd-c: {{ c }};{%- endif -%}{%- if bs.size_enable -%}{%- if block.type == 'heading' -%}--pd-fs-d: {{ bs.size_desktop }}px; --pd-fs-m: {{ bs.size_mobile }}px;{%- else -%}--pd-fs: {{ bs.size }}px;{%- endif -%}{%- endif -%}{%- endcapture -%}
            {%- if block.type == 'heading' -%}
              <h2 class="pd-set__heading" data-pd-block="{{ block.id }}" data-pd-type="heading" data-pd-settings="{{ pd_b | escape }}" style="{{ bvars }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- else -%}
              <div class="pd-set__sub" data-pd-block="{{ block.id }}" data-pd-type="subheading" data-pd-settings="{{ pd_b | escape }}" style="{{ bvars }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if heading_blocks.size == 0 and s.heading != blank -%}<h2 class="pd-set__heading" data-pd-legacy="heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if sub_blocks.size == 0 and s.description != blank -%}<div class="pd-set__sub" data-pd-legacy="description">{{ s.description }}</div>{%- endif -%}
      </div>
      <div class="pd-set__pager" data-style="{{ s.pagination_style | default: 'pill' }}" role="group" aria-label="{{ 'general.pagination.label' | t }}">
        <span class="pd-set__dots">
          {%- for i in (1..slides) -%}<button type="button" class="pd-set__dot" data-index="{{ forloop.index0 }}" aria-label="{{ 'accessibility.go_to_slide' | t }} {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{%- endfor -%}
        </span>
        <span class="pd-set__count" aria-hidden="true"><span data-pd-current>1</span>/{{ slides }}</span>
        <span class="pd-set__bar" aria-hidden="true"><span style="--pd-progress: {{ 100.0 | divided_by: slides | round }}%"></span></span>
      </div>
    </div>
    <div class="pd-set__viewport">
      <button type="button" class="pd-set__arrow pd-set__arrow--prev" data-dir="-1" aria-label="{{ 'accessibility.previous' | t }}"{% unless s.infinite %} disabled{% endunless %}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="pd-set__track" tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ label_text | default: section.settings.heading | escape }}">
        {%- if source == 'blocks' -%}
          {%- assign n = 0 -%}
          {%- for block in set_blocks -%}
            {%- assign list = block.settings.products -%}
            {%- if list.size > 0 -%}
              {%- assign n = n | plus: 1 -%}
              {%- assign first = main | default: list.first -%}
              {%- assign first_id = first.id | append: '' -%}
              {%- assign others = 0 -%}
              {%- for item in list -%}{%- assign iid = item.id | append: '' -%}{%- if iid != first_id and others < 4 -%}{%- assign others = others | plus: 1 -%}{%- endif -%}{%- endfor -%}
              <div class="pd-set__slide" role="group" aria-roledescription="slide" aria-label="{{ n }} / {{ slides }}" data-pd-block="{{ block.id }}" data-pd-type="set" {{ block.shopify_attributes }}>
                <div class="pd-set__grid product_set grid grid-{{ others | plus: 1 }}{% if per_m > 1 %} reset-layout-mobile{% endif %}">
                  {%- render 'product-item', card_product: first, section_id: sid, container: s.section_width, colunm: per_d, colunm_mobile: per_m, padding: s.column_gap, class: 'product-set', template_enable_action: true, template_enable_product_vendor: false, template_enable_rate: false, template_enable_product_short_description: false, template_enable_color_swatches: false, template_enable_price: false, template_enable_add_cart: true, scroll_animation: 'none', indexFor: n, template_enable_product_badges: false, type: 'product-set', product_set_badge: true -%}
                  {%- assign shown = 0 -%}
                  {%- for item in list -%}
                    {%- assign iid = item.id | append: '' -%}
                    {%- if iid != first_id and shown < 4 -%}
                      {%- assign shown = shown | plus: 1 -%}
                      {%- render 'product-item', card_product: item, section_id: sid, container: s.section_width, colunm: per_d, colunm_mobile: per_m, padding: s.column_gap, class: 'product-set', template_enable_action: true, template_enable_product_vendor: false, template_enable_rate: false, template_enable_product_short_description: false, template_enable_color_swatches: false, template_enable_price: false, template_enable_add_cart: true, scroll_animation: 'none', indexFor: shown, template_enable_product_badges: false, type: 'product-set', product_set_badge: false -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif source == 'metafield' -%}
          {%- for item in metafield_list -%}
            {%- assign list = item.product_item.value -%}
            {%- assign others = 0 -%}
            {%- for p in list -%}{%- assign pid = p.id | append: '' -%}{%- if pid != main_id and others < 4 -%}{%- assign others = others | plus: 1 -%}{%- endif -%}{%- endfor -%}
            <div class="pd-set__slide" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides }}">
              <div class="pd-set__grid product_set grid grid-{{ others | plus: 1 }}{% if per_m > 1 %} reset-layout-mobile{% endif %}">
                {%- render 'product-item', card_product: main, section_id: sid, container: s.section_width, colunm: per_d, colunm_mobile: per_m, padding: s.column_gap, class: 'product-set', template_enable_action: true, template_enable_product_vendor: false, template_enable_rate: false, template_enable_product_short_description: false, template_enable_color_swatches: false, template_enable_price: false, template_enable_add_cart: true, scroll_animation: 'none', indexFor: forloop.index, template_enable_product_badges: false, type: 'product-set', product_set_badge: true -%}
                {%- assign shown = 0 -%}
                {%- for p in list -%}
                  {%- assign pid = p.id | append: '' -%}
                  {%- if pid != main_id and shown < 4 -%}
                    {%- assign shown = shown | plus: 1 -%}
                    {%- render 'product-item', card_product: p, section_id: sid, container: s.section_width, colunm: per_d, colunm_mobile: per_m, padding: s.column_gap, class: 'product-set', template_enable_action: true, template_enable_product_vendor: false, template_enable_rate: false, template_enable_product_short_description: false, template_enable_color_swatches: false, template_enable_price: false, template_enable_add_cart: true, scroll_animation: 'none', indexFor: shown, template_enable_product_badges: false, type: 'product-set', product_set_badge: false -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..slides) -%}
            {%- assign b = set_blocks[forloop.index0] -%}
            <div class="pd-set__slide" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides }}"{% if b %} data-pd-block="{{ b.id }}" data-pd-type="set" {{ b.shopify_attributes }}{% endif %}>
              <div class="pd-set__grid product_set grid grid-3{% if per_m > 1 %} reset-layout-mobile{% endif %}">
                {%- for j in (1..3) -%}{%- render 'product-item', card_product: nil, class: ' product-set', type: 'product-set' -%}{%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="pd-set__arrow pd-set__arrow--next" data-dir="1" aria-label="{{ 'accessibility.next' | t }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    {%- if source == 'preview' -%}<p class="pd-set__note">Add products to each Set block, or fill the product's product_set metafield.</p>{%- endif -%}
  </div>
</div>
{%- endif -%}
</template>

