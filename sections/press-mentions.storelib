<template compat="shopify">
<script src="{{ 'live-r7-trust.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes. Press Mentions: where the shop has been written about,
  each mention a link out to the article. One Mention block per article:
  the publication's logo (or its name in letters), the headline or a short
  line from it, the issue or date, and the link. A list with hairlines
  between the rows, or cards; on a phone the cards stack or become a row
  the finger swipes (a native scroller that snaps). Nothing here is filled
  in for the creator: an empty logo shows the theme's logo placeholder in
  the builder. The arrow keys on the swiped row and the live builder edits
  are in shopify/assets/live-r7-trust.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign design = request.design_mode
  assign item_count = 0
  for block in section.blocks
    if block.type == 'mention'
      if design or block.settings.title != blank or block.settings.logo != blank or block.settings.publication != blank
        assign item_count = item_count | plus: 1
      endif
    endif
  endfor
  assign custom = st.enable_custom_style
  assign has_bg = false
  if custom
    capture pm_bg
      render 'scheme-color', color: st.section_bg, fallback: 'none'
    endcapture
    assign pm_bg = pm_bg | strip
    if pm_bg != 'none'
      assign has_bg = true
    endif
  endif
  assign own_fonts = false
  if st.enable_custom_fonts
    if st.heading_font.family != blank or st.body_font.family != blank
      assign own_fonts = true
    endif
  endif
-%}
{%- if design or item_count > 0 -%}
<style data-r7g-space>#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}@media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}{% if st.reset_spacing %}#shopify-section-{{ sid }}{margin-top:0!important;margin-bottom:0!important}#shopify-section-{{ sid }} + .shopify-section{margin-top:0!important}{% endif %}{% comment %}{% endcomment %}</style>
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if st.enable_custom_fonts -%}
    {{ st.heading_font | font_face: font_display: 'swap' }}
    {{ st.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .pm {
    --pm-edge: 20px;
    font-family: var(--body-font, inherit); color: var(--color-text);
    padding-top: var(--pm-pt-m, 48px); padding-bottom: var(--pm-pb-m, 48px);
  }
  #shopify-section-{{ sid }} .pm[data-bg] { background: var(--pm-bg); }
  #shopify-section-{{ sid }} .pm, #shopify-section-{{ sid }} .pm *, #shopify-section-{{ sid }} .pm *::before, #shopify-section-{{ sid }} .pm *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .pm [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .pm__inner { width: 100%; margin-inline: auto; padding-inline: var(--pm-edge); }

  /* Heading and line */
  #shopify-section-{{ sid }} .pm__head { display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 720px; margin: 0 auto 28px; text-align: center; }
  #shopify-section-{{ sid }} .pm[data-align='left'] .pm__head { align-items: flex-start; margin-inline: 0; text-align: start; }
  #shopify-section-{{ sid }} .pm__head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .pm__heading { margin: 0; max-width: 100%; font-size: var(--b-fs-m, 26px); color: var(--b-c, var(--color-heading)); text-wrap: balance; overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .pm__sub { max-width: 100%; font-size: var(--b-fs-m, 15px); line-height: var(--body-line-height, 1.6); color: var(--b-c, var(--color-text)); }
  #shopify-section-{{ sid }} .pm__sub p { margin: 0 0 .5em; color: inherit; }
  #shopify-section-{{ sid }} .pm__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .pm__sub a { color: inherit; }

  /* A mention */
  #shopify-section-{{ sid }} .pm__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--pm-line, var(--color-border)); }
  #shopify-section-{{ sid }} .pm__item { display: flex; min-width: 0; margin: 0; border-bottom: 1px solid var(--pm-line, var(--color-border)); }
  #shopify-section-{{ sid }} .pm__link {
    flex: 1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-content: start;
    padding: 22px 0; color: inherit; text-decoration: none; outline: none; -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .pm__logo { display: flex; align-items: center; min-height: var(--pm-h-m, 24px); min-width: 0; }
  #shopify-section-{{ sid }} .pm__img { display: block; width: auto; max-width: min(100%, 180px); height: var(--pm-h-m, 24px); object-fit: contain; object-position: left center; transition: filter .25s ease, opacity .25s ease; }
  #shopify-section-{{ sid }} .pm__logo .lg__ph { display: block; width: auto; height: calc(var(--pm-h-m, 24px) + 12px); aspect-ratio: 160 / 64; color: var(--color-text); }
  #shopify-section-{{ sid }} .pm__name { font-family: var(--heading-font, inherit); font-size: 13px; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--pm-title, var(--color-heading)); overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .pm[data-style='mono'] .pm__img { filter: grayscale(1); opacity: .62; }
  #shopify-section-{{ sid }} .pm__body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  #shopify-section-{{ sid }} .pm__title { margin: 0; font-size: var(--pm-ts-m, 17px); line-height: 1.35; color: var(--pm-title, var(--color-heading)); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .pm__date { font-size: 13px; color: var(--color-text); }
  #shopify-section-{{ sid }} .pm__more { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; font-size: 14px; color: var(--pm-title, var(--color-heading)); white-space: nowrap; }
  #shopify-section-{{ sid }} .pm__more svg { width: 16px; height: 16px; flex: none; transition: transform .2s ease; }
  #shopify-section-{{ sid }} .pm__more svg:dir(rtl) { transform: scaleX(-1); }
  #shopify-section-{{ sid }} .pm__link:not([href]) .pm__more { display: none; }
  #shopify-section-{{ sid }} a.pm__link[href]:focus-visible { box-shadow: 0 0 0 2px var(--color-heading); border-radius: 2px; }
  #shopify-section-{{ sid }} a.pm__link[href]:active .pm__title { opacity: .7; }
  #shopify-section-{{ sid }} .pm[data-style='mono'] a.pm__link:focus-visible .pm__img { filter: none; opacity: 1; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} a.pm__link[href]:hover .pm__title { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
    #shopify-section-{{ sid }} a.pm__link[href]:hover .pm__more svg { transform: translateX(4px); }
    #shopify-section-{{ sid }} .pm[data-style='mono'] .pm__link:hover .pm__img { filter: none; opacity: 1; }
  }
  @media (hover: none) {
    #shopify-section-{{ sid }} .pm[data-style='mono'] .pm__img { filter: none; opacity: 1; }
  }

  /* Cards */
  #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; border: 0; }
  #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__item { border: 1px solid var(--pm-line, var(--color-border)); border-radius: var(--rounded-radius, 8px); background: var(--pm-card, transparent); }
  #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__link { display: flex; flex-direction: column; gap: 16px; padding: 20px; border-radius: inherit; }
  #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__more { margin-top: auto; }
  #shopify-section-{{ sid }} .pm[data-layout='cards'] a.pm__link[href]:focus-visible { box-shadow: inset 0 0 0 2px var(--color-heading); }

  /* Phones: cards in a row the finger swipes */
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .pm[data-layout='cards'][data-mobile='swipe'] .pm__list {
      display: flex; gap: 12px; margin-inline: calc(-1 * var(--pm-edge)); padding: 2px var(--pm-edge);
      overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pm-edge);
      -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scrollbar-width: none; touch-action: pan-x pan-y;
    }
    #shopify-section-{{ sid }} .pm[data-layout='cards'][data-mobile='swipe'] .pm__list::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .pm[data-layout='cards'][data-mobile='swipe'] .pm__item { flex: 0 0 82%; scroll-snap-align: start; }
    #shopify-section-{{ sid }} .pm[data-layout='cards'][data-mobile='swipe'] .pm__item:only-child { flex-basis: 100%; }
    #shopify-section-{{ sid }} .pm__list:focus-visible { outline: 2px solid var(--color-heading); outline-offset: -2px; }
  }
  #shopify-section-{{ sid }} .pm__empty { margin: 0; padding: 24px 0; text-align: center; font-size: 14px; color: var(--color-text); }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pm { --pm-edge: 24px; padding-top: var(--pm-pt, 56px); padding-bottom: var(--pm-pb, 56px); }
    #shopify-section-{{ sid }} .pm__head { margin-bottom: 36px; }
    #shopify-section-{{ sid }} .pm__heading, #shopify-section-{{ sid }} .pm__sub { font-size: var(--b-fs-d, 32px); }
    #shopify-section-{{ sid }} .pm__logo { min-height: var(--pm-h, 28px); }
    #shopify-section-{{ sid }} .pm__img { height: var(--pm-h, 28px); }
    #shopify-section-{{ sid }} .pm__logo .lg__ph { height: calc(var(--pm-h, 28px) + 12px); }
    #shopify-section-{{ sid }} .pm__title { font-size: var(--pm-ts, 20px); }
    #shopify-section-{{ sid }} .pm[data-layout='list'] .pm__link { grid-template-columns: 200px minmax(0, 1fr) auto; align-items: center; gap: 40px; padding: 28px 0; }
    #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__list { grid-template-columns: repeat(var(--pm-cols, 3), minmax(0, 1fr)); gap: 20px; }
    #shopify-section-{{ sid }} .pm[data-layout='cards'] .pm__link { padding: 28px; gap: 20px; }
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ sid }} .pm[data-width='container'] .pm__inner { width: 90%; }
    #shopify-section-{{ sid }} .pm[data-width='fluid_container'] .pm__inner { width: 95%; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .pm[data-width='container'] .pm__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    #shopify-section-{{ sid }} .pm[data-width='fluid_container'] .pm__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    #shopify-section-{{ sid }} .pm[data-width='stretch_width'] { --pm-edge: 3rem; }
    #shopify-section-{{ sid }} .pm[data-width='full_width'] { --pm-edge: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.pm__img, .pm__more svg) { transition: none; }
    #shopify-section-{{ sid }} a.pm__link[href]:hover .pm__more svg { transform: none; }
    #shopify-section-{{ sid }} .pm__list { scroll-behavior: auto; }
  }
{% comment %}{% endcomment %}</style>
{%- capture pm_vars -%}
--pm-cols: {{ st.columns | default: 3 }};--pm-h: {{ st.logo_height | default: 0 }}px;--pm-h-m: {{ st.logo_height_mobile | default: 0 }}px;--pm-ts: {{ st.title_size | default: 0 }}px;--pm-ts-m: {{ st.title_size_mobile | default: 0 }}px;--pm-pt: {{ st.padding_top | default: 0 }}px;--pm-pb: {{ st.padding_bottom | default: 0 }}px;--pm-pt-m: {{ st.padding_top_mobile | default: 0 }}px;--pm-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
{%- if has_bg -%}--pm-bg: {{ pm_bg }};{%- endif -%}
{%- if custom -%}--pm-title: {% render 'scheme-color', color: st.title_color, fallback: 'var(--color-heading)' %};--pm-line: {% render 'scheme-color', color: st.line_color, fallback: 'var(--color-border)' %};--pm-card: {% render 'scheme-color', color: st.card_bg, fallback: 'transparent' %};{%- endif -%}
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--heading-font: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--body-font: {{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
{%- if design -%}
{%- capture pm_json -%}{"color_scheme":{{ color_scheme | json }},"section_width":{{ st.section_width | append: '' | json }},"reset_spacing":{% if st.reset_spacing %}true{% else %}false{% endif %},"link_label":{{ st.link_label | append: '' | json }},"alignment":{{ st.alignment | append: '' | json }},"layout":{{ st.layout | append: '' | json }},"columns":{{ st.columns | default: 0 | json }},"logo_height":{{ st.logo_height | default: 0 | json }},"logo_style":{{ st.logo_style | append: '' | json }},"enable_custom_style":{% if st.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ st.section_bg | append: '' | json }},"title_color":{{ st.title_color | append: '' | json }},"line_color":{{ st.line_color | append: '' | json }},"card_bg":{{ st.card_bg | append: '' | json }},"title_size":{{ st.title_size | default: 0 | json }},"enable_custom_fonts":{% if st.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ st.heading_font.family | append: '' | json }},"fallback_families":{{ st.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ st.body_font.family | append: '' | json }},"fallback_families":{{ st.body_font.fallback_families | append: '' | json }}},"padding_top":{{ st.padding_top | default: 0 | json }},"padding_bottom":{{ st.padding_bottom | default: 0 | json }},"section_margin_top_desktop":{{ st.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ st.section_margin_bottom_desktop | default: 0 | json }},"mobile_layout":{{ st.mobile_layout | append: '' | json }},"logo_height_mobile":{{ st.logo_height_mobile | default: 0 | json }},"title_size_mobile":{{ st.title_size_mobile | default: 0 | json }},"padding_top_mobile":{{ st.padding_top_mobile | default: 0 | json }},"padding_bottom_mobile":{{ st.padding_bottom_mobile | default: 0 | json }},"section_margin_top_mobile":{{ st.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ st.section_margin_bottom_mobile | default: 0 | json }}}{%- endcapture -%}
{%- endif -%}
<div class="pm color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}" data-r7g="press-mentions" data-r7g-section="{{ sid }}"{% if design %} data-r7g-settings="{{ pm_json | escape }}"{% endif %} data-width="{{ st.section_width | default: 'fluid_container' }}" data-align="{{ st.alignment | default: 'center' }}" data-layout="{{ st.layout | default: 'list' }}" data-mobile="{{ st.mobile_layout | default: 'swipe' }}" data-style="{{ st.logo_style | default: 'original' }}"{% if has_bg %} data-bg{% endif %}{% if own_fonts %} data-own-font{% endif %} style="{{ pm_vars | strip }}">
  {%- if design -%}<template data-r7g-ph>{%- render 'logos-ph' -%}</template>{%- endif -%}
  <div class="pm__inner">
    <div class="pm__head">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' or block.type == 'subheading' -%}{%- render 'r7-trust-text', block: block, p: 'pm', design: design -%}{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if item_count > 0 -%}
    <ul class="pm__list" role="list" data-r7g-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'mention' -%}
        {%- assign bs = block.settings -%}
        {%- if design or bs.title != blank or bs.logo != blank or bs.publication != blank -%}
        <li class="pm__item" data-r7g-block="{{ block.id }}" data-r7g-type="mention"{% if design %} data-r7g-settings="{% capture pmb_json %}{"logo":{% if bs.logo != blank %}{{ bs.logo | image_url: width: 480 | json }}{% else %}""{% endif %},"publication":{{ bs.publication | append: '' | json }},"title":{{ bs.title | append: '' | json }},"date":{{ bs.date | append: '' | json }},"url":{{ bs.url | append: '' | json }}}{% endcapture %}{{ pmb_json | escape }}"{% endif %} {{ block.shopify_attributes }}>
          <a class="pm__link"{% if bs.url != blank %} href="{{ bs.url | url }}"{% endif %}>
            <div class="pm__logo"{% if design == false and bs.logo == blank and bs.publication == blank %} hidden{% endif %}>
              {%- if bs.logo != blank -%}
                <img class="pm__img" src="{{ bs.logo | image_url: width: 480 }}" srcset="{{ bs.logo | image_url: width: 240 }} 240w, {{ bs.logo | image_url: width: 480 }} 480w" sizes="180px" width="{{ bs.logo.width | default: 240 }}" height="{{ bs.logo.height | default: 80 }}" alt="{{ bs.publication | default: bs.logo.alt | escape }}" loading="lazy" decoding="async">
              {%- elsif bs.publication != blank -%}
                <span class="pm__name">{{ bs.publication | escape }}</span>
              {%- elsif design -%}
                {%- render 'logos-ph' -%}
              {%- endif -%}
            </div>
            <div class="pm__body">
              <h3 class="pm__title"{% if bs.title == blank %} hidden{% endif %}>{{ bs.title }}</h3>
              <span class="pm__date"{% if bs.date == blank %} hidden{% endif %}>{{ bs.date | escape }}</span>
            </div>
            <span class="pm__more"{% if st.link_label == blank %} hidden{% endif %}><span class="pm__more-label">{{ st.link_label | escape }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        </li>
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- elsif design -%}
      <p class="pm__empty">Add a Mention block for each article about your shop.</p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
</template>

<schema>
{
  "type": "press-mentions",
  "name": "Press Mentions",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Read the article",
      "info": "Shown on each mention that has a link."
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout == 'cards' }}"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Images"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo colour",
      "default": "original",
      "info": "Touch screens always show the colours.",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "mono",
          "label": "Grey until hover"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Headline colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card colour",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.layout == 'cards' }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
