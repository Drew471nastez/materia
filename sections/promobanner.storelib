  "shopify": {
    "name": "Promotion Popup Discount",
    "tag": "section",
    "class": "promo-banner-pro-wrapper",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Trigger"
      },
      {
        "type": "checkbox",
        "id": "show_as_popup",
        "label": "Show as a popup",
        "default": true
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "Opens",
        "default": "exit",
        "options": [
          {
            "value": "immediate",
            "label": "On page load"
          },
          {
            "value": "delay",
            "label": "After a delay"
          },
          {
            "value": "scroll",
            "label": "On scroll"
          },
          {
            "value": "exit",
            "label": "On exit intent"
          },
          {
            "value": "inactivity",
            "label": "When idle"
          },
          {
            "value": "pageviews",
            "label": "After page views"
          },
          {
            "value": "manual",
            "label": "From a link"
          }
        ]
      },
      {
        "type": "range",
        "id": "delay_s",
        "label": "Delay",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "s",
        "default": 20
      },
      {
        "type": "range",
        "id": "inactivity_s",
        "label": "Idle for",
        "min": 0,
        "max": 120,
        "step": 5,
        "unit": "s",
        "default": 10,
        "visible_if": "{{ section.settings.open_mode == 'inactivity' }}"
      },
      {
        "type": "range",
        "id": "scroll_pct",
        "label": "Scrolled",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 50,
        "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
      },
      {
        "type": "range",
        "id": "page_views",
        "label": "Page views",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 2,
        "visible_if": "{{ section.settings.open_mode == 'pageviews' }}"
      },
      {
        "type": "checkbox",
        "id": "exit_intent",
        "label": "Also open on exit intent",
        "default": true
      },
      {
        "type": "header",
        "content": "Behaviour"
      },
      {
        "type": "range",
        "id": "hide_days",
        "label": "Hide after closing for",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "once_per_session",
        "label": "Once per session",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_edit_mode",
        "label": "Show in the builder",
        "default": false
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "align_desktop",
        "label": "Text",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "select",
        "id": "align_mobile",
        "label": "Text on phones",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "range",
        "id": "popup_width",
        "label": "Width",
        "min": 400,
        "max": 1200,
        "step": 10,
        "unit": "px",
        "default": 750
      },
      {
        "type": "range",
        "id": "popup_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "card_padding",
        "label": "Side padding",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "top_padding",
        "label": "Top padding",
        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
