<template compat="shopify">
<script src="{{ 'live-page-popups.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Promotion Popup Discount: an eyebrow, a headline, a line
  of text, the creator's code to copy, a button, an optional signup form
  (Storelib Subscribers) and a picture, as a popup in a native <dialog>
  (snippets/page-popup-dialog) or drawn in the page ("Show as a popup"
  off). Every setting reaches the page as a CSS variable, an attribute, a
  class or a text on its element, so shopify/assets/live-page-popups.js
  applies a builder edit in place, the same as this Liquid draws it. Each
  block is always drawn (hidden while empty) so it can be filled in live.
  Every rule is scoped to this section, so two of them never share a look.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign fb_accessibility_code_emailed_success = 'accessibility.code_emailed_success' | t
  assign fb_accessibility_get_my_code = 'accessibility.get_my_code' | t
  assign fb_accessibility_enter_your_email = 'accessibility.enter_your_email' | t
  assign fb_accessibility_close = 'accessibility.close' | t
  assign is_popup = true
  if st.show_as_popup == false
    assign is_popup = false
  endif
  assign block_eyebrow = section.blocks | where: 'type', 'eyebrow' | first
  assign block_headline = section.blocks | where: 'type', 'headline' | first
  assign block_body = section.blocks | where: 'type', 'body' | first
  assign block_coupon = section.blocks | where: 'type', 'coupon' | first
  assign block_button = section.blocks | where: 'type', 'button' | first
  assign block_newsletter = section.blocks | where: 'type', 'newsletter' | first
  assign block_image = section.blocks | where: 'type', 'image' | first
  assign pbp_custom = false
  if st.enable_custom_style == true
    assign pbp_custom = true
  endif
  assign eb = block_eyebrow.settings
  assign hb = block_headline.settings
  assign bb = block_body.settings
  assign cb = block_coupon.settings
  assign btb = block_button.settings
  assign ib = block_image.settings
  assign coupon_code = cb.code
  assign image_side = ib.side | default: 'image-right'
  assign mobile_image_position = ib.mobile_position | default: 'above'
-%}
{%- comment -%} The theme's scroll reveal, only when the banner is drawn in the page. {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and st.reveal != false and is_popup == false -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style>
  /* No stacking context here: the popup is fixed over the page. */
  #shopify-section-{{ sid }} {
    position: relative !important;
    font-weight: var(--body-weight, inherit);
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    box-sizing: border-box !important;
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Remove section spacing */
  #shopify-section-{{ sid }}:has(> [data-pbp-reset]) { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }}:has(> [data-pbp-reset]) + .shopify-section,
  .shopify-section + #shopify-section-{{ sid }}:has(> [data-pbp-reset]) { margin-top: 0 !important; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) { font-family: inherit; }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-weight: var(--heading-weight, inherit); font-family: var(--heading-font, inherit); }
  /* Section width (drawn in the page) */
  #shopify-section-{{ sid }} .promo-banner-pro.container { max-width: calc(var(--page-width, 1300px) + 3rem) !important; margin-inline: auto !important; box-sizing: border-box !important; }
  #shopify-section-{{ sid }} .promo-banner-pro.fluid_container { max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important; margin-inline: auto !important; box-sizing: border-box !important; }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .promo-banner-pro.stretch_width { padding-inline: 3rem; }
  }
{% comment %}{% endcomment %}</style>
{%- capture pbp_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ st.enable_edit_mode | json }},
   "trigger": {"mode": {{ st.open_mode | default: 'exit' | json }}, "delay": {{ st.delay_s | default: 0 | json }}, "idle": {{ st.inactivity_s | default: 10 | json }}, "scroll": {{ st.scroll_pct | default: 50 | json }}, "views": {{ st.page_views | default: 2 | json }}, "exit": {{ st.exit_intent | json }} },
   "frequency": {"mode": {% if st.hide_days > 0 %}"after_days"{% elsif st.once_per_session %}"session"{% else %}"always"{% endif %}, "days": {{ st.hide_days | default: 0 | json }}, "session": {{ st.once_per_session | json }} }}
{%- endcapture -%}
{%- liquid
  assign c_eb = ''
  if eb.enable_custom_style == true
    assign c_eb = eb.color
  endif
  assign c_hb = ''
  if hb.enable_custom_style == true
    assign c_hb = hb.color
  endif
  assign c_bb = ''
  if bb.enable_custom_style == true
    assign c_bb = bb.color
  endif
  assign cc = false
  if cb.enable_custom_style == true
    assign cc = true
  endif
-%}
{%- capture pbp_vars -%}
--pbp-overlay-opacity: {{ st.overlay_opacity | default: 0 | times: 0.01 }}; --pbp-radius: {{ st.radius | default: 0 }}px; --pbp-popup-radius: {{ st.popup_radius | default: 0 }}px; --pbp-popup-w: {{ st.popup_width | default: 750 }}px; --pbp-pad: {{ st.card_padding | default: 0 }}px; --pbp-top-pad: {{ st.top_padding | default: 0 }}px; --pbp-bottom-pad: {{ st.bottom_padding | default: 0 }}px; --pbp-mtop-pad: {{ st.mobile_top_padding | default: 0 }}px; --pbp-mbottom-pad: {{ st.mobile_bottom_padding | default: 0 }}px; --pbp-mh-pad: {{ st.mobile_h_padding | default: 0 }}px; --pbp-gutter: {{ st.mobile_side_gutter | default: 32 }}px; --pbp-gap: {{ st.col_gap | default: 0 }}px; --pbp-text-l-pad: {{ st.text_left_pad_desktop | default: 0 }}px; --pbp-text-r-pad: {{ st.text_right_pad_desktop | default: 0 }}px; --pbp-text-l-pad-m: {{ st.text_left_pad_mobile | default: 0 }}px; --pbp-text-r-pad-m: {{ st.text_right_pad_mobile | default: 0 }}px;
 --pbp-bg: {% if pbp_custom %}{% render 'scheme-color', color: st.card_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --pbp-text: {% if pbp_custom %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}; --pbp-overlay: {% if pbp_custom %}{% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %}{% else %}#000000{% endif %}; --pbp-close-color: {% if pbp_custom %}{% render 'scheme-color', color: st.close_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
 --pbp-eyebrow-ls: {{ eb.letter_spacing | default: 0 }}em; --pbp-eyebrow-size: {{ eb.size_desktop | default: 12 }}px; --pbp-eyebrow-size-m: {{ eb.size_mobile | default: 14 }}px; --pbp-eyebrow-color: {% render 'scheme-color', color: c_eb, fallback: 'inherit' %};
 --pbp-headline-size: {{ hb.size_desktop | default: 56 }}px; --pbp-headline-size-m: {{ hb.size_mobile | default: 40 }}px; --pbp-headline-w: {{ hb.weight | default: 700 }}; --pbp-headline-color: {% render 'scheme-color', color: c_hb, fallback: 'var(--color-heading)' %};
 --pbp-body-size: {{ bb.size_desktop | default: 16 }}px; --pbp-body-size-m: {{ bb.size_mobile | default: 16 }}px; --pbp-body-color: {% render 'scheme-color', color: c_bb, fallback: 'inherit' %};
 --pbp-code-size: {{ cb.code_size | default: 18 }}px;
 --pbp-code-bg: {% if cc %}{% render 'scheme-color', color: cb.code_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --pbp-code-bg-copied: {% if cc %}{% render 'scheme-color', color: cb.code_bg_copied, fallback: 'color-mix(in srgb, var(--color-heading) 6%, var(--color-background))' %}{% else %}color-mix(in srgb, var(--color-heading) 6%, var(--color-background)){% endif %}; --pbp-code-border: {% if cc %}{% render 'scheme-color', color: cb.code_border, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}; --pbp-code-border-copied: {% if cc %}{% render 'scheme-color', color: cb.code_border_copied, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pbp-code-color: {% if cc %}{% render 'scheme-color', color: cb.code_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pbp-code-color-copied: {% if cc %}{% render 'scheme-color', color: cb.code_color_copied, fallback: 'var(--color-primary)' %}{% else %}var(--color-primary){% endif %};
 --pbp-copy-bg: {% if cc %}{% render 'scheme-color', color: cb.copy_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --pbp-copy-bg-copied: {% if cc %}{% render 'scheme-color', color: cb.copy_bg_copied, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pbp-copy-border: {% if cc %}{% render 'scheme-color', color: cb.copy_border, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}; --pbp-copy-border-copied: {% if cc %}{% render 'scheme-color', color: cb.copy_border_copied, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pbp-copy-color: {% if cc %}{% render 'scheme-color', color: cb.copy_color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}{% else %}color-mix(in srgb, var(--color-text) 70%, transparent){% endif %}; --pbp-copy-color-copied: {% if cc %}{% render 'scheme-color', color: cb.copy_color_copied, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
 --pbp-btn-w: {% if btb.width > 0 %}{{ btb.width }}px{% else %}auto{% endif %};
 --pbp-img-radius: {{ ib.radius | default: 0 }}px; --pbp-img-w: {% if ib.enable_custom_desktop %}{{ ib.desktop_w }}px{% else %}100%{% endif %}; --pbp-img-h: {% if ib.enable_custom_desktop %}{{ ib.desktop_h }}px{% else %}100%{% endif %}; --pbp-img-w-m: {% if ib.enable_custom_mobile %}{{ ib.mobile_w }}px{% else %}100%{% endif %}; --pbp-img-h-m: {% if ib.enable_custom_mobile %}{{ ib.mobile_h }}px{% else %}100%{% endif %};
{%- render 'page-popup-fonts', st: st -%}
{%- endcapture -%}
{% render 'page-popup-dialog', sid: sid, st: st %}
<section
  data-pg-root="promobanner" data-pg-section="{{ sid }}"{% if request.design_mode %} data-pg-settings="{{ st | json | escape }}"{% endif %}{% if st.enable_custom_fonts %} data-pg-fonts data-own-font{% endif %}{% unless is_popup %} data-pg-inline{% endunless %}{% if st.reset_spacing %} data-pbp-reset{% endif %}
  data-pbp-mobile-image="{{ mobile_image_position }}"{% if ib.enable_custom_desktop %} data-pbp-cimg-d{% endif %}{% if ib.enable_custom_mobile %} data-pbp-cimg-m{% endif %}
  class="promo-banner-pro color-{{ color_scheme }}{% if is_popup %} promo-banner-pro--as-popup{% else %} {{ st.section_width }}{% endif %}"
  data-section-id="{{ sid }}"
  data-hide-days="{{ st.hide_days }}"
  data-open-mode="{{ st.open_mode }}"
  data-delay="{{ st.delay_s }}"
  data-inactivity="{{ st.inactivity_s }}"
  data-exit-intent="{% if st.exit_intent %}true{% else %}false{% endif %}"
  data-append-discount="{% if btb.append_discount %}true{% else %}false{% endif %}"
  data-discount-code="{{ coupon_code | escape }}"
  data-show-once-per-session="{% if st.once_per_session %}true{% else %}false{% endif %}"
  data-edit-mode="{% if st.enable_edit_mode %}true{% else %}false{% endif %}"
  data-popup-root="{{ sid }}" data-popup-config="{{ pbp_config | strip_newlines | escape }}"{% if is_popup %} aria-hidden="true"{% endif %}
  style="{{ pbp_vars | strip_newlines | strip }}"
>
  <dialog class="pg-dialog" data-pg-dialog aria-labelledby="pbp-title-{{ sid }}" aria-describedby="pbp-desc-{{ sid }}">
  <div class="pbp-overlay" data-pg-backdrop aria-hidden="true"></div>

  <div class="pbp-card{% unless is_popup %} pbp-card--inline{% endunless %}" data-pg-card tabindex="-1">
    <button type="button" class="pbp-close" data-popup-close aria-label="{{ 'general.close' | t | default: fb_accessibility_close }}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="pbp-grid {{ image_side }}">
      <div class="pbp-text pbp-align-desktop-{{ st.align_desktop }} pbp-align-mobile-{{ st.align_mobile }}">
        {%- if block_eyebrow != blank %}
          <div class="pbp-eyebrow" data-pg-block="{{ block_eyebrow.id }}" data-pg-type="eyebrow"{% if request.design_mode %} data-pg-settings="{{ eb | json | escape }}"{% endif %}{% if eb.text == blank %} hidden{% endif %} {{ block_eyebrow.shopify_attributes }}>{{ eb.text }}</div>
        {%- endif %}
        {%- if block_headline != blank %}
          <h2 class="pbp-headline" id="pbp-title-{{ sid }}"{% unless hb.weight == 'inherit' %} data-own-weight{% endunless %} data-pg-block="{{ block_headline.id }}" data-pg-type="headline"{% if request.design_mode %} data-pg-settings="{{ hb | json | escape }}"{% endif %}{% if hb.text == blank %} hidden{% endif %} {{ block_headline.shopify_attributes }}>{{ hb.text }}</h2>
        {%- endif %}
        {%- if block_body != blank %}
          <p class="pbp-body" id="pbp-desc-{{ sid }}" data-pg-block="{{ block_body.id }}" data-pg-type="body"{% if request.design_mode %} data-pg-settings="{{ bb | json | escape }}"{% endif %}{% if bb.text == blank %} hidden{% endif %} {{ block_body.shopify_attributes }}>{{ bb.text }}</p>
        {%- endif %}

        {%- if block_coupon != blank %}
          <div class="pbp-code-row" data-pg-block="{{ block_coupon.id }}" data-pg-type="coupon"{% if request.design_mode %} data-pg-settings="{{ cb | json | escape }}"{% endif %}{% if cb.code == blank and cb.label == blank %} hidden{% endif %} {{ block_coupon.shopify_attributes }}>
            <span class="pbp-code-label"{% if cb.label == blank %} hidden{% endif %}>{{ cb.label }}</span>
            <button class="pbp-code" data-code="{{ cb.code | escape }}" type="button" aria-label="{{ 'accessibility.copy_coupon_code' | t }}"{% if cb.code == blank %} hidden{% endif %}>{{ cb.code | escape }}</button>
            <button class="pbp-copy" type="button" aria-label="{{ 'accessibility.copy_coupon' | t }}"{% if cb.code == blank %} hidden{% endif %}>
              <svg width="20" height="20" viewBox="0 -0.5 25 25" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M17.676 14.248C17.676 15.8651 16.3651 17.176 14.748 17.176H7.428C5.81091 17.176 4.5 15.8651 4.5 14.248V6.928C4.5 5.31091 5.81091 4 7.428 4H14.748C16.3651 4 17.676 5.31091 17.676 6.928V14.248Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M10.252 20H17.572C19.1891 20 20.5 18.689 20.5 17.072V9.75195" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        {%- endif %}

        {%- if block_button != blank %}
          {%- liquid
            assign href = btb.link
            if btb.append_discount and coupon_code != blank and href != blank
              assign href = '/discount/' | append: coupon_code | append: '?redirect=' | append: btb.link
            endif
            if href == blank
              assign href = routes.all_products_collection_url
            endif
            assign btn_custom = false
            assign btn_transform = blank
            if btb.use_theme_button == false
              assign btn_custom = true
              assign btn_transform = 'uppercase'
            endif
            assign b_bg = ''
            assign b_tx = ''
            assign b_bgh = ''
            assign b_txh = ''
            if btb.enable_custom_style == true
              assign b_bg = btb.bg
              assign b_tx = btb.text_color
              assign b_bgh = btb.bg_hover
              assign b_txh = btb.text_hover
            endif
          -%}
          <a class="pbp-btn btn-primary" data-theme-button="primary" data-sl-button{% if btn_custom %} data-own-shape{% endif %} data-pg-block="{{ block_button.id }}" data-pg-type="button"{% if request.design_mode %} data-pg-settings="{{ btb | json | escape }}"{% endif %} data-pg-default-href="{{ routes.all_products_collection_url }}"{% if btb.label == blank %} hidden{% endif %} style="{%- render 'button-overrides', bg: b_bg, text: b_tx, hover_bg: b_bgh, hover_text: b_txh, custom: btn_custom, radius: btb.radius, font_size: btb.size, weight: 800, transform: btn_transform -%}{%- if btn_custom -%}--btn-anim-duration: {{ btb.hover_transition | default: 200 }}ms;{%- endif -%}" href="{{ href }}" {{ block_button.shopify_attributes }}>{{ btb.label }}</a>
        {%- endif %}

        {%- if block_newsletter != blank -%}
          {%- liquid
            assign nb = block_newsletter.settings
            assign pbp_nl_form_id = 'pbp-nl-form-' | append: sid
            assign pbp_nl_form_class = 'pbp-nl-formel-' | append: sid
            assign n_ib = ''
            assign n_it = ''
            assign n_ibd = ''
            assign n_sb = ''
            assign n_st = ''
            assign n_sbh = ''
            assign n_sth = ''
            if nb.enable_custom_style == true
              assign n_ib = nb.input_bg
              assign n_it = nb.input_text
              assign n_ibd = nb.input_border
              assign n_sb = nb.submit_bg
              assign n_st = nb.submit_text
              assign n_sbh = nb.submit_bg_hover
              assign n_sth = nb.submit_text_hover
            endif
            assign pbp_ph = nb.email_placeholder | default: fb_accessibility_enter_your_email
            assign pbp_phone_req = 'false'
            if nb.phone_required
              assign pbp_phone_req = 'true'
            endif
            assign pbp_phone_off = true
            if nb.collect_phone
              assign pbp_phone_off = false
            endif
          -%}
          <div class="pbp-newsletter" data-pg-block="{{ block_newsletter.id }}" data-pg-type="newsletter"{% if request.design_mode %} data-pg-settings="{{ nb | json | escape }}"{% endif %} data-pg-i18n='{"placeholder":{{ fb_accessibility_enter_your_email | json | escape }},"submit":{{ fb_accessibility_get_my_code | json | escape }},"success":{{ fb_accessibility_code_emailed_success | json | escape }}}'
               style="--pbp-nl-input-bg: {% render 'scheme-color', color: n_ib, fallback: 'var(--input-bg)' %}; --pbp-nl-input-text: {% render 'scheme-color', color: n_it, fallback: 'var(--input-color)' %}; --pbp-nl-input-border: {% render 'scheme-color', color: n_ibd, fallback: 'var(--color-border)' %};{% if nb.enable_custom_style == true %} --mt-select-bg: {% render 'scheme-color', color: n_ib, fallback: 'var(--input-bg)' %}; --mt-select-text: {% render 'scheme-color', color: n_it, fallback: 'var(--input-color)' %}; --mt-select-border: {% render 'scheme-color', color: n_ibd, fallback: 'var(--color-border)' %};{% endif %}"
               {{ block_newsletter.shopify_attributes }}>
            <form id="{{ pbp_nl_form_id }}" class="{{ pbp_nl_form_class }}" data-storelib-form="subscribe">
              <input class="pbp-nl-email" type="email" name="email" autocomplete="email" required aria-label="{{ pbp_ph | escape }}" placeholder="{{ pbp_ph | escape }}">
              {%- render 'cpnb-phone-field',
                  scope: sid,
                  default_country: nb.phone_default_country,
                  phone_placeholder: nb.phone_placeholder,
                  required: pbp_phone_req,
                  off: pbp_phone_off -%}
              <button class="pbp-nl-submit btn-primary" type="submit" data-theme-button="primary" data-sl-button style="{%- render 'button-overrides', bg: n_sb, text: n_st, hover_bg: n_sbh, hover_text: n_sth -%}">{{ nb.button_label | default: fb_accessibility_get_my_code }}</button>
              <p class="pbp-nl-success" data-storelib-success hidden>{{ nb.success_text | default: fb_accessibility_code_emailed_success }}</p>
            </form>
          </div>
        {%- endif -%}
      </div>

      <div class="pbp-image"{% if block_image != blank %} data-pg-block="{{ block_image.id }}" data-pg-type="image"{% if request.design_mode %} data-pg-settings="{{ ib | json | escape }}"{% endif %} {{ block_image.shopify_attributes }}{% endif %}>
        <template data-pg-ph>{{ 'lifestyle-1' | placeholder_svg_tag: 'pbp-img-el pbp-img-placeholder' }}</template>
        {%- if ib.image != blank -%}
          {{ ib.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: ib.alt, sizes: '(min-width: 990px) 420px, 50vw', widths: '360,540,720,900', class: 'pbp-img-el' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pbp-img-el pbp-img-placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
  </dialog>

  <style>
    #shopify-section-{{ sid }} .promo-banner-pro { position: relative; }
    #shopify-section-{{ sid }} [data-pg-inline] dialog[data-pg-dialog] { display: contents !important; }
    #shopify-section-{{ sid }} .promo-banner-pro:not(.promo-banner-pro--as-popup) :is(.pbp-close, .pbp-overlay) { display: none !important; }
    #shopify-section-{{ sid }} .pbp-text [hidden], #shopify-section-{{ sid }} .pbp-code-row [hidden] { display: none !important; }
    #shopify-section-{{ sid }} .promo-banner-pro .pbp-overlay {
      position: fixed; inset: 0; background: var(--pbp-overlay);
      opacity: 0; pointer-events: none; visibility: hidden;
      transition: opacity .3s ease, visibility 0s linear .3s;
    }
    #shopify-section-{{ sid }} .promo-banner-pro--as-popup .pbp-card {
      position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(0.96);
      opacity: 0; pointer-events: none; visibility: hidden;
      transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s ease, visibility 0s linear .35s;
      z-index: 2147483647;
      max-height: calc(var(--sl-vh, 1vh) * 100 - 24px); overflow: hidden auto; overscroll-behavior: contain;
      max-width: var(--pbp-popup-w);
      width: min(calc(100vw - var(--pbp-gutter, 32px)), var(--pbp-popup-w));
      border-radius: var(--pbp-popup-radius);
    }
    @media (min-width: 750px) {
      #shopify-section-{{ sid }} .promo-banner-pro--as-popup .pbp-card { width: min(92vw, var(--pbp-popup-w)); }
    }
    #shopify-section-{{ sid }} .promo-banner-pro--as-popup.pbp-open .pbp-overlay {
      opacity: var(--pbp-overlay-opacity); pointer-events: auto; z-index: 2147483646;
      visibility: visible; transition-delay: 0s;
    }
    #shopify-section-{{ sid }} .promo-banner-pro--as-popup.pbp-open .pbp-card {
      opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1);
      visibility: visible; transition-delay: 0s;
    }
    #shopify-section-{{ sid }} .pbp-card {
      background: var(--pbp-bg); color: var(--pbp-text) !important;
      border-radius: var(--pbp-radius);
      box-shadow: 0 10px 30px rgba(0,0,0,.10);
      padding-top: var(--pbp-top-pad);
      padding-bottom: var(--pbp-bottom-pad);
      padding-left: var(--pbp-pad);
      padding-right: var(--pbp-pad);
      max-width: 920px; width: min(92vw, 920px);
    }
    #shopify-section-{{ sid }} .pbp-card--inline { margin: 20px auto; }
    #shopify-section-{{ sid }} .pbp-close {
      position: absolute; left: 12px; top: 10px; border: none; background: transparent; outline: none;
      font-size: 28px; line-height: 1; color: var(--pbp-close-color); opacity: .6; cursor: pointer;
      min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center;
      transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    }
    #shopify-section-{{ sid }} .pbp-close:hover { opacity: 1; }
    #shopify-section-{{ sid }} :is(.pbp-close, .pbp-code, .pbp-copy, .pbp-btn, .pbp-nl-submit):focus-visible { outline: 2px solid currentColor; outline-offset: 2px; opacity: 1; }

    #shopify-section-{{ sid }} .pbp-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: var(--pbp-gap); align-items: stretch; }
    #shopify-section-{{ sid }} .pbp-grid.image-left { grid-template-columns: .95fr 1.05fr; }
    #shopify-section-{{ sid }} .pbp-grid.image-left .pbp-text { order: 2; }
    #shopify-section-{{ sid }} .pbp-grid.image-left .pbp-image { order: 1; }

    #shopify-section-{{ sid }} .pbp-text { display: flex; flex-direction: column; justify-content: center; padding: 0 var(--pbp-text-r-pad) 0 var(--pbp-text-l-pad); }
    #shopify-section-{{ sid }} .pbp-image { border-radius: var(--pbp-img-radius); overflow: hidden; }
    #shopify-section-{{ sid }} .pbp-img-el { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 360px; }
    #shopify-section-{{ sid }} .pbp-img-placeholder { background: color-mix(in srgb, var(--color-heading) 8%, var(--pbp-bg)); fill: color-mix(in srgb, var(--color-text) 30%, transparent); }

    #shopify-section-{{ sid }} .pbp-eyebrow {
      text-transform: uppercase; letter-spacing: var(--pbp-eyebrow-ls);
      font-size: var(--pbp-eyebrow-size); font-weight: var(--subheading-weight, 700); opacity: .8; margin-bottom: 8px;
      color: var(--pbp-eyebrow-color, inherit);
    }
    #shopify-section-{{ sid }} .pbp-headline { font-size: var(--pbp-headline-size); line-height: 1.0; font-weight: var(--pbp-headline-w); margin: 0 0 12px; color: var(--pbp-headline-color, inherit); }
    #shopify-section-{{ sid }} .pbp-body { font-size: var(--pbp-body-size); margin: 0 0 18px; max-width: 420px; color: var(--pbp-body-color, inherit); }

    #shopify-section-{{ sid }} .pbp-code-row { display: flex; align-items: center; gap: 10px; margin: 6px 0 20px; flex-wrap: wrap; }
    #shopify-section-{{ sid }} .pbp-code-label { font-weight: 600; opacity: .9; }
    #shopify-section-{{ sid }} .pbp-code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: var(--pbp-code-size); font-weight: 700; letter-spacing: .08em;
      border: 2px dashed var(--pbp-code-border); background: var(--pbp-code-bg); color: var(--pbp-code-color);
      min-height: 44px; padding: 10px 12px; border-radius: 6px; cursor: pointer; transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    }
    #shopify-section-{{ sid }} .pbp-copy {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; border-radius: 6px; border: 1px solid var(--pbp-copy-border);
      background: var(--pbp-copy-bg); color: var(--pbp-copy-color); cursor: pointer; transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    }
    #shopify-section-{{ sid }} .pbp-code.is-copied { background: var(--pbp-code-bg-copied); border-color: var(--pbp-code-border-copied); color: var(--pbp-code-color-copied); }
    #shopify-section-{{ sid }} .pbp-copy.is-copied { background: var(--pbp-copy-bg-copied); border-color: var(--pbp-copy-border-copied); color: var(--pbp-copy-color-copied); }

    #shopify-section-{{ sid }} .pbp-newsletter { margin-top: 16px; max-width: 420px; }
    #shopify-section-{{ sid }} .pbp-newsletter form { display: flex; flex-direction: column; gap: 10px; }
    #shopify-section-{{ sid }} .pbp-newsletter .pbp-nl-email {
      width: 100%;
      min-height: var(--input-height, 44px);
      padding: var(--input-padding, 12px 14px);
      background: var(--pbp-nl-input-bg, var(--input-bg));
      color: var(--pbp-nl-input-text, var(--input-color));
      border: var(--inputs-border-width, 1px) solid var(--pbp-nl-input-border, var(--color-border));
      border-radius: var(--input-border-radius, 8px);
      font-size: var(--input-font-size, 15px);
      outline: none;
      transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    }
    #shopify-section-{{ sid }} .pbp-newsletter .pbp-nl-email::placeholder { color: var(--input-placeholder-color); }
    #shopify-section-{{ sid }} .pbp-newsletter .pbp-nl-email:focus-visible { border-color: var(--color-heading); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent); }
    #shopify-section-{{ sid }} .pbp-newsletter .pbp-nl-submit { width: 100%; }
    #shopify-section-{{ sid }} .pbp-newsletter .pbp-nl-success { margin: 0; color: #1c8d3a; font-size: 14px; }

    /* The button and the signup button are theme buttons
       (theme-button-contract.css); a block's own colours, and its shape with
       the theme's style off, arrive as --mb-* tokens. */
    #shopify-section-{{ sid }} .pbp-btn { text-align: center; width: var(--pbp-btn-w); align-self: flex-start; }

    @media (min-width: 750px) {
      #shopify-section-{{ sid }} .pbp-text.pbp-align-desktop-left { text-align: start; align-items: flex-start; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-desktop-center { text-align: center; align-items: center; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-desktop-center .pbp-code-row { justify-content: center; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-desktop-left .pbp-code-row { justify-content: flex-start; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-desktop-center .pbp-btn { align-self: center; }
      #shopify-section-{{ sid }} [data-pbp-cimg-d] .pbp-img-el { width: var(--pbp-img-w); height: var(--pbp-img-h); }
    }

    @media (max-width: 749px) {
      #shopify-section-{{ sid }} .pbp-grid, #shopify-section-{{ sid }} .pbp-grid.image-left { grid-template-columns: 1fr; }
      #shopify-section-{{ sid }} [data-pbp-mobile-image="above"] .pbp-grid .pbp-text { order: 2; }
      #shopify-section-{{ sid }} [data-pbp-mobile-image="above"] .pbp-grid .pbp-image { order: 1; }
      #shopify-section-{{ sid }} .pbp-card {
        padding-top: var(--pbp-mtop-pad);
        padding-bottom: var(--pbp-mbottom-pad);
        padding-left: var(--pbp-mh-pad);
        padding-right: var(--pbp-mh-pad);
      }
      #shopify-section-{{ sid }} .pbp-text { padding: 0 var(--pbp-text-r-pad-m) 0 var(--pbp-text-l-pad-m); }
      #shopify-section-{{ sid }} .pbp-img-el { min-height: 200px; max-height: 40vh; }
      #shopify-section-{{ sid }} .pbp-eyebrow { font-size: var(--pbp-eyebrow-size-m); }
      #shopify-section-{{ sid }} .pbp-headline { font-size: var(--pbp-headline-size-m); }
      #shopify-section-{{ sid }} .pbp-body { font-size: var(--pbp-body-size-m); }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-mobile-left { text-align: start; align-items: flex-start; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-mobile-center { text-align: center; align-items: center; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-mobile-center .pbp-code-row { justify-content: center; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-mobile-left .pbp-code-row { justify-content: flex-start; }
      #shopify-section-{{ sid }} .pbp-text.pbp-align-mobile-center .pbp-btn { align-self: center; }
      #shopify-section-{{ sid }} [data-pbp-cimg-m] .pbp-img-el { width: var(--pbp-img-w-m); height: var(--pbp-img-h-m); }
      #shopify-section-{{ sid }} .pbp-close { left: 8px; top: 6px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} :is(.pbp-overlay, .pbp-card, .pbp-close, .pbp-code, .pbp-copy, .pbp-btn, .pbp-nl-email, .pbp-nl-submit) { transition: none !important; }
      #shopify-section-{{ sid }} .promo-banner-pro--as-popup .pbp-card { transform: translate(-50%, -50%) !important; }
    }
{% comment %}{% endcomment %}  </style>

  <script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
  <script>
    (function(){
      var SID = {{ section.id | json }};
      var I18N_COPIED_UPPER = {{ 'accessibility.copied_upper' | t | json }};
      function setup(P){
        var root = document.querySelector('.promo-banner-pro[data-section-id="' + SID + '"]');
        if (!root || root.__pbp) return;
        root.__pbp = true;
        var codeBtn = root.querySelector('.pbp-code');
        var copyBtn = root.querySelector('.pbp-copy');
        var form = root.querySelector('.pbp-nl-formel-' + SID);
        var api = null;

        // Copy the code (the code or the icon), and say so for 3 seconds.
        function copyCode(){
          var code = codeBtn && codeBtn.dataset.code;
          if (!code) return;
          P.copy(code).catch(function(){}).then(function(){
            codeBtn.textContent = I18N_COPIED_UPPER;
            codeBtn.classList.add('is-copied');
            if (copyBtn) copyBtn.classList.add('is-copied');
            setTimeout(function(){
              codeBtn.textContent = codeBtn.dataset.code || '';
              codeBtn.classList.remove('is-copied');
              if (copyBtn) copyBtn.classList.remove('is-copied');
            }, 3000);
          });
        }
        if (codeBtn) codeBtn.addEventListener('click', copyCode);
        if (copyBtn) copyBtn.addEventListener('click', copyCode);

        if (!root.classList.contains('promo-banner-pro--as-popup')) return;   // drawn inline, not as a popup
        var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
        api = P.register({
          id: SID, root: root, dialog: root.querySelector('.pbp-card'), backdrop: root.querySelector('.pbp-overlay'),
          design: CFG.design, preview: CFG.preview, trigger: CFG.trigger, frequency: CFG.frequency,
          open: function(){ root.classList.add('pbp-open'); },
          close: function(){ root.classList.remove('pbp-open'); }
        });
        if (form) new MutationObserver(function(){
          if (form.getAttribute('data-state') === 'done' && api) api.done(365);
        }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
        window['PBP_open_' + SID] = function(){ api.show(); };
        window['PBP_close_' + SID] = function(){ api.hide(); };
      }
      function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
      boot();
      function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
      document.addEventListener('storelib:section-load', reload);
      document.addEventListener('shopify:section:load', reload);
    })();
{% comment %}{% endcomment %}  </script>
</section>
</template>

