<template compat="shopify">
{%- assign fb_accessibility_promotion_image_placeholder = 'accessibility.promotion_image_placeholder' | t -%}
{%- assign fb_accessibility_code_emailed_success = 'accessibility.code_emailed_success' | t -%}
{%- assign fb_accessibility_get_my_code = 'accessibility.get_my_code' | t -%}
{%- assign fb_accessibility_enter_your_email = 'accessibility.enter_your_email' | t -%}
{%- assign fb_accessibility_close = 'accessibility.close' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation removed for popup — popup uses position:fixed and the
     highest possible z-index, so we must NOT create a stacking context here
     or the popup gets trapped inside it and gets covered by other sections. */
  #shopify-section-{{ section.id }} {
    position: static;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


{% assign is_popup = section.settings.show_as_popup %}

{%- comment -%}
  Block lookup: each content piece (eyebrow, headline, body, coupon, button,
  image) is a block with limit:1. Older instances may not have any blocks yet
  — in that case we fall back to legacy section-level settings so the popup
  keeps rendering exactly as before.
{%- endcomment -%}
{%- assign block_eyebrow = blank -%}
{%- assign block_headline = blank -%}
{%- assign block_body = blank -%}
{%- assign block_coupon = blank -%}
{%- assign block_button = blank -%}
{%- assign block_newsletter = blank -%}
{%- assign block_image = blank -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'eyebrow' -%}{%- assign block_eyebrow = b -%}
    {%- when 'headline' -%}{%- assign block_headline = b -%}
    {%- when 'body' -%}{%- assign block_body = b -%}
    {%- when 'coupon' -%}{%- assign block_coupon = b -%}
    {%- when 'button' -%}{%- assign block_button = b -%}
    {%- when 'newsletter' -%}{%- assign block_newsletter = b -%}
    {%- when 'image' -%}{%- assign block_image = b -%}
  {%- endcase -%}
{%- endfor -%}

{%- comment -%} Eyebrow block resolution {%- endcomment -%}
{%- if block_eyebrow != blank -%}
  {%- assign eyebrow_text = block_eyebrow.settings.text -%}
  {%- assign eyebrow_size_d = block_eyebrow.settings.size_desktop -%}
  {%- assign eyebrow_size_m = block_eyebrow.settings.size_mobile -%}
  {%- assign eyebrow_ls = block_eyebrow.settings.letter_spacing -%}
  {%- assign eyebrow_color = block_eyebrow.settings.color -%}
{%- else -%}
  {%- assign eyebrow_text = section.settings.eyebrow -%}
  {%- assign eyebrow_size_d = section.settings.eyebrow_size -%}
  {%- assign eyebrow_size_m = section.settings.eyebrow_size_mobile -%}
  {%- assign eyebrow_ls = section.settings.eyebrow_ls -%}
  {%- assign eyebrow_color = '' -%}
{%- endif -%}
{%- comment -%} Headline block resolution {%- endcomment -%}
{%- if block_headline != blank -%}
  {%- assign headline_text = block_headline.settings.text -%}
  {%- assign headline_size_d = block_headline.settings.size_desktop -%}
  {%- assign headline_size_m = block_headline.settings.size_mobile -%}
  {%- assign headline_weight = block_headline.settings.weight -%}
  {%- assign headline_color = block_headline.settings.color -%}
{%- else -%}
  {%- assign headline_text = section.settings.headline -%}
  {%- assign headline_size_d = section.settings.headline_size -%}
  {%- assign headline_size_m = section.settings.headline_size_mobile -%}
  {%- assign headline_weight = section.settings.headline_weight -%}
  {%- assign headline_color = '' -%}
{%- endif -%}
{%- comment -%} Body block resolution {%- endcomment -%}
{%- if block_body != blank -%}
  {%- assign body_text = block_body.settings.text -%}
  {%- assign body_size_d = block_body.settings.size_desktop -%}
  {%- assign body_size_m = block_body.settings.size_mobile -%}
  {%- assign body_color = block_body.settings.color -%}
{%- else -%}
  {%- assign body_text = section.settings.body -%}
  {%- assign body_size_d = section.settings.body_size -%}
  {%- assign body_size_m = section.settings.body_size_mobile -%}
  {%- assign body_color = '' -%}
{%- endif -%}
{%- comment -%} Coupon block resolution {%- endcomment -%}
{%- if block_coupon != blank -%}
  {%- assign coupon_label = block_coupon.settings.label -%}
  {%- assign coupon_code = block_coupon.settings.code -%}
  {%- assign code_size = block_coupon.settings.code_size -%}
  {%- assign code_bg = block_coupon.settings.code_bg -%}
  {%- assign code_bg_copied = block_coupon.settings.code_bg_copied -%}
  {%- assign code_border = block_coupon.settings.code_border -%}
  {%- assign code_border_copied = block_coupon.settings.code_border_copied -%}
  {%- assign code_color = block_coupon.settings.code_color -%}
  {%- assign code_color_copied = block_coupon.settings.code_color_copied -%}
  {%- assign copy_bg = block_coupon.settings.copy_bg -%}
  {%- assign copy_bg_copied = block_coupon.settings.copy_bg_copied -%}
  {%- assign copy_border = block_coupon.settings.copy_border -%}
  {%- assign copy_border_copied = block_coupon.settings.copy_border_copied -%}
  {%- assign copy_color = block_coupon.settings.copy_color -%}
  {%- assign copy_color_copied = block_coupon.settings.copy_color_copied -%}
{%- else -%}
  {%- assign coupon_label = section.settings.coupon_label -%}
  {%- assign coupon_code = section.settings.coupon_code -%}
  {%- assign code_size = section.settings.code_size -%}
  {%- assign code_bg = section.settings.code_bg -%}
  {%- assign code_bg_copied = section.settings.code_bg_copied -%}
  {%- assign code_border = section.settings.code_border -%}
  {%- assign code_border_copied = section.settings.code_border_copied -%}
  {%- assign code_color = section.settings.code_color -%}
  {%- assign code_color_copied = section.settings.code_color_copied -%}
  {%- assign copy_bg = section.settings.copy_bg -%}
  {%- assign copy_bg_copied = section.settings.copy_bg_copied -%}
  {%- assign copy_border = section.settings.copy_border -%}
  {%- assign copy_border_copied = section.settings.copy_border_copied -%}
  {%- assign copy_color = section.settings.copy_color -%}
  {%- assign copy_color_copied = section.settings.copy_color_copied -%}
{%- endif -%}
{%- comment -%} Button block resolution {%- endcomment -%}
{%- if block_button != blank -%}
  {%- assign btn_label = block_button.settings.label -%}
  {%- assign btn_link = block_button.settings.link -%}
  {%- assign append_discount = block_button.settings.append_discount -%}
  {%- assign btn_bg = block_button.settings.bg -%}
  {%- assign btn_text = block_button.settings.text_color -%}
  {%- assign btn_bg_hover = block_button.settings.bg_hover -%}
  {%- assign btn_text_hover = block_button.settings.text_hover -%}
  {%- assign btn_hover_transition = block_button.settings.hover_transition -%}
  {%- assign btn_size = block_button.settings.size -%}
  {%- assign btn_width = block_button.settings.width -%}
  {%- assign btn_radius = block_button.settings.radius -%}
{%- else -%}
  {%- assign btn_label = section.settings.btn_label -%}
  {%- assign btn_link = section.settings.btn_link -%}
  {%- assign append_discount = section.settings.append_discount -%}
  {%- assign btn_bg = section.settings.btn_bg -%}
  {%- assign btn_text = section.settings.btn_text -%}
  {%- assign btn_bg_hover = '#000000' -%}
  {%- assign btn_text_hover = section.settings.btn_text -%}
  {%- assign btn_hover_transition = 200 -%}
  {%- assign btn_size = section.settings.btn_size -%}
  {%- assign btn_width = section.settings.btn_width -%}
  {%- assign btn_radius = section.settings.btn_radius -%}
{%- endif -%}
{%- comment -%} Image block resolution {%- endcomment -%}
{%- if block_image != blank -%}
  {%- assign image_pic = block_image.settings.image -%}
  {%- assign image_alt = block_image.settings.alt -%}
  {%- assign image_side = block_image.settings.side -%}
  {%- assign mobile_image_position = block_image.settings.mobile_position -%}
  {%- assign enable_custom_img_desktop = block_image.settings.enable_custom_desktop -%}
  {%- assign img_w_desktop = block_image.settings.desktop_w -%}
  {%- assign img_h_desktop = block_image.settings.desktop_h -%}
  {%- assign enable_custom_img_mobile = block_image.settings.enable_custom_mobile -%}
  {%- assign img_w_mobile = block_image.settings.mobile_w -%}
  {%- assign img_h_mobile = block_image.settings.mobile_h -%}
  {%- assign img_radius = block_image.settings.radius -%}
{%- else -%}
  {%- assign image_pic = section.settings.image -%}
  {%- assign image_alt = section.settings.image_alt -%}
  {%- assign image_side = section.settings.image_side -%}
  {%- assign mobile_image_position = section.settings.mobile_image_position -%}
  {%- assign enable_custom_img_desktop = section.settings.enable_custom_img_desktop -%}
  {%- assign img_w_desktop = section.settings.img_w_desktop -%}
  {%- assign img_h_desktop = section.settings.img_h_desktop -%}
  {%- assign enable_custom_img_mobile = section.settings.enable_custom_img_mobile -%}
  {%- assign img_w_mobile = section.settings.img_w_mobile -%}
  {%- assign img_h_mobile = section.settings.img_h_mobile -%}
  {%- assign img_radius = section.settings.img_radius -%}
{%- endif -%}

<section
  class="promo-banner-pro{% if is_popup %} promo-banner-pro--as-popup{% endif %}"
  data-section-id="{{ section.id }}"
  data-hide-days="{{ section.settings.hide_days }}"
  data-open-mode="{{ section.settings.open_mode }}"
  data-delay="{{ section.settings.delay_s }}"
  data-inactivity="{{ section.settings.inactivity_s }}"
  data-exit-intent="{% if section.settings.exit_intent %}true{% else %}false{% endif %}"
  data-append-discount="{% if append_discount %}true{% else %}false{% endif %}"
  data-discount-code="{{ coupon_code | escape }}"
  data-show-once-per-session="{% if section.settings.once_per_session %}true{% else %}false{% endif %}"
  data-edit-mode="{% if section.settings.enable_edit_mode %}true{% else %}false{% endif %}"
  style="
    --pbp-bg: {{ section.settings.card_bg }};
    --pbp-text: {{ section.settings.text_color }};
    --pbp-btn-bg: {{ btn_bg }};
    --pbp-btn-text: {{ btn_text }};
    --pbp-btn-bg-hover: {{ btn_bg_hover }};
    --pbp-btn-text-hover: {{ btn_text_hover }};
    --pbp-btn-hover-transition: {{ btn_hover_transition }}ms;
    --pbp-overlay: {{ section.settings.overlay_color }};
    --pbp-overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
    --pbp-radius: {{ section.settings.radius }}px;
    --pbp-popup-radius: {{ section.settings.popup_radius }}px;
    --pbp-popup-w: {{ section.settings.popup_width }}px;
    --pbp-pad: {{ section.settings.card_padding }}px;
    --pbp-top-pad: {{ section.settings.top_padding }}px;
    --pbp-bottom-pad: {{ section.settings.bottom_padding }}px;
    --pbp-mtop-pad: {{ section.settings.mobile_top_padding }}px;
    --pbp-mbottom-pad: {{ section.settings.mobile_bottom_padding }}px;
    --pbp-mh-pad: {{ section.settings.mobile_h_padding }}px;
    --pbp-gap: {{ section.settings.col_gap }}px;
    --pbp-eyebrow-ls: {{ eyebrow_ls }}em;
    --pbp-eyebrow-size: {{ eyebrow_size_d }}px;
    --pbp-eyebrow-size-m: {{ eyebrow_size_m }}px;
    --pbp-eyebrow-color: {{ eyebrow_color | default: 'inherit' }};
    --pbp-headline-size: {{ headline_size_d }}px;
    --pbp-headline-size-m: {{ headline_size_m }}px;
    --pbp-headline-w: {{ headline_weight }};
    --pbp-headline-color: {{ headline_color | default: 'inherit' }};
    --pbp-body-size: {{ body_size_d }}px;
    --pbp-body-size-m: {{ body_size_m }}px;
    --pbp-body-color: {{ body_color | default: 'inherit' }};
    --pbp-code-size: {{ code_size }}px;
    --pbp-btn-size: {{ btn_size }}px;
    --pbp-btn-radius: {{ btn_radius }}px;
    --pbp-text-l-pad: {{ section.settings.text_left_pad_desktop }}px;
    --pbp-text-r-pad: {{ section.settings.text_right_pad_desktop }}px;
    --pbp-text-l-pad-m: {{ section.settings.text_left_pad_mobile }}px;
    --pbp-text-r-pad-m: {{ section.settings.text_right_pad_mobile }}px;
    --pbp-img-radius: {{ img_radius }}px;

    --pbp-code-bg: {{ code_bg }};
    --pbp-code-bg-copied: {{ code_bg_copied }};
    --pbp-code-border: {{ code_border }};
    --pbp-code-border-copied: {{ code_border_copied }};
    --pbp-code-color: {{ code_color }} !important;
    --pbp-code-color-copied: {{ code_color_copied }};

    --pbp-copy-bg: {{ copy_bg }};
    --pbp-copy-bg-copied: {{ copy_bg_copied }};
    --pbp-copy-border: {{ copy_border }};
    --pbp-copy-border-copied: {{ copy_border_copied }};
    --pbp-copy-color: {{ copy_color }} !important;
    --pbp-copy-color-copied: {{ copy_color_copied }};

    --pbp-close-color: {{ section.settings.close_color }} !important;

    /* Desktop button width (auto if 0) */
    --pbp-btn-w: {% if btn_width > 0 %}{{ btn_width }}px{% else %}auto{% endif %};

    /* Desktop custom image size */
    --pbp-img-w: {% if enable_custom_img_desktop %}{{ img_w_desktop }}px{% else %}100%{% endif %};
    --pbp-img-h: {% if enable_custom_img_desktop %}{{ img_h_desktop }}px{% else %}100%{% endif %};

    /* Mobile custom image size */
    --pbp-img-w-m: {% if enable_custom_img_mobile %}{{ img_w_mobile }}px{% else %}100%{% endif %};
    --pbp-img-h-m: {% if enable_custom_img_mobile %}{{ img_h_mobile }}px{% else %}100%{% endif %};
  "
>
  <div class="pbp-overlay" aria-hidden="true"></div>

  <div class="pbp-card{% unless is_popup %} pbp-card--inline{% endunless %}"
       {% if is_popup %}role="dialog" aria-modal="true"{% endif %}
       aria-labelledby="pbp-title-{{ section.id }}"
       aria-describedby="pbp-desc-{{ section.id }}">

    <button class="pbp-close" aria-label="{{ 'general.close' | t | default: fb_accessibility_close }}">
      <span aria-hidden="true">×</span>
    </button>

    <div class="pbp-grid {{ image_side }}">
      <div class="pbp-text pbp-align-desktop-{{ section.settings.align_desktop }} pbp-align-mobile-{{ section.settings.align_mobile }}">
        {% if eyebrow_text != blank %}
          <div class="pbp-eyebrow"{% if block_eyebrow != blank %} {{ block_eyebrow.shopify_attributes }}{% endif %}>{{ eyebrow_text }}</div>
        {% endif %}

        {% if headline_text != blank %}
          <h2 class="pbp-headline" id="pbp-title-{{ section.id }}"{% if block_headline != blank %} {{ block_headline.shopify_attributes }}{% endif %}>{{ headline_text }}</h2>
        {% endif %}

        {% if body_text != blank %}
          <p class="pbp-body" id="pbp-desc-{{ section.id }}"{% if block_body != blank %} {{ block_body.shopify_attributes }}{% endif %}>{{ body_text }}</p>
        {% endif %}

        {% if coupon_code != blank or coupon_label != blank %}
          <div class="pbp-code-row"{% if block_coupon != blank %} {{ block_coupon.shopify_attributes }}{% endif %}>
            {% if coupon_label != blank %}
              <span class="pbp-code-label">{{ coupon_label }}</span>
            {% endif %}
            {% if coupon_code != blank %}
              <button class="pbp-code" data-code="{{ coupon_code | escape }}" type="button" aria-label="{{ 'accessibility.copy_coupon_code' | t }}">
                {{ coupon_code | escape }}
              </button>
              <button class="pbp-copy" type="button" aria-label="{{ 'accessibility.copy_coupon' | t }}">
                <svg width="20" height="20" viewBox="0 -0.5 25 25" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                  <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                  <g id="SVGRepo_iconCarrier">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M17.676 14.248C17.676 15.8651 16.3651 17.176 14.748 17.176H7.428C5.81091 17.176 4.5 15.8651 4.5 14.248V6.928C4.5 5.31091 5.81091 4 7.428 4H14.748C16.3651 4 17.676 5.31091 17.676 6.928V14.248Z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M10.252 20H17.572C19.1891 20 20.5 18.689 20.5 17.072V9.75195" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path>
                  </g>
                </svg>
              </button>
            {% endif %}
          </div>
        {% endif %}

        {% assign href = btn_link %}
        {% if append_discount and coupon_code != blank and href != blank %}
          {% assign redir = href %}
          {% assign href = '/discount/' | append: coupon_code | append: '?redirect=' | append: redir %}
        {% endif %}

        {% if btn_label != blank %}
          <a class="pbp-btn"{% if href != blank %} href="{{ href }}"{% endif %}{% if block_button != blank %} {{ block_button.shopify_attributes }}{% endif %}>
            {{ btn_label }}
          </a>
        {% endif %}

        {%- if block_newsletter != blank -%}
          {%- assign pbp_nl_form_id = 'pbp-nl-form-' | append: section.id -%}
          {%- assign pbp_nl_form_class = 'pbp-nl-formel-' | append: section.id -%}
          <div class="pbp-newsletter"
               style="--pbp-nl-input-bg: {{ block_newsletter.settings.input_bg }};
                      --pbp-nl-input-text: {{ block_newsletter.settings.input_text }};
                      --pbp-nl-input-border: {{ block_newsletter.settings.input_border }};
                      --pbp-nl-submit-bg: {{ block_newsletter.settings.submit_bg }};
                      --pbp-nl-submit-text: {{ block_newsletter.settings.submit_text }};
                      --pbp-nl-submit-bg-hover: {{ block_newsletter.settings.submit_bg_hover }};
                      --pbp-nl-submit-text-hover: {{ block_newsletter.settings.submit_text_hover }};"
               {{ block_newsletter.shopify_attributes }}>
            {%- form 'customer', id: pbp_nl_form_id, class: pbp_nl_form_class -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input class="pbp-nl-email" type="email" name="contact[email]" required
                     placeholder="{{ block_newsletter.settings.email_placeholder | default: fb_accessibility_enter_your_email | escape }}">
              {%- if block_newsletter.settings.collect_phone -%}
                {%- if block_newsletter.settings.phone_required -%}{%- assign pbp_phone_req = 'true' -%}{%- else -%}{%- assign pbp_phone_req = 'false' -%}{%- endif -%}
                {%- render 'cpnb-phone-field',
                    scope: section.id,
                    default_country: block_newsletter.settings.phone_default_country,
                    phone_placeholder: block_newsletter.settings.phone_placeholder,
                    required: pbp_phone_req -%}
              {%- endif -%}
              <button class="pbp-nl-submit" type="submit">
                {{ block_newsletter.settings.button_label | default: fb_accessibility_get_my_code }}
              </button>
              {%- if form.posted_successfully? -%}
                <p class="pbp-nl-success">{{ block_newsletter.settings.success_text | default: fb_accessibility_code_emailed_success }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pbp-image"{% if block_image != blank %} {{ block_image.shopify_attributes }}{% endif %}>
        {% if image_pic != blank %}
          {{ image_pic | image_url: width: 900 | image_tag:
            loading: 'lazy',
            alt: image_alt,
            sizes: '(min-width: 990px) 420px, 50vw',
            widths: '360,540,720,900',
            class: 'pbp-img-el'
          }}
        {% else %}
          <img
            class="pbp-img-el"
            src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
            width="900" height="600" loading="lazy" alt="{{ image_alt | default: fb_accessibility_promotion_image_placeholder }}">
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    .promo-banner-pro { position: relative; }
    .promo-banner-pro .pbp-overlay{
      position: fixed; inset: 0; background: var(--pbp-overlay);
      opacity: 0; pointer-events: none; transition: opacity .3s ease-in-out;
    }
    .promo-banner-pro--as-popup .pbp-card{
      position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(0.95);
      opacity: 0; pointer-events: none; transition: transform .3s ease-in-out, opacity .3s ease-in-out;
      z-index: 2147483647;
      max-width: var(--pbp-popup-w);
      /* Default: 92vw with a hard floor so very narrow phones still keep
         a comfortable side gutter (16px each side) instead of gluing to edges. */
      width: min(calc(100vw - {{ section.settings.mobile_side_gutter | default: 32 }}px), var(--pbp-popup-w));
      border-radius: var(--pbp-popup-radius);
    }
    @media (min-width: 750px){
      .promo-banner-pro--as-popup .pbp-card{
        width: min(92vw, var(--pbp-popup-w));
      }
    }
    .promo-banner-pro--as-popup.pbp-open .pbp-overlay{
      opacity: var(--pbp-overlay-opacity); pointer-events: auto; z-index: 2147483646;
    }
    .promo-banner-pro--as-popup.pbp-open .pbp-card{
      opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1);
    }

    .pbp-card{
      background: var(--pbp-bg); color: var(--pbp-text) !important;
      border-radius: var(--pbp-radius);
      box-shadow: 0 10px 30px rgba(0,0,0,.10);
      padding-top: var(--pbp-top-pad);
      padding-bottom: var(--pbp-bottom-pad);
      padding-left: var(--pbp-pad);
      padding-right: var(--pbp-pad);
      max-width: 920px; width: min(92vw, 920px);
    }
    .pbp-card--inline{ margin: 20px auto; }

    .pbp-close{
      position: absolute; left: 12px; top: 10px; border: none; background: transparent; outline: none;
      font-size: 28px; line-height: 1; color: var(--pbp-close-color); opacity:.6; cursor:pointer;
      transition: opacity .2s ease;
    }
    .pbp-close:hover{ opacity: 1; }
    .pbp-close:focus { outline: none; }

    .pbp-grid{
      display: grid; grid-template-columns: 1.05fr .95fr; gap: var(--pbp-gap); align-items: stretch;
    }
    .pbp-grid.image-left{ grid-template-columns: .95fr 1.05fr; }
    .pbp-grid.image-left .pbp-text{ order: 2; }
    .pbp-grid.image-left .pbp-image{ order: 1; }

    .pbp-text{ display:flex; flex-direction:column; justify-content:center; padding: 0 var(--pbp-text-r-pad) 0 var(--pbp-text-l-pad); }
    .pbp-image{ border-radius: var(--pbp-img-radius); overflow: hidden; }
    .pbp-img-el{ width:100%; height:100%; object-fit: cover; display:block; min-height: 360px; }

    .pbp-eyebrow{
      text-transform: uppercase; letter-spacing: var(--pbp-eyebrow-ls);
      font-size: var(--pbp-eyebrow-size); font-weight: 700; opacity:.8; margin-bottom: 8px;
    }
    .pbp-headline{
      font-size: var(--pbp-headline-size); line-height: 1.0; font-weight: var(--pbp-headline-w); margin: 0 0 12px;
    }
    .pbp-body{ font-size: var(--pbp-body-size); margin: 0 0 18px; max-width: 420px; }

    .pbp-code-row{ display:flex; align-items:center; gap:10px; margin: 6px 0 20px; flex-wrap: wrap; }
    .pbp-code-label{ font-weight: 600; opacity:.9; }
    .pbp-code{
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: var(--pbp-code-size); font-weight: 700; letter-spacing: .08em;
      border: 2px dashed var(--pbp-code-border); background: var(--pbp-code-bg); color: var(--pbp-code-color);
      padding: 10px 12px; border-radius: 6px; cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease;
    }
    .pbp-copy{
      display:inline-flex; align-items:center; justify-content:center;
      width:38px; height:38px; border-radius: 6px; border:1px solid var(--pbp-copy-border);
      background: var(--pbp-copy-bg); color: var(--pbp-copy-color); cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease;
    }

    /* Copied visual state */
    .pbp-code.is-copied{
      background: var(--pbp-code-bg-copied);
      border-color: var(--pbp-code-border-copied);
      color: var(--pbp-code-color-copied);
    }
    .pbp-copy.is-copied{
      background: var(--pbp-copy-bg-copied);
      border-color: var(--pbp-copy-border-copied);
      color: var(--pbp-copy-color-copied);
    }

    /* Optional newsletter form block */
    .pbp-newsletter { margin-top: 16px; max-width: 420px; }
    .pbp-newsletter form { display: flex; flex-direction: column; gap: 10px; }
    .pbp-newsletter .pbp-nl-email {
      width: 100%; padding: 12px 14px;
      background: var(--pbp-nl-input-bg, #fff);
      color: var(--pbp-nl-input-text, #111);
      border: 1px solid var(--pbp-nl-input-border, #ccc);
      border-radius: 8px;
      font-size: 15px;
      outline: none;
    }
    .pbp-newsletter .pbp-nl-submit {
      width: 100%; padding: 12px 18px;
      background: var(--pbp-nl-submit-bg, #111);
      color: var(--pbp-nl-submit-text, #fff);
      border: none; border-radius: 8px;
      font-weight: 700; font-size: 15px;
      cursor: pointer;
      transition: background-color .25s ease, color .25s ease;
    }
    .pbp-newsletter .pbp-nl-submit:hover,
    .pbp-newsletter .pbp-nl-submit:focus-visible {
      background: var(--pbp-nl-submit-bg-hover, var(--pbp-nl-submit-bg));
      color: var(--pbp-nl-submit-text-hover, var(--pbp-nl-submit-text));
    }
    .pbp-newsletter .pbp-nl-success {
      margin: 0;
      color: #1c8d3a;
      font-size: 14px;
    }

    .pbp-btn{
      display:inline-block; text-decoration:none; text-align:center;
      padding: 14px 26px; border-radius: var(--pbp-btn-radius);
      background: var(--pbp-btn-bg); color: var(--pbp-btn-text);
      font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
      font-size: var(--pbp-btn-size);
      width: var(--pbp-btn-w);
      align-self: flex-start; /* overridden by center alignment */
      transition: background-color var(--pbp-btn-hover-transition) ease, color var(--pbp-btn-hover-transition) ease, border-color var(--pbp-btn-hover-transition) ease;
    }
    .pbp-btn:hover,
    .pbp-btn:focus-visible{
      background: var(--pbp-btn-bg-hover);
      color: var(--pbp-btn-text-hover);
    }

    /* Desktop alignment controls */
    @media (min-width: 750px){
      .pbp-text.pbp-align-desktop-left{ text-align: left; align-items: flex-start; }
      .pbp-text.pbp-align-desktop-center{ text-align: center; align-items: center; }
      .pbp-text.pbp-align-desktop-center .pbp-code-row{ justify-content: center; }
      .pbp-text.pbp-align-desktop-left .pbp-code-row{ justify-content: flex-start; }
      .pbp-text.pbp-align-desktop-center .pbp-btn{ align-self: center; }
    }

    /* Desktop custom image size (only when enabled) */
    @media (min-width: 750px){
      {% if enable_custom_img_desktop %}
      .pbp-img-el{ width: var(--pbp-img-w); height: var(--pbp-img-h); }
      {% endif %}
    }

    /* Per-block color overrides (only apply when set on the block) */
    .pbp-eyebrow{ color: var(--pbp-eyebrow-color, inherit); }
    .pbp-headline{ color: var(--pbp-headline-color, inherit); }
    .pbp-body{ color: var(--pbp-body-color, inherit); }

    /* Mobile */
    @media (max-width: 749px){
      .pbp-grid{ grid-template-columns: 1fr; }
      {% if mobile_image_position == 'above' %}
      .pbp-text{ order: 2; }
      .pbp-image{ order: 1; }
      {% endif %}
      .pbp-card {
        padding-top: var(--pbp-mtop-pad);
        padding-bottom: var(--pbp-mbottom-pad);
        padding-left: var(--pbp-mh-pad);
        padding-right: var(--pbp-mh-pad);
      }
      .pbp-text{ padding: 0 var(--pbp-text-r-pad-m) 0 var(--pbp-text-l-pad-m); }
      .pbp-img-el{ min-height: 260px; }

      .pbp-eyebrow{ font-size: var(--pbp-eyebrow-size-m); }
      .pbp-headline{ font-size: var(--pbp-headline-size-m); }
      .pbp-body{ font-size: var(--pbp-body-size-m); }

      /* Mobile alignment controls */
      .pbp-text.pbp-align-mobile-left{ text-align: left; align-items: flex-start; }
      .pbp-text.pbp-align-mobile-center{ text-align: center; align-items: center; }
      .pbp-text.pbp-align-mobile-center .pbp-code-row{ justify-content: center; }
      .pbp-text.pbp-align-mobile-left .pbp-code-row{ justify-content: flex-start; }
      .pbp-text.pbp-align-mobile-center .pbp-btn{ align-self: center; }

      /* Mobile custom image size (only when enabled) */
      {% if enable_custom_img_mobile %}
      .pbp-img-el{ width: var(--pbp-img-w-m); height: var(--pbp-img-h-m); }
      {% endif %}

      .pbp-close{ left: 8px; top: 6px; }
    }
{% comment %}{% endcomment %}  </style>

  <script>
    (function(){
      const I18N_COPIED_UPPER = {{ 'accessibility.copied_upper' | t | json }};
      const root = document.currentScript.closest('.promo-banner-pro');
      const card = root.querySelector('.pbp-card');
      const overlay = root.querySelector('.pbp-overlay');
      const closeBtn = root.querySelector('.pbp-close');
      const copyBtn = root.querySelector('.pbp-copy');
      const codeBtn = root.querySelector('.pbp-code');

      // Robust copy to clipboard (code or icon click)
      function copyCode(){
        const code = codeBtn?.dataset.code || '';
        if(!code) return;

        const originalText = codeBtn.textContent;

        function markCopied(){
          codeBtn.textContent = I18N_COPIED_UPPER;
          codeBtn && codeBtn.classList.add('is-copied');
          copyBtn && copyBtn.classList.add('is-copied');
          setTimeout(()=>{
            codeBtn.textContent = originalText;
            codeBtn && codeBtn.classList.remove('is-copied');
            copyBtn && copyBtn.classList.remove('is-copied');
          }, 3000);
        }

        if(navigator.clipboard && navigator.clipboard.writeText){
          navigator.clipboard.writeText(code).then(markCopied).catch(()=>fallback());
        } else {
          fallback();
        }

        function fallback(){
          const ta = document.createElement('textarea');
          ta.value = code;
          ta.setAttribute('readonly','');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try{ document.execCommand('copy'); }catch(e){}
          document.body.removeChild(ta);
          markCopied();
        }
      }
      copyBtn && copyBtn.addEventListener('click', copyCode);
      codeBtn && codeBtn.addEventListener('click', copyCode);

      // Popup behavior
      const isPopup = root.classList.contains('promo-banner-pro--as-popup');
      if(!isPopup) return;

      const id = root.dataset.sectionId || '{{ section.id }}';
      const hideDays = parseInt(root.dataset.hideDays || '0', 10);
      const openMode = root.dataset.openMode;
       const delay = parseInt(root.dataset.delay || '0', 10) * 1000; // convert seconds → ms
      const inactivity = parseInt(root.dataset.inactivity || '0', 10) * 1000;
      const exitIntentEnabled = root.dataset.exitIntent === 'true';
      const oncePerSession = root.dataset.showOncePerSession === 'true';
      const editModeWanted = root.dataset.editMode === 'true';
      const inDesign = !!(window.Shopify && Shopify.designMode);
      const editMode = editModeWanted && inDesign;

      const LS_KEY = 'pbp_hide_until_' + id;
      const SS_KEY = 'pbp_shown_' + id;

      function isHidden(){
        if(editMode) return false; // always show while editing
        const until = parseInt(localStorage.getItem(LS_KEY) || '0', 10);
        if(until && Date.now() < until) return true;
        if(oncePerSession && sessionStorage.getItem(SS_KEY)) return true;
        return false;
      }
      function hideForDays(days){
        if(editMode) return; // do not hide in editor
        if(days > 0){
          const until = Date.now() + days*24*60*60*1000;
          localStorage.setItem(LS_KEY, String(until));
        }
      }
      function show(){
        if(isHidden()) return;
        root.classList.add('pbp-open');
        if(!editMode){ sessionStorage.setItem(SS_KEY, '1'); }
        trapFocus();
      }
      function close(){
        root.classList.remove('pbp-open');
        untrapFocus();
        if(editMode){
          setTimeout(() => {
            root.classList.add('pbp-open');
            trapFocus();
          }, 5000);
          return;
        }
        hideForDays(hideDays);
      }

      closeBtn && closeBtn.addEventListener('click', close);
      overlay && overlay.addEventListener('click', close);
      document.addEventListener('keydown', e => { if(e.key === 'Escape') close(); });

      // Focus trap for a11y
      let prevFocus, firstFocusable, focusables;
      function trapFocus(){
        prevFocus = document.activeElement;
        focusables = card.querySelectorAll('a,button,[tabindex]:not([tabindex="-1"])');
        firstFocusable = focusables[0] || closeBtn;
        (firstFocusable || card).focus({preventScroll:true});
        card.addEventListener('keydown', cycleFocus);
      }
      function untrapFocus(){
        card.removeEventListener('keydown', cycleFocus);
        if(prevFocus && prevFocus.focus){ prevFocus.focus({preventScroll:true}); }
      }
      function cycleFocus(e){
        if(e.key !== 'Tab' || focusables.length < 2) return;
        const focusedIndex = Array.prototype.indexOf.call(focusables, document.activeElement);
        if(e.shiftKey && focusedIndex === 0){ e.preventDefault(); focusables[focusables.length-1].focus(); }
        else if(!e.shiftKey && focusedIndex === focusables.length-1){ e.preventDefault(); focusables[0].focus(); }
      }

      // Open logic
      if(editMode){
        show();
        // Keep visible while editing
        ['click','keydown'].forEach(ev=>{
          card.addEventListener(ev, ()=>{ root.classList.add('pbp-open'); }, {passive:true});
        });
        return;
      }

      if(isHidden()) return;

      // Manual hooks (registered first so they're always available regardless of openMode)
      window['PBP_open_{{ section.id }}'] = show;
      window['PBP_close_{{ section.id }}'] = close;

      if(openMode === 'immediate'){
        show();
      } else if(openMode === 'delay'){
        // Treat 0s as immediate so the trigger always fires
        if(delay > 0){ setTimeout(show, delay); } else { show(); }
      } else if(openMode === 'inactivity'){
        const wait = inactivity > 0 ? inactivity : 10000;
        let timer;
        const reset = ()=>{ clearTimeout(timer); timer = setTimeout(show, wait); };
        ['mousemove','keydown','scroll','click','touchstart'].forEach(ev => document.addEventListener(ev, reset, {passive:true}));
        reset();
      } else if(openMode === 'exit'){
        // When the user picks "Exit intent" we don't gate behind the separate
        // exit_intent checkbox — that checkbox stays as a fallback for other
        // open modes that want to combine. Always wire the handler here.
        const exitHandler = (e)=>{ if(e.clientY <= 8){ show(); document.removeEventListener('mousemove', exitHandler); } };
        document.addEventListener('mousemove', exitHandler, {passive:true});
      } else if(openMode === 'manual'){
        // No automatic trigger; call window.PBP_open_<section.id>() to show.
      } else if(exitIntentEnabled){
        // Backward-compat fallback if openMode is unknown but exit-intent is on.
        const exitHandler = (e)=>{ if(e.clientY <= 8){ show(); document.removeEventListener('mousemove', exitHandler); } };
        document.addEventListener('mousemove', exitHandler, {passive:true});
      }
    })();
{% comment %}{% endcomment %}  </script>
</section>


</template>

<schema>
{
  "type": "promobanner",
  "name": "Promotion Popup Discount",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "📝 Content lives in blocks below"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "align_desktop",
      "label": "Desktop alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left aligned"
        },
        {
          "value": "center",
          "label": "Center aligned"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Trigger / Display Behavior"
    },
    {
      "id": "show_as_popup",
      "type": "checkbox",
      "label": "Render as popup (modal)",
      "default": true
    },
    {
      "id": "open_mode",
      "type": "select",
      "label": "When to open",
      "default": "exit",
      "options": [
        {
          "value": "immediate",
          "label": "Immediately"
        },
        {
          "value": "delay",
          "label": "After delay"
        },
        {
          "value": "exit",
          "label": "Exit intent (desktop)"
        },
        {
          "value": "inactivity",
          "label": "Inactivity timer"
        },
        {
          "value": "manual",
          "label": "Manual (via JS)"
        }
      ]
    },
    {
      "id": "delay_s",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Delay (seconds)",
      "default": 20
    },
    {
      "id": "inactivity_s",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Inactivity duration (s)",
      "default": 10
    },
    {
      "id": "exit_intent",
      "type": "checkbox",
      "label": "Enable exit-intent detection",
      "default": true
    },
    {
      "id": "hide_days",
      "type": "range",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "day",
      "label": "Do not show again for",
      "default": 2
    },
    {
      "id": "once_per_session",
      "type": "checkbox",
      "label": "Show only once per session",
      "default": true
    },
    {
      "id": "enable_edit_mode",
      "type": "checkbox",
      "label": "Enable Edit mode (always show in Theme Editor)",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Style & Colors"
    },
    {
      "id": "card_bg",
      "type": "color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "id": "text_color",
      "type": "color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "id": "close_color",
      "type": "color",
      "label": "Close icon color",
      "default": "#111111"
    },
    {
      "id": "overlay_color",
      "type": "color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "id": "overlay_opacity",
      "type": "range",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 50
    },
    {
      "id": "radius",
      "type": "range",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Layout & Spacing"
    },
    {
      "id": "popup_width",
      "type": "range",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Popup width (desktop)",
      "default": 750
    },
    {
      "id": "popup_radius",
