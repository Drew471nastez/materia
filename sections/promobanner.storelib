  "shopify": {
    "name": "Promotion Popup Discount",
    "tag": "section",
    "class": "promo-banner-pro-wrapper",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "📝 Content lives in blocks below",
        "info": "Eyebrow, headline, body, coupon, CTA button and image are all configured per-block. Add or edit them in the Blocks panel below."
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "align_desktop",
        "label": "Desktop alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left aligned"
          },
          {
            "value": "center",
            "label": "Center aligned"
          }
        ]
      },
      {
        "type": "header",
        "content": "Trigger / Display Behavior"
      },
      {
        "id": "show_as_popup",
        "type": "checkbox",
        "label": "Render as popup (modal)",
        "default": true
      },
      {
        "id": "open_mode",
        "type": "select",
        "label": "When to open",
        "default": "exit",
        "options": [
          {
            "value": "immediate",
            "label": "Immediately"
          },
          {
            "value": "delay",
            "label": "After delay"
          },
          {
            "value": "exit",
            "label": "Exit intent (desktop)"
          },
          {
            "value": "inactivity",
            "label": "Inactivity timer"
          },
          {
            "value": "manual",
            "label": "Manual (via JS)"
          }
        ]
      },
      {
        "id": "delay_s",
        "type": "range",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "s",
        "label": "Delay (seconds)",
        "default": 20
      },
      {
        "id": "inactivity_s",
        "type": "range",
        "min": 0,
        "max": 120,
        "step": 5,
        "unit": "s",
        "label": "Inactivity duration (s)",
        "default": 10
      },
      {
        "id": "exit_intent",
        "type": "checkbox",
        "label": "Enable exit-intent detection",
        "default": true
      },
      {
        "id": "hide_days",
        "type": "range",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "day",
        "label": "Do not show again for",
        "default": 2
      },
      {
        "id": "once_per_session",
        "type": "checkbox",
        "label": "Show only once per session",
        "default": true
      },
      {
        "id": "enable_edit_mode",
        "type": "checkbox",
