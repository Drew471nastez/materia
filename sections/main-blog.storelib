      "label": "Badge text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Badge radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_width",
      "label": "Badge minimum width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_height",
      "label": "Badge height",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_vertical_position",
      "label": "Badge top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_horizontal_position",
      "label": "Badge left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_58",
      "label": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "shopify": {
    "name": "Blog posts page",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Colour scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "stretch_width"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "blog_select",
        "label": "Blog",
        "info": "The blog handle, for example news. Empty shows the blog being read."
      },
      {
        "type": "checkbox",
        "id": "show_category",
        "label": "Show category (first tag)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_date",
        "label": "Show date",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_excerpt",
        "label": "Show the start of each post",
        "default": true
      },
      {
        "type": "range",
        "id": "excerpt_lines",
        "label": "Lines of text",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 2,
        "visible_if": "{{ section.settings.show_excerpt }}"
      },
      {
        "type": "checkbox",
        "id": "show_readmore",
        "label": "Show Read more",
        "default": true
      },
      {
        "type": "text",
        "id": "readmore_text",
        "label": "Read more text",
        "default": "Read article",
        "visible_if": "{{ section.settings.show_readmore }}"
      },
      {
        "type": "text",
        "id": "empty_heading",
        "label": "Heading with no posts",
        "default": "No posts yet"
      },
      {
        "type": "richtext",
        "id": "empty_text",
        "label": "Text with no posts",
        "default": "<p>New posts show here as soon as they are published.</p>"
      },
      {
        "type": "text",
        "id": "empty_button_label",
        "label": "Button with no posts",
        "default": "Shop all products",
        "info": "Leave empty to hide the button."
      },
      {
        "type": "url",
        "id": "empty_button_url",
        "label": "Button link with no posts",
        "default": "/collections/all"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "options": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "list",
            "label": "List"
          }
        ],
        "default": "grid"
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Posts per row",
        "visible_if": "{{ section.settings.layout == 'grid' }}",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "items_to_show",
        "label": "Posts per page",
        "min": 1,
        "max": 24,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between posts",
        "visible_if": "{{ section.settings.layout == 'grid' }}",
        "min": 0,
        "max": 50,
        "step": 5,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "row_gap",
        "label": "Gap between rows",
        "min": 16,
        "max": 96,
        "step": 4,
        "default": 48,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "pagination",
        "label": "Pagination",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Page numbers"
          },
          {
            "value": "load_more_button",
            "label": "Load-more button"
          },
          {
            "value": "infinit_scrolling",
            "label": "Infinite scroll"
          }
        ]
      },
      {
        "type": "text",
        "id": "button_show_more",
        "label": "Load more button text",
        "default": "Load more",
        "visible_if": "{{ section.settings.pagination == 'load_more_button' }}"
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Picture shape",
        "options": [
          {
            "value": "adapt",
            "label": "Original"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "square"
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom shape",
        "info": "Width:height, for example 16:10",
        "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Picture corner radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Badge"
      },
      {
        "type": "text",
        "id": "blog_post_badge_reference",
        "label": "Post with a badge",
        "info": "The post handle, for example news/our-new-studio. Empty shows no badge."
      },
      {
        "type": "text",
        "id": "badge_text",
        "label": "Badge text",
        "default": "Recent",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_vertical_position",
        "label": "Badge distance from top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_horizontal_position",
        "label": "Badge distance from the side",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_width",
        "label": "Badge minimum width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_height",
        "label": "Badge height",
        "min": 20,
        "max": 100,
        "step": 5,
        "default": 40,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_border_radius",
        "label": "Badge corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 20,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_text_font_size",
        "label": "Badge text size",
        "min": 10,
        "max": 30,
        "step": 1,
        "default": 14,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off, the colours follow the colour scheme and Theme settings > Buttons. On, the colours below apply; one left empty still follows the scheme."
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "meta_color",
        "label": "Date line colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "excerpt_color",
        "label": "Text colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "badge_background_color",
        "label": "Badge background",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "color",
        "id": "badge_text_color",
        "label": "Badge text colour",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "header",
        "content": "Buttons",
        "info": "Button and Outline are the theme's own buttons: colours, border, corners, font and hover come from Theme settings > Buttons. A size, corner or colour set here overrides it."
      },
      {
        "type": "select",
        "id": "readmore_type",
        "label": "Read more style",
        "options": [
          {
            "value": "primary",
            "label": "Button"
          },
          {
            "value": "outline",
            "label": "Outline"
          },
          {
            "value": "secondary",
            "label": "Text link, line on hover"
          },
          {
            "value": "underline",
            "label": "Underlined text link"
          }
        ],
        "default": "primary",
        "visible_if": "{{ section.settings.show_readmore }}"
      },
      {
        "type": "checkbox",
        "id": "button_arrow",
        "label": "Show arrow",
        "default": true,
        "visible_if": "{{ section.settings.show_readmore }}"
      },
      {
        "type": "select",
        "id": "readmore_line",
        "label": "Link underline",
        "options": [
          {
            "value": "style",
            "label": "Follow style"
          },
          {
            "value": "none",
            "label": "None"
          }
        ],
        "default": "style",
        "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'secondary' or section.settings.readmore_type == 'underline' }}"
      },
      {
        "type": "select",
        "id": "button_size",
        "label": "Button size",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ],
        "default": "medium",
        "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button corners",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "pill",
            "label": "Pill"
          }
        ],
        "default": "theme",
        "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
      },
      {
        "type": "select",
        "id": "button_hover",
        "label": "Button hover",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "lift",
            "label": "Lift"
          },
          {
            "value": "grow",
            "label": "Grow"
          }
        ],
        "default": "theme",
        "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
      },
      {
        "type": "checkbox",
        "id": "button_full_width",
        "label": "Full width button",
        "default": false,
        "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
      },
      {
        "type": "checkbox",
        "id": "button_custom_colors",
        "label": "Use my own button colours",
        "default": false,
        "visible_if": "{{ section.settings.show_readmore and section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button colour",
        "info": "The fill of a button, the line and text of an outline, the colour of a text link",
        "visible_if": "{{ section.settings.show_readmore and section.settings.enable_custom_style and section.settings.button_custom_colors }}"
      },
      {
        "type": "color",
        "id": "button_text",
        "label": "Button text",
        "visible_if": "{{ section.settings.show_readmore and section.settings.enable_custom_style and section.settings.button_custom_colors }}"
      },
      {
        "type": "color",
        "id": "button_hover_bg",
        "label": "Hover colour",
        "visible_if": "{{ section.settings.show_readmore and section.settings.enable_custom_style and section.settings.button_custom_colors }}"
      },
      {
        "type": "color",
        "id": "button_hover_text",
        "label": "Hover text",
        "visible_if": "{{ section.settings.show_readmore and section.settings.enable_custom_style and section.settings.button_custom_colors }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Titles font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "title_size",
        "label": "Title size",
        "min": 16,
        "max": 36,
        "step": 1,
        "default": 22,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "card_entrance",
        "label": "Fade posts in as they scroll into view",
        "default": true
      },
      {
        "type": "select",
        "id": "hover_effect",
        "label": "Post on hover",
        "default": "lift_zoom",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "lift",
            "label": "Lift card"
          },
          {
            "value": "zoom",
            "label": "Zoom image"
          },
          {
            "value": "lift_zoom",
            "label": "Lift card and zoom image"
          }
        ]
      },
      {
        "type": "select",
        "id": "title_hover",
        "label": "Title on hover",
        "options": [
          {
            "value": "underline",
            "label": "Underline"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "none",
            "label": "None"
          }
        ],
        "default": "underline"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "default": 64,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "Top margin",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "Bottom margin",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Posts per row (mobile)",
        "visible_if": "{{ section.settings.layout == 'grid' }}",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 48,
        "unit": "px"
      }
    ],
    "blocks": []
  }
}
</schema>
