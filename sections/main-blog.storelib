<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign section_st = section.settings

  assign blog_handle = section_st.blog_select
  assign selected_blog = blogs[blog_handle]
  if selected_blog == blank and blog_handle.handle != blank
    assign selected_blog = blogs[blog_handle.handle]
  endif
  if selected_blog == blank
    assign selected_blog = blog
  endif

  assign image_ratio = section_st.image_ratio
  comment
    Custom shape with nothing typed: the 3:2 the cards use elsewhere, not a picture with no height.
  endcomment
  assign custom_ratio = section_st.custom_ratio | default: '3:2'
  assign content_alignment = section_st.content_alignment
  assign show_date = section_st.show_date
  assign show_excerpt = section_st.show_excerpt
  assign show_readmore = section_st.show_readmore
  assign readmore_type = section_st.readmore_type
  assign hover_effect = section_st.hover_effect

  assign layout = section_st.layout
  assign pagination = section_st.pagination
  assign section_width = section_st.section_width
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign column_gap = section_st.column_gap

  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  /* ======================================== */
  /* SECTION PADDING & MARGIN CSS VARIABLES   */
  /* ======================================== */
  --section-pt: {{ section_st.padding_top }}px;
  --section-pb: {{ section_st.padding_bottom }}px;
  --section-mt: {{ section_st.margin_top }}px;
  --section-mb: {{ section_st.margin_bottom }}px;

  /* ======================================== */
  /* COLUMN/LAYOUT VARIABLES                  */
  /* ======================================== */
  --col-gap-desktop: 6rem;
  --col-width: 24rem;

  /* ============================== */
  /* READ MORE BUTTON CSS VARIABLES */
  /* ============================== */
  --readmore-bg-color: var(--btn-primary-bg-color);
  --readmore-hover-bg-color: var(--btn-primary-hover-bg-color);
  --readmore-text-color: var(--btn-primary-color);
  --readmore-border-radius: var(--btn-radius, 4px);
  --readmore-border-weight: var(--btn-border-width, 1px);
  --readmore-border-color: var(--btn-primary-border-color, var(--btn-primary-bg-color));

  /* ============================== */
  /* BADGE CUSTOMIZATION VARIABLES */
  /* ============================== */
  --badge-vertical-position: {{ section_st.badge_vertical_position }}px;
  --badge-horizontal-position: {{ section_st.badge_horizontal_position }}px;
  --badge-width: {{ section_st.badge_width }}px;
  --badge-height: {{ section_st.badge_height }}px;
  --badge-font-size: {{ section_st.badge_text_font_size }}px;
{%- endcapture -%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};
  --col-number: {{ items_per_row_mobile }};

  {% if items_per_row > 3 %}
    --col-tablet: 3;
  {% else %}
    --col-tablet: {{ items_per_row }};
  {% endif %}

  --col-mobile: {{ items_per_row_mobile }};

  {% if column_gap < 15 %}
    --col-gap: {{ column_gap }}px;
    --col-gap-desktop: {{ column_gap }}px;
  {% else %}
    --col-gap: 15px;
    --col-gap-desktop: {{ column_gap }}px;
  {% endif %}

  {% if layout == 'grid' %}
    --row-gap: 4rem;
  {% else %}
    --row-gap: 3rem;
  {% endif %}
{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} .sec__blog-list {
    margin-top: var(--section-mt);
    margin-bottom: var(--section-mb);
  }
  #shopify-section-{{ section.id }} .read-more-button {
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .read-more-button:hover {
    color: var(--btn-primary-hover-color);
    border-color: var(--btn-primary-hover-border-color, var(--readmore-hover-bg-color));
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .read-more-button,
    #shopify-section-{{ section.id }} .blog-posts-readmore,
    #shopify-section-{{ section.id }} .blog-posts-readmore::before,
    #shopify-section-{{ section.id }} .blog-posts-readmore::after { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- liquid
  comment
    Theme first: the badge takes the scheme's primary colour and the theme's
    button text colour; a colour picked here applies only while Enable custom
    styling is on. Custom fonts reach the post titles and text through
    data-own-font, so the theme's "Use in every section" rule leaves them.
  endcomment
  assign mb_badge_bg = 'var(--color-primary)'
  assign mb_badge_text = 'var(--btn-primary-color)'
  if section_st.enable_custom_style
    capture mb_badge_bg
      render 'scheme-color', color: section_st.badge_background_color, fallback: mb_badge_bg
    endcapture
    capture mb_badge_text
      render 'scheme-color', color: section_st.badge_text_color, fallback: mb_badge_text
    endcapture
  endif
  assign mb_heading_font = ''
  assign mb_body_font = ''
  if section_st.enable_custom_fonts
    if section_st.heading_font.family != blank
      assign mb_heading_font = section_st.heading_font.family
      if section_st.heading_font.fallback_families != blank
        assign mb_heading_font = mb_heading_font | append: ', ' | append: section_st.heading_font.fallback_families
      endif
    endif
    if section_st.body_font.family != blank
      assign mb_body_font = section_st.body_font.family
      if section_st.body_font.fallback_families != blank
        assign mb_body_font = mb_body_font | append: ', ' | append: section_st.body_font.fallback_families
      endif
    endif
  endif
  assign mb_has_posts = false
  if selected_blog and selected_blog.articles.size > 0
    assign mb_has_posts = true
  endif
-%}
{%- if section_st.enable_custom_fonts -%}<style>{{ section_st.heading_font | font_face: font_display: 'swap' }}{{ section_st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
<style>
  #shopify-section-{{ section.id }} .article-badge {
    position: absolute; z-index: 2;
    top: var(--badge-vertical-position); left: var(--badge-horizontal-position);
    width: var(--badge-width); height: var(--badge-height);
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 0.4rem 0.8rem;
    font-size: var(--badge-font-size);
    border-radius: var(--badge-radius);
    background-color: var(--badge-bg) !important;
    color: var(--badge-color) !important;
  }
  #shopify-section-{{ section.id }} [data-own-font] :is(.blog-posts-title, .blog-posts-title a, .main-blog-empty__title) { font-family: var(--mbl-heading-font, var(--heading-font)); }
  #shopify-section-{{ section.id }} [data-own-font] :is(.blog-posts-content, .blog-posts-bottom, .blog-posts-readmore, .main-blog-empty__text, .main-blog-empty__text p) { font-family: var(--mbl-body-font, var(--body-font)); }
  #shopify-section-{{ section.id }} .main-blog-empty {
    width: 100%; max-width: 64rem; margin-inline: auto; padding: 56px 24px;
    border: 1px solid var(--color-border); border-radius: var(--rounded-radius, 8px);
    display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center;
  }
  #shopify-section-{{ section.id }} .main-blog-empty[data-align="left"] { align-items: flex-start; text-align: start; margin-inline: 0 auto; }
  #shopify-section-{{ section.id }} .main-blog-empty[data-align="right"] { align-items: flex-end; text-align: end; margin-inline: auto 0; }
  #shopify-section-{{ section.id }} .main-blog-empty__title { margin: 0; color: var(--color-heading); }
  #shopify-section-{{ section.id }} .main-blog-empty__text { color: var(--color-text); max-width: 46ch; }
  #shopify-section-{{ section.id }} .main-blog-empty__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .main-blog-empty [hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .main-blog-empty__action { margin-top: 8px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  @media (max-width: 767px) { #shopify-section-{{ section.id }} .main-blog-empty { padding: 40px 20px; } }
{% comment %}{% endcomment %}</style>
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__blog-list color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }} --badge-bg: {{ mb_badge_bg | strip }}; --badge-color: {{ mb_badge_text | strip }}; --badge-radius: {{ section_st.badge_border_radius }}px;{% if mb_heading_font != blank %} --mbl-heading-font: {{ mb_heading_font }};{% endif %}{% if mb_body_font != blank %} --mbl-body-font: {{ mb_body_font }};{% endif %}"
  data-lcp="main-blog"
  data-lcp-id="{{ section.id }}"
  data-lcp-settings="{{ section.settings | json | escape }}"
  {%- if section_st.enable_custom_fonts %} data-own-font{% endif %}
>
  <div class="{{ section_width }}">
    <div class="blog-grid-container flex flex-wrap gap-40 justify-between">
      {%- if mb_has_posts -%}
        {%- paginate selected_blog.articles by items_to_show -%}
          <div class="main-blog w-full">
            <div
              class="sticky top-30"
              {% if layout == 'list' %}
                style="--col-width: 48.5%;"
              {% endif %}
            >
              <div
                id="blog-articles"
                class="blog-articles {{ hover_effect }} row-gap-custom{% if layout == 'grid' %} grid grid-cols gap{% else %} flex flex-column{% endif %}{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
                style="{{ col_style | strip | strip_newlines }}"
              >
                {%- for article in selected_blog.articles -%}
                  {% comment %}
                    The post whose handle is the badge setting gets the badge.
                  {% endcomment %}
                  {% if article.handle == section_st.blog_post_badge_reference %}
                    <div style="position: relative;">
                      <div class="article-badge" data-mbl-badge>{{ section_st.badge_text }}</div>
                      {%- render 'article-card',
                        article: article,
                        show_date: show_date,
                        show_excerpt: show_excerpt,
                        show_readmore: show_readmore,
                        readmore_type: readmore_type,
                        section_width: section_width,
                        items_per_row: items_per_row,
                        items_per_row_mobile: items_per_row_mobile,
                        column_gap: column_gap,
                        image_ratio: image_ratio,
                        custom_ratio: custom_ratio,
                        pagination: pagination,
                        layout: layout,
                        scroll_animation: scroll_animation,
                        indexFor: forloop.index
                      -%}
                    </div>
                  {% else %}
                    {%- render 'article-card',
                      article: article,
                      show_date: show_date,
                      show_excerpt: show_excerpt,
                      show_readmore: show_readmore,
                      readmore_type: readmore_type,
                      section_width: section_width,
                      items_per_row: items_per_row,
                      items_per_row_mobile: items_per_row_mobile,
                      column_gap: column_gap,
                      image_ratio: image_ratio,
                      custom_ratio: custom_ratio,
                      pagination: pagination,
                      layout: layout,
                      scroll_animation: scroll_animation,
                      indexFor: forloop.index
                    -%}
                  {% endif %}
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination',
                  section_st: section_st,
                  pagination: pagination,
                  number_page: items_to_show,
                  paginate: paginate
                %}
              {% endif %}
            </div>
          </div>
        {%- endpaginate -%}

      {%- else -%}
        {%- comment -%}
          No posts yet (a Storelib blog has none): a short note in the
          creator's words and one way on, never a made-up post.
        {%- endcomment -%}
        <div class="main-blog-empty" data-main-blog-empty data-align="{{ content_alignment | default: 'center' }}">
          <h2 class="main-blog-empty__title h4"{% if section_st.empty_heading == blank %} hidden{% endif %}>{{ section_st.empty_heading | escape }}</h2>
          <div class="main-blog-empty__text"{% if section_st.empty_text == blank %} hidden{% endif %}>{{ section_st.empty_text }}</div>
          {%- liquid
            assign mb_empty_url = section_st.empty_button_url | default: routes.all_products_collection_url | default: '/collections/all'
          -%}
          <a class="main-blog-empty__action btn btn-primary" href="{{ mb_empty_url }}" data-theme-button="primary" data-sl-button{% if section_st.empty_button_label == blank %} hidden{% endif %}>{{ section_st.empty_button_label | escape }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>



{% stylesheet %}
       .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary {
      margin-top: 10px;
       font-weight: bold;

    }
  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary {
      margin-top: 10px;
      font-weight: bold;
      position: relative;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      transition: color 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary::after {
      content: "≫"; /* Right arrow */
      margin-left: 8px;
      font-size: 16px;
      transition: margin-left 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 2px;
      background-color: currentColor;
      transition: width 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary:hover::before {
      width: 100%;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary:hover::after {
      margin-left: 12px; /* Moves the arrow slightly on hover */
  }






      /* ============================= */
      /* READ MORE BUTTON STYLING      */
      /* ============================= */
      .read-more-button {
        background-color: var(--readmore-bg-color) !important;
        color: var(--readmore-text-color);
        border-radius: var(--readmore-border-radius);
        border: var(--readmore-border-weight) solid var(--readmore-border-color);
        padding: 10px 20px;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.3s, color 0.3s, border-color 0.3s;
      }
      .read-more-button:hover {
        background-color: var(--readmore-hover-bg-color);
        color: var(--readmore-text-color);
        border-color: var(--readmore-border-color);
      }

      /* =================================== */
      /* SECTION SPACING & MARGIN STYLING    */
      /* =================================== */
      .sec__blog-list {
        /* Padding from sliders */
        padding-top: var(--section-pt);
        padding-bottom: var(--section-pb);

        /* Margin from sliders */
        margin-top: var(--section-mt);
        margin-bottom: var(--section-mb);
      }

      /* Optional: Adjustments for minimal padding classes */
      .pt-min {
        padding-top: 10px; /* Adjust as needed */
      }
      .pb-min {
        padding-bottom: 10px; /* Adjust as needed */
      }

      /* ============================= */
      /* HOVER ANIMATION STYLING      */
      /* ============================= */
      .blog-articles.fade_in .article-card {
        transition: opacity 0.5s ease-in-out;
        opacity: 0;
      }
      .blog-articles.fade_in:hover .article-card {
        opacity: 1;
      }

      .blog-articles.fade_in_up .article-card {
        transform: translateY(20px);
        transition: transform 0.5s ease-in-out;
      }
      .blog-articles.fade_in_up:hover .article-card {
        transform: translateY(0);
      }

      .blog-articles.subtle_zoom_in .article-card {
        transition: transform 0.3s ease-in-out;
      }
      .blog-articles.subtle_zoom_in:hover .article-card {
        transform: scale(1.05);
      }

      .blog-articles.zoom_out .article-card {
        transition: transform 0.3s ease-in-out;
      }
      .blog-articles.zoom_out:hover .article-card {
        transform: scale(0.95);
      }

      /* ============================= */
      /* BADGE STYLING                */
      /* ============================= */
      .article-badge {
        /* Additional styles are handled inline via Liquid */
      }

      @media only screen and (max-width: 768px) {
        .sec__blog-list {
          padding: 7.5px;
        }
      }
{% endstylesheet %}

</template>

<schema>
{
  "type": "main-blog",
  "name": "Main blog",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_readmore",
      "label": "Show read more",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt (Original)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom ratio",
      "info": "Format 2:3",
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Page numbers"
        },
        {
          "value": "load_more_button",
          "label": "Load-more button"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load-more text",
      "default": "Load more",
      "visible_if": "{{ section.settings.pagination == 'load_more_button' }}"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Recent"
    },
    {
      "type": "text",
      "id": "blog_post_badge_reference",
      "label": "Badge article handle"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text"
    },
    {
      "type": "range",
      "id": "badge_text_font_size",
      "label": "Badge text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
