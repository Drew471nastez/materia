  "shopify": {
    "name": "Blog posts page",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Colour scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "stretch_width"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "blog",
        "id": "blog_select",
        "label": "Blog",
        "info": "Empty shows the blog being read."
      },
      {
        "type": "checkbox",
        "id": "show_date",
        "label": "Show date",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_excerpt",
        "label": "Show the start of each post",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_readmore",
        "label": "Show Read more",
        "default": true
      },
      {
        "type": "select",
        "id": "readmore_type",
        "label": "Read more style",
        "options": [
          {
            "value": "primary",
            "label": "Button"
          },
          {
            "value": "secondary",
            "label": "Text link"
          }
        ],
        "default": "primary",
        "visible_if": "{{ section.settings.show_readmore }}"
      },
      {
        "type": "text",
        "id": "empty_heading",
        "label": "Heading with no posts",
        "default": "No posts yet"
      },
      {
        "type": "richtext",
        "id": "empty_text",
        "label": "Text with no posts",
        "default": "<p>New posts show here as soon as they are published.</p>"
      },
      {
        "type": "text",
        "id": "empty_button_label",
        "label": "Button with no posts",
        "default": "Shop all products",
        "info": "Leave empty to hide the button."
      },
      {
        "type": "url",
        "id": "empty_button_url",
        "label": "Button link with no posts",
        "default": "/collections/all"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "options": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "list",
            "label": "List"
          }
        ],
        "default": "grid"
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Posts per row",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "items_to_show",
        "label": "Posts per page",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between posts",
        "min": 0,
        "max": 50,
        "step": 5,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "pagination",
        "label": "Pagination",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Page numbers"
          },
          {
            "value": "load_more_button",
            "label": "Load-more button"
          },
          {
            "value": "infinit_scrolling",
            "label": "Infinite scroll"
          }
        ]
      },
      {
        "type": "text",
        "id": "button_show_more",
        "label": "Load more button text",
        "default": "Load more",
        "visible_if": "{{ section.settings.pagination == 'load_more_button' }}"
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Picture shape",
        "options": [
          {
            "value": "adapt",
            "label": "Original"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "square"
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom shape",
        "info": "Width:height, for example 16:9",
        "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
      },
      {
        "type": "header",
        "content": "Badge"
      },
      {
        "type": "text",
        "id": "blog_post_badge_reference",
        "label": "Post with a badge",
        "info": "The post handle, for example news/our-new-studio. Empty shows no badge."
      },
      {
        "type": "text",
        "id": "badge_text",
        "label": "Badge text",
        "default": "Recent",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_vertical_position",
        "label": "Badge distance from top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_horizontal_position",
        "label": "Badge distance from the side",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_width",
        "label": "Badge width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_height",
        "label": "Badge height",
        "min": 20,
        "max": 100,
        "step": 5,
        "default": 40,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_border_radius",
        "label": "Badge corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 20,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "range",
        "id": "badge_text_font_size",
        "label": "Badge text size",
        "min": 10,
        "max": 30,
        "step": 1,
        "default": 14,
        "unit": "px",
        "visible_if": "{{ section.settings.blog_post_badge_reference != blank }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "badge_background_color",
        "label": "Badge background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "badge_text_color",
        "label": "Badge text colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Titles font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Text font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "Top margin",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}",
        "info": "Applies when Remove default space between sections is off."
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "Bottom margin",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Posts per row (mobile)",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      }
    ],
    "blocks": []
  }
