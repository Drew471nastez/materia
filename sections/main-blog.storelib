<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if section.settings.reset_spacing -%}
<style>
  #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section,
  .shopify-section + #shopify-section-{{ section.id }} { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- liquid
  assign section_st = section.settings

  assign blog_handle = section_st.blog_select
  assign selected_blog = blogs[blog_handle]
  if selected_blog == blank and blog_handle.handle != blank
    assign selected_blog = blogs[blog_handle.handle]
  endif
  if selected_blog == blank
    assign selected_blog = blog
  endif

  assign image_ratio = section_st.image_ratio
  assign custom_ratio = section_st.custom_ratio
  assign content_alignment = section_st.content_alignment | default: 'left'
  assign show_date = section_st.show_date
  assign show_excerpt = section_st.show_excerpt
  assign show_readmore = section_st.show_readmore
  assign readmore_type = section_st.readmore_type
  assign hover_effect = section_st.hover_effect | default: 'lift_zoom'

  assign layout = section_st.layout
  assign pagination = section_st.pagination
  assign section_width = section_st.section_width
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign column_gap = section_st.column_gap

  assign scroll_animation = settings.scroll_animation
-%}

{%- case image_ratio -%}
  {%- when 'square' -%}{%- assign mb_ratio = '1 / 1' -%}
  {%- when 'portrait' -%}{%- assign mb_ratio = '3 / 4' -%}
  {%- when 'landscape' -%}{%- assign mb_ratio = '4 / 3' -%}
  {%- when 'custom' -%}{%- assign mb_ratio = custom_ratio | default: '16:10' | replace: ':', ' / ' -%}
  {%- else -%}{%- assign mb_ratio = 'auto' -%}
{%- endcase -%}
{%- liquid
  comment
    Theme first: the badge, the post titles, the date line, the excerpt and
    the Read more button follow the colour scheme and Theme settings >
    Buttons. A colour picked here applies only while Enable custom styling is
    on. Custom fonts reach the titles and text through data-own-font, so the
    theme's "Use in every section" rule leaves them.
  endcomment
  assign mb_custom = section_st.enable_custom_style
  assign btn_custom = false
  if mb_custom and section_st.button_custom_colors
    assign btn_custom = true
  endif
  assign mb_btn_kind = readmore_type | default: 'primary'
  assign mb_theme_btn = ''
  if mb_btn_kind == 'primary'
    assign mb_theme_btn = 'primary'
  elsif mb_btn_kind == 'outline'
    assign mb_theme_btn = 'secondary'
  endif

  assign mb_badge_bg = 'var(--color-primary)'
  assign mb_badge_text = 'var(--btn-primary-color)'
  assign mb_title_c = 'none'
  assign mb_meta_c = 'none'
  assign mb_excerpt_c = 'none'
  assign mb_link_c = 'none'
  assign mb_link_hover_c = 'none'
  if mb_custom
    capture mb_badge_bg
      render 'scheme-color', color: section_st.badge_background_color, fallback: mb_badge_bg
    endcapture
    capture mb_badge_text
      render 'scheme-color', color: section_st.badge_text_color, fallback: mb_badge_text
    endcapture
    capture mb_title_c
      render 'scheme-color', color: section_st.title_color, fallback: 'none'
    endcapture
    capture mb_meta_c
      render 'scheme-color', color: section_st.meta_color, fallback: 'none'
    endcapture
    capture mb_excerpt_c
      render 'scheme-color', color: section_st.excerpt_color, fallback: 'none'
    endcapture
  endif
  if btn_custom
    capture mb_link_c
      render 'scheme-color', color: section_st.button_bg, fallback: 'none'
    endcapture
    capture mb_link_hover_c
      render 'scheme-color', color: section_st.button_hover_text, fallback: 'none'
    endcapture
  endif
  assign mb_badge_bg = mb_badge_bg | strip
  assign mb_badge_text = mb_badge_text | strip
  assign mb_title_c = mb_title_c | strip | remove: 'none'
  assign mb_meta_c = mb_meta_c | strip | remove: 'none'
  assign mb_excerpt_c = mb_excerpt_c | strip | remove: 'none'
  assign mb_link_c = mb_link_c | strip | remove: 'none'
  assign mb_link_hover_c = mb_link_hover_c | strip | remove: 'none'

  assign mb_heading_font = ''
  assign mb_body_font = ''
  if section_st.enable_custom_fonts
    if section_st.heading_font.family != blank
      assign mb_heading_font = section_st.heading_font.family
      if section_st.heading_font.fallback_families != blank
        assign mb_heading_font = mb_heading_font | append: ', ' | append: section_st.heading_font.fallback_families
      endif
    endif
    if section_st.body_font.family != blank
      assign mb_body_font = section_st.body_font.family
      if section_st.body_font.fallback_families != blank
        assign mb_body_font = mb_body_font | append: ', ' | append: section_st.body_font.fallback_families
      endif
    endif
  endif

  assign mb_has_posts = false
  if selected_blog and selected_blog.articles.size > 0
    assign mb_has_posts = true
  endif
  assign mb_badge_ref = section_st.blog_post_badge_reference | split: '/' | last
-%}
{%- capture mb_btn_override -%}
  {%- if btn_custom -%}
    {%- render 'button-overrides', bg: section_st.button_bg, text: section_st.button_text, hover_bg: section_st.button_hover_bg, hover_text: section_st.button_hover_text -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign mb_btn_override = mb_btn_override | strip -%}
{%- capture col_style -%}
  --mb-ratio: {{ mb_ratio }};
  --mb-title-size: {{ section_st.title_size | default: 22 }}px;
  --mb-lines: {{ section_st.excerpt_lines | default: 2 }};
  {% if mb_title_c != blank %}--mb-title: {{ mb_title_c }};{% endif %}
  {% if mb_meta_c != blank %}--mb-meta: {{ mb_meta_c }};{% endif %}
  {% if mb_excerpt_c != blank %}--mb-excerpt: {{ mb_excerpt_c }};{% endif %}
  --col-desktop: {{ items_per_row }};
  --col-number: {{ items_per_row_mobile }};
  {% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
  --col-mobile: {{ items_per_row_mobile }};
  {% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;{% endif %}
  --col-gap-desktop: {{ column_gap }}px;
  --row-gap: {{ section_st.row_gap | default: 48 }}px;
  {% if mb_link_c != blank %}--mbl-link: {{ mb_link_c }};{% else %}--mbl-link: var(--mb-title, currentColor);{% endif %}
  {% if mb_link_hover_c != blank %}--mbl-link-hover: {{ mb_link_hover_c }};{% else %}--mbl-link-hover: var(--mbl-link);{% endif %}
{%- endcapture -%}
{%- capture root_style -%}
  --mb-align: {{ content_alignment }};
  --mb-img-radius: {{ section_st.image_radius | default: 8 }}px;
  --mb-pt: {{ section_st.padding_top | default: 0 }}px;
  --mb-pb: {{ section_st.padding_bottom | default: 64 }}px;
  --mb-pt-m: {{ section_st.padding_top_mobile | default: 0 }}px;
  --mb-pb-m: {{ section_st.padding_bottom_mobile | default: 48 }}px;
  --section-mt: {{ section_st.margin_top | default: 0 }}px;
  --section-mb: {{ section_st.margin_bottom | default: 0 }}px;
  --badge-vertical-position: {{ section_st.badge_vertical_position }}px;
  --badge-horizontal-position: {{ section_st.badge_horizontal_position }}px;
  --badge-width: {{ section_st.badge_width }}px;
  --badge-height: {{ section_st.badge_height }}px;
  --badge-font-size: {{ section_st.badge_text_font_size }}px;
  --badge-radius: {{ section_st.badge_border_radius }}px;
  --badge-bg: {{ mb_badge_bg }};
  --badge-color: {{ mb_badge_text }};
  {% if mb_heading_font != blank %}--mbl-heading-font: {{ mb_heading_font }};{% endif %}
  {% if mb_body_font != blank %}--mbl-body-font: {{ mb_body_font }};{% endif %}
{%- endcapture -%}
{%- if section_st.enable_custom_fonts -%}<style>{{ section_st.heading_font | font_face: font_display: 'swap' }}{{ section_st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}


<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; font-weight: var(--body-weight, inherit); }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) { font-weight: var(--heading-weight, inherit); }

  #shopify-section-{{ section.id }} > .sec__blog-list.mb-root {
    --mb-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    padding-top: var(--mb-pt, 0px) !important;
    padding-bottom: var(--mb-pb, 64px) !important;
    margin-top: var(--section-mt, 0px) !important;
    margin-bottom: var(--section-mb, 0px) !important;
  }
  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} > .sec__blog-list.mb-root {
      padding-top: var(--mb-pt-m, 0px) !important;
      padding-bottom: var(--mb-pb-m, 48px) !important;
    }
    #shopify-section-{{ section.id }} .mb-card .mb-card__title { font-size: clamp(16px, calc(var(--mb-title-size) * 0.85), var(--mb-title-size)); }
    #shopify-section-{{ section.id }} .mb-list--grid[style*="--col-mobile: 2"] .mb-card__excerpt,
    #shopify-section-{{ section.id }} .mb-list--grid[style*="--col-mobile: 3"] .mb-card__excerpt { font-size: 14px; }
  }
  @media (hover: none) {
    #shopify-section-{{ section.id }} .blog-articles.mb-list .mb-card:hover,
    #shopify-section-{{ section.id }} .blog-articles.mb-list .mb-card:hover .mb-card__media img { transform: none; }
  }

  #shopify-section-{{ section.id }} .blog-articles { row-gap: var(--row-gap); }
  #shopify-section-{{ section.id }} .blog-articles > * { min-width: 0; position: relative; }
  #shopify-section-{{ section.id }} .mb-list { display: grid; grid-template-columns: repeat(var(--col-mobile, 1), minmax(0, 1fr)); column-gap: min(var(--col-gap-desktop), 20px); row-gap: var(--row-gap); }
  #shopify-section-{{ section.id }} .mb-list--list { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .mb-list--grid { grid-template-columns: repeat(var(--col-tablet), minmax(0, 1fr)); column-gap: var(--col-gap-desktop); }
    #shopify-section-{{ section.id }} .mb-list--list .mb-card { flex-direction: row; align-items: center; gap: 40px; }
    #shopify-section-{{ section.id }} .mb-list--list .mb-card__media { flex: 0 0 42%; }
    #shopify-section-{{ section.id }} .mb-list--list .mb-card__body { padding-top: 0; }
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }} .mb-list--grid { grid-template-columns: repeat(var(--col-desktop), minmax(0, 1fr)); }
  }
  #shopify-section-{{ section.id }} .mb-card { position: relative; display: flex; flex-direction: column; height: 100%; text-align: var(--mb-align); transition: transform 0.45s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-card__media { position: relative; display: block; overflow: hidden; aspect-ratio: var(--mb-ratio, 16 / 10); border-radius: var(--mb-img-radius); background: rgba(127, 127, 127, 0.12); isolation: isolate; }
  #shopify-section-{{ section.id }} .mb-card__media--adapt { aspect-ratio: auto; }
  #shopify-section-{{ section.id }} .mb-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform 0.8s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-card__media--adapt img { height: auto; }
  #shopify-section-{{ section.id }} .mb-card__ph { display: block; width: 100%; height: 100%; min-height: 160px; }
  #shopify-section-{{ section.id }} .mb-card__body { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1; padding-top: 20px; }
  #shopify-section-{{ section.id }} .mb-align--center .mb-card__body { align-items: center; }
  #shopify-section-{{ section.id }} .mb-align--right .mb-card__body { align-items: flex-end; }
  #shopify-section-{{ section.id }} .mb-card__meta { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; line-height: 1.4; color: var(--mb-meta, color-mix(in srgb, currentColor 64%, transparent)); }
  #shopify-section-{{ section.id }} .mb-card__cat { font-weight: 500; color: var(--mb-title, currentColor); }
  #shopify-section-{{ section.id }} .mb-card .mb-card__title { margin: 4px 0 0; font-size: var(--mb-title-size); line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; color: var(--mb-title, inherit); text-wrap: pretty; }
  #shopify-section-{{ section.id }} .mb-card__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .mb-card__title a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  #shopify-section-{{ section.id }} .mb-card__title span { background-image: linear-gradient(currentColor, currentColor); background-size: 0 1px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 0.4s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-card:hover .mb-card__title span { background-size: 100% 1px; }
  #shopify-section-{{ section.id }} .mb-card__excerpt { margin: 0; font-size: 16px; line-height: 1.6; color: var(--mb-excerpt, color-mix(in srgb, currentColor 66%, transparent)); display: -webkit-box; -webkit-line-clamp: var(--mb-lines); -webkit-box-orient: vertical; overflow: hidden; }
  #shopify-section-{{ section.id }} .mb-card__foot { position: relative; z-index: 2; margin-top: auto; padding-top: 8px; max-width: 100%; }
  #shopify-section-{{ section.id }} .mb-btn-full .mb-card__foot:has(.mb-btn--primary, .mb-btn--outline) { align-self: stretch; }
  #shopify-section-{{ section.id }} .mb-btn-full :is(.mb-btn--primary, .mb-btn--outline) { width: 100%; }
  #shopify-section-{{ section.id }} .mb-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box; max-width: 100%; min-height: 44px; text-decoration: none; cursor: pointer; }
  #shopify-section-{{ section.id }} a.mb-btn:is(:link, :visited, :hover, :active, :focus) { text-decoration: none; }
  #shopify-section-{{ section.id }} .mb-btn-size--small[data-theme-button] { min-height: 44px; padding-inline: 16px; font-size: 14px; }
  #shopify-section-{{ section.id }} .mb-btn-size--large[data-theme-button] { min-height: 56px; padding-inline: 30px; font-size: 17px; }
  #shopify-section-{{ section.id }} .mb-btn-shape--square[data-theme-button] { border-radius: 0; }
  #shopify-section-{{ section.id }} .mb-btn-shape--rounded[data-theme-button] { border-radius: 8px; }
  #shopify-section-{{ section.id }} .mb-btn-shape--pill[data-theme-button] { border-radius: 999px; }
  #shopify-section-{{ section.id }} :is(.mb-btn--secondary, .mb-btn--underline) { padding: 0; border: 0; border-radius: 0; background: transparent; font-family: inherit; font-size: var(--btn-font-size, 15px); font-weight: 600; line-height: 1.2; letter-spacing: var(--btn-letter-spacing, normal); text-transform: var(--btn-text-transform, none); color: var(--mbl-link); transition: color var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)); }
  #shopify-section-{{ section.id }} :is(.mb-btn--secondary, .mb-btn--underline):hover { color: var(--mbl-link-hover); }
  #shopify-section-{{ section.id }} :is(.mb-btn--secondary, .mb-btn--underline) .mb-btn__label { position: relative; }
  #shopify-section-{{ section.id }} :is(.mb-btn--secondary, .mb-btn--underline) .mb-btn__label::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--mb-ease), opacity 0.35s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-btn--secondary:hover .mb-btn__label::after,
  #shopify-section-{{ section.id }} .mb-card:hover .mb-btn--secondary .mb-btn__label::after { transform: scaleX(1); }
  #shopify-section-{{ section.id }} .mb-btn--underline .mb-btn__label::after { transform: scaleX(1); opacity: 0.35; }
  #shopify-section-{{ section.id }} .mb-btn--underline:hover .mb-btn__label::after,
  #shopify-section-{{ section.id }} .mb-card:hover .mb-btn--underline .mb-btn__label::after { opacity: 1; }
  #shopify-section-{{ section.id }} .mb-btn__arrow { display: inline-flex; flex: none; transition: transform 0.3s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-btn__arrow[hidden] { display: none; }
  #shopify-section-{{ section.id }} .mb-btn__arrow svg { display: block; width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .mb-btn:hover .mb-btn__arrow,
  #shopify-section-{{ section.id }} .mb-card:hover .mb-btn__arrow { transform: translateX(4px); }
  #shopify-section-{{ section.id }} :is(.mb-btn-hover--lift, .mb-btn-hover--grow) [data-theme-button] { transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)), background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, var(--mb-ease)); }
  #shopify-section-{{ section.id }} .mb-btn-hover--lift [data-theme-button]:hover { transform: translateY(-2px); box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.35); }
  #shopify-section-{{ section.id }} .mb-btn-hover--grow [data-theme-button]:hover { transform: scale(1.03); }
  #shopify-section-{{ section.id }} .mb-hover--lift .mb-card:hover,
  #shopify-section-{{ section.id }} .mb-hover--lift_zoom .mb-card:hover { transform: translateY(-4px); }
  #shopify-section-{{ section.id }} .mb-hover--zoom .mb-card:hover .mb-card__media img,
  #shopify-section-{{ section.id }} .mb-hover--lift_zoom .mb-card:hover .mb-card__media img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .mb-card:has(.mb-card__title a:focus-visible) .mb-card__media { outline: 2px solid currentColor; outline-offset: 3px; }
  #shopify-section-{{ section.id }} .article-card { height: 100%; text-align: var(--mb-align); transition: transform 0.4s var(--mb-ease); }
  #shopify-section-{{ section.id }} .article-card :where(a, div, figure):has(> img) { overflow: hidden; border-radius: var(--mb-img-radius); }
  #shopify-section-{{ section.id }} .article-card img { border-radius: var(--mb-img-radius); transition: transform 0.7s var(--mb-ease); will-change: transform; }
  #shopify-section-{{ section.id }} .article-card :is(h2, h3, h4) a { text-decoration: none; background-image: linear-gradient(currentColor, currentColor); background-size: 0 1px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 0.35s var(--mb-ease); }
  #shopify-section-{{ section.id }} .article-card:hover :is(h2, h3, h4) a { background-size: 100% 1px; }
  #shopify-section-{{ section.id }} .mb-card__title a:is(:hover, :focus, :active, :visited) { text-decoration: none; }
  #shopify-section-{{ section.id }} :is(.mb-title-hover--none, .mb-title-hover--fade) .mb-card__title span,
  #shopify-section-{{ section.id }} :is(.mb-title-hover--none, .mb-title-hover--fade) .article-card :is(h2, h3, h4) a { background-image: none; }
  #shopify-section-{{ section.id }} .mb-title-hover--fade .mb-card__title span { transition: opacity 0.35s var(--mb-ease); }
  #shopify-section-{{ section.id }} .mb-title-hover--fade .mb-card:hover .mb-card__title span,
  #shopify-section-{{ section.id }} .mb-title-hover--fade .article-card:hover :is(h2, h3, h4) a { opacity: 0.65; }
  #shopify-section-{{ section.id }} .mb-link-line--none .mb-btn__label::after { content: none; display: none; }

  #shopify-section-{{ section.id }} .mb-hover--lift .article-card:hover,
  #shopify-section-{{ section.id }} .mb-hover--lift_zoom .article-card:hover { transform: translateY(-4px); }
  #shopify-section-{{ section.id }} .mb-hover--zoom .article-card:hover img,
  #shopify-section-{{ section.id }} .mb-hover--lift_zoom .article-card:hover img { transform: scale(1.04); }

  @keyframes mbCardIn { from { opacity: 0; translate: 0 24px; } to { opacity: 1; translate: 0 0; } }
  #shopify-section-{{ section.id }} .mb-enter > * { animation: mbCardIn 0.7s var(--mb-ease) both; animation-delay: calc(var(--mb-i, 0) * 80ms); }
  #shopify-section-{{ section.id }} .mb-enter > :nth-child(2) { --mb-i: 1; }
  #shopify-section-{{ section.id }} .mb-enter > :nth-child(3) { --mb-i: 2; }
  #shopify-section-{{ section.id }} .mb-enter > :nth-child(4) { --mb-i: 3; }
  #shopify-section-{{ section.id }} .mb-enter > :nth-child(5) { --mb-i: 4; }
  #shopify-section-{{ section.id }} .mb-enter > :nth-child(n+6) { --mb-i: 5; }
  @supports (animation-timeline: view()) {
    #shopify-section-{{ section.id }} .mb-enter > * { animation-timeline: view(); animation-range: entry 0% entry 35%; animation-delay: 0s; }
  }

  #shopify-section-{{ section.id }} .mb-badge {
    position: absolute; z-index: 2;
    top: var(--badge-vertical-position); left: var(--badge-horizontal-position);
    min-width: var(--badge-width); height: var(--badge-height);
    padding: 0 12px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--badge-bg); color: var(--badge-color);
    border-radius: var(--badge-radius);
    font-size: var(--badge-font-size); font-weight: 600; line-height: 1; letter-spacing: 0.02em;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .mb-badge[hidden] { display: none; }

  #shopify-section-{{ section.id }} [data-own-font] :is(.mb-card__title, .mb-card__title a, .main-blog-empty__title) { font-family: var(--mbl-heading-font, var(--heading-font)); }
  #shopify-section-{{ section.id }} [data-own-font] :is(.mb-card__meta, .mb-card__excerpt, .mb-btn, .main-blog-empty__text, .main-blog-empty__text p) { font-family: var(--mbl-body-font, var(--body-font)); }

  #shopify-section-{{ section.id }} .main-blog-empty {
    width: 100%; max-width: 64rem; margin-inline: auto; padding: 56px 24px;
    border: 1px solid var(--color-border); border-radius: var(--rounded-radius, 8px);
    display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center;
  }
  #shopify-section-{{ section.id }} .main-blog-empty[data-align="left"] { align-items: flex-start; text-align: start; margin-inline: 0 auto; }
  #shopify-section-{{ section.id }} .main-blog-empty[data-align="right"] { align-items: flex-end; text-align: end; margin-inline: auto 0; }
  #shopify-section-{{ section.id }} .main-blog-empty__title { margin: 0; color: var(--color-heading); }
  #shopify-section-{{ section.id }} .main-blog-empty__text { color: var(--color-text); max-width: 46ch; }
  #shopify-section-{{ section.id }} .main-blog-empty__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .main-blog-empty [hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .main-blog-empty__action { margin-top: 8px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  @media (max-width: 767px) { #shopify-section-{{ section.id }} .main-blog-empty { padding: 40px 20px; } }

  #shopify-section-{{ section.id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .blog-articles > *,
    #shopify-section-{{ section.id }} .article-card,
    #shopify-section-{{ section.id }} .article-card img,
    #shopify-section-{{ section.id }} .mb-card,
    #shopify-section-{{ section.id }} .mb-card__media img,
    #shopify-section-{{ section.id }} .mb-card__title span,
    #shopify-section-{{ section.id }} .mb-btn,
    #shopify-section-{{ section.id }} .mb-btn__arrow,
    #shopify-section-{{ section.id }} .mb-btn__label::after { animation: none !important; transition: none !important; transform: none !important; }
  }
{% comment %}{% endcomment %}</style>

<div
  class="section sec__blog-list mb-root color-{{ color_scheme }} gradient"
  style="{{ root_style | strip | strip_newlines }}"
  data-lcp="main-blog"
  data-lcp-id="{{ section.id }}"
  data-lcp-settings="{{ section.settings | json | escape }}"
  {%- if section_st.enable_custom_fonts %} data-own-font{% endif %}
>
  <div class="{{ section_width }}">
    <div class="blog-grid-container flex flex-wrap gap-40 justify-between">
      {%- if mb_has_posts -%}
        {%- paginate selected_blog.articles by items_to_show -%}
          <div class="main-blog w-full">
            <div{% if layout == 'list' %} style="--col-width: 48.5%;"{% endif %}>
              <div
                id="blog-articles"
                class="blog-articles mb-list mb-list--{{ layout }} mb-align--{{ content_alignment }} mb-hover--{{ hover_effect }} mb-btn-hover--{{ section_st.button_hover | default: 'theme' }} mb-title-hover--{{ section_st.title_hover | default: 'underline' }} mb-link-line--{{ section_st.readmore_line | default: 'style' }}{% if section_st.button_full_width %} mb-btn-full{% endif %}{% if section_st.card_entrance %} mb-enter{% endif %}{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
                style="{{ col_style | strip | strip_newlines }}"
              >
                {%- for article in selected_blog.articles -%}
                  {%- assign mb_handle = article.handle | split: '/' | last -%}
                  {%- assign mb_cat = article.tags | first -%}
                  {%- assign mb_excerpt = article.excerpt | default: article.content | strip_html | strip | truncatewords: 40 -%}
                  <article class="mb-card">
                    <a class="mb-card__media{% if image_ratio == 'adapt' %} mb-card__media--adapt{% endif %}" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                      {%- if mb_badge_ref != blank and mb_handle == mb_badge_ref -%}
                        <span class="mb-badge" data-mbl-badge{% if section_st.badge_text == blank %} hidden{% endif %}>{{ section_st.badge_text }}</span>
                      {%- endif -%}
                      {%- if article.image -%}
                        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}"{% if forloop.index > 3 %} loading="lazy"{% endif %} decoding="async">
                      {%- else -%}
                        <span class="mb-card__ph"></span>
                      {%- endif -%}
                    </a>
                    <div class="mb-card__body">
                      {%- assign mb_show_cat = false -%}
                      {%- if section_st.show_category and mb_cat != blank -%}{%- assign mb_show_cat = true -%}{%- endif -%}
                      {%- if mb_show_cat or show_date -%}
                        <p class="mb-card__meta">
                          {%- if mb_show_cat -%}<span class="mb-card__cat">{{ mb_cat }}</span>{%- endif -%}
                          {%- if mb_show_cat and show_date -%}<span class="mb-card__dot" aria-hidden="true">&middot;</span>{%- endif -%}
                          {%- if show_date -%}<time class="mb-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %-d, %Y' }}</time>{%- endif -%}
                        </p>
                      {%- endif -%}
                      <h3 class="mb-card__title"><a href="{{ article.url }}"><span>{{ article.title | escape }}</span></a></h3>
                      {%- if show_excerpt and mb_excerpt != blank -%}
                        <p class="mb-card__excerpt">{{ mb_excerpt }}</p>
                      {%- endif -%}
                      {%- if show_readmore -%}
                        {%- assign mb_rm_text = section_st.readmore_text | default: 'Read article' -%}
                        <div class="mb-card__foot">
                          <a class="mb-btn mb-btn--{{ mb_btn_kind }}{% if mb_theme_btn != blank %} mb-btn-size--{{ section_st.button_size | default: 'medium' }} mb-btn-shape--{{ section_st.button_shape | default: 'theme' }}{% endif %}"{% if mb_theme_btn != blank %} data-theme-button="{{ mb_theme_btn }}" data-sl-button{% if mb_btn_override != blank %} style="{{ mb_btn_override }}"{% endif %}{% endif %} href="{{ article.url }}" aria-label="{{ mb_rm_text | escape }}: {{ article.title | escape }}" data-mbl-title="{{ article.title | escape }}"><span class="mb-btn__label">{{ mb_rm_text }}</span><span class="mb-btn__arrow" aria-hidden="true"{% unless section_st.button_arrow %} hidden{% endunless %}><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
                        </div>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination',
                  section_st: section_st,
                  pagination: pagination,
                  number_page: items_to_show,
                  paginate: paginate
                %}
              {% endif %}
            </div>
          </div>
        {%- endpaginate -%}
      {%- else -%}
        {%- comment -%}
          No posts yet (a Storelib blog has none): a short note in the
          creator's words and one way on, never a made-up post.
        {%- endcomment -%}
        <div class="main-blog-empty" data-main-blog-empty data-align="{{ content_alignment | default: 'center' }}">
          <h2 class="main-blog-empty__title h4"{% if section_st.empty_heading == blank %} hidden{% endif %}>{{ section_st.empty_heading | escape }}</h2>
          <div class="main-blog-empty__text"{% if section_st.empty_text == blank %} hidden{% endif %}>{{ section_st.empty_text }}</div>
          {%- liquid
            assign mb_empty_url = section_st.empty_button_url | default: routes.all_products_collection_url | default: '/collections/all'
          -%}
          <a class="main-blog-empty__action btn btn-primary" href="{{ mb_empty_url }}" data-theme-button="primary" data-sl-button{% if section_st.empty_button_label == blank %} hidden{% endif %}>{{ section_st.empty_button_label | escape }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "main-blog",
  "name": "Blog posts",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Articles per row (desktop)",
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Articles per row (mobile)",
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "visible_if": "{{ section.settings.layout == 'grid' }}",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "blog_select",
      "label": "Blog handle",
      "info": "Leave empty to show the blog this page belongs to"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Articles per page",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Page numbers"
        },
        {
          "value": "load_more_button",
          "label": "Load-more button"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load-more text",
      "default": "Load more",
      "visible_if": "{{ section.settings.pagination == 'load_more_button' }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Article cards"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt (Original)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom ratio",
      "info": "Format 2:3",
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "default": "lift_zoom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift card"
        },
        {
          "value": "zoom",
          "label": "Zoom image"
        },
        {
          "value": "lift_zoom",
          "label": "Lift card and zoom image"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "card_entrance",
      "label": "Fade cards in as they scroll into view",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Card text"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category (first tag)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "select",
      "id": "title_hover",
      "label": "Title hover",
      "options": [
        {
          "value": "underline",
          "label": "Line slides in under the title"
        },
        {
          "value": "fade",
          "label": "Title fades, no underline"
        },
        {
          "value": "none",
          "label": "Normal, no underline"
        }
      ],
      "default": "underline"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 36,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_lines",
      "label": "Excerpt lines",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.show_excerpt }}"
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Read more button"
    },
    {
      "type": "checkbox",
      "id": "show_readmore",
      "label": "Show read more",
      "default": true
    },
    {
      "type": "text",
      "id": "readmore_text",
      "label": "Button text",
      "default": "Read article",
      "visible_if": "{{ section.settings.show_readmore }}"
    },
    {
      "type": "select",
      "id": "readmore_type",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Filled button"
        },
        {
          "value": "outline",
          "label": "Outline button"
        },
        {
          "value": "secondary",
          "label": "Text link, line on hover"
        },
        {
          "value": "underline",
          "label": "Underlined text link"
        }
      ],
      "default": "primary",
      "visible_if": "{{ section.settings.show_readmore }}"
    },
    {
      "type": "checkbox",
      "id": "button_arrow",
      "label": "Show arrow",
      "default": true,
      "visible_if": "{{ section.settings.show_readmore }}"
    },
    {
      "type": "select",
      "id": "readmore_line",
      "label": "Link underline",
      "options": [
        {
          "value": "style",
          "label": "Follow the button style"
        },
        {
          "value": "none",
          "label": "No underline"
        }
      ],
      "default": "style",
      "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'secondary' or section.settings.readmore_type == 'underline' }}"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
    },
    {
      "type": "select",
      "id": "button_shape",
      "label": "Button corners",
      "options": [
        {
          "value": "theme",
          "label": "Follow theme buttons"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "pill",
          "label": "Pill"
        }
      ],
      "default": "theme",
      "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
    },
    {
      "type": "select",
      "id": "button_hover",
      "label": "Button hover",
      "options": [
        {
          "value": "theme",
          "label": "Theme hover"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "grow",
          "label": "Grow"
        }
      ],
      "default": "theme",
      "visible_if": "{{ section.settings.show_readmore and section.settings.readmore_type == 'primary' or section.settings.readmore_type == 'outline' }}"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Full width button",
      "default": false,
