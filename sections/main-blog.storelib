      "visible_if": "{{ section.settings.button_custom_colors }}"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "visible_if": "{{ section.settings.button_custom_colors }}"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Hover colour",
      "visible_if": "{{ section.settings.button_custom_colors }}"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Hover text",
      "visible_if": "{{ section.settings.button_custom_colors }}"
    },
    {
      "type": "header",
      "id": "hdr_42",
      "label": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",
      "info": "Leave empty to follow the colour scheme"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Date line colour",
      "info": "Leave empty to follow the colour scheme"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt colour",
      "info": "Leave empty to follow the colour scheme"
    },
    {
      "type": "header",
      "id": "hdr_47",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Recent"
    },
    {
      "type": "text",
      "id": "blog_post_badge_reference",
