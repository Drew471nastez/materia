<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign section_st = section.settings

  assign blog_handle = section_st.blog_select
  assign selected_blog = blogs[blog_handle]

  assign image_ratio = section_st.image_ratio
  assign custom_ratio = section_st.custom_ratio
  assign content_alignment = section_st.content_alignment
  assign show_date = section_st.show_date
  assign show_excerpt = section_st.show_excerpt
  assign show_readmore = section_st.show_readmore
  assign readmore_type = section_st.readmore_type
  assign hover_effect = section_st.hover_effect

  assign layout = section_st.layout
  assign pagination = section_st.pagination
  assign section_width = section_st.section_width
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign column_gap = section_st.column_gap

  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  /* ======================================== */
  /* SECTION PADDING & MARGIN CSS VARIABLES   */
  /* ======================================== */
  --section-pt: {{ section_st.padding_top }}px;
  --section-pb: {{ section_st.padding_bottom }}px;
  --section-mt: {{ section_st.margin_top }}px;
  --section-mb: {{ section_st.margin_bottom }}px;

  /* ======================================== */
  /* COLUMN/LAYOUT VARIABLES                  */
  /* ======================================== */
  --col-gap-desktop: 6rem;
  --col-width: 24rem;

  /* ============================== */
  /* READ MORE BUTTON CSS VARIABLES */
  /* ============================== */
  --readmore-bg-color: {{ section_st.readmore_bg_color | default: '#007bff' }};
  --readmore-hover-bg-color: {{ section_st.readmore_hover_bg_color | default: '#0056b3' }};
  --readmore-text-color: {{ section_st.readmore_text_color | default: '#ffffff' }};
  --readmore-border-radius: {{ section_st.readmore_border_radius | default: 4 }}px;
  --readmore-border-weight: {{ section_st.readmore_border_weight | default: 2 }}px;
  --readmore-border-color: {{ section_st.readmore_border_color | default: '#007bff' }};

  /* ============================== */
  /* BADGE CUSTOMIZATION VARIABLES */
  /* ============================== */
  --badge-vertical-position: {{ section_st.badge_vertical_position }}px;
  --badge-horizontal-position: {{ section_st.badge_horizontal_position }}px;
  --badge-width: {{ section_st.badge_width }}px;
  --badge-height: {{ section_st.badge_height }}px;
  --badge-font-size: {{ section_st.badge_text_font_size }}px;
{%- endcapture -%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};
  --col-number: {{ items_per_row_mobile }};

  {% if items_per_row > 3 %}
    --col-tablet: 3;
  {% else %}
    --col-tablet: {{ items_per_row }};
  {% endif %}

  --col-mobile: {{ items_per_row_mobile }};

  {% if column_gap < 15 %}
    --col-gap: {{ column_gap }}px;
    --col-gap-desktop: {{ column_gap }}px;
  {% else %}
    --col-gap: 15px;
    --col-gap-desktop: {{ column_gap }}px;
  {% endif %}

  {% if layout == 'grid' %}
    --row-gap: 4rem;
  {% else %}
    --row-gap: 3rem;
  {% endif %}
{%- endcapture -%}

<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__blog-list"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="blog-grid-container flex flex-wrap gap-40 justify-between">
      {%- if selected_blog and selected_blog.articles.size > 0 -%}
        {%- paginate selected_blog.articles by items_to_show -%}
          <div class="main-blog w-full">
            <div
              class="sticky top-30"
              {% if layout == 'list' %}
                style="--col-width: 48.5%;"
              {% endif %}
            >
              <div
                id="blog-articles"
                class="blog-articles {{ hover_effect }} row-gap-custom{% if layout == 'grid' %} grid grid-cols gap{% else %} flex flex-column{% endif %}{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
                style="{{ col_style | strip | strip_newlines }}"
              >
                {%- for article in selected_blog.articles -%}
                  {% comment %}
                    We wrap the article-card in a conditional:
                    If the article.handle == the user’s badge reference setting,
                    we show the badge. Otherwise, just render normally.
                  {% endcomment %}
                  {% if article.handle == section_st.blog_post_badge_reference %}
                    <div style="position: relative;">
                      <div
                        class="article-badge"
                        style="
                                                background-color: {{ section_st.badge_background_color }} !important;
                                                color: {{ section_st.badge_text_color }} !important;
                                                border-radius: {{ section_st.badge_border_radius }}px;
                                                padding: 0.4rem 0.8rem;
                                                position: absolute;
                                                top: var(--badge-vertical-position);
                                                left: var(--badge-horizontal-position);
                                                width: var(--badge-width);
                                                height: var(--badge-height);
                                                font-size: var(--badge-font-size);
                                               display: flex;
                          align-items: center;
                          justify-content: center;
                          text-align: center;
                          z-index: 2;
                                                z-index: 2;
                        "
                      >
                        {{ section_st.badge_text }}
                      </div>
                      {%- render 'article-card',
                        article: article,
                        show_date: show_date,
                        show_excerpt: show_excerpt,
                        show_readmore: show_readmore,
                        readmore_type: readmore_type,
                        section_width: section_width,
                        items_per_row: items_per_row,
                        items_per_row_mobile: items_per_row_mobile,
                        column_gap: column_gap,
                        image_ratio: image_ratio,
                        custom_ratio: custom_ratio,
                        pagination: pagination,
                        layout: layout,
                        scroll_animation: scroll_animation,
                        indexFor: forloop.index
                      -%}
                    </div>
                  {% else %}
                    {%- render 'article-card',
                      article: article,
                      show_date: show_date,
                      show_excerpt: show_excerpt,
                      show_readmore: show_readmore,
                      readmore_type: readmore_type,
                      section_width: section_width,
                      items_per_row: items_per_row,
                      items_per_row_mobile: items_per_row_mobile,
                      column_gap: column_gap,
                      image_ratio: image_ratio,
                      custom_ratio: custom_ratio,
                      pagination: pagination,
                      layout: layout,
                      scroll_animation: scroll_animation,
                      indexFor: forloop.index
                    -%}
                  {% endif %}
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination',
                  section_st: section_st,
                  pagination: pagination,
                  number_page: items_to_show,
                  paginate: paginate
                %}
              {% endif %}
            </div>
          </div>
        {%- endpaginate -%}

      {%- else -%}
        <p>{{ 'blogs.article.empty' | t }}</p>
      {% endif %}
    </div>
  </div>
</div>



{% stylesheet %}
       .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary {
      margin-top: 10px;
       font-weight: bold;

    }
  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary {
      margin-top: 10px;
      font-weight: bold;
      position: relative;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      transition: color 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary::after {
      content: "≫"; /* Right arrow */
      margin-left: 8px;
      font-size: 16px;
      transition: margin-left 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 2px;
      background-color: currentColor;
      transition: width 0.3s ease-in-out;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary:hover::before {
      width: 100%;
  }

  .mt-30.inline-flex.blog-posts-readmore.no-underline.btn-secondary:hover::after {
      margin-left: 12px; /* Moves the arrow slightly on hover */
  }






      /* ============================= */
      /* READ MORE BUTTON STYLING      */
      /* ============================= */
      .read-more-button {
        background-color: var(--readmore-bg-color) !important;
        color: var(--readmore-text-color);
        border-radius: var(--readmore-border-radius);
        border: var(--readmore-border-weight) solid var(--readmore-border-color);
        padding: 10px 20px;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.3s, color 0.3s, border-color 0.3s;
      }
      .read-more-button:hover {
        background-color: var(--readmore-hover-bg-color);
        color: var(--readmore-text-color);
        border-color: var(--readmore-border-color);
      }

      /* =================================== */
      /* SECTION SPACING & MARGIN STYLING    */
      /* =================================== */
      .sec__blog-list {
        /* Padding from sliders */
        padding-top: var(--section-pt);
        padding-bottom: var(--section-pb);

        /* Margin from sliders */
        margin-top: var(--section-mt);
        margin-bottom: var(--section-mb);
      }

      /* Optional: Adjustments for minimal padding classes */
      .pt-min {
        padding-top: 10px; /* Adjust as needed */
      }
      .pb-min {
        padding-bottom: 10px; /* Adjust as needed */
      }

      /* ============================= */
      /* HOVER ANIMATION STYLING      */
      /* ============================= */
      .blog-articles.fade_in .article-card {
        transition: opacity 0.5s ease-in-out;
        opacity: 0;
      }
      .blog-articles.fade_in:hover .article-card {
        opacity: 1;
      }

      .blog-articles.fade_in_up .article-card {
        transform: translateY(20px);
        transition: transform 0.5s ease-in-out;
      }
      .blog-articles.fade_in_up:hover .article-card {
        transform: translateY(0);
      }

      .blog-articles.subtle_zoom_in .article-card {
        transition: transform 0.3s ease-in-out;
      }
      .blog-articles.subtle_zoom_in:hover .article-card {
        transform: scale(1.05);
      }

      .blog-articles.zoom_out .article-card {
        transition: transform 0.3s ease-in-out;
      }
      .blog-articles.zoom_out:hover .article-card {
        transform: scale(0.95);
      }

      /* ============================= */
      /* BADGE STYLING                */
      /* ============================= */
      .article-badge {
        /* Additional styles are handled inline via Liquid */
      }

      @media only screen and (max-width: 768px) {
        .sec__blog-list {
          padding: 7.5px;
        }
      }
{% endstylesheet %}

</template>

<schema>
{
  "type": "main-blog",
  "name": "Main blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "info": "Choose how the text (title, date, excerpt, etc.) is aligned within each article card.",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Article Date",
      "info": "Enable this to display the publication date on the article card.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Article Text",
      "info": "Enable this to display a brief excerpt for each article.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_readmore",
      "label": "Show Read More Button",
      "info": "Enable this to display a 'Read More' link or button.",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "info": "Controls how wide this section will appear: Container is fixed, Fluid Container expands slightly, Stretch Width extends across the browser width, and Full Width extends to the edges of the browser window.",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid Container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch Width"
        },
        {
          "value": "full_width",
          "label": "Full Width"
        }
      ],
      "default": "stretch_width"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Featured Image Ratio",
      "info": "Select how your featured blog images are displayed. 'Adapt' keeps the original aspect ratio, 'Square' crops to a 1:1 ratio, 'Portrait' is a 2:3 ratio, 'Landscape' is a 3:2 ratio, and 'Custom' allows you to specify your own ratio below.",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt (Original)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom Image Ratio",
      "info": "Specify a custom width:height ratio in the format (e.g. 2:3 or 16:9). This is used only if 'Custom' is selected above."
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load More Button Text",
      "info": "Customize the text on the Load More button (only applies if 'Load More Button' pagination is chosen).",
      "default": "Load more"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Recent",
      "info": "Enter the text you want to display in the badge. Examples: Popular, Trending, Must Read, Hot, Last Published, Exclusive, Featured, Editor's Pick, Spotlight, Breaking News, Top Stories."
    },
    {
      "type": "text",
      "id": "blog_post_badge_reference",
      "label": "Blog Post Badge Reference",
      "info": "Enter the article’s handle that should display the badge. For ex your url of the blog is eg. (https://site.net/blogs/cooking-blog/how-to-make-icecream ) ,you should paste only the e.g (cooking-blog/how-to-make-icecream ). "
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_text_font_size",
      "label": "Badge Text Font Size",
      "info": "Adjust the font size of the badge text.",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Buttons"
    },
    {
      "type": "select",
      "id": "readmore_type",
      "label": "Read More Button Style",
      "info": "Choose between a primary, solid-style button or a simple text-only button.",
      "options": [
        {
          "value": "primary",
          "label": "Primary Button"
        },
        {
          "value": "secondary",
          "label": "Text Button"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge Background Color",
      "default": "#007bff"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Badge Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Articles per Row (Desktop)",
      "info": "How many articles to show side-by-side on desktop. Larger screens can accommodate more columns.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Horizontal Gap Between Articles",
      "info": "Spacing in pixels between columns of articles. A larger number increases the space.",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top Margin",
      "info": "Controls extra space (in pixels) added above this entire section container.",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom Margin",
      "info": "Controls extra space (in pixels) added below this entire section container.",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_vertical_position",
      "label": "Badge Vertical Position",
      "info": "Control the vertical position (top) of the badge in the image.",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_horizontal_position",
      "label": "Badge Horizontal Position",
      "info": "Control the horizontal position (left) of the badge in the image.",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_width",
      "label": "Badge Width",
      "info": "Set the width of the badge in pixels.",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "badge_height",
      "label": "Badge Height",
      "info": "Set the height of the badge in pixels.",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Articles per Row (Mobile)",
      "info": "Number of articles displayed side-by-side on smaller screens.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Blog Layout",
      "info": "Display your blog articles in a structured grid or a stacked list format.",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Articles per Page",
      "info": "The number of articles to display on initial load (before pagination).",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "shopify": {
    "name": "t:sections.main-blog.name",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Content Alignment",
        "info": "Choose how the text (title, date, excerpt, etc.) is aligned within each article card.",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_date",
        "label": "Show Article Date",
        "info": "Enable this to display the publication date on the article card.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_excerpt",
        "label": "Show Article Text",
        "info": "Enable this to display a brief excerpt for each article.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_readmore",
        "label": "Show Read More Button",
        "info": "Enable this to display a 'Read More' link or button.",
        "default": true
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section Width",
        "info": "Controls how wide this section will appear: Container is fixed, Fluid Container expands slightly, Stretch Width extends across the browser width, and Full Width extends to the edges of the browser window.",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid Container"
          },
          {
            "value": "stretch_width",
            "label": "Stretch Width"
          },
          {
            "value": "full_width",
            "label": "Full Width"
          }
        ],
        "default": "stretch_width"
      },
      {
        "type": "header",
        "content": "Image / Media"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Featured Image Ratio",
        "info": "Select how your featured blog images are displayed. 'Adapt' keeps the original aspect ratio, 'Square' crops to a 1:1 ratio, 'Portrait' is a 2:3 ratio, 'Landscape' is a 3:2 ratio, and 'Custom' allows you to specify your own ratio below.",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt (Original)"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "square"
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom Image Ratio",
        "info": "Specify a custom width:height ratio in the format (e.g. 2:3 or 16:9). This is used only if 'Custom' is selected above."
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "blog",
        "id": "blog_select",
        "label": "Select Blog 💻 ",
        "info": "Choose which blog’s articles you want to display."
      },
      {
        "type": "text",
        "id": "button_show_more",
        "label": "Load More Button Text",
        "info": "Customize the text on the Load More button (only applies if 'Load More Button' pagination is chosen).",
        "default": "Load more"
      },
      {
        "type": "text",
        "id": "badge_text",
        "label": "Badge Text",
        "default": "Recent",
        "info": "Enter the text you want to display in the badge. Examples: Popular, Trending, Must Read, Hot, Last Published, Exclusive, Featured, Editor's Pick, Spotlight, Breaking News, Top Stories."
      },
      {
        "type": "text",
        "id": "blog_post_badge_reference",
        "label": "Blog Post Badge Reference",
        "info": "Enter the article’s handle that should display the badge. For ex your url of the blog is eg. (https://site.net/blogs/cooking-blog/how-to-make-icecream ) ,you should paste only the e.g (cooking-blog/how-to-make-icecream ). "
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "color",
        "id": "badge_text_color",
        "label": "Badge Text Color",
        "default": "#ffffff"
      },
      {
        "type": "range",
        "id": "badge_text_font_size",
        "label": "Badge Text Font Size",
        "info": "Adjust the font size of the badge text.",
        "min": 10,
        "max": 30,
        "step": 1,
        "default": 14,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Buttons"
      },
      {
        "type": "select",
        "id": "readmore_type",
        "label": "Read More Button Style",
        "info": "Choose between a primary, solid-style button or a simple text-only button.",
        "options": [
          {
            "value": "primary",
            "label": "Primary Button"
          },
          {
            "value": "secondary",
            "label": "Text Button"
          }
        ],
        "default": "primary"
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "color",
        "id": "badge_background_color",
        "label": "Badge Background Color",
        "default": "#007bff"
      },
      {
        "type": "range",
        "id": "badge_border_radius",
        "label": "Badge Border Radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Articles per Row (Desktop)",
        "info": "How many articles to show side-by-side on desktop. Larger screens can accommodate more columns.",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Horizontal Gap Between Articles",
        "info": "Spacing in pixels between columns of articles. A larger number increases the space.",
        "min": 0,
        "max": 50,
        "step": 5,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "Top Margin",
        "info": "Controls extra space (in pixels) added above this entire section container.",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "Bottom Margin",
        "info": "Controls extra space (in pixels) added below this entire section container.",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "badge_vertical_position",
        "label": "Badge Vertical Position",
        "info": "Control the vertical position (top) of the badge in the image.",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "badge_horizontal_position",
        "label": "Badge Horizontal Position",
        "info": "Control the horizontal position (left) of the badge in the image.",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 12,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "badge_width",
        "label": "Badge Width",
        "info": "Set the width of the badge in pixels.",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "badge_height",
        "label": "Badge Height",
        "info": "Set the height of the badge in pixels.",
        "min": 20,
        "max": 100,
        "step": 5,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Articles per Row (Mobile)",
        "info": "Number of articles displayed side-by-side on smaller screens.",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Blog Layout",
        "info": "Display your blog articles in a structured grid or a stacked list format.",
        "options": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "list",
            "label": "List"
          }
        ],
        "default": "grid"
      },
      {
        "type": "range",
        "id": "items_to_show",
        "label": "Articles per Page",
        "info": "The number of articles to display on initial load (before pagination).",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 4
      }
    ],
    "blocks": []
  }
}
