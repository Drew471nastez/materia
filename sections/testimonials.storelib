        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "header",
        "content": "Custom colors"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_colors",
        "label": "Enable custom colors",
        "default": false,
        "info": "Off uses the selected theme color scheme. On applies the colors below."
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "visible_if": "{{ section.settings.enable_custom_colors }}"
      },
      {
        "type": "color",
        "id": "card_border_color",
        "label": "Border color",
        "visible_if": "{{ section.settings.enable_custom_colors }}"
      },
      {
        "type": "color",
        "id": "quote_color",
        "label": "Stars and quote mark",
        "visible_if": "{{ section.settings.enable_custom_colors }}"
      },
      {
        "type": "header",
        "content": "Custom typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_typography",
        "label": "Enable custom quote size",
        "default": false,
        "info": "Off uses Theme settings → Typography. Header blocks have their own optional overrides."
      },
      {
        "type": "range",
        "id": "quote_size",
        "label": "Quote text size",
        "min": 12,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.enable_custom_typography }}"
      },
      {
        "type": "header",
        "content": "Motion"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section gap",
        "default": true
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "space_below_cards_desktop",
