    {
      "type": "header",
      "id": "hdr_31",
      "label": "Custom colors"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_colors",
      "label": "Enable custom colors",
      "default": false,
      "info": "Off uses the selected theme color scheme. On applies the colors below."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_colors }}"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "visible_if": "{{ section.settings.enable_custom_colors }}"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Stars and quote mark",
      "visible_if": "{{ section.settings.enable_custom_colors }}"
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Custom typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_typography",
      "label": "Enable custom quote size",
      "default": false,
      "info": "Off uses Theme settings → Typography. Header blocks have their own optional overrides."
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Quote text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_typography }}"
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Motion"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section gap",
      "default": true
    },
    {
