<template>
<section class="s qx qx--{{ settings.layout }} qx--icon-{{ settings.icon }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ settings.text_color }}; --s-heading: {{ settings.heading_color }}; --s-border: {{ settings.border_color }}; --s-accent: {{ scheme.accent }}; --s-link: {{ scheme.link }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="qx__in qx__in--{{ settings.max_width }}">

    <div class="qx__head">
      {% if settings.heading %}<h2 class="qx__h qx__h--{{ settings.heading_size }}">{{ settings.heading | raw }}</h2>{% endif %}
      {% if settings.subheading %}<div class="qx__sub">{{ settings.subheading | raw }}</div>{% endif %}
      {% if settings.contact_text %}
        <p class="qx__contact">
          {% if settings.contact_intro %}<span class="qx__contact-intro">{{ settings.contact_intro }}</span>{% endif %}
          <a class="qx__contact-link" href="{{ settings.contact_url | default: '#' | url }}">{{ settings.contact_text }}</a>
        </p>
      {% endif %}
    </div>

    <div class="qx__body">
      {% for block in blocks %}
        {% if forloop.first %}<div class="qx__list">{% endif %}
        <details class="qa" name="{{ section.id }}-faq" data-block-id="{{ block.id }}"{% if block.settings.open or forloop.first and settings.open_first %} open{% endif %}>
          <summary class="qa__q">
            <span class="qa__text">{{ block.settings.question }}</span>
            <span class="qa__mark" aria-hidden="true"></span>
          </summary>
          <div class="qa__a">{{ block.settings.answer | raw }}</div>
        </details>
        {% if forloop.last %}</div>{% endif %}
      {% else %}
        {% if page.in_editor %}<p class="qx__empty">Add your first question in the sidebar</p>{% endif %}
      {% endfor %}
    </div>

  </div>
</section>
</template>

<style scoped>
.qx { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); }
.qx__in { display: grid; gap: 32px; margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.qx__in--narrow { max-width: 720px; }
.qx__in--medium { max-width: 960px; }
.qx__in--wide { max-width: var(--theme-page-width, 1280px); }
.qx__in--full { max-width: none; }

.qx__head { max-width: 36rem; }
.qx__h { margin: 0; color: var(--s-heading); font-family: var(--theme-font-heading); font-weight: var(--type-h2-weight, var(--section-heading-weight, 700)); line-height: var(--section-heading-line-height, 1.1); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); overflow-wrap: anywhere; }
.qx__h--h1 { font-size: clamp(32px, 7cqi, var(--type-h1-size, 56px)); }
.qx__h--h2 { font-size: clamp(26px, 6cqi, var(--type-h2-size, 36px)); }
.qx__h--h3 { font-size: clamp(20px, 5cqi, var(--type-h3-size, 24px)); }
.qx__sub { margin-top: 12px; font-size: var(--type-body-size, 16px); line-height: 1.6; max-width: 36rem; }
.qx__sub > :first-child { margin-top: 0; }
.qx__sub > :last-child { margin-bottom: 0; }
.qx__contact { margin: 24px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 15px; line-height: 1.5; }
.qx__contact-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; transition: opacity 150ms ease; }
.qx__contact-link:hover { opacity: 0.7; }
.qx__contact-link:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; border-radius: 4px; }

.qa { border-bottom: 1px solid var(--s-border); }
.qa:first-of-type { border-top: 1px solid var(--s-border); }
.qa__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 16px 2px; cursor: pointer; list-style: none; font-family: var(--theme-font-body); font-size: 16px; font-weight: 600; line-height: 1.4; color: var(--s-heading); }
.qa__q::-webkit-details-marker { display: none; }
.qa__q::marker { content: ""; }
.qa__q:hover .qa__text { opacity: 0.75; }
.qa__text { transition: opacity 150ms ease; }
.qa__q:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; border-radius: 8px; }

.qa__mark { position: relative; flex: none; width: 14px; height: 14px; }
.qa__mark::before, .qa__mark::after { content: ""; position: absolute; inset: 0; margin: auto; transition: transform 160ms ease, opacity 160ms ease; }
.qx--icon-plus .qa__mark::before { width: 14px; height: 1.5px; background: currentColor; }
.qx--icon-plus .qa__mark::after { width: 1.5px; height: 14px; background: currentColor; }
.qx--icon-plus .qa[open] .qa__mark::after { transform: scaleY(0); opacity: 0; }
.qx--icon-chevron .qa__mark::before { width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
.qx--icon-chevron .qa__mark::after { display: none; }
.qx--icon-chevron .qa[open] .qa__mark::before { transform: translateY(2px) rotate(-135deg); }

.qa__a { padding: 0 2px 20px; max-width: 40rem; font-size: 15px; line-height: 1.65; color: var(--s-text); }
.qa__a > :first-child { margin-top: 0; }
.qa__a > :last-child { margin-bottom: 0; }
.qa__a a { color: var(--s-heading); text-underline-offset: 3px; }

.qx__empty { margin: 0; padding: 24px; text-align: center; font-size: 14px; border: 1px dashed var(--s-border); border-radius: 8px; opacity: 0.75; }

@container (min-width: 760px) {
  .qx--split .qx__in { grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  .qx--split .qx__head { position: sticky; top: 24px; }
  .qx--stacked .qx__in { gap: 40px; }
  .qx--stacked .qx__body { max-width: 48rem; }
  .qa__q { font-size: 17px; padding: 20px 2px; }
}

@media (prefers-reduced-motion: reduce) {
  .qa__mark::before, .qa__mark::after, .qa__text, .qx__contact-link { transition: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "faq_pants_down",
  "name": "Questions Beside Heading",
  "category": "faq",
  "description": "A bold heading with a contact link beside a list of questions that open one at a time.",
  "version": "1.0.0",
  "icon": "help-circle",
  "settings": [
    {"type":"header","id":"hdr_content","label":"Content"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"PUT YOUR PANTS DOWN!"},
    {"type":"select","id":"heading_size","label":"Heading size","default":"h2","options":[{"label":"Large (H1)","value":"h1"},{"label":"Medium (H2)","value":"h2"},{"label":"Small (H3)","value":"h3"}]},
    {"type":"richtext","id":"subheading","label":"Supporting text","default":"<p>Everything people ask before they order, from fit to delivery to sending a pair back.</p>"},
    {"type":"text","id":"contact_intro","label":"Contact line","default":"Still not sure?"},
    {"type":"text","id":"contact_text","label":"Contact link wording","default":"Message us"},
    {"type":"url","id":"contact_url","label":"Contact link","default":"/pages/contact"},
    {"type":"toggle","id":"open_first","label":"Open the first question","default":true},
    {"type":"header","id":"hdr_layout","label":"Layout"},
    {"type":"radio","id":"layout","label":"Layout","default":"split","options":[{"label":"Heading beside questions","value":"split"},{"label":"Heading above questions","value":"stacked"}]},
    {"type":"select","id":"max_width","label":"Content width","default":"wide","options":[{"label":"Narrow","value":"narrow"},{"label":"Medium","value":"medium"},{"label":"Wide","value":"wide"},{"label":"Full","value":"full"}]},
    {"type":"header","id":"hdr_style","label":"Style"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"white"},
    {"type":"color","id":"heading_color","label":"Heading and questions","default":"scheme.heading"},
    {"type":"color","id":"text_color","label":"Text","default":"scheme.text"},
    {"type":"color","id":"border_color","label":"Dividers","default":"scheme.border"},
    {"type":"select","id":"icon","label":"Open and close icon","default":"plus","options":[{"label":"Plus","value":"plus"},{"label":"Chevron","value":"chevron"}]},
    {"type":"header","id":"hdr_spacing","label":"Spacing"},
    {"type":"range","id":"padding_top","label":"Top padding","default":36,"min":0,"max":160,"step":4,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","default":36,"min":0,"max":160,"step":4,"unit":"px"}
  ],
  "blocks": [
    {"type":"question","name":"Question","limit":30,"settings":[
      {"type":"text","id":"question","label":"Question","default":"How do I find my size?"},
      {"type":"richtext","id":"answer","label":"Answer","default":"<p>Every product page has a size chart. Measure a pair that fits you well and compare it with the chart.</p>"},
      {"type":"checkbox","id":"open","label":"Open by default","default":false}
    ]}
  ],
  "max_blocks": 30,
  "presets": [
    {"name":"Questions Beside Heading","blocks":[
      {"type":"question","settings":{"question":"How do I find my size?","answer":"<p>Every product page has a size chart with waist, hip and inside leg measurements. Lay a pair you already like flat, measure it, and pick the size closest to it. Between two sizes, go up.</p>"}},
      {"type":"question","settings":{"question":"How long does delivery take?","answer":"<p>Orders leave us within a couple of working days, and you get a tracking link by email the moment yours ships. The delivery time for your address is shown at checkout before you pay.</p>"}},
      {"type":"question","settings":{"question":"Can I return something that doesn't fit?","answer":"<p>Yes. Send it back unworn, unwashed and with its tags on, and we refund you once it arrives. The full details are on our returns page.</p>"}},
      {"type":"question","settings":{"question":"Can I swap for a different size?","answer":"<p>Of course. Message us with your order number and the size you need, and we will tell you how to send the first pair back and get the new one on its way.</p>"}},
      {"type":"question","settings":{"question":"How should I wash them?","answer":"<p>Turn them inside out, wash cool with similar colours and hang them to dry. Skipping the tumble dryer keeps the fit and colour as they were the day they arrived.</p>"}},
      {"type":"question","settings":{"question":"Can I change my order after I've placed it?","answer":"<p>As long as it hasn't shipped yet. Reply to your order confirmation email straight away with what you want changed and we will sort it.</p>"}}
    ]},
    {"name":"Questions Beside Heading on dark","settings":{"color_scheme":"dark"},"blocks":[
      {"type":"question","settings":{"question":"How do I find my size?","answer":"<p>Every product page has a size chart with waist, hip and inside leg measurements. Lay a pair you already like flat, measure it, and pick the size closest to it. Between two sizes, go up.</p>"}},
      {"type":"question","settings":{"question":"How long does delivery take?","answer":"<p>Orders leave us within a couple of working days, and you get a tracking link by email the moment yours ships. The delivery time for your address is shown at checkout before you pay.</p>"}},
      {"type":"question","settings":{"question":"Can I return something that doesn't fit?","answer":"<p>Yes. Send it back unworn, unwashed and with its tags on, and we refund you once it arrives. The full details are on our returns page.</p>"}}
    ]}
  ]
}
</schema>