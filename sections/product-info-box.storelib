<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Product Info Box (standalone section)
  Compact bordered box that pairs with the product information area.
  Has three stacked rows: a top message ("Free delivery on orders over
  $100"), a smooth collapsible delivery information panel, and a row
  of payment-method badges. Designed to drop in on product pages
  beside or below the buy buttons.

  Block-organized: heading_row (top message), collapsible (multiple
  open/close rows), payment_badges. Renders without JS for the open
  state of collapsibles too — uses <details>/<summary> with the same
  3-level grid-template-rows animation as the rest of the theme's FAQ
  sections.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  comment
    Pre-collect blocks into separate lists for ordered rendering.
  endcomment
  assign top_rows      = section.blocks | where: 'type', 'top_row'
  assign collapsibles  = section.blocks | where: 'type', 'collapsible'
  assign badges_block  = nil
  for b in section.blocks
    if b.type == 'badges' and badges_block == nil
      assign badges_block = b
    endif
  endfor
-%}

<div class="pib color-{{ color_scheme }} gradient" id="pib-{{ sid }}"
     style="
       --pib-bg: {% render 'scheme-color', color: st.box_bg, fallback: 'var(--color-background)' %};
       --pib-border: {% render 'scheme-color', color: st.border_color, fallback: 'var(--color-border)' %};
       --pib-text: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
       --pib-muted: {% render 'scheme-color', color: st.muted_color, fallback: 'color-mix(in srgb, var(--color-text) 75%, transparent)' %};
       --pib-radius: {{ st.box_radius | default: 12 }}px;
       --pib-row-pad-y: {{ st.row_pad_y | default: 16 }}px;
       --pib-row-pad-x: {{ st.row_pad_x | default: 18 }}px;
       margin-top: {{ st.margin_top | default: 0 }}px;
       margin-bottom: {{ st.margin_bottom | default: 0 }}px;
     ">
  <div class="pib__inner">

    {%- comment -%}========== TOP ROWS (highlight messages) ==========={%- endcomment -%}
    {%- for tr in top_rows -%}
      <div class="pib__row pib__row--top" id="block-{{ tr.id }}" {{ tr.shopify_attributes }}>
        <div class="pib__top">
          {%- if tr.settings.show_icon -%}
            <span class="pib__top-icon" style="color: {% render 'scheme-color', color: tr.settings.icon_color, fallback: 'var(--color-heading)' %};">
              {%- case tr.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96c1 1.57 2 4.55 2 7.04A6.78 6.78 0 0 1 14 17"/><path d="M2 22 19 5"/></svg>
                {%- when 'gift' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C9 3 12 7 12 8c0-1 3-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
                {%- when 'lock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          <div class="pib__top-text">{{ tr.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%}========== COLLAPSIBLE ROWS ==========={%- endcomment -%}
    {%- comment -%}
      Uses div + button (not <details>) so the close transition runs.
      Native <details> hides children abruptly when toggled, which breaks
      the grid-template-rows height animation on close.
    {%- endcomment -%}
    {%- for c in collapsibles -%}
      <div class="pib__row pib__row--collapse pib__details" id="block-{{ c.id }}" data-pib-coll {% if c.settings.open_default %}data-open="1"{% endif %} {{ c.shopify_attributes }}>
        <button type="button" class="pib__summary" data-pib-toggle aria-expanded="{% if c.settings.open_default %}true{% else %}false{% endif %}" aria-controls="pib-a-{{ sid }}-{{ c.id }}">
          <span class="pib__summary-text">{{ c.settings.title }}</span>
          <span class="pib__chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </button>
        <div class="pib__answer-wrap" id="pib-a-{{ sid }}-{{ c.id }}">
          <div class="pib__answer-inner">
            <div class="pib__answer">{{ c.settings.body }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%}========== PAYMENT BADGES ==========={%- endcomment -%}
    {%- if badges_block -%}
      {%- assign bb = badges_block.settings -%}
      <div class="pib__row pib__row--badges" id="block-{{ badges_block.id }}" {{ badges_block.shopify_attributes }}>
        <div class="pib__badges" style="--pib-badge-h: {{ bb.badge_height | default: 24 }}px;">
          {%- comment -%}
            Build the list of types to render. When `use_shop_methods`
            is on we ask Shopify which payment types the merchant has
            enabled — but some store configurations (Shopify Payments
            without explicit type listing, sandbox stores, etc.) return
            an empty array, which is what was producing a totally blank
            badges row. Fall back to a sensible default set so the row
            always shows something.
          {%- endcomment -%}
          {%- assign types_list = '' | split: ',' -%}
          {%- if bb.use_shop_methods -%}
            {%- for type in shop.enabled_payment_types -%}
              {%- assign types_list = types_list | concat: type | split: '||MATERIA||' -%}
            {%- endfor -%}
            {%- if types_list.size == 0 -%}
              {%- assign types_list = 'visa,master,american_express,paypal,apple_pay,google_pay,shop_pay' | split: ',' -%}
            {%- endif -%}
          {%- else -%}
            {%- for n in (1..6) -%}
              {%- assign type_key = 'badge_' | append: n | append: '_type' -%}
              {%- assign sel = bb[type_key] -%}
              {%- if sel != blank and sel != 'none' -%}
                {%- assign types_list = types_list | concat: sel | split: '||MATERIA||' -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%}
            Render each badge as an inline SVG so it works regardless of
            whether `payment_type_svg_tag` is available / wired up in
            this store. SVGs are wrapped in a span so the height CSS
            (`.pib__badge svg`) sizes them consistently.
          {%- endcomment -%}
          {%- for type in types_list -%}
            {%- if type == blank -%}{%- continue -%}{%- endif -%}
            <span class="pib__badge pib__badge--auto">
              {%- case type -%}
                {%- when 'visa' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.visa' | t }}"><title>{{ 'payment.methods.visa' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path d="M28.3 10.1H28c-.4 1-.7 1.5-1 3h1.9c-.3-1.5-.3-2.2-.6-3zm2.9 5.9h-1.7c-.1 0-.1 0-.2-.1l-.2-.9-.1-.2h-2.4c-.1 0-.2 0-.2.2l-.3.9c0 .1-.1.1-.1.1h-2.1l.2-.5L27 8.7c0-.5.3-.7.8-.7h1.5c.1 0 .2 0 .2.2l1.4 6.5c.1.4.2.7.2 1.1.1.1.1.1.1.2zm-13.4-.3l.4-1.8c.1 0 .2.1.2.1.7.3 1.4.5 2.1.4.2 0 .5-.1.7-.2.5-.2.5-.7.1-1.1-.2-.2-.5-.3-.8-.5-.4-.2-.8-.4-1.1-.7-1.2-1-.8-2.4-.1-3.1.6-.4.9-.8 1.7-.8 1.2 0 2.5 0 3.1.2h.1c-.1.6-.2 1.1-.4 1.7-.5-.2-1-.4-1.5-.4-.3 0-.6 0-.9.1-.2 0-.3.1-.4.2-.2.2-.2.5 0 .7l.5.4c.4.2.8.4 1.1.6.5.3 1 .8 1.1 1.4.2.9-.1 1.7-.9 2.3-.5.4-.7.6-1.4.6-1.4 0-2.5.1-3.4-.2-.1.2-.1.2-.2.1zm-3.5.3c.1-.7.1-.7.2-1 .5-2.2 1-4.5 1.4-6.7.1-.2.1-.3.3-.3H18c-.2 1.2-.4 2.1-.7 3.2-.3 1.5-.6 3-1 4.5 0 .2-.1.2-.3.2M5 8.2c0-.1.2-.2.3-.2h3.4c.5 0 .9.3 1 .8l.9 4.4c0 .1 0 .1.1.2 0-.1.1-.1.1-.1l2.1-5.1c-.1-.1 0-.2.1-.2h2.1c0 .1 0 .1-.1.2l-3.1 7.3c-.1.2-.1.3-.2.4-.1.1-.3 0-.5 0H9.7c-.1 0-.2 0-.2-.2L7.9 9.5c-.2-.2-.5-.5-.9-.6-.6-.3-1.7-.5-1.9-.5L5 8.2z" fill="#142688"/></svg>
                {%- when 'master', 'mastercard' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.mastercard' | t }}"><title>{{ 'payment.methods.mastercard' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><circle fill="#EB001B" cx="15" cy="12" r="7"/><circle fill="#F79E1B" cx="23" cy="12" r="7"/><path fill="#FF5F00" d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.3-3 3.4-3 5.7s1.2 4.5 3 5.7c1.8-1.2 3-3.3 3-5.7z"/></svg>
                {%- when 'american_express', 'amex' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.american_express' | t }}"><title>{{ 'payment.methods.american_express' | t }}</title><path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z" opacity=".07"/><path fill="#006FCF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32Z"/><path fill="#FFF" d="M22.012 19.936v-8.421L37 11.528v2.326l-1.732 1.852L37 17.573v2.375h-2.766l-1.47-1.622-1.46 1.628-9.292-.02Z"/><path fill="#006FCF" d="M23.013 19.012v-6.57h5.572v1.513h-3.768v1.028h3.678v1.488h-3.678v1.01h3.768v1.531h-5.572Z"/><path fill="#006FCF" d="m28.557 19.012 3.083-3.289-3.083-3.282h2.386l1.884 2.083 1.89-2.082H37v.051l-3.017 3.23L37 18.92v.093h-2.307l-1.917-2.103-1.898 2.104h-2.321Z"/><path fill="#FFF" d="M22.71 4.04h3.614l1.269 2.881V4.04h4.46l.77 2.159.771-2.159H37v8.421H19l3.71-8.421Z"/><path fill="#006FCF" d="m23.395 4.955-2.916 6.566h2l.55-1.315h2.98l.55 1.315h2.05l-2.904-6.566h-2.31Zm.25 3.777.875-2.09.873 2.09h-1.748Z"/><path fill="#006FCF" d="M28.581 11.52V4.953l2.811.01L32.84 9l1.456-4.046H37v6.565l-1.74.016v-4.51l-1.644 4.494h-1.59L30.35 7.01v4.51h-1.768Z"/></svg>
                {%- when 'paypal' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.paypal' | t }}"><title>{{ 'payment.methods.paypal' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#003087" d="M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z"/><path fill="#3086C8" d="M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.1-3.2.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.5-.8z"/><path fill="#012169" d="M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z"/></svg>
                {%- when 'apple_pay' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.apple_pay' | t }}"><title>{{ 'payment.methods.apple_pay' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#000" d="M11.34 9.56c-.42.5-1.1.89-1.78.83-.08-.68.25-1.4.64-1.84.43-.51 1.18-.87 1.79-.9.07.71-.21 1.4-.65 1.91Zm.64.95c-.99-.06-1.83.56-2.3.56-.48 0-1.2-.53-1.98-.52-1.02.02-1.97.59-2.49 1.51-1.07 1.84-.28 4.57.76 6.07.51.74 1.12 1.55 1.92 1.52.76-.03 1.05-.49 1.97-.49.92 0 1.18.49 1.98.48.82-.02 1.34-.74 1.84-1.48.58-.84.81-1.66.83-1.7-.02-.02-1.6-.62-1.62-2.45-.01-1.53 1.25-2.26 1.31-2.3-.71-1.05-1.83-1.17-2.22-1.2Zm5.78-1.4v9.79h1.52v-3.35h2.1c1.92 0 3.27-1.32 3.27-3.23s-1.32-3.21-3.21-3.21h-3.68Zm1.52 1.28h1.75c1.31 0 2.06.7 2.06 1.94 0 1.24-.75 1.94-2.07 1.94h-1.74V10.4Zm9.3 8.6c.95 0 1.84-.48 2.24-1.25h.03v1.17h1.41v-4.88c0-1.42-1.13-2.34-2.88-2.34-1.62 0-2.83.93-2.87 2.2h1.37c.11-.6.67-1 1.46-1 .96 0 1.5.45 1.5 1.27v.56l-1.95.12c-1.81.11-2.79.85-2.79 2.14 0 1.31 1.01 2.18 2.46 2.18Zm.42-1.16c-.84 0-1.37-.4-1.37-1.02 0-.64.51-1.01 1.49-1.07l1.74-.11v.58c0 .96-.81 1.62-1.86 1.62Zm5.29 3.71c1.49 0 2.19-.57 2.81-2.31l2.69-7.55h-1.55l-1.81 5.83h-.03l-1.81-5.83h-1.59l2.6 7.21-.14.44c-.24.75-.62 1.04-1.31 1.04-.12 0-.36-.01-.46-.03v1.17c.09.03.48.03.6.03Z"/></svg>
                {%- when 'google_pay' -%}
