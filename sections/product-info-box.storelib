                {%- when 'shop_pay', 'shopify_pay' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.shop_pay' | t }}"><title>{{ 'payment.methods.shop_pay' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#5A31F4" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#fff" d="M9.7 9.3c-1 0-1.7.8-1.7 1.7s.7 1.7 1.7 1.7c.8 0 1.6-.6 1.6-1.7 0-1-.6-1.7-1.6-1.7zm-.05 3.45c-1.1 0-1.97-.81-1.97-1.97s.85-1.97 1.97-1.97c.79 0 1.48.43 1.78 1.07v-1h.6v3.8h-.6v-1c-.3.64-.99 1.07-1.78 1.07zm5.9-3.97v3.94h-.6V8.78h.6zm1.79.05v3.83h-.6V8.83h.6zm1.7 4.05c-1.05 0-1.85-.81-1.85-1.97 0-1.16.85-1.97 1.94-1.97s1.85.83 1.85 1.97c0 .12 0 .24-.02.34h-3.16c.07.65.59 1.06 1.24 1.06.5 0 .92-.24 1.13-.61h.62c-.27.7-.99 1.18-1.75 1.18zm.1-3.4c-.6 0-1.07.36-1.21.95h2.43c-.04-.55-.5-.95-1.22-.95zm5.07 3.4c-1.05 0-1.85-.81-1.85-1.97 0-1.16.85-1.97 1.94-1.97s1.85.83 1.85 1.97c0 .12 0 .24-.02.34h-3.16c.07.65.59 1.06 1.24 1.06.5 0 .92-.24 1.13-.61h.62c-.27.7-.99 1.18-1.75 1.18zm.1-3.4c-.6 0-1.07.36-1.21.95h2.43c-.04-.55-.5-.95-1.22-.95z"/></svg>
                {%- when 'klarna' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.klarna' | t }}"><title>{{ 'payment.methods.klarna' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#FFB3C7" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#0A0A0A" d="M11.4 8.7c0 1-.5 2-1.4 2.6l1.6 2.2H10l-1.7-2.4v2.4H6.9V7.1h1.4v3.5l1.6-2H11l-1.4 1.8c.5.4.8.8.8 1.3 0-.7 0 0 1 .9zm1.3 4.8h1.3V7H12.7v6.5zm5-3.5c-.4 0-.7.1-.9.4v-.3h-1.3v3.5h1.3v-1.9c0-.4.2-.6.6-.6.4 0 .6.2.6.6v1.9H19v-2.1c0-1-.6-1.5-1.3-1.5zm5.3 1.7c0-1.1-.9-1.9-2-1.9s-2 .9-2 1.9c0 1.1.9 1.9 2 1.9.4 0 .8-.1 1.2-.4v.3h1.3v-1.8h-.5zm-2 .9c-.6 0-1-.4-1-.9s.4-.9 1-.9 1 .4 1 .9-.5.9-1 .9zm5.3-2.6c-.4 0-.7.1-1 .4v-.3h-1.3v3.5h1.3v-1.9c0-.4.2-.6.6-.6.4 0 .6.2.6.6v1.9h1.3v-2.1c0-1-.6-1.5-1.5-1.5zm5.6.1l-1 1.5-1-1.5h-1.4l1.7 2.6-.3.4c-.1.1-.2.2-.4.2h-.3v1.1c.2 0 .4.1.6.1.6 0 1.1-.3 1.4-.8l2.1-3.6h-1.4z"/></svg>
                {%- when 'afterpay' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.afterpay' | t }}"><title>{{ 'payment.methods.afterpay' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#B2FCE4" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#0A0A0A" d="m24.4 7.7-1.7 1v.7l1.7 1V9.6h2.5v.7l1.7-1-1.7-1v.7h-2.5v-.3zm-2.6 0v8.5h-1.6V14c-.4.4-1 .7-1.7.7-1.5 0-2.7-1.2-2.7-2.7s1.2-2.7 2.7-2.7c.7 0 1.3.3 1.7.7v-.7h1.6V7.7zm-2.9 5.5c.7 0 1.3-.6 1.3-1.3s-.6-1.3-1.3-1.3-1.3.6-1.3 1.3.6 1.3 1.3 1.3zm-7.2-.6c0-1.5 1.2-2.7 2.7-2.7s2.7 1.2 2.7 2.7-1.2 2.7-2.7 2.7-2.7-1.2-2.7-2.7zm2.7 1.3c.7 0 1.3-.6 1.3-1.3s-.6-1.3-1.3-1.3-1.3.6-1.3 1.3.6 1.3 1.3 1.3z"/></svg>
                {%- when 'discover' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.discover' | t }}"><title>{{ 'payment.methods.discover' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#F47216" d="M19 19h17c.6 0 1-.4 1-1V11c-3.5 4-12.7 7-18 8z"/><circle cx="20.5" cy="11.3" r="2.2" fill="#F47216"/></svg>
                {%- when 'diners_club' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.diners_club' | t }}"><title>{{ 'payment.methods.diners_club' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#0079BE" d="M21 19c4 0 7-3.1 7-7s-3.1-7-7-7h-4c-3.9 0-7 3.1-7 7s3.1 7 7 7h4zM16 6.5c2.9 0 5.3 2.4 5.3 5.5S18.9 17.5 16 17.5 10.7 15.1 10.7 12 13.1 6.5 16 6.5zm-1.7 8.7v-6.4C13 9.3 12 10.5 12 12s1 2.7 2.3 3.2zm3.4 0c1.4-.5 2.3-1.7 2.3-3.2s-1-2.7-2.3-3.2v6.4z"/></svg>
                {%- when 'amazon' -%}
                  <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'payment.methods.amazon' | t }}"><title>{{ 'payment.methods.amazon' | t }}</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#F90" d="M25.95 15.46c-2.04 1.5-5 2.3-7.55 2.3-3.57 0-6.79-1.32-9.22-3.52-.19-.17-.02-.41.21-.28 2.62 1.52 5.86 2.44 9.21 2.44 2.27 0 4.76-.47 7.05-1.44.35-.15.64.22.3.5z"/><path fill="#F90" d="M26.8 14.5c-.26-.34-1.74-.16-2.4-.08-.2.02-.23-.15-.05-.28 1.18-.83 3.1-.59 3.32-.31.23.28-.06 2.21-1.16 3.13-.17.14-.33.07-.26-.12.25-.62.81-2 .55-2.34z"/><path fill="#221F1F" d="M24.45 8.25V7.4c0-.13.1-.22.21-.22h3.83c.12 0 .22.09.22.22v.73c0 .12-.1.28-.29.54l-1.99 2.83c.74-.02 1.52.09 2.18.46.15.08.19.21.2.33v.91c0 .13-.14.27-.28.2-1.17-.61-2.72-.68-4 .01-.13.07-.27-.07-.27-.2v-.86c0-.14 0-.38.14-.6l2.3-3.3h-2c-.12 0-.22-.09-.22-.21z"/><path fill="#221F1F" d="M14.6 13.42h-1.16c-.11 0-.2-.09-.21-.2V7.41c0-.12.1-.21.22-.21h1.09c.12 0 .2.1.21.2v.78h.02c.28-.76.82-1.12 1.55-1.12.74 0 1.2.36 1.53 1.12.28-.76.93-1.12 1.62-1.12.5 0 1.04.21 1.36.66.37.5.3 1.23.3 1.87v3.76c0 .12-.1.21-.22.21h-1.16c-.12 0-.21-.1-.21-.21V9.55c0-.25.02-.87-.03-1.1-.08-.4-.34-.51-.67-.51-.28 0-.57.19-.69.49-.12.3-.11.81-.11 1.12v3.66c0 .12-.1.21-.22.21h-1.16c-.12 0-.21-.1-.21-.21v-3.66c0-.66.11-1.63-.7-1.63-.83 0-.8.95-.8 1.63v3.66c0 .12-.1.21-.22.21z"/></svg>
                {%- else -%}
                  {{ type | payment_type_svg_tag }}
              {%- endcase -%}
            </span>
          {%- endfor -%}

          {%- comment -%}Custom image badges (manual mode){%- endcomment -%}
          {%- unless bb.use_shop_methods -%}
            {%- for n in (1..6) -%}
              {%- assign image_key = 'badge_' | append: n | append: '_image' -%}
              {%- assign type_key  = 'badge_' | append: n | append: '_type' -%}
              {%- assign sel = bb[type_key] -%}
              {%- assign img = bb[image_key] -%}
              {%- if img -%}
                {%- if sel == blank or sel == 'none' -%}
                  <img class="pib__badge" src="{{ img | image_url: height: 48 }}" alt="" loading="lazy" height="24">
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #pib-{{ sid }} { display: block; font-family: var(--body-font, inherit); }
  #pib-{{ sid }} .pib__inner {
    background: var(--pib-bg);
    color: var(--pib-text);
    border: 1px solid var(--pib-border);
    border-radius: var(--pib-radius);
    overflow: hidden;
  }
  #pib-{{ sid }} .pib__row {
    padding: var(--pib-row-pad-y) var(--pib-row-pad-x);
    border-top: 1px solid var(--pib-border);
  }
  #pib-{{ sid }} .pib__row:first-child { border-top: 0; }

  /* Top highlight row */
  #pib-{{ sid }} .pib__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #pib-{{ sid }} .pib__top-icon {
    flex: 0 0 auto;
    display: inline-flex;
    width: 20px; height: 20px;
  }
  #pib-{{ sid }} .pib__top-icon svg { width: 100%; height: 100%; display: block; }
  #pib-{{ sid }} .pib__top-text {
    font-size: 15px;
    line-height: 1.4;
    color: var(--pib-text);
  }
  #pib-{{ sid }} .pib__top-text strong { font-weight: 700; }

  /* Collapsible */
  #pib-{{ sid }} .pib__details { padding: 0; }
  #pib-{{ sid }} .pib__summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 24px;
    align-items: center;
    gap: 12px;
    padding: var(--pib-row-pad-y) var(--pib-row-pad-x);
    width: 100%;
    background: transparent;
    border: 0;
    text-align: start;
    font-family: inherit;
    font-weight: var(--heading-weight, 700);
    font-size: 15px;
    line-height: 1.3;
    min-height: 44px;
    color: var(--pib-text);
  }
  #pib-{{ sid }} .pib__summary:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  #pib-{{ sid }} .pib__chevron {
    width: 24px; height: 24px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--pib-text);
    transition: transform .35s cubic-bezier(.4, 0, .2, 1);
  }
  #pib-{{ sid }} .pib__chevron svg { width: 18px; height: 18px; }
  #pib-{{ sid }} .pib__details[data-open="1"] .pib__chevron { transform: rotate(180deg); }

  /* Smooth height animation — same 3-level pattern as Faq1 / info-box */
  #pib-{{ sid }} .pib__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .42s cubic-bezier(.4, 0, .2, 1);
  }
  #pib-{{ sid }} .pib__details[data-open="1"] .pib__answer-wrap { grid-template-rows: 1fr; }
  #pib-{{ sid }} .pib__answer-inner { overflow: hidden; }
  #pib-{{ sid }} .pib__answer {
    padding: 0 var(--pib-row-pad-x) var(--pib-row-pad-y);
    color: var(--pib-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  #pib-{{ sid }} .pib__answer p { margin: 0; }
  #pib-{{ sid }} .pib__answer p + p { margin-top: 10px; }

  /* Payment badges row */
  #pib-{{ sid }} .pib__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  #pib-{{ sid }} .pib__badge {
    height: var(--pib-badge-h);
    width: auto;
    display: inline-flex;
    align-items: center;
    object-fit: contain;
    line-height: 0;
  }
  #pib-{{ sid }} .pib__badge svg,
  #pib-{{ sid }} svg.pib__badge { height: var(--pib-badge-h); width: auto; display: block; }

  @media (prefers-reduced-motion: reduce) {
    #pib-{{ sid }} .pib__answer-wrap,
    #pib-{{ sid }} .pib__chevron { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>

<script>
  (function () {
    function initPib() {
    var root = document.getElementById('pib-{{ sid }}');
    if (!root || root.__pibInit) return;
    root.__pibInit = true;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-pib-toggle]');
      if (!btn || !root.contains(btn)) return;
      var coll = btn.closest('[data-pib-coll]');
      if (!coll) return;
      var isOpen = coll.getAttribute('data-open') === '1';
      if (isOpen) {
        coll.removeAttribute('data-open');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        coll.setAttribute('data-open', '1');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
    }
    initPib();
    window.__pibListen = window.__pibListen || {};
    if (!window.__pibListen['{{ sid }}']) {
      window.__pibListen['{{ sid }}'] = true;
      document.addEventListener('storelib:section-load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ sid }}') initPib();
      });
    }
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "product-info-box",
  "name": "Product Info Box",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
