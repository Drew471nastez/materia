            "label": "Progress bar"
          }
        ]
      },
      {
        "type": "select",
        "id": "pagination_style",
        "label": "Pagination style",
        "default": "pill",
        "options": [
          {
            "value": "dot",
            "label": "Dot (default)"
          },
          {
            "value": "pill",
            "label": "Pill (active expands)"
          },
          {
            "value": "line",
            "label": "Line / bar"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "ring",
            "label": "Ring (hollow)"
          },
          {
            "value": "number",
            "label": "Numbers"
          },
          {
            "value": "progress",
            "label": "Progress fill"
          }
        ],
        "visible_if": "{{ section.settings.carousel_pagination != 'disable' }}"
      },
      {
        "type": "select",
        "id": "pagination_position",
        "label": "Pagination position (desktop)",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "visible_if": "{{ section.settings.carousel_pagination != 'disable' }}"
      },
      {
        "type": "checkbox",
        "id": "infinite",
        "label": "Loop",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Change slides automatically",
        "default": false,
        "info": "Pauses off screen and under reduced motion."
      },
      {
        "type": "range",
        "id": "autorotate_speed",
        "label": "Seconds per slide",
        "max": 6,
        "min": 2,
        "step": 1,
        "unit": "s",
        "default": 5,
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Picture shape",
        "options": [
          {
            "value": "adapt",
            "label": "Original"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "adapt"
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom shape",
        "info": "Width:height, for example 16:9",
        "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
      },
      {
        "type": "checkbox",
        "id": "rounded_image",
        "label": "Round pictures",
        "info": "Only works when you selected Below image in Collection information position setting.",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "checkbox",
        "id": "image_custom_width",
        "label": "Set the picture width",
        "info": "Only works when you selected Below image in Collection information position setting.",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "range",
        "id": "image_width",
        "label": "Picture width",
        "min": 100,
        "max": 300,
        "step": 5,
        "default": 200,
        "unit": "px",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' and section.settings.image_custom_width }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "select",
        "id": "header_size",
        "label": "Heading size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ]
      },
      {
        "type": "range",
        "id": "font_size",
        "label": "Name size",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px",
        "visible_if": "{{ section.settings.design == 'morden' or section.settings.collection_information_position == 'below_image' }}",
        "info": "On the picture, the Default card style takes the theme button size."
      },
      {
        "type": "select",
        "id": "font_weight",
        "label": "Name weight",
        "default": "heading_weight",
        "options": [
          {
            "value": "body_weight",
            "label": "Text"
          },
          {
            "value": "subheading_weight",
            "label": "Subheading"
          },
          {
            "value": "heading_weight",
            "label": "Heading"
          }
        ],
        "visible_if": "{{ section.settings.design == 'morden' or section.settings.collection_information_position == 'below_image' }}",
        "info": "On the picture, the Default card style takes the theme button weight."
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "info": "Display a part of the upcoming slide.",
        "default": false
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Collections per row (mobile)",
        "min": 1,
        "max": 3,
        "step": 0.5,
        "default": 1
      }
    ]
  }
}
</schema>
