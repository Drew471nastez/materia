      "id": "autorotate_speed",
      "label": "Autorotate speed",
      "max": 6,
      "min": 2,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Items per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "collection_information_position",
      "label": "Collection information position",
      "options": [
        {
          "value": "overlay_image",
          "label": "Overlay image"
        },
        {
          "value": "below_image",
          "label": "Below image"
        }
      ],
      "default": "overlay_image"
    },
    {
      "type": "range",
      "id": "information_spacing",
      "label": "Information spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_38",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Items per row mobile",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "morden",
          "label": "Morden"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    }
  ],
  "shopify": {
    "name": "Subcollections",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Colour scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretch width"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Collection list"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Text"
      },
      {
        "type": "checkbox",
        "id": "show_product_count",
        "label": "Show product count"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Collections per row",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between collections",
        "min": 0,
        "max": 50,
        "step": 5,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "select",
