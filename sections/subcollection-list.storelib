        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "select",
        "id": "design",
        "label": "Card style",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "morden",
            "label": "Modern"
          }
        ],
        "default": "default"
      },
      {
        "type": "checkbox",
        "id": "show_arrow",
        "label": "Show arrows",
        "default": false
      },
      {
        "type": "select",
        "id": "carousel_pagination",
        "label": "Pagination",
        "options": [
          {
            "value": "disable",
            "label": "None"
          },
          {
            "value": "show_dots",
