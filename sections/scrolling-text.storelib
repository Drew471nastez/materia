<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes — Scrolling Text.
  A horizontal marquee of large words. Each word is a block and can be SOLID or
  OUTLINE (hollow / stroked). Connected to the theme color scheme + fonts, with
  optional custom font (Shopify font library or a font URL) and optional custom
  colour. Default text colour is black. Mobile-responsive, pause-on-hover, and
  prefers-reduced-motion safe. Filed under the Text Content category.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'

  # Resolve the font-family string: custom URL font > Shopify font picker > theme font.
  assign use_cf = st.use_custom_font
  assign cf = st.custom_font
  assign cf_url = st.custom_font_url
  assign cf_fam = st.custom_font_family
  if use_cf and cf_url != blank and cf_fam != blank
    assign mq_font = "'" | append: cf_fam | append: "', sans-serif"
  elsif use_cf and cf != blank
    assign mq_font = cf.family | append: ', ' | append: cf.fallback_families
  elsif st.base_font == 'body'
    assign mq_font = 'var(--body-font, inherit)'
  else
    assign mq_font = 'var(--heading-font, inherit)'
  endif

  # Resolve text colour: custom (default black) or follow the colour scheme.
  assign mq_color = 'var(--color-text)'
  if st.use_custom_text_color and st.text_color != blank and st.text_color.alpha != 0
    assign mq_color = st.text_color
  endif
  assign mq_weight = st.font_weight | default: 'theme'
  if mq_weight == 'theme'
    if st.base_font == 'body' and use_cf != true
      assign mq_weight = 'var(--body-weight, 400)'
    else
      assign mq_weight = 'var(--heading-weight, 700)'
    endif
  endif
-%}

{%- comment -%} Connect to theme-level scroll-reveal entrance animation. {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- comment -%} Custom @font-face: URL font first, else the chosen Shopify font. {%- endcomment -%}
{%- if use_cf and cf_url != blank and cf_fam != blank -%}
<style>
  @font-face {
    font-family: '{{ cf_fam }}';
    src: url("{{ cf_url }}");
    font-display: swap;
  }
{% comment %}{% endcomment %}</style>
{%- elsif use_cf and cf != blank -%}
{% style %}{{ cf | font_face: font_display: 'swap' }}{% endstyle %}
{%- endif -%}

<style data-rs-bulletproof>
  {%- if st.reset_spacing -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > div {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<style>
  /* Section isolation + theme typography inheritance */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Full-bleed wrapper so the scheme background spans edge to edge */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }

  /* ===== Scrolling Text marquee ===== */
  #shopify-section-{{ section.id }} {
    --stm-gap: {{ st.item_gap_mobile | default: 32 }}px;
    --stm-size: {{ st.text_size_mobile | default: 40 }}px;
    --stm-pt: {{ st.padding_top_mobile | default: 16 }}px;
    --stm-pb: {{ st.padding_bottom_mobile | default: 16 }}px;
    --stm-duration: {{ st.duration | default: 40 }}s;
    --stm-direction: {{ st.direction | default: 'normal' }};
    --stm-pause: {% if st.pause_on_hover %}paused{% else %}running{% endif %};
    --stm-weight: {{ mq_weight }};
    --stm-ls: {{ st.letter_spacing | default: 0 }}px;
    --stm-tt: {{ st.text_transform | default: 'none' }};
    --stm-font: {{ mq_font }};
    --stm-color: {{ mq_color }};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      --stm-gap: {{ st.item_gap | default: 64 }}px;
      --stm-size: {{ st.text_size | default: 80 }}px;
      --stm-pt: {{ st.padding_top | default: 24 }}px;
      --stm-pb: {{ st.padding_bottom | default: 24 }}px;
    }
  }

  #shopify-section-{{ section.id }} .stm__viewport {
    overflow: hidden;
    display: flex;
    gap: var(--stm-gap);
    width: 100%;
    padding-block: var(--stm-pt) var(--stm-pb);
  }
  #shopify-section-{{ section.id }} .stm__track {
    display: flex;
    gap: var(--stm-gap);
    width: max-content;
    flex-shrink: 0;
    animation: stm-scroll-{{ section.id }} var(--stm-duration) linear infinite;
    animation-direction: var(--stm-direction);
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .stm__viewport:hover .stm__track {
    animation-play-state: var(--stm-pause);
  }
  @keyframes stm-scroll-{{ section.id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% - var(--stm-gap))); }
  }
  #shopify-section-{{ section.id }} .stm__item {
    white-space: nowrap;
    flex-shrink: 0;
    font-family: var(--stm-font);
    font-size: var(--stm-size);
    font-weight: var(--stm-weight);
    line-height: 1.05;
    letter-spacing: var(--stm-ls);
    text-transform: var(--stm-tt);
    color: var(--stm-color);
  }

  {%- comment -%} Per-word solid vs. outline + optional colour override. {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- capture c -%}{% render 'scheme-color', color: b.color, fallback: 'var(--stm-color)' %}{%- endcapture -%}
    #shopify-section-{{ section.id }} .stm__item[data-block-id="{{ block.id }}"] {
      {%- if b.use_outline_text -%}
        color: transparent;
        -webkit-text-fill-color: transparent;
        -webkit-text-stroke: {{ b.outline_width | default: 2 }}px {{ c }};
        text-stroke: {{ b.outline_width | default: 2 }}px {{ c }};
      {%- else -%}
        color: {{ c }};
        -webkit-text-fill-color: {{ c }};
      {%- endif -%}
    }
  {%- endfor -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .stm__track { animation: none; }
  }
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .stm { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .stm { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} .stm { padding-inline: 1.5rem; box-sizing: border-box; }
      @media (min-width: 1200px) { #shopify-section-{{ section.id }} .stm { padding-inline: 3rem; } }
  {%- endcase -%}
  {%- unless st.show_on_mobile -%}
    @media (max-width: 767.98px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {%- endunless -%}
{% comment %}{% endcomment %}</style>

<!-- ti-theme:start -->
<div class="stm section color-{{ color_scheme }} gradient {{ st.section_width }}">
  {%- if section.blocks.size > 0 -%}
    <div class="stm__viewport">
      {%- for i in (1..st.repeat_count) -%}
        <div class="stm__track"{% if i > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <span class="stm__item" data-block-id="{{ block.id }}"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="stm__viewport"><div class="stm__track"><span class="stm__item">Add a Word block</span></div></div>
  {%- endif -%}
</div>
<!-- ti-theme:end -->



</template>

<schema>
{
  "type": "scrolling-text",
  "name": "Scrolling Text",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size (desktop)",
      "min": 16,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size (mobile)",
      "min": 12,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -4,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Font"
    },
    {
      "type": "select",
      "id": "base_font",
      "label": "Theme font",
      "default": "heading",
      "options": [
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use a custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "custom_font",
      "label": "Custom font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.use_custom_font }}"
    },
    {
      "type": "text",
      "id": "custom_font_url",
      "label": "Custom font URL",
      "visible_if": "{{ section.settings.use_custom_font }}"
    },
    {
      "type": "text",
      "id": "custom_font_family",
      "label": "Font family name",
      "visible_if": "{{ section.settings.use_custom_font }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Color"
    },
    {
      "type": "checkbox",
      "id": "use_custom_text_color",
      "label": "Use custom text color",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.use_custom_text_color }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Motion"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll duration",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "Higher is slower"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Left"
        },
        {
          "value": "reverse",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between words (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "label": "Gap between words (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Content repeats",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Layout & spacing"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Create."
        },
        {
          "type": "checkbox",
          "id": "use_outline_text",
          "label": "Outline (hollow) text",
          "default": false
        },
        {
          "type": "range",
          "id": "outline_width",
          "label": "Outline thickness",
          "min": 1,
          "max": 8,
          "step": 1,
          "unit": "px",
          "default": 2
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color (optional)"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Scrolling Text",
      "category": "Text",
      "settings": {
        "text_size": 80,
        "text_size_mobile": 40,
        "font_weight": "700",
        "duration": 40,
        "direction": "normal"
      },
      "blocks": [
        {
          "type": "word",
          "settings": {
            "text": "Create.",
            "use_outline_text": false
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Inspire.",
            "use_outline_text": true
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Elevate.",
            "use_outline_text": false
          }
        },
        {
          "type": "word",
          "settings": {
            "text": "Repeat.",
            "use_outline_text": true
          }
        },
        {
          "type": "word",
