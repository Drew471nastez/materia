<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The contact page: a map embed, the store's contact form
  (the theme's contact form tag, which Storelib sends to the creator's
  inbox) and a text column. Live edits: shopify/assets/live-account-pages.js;
  a new map embed code waits for the builder's redraw.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign sid = section.id
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign section_width = section_st.section_width
  assign column_gap = section_st.column_gap
  assign iframe = section_st.iframe
  assign scroll_animation = settings.scroll_animation
  assign custom = section_st.enable_custom_style
  assign st = section_st
-%}
{%- assign fb_accessibility_email = 'accessibility.email' | t -%}
{%- assign fb_accessibility_name = 'accessibility.name' | t -%}
{%- assign fb_accessibility_send = 'accessibility.send' | t -%}
{%- assign fb_accessibility_enter_message = 'accessibility.enter_message' | t -%}
{%- assign fb_accessibility_your_email = 'accessibility.your_email' | t -%}
{%- assign fb_accessibility_your_name = 'accessibility.your_name' | t -%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{{ 'page-contact.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ sid }} .contact-privacy__input {
    width: 1.8rem; height: 1.8rem; flex: none; margin: 0;
    accent-color: var(--btn-primary-bg-color, var(--color-primary));
  }
  #shopify-section-{{ sid }} .contact-privacy { min-height: 44px; }
  #shopify-section-{{ sid }} .form_action:has(.contact-privacy__input:not(:checked)) button[type="submit"] {
    opacity: 0.4;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .form_action button[type="submit"] {
    transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .section__header-heading { color: var(--ap-h-c, var(--color-heading)); }
  #shopify-section-{{ sid }} .contact-container :is(.section__header-des, .contact-privacy__label, .support_customer) { color: var(--ap-t-c, inherit); }
  #shopify-section-{{ sid }} .contact-form__label { display: block; margin-bottom: 6px; }
  #shopify-section-{{ sid }} .contact-form__msg { margin: 0 0 20px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .form_action button[type="submit"] { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list color-{{ color_scheme }} gradient{% if section_st.reset_spacing %} remove_spacing{% endif %}"
  data-ap-root="page-contact"
  data-ap-section="{{ sid }}"
  data-ap-settings="{{ section_st | json | escape }}"
  {% if section_st.reset_spacing %}data-ap-reset{% endif %}
  {% if st.enable_custom_fonts %}data-own-font{% endif %}
  style="--section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --column_gap: {{ column_gap }}px;{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  <div class="{{ section_width }}" data-ap-width>
    {% if iframe != blank %}
      <div class="w-full map rounded mb-50">
        {{ iframe }}
      </div>
    {% endif %}
    <div class="flex flex-wrap contact-container">
      {% for block in section.blocks %}
        {%- liquid
          assign block_st = block.settings
          assign name = block_st.name | default: fb_accessibility_your_name
          assign email = block_st.email | default: fb_accessibility_your_email
          assign your_comment = block_st.your_comment | default: fb_accessibility_enter_message
          assign button_label = block_st.button_label | default: fb_accessibility_send
          assign heading = block_st.heading
          assign description = block_st.description
        -%}
        {% case block.type %}
          {% when 'contact' %}
            <motion-element
              data-motion="fade-up-sm"
              {% if scroll_animation != 'slide_in' %}hold{% endif %}
              data-motion-delay="150"
              class="contact_form flex-1 {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              {%- if scroll_animation != 'none' -%} style="--animation-order: {{ forloop.index0 }};"{% endif %}
              data-ap-block="{{ block.id }}"
              data-ap-type="contact"
              data-ap-settings="{{ block_st | json | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="contact_header">
                <h2 class="section__header-heading h4 heading-letter-spacing mt-0" data-ap-btext="heading"{% if heading == blank %} hidden{% endif %}>{{ heading }}</h2>
                <div class="section__header-des rich__text-m0 mb-25" data-ap-brich="description"{% if description == blank %} hidden{% endif %}>{{ description }}</div>
              </div>
              {% form 'contact' %}
                {% if form.posted_successfully? %}
                  <p class="success ap__msg contact-form__msg" role="status">
                    <svg width="18" height="18" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"><path d="m6.033 8.992 1.972 1.98 3.952-3.96"/><circle cx="9" cy="9" r="7.5"/></g></svg>
                    <span data-ap-btext="success_message">{{ block_st.success_message | escape }}</span>
                  </p>
                {% elsif form.errors %}
                  <div class="error ap__msg contact-form__msg" role="alert">
                    {%- render 'icon-error' -%}
                    <div><span data-ap-btext="error_message">{{ block_st.error_message | escape }}</span>{{ form.errors | default_errors }}</div>
                  </div>
                {% endif %}
                <div class="flex flex-cols flex-wrap gap-20" style="--col-number: 1; --col-desktop: 2;">
                  <div class="full-name flex-1 form-floating">
                    <input
                      type="text"
                      class="form-input form-input-placeholder w-full form-control"
                      name="contact[name]"
                      {% if form.name %}value="{{ form.name }}"{% elsif customer %}value="{{ customer.name }}"{% endif %}
                      id="ContactName-{{ sid }}-{{ block.id }}"
                      autocomplete="name"
                      required
                      placeholder="{{ name }}"
                      data-ap-bph="name"
                    >
                    <label class="field__label" for="ContactName-{{ sid }}-{{ block.id }}" data-ap-btext="name">{{ name | default: fb_accessibility_name }}</label>
                  </div>
                  <div class="email flex-1 form-floating">
                    <input
                      type="email"
                      name="contact[email]"
                      placeholder="{{ email }}"
                      class="form-input form-input-placeholder w-full form-control"
                      id="ContactEmail-{{ sid }}-{{ block.id }}"
                      autocomplete="email"
                      required
                      data-ap-bph="email"
                    >
                    <label class="field__label" for="ContactEmail-{{ sid }}-{{ block.id }}" data-ap-btext="email">{{ email | default: fb_accessibility_email }}</label>
                  </div>
                </div>
                <div class="form-floating textarea">
                  <textarea
                    class="w-full form-control"
                    name="contact[body]"
                    placeholder="{{ your_comment }}"
                    id="ContactBody-{{ sid }}-{{ block.id }}"
                    data-ap-bph="your_comment"
                  ></textarea>
                  <label class="form__label" for="ContactBody-{{ sid }}-{{ block.id }}" data-ap-btext="your_comment">{{ your_comment }}</label>
                </div>
                <div class="form_action">
                  <div class="contact-privacy flex gap-10 align-center mt-20" data-ap-bshow="show_privacy"{% unless block_st.show_privacy %} hidden{% endunless %}>
                    <input type="checkbox" class="contact-privacy__input" id="ContactPrivacy-{{ sid }}-{{ block.id }}"{% if block_st.show_privacy %} required{% endif %}>
                    <label class="contact-privacy__label" for="ContactPrivacy-{{ sid }}-{{ block.id }}" data-ap-brich="privacy_text">{{ block_st.privacy_text }}</label>
                  </div>
                  <button class="block btn btn-primary mt-30" data-theme-button="primary" data-sl-button type="submit" data-ap-btext="button_label">{{ button_label }}</button>
                </div>
              {% endform %}
            </motion-element>
          {% when 'text_block' %}
            <motion-element
              data-motion="fade-up-sm"
              {% if scroll_animation != 'slide_in' %}hold{% endif %}
              data-motion-delay="150"
              class="support_customer w-full {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              {%- if scroll_animation != 'none' -%} style="--animation-order: {{ forloop.index0 }};"{% endif %}
              data-ap-block="{{ block.id }}"
              data-ap-type="text_block"
              data-ap-settings="{{ block_st | json | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="contact_header">
                <h2 class="section__header-heading h4 heading-letter-spacing mt-0" data-ap-btext="heading_text_block"{% if block_st.heading_text_block == blank %} hidden{% endif %}>{{ block_st.heading_text_block }}</h2>
                <div class="section__header-des" data-ap-brich="description_text_block"{% if block_st.description_text_block == blank %} hidden{% endif %}>{{ block_st.description_text_block }}</div>
              </div>
              <div class="support_customer__content" data-ap-brich="content"{% if block_st.content == blank %} hidden{% endif %}>{{ block_st.content }}</div>
            </motion-element>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
<script src="{{ 'contact.js' | asset_url }}" defer="defer"></script>
</template>

<schema>
{
  "type": "page-contact",
  "name": "Page contact",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "textarea",
      "id": "iframe",
      "label": "Iframe",
      "default": "<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d50941.0851952626!2d-95.78197131269138!3d37.06182424549097!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b778b9da9b5b1f%3A0x3df3aefa017361ac!2sFawn%20Creek%20Township%2C%20KS%2C%20USA!5e0!3m2!1sen!2s!4v1666059952368!5m2!1sen!2s\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "General"
        },
        {
          "type": "checkbox",
          "id": "show_privacy",
          "label": "Show privacy",
          "default": true
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "your_comment",
          "label": "Your comment"
        },
        {
          "type": "header",
          "id": "hdr_10",
          "label": "Buttons"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        }
      ],
      "limit": 1
    },
    {
      "type": "text_block",
      "name": "Text block",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading_text_block",
          "label": "Heading text block"
        },
        {
          "type": "richtext",
          "id": "description_text_block",
          "label": "Description text block"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ],
      "limit": 1
    }
  ],
  "shopify": {
    "name": "Contact page",
    "tag": "section",
    "class": "overlay-section contact-us",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "textarea",
        "id": "iframe",
        "label": "Map embed code",
        "info": "Paste the embed code from Google Maps (Share > Embed a map)."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between columns",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "contact",
        "name": "Contact form",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Text"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name field label",
            "info": "Empty: Your name"
          },
          {
            "type": "text",
            "id": "email",
            "label": "Email field label",
            "info": "Empty: Your email"
          },
          {
            "type": "text",
            "id": "your_comment",
            "label": "Message field label",
            "info": "Empty: Enter your message"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Button label",
            "info": "Empty: Send"
          },
          {
            "type": "checkbox",
            "id": "show_privacy",
            "label": "Ask to agree to the privacy policy",
            "default": true
          },
          {
            "type": "inline_richtext",
            "id": "privacy_text",
            "label": "Privacy text",
            "default": "I agree to the <a href=\"/policies/privacy-policy\" title=\"Privacy Policy\">privacy policy</a>.",
            "visible_if": "{{ block.settings.show_privacy }}"
          },
          {
            "type": "header",
            "content": "Messages"
          },
          {
            "type": "text",
            "id": "success_message",
            "label": "Success message",
            "default": "Thanks for your message. We will reply soon."
          },
          {
            "type": "text",
            "id": "error_message",
            "label": "Error message",
            "default": "Your message was not sent. Check the fields and try again."
          }
        ]
      },
      {
        "type": "text_block",
        "name": "Text",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading_text_block",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "description_text_block",
            "label": "Intro"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Text"
          }
        ]
      }
    ]
  }
}
</schema>
