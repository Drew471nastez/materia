<template compat="shopify">
{%- assign fb_accessibility_email = 'accessibility.email' | t -%}
{%- assign fb_accessibility_name = 'accessibility.name' | t -%}
{%- assign fb_accessibility_send = 'accessibility.send' | t -%}
{%- assign fb_accessibility_enter_message = 'accessibility.enter_message' | t -%}
{%- assign fb_accessibility_your_email = 'accessibility.your_email' | t -%}
{%- assign fb_accessibility_your_name = 'accessibility.your_name' | t -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'page-contact.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign heading = section_st.heading
  assign description = section_st.description
  assign column_gap = section_st.column_gap
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign iframe = section_st.iframe
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  --column_gap: {{ column_gap }}px;
{%- endcapture -%}
<div
  class="section sec__collection-list color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {% if iframe != null %}
      <div class=" w-full map rounded mb-50" style="{{ style | strip | strip_newlines }}">
        {{ iframe }}
      </div>
    {% endif %}
    <div class="flex flex-wrap contact-container">
      {% for block in section.blocks %}
        {%- liquid
          assign block_st = block.settings
          assign name = block_st.name | default: fb_accessibility_your_name
          assign email = block_st.email | default: fb_accessibility_your_email
          assign your_comment = block_st.your_comment | default: fb_accessibility_enter_message
          assign button_label = block_st.button_label | default: fb_accessibility_send
          assign show_privacy = block_st.show_privacy
          assign heading = block_st.heading
          assign description = block_st.description
          assign heading_text_block = block_st.heading_text_block
          assign description_text_block = block_st.description_text_block
          assign content = block_st.content
        -%}
        {% case block.type %}
          {% when 'contact' %}
            <motion-element
              data-motion="fade-up-sm"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              data-motion-delay="150"
              class="contact_form flex-1 {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              {%- if scroll_animation != 'none' -%}
                style="--animation-order: {{ forloop.index0 }};"
              {% endif %}
            >
              <div class="contact_header">
                {% if heading != blank %}
                  <h3 class="section__header-heading h4 heading-letter-spacing mt-0">{{ heading }}</h3>
                {% endif %}
                {% if description != blank %}
                  <div class="section__header-des rich__text-m0 mb-25">
                    {{ description }}
                  </div>
                {% endif %}
              </div>
              {% form 'contact' %}
                {% if form.posted_successfully? %}
                  <p class="success inline-flex gap-10 align-center lh-normal">
                    <svg width="18" height="18" fill="none">
                      <g stroke="#137F24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"><path d="m6.033 8.992 1.972 1.98 3.952-3.96"/><path d="M7.973 1.178c.565-.482 1.49-.482 2.062 0l1.293 1.113c.245.213.704.385 1.03.385h1.392c.867 0 1.579.712 1.579 1.579v1.39c0 .32.172.786.384 1.032l1.113 1.292c.483.565.483 1.49 0 2.062l-1.113 1.293a1.813 1.813 0 0 0-.384 1.03v1.392c0 .867-.712 1.579-1.58 1.579h-1.39c-.32 0-.786.172-1.031.384l-1.293 1.113c-.564.483-1.489.483-2.062 0L6.681 15.71a1.813 1.813 0 0 0-1.031-.384H4.234c-.867 0-1.579-.712-1.579-1.58v-1.398c0-.32-.172-.778-.376-1.023l-1.105-1.301c-.474-.565-.474-1.48 0-2.045L2.28 6.677c.204-.246.376-.704.376-1.023V4.247c0-.868.712-1.58 1.58-1.58H5.65c.319 0 .785-.171 1.03-.384l1.293-1.105Z"/></g>
                    </svg>
                    {{ 'general.contact.success' | t }}
                  </p>
                {% else %}
                  {{ form.errors | default_errors }}
                {% endif %}
                <div
                  class="flex flex-cols flex-wrap gap-20"
                  style="
                    --col-number: 1;
                    --col-desktop: 2;
                  "
                >
                  <div class="full-name flex-1 form-floating">
                    <input
                      type="text"
                      class="form-input form-input-placeholder w-full form-control"
                      name="contact[name]"
                      {% if form.name %}
                        value="{{ form.name }}"
                      {% elsif customer %}
                        value="{{ customer.name }}"
                      {% endif %}
                      id="inputName"
                      required
                      placeholder="{{ name }}"
                    >
                    <label class="field__label" for="customer_email">
                      {{ name | default: fb_accessibility_name }}
                    </label>
                  </div>
                  <div class="email flex-1 form-floating">
                    <input
                      type="email"
                      name="contact[email]"
                      placeholder="{{  email }}"
                      class="form-input form-input-placeholder w-full form-control"
                      id="email"
                      required
                    >
                    <label class="field__label" for="customer_email">
                      {{ email | default: fb_accessibility_email }}
                    </label>
                  </div>
                </div>
                <div class="form-floating textarea">
                  <textarea
                    class="w-full form-control"
                    name="contact[body]"
                    placeholder="{{ your_comment }}"
                    id="message"
                  ></textarea>
                  <label class="form__label" for="message">
                    {{ your_comment | default:  'Your_comment' }}
                  </label>
               </div>
                <div class="form_action">
                  <button
                    class="block btn btn-primary mt-30"
                    type="submit"
                  >
                    {{ button_label }}
                  </button>
                </div>
              {% endform %}
            </motion-element>
          {% when 'text_block' %}
            <motion-element
              data-motion="fade-up-sm"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              data-motion-delay="150"
              class="support_customer w-full {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              {%- if scroll_animation != 'none' -%}
                style="--animation-order: {{ forloop.index0 }};"
              {% endif %}
            >
              <div class="contact_header">
                {% if heading_text_block != blank %}
                  <h3 class="section__header-heading h4 heading-letter-spacing mt-0">{{ heading_text_block }}</h3>
                {% endif %}
                {% if description_text_block != blank %}
                  <p class="section__header-des">
                    {{ description_text_block }}
                  </p>
                {% endif %}
              </div>
              {% if content != blank %}
                {{ content }}
              {% endif %}
            </motion-element>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
<script src="{{ 'contact.js' | asset_url }}" defer="defer"></script>



</template>

<schema>
{
  "type": "page-contact",
  "name": "Page contact",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "textarea",
      "id": "iframe",
      "label": "Iframe",
      "default": "<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d50941.0851952626!2d-95.78197131269138!3d37.06182424549097!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b778b9da9b5b1f%3A0x3df3aefa017361ac!2sFawn%20Creek%20Township%2C%20KS%2C%20USA!5e0!3m2!1sen!2s!4v1666059952368!5m2!1sen!2s\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "General"
        },
        {
          "type": "checkbox",
          "id": "show_privacy",
          "label": "Show privacy",
          "default": true
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "your_comment",
          "label": "Your comment"
        },
        {
          "type": "header",
          "id": "hdr_10",
          "label": "Buttons"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        }
      ],
      "limit": 1
    },
    {
      "type": "text_block",
      "name": "Text block",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "heading_text_block",
          "label": "Heading text block"
        },
        {
          "type": "richtext",
          "id": "description_text_block",
          "label": "Description text block"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ],
      "limit": 1
    }
  ],
  "shopify": {
    "name": "t:sections.contact.name",
    "tag": "section",
    "class": "overlay-section contact-us",
    "limit": 1,
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.color_scheme.label",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:sections.all.section_width.label",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "textarea",
        "id": "iframe",
        "label": "t:sections.contact.settings.iframe.label",
        "default": "<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d50941.0851952626!2d-95.78197131269138!3d37.06182424549097!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b778b9da9b5b1f%3A0x3df3aefa017361ac!2sFawn%20Creek%20Township%2C%20KS%2C%20USA!5e0!3m2!1sen!2s!4v1666059952368!5m2!1sen!2s\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>"
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "t:sections.all.items.column_gap.label",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 100,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.all.section_padding.top.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.all.section_padding.bottom.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "contact",
        "name": "t:sections.contact.name",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "General"
          },
          {
            "type": "checkbox",
            "id": "show_privacy",
            "label": "t:sections.contact.block.contact.settings.show_privacy.label",
            "default": true
          },
          {
            "type": "header",
            "content": "Section Header"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "t:sections.all.section_header.heading.label"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.all.section_header.description.label"
          },
          {
            "type": "text",
            "id": "name",
            "label": "t:sections.contact.block.contact.settings.name.label"
          },
          {
            "type": "text",
            "id": "email",
            "label": "t:sections.contact.block.contact.settings.email.label"
          },
          {
            "type": "text",
            "id": "your_comment",
            "label": "t:sections.contact.block.contact.settings.your_comment.label"
          },
          {
            "type": "header",
            "content": "Buttons"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "t:sections.contact.block.contact.settings.button_label.label"
          }
        ]
      },
      {
        "type": "text_block",
        "name": "t:sections.contact.block.text_block.label",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading_text_block",
            "label": "t:sections.all.section_header.heading.label"
          },
          {
            "type": "richtext",
            "id": "description_text_block",
            "label": "t:sections.all.section_header.description.label"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "t:sections.contact.block.text_block.settings.content.label"
          }
        ]
      }
    ]
  }
}
</schema>
