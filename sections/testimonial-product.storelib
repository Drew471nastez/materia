<template compat="shopify">
<script src="{{ 'live-r7-testimonials.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign fonts = st.enable_custom_fonts
  assign scroll_anim = settings.scroll_animation | default: 'none'
  assign cards = section.blocks | where: 'type', 'testimonial'
  assign total = cards.size
  assign per_view = st.cards_desktop | default: 3
  assign per_view_tablet = per_view | at_most: 2
  assign per_view_mobile = 1
  if st.mobile_peek
    assign per_view_mobile = 1.15
  endif
  assign region_label = 'Customer quotes'
  for b in section.blocks
    if b.type == 'heading' and b.settings.text != blank
      assign region_label = b.settings.text | strip_html
      break
    endif
  endfor
-%}
{%- comment -%}
  Materia Themes. Testimonial With Product.

  Eyebrow, heading and subheading blocks over one row of quote cards. Each
  testimonial block is a customer's words (stars only when a rating is set,
  picture, name, a line under the name) and the product they bought, picked
  from the store: its picture, title and price, linked to the product page.
  Nothing about the product is typed. With no product picked the builder
  shows where it goes and the storefront shows the quote alone.
  The row is a native scroller: a finger, a trackpad or the arrow keys move
  it and it snaps card by card; the arrows and the progress line are run by
  assets/live-r7-testimonials.js, which also applies the builder's live
  edits. Button blocks sit under the row as theme buttons. Colours follow
  the colour scheme and fonts follow Theme settings > Typography until
  custom styling or custom fonts are switched on.
{%- endcomment -%}
{%- if scroll_anim != blank and scroll_anim != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'r7-testimonial-base', sid: sid %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .r7p { --r7p-n: var(--r7p-pv-m); }
  #shopify-section-{{ sid }} .r7p__track { display: flex; gap: var(--r7t-gap); margin-inline: calc(var(--r7t-pad) * -1); padding-inline: var(--r7t-pad); scroll-padding-inline: var(--r7t-pad); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scrollbar-width: none; touch-action: pan-x pan-y; }
  #shopify-section-{{ sid }} .r7p__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .r7p__track:focus-visible { outline: 2px solid var(--r7t-name-c); outline-offset: -2px; }
  #shopify-section-{{ sid }} .r7p__card { flex: 0 0 calc((100% - var(--r7t-gap) * (var(--r7p-n) - 1)) / var(--r7p-n)); scroll-snap-align: start; }
  #shopify-section-{{ sid }} .r7p__product { display: flex; align-items: center; align-self: stretch; gap: 12px; min-height: 44px; margin-top: auto; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--r7t-text) 18%, transparent); color: var(--r7t-text); text-decoration: none; transition: opacity .15s ease; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} a.r7p__product:active { opacity: .7; }
  #shopify-section-{{ sid }} a.r7p__product:focus-visible { outline: 2px solid var(--r7t-name-c); outline-offset: 4px; }
  #shopify-section-{{ sid }} .r7p__pic { flex: 0 0 56px; width: 56px; height: 56px; overflow: hidden; border-radius: min(var(--r7t-radius), 8px); background: color-mix(in srgb, var(--r7t-text) 10%, transparent); color: color-mix(in srgb, var(--r7t-text) 45%, transparent); }
  #shopify-section-{{ sid }} .r7p__pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .r7p__pic svg { display: block; width: 24px; height: 24px; margin: 16px; }
  #shopify-section-{{ sid }} .r7p__ptext { display: flex; flex: 1 1 auto; flex-direction: column; gap: 2px; min-width: 0; }
  #shopify-section-{{ sid }} .r7p__ptitle { color: var(--r7t-name-c); font-size: 14px; font-weight: 600; line-height: 1.3; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  #shopify-section-{{ sid }} .r7p__price { font-size: 13px; line-height: 1.3; }
  #shopify-section-{{ sid }} .r7p__price s { margin-inline-end: 6px; opacity: .7; }
  #shopify-section-{{ sid }} .r7p__soldout { margin-inline-start: 6px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  #shopify-section-{{ sid }} .r7p__go { flex: 0 0 auto; width: 16px; height: 16px; color: var(--r7t-name-c); transition: transform .2s ease; }
  [dir="rtl"] #shopify-section-{{ sid }} .r7p__go, [dir="rtl"] #shopify-section-{{ sid }} .r7p__arrow svg { transform: scaleX(-1); }
  #shopify-section-{{ sid }} .r7p__product--empty { font-size: 13px; line-height: 1.35; }
  #shopify-section-{{ sid }} .r7p__nav { display: flex; align-items: center; gap: 20px; margin-top: 20px; }
  #shopify-section-{{ sid }} .r7p[data-arrows="false"][data-progress="false"] .r7p__nav { display: none; }
  #shopify-section-{{ sid }} .r7p__bar { position: relative; flex: 1 1 auto; height: 2px; overflow: hidden; border-radius: 2px; background: color-mix(in srgb, var(--r7t-text) 22%, transparent); }
  #shopify-section-{{ sid }} .r7p[data-progress="false"] .r7p__bar { visibility: hidden; }
  #shopify-section-{{ sid }} .r7p__fill { position: absolute; inset: 0; background: var(--r7t-name-c); transform-origin: left center; transform: scaleX(var(--r7p-f, calc(var(--r7p-n) / var(--r7p-count)))); }
  [dir="rtl"] #shopify-section-{{ sid }} .r7p__fill { transform-origin: right center; }
  #shopify-section-{{ sid }} .r7p__arrows { display: flex; flex: 0 0 auto; gap: 8px; }
  #shopify-section-{{ sid }} .r7p[data-arrows="false"] .r7p__arrows { display: none; }
  #shopify-section-{{ sid }} .r7p__arrow { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: 0; padding: 0; border: 1px solid var(--r7t-card-border); border-radius: 50%; background: transparent; color: var(--r7t-name-c); cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color .2s ease, color .2s ease, border-color .2s ease, opacity .2s ease; }
  #shopify-section-{{ sid }} .r7p__arrow svg { display: block; width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .r7p__arrow:active:not(:disabled) { background: var(--r7t-name-c); color: var(--r7t-bg); border-color: var(--r7t-name-c); }
  #shopify-section-{{ sid }} .r7p__arrow:disabled { opacity: .35; cursor: default; }
  #shopify-section-{{ sid }} .r7p__arrow:focus-visible { outline: 2px solid var(--r7t-name-c); outline-offset: 2px; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .r7p__arrow:hover:not(:disabled) { background: var(--r7t-name-c); color: var(--r7t-bg); border-color: var(--r7t-name-c); }
    #shopify-section-{{ sid }} a.r7p__product:hover .r7p__ptitle { text-decoration: underline; text-underline-offset: 2px; }
    #shopify-section-{{ sid }} a.r7p__product:hover .r7p__go { transform: translateX(3px); }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .r7p[data-fit-m="true"] .r7p__nav { display: none; }
    #shopify-section-{{ sid }} .r7p[data-fit-m="true"][data-align="center"] .r7p__track { justify-content: center; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .r7p { --r7p-n: var(--r7p-pv-t); }
    #shopify-section-{{ sid }} .r7p__nav { margin-top: 28px; }
  }
  @media (min-width: 768px) and (max-width: 989px) {
    #shopify-section-{{ sid }} .r7p[data-fit-t="true"] .r7p__nav { display: none; }
    #shopify-section-{{ sid }} .r7p[data-fit-t="true"][data-align="center"] .r7p__track { justify-content: center; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .r7p { --r7p-n: var(--r7p-pv); }
    #shopify-section-{{ sid }} .r7p[data-fit-d="true"] .r7p__nav { display: none; }
    #shopify-section-{{ sid }} .r7p[data-fit-d="true"][data-align="center"] .r7p__track { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .r7p__arrow, #shopify-section-{{ sid }} .r7p__go, #shopify-section-{{ sid }} .r7p__product { transition: none; }
    #shopify-section-{{ sid }} .r7p__track { scroll-behavior: auto; }
  }
{% comment %}{% endcomment %}</style>
<div class="r7t r7p color-{{ color_scheme }} gradient" data-r7t-root="testimonial-product" data-section-id="{{ sid }}"{% if request.design_mode %} data-r7t-settings="{{ st | json | escape }}"{% endif %} data-card="{{ st.card_style | default: 'filled' }}" data-align="{{ st.text_align | default: 'left' }}" data-arrows="{% if st.show_arrows %}true{% else %}false{% endif %}" data-progress="{% if st.show_progress %}true{% else %}false{% endif %}" data-fit-m="{% if total <= 1 %}true{% else %}false{% endif %}" data-fit-t="{% if total <= per_view_tablet %}true{% else %}false{% endif %}" data-fit-d="{% if total <= per_view %}true{% else %}false{% endif %}" data-reset="{% if st.reset_spacing %}true{% else %}false{% endif %}"{% if fonts %} data-own-font{% endif %} style="{% render 'r7-testimonial-vars', st: st %}--r7p-pv: {{ per_view }};--r7p-pv-t: {{ per_view_tablet }};--r7p-pv-m: {{ per_view_mobile }};--r7p-count: {{ total | at_least: 1 }};">
  <div class="r7t__frame" data-width="{{ st.section_width | default: 'container' }}">
    {% render 'r7-testimonial-head', section: section %}

    {%- if total > 0 -%}
      <div class="r7p__track" data-r7t-track tabindex="0" role="region" aria-label="{{ region_label | escape }}">
        {%- for b in cards -%}
          {%- assign bs = b.settings -%}
          {%- assign p = bs.product -%}
          <div class="r7t-card r7p__card" data-r7t-block="{{ b.id }}" data-r7t-type="testimonial"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %} {{ b.shopify_attributes }}>
            {% render 'r7-testimonial-quote', bs: bs %}
            {%- if p != blank -%}
              <a class="r7p__product" href="{{ p.url }}" data-r7t-product>
                <span class="r7p__pic">
                  {%- if p.featured_image != blank -%}
                    <img src="{{ p.featured_image | image_url: width: 168 }}" alt="" width="56" height="56" loading="lazy" decoding="async">
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {%- endif -%}
                </span>
                <span class="r7p__ptext">
                  <span class="r7p__ptitle">{{ p.title | escape }}</span>
                  <span class="r7p__price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}{{ p.price | money }}{%- unless p.available -%}<span class="r7p__soldout">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}</span>
                </span>
                <svg class="r7p__go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            {%- elsif request.design_mode -%}
              <div class="r7p__product r7p__product--empty" data-r7t-product>
                <span class="r7p__pic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></span>
                <span class="r7p__ptext">Pick the product this customer bought. Its picture, title and price show here.</span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="r7p__nav">
        <div class="r7p__bar" aria-hidden="true"><span class="r7p__fill" data-r7t-fill></span></div>
        <div class="r7p__arrows">
          <button type="button" class="r7p__arrow" data-r7t-prev aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button type="button" class="r7p__arrow" data-r7t-next aria-label="{{ 'accessibility.next' | t | default: 'Next' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      </div>
    {%- endif -%}

    <div class="r7t__actions">
      {%- for b in section.blocks -%}
        {%- if b.type != 'button' -%}{%- continue -%}{%- endif -%}
        {%- assign bs = b.settings -%}
        {% render 'r7-testimonial-button', b: b, bs: bs %}
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "shopify": {
    "name": "Testimonial With Product",
    "tag": "section",
    "class": "section-testimonial-product",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "Heading alignment",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "cards_desktop",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Cards in view (desktop)",
        "default": 3,
        "info": "Tablets show two cards at most."
      },
      {
        "type": "range",
        "id": "card_gap",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Gap between cards",
        "default": 20
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Card style",
        "default": "filled",
        "options": [
          {
            "value": "filled",
            "label": "Filled"
          },
          {
            "value": "outline",
            "label": "Outline"
          },
          {
            "value": "plain",
            "label": "Line"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show arrows",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_progress",
        "label": "Show progress line",
        "default": true
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme and corners follow Theme settings."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style == 'filled' }}"
      },
      {
        "type": "color",
        "id": "card_border_color",
        "label": "Card line",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style != 'filled' }}"
      },
      {
        "type": "color",
        "id": "quote_color",
        "label": "Quote",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "name_color",
        "label": "Name",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Filled star",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_empty_color",
        "label": "Empty star",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Card corner radius",
        "default": 12,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading and name font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "quote_size",
        "min": 13,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Quote size (desktop)",
        "default": 16
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses Theme settings > Animations."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Top padding",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding",
        "default": 60
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Top margin (desktop)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Bottom margin (desktop)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "checkbox",
        "id": "mobile_peek",
        "label": "Show part of the next card",
        "default": true,
        "info": "A hint that the row swipes."
      },
      {
        "type": "range",
        "id": "quote_size_mobile",
        "min": 13,
        "max": 22,
        "step": 1,
        "unit": "px",
        "label": "Quote size (mobile)",
        "default": 15
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Top padding (mobile)",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding (mobile)",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Top margin (mobile)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Bottom margin (mobile)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Eyebrow text",
            "default": "Customer picks"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "What they bought, in their words"
          },
          {
            "type": "range",
            "id": "size",
            "min": 20,
            "max": 72,
            "step": 1,
            "unit": "px",
            "label": "Font size (desktop)",
            "default": 40
          },
          {
            "type": "range",
            "id": "size_mobile",
            "min": 16,
            "max": 48,
            "step": 1,
            "unit": "px",
            "label": "Font size (mobile)",
            "default": 26
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Subheading",
            "default": "<p>Put each quote beside the product the customer bought, so the next shopper can find it.</p>"
          },
          {
            "type": "range",
            "id": "size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Font size",
            "default": 16
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product",
            "info": "The product this customer bought. Its picture, title and price come from your store."
          },
          {
            "type": "textarea",
            "id": "body",
            "label": "Quote",
            "default": "Paste what this customer said about the product you pick above.",
            "info": "Paste the customer's own words."
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Customer name"
          },
          {
            "type": "text",
            "id": "role",
            "label": "Line under the name",
            "default": "",
            "info": "For example the city, or what they bought."
          },
          {
            "type": "range",
            "id": "rating",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "label": "Star rating",
            "default": 0,
            "info": "0 shows no stars. Use the rating your customer gave."
          },
          {
            "type": "image_picker",
            "id": "avatar",
            "label": "Customer picture"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Shop all products"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: the button follows Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_hover",
            "label": "Text (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonial With Product",
        "category": "Testimonials",
        "blocks": [
          {
            "type": "eyebrow"
          },
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          }
        ]
      }
    ]
  }
}
