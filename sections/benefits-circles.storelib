    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Why people love it"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              }
            ],
            "visible_if": "{{ false }}",
            "info": "Legacy: the heading is an h2.",
            "hidden": true
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: colour, size, weight and spacing follow the theme."
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "default": "#0F172A",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 48,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 30,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.2,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -3,
            "max": 7,
            "step": 0.1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Four simple reasons customers come back.</p>"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 900,
            "step": 10,
            "unit": "px",
            "default": 580
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: colour and size follow the theme."
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "default": "#475569",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "circle",
        "name": "Circle",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "label",
            "label": "Label",
            "default": "Quality you can feel"
          },
          {
            "type": "inline_richtext",
            "id": "sublabel",
            "label": "Sublabel (optional)"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link target"
          },
          {
            "type": "select",
            "id": "icon_type",
            "label": "Icon source",
            "default": "preset",
            "options": [
              {
                "value": "preset",
                "label": "Built-in icon"
              },
              {
                "value": "svg",
                "label": "Custom SVG"
              },
              {
                "value": "image",
                "label": "Image upload"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon_preset",
            "label": "Built-in icon",
            "default": "check",
            "options": [
              {
                "value": "check",
                "label": "Check"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
              {
                "value": "shield",
                "label": "Shield"
              },
              {
                "value": "truck",
                "label": "Truck"
              },
              {
                "value": "package",
                "label": "Package"
              },
              {
                "value": "leaf",
                "label": "Leaf"
              },
              {
                "value": "gift",
                "label": "Gift"
              },
              {
                "value": "clock",
                "label": "Clock"
              },
              {
                "value": "sparkle",
                "label": "Sparkle"
              },
              {
                "value": "zap",
                "label": "Lightning"
              },
              {
                "value": "refresh",
                "label": "Refresh / Recycle"
              },
              {
                "value": "sun",
                "label": "Sun"
              },
              {
                "value": "thumbs-up",
                "label": "Thumbs up"
              },
              {
                "value": "award",
                "label": "Award"
              },
              {
                "value": "lock",
                "label": "Lock"
              },
              {
                "value": "globe",
                "label": "Globe"
              },
              {
                "value": "message",
                "label": "Message"
              }
            ],
            "visible_if": "{{ block.settings.icon_type == 'preset' }}"
          },
          {
            "type": "image_picker",
            "id": "icon_image",
            "label": "Image (when Image)",
            "visible_if": "{{ block.settings.icon_type == 'image' }}"
          },
          {
            "type": "html",
            "id": "icon_svg",
            "label": "Custom SVG (when SVG)",
            "info": "Paste raw <svg>…</svg>.",
            "visible_if": "{{ block.settings.icon_type == 'svg' }}"
          },
          {
            "type": "checkbox",
            "id": "icon_fill_circle",
            "label": "Image fills circle (cover)",
            "default": false,
            "visible_if": "{{ block.settings.icon_type == 'image' }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "icon_color",
            "label": "Icon color override",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "circle_bg",
            "label": "Circle background override",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "circle_border_color",
            "label": "Circle border color override",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Benefits Circles",
        "category": "Features",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "circle",
            "settings": {
              "icon_preset": "shield",
              "label": "Built to last"
            }
          },
          {
            "type": "circle",
            "settings": {
              "icon_preset": "leaf",
              "label": "Naturally made"
            }
          },
          {
            "type": "circle",
            "settings": {
              "icon_preset": "truck",
              "label": "Quick delivery"
            }
          },
          {
            "type": "circle",
            "settings": {
              "icon_preset": "heart",
              "label": "Made with care"
            }
          }
        ]
