        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "label_size_mobile",
        "label": "Label size (mobile)",
        "min": 10,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 14,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
