<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Runtime, loaded once per page by layout/theme.storelib: shopify/assets/live-features-a.js. {%- endcomment -%}
{%- comment -%}
  Materia Themes. Benefits Circles: a heading, a short text and a row of
  round icon badges, each with a label, an optional second line and link.
  Colours, sizes and weights follow the colour scheme and the theme until
  Enable custom styling is on (the section's and each block's own); fonts
  until Use custom fonts is on. Values are CSS variables on the root and
  the blocks, worked out again by live-features-a.js when a setting changes
  in the builder.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign icon_names = 'check,star,heart,shield,truck,package,leaf,gift,clock,sparkle,zap,refresh,sun,thumbs-up,award,lock,globe,message' | split: ','
  assign align = st.header_align | default: 'center'
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.reset_spacing -%}
<style data-rs-bulletproof>
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} > section { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section, .shopify-section + #shopify-section-{{ section.id }} { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{% render 'features-a-root', section: section, part: 'css' %}
{% render 'features-a-root', section: section, part: 'fonts' %}
<style>
  :is(#_, .bcir[data-show="desktop"]) { display: none; }
  :is(#_, .bcir) .bcir__inner.fa-inner { max-width: var(--bcir-w-m); }
  :is(#_, .bcir) .bcir__header { display: flex; flex-direction: column; align-items: var(--bcir-flex); text-align: var(--bcir-align); gap: var(--bcir-hs-m); margin: 0 auto var(--bcir-hgap-m); width: 100%; }
  :is(#_, .bcir) .bcir__header:not(:has(> :not([hidden]))) { display: none; }
  :is(#_, .bcir) .bcir__heading { margin: 0; color: var(--bcir-h-color); font-size: var(--bcir-h-m); }
  :is(#_, .bcir) .bcir__heading[data-own-weight] { font-weight: var(--bcir-h-w); }
  :is(#_, .bcir) .bcir__heading[data-own-size] { line-height: var(--bcir-h-lh); letter-spacing: var(--bcir-h-ls); }
  :is(#_, .bcir) .bcir__sub { margin: 0; color: var(--bcir-s-color); font-size: var(--bcir-s-size); line-height: var(--bcir-s-lh); max-width: var(--bcir-s-max); }
  :is(#_, .bcir) .bcir__sub > * { margin: 0; }
  :is(#_, .bcir) .bcir__row { position: relative; display: grid; grid-template-columns: repeat(var(--bcir-cols-m), minmax(0, 1fr)); gap: var(--bcir-row-m) var(--bcir-col-m); align-items: start; justify-items: center; }
  :is(#_, .bcir) .bcir__cell { width: 100%; max-width: var(--bcir-item-max); position: relative; z-index: 1; display: flex; justify-content: center; }
  :is(#_, .bcir) .bcir__item { display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%; color: inherit; text-decoration: none; }
  :is(#_, .bcir) a.bcir__item:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 6px; border-radius: 4px; }
  :is(#_, .bcir) .bcir__circle { width: var(--bcir-c-m); max-width: 100%; aspect-ratio: 1; border-radius: 999px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--bcir-c-bg, var(--bcir-c-bg-s)); border: var(--bcir-bw) solid var(--bcir-c-border, var(--bcir-c-border-s)); color: var(--bcir-c-icon, var(--bcir-c-icon-s)); box-shadow: var(--bcir-shadow); background-clip: padding-box; transition: transform .35s cubic-bezier(.22, 1, .36, 1), box-shadow .35s ease, background .35s ease, color .35s ease, border-color .35s ease; }
  :is(#_, .bcir) .bcir__icon { width: var(--bcir-i-m); height: var(--bcir-i-m); max-width: 80%; max-height: 80%; display: inline-flex; align-items: center; justify-content: center; transition: transform .5s ease; }
  :is(#_, .bcir) .bcir__icon :is(svg, img) { width: 100%; height: 100%; display: block; object-fit: contain; }
  :is(#_, .bcir) .bcir__circle--full .bcir__icon { width: 100%; height: 100%; max-width: 100%; max-height: 100%; }
  :is(#_, .bcir) .bcir__circle--full .bcir__icon img { object-fit: cover; }
  :is(#_, .bcir) .bcir__label { margin: var(--bcir-lgap-m) 0 0; font-size: var(--bcir-l-m); line-height: var(--bcir-l-lh); color: var(--bcir-l-color); max-width: var(--bcir-l-max); }
  :is(#_, .bcir) .bcir__label[data-own-weight] { font-weight: var(--bcir-l-w); }
  :is(#_, .bcir) .bcir__sublabel { margin: var(--bcir-sgap) 0 0; font-size: var(--bcir-sl-size); line-height: 1.45; color: var(--bcir-sl-color); max-width: var(--bcir-l-max); }
  :is(#_, .bcir[data-hover="lift"]) .bcir__item:hover .bcir__circle { transform: translateY(-4px); box-shadow: 0 12px 24px -10px rgba(15, 23, 42, .25); }
  :is(#_, .bcir[data-hover="scale"]) .bcir__item:hover .bcir__circle { transform: scale(1.06); }
  :is(#_, .bcir[data-hover="fill"]) .bcir__item:hover .bcir__circle { background: var(--bcir-c-icon, var(--bcir-c-icon-s)); color: var(--bcir-c-bg, var(--bcir-c-bg-s)); border-color: var(--bcir-c-icon, var(--bcir-c-icon-s)); }
  :is(#_, .bcir[data-hover="spin"]) .bcir__item:hover .bcir__icon { transform: rotate(360deg); }
  @media (min-width: 768px) {
    :is(#_, .bcir[data-show="desktop"]) { display: block; }
    :is(#_, .bcir[data-show="mobile"]) { display: none; }
    :is(#_, .bcir) .bcir__inner.fa-inner { max-width: var(--bcir-w-t); }
    :is(#_, .bcir) .bcir__header { gap: var(--bcir-hs-d); margin-bottom: var(--bcir-hgap-d); }
    :is(#_, .bcir) .bcir__heading { font-size: var(--bcir-h-d); }
    :is(#_, .bcir) .bcir__row { grid-template-columns: repeat(var(--bcir-cols-d), minmax(0, 1fr)); gap: var(--bcir-row-d) var(--bcir-col-d); }
    :is(#_, .bcir) .bcir__circle { width: var(--bcir-c-d); }
    :is(#_, .bcir) .bcir__icon { width: var(--bcir-i-d); height: var(--bcir-i-d); }
    :is(#_, .bcir) .bcir__label { margin-top: var(--bcir-lgap-d); font-size: var(--bcir-l-d); }
    :is(#_, .bcir[data-connector="true"]) .bcir__row::before { content: ''; position: absolute; top: calc(var(--bcir-c-d) / 2); left: 8%; right: 8%; height: 0; border-top: 2px dashed var(--bcir-connector); z-index: 0; pointer-events: none; }
  }
  @media (min-width: 1024px) { :is(#_, .bcir) .bcir__inner.fa-inner { max-width: var(--bcir-w-d); } }
  @media (prefers-reduced-motion: reduce) {
    :is(#_, .bcir) :is(.bcir__circle, .bcir__icon) { transition: none !important; }
    :is(#_, .bcir) .bcir__item:hover :is(.bcir__circle, .bcir__icon) { transform: none !important; }
  }
{% comment %}{% endcomment %}</style>
<section class="bcir color-{{ scheme }} gradient" id="bcir-{{ section.id }}"
  {% render 'features-a-root', section: section, part: 'attrs', type: 'benefits-circles', width: st.section_width %}
  data-show="{% if st.show_section_on == 'mobile' or st.show_section_on == 'desktop' %}{{ st.show_section_on }}{% else %}all{% endif %}" data-hover="{{ st.hover_effect | default: 'none' }}" data-connector="{% if st.show_connector %}true{% else %}false{% endif %}"
  style="{% render 'features-a-root', section: section, part: 'vars', bg: st.section_bg, pt_m: st.padding_top_mobile, pb_m: st.padding_bottom_mobile, pt_d: st.padding_top_desktop, pb_d: st.padding_bottom_desktop %}--bcir-w-d: {{ st.section_max_width_desktop | default: 1200 }}px;--bcir-w-t: {{ st.section_max_width_tablet | default: 900 }}px;--bcir-w-m: {{ st.section_max_width_mobile | default: 560 }}px;--bcir-cols-d: {{ st.cols_desktop | default: 4 }};--bcir-cols-m: {{ st.cols_mobile | default: 2 }};--bcir-col-d: {{ st.col_gap_desktop | default: 0 }}px;--bcir-col-m: {{ st.col_gap_mobile | default: 0 }}px;--bcir-row-d: {{ st.row_gap_desktop | default: 0 }}px;--bcir-row-m: {{ st.row_gap_mobile | default: 0 }}px;--bcir-item-max: {{ st.item_max_width | default: 220 }}px;--bcir-align: {% if align == 'left' or align == 'right' %}{{ align }}{% else %}center{% endif %};--bcir-flex: {% if align == 'left' %}flex-start{% elsif align == 'right' %}flex-end{% else %}center{% endif %};--bcir-hgap-d: {{ st.gap_header | default: 0 }}px;--bcir-hgap-m: {{ st.gap_header_mobile | default: 0 }}px;--bcir-hs-d: {{ st.heading_sub_gap_desktop | default: 0 }}px;--bcir-hs-m: {{ st.heading_sub_gap_mobile | default: 0 }}px;--bcir-l-max: {{ st.label_max_width | default: 200 }}px;--bcir-lgap-d: {{ st.label_gap | default: 0 }}px;--bcir-lgap-m: {{ st.label_gap_mobile | default: 0 }}px;--bcir-sgap: {{ st.sublabel_gap | default: 0 }}px;--bcir-c-d: {{ st.circle_size_desktop | default: 96 }}px;--bcir-c-m: {{ st.circle_size_mobile | default: 80 }}px;--bcir-bw: {{ st.circle_border_width | default: 0 }}px;--bcir-i-d: {{ st.icon_size_desktop | default: 36 }}px;--bcir-i-m: {{ st.icon_size_mobile | default: 32 }}px;{% if own %}--bcir-c-bg-s: {% render 'scheme-color', color: st.circle_bg, fallback: 'var(--color-background)' %};--bcir-c-border-s: {% render 'scheme-color', color: st.circle_border_color, fallback: 'var(--color-border)' %};--bcir-c-icon-s: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %};--bcir-connector: {% render 'scheme-color', color: st.connector_color, fallback: 'var(--color-primary)' %};--bcir-l-color: {% render 'scheme-color', color: st.label_color, fallback: 'var(--color-heading)' %};--bcir-sl-color: {% render 'scheme-color', color: st.sublabel_color, fallback: 'var(--color-text)' %};--bcir-shadow: {{ st.circle_shadow | default: 'none' | replace: ';', '' | replace: '"', '' }};--bcir-l-w: {{ st.label_weight | default: 600 }};--bcir-l-d: {{ st.label_size_desktop | default: 16 }}px;--bcir-l-m: {{ st.label_size_mobile | default: 14 }}px;--bcir-l-lh: {{ st.label_line_height | default: 1.4 }};--bcir-sl-size: {{ st.sublabel_size | default: 13 }}px;{% else %}--bcir-c-bg-s: var(--color-background);--bcir-c-border-s: var(--color-border);--bcir-c-icon-s: var(--color-heading);--bcir-connector: var(--color-border);--bcir-l-color: var(--color-heading);--bcir-sl-color: var(--color-text);--bcir-shadow: var(--btn-shadow, none);--bcir-l-w: 600;--bcir-l-d: var(--body-font-size, 16px);--bcir-l-m: var(--body-font-size, 16px);--bcir-l-lh: var(--body-line-height, 1.5);--bcir-sl-size: var(--body-font-size, 16px);{% endif %}">
  {%- if request.design_mode -%}{%- for n in icon_names -%}<template data-fa-icon="{{ n }}">{% render 'features-a-circle-icon', name: n %}</template>{%- endfor -%}{%- endif -%}
  <div class="bcir__inner fa-inner">
    <div class="bcir__header">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="bcir__heading fa-h" id="block-{{ block.id }}" data-fa-block="{{ block.id }}" data-fa-type="heading" data-fa-settings="{{ bs | json | escape }}"{% if bs.enable_custom_style %} data-own-weight data-own-size{% endif %} style="{% if bs.enable_custom_style %}--bcir-h-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};--bcir-h-w: {{ bs.weight | default: 700 }};--bcir-h-d: {{ bs.size_desktop | default: 48 }}px;--bcir-h-m: {{ bs.size_mobile | default: 30 }}px;--bcir-h-lh: {{ bs.line_height | default: 1.2 }};--bcir-h-ls: {{ bs.tracking | default: 0 }}px;{% else %}--bcir-h-color: var(--color-heading);--bcir-h-w: var(--heading-weight, 700);--bcir-h-d: var(--h2-size, 32px);--bcir-h-m: var(--h2-size, 32px);--bcir-h-lh: var(--heading-line-height, 1.2);--bcir-h-ls: var(--heading-letter-spacing, normal);{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
          {%- when 'subheading' -%}
            <div class="bcir__sub fa-t fa-rich" id="block-{{ block.id }}" data-fa-block="{{ block.id }}" data-fa-type="subheading" data-fa-settings="{{ bs | json | escape }}" style="--bcir-s-max: {{ bs.max_width | default: 580 }}px;{% if bs.enable_custom_style %}--bcir-s-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};--bcir-s-size: {{ bs.size | default: 16 }}px;--bcir-s-lh: {{ bs.line_height | default: 1.5 }};{% else %}--bcir-s-color: var(--color-text);--bcir-s-size: var(--body-font-size, 16px);--bcir-s-lh: var(--body-line-height, 1.5);{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="bcir__row">
      {%- for block in section.blocks -%}
        {%- if block.type != 'circle' -%}{%- continue -%}{%- endif -%}
        {%- assign cs = block.settings -%}
        {%- assign full = false -%}{%- if cs.icon_type == 'image' and cs.icon_image != blank and cs.icon_fill_circle -%}{%- assign full = true -%}{%- endif -%}
        <div class="bcir__cell" id="block-{{ block.id }}" data-fa-block="{{ block.id }}" data-fa-type="circle" data-fa-settings="{{ cs | json | escape }}" style="{% if cs.enable_custom_style %}--bcir-c-bg: {% render 'scheme-color', color: cs.circle_bg, fallback: 'var(--bcir-c-bg-s)' %};--bcir-c-border: {% render 'scheme-color', color: cs.circle_border_color, fallback: 'var(--bcir-c-border-s)' %};--bcir-c-icon: {% render 'scheme-color', color: cs.icon_color, fallback: 'var(--bcir-c-icon-s)' %};{% endif %}" {{ block.shopify_attributes }}>
          {%- if cs.link != blank -%}<a class="bcir__item" data-fa-nolink="div" href="{{ cs.link | url }}">{%- else -%}<div class="bcir__item" data-fa-nolink="div">{%- endif -%}
            <span class="bcir__circle{% if full %} bcir__circle--full{% endif %}">
              <span class="bcir__icon" aria-hidden="true">
                {%- case cs.icon_type -%}
                  {%- when 'svg' -%}
                    {{ cs.icon_svg }}
                  {%- when 'image' -%}
                    {%- if cs.icon_image != blank -%}<img src="{{ cs.icon_image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy" decoding="async">{%- endif -%}
                  {%- else -%}
                    {%- render 'features-a-circle-icon', name: cs.icon_preset -%}
                {%- endcase -%}
              </span>
            </span>
            <h3 class="bcir__label fa-h"{% if own %} data-own-weight data-own-size{% endif %}{% if cs.label == blank %} hidden{% endif %}>{{ cs.label }}</h3>
            <p class="bcir__sublabel fa-t"{% if cs.sublabel == blank %} hidden{% endif %}>{{ cs.sublabel }}</p>
          {%- if cs.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
</template>

<schema>
{
  "type": "benefits-circles",
  "name": "Benefits Circles",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Grid and width"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "cols_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Section width (desktop ≥1024px)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Section width (tablet ≥768px)",
      "min": 500,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "section_max_width_mobile",
      "label": "Section width (mobile)",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Row gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Row gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_max_width",
      "label": "Item max width",
      "min": 100,
      "max": 360,
      "step": 5,
      "unit": "px",
      "default": 220
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Header and labels"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Aligns both heading and subheading."
    },
    {
      "type": "range",
      "id": "gap_header",
      "label": "Gap subheading → circles (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "gap_header_mobile",
      "label": "Gap subheading → circles (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_sub_gap_desktop",
      "label": "Gap heading → subheading (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_sub_gap_mobile",
      "label": "Gap heading → subheading (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "label_max_width",
      "label": "Label max width",
      "min": 100,
      "max": 320,
      "step": 5,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap circle → label (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_gap_mobile",
      "label": "Gap circle → label (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "sublabel_gap",
      "label": "Gap label → sublabel",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Circles and icons"
    },
    {
      "type": "range",
      "id": "circle_size_desktop",
      "label": "Circle size (desktop)",
      "min": 40,
      "max": 200,
