<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Benefits Circles
  A row of circular icon badges, each with an optional label underneath.
  Each circle's icon source can be a built-in Lucide-style SVG, a custom
  inline SVG, or an uploaded image. Stacks responsively on mobile, fully
  restylable: ring vs. filled circles, sizes, colors, hover effect,
  optional connector line, per-circle color overrides.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign circles = section.blocks | where: 'type', 'circle'
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .bcir {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width — separate sliders for mobile/tablet/desktop */
  #shopify-section-{{ sid }} .bcir__inner {
    max-width: {{ st.section_max_width_mobile | default: 560 }}px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__inner {
      max-width: {{ st.section_max_width_tablet | default: 900 }}px;
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .bcir__inner {
      max-width: {{ st.section_max_width_desktop | default: 1200 }}px;
    }
  }

  /* Header — flex column, alignment controls BOTH heading & subheading */
  #shopify-section-{{ sid }} .bcir__header {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    margin: 0 auto {{ st.gap_header_mobile | default: 32 }}px;
    gap: {{ st.heading_sub_gap_mobile | default: 8 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__header {
      margin-bottom: {{ st.gap_header | default: 56 }}px;
      gap: {{ st.heading_sub_gap_desktop | default: 14 }}px;
    }
  }
  /* Reset margins on header DESCENDANTS only (not the header itself,
     so its margin-bottom gap to the circles is preserved). */
  #shopify-section-{{ sid }} .bcir__header > *,
  #shopify-section-{{ sid }} .bcir__header :is(h1, h2, h3, h4, h5, h6, p, div, span) {
    margin-block: 0 !important;
    margin-block-start: 0 !important;
    margin-block-end: 0 !important;
    padding-block: 0 !important;
  }

  /* Circles row */
  #shopify-section-{{ sid }} .bcir__row {
    display: grid;
    grid-template-columns: repeat({{ st.cols_mobile | default: 2 }}, minmax(0, 1fr));
    gap: {{ st.row_gap_mobile | default: 28 }}px {{ st.col_gap_mobile | default: 16 }}px;
    align-items: start;
    justify-items: center;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__row {
      grid-template-columns: repeat({{ st.cols_desktop | default: 4 }}, minmax(0, 1fr));
      gap: {{ st.row_gap_desktop | default: 40 }}px {{ st.col_gap_desktop | default: 32 }}px;
    }
  }

  /* Single item */
  #shopify-section-{{ sid }} .bcir__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: {{ st.item_max_width | default: 220 }}px;
    width: 100%;
    position: relative;
  }
  #shopify-section-{{ sid }} .bcir__item--linked { cursor: pointer; text-decoration: none; color: inherit; }

  /* Circle */
  #shopify-section-{{ sid }} .bcir__circle {
    width: {{ st.circle_size_mobile | default: 80 }}px;
    height: {{ st.circle_size_mobile | default: 80 }}px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: st.circle_bg, fallback: 'var(--color-background)' %};
    border: {{ st.circle_border_width | default: 1 }}px solid {% render 'scheme-color', color: st.circle_border_color, fallback: 'var(--color-border)' %};
    display: flex;
    align-items: center;
    justify-content: center;
    color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %};
    transition: transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease, border-color .35s ease, background .35s ease;
    box-shadow: {{ st.circle_shadow | default: 'none' }};
    overflow: hidden;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__circle {
      width: {{ st.circle_size_desktop | default: 96 }}px;
      height: {{ st.circle_size_desktop | default: 96 }}px;
    }
  }

  {%- if st.hover_effect == 'lift' -%}
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__circle {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px -10px rgba(15, 23, 42, .25);
    }
  {%- elsif st.hover_effect == 'scale' -%}
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__circle { transform: scale(1.06); }
  {%- elsif st.hover_effect == 'fill' -%}
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__circle {
      background: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %};
      color: {% render 'scheme-color', color: st.circle_bg, fallback: 'var(--color-background)' %};
      border-color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %};
    }
  {%- elsif st.hover_effect == 'spin' -%}
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__icon { transform: rotate(360deg); transition: transform .8s ease; }
  {%- endif -%}
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .bcir__circle { transition: none !important; }
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__circle { transform: none !important; }
    #shopify-section-{{ sid }} .bcir__item:hover .bcir__icon { transform: none !important; }
  }

  /* Inner icon */
  #shopify-section-{{ sid }} .bcir__icon {
    width: {{ st.icon_size_mobile | default: 32 }}px;
    height: {{ st.icon_size_mobile | default: 32 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform .35s ease;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__icon {
      width: {{ st.icon_size_desktop | default: 36 }}px;
      height: {{ st.icon_size_desktop | default: 36 }}px;
    }
  }
  #shopify-section-{{ sid }} .bcir__icon svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .bcir__icon img { width: 100%; height: 100%; object-fit: contain; }

  /* Filled circle full-image variant */
  #shopify-section-{{ sid }} .bcir__circle--full .bcir__icon {
    width: 100% !important;
    height: 100% !important;
  }
  #shopify-section-{{ sid }} .bcir__circle--full .bcir__icon img,
  #shopify-section-{{ sid }} .bcir__circle--full .bcir__icon svg {
    object-fit: cover;
  }

  /* Label */
  #shopify-section-{{ sid }} .bcir__label {
    margin: {{ st.label_gap_mobile | default: 12 }}px 0 0 !important;
    font-weight: {{ st.label_weight | default: 600 }};
    font-size: {{ st.label_size_mobile | default: 14 }}px;
    line-height: {{ st.label_line_height | default: 1.4 }};
    color: {% render 'scheme-color', color: st.label_color, fallback: 'var(--color-heading)' %};
    text-align: center;
    max-width: {{ st.label_max_width | default: 200 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .bcir__label {
      margin-top: {{ st.label_gap | default: 16 }}px !important;
      font-size: {{ st.label_size_desktop | default: 16 }}px;
    }
  }
  #shopify-section-{{ sid }} .bcir__label > * { margin: 0 !important; padding: 0 !important; }

  /* Optional sublabel */
  #shopify-section-{{ sid }} .bcir__sublabel {
    margin: {{ st.sublabel_gap | default: 6 }}px 0 0 !important;
    font-size: {{ st.sublabel_size | default: 13 }}px;
    line-height: 1.45;
    color: {% render 'scheme-color', color: st.sublabel_color, fallback: 'var(--color-heading)' %};
    max-width: {{ st.label_max_width | default: 200 }}px;
  }
  #shopify-section-{{ sid }} .bcir__sublabel > * { margin: 0 !important; padding: 0 !important; }

  /* Optional connector line — desktop only */
  {%- if st.show_connector -%}
    @media (min-width: 768px) {
      #shopify-section-{{ sid }} .bcir__row { position: relative; }
      #shopify-section-{{ sid }} .bcir__row::before {
        content: '';
        position: absolute;
        top: {{ st.circle_size_desktop | default: 96 | divided_by: 2 }}px;
        left: 8%;
        right: 8%;
        height: 0;
        border-top: 2px dashed {% render 'scheme-color', color: st.connector_color, fallback: 'var(--color-primary)' %};
        z-index: 0;
        pointer-events: none;
      }
      #shopify-section-{{ sid }} .bcir__item { position: relative; z-index: 1; }
      #shopify-section-{{ sid }} .bcir__circle { position: relative; z-index: 1; background-clip: padding-box; }
    }
  {%- endif -%}

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .bcir { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .bcir { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .bcir { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .bcir { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="bcir color-{{ color_scheme }} gradient {{ section.settings.section_width }}" id="bcir-{{ sid }}">
  <div class="bcir__inner">

    {%- comment -%}========== HEADER ==========={%- endcomment -%}
    {%- assign has_header = false -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'heading' or b.type == 'subheading' -%}
        {%- assign has_header = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_header -%}
      <div class="bcir__header">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="bcir__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {{ bs.color | default: '#0F172A' }} !important;
                    font-weight: {{ bs.weight | default: 700 }};
                    line-height: {{ bs.line_height | default: 1.2 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    font-size: {{ bs.size_mobile | default: 30 }}px !important;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 48 }}px !important; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="bcir__sub" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {{ bs.color | default: '#475569' }} !important;
                    font-size: {{ bs.size | default: 16 }}px;
                    line-height: {{ bs.line_height | default: 1.5 }};
                    max-width: {{ bs.max_width | default: 580 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0 !important; margin-block: 0 !important; padding: 0 !important; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}========== CIRCLES ==========={%- endcomment -%}
    <div class="bcir__row">
      {%- for circle in circles -%}
        {%- assign cs = circle.settings -%}
        {%- assign tag = 'div' -%}
        {%- assign extra_class = '' -%}
        {%- if cs.link != blank -%}
          {%- assign tag = 'a' -%}
          {%- assign extra_class = ' bcir__item--linked' -%}
        {%- endif -%}
        {%- assign full_class = '' -%}
        {%- if cs.icon_type == 'image' and cs.icon_image and cs.icon_fill_circle -%}
          {%- assign full_class = ' bcir__circle--full' -%}
        {%- endif -%}

        <{{ tag }} class="bcir__item{{ extra_class }}" id="block-{{ circle.id }}" {% if cs.link != blank %}href="{{ cs.link }}"{% endif %} {{ circle.shopify_attributes }}>
          <span class="bcir__circle{{ full_class }}"
                style="
                  {% if cs.circle_bg != blank %}background: {{ cs.circle_bg }};{% endif %}
                  {% if cs.circle_border_color != blank %}border-color: {{ cs.circle_border_color }};{% endif %}
                  {% if cs.icon_color != blank %}color: {{ cs.icon_color }};{% endif %}
                ">
            <span class="bcir__icon">
              {%- case cs.icon_type -%}
                {%- when 'svg' -%}
                  {{ cs.icon_svg }}
                {%- when 'image' -%}
                  {%- if cs.icon_image -%}
                    <img src="{{ cs.icon_image | image_url: width: 240 }}" alt="{{ cs.label | default: '' | strip_html | escape }}" loading="lazy" width="60" height="60">
                  {%- endif -%}
                {%- else -%}
                  {%- case cs.icon_preset -%}
                    {%- when 'check' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96c1 1.57 2 4.55 2 7.04A6.78 6.78 0 0 1 14 17"/><path d="M2 22 19 5"/></svg>
                    {%- when 'gift' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C9 3 12 7 12 8c0-1 3-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- when 'sparkle' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.5L19 10l-5.1 1.5L12 17l-1.9-5.5L5 10l5.1-1.5z"/></svg>
                    {%- when 'zap' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {%- when 'refresh' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><polyline points="21 3 21 8 16 8"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><polyline points="3 21 3 16 8 16"/></svg>
                    {%- when 'sun' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/><line x1="4.93" y1="4.93" x2="7.05" y2="7.05"/><line x1="16.95" y1="16.95" x2="19.07" y2="19.07"/><line x1="4.93" y1="19.07" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.07" y2="4.93"/></svg>
                    {%- when 'thumbs-up' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v11"/><path d="M14 4h-1c-1.66 0-3 1.34-3 3v3H4a2 2 0 0 0-2 2v8c0 1.1.9 2 2 2h13.5a2.5 2.5 0 0 0 2.45-2l1.5-9.5A2 2 0 0 0 19.5 8H14V4z"/></svg>
                    {%- when 'award' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.21 13.89 7 22l5-3 5 3-1.21-8.11"/></svg>
                    {%- when 'lock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    {%- when 'package' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8 12 3 3 8l9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
                    {%- when 'globe' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    {%- when 'message' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {%- endcase -%}
              {%- endcase -%}
            </span>
          </span>
          {%- if cs.label != blank -%}
            <div class="bcir__label">{{ cs.label }}</div>
          {%- endif -%}
          {%- if cs.sublabel != blank -%}
            <div class="bcir__sublabel">{{ cs.sublabel }}</div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>

  </div>
</section>



</template>

