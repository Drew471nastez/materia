<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. FAQ 5: question cards floating around a product image.
  Each card block picks its place on desktop (top, middle or bottom, left
  or right); on a phone the cards stack in the mobile layout chosen. The
  heading and subheading are blocks (snippets/faq-live-header). Every value
  is a --ffq-* variable on the root; live-faq.js applies live edits.
{%- endcomment -%}
{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign own = st.enable_custom_style
  assign image_block = nil
  for b in section.blocks
    if b.type == 'product_image' and image_block == nil
      assign image_block = b
    endif
  endfor
  assign card_blocks = section.blocks | where: 'type', 'faq_card'
  assign h_align = st.header_align | default: 'center'
  assign h_flex = 'center'
  if h_align == 'left'
    assign h_flex = 'flex-start'
  elsif h_align == 'right'
    assign h_flex = 'flex-end'
  endif
  assign hw = st.heading_weight | default: 'theme'
  assign own_hw = false
  if hw != 'theme'
    assign own_hw = true
  endif
  assign qw = st.q_weight | default: 'theme'
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
-%}
{%- capture ffq_vars -%}
--ffq-bg:{% if own %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--ffq-pt-m:{{ st.padding_top_mobile | default: 56 }}px;--ffq-pb-m:{{ st.padding_bottom_mobile | default: 56 }}px;--ffq-pt-d:{{ st.padding_top_desktop | default: 96 }}px;--ffq-pb-d:{{ st.padding_bottom_desktop | default: 96 }}px;
--ffq-maxw:{{ st.max_width | default: 1200 }}px;--ffq-align:{{ h_align }};--ffq-flex:{{ h_flex }};
--ffq-h-m:{{ st.heading_size_mobile | default: 30 }}px;--ffq-h-d:{{ st.heading_size_desktop | default: 48 }}px;--ffq-hw:{% if own_hw %}{{ hw }}{% else %}var(--heading-weight, 700){% endif %};
--ffq-heading-color:{% if own %}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--ffq-sub-color:{% if own %}{% render 'scheme-color', color: st.sub_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--ffq-img-w:{{ st.image_width | default: 360 }}px;--ffq-img-r:{{ st.image_radius | default: 24 }}px;--ffq-img-bg:{% if own %}{% render 'scheme-color', color: st.image_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--ffq-fit:{{ st.image_fit | default: 'contain' }};
--ffq-card-r:{{ st.card_radius | default: 18 }}px;--ffq-card-p:{{ st.card_padding | default: 22 }}px;--ffq-card-mw:{{ st.card_max_width | default: 320 }}px;--ffq-overlap:{{ st.card_overlap | default: 36 }}px;
--ffq-q-size:{{ st.q_size | default: 19 }}px;--ffq-q-w:{% if qw != 'theme' %}{{ qw }}{% else %}var(--heading-weight, 700){% endif %};--ffq-a-size:{{ st.a_size | default: 14 }}px;
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--ffq-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--ffq-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom | default: 0 }}px; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) { font-family: var(--heading-font, inherit); }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }}, #shopify-section-{{ sid }} > section, #shopify-section-{{ sid }} > div { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section, .shopify-section + #shopify-section-{{ sid }} { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .ffq { background: var(--ffq-bg) !important; padding: var(--ffq-pt-m) 1.25rem var(--ffq-pb-m); overflow-x: clip; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ffq { padding: var(--ffq-pt-d) 1.5rem var(--ffq-pb-d); }
  }
  #shopify-section-{{ sid }} .ffq__inner { max-width: var(--ffq-maxw); margin-inline: auto; }

  #shopify-section-{{ sid }} .ffq__header { display: flex; flex-direction: column; align-items: var(--ffq-flex); text-align: var(--ffq-align); gap: 12px; margin-bottom: 32px; }
  #shopify-section-{{ sid }} .ffq__header > * { margin: 0 !important; }
  #shopify-section-{{ sid }} .ffq__header > [hidden] { display: none; }
  #shopify-section-{{ sid }} .ffq__heading {
    color: var(--fb-c, var(--ffq-heading-color)) !important;
    font-family: var(--fb-ff, var(--ffq-hf, var(--heading-font, inherit)));
    font-size: var(--fb-fs-m, var(--ffq-h-m));
    line-height: var(--fb-lh, 1.15);
    font-weight: var(--ffq-hw);
  }
  #shopify-section-{{ sid }} .ffq__heading[data-own-weight] { font-weight: var(--fb-fw, var(--ffq-hw)); }
  #shopify-section-{{ sid }} .ffq__heading[data-own-size] { letter-spacing: var(--fb-ls, normal); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ffq__heading { font-size: var(--fb-fs-d, var(--ffq-h-d)); }
  }
  #shopify-section-{{ sid }} .ffq__subheading { color: var(--fb-c, var(--ffq-sub-color)) !important; font-family: var(--fb-ff, var(--ffq-bf, inherit)); font-size: var(--fb-fs, 16px); line-height: var(--fb-lh, 1.55); max-width: 600px; }
  #shopify-section-{{ sid }} .ffq__subheading[data-own-weight] { font-weight: var(--fb-fw); }
  #shopify-section-{{ sid }} :is(.ffq__subheading, .ffq__card-a) :is(p, li, strong, em) { font-family: inherit; }
  #shopify-section-{{ sid }} .ffq__subheading > * { margin: 0; }

  /* Stage: on a phone the image comes first and the cards stack in the
     mobile layout chosen; from 900px they float around the image. */
  #shopify-section-{{ sid }} .ffq__stage { display: grid; gap: 18px; grid-template-columns: minmax(0, 1fr); grid-template-areas: "img" "tl" "tr" "ml" "mr" "bl" "br"; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="top-left"] { grid-area: tl; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="top-right"] { grid-area: tr; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="middle-left"] { grid-area: ml; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="middle-right"] { grid-area: mr; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="bottom-left"] { grid-area: bl; }
  #shopify-section-{{ sid }} .ffq__card[data-pos="bottom-right"] { grid-area: br; }
  #shopify-section-{{ sid }} .ffq__image-wrap { grid-area: img; justify-self: center; }
  #shopify-section-{{ sid }} .ffq__card { justify-self: center; width: 100%; }
  #shopify-section-{{ sid }} .ffq[data-ffq-mobile="zigzag"] .ffq__card { width: min(86%, var(--ffq-card-mw)); }
  #shopify-section-{{ sid }} .ffq[data-ffq-mobile="zigzag"] .ffq__card[data-pos$="-left"] { justify-self: start; }
  #shopify-section-{{ sid }} .ffq[data-ffq-mobile="zigzag"] .ffq__card[data-pos$="-right"] { justify-self: end; }
  #shopify-section-{{ sid }} .ffq[data-ffq-mobile="left"] .ffq__card { justify-self: start; }
  #shopify-section-{{ sid }} .ffq[data-ffq-mobile="right"] .ffq__card { justify-self: end; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .ffq__stage {
      grid-template-columns: minmax(0, 1fr) var(--ffq-img-w) minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      grid-template-areas: "tl img tr" "ml img mr" "bl img br";
      column-gap: clamp(8px, 1.5vw, 24px); row-gap: clamp(20px, 3vw, 36px); align-items: start;
    }
    #shopify-section-{{ sid }} .ffq[data-ffq-mobile] .ffq__card { width: auto; position: relative; z-index: 2; text-align: start; }
    #shopify-section-{{ sid }} .ffq[data-ffq-mobile] .ffq__card[data-pos$="-left"] { justify-self: end; transform: translateX(var(--ffq-overlap)); }
    #shopify-section-{{ sid }} .ffq[data-ffq-mobile] .ffq__card[data-pos$="-right"] { justify-self: start; transform: translateX(calc(var(--ffq-overlap) * -1)); }
    #shopify-section-{{ sid }} .ffq__image-wrap { grid-row: 1 / span 3; align-self: center; justify-self: center; position: relative; z-index: 1; }
  }

  #shopify-section-{{ sid }} .ffq__card {
    background: var(--ffq-card-bg, color-mix(in srgb, var(--color-heading) 6%, var(--color-background)));
    color: var(--ffq-card-fg, var(--color-text));
    border-radius: var(--ffq-card-r);
    padding: var(--ffq-card-p);
    max-width: var(--ffq-card-mw);
    box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px rgba(15,23,42,.06);
  }
  #shopify-section-{{ sid }} .ffq__card-q { margin: 0 0 8px; color: var(--ffq-card-q, var(--color-heading)); font-family: var(--ffq-hf, var(--heading-font, inherit)); font-size: var(--ffq-q-size); line-height: 1.25; font-weight: var(--ffq-q-w); }
  #shopify-section-{{ sid }} .ffq__card-a { margin: 0; color: var(--ffq-card-fg, var(--color-text)); font-family: var(--ffq-bf, inherit); font-size: var(--ffq-a-size); line-height: 1.55; }
  #shopify-section-{{ sid }} .ffq__card-a > * { margin: 0; }
  #shopify-section-{{ sid }} .ffq__card-a > * + * { margin-top: 8px; }
  #shopify-section-{{ sid }} .ffq__card-a a { color: inherit; text-decoration: underline; }

  #shopify-section-{{ sid }} .ffq__image-wrap { width: 100%; max-width: var(--ffq-img-w); aspect-ratio: 1 / 1; border-radius: var(--ffq-img-r); overflow: hidden; background: var(--ffq-img-bg); color: var(--color-heading); display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ sid }} .ffq__image-wrap :is(img, svg) { width: 100%; height: 100%; object-fit: var(--ffq-fit); display: block; }
{% comment %}{% endcomment %}</style>
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<section class="ffq color-{{ color_scheme }} gradient" id="ffq-{{ sid }}" data-faq-root="faq-floating" data-faq-section="{{ section.id }}" data-faq-settings="{{ section.settings | json | escape }}" data-ffq-mobile="{{ st.mobile_layout | default: 'zigzag' }}" style="{{ ffq_vars | strip_newlines }}">
  <div class="ffq__inner">
    {%- render 'faq-live-header', section: section, p: 'ffq', own_hw: own_hw -%}
    <div class="ffq__stage">
      {%- for card in card_blocks -%}
        {%- assign cs = card.settings -%}
        {%- capture card_vars -%}
          {%- if cs.enable_custom_style -%}--ffq-card-bg:{% render 'scheme-color', color: cs.bg_color, fallback: 'color-mix(in srgb, var(--color-heading) 6%, var(--color-background))' %};--ffq-card-fg:{% render 'scheme-color', color: cs.text_color, fallback: 'var(--color-text)' %};--ffq-card-q:{% render 'scheme-color', color: cs.q_color, fallback: 'var(--color-heading)' %};{%- endif -%}
        {%- endcapture -%}
        <div class="ffq__card" id="block-{{ card.id }}" data-pos="{{ cs.position | default: 'top-left' }}" data-faq-block="{{ card.id }}" data-faq-type="faq_card" data-faq-settings="{{ cs | json | escape }}"{% if card_vars != blank %} style="{{ card_vars }}"{% endif %} {{ card.shopify_attributes }}>
          <h3 class="ffq__card-q" data-faq-question{% if sec_font %} data-own-font{% endif %}{% if qw != 'theme' %} data-own-weight{% endif %}>{{ cs.question }}</h3>
          <div class="ffq__card-a" data-faq-answer{% if sec_font %} data-own-font{% endif %}>{{ cs.answer }}</div>
        </div>
      {%- endfor -%}
      <div class="ffq__image-wrap" data-faq-media{% if image_block %} id="block-{{ image_block.id }}" data-faq-block="{{ image_block.id }}" data-faq-type="product_image" data-faq-settings="{{ image_block.settings | json | escape }}" {{ image_block.shopify_attributes }}{% endif %}>
        {%- if image_block and image_block.settings.image != blank -%}
          {{ image_block.settings.image | image_url: width: 1000 | image_tag: alt: image_block.settings.image.alt, width: image_block.settings.image.width, height: image_block.settings.image.height, loading: 'lazy', sizes: '(min-width: 900px) 360px, 100vw', widths: '320,480,640,800,1000' }}
        {%- else -%}
          <svg class="ffq__ph" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><rect width="400" height="400" fill="currentColor" opacity=".08"/><g fill="currentColor" opacity=".35"><circle cx="176" cy="172" r="16"/><path d="M136 248l46-54 29 32 23-21 40 43z"/></g></svg>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if st.structured_data -%}{% render 'faq-live-jsonld', items: card_blocks %}{%- endif -%}
</section>
</template>

<schema>
{
  "type": "faq-floating",
  "name": "FAQ 5",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Add FAQ structured data",
      "default": false,
      "info": "Lets search engines read these questions. Turn it on for one FAQ section per page."
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "hidden": true,
      "info": "Legacy: used only when the section has no subheading block."
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_max_width",
      "label": "Card width",
      "min": 220,
      "max": 480,
      "step": 5,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_overlap",
      "label": "Card overlap (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Media"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (desktop)",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading and question font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Text and answer font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "q_size",
      "label": "Question size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "select",
      "id": "q_weight",
      "label": "Question weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "a_size",
      "label": "Answer size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_35",
