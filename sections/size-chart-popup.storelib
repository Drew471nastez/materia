<template compat="shopify">
{% render 'theme-type' %}
{%- assign fb_accessibility_size_guide = 'accessibility.size_guide' | t -%}
{%- comment -%}
  Materia Themes. Size Chart Popup: a trigger button and a native <dialog>
  with the size chart. What the dialog shows, first found:
    1. the size chart Storelib gives this product (Products > Size charts),
       drawn by snippets/product-size-chart-content (the same table, cm / in
       switch and colours as every other size guide; size-chart.js),
       while "Use the product's size chart" is on;
    2. the chart typed here: Column headers and one Row block per size
       (sections saved before rows were blocks keep Row 1 to Row 8);
  then the Custom HTML and Notes blocks.
  shopify/assets/live-popups-code.js opens it with showModal() (Escape, the
  44px close button and a click outside close it; focus goes back to the
  trigger) and applies every setting live in the builder, where selecting the
  section or a block opens it in the page without covering it.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign scs_custom = false
  if st.enable_custom_style
    assign scs_custom = true
  endif
  assign scs_fonts = false
  if st.enable_custom_fonts
    assign scs_fonts = true
  endif
  assign scs_product = product | default: page.product
  assign scs_chart = ''
  if st.use_product_chart != false and scs_product != blank
    capture scs_chart
      render 'product-size-chart-content', product: scs_product, chart_id: sid
    endcapture
  endif
  assign scs_chart_plain = scs_chart | strip_html | strip
  assign scs_has_chart = false
  if scs_chart_plain != blank or scs_chart contains '<table' or scs_chart contains '<img'
    assign scs_has_chart = true
  endif
  assign row_blocks = section.blocks | where: 'type', 'row'
  assign html_blocks = section.blocks | where: 'type', 'html'
  assign notes_blocks = section.blocks | where: 'type', 'notes'
  assign scs_align = st.align | default: 'left'
-%}
{%- capture scs_vars -%}
--scs-align: {{ scs_align }}; --scs-mt: {{ st.margin_top | default: 0 }}px; --scs-mb: {{ st.margin_bottom | default: 0 }}px;
--scs-trig-fs: {{ st.trig_size | default: 16 }}px; --scs-trig-fw: {{ st.trig_weight | default: '600' }}; --scs-gap: {{ st.trig_gap | default: 8 }}px; --scs-pad-y: {{ st.trig_pad_y | default: 8 }}px; --scs-pad-x: {{ st.trig_pad_x | default: 0 }}px; --scs-icon: {{ st.icon_size | default: 18 }}px;
--scs-title-fs: {{ st.title_size | default: 20 }}px; --scs-pad: {{ st.modal_padding | default: 24 }}px; --scs-mw-d: {{ st.modal_width_d | default: 720 }}px; --scs-mw-m: {{ st.modal_width_m | default: 360 }}px;
{%- if scs_custom -%}
--scs-trig: {% render 'scheme-color', color: st.trig_color, fallback: 'var(--color-text)' %}; --scs-icon-c: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--scs-trig)' %}; --scs-title: {% render 'scheme-color', color: st.title_color, fallback: 'var(--color-heading)' %}; --scs-bg: {% render 'scheme-color', color: st.modal_bg, fallback: 'var(--color-background)' %}; --scs-text: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}; --scs-tb: {% render 'scheme-color', color: st.table_border_color, fallback: 'var(--color-border)' %}; --scs-ts: {% render 'scheme-color', color: st.table_stripe_color, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %}; --scs-radius: {{ st.modal_radius | default: 16 }}px;
{%- endif -%}
{%- if scs_fonts -%}
{%- if st.heading_font.family != blank -%}--scs-hf: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.body_font.family != blank -%}--scs-bf: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}
{%- if scs_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<div class="scs-wrap color-{{ color_scheme }}" id="scs-{{ sid }}"
     data-pc-root="size-chart-popup"
     data-pc-section="{{ sid }}"
     data-pc-settings="{{ st | json | escape }}"
     data-scs-i18n='{"title":{{ fb_accessibility_size_guide | json | escape }}}'
     data-scs-underline="{% if st.underline_text %}true{% else %}false{% endif %}"
     style="{{ scs_vars | strip | strip_newlines }}">
  <button type="button"
          class="scs__trigger"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="scs-dialog-{{ sid }}"
          data-scs-open
          {% if scs_fonts %}data-own-font{% endif %}>
    <span class="scs__icn" aria-hidden="true" data-scs-icon{% unless st.show_icon %} hidden{% endunless %}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/><path d="M7 4v4"/><path d="M12 10v4"/><path d="M17 16v4"/></svg>
    </span>
    <span class="scs__label" data-scs-label>{{ st.trig_text | default: fb_accessibility_size_guide }}</span>
  </button>

  <dialog id="scs-dialog-{{ sid }}" class="scs__dialog" aria-labelledby="scs-title-{{ sid }}" data-scs-dialog>
    <div class="scs__modal" data-scs-modal>
      <div class="scs__head">
        <h2 id="scs-title-{{ sid }}" class="scs__title" data-scs-title{% if scs_fonts %} data-own-font{% endif %}>{{ st.modal_title | default: fb_accessibility_size_guide }}</h2>
        <button type="button" class="scs__close" aria-label="{{ 'accessibility.close_esc' | t }}" data-scs-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>

      <div class="scs__body"{% if scs_fonts %} data-own-font{% endif %}>
        {%- if scs_has_chart -%}
          <div class="scs__product-chart" data-scs-product-chart>{{ scs_chart }}</div>
        {%- else -%}
          {%- liquid
            assign headers = st.headers | split: '|'
            assign has_rows = false
            if row_blocks.size > 0
              assign has_rows = true
            else
              for n in (1..8)
                assign key = 'row_' | append: n
                if st[key] != blank
                  assign has_rows = true
                endif
              endfor
            endif
          -%}
          <div class="scs__table-wrap" data-scs-table{% if st.headers == blank and has_rows == false %} hidden{% endif %} tabindex="0" role="region" aria-label="{{ st.modal_title | default: fb_accessibility_size_guide | escape }}">
            <table class="scs__table">
              <thead data-scs-headers{% if st.headers == blank %} hidden{% endif %}>
                <tr>{%- for h in headers -%}<th scope="col">{{ h | strip }}</th>{%- endfor -%}</tr>
              </thead>
              <tbody>
                {%- if row_blocks.size > 0 -%}
                  {%- for block in row_blocks -%}
                    {%- assign cells = block.settings.cells | split: '|' -%}
                    <tr data-pc-block="{{ block.id }}" data-pc-type="row" data-pc-settings="{{ block.settings | json | escape }}"{% if block.settings.cells == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                      {%- for c in cells -%}{%- if forloop.first -%}<th scope="row">{{ c | strip }}</th>{%- else -%}<td>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}
                    </tr>
                  {%- endfor -%}
                {%- else -%}
                  {%- for n in (1..8) -%}
                    {%- assign key = 'row_' | append: n -%}
                    {%- assign row_value = st[key] -%}
                    {%- if row_value != blank -%}
                      {%- assign cells = row_value | split: '|' -%}
                      <tr data-pc-legacy="{{ key }}">
                        {%- for c in cells -%}{%- if forloop.first -%}<th scope="row">{{ c | strip }}</th>{%- else -%}<td>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}

        {%- if html_blocks.size > 0 -%}
          {%- for block in html_blocks -%}
            <div class="scs__html" data-pc-block="{{ block.id }}" data-pc-type="html" data-pc-settings="{}" {{ block.shopify_attributes }}>{{ block.settings.html }}</div>
          {%- endfor -%}
        {%- elsif st.html != blank -%}
          <div class="scs__html" data-pc-legacy="html">{{ st.html }}</div>
        {%- endif -%}

        {%- if notes_blocks.size > 0 -%}
          {%- for block in notes_blocks -%}
            <div class="scs__notes" data-pc-block="{{ block.id }}" data-pc-type="notes" data-pc-settings="{{ block.settings | json | escape }}"{% if block.settings.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endfor -%}
        {%- elsif st.notes != blank -%}
          <div class="scs__notes" data-pc-legacy="notes">{{ st.notes }}</div>
        {%- endif -%}

        {%- if request.design_mode and scs_has_chart == false and st.headers == blank and html_blocks.size == 0 and st.html == blank -%}
          <p class="scs__empty">Add column headers and Row blocks to build the chart. Only you see this note in the builder.</p>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</div>

<style>
  #scs-{{ sid }} {
    display: block;
    margin-top: var(--scs-mt, 0px);
    margin-bottom: var(--scs-mb, 0px);
    text-align: var(--scs-align, left);
    background: transparent;
  }
  #scs-{{ sid }} .scs__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--scs-gap, 8px);
    min-height: 44px;
    padding: var(--scs-pad-y, 8px) var(--scs-pad-x, 0px);
    box-sizing: border-box;
    background: transparent;
    border: 0;
    cursor: pointer;
    line-height: 1.2;
    font-family: var(--scs-bf, inherit);
    font-size: var(--scs-trig-fs, 16px);
    font-weight: var(--scs-trig-fw, 600);
    color: var(--scs-trig, var(--color-text));
  }
  #scs-{{ sid }}[data-scs-underline='true'] .scs__label { text-decoration: underline; text-underline-offset: 2px; }
  #scs-{{ sid }} .scs__trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #scs-{{ sid }} .scs__icn { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--scs-icon, 18px); height: var(--scs-icon, 18px); color: var(--scs-icon-c, var(--scs-trig, var(--color-text))); }
  #scs-{{ sid }} .scs__icn[hidden] { display: none; }
  #scs-{{ sid }} .scs__icn svg { width: 100%; height: 100%; display: block; }

  #scs-{{ sid }} .scs__dialog {
    box-sizing: border-box;
    width: min(var(--scs-mw-m, 360px), calc(100vw - 32px));
    max-width: none;
    max-height: calc(var(--sl-vh, 1vh) * 85);
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    text-align: start;
  }
  @media (min-width: 600px) {
    #scs-{{ sid }} .scs__dialog { width: min(var(--scs-mw-d, 720px), calc(100vw - 32px)); }
  }
  #scs-{{ sid }} .scs__dialog::backdrop { background: rgba(0, 0, 0, .5); }
  #scs-{{ sid }} .scs__dialog[open] { animation: pc-scs-in .2s ease both; }
  @keyframes pc-scs-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  /* In the builder the chart opens in the page, under its trigger */
  #scs-{{ sid }} .scs__dialog[open]:not(:modal) { position: relative; inset: auto; display: block; margin: 12px 0 0; z-index: auto; }

  #scs-{{ sid }} .scs__modal {
    --sz-bg: var(--scs-bg, var(--color-background));
    --sz-border: var(--scs-tb, var(--color-border));
    --sz-head-bg: var(--scs-ts, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
    --sz-head-text: var(--scs-title, var(--color-heading));
    --sz-text: var(--scs-text, var(--color-text));
    --sz-stripe: var(--scs-ts, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
    box-sizing: border-box;
    width: 100%;
    max-height: calc(var(--sl-vh, 1vh) * 85);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--scs-pad, 24px);
    background: var(--scs-bg, var(--color-background));
    color: var(--scs-text, var(--color-text));
    border-radius: var(--scs-radius, var(--rounded-radius, 8px));
    font-family: var(--scs-bf, var(--body-font, inherit));
    box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
  }
  #scs-{{ sid }} .scs__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  #scs-{{ sid }} .scs__title {
    margin: 0 !important;
    border: 0;
    color: var(--scs-title, var(--color-heading));
    font-size: var(--scs-title-fs, 20px);
    font-family: var(--scs-hf, var(--heading-font, inherit));
    font-weight: var(--heading-weight, 700);
    line-height: var(--heading-line-height, 1.2);
  }
  #scs-{{ sid }} .scs__close {
    flex: 0 0 auto;
    background: transparent;
    border: 0;
    width: 44px;
    height: 44px;
    margin: -10px -10px -10px 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 8px;
    color: var(--scs-title, var(--color-heading));
    transition: background .15s ease;
  }
  #scs-{{ sid }} .scs__close:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
  #scs-{{ sid }} .scs__close:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
  #scs-{{ sid }} .scs__close svg { width: 18px; height: 18px; }

  #scs-{{ sid }} .scs__body { display: flex; flex-direction: column; gap: 16px; font-size: 15px; line-height: 1.55; }
  #scs-{{ sid }} .scs__body :is(p, li) { font-family: inherit; }
  #scs-{{ sid }} .scs__table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  #scs-{{ sid }} .scs__table-wrap[hidden] { display: none; }
  #scs-{{ sid }} .scs__table-wrap:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #scs-{{ sid }} .scs__table { width: 100%; margin: 0; border-collapse: collapse; font-size: 14px; color: inherit; }
  #scs-{{ sid }} .scs__table :is(th, td) {
    padding: 10px 12px;
    border: 1px solid var(--scs-tb, var(--color-border));
    text-align: start;
    white-space: nowrap;
  }
  #scs-{{ sid }} .scs__table thead th {
    background: var(--scs-ts, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
    font-weight: var(--subheading-weight, 700);
    color: var(--scs-title, var(--color-heading));
  }
  #scs-{{ sid }} .scs__table tbody th { font-weight: var(--subheading-weight, 700); }
  #scs-{{ sid }} .scs__table tbody tr:nth-child(even) :is(td, th) { background: var(--scs-ts, color-mix(in srgb, var(--color-text) 5%, var(--color-background))); }
  #scs-{{ sid }} .scs__html { font-size: 14px; line-height: 1.55; }
  #scs-{{ sid }} .scs__html table { width: 100%; border-collapse: collapse; }
  #scs-{{ sid }} .scs__html :is(th, td) { padding: 10px 12px; border: 1px solid var(--scs-tb, var(--color-border)); text-align: left; }
  #scs-{{ sid }} .scs__html th { background: var(--scs-ts, color-mix(in srgb, var(--color-text) 5%, var(--color-background))); font-weight: var(--subheading-weight, 700); }
  #scs-{{ sid }} .scs__notes { font-size: 14px; line-height: 1.6; }
  #scs-{{ sid }} .scs__notes p { margin: 0; }
  #scs-{{ sid }} .scs__notes p + p { margin-top: 8px; }
  #scs-{{ sid }} .scs__empty { opacity: .7; margin: 0; font-style: italic; }
  @media (prefers-reduced-motion: reduce) {
    #scs-{{ sid }} .scs__dialog[open], #scs-{{ sid }} .scs__close { animation: none !important; transition: none !important; }
  }
  html.pc-lock { overflow: hidden; }
{% comment %}{% endcomment %}</style>
</template>

<schema>
{
  "type": "size-chart-popup",
  "name": "Size Chart Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "trig_text",
      "label": "Button text",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Title",
      "default": "Size Guide"
    },
    {
      "type": "checkbox",
      "id": "use_product_chart",
      "label": "Use the product's size chart",
      "default": true,
      "info": "When the product has a size chart in Storelib (Products > Size charts), it is shown instead of the rows below."
    },
    {
      "type": "text",
      "id": "headers",
      "label": "Column headers",
      "default": "Size|Chest (in)|Waist (in)|Hips (in)",
      "info": "Separate with |, for example Size|Chest|Waist. Add one Row block per size."
    },
    {
      "type": "text",
      "id": "row_1",
      "label": "Row 1 (separate with |)",
      "default": "S|34-36|28-30|34-36",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_2",
      "label": "Row 2 (separate with |)",
      "default": "M|38-40|32-34|38-40",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_3",
      "label": "Row 3 (separate with |)",
      "default": "L|42-44|36-38|42-44",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_4",
      "label": "Row 4 (separate with |)",
      "default": "XL|46-48|40-42|46-48",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_5",
      "label": "Row 5 (separate with |)",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_6",
      "label": "Row 6 (separate with |)",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_7",
      "label": "Row 7 (separate with |)",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "row_8",
      "label": "Row 8 (separate with |)",
      "hidden": true,
      "info": "Legacy: used only when the section has no Row block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "html",
      "id": "html",
      "label": "Custom HTML",
      "hidden": true,
      "info": "Legacy: used only when the section has no Custom HTML block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "notes",
      "label": "Notes",
      "default": "<p>All measurements are in inches. Sizes may vary slightly by style.</p>",
      "hidden": true,
      "info": "Legacy: used only when the section has no Notes block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "underline_text",
      "label": "Underline the text",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "trig_gap",
      "label": "Gap between icon and text",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "trig_pad_y",
      "label": "Padding top and bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "trig_pad_x",
      "label": "Padding left and right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "modal_width_d",
      "label": "Popup width (desktop)",
      "min": 360,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "modal_width_m",
      "label": "Popup width (mobile)",
      "min": 260,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 360
