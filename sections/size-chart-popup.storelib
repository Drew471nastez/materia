<template compat="shopify">
{% render 'theme-type' %}
{%- assign fb_accessibility_size_guide = 'accessibility.size_guide' | t -%}
{%- comment -%}
  Materia Themes — Size Chart Popup (standalone section)
  A self-contained size chart trigger + popup. Renders the trigger
  inline and opens a modal with a size chart table built directly
  from block settings — no Shopify Page required, no setup. Works
  100% out of the box with sensible defaults; the merchant can edit
  headers, rows, notes, and styling without touching liquid.

  Place this section anywhere on the product template (or any page)
  and the trigger appears wherever the section is mounted. Pairs
  with the Product Information section.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
-%}

<div class="scs-wrap" id="scs-{{ sid }}"
     style="
       --scs-align: {{ st.align | default: 'left' }};
       margin-top: {{ st.margin_top | default: 0 }}px;
       margin-bottom: {{ st.margin_bottom | default: 0 }}px;
       text-align: {{ st.align | default: 'left' }};
     ">

  <button type="button"
          class="scs__trigger{% if st.underline_text %} scs__trigger--underline{% endif %}"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="scs-dialog-{{ sid }}"
          data-scs-open
          style="
            color: {{ st.trig_color | default: '#111111' }};
            font-size: {{ st.trig_size | default: 16 }}px;
            font-weight: {{ st.trig_weight | default: '600' }};
            gap: {{ st.trig_gap | default: 8 }}px;
            padding: {{ st.trig_pad_y | default: 8 }}px {{ st.trig_pad_x | default: 0 }}px;
          ">
    {%- if st.show_icon -%}
      <span class="scs__icn" aria-hidden="true" style="width: {{ st.icon_size | default: 18 }}px; height: {{ st.icon_size | default: 18 }}px; color: {{ st.icon_color | default: st.trig_color | default: '#111111' }};">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/><path d="M7 4v4"/><path d="M12 10v4"/><path d="M17 16v4"/></svg>
      </span>
    {%- endif -%}
    <span class="scs__label">{{ st.trig_text | default: fb_accessibility_size_guide }}</span>
  </button>

  <div class="scs__overlay" data-scs-overlay hidden></div>

  <div id="scs-dialog-{{ sid }}"
       class="scs__dialog"
       role="dialog"
       aria-modal="true"
       aria-labelledby="scs-title-{{ sid }}"
       data-scs-dialog
       hidden>
    <div class="scs__modal" data-scs-modal
         style="
           background: {{ st.modal_bg | default: '#FFFFFF' }};
           color: {{ st.text_color | default: '#1F2937' }};
           border-radius: {{ st.modal_radius | default: 16 }}px;
           padding: {{ st.modal_padding | default: 24 }}px;
           --scs-mw-d: {{ st.modal_width_d | default: 720 }}px;
           --scs-mw-m: {{ st.modal_width_m | default: 360 }}px;
         ">
      <div class="scs__head">
        <h3 id="scs-title-{{ sid }}" class="scs__title"
            style="color: {{ st.title_color | default: '#111111' }}; font-size: {{ st.title_size | default: 20 }}px;">
          {{ st.modal_title | default: fb_accessibility_size_guide }}
        </h3>
        <button type="button" class="scs__close" aria-label="{{ 'accessibility.close_esc' | t }}" data-scs-close
                style="color: {{ st.title_color | default: '#111111' }};">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>

      <div class="scs__body">
        {%- if st.headers != blank -%}
          {%- assign headers = st.headers | split: '|' -%}
          <div class="scs__table-wrap">
            <table class="scs__table"
                   style="
                     --scs-tb: {{ st.table_border_color | default: '#E5E7EB' }};
                     --scs-ts: {{ st.table_stripe_color | default: '#F9FAFB' }};
                     --scs-th: {{ st.title_color | default: '#111111' }};
                   ">
              <thead>
                <tr>
                  {%- for h in headers -%}<th>{{ h | strip }}</th>{%- endfor -%}
                </tr>
              </thead>
              <tbody>
                {%- for n in (1..8) -%}
                  {%- assign key = 'row_' | append: n -%}
                  {%- assign row_value = st[key] -%}
                  {%- if row_value != blank -%}
                    {%- assign cells = row_value | split: '|' -%}
                    <tr>
                      {%- for c in cells -%}<td>{{ c | strip }}</td>{%- endfor -%}
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}

        {%- if st.html != blank -%}
          <div class="scs__html"
               style="--scs-tb: {{ st.table_border_color | default: '#E5E7EB' }}; --scs-ts: {{ st.table_stripe_color | default: '#F9FAFB' }};">
            {{ st.html }}
          </div>
        {%- endif -%}

        {%- if st.notes != blank -%}
          <div class="scs__notes">{{ st.notes }}</div>
        {%- endif -%}

        {%- if st.headers == blank and st.html == blank and st.notes == blank -%}
          <p class="scs__empty">Add column headers and rows in the section settings to build your size chart, or paste an HTML table in the “Custom HTML” field.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #scs-{{ sid }} { display: block; }
  #scs-{{ sid }} .scs__trigger {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    line-height: 1.2;
    font-family: inherit;
  }
  #scs-{{ sid }} .scs__trigger--underline { text-decoration: underline; text-underline-offset: 2px; }
  #scs-{{ sid }} .scs__trigger:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  #scs-{{ sid }} .scs__icn { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  #scs-{{ sid }} .scs__icn svg { width: 100%; height: 100%; display: block; }

  #scs-{{ sid }} .scs__overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.5);
    opacity: 0; pointer-events: none;
    transition: opacity .2s ease;
    z-index: 9998;
  }
  #scs-{{ sid }} .scs__overlay.is-open { opacity: 1; pointer-events: auto; }

  #scs-{{ sid }} .scs__dialog {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
    padding: 16px;
    opacity: 0; pointer-events: none;
    transition: opacity .2s ease;
  }
  #scs-{{ sid }} .scs__dialog.is-open { opacity: 1; pointer-events: auto; }

  #scs-{{ sid }} .scs__modal {
    width: 100%;
    max-width: var(--scs-mw-m);
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,.3);
    transform: translateY(8px);
    transition: transform .2s ease;
  }
  #scs-{{ sid }} .scs__dialog.is-open .scs__modal { transform: translateY(0); }
  @media (min-width: 600px) {
    #scs-{{ sid }} .scs__modal { max-width: var(--scs-mw-d); }
  }

  #scs-{{ sid }} .scs__head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  #scs-{{ sid }} .scs__title {
    margin: 0 !important;
    font-weight: var(--heading-weight, 700);
    line-height: var(--heading-line-height, 1.2);
    letter-spacing: var(--heading-letter-spacing, normal);
    text-transform: var(--heading-text-transform, none);
  }
  #scs-{{ sid }} .scs__close {
    background: transparent; border: 0;
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 8px;
    transition: background .15s ease;
  }
  #scs-{{ sid }} .scs__close:hover { background: rgba(0,0,0,.06); }
  #scs-{{ sid }} .scs__close:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  #scs-{{ sid }} .scs__close svg { width: 18px; height: 18px; }

  #scs-{{ sid }} .scs__body {
    display: flex; flex-direction: column; gap: 16px;
    font-size: 15px; line-height: 1.55;
  }
  #scs-{{ sid }} .scs__table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  #scs-{{ sid }} .scs__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  #scs-{{ sid }} .scs__table th,
  #scs-{{ sid }} .scs__table td {
    padding: 10px 12px;
    border: 1px solid var(--scs-tb);
    text-align: left;
    white-space: nowrap;
  }
  #scs-{{ sid }} .scs__table th {
    background: var(--scs-ts);
    font-weight: var(--subheading-weight, 700);
    color: var(--scs-th);
  }
  #scs-{{ sid }} .scs__table tbody tr:nth-child(even) td {
    background: var(--scs-ts);
  }
  #scs-{{ sid }} .scs__html { font-size: 14px; line-height: 1.55; }
  #scs-{{ sid }} .scs__html table { width: 100%; border-collapse: collapse; }
  #scs-{{ sid }} .scs__html th, #scs-{{ sid }} .scs__html td { padding: 10px 12px; border: 1px solid var(--scs-tb); text-align: left; }
  #scs-{{ sid }} .scs__html th { background: var(--scs-ts); font-weight: var(--subheading-weight, 700); }
  #scs-{{ sid }} .scs__notes { font-size: 14px; line-height: 1.6; }
  #scs-{{ sid }} .scs__notes p { margin: 0; }
  #scs-{{ sid }} .scs__notes p + p { margin-top: 8px; }
  #scs-{{ sid }} .scs__empty { color: #6B7280; margin: 0; font-style: italic; }

  html.scs-lock { overflow: hidden; }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  var root = document.getElementById('scs-{{ sid }}');
  if (!root || root.__scsInit) return;
  root.__scsInit = true;

  var trigger = root.querySelector('[data-scs-open]');
  var overlay = root.querySelector('[data-scs-overlay]');
  var dialog  = root.querySelector('[data-scs-dialog]');
  var modal   = root.querySelector('[data-scs-modal]');
  var closeBtn= root.querySelector('[data-scs-close]');
  var lastFocus = null;

  if (!trigger || !overlay || !dialog || !modal || !closeBtn) return;

  function open(){
    lastFocus = document.activeElement;
    overlay.hidden = false;
    dialog.hidden = false;
    requestAnimationFrame(function(){
      overlay.classList.add('is-open');
      dialog.classList.add('is-open');
      trigger.setAttribute('aria-expanded','true');
      document.documentElement.classList.add('scs-lock');
      closeBtn.focus();
    });
    document.addEventListener('keydown', onKey);
    dialog.addEventListener('click', onOutside);
  }
  function close(){
    overlay.classList.remove('is-open');
    dialog.classList.remove('is-open');
    trigger.setAttribute('aria-expanded','false');
    document.documentElement.classList.remove('scs-lock');
    setTimeout(function(){
      overlay.hidden = true;
      dialog.hidden = true;
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus({preventScroll:true});
      }
    }, 200);
    document.removeEventListener('keydown', onKey);
    dialog.removeEventListener('click', onOutside);
  }
  function onOutside(e){ if (!modal.contains(e.target)) close(); }
  function onKey(e){ if (e.key === 'Escape') { e.preventDefault(); close(); } }

  trigger.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', close);
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "size-chart-popup",
  "name": "Size Chart Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Trigger button"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "underline_text",
      "label": "Underline trigger text",
      "default": false
    },
    {
      "type": "text",
      "id": "trig_text",
      "label": "Trigger text",
      "default": "Size Guide"
    },
    {
      "type": "color",
      "id": "trig_color",
      "label": "Trigger text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Trigger icon color (override)"
    },
    {
      "type": "range",
      "id": "trig_size",
      "label": "Trigger font size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "trig_weight",
      "label": "Trigger font weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "trig_gap",
      "label": "Gap icon → text",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "trig_pad_y",
      "label": "Trigger padding y",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "trig_pad_x",
      "label": "Trigger padding x",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "align",
      "label": "Trigger alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Modal title"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal title",
      "default": "Size Guide"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Size chart table"
    },
    {
      "type": "text",
      "id": "headers",
      "label": "Column headers (separate with |)",
      "default": "Size|Chest (in)|Waist (in)|Hips (in)"
    },
    {
      "type": "text",
      "id": "row_1",
      "label": "Row 1 (separate with |)",
      "default": "S|34-36|28-30|34-36"
    },
    {
      "type": "text",
      "id": "row_2",
      "label": "Row 2 (separate with |)",
      "default": "M|38-40|32-34|38-40"
    },
    {
      "type": "text",
      "id": "row_3",
      "label": "Row 3 (separate with |)",
      "default": "L|42-44|36-38|42-44"
    },
    {
      "type": "text",
      "id": "row_4",
      "label": "Row 4 (separate with |)",
      "default": "XL|46-48|40-42|46-48"
    },
    {
      "type": "text",
      "id": "row_5",
      "label": "Row 5 (separate with |)"
    },
    {
      "type": "text",
      "id": "row_6",
      "label": "Row 6 (separate with |)"
    },
    {
      "type": "text",
      "id": "row_7",
      "label": "Row 7 (separate with |)"
    },
    {
      "type": "text",
      "id": "row_8",
      "label": "Row 8 (separate with |)"
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Custom HTML (optional)"
    },
    {
      "type": "html",
      "id": "html",
      "label": "Custom HTML"
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Notes (optional)"
    },
    {
      "type": "richtext",
      "id": "notes",
      "label": "Notes",
      "default": "<p>All measurements are in inches. Sizes may vary slightly by style.</p>"
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Modal style"
    },
    {
      "type": "color",
      "id": "modal_bg",
      "label": "Modal background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "table_border_color",
      "label": "Table border color",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "table_stripe_color",
      "label": "Header / stripe row color",
      "default": "#F9FAFB"
    },
    {
      "type": "range",
      "id": "modal_radius",
      "label": "Modal corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "modal_padding",
      "label": "Modal inner padding",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "modal_width_d",
      "label": "Modal width (desktop)",
      "min": 360,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "modal_width_m",
      "label": "Modal width (mobile)",
      "min": 260,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Section margin top",
      "min": -40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Section margin bottom",
      "min": -40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Size Chart Popup",
      "category": "Product"
    }
  ],
  "allowed_templates": [
    "product"
  ],
  "shopify": {
