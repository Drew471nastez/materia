<template compat="shopify">
<script src="{{ 'live-announcements.js' | asset_url }}" defer="defer"></script>
{%- comment -%} Runtime: shopify/assets/live-announcements.js (loaded by the layout on every page) runs the slides, the marquee, the countdowns and the close button per instance (paused off screen) and applies live edits. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign fonts = st.enable_custom_fonts
  assign custom = st.enable_custom_style
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- render 'announce-frame', section: section -%}
{%- if fonts -%}<style>{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- for block in section.blocks -%}{%- if block.settings.enable_custom_fonts and block.settings.font.family != blank -%}<style>{{ block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}{%- endfor -%}
{%- liquid
  assign sid = section.id
  assign shown_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign shown_count = shown_count | plus: 1
    endif
  endfor
  assign multi = false
  if shown_count > 1
    assign multi = true
  endif
  assign page = request.page_type
-%}
<style>
  #shopify-section-{{ sid }} .ab2 { position: relative; z-index: 10; display: block; background: var(--ab2-bg); color: var(--ab2-text); font-family: var(--ab2-ff); font-weight: var(--ab2-fw); font-size: var(--ab2-fs); text-transform: var(--ab2-tt); text-align: center; border-bottom: var(--ab2-lw) solid var(--ab2-line); padding: var(--ab2-pt) 0 var(--ab2-pb); }
  #shopify-section-{{ sid }} .ab2[data-home-only='true']:not([data-page='index']) { display: none; }
  #shopify-section-{{ sid }} .ab2__inner { position: relative; width: 100%; margin-inline: auto; padding-inline: 16px; }
  #shopify-section-{{ sid }} .ab2[data-width='container'] .ab2__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .ab2[data-width='fluid_container'] .ab2__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .ab2[data-close='true'] .ab2__inner { padding-inline: 44px; }
  #shopify-section-{{ sid }} .ab2__msg { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 12px; color: var(--b-c, var(--ab2-text)); font-family: var(--b-f, inherit); font-weight: var(--b-w, inherit); line-height: 1.4; }
  #shopify-section-{{ sid }} .ab2__text :is(p, strong, em, a, span) { font-family: inherit; color: inherit; margin: 0; }
  #shopify-section-{{ sid }} .ab2__text a { text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .ab2__timer { display: inline-flex; gap: 8px; align-items: baseline; font-variant-numeric: tabular-nums; color: var(--ab2-accent); white-space: nowrap; }
  #shopify-section-{{ sid }} .ab2__unit { display: inline-flex; gap: 3px; align-items: baseline; }
  #shopify-section-{{ sid }} .ab2__num { font-weight: var(--heading-weight, 700); min-width: 2ch; }
  #shopify-section-{{ sid }} .ab2__lbl { font-size: .85em; opacity: .85; }
  #shopify-section-{{ sid }} .ab2__timer[data-ended='true']:has([data-an-ended]:not([hidden])) .ab2__unit { display: none; }
  #shopify-section-{{ sid }} .ab2__slides { display: flex; align-items: center; justify-content: center; gap: 4px; }
  #shopify-section-{{ sid }} .ab2__viewport { display: grid; flex: 1 1 auto; min-width: 0; max-width: 55rem; overflow: hidden; }
  #shopify-section-{{ sid }} .ab2__slide { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; min-width: 0; padding-inline: 8px; }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='slide'] .ab2__slide { opacity: 0; visibility: hidden; transform: translateY(100%); transition: transform .45s ease, opacity .45s ease, visibility 0s .45s; }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='slide'] .ab2__slide[data-active] { opacity: 1; visibility: visible; transform: none; transition: transform .45s ease, opacity .45s ease; }
  #shopify-section-{{ sid }} .ab2__arrow { display: none; flex: 0 0 44px; width: 44px; height: 44px; align-items: center; justify-content: center; padding: 0; margin: 0; border: 0; background: transparent; color: inherit; opacity: .6; cursor: pointer; box-shadow: none; }
  #shopify-section-{{ sid }} .ab2__arrow:hover { opacity: 1; }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='slide'] .ab2__arrow { display: inline-flex; }
  #shopify-section-{{ sid }} .ab2__marquee { display: none; overflow: hidden; gap: var(--ab2-gap); }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='marquee'] .ab2__slides { display: none; }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='marquee'] .ab2__marquee { display: flex; }
  #shopify-section-{{ sid }} .ab2[data-multi='true'][data-mode='marquee'] .ab2__inner { padding-inline: 0; }
  #shopify-section-{{ sid }} .ab2__group { display: flex; flex-shrink: 0; align-items: center; gap: var(--ab2-gap); width: max-content; white-space: nowrap; animation: ab2Marquee var(--ab2-speed) linear infinite; }
  #shopify-section-{{ sid }} .ab2__marquee:hover .ab2__group, #shopify-section-{{ sid }} .ab2[data-paused] .ab2__group { animation-play-state: paused; }
  #shopify-section-{{ sid }} .ab2__item { display: inline-flex; align-items: center; gap: var(--ab2-gap); }
  #shopify-section-{{ sid }} .ab2__item .ab2__msg { flex-wrap: nowrap; }
  #shopify-section-{{ sid }} .ab2__icon { display: inline-flex; color: var(--ab2-accent); font-size: .8em; }
  #shopify-section-{{ sid }} .ab2[data-icon='none'] .ab2__icon { display: none; }
  @keyframes ab2Marquee { from { transform: translateX(0); } to { transform: translateX(calc(-100% - var(--ab2-gap))); } }
  #shopify-section-{{ sid }} .ab2__close { position: absolute; inset-inline-end: 0; top: 50%; transform: translateY(-50%); display: none; width: 44px; height: 44px; align-items: center; justify-content: center; padding: 0; margin: 0; border: 0; background: transparent; color: inherit; cursor: pointer; z-index: 2; box-shadow: none; }
  #shopify-section-{{ sid }} .ab2__close svg { opacity: .6; } #shopify-section-{{ sid }} .ab2__close:hover svg { opacity: 1; }
  #shopify-section-{{ sid }} .ab2[data-close='true'] .ab2__close { display: inline-flex; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .ab2[data-show-mobile='false'] { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ab2__group { animation: none; }
    #shopify-section-{{ sid }} .ab2__group[aria-hidden='true'] { display: none; }
    #shopify-section-{{ sid }} .ab2__marquee { overflow-x: auto; }
    #shopify-section-{{ sid }} .ab2 .ab2__slide { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
{%- capture ab2_vars -%}
--ab2-fs: {{ st.font_size }}px;--ab2-pt: {{ st.padding_top }}px;--ab2-pb: {{ st.padding_bottom }}px;--ab2-speed: {{ st.speed }}s;--ab2-gap: {{ st.space_between }}px;
--ab2-fw: {% case st.font_weight %}{% when 'heading_weight' %}var(--heading-weight, 600){% when 'subheading_weight' %}var(--subheading-weight, 600){% else %}{% if fonts %}{% render 'announce-font', font: st.body_font, on: true, fallback: 'var(--body-weight, 400)', weight: true %}{% else %}var(--body-weight, 400){% endif %}{% endcase %};--ab2-tt: {% if st.uppercase %}uppercase{% else %}none{% endif %};
--ab2-ff: {% render 'announce-font', font: st.body_font, on: fonts, fallback: 'var(--body-font)' %};
--ab2-text: {% if custom %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--ab2-bg: {% if custom %}{% render 'scheme-color', color: st.background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--ab2-accent: {% if custom %}{% render 'scheme-color', color: st.accent_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--ab2-line: {% if custom %}{% render 'scheme-color', color: st.line_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};--ab2-lw: {% if st.show_separator_line %}1px{% else %}0px{% endif %};
{%- endcapture -%}
<div id="announcement-bar-pro-2-{{ sid }}" class="ab2 announcement-bar-pro-2 color-{{ color_scheme }} gradient" role="region" aria-label="Announcements" data-an-root="announcement-bar" data-an-section="{{ sid }}"{% if request.design_mode %} data-an-settings="{{ section.settings | json | escape }}"{% endif %}{% if request.design_mode %} data-an-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;full_width&quot;,&quot;reset_spacing&quot;:true,&quot;homepage_only&quot;:true,&quot;show_mobile&quot;:true,&quot;label_days&quot;:&quot;Days&quot;,&quot;label_hours&quot;:&quot;Hours&quot;,&quot;label_minutes&quot;:&quot;Mins&quot;,&quot;label_seconds&quot;:&quot;Secs&quot;,&quot;announcement_actions&quot;:&quot;slide&quot;,&quot;icon_between_item&quot;:&quot;none&quot;,&quot;space_between&quot;:50,&quot;show_separator_line&quot;:true,&quot;enable_custom_style&quot;:false,&quot;show_close&quot;:true,&quot;enable_custom_fonts&quot;:false,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;font_size&quot;:12,&quot;font_weight&quot;:&quot;subheading_weight&quot;,&quot;uppercase&quot;:false,&quot;reveal&quot;:true,&quot;change_every&quot;:3,&quot;speed&quot;:15,&quot;padding_top&quot;:12,&quot;padding_bottom&quot;:12,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0&#125;"{% endif %}{% if request.design_mode %} data-an-block-defaults="&#123;&quot;announcement&quot;:&#123;&quot;text&quot;:&quot;Welcome to our store&quot;,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;font&quot;:&quot;assistant_n4&quot;&#125;&#125;"{% endif %} data-width="{{ st.section_width | default: 'full_width' }}" data-reset="{% if st.reset_spacing %}true{% else %}false{% endif %}" data-mode="{% if st.announcement_actions == 'marquee' %}marquee{% else %}slide{% endif %}" data-multi="{{ multi }}" data-page="{{ page }}" data-home-only="{% if st.homepage_only %}true{% else %}false{% endif %}" data-show-mobile="{% if st.show_mobile == false %}false{% else %}true{% endif %}" data-close="{% if st.show_close %}true{% else %}false{% endif %}" data-icon="{{ st.icon_between_item | default: 'none' }}" data-interval="{{ st.change_every | default: 3 }}" data-sticky-announcement="false"{% if fonts %} data-own-font data-own-weight{% endif %} style="{{ ab2_vars | strip_newlines }}">
  <div class="ab2__inner">
    <div class="ab2__slides" data-an-slides>
      <button type="button" class="ab2__arrow" data-an-prev aria-label="Previous announcement"><svg width="8" height="14" viewBox="0 0 8 14" aria-hidden="true" focusable="false"><path d="M7 1 1 7l6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="ab2__viewport" aria-live="off">
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- assign bfont = false -%}{%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign bfont = true -%}{%- endif -%}
          {%- assign active = false -%}{%- if bs.text != blank and shown == 0 -%}{%- assign active = true -%}{%- assign shown = 1 -%}{%- endif -%}
          <div class="ab2__slide" {% render 'announce-block', block: block %}{% if active %} data-active{% elsif multi %} aria-hidden="true"{% endif %}{% if bs.text == blank %} hidden{% endif %}>
            <span class="ab2__msg"{% if bfont %} data-own-font data-own-weight{% endif %} style="{% if bs.enable_custom_style %}--b-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--ab2-text)' %};{% endif %}{% if bfont %}--b-f: {% render 'announce-font', font: bs.font, on: true, fallback: 'inherit' %};--b-w: {{ bs.font.weight | default: 400 }};{% endif %}">{% render 'announce-ab2-message', block: block, section: section %}</span>
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="ab2__arrow" data-an-next aria-label="Next announcement"><svg width="8" height="14" viewBox="0 0 8 14" aria-hidden="true" focusable="false"><path d="m1 1 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="ab2__marquee" data-an-track>
      {%- for i in (1..4) -%}
        <div class="ab2__group"{% if forloop.first %} data-an-group{% else %} aria-hidden="true" data-an-copies{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign bs = block.settings -%}
            {%- assign bfont = false -%}{%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign bfont = true -%}{%- endif -%}
            <span class="ab2__item" data-an-copy="{{ block.id }}"{% if bs.text == blank %} hidden{% endif %}><span class="ab2__msg"{% if bfont %} data-own-font data-own-weight{% endif %} style="{% if bs.enable_custom_style %}--b-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--ab2-text)' %};{% endif %}{% if bfont %}--b-f: {% render 'announce-font', font: bs.font, on: true, fallback: 'inherit' %};--b-w: {{ bs.font.weight | default: 400 }};{% endif %}">{% render 'announce-ab2-message', block: block, section: section %}</span><span class="ab2__icon" aria-hidden="true">{% if st.icon_between_item == 'star' %}{% render 'announce-icon', icon: 'fa-star' %}{% else %}{% render 'announce-icon', icon: 'fa-circle' %}{% endif %}</span></span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <button type="button" class="ab2__close announcement-bar-close" data-an-close aria-label="Close announcement"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m1 1 10 10M11 1 1 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
</div>

</template>

<schema>
{
  "type": "announcement-bar",
  "name": "Announcement Bar Pro 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width",
      "label": "Section width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_only",
      "default": true,
      "label": "Home page only"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "default": true,
      "label": "Show on mobile"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content"
    },
    {
      "type": "paragraph",
      "id": "para_8",
      "label": "Each Announcement block is one message, with an optional countdown.",
      "content": "Each Announcement block is one message, with an optional countdown."
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Countdown days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Countdown hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Countdown minutes label",
      "default": "Mins"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Countdown seconds label",
      "default": "Secs"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "announcement_actions",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ],
      "default": "slide",
      "label": "With several messages",
      "info": "One message stays still."
    },
    {
      "type": "select",
      "id": "icon_between_item",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "star",
          "label": "Star"
        }
      ],
      "default": "none",
      "label": "Icon between messages",
      "visible_if": "{{ section.settings.announcement_actions == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "space_between",
      "min": 10,
      "max": 100,
      "step": 1,
      "label": "Space between messages",
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.announcement_actions == 'marquee' }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "show_separator_line",
      "default": true,
      "label": "Bottom line"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Countdown and icons",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Bottom line",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_separator_line }}"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "default": true,
      "label": "Close button"
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: the bar follows Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "label": "Text size",
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "Body"
        },
        {
          "value": "subheading_weight",
          "label": "Subheading"
        },
        {
          "value": "heading_weight",
          "label": "Heading"
        }
      ],
      "default": "subheading_weight",
      "label": "Text weight"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "change_every",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Change every",
      "unit": "s",
      "default": 3,
      "visible_if": "{{ section.settings.announcement_actions == 'slide' }}",
      "info": "Pauses on hover and for visitors who reduce motion."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee loop duration",
      "default": 15,
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "s",
      "visible_if": "{{ section.settings.announcement_actions == 'marquee' }}",
      "info": "Lower is faster. Stops for visitors who reduce motion."
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 12,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 12,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
