<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image With Text Multirow.
  A stack of image and text rows, one row per block. Rows alternate the image
  side on desktop (or each row picks its own side) and stack on mobile.
  Colours follow the colour scheme; custom colours and fonts are opt-in.
  Every value is a --tg-* / --iwm-* variable written again live by
  media-live-text-grid.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.5%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  case st.content_align
    when 'center'
      assign ai = 'center'
      assign ta = 'center'
    when 'right'
      assign ai = 'flex-end'
      assign ta = 'right'
    else
      assign ai = 'flex-start'
      assign ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign ai_m = 'center'
      assign ta_m = 'center'
    when 'right'
      assign ai_m = 'flex-end'
      assign ta_m = 'right'
    else
      assign ai_m = 'flex-start'
      assign ta_m = 'left'
  endcase
  assign hw = ''
  if st.heading_weight != blank and st.heading_weight != 'theme'
    assign hw = st.heading_weight
  endif
-%}
<style data-tg-margins>{% render 'media-tg-base', st: st, sid: sid, bp: 900, part: 'margins' %}</style>
<style>
{% render 'media-tg-base', st: st, sid: sid, bp: 900 %}
#shopify-section-{{ sid }} .iwm__rows { display: flex; flex-direction: column; gap: var(--iwm-rg-m); }
#shopify-section-{{ sid }} .iwm__row { display: flex; flex-direction: column; align-items: center; gap: var(--iwm-cg-m); background: var(--iwm-row-bg, transparent); padding: var(--iwm-row-pad, 0px); border-radius: var(--iwm-row-r, 0px); }
#shopify-section-{{ sid }} .iwm__media, #shopify-section-{{ sid }} .iwm__text { width: 100%; min-width: 0; }
#shopify-section-{{ sid }} .iwm__media { overflow: hidden; border-radius: var(--iwm-r); aspect-ratio: var(--iwm-ar); background: var(--iwm-img-bg, color-mix(in srgb, var(--color-text) 8%, var(--color-background))); }
#shopify-section-{{ sid }} .iwm__media img { width: 100%; height: 100%; display: block; object-fit: var(--iwm-fit); }
#shopify-section-{{ sid }} .iwm__text { display: flex; flex-direction: column; gap: var(--iwm-cgap); align-items: var(--iwm-ai-m); text-align: var(--iwm-ta-m); }
#shopify-section-{{ sid }} .iwm__text > * { margin: 0; max-width: 100%; }
#shopify-section-{{ sid }} .iwm__caption { font-size: var(--iwm-cap-size); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; line-height: 1.2; color: var(--iwm-cap-c, inherit); }
#shopify-section-{{ sid }} .iwm .iwm__heading { font-size: var(--iwm-h-m); font-weight: var(--iwm-hw, var(--tg-hw, var(--heading-weight, 700))); line-height: 1.1; letter-spacing: -0.01em; color: var(--iwm-head-c, var(--color-heading)); }
#shopify-section-{{ sid }} .iwm__body { font-size: var(--iwm-b-m); line-height: 1.6; max-width: 540px; color: var(--iwm-body-c, inherit); }
#shopify-section-{{ sid }} .iwm__body p { margin: 0 0 .5em; }
#shopify-section-{{ sid }} .iwm__body > :last-child { margin-bottom: 0; }
@media (min-width: 900px) {
  #shopify-section-{{ sid }} .iwm__rows { gap: var(--iwm-rg-d); }
  #shopify-section-{{ sid }} .iwm__row { flex-direction: row; gap: var(--iwm-cg-d); }
  #shopify-section-{{ sid }} .iwm__row[data-side="right"] { flex-direction: row-reverse; }
  #shopify-section-{{ sid }} .iwm__text { flex: 0 0 var(--iwm-tw); width: auto; align-items: var(--iwm-ai-d); text-align: var(--iwm-ta-d); }
  #shopify-section-{{ sid }} .iwm__media { flex: 1 1 0; width: auto; }
  #shopify-section-{{ sid }} .iwm .iwm__heading { font-size: var(--iwm-h-d); }
  #shopify-section-{{ sid }} .iwm__body { font-size: var(--iwm-b-d); }
}
{% comment %}{% endcomment %}</style>
<div id="iwm-{{ sid }}" class="tg iwm section sec__image-text-multirow color-{{ color_scheme }} gradient" data-tg-root="multirow" data-tg-section="{{ sid }}" data-tg-placeholder="{{ placeholder }}" data-tg-settings="{{ st | json | escape }}" data-tg-defaults='{"color_scheme":"default-color-scheme","section_width":"container","reset_spacing":true,"alternate_rows":true,"content_align":"left","text_column_width":50,"row_gap_desktop":80,"col_gap_desktop":60,"content_gap":14,"image_aspect_w":1,"image_aspect_h":1,"image_fit":"cover","image_radius":12,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","caption_size":12,"heading_size_desktop":40,"heading_weight":"theme","body_size_desktop":16,"padding_top_desktop":100,"padding_bottom_desktop":100,"side_padding_desktop":32,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"content_align_mobile":"left","row_gap_mobile":40,"col_gap_mobile":24,"heading_size_mobile":30,"body_size_mobile":14,"padding_top_mobile":60,"padding_bottom_mobile":60,"side_padding_mobile":20,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-tg-block-defaults='{"row":{"caption":"CAPTION","heading":"Row","heading_tag":"h3","body":"\u003cp>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.\u003c/p>","btn_label":"Button label","image_position":"auto","content_align_desktop":"section","content_align_mobile":"section","row_padding":0,"row_radius":0,"enable_custom_style":false,"row_bg":"rgba(0,0,0,0)","use_theme_button":true,"btn_padding_x":26,"btn_padding_y":14,"btn_radius":8,"btn_border_width":1,"btn_font_size":14,"btn_font_weight":"500"}}'
  style="{% render 'media-tg-vars', st: st, text_color: true %}--iwm-ai-d:{{ ai }};--iwm-ta-d:{{ ta }};--iwm-ai-m:{{ ai_m }};--iwm-ta-m:{{ ta_m }};--iwm-tw:{{ st.text_column_width | default: 50 }}%;--iwm-rg-d:{{ st.row_gap_desktop | default: 80 }}px;--iwm-rg-m:{{ st.row_gap_mobile | default: 40 }}px;--iwm-cg-d:{{ st.col_gap_desktop | default: 60 }}px;--iwm-cg-m:{{ st.col_gap_mobile | default: 24 }}px;--iwm-cgap:{{ st.content_gap | default: 14 }}px;--iwm-ar:{{ st.image_aspect_w | default: 1 }} / {{ st.image_aspect_h | default: 1 }};--iwm-r:{{ st.image_radius | default: 12 }}px;--iwm-fit:{{ st.image_fit | default: 'cover' }};--iwm-cap-size:{{ st.caption_size | default: 12 }}px;--iwm-h-d:{{ st.heading_size_desktop | default: 40 }}px;--iwm-h-m:{{ st.heading_size_mobile | default: 30 }}px;{% if hw != '' %}--iwm-hw:{{ hw }};{% endif %}--iwm-b-d:{{ st.body_size_desktop | default: 16 }}px;--iwm-b-m:{{ st.body_size_mobile | default: 14 }}px;{% if st.enable_custom_style %}--iwm-img-bg:{% render 'scheme-color', color: st.image_bg, fallback: 'initial' %};--iwm-cap-c:{% render 'scheme-color', color: st.caption_color, fallback: 'initial' %};--iwm-head-c:{% render 'scheme-color', color: st.heading_color, fallback: 'initial' %};--iwm-body-c:{% render 'scheme-color', color: st.body_color, fallback: 'initial' %};{% endif %}">
  <div class="tg__inner iwm__inner">
    <div class="iwm__rows">
      {%- assign row_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          {%- liquid
            assign rs = block.settings
            assign row_index = row_index | plus: 1
            assign even = row_index | modulo: 2
            if rs.image_position == 'left' or rs.image_position == 'right'
              assign side = rs.image_position
            elsif st.alternate_rows and even == 0
              assign side = 'right'
            else
              assign side = 'left'
            endif
            assign r_ai = ''
            assign r_ta = ''
            case rs.content_align_desktop
              when 'left'
                assign r_ai = 'flex-start'
                assign r_ta = 'left'
              when 'center'
                assign r_ai = 'center'
                assign r_ta = 'center'
              when 'right'
                assign r_ai = 'flex-end'
                assign r_ta = 'right'
            endcase
            assign r_ai_m = ''
            assign r_ta_m = ''
            case rs.content_align_mobile
              when 'left'
                assign r_ai_m = 'flex-start'
                assign r_ta_m = 'left'
              when 'center'
                assign r_ai_m = 'center'
                assign r_ta_m = 'center'
              when 'right'
                assign r_ai_m = 'flex-end'
                assign r_ta_m = 'right'
            endcase
            assign custom_btn = true
            if rs.use_theme_button
              assign custom_btn = false
            endif
          -%}
          <div class="iwm__row" data-block-id="{{ block.id }}" data-tg-block="{{ block.id }}" data-tg-type="row" data-tg-settings="{{ rs | json | escape }}" data-side="{{ side }}" {{ block.shopify_attributes }}
            style="--iwm-row-pad:{{ rs.row_padding | default: 0 }}px;--iwm-row-r:{{ rs.row_radius | default: 0 }}px;{% if r_ai != '' %}--iwm-ai-d:{{ r_ai }};--iwm-ta-d:{{ r_ta }};{% endif %}{% if r_ai_m != '' %}--iwm-ai-m:{{ r_ai_m }};--iwm-ta-m:{{ r_ta_m }};{% endif %}{% if rs.enable_custom_style %}--iwm-row-bg:{% render 'scheme-color', color: rs.row_bg, fallback: 'initial' %};{% endif %}">
            <div class="iwm__media">
              {%- if rs.image != blank -%}
                <img src="{{ rs.image | image_url: width: 1200 }}" srcset="{{ rs.image | image_url: width: 600 }} 600w, {{ rs.image | image_url: width: 900 }} 900w, {{ rs.image | image_url: width: 1200 }} 1200w" sizes="(min-width: 900px) 50vw, 100vw" alt="{{ rs.image.alt | default: rs.heading | strip_html | escape }}" width="{{ rs.image.width | default: 1200 }}" height="{{ rs.image.height | default: 1200 }}" loading="lazy" decoding="async">
              {%- else -%}
                <img class="tg__ph" src="{{ placeholder }}" alt="" width="400" height="300" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
            <div class="iwm__text">
              <p class="iwm__caption"{% if rs.caption == blank %} hidden{% endif %}>{{ rs.caption | escape }}</p>
              <h2 class="tg__h iwm__heading"{% if rs.heading == blank %} hidden{% endif %}>{{ rs.heading }}</h2>
              <div class="iwm__body"{% if rs.body == blank %} hidden{% endif %}>{{ rs.body }}</div>
              {%- if rs.btn_link != blank -%}<a href="{{ rs.btn_link | url }}"{% else %}<button type="button"{% endif %} class="iwm__btn" data-theme-button="primary" data-sl-button{% if rs.btn_label == blank %} hidden{% endif %} style="{% if rs.enable_custom_style %}{% render 'button-overrides', bg: rs.btn_bg, text: rs.btn_color, border: rs.btn_border_color, hover_bg: rs.btn_bg_hover, hover_text: rs.btn_color_hover, hover_border: rs.btn_border_color_hover %}{% endif %}{% render 'button-overrides', custom: custom_btn, radius: rs.btn_radius, padding_y: rs.btn_padding_y, padding_x: rs.btn_padding_x, font_size: rs.btn_font_size, weight: rs.btn_font_weight, border_width: rs.btn_border_width %}">{{ rs.btn_label | escape }}{% if rs.btn_link != blank %}</a>{% else %}</button>{% endif %}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "image-with-text-multirow",
  "name": "Image With Text Multirow",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alternate_rows",
      "label": "Alternate image side",
      "default": true
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Text alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Gap between rows (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Gap between rows (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Gap inside row (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Gap inside row (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between text blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_aspect_w",
      "label": "Image ratio width",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_aspect_h",
      "label": "Image ratio height",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image placeholder background"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Typography"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color"
    },
    {
      "type": "range",
      "id": "caption_size",
      "label": "Caption size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 22,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semibold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        },
        {
          "value": "800",
          "label": "Extra bold (800)"
        }
      ]
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color"
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Custom fonts"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Colors and spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
