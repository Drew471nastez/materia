<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Multirow

  A stack of image + text rows (each row = one block). Rows can
  alternate between image-left / image-right automatically, or each
  row can override its own direction.

  All design + spacing controls live at the section level so all
  rows stay consistent. Each row block carries its own copy + image.

  Block types:
    - row     (repeatable) — image + caption + heading + body + button

  Section settings: layout width, alternate direction, gap between
  rows, image aspect, text alignment, full color/spacing controls,
  remove default space toggle.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase
-%}

<style>
  /* Custom fonts (override theme defaults inside this section only) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6),
    #shopify-section-{{ section.id }} .iwm__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }

  /* Section margins + reset */
  {%- if st.section_bg != blank and st.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .iwm { background: {{ st.section_bg }}; }
  {%- endif -%}
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .iwm__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .iwm__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .iwm__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  /* Outer wrap */
  #shopify-section-{{ sid }} .iwm {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwm {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwm__inner { width: 100%; box-sizing: border-box; }

  /* Stack of rows */
  #shopify-section-{{ sid }} .iwm__rows {
    display: flex;
    flex-direction: column;
    gap: {{ st.row_gap_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwm__rows {
      gap: {{ st.row_gap_desktop | default: 80 }}px;
    }
  }

  /* Each row */
  #shopify-section-{{ sid }} .iwm__row {
    display: flex;
    flex-direction: column;
    gap: {{ st.col_gap_mobile | default: 24 }}px;
    align-items: center;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwm__row {
      flex-direction: row;
      gap: {{ st.col_gap_desktop | default: 60 }}px;
      align-items: center;
    }
    /* Auto-alternate direction by row index when section setting is on */
    {%- if st.alternate_rows -%}
      {%- assign _row_index = 0 -%}
      {%- for blk in section.blocks -%}
        {%- if blk.type == 'row' -%}
          {%- assign _row_index = _row_index | plus: 1 -%}
          {%- assign _is_even = _row_index | modulo: 2 -%}
          {%- if blk.settings.image_position == 'auto' -%}
            #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] {
              flex-direction: {% if _is_even == 0 %}row-reverse{% else %}row{% endif %};
            }
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  }

  /* Per-row direction override */
  {%- for blk in section.blocks -%}
    {%- if blk.type == 'row' -%}
      {%- assign rs = blk.settings -%}
      {%- if rs.image_position == 'left' -%}
        @media (min-width: 900px) {
          #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] { flex-direction: row; }
        }
      {%- elsif rs.image_position == 'right' -%}
        @media (min-width: 900px) {
          #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] { flex-direction: row-reverse; }
        }
      {%- endif -%}

      /* Per-row colors */
      #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] {
        {%- if rs.row_bg != blank and rs.row_bg != 'rgba(0,0,0,0)' and rs.row_bg.alpha != 0 -%}background: {{ rs.row_bg }};{%- endif -%}
        {%- if rs.row_padding > 0 -%}padding: {{ rs.row_padding }}px;{%- endif -%}
        {%- if rs.row_radius > 0 -%}border-radius: {{ rs.row_radius }}px;{%- endif -%}
      }

      /* Per-row content alignment overrides */
      {%- if rs.content_align_mobile and rs.content_align_mobile != 'section' -%}
        {%- case rs.content_align_mobile -%}
          {%- when 'center' -%}{%- assign _r_ai_m = 'center' -%}{%- assign _r_ta_m = 'center' -%}
          {%- when 'right'  -%}{%- assign _r_ai_m = 'flex-end' -%}{%- assign _r_ta_m = 'right' -%}
          {%- else -%}{%- assign _r_ai_m = 'flex-start' -%}{%- assign _r_ta_m = 'left' -%}
        {%- endcase -%}
        #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] .iwm__text {
          align-items: {{ _r_ai_m }} !important;
          text-align: {{ _r_ta_m }} !important;
        }
      {%- endif -%}
      {%- if rs.content_align_desktop and rs.content_align_desktop != 'section' -%}
        {%- case rs.content_align_desktop -%}
          {%- when 'center' -%}{%- assign _r_ai_d = 'center' -%}{%- assign _r_ta_d = 'center' -%}
          {%- when 'right'  -%}{%- assign _r_ai_d = 'flex-end' -%}{%- assign _r_ta_d = 'right' -%}
          {%- else -%}{%- assign _r_ai_d = 'flex-start' -%}{%- assign _r_ta_d = 'left' -%}
        {%- endcase -%}
        @media (min-width: 900px) {
          #shopify-section-{{ sid }} .iwm__row[data-block-id="{{ blk.id }}"] .iwm__text {
            align-items: {{ _r_ai_d }} !important;
            text-align: {{ _r_ta_d }} !important;
          }
        }
      {%- endif -%}

      /* Per-row button radius/colors */
      #shopify-section-{{ sid }} .iwm__btn[data-block-id="{{ blk.id }}"] {
        background-color: {% render 'scheme-color', color: rs.btn_bg, fallback: 'var(--btn-primary-bg-color)' %};
        color: {% render 'scheme-color', color: rs.btn_color, fallback: 'var(--btn-primary-color)' %};
        border-style: solid;
        border-color: {% render 'scheme-color', color: rs.btn_border_color, fallback: 'var(--btn-primary-border-color)' %};
        {%- if rs.use_theme_button %}
        border-width: var(--btn-border-width, 1px);
        padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
        border-radius: var(--btn-radius, 8px);
        font-size: var(--btn-font-size, 14px);
        font-weight: var(--btn-font-weight, 500);
        text-transform: var(--btn-text-transform, none);
        {%- else %}
        border-width: {{ rs.btn_border_width | default: 1 }}px;
        padding: {{ rs.btn_padding_y | default: 14 }}px {{ rs.btn_padding_x | default: 26 }}px;
        border-radius: {{ rs.btn_radius | default: 8 }}px;
        font-size: {{ rs.btn_font_size | default: 14 }}px;
        font-weight: {{ rs.btn_font_weight | default: '500' }};
        {%- endif %}
      }
      #shopify-section-{{ sid }} .iwm__btn[data-block-id="{{ blk.id }}"]:hover,
      #shopify-section-{{ sid }} .iwm__btn[data-block-id="{{ blk.id }}"]:focus-visible {
        background-color: {% render 'scheme-color', color: rs.btn_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
        color: {% render 'scheme-color', color: rs.btn_color_hover, fallback: 'var(--btn-primary-hover-color)' %};
        border-color: {% render 'scheme-color', color: rs.btn_border_color_hover, fallback: 'var(--btn-primary-hover-border-color)' %};
      }
    {%- endif -%}
  {%- endfor -%}

  /* Media + text columns */
  #shopify-section-{{ sid }} .iwm__media,
  #shopify-section-{{ sid }} .iwm__text {
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwm__text  { width: {{ st.text_column_width | default: 50 }}%; }
    #shopify-section-{{ sid }} .iwm__media { width: calc(100% - {{ st.text_column_width | default: 50 }}%); }
  }

  #shopify-section-{{ sid }} .iwm__media {
    border-radius: {{ st.image_radius | default: 12 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: st.image_bg, fallback: 'color-mix(in srgb, var(--color-text) 8%, var(--color-background))' %};
    aspect-ratio: {{ st.image_aspect_w | default: 1 }} / {{ st.image_aspect_h | default: 1 }};
  }
  #shopify-section-{{ sid }} .iwm__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ st.image_fit | default: 'cover' }};
    display: block;
  }

  /* Text column */
  #shopify-section-{{ sid }} .iwm__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 14 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwm__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .iwm__text > * { margin: 0; max-width: 100%; }

  #shopify-section-{{ sid }} .iwm__caption {
    font-size: {{ st.caption_size | default: 12 }}px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
    color: {% render 'scheme-color', color: st.caption_color, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .iwm__heading {
    font-weight: {% if st.heading_weight == 'theme' or st.heading_weight == blank %}{% if st.enable_custom_fonts and st.heading_font %}{{ st.heading_font.weight }}{% else %}var(--heading-weight, 700){% endif %}{% else %}{{ st.heading_weight }}{% endif %};
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-size: {{ st.heading_size_mobile | default: 30 }}px;
    color: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwm__heading {
      font-size: {{ st.heading_size_desktop | default: 40 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwm__body {
    line-height: 1.6;
    max-width: 540px;
    color: {% render 'scheme-color', color: st.body_color, fallback: 'var(--color-text)' %};
    font-size: {{ st.body_size_mobile | default: 14 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwm__body { font-size: {{ st.body_size_desktop | default: 16 }}px; }
  }
  #shopify-section-{{ sid }} .iwm__body p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iwm__body p:last-child { margin: 0; }

  #shopify-section-{{ sid }} .iwm__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .iwm__btn:hover {
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .iwm__btn,
    #shopify-section-{{ sid }} .iwm__btn:hover { transition: none !important; transform: none !important; }
  }
{% comment %}{% endcomment %}</style>

<div id="iwm-{{ sid }}" class="iwm section sec__image-text-multirow color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="iwm__inner">
    <div class="iwm__rows">
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          {%- assign rs = block.settings -%}
          <div class="iwm__row" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="iwm__media">
              {%- if rs.image != blank -%}
                <img
                  src="{{ rs.image | image_url: width: 1200 }}"
                  srcset="{{ rs.image | image_url: width: 600 }} 600w,
                          {{ rs.image | image_url: width: 900 }} 900w,
                          {{ rs.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 900px) 50vw, 100vw"
                  alt="{{ rs.image.alt | default: rs.heading | default: fb_accessibility_image | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
              {%- endif -%}
            </div>

            <div class="iwm__text">
              {%- if rs.caption != blank -%}
                <p class="iwm__caption">{{ rs.caption | escape }}</p>
              {%- endif -%}
              {%- if rs.heading != blank -%}
                <{{ rs.heading_tag | default: 'h3' }} class="iwm__heading">{{ rs.heading | escape }}</{{ rs.heading_tag | default: 'h3' }}>
              {%- endif -%}
              {%- if rs.body != blank -%}
                <div class="iwm__body">{{ rs.body }}</div>
              {%- endif -%}
              {%- if rs.btn_label != blank -%}
{%- liquid
                  assign custom_btn = true
                  if rs.use_theme_button
                    assign custom_btn = false
                  endif
                -%}
                <a class="iwm__btn" data-block-id="{{ block.id }}" data-theme-button="primary" style="{%- render 'button-overrides', bg: rs.btn_bg, text: rs.btn_color, border: rs.btn_border_color, hover_bg: rs.btn_bg_hover, hover_text: rs.btn_color_hover, hover_border: rs.btn_border_color_hover, custom: custom_btn, radius: rs.btn_radius, padding_y: rs.btn_padding_y, padding_x: rs.btn_padding_x, font_size: rs.btn_font_size, weight: rs.btn_font_weight, border_width: rs.btn_border_width -%}" href="{{ rs.btn_link | default: '#' }}">{{ rs.btn_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-with-text-multirow",
  "name": "Image With Text Multirow",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alternate_rows",
      "label": "Alternate image side",
      "default": true
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Text alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Gap between rows (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Gap between rows (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Gap inside row (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Gap inside row (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between text blocks",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_aspect_w",
      "label": "Image ratio width",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_aspect_h",
      "label": "Image ratio height",
      "min": 1,
