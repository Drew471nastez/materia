                  {%- endcase -%}
                {%- endif -%}
              </span>

              <span class="bbp__text">
                {%- if b.title != blank -%}
                  <span class="bbp__title">{{ b.title }}</span>
                {%- endif -%}
                {%- if b.subtitle != blank -%}
                  <span class="bbp__subtitle">{{ b.subtitle }}</span>
                {%- endif -%}
              </span>

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>



</template>

<schema>
{
  "type": "benefits-bar-pro",
  "name": "Benefits Bar Pro",
  "settings": [
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "two_column",
      "options": [
        {
          "value": "one_column",
          "label": "One column"
        },
        {
          "value": "two_column",
          "label": "Two columns"
        },
        {
          "value": "carousel_scroll",
          "label": "Horizontal scroll"
        }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "Item alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_d",
      "label": "Title size (desktop)",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "title_size_m",
      "label": "Title size (mobile)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size_d",
      "label": "Subtitle size (desktop)",
      "min": 9,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "subtitle_size_m",
      "label": "Subtitle size (mobile)",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "custom_text_colors",
      "label": "Custom text colors",
      "default": false,
      "info": "Override the color scheme for the title and subtitle."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "visible_if": "{{ section.settings.custom_text_colors }}"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "visible_if": "{{ section.settings.custom_text_colors }}"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Icon"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "default": "rounded_square",
      "options": [
