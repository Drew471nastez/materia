<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Benefits Bar Pro
  A horizontal benefits/trust bar: icon + title + subtitle per item.
  Self-contained, scoped to #shopify-section-{{ section.id }}.
  Colors come from the chosen theme color scheme (color-{{ scheme }} class
  + theme CSS vars --color-text / --color-heading / --color-background / --color-border).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme | default: 'scheme-1'
  assign uid = section.id

  assign cols = s.columns_desktop | default: 4
  assign gap = s.item_gap | default: 24
  assign isize = s.icon_size | default: 30
  assign stroke = s.icon_stroke | default: 2
  assign pt = s.padding_top | default: 24
  assign pb = s.padding_bottom | default: 24

  assign tsd = s.title_size_d | default: 15
  assign tsm = s.title_size_m | default: 14
  assign ssd = s.subtitle_size_d | default: 13
  assign ssm = s.subtitle_size_m | default: 12

  assign align = s.align | default: 'left'
  assign text_align = 'left'
  assign justify = 'flex-start'
  if align == 'center'
    assign text_align = 'center'
    assign justify = 'center'
  endif

  assign width = s.width | default: 'fluid_container'
  case width
    when 'container'
      assign maxw = 'calc(var(--page-width, 1300px) + 3rem)'
      assign padx = '1.5rem'
    when 'stretch_width'
      assign maxw = 'none'
      assign padx = '3rem'
    when 'full_width'
      assign maxw = 'none'
      assign padx = '1.5rem'
    else
      assign maxw = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
      assign padx = '1.5rem'
  endcase
-%}

<style>
  #shopify-section-{{ uid }} .benefits-bar-pro-{{ uid }} {
    --bbp-cols: {{ cols }};
    --bbp-gap: {{ gap }}px;
    --bbp-icon-size: {{ isize }}px;
    --bbp-icon-stroke: {{ stroke }};
    --bbp-icon-color: {% if s.icon_color != blank %}{{ s.icon_color }}{% else %}var(--color-heading){% endif %};
    --bbp-icon-bg: {% if s.icon_bg_color != blank %}{{ s.icon_bg_color }}{% else %}#f9f9f9{% endif %};
    --bbp-divider: {% if s.divider_color != blank %}{{ s.divider_color }}{% else %}#f2f2f2{% endif %};
  }

  #shopify-section-{{ uid }} .benefits-bar-pro-{{ uid }} {
    color: var(--color-text);
    background: var(--gradient-background, var(--color-background));
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ uid }} .bbp__inner {
    width: 100%;
    max-width: {{ maxw }};
    margin-inline: auto;
    padding-inline: {{ padx }};
    box-sizing: border-box;
  }

  #shopify-section-{{ uid }} .bbp__heading {
    margin: 0 0 1.25rem;
    text-align: {{ text_align }};
    color: var(--color-heading);
    line-height: 1.2;
    font-size: var(--bbp-hd, clamp(1.3rem, 1.05rem + 1vw, 2rem));
    font-weight: 600;
  }

  #shopify-section-{{ uid }} .bbp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--bbp-cols), minmax(0, 1fr));
    gap: var(--bbp-gap);
    align-items: stretch;
  }

  #shopify-section-{{ uid }} .bbp__item {
    position: relative;
    min-width: 0;
  }

  #shopify-section-{{ uid }} .bbp__link {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: {{ justify }};
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    padding: 0.5rem;
    border-radius: 8px;
    transition: transform 0.25s ease;
    will-change: transform;
  }

  #shopify-section-{{ uid }} a.bbp__link:hover {
    transform: translateY(-3px);
  }

  /* Vertical dividers between items (desktop grid) */
  {%- if s.show_dividers -%}
  #shopify-section-{{ uid }} .bbp__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 12%;
    bottom: 12%;
    right: calc(var(--bbp-gap) / -2);
    width: 1px;
    background-color: var(--bbp-divider);
    pointer-events: none;
  }
  {%- endif -%}

  #shopify-section-{{ uid }} .bbp__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--bbp-icon-size);
    height: var(--bbp-icon-size);
    color: var(--bbp-icon-color);
  }

  #shopify-section-{{ uid }} .bbp__icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  #shopify-section-{{ uid }} .bbp__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  {%- if s.icon_style == 'circle' or s.icon_style == 'rounded_square' -%}
  #shopify-section-{{ uid }} .bbp__icon {
    width: calc(var(--bbp-icon-size) + 22px);
    height: calc(var(--bbp-icon-size) + 22px);
    padding: 11px;
    box-sizing: border-box;
    background-color: var(--bbp-icon-bg);
    border-radius: {% if s.icon_style == 'circle' %}50%{% else %}12px{% endif %};
  }
  {%- endif -%}

  #shopify-section-{{ uid }} .bbp__text {
    min-width: 0;
    text-align: {{ text_align }};
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  #shopify-section-{{ uid }} .bbp__title {
    display: block;
    margin: 0;
    font-size: {{ tsd }}px;
    font-weight: 600;
    line-height: 1.3;
    color: {% if s.custom_text_colors and s.title_color != blank %}{{ s.title_color }}{% else %}var(--color-heading){% endif %};
  }

  #shopify-section-{{ uid }} .bbp__subtitle {
    display: block;
    margin: 0;
    font-size: {{ ssd }}px;
    line-height: 1.35;
    {%- unless s.custom_text_colors and s.subtitle_color != blank %}
    opacity: 0.7;
    {%- endunless %}
    color: {% if s.custom_text_colors and s.subtitle_color != blank %}{{ s.subtitle_color }}{% else %}var(--color-text){% endif %};
  }

  /* Mobile layouts */
  @media (max-width: 749px) {
    {%- case s.mobile_layout -%}
      {%- when 'one_column' -%}
        #shopify-section-{{ uid }} .bbp__list {
          grid-template-columns: 1fr;
          gap: 14px;
        }
        #shopify-section-{{ uid }} .bbp__link {
          justify-content: flex-start;
        }
        #shopify-section-{{ uid }} .bbp__text { text-align: left; }
        {%- if s.show_dividers -%}
        #shopify-section-{{ uid }} .bbp__item:not(:last-child)::after {
          top: auto; bottom: -7px; right: 0; left: 0;
          width: auto; height: 1px;
        }
        {%- endif -%}
      {%- when 'carousel_scroll' -%}
        #shopify-section-{{ uid }} .bbp__list {
          grid-auto-flow: column;
          grid-template-columns: none;
          grid-auto-columns: minmax(60%, 1fr);
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 6px;
          scrollbar-width: none;
        }
        #shopify-section-{{ uid }} .bbp__list::-webkit-scrollbar { display: none; }
        #shopify-section-{{ uid }} .bbp__item { scroll-snap-align: start; }
        {%- if s.show_dividers -%}
        #shopify-section-{{ uid }} .bbp__item:not(:last-child)::after { display: none; }
        {%- endif -%}
      {%- else -%}
        #shopify-section-{{ uid }} .bbp__list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 18px;
        }
        {%- if s.show_dividers -%}
        #shopify-section-{{ uid }} .bbp__item:nth-child(2n)::after { display: none; }
        {%- endif -%}
    {%- endcase -%}
  }

  /* Typography — mobile sizes from the sliders */
  @media (max-width: 749px) {
    #shopify-section-{{ uid }} .bbp__title { font-size: {{ tsm }}px; }
    #shopify-section-{{ uid }} .bbp__subtitle { font-size: {{ ssm }}px; }
    #shopify-section-{{ uid }} .bbp__heading {
      font-size: var(--bbp-hm, clamp(1.1rem, 1rem + 1vw, 1.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ uid }} .bbp__link { transition: none; }
    #shopify-section-{{ uid }} a.bbp__link:hover { transform: none; }
  }
{% comment %}{% endcomment %}</style>

<div class="benefits-bar-pro-{{ uid }} color-{{ scheme }} gradient {{ section.settings.width }}">
  <div class="bbp__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' and block.settings.heading != blank -%}
        {%- assign htag = block.settings.heading_tag | default: 'h2' -%}
        <{{ htag }} class="bbp__heading" style="--bbp-hd: {{ block.settings.heading_size_d | default: 30 }}px; --bbp-hm: {{ block.settings.heading_size_m | default: 22 }}px;{% if block.settings.heading_color != blank %} color: {{ block.settings.heading_color }};{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</{{ htag }}>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="bbp__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
          {%- liquid
            assign b = block.settings
            assign has_link = false
            if b.link != blank
              assign has_link = true
            endif
            assign aria = b.title | default: '' | strip_html
          -%}
          <li class="bbp__item" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a class="bbp__link" href="{{ b.link }}"{% if aria != blank %} aria-label="{{ aria | escape }}"{% endif %}>
            {%- else -%}
              <div class="bbp__link">
            {%- endif -%}

              <span class="bbp__icon" aria-hidden="true">
                {%- if b.icon_image != blank -%}
                  {{- b.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: '' -}}
                {%- else -%}
                  {%- case b.icon -%}
                    {%- when 'shipping_fast' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M624 352h-16V243.9c0-12.7-5.1-24.9-14.1-33.9L494 110.1c-9-9-21.2-14.1-33.9-14.1H416V48c0-26.5-21.5-48-48-48H112C85.5 0 64 21.5 64 48v48H8c-4.4 0-8 3.6-8 8v16c0 4.4 3.6 8 8 8h272c4.4 0 8 3.6 8 8v16c0 4.4-3.6 8-8 8H40c-4.4 0-8 3.6-8 8v16c0 4.4 3.6 8 8 8h208c4.4 0 8 3.6 8 8v16c0 4.4-3.6 8-8 8H8c-4.4 0-8 3.6-8 8v16c0 4.4 3.6 8 8 8h208c4.4 0 8 3.6 8 8v16c0 4.4-3.6 8-8 8H64v128c0 53 43 96 96 96s96-43 96-96h128c0 53 43 96 96 96s96-43 96-96h48c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zM160 464c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm320 0c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm80-208H416V144h44.1l99.9 99.9V256z"/></svg>
                    {%- when 'truck' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M624 352h-16V243.9c0-12.7-5.1-24.9-14.1-33.9L494 110.1c-9-9-21.2-14.1-33.9-14.1H416V48c0-26.5-21.5-48-48-48H48C21.5 0 0 21.5 0 48v320c0 26.5 21.5 48 48 48h16c0 53 43 96 96 96s96-43 96-96h128c0 53 43 96 96 96s96-43 96-96h48c8.8 0 16-7.2 16-16v-32c0-8.8-7.2-16-16-16zM160 464c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm320 0c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm80-208H416V144h44.1l99.9 99.9V256z"/></svg>
                    {%- when 'box' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M509.5 184.6L458.9 32.8C452.4 13.2 434.1 0 413.4 0H272v192h238.7c-.4-2.5-.4-5-1.2-7.4zM240 0H98.6c-20.7 0-39 13.2-45.5 32.8L2.5 184.6c-.8 2.4-.8 4.9-1.2 7.4H240V0zM0 224v240c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V224H0z"/></svg>
                    {%- when 'route' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M416 320h-96c-17.6 0-32-14.4-32-32s14.4-32 32-32h96s96-107 96-160-43-96-96-96-96 43-96 96c0 25.5 22.2 63.4 45.3 96H320c-52.9 0-96 43.1-96 96s43.1 96 96 96h96c17.6 0 32 14.4 32 32s-14.4 32-32 32H185.5c-16 24.8-33.8 47.7-47.3 64H416c52.9 0 96-43.1 96-96s-43.1-96-96-96zm0-256c17.7 0 32 14.3 32 32s-14.3 32-32 32-32-14.3-32-32 14.3-32 32-32zM96 256c-53 0-96 43-96 96s96 160 96 160 96-107 96-160-43-96-96-96zm0 128c-17.7 0-32-14.3-32-32s14.3-32 32-32 32 14.3 32 32-14.3 32-32 32z"/></svg>
                    {%- when 'map_marker_alt' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M192 0C85.9 0 0 86 0 192c0 71.1 24 93.3 151.3 297.4 18.8 30.1 62.7 30.1 81.5 0C360.1 285.2 384 263.1 384 192 384 85.9 298 0 192 0zm0 464C64.6 259.7 48 246.8 48 192c0-79.5 64.5-144 144-144s144 64.5 144 144c0 54.6-15.2 65.4-144 272zm-80-272c0-44.2 35.8-80 80-80s80 35.8 80 80-35.8 80-80 80-80-35.8-80-80z"/></svg>
                    {%- when 'headset' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M192 208c0-17.7-14.3-32-32-32h-16c-35.4 0-64 28.7-64 64v48c0 35.4 28.7 64 64 64h16c17.7 0 32-14.3 32-32V208zm176 144c35.4 0 64-28.7 64-64v-48c0-35.4-28.7-64-64-64h-16c-17.7 0-32 14.3-32 32v112c0 17.7 14.3 32 32 32h16zM256 0C113.2 0 4.6 118.8 0 256v16c0 8.8 7.2 16 16 16h16c8.8 0 16-7.2 16-16v-16c0-114.7 93.3-208 208-208s208 93.3 208 208h-.1c.1 2.4 .1 165.7 .1 165.7 0 23.4-18.9 42.3-42.3 42.3H320c0-26.5-21.5-48-48-48h-32c-26.5 0-48 21.5-48 48s21.5 48 48 48h181.7c49.9 0 90.3-40.4 90.3-90.3V256C507.4 118.8 398.8 0 256 0z"/></svg>
                    {%- when 'envelope' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7 .3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2 .4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"/></svg>
                    {%- when 'comments' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M416 192c0-88.4-93.1-160-208-160S0 103.6 0 192c0 34.3 14.1 65.9 38 92-13.4 30.2-35.5 54.2-35.8 54.5-2.2 2.3-2.8 5.7-1.5 8.7S4.8 352 8 352c36.6 0 66.9-12.3 88.7-25 32.2 15.7 70.3 25 111.3 25 114.9 0 208-71.6 208-160zm122 220c23.9-26 38-57.7 38-92 0-66.9-53.5-124.2-129.3-148.1 .9 6.6 1.3 13.3 1.3 20.1 0 105.9-107.7 192-240 192-10.8 0-21.3-.8-31.7-1.9C207.8 439.6 281.8 480 368 480c41 0 79.1-9.2 111.3-25 21.8 12.7 52.1 25 88.7 25 3.2 0 6.1-1.9 7.3-4.8 1.3-2.9 .7-6.3-1.5-8.7-.3-.3-22.4-24.2-35.8-54.5z"/></svg>
                    {%- when 'question_circle' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M504 256c0 137-111 248-248 248S8 393 8 256C8 119.1 119 8 256 8s248 111.1 248 248zM262.7 90c-54.5 0-89.3 23-116.5 63.8-3.5 5.3-2.4 12.4 2.7 16.3l34.7 26.3c5.2 3.9 12.6 3 16.7-2.1 17.9-22.7 30.1-35.8 57.3-35.8 20.4 0 45.7 13.1 45.7 33 0 15-12.4 22.7-32.5 34C247.1 238.5 216 254.9 216 296v4c0 6.6 5.4 12 12 12h56c6.6 0 12-5.4 12-12v-1.3c0-28.5 83.2-29.6 83.2-106.7 0-58-60.2-102-116.5-102zM256 338c-25.4 0-46 20.6-46 46 0 25.4 20.6 46 46 46s46-20.6 46-46c0-25.4-20.6-46-46-46z"/></svg>
                    {%- when 'lock' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M400 224h-24v-72C376 68.2 307.8 0 224 0S72 68.2 72 152v72H48c-26.5 0-48 21.5-48 48v192c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V272c0-26.5-21.5-48-48-48zm-104 0H152v-72c0-39.7 32.3-72 72-72s72 32.3 72 72v72z"/></svg>
                    {%- when 'shield_alt' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M466.5 83.7l-192-80a48.2 48.2 0 0 0 -36.9 0l-192 80C27.7 91.1 16 108.6 16 128c0 198.5 114.5 335.7 221.5 380.3 11.8 4.9 25.1 4.9 36.9 0C360.1 472.6 496 349.3 496 128c0-19.4-11.7-36.9-29.5-44.3zM256.1 446.3l-.1-381 175.9 73.3c-3.3 151.4-82.1 261.1-175.8 307.7z"/></svg>
                    {%- when 'check_circle' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M504 256c0 137-111 248-248 248S8 393 8 256 119 8 256 8s248 111 248 248zM227.3 387.3l184-184c6.2-6.2 6.2-16.4 0-22.6l-22.6-22.6c-6.2-6.2-16.4-6.2-22.6 0L216 308.1l-70.1-70.1c-6.2-6.2-16.4-6.2-22.6 0l-22.6 22.6c-6.2 6.2-6.2 16.4 0 22.6l104 104c6.2 6.2 16.4 6.2 22.6 0z"/></svg>
                    {%- when 'award' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M97.1 362.6c-8.7-8.7-4.2-6.2-25.1-11.9-9.5-2.6-17.9-7.5-25.4-13.3L1.2 448.7c-4.4 10.8 3.8 22.5 15.4 22l52.7-2L105.6 507c8 8.4 22 5.8 26.4-5l52.1-127.6c-10.8 6-22.9 9.6-35.3 9.6-19.5 0-37.8-7.6-51.6-21.4zM382.8 448.7l-45.4-111.2c-7.6 5.9-15.9 10.8-25.4 13.3-21.1 5.6-16.5 3.2-25.1 11.9-13.8 13.8-32.1 21.4-51.6 21.4-12.4 0-24.5-3.6-35.3-9.6L252 502c4.4 10.8 18.4 13.4 26.4 5l36.3-38.3 52.7 2c11.6 .4 19.8-11.3 15.4-22zM263 340c15.3-15.6 17-14.2 38.8-20.1 13.9-3.8 24.8-14.8 28.5-29 7.5-28.4 5.5-25 26-45.8 10.2-10.4 14.1-25.4 10.4-39.6-7.5-28.4-7.5-24.4 0-52.8 3.7-14.1-.3-29.2-10.4-39.6-20.4-20.8-18.5-17.4-26-45.8-3.7-14.1-14.6-25.2-28.5-29-27.9-7.6-24.5-5.6-45-26.4-10.2-10.4-25-14.4-38.9-10.6-27.9 7.6-24 7.6-51.9 0-13.9-3.8-28.7 .3-38.9 10.6-20.4 20.8-17.1 18.8-44.9 26.4-13.9 3.8-24.8 14.8-28.5 29-7.5 28.4-5.5 25-26 45.8-10.2 10.4-14.2 25.4-10.4 39.6 7.5 28.4 7.5 24.4 0 52.8-3.7 14.1 .3 29.2 10.4 39.6 20.4 20.8 18.5 17.4 26 45.8 3.7 14.1 14.6 25.2 28.5 29C104.6 326 106.3 325 121 340c13.2 13.5 33.8 15.9 49.7 5.8a39.7 39.7 0 0 1 42.5 0c15.9 10.1 36.5 7.7 49.7-5.8zM97.7 176c0-53 42.2-96 94.3-96s94.3 43 94.3 96-42.2 96-94.3 96-94.3-43-94.3-96z"/></svg>
                    {%- when 'gem' -%}
