<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


{% if section.settings.enable_custom_fonts and section.settings.custom_font_url != blank %}
  <!-- Load the custom font only if user enabled it and provided a URL -->
  <link href="{{ section.settings.custom_font_url }}" rel="stylesheet">
  <style>
    .no-monthly-fees-promo .title,
    .no-monthly-fees-promo .subtitle {
      font-family: "{{ section.settings.custom_font_family | escape }}", sans-serif !important;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<style>
  .no-monthly-fees-promo {
    text-align: center;
    /* Desktop padding defaults */
    padding: var(--top-padding-desktop, 40px) 15px var(--bottom-padding-desktop, 40px);
  }

  /* Ensure any strong tags inherit font-weight so custom weights apply */
  .no-monthly-fees-promo .title strong,
  .no-monthly-fees-promo .subtitle strong {
    font-weight: inherit;
  }

  .no-monthly-fees-promo .title {
    /* Use desktop custom property; fallback 37px if not set */
    font-size: var(--title-font-size-desktop, 37px);
    font-weight: var(--title-font-weight, 700);
    /* Fix overlapping letters like “g” by increasing line-height */
    line-height: 1.2 !important;
    margin: 0;
    color: var(--title-text-color, #2C49F2);
  }

  .no-monthly-fees-promo .subtitle {
    font-size: var(--subtitle-font-size-desktop, 36px) !important;
    font-weight: var(--subtitle-font-weight, 700) !important;
    line-height: 1.2 !important;
    margin: var(--title-subtitle-gap-desktop, 10px) 0 var(--title-subheading-gap-desktop, 30px);
    color: var(--subtitle-text-color, #121212);
  }

  /* Subheading (the <p> tag) Desktop styles */
  .no-monthly-fees-promo p {
    padding-left: var(--subheading-padding-left-desktop, 20px);
    padding-right: var(--subheading-padding-right-desktop, 20px);
    font-size: var(--subheading-font-size-desktop, 16px);
    line-height: var(--subheading-line-height-desktop, 1.6);
    margin: 0 auto;
    max-width: 1000px;
  }

  /* Gradient text styling */
  .no-monthly-fees-promo .gradient-text {
    display: block;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .no-monthly-fees-promo {
      padding-top: var(--top-padding-mobile, 32px);
      padding-bottom: var(--bottom-padding-mobile, 32px);
    }

    .no-monthly-fees-promo .title {
      font-size: var(--title-mobile-font-size, 35px) !important;
      line-height: 1.2 !important;
      margin: 0;
    }

    .no-monthly-fees-promo .subtitle {
      font-size: var(--subtitle-mobile-font-size, 31px) !important;
      line-height: 1.2 !important;
      margin-top: var(--title-subtitle-gap-mobile, 10px) !important;
      margin-bottom: var(--title-subheading-gap-mobile, 20px) !important;
    }

    .no-monthly-fees-promo p {
      font-size: var(--subheading-font-size-mobile, 15px);
      line-height: var(--subheading-line-height-mobile, 1.4);
      padding-left: var(--subheading-padding-left-mobile, 20px);
      padding-right: var(--subheading-padding-right-mobile, 10px);
    }
  }
{% comment %}{% endcomment %}</style>

<div
  class="no-monthly-fees-promo"
  style="
    --top-padding-desktop: {{ section.settings.padding_top_desktop }}px;
    --bottom-padding-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --top-padding-mobile: {{ section.settings.padding_top_mobile }}px;
    --bottom-padding-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --title-subheading-gap-desktop: {{ section.settings.title_subheading_gap_desktop }}px;
    --title-subheading-gap-mobile: {{ section.settings.title_subheading_gap_mobile }}px;
    --title-subtitle-gap-desktop: {{ section.settings.title_subtitle_gap_desktop }}px;
    --title-subtitle-gap-mobile: {{ section.settings.title_subtitle_gap_mobile }}px;

    --subheading-padding-left-desktop: {{ section.settings.subheading_padding_left_desktop }}px;
    --subheading-padding-right-desktop: {{ section.settings.subheading_padding_right_desktop }}px;
    --subheading-padding-left-mobile: {{ section.settings.subheading_padding_left_mobile }}px;
    --subheading-padding-right-mobile: {{ section.settings.subheading_padding_right_mobile }}px;

    --title-mobile-font-size: {{ section.settings.title_mobile_font_size }}px;
    --subtitle-mobile-font-size: {{ section.settings.subtitle_mobile_font_size }}px;

    --title-text-color: {{ section.settings.title_text_color }};
    --subtitle-text-color: {{ section.settings.subtitle_text_color }};

    --title-font-size-desktop: {{ section.settings.title_font_size_desktop }}px;
    --subtitle-font-size-desktop: {{ section.settings.subtitle_font_size_desktop }}px;

    --subheading-font-size-desktop: {{ section.settings.subheading_font_size_desktop }}px;
    --subheading-line-height-desktop: {{ section.settings.subheading_line_height_desktop }};
    --subheading-font-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
    --subheading-line-height-mobile: {{ section.settings.subheading_line_height_mobile }};

    --title-font-weight: {{ section.settings.title_font_weight }};
    --subtitle-font-weight: {{ section.settings.subtitle_font_weight }};
  "
>

  {% assign title_block = nil %}
  {% assign subtitle_block = nil %}
  {% for block in section.blocks %}
    {% if block.type == 'title' and title_block == nil %}
      {% assign title_block = block %}
    {% elsif block.type == 'subtitle' and subtitle_block == nil %}
      {% assign subtitle_block = block %}
    {% endif %}
  {% endfor %}

  {% assign main_title = blank %}
  {% assign main_subtitle = blank %}
  {% assign gradient_enabled = false %}
  {% assign gradient_start = '#2C49F2' %}
  {% assign gradient_middle = '#4240FF' %}
  {% assign gradient_end = '#9B94FC' %}
  {% assign gradient_direction = 'to right' %}

  {% assign subtitle_gradient_enabled = false %}
  {% assign subtitle_gradient_start = '#FF6B6B' %}
  {% assign subtitle_gradient_middle = '#FF8E53' %}
  {% assign subtitle_gradient_end = '#FFC371' %}
  {% assign subtitle_gradient_direction = 'to right' %}

  {% if title_block != nil %}
    {% assign main_title = title_block.settings.text %}
    {% assign gradient_enabled = title_block.settings.enable_gradient %}
    {% assign gradient_start = title_block.settings.gradient_start %}
    {% assign gradient_middle = title_block.settings.gradient_middle %}
    {% assign gradient_end = title_block.settings.gradient_end %}
    {% assign gradient_direction = title_block.settings.gradient_direction %}
  {% endif %}

  {% if subtitle_block != nil %}
    {% assign main_subtitle = subtitle_block.settings.text %}
    {% assign subtitle_gradient_enabled = subtitle_block.settings.enable_gradient %}
    {% assign subtitle_gradient_start = subtitle_block.settings.gradient_start %}
    {% assign subtitle_gradient_middle = subtitle_block.settings.gradient_middle %}
    {% assign subtitle_gradient_end = subtitle_block.settings.gradient_end %}
    {% assign subtitle_gradient_direction = subtitle_block.settings.gradient_direction %}
  {% endif %}

  {% assign inverse = section.settings.inverse_title_and_subtitle %}

  {% if inverse and main_title != blank and main_subtitle != blank %}
    {% assign temp_title = main_title %}
    {% assign main_title = main_subtitle %}
    {% assign main_subtitle = temp_title %}
  {% endif %}

  {% if title_block != nil and main_title != blank %}
    {% if gradient_enabled %}
      <!-- Title with gradient -->
      <h2 class="title gradient-text" style="
           background-image: linear-gradient(
             {{ gradient_direction }},
             {{ gradient_start }},
             {{ gradient_middle }},
             {{ gradient_end }}
           );">
        <strong>{{ main_title }}</strong>
      </h2>
    {% else %}
      <!-- Title with solid color -->
      <h2 class="title">
        <strong>{{ main_title }}</strong>
      </h2>
    {% endif %}
  {% endif %}

  {% if subtitle_block != nil and main_subtitle != blank %}
    {% if subtitle_gradient_enabled %}
      <!-- Subtitle with gradient -->
      <h3 class="subtitle gradient-text" style="
           background-image: linear-gradient(
             {{ subtitle_gradient_direction }},
             {{ subtitle_gradient_start }},
             {{ subtitle_gradient_middle }},
             {{ subtitle_gradient_end }}
           );">
        <strong>{{ main_subtitle }}</strong>
      </h3>
    {% else %}
      <!-- Subtitle with solid color -->
      <h3 class="subtitle">
        <strong>{{ main_subtitle }}</strong>
      </h3>
    {% endif %}
  {% endif %}

  <p>{{ section.settings.subheading_text }}</p>
</div>
</template>

<schema>
{
  "type": "titleandsubtitle",
  "name": "Title & Subtitle",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "subheading_text",
      "label": "Subheading Text",
      "default": "Lorem ipsum dolor sit amet. Nulla feugiat sem vitae elit. Pellentesque habitant morbi tristique senectus et netus. Integer non turpis euismod nulla facilisis posuere."
    },
    {
      "type": "text",
      "id": "custom_font_url",
      "label": "Custom Font URL",
      "info": "Example: https://fonts.googleapis.com/css?family=Roboto"
    },
    {
      "type": "text",
      "id": "custom_font_family",
      "label": "Custom Font Family",
      "info": "Font family name loaded by the URL above (e.g., Roboto)"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "inverse_title_and_subtitle",
      "label": "Inverse Title & Subtitle",
      "default": false
    },
    {
      "type": "range",
      "id": "title_subheading_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical Space between Subtitle and Subheading (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_subheading_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical Space between Subtitle and Subheading (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_subtitle_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical Space between Main Title and Subtitle (Desktop)",
      "default": 10
    },
    {
      "type": "range",
      "id": "title_subtitle_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical Space between Main Title and Subtitle (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "subheading_padding_left_desktop",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Subheading Left Padding (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_padding_right_desktop",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Subheading Right Padding (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_padding_left_mobile",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Subheading Left Padding (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Subheading Right Padding (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "title_mobile_font_size",
      "label": "Title Mobile Font Size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "subtitle_mobile_font_size",
      "label": "Subtitle Mobile Font Size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 31
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size (Desktop)",
      "default": 37
    },
    {
      "type": "range",
      "id": "subtitle_font_size_desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_line_height_desktop",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Subheading Line Height (Desktop)",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_line_height_mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Subheading Line Height (Mobile)",
      "default": 1.4
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "450",
          "label": "450"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "550",
          "label": "550"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ]
    },
    {
      "type": "select",
      "id": "subtitle_font_weight",
      "label": "Subtitle Font Weight",
      "default": "700",
      "options": [
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "550",
          "label": "550"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable Custom Fonts for Title & Subtitle",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
