<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


{% if section.settings.enable_custom_fonts and section.settings.custom_font_url != blank %}
  <!-- Load the custom font only if user enabled it and provided a URL -->
  <link href="{{ section.settings.custom_font_url }}" rel="stylesheet">
  <style>
    #shopify-section-{{ section.id }} :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .title,
    #shopify-section-{{ section.id }} :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .subtitle {
      font-family: "{{ section.settings.custom_font_family | escape }}", sans-serif !important;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<style>
  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo {
    text-align: center;
    /* Desktop padding defaults */
    padding: var(--top-padding-desktop, 40px) 15px var(--bottom-padding-desktop, 40px);
  }

  /* Ensure any strong tags inherit font-weight so custom weights apply */
  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .title strong,
  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .subtitle strong {
    font-weight: inherit;
  }

  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .title {
    /* Use desktop custom property; fallback 37px if not set */
    font-size: var(--title-font-size-desktop, 37px);
    font-weight: var(--title-font-weight, 700);
    /* Fix overlapping letters like “g” by increasing line-height */
    line-height: 1.2 !important;
    margin: 0;
    color: var(--title-text-color, var(--color-heading));
  }

  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .subtitle {
    font-size: var(--subtitle-font-size-desktop, 36px) !important;
    font-weight: var(--subtitle-font-weight, 700) !important;
    line-height: 1.2 !important;
    margin: var(--title-subtitle-gap-desktop, 10px) 0 var(--title-subheading-gap-desktop, 30px);
    color: var(--subtitle-text-color, var(--color-heading));
  }

  /* Subheading (the <p> tag) Desktop styles */
  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo p {
    padding-left: var(--subheading-padding-left-desktop, 20px);
    padding-right: var(--subheading-padding-right-desktop, 20px);
    font-size: var(--subheading-font-size-desktop, 16px);
    line-height: var(--subheading-line-height-desktop, 1.6);
    margin: 0 auto;
    max-width: 1000px;
    color: var(--subheading-text-color, var(--color-text));
  }

  /* Gradient text styling */
  :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .gradient-text {
    display: block;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo {
      padding-top: var(--top-padding-mobile, 32px);
      padding-bottom: var(--bottom-padding-mobile, 32px);
    }

    :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .title {
      font-size: var(--title-mobile-font-size, 35px) !important;
      line-height: 1.2 !important;
      margin: 0;
    }

    :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo .subtitle {
      font-size: var(--subtitle-mobile-font-size, 31px) !important;
      line-height: 1.2 !important;
      margin-top: var(--title-subtitle-gap-mobile, 10px) !important;
      margin-bottom: var(--title-subheading-gap-mobile, 20px) !important;
    }

    :where(#shopify-section-{{ section.id }}) .no-monthly-fees-promo p {
      font-size: var(--subheading-font-size-mobile, 15px);
      line-height: var(--subheading-line-height-mobile, 1.4);
      padding-left: var(--subheading-padding-left-mobile, 20px);
      padding-right: var(--subheading-padding-right-mobile, 10px);
    }
  }
{% comment %}{% endcomment %}</style>

<div
  data-text-controls="titleandsubtitle" data-tx-section="{{ section.id }}" data-tx-settings="{{ section.settings | json | escape }}" data-tx-defaults='{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"reveal":true,"subheading_text":"Lorem ipsum dolor sit amet. Nulla feugiat sem vitae elit. Pellentesque habitant morbi tristique senectus et netus. Integer non turpis euismod nulla facilisis posuere.","inverse_title_and_subtitle":false,"title_font_size_desktop":37,"subtitle_font_size_desktop":36,"subheading_font_size_desktop":16,"subheading_line_height_desktop":1.6,"title_font_weight":"theme","subtitle_font_weight":"theme","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","enable_custom_style":false,"title_subheading_gap_desktop":30,"title_subtitle_gap_desktop":10,"subheading_padding_left_desktop":20,"subheading_padding_right_desktop":20,"padding_top_desktop":40,"padding_bottom_desktop":40,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"title_subheading_gap_mobile":20,"title_subtitle_gap_mobile":10,"subheading_padding_left_mobile":20,"subheading_padding_right_mobile":10,"title_mobile_font_size":35,"subtitle_mobile_font_size":31,"subheading_font_size_mobile":15,"subheading_line_height_mobile":1.4,"padding_top_mobile":32,"padding_bottom_mobile":32,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"content_alignment":"center","content_alignment_mobile":"center","text_max_width":1000}' data-tx-block-defaults='{"title":{"text":"Beatiful Design.","enable_custom_fonts":false,"font":"assistant_n4","enable_gradient":false,"enable_custom_style":false,"gradient_start":"#2C49F2","gradient_middle":"#4240FF","gradient_end":"#9B94FC","gradient_direction":"to right","font_weight":"theme","letter_spacing":0,"line_height":1.2,"text_case":"theme","space_above":0,"space_below":0},"subtitle":{"text":"Here Is Your Subtitle","enable_custom_fonts":false,"font":"assistant_n4","enable_gradient":false,"enable_custom_style":false,"gradient_start":"#FF6B6B","gradient_middle":"#FF8E53","gradient_end":"#FFC371","gradient_direction":"to right","font_weight":"theme","letter_spacing":0,"line_height":1.2,"text_case":"theme","space_above":0,"space_below":0}}' data-tx-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" class="no-monthly-fees-promo color-{{ color_scheme }} gradient"
  style="
    --top-padding-desktop: {{ section.settings.padding_top_desktop }}px;
    --bottom-padding-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --top-padding-mobile: {{ section.settings.padding_top_mobile }}px;
    --bottom-padding-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --title-subheading-gap-desktop: {{ section.settings.title_subheading_gap_desktop }}px;
    --title-subheading-gap-mobile: {{ section.settings.title_subheading_gap_mobile }}px;
    --title-subtitle-gap-desktop: {{ section.settings.title_subtitle_gap_desktop }}px;
    --title-subtitle-gap-mobile: {{ section.settings.title_subtitle_gap_mobile }}px;

    --subheading-padding-left-desktop: {{ section.settings.subheading_padding_left_desktop }}px;
    --subheading-padding-right-desktop: {{ section.settings.subheading_padding_right_desktop }}px;
    --subheading-padding-left-mobile: {{ section.settings.subheading_padding_left_mobile }}px;
    --subheading-padding-right-mobile: {{ section.settings.subheading_padding_right_mobile }}px;

    --title-mobile-font-size: {{ section.settings.title_mobile_font_size }}px;
    --subtitle-mobile-font-size: {{ section.settings.subtitle_mobile_font_size }}px;

    --title-text-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.title_text_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %};
    --subtitle-text-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.subtitle_text_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %};
    --subheading-text-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.subheading_text_color, fallback: 'var(--color-text)' %}{% else %}{{ 'var(--color-text)' }}{% endif %};

    --title-font-size-desktop: {{ section.settings.title_font_size_desktop }}px;
    --subtitle-font-size-desktop: {{ section.settings.subtitle_font_size_desktop }}px;

    --subheading-font-size-desktop: {{ section.settings.subheading_font_size_desktop }}px;
    --subheading-line-height-desktop: {{ section.settings.subheading_line_height_desktop }};
    --subheading-font-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;
    --subheading-line-height-mobile: {{ section.settings.subheading_line_height_mobile }};

    --title-font-weight: {% if section.settings.title_font_weight == 'theme' or section.settings.title_font_weight == blank %}var(--heading-weight, 700){% else %}{{ section.settings.title_font_weight }}{% endif %};
    --subtitle-font-weight: {% if section.settings.subtitle_font_weight == 'theme' or section.settings.subtitle_font_weight == blank %}var(--heading-weight, 700){% else %}{{ section.settings.subtitle_font_weight }}{% endif %};
  "
>

  {% assign first_title = section.blocks | where: 'type', 'title' | first %}
  {% assign first_subtitle = section.blocks | where: 'type', 'subtitle' | first %}
  {% for block in section.blocks %}
    {% assign b = block.settings %}{% assign words = b.text %}
    {% if section.settings.inverse_title_and_subtitle and first_title and first_subtitle %}{% if block.id == first_title.id %}{% assign words = first_subtitle.settings.text %}{% elsif block.id == first_subtitle.id %}{% assign words = first_title.settings.text %}{% endif %}{% endif %}
    {% if block.type == 'title' %}<h2{% else %}<h3{% endif %} class="{{ block.type }}{% if b.enable_gradient %} gradient-text{% endif %}" data-tx-block="{{ block.id }}" data-tx-type="{{ block.type }}" data-tx-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}{% if b.enable_gradient and b.enable_custom_style %} style="background-image:linear-gradient({{ b.gradient_direction }},{{ b.gradient_start }},{{ b.gradient_middle }},{{ b.gradient_end }})"{% endif %}>{{ words }}{% if block.type == 'title' %}</h2>{% else %}</h3>{% endif %}
  {% endfor %}
  <div data-tx-subheading>{{ section.settings.subheading_text }}</div>
</div>
{% render 'text-controls-initial', section: section, kind: 'titleandsubtitle' %}
{{ 'text-section-controls.css' | asset_url | stylesheet_tag }}
{{ 'text-section-controls.js' | asset_url | script_tag }}
{% render 'wavy-title-initial', section:section, kind:'titleandsubtitle' %}
</template>

<schema>
{
  "shopify": {
    "name": "Title & Subtitle",
    "tag": "section",
    "class": "no-monthly-fees-promo",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section gap",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "richtext",
        "id": "subheading_text",
        "label": "Text",
        "default": "<p>Lorem ipsum dolor sit amet. Nulla feugiat sem vitae elit. Pellentesque habitant morbi tristique senectus et netus. Integer non turpis euismod nulla facilisis posuere.</p>"
      },
      {
        "type": "checkbox",
        "id": "inverse_title_and_subtitle",
        "label": "Swap title and subtitle",
        "default": false
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "text_max_width",
        "label": "Text maximum width",
        "min": 300,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1000
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Use custom font",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "title_font_size_desktop",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Title size",
        "default": 37
      },
      {
        "type": "range",
        "id": "subtitle_font_size_desktop",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Subtitle size",
        "default": 36
      },
      {
        "type": "range",
        "id": "subheading_font_size_desktop",
        "min": 10,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Text size",
        "default": 16
      },
      {
        "type": "range",
        "id": "subheading_line_height_desktop",
        "min": 1,
        "max": 3,
        "step": 0.1,
        "label": "Text line height",
        "default": 1.6
      },
      {
        "type": "select",
        "id": "title_font_weight",
        "label": "Title weight",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "300",
            "label": "300"
          },
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "450",
            "label": "450"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "550",
            "label": "550"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "select",
        "id": "subtitle_font_weight",
        "label": "Subtitle weight",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "300",
            "label": "300"
          },
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "550",
            "label": "550"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "header",
        "content": "Custom styling"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "title_text_color",
        "label": "Title color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "subtitle_text_color",
        "label": "Subtitle color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "subheading_text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "title_subheading_gap_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Subtitle to text gap",
        "default": 30
      },
      {
        "type": "range",
        "id": "title_subtitle_gap_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Title to subtitle gap",
        "default": 10
      },
      {
        "type": "range",
        "id": "subheading_padding_left_desktop",
        "min": 0,
        "max": 600,
        "step": 20,
        "unit": "px",
        "label": "Text left padding",
        "default": 20
      },
      {
        "type": "range",
