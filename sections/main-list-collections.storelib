      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Spacing between collections",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "type",
      "label": "Collections to show",
      "info": "All of your collections are listed by default. Choose 'Selected' to add specific collections.",
      "default": "all",
