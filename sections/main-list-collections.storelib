        },
        {
          "value": "products_low",
          "label": "Fewest products"
        }
      ]
    },
    {
      "type": "select",
      "id": "design",
      "label": "Card style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "morden",
          "label": "Modern"
        }
      ]
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Items per page",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Image / Media"
        },
        {
          "type": "image_picker",
