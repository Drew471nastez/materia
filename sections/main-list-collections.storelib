<template compat="shopify">
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} { font-weight: var(--body-weight, inherit); isolation: isolate; position: relative; }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) { font-weight: var(--heading-weight, inherit); }
{% comment %}{% endcomment %}</style>

{%- comment -%}
  === COLLECTION CARD BUTTON COLOR FIX ===

  The collection title is rendered as <a class="collection-item__name btn btn-white">.
  The theme's `.btn-white` rule sets:
      --btn-bg: var(--color-white);
      --btn-color: var(--btn-outline-color);
      --btn-border-color: var(--color-white);

  So when the merchant changes the scheme's Button Primary color, nothing
  changes on these cards — they use `.btn-white` styling instead.

  Fix: override --btn-bg / --btn-color / --btn-border-color on
  .collection-item__name.btn-white inside this section so they consume the
  scheme's Button Primary vars that the theme already generates from the
  color scheme settings:
      --btn-primary-bg-color           (from btn_primary_background)
      --btn-primary-bg-graident-color  (from btn_primary_gradient)
      --btn-primary-color              (from btn_primary_color)
      --btn-primary-border-color       (from btn_primary_border_color)
      --btn-primary-hover-bg-color     (from btn_primary_hover_background)
      --btn-primary-hover-color        (from btn_primary_hover_color)
      --btn-primary-hover-border-color (from btn_primary_hover_border_color)

  This way the merchant's choice in the editor flows correctly to the cards.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn-white,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn-white,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn {
    --btn-bg: var(--btn-primary-bg-color) !important;
    --btn-bg-gradient: var(--btn-primary-bg-graident-color, var(--btn-primary-bg-color)) !important;
    --btn-color: var(--btn-primary-color) !important;
    --btn-border-color: var(--btn-primary-border-color, var(--btn-primary-bg-color)) !important;
    background: var(--btn-primary-bg-color) !important;
    background: var(--btn-primary-bg-graident-color, var(--btn-primary-bg-color)) !important;
    color: var(--btn-primary-color) !important;
    border: var(--btn-border-width, 1px) solid var(--btn-primary-border-color, var(--btn-primary-bg-color)) !important;
    transition: background-color 0.25s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.15s ease !important;
  }
  /* Inner span (the text node) inherits */
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn-white *,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn *,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn-white *,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn * {
    color: var(--btn-primary-color) !important;
  }

  /* Hover state — uses scheme's hover vars */
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn-white:hover,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn-white:focus-visible,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn:hover,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn:focus-visible,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn-white:hover,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn-white:focus-visible,
  #shopify-section-{{ section.id }} .collection-item:hover .collection-item__name.btn-white,
  #shopify-section-{{ section.id }} .collection-items:hover .collection-item__name.btn-white {
    --btn-bg: var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color)) !important;
    --btn-color: var(--btn-primary-hover-color, var(--btn-primary-color)) !important;
    --btn-border-color: var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color))) !important;
    background: var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color)) !important;
    background: var(--btn-primary-hover-bg-color-graident, var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color))) !important;
    color: var(--btn-primary-hover-color, var(--btn-primary-color)) !important;
    border-color: var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color))) !important;
  }
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn-white:hover *,
  #shopify-section-{{ section.id }} .collection-item .collection-item__name.btn:hover *,
  #shopify-section-{{ section.id }} .collection-items .collection-item__name.btn-white:hover *,
  #shopify-section-{{ section.id }} .collection-item:hover .collection-item__name.btn-white *,
  #shopify-section-{{ section.id }} .collection-items:hover .collection-item__name.btn-white * {
    color: var(--btn-primary-hover-color, var(--btn-primary-color)) !important;
  }

  /* Load-more button (also uses .btn-primary, theme already handles it,
     but we make sure scheme vars apply correctly here too) */
  #shopify-section-{{ section.id }} loadmore-button .button.btn-primary,
  #shopify-section-{{ section.id }} loadmore-button a.btn-primary {
    --btn-bg: var(--btn-primary-bg-color) !important;
    --btn-color: var(--btn-primary-color) !important;
    --btn-border-color: var(--btn-primary-border-color, var(--btn-primary-bg-color)) !important;
    background: var(--btn-primary-bg-color) !important;
    color: var(--btn-primary-color) !important;
    border: var(--btn-border-width, 1px) solid var(--btn-primary-border-color, var(--btn-primary-bg-color)) !important;
  }
  #shopify-section-{{ section.id }} loadmore-button .button.btn-primary:hover,
  #shopify-section-{{ section.id }} loadmore-button a.btn-primary:hover {
    background: var(--btn-primary-hover-bg-color, var(--btn-primary-bg-color)) !important;
    color: var(--btn-primary-hover-color, var(--btn-primary-color)) !important;
    border-color: var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color)) !important;
  }
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign sort_collections = section_st.sort_collections
  assign type = section_st.type
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign column_gap = section_st.column_gap
  assign pagination = section_st.pagination
  assign design = section_st.design
  assign collection_information_position = 'overlay_image'
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- capture col_style -%}
--col-desktop: {{ items_per_row }};--col-number:2;{% if items_per_row > 3 %}--col-tablet: 3;--col-desktop-small: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  column_gap }}px;{% endif %};--btn-padding-x: 2rem;
{%- endcapture -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collections-list color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div
      class="collection-list grid col-{{ items_per_row }} {{ settings.hover_effect }}"
    >
      {%- if type == 'all' -%}
        {%- liquid
          case sort_collections
            when 'products_high', 'products_low'
              assign collections = collections | sort: 'all_products_count'
            when 'date', 'date_reversed'
              assign collections = collections | sort: 'published_at'
          endcase
          if sort_collections == 'products_high' or sort_collections == 'date_reversed' or sort_collections == 'alphabetical_reversed'
            assign collections = collections | reverse
          endif
        -%}
        {%- paginate collections by items_to_show -%}
          <grid-list
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
          >
            <div
              class="collection-list-grid grid grid-cols gap{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
              style="{{ col_style | strip | strip_newlines }}"
            >
              {% for collection in collections %}
                <div class="collection-items relative align-self-start{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-item{% endif %}">
                  <motion-element
                    data-motion="fade-up-lg"
                    hold
                    data-motion-delay="{{ forloop.index0 | times: 50 }}"
                    class="collection-item grid-custom-item {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }} {% endif %} {{ settings.hover_effect }}"
                    {%- if scroll_animation != 'none' -%}
                      style="--animation-order: {{  forloop.index }};"
                    {%- endif -%}
                  >
                    {% render 'collection-item',
                      card_collection: collection,
                      section: section,
                      design: design,
                      collection_information_position: collection_information_position
                    %}
                  </motion-element>
                </div>
              {% endfor %}
            </div>
          </grid-list>
          {% render 'pagination',
            section_st: section_st,
            pagination: pagination,
            number_page: items_to_show,
            paginate: paginate
          %}
        {%- endpaginate -%}
      {%- else -%}
        <grid-list
          {% if scroll_animation != 'slide_in' %}
            hold
          {% endif %}
        >
          <div
            class="collection-list-grid grid grid-cols gap"
            style="{{ col_style | strip | strip_newlines }}"
          >
            {%- assign load = false -%}
            {% for block in section.blocks %}
              {%- liquid
                assign block_st = block.settings
                assign class = ' grid-custom-item'
                if forloop.index > items_to_show
                  assign class = ' grid-custom-item hidden trigger_slidein'
                  assign load = true
                endif
              -%}
              <motion-element
                data-motion="fade-up-lg"
                hold
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="collection-item {{ class }} {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }}  {% endif %} {{ settings.hover_effect }}"
                {%- if scroll_animation != 'none' -%}
                  style="--animation-order: {{  forloop.index }};"
                {%- endif -%}
              >
                {% render 'collection-item',
                  card_collection: block_st.collection,
                  section: section,
                  block: block,
                  design: design,
                  collection_information_position: collection_information_position
                %}
              </motion-element>
            {% endfor %}
          </div>
        </grid-list>
        {%- if load -%}
          {%- if pagination == 'load_more_button' or pagination == 'infinit_scrolling' -%}
            <loadmore-button {% if scroll_animation != 'slide_in' %}hold{% endif %} class="block collection-infinite-scroll text-center mt-60">
              <a class="button inline-block btn-primary" aria-label="{{ section_st.button_show_more }}" role="link">
                <span class="hidden-on-load">{{ section_st.button_show_more }}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="spin opacity-0 icon-load">
                  <use href="#icon-load"></use>
                </svg>
              </a>
            </loadmore-button>
          {%- endif -%}
        {%- endif -%}
      {% endif %}
    </div>
  </div>
</div>


</template>

<schema>
{
  "type": "main-list-collections",
  "name": "Collections list page",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "stretch_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "info": "Add images by editing your collections.",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load-more button text",
      "default": "Load more"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Collection name font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Carousel Options"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination type",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Page numbers"
        },
        {
          "value": "load_more_button",
          "label": "Load-more button"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "items_per_row",
