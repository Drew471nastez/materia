      {
        "type": "view_all",
        "name": "View All button",
        "limit": 1,
        "settings": [
          {
            "type": "checkbox",
            "id": "enabled",
            "label": "Show button",
            "default": true
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "View all"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Empty: the collection page."
          },
          {
            "type": "select",
            "id": "position",
            "label": "Position",
            "default": "header",
            "options": [
              {
                "value": "header",
                "label": "Header"
              },
              {
                "value": "bottom",
                "label": "Below"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "full_width",
            "label": "Full width",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Uppercase",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text color (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color_hover",
            "label": "Border color (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 6,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Horizontal padding",
            "min": 8,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 26,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Vertical padding",
            "min": 6,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Font size",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "600",
            "options": [
              {
                "value": "500",
                "label": "Medium (500)"
              },
              {
                "value": "600",
                "label": "Semibold (600)"
              },
              {
                "value": "700",
                "label": "Bold (700)"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 4,
            "step": 1,
            "unit": "px",
            "default": 1,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Products carousel",
        "category": "Products",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "view_all",
            "settings": {
              "label": "View all",
              "position": "header"
            }
          }
        ]
      }
    ]
  }
