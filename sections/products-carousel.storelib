<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Products carousel: the theme's own product cards
  (snippets/product-item) in the theme's slider (slide-section, global.js),
  so Theme settings > Product cards draw every card. The header is blocks
  (Eyebrow, Heading, Subheading, View All button); a section saved before it
  had blocks keeps its heading and description. live-products-b.js applies
  the style settings in the builder and stops auto-rotation off screen, in a
  hidden tab and under reduced motion; the slider's build (products per row,
  gap, arrows, pagination, loop) follows the builder's redraw.
{%- endcomment -%}
{{ 'pagination-styles.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_width = s.section_width | default: 'fluid_container'
  assign column_gap = s.column_gap
  assign items_per_row = s.items_per_row
  assign items_to_show = s.items_to_show
  assign scroll_animation = settings.scroll_animation
  assign reveal = s.reveal
  assign show_banner = s.show_banner
  assign banner_image = s.banner_image
  assign video_url = s.video_url
  assign local_video = s.local_video
  assign carousel_pagination = s.carousel_pagination
  if s.items_per_row_mobile > 1 and s.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
  assign fallback_href = s.collection.url | default: routes.all_products_collection_url | default: '/collections/all'
  assign has_heading = false
  assign has_sub = false
  assign header_text = false
  assign header_buttons = false
  assign bottom_buttons = false
  for block in section.blocks
    case block.type
      when 'heading'
        assign has_heading = true
      when 'subheading'
        assign has_sub = true
    endcase
    if block.type == 'view_all'
      if block.settings.enabled and block.settings.position == 'bottom'
        assign bottom_buttons = true
      elsif block.settings.enabled
        assign header_buttons = true
      endif
    elsif block.settings.text != blank
      assign header_text = true
    endif
  endfor
  if has_heading == false and s.heading != blank
    assign header_text = true
  endif
  if has_sub == false and s.description != blank
    assign header_text = true
  endif
  assign header_class = ''
  if s.header_size == 'small'
    assign header_class = 'h3'
  elsif s.header_size == 'large'
    assign header_class = 'h1-size'
  endif
-%}
{%- capture pb_json -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"items_to_show":{{ section.settings.items_to_show | default: 0 | json }},"heading":{{ section.settings.heading | append: '' | json }},"description":{{ section.settings.description | append: '' | json }},"header_size":{{ section.settings.header_size | append: '' | json }},"header_alignment":{{ section.settings.header_alignment | append: '' | json }},"heading_underline":{% if section.settings.heading_underline %}true{% else %}false{% endif %},"header_spacing":{{ section.settings.header_spacing | default: 0 | json }},"items_per_row":{{ section.settings.items_per_row | default: 0 | json }},"column_gap":{{ section.settings.column_gap | default: 0 | json }},"show_banner":{% if section.settings.show_banner %}true{% else %}false{% endif %},"banner_type":{{ section.settings.banner_type | append: '' | json }},"banner_image":{% if section.settings.banner_image != blank %}{{ section.settings.banner_image | image_url: width: 1600 | json }}{% else %}""{% endif %},"video_autoplay":{% if section.settings.video_autoplay %}true{% else %}false{% endif %},"banner_link":{{ section.settings.banner_link | append: '' | json }},"banner_width":{{ section.settings.banner_width | default: 0 | json }},"position":{{ section.settings.position | append: '' | json }},"sticky_banner":{% if section.settings.sticky_banner %}true{% else %}false{% endif %},"show_arrow":{% if section.settings.show_arrow %}true{% else %}false{% endif %},"carousel_pagination":{{ section.settings.carousel_pagination | append: '' | json }},"pagination_style":{{ section.settings.pagination_style | append: '' | json }},"pagination_position":{{ section.settings.pagination_position | append: '' | json }},"infinite":{% if section.settings.infinite %}true{% else %}false{% endif %},"autoplay":{% if section.settings.autoplay %}true{% else %}false{% endif %},"autorotate_speed":{{ section.settings.autorotate_speed | default: 0 | json }},"reveal":{% if section.settings.reveal %}true{% else %}false{% endif %},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg_override":{{ section.settings.section_bg_override | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"padding_top":{{ section.settings.padding_top | default: 0 | json }},"padding_bottom":{{ section.settings.padding_bottom | default: 0 | json }},"gap_products_to_pagination":{{ section.settings.gap_products_to_pagination | default: 0 | json }},"gap_pagination_to_button":{{ section.settings.gap_pagination_to_button | default: 0 | json }},"gap_products_to_button":{{ section.settings.gap_products_to_button | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"items_per_row_mobile":{{ section.settings.items_per_row_mobile | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} {
    margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px !important;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ s.section_margin_top_desktop | default: 0 }}px !important;
      margin-bottom: {{ s.section_margin_bottom_desktop | default: 0 }}px !important;
    }
  }
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #shopify-section-{{ sid }} .pc {
    background: var(--pb-bg, var(--gradient-background, var(--color-background)));
    color: var(--color-text);
    font-family: var(--body-font);
  }
  #shopify-section-{{ sid }} .pc-header { margin-bottom: var(--pc-hgap, 32px); display: flex; flex-wrap: wrap; gap: 15px 30px; align-items: center; justify-content: space-between; }
  #shopify-section-{{ sid }} .pc-header[hidden] { display: none; }
  #shopify-section-{{ sid }} .pc-header__text { display: flex; flex-direction: column; gap: 10px; min-width: 0; max-width: 760px; }
  #shopify-section-{{ sid }} .pc[data-align='center'] .pc-header { flex-direction: column; text-align: center; }
  #shopify-section-{{ sid }} .pc[data-align='center'] .pc-header__text { align-items: center; }
  #shopify-section-{{ sid }} .pc[data-align='right'] .pc-header { flex-direction: row-reverse; text-align: right; }
  #shopify-section-{{ sid }} .pc[data-align='right'] .pc-header__text { align-items: flex-end; }
  #shopify-section-{{ sid }} .pc[data-width='full_width'] .pc-header { padding-inline: 20px; }
  #shopify-section-{{ sid }} .pc-header__actions:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .pb-eyebrow { margin: 0; font-size: var(--pb-fs, 13px); color: var(--pb-c, var(--color-text)); text-transform: uppercase; letter-spacing: .12em; font-weight: var(--subheading-weight, 500); }
  #shopify-section-{{ sid }} .pb-heading { margin: 0; font-size: var(--pb-fs-m, 26px); color: var(--pb-c, var(--color-heading)); line-height: var(--heading-line-height, 1.2); }
  #shopify-section-{{ sid }} .pb-sub { margin: 0; font-size: var(--pb-fs, 16px); color: var(--pb-c, var(--color-text)); }
  #shopify-section-{{ sid }} .pb-sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .pb-sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} :is(.pb-eyebrow, .pb-heading, .pb-sub, .pc__view-all)[hidden] { display: none !important; }
  #shopify-section-{{ sid }} .pc[data-underline='true'] .pb-heading { display: inline-block; position: relative; padding-bottom: 12px; align-self: flex-start; }
  #shopify-section-{{ sid }} .pc[data-underline='true'][data-align='center'] .pb-heading { align-self: center; }
  #shopify-section-{{ sid }} .pc[data-underline='true'][data-align='right'] .pb-heading { align-self: flex-end; }
  #shopify-section-{{ sid }} .pc[data-underline='true'] .pb-heading::after { content: ""; position: absolute; left: 0; bottom: 0; width: 48px; height: 2px; background: currentColor; opacity: .85; border-radius: 2px; }
  #shopify-section-{{ sid }} .pc[data-underline='true'][data-align='center'] .pb-heading::after { left: 50%; transform: translateX(-50%); }
  #shopify-section-{{ sid }} .pc[data-underline='true'][data-align='right'] .pb-heading::after { left: auto; right: 0; }
  /* View all is a theme button (theme-button-contract.css): Theme settings >
     Buttons draw it; the block's colours, uppercase and (theme style off) its
     shape are --mb-* tokens. */
  #shopify-section-{{ sid }} .pc__view-all { white-space: nowrap; display: inline-flex; width: auto; max-width: max-content; }
  #shopify-section-{{ sid }} .pc__view-all[data-full='true'] { display: flex; width: 100%; max-width: 100%; }
  #shopify-section-{{ sid }} .products-carousel__view-all-bottom {
    position: relative; z-index: 3; width: 100%; text-align: center; clear: both;
    margin-top: var(--pc-gap-btn);
  }
  #shopify-section-{{ sid }} .products-carousel__view-all-bottom:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} slide-section:has(.products-carousel__pagination:not(.pc-pag-off)) + .products-carousel__view-all-bottom { margin-top: var(--pc-gap-pag-btn); }
  #shopify-section-{{ sid }} .product_with-banner { --col-width: var(--pc-banner-w, 30%); }
  #shopify-section-{{ sid }} .products-grid__banner[data-sticky='true'] { position: sticky; top: 30px; }
  /* === PAGINATION POSITIONING ===
     Swiper's default CSS absolutely-positions .swiper-pagination at the bottom
     of the swiper container, which overlaps product prices. Force it to sit
     BELOW the swiper-wrapper instead by making it relative + adding spacing.
     The gap above pagination (products → pagination) is driven by the
     gap_products_to_pagination setting. */
  #shopify-section-{{ section.id }} .products-carousel__pagination {
    position: relative !important;
    bottom: auto !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
    width: 100% !important;
    margin-top: var(--pc-gap-pag) !important;
    margin-bottom: 0 !important;
    z-index: 2;
  }
  /* Progress pagination needs its own positioning (it's a fixed-width centered
     bar, not full-width). Reset the width 100% from above and recenter. */
  #shopify-section-{{ section.id }} [data-pagination-style='progress'].products-carousel__pagination,
  #shopify-section-{{ section.id }} .products-carousel__pagination[data-pagination-style='progress'] {
    width: clamp(140px, 32vw, 280px) !important;
    margin-left: auto !important;
    margin-right: auto !important;
    left: 0 !important;
    transform: none !important;
  }
  /* The carousel track is wider than the viewport by design (that's how it
     scrolls). Swiper normally clips it with overflow:hidden, but the pagination
     is forced into normal flow BELOW the slides, so a plain overflow:hidden
     would clip the dots. Clip ONLY the horizontal axis so the track can never
     spill past the viewport and widen the page on mobile, and keep the vertical
     axis visible so the pagination underneath still shows. max-width:100% is a
     belt-and-braces guard so the container itself never exceeds its column. */
  #shopify-section-{{ section.id }} slide-section {
    overflow-x: clip;
    overflow-y: visible;
    max-width: 100%;
    padding-bottom: 0 !important;
  }

  /* === CARD HEIGHT & TOP ALIGNMENT (BULLETPROOF) ===
     The issue: slides were rendering at different heights because the image
     aspect ratios weren't being forced consistent, AND content inside slides
     wasn't being top-anchored. This block fixes both:

     1. All slides share the wrapper's tallest height (align-items: stretch).
     2. All slides are forced to start at the TOP (align-self: flex-start +
        the inner wrapper uses justify-content: flex-start so the image is
        anchored to the top of the card, never the middle).
     3. The image container is forced to a consistent aspect ratio so the
        first card can't render at a different height than the others.
     4. Title/price/actions get pushed to share the remaining space below
        the image consistently across all cards.

     CRITICAL: Only apply flex to visible content children. Setting
     `display: flex` on script, noscript, style or template elements
     overrides their user-agent `display: none`, making their text content
     visible on the page (e.g. product variant JSON dumps from product-item.liquid). */
  #shopify-section-{{ section.id }} .swiper-wrapper {
    align-items: stretch !important;
  }
  #shopify-section-{{ section.id }} .swiper-slide {
    height: auto !important;
    display: flex !important;
    flex-direction: column;
    align-self: flex-start !important;
    justify-content: flex-start !important;
    vertical-align: top !important;
  }
  #shopify-section-{{ section.id }} .swiper-slide > *:not(script):not(noscript):not(style):not(template):not(link):not(meta) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
  }
  /* Explicitly keep script/template-type elements hidden even inside the flex
     parent — defensive in case the browser/user-agent stylesheet is overridden. */
  #shopify-section-{{ section.id }} .swiper-slide script,
  #shopify-section-{{ section.id }} .swiper-slide noscript,
  #shopify-section-{{ section.id }} .swiper-slide template,
  #shopify-section-{{ section.id }} .swiper-slide style,
  #shopify-section-{{ section.id }} .swiper-slide link,
  #shopify-section-{{ section.id }} .swiper-slide meta {
    display: none !important;
  }
  /* The product-item inner wrapper anchors the image to the top and pushes
     vendor / title / price / actions to share the remaining height. */
  #shopify-section-{{ section.id }} .swiper-slide .product-item__wrapper,
  #shopify-section-{{ section.id }} .swiper-slide .product-card,
  #shopify-section-{{ section.id }} .swiper-slide .card-wrapper,
  #shopify-section-{{ section.id }} .swiper-slide .product-item {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start !important;
    align-items: stretch !important;
    height: 100%;
    width: 100%;
  }
  /* Force the image / media wrapper to share a consistent aspect ratio at the
     top of every card. Without this, placeholders and real images can render
     at different heights (which is exactly what's happening in the screenshot —
     the first card's image area is taller than the others). */
  #shopify-section-{{ section.id }} .swiper-slide .product-item__image,
  #shopify-section-{{ section.id }} .swiper-slide .product-item__media,
  #shopify-section-{{ section.id }} .swiper-slide .pcard__image,
  #shopify-section-{{ section.id }} .swiper-slide .product-card__media,
  #shopify-section-{{ section.id }} .swiper-slide .card__media,
  #shopify-section-{{ section.id }} .swiper-slide .media,
  #shopify-section-{{ section.id }} .swiper-slide .placeholder-svg-wrapper,
  #shopify-section-{{ section.id }} .swiper-slide .placeholder {
    flex: 0 0 auto !important;
    width: 100% !important;
    align-self: stretch !important;
    margin-top: 0 !important;
  }
  /* Specifically make sure the placeholder SVG and any direct img/video in the
     card's media slot stretch to 100% width and don't push the card down. */
  #shopify-section-{{ section.id }} .swiper-slide .product-item > a:first-child,
  #shopify-section-{{ section.id }} .swiper-slide .product-item__wrapper > a:first-child,
  #shopify-section-{{ section.id }} .swiper-slide .product-card > a:first-child {
    display: block !important;
    width: 100% !important;
    margin-top: 0 !important;
  }
  /* The text/info area below the image gets the remaining flex space so the
     bottoms align even when titles wrap to different line counts. */
  #shopify-section-{{ section.id }} .swiper-slide .product-item__info,
  #shopify-section-{{ section.id }} .swiper-slide .product-card__info,
  #shopify-section-{{ section.id }} .swiper-slide .card__content,
  #shopify-section-{{ section.id }} .swiper-slide .product-item__content {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    width: 100% !important;
  }
{% comment %}{% endcomment %}</style>
<div
  class="section pc{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} sec__products-carousel color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}{% if reveal %} overflow-hidden{% endif %}"
  data-pb-root="products-carousel" data-pb-section="{{ sid }}" data-pb-settings="{{ pb_json | escape }}" data-pb-fallback-href="{{ fallback_href }}" data-pb-defaults='{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"items_to_show":5,"heading":"Best Selling","header_size":"medium","header_alignment":"left","heading_underline":false,"header_spacing":32,"items_per_row":4,"column_gap":30,"show_banner":false,"banner_type":"image","video_autoplay":true,"banner_width":30,"position":"left","sticky_banner":false,"show_arrow":false,"carousel_pagination":"show_dots_on_mobile","pagination_style":"dot","pagination_position":"center","infinite":false,"autoplay":false,"autorotate_speed":5,"reveal":false,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","padding_top":50,"padding_bottom":50,"gap_products_to_pagination":24,"gap_pagination_to_button":24,"gap_products_to_button":32,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"items_per_row_mobile":2,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-pb-block-defaults='{"eyebrow":{"text":"Shop","enable_custom_style":false,"size":13},"heading":{"text":"Best Selling","enable_custom_style":false,"size_desktop":32,"size_mobile":26},"subheading":{"text":"&lt;p>Fresh picks from the collection.&lt;/p>","enable_custom_style":false,"size":16},"view_all":{"enabled":true,"label":"View all","position":"header","full_width":false,"uppercase":false,"enable_custom_style":false,"use_theme_button":true,"radius":6,"padding_x":26,"padding_y":14,"font_size":14,"font_weight":"600","border_width":1}}'
  data-align="{{ s.header_alignment | default: 'left' }}" data-underline="{% if s.heading_underline %}true{% else %}false{% endif %}" data-width="{{ section_width }}"
  style="--section-pt: {{ s.padding_top }};--section-pb: {{ s.padding_bottom }};--pc-hgap: {{ s.header_spacing | default: 0 }}px;--pc-gap-pag: {{ s.gap_products_to_pagination | default: 0 }}px;--pc-gap-pag-btn: {{ s.gap_pagination_to_button | default: 0 }}px;--pc-gap-btn: {{ s.gap_products_to_button | default: 0 }}px;--pc-banner-w: {{ s.banner_width | default: 30 }}%;{% if s.enable_custom_style %}--pb-bg: {% render 'scheme-color', color: s.section_bg_override, fallback: 'var(--color-background)' %};{% endif %}{% if s.enable_custom_fonts and s.heading_font.family != blank %}--heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if s.enable_custom_fonts and s.body_font.family != blank %}--body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{% endif %}"
>
  <div class="pb-inner {{ section_width }}" data-pb-width>
    <div class="pc-header section__header" data-pb-header{% unless header_text or header_buttons %} hidden{% endunless %}>
      <div class="pc-header__text secion__header-inner">
        {%- if has_heading == false and s.heading != blank -%}
          <h2 class="pb-heading section__header-heading heading-letter-spacing {{ header_class }}" data-pb-legacy>{{ s.heading }}</h2>
        {%- endif -%}
        {%- if has_sub == false and s.description != blank -%}
          <div class="pb-sub section__header-des rich__text-m0" data-pb-legacy>{{ s.description }}</div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading' -%}
            {%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'view_all' -%}{"enabled":{% if block.settings.enabled %}true{% else %}false{% endif %},"label":{{ block.settings.label | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"full_width":{% if block.settings.full_width %}true{% else %}false{% endif %},"uppercase":{% if block.settings.uppercase %}true{% else %}false{% endif %},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"padding_x":{{ block.settings.padding_x | default: 0 | json }},"padding_y":{{ block.settings.padding_y | default: 0 | json }},"font_size":{{ block.settings.font_size | default: 0 | json }},"font_weight":{{ block.settings.font_weight | append: '' | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}
            {%- render 'products-b-text', block: block, json: pb_bjson -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="pc-header__actions" data-pb-slot="header">
        {%- for block in section.blocks -%}{%- if block.type == 'view_all' and block.settings.position != 'bottom' -%}{%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'view_all' -%}{"enabled":{% if block.settings.enabled %}true{% else %}false{% endif %},"label":{{ block.settings.label | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"full_width":{% if block.settings.full_width %}true{% else %}false{% endif %},"uppercase":{% if block.settings.uppercase %}true{% else %}false{% endif %},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"padding_x":{{ block.settings.padding_x | default: 0 | json }},"padding_y":{{ block.settings.padding_y | default: 0 | json }},"font_size":{{ block.settings.font_size | default: 0 | json }},"font_weight":{{ block.settings.font_weight | append: '' | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}{%- assign bs = block.settings -%}
{%- capture pb_style -%}
  {%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
  {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius | default: 0 }}px;--mb-padding-x: {{ bs.padding_x | default: 0 }}px;--mb-padding-y: {{ bs.padding_y | default: 0 }}px;--mb-font-size: {{ bs.font_size | default: 14 }}px;--mb-weight: {{ bs.font_weight | default: 600 }};--btn-border-width: {{ bs.border_width | default: 0 }}px;{%- endif -%}
  {%- if bs.uppercase -%}--btn-text-transform: uppercase;--btn-letter-spacing: 0.04em;{%- endif -%}
{%- endcapture -%}
{%- assign pb_label = bs.label | strip -%}
<a class="pc__view-all no-underline" href="{% if bs.link != blank %}{{ bs.link | url }}{% else %}{{ fallback_href }}{% endif %}" data-theme-button="primary" data-sl-button data-block-id="{{ block.id }}" data-full="{% if bs.full_width %}true{% else %}false{% endif %}" data-pb-order="{{ forloop.index }}" data-pb-block="{{ block.id }}" data-pb-type="view_all" data-pb-settings="{{ pb_bjson | escape }}" style="{{ pb_style | strip }}"{% if bs.enabled == false or pb_label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ pb_label | escape }}</a>{%- endif -%}{%- endfor -%}
      </div>
    </div>
    {%- if data_free_scroll == 'true' -%}<div class="free-scroll">{%- endif -%}
    {%- if show_banner -%}
      <div class="flex flex-wrap gap product_with-banner{% if s.position == 'left' %} flex-row-reverse{% endif %}" data-pb-banner-row style="{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;{% endif %}">
      <div class="w-full col-1025-remaining">
    {%- endif -%}
      <slide-section
        class="swiper{% if reveal %} reveal_on_scroll{% endif %}"
        data-section-id="{{ sid }}"
        data-autoplay="{{ s.autoplay }}"
        data-effect="slide"
        data-loop="{{ s.infinite }}"
        data-speed="500"
        data-autoplay-speed="{{ s.autorotate_speed }}"
        data-spacing="{{ column_gap }}"
        data-mobile="{{ s.items_per_row_mobile }}"
        data-desktop="{{ items_per_row }}"
        data-free-scroll="{{ data_free_scroll }}"
        data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' or s.pagination_style == 'progress' %}true{% else %}false{% endif %}"
        data-pagination-style="{{ s.pagination_style | default: 'dot' }}"
        style="{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;{% endif %}"
        data-arrow-centerimage="1"
        data-pb-slider
      >
        {%- if s.show_arrow -%}
          {%- render 'swiper-navigation' -%}
        {%- endif -%}
        <div class="swiper-wrapper">
          {%- if s.collection.products.size > 0 -%}
            {%- for product in s.collection.products limit: items_to_show -%}
              {% render 'product-item',
                card_product: product,
                section_id: sid,
                container: section_width,
                colunm: items_per_row,
                colunm_mobile: s.items_per_row_mobile,
                padding: column_gap,
                class: ' swiper-slide',
                template_enable_action: true,
                template_enable_product_vendor: true,
                template_enable_rate: true,
                template_enable_product_short_description: true,
                template_enable_color_swatches: true,
                template_enable_price: true,
                template_enable_add_cart: true,
                scroll_animation: scroll_animation,
                indexFor: forloop.index,
                template_enable_product_badges: true
              %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..items_to_show) -%}
              {% render 'product-item',
                section_id: sid,
                container: section_width,
                colunm: items_per_row,
                colunm_mobile: s.items_per_row_mobile,
                padding: column_gap,
                class: ' swiper-slide',
                template_enable_action: true,
                template_enable_product_vendor: true,
                template_enable_rate: true,
                template_enable_product_short_description: true,
                template_enable_color_swatches: true,
                template_enable_price: true,
                scroll_animation: scroll_animation,
                indexFor: forloop.index,
                template_enable_product_badges: true
              %}
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' or carousel_pagination == 'show_progress_bar' -%}
          <div
            class="swiper-pagination products-carousel__pagination flex flex-wrap px-15 lh-1 bottom-30{% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ s.pagination_position | default: 'center' }}"
            style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
            data-pagination-style="{{ s.pagination_style | default: 'dot' }}"
            data-pb-pagination
          ></div>
        {%- endif -%}
      </slide-section>
      <div class="products-carousel__view-all-bottom" data-pb-slot="bottom">
        {%- for block in section.blocks -%}{%- if block.type == 'view_all' and block.settings.position == 'bottom' -%}{%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'view_all' -%}{"enabled":{% if block.settings.enabled %}true{% else %}false{% endif %},"label":{{ block.settings.label | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"position":{{ block.settings.position | append: '' | json }},"full_width":{% if block.settings.full_width %}true{% else %}false{% endif %},"uppercase":{% if block.settings.uppercase %}true{% else %}false{% endif %},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"bg":{{ block.settings.bg | append: '' | json }},"color":{{ block.settings.color | append: '' | json }},"border_color":{{ block.settings.border_color | append: '' | json }},"bg_hover":{{ block.settings.bg_hover | append: '' | json }},"color_hover":{{ block.settings.color_hover | append: '' | json }},"border_color_hover":{{ block.settings.border_color_hover | append: '' | json }},"use_theme_button":{% if block.settings.use_theme_button %}true{% else %}false{% endif %},"radius":{{ block.settings.radius | default: 0 | json }},"padding_x":{{ block.settings.padding_x | default: 0 | json }},"padding_y":{{ block.settings.padding_y | default: 0 | json }},"font_size":{{ block.settings.font_size | default: 0 | json }},"font_weight":{{ block.settings.font_weight | append: '' | json }},"border_width":{{ block.settings.border_width | default: 0 | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}{%- assign bs = block.settings -%}
{%- capture pb_style -%}
  {%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
  {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius | default: 0 }}px;--mb-padding-x: {{ bs.padding_x | default: 0 }}px;--mb-padding-y: {{ bs.padding_y | default: 0 }}px;--mb-font-size: {{ bs.font_size | default: 14 }}px;--mb-weight: {{ bs.font_weight | default: 600 }};--btn-border-width: {{ bs.border_width | default: 0 }}px;{%- endif -%}
  {%- if bs.uppercase -%}--btn-text-transform: uppercase;--btn-letter-spacing: 0.04em;{%- endif -%}
{%- endcapture -%}
{%- assign pb_label = bs.label | strip -%}
<a class="pc__view-all no-underline" href="{% if bs.link != blank %}{{ bs.link | url }}{% else %}{{ fallback_href }}{% endif %}" data-theme-button="primary" data-sl-button data-block-id="{{ block.id }}" data-full="{% if bs.full_width %}true{% else %}false{% endif %}" data-pb-order="{{ forloop.index }}" data-pb-block="{{ block.id }}" data-pb-type="view_all" data-pb-settings="{{ pb_bjson | escape }}" style="{{ pb_style | strip }}"{% if bs.enabled == false or pb_label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ pb_label | escape }}</a>{%- endif -%}{%- endfor -%}
      </div>
    {%- if show_banner -%}
      </div>
      <a
        class="hidden block-1025 products-grid__banner fs-0 align-self-baseline w-full col-md-w-custom rounded overflow-hidden"
        data-pb-banner data-sticky="{% if s.sticky_banner %}true{% else %}false{% endif %}"
        aria-label="{{- 'general.banner' | t -}}"
        {% if s.banner_link == blank or s.banner_type != 'image' %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ s.banner_link | url }}"
        {% endif %}
      >
        {%- if s.banner_type == 'image' and banner_image != blank -%}
          {%- assign image_alt = banner_image.alt | default: '' | escape -%}
          {% render 'responsive-image',
            type: 'other',
            class: 'rounded',
            image: banner_image,
            image_alt: image_alt,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: s.items_per_row_mobile,
            padding: column_gap,
          %}
        {%- elsif s.banner_type == 'video' and local_video != blank -%}
          {%- liquid
            assign source_url = ''
            for src in local_video.sources
              if src.format == 'mp4'
                assign source_url = src.url
                break
              endif
            endfor
          -%}
          <video class="rounded w-full" controls playsinline preload="none"{% if s.video_autoplay %} muted autoplay loop data-pb-autoplay{% endif %} src="{{ source_url }}" poster="{{ local_video.preview_image | image_url: width: 1100 }}"></video>
        {%- elsif s.banner_type == 'video' and video_url != blank -%}
          {%- if video_url.type == 'youtube' -%}
            <div style="--aspect-ratio: 16/9">
              <iframe src="https://www.youtube.com/embed/{{ video_url.id }}?enablejsapi=1&autoplay=0&mute=0&loop=0" class="js-youtube rounded w-full" title="{{ 'general.banner' | t }}" loading="lazy"></iframe>
            </div>
          {%- else -%}
            <div style="--aspect-ratio: 16/9">
              <iframe class="js-vimeo rounded w-full" src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=0&muted=0&loop=0" title="{{ 'general.banner' | t }}" loading="lazy" allowfullscreen></iframe>
            </div>
          {%- endif -%}
        {%- else -%}
          {% render 'placeholder-render', class: 'rounded' %}
        {%- endif -%}
      </a>
      </div>
    {%- endif -%}
    {%- if data_free_scroll == 'true' -%}</div>{%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "type": "products-carousel",
  "name": "Products carousel",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg_override",
      "label": "Background override"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Vertical gaps"
    },
    {
      "type": "range",
      "id": "gap_products_to_pagination",
      "label": "Products to pagination",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_pagination_to_button",
      "label": "Pagination to button",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_products_to_button",
      "label": "Products to button",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Selling"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "heading_underline",
      "label": "Heading underline",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Image / Media"
    },
    {
      "type": "checkbox",
      "id": "sticky_banner",
      "label": "Sticky banner"
    },
    {
      "type": "range",
      "id": "banner_width",
      "label": "Banner width",
      "min": 20,
      "max": 50,
      "step": 1,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Banner position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    },
    {
      "type": "select",
      "id": "banner_type",
      "label": "Banner type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "label": "Video URL"
    },
    {
      "type": "video",
      "id": "local_video",
      "label": "Local video"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Display & Grid"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Items to show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Items per row (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Carousel Options"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video (muted)",
      "default": true
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Pagination dots",
      "default": "show_dots_on_mobile",
      "options": [
        {
          "value": "disable",
          "label": "Disable"
        },
        {
          "value": "show_dots",
          "label": "Show dots"
        },
        {
          "value": "show_dots_on_mobile",
          "label": "Mobile only"
        },
        {
          "value": "show_progress_bar",
          "label": "Progress bar"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
