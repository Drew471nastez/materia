<template compat="shopify">
{%- comment -%}Retired at creator request. No storefront output or library presets.{%- endcomment -%}
</template>
<schema>
{
  "shopify": {
    "name": "Hero Product 4",
    "tag": "section",
    "class": "hp4-section-wrap",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section spacing",
        "default": true
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image position",
        "default": "right",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "text_column_width",
        "label": "Text column width",
        "min": 35,
        "max": 70,
        "step": 1,
        "unit": "%",
        "default": 50
      },
      {
        "type": "range",
        "id": "gap_columns",
        "label": "Column gap (desktop)",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "select",
        "id": "content_align_desktop",
        "label": "Content alignment (desktop)",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "muted_color",
        "label": "Muted text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "top_divider_color",
        "label": "Top divider color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "bottom_divider_color",
        "label": "Bottom divider color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "divider_bottom_color",
        "label": "Divider color",
        "info": "Match next section background",
        "default": "#FFFFFF",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "product",
        "id": "featured_product",
        "label": "Featured product",
        "info": "Used by rating blocks"
      },
      {
        "type": "image_picker",
        "id": "featured_image",
        "label": "Featured image"
      },
      {
        "type": "image_picker",
        "id": "featured_image_mobile",
        "label": "Featured image (mobile override)"
      },
      {
        "type": "text",
        "id": "image_alt",
        "label": "Image description"
      },
      {
        "type": "header",
        "content": "Media Layout"
      },
      {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Cover"
          },
          {
            "value": "contain",
            "label": "Contain"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_height_desktop",
        "label": "Image height (desktop)",
        "min": 100,
        "max": 1100,
        "step": 10,
        "unit": "px",
        "default": 480
      },
      {
        "type": "checkbox",
        "id": "image_full_width",
        "label": "Image full width",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "divider_bottom_rotate",
        "label": "Wave rotate (flip upside down)",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "image_full_width_desktop",
        "label": "Image full width (desktop)",
        "default": false
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "select",
        "id": "animation",
        "label": "Entrance animation",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "fade_up",
            "label": "Fade up"
          },
          {
            "value": "zoom",
            "label": "Zoom"
          }
        ],
        "default": "theme",
        "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal content on entry",
        "default": false,
        "info": "When no other animation is selected, use a subtle reveal. Editor slider changes never replay the entrance."
      },
      {
        "type": "header",
        "content": "Section Dividers"
      },
      {
        "type": "checkbox",
        "id": "show_top_divider",
        "label": "Show top divider",
        "default": false
      },
      {
        "type": "range",
        "id": "top_divider_thickness",
        "label": "Top divider thickness",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "show_bottom_divider",
        "label": "Show bottom divider",
        "default": false
      },
      {
        "type": "range",
        "id": "bottom_divider_thickness",
        "label": "Bottom divider thickness",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "select",
        "id": "divider_top_style",
        "label": "Top shape",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "wave",
            "label": "Wave"
          },
          {
            "value": "wave_soft",
            "label": "Wave (soft)"
          },
          {
            "value": "zigzag",
            "label": "Zig-zag"
          },
          {
            "value": "curve_down",
            "label": "Curve (dip)"
          },
          {
            "value": "arch_up",
            "label": "Arch (peak)"
          },
          {
            "value": "triangles",
            "label": "Triangles"
          },
          {
            "value": "scallop",
            "label": "Scallop"
          },
          {
            "value": "tilt_left",
            "label": "Tilt left"
          },
          {
            "value": "tilt_right",
            "label": "Tilt right"
          },
          {
            "value": "straight",
            "label": "Straight bar"
          }
        ]
      },
      {
        "type": "color",
        "id": "divider_top_color",
        "label": "Top shape color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "divider_top_height_desktop",
        "label": "Top shape height (desktop)",
        "min": 0,
        "max": 200,
        "step": 1,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "divider_top_height_mobile",
        "label": "Top shape height (mobile)",
        "min": 0,
        "max": 200,
        "step": 1,
        "unit": "px",
        "default": 40
      },
      {
        "type": "checkbox",
        "id": "divider_top_flip",
        "label": "Flip top shape horizontally",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "divider_top_rotate",
        "label": "Rotate top shape 180°",
        "default": false
      },
      {
        "type": "select",
        "id": "divider_bottom_style",
        "label": "Shape",
        "default": "wave_soft",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "wave",
            "label": "Wave"
          },
          {
            "value": "wave_soft",
            "label": "Wave (soft)"
          },
          {
            "value": "zigzag",
            "label": "Zig-zag"
          },
          {
            "value": "curve_down",
            "label": "Curve (dip)"
          },
          {
            "value": "arch_up",
            "label": "Arch (peak)"
          },
          {
            "value": "triangles",
            "label": "Triangles"
          },
          {
            "value": "scallop",
            "label": "Scallop"
          },
          {
            "value": "tilt_left",
            "label": "Tilt left"
          },
          {
            "value": "tilt_right",
            "label": "Tilt right"
          },
          {
            "value": "straight",
            "label": "Straight bar"
          }
        ]
      },
      {
        "type": "range",
        "id": "divider_bottom_height_desktop",
        "label": "Divider height (desktop)",
        "min": 20,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 24
      },
      {
        "type": "checkbox",
        "id": "divider_bottom_flip",
        "label": "Flip horizontally",
        "default": false
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "section_padding_left_desktop",
        "label": "Left padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "section_padding_right_desktop",
        "label": "Right padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "select",
        "id": "image_position_mobile",
        "label": "Mobile image position",
        "default": "top",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ]
      },
      {
        "type": "select",
        "id": "content_align_mobile",
        "label": "Content alignment (mobile)",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "gap_columns_mobile",
        "label": "Column gap (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "image_height_mobile",
        "label": "Image height (mobile)",
        "min": 100,
        "max": 1100,
        "step": 10,
        "unit": "px",
        "default": 320
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "section_padding_left_mobile",
        "label": "Left padding (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_padding_right_mobile",
        "label": "Right padding (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "divider_bottom_height_mobile",
        "label": "Divider height (mobile)",
        "min": 12,
        "max": 140,
        "step": 4,
        "unit": "px",
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 3,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading_text",
            "label": "Heading text",
            "default": "Hero Product Section"
          },
          {
            "type": "text",
            "id": "accent_word",
            "label": "Accent substring",
            "info": "Exact text to accent"
          },
          {
            "type": "select",
            "id": "accent_style",
            "label": "Accent style",
            "default": "italic",
            "options": [
              {
                "value": "italic",
                "label": "Italic"
              },
              {
                "value": "normal",
                "label": "Normal"
              }
            ]
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "accent_color",
            "label": "Accent color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Heading color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "400",
                "label": "Regular (400)"
              },
              {
                "value": "500",
                "label": "Medium (500)"
              },
              {
                "value": "600",
                "label": "Semibold (600)"
              },
              {
                "value": "700",
                "label": "Bold (700)"
              },
              {
                "value": "800",
                "label": "Extra bold (800)"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "font_size_desktop",
            "label": "Font size (desktop)",
            "min": 24,
            "max": 96,
            "step": 1,
            "unit": "px",
            "default": 56,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "font_size_mobile",
            "label": "Font size (mobile)",
            "min": 18,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 32,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height_desktop",
            "label": "Line height (desktop)",
            "min": 0.8,
            "max": 2,
            "step": 0.1,
            "default": 1.1,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height_mobile",
            "label": "Line height (mobile)",
            "min": 0.8,
            "max": 2,
            "step": 0.1,
            "default": 1.2,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_font",
            "label": "Use custom Google font",
            "default": false,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "font_picker",
            "id": "custom_font_name",
            "label": "Custom heading font",
            "info": "e.g. \"Inter\", \"Playfair Display\"",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_custom_font }}"
          },
          {
            "type": "checkbox",
            "id": "enable_gradient",
            "label": "Enable gradient text",
            "default": false,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "gradient_start",
            "label": "Gradient start",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_gradient }}"
          },
          {
            "type": "color",
            "id": "gradient_middle",
            "label": "Gradient middle",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_gradient }}"
          },
          {
            "type": "color",
            "id": "gradient_end",
            "label": "Gradient end",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_gradient }}"
          },
          {
            "type": "range",
            "id": "gradient_angle",
            "label": "Gradient angle",
            "min": 0,
            "max": 360,
            "step": 5,
            "unit": "deg",
            "default": 90,
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_gradient }}"
          },
          {
            "type": "select",
            "id": "font_source",
            "label": "Font",
            "options": [
              {
                "value": "heading",
                "label": "Heading font"
              },
              {
                "value": "body",
                "label": "Body font"
              }
            ],
            "default": "heading",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "text_case",
            "label": "Text case",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "none",
                "label": "Original"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              },
              {
                "value": "lowercase",
                "label": "Lowercase"
              },
              {
                "value": "capitalize",
                "label": "Capitalize"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "letter_spacing",
            "label": "Letter spacing",
            "min": -2,
            "max": 8,
            "step": 0.1,
            "default": 0,
            "unit": "px",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 1200,
            "step": 10,
            "unit": "px",
            "default": 640
          },
          {
            "type": "range",
            "id": "margin_bottom",
            "label": "Margin bottom",
            "min": 0,
            "max": 80,
            "step": 2,
            "unit": "px",
            "default": 16
          },
          {
            "type": "checkbox",
            "id": "enable_custom_alignment",
            "label": "Override section alignment",
            "default": false
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 3,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Short supporting copy that explains what the product does and why it matters.</p>"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
