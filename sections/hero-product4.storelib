          "type": "header",
          "id": "hdr_24",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Top padding",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Bottom padding",
          "min": 0,
          "max": 60,
          "step": 1,
