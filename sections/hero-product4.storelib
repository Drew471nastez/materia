<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_new_badge = 'accessibility.new_badge' | t -%}
{%- assign fb_accessibility_selling_fast = 'accessibility.selling_fast' | t -%}
{%- assign fb_accessibility_learn_more = 'accessibility.learn_more' | t -%}
{%- assign fb_accessibility_shop_now_upper = 'accessibility.shop_now_upper' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign featured_product = s.featured_product
-%}

{%- comment -%} ============================================================
   Hero Product 4
   Two-column hero: stack of customizable blocks on one side, portrait
   product image on the other. All visible content lives in blocks so the
   merchant can drag/reorder them in the editor.
============================================================ {%- endcomment -%}

<style>
  /* Custom fonts (toggle in section settings; off by default) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
    font-family: var(--heading-font, inherit);
  }

  /* Section margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ s.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ s.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ s.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  /* Full-width wrapper */
  #shopify-section-{{ sid }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ sid }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width */
  {%- case s.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .container,
      #shopify-section-{{ sid }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .fluid_container,
      #shopify-section-{{ sid }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .stretch_width,
        #shopify-section-{{ sid }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}

  {%- if s.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    .shopify-section:has(+ #shopify-section-{{ sid }}) {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }
  {%- endif -%}

  /* ============== Section layout ============== */
  #hp4-{{ sid }} {
    background: {% render 'scheme-color', color: s.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %};
    color: {% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %};
    --hp-muted: {% render 'scheme-color', color: s.muted_color, fallback: 'var(--color-text)' %};
    padding-top: {{ s.padding_top_mobile | default: 32 }}px;
    padding-bottom: {{ s.padding_bottom_mobile | default: 32 }}px;
    padding-left: {{ s.section_padding_left_mobile | default: 6 }}px;
    padding-right: {{ s.section_padding_right_mobile | default: 6 }}px;
    box-sizing: border-box;
    position: relative;
  }
  @media (min-width: 768px) {
    #hp4-{{ sid }} {
      padding-top: {{ s.padding_top_desktop | default: 64 }}px;
      padding-bottom: {{ s.padding_bottom_desktop | default: 64 }}px;
    }
  }
  @media (min-width: 1024px) {
    #hp4-{{ sid }} {
      padding-left: {{ s.section_padding_left_desktop | default: 16 }}px;
      padding-right: {{ s.section_padding_right_desktop | default: 16 }}px;
    }
  }
  {%- if s.divider_bottom_style != 'none' and s.divider_bottom_style != blank -%}
    #hp4-{{ sid }} {
      padding-bottom: calc({{ s.padding_bottom_mobile | default: 32 }}px + {{ s.divider_bottom_height_mobile | default: 40 }}px);
    }
    @media (min-width: 768px) {
      #hp4-{{ sid }} {
        padding-bottom: calc({{ s.padding_bottom_desktop | default: 64 }}px + {{ s.divider_bottom_height_desktop | default: 60 }}px);
      }
    }
  {%- endif -%}

  /* Full-width image (mobile): bleed the image column flush to the viewport's
     left/right edges AND make it fill the section top-to-bottom so the image
     sticks to the top and bottom with no gaps. */
  {%- if s.image_full_width -%}
    @media (max-width: 899px) {
      /* Kill the section's own vertical padding so the image can reach top & bottom. */
      #hp4-{{ sid }} {
        padding-top: 0 !important;
        padding-bottom: {% if s.divider_bottom_style != 'none' and s.divider_bottom_style != blank %}{{ s.divider_bottom_height_mobile | default: 40 }}px{% else %}0{% endif %} !important;
      }
      /* Stack: image on top, full bleed, flush to the section's top edge. */
      #hp4-{{ sid }} .hp4-grid {
        gap: 0 !important;
      }
      #hp4-{{ sid }} .hp4-image-wrap {
        border-radius: 0 !important;
      }
      #hp4-{{ sid }} .hp4-image-col {
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(50% - 50vw) !important;
        margin-right: calc(50% - 50vw) !important;
      }
      /* Give the text its own breathing room since the section padding is gone. */
      #hp4-{{ sid }} .hp4-text {
        padding: {{ s.padding_top_mobile | default: 32 }}px {{ s.section_padding_left_mobile | default: 8 }}px {{ s.padding_bottom_mobile | default: 32 }}px {{ s.section_padding_right_mobile | default: 8 }}px !important;
      }
    }
  {%- endif -%}

  /* Full-width image (desktop): on >=900px, bleed the image column to the viewport
     edge on its side AND stretch it to fill the full section height (sticks to the
     section's top and bottom), ignoring section padding and container max-width. */
  {%- if s.image_full_width_desktop -%}
    @media (min-width: 900px) {
      /* Let the image column span the section's full height. */
      #hp4-{{ sid }} {
        padding-top: 0 !important;
        padding-bottom: {% if s.divider_bottom_style != 'none' and s.divider_bottom_style != blank %}{{ s.divider_bottom_height_desktop | default: 60 }}px{% else %}0{% endif %} !important;
        overflow: hidden;
      }
      #hp4-{{ sid }} .hp4-grid {
        align-items: stretch !important;
      }
      #hp4-{{ sid }} .hp4-image-wrap {
        border-radius: 0 !important;
        height: 100% !important;
      }
      /* Make the image fill the whole column height (top & bottom stick). */
      #hp4-{{ sid }} .hp4-image-wrap img,
      #hp4-{{ sid }} .hp4-image-wrap .hp4-image-fallback {
        height: 100% !important;
        min-height: {{ s.image_height_desktop | default: 480 }}px;
        object-fit: {{ s.image_fit | default: 'cover' }} !important;
      }
      /* Keep the text column padded since the section padding is now zero. */
      #hp4-{{ sid }} .hp4-text {
        padding-top: {{ s.padding_top_desktop | default: 64 }}px !important;
        padding-bottom: {{ s.padding_bottom_desktop | default: 64 }}px !important;
      }
      {%- if s.image_position == 'left' -%}
        #hp4-{{ sid }} .hp4-image-col {
          margin-left: calc((100vw - 100%) / -2) !important;
          padding-left: calc((100vw - 100%) / 2) !important;
          box-sizing: content-box !important;
        }
      {%- else -%}
        #hp4-{{ sid }} .hp4-image-col {
          margin-right: calc((100vw - 100%) / -2) !important;
          padding-right: calc((100vw - 100%) / 2) !important;
          box-sizing: content-box !important;
        }
      {%- endif -%}
    }
  {%- endif -%}

  #hp4-{{ sid }} .hp4-grid {
    display: flex !important;
    flex-direction: column-reverse !important;
    gap: {{ s.gap_columns_mobile | default: 32 }}px !important;
    row-gap: {{ s.gap_columns_mobile | default: 32 }}px !important;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 900px) {
    #hp4-{{ sid }} .hp4-grid {
      flex-direction: {% if s.image_position == 'left' %}row-reverse{% else %}row{% endif %} !important;
      gap: {{ s.gap_columns | default: 64 }}px !important;
      column-gap: {{ s.gap_columns | default: 64 }}px !important;
      row-gap: 0 !important;
      align-items: center;
    }
  }

  {%- liquid
    assign _ca_m = s.content_align_mobile | default: 'left'
    assign _ca_d = s.content_align_desktop | default: 'left'
    case _ca_m
      when 'center'
        assign _ai_m = 'center'
        assign _ta_m = 'center'
      when 'right'
        assign _ai_m = 'flex-end'
        assign _ta_m = 'right'
      else
        assign _ai_m = 'flex-start'
        assign _ta_m = 'left'
    endcase
    case _ca_d
      when 'center'
        assign _ai_d = 'center'
        assign _ta_d = 'center'
      when 'right'
        assign _ai_d = 'flex-end'
        assign _ta_d = 'right'
      else
        assign _ai_d = 'flex-start'
        assign _ta_d = 'left'
    endcase
  -%}
  #hp4-{{ sid }} .hp4-text {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
  }
  #hp4-{{ sid }} .hp4-text > * {
    text-align: {{ _ta_m }};
  }
  #hp4-{{ sid }} .hp4-text > .hp4-btn,
  #hp4-{{ sid }} .hp4-text > .hp4-pill,
  #hp4-{{ sid }} .hp4-text > .hp4-spa,
  #hp4-{{ sid }} .hp4-text > .hp4-guarantee,
  #hp4-{{ sid }} .hp4-text > .hp4-bullet-checklist,
  #hp4-{{ sid }} .hp4-text > .hp4-bonus-offer,
  #hp4-{{ sid }} .hp4-text > .hp4-price-inline,
  #hp4-{{ sid }} .hp4-text > .hp4-scarcity-meter {
    align-self: {{ _ai_m }};
    {%- if _ca_m == 'center' -%}margin-left: auto; margin-right: auto;{%- endif -%}
    {%- if _ca_m == 'right' -%}margin-left: auto;{%- endif -%}
  }
  #hp4-{{ sid }} .hp4-image-col {
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 900px) {
    #hp4-{{ sid }} .hp4-text {
      width: {{ s.text_column_width | default: 50 }}%;
      align-items: {{ _ai_d }};
      text-align: {{ _ta_d }};
    }
    #hp4-{{ sid }} .hp4-text > * {
      text-align: {{ _ta_d }};
    }
    #hp4-{{ sid }} .hp4-text > .hp4-btn,
    #hp4-{{ sid }} .hp4-text > .hp4-pill,
    #hp4-{{ sid }} .hp4-text > .hp4-spa,
    #hp4-{{ sid }} .hp4-text > .hp4-guarantee,
    #hp4-{{ sid }} .hp4-text > .hp4-bullet-checklist,
    #hp4-{{ sid }} .hp4-text > .hp4-bonus-offer,
    #hp4-{{ sid }} .hp4-text > .hp4-price-inline,
    #hp4-{{ sid }} .hp4-text > .hp4-scarcity-meter {
      align-self: {{ _ai_d }};
      {%- if _ca_d == 'center' -%}margin-left: auto; margin-right: auto;{%- elsif _ca_d == 'right' -%}margin-left: auto; margin-right: 0;{%- else -%}margin-left: 0; margin-right: auto;{%- endif -%}
    }
    #hp4-{{ sid }} .hp4-image-col {
      width: calc(100% - {{ s.text_column_width | default: 50 }}%);
    }
  }

  #hp4-{{ sid }} .hp4-image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: {{ s.image_radius | default: 16 }}px;
    background: var(--color-border, #f3f4f6);
  }
  #hp4-{{ sid }} .hp4-image-wrap img,
  #hp4-{{ sid }} .hp4-image-wrap .hp4-image-fallback {
    display: block;
    width: 100%;
    height: {{ s.image_height_mobile | default: 460 }}px;
    object-fit: {{ s.image_fit | default: 'cover' }};
  }
  @media (min-width: 900px) {
    #hp4-{{ sid }} .hp4-image-wrap img,
    #hp4-{{ sid }} .hp4-image-wrap .hp4-image-fallback {
      height: {{ s.image_height_desktop | default: 640 }}px;
    }
  }
  #hp4-{{ sid }} .hp4-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 14px;
    background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
  }
  #hp4-{{ sid }} .hp4-image-wrap picture { display: block; width: 100%; height: 100%; }
  /* mobile-only override image */
  @media (max-width: 899px) {
    #hp4-{{ sid }} .hp4-image-wrap .hp4-image-desktop { display: none; }
    #hp4-{{ sid }} .hp4-image-wrap .hp4-image-mobile { display: block; }
  }
  @media (min-width: 900px) {
    #hp4-{{ sid }} .hp4-image-wrap .hp4-image-desktop { display: block; }
    #hp4-{{ sid }} .hp4-image-wrap .hp4-image-mobile { display: none; }
  }

  /* Reveal */
  {%- if s.reveal -%}
    #hp4-{{ sid }} { opacity: 0; transform: translateY(12px); transition: opacity 600ms ease, transform 600ms ease; }
    #hp4-{{ sid }}.is-revealed { opacity: 1; transform: translateY(0); }
  {%- endif -%}

  /* Section dividers */
  {%- if s.show_top_divider -%}
    #hp4-{{ sid }}::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: {{ s.top_divider_thickness | default: 1 }}px;
      background: {% render 'scheme-color', color: s.top_divider_color, fallback: 'var(--color-border)' %};
    }
  {%- endif -%}
  {%- if s.show_bottom_divider -%}
    #hp4-{{ sid }}::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: {{ s.bottom_divider_thickness | default: 1 }}px;
      background: {% render 'scheme-color', color: s.bottom_divider_color, fallback: 'var(--color-border)' %};
    }
  {%- endif -%}

  /* Wave rotate: flip the bottom pattern divider vertically (upside down) so the
     shape bulges outward instead of dipping in.

     IMPORTANT: a CSS `transform` on the wrapper would turn the wrapper into the
     containing block for the divider's absolute positioning and break its
     flush-to-section anchoring (that was the earlier bug). So the wrapper uses
     `display: contents` — it vanishes from the box tree entirely, letting the
     divider behave exactly like the working non-rotated version. We then apply the
     flip transform to the divider element itself (the wrapper's direct child),
     which keeps its own full-width, flush positioning and just mirrors it. */
  {%- if s.divider_bottom_rotate -%}
    #hp4-{{ sid }} .hp4-divider-bottom-wrap {
      display: contents;
    }
    #hp4-{{ sid }} .hp4-divider-bottom-wrap > * {
      transform: scaleY(-1);
      transform-origin: center;
    }
  {%- endif -%}

  /* ============== Block-specific styles ============== */

  /* heading block */
  #hp4-{{ sid }} .hp4-heading {
    margin: 0;
    line-height: 1.1;
  }
  #hp4-{{ sid }} .hp4-heading .hp4-accent-word {
    font-style: italic;
    /* Breathing room so the (italic) accent word never visually collides with
       the next word in the heading. Em-based so it scales with font size. */
    padding-inline: 0.04em 0.12em;
    margin-inline: 0.02em;
  }

  /* subheading block */
  #hp4-{{ sid }} .hp4-subheading {
    margin: 0;
  }
  #hp4-{{ sid }} .hp4-subheading p { margin: 0; }

  /* primary / secondary buttons */
  #hp4-{{ sid }} .hp4-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none !important;
    cursor: pointer;
    border-style: solid;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 120ms ease;
    box-sizing: border-box;
    line-height: 1.2;
    -webkit-appearance: none;
    appearance: none;
  }
  #hp4-{{ sid }} .hp4-btn:hover { transform: translateY(-1px); }
  #hp4-{{ sid }} .hp4-btn-text {
    background: transparent !important;
    border: 0 !important;
    padding: 6px 0 !important;
  }

  /* guarantee badge */
  #hp4-{{ sid }} .hp4-guarantee {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  #hp4-{{ sid }} .hp4-guarantee svg { flex-shrink: 0; }

  /* pill badge */
  #hp4-{{ sid }} .hp4-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: auto;
    align-self: flex-start;
  }

  /* accent block */
  #hp4-{{ sid }} .hp4-accent { margin: 0; }

  /* social proof avatars block */
  #hp4-{{ sid }} .hp4-spa {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: auto;
    flex-wrap: wrap;
  }
  #hp4-{{ sid }} .hp4-spa-avatars { display: inline-flex; align-items: center; }
  #hp4-{{ sid }} .hp4-spa-avatars img {
    border-radius: 9999px;
    object-fit: cover;
    display: block;
  }
  #hp4-{{ sid }} .hp4-spa-stars {
    display: inline-flex;
    gap: 2px;
    margin-right: 6px;
  }
  #hp4-{{ sid }} .hp4-spa-message .hp4-spa-accent {
    font-weight: 700;
  }

  /* divider block */
  #hp4-{{ sid }} .hp4-divider {
    width: 100%;
    height: 0;
    border: 0;
  }

  /* Block wrapper - allows merchant to keep things stacked left-aligned */
  #hp4-{{ sid }} .hp4-block-wrap { width: 100%; }
{% comment %}{% endcomment %}</style>

<div id="hp4-{{ sid }}" class="hp4-section color-{{ color_scheme }} gradient{% if s.reveal %} hp4-reveal-target{% endif %}">
  {%- liquid
    case s.section_width
      when 'fluid_container'
        assign hp4_width_class = 'fluid_container'
      when 'stretch_width'
        assign hp4_width_class = 'stretch_width'
      when 'full_width'
        assign hp4_width_class = 'full_width'
      else
        assign hp4_width_class = 'container'
    endcase
  -%}
  <div class="{{ hp4_width_class }} hp4-grid">
    <div class="hp4-text">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}

          {%- when 'heading' -%}
            {%- assign heading_text = bs.heading_text | default: '' -%}
            {%- assign accent_word = bs.accent_word -%}
            {%- assign heading_processed = heading_text -%}
            {%- if accent_word != blank -%}
              {%- capture _open -%}<span class="hp4-accent-word" style="color:{% render 'scheme-color', color: bs.accent_color, fallback: 'var(--color-primary)' %};{% if bs.accent_style == 'normal' %}font-style:normal;{% endif %}">{%- endcapture -%}
              {%- capture _replacement -%}{{ _open }}{{ accent_word }}</span>{%- endcapture -%}
              {%- assign heading_processed = heading_processed | replace: accent_word, _replacement -%}
            {%- endif -%}
            {%- if bs.enable_custom_font and bs.custom_font_name != blank -%}
              <style>
                @import url('https://fonts.googleapis.com/css2?family={{ bs.custom_font_name | replace: ' ', '+' }}:wght@400;500;600;700;800&display=swap');
                #hp4-{{ sid }} #hp4-heading-{{ block.id }} {
                  font-family: '{{ bs.custom_font_name }}', var(--heading-font, inherit) !important;
                }
{% comment %}{% endcomment %}              </style>
            {%- endif -%}
            <style>
              #hp4-{{ sid }} #hp4-heading-{{ block.id }} {
                font-size: {{ bs.font_size_mobile | default: 32 }}px;
                line-height: {{ bs.line_height_mobile | default: 1.15 }};
                font-weight: {% if bs.font_weight == 'theme' or bs.font_weight == blank %}var(--heading-weight, 700){% else %}{{ bs.font_weight }}{% endif %};
                color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
                max-width: {{ bs.max_width | default: 640 }}px;
                margin: 0 0 {{ bs.margin_bottom | default: 16 }}px 0;
                {%- if bs.enable_gradient -%}
                  background: linear-gradient({{ bs.gradient_angle | default: 90 }}deg, {% render 'scheme-color', color: bs.gradient_start, fallback: 'var(--color-heading)' %}, {% render 'scheme-color', color: bs.gradient_middle, fallback: 'var(--color-text)' %}, {% render 'scheme-color', color: bs.gradient_end, fallback: 'var(--color-heading)' %});
                  -webkit-background-clip: text;
                  background-clip: text;
                  -webkit-text-fill-color: transparent;
                  color: transparent;
                {%- endif -%}
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-heading-{{ block.id }} {
                  font-size: {{ bs.font_size_desktop | default: 56 }}px;
                  line-height: {{ bs.line_height_desktop | default: 1.05 }};
                }
              }
{% comment %}{% endcomment %}            </style>
            <h1 id="hp4-heading-{{ block.id }}" class="hp4-heading" {{ block.shopify_attributes }}>{{ heading_processed }}</h1>

          {%- when 'subheading' -%}
            <style>
              #hp4-{{ sid }} #hp4-sub-{{ block.id }} {
                font-size: {{ bs.font_size_mobile | default: 15 }}px;
                line-height: {{ bs.line_height | default: 1.5 }};
                color: {% render 'scheme-color', color: bs.color, fallback: 'var(--hp-muted, var(--color-text))' %};
                font-weight: {% if bs.font_weight == 'theme' or bs.font_weight == blank %}var(--body-weight, 400){% else %}{{ bs.font_weight }}{% endif %};
                max-width: {{ bs.max_width | default: 560 }}px;
                margin: 0 0 {{ bs.margin_bottom | default: 16 }}px 0;
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-sub-{{ block.id }} {
                  font-size: {{ bs.font_size_desktop | default: 17 }}px;
                }
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-sub-{{ block.id }}" class="hp4-subheading rte" {{ block.shopify_attributes }}>{{ bs.text }}</div>

          {%- when 'primary_button' -%}
            <style>
              #hp4-{{ sid }} #hp4-pbtn-{{ block.id }} {
                background: {% render 'scheme-color', color: bs.bg_color, fallback: 'var(--btn-primary-bg-color)' %} !important;
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-primary-color)' %} !important;
                border-color: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, transparent)' %} !important;
                border-width: {% if bs.use_theme_button %}var(--btn-border-width, 0px){% else %}{{ bs.border_width | default: 0 }}px{% endif %} !important;
                border-radius: {% if bs.use_theme_button %}var(--btn-radius, 999px){% else %}{{ bs.border_radius | default: 999 }}px{% endif %} !important;
                padding: {% if bs.use_theme_button %}var(--btn-padding-y, 14px) var(--btn-padding-x, 22px){% else %}{{ bs.padding_y_mobile | default: 14 }}px {{ bs.padding_x_mobile | default: 22 }}px{% endif %} !important;
                font-weight: {% if bs.use_theme_button %}var(--btn-font-weight, 700){% else %}{{ bs.font_weight | default: '700' }}{% endif %} !important;
                font-size: {% if bs.use_theme_button %}var(--btn-font-size, 14px){% else %}{{ bs.font_size_mobile | default: 14 }}px{% endif %} !important;
                letter-spacing: {{ bs.letter_spacing | default: 0.5 }}px !important;
                text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %} !important;
                margin: {{ bs.margin_top | default: 8 }}px 0 {{ bs.margin_bottom | default: 16 }}px 0 !important;
                {%- if bs.full_width -%}
                  display: flex !important;
                  width: 100% !important;
                  max-width: 100% !important;
                  align-self: stretch !important;
                {%- else -%}
                  display: inline-flex !important;
                  width: auto !important;
                  max-width: max-content !important;
                  align-self: flex-start !important;
                {%- endif -%}
              }
              #hp4-{{ sid }} #hp4-pbtn-{{ block.id }}:hover {
                background: {% render 'scheme-color', color: bs.hover_bg, fallback: 'var(--btn-primary-hover-bg-color)' %};
                color: {% render 'scheme-color', color: bs.hover_text, fallback: 'var(--btn-primary-hover-color)' %};
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-pbtn-{{ block.id }} {
                  padding: {% if bs.use_theme_button %}var(--btn-padding-y, 16px) var(--btn-padding-x, 28px){% else %}{{ bs.padding_y_desktop | default: 16 }}px {{ bs.padding_x_desktop | default: 28 }}px{% endif %} !important;
                  font-size: {% if bs.use_theme_button %}var(--btn-font-size, 15px){% else %}{{ bs.font_size_desktop | default: 15 }}px{% endif %} !important;
                }
              }
{% comment %}{% endcomment %}            </style>
            <a id="hp4-pbtn-{{ block.id }}" class="hp4-btn hp4-btn-primary" href="{{ bs.link | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | default: fb_accessibility_shop_now_upper }}</a>

          {%- when 'secondary_button' -%}
            {%- assign _style = bs.style | default: 'outline' -%}
            <style>
              #hp4-{{ sid }} #hp4-sbtn-{{ block.id }} {
                {%- if _style == 'primary' -%}
                  background: {% render 'scheme-color', color: bs.bg_color, fallback: 'var(--btn-primary-bg-color)' %};
                  color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-primary-color)' %};
                  border-color: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, transparent)' %};
                  border-width: {% if bs.use_theme_button %}var(--btn-border-width, 0px){% else %}{{ bs.border_width | default: 0 }}px{% endif %};
                {%- elsif _style == 'outline' -%}
                  background: {% render 'scheme-color', color: bs.bg_color, fallback: 'transparent' %};
                  color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-secondary-color)' %};
                  border-color: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-secondary-border-color)' %};
                  border-width: {% if bs.use_theme_button %}var(--btn-border-width, 1px){% else %}{{ bs.border_width | default: 1 }}px{% endif %};
                {%- else -%}
                  background: transparent;
                  color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-link-color, var(--color-text))' %};
                  border: 0;
                  text-decoration: underline !important;
                {%- endif -%}
                border-radius: {% if bs.use_theme_button %}var(--btn-radius, 999px){% else %}{{ bs.border_radius | default: 999 }}px{% endif %} !important;
                padding: {% if _style == 'text' %}6px 0{% else %}{% if bs.use_theme_button %}var(--btn-padding-y, 14px) var(--btn-padding-x, 22px){% else %}{{ bs.padding_y_mobile | default: 14 }}px {{ bs.padding_x_mobile | default: 22 }}px{% endif %}{% endif %} !important;
                font-weight: {% if bs.use_theme_button %}var(--btn-font-weight, 600){% else %}{{ bs.font_weight | default: '600' }}{% endif %} !important;
                font-size: {% if bs.use_theme_button %}var(--btn-font-size, 14px){% else %}{{ bs.font_size_mobile | default: 14 }}px{% endif %} !important;
                letter-spacing: {{ bs.letter_spacing | default: 0.3 }}px !important;
                text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %} !important;
                margin: {{ bs.margin_top | default: 8 }}px 0 {{ bs.margin_bottom | default: 16 }}px 0 !important;
                {%- if bs.full_width -%}
                  display: flex !important;
                  width: 100% !important;
                  max-width: 100% !important;
                  align-self: stretch !important;
                {%- else -%}
                  display: inline-flex !important;
                  width: auto !important;
                  max-width: max-content !important;
                  align-self: flex-start !important;
                {%- endif -%}
              }
              #hp4-{{ sid }} #hp4-sbtn-{{ block.id }}:hover {
                background: {% render 'scheme-color', color: bs.hover_bg, fallback: 'var(--btn-secondary-hover-bg-color)' %};
                color: {% render 'scheme-color', color: bs.hover_text, fallback: 'var(--btn-secondary-hover-color)' %};
                {%- if _style == 'outline' -%}border-color: {% render 'scheme-color', color: bs.hover_bg, fallback: 'var(--btn-secondary-hover-bg-color)' %};{%- endif -%}
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-sbtn-{{ block.id }} {
                  padding: {% if _style == 'text' %}6px 0{% else %}{% if bs.use_theme_button %}var(--btn-padding-y, 16px) var(--btn-padding-x, 28px){% else %}{{ bs.padding_y_desktop | default: 16 }}px {{ bs.padding_x_desktop | default: 28 }}px{% endif %}{% endif %} !important;
                  font-size: {% if bs.use_theme_button %}var(--btn-font-size, 15px){% else %}{{ bs.font_size_desktop | default: 15 }}px{% endif %} !important;
                }
              }
{% comment %}{% endcomment %}            </style>
            <a id="hp4-sbtn-{{ block.id }}" class="hp4-btn hp4-btn-secondary{% if _style == 'text' %} hp4-btn-text{% endif %}" href="{{ bs.link | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | default: fb_accessibility_learn_more }}</a>

          {%- when 'guarantee_badge' -%}
            <style>
              #hp4-{{ sid }} #hp4-grnt-{{ block.id }} {
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--hp-muted, var(--color-text))' %};
                font-size: {{ bs.font_size | default: 14 }}px;
                font-weight: {{ bs.font_weight | default: '500' }};
                margin-top: {{ bs.margin_top | default: 0 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 0 }}px;
                justify-content: {{ bs.alignment | default: 'flex-start' }};
              }
              #hp4-{{ sid }} #hp4-grnt-{{ block.id }} svg {
                width: {{ bs.icon_size | default: 18 }}px;
                height: {{ bs.icon_size | default: 18 }}px;
                stroke: {% render 'scheme-color', color: bs.icon_color, fallback: 'var(--hp-muted, var(--color-text))' %};
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-grnt-{{ block.id }}" class="hp4-guarantee" {{ block.shopify_attributes }}>
              {%- case bs.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'shield_check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                {%- when 'lock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- endcase -%}
              <span>{{ bs.text | default: '30-Day Money-Back Guarantee' }}</span>
            </div>

          {%- when 'pill_badge' -%}
            {%- liquid
              comment
                Style presets — pick a curated look, or "custom" to use the
                manual color/border/gradient settings further down. Presets
                set bg/text/border/gradient/letter-spacing only; everything
                else (font size, padding, margins, uppercase) still comes
                from the per-block settings.
              endcomment
              assign p = bs.style_preset | default: 'custom'

              capture p_bg
                render 'scheme-color', color: bs.bg_color, fallback: 'var(--btn-primary-bg-color)'
              endcapture
              capture p_color
                render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-primary-color)'
              endcapture
              assign p_border_w = bs.border_width | default: 0
              assign p_border_c = bs.border_color | default: 'transparent'
              assign p_gradient = false
              assign p_grad_a = bs.gradient_angle | default: 90
              capture p_grad_s
                render 'scheme-color', color: bs.gradient_start, fallback: 'var(--color-heading)'
              endcapture
              assign p_grad_m = bs.gradient_middle
              capture p_grad_e
                render 'scheme-color', color: bs.gradient_end, fallback: 'var(--color-text)'
              endcapture
              if bs.enable_gradient
                assign p_gradient = true
              endif

              case p
                when 'solid_dark'
                  assign p_bg = '#0F172A'
                  assign p_color = '#FFFFFF'
                  assign p_border_w = 0
                  assign p_gradient = false
                when 'solid_light'
                  assign p_bg = '#F1F5F9'
                  assign p_color = '#0F172A'
                  assign p_border_w = 0
                  assign p_gradient = false
                when 'outline'
                  assign p_bg = 'transparent'
                  assign p_color = '#0F172A'
                  assign p_border_w = 1
                  assign p_border_c = '#0F172A'
                  assign p_gradient = false
                when 'soft_pastel'
                  assign p_bg = '#FEF3C7'
                  assign p_color = '#92400E'
                  assign p_border_w = 0
                  assign p_gradient = false
                when 'gradient_sunrise'
                  assign p_gradient = true
                  assign p_grad_a = 90
                  assign p_grad_s = '#F97316'
                  assign p_grad_m = '#EC4899'
                  assign p_grad_e = '#8B5CF6'
                  assign p_color = '#FFFFFF'
                  assign p_border_w = 0
                when 'vivid_accent'
                  assign p_bg = '#F97316'
                  assign p_color = '#FFFFFF'
                  assign p_border_w = 0
                  assign p_gradient = false
                when 'glass'
                  assign p_bg = 'rgba(255,255,255,0.15)'
                  assign p_color = '#FFFFFF'
                  assign p_border_w = 1
                  assign p_border_c = 'rgba(255,255,255,0.35)'
                  assign p_gradient = false
              endcase
            -%}
            <style>
              #hp4-{{ sid }} #hp4-pill-{{ block.id }} {
                {%- if p_gradient -%}
                  background: linear-gradient({{ p_grad_a }}deg, {{ p_grad_s }}{% if p_grad_m != blank %}, {{ p_grad_m }}{% endif %}, {{ p_grad_e }});
                {%- else -%}
                  background: {{ p_bg }};
                {%- endif -%}
                color: {{ p_color }};
                border: {{ p_border_w }}px solid {{ p_border_c }};
                border-radius: {{ bs.border_radius | default: 999 }}px;
                font-size: {{ bs.font_size | default: 12 }}px;
                font-weight: {{ bs.font_weight | default: '700' }};
                padding: {{ bs.padding_y | default: 8 }}px {{ bs.padding_x | default: 14 }}px;
                margin: {{ bs.margin_top | default: 0 }}px 0 {{ bs.margin_bottom | default: 16 }}px 0;
                letter-spacing: {{ bs.letter_spacing | default: 0.5 }}px;
                text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
                {% if p == 'glass' %}backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);{% endif %}
              }
{% comment %}{% endcomment %}            </style>
            <span id="hp4-pill-{{ block.id }}" class="hp4-pill" {{ block.shopify_attributes }}>
              {%- if bs.icon != blank -%}<span aria-hidden="true">{{ bs.icon }}</span>{%- endif -%}
              <span>{{ bs.text | default: fb_accessibility_new_badge }}</span>
            </span>

          {%- when 'accent_block' -%}
            <style>
              #hp4-{{ sid }} #hp4-acc-{{ block.id }} {
                color: {% render 'scheme-color', color: bs.color, fallback: 'var(--hp-muted, var(--color-text))' %};
                font-size: {{ bs.font_size | default: 14 }}px;
                font-weight: {{ bs.font_weight | default: '500' }};
                margin-top: {{ bs.margin_top | default: 0 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 8 }}px;
                text-align: {{ bs.alignment | default: 'left' }};
              }
{% comment %}{% endcomment %}            </style>
            <p id="hp4-acc-{{ block.id }}" class="hp4-accent" {{ block.shopify_attributes }}>{{ bs.text | default: '1,250+ customers trust us' }}</p>

          {%- when 'social_proof_avatars' -%}
            {%- assign spa_message = bs.referral_text | default: 'Trusted by 1,250+ customers' -%}
            {%- if bs.referral_accent_text != blank -%}
              {%- capture _spa_open -%}<span class="hp4-spa-accent" style="color:{% render 'scheme-color', color: bs.referral_accent_color, fallback: 'var(--color-primary)' %};">{%- endcapture -%}
              {%- capture _spa_html -%}{{ _spa_open }}{{ bs.referral_accent_text }}</span>{%- endcapture -%}
              {%- assign spa_message = spa_message | replace: bs.referral_accent_text, _spa_html -%}
            {%- endif -%}
            <style>
              #hp4-{{ sid }} #hp4-spa-{{ block.id }} {
                gap: {{ bs.referral_inline_gap_mobile | default: 8 }}px;
                margin-top: {{ bs.margin_top | default: 0 }}px;
                margin-bottom: {{ bs.referral_to_title_gap_mobile | default: 12 }}px;
              }
              #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-avatars img {
                width: {{ bs.ref_avatar_size_mobile | default: 32 }}px;
                height: {{ bs.ref_avatar_size_mobile | default: 32 }}px;
                border: {{ bs.ref_avatar_border_thickness | default: 2 }}px solid {% render 'scheme-color', color: bs.ref_avatar_border_color, fallback: 'var(--color-background)' %};
              }
              #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-avatars img + img {
                margin-left: -{{ bs.ref_avatar_overlap_mobile | default: 8 }}px;
              }
              #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-message {
                color: {% render 'scheme-color', color: bs.referral_text_color, fallback: 'var(--color-text)' %};
                font-size: {{ bs.font_size_mobile | default: 14 }}px;
                line-height: 1.4;
              }
              #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-stars svg {
                width: {{ bs.star_size_mobile | default: 16 }}px;
                height: {{ bs.star_size_mobile | default: 16 }}px;
                fill: {% render 'scheme-color', color: bs.star_color, fallback: 'var(--color-primary)' %};
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-spa-{{ block.id }} {
                  gap: {{ bs.referral_inline_gap_desktop | default: 12 }}px;
                  margin-bottom: {{ bs.referral_to_title_gap_desktop | default: 20 }}px;
                }
                #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-avatars img {
                  width: {{ bs.ref_avatar_size_desktop | default: 36 }}px;
                  height: {{ bs.ref_avatar_size_desktop | default: 36 }}px;
                }
                #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-avatars img + img {
                  margin-left: -{{ bs.ref_avatar_overlap_desktop | default: 10 }}px;
                }
                #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-message {
                  font-size: {{ bs.font_size_desktop | default: 15 }}px;
                }
                #hp4-{{ sid }} #hp4-spa-{{ block.id }} .hp4-spa-stars svg {
                  width: {{ bs.star_size_desktop | default: 18 }}px;
                  height: {{ bs.star_size_desktop | default: 18 }}px;
                }
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-spa-{{ block.id }}" class="hp4-spa" {{ block.shopify_attributes }}>
              <div class="hp4-spa-avatars">
                {%- if bs.ref_avatar_1 != blank -%}<img loading="lazy" src="{{ bs.ref_avatar_1 | img_url: '120x120' }}" alt="">{%- endif -%}
                {%- if bs.ref_avatar_2 != blank -%}<img loading="lazy" src="{{ bs.ref_avatar_2 | img_url: '120x120' }}" alt="">{%- endif -%}
                {%- if bs.ref_avatar_3 != blank -%}<img loading="lazy" src="{{ bs.ref_avatar_3 | img_url: '120x120' }}" alt="">{%- endif -%}
                {%- if bs.ref_avatar_4 != blank -%}<img loading="lazy" src="{{ bs.ref_avatar_4 | img_url: '120x120' }}" alt="">{%- endif -%}
                {%- if bs.ref_avatar_5 != blank -%}<img loading="lazy" src="{{ bs.ref_avatar_5 | img_url: '120x120' }}" alt="">{%- endif -%}
              </div>
              {%- if bs.show_stars -%}
                <span class="hp4-spa-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.7l2.1 4.25 4.7.68-3.4 3.31.8 4.64L12 14.96 7.8 16.58l.8-4.64L5.2 8.63l4.7-.68L12 3.7z"/></svg>
                  {%- endfor -%}
                </span>
              {%- endif -%}
              <span class="hp4-spa-message">{{ spa_message }}</span>
            </div>

          {%- when 'divider' -%}
            <style>
              #hp4-{{ sid }} #hp4-div-{{ block.id }} {
                border-top: {{ bs.thickness | default: 1 }}px solid {% render 'scheme-color', color: bs.color, fallback: 'var(--color-border)' %};
                margin-top: {{ bs.margin_top | default: 16 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 16 }}px;
              }
{% comment %}{% endcomment %}            </style>
            <hr id="hp4-div-{{ block.id }}" class="hp4-divider" {{ block.shopify_attributes }}>

          {%- when 'happy_customers' -%}
            {%- render 'happy-customers', block: block -%}

          {%- when 'simple_rating' -%}
            {%- render 'simple-rating', block: block -%}

          {%- when 'low_stock_badge' -%}
            {%- render 'low-stock-badge', block: block -%}

          {%- when 'benefits_pills' -%}
            <style>
              /* Hide the heading from benefits-pills snippet for hero use. */
              #shopify-section-{{ sid }} [data-block-id="{{ block.id }}"] .benefits-pills__heading,
              #shopify-section-{{ sid }} [data-block-id="{{ block.id }}"] .benefits-pills-heading,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} .benefits-pills__heading,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} .benefits-pills-heading,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} > h2,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} > h3,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} > .heading,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} > .pill-heading,
              #shopify-section-{{ sid }} #BenefitsPills-{{ block.id }} > [class*="heading"]:first-child {
                display: none !important;
              }
{% comment %}{% endcomment %}            </style>
            {%- render 'benefits-pills', block: block -%}

          {%- when 'benefits_tab' -%}
            {%- render 'benefits-tab', block: block -%}

          {%- when 'benefits_stack_badge' -%}
            {%- render 'benefits-stack', block: block -%}

          {%- when 'rating_badge' -%}
            {%- assign bs = block.settings -%}
            {%- assign rating_times = bs.rating | times: 10 -%}
            {%- assign rating_round = rating_times | round -%}
            {%- assign rating_norm  = rating_round | divided_by: 10.0 -%}
            {%- assign full_stars   = rating_norm | floor -%}
            {%- assign frac         = rating_norm | minus: full_stars -%}
            {%- assign show_half    = 0 -%}{% if frac >= 0.5 %}{% assign show_half = 1 %}{% endif %}
            {%- assign next_index   = full_stars | plus: 1 -%}
            <style>
              #LodRatingBadge-{{ block.id }}{
                margin-top: {{ bs.section_mt_d }}px !important;
                margin-bottom: {{ bs.section_mb_d }}px !important;
                padding-left: {{ bs.section_pl_d }}px !important;
                padding-right: {{ bs.section_pr_d }}px !important;
                background: transparent !important;
                width: 100% !important;
                --lod-tile: {{ bs.star_tile_size_d }}px;
                --lod-glyph: {{ bs.star_icon_scale_d }}%;
                --lod-radius: {{ bs.star_radius }}px;
                --lod-tile-color: {% render 'scheme-color', color: bs.stars_color, fallback: 'var(--color-primary)' %} !important;
                --lod-icon-color: {% render 'scheme-color', color: bs.star_icon_color, fallback: 'var(--color-background)' %} !important;
              }
              #LodRatingBadge-{{ block.id }} .lod-rating__wrap{
                display:inline-flex !important; align-items:center !important; gap:16px !important;
                text-decoration:none !important;
                cursor:{% if bs.enable_link and bs.link_url != blank %}pointer{% else %}default{% endif %} !important;
              }
              #LodRatingBadge-{{ block.id }} .lod-stars{ display:inline-flex !important; align-items:center !important; gap:6px !important; }
              #LodRatingBadge-{{ block.id }} .lod-star{
                position:relative !important;
                width:var(--lod-tile) !important; height:var(--lod-tile) !important;
                border-radius:var(--lod-radius) !important;
                overflow:hidden !important; flex:0 0 auto !important;
              }
              #LodRatingBadge-{{ block.id }} .lod-star__tile{ position:absolute !important; inset:0 !important; background: var(--lod-tile-color) !important; }
              #LodRatingBadge-{{ block.id }} .lod-star__icon{ position:absolute !important; inset:0 !important; display:grid !important; place-items:center !important; }
              #LodRatingBadge-{{ block.id }} .lod-star__icon svg{ width: var(--lod-glyph) !important; height: var(--lod-glyph) !important; display:block !important; fill: var(--lod-icon-color) !important; stroke: none !important; }
              #LodRatingBadge-{{ block.id }} .lod-star--half::after{ content:"" !important; position:absolute !important; top:0 !important; right:0 !important; bottom:0 !important; width:50% !important; background: var(--color-border, #E6E6E6) !important; }
              #LodRatingBadge-{{ block.id }} .lod-star--empty .lod-star__tile{ background: var(--color-border, #E6E6E6) !important; }
              #LodRatingBadge-{{ block.id }} .lod-rating__text{ margin:0 !important; color:{% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-heading)' %} !important; font-family:inherit !important; font-weight:{{ bs.font_weight }} !important; font-size:{{ bs.text_size }}px !important; line-height:1 !important; }
              @media (max-width:749px){
                #LodRatingBadge-{{ block.id }}{
                  margin-top: {{ bs.section_mt_m }}px !important;
                  margin-bottom: {{ bs.section_mb_m }}px !important;
                  padding-left: {{ bs.section_pl_m }}px !important;
                  padding-right: {{ bs.section_pr_m }}px !important;
                  --lod-tile: {{ bs.star_tile_size_m }}px;
                  --lod-glyph: {{ bs.star_icon_scale_m }}%;
                }
                #LodRatingBadge-{{ block.id }} .lod-rating__text{ font-size: {{ bs.text_size | minus: 2 | at_least: 10 }}px !important; }
              }
{% comment %}{% endcomment %}            </style>
            {%- capture _badge -%}
              <div class="lod-rating__wrap" {% if bs.enable_link and bs.link_url != blank %}data-lod-link="{{ bs.link_url | escape }}"{% endif %}>
                <div class="lod-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- assign star_class = '' -%}
                    {%- if i <= full_stars -%}
                      {%- assign star_class = '' -%}
                    {%- elsif i == next_index and show_half == 1 -%}
                      {%- assign star_class = 'lod-star--half' -%}
                    {%- else -%}
                      {%- assign star_class = 'lod-star--empty' -%}
                    {%- endif -%}
                    <span class="lod-star {{ star_class }}">
                      <span class="lod-star__tile"></span>
                      <span class="lod-star__icon">
                        <svg viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                          <path d="M12 3.7l2.1 4.25 4.7.68-3.4 3.31.8 4.64L12 14.96 7.8 16.58l.8-4.64L5.2 8.63l4.7-.68L12 3.7z"/>
                        </svg>
                      </span>
                    </span>
                  {%- endfor -%}
                </div>
                <p class="lod-rating__text">{{ bs.label_text }}</p>
              </div>
            {%- endcapture -%}
            <div id="LodRatingBadge-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if bs.enable_link and bs.link_url != blank -%}
                <a href="{{ bs.link_url }}" style="text-decoration:none!important;color:inherit!important;display:inline-block!important;">{{ _badge }}</a>
              {%- else -%}
                {{ _badge }}
              {%- endif -%}
            </div>
            <script>
            (function(){
              var root=document.getElementById('LodRatingBadge-{{ block.id }}'); if(!root) return;
              var wrap=root.querySelector('.lod-rating__wrap'); if(!wrap) return;
              var href=wrap.getAttribute('data-lod-link');
              if(href){ wrap.addEventListener('click', function(){ window.location.href = href; }); }
            })();
{% comment %}{% endcomment %}            </script>

          {%- when 'countdown_badge' -%}
            {%- assign bs = block.settings -%}
            <div id="CountdownBadge-{{ block.id }}"
                 class="cd-badge"
                 {{ block.shopify_attributes }}
                 role="region"
                 aria-label="{{ 'accessibility.countdown_badge' | t }}"
                 style="
                   --cd-bg: {% render 'scheme-color', color: bs.bg_color, fallback: 'var(--color-background)' %};
                   --cd-border: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--color-border)' %};
                   --cd-radius: {{ bs.radius | default: 10 }}px;
                   --cd-heading-color: {% render 'scheme-color', color: bs.heading_color, fallback: 'var(--color-heading)' %} !important;
                   --cd-heading-size-d: {{ bs.heading_size_d | default: 18 }}px;
                   --cd-heading-size-m: {{ bs.heading_size_m | default: 16 }}px;
                   --cd-heading-weight: {{ bs.heading_weight | default: '700' }};
                   --cd-number-color: {% render 'scheme-color', color: bs.number_color, fallback: 'var(--color-primary)' %} !important;
                   --cd-number-size-d: {{ bs.number_size_d | default: 18 }}px;
                   --cd-number-size-m: {{ bs.number_size_m | default: 16 }}px;
                   --cd-number-weight: {{ bs.number_weight | default: '700' }};
                   --cd-label-color: {% render 'scheme-color', color: bs.label_color, fallback: 'var(--color-text)' %} !important;
                   --cd-label-weight: {{ bs.label_weight | default: '500' }};
                   --cd-gap: {{ bs.item_gap | default: 6 }}px;
                   --cd-pl-d: {{ bs.pad_left_d | default: 16 }}px;
                   --cd-pr-d: {{ bs.pad_right_d | default: 16 }}px;
                   --cd-pl-m: {{ bs.pad_left_m | default: 12 }}px;
                   --cd-pr-m: {{ bs.pad_right_m | default: 12 }}px;
                   --cd-mt-d: {{ bs.section_pt_d | default: 0 }}px;
                   --cd-mb-d: {{ bs.section_pb_d | default: 0 }}px;
                   --cd-mt-m: {{ bs.section_pt_m | default: 0 }}px;
                   --cd-mb-m: {{ bs.section_pb_m | default: 0 }}px;
                   --cd-width-d: {{ bs.timer_width_d_px | default: 520 }}px;
                   --cd-width-m: {{ bs.timer_width_m_px | default: 320 }}px;
                 ">
              <div class="cd-card" aria-live="polite">
                <div class="cd-heading">{{ bs.heading_text }}</div>
                <div class="cd-row">
                  <div class="cd-item"><span class="cd-num" data-cd="days">00</span><span class="cd-label">{{ bs.days_label }}</span></div>
                  <span class="cd-sep">:</span>
                  <div class="cd-item"><span class="cd-num" data-cd="hours">00</span><span class="cd-label">{{ bs.hours_label }}</span></div>
                  <span class="cd-sep">:</span>
                  <div class="cd-item"><span class="cd-num" data-cd="mins">00</span><span class="cd-label">{{ bs.mins_label }}</span></div>
                  <span class="cd-sep">:</span>
                  <div class="cd-item"><span class="cd-num" data-cd="secs">00</span><span class="cd-label">{{ bs.secs_label }}</span></div>
                </div>
                <div class="cd-ended" hidden>{{ bs.ended_text }}</div>
              </div>
            </div>
            <style>
              #CountdownBadge-{{ block.id }}{ margin-top: var(--cd-mt-d); margin-bottom: var(--cd-mb-d); }
              @media (max-width:768px){ #CountdownBadge-{{ block.id }}{ margin-top: var(--cd-mt-m); margin-bottom: var(--cd-mb-m); } }
              #CountdownBadge-{{ block.id }} .cd-card{
                background: var(--cd-bg);
                border: 1px solid var(--cd-border);
                border-radius: var(--cd-radius);
                padding: 12px var(--cd-pr-d) 12px var(--cd-pl-d);
                width: var(--cd-width-d);
                max-width: 100%;
                box-sizing: border-box;
              }
              @media (max-width:768px){
                #CountdownBadge-{{ block.id }} .cd-card{
                  padding-left: var(--cd-pl-m);
                  padding-right: var(--cd-pr-m);
                  width: var(--cd-width-m);
                }
              }
              #CountdownBadge-{{ block.id }} .cd-heading{ margin: 0 0 6px 0; color: var(--cd-heading-color); font-size: var(--cd-heading-size-d); font-weight: var(--cd-heading-weight); line-height: 1.25; }
              @media (max-width:768px){ #CountdownBadge-{{ block.id }} .cd-heading{ font-size: var(--cd-heading-size-m); } }
              #CountdownBadge-{{ block.id }} .cd-row{ display: inline-flex; align-items: baseline; gap: var(--cd-gap); flex-wrap: wrap; }
              #CountdownBadge-{{ block.id }} .cd-item{ display: inline-flex; align-items: baseline; gap: 6px; }
              #CountdownBadge-{{ block.id }} .cd-num{ color: var(--cd-number-color); font-size: var(--cd-number-size-d); font-weight: var(--cd-number-weight); line-height: 1; }
              @media (max-width:768px){ #CountdownBadge-{{ block.id }} .cd-num{ font-size: var(--cd-number-size-m); } }
              #CountdownBadge-{{ block.id }} .cd-label{ color: var(--cd-label-color); font-weight: var(--cd-label-weight); line-height: 1.1; }
              #CountdownBadge-{{ block.id }} .cd-sep{ color: var(--cd-number-color); font-weight: var(--cd-number-weight); line-height: 1; }
              #CountdownBadge-{{ block.id }} .cd-ended{ margin-top: 6px; color: var(--cd-number-color); font-weight: var(--cd-number-weight); }
{% comment %}{% endcomment %}            </style>
            <script>
            (function(){
              var KEY = '__cdBadge_{{ block.id }}';
              function init(){
              var root = document.getElementById('CountdownBadge-{{ block.id }}');
              if(!root || root.__cdInit) return;
              root.__cdInit = true;
              if (window[KEY] && window[KEY].stop) window[KEY].stop();
              var endedEl = root.querySelector('.cd-ended');
              var onEnd  = {{ bs.on_end | json }};
              var endISO = {{ bs.end_iso | json }};
              function toMs(d,h,m,s){ return (((+d||0)*24 + (+h||0))*60 + (+m||0))*60*1000 + (+s||0)*1000; }
              var restartMs = toMs({{ bs.restart_days | default: 1 }}, {{ bs.restart_hours | default: 0 }}, {{ bs.restart_minutes | default: 0 }}, {{ bs.restart_seconds | default: 0 }}) || (24*60*60*1000);
              function parseISO(iso){ if(!iso) return null; var d = new Date(iso); return isNaN(d) ? null : d; }
              function now(){ return Date.now(); }
              function parts(ms){
                if(ms < 0) ms = 0;
                var s = Math.floor(ms/1000);
                return {days: Math.floor(s / 86400), hrs: Math.floor((s % 86400) / 3600), mins: Math.floor((s % 3600) / 60), secs: (s % 60)};
              }
              var pad2 = function(n){ return String(n).padStart(2,'0'); };
              var els = { days: root.querySelector('[data-cd="days"]'), hours: root.querySelector('[data-cd="hours"]'), mins: root.querySelector('[data-cd="mins"]'), secs: root.querySelector('[data-cd="secs"]') };
              function writeZeros(){ if(els.days) els.days.textContent='00'; if(els.hours) els.hours.textContent='00'; if(els.mins) els.mins.textContent='00'; if(els.secs) els.secs.textContent='00'; }
              function showEnded(show){ if(!endedEl) return; endedEl.hidden = !show; }
              function initEnd(){ var abs = parseISO(endISO); if (abs) return abs.getTime(); return now() + (24*60*60*1000); }
              var endTs = initEnd();
              function tick(){
                var diff = endTs - now();
                if(diff <= 0){
                  if(onEnd === 'restart'){ endTs = now() + restartMs; showEnded(false); }
                  else if(onEnd === 'ended'){ writeZeros(); showEnded(true); return; }
                  else { writeZeros(); showEnded(false); return; }
                }
                var p = parts(diff);
                if(els.days) els.days.textContent = String(p.days);
                if(els.hours) els.hours.textContent = pad2(p.hrs);
                if(els.mins) els.mins.textContent = pad2(p.mins);
                if(els.secs) els.secs.textContent = pad2(p.secs);
                showEnded(false);
              }
              var timer = null, io = null, visible = true;
              function stop(){ if(timer){ clearInterval(timer); timer = null; } }
              function start(){ stop(); if(visible && !document.hidden){ timer = setInterval(function(){ if(!root.isConnected){ cleanup(); return; } tick(); }, 1000); } }
              function onVis(){ if(document.hidden){ stop(); } else { tick(); start(); } }
              function cleanup(){ stop(); if(io){ io.disconnect(); io = null; } document.removeEventListener('visibilitychange', onVis); }
              tick();
              if('IntersectionObserver' in window){
                io = new IntersectionObserver(function(entries){ visible = entries[0].isIntersecting; if(visible){ tick(); start(); } else { stop(); } });
                io.observe(root);
              }
              document.addEventListener('visibilitychange', onVis);
              start();
              window[KEY] = { stop: cleanup };
              }
              init();
              if(!window[KEY + '_bound']){
                window[KEY + '_bound'] = true;
                document.addEventListener('storelib:section-load', function(e){
                  if(e.detail && String(e.detail.sectionId) === '{{ section.id }}') init();
                });
              }
            })();
{% comment %}{% endcomment %}            </script>

          {%- when 'rich_text' -%}
            <style>
              #hp4-{{ sid }} #hp4-rt-{{ block.id }} {
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--hp-muted, var(--color-text))' %};
                font-size: {{ bs.font_size_mobile | default: 15 }}px;
                line-height: {{ bs.line_height_x10 | default: 16 | divided_by: 10.0 }};
                font-weight: {{ bs.font_weight | default: '400' }};
                margin-top: {{ bs.margin_top | default: 0 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 16 }}px;
                max-width: {{ bs.max_width | default: 540 }}px;
              }
              #hp4-{{ sid }} #hp4-rt-{{ block.id }} a {
                color: {% render 'scheme-color', color: bs.link_color, fallback: 'var(--color-heading)' %};
                text-decoration: underline;
                text-underline-offset: 3px;
              }
              #hp4-{{ sid }} #hp4-rt-{{ block.id }} p { margin: 0 0 0.6em; }
              #hp4-{{ sid }} #hp4-rt-{{ block.id }} p:last-child { margin: 0; }
              #hp4-{{ sid }} #hp4-rt-{{ block.id }} strong { font-weight: 700; color: {% render 'scheme-color', color: bs.strong_color, fallback: 'var(--color-heading)' %}; }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-rt-{{ block.id }} { font-size: {{ bs.font_size_desktop | default: 17 }}px; }
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-rt-{{ block.id }}" class="hp4-rich-text rte" {{ block.shopify_attributes }}>{{ bs.text }}</div>

          {%- when 'price_inline' -%}
            {%- assign _has_compare = false -%}
            {%- if bs.compare_price != blank -%}{%- assign _has_compare = true -%}{%- endif -%}
            <style>
              #hp4-{{ sid }} #hp4-pi-{{ block.id }} {
                display: inline-flex;
                flex-wrap: wrap;
                align-items: baseline;
                gap: {{ bs.gap | default: 10 }}px;
                margin-top: {{ bs.margin_top | default: 0 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 14 }}px;
              }
              #hp4-{{ sid }} #hp4-pi-{{ block.id }} .hp4-pi-current {
                color: {% render 'scheme-color', color: bs.price_color, fallback: 'var(--color-primary)' %};
                font-size: {{ bs.price_size_mobile | default: 28 }}px;
                font-weight: {{ bs.price_weight | default: '800' }};
                letter-spacing: -0.01em;
                line-height: 1;
              }
              #hp4-{{ sid }} #hp4-pi-{{ block.id }} .hp4-pi-compare {
                color: {% render 'scheme-color', color: bs.compare_color, fallback: 'color-mix(in srgb, var(--color-text) 60%, transparent)' %};
                font-size: {{ bs.compare_size_mobile | default: 18 }}px;
                font-weight: 500;
                text-decoration: line-through;
                line-height: 1;
              }
              #hp4-{{ sid }} #hp4-pi-{{ block.id }} .hp4-pi-save {
                background: {% render 'scheme-color', color: bs.save_bg, fallback: 'var(--btn-primary-bg-color)' %};
                color: {% render 'scheme-color', color: bs.save_color, fallback: 'var(--btn-primary-color)' %};
                font-size: {{ bs.save_size | default: 12 }}px;
                font-weight: 700;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                padding: 4px 8px;
                border-radius: {{ bs.save_radius | default: 6 }}px;
                line-height: 1;
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-pi-{{ block.id }} .hp4-pi-current { font-size: {{ bs.price_size_desktop | default: 36 }}px; }
                #hp4-{{ sid }} #hp4-pi-{{ block.id }} .hp4-pi-compare { font-size: {{ bs.compare_size_desktop | default: 22 }}px; }
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-pi-{{ block.id }}" class="hp4-price-inline" {{ block.shopify_attributes }}>
              {%- if bs.current_price != blank -%}<span class="hp4-pi-current">{{ bs.current_price }}</span>{%- endif -%}
              {%- if _has_compare -%}<span class="hp4-pi-compare">{{ bs.compare_price }}</span>{%- endif -%}
              {%- if bs.save_text != blank -%}<span class="hp4-pi-save">{{ bs.save_text }}</span>{%- endif -%}
            </div>

          {%- when 'scarcity_meter' -%}
            {%- assign _pct = bs.percent_sold | default: 75 -%}
            {%- if _pct > 100 -%}{%- assign _pct = 100 -%}{%- endif -%}
            {%- if _pct < 0 -%}{%- assign _pct = 0 -%}{%- endif -%}
            <style>
              #hp4-{{ sid }} #hp4-sm-{{ block.id }} {
                width: 100%;
                max-width: {{ bs.max_width | default: 420 }}px;
                margin-top: {{ bs.margin_top | default: 6 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 14 }}px;
              }
              #hp4-{{ sid }} #hp4-sm-{{ block.id }} .hp4-sm-text {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--hp-muted, var(--color-text))' %};
                font-size: {{ bs.font_size | default: 13 }}px;
                font-weight: 600;
                letter-spacing: 0.3px;
                margin-bottom: 8px;
              }
              #hp4-{{ sid }} #hp4-sm-{{ block.id }} .hp4-sm-text strong {
                color: {% render 'scheme-color', color: bs.accent_color, fallback: 'var(--color-primary)' %};
                font-weight: 800;
              }
              #hp4-{{ sid }} #hp4-sm-{{ block.id }} .hp4-sm-track {
                position: relative;
                height: {{ bs.bar_height | default: 8 }}px;
                background: {% render 'scheme-color', color: bs.bar_bg, fallback: 'var(--color-border)' %};
                border-radius: 999px;
                overflow: hidden;
              }
              #hp4-{{ sid }} #hp4-sm-{{ block.id }} .hp4-sm-fill {
                position: absolute;
                inset: 0 auto 0 0;
                width: {{ _pct }}%;
                background: {% render 'scheme-color', color: bs.fill_color, fallback: 'var(--color-primary)' %};
                border-radius: 999px;
                {%- if bs.animate -%}
                  animation: hp3SmFill 1200ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
                {%- endif -%}
              }
              @keyframes hp3SmFill { from { width: 0%; } to { width: {{ _pct }}%; } }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-sm-{{ block.id }}" class="hp4-scarcity-meter" {{ block.shopify_attributes }}>
              <div class="hp4-sm-text">
                <span>{{ bs.left_label | default: fb_accessibility_selling_fast }}</span>
                <span>{%- if bs.right_label contains '[pct]' -%}{{ bs.right_label | replace: '[pct]', _pct }}{%- else -%}<strong>{{ _pct }}%</strong>&nbsp;{{ bs.right_label | default: 'sold' }}{%- endif -%}</span>
              </div>
              <div class="hp4-sm-track"><div class="hp4-sm-fill"></div></div>
            </div>

          {%- when 'bullet_checklist' -%}
            <style>
              #hp4-{{ sid }} #hp4-bcl-{{ block.id }} {
                list-style: none;
                margin: {{ bs.margin_top | default: 0 }}px 0 {{ bs.margin_bottom | default: 16 }}px;
                padding: 0;
                display: grid;
                grid-template-columns: repeat({{ bs.columns_mobile | default: 1 }}, minmax(0, 1fr));
                gap: {{ bs.row_gap | default: 10 }}px {{ bs.col_gap | default: 16 }}px;
                max-width: {{ bs.max_width | default: 540 }}px;
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-bcl-{{ block.id }} {
                  grid-template-columns: repeat({{ bs.columns_desktop | default: 1 }}, minmax(0, 1fr));
                }
              }
              #hp4-{{ sid }} #hp4-bcl-{{ block.id }} li {
                display: flex;
                align-items: flex-start;
                gap: {{ bs.icon_gap | default: 10 }}px;
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-text)' %};
                font-size: {{ bs.font_size_mobile | default: 14 }}px;
                font-weight: {{ bs.font_weight | default: '500' }};
                line-height: 1.45;
              }
              @media (min-width: 768px) {
                #hp4-{{ sid }} #hp4-bcl-{{ block.id }} li {
                  font-size: {{ bs.font_size_desktop | default: 15 }}px;
                }
              }
              #hp4-{{ sid }} #hp4-bcl-{{ block.id }} .hp4-bcl-icon {
                flex-shrink: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: {{ bs.icon_box_size | default: 22 }}px;
                height: {{ bs.icon_box_size | default: 22 }}px;
                {%- case bs.icon_radius_style -%}
                  {%- when 'rounded' -%}border-radius: 6px;
                  {%- when 'square' -%}border-radius: 0;
                  {%- else -%}border-radius: 999px;
                {%- endcase -%}
                background: {% render 'scheme-color', color: bs.icon_bg, fallback: 'var(--btn-primary-bg-color)' %};
                color: {% render 'scheme-color', color: bs.icon_color, fallback: 'var(--btn-primary-color)' %};
                margin-top: 1px;
              }
              #hp4-{{ sid }} #hp4-bcl-{{ block.id }} .hp4-bcl-icon svg {
                width: 60%;
                height: 60%;
                stroke: currentColor;
              }
{% comment %}{% endcomment %}            </style>
            <ul id="hp4-bcl-{{ block.id }}" class="hp4-bullet-checklist" {{ block.shopify_attributes }}>
              {%- assign _items_raw = bs.items | default: '' -%}
              {%- assign _items = _items_raw | newline_to_br | replace: '<br />', '
' | replace: '<br/>', '
' | replace: '<br>', '
' | strip | split: '
' -%}
              {%- for it in _items -%}
                {%- assign _txt = it | strip -%}
                {%- if _txt != blank -%}
                  <li>
                    <span class="hp4-bcl-icon">{%- render 'hp-icon', icon: bs.icon_style | default: 'check' -%}</span>
                    <span>{{ _txt }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'bonus_offer' -%}
            <style>
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} {
                display: flex;
                align-items: center;
                gap: {{ bs.gap | default: 14 }}px;
                margin-top: {{ bs.margin_top | default: 8 }}px;
                margin-bottom: {{ bs.margin_bottom | default: 14 }}px;
                padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 16 }}px;
                background: {% render 'scheme-color', color: bs.bg, fallback: 'color-mix(in srgb, var(--color-primary) 8%, var(--color-background))' %};
                border: {{ bs.border_width | default: 1 }}px {{ bs.border_style | default: 'dashed' }} {% render 'scheme-color', color: bs.border_color, fallback: 'var(--color-primary)' %};
                border-radius: {{ bs.radius | default: 12 }}px;
                max-width: {{ bs.max_width | default: 540 }}px;
                position: relative;
              }
              {%- if bs.shimmer -%}
                #hp4-{{ sid }} #hp4-bonus-{{ block.id }}::before {
                  content: '';
                  position: absolute;
                  inset: 0;
                  border-radius: inherit;
                  background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,0.4) 50%, transparent 70%);
                  background-size: 200% 100%;
                  animation: hp3BonusShimmer 3s ease-in-out infinite;
                  pointer-events: none;
                  mix-blend-mode: overlay;
                }
                @keyframes hp3BonusShimmer {
                  from { background-position: 200% 0; }
                  to   { background-position: -100% 0; }
                }
              {%- endif -%}
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-icon {
                flex-shrink: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: {{ bs.icon_box_size | default: 44 }}px;
                height: {{ bs.icon_box_size | default: 44 }}px;
                border-radius: {{ bs.icon_radius | default: 12 }}px;
                background: {% render 'scheme-color', color: bs.icon_bg, fallback: 'var(--btn-primary-bg-color)' %};
                color: {% render 'scheme-color', color: bs.icon_color, fallback: 'var(--btn-primary-color)' %};
                position: relative;
                z-index: 1;
              }
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-icon svg {
                width: 22px;
                height: 22px;
                stroke: currentColor;
              }
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-text {
                position: relative;
                z-index: 1;
                min-width: 0;
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-text)' %};
              }
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-title {
                display: block;
                font-size: {{ bs.title_size | default: 14 }}px;
                font-weight: 700;
                letter-spacing: 0.3px;
                line-height: 1.2;
                color: {% render 'scheme-color', color: bs.title_color, fallback: 'var(--color-heading)' %};
              }
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-body {
                display: block;
                margin-top: 4px;
                font-size: {{ bs.body_size | default: 13 }}px;
                font-weight: 500;
                line-height: 1.4;
                color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-text)' %};
              }
              #hp4-{{ sid }} #hp4-bonus-{{ block.id }} .hp4-bonus-body a {
                color: inherit;
                text-decoration: underline;
                text-underline-offset: 2px;
              }
{% comment %}{% endcomment %}            </style>
            <div id="hp4-bonus-{{ block.id }}" class="hp4-bonus-offer" {{ block.shopify_attributes }}>
              <span class="hp4-bonus-icon">{%- render 'hp-icon', icon: bs.icon | default: 'gift' -%}</span>
              <span class="hp4-bonus-text">
                {%- if bs.title != blank -%}<span class="hp4-bonus-title">{{ bs.title | escape }}</span>{%- endif -%}
                {%- if bs.body != blank -%}<span class="hp4-bonus-body">{{ bs.body }}</span>{%- endif -%}
              </span>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="hp4-image-col">
      <div class="hp4-image-wrap">
        {%- liquid
          assign hp4_img = s.featured_image
          assign hp4_alt = s.featured_image.alt | default: shop.name
          if hp4_img == blank and featured_product != blank and featured_product.featured_image != blank
            assign hp4_img = featured_product.featured_image
            assign hp4_alt = featured_product.title
          endif
        -%}
        <picture class="hp4-image-picture">
          {%- if s.featured_image_mobile != blank -%}
            <source media="(max-width: 899px)" srcset="{{ s.featured_image_mobile | img_url: '900x' }}">
          {%- endif -%}
          {%- if hp4_img != blank -%}
            <img class="hp4-image-main" fetchpriority="high" src="{{ hp4_img | img_url: '1200x' }}" srcset="{{ hp4_img | img_url: '600x' }} 600w, {{ hp4_img | img_url: '900x' }} 900w, {{ hp4_img | img_url: '1200x' }} 1200w, {{ hp4_img | img_url: '1800x' }} 1800w" sizes="(min-width: 900px) 50vw, 100vw" alt="{{ hp4_alt | escape }}" width="{{ hp4_img.width }}" height="{{ hp4_img.height }}">
          {%- else -%}
            <img class="hp4-image-main" src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ shop.name | escape }}">
          {%- endif -%}
        </picture>
      </div>
    </div>
  </div>

  {%- if s.divider_bottom_style != 'none' and s.divider_bottom_style != blank -%}
    {%- if s.divider_bottom_rotate -%}
      <div class="hp4-divider-bottom-wrap">
        {%- render 'hp-divider-bottom',
            style: s.divider_bottom_style,
            color: s.divider_bottom_color,
            height_desktop: s.divider_bottom_height_desktop,
            height_mobile: s.divider_bottom_height_mobile,
            flip: s.divider_bottom_flip
        -%}
      </div>
    {%- else -%}
      {%- render 'hp-divider-bottom',
          style: s.divider_bottom_style,
          color: s.divider_bottom_color,
          height_desktop: s.divider_bottom_height_desktop,
          height_mobile: s.divider_bottom_height_mobile,
          flip: s.divider_bottom_flip
      -%}
    {%- endif -%}
  {%- endif -%}
</div>

{%- if s.reveal -%}
<script>
(function(){
  if(!window.__hp4RevealBound_{{ sid | replace: '-', '_' }}){
    window.__hp4RevealBound_{{ sid | replace: '-', '_' }} = true;
    document.addEventListener('storelib:section-load', function(e){
      if(!e.detail || String(e.detail.sectionId) !== '{{ sid }}') return;
      var r = document.getElementById('hp4-{{ sid }}');
      if(r) r.classList.add('is-revealed');
    });
  }
  var root = document.getElementById('hp4-{{ sid }}');
  if(!root) return;
  if(!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches){ root.classList.add('is-revealed'); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ root.classList.add('is-revealed'); io.unobserve(root); }
    });
  }, { threshold: 0.1 });
  io.observe(root);
})();
{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

