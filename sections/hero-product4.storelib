          "min": 1,
          "max": 6,
          "step": 1,
          "default": 4
        },
        {
          "type": "range",
          "id": "avatar_size",
          "label": "Avatar size",
          "min": 24,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "avatar_overlap",
          "label": "Avatar overlap",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "range",
          "id": "total_stars",
          "label": "Total stars",
          "min": 3,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "range",
          "id": "filled_stars",
          "label": "Filled stars",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5,
          "info": "Supports half stars (e.g., 4.5)."
        },
        {
          "type": "range",
          "id": "star_size",
          "label": "Star size",
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 14
        }
      ],
      "limit": 2
    },
    {
      "type": "simple_rating",
      "name": "Simple rating",
      "settings": [
        {
          "type": "header",
