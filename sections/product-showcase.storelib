      "default": "135deg",
      "options": [
        {
          "value": "45deg",
          "label": "45°"
        },
        {
          "value": "90deg",
          "label": "90°"
        },
        {
          "value": "135deg",
          "label": "135°"
        },
        {
          "value": "180deg",
          "label": "180°"
        },
        {
          "value": "225deg",
          "label": "225°"
        },
        {
          "value": "270deg",
          "label": "270°"
        }
      ],
      "visible_if": "{{ section.settings.enable_gradient }}"
    },
    {
