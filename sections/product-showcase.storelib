      "default": 80,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (Desktop)",
      "min": 0,
      "max": 100,
      "default": 80,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile)",
      "min": 0,
      "max": 100,
      "default": 48,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile)",
      "min": 0,
      "max": 100,
      "default": 48,
      "step": 1
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
