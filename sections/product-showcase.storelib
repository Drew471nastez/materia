      },
      {
        "type": "color",
        "id": "gradient_color_2",
        "label": "Gradient color 2",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "select",
        "id": "gradient_degrees",
        "label": "Gradient direction",
        "default": "135deg",
        "options": [
          {
            "value": "45deg",
            "label": "45°"
          },
          {
            "value": "90deg",
            "label": "90°"
          },
          {
            "value": "135deg",
            "label": "135°"
          },
          {
            "value": "180deg",
            "label": "180°"
          },
          {
            "value": "225deg",
            "label": "225°"
          },
          {
            "value": "270deg",
            "label": "270°"
          }
        ],
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "description_color",
        "label": "Description",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_filled_color",
        "label": "Stars",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_unfilled_color",
        "label": "Empty stars",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "reviews_color",
        "label": "Reviews text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "benefit_color",
        "label": "Benefits text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "check_color",
        "label": "Benefit icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "arrow_color",
        "label": "Arrows",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "arrow_border_color",
        "label": "Arrow border",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg_color",
        "label": "Button background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg_hover_color",
        "label": "Button background (hover)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_hover_color",
        "label": "Button text (hover)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "select",
        "id": "check_icon_style",
        "label": "Benefit icon",
        "default": "check",
        "options": [
          {
            "value": "check",
            "label": "Checkmark"
          },
          {
            "value": "check_circle",
            "label": "Check in circle"
          },
          {
            "value": "check_circle_filled",
            "label": "Check in filled circle"
          },
          {
            "value": "arrow",
            "label": "Arrow"
          },
          {
            "value": "star",
            "label": "Star"
          },
          {
            "value": "plus",
            "label": "Plus"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Match theme button",
        "default": true
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 40,
        "default": 8,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_padding_v",
        "label": "Button padding y",
        "min": 6,
        "max": 40,
        "default": 18,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_padding_h",
        "label": "Button padding x",
        "min": 12,
        "max": 90,
        "default": 44,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_font_size",
        "label": "Button text size",
        "min": 10,
        "max": 30,
        "default": 17,
        "step": 1,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "heading_size_desktop",
        "label": "Heading size (desktop)",
        "min": 20,
        "max": 120,
        "default": 56,
        "step": 1
      },
      {
        "type": "checkbox",
        "id": "heading_use_custom_weight",
        "label": "Custom heading weight",
        "default": false
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Heading weight",
        "default": "800",
        "options": [
          {
            "value": "400",
            "label": "Normal"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi Bold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra Bold"
          },
          {
            "value": "900",
            "label": "Black"
          }
        ],
        "visible_if": "{{ section.settings.heading_use_custom_weight }}"
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "min": -2,
        "max": 10,
        "default": 0,
        "step": 1
      },
      {
        "type": "select",
        "id": "heading_uppercase",
        "label": "Heading case",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "As typed"
          },
          {
            "value": "uppercase",
            "label": "Upper"
          },
          {
            "value": "capitalize",
            "label": "Title"
          }
        ]
      },
      {
        "type": "range",
        "id": "description_size_desktop",
        "label": "Description size (desktop)",
        "min": 12,
        "max": 36,
        "default": 19,
        "step": 1
      },
      {
        "type": "range",
        "id": "star_size",
        "label": "Star size",
        "min": 12,
        "max": 48,
        "default": 26,
        "step": 1
      },
      {
        "type": "range",
        "id": "reviews_size",
        "label": "Reviews text size",
        "min": 10,
        "max": 30,
        "default": 17,
        "step": 1
      },
      {
        "type": "range",
        "id": "benefit_size",
        "label": "Benefits text size",
        "min": 12,
        "max": 32,
        "default": 18,
        "step": 1
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 100,
        "default": 80,
        "step": 1
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 100,
        "default": 80,
        "step": 1
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "min": 16,
        "max": 80,
        "default": 34,
        "step": 1
      },
      {
        "type": "range",
        "id": "description_size_mobile",
        "label": "Description size (mobile)",
        "min": 11,
        "max": 28,
        "default": 16,
        "step": 1
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 100,
        "default": 48,
        "step": 1
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 100,
        "default": 48,
        "step": 1
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product",
            "info": "Gives the slide its picture, title, price and link. The fields below replace them."
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Empty: the product picture."
          },
          {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Your Product Name",
            "info": "Empty: the product title."
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Describe your product in a sentence or two. Highlight what makes it different and why customers keep coming back for it.",
            "info": "Empty: the start of the product description."
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button label",
            "default": "Shop Now"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link",
            "info": "Empty: the product page."
          },
          {
            "type": "text",
            "id": "benefit_1",
            "label": "Benefit 1",
            "default": "Benefit number one"
          },
          {
            "type": "text",
            "id": "benefit_2",
            "label": "Benefit 2",
            "default": "Benefit number two"
          },
          {
            "type": "text",
            "id": "benefit_3",
            "label": "Benefit 3",
            "default": "Benefit number three"
          },
          {
            "type": "text",
            "id": "benefit_4",
            "label": "Benefit 4",
            "default": "Benefit number four"
          },
          {
            "type": "text",
            "id": "benefit_5",
            "label": "Benefit 5"
          },
          {
            "type": "range",
            "id": "star_rating",
            "label": "Star rating",
            "min": 0,
            "max": 5,
            "default": 0,
            "step": 0.5,
            "info": "0 hides the stars."
          },
          {
            "type": "text",
            "id": "reviews_text",
            "label": "Reviews text",
            "info": "For example the number of reviews the product has."
          },
          {
            "type": "url",
            "id": "reviews_link",
            "label": "Reviews link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Showcase",
        "category": "Products",
        "blocks": [
          {
            "type": "slide",
            "settings": {
              "heading": "Your First Product",
              "description": "Describe your product in a sentence or two. Highlight what makes it different and why customers keep coming back for it.",
              "benefit_1": "Benefit number one",
              "benefit_2": "Benefit number two",
              "benefit_3": "Benefit number three",
              "benefit_4": "Benefit number four",
              "button_text": "Shop Now"
            }
          },
          {
            "type": "slide",
            "settings": {
              "heading": "Your Second Product",
              "description": "Swap in your own copy here. Each slide is its own product with its own image, rating, benefits and button.",
              "benefit_1": "Highlight a key feature",
              "benefit_2": "Add a reason to buy",
              "benefit_3": "Mention a guarantee",
              "button_text": "Shop Now"
            }
          }
        ]
      }
    ]
  }
}
