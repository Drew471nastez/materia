<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Product Showcase — a scoped, block-driven product carousel.

  Architecture (mirrors Materia's Hero Pro 1 conventions):
   • Everything is scoped to #shopify-section-{{ section.id }} so multiple
     instances on one page never collide and no other section can bleed
     styles or JS into this one. `isolation: isolate` creates its own
     stacking context.
   • Content lives in repeatable "Slide" blocks (one product each). The
     arrows page between slides.
   • Every style setting is emitted as a LITERAL value into a scoped
     <style> block (no CSS-var indirection) so each control applies
     reliably and updates live in the editor.
   • Typography is connected to the theme. Headings use --heading-font,
     body text uses --body-font, the button uses --btn-font. Font WEIGHT
     follows the theme by default (--heading-weight / --body-weight). The
     heading weight only changes when "Use custom heading font weight" is
     toggled on, then the section weight applies instead.
   • Connected to the theme's scroll-animation and speed settings, same as
     Hero Pro 1.
{%- endcomment -%}

{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function () {
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- comment -%} Section-level style locals {%- endcomment -%}
{%- assign s = section.settings -%}
{%- liquid
  assign ps_custom = false
  if s.use_theme_button == false
    assign ps_custom = true
  endif
-%}
{%- capture ps_bg -%}{% render 'scheme-color', color: s.background_color, fallback: 'var(--color-background)' %}{%- endcapture -%}

{%- comment -%}
  Heading weight: off by default. When the toggle is off we inherit the
  theme's heading weight; only when it's on do we apply the section value.
{%- endcomment -%}
{%- if s.heading_use_custom_weight -%}
  {%- assign ps_heading_weight = s.heading_weight -%}
{%- else -%}
  {%- assign ps_heading_weight = 'var(--heading-weight, 700)' -%}
{%- endif -%}

{%- comment -%} Speed: honour the theme's global performance settings. {%- endcomment -%}
{%- liquid
  assign sp_quality = 'balanced'
  if sp_quality == 'max'
    assign ps_img_max = 1800
  elsif sp_quality == 'fast'
    assign ps_img_max = 1000
  else
    assign ps_img_max = 1400
  endif
  assign sp_lazy = settings.perf_images
  # The first picture loads first only when the section opens the page;
  # lower down it would hold back the hero picture.
  assign sp_preload = false
  if settings.perf_images and section.index != blank and section.index <= 2
    assign sp_preload = true
  endif
  assign sp_decode = settings.perf_images
-%}

{%- comment -%} Selectable benefit/check icon (rendered once, reused per benefit). {%- endcomment -%}
{%- capture ps_check_svg -%}
  {%- case s.check_icon_style -%}
    {%- when 'check_circle' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="16.5 8.8 10.5 15.2 7.5 12.2"/></svg>
    {%- when 'check_circle_filled' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="11"/><path d="M17 8.5 L10.4 15.4 L7 12.1" fill="none" style="stroke: {{ ps_bg }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'arrow' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    {%- when 'star' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 14.7 8.6 21.8 9.2 16.4 13.9 18.1 20.8 12 17.1 5.9 20.8 7.6 13.9 2.2 9.2 9.3 8.6"/></svg>
    {%- when 'plus' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  {%- endcase -%}
{%- endcapture -%}

<style>
  /* ============================================================
     SCOPING — every rule is prefixed with the section wrapper id.
     ============================================================ */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .ps-section {
    font-family: var(--body-font, inherit);
    box-sizing: border-box;
    position: relative;
    width: 100%;
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    {% if s.enable_gradient %}
      background: linear-gradient({{ s.gradient_degrees }}, {% render 'scheme-color', color: s.gradient_color_1, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: s.gradient_color_2, fallback: 'var(--color-background)' %});
    {% else %}
      background-color: {{ ps_bg }};
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ps-section *,
  #shopify-section-{{ section.id }} .ps-section *::before,
  #shopify-section-{{ section.id }} .ps-section *::after { box-sizing: border-box; }

  /* Width container */
  #shopify-section-{{ section.id }} .ps-inner {
    {% case s.section_width %}
      {% when 'container' %}max-width: calc(var(--page-width, 1300px) + 3rem);
      {% when 'fluid_container' %}max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
      {% when 'stretch_width' %}max-width: none; padding-inline: 3rem;
      {% when 'full_width' %}max-width: none;
      {% else %}max-width: {{ s.content_max_width }}px;
    {% endcase %}
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* Viewport + sliding track */
  #shopify-section-{{ section.id }} .ps-viewport { overflow: hidden; width: 100%; }
  #shopify-section-{{ section.id }} .ps-track {
    display: flex;
    width: 100%;
    transition: transform .55s cubic-bezier(.4, 0, .2, 1);
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .ps-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr 1.05fr;
    gap: 48px;
    align-items: center;
  }

  /* Columns */
  #shopify-section-{{ section.id }} .ps-col-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-height: 100%;
    align-self: {{ s.left_vertical_align }};
  }
  #shopify-section-{{ section.id }} .ps-col-center { display: flex; justify-content: center; align-items: center; }
  #shopify-section-{{ section.id }} .ps-col-right { display: flex; flex-direction: column; gap: 18px; }

  /* Heading + description — typography connected to the theme.
     Family always follows the theme. Weight follows the theme unless the
     "Use custom heading font weight" toggle is on. */
  #shopify-section-{{ section.id }} .ps-heading {
    font-family: var(--heading-font, var(--body-font, inherit));
    margin: 0;
    color: {% render 'scheme-color', color: s.heading_color, fallback: 'var(--color-heading)' %};
    font-size: {{ s.heading_size_desktop }}px;
    font-weight: {{ ps_heading_weight }};
    line-height: 1.05;
    letter-spacing: {{ s.heading_letter_spacing }}px;
    text-transform: {{ s.heading_uppercase }};
  }
  #shopify-section-{{ section.id }} .ps-desc {
    font-family: var(--body-font, inherit);
    margin: 0;
    color: {% render 'scheme-color', color: s.description_color, fallback: 'var(--color-text)' %};
    font-size: {{ s.description_size_desktop }}px;
    font-weight: var(--body-weight, 400);
    line-height: 1.55;
  }

  /* Arrows */
  #shopify-section-{{ section.id }} .ps-arrows { display: flex; gap: 14px; margin-top: auto; padding-top: 8px; }
  #shopify-section-{{ section.id }} .ps-arrow {
    width: {{ s.arrow_size }}px;
    height: {{ s.arrow_size }}px;
    border-radius: 9999px;
    border: 1.5px solid {% render 'scheme-color', color: s.arrow_border_color, fallback: 'var(--color-border)' %};
    background: transparent;
    color: {% render 'scheme-color', color: s.arrow_color, fallback: 'var(--color-heading)' %};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .ps-arrow:hover { background-color: {% render 'scheme-color', color: s.arrow_color, fallback: 'var(--color-heading)' %}; color: {{ ps_bg }}; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .ps-arrow svg { width: 45%; height: 45%; display: block; }

  /* Product image */
  #shopify-section-{{ section.id }} .ps-image { width: 100%; display: flex; justify-content: center; }
  #shopify-section-{{ section.id }} .ps-image img {
    max-width: 100%;
    max-height: {{ s.image_max_height }}px;
    height: auto;
    width: auto;
    object-fit: contain;
    display: block;
    border-radius: {{ s.image_border_radius }}px;
  }
  /* Placeholder shows as a 4:3 framed image (Instagram-ish) until a
     real product image is uploaded. */
  #shopify-section-{{ section.id }} .ps-image img.ps-placeholder-img {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 3;
    max-height: none;
    object-fit: cover;
  }

  /* Rating + reviews */
  #shopify-section-{{ section.id }} .ps-rating { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .ps-stars {
    position: relative;
    display: inline-block;
    line-height: 1;
    font-size: {{ s.star_size }}px;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .ps-stars .ps-stars-base,
  #shopify-section-{{ section.id }} .ps-stars .ps-stars-fill { letter-spacing: 2px; }
  #shopify-section-{{ section.id }} .ps-stars .ps-stars-base { color: {% render 'scheme-color', color: s.star_unfilled_color, fallback: 'var(--color-border)' %}; }
  #shopify-section-{{ section.id }} .ps-stars .ps-stars-fill {
    color: {% render 'scheme-color', color: s.star_filled_color, fallback: 'var(--color-primary)' %};
    position: absolute; top: 0; left: 0; overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ps-reviews {
    font-family: var(--body-font, inherit);
    color: {% render 'scheme-color', color: s.reviews_color, fallback: 'var(--color-text)' %};
    font-size: {{ s.reviews_size }}px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} a.ps-reviews { opacity: 1; transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); }
  #shopify-section-{{ section.id }} a.ps-reviews:hover { opacity: .8; }

  /* Benefits */
  #shopify-section-{{ section.id }} .ps-benefits { display: flex; flex-direction: column; gap: 14px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .ps-benefit {
    font-family: var(--body-font, inherit);
    display: flex;
    align-items: center;
    gap: 12px;
    color: {% render 'scheme-color', color: s.benefit_color, fallback: 'var(--color-text)' %};
    font-size: {{ s.benefit_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .ps-check {
    flex: 0 0 auto;
    width: {{ s.benefit_size | plus: 6 }}px;
    height: {{ s.benefit_size | plus: 6 }}px;
    color: {% render 'scheme-color', color: s.check_color, fallback: 'var(--color-heading)' %};
  }
  #shopify-section-{{ section.id }} .ps-check svg { width: 100%; height: 100%; display: block; }

  /* The button is a theme button (theme-button-contract.css): Theme settings >
     Buttons draw it; colours set here, and the shape when the theme style is
     off, are passed as tokens by the button-overrides snippet. */
  #shopify-section-{{ section.id }} .ps-btn {
    align-self: flex-start;
    margin-top: 6px;
    cursor: pointer;
  }

  /* Reveal (uses theme scroll-trigger if present; gentle local fallback) */
  #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-left,
  #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-center,
  #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-right { animation: ps-fade-{{ section.id }} .6s ease both; }
  @keyframes ps-fade-{{ section.id }} { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  /* ===================== MOBILE ===================== */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .ps-section {
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .ps-slide {
      grid-template-columns: 1fr;
      gap: 22px;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .ps-col-center { order: 1; }
    #shopify-section-{{ section.id }} .ps-col-left { order: 2; align-items: center; }
    #shopify-section-{{ section.id }} .ps-col-right { order: 3; align-items: center; }
    #shopify-section-{{ section.id }} .ps-rating,
    #shopify-section-{{ section.id }} .ps-arrows { justify-content: center; }
    #shopify-section-{{ section.id }} .ps-btn { align-self: center; }
    #shopify-section-{{ section.id }} .ps-benefit { text-align: left; }
    #shopify-section-{{ section.id }} .ps-heading { font-size: {{ s.heading_size_mobile }}px; }
    #shopify-section-{{ section.id }} .ps-desc { font-size: {{ s.description_size_mobile }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ps-track,
    #shopify-section-{{ section.id }} .ps-arrow { transition: none; }
    #shopify-section-{{ section.id }} .ps-arrow:hover { transform: none; }
    #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-left,
    #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-center,
    #shopify-section-{{ section.id }} .ps-slide.is-active .ps-col-right { animation: none; }
  }
{% comment %}{% endcomment %}</style>

<div class="ps-section color-{{ color_scheme }} gradient">
  <div class="ps-inner">
    <div class="ps-viewport">
      <div class="ps-track" data-ps-track>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="ps-slide{% if forloop.first %} is-active{% endif %}" data-ps-slide {{ block.shopify_attributes }}>

            {%- comment -%} LEFT: heading, description, arrows {%- endcomment -%}
            <div class="ps-col-left">
              {%- if b.heading != blank -%}
                <h2 class="ps-heading">{{ b.heading }}</h2>
              {%- endif -%}
              {%- if b.description != blank -%}
                <p class="ps-desc">{{ b.description }}</p>
              {%- endif -%}

              {%- if section.blocks.size > 1 and s.show_arrows -%}
                <div class="ps-arrows">
                  <button type="button" class="ps-arrow" data-ps-prev aria-label="Previous">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                  </button>
                  <button type="button" class="ps-arrow" data-ps-next aria-label="Next">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </button>
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} CENTER: product image {%- endcomment -%}
            <div class="ps-col-center">
              <div class="ps-image">
                {%- if b.image != blank -%}
                  {%- liquid
                    if forloop.first
                      assign ps_loading = 'eager'
                      unless sp_preload
                        assign ps_loading = 'lazy'
                      endunless
                    else
                      assign ps_loading = 'lazy'
                      unless sp_lazy
                        assign ps_loading = 'eager'
                      endunless
                    endif
                  -%}
                  <img
                    src="{{ b.image | image_url: width: ps_img_max }}"
                    srcset="{{ b.image | image_url: width: 360 }} 360w,
                            {{ b.image | image_url: width: 540 }} 540w,
                            {{ b.image | image_url: width: 720 }} 720w,
                            {{ b.image | image_url: width: 960 }} 960w,
                            {{ b.image | image_url: width: 1200 }} 1200w,
                            {{ b.image | image_url: width: ps_img_max }} {{ ps_img_max }}w"
                    sizes="(max-width: 749px) 90vw, 33vw"
                    width="{{ b.image.width }}"
                    height="{{ b.image.height }}"
                    alt="{{ b.image.alt | default: b.heading | escape }}"
                    loading="{{ ps_loading }}"
                    {% if forloop.first and sp_preload %}fetchpriority="high"{% endif %}
                    {% if sp_decode %}decoding="async"{% endif %}>
                {%- else -%}
                  <img class="ps-placeholder-img"
                    src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
                    alt="{{ b.heading | escape }}"
                    width="1200" height="900"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if sp_decode %}decoding="async"{% endif %}>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} RIGHT: rating, benefits, button {%- endcomment -%}
            <div class="ps-col-right">
              {%- if b.star_rating > 0 or b.reviews_text != blank -%}
                <div class="ps-rating">
                  {%- if b.star_rating > 0 -%}
                    <span class="ps-stars" role="img" aria-label="{{ b.star_rating }} out of 5 stars">
                      <span class="ps-stars-base" aria-hidden="true">★★★★★</span>
                      <span class="ps-stars-fill" aria-hidden="true" style="width: {{ b.star_rating | times: 20 }}%;">★★★★★</span>
                    </span>
                  {%- endif -%}
                  {%- if b.reviews_text != blank -%}
                    {%- if b.reviews_link != blank -%}
                      <a class="ps-reviews" href="{{ b.reviews_link }}">{{ b.reviews_text }}</a>
                    {%- else -%}
                      <span class="ps-reviews">{{ b.reviews_text }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- assign has_benefit = false -%}
              {%- for i in (1..5) -%}
                {%- assign key = 'benefit_' | append: i -%}
                {%- if b[key] != blank -%}{%- assign has_benefit = true -%}{%- endif -%}
              {%- endfor -%}
              {%- if has_benefit -%}
                <ul class="ps-benefits">
                  {%- for i in (1..5) -%}
                    {%- assign key = 'benefit_' | append: i -%}
                    {%- if b[key] != blank -%}
                      <li class="ps-benefit">
                        <span class="ps-check">{{ ps_check_svg }}</span>
                        <span>{{ b[key] }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if b.button_text != blank -%}
                <a class="ps-btn" data-theme-button="primary" data-sl-button style="{%- render 'button-overrides', bg: s.button_bg_color, text: s.button_text_color, hover_bg: s.button_bg_hover_color, hover_text: s.button_text_hover_color, custom: ps_custom, radius: s.button_radius, padding_y: s.button_padding_v, padding_x: s.button_padding_h, font_size: s.button_font_size, border_width: 0 -%}" href="{{ b.button_link | default: routes.all_products_collection_url | default: '/collections/all' }}">{{ b.button_text }}</a>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
  function initPs() {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    if (root.__psCleanup) { root.__psCleanup(); root.__psCleanup = null; }
    var track = root.querySelector('[data-ps-track]');
    if (!track || track.__psInit) return;
    track.__psInit = true;
    var slides = track.querySelectorAll('[data-ps-slide]');
    var count = slides.length;
    if (count <= 1) return;

    var index = 0;
    var autoplay = {{ s.autoplay | json }};
    var speed = {{ s.autoplay_speed | default: 6 }} * 1000;
    var timer = null;

    function render() {
      track.style.transform = 'translateX(' + (-index * 100) + '%)';
      for (var k = 0; k < slides.length; k++) {
        slides[k].classList.toggle('is-active', k === index);
      }
    }
    function go(to) { index = (to + count) % count; render(); }

    root.querySelectorAll('[data-ps-prev]').forEach(function (el) {
      el.addEventListener('click', function () { go(index - 1); restart(); });
    });
    root.querySelectorAll('[data-ps-next]').forEach(function (el) {
      el.addEventListener('click', function () { go(index + 1); restart(); });
    });

    /* ---- Real-time touch swipe (mobile) ---- */
    var viewport = root.querySelector('.ps-viewport');
    var startX = 0, startY = 0, dx = 0, dragging = false, locked = false, vw = 0;
    if (viewport) {
      viewport.addEventListener('touchstart', function (e) {
        if (count <= 1) return;
        dragging = true; locked = false; dx = 0;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        vw = viewport.clientWidth || 1;
        track.style.transition = 'none';
        stop();
      }, { passive: true });

      viewport.addEventListener('touchmove', function (e) {
        if (!dragging) return;
        var mx = e.touches[0].clientX - startX;
        var my = e.touches[0].clientY - startY;
        /* Decide intent once: horizontal => drive the slider, vertical
           => let the page scroll and bail out of the swipe. */
        if (!locked) {
          if (Math.abs(mx) < 6 && Math.abs(my) < 6) return;
          if (Math.abs(my) > Math.abs(mx)) { dragging = false; track.style.transition = ''; render(); start(); return; }
          locked = true;
        }
        dx = mx;
        /* resist past the first/last edge so it feels natural */
        if ((index === 0 && dx > 0) || (index === count - 1 && dx < 0)) dx *= 0.35;
        track.style.transform = 'translateX(calc(' + (-index * 100) + '% + ' + dx + 'px))';
      }, { passive: true });

      function endSwipe() {
        if (!dragging) return;
        dragging = false;
        track.style.transition = '';
        var threshold = vw * 0.18;
        if (dx <= -threshold) go(index + 1);
        else if (dx >= threshold) go(index - 1);
        else render();
        dx = 0;
        start();
      }
      viewport.addEventListener('touchend', endSwipe);
      viewport.addEventListener('touchcancel', endSwipe);
    }

    var onScreen = true;
    function start() { if (autoplay && onScreen && !timer && document.body.contains(track)) { timer = setInterval(function () { if (!document.body.contains(track)) { stop(); return; } go(index + 1); }, speed); } }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { stop(); start(); }

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    var io = null;
    if (autoplay && 'IntersectionObserver' in window) {
      io = new IntersectionObserver(function (entries) {
        onScreen = entries[0].isIntersecting;
        if (onScreen) start(); else stop();
      });
      io.observe(root);
    }
    root.__psCleanup = function () {
      stop();
      root.removeEventListener('mouseenter', stop);
      root.removeEventListener('mouseleave', start);
      if (io) io.disconnect();
    };

    render();
    start();
  }
  initPs();
  window.__psListen = window.__psListen || {};
  if (!window.__psListen['{{ section.id }}']) {
    window.__psListen['{{ section.id }}'] = true;
    document.addEventListener('storelib:section-load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') initPs();
    });
  }
  })();
