            "benefit_2": "Add a reason to buy",
            "benefit_3": "Mention a guarantee",
            "button_text": "Shop Now"
          }
        }
      ]
    }
  ],
  "shopify": {
    "name": "Product Showcase",
    "tag": "section",
    "class": "product-showcase-section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          },
          {
            "value": "custom",
            "label": "Custom max width"
          }
        ]
      },
      {
        "type": "range",
        "id": "content_max_width",
        "label": "Custom max width",
        "min": 800,
        "max": 1800,
        "default": 1300,
        "step": 10,
        "visible_if": "{{ section.settings.section_width == 'custom' }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "left_vertical_align",
        "label": "Heading column position",
        "default": "center",
        "options": [
          {
            "value": "start",
            "label": "Top"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "end",
            "label": "Bottom"
          }
        ],
        "info": "Desktop."
      },
      {
        "type": "header",
        "content": "Images"
      },
      {
        "type": "range",
        "id": "image_max_height",
        "label": "Image max height",
        "min": 200,
        "max": 900,
        "default": 560,
        "step": 10
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 60,
        "default": 12,
        "step": 1
      },
      {
        "type": "header",
        "content": "Slider"
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show arrows",
        "default": true,
        "info": "With two or more slides."
      },
      {
        "type": "range",
        "id": "arrow_size",
        "label": "Arrow size",
        "min": 30,
        "max": 80,
        "default": 48,
        "step": 1
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-rotate slides",
        "default": false,
        "info": "Stops on hover, off screen and when visitors prefer reduced motion."
      },
      {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Change slide every (seconds)",
        "min": 3,
        "max": 15,
        "default": 6,
        "step": 1,
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_gradient",
        "label": "Background gradient",
        "default": false,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "gradient_color_1",
        "label": "Gradient color 1",
