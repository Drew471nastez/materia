          "label": "Custom max width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Custom max width",
      "min": 800,
      "max": 1800,
      "default": 1300,
      "step": 10,
      "visible_if": "{{ section.settings.section_width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Image max height",
      "min": 200,
      "max": 900,
      "default": 560,
      "step": 10
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 60,
      "default": 12,
      "step": 1
    },
    {
      "type": "select",
      "id": "left_vertical_align",
      "label": "Text position",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
