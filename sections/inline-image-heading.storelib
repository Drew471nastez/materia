<template compat="shopify">
<script src="{{ 'live-text.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Inline Image Heading: an optional eyebrow block and one
  large heading sentence built from Text and Image blocks, with small round
  pictures between the words. Theme first: colours from the colour scheme,
  fonts and weights from Theme settings > Typography; custom colours, fonts,
  weight and line spacing only when their switch is on. Every value is a CSS
  variable on the root, printed here for the first paint and repainted live by
  live-text.js (the same names and the same fallbacks).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign align = st.content_alignment | default: 'center'
  assign eyebrow_block = section.blocks | where: 'type', 'eyebrow' | first
  assign heading_blocks = 0
  for block in section.blocks
    if block.type == 'text' or block.type == 'image'
      assign heading_blocks = heading_blocks | plus: 1
    endif
  endfor
  case st.heading_weight
    when 'body_weight'
      assign iih_weight = 'var(--body-weight, 400)'
    when 'subheading_weight'
      assign iih_weight = 'var(--subheading-weight, 500)'
    else
      assign iih_weight = 'var(--heading-weight, 700)'
  endcase
  case st.section_width
    when 'container'
      assign iih_max = 'calc(var(--page-width, 1300px) + 3rem)'
    when 'narrow'
      assign iih_max = '1040px'
    when 'stretch_width'
      assign iih_max = 'none'
    when 'full_width'
      assign iih_max = 'none'
    else
      assign iih_max = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
  endcase
  assign iih_pad = '22px'
  assign iih_pad_wide = '22px'
  if st.section_width == 'stretch_width'
    assign iih_pad = '1.5rem'
    assign iih_pad_wide = '3rem'
  elsif st.section_width == 'full_width'
    assign iih_pad = '4vw'
    assign iih_pad_wide = '4vw'
  endif
-%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.reset_spacing -%}
<style data-rs-bulletproof>
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if st.enable_custom_fonts -%}
<style>
  {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if eyebrow_block and eyebrow_block.settings.enable_custom_fonts and eyebrow_block.settings.font.family != blank -%}
<style>{{ eyebrow_block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    max-width: none !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
    margin-top: var(--iih-mt-m, 0px) !important;
    margin-bottom: var(--iih-mb-m, 0px) !important;
    --iih-mt-m: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_top_mobile | default: 0 }}{% endif %}px;
    --iih-mb-m: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_bottom_mobile | default: 0 }}{% endif %}px;
    --iih-mt-d: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_top_desktop | default: 0 }}{% endif %}px;
    --iih-mb-d: {% if st.reset_spacing %}0{% else %}{{ st.section_margin_bottom_desktop | default: 0 }}{% endif %}px;
    --iih-mobile-display: {% if st.show_on_mobile == false %}none{% else %}block{% endif %};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} { margin-top: var(--iih-mt-d, 0px) !important; margin-bottom: var(--iih-mb-d, 0px) !important; }
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} { display: var(--iih-mobile-display, block) !important; }
  }
  #shopify-section-{{ section.id }} .iih {
    box-sizing: border-box;
    width: 100%;
    container-type: inline-size;
    background: var(--iih-bg);
    padding-block: var(--iih-pt-m) var(--iih-pb-m);
  }
  #shopify-section-{{ section.id }} .iih__inner {
    max-width: var(--iih-max);
    margin-inline: auto;
    padding-inline: var(--iih-pad);
    box-sizing: border-box;
    text-align: var(--iih-align);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih { padding-block: var(--iih-pt-d) var(--iih-pb-d); }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .iih__inner { padding-inline: var(--iih-pad-wide); }
  }
  #shopify-section-{{ section.id }} .iih__eyebrow {
    margin: 0 0 var(--iih-eyebrow-gap, 24px);
    font-family: var(--iih-eyebrow-font, var(--iih-body-font));
    font-size: var(--iih-eyebrow-size-m, 13px);
    font-weight: var(--iih-eyebrow-weight, var(--body-weight, 400));
    letter-spacing: var(--iih-eyebrow-ls, 1px);
    text-transform: var(--iih-eyebrow-case, none);
    line-height: 1.4;
    color: var(--iih-eyebrow-ink, var(--color-text));
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih__eyebrow { font-size: var(--iih-eyebrow-size-d, 14px); }
  }
  #shopify-section-{{ section.id }} .iih .iih__heading {
    margin: 0;
    font-family: var(--iih-font);
    font-weight: var(--iih-weight);
    font-size: var(--iih-size-m);
    line-height: var(--iih-lh);
    letter-spacing: var(--iih-ls);
    color: var(--iih-ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih .iih__heading { font-size: var(--iih-size-d); }
  }
  #shopify-section-{{ section.id }} .iih__text { white-space: normal; }
  #shopify-section-{{ section.id }} .iih__media {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-inline: var(--iih-gap);
    transform: translateY(var(--iih-offset));
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .iih__link {
    display: inline-block;
    line-height: 0;
    border-radius: 50%;
  }
  #shopify-section-{{ section.id }} .iih__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  #shopify-section-{{ section.id }} .iih__img {
    width: var(--iih-img-m);
    height: var(--iih-img-m);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih__img { width: var(--iih-d, var(--iih-img-d)); height: var(--iih-d, var(--iih-img-d)); }
  }
  #shopify-section-{{ section.id }} .iih__placeholder { fill: currentColor; color: var(--color-text); opacity: 0.35; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .iih, #shopify-section-{{ section.id }} .iih * { animation: none !important; transition: none !important; }
  }
  #shopify-section-{{ section.id }} .iih [hidden] { display: none !important; }
{% comment %}{% endcomment %}</style>
{%- capture iih_bg -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_background, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
{%- capture iih_ink -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}{%- endcapture -%}
{%- capture iih_font -%}{% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %}{%- endcapture -%}
{%- capture iih_body_font -%}{% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %}{%- endcapture -%}
<div
  class="iih section color-{{ color_scheme }} gradient"
  data-live-text="inline-image-heading"
  data-lt-section="{{ section.id }}"
  data-lt-settings="{{ section.settings | json | escape }}"
  {% if st.enable_custom_fonts %}data-own-font{% endif %}
  style="--iih-bg: {{ iih_bg | strip }}; --iih-ink: {{ iih_ink | strip }}; --iih-font: {{ iih_font | strip }}; --iih-body-font: {{ iih_body_font | strip }}; --iih-weight: {{ iih_weight }}; --iih-lh: {% if st.enable_custom_size %}{{ st.heading_line_height | default: 1.15 }}{% else %}var(--heading-line-height, 1.2){% endif %}; --iih-ls: {% if st.enable_custom_size %}{{ st.heading_letter_spacing | default: 0 }}px{% else %}var(--heading-letter-spacing, normal){% endif %}; --iih-size-d: {{ st.heading_size | default: 56 }}px; --iih-size-m: {{ st.heading_size_mobile | default: 30 }}px; --iih-img-d: {{ st.image_size | default: 64 }}px; --iih-img-m: {{ st.image_size_mobile | default: 40 }}px; --iih-gap: {{ st.image_gap | default: 0 }}px; --iih-offset: {{ st.image_offset_y | default: 0 }}px; --iih-pt-d: {{ st.padding_top }}px; --iih-pb-d: {{ st.padding_bottom }}px; --iih-pt-m: {{ st.padding_top_mobile }}px; --iih-pb-m: {{ st.padding_bottom_mobile }}px; --iih-align: {{ align }}; --iih-max: {{ iih_max }}; --iih-pad: {{ iih_pad }}; --iih-pad-wide: {{ iih_pad_wide }};"
>
  <div class="iih__inner">
    {%- if eyebrow_block -%}
      {%- assign eb = eyebrow_block.settings -%}
      {%- capture eb_ink -%}{% if eb.enable_custom_style %}{% render 'scheme-color', color: eb.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}{%- endcapture -%}
      <p
        class="iih__eyebrow"
        data-lt-block="{{ eyebrow_block.id }}" data-lt-type="eyebrow" data-lt-settings="{{ eb | json | escape }}" {{ eyebrow_block.shopify_attributes }}
        {% if eb.enable_custom_fonts or st.enable_custom_fonts %}data-own-font{% endif %}
        {% if eb.text == blank %}hidden{% endif %}
        style="--iih-eyebrow-ink: {{ eb_ink | strip }}; --iih-eyebrow-size-d: {{ eb.size }}px; --iih-eyebrow-size-m: {{ eb.size_mobile }}px; --iih-eyebrow-weight: {% if eb.weight == 'theme' or eb.weight == blank %}var(--body-weight, 400){% else %}{{ eb.weight }}{% endif %}; --iih-eyebrow-ls: {{ eb.letter_spacing }}px; --iih-eyebrow-case: {% if eb.uppercase %}uppercase{% else %}none{% endif %}; --iih-eyebrow-gap: {{ eb.spacing_below }}px;{% if eb.enable_custom_fonts and eb.font.family != blank %} --iih-eyebrow-font: {{ eb.font.family }}, {{ eb.font.fallback_families | default: 'sans-serif' }};{% endif %}"
      >{{ eb.text | escape }}</p>
    {%- elsif st.show_eyebrow and st.eyebrow != blank -%}
      {%- comment -%} Legacy: the eyebrow from section settings, only when there is no Eyebrow block. {%- endcomment -%}
      {%- capture eb_ink -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.eyebrow_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}{%- endcapture -%}
      <p
        class="iih__eyebrow" data-lt-legacy-eyebrow
        {% if st.enable_custom_fonts %}data-own-font{% endif %}
        style="--iih-eyebrow-ink: {{ eb_ink | strip }}; --iih-eyebrow-size-d: {{ st.eyebrow_size }}px; --iih-eyebrow-size-m: {{ st.eyebrow_size_mobile }}px; --iih-eyebrow-weight: {% case st.eyebrow_weight %}{% when 'heading_weight' %}var(--heading-weight, 700){% when 'subheading_weight' %}var(--subheading-weight, 500){% else %}var(--body-weight, 400){% endcase %}; --iih-eyebrow-ls: {{ st.eyebrow_letter_spacing }}px; --iih-eyebrow-case: {% if st.eyebrow_uppercase %}uppercase{% else %}none{% endif %}; --iih-eyebrow-gap: {{ st.eyebrow_spacing_below }}px;"
      >{{ st.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if heading_blocks > 0 -%}
      <h2
        class="iih__heading"
        {% if st.enable_custom_fonts %}data-own-font{% endif %}
        {% if st.heading_weight != blank and st.heading_weight != 'heading_weight' %}data-own-weight{% endif %}
        {% if st.enable_custom_size %}data-own-size{% endif %}
      >
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <span class="iih__text" data-lt-block="{{ block.id }}" data-lt-type="text" data-lt-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</span>{{ ' ' }}
            {%- when 'image' -%}
              {%- assign col = bs.collection -%}
              {%- assign col_img = col.image | default: col.featured_image -%}
              {%- assign chosen = bs.image | default: col_img -%}
              <span class="iih__media" data-lt-block="{{ block.id }}" data-lt-type="image" data-lt-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.size_override > 0 %} style="--iih-d: {{ bs.size_override }}px;"{% endif %}>
                {%- if col != blank and col.url != blank -%}<a class="iih__link" href="{{ col.url }}" aria-label="{{ col.title | escape }}">{%- endif -%}
                {%- if chosen != blank -%}
                  <img
                    class="iih__img"
                    src="{{ chosen | image_url: width: 220 }}"
                    srcset="{{ chosen | image_url: width: 110 }} 110w, {{ chosen | image_url: width: 220 }} 220w, {{ chosen | image_url: width: 330 }} 330w, {{ chosen | image_url: width: 480 }} 480w"
                    sizes="{{ st.image_size | default: 64 }}px"
                    width="{{ chosen.width | default: 220 }}"
                    height="{{ chosen.height | default: 220 }}"
                    alt="{{ bs.image.alt | default: col.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'iih__img iih__placeholder' }}
                {%- endif -%}
                {%- if col != blank and col.url != blank -%}</a>{%- endif -%}
              </span>{{ ' ' }}
          {%- endcase -%}
        {%- endfor -%}
      </h2>
    {%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "type": "inline-image-heading",
  "name": "Inline Image Heading",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "default": "fluid_container",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space around section",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Images"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size (desktop)",
      "min": 24,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Space around images",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "image_offset_y",
      "label": "Image vertical nudge",
      "min": -40,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}",
      "info": "Used by the eyebrow."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "heading_weight",
      "options": [
        {
          "value": "heading_weight",
          "label": "Theme heading"
        },
        {
          "value": "subheading_weight",
          "label": "Theme subheading"
        },
        {
          "value": "body_weight",
          "label": "Theme body"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_size",
      "label": "Custom line height and spacing",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_line_height",
      "label": "Heading line height",
      "default": "1.15",
      "options": [
        {
          "value": "1",
          "label": "Tight (1.0)"
        },
        {
          "value": "1.1",
          "label": "Snug (1.1)"
        },
        {
          "value": "1.15",
          "label": "Normal (1.15)"
        },
        {
          "value": "1.25",
          "label": "Relaxed (1.25)"
        },
        {
          "value": "1.4",
          "label": "Loose (1.4)"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_size }}"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -4,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_size }}"
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 12,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "image_size_mobile",
      "label": "Image size (mobile)",
      "min": 16,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
