<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes — Inline Image Heading.
  An editorial statement: a small eyebrow line + a large heading sentence with
  small circular images woven inline between the words. Built from blocks
  (Text + Image) so the merchant composes the sentence in any order.
  Connected to the theme color scheme + heading font + weight settings.
{%- endcomment -%}

{%- comment -%} Connect to theme-level scroll animation settings. {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign heading_tag = 'h2'
  assign align = st.content_alignment | default: 'center'
-%}

<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Theme typography inheritance */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Full-bleed wrapper so the color-scheme background reaches edge to edge */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > .iih {
    width: 100% !important;
    box-sizing: border-box !important;
  }

  /* ===== Inline Image Heading ===== */
  #shopify-section-{{ section.id }} .iih {
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
    --iih-img: {{ st.image_size_mobile | default: 40 }}px;
    --iih-gap: {{ st.image_gap | default: 6 }}px;
    --iih-offset: {{ st.image_offset_y | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih {
      padding-top: {{ st.padding_top | default: 80 }}px;
      padding-bottom: {{ st.padding_bottom | default: 80 }}px;
      --iih-img: {{ st.image_size | default: 64 }}px;
    }
  }

  /* Inner measure (width) */
  #shopify-section-{{ section.id }} .iih__inner {
    margin-inline: auto;
    padding-inline: 22px;
    box-sizing: border-box;
    text-align: {{ align }};
  }
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .iih__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .iih__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    {%- when 'narrow' -%}
      #shopify-section-{{ section.id }} .iih__inner { max-width: 1040px; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} .iih__inner { max-width: none; padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ section.id }} .iih__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      #shopify-section-{{ section.id }} .iih__inner { max-width: none; padding-inline: 4vw; }
  {%- endcase -%}

  /* Eyebrow */
  #shopify-section-{{ section.id }} .iih__eyebrow {
    margin: 0 0 {{ st.eyebrow_spacing_below | default: 24 }}px;
    font-size: {{ st.eyebrow_size_mobile | default: 13 }}px;
    letter-spacing: {{ st.eyebrow_letter_spacing | default: 1 }}px;
    line-height: 1.4;
    color: {% render 'scheme-color', color: st.eyebrow_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih__eyebrow { font-size: {{ st.eyebrow_size | default: 14 }}px; }
  }

  /* Heading sentence */
  #shopify-section-{{ section.id }} .iih__heading {
    margin: 0;
    font-family: var(--heading-font, inherit);
    font-size: {{ st.heading_size_mobile | default: 30 }}px;
    line-height: {{ st.heading_line_height | default: '1.15' }};
    letter-spacing: {{ st.heading_letter_spacing | default: 0 }}px;
    text-wrap: balance;
    color: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .iih__heading { font-size: {{ st.heading_size | default: 56 }}px; }
  }
  #shopify-section-{{ section.id }} .iih__text { white-space: normal; }

  /* Inline circular media */
  #shopify-section-{{ section.id }} .iih__media {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-inline: var(--iih-gap);
    transform: translateY(var(--iih-offset));
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .iih__link {
    display: inline-block;
    line-height: 0;
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .iih__img {
    position: relative;
    z-index: 1;
    width: var(--iih-d, var(--iih-img));
    height: var(--iih-d, var(--iih-img));
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: rgba(0, 0, 0, 0.04);
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .iih__img { width: var(--iih-img); height: var(--iih-img); }
  }
  #shopify-section-{{ section.id }} .iih__placeholder { fill: currentColor; color: var(--color-text); opacity: 0.35; }

  {%- unless st.show_on_mobile -%}
    @media (max-width: 767.98px) { #shopify-section-{{ section.id }} { display: none !important; } }
  {%- endunless -%}
{% comment %}{% endcomment %}</style>

<!-- ti-theme:start -->
<div data-editorial-controls="inline-image-heading" data-ec-section="{{ section.id }}" data-ec-section-settings="{{ section.settings | json | escape }}" data-ec-defaults='{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":false,"content_alignment":"center","show_eyebrow":true,"eyebrow":"Crafted with intention","eyebrow_size":14,"eyebrow_size_mobile":13,"eyebrow_weight":"body_weight","eyebrow_uppercase":false,"eyebrow_letter_spacing":1,"eyebrow_spacing_below":24,"heading_size":56,"heading_size_mobile":30,"heading_weight":"heading_weight","heading_line_height":"1.15","heading_letter_spacing":0,"image_size":64,"image_size_mobile":40,"image_gap":6,"image_offset_y":0,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":true,"padding_top":80,"padding_bottom":80,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"show_on_mobile":true,"padding_top_mobile":56,"padding_bottom_mobile":56,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"heading_tag":"h2"}' data-ec-block-defaults='{"text":{"text":"Your text here"},"image":{"size_override":0}}' class="iih section color-{{ color_scheme }} gradient">
  <div class="iih__inner">
    {%- if st.show_eyebrow and st.eyebrow != blank -%}
      <p class="iih__eyebrow {{ st.eyebrow_weight }}{% if st.eyebrow_uppercase %} uppercase{% endif %}">{{ st.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <{{ heading_tag }} class="iih__heading {{ st.heading_weight }}">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- if bs.text != blank -%}<span class="iih__text" data-block-id="{{ block.id }}" data-ec-block="{{ block.id }}" data-ec-type="{{ block.type }}" data-ec-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}>{{ bs.text }}</span>{{ ' ' }}{%- endif -%}
            {%- when 'image' -%}
              {%- assign col = bs.collection -%}
              {%- assign col_img = col.image | default: col.featured_image -%}
              {%- assign chosen = bs.image | default: col_img -%}
              <span class="iih__media" data-block-id="{{ block.id }}" data-ec-block="{{ block.id }}" data-ec-type="{{ block.type }}" data-ec-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.size_override > 0 %} style="--iih-d: {{ bs.size_override }}px;"{% endif %}>
                {%- if col != blank and col.url != blank -%}<a class="iih__link" href="{{ col.url }}" aria-label="{{ col.title | escape }}">{%- endif -%}
                {%- if chosen != blank -%}
                  <img
                    class="iih__img"
                    src="{{ chosen | image_url: width: 220 }}"
                    srcset="{{ chosen | image_url: width: 110 }} 110w,
                            {{ chosen | image_url: width: 220 }} 220w,
                            {{ chosen | image_url: width: 330 }} 330w,
                            {{ chosen | image_url: width: 480 }} 480w"
                    sizes="{{ st.image_size | default: 64 }}px"
                    width="{{ chosen.width }}"
                    height="{{ chosen.height }}"
                    alt="{{ bs.image.alt | default: col.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'iih__img iih__placeholder' }}
                {%- endif -%}
                {%- if col != blank and col.url != blank -%}</a>{%- endif -%}
              </span>{{ ' ' }}
          {%- endcase -%}
        {%- endfor -%}
      </{{ heading_tag }}>
    {%- endif -%}
  </div>
</div>
<!-- ti-theme:end -->



{% render 'editorial-initial-style', section: section, kind: 'inline-image-heading' %}
{{ 'editorial-controls.js' | asset_url | script_tag }}
</template>

<schema>
{
  "shopify": {
    "name": "Inline Image Heading",
    "tag": "section",
    "class": "section-inline-image-heading",
    "max_blocks": 30,
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "narrow",
            "label": "Narrow"
          },
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space around section",
        "default": false
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Top text"
      },
      {
        "type": "checkbox",
        "id": "show_eyebrow",
        "label": "Show eyebrow",
        "default": true
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow text",
        "default": "Crafted with intention"
      },
      {
        "type": "range",
        "id": "eyebrow_size",
        "label": "Eyebrow size (desktop)",
        "min": 8,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "eyebrow_size_mobile",
        "label": "Eyebrow size (mobile)",
        "min": 8,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "select",
        "id": "eyebrow_weight",
        "label": "Eyebrow weight",
        "default": "body_weight",
        "options": [
          {
            "value": "body_weight",
            "label": "Body"
          },
          {
            "value": "subheading_weight",
            "label": "Medium"
          },
          {
            "value": "heading_weight",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "eyebrow_uppercase",
        "label": "Uppercase eyebrow",
        "default": false
      },
      {
        "type": "range",
        "id": "eyebrow_letter_spacing",
        "label": "Eyebrow letter spacing",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "range",
        "id": "eyebrow_spacing_below",
        "label": "Space below eyebrow",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "range",
        "id": "heading_size",
        "label": "Heading size (desktop)",
        "min": 16,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "min": 12,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Heading weight",
        "default": "heading_weight",
        "options": [
          {
            "value": "body_weight",
            "label": "Body"
          },
          {
            "value": "subheading_weight",
            "label": "Medium"
          },
          {
            "value": "heading_weight",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "select",
        "id": "heading_line_height",
        "label": "Heading line height",
        "default": "1.15",
        "options": [
          {
            "value": "1",
            "label": "Tight (1.0)"
          },
          {
            "value": "1.1",
            "label": "Snug (1.1)"
          },
          {
            "value": "1.15",
            "label": "Normal (1.15)"
          },
          {
            "value": "1.25",
            "label": "Relaxed (1.25)"
          },
          {
            "value": "1.4",
            "label": "Loose (1.4)"
          }
        ]
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "min": -4,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Inline images"
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Image size (desktop)",
        "min": 24,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "image_size_mobile",
        "label": "Image size (mobile)",
        "min": 16,
        "max": 160,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "image_gap",
        "label": "Space around images",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "image_offset_y",
        "label": "Image vertical nudge",
        "min": -40,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Custom styling"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "eyebrow_color",
        "label": "Eyebrow color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Custom fonts"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 80
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 80
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "checkbox",
        "id": "show_on_mobile",
        "label": "Show on mobile",
        "default": true
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Compatibility",
        "visible_if": "{{ false }}"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading tag (SEO)",
        "default": "h2",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          },
          {
            "value": "h3",
            "label": "H3"
          },
          {
            "value": "p",
            "label": "Paragraph"
          }
        ],
        "visible_if": "{{ false }}"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Text",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Your text here"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image collection",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Link to collection"
          },
          {
            "type": "range",
            "id": "size_override",
            "label": "Size override (desktop)",
            "info": "0 uses section size",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "default": 0
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Inline Image Heading",
        "category": "Text",
