                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "text",
        "name": "Text",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Words",
            "default": "Your text here"
          }
        ]
      },
      {
        "type": "image",
        "name": "Image collection",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Link to collection",
            "info": "The picture links to this collection. With no image picked, the collection image shows."
          },
          {
            "type": "range",
            "id": "size_override",
            "label": "Image size (desktop)",
            "info": "0 uses the section size.",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "default": 0
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Inline Image Heading",
        "category": "Text",
        "settings": {
          "section_width": "fluid_container",
          "content_alignment": "center",
          "heading_size": 56,
          "heading_size_mobile": 30
        },
        "blocks": [
          {
            "type": "eyebrow",
            "settings": {
              "text": "Crafted with intention"
            }
          },
          {
            "type": "text",
            "settings": {
              "text": "Where bold"
            }
          },
          {
            "type": "image"
          },
          {
            "type": "text",
            "settings": {
              "text": "ideas meet beautiful"
            }
          },
          {
            "type": "image"
          },
          {
            "type": "text",
            "settings": {
              "text": "details and easy"
            }
          },
          {
            "type": "image"
          },
          {
            "type": "text",
            "settings": {
              "text": "everyday design."
            }
          }
        ]
      }
    ]
  }
}
