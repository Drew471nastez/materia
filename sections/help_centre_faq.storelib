<template>
<section class="hc hc--{{ settings.layout }} hc--align-{{ settings.align }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-heading: {{ settings.heading_color }}; --s-text: {{ settings.text_color }}; --s-border: {{ settings.border_color }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="hc__in hc__in--{{ settings.max_width }}">
    <div class="hc__grid">

      <div class="hc__aside">
        {% if settings.heading or settings.text %}
          <div class="hc__head">
            {% if settings.heading %}<h2 class="hc__h">{{ settings.heading | raw }}</h2>{% endif %}
            {% if settings.text %}<div class="hc__sub">{{ settings.text | raw }}</div>{% endif %}
          </div>
        {% endif %}

        {% if settings.contact_title or settings.contact_text or settings.button_text %}
          <div class="hc__contact">
            {% if settings.contact_title %}<h3 class="hc__ct">{{ settings.contact_title | raw }}</h3>{% endif %}
            {% if settings.contact_text %}<div class="hc__cp">{{ settings.contact_text | raw }}</div>{% endif %}
            {% if settings.button_text %}<a class="hc__btn" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
          </div>
        {% endif %}
      </div>

      <div class="hc__list">
        {% for block in blocks %}
          <details class="hc__item" data-block-id="{{ block.id }}"{% if settings.one_at_a_time %} name="{{ section.id }}-faq"{% endif %}{% if block.settings.open or forloop.first and settings.open_first %} open{% endif %}>
            <summary class="hc__q">
              <span class="hc__qt">{{ block.settings.question }}</span>
              {% if settings.icon_style == 'chevron' %}
                <svg class="hc__icon hc__icon--chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              {% else %}
                <svg class="hc__icon hc__icon--plus" viewBox="0 0 24 24" aria-hidden="true"><path class="hc__h-line" d="M5 12h14"/><path class="hc__v-line" d="M12 5v14"/></svg>
              {% endif %}
            </summary>
            <div class="hc__a">{{ block.settings.answer | raw }}</div>
          </details>
        {% else %}
          {% if page.in_editor %}<p class="hc__empty">Add questions in the sidebar</p>{% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>
</template>

<style scoped>
.hc { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); }
.hc__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.hc__in--narrow { max-width: 720px; }
.hc__in--medium { max-width: 960px; }
.hc__in--wide { max-width: var(--theme-page-width, 1280px); }

.hc__grid { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr); }
.hc__aside { display: contents; }
.hc__head { order: 1; max-width: 36rem; }
.hc__list { order: 2; min-width: 0; }
.hc__contact { order: 3; }

.hc__h { margin: 0; color: var(--s-heading); font-family: var(--section-heading-font, var(--theme-font-heading)); font-size: var(--section-heading-size, 36px); line-height: var(--section-heading-line-height, 1.15); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); overflow-wrap: break-word; }
.hc__sub { margin-top: 12px; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-text); }
.hc__sub > :first-child, .hc__cp > :first-child, .hc__a > :first-child { margin-top: 0; }
.hc__sub > :last-child, .hc__cp > :last-child, .hc__a > :last-child { margin-bottom: 0; }

.hc__contact { padding: 24px; border: 1px solid var(--s-border); border-radius: 8px; }
.hc__ct { margin: 0; font-family: var(--theme-font-heading); font-size: 18px; line-height: 1.3; font-weight: 600; color: var(--s-heading); }
.hc__cp { margin-top: 8px; font-size: 15px; line-height: 1.6; color: var(--s-text); }
.hc__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 16px; padding: 0 24px; border-radius: 8px; border: 1px solid var(--s-btn); background: var(--s-btn); color: var(--s-btn-text); font-size: 15px; font-weight: 600; text-decoration: none; transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease; }
.hc__btn:hover { background: var(--s-btn-hover); border-color: var(--s-btn-hover); color: var(--s-btn-hover-text); }
.hc__btn:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; }

.hc__item { border-bottom: 1px solid var(--s-border); }
.hc__item:first-child { border-top: 1px solid var(--s-border); }
.hc__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 20px 0; cursor: pointer; list-style: none; color: var(--s-heading); font-family: var(--theme-font-heading); font-size: 17px; line-height: 1.4; font-weight: 600; }
.hc__q::-webkit-details-marker { display: none; }
.hc__q::marker { content: ""; }
.hc__q:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 4px; border-radius: 4px; }
.hc__q:hover .hc__qt { opacity: 0.75; }
.hc__qt { transition: opacity 200ms ease; }

.hc__icon { flex: none; width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms ease; }
.hc__v-line { transform-origin: 12px 12px; transition: transform 200ms ease, opacity 200ms ease; }
.hc__item[open] .hc__v-line { transform: scaleY(0); opacity: 0; }
.hc__item[open] .hc__icon--chevron { transform: rotate(180deg); }

.hc__a { padding: 0 32px 24px 0; max-width: 40rem; font-size: 16px; line-height: 1.65; color: var(--s-text); }
.hc__item[open] .hc__a { animation: hc-in 200ms ease both; }
@keyframes hc-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

.hc__empty { margin: 0; padding: 32px 0; text-align: center; font-size: 14px; opacity: 0.6; }

.hc--stacked.hc--align-center .hc__head { justify-self: center; text-align: center; }

@container (min-width: 760px) {
  .hc--split .hc__grid { grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  .hc--split .hc__aside { display: flex; flex-direction: column; gap: 32px; position: sticky; top: 24px; }

  .hc--stacked .hc__grid { gap: 48px; }
  .hc--stacked .hc__aside { display: flex; flex-direction: column; gap: 24px; width: 100%; max-width: 760px; }
  .hc--stacked .hc__list { width: 100%; max-width: 760px; }
  .hc--stacked.hc--align-center .hc__aside, .hc--stacked.hc--align-center .hc__list { justify-self: center; }
  .hc--stacked.hc--align-center .hc__aside { text-align: center; }
  .hc--stacked.hc--align-center .hc__head { margin-inline: auto; }

  .hc__q { font-size: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  .hc__icon, .hc__v-line, .hc__btn, .hc__qt { transition: none; }
  .hc__item[open] .hc__a { animation: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "help_centre_faq",
  "name": "Help Centre FAQ",
  "category": "faq",
  "description": "Questions that open and close, beside a heading and a contact panel.",
  "version": "1.0.0",
  "icon": "help-circle",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions before you order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Delivery, returns, payment and tracking, answered in one place.</p>"
    },
    {
      "type": "header",
      "id": "hdr_contact",
      "label": "Contact panel"
    },
    {
      "type": "inline_richtext",
      "id": "contact_title",
      "label": "Panel title",
      "default": "Still have a question?"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Panel text",
      "default": "<p>Send us a message and we will reply within one working day.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/pages/contact"
    },
    {
      "type": "header",
      "id": "hdr_behaviour",
      "label": "Behaviour"
    },
    {
      "type": "toggle",
      "id": "open_first",
      "label": "Open the first answer",
      "default": true
    },
    {
      "type": "toggle",
      "id": "one_at_a_time",
      "label": "Keep one answer open at a time",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon",
      "default": "plus",
      "options": [
        {
          "label": "Plus",
          "value": "plus"
        },
        {
          "label": "Chevron",
          "value": "chevron"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        {
          "label": "Heading beside questions",
          "value": "split"
        },
        {
          "label": "Heading above questions",
          "value": "stacked"
        }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ],
      "visible_if": "{{ section.settings.layout == 'stacked' }}"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings and questions",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "scheme.text"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lines and borders",
      "default": "scheme.border"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 40,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders leave us within one to two working days. You will get an email with tracking as soon as yours ships.</p>"
        },
        {
          "type": "toggle",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": []
}
</schema>