<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Image With Text Steps.

  Image on one side, a vertical list of steps (blocks) on the other. "Marker
  style" picks the step marker: dot, outlined dot, numbered, outlined number,
  "01" prefix, or each step's own icon. Colours follow the colour scheme and
  the button follows Theme settings > Buttons until "Enable custom styling" or
  "Use theme button style" says otherwise. Every value is a CSS variable on
  the section root, so shopify/assets/media-live-stats-reels.js applies
  builder edits in place.
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign step_blocks    = section.blocks | where: 'type', 'step'
  assign button_blocks  = section.blocks | where: 'type', 'button'

  assign step_style = s.step_style | default: 'dot'
  assign custom = s.custom_colors
  assign placeholder_src = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23000000%22 fill-opacity=%220.18%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'

  case s.section_width
    when 'fluid_container'
      assign max_w = 'var(--fluid-container-width, 1500px)'
    when 'stretch_width'
      assign max_w = 'none'
    when 'full_width'
      assign max_w = 'none'
    else
      assign max_w = 'var(--theme-page-width, var(--page-width, 1300px))'
  endcase

  assign steps_custom_btn = true
  if s.use_theme_button
    assign steps_custom_btn = false
  endif
  assign btn_bg = ''
  assign btn_text = ''
  assign btn_hover = ''
  if custom
    assign btn_bg = s.button_bg
    assign btn_text = s.button_color
    assign btn_hover = s.button_bg_hover
  endif
-%}
{%- capture st_style -%}
--st-max: {{ max_w }}; --st-pt: {{ s.padding_top | default: 0 }}px; --st-pb: {{ s.padding_bottom | default: 0 }}px;
--st-px-m: {{ s.side_padding_mobile | default: 0 }}px; --st-px-d: {{ s.side_padding_desktop | default: 0 }}px;
--st-gap-m: {{ s.gap_mobile | default: 0 }}px; --st-gap-d: {{ s.gap_desktop | default: 0 }}px;
--st-dir: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %}; --st-valign: {{ s.column_valign | default: 'center' }};
--st-img-w: {{ s.image_width_pct | default: 50 }}%; --st-text-gap: {{ s.text_gap | default: 0 }}px;
--st-ratio-m: {{ s.image_aspect | default: '4 / 5' }}; --st-ratio-d: {{ s.image_aspect_desktop | default: '4 / 5' }}; --st-radius: {{ s.image_radius | default: 0 }}px;
--st-mk: {{ s.marker_size | default: 32 }}px; --st-mk-font: {{ s.marker_font_size | default: 14 }}px; --st-line-style: {{ s.line_style | default: 'solid' }}; --st-line-w: {{ s.line_thickness | default: 2 }}px;
--st-gap-inline: {{ s.step_gap_inline | default: 16 }}px; --st-gap-below: {{ s.step_gap_below | default: 22 }}px; --st-steps-mt: {{ s.steps_margin_top | default: 0 }}px; --st-btn-mt: {{ s.button_margin_top | default: 0 }}px;
{%- render 'media-msr-var', name: '--st-bg', color: s.section_bg, on: custom -%}
{%- render 'media-msr-var', name: '--st-mk-color', color: s.marker_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-mk-text', color: s.marker_text_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-line-color', color: s.line_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-title-color', color: s.step_title_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-desc-color', color: s.step_desc_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-img-bg', color: s.image_bg, on: custom -%}
{%- if custom -%}--st-title-size: {{ s.step_title_size | default: 18 }}px; --st-desc-size: {{ s.step_desc_size | default: 14 }}px;{%- endif -%}
{%- if s.enable_custom_fonts -%}
  {%- if s.heading_font.family != blank -%}--st-hfont: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'serif' }};{%- endif -%}
  {%- if s.body_font.family != blank -%}--st-bfont: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}

<style>
  {%- if s.enable_custom_fonts -%}
    {%- if s.heading_font.family != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.body_font.family != blank -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endif -%}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .iws-steps { background: var(--st-bg, var(--color-background)); }
  #shopify-section-{{ sid }} .iws {
    padding: var(--st-pt) var(--st-px-m) var(--st-pb) !important;
    font-family: var(--st-bfont, var(--body-font));
  }
  #shopify-section-{{ sid }} .iws *, #shopify-section-{{ sid }} .iws *::before, #shopify-section-{{ sid }} .iws *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .iws[data-width='full_width'] { padding-inline: 0 !important; }
  #shopify-section-{{ sid }} .iws[data-width='full_width'] .iws__media { border-radius: 0; }
  #shopify-section-{{ sid }} .iws[data-width='full_width'] .iws__col { padding-inline: var(--st-px-m); }
  #shopify-section-{{ sid }} .iws__inner {
    max-width: var(--st-max); margin-inline: auto;
    display: flex; flex-direction: column; gap: var(--st-gap-m);
  }

  /* Image column */
  #shopify-section-{{ sid }} .iws__media {
    flex: 0 0 100%; width: 100%; min-width: 0; position: relative; overflow: hidden;
    border-radius: var(--st-radius); aspect-ratio: var(--st-ratio-m);
    background: var(--st-img-bg, color-mix(in srgb, var(--color-text) 8%, var(--color-background)));
  }
  #shopify-section-{{ sid }} .iws__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Text column */
  #shopify-section-{{ sid }} .iws__col { flex: 1 1 100%; min-width: 0; display: flex; flex-direction: column; gap: var(--st-text-gap); }
  #shopify-section-{{ sid }} .iws__eyebrow {
    margin: 0; font-size: var(--b-size, var(--sl-caption-size, 12px)); font-weight: var(--sl-caption-weight, 600);
    text-transform: uppercase; letter-spacing: 0.18em; color: var(--b-color, var(--color-heading));
  }
  #shopify-section-{{ sid }} .iws__heading {
    margin: 0; color: var(--b-color, var(--color-heading)); font-family: var(--st-hfont, var(--heading-font));
    font-weight: var(--b-weight, var(--heading-weight, 700));
  }
  #shopify-section-{{ sid }} .iws__heading[data-custom] { line-height: 1.15; font-size: var(--b-size-m); }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .iws__sub { margin: 0; line-height: 1.6; color: var(--b-color, var(--color-text)); font-size: var(--b-size, inherit); max-width: var(--b-max, 560px); }
  #shopify-section-{{ sid }} .iws__heading a, #shopify-section-{{ sid }} .iws__sub a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .iws__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__sub p:last-child { margin: 0; }

  /* Steps */
  #shopify-section-{{ sid }} .iws__steps { margin: var(--st-steps-mt) 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  #shopify-section-{{ sid }} .iws__step {
    --mk: var(--b-mk, var(--st-mk-color, var(--color-heading, currentColor)));
    position: relative; display: grid; grid-template-columns: var(--st-mk) 1fr; gap: var(--st-gap-inline);
    padding: 0 0 var(--st-gap-below) 0; align-items: start;
  }
  #shopify-section-{{ sid }} .iws__step:not(:last-child)::before {
    content: ''; position: absolute; top: var(--st-mk); bottom: 0; width: 0;
    left: calc(var(--st-mk) / 2 - var(--st-line-w) / 2);
    border-left: var(--st-line-w) var(--st-line-style) var(--st-line-color, color-mix(in srgb, var(--color-heading, currentColor) 35%, transparent));
  }
  #shopify-section-{{ sid }} .iws__step-marker {
    width: var(--st-mk); height: var(--st-mk); display: inline-flex; align-items: center; justify-content: center;
    position: relative; z-index: 1; border-radius: 999px; line-height: 1; font-weight: 700; font-size: var(--st-mk-font);
    color: var(--st-mk-text, var(--color-background)); background: var(--mk); border: var(--st-line-w) solid var(--mk);
  }
  #shopify-section-{{ sid }} .iws__step-num, #shopify-section-{{ sid }} .iws__step-prefix { display: none; }
  #shopify-section-{{ sid }} :is(.iws__step--numbered, .iws__step--numbered_outline) .iws__step-num { display: inline; }
  #shopify-section-{{ sid }} .iws__step--prefixed .iws__step-prefix { display: inline; }
  #shopify-section-{{ sid }} :is(.iws__step--dot, .iws__step--dot_outline) .iws__step-marker {
    width: calc(var(--st-mk) / 2); height: calc(var(--st-mk) / 2); margin: calc(var(--st-mk) / 4) 0 0 calc(var(--st-mk) / 4);
  }
  #shopify-section-{{ sid }} .iws__step--dot .iws__step-marker { border: 0; }
  #shopify-section-{{ sid }} .iws__step--dot_outline .iws__step-marker { background: transparent; }
  #shopify-section-{{ sid }} .iws__step--numbered_outline .iws__step-marker { background: transparent; color: var(--mk); }
  #shopify-section-{{ sid }} .iws__step--prefixed { grid-template-columns: 1fr; }
  #shopify-section-{{ sid }} .iws__step--prefixed .iws__step-marker,
  #shopify-section-{{ sid }} .iws__step--prefixed:not(:last-child)::before { display: none; }
  #shopify-section-{{ sid }} .iws__step--icon .iws__step-marker { background: transparent; border: 0; color: var(--mk); }
  #shopify-section-{{ sid }} .iws__step-marker img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .iws__step:not(.iws__step--icon) .iws__step-marker img { display: none; }
  #shopify-section-{{ sid }} .iws__step-content { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  #shopify-section-{{ sid }} .iws__step-title {
    margin: 0; font-family: var(--st-hfont, var(--heading-font)); font-weight: var(--heading-weight, 700);
    font-size: var(--st-title-size, var(--sl-h4-size, 18px)); line-height: 1.3;
    color: var(--b-title, var(--st-title-color, var(--color-heading)));
  }
  #shopify-section-{{ sid }} .iws__step-prefix { color: var(--mk); margin-right: 6px; font-feature-settings: 'tnum'; }
  #shopify-section-{{ sid }} .iws__step-desc {
    margin: 0; font-size: var(--st-desc-size, var(--sl-body-small-size, 14px)); line-height: 1.55;
    color: var(--b-desc, var(--st-desc-color, var(--color-text)));
  }
  #shopify-section-{{ sid }} .iws__step-desc p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__step-desc p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .iws__step-desc a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  /* Button: paint, shape, type, hover effect and timing come from Theme
     settings > Buttons through the theme button contract
     (theme-button-contract.css). The section's own colours (Enable custom
     styling), and its size and shape when "Use theme button style" is off,
     enter as tokens from snippets/button-overrides. Only placement is set here. */
  #shopify-section-{{ sid }} .iws__btn { margin-top: var(--st-btn-mt); align-self: flex-start; width: max-content; max-width: 100%; }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iws { padding-inline: var(--st-px-d) !important; }
    #shopify-section-{{ sid }} .iws[data-width='full_width'] { padding-inline: 0 !important; }
    #shopify-section-{{ sid }} .iws[data-width='full_width'] .iws__col { padding-inline: var(--st-px-d); }
    #shopify-section-{{ sid }} .iws__inner { flex-direction: var(--st-dir); gap: var(--st-gap-d); align-items: var(--st-valign); }
    #shopify-section-{{ sid }} .iws__media {
      flex: 0 0 calc(var(--st-img-w) - var(--st-gap-d) / 2); max-width: calc(var(--st-img-w) - var(--st-gap-d) / 2);
      aspect-ratio: var(--st-ratio-d);
    }
    #shopify-section-{{ sid }} .iws__col { flex: 1 1 0; }
    #shopify-section-{{ sid }} .iws__heading[data-custom] { font-size: var(--b-size-d); }
  }
{% comment %}{% endcomment %}</style>

<div class="section iws-steps{{ reset_spacing }} color-{{ color_scheme }} gradient" data-msr="steps" data-msr-section="{{ sid }}" data-msr-settings="{{ s | json | escape }}" data-msr-defaults='{"color_scheme":"default-color-scheme","section_width":"container","reset_spacing":true,"image_position":"left","column_valign":"center","image_width_pct":50,"gap_desktop":64,"text_gap":18,"image_alt":"","image_aspect_desktop":"4 / 5","image_radius":16,"step_style":"dot","marker_size":32,"marker_font_size":14,"line_style":"solid","line_thickness":2,"step_gap_inline":16,"step_gap_below":22,"steps_margin_top":12,"custom_colors":false,"step_title_size":18,"step_desc_size":14,"use_theme_button":true,"button_size":15,"button_pad_x":26,"button_pad_y":14,"button_radius":100,"button_margin_top":8,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","padding_top":60,"padding_bottom":60,"side_padding_desktop":24,"image_aspect":"4 / 5","gap_mobile":32,"side_padding_mobile":16}' data-msr-block-defaults='{"eyebrow":{"text":"Why us","custom_style":false,"size":12},"heading":{"text":"Built for results.","tag":"h2","custom_style":false,"weight":"700","size_desktop":40,"size_mobile":28},"subheading":{"text":"&lt;p>Quality you can feel, simplicity you can trust.&lt;/p>","max_width":560,"custom_style":false,"size":15},"step":{"title":"Step title","description":"&lt;p>Add a short description that explains this step.&lt;/p>","enable_custom_style":false},"button":{"label":"Shop now"}}' data-msr-placeholder="{{ placeholder_src }}" style="{{ st_style | strip_newlines }}">
  <div class="iws" data-section-id="{{ sid }}" data-width="{{ s.section_width | default: 'container' }}">
    <div class="iws__inner">

      <div class="iws__media">
        {%- assign demo_iws = '' -%}
        {%- if s.image == blank -%}
          {%- capture demo_iws -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_iws = demo_iws | strip -%}
        {%- endif -%}
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', decoding: 'async', sizes: '(max-width: 767px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- elsif s.placeholder_url != blank -%}
          {{ s.placeholder_url | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', decoding: 'async', sizes: '(max-width: 767px) 100vw, 50vw' }}
        {%- elsif demo_iws != blank -%}
          <img src="{{ demo_iws }}" alt="" width="1200" height="1500" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder_src }}" alt="" width="400" height="300" loading="lazy" decoding="async">
        {%- endif -%}
      </div>

      <div class="iws__col">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="iws__eyebrow" data-msr-block="{{ block.id }}" data-msr-type="eyebrow" data-msr-settings="{{ bs | json | escape }}"{% if bs.text == blank %} hidden{% endif %}
                 style="{% if bs.custom_style %}--b-size: {{ bs.size | default: 12 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                 {{ block.shopify_attributes }}>{{ bs.text }}</p>
            {%- when 'heading' -%}
              <h2 class="iws__heading" data-msr-block="{{ block.id }}" data-msr-type="heading" data-msr-settings="{{ bs | json | escape }}"{% if bs.custom_style %} data-custom{% endif %}{% if bs.text == blank %} hidden{% endif %}
                 style="{% if bs.custom_style %}--b-size-m: {{ bs.size_mobile | default: 28 }}px; --b-size-d: {{ bs.size_desktop | default: 40 }}px; --b-weight: {{ bs.weight | default: 700 }};{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                 {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="iws__sub" data-msr-block="{{ block.id }}" data-msr-type="subheading" data-msr-settings="{{ bs | json | escape }}"{% if bs.text == blank %} hidden{% endif %}
                   style="--b-max: {{ bs.max_width | default: 560 }}px;{% if bs.custom_style %} --b-size: {{ bs.size | default: 15 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                   {{ block.shopify_attributes }}>{{ bs.text }}</div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if step_blocks.size > 0 -%}
          <ol class="iws__steps">
            {%- for block in step_blocks -%}
              {%- assign sb = block.settings -%}
              {%- assign step_class = step_style -%}
              {%- if sb.icon != blank -%}
                {%- assign step_class = 'icon' -%}
              {%- elsif step_style == 'icon' -%}
                {%- assign step_class = 'numbered_outline' -%}
              {%- endif -%}
              <li class="iws__step iws__step--{{ step_class }}" data-msr-block="{{ block.id }}" data-msr-type="step" data-msr-settings="{{ sb | json | escape }}" style="{% render 'media-msr-var', name: '--b-mk', color: sb.marker_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-title', color: sb.title_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-desc', color: sb.description_color, on: sb.enable_custom_style %}" {{ block.shopify_attributes }}>
                <div class="iws__step-marker" aria-hidden="true">
                  {%- if sb.icon != blank -%}
                    {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 40, height: 40 }}
                  {%- endif -%}
                  <span class="iws__step-num">{{ forloop.index }}</span>
                </div>
                <div class="iws__step-content">
                  <h3 class="iws__step-title"><span class="iws__step-prefix" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><span class="iws__step-text">{{ sb.title | default: fb_accessibility_step_title }}</span></h3>
                  <div class="iws__step-desc"{% if sb.description == blank %} hidden{% endif %}>{{ sb.description }}</div>
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- for block in button_blocks -%}
          {%- assign bs = block.settings -%}
          <a class="iws__btn btn-primary inline-flex no-underline" data-sl-button data-theme-button="primary" data-button-role="primary" data-button-appearance="{{ settings.btn_style | default: 'solid' }}" data-msr-block="{{ block.id }}" data-msr-type="button" data-msr-settings="{{ bs | json | escape }}" style="{%- render 'button-overrides', bg: btn_bg, text: btn_text, border: btn_bg, hover_bg: btn_hover, hover_text: btn_text, hover_border: btn_hover, custom: steps_custom_btn, radius: s.button_radius, padding_y: s.button_pad_y, padding_x: s.button_pad_x, font_size: s.button_size, weight: 600, border_width: 0 -%}" href="{{ bs.url | default: routes.all_products_collection_url }}"{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>
{%- comment -%} Live edits: shopify/assets/media-live-stats-reels.js (loaded on every page). {%- endcomment -%}



</template>

<schema>
{
  "type": "image-with-text-steps",
  "name": "Image With Text Steps",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Text, headings, markers and the button follow this scheme unless you pick your own colours below.",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "container",
      "info": "Default follows Theme settings › Layout › page width. Full width takes the image to the screen edge."
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove the theme's space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between text elements",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "info": "Describes the picture for screen readers.",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "placeholder_url",
      "label": "Fallback image",
      "info": "Shown when no image is picked."
    },
    {
      "type": "select",
      "id": "image_aspect_desktop",
      "label": "Image shape (desktop)",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Steps"
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Marker style",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Filled dot"
        },
        {
          "value": "dot_outline",
          "label": "Outlined dot"
        },
        {
          "value": "numbered",
          "label": "Numbered (filled)"
        },
        {
          "value": "numbered_outline",
          "label": "Numbered (outline)"
        },
        {
          "value": "prefixed",
          "label": "Prefix in title (01.)"
        },
        {
          "value": "icon",
          "label": "Custom icon (per step)"
        }
      ]
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "marker_font_size",
      "label": "Marker number size",
      "visible_if": "{{ section.settings.step_style != 'dot' and section.settings.step_style != 'dot_outline' and section.settings.step_style != 'prefixed' }}",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Connecting line style",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
