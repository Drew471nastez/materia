        "id": "image_aspect_desktop",
        "label": "Image shape (desktop)",
        "default": "4 / 5",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "4:5"
          },
          {
            "value": "3 / 4",
            "label": "3:4"
          },
          {
            "value": "16 / 9",
            "label": "16:9"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Steps"
      },
      {
        "type": "select",
        "id": "step_style",
        "label": "Marker style",
        "default": "dot",
        "options": [
          {
            "value": "dot",
            "label": "Filled dot"
          },
          {
            "value": "dot_outline",
            "label": "Outlined dot"
          },
          {
            "value": "numbered",
            "label": "Numbered (filled)"
          },
          {
            "value": "numbered_outline",
            "label": "Numbered (outline)"
          },
          {
            "value": "prefixed",
            "label": "Prefix in title (01.)"
          },
          {
            "value": "icon",
            "label": "Custom icon (per step)"
          }
        ]
      },
      {
        "type": "range",
        "id": "marker_size",
        "label": "Marker size",
        "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
        "min": 16,
        "max": 56,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "marker_font_size",
        "label": "Marker number size",
        "visible_if": "{{ section.settings.step_style != 'dot' and section.settings.step_style != 'dot_outline' and section.settings.step_style != 'prefixed' }}",
        "min": 10,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "select",
        "id": "line_style",
        "label": "Connecting line style",
        "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
        "default": "solid",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "dashed",
            "label": "Dashed"
          },
          {
            "value": "dotted",
            "label": "Dotted"
          }
        ]
      },
      {
        "type": "range",
        "id": "line_thickness",
        "label": "Line and outline thickness",
        "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
        "min": 1,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "step_gap_inline",
        "label": "Gap between marker and text",
        "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "step_gap_below",
        "label": "Gap between steps",
        "min": 8,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "steps_margin_top",
        "label": "Space above first step",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "custom_colors",
        "label": "Enable custom styling",
        "default": false,
        "info": "Colours, step text sizes and button colours. Off follows the colour scheme and Theme settings."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "info": "Leave empty to use the colour scheme's background.",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "marker_color",
        "label": "Marker",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "marker_text_color",
        "label": "Marker number",
        "visible_if": "{{ section.settings.custom_colors and section.settings.step_style == 'numbered' }}"
      },
      {
        "type": "color",
        "id": "line_color",
        "label": "Connecting line",
        "visible_if": "{{ section.settings.custom_colors and section.settings.step_style != 'prefixed' }}"
      },
      {
        "type": "color",
        "id": "step_title_color",
        "label": "Step title",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "step_desc_color",
        "label": "Step description",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "image_bg",
        "label": "Behind the image",
        "info": "Shows while the picture loads or around a transparent image.",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "range",
        "id": "step_title_size",
        "label": "Step title size",
        "visible_if": "{{ section.settings.custom_colors }}",
        "min": 14,
        "max": 26,
        "step": 1,
        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "step_desc_size",
        "label": "Step description size",
        "visible_if": "{{ section.settings.custom_colors }}",
        "min": 11,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "button_color",
        "label": "Button text",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "color",
        "id": "button_bg_hover",
        "label": "Button background on hover",
        "visible_if": "{{ section.settings.custom_colors }}"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Use theme button style",
        "info": "On: colours, size and shape follow Theme settings › Buttons. Off: set them below.",
        "default": true
      },
      {
        "type": "range",
        "id": "button_size",
        "label": "Button text size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 15,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_pad_x",
        "label": "Button horizontal padding",
        "min": 12,
        "max": 48,
        "step": 1,
        "unit": "px",
        "default": 26,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_pad_y",
        "label": "Button vertical padding",
        "min": 8,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 14,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 100,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_margin_top",
        "label": "Space above button",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "side_padding_desktop",
        "label": "Side padding (desktop)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "select",
        "id": "image_aspect",
        "label": "Image shape (mobile)",
        "default": "4 / 5",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "4:5"
          },
          {
            "value": "3 / 4",
            "label": "3:4"
          }
        ]
      },
      {
        "type": "range",
        "id": "gap_mobile",
        "label": "Gap between image and text (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "side_padding_mobile",
        "label": "Side padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Eyebrow text",
            "default": "Why us"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Enable custom styling",
            "info": "Off: follows the colour scheme and Theme settings › Typography.",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Font size",
            "visible_if": "{{ block.settings.custom_style }}",
            "min": 9,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 12
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading text",
            "default": "Built for results."
          },
          {
            "type": "select",
            "id": "tag",
            "label": "Heading tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              }
            ],
            "hidden": true,
            "info": "Kept for saved content. The heading is always an h2."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Enable custom styling",
            "info": "Off: colour, font, size and weight follow the colour scheme and Theme settings › Typography.",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Font weight",
            "visible_if": "{{ block.settings.custom_style }}",
            "default": "700",
            "options": [
              {
                "value": "400",
                "label": "Regular"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "visible_if": "{{ block.settings.custom_style }}",
            "min": 20,
            "max": 72,
            "step": 1,
            "unit": "px",
            "default": 40
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "visible_if": "{{ block.settings.custom_style }}",
            "min": 18,
            "max": 56,
            "step": 1,
            "unit": "px",
            "default": 28
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Subheading text",
            "default": "<p>Quality you can feel, simplicity you can trust.</p>"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 240,
            "max": 720,
            "step": 10,
            "unit": "px",
            "default": 560
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "custom_style",
            "label": "Enable custom styling",
            "info": "Off: colour, font and size follow the colour scheme and Theme settings › Typography.",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Font size",
            "visible_if": "{{ block.settings.custom_style }}",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 15
          }
        ]
      },
      {
        "type": "step",
        "name": "Step",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "title",
            "label": "Step title",
            "default": "Step title"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Step description",
            "default": "<p>Add a short description that explains this step.</p>"
          },
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Custom icon",
            "info": "Replaces the marker for this step."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "description_color",
            "label": "Description",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "marker_color",
            "label": "Marker",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image With Text Steps",
        "category": "Image and video",
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "Built for results."
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>Quality you can feel, simplicity you can trust.</p>"
            }
          },
          {
            "type": "step",
            "settings": {
              "title": "Made with care",
              "description": "<p>Every detail matters. Crafted to last.</p>"
            }
          },
          {
            "type": "step",
            "settings": {
              "title": "Tested by experts",
              "description": "<p>Real-world testing before it ever reaches you.</p>"
            }
          },
          {
            "type": "step",
            "settings": {
              "title": "Loved by customers",
              "description": "<p>Thousands of happy reviews and counting.</p>"
            }
          },
          {
            "type": "button",
            "settings": {
              "label": "Shop now"
            }
          }
        ]
      }
    ]
  }
}
