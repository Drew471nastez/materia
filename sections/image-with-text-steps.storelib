<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Steps

  Two-column layout: image on one side, vertical step list on the other.
  Each step is a block (title + description + optional custom icon).
  Section-level "Step style" picks the marker treatment:
    - dot          → small filled dot
    - dot_outline  → outlined dot
    - numbered     → filled circle with number (1, 2, 3…)
    - numbered_outline → outlined circle with number
    - prefixed     → text "01", "02", etc. inline before the title (no marker)
    - icon         → block's custom icon image
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign step_blocks    = section.blocks | where: 'type', 'step'
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks     = section.blocks | where: 'type', 'subheading'
  assign eyebrow_blocks = section.blocks | where: 'type', 'eyebrow'
  assign button_blocks  = section.blocks | where: 'type', 'button'

  assign step_style = s.step_style | default: 'dot'
  assign image_position = s.image_position | default: 'left'
  assign placeholder_src = s.placeholder_url | default: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E'
-%}
{%- capture mk_base -%}{% render 'scheme-color', color: s.marker_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- assign mk_color = 'var(--mk)' -%}
{%- capture line_color -%}{% render 'scheme-color', color: s.line_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .iws {
    container-type: inline-size;
    container-name: iws;
    padding-top:    {{ s.padding_top         | default: 60 }}px !important;
    padding-bottom: {{ s.padding_bottom      | default: 60 }}px !important;
    padding-left:   {{ s.side_padding_mobile | default: 16 }}px !important;
    padding-right:  {{ s.side_padding_mobile | default: 16 }}px !important;
  }
  {%- if s.section_bg != blank and s.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .iws { background: {{ s.section_bg }}; }
  {%- endif -%}
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws {
      padding-left:  {{ s.side_padding_desktop | default: 24 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 24 }}px !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws {
      padding-left:  {{ s.side_padding_desktop | default: 24 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 24 }}px !important;
    }
  }

  #shopify-section-{{ sid }} .iws__inner {
    {%- case s.section_width -%}
      {%- when 'fluid_container' -%} max-width: var(--fluid-container-width, 1500px);
      {%- when 'stretch_width' -%} max-width: none;
      {%- when 'full_width' -%} max-width: none;
      {%- else -%} max-width: var(--theme-page-width, var(--page-width, 1300px));
    {%- endcase -%}
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: {{ s.gap_mobile | default: 32 }}px;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__inner {
      flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 64 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__inner {
      flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 64 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }

  /* Image column */
  #shopify-section-{{ sid }} .iws__media {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    border-radius: {{ s.image_radius | default: 16 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'color-mix(in srgb, var(--color-text) 8%, var(--color-background))' %};
    aspect-ratio: {{ s.image_aspect | default: '4 / 5' }};
    position: relative;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  #shopify-section-{{ sid }} .iws__media img,
  #shopify-section-{{ sid }} .iws__media svg {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text column */
  #shopify-section-{{ sid }} .iws__col {
    flex: 1 1 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: {{ s.text_gap | default: 18 }}px;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__col { flex: 1 1 0; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__col { flex: 1 1 0; }
  }

  /* Text blocks follow the colour scheme and Theme settings > Typography
     until a block's "Use custom style" is switched on. */
  #shopify-section-{{ sid }} .iws__eyebrow {
    margin: 0;
    font-family: var(--theme-font-body, inherit);
    font-size: var(--sl-caption-size, 12px);
    font-weight: var(--sl-caption-weight, 600);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-heading);
  }
  #shopify-section-{{ sid }} .iws__eyebrow--custom {
    font-size: var(--iws-e-size);
    color: var(--iws-e-color);
  }
  #shopify-section-{{ sid }} .iws__heading { margin: 0; color: var(--color-heading); }
  #shopify-section-{{ sid }} .iws__heading--custom {
    color: var(--iws-h-color);
    font-size: var(--iws-h-size-m);
    font-weight: var(--iws-h-weight);
    line-height: 1.15;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__heading--custom { font-size: var(--iws-h-size-d); }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__heading--custom { font-size: var(--iws-h-size-d); }
  }
  #shopify-section-{{ sid }} .iws__sub {
    margin: 0;
    font-family: var(--theme-font-body, inherit);
    line-height: 1.6;
    color: var(--color-text);
  }
  #shopify-section-{{ sid }} .iws__sub--custom {
    font-size: var(--iws-s-size);
    color: var(--iws-s-color);
  }
  #shopify-section-{{ sid }} .iws__heading a,
  #shopify-section-{{ sid }} .iws__sub a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .iws__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__sub p:last-child { margin: 0; }

  /* Steps list */
  #shopify-section-{{ sid }} .iws__steps {
    margin: {{ s.steps_margin_top | default: 12 }}px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  #shopify-section-{{ sid }} .iws__step {
    --mk: {{ mk_base }};
    position: relative;
    display: grid;
    grid-template-columns: {{ s.marker_size | default: 32 }}px 1fr;
    gap: {{ s.step_gap_inline | default: 16 }}px;
    padding: 0 0 {{ s.step_gap_below | default: 22 }}px 0;
  }
  /* connecting line */
  #shopify-section-{{ sid }} .iws__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: {{ s.marker_size | default: 32 }}px;
    bottom: 0;
    left: calc({{ s.marker_size | default: 32 | divided_by: 2 }}px - {{ s.line_thickness | default: 2 | divided_by: 2 }}px);
    width: 0;
    border-left: {{ s.line_thickness | default: 2 }}px {{ s.line_style | default: 'solid' }} {{ line_color }};
    background: transparent;
  }
  #shopify-section-{{ sid }} .iws__step-marker {
    width: {{ s.marker_size | default: 32 }}px;
    height: {{ s.marker_size | default: 32 }}px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {% render 'scheme-color', color: s.marker_text_color, fallback: 'var(--color-background)' %};
    font-weight: 700;
    font-size: {{ s.marker_font_size | default: 14 }}px;
    line-height: 1;
    border-radius: 999px;
    background: {{ mk_color }};
    border: {{ s.line_thickness | default: 2 }}px solid {{ mk_color }};
  }
  #shopify-section-{{ sid }} .iws__step--dot .iws__step-marker {
    width: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    border: 0;
  }
  #shopify-section-{{ sid }} .iws__step--dot_outline .iws__step-marker {
    background: transparent;
    border: {{ s.line_thickness | default: 2 }}px solid {{ mk_color }};
    width: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
  }
  #shopify-section-{{ sid }} .iws__step--numbered_outline .iws__step-marker {
    background: transparent;
    color: {{ mk_color }};
  }
  #shopify-section-{{ sid }} .iws__step--prefixed { grid-template-columns: 1fr; }
  #shopify-section-{{ sid }} .iws__step--prefixed .iws__step-marker,
  #shopify-section-{{ sid }} .iws__step--prefixed:not(:last-child)::before { display: none; }
  #shopify-section-{{ sid }} .iws__step--icon .iws__step-marker {
    background: transparent;
    border: 0;
    color: {{ mk_color }};
  }
  #shopify-section-{{ sid }} .iws__step-marker img,
  #shopify-section-{{ sid }} .iws__step-marker svg {
    width: 100%; height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .iws__step-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ sid }} .iws__step-title {
    margin: 0;
    font-weight: var(--heading-weight, 700);
    font-size: {{ s.step_title_size | default: 18 }}px;
    line-height: 1.3;
    color: {% render 'scheme-color', color: s.step_title_color, fallback: 'var(--color-heading)' %};
  }
  #shopify-section-{{ sid }} .iws__step-prefix {
    color: {{ mk_color }};
    margin-right: 6px;
    font-feature-settings: 'tnum';
  }
  #shopify-section-{{ sid }} .iws__step-desc {
    margin: 0;
    font-size: {{ s.step_desc_size | default: 14 }}px;
    line-height: 1.55;
    color: {% render 'scheme-color', color: s.step_desc_color, fallback: 'var(--color-text)' %};
  }
  #shopify-section-{{ sid }} .iws__step-desc p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__step-desc p:last-child { margin: 0; }

  /* Button: paint, shape, type, hover effect and timing come from Theme
     settings > Buttons through the theme button contract
     (theme-button-contract.css). The section's own colours, and its size and
     shape when "Use theme button style" is off, enter as tokens from
     snippets/button-overrides. Only placement is set here. */
  #shopify-section-{{ sid }} .iws__btn {
    margin-top: {{ s.button_margin_top | default: 8 }}px;
    align-self: flex-start;
    width: max-content;
    max-width: 100%;
  }
{% comment %}{% endcomment %}</style>

<div class="section{{ reset_spacing }} color-{{ color_scheme }} gradient">
  <div class="iws" data-section-id="{{ sid }}">
    <div class="iws__inner">

      <div class="iws__media">
        {%- assign demo_iws = '' -%}
        {%- if s.image == blank -%}
          {%- capture demo_iws -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_iws = demo_iws | strip -%}
        {%- endif -%}
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- elsif s.placeholder_url != blank -%}
          {{ s.placeholder_url | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw' }}
        {%- elsif demo_iws != blank -%}
          <img src="{{ demo_iws }}" alt="" loading="lazy">
        {%- else -%}
          <img src="{{ placeholder_src }}" alt="" loading="lazy">
        {%- endif -%}
      </div>

      <div class="iws__col">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="iws__eyebrow{% if bs.custom_style %} iws__eyebrow--custom{% endif %}"
                   {% if bs.custom_style %}style="--iws-e-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}; --iws-e-size: {{ bs.size | default: 12 }}px;"{% endif %}
                   {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                {%- assign h_tag = bs.tag | default: 'h2' -%}
                <{{ h_tag }} class="iws__heading{% if bs.custom_style %} iws__heading--custom{% endif %}"
                   {% if bs.custom_style %}style="--iws-h-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}; --iws-h-size-m: {{ bs.size_mobile | default: 28 }}px; --iws-h-size-d: {{ bs.size_desktop | default: 40 }}px; --iws-h-weight: {{ bs.weight | default: 700 }};"{% endif %}
                   {{ block.shopify_attributes }}>{{ bs.text }}</{{ h_tag }}>
              {%- endif -%}
            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="iws__sub{% if bs.custom_style %} iws__sub--custom{% endif %}"
                     style="max-width: {{ bs.max_width | default: 560 }}px;{% if bs.custom_style %} --iws-s-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}; --iws-s-size: {{ bs.size | default: 15 }}px;{% endif %}"
                     {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if step_blocks.size > 0 -%}
          <ol class="iws__steps">
            {%- for block in step_blocks -%}
              {%- assign sb = block.settings -%}
              {%- assign step_class = step_style -%}
              {%- if sb.icon != blank -%}
                {%- assign step_class = 'icon' -%}
              {%- elsif step_style == 'icon' -%}
                {%- assign step_class = 'numbered_outline' -%}
              {%- endif -%}
              <li class="iws__step iws__step--{{ step_class }}"{% if sb.marker_color != blank and sb.marker_color.alpha != 0 %} style="--mk: {{ sb.marker_color }};"{% endif %} {{ block.shopify_attributes }}>
                <div class="iws__step-marker" aria-hidden="true">
                  {%- if sb.icon != blank -%}
                    {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
                  {%- elsif step_class == 'numbered' or step_class == 'numbered_outline' -%}
                    {{ forloop.index }}
                  {%- endif -%}
                </div>
                <div class="iws__step-content">
                  <h3 class="iws__step-title" style="{% if sb.title_color != blank and sb.title_color.alpha != 0 %}color: {{ sb.title_color }};{% endif %}">
                    {%- if step_style == 'prefixed' -%}
                      <span class="iws__step-prefix">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                    {%- endif -%}
                    {{ sb.title | default: fb_accessibility_step_title | escape }}
                  </h3>
                  {%- if sb.description != blank -%}
                    <div class="iws__step-desc" style="{% if sb.description_color != blank and sb.description_color.alpha != 0 %}color: {{ sb.description_color }};{% endif %}">{{ sb.description }}</div>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- liquid
          assign steps_custom_btn = true
          if s.use_theme_button
            assign steps_custom_btn = false
          endif
        -%}
        {%- for block in button_blocks -%}
          {%- assign bs = block.settings -%}
          {%- if bs.label != blank -%}
            <a class="iws__btn btn-primary inline-flex no-underline" data-sl-button data-theme-button="primary" data-button-role="primary" data-button-appearance="{{ settings.btn_style | default: 'solid' }}" style="{%- render 'button-overrides', bg: s.button_bg, text: s.button_color, border: s.button_bg, hover_bg: s.button_bg_hover, hover_text: s.button_color, hover_border: s.button_bg_hover, custom: steps_custom_btn, radius: s.button_radius, padding_y: s.button_pad_y, padding_x: s.button_pad_x, font_size: s.button_size, weight: 600, border_width: 0 -%}" href="{{ bs.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-with-text-steps",
  "name": "Image With Text Steps",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between text elements",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "info": "Describes the picture for screen readers.",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "placeholder_url",
      "label": "Fallback image",
      "info": "Shown when no image is picked above."
    },
    {
      "type": "select",
      "id": "image_aspect_desktop",
      "label": "Aspect ratio (desktop)",
