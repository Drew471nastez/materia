<template compat="shopify">
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Text Steps

  Two-column layout: image on one side, vertical step list on the other.
  Each step is a block (title + description + optional custom icon).
  Section-level "Step style" picks the marker treatment:
    - dot          → small filled dot
    - dot_outline  → outlined dot
    - numbered     → filled circle with number (1, 2, 3…)
    - numbered_outline → outlined circle with number
    - prefixed     → text "01", "02", etc. inline before the title (no marker)
    - icon         → block's custom icon image
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign step_blocks    = section.blocks | where: 'type', 'step'
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks     = section.blocks | where: 'type', 'subheading'
  assign eyebrow_blocks = section.blocks | where: 'type', 'eyebrow'
  assign button_blocks  = section.blocks | where: 'type', 'button'

  assign step_style = s.step_style | default: 'dot'
  assign image_position = s.image_position | default: 'left'
  assign placeholder_src = s.placeholder_url | default: 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .iws {
    container-type: inline-size;
    container-name: iws;
    padding-top:    {{ s.padding_top         | default: 60 }}px !important;
    padding-bottom: {{ s.padding_bottom      | default: 60 }}px !important;
    padding-left:   {{ s.side_padding_mobile | default: 16 }}px !important;
    padding-right:  {{ s.side_padding_mobile | default: 16 }}px !important;
    background: {{ s.section_bg | default: '#FFFFFF' }};
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws {
      padding-left:  {{ s.side_padding_desktop | default: 24 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 24 }}px !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws {
      padding-left:  {{ s.side_padding_desktop | default: 24 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 24 }}px !important;
    }
  }

  #shopify-section-{{ sid }} .iws__inner {
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: {{ s.gap_mobile | default: 32 }}px;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__inner {
      flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 64 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__inner {
      flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 64 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }

  /* Image column */
  #shopify-section-{{ sid }} .iws__media {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    border-radius: {{ s.image_radius | default: 16 }}px;
    overflow: hidden;
    background: {{ s.image_bg | default: '#F4EEE7' }};
    aspect-ratio: {{ s.image_aspect | default: '4 / 5' }};
    position: relative;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 64 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  #shopify-section-{{ sid }} .iws__media img,
  #shopify-section-{{ sid }} .iws__media svg {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text column */
  #shopify-section-{{ sid }} .iws__col {
    flex: 1 1 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: {{ s.text_gap | default: 18 }}px;
  }
  @container iws (min-width: 760px) {
    #shopify-section-{{ sid }} .iws__col { flex: 1 1 0; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iws__col { flex: 1 1 0; }
  }

  #shopify-section-{{ sid }} .iws__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  #shopify-section-{{ sid }} .iws__heading {
    margin: 0;
    font-weight: 700;
    line-height: 1.1;
  }
  #shopify-section-{{ sid }} .iws__sub {
    margin: 0;
    line-height: 1.55;
  }
  #shopify-section-{{ sid }} .iws__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__sub p:last-child { margin: 0; }

  /* Steps list */
  #shopify-section-{{ sid }} .iws__steps {
    margin: {{ s.steps_margin_top | default: 12 }}px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  #shopify-section-{{ sid }} .iws__step {
    position: relative;
    display: grid;
    grid-template-columns: {{ s.marker_size | default: 32 }}px 1fr;
    gap: {{ s.step_gap_inline | default: 16 }}px;
    padding: 0 0 {{ s.step_gap_below | default: 22 }}px 0;
  }
  /* connecting line */
  #shopify-section-{{ sid }} .iws__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: {{ s.marker_size | default: 32 }}px;
    bottom: 0;
    left: calc({{ s.marker_size | default: 32 | divided_by: 2 }}px - {{ s.line_thickness | default: 2 | divided_by: 2 }}px);
    width: {{ s.line_thickness | default: 2 }}px;
    background: {{ s.line_color | default: '#1F1F8C' }};
    {%- if step_style == 'numbered_outline' or step_style == 'dot_outline' -%}
      border-left: {{ s.line_thickness | default: 2 }}px {{ s.line_style | default: 'solid' }} {{ s.line_color | default: '#1F1F8C' }};
      background: transparent;
      width: 0;
    {%- endif -%}
  }
  #shopify-section-{{ sid }} .iws__step-marker {
    width: {{ s.marker_size | default: 32 }}px;
    height: {{ s.marker_size | default: 32 }}px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.marker_text_color | default: '#FFFFFF' }};
    font-weight: 700;
    font-size: {{ s.marker_font_size | default: 14 }}px;
    line-height: 1;
    border-radius: 999px;
    background: {{ s.marker_color | default: '#1F1F8C' }};
    border: {{ s.line_thickness | default: 2 }}px solid {{ s.marker_color | default: '#1F1F8C' }};
  }
  #shopify-section-{{ sid }} .iws__step--dot .iws__step-marker {
    width: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    border: 0;
  }
  #shopify-section-{{ sid }} .iws__step--dot_outline .iws__step-marker {
    background: transparent;
    border: {{ s.line_thickness | default: 2 }}px solid {{ s.marker_color | default: '#1F1F8C' }};
    width: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    height: {{ s.marker_size | default: 32 | divided_by: 2 }}px;
    margin-top: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
    margin-left: calc({{ s.marker_size | default: 32 | divided_by: 4 }}px);
  }
  #shopify-section-{{ sid }} .iws__step--numbered_outline .iws__step-marker {
    background: transparent;
    color: {{ s.marker_color | default: '#1F1F8C' }};
  }
  #shopify-section-{{ sid }} .iws__step--icon .iws__step-marker {
    background: transparent;
    border: 0;
    color: {{ s.marker_color | default: '#1F1F8C' }};
  }
  #shopify-section-{{ sid }} .iws__step-marker img,
  #shopify-section-{{ sid }} .iws__step-marker svg {
    width: 100%; height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .iws__step-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ sid }} .iws__step-title {
    margin: 0;
    font-weight: 700;
    font-size: {{ s.step_title_size | default: 18 }}px;
    line-height: 1.3;
    color: {{ s.step_title_color | default: '#1F1F8C' }};
  }
  #shopify-section-{{ sid }} .iws__step-prefix {
    color: {{ s.marker_color | default: '#1F1F8C' }};
    margin-right: 6px;
    font-feature-settings: 'tnum';
  }
  #shopify-section-{{ sid }} .iws__step-desc {
    margin: 0;
    font-size: {{ s.step_desc_size | default: 14 }}px;
    line-height: 1.55;
    color: {{ s.step_desc_color | default: '#5856A4' }};
  }
  #shopify-section-{{ sid }} .iws__step-desc p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iws__step-desc p:last-child { margin: 0; }

  /* Button */
  #shopify-section-{{ sid }} .iws__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: {{ s.button_margin_top | default: 8 }}px;
    padding: {{ s.button_pad_y | default: 14 }}px {{ s.button_pad_x | default: 26 }}px;
    background: {{ s.button_bg | default: '#1F1F8C' }};
    color: {{ s.button_color | default: '#FFFFFF' }};
    border-radius: {{ s.button_radius | default: 999 }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: {{ s.button_size | default: 15 }}px;
    transition: transform 0.18s ease, background 0.18s ease;
    align-self: flex-start;
    width: max-content;
  }
  #shopify-section-{{ sid }} .iws__btn:hover {
    background: {{ s.button_bg_hover | default: '#000084' }};
    transform: translateY(-1px);
  }
{% comment %}{% endcomment %}</style>

<div class="section{{ reset_spacing }}">
  <div class="iws" data-section-id="{{ sid }}">
    <div class="iws__inner">

      <div class="iws__media">
        {%- assign demo_iws = '' -%}
        {%- if s.image == blank -%}
          {%- capture demo_iws -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_iws = demo_iws | strip -%}
        {%- endif -%}
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- elsif demo_iws != blank -%}
          <img src="{{ demo_iws }}" alt="" loading="lazy">
        {%- else -%}
          <img src="{{ placeholder_src }}" alt="" loading="lazy">
        {%- endif -%}
      </div>

      <div class="iws__col">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="iws__eyebrow"
                   style="color: {{ bs.color | default: '#000000' }}; font-size: {{ bs.size | default: 12 }}px;"
                   {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} class="iws__heading"
                   style="color: {{ bs.color | default: '#000000' }}; font-size: {{ bs.size_mobile | default: 28 }}px;"
                   {{ block.shopify_attributes }}>{{ bs.text | escape }}</{{ bs.tag | default: 'h2' }}>
              {%- endif -%}
            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="iws__sub"
                     style="color: {{ bs.color | default: '#000000' }}; font-size: {{ bs.size | default: 15 }}px; max-width: {{ bs.max_width | default: 560 }}px;"
                     {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if step_blocks.size > 0 -%}
          <ul class="iws__steps">
            {%- for block in step_blocks -%}
              {%- assign sb = block.settings -%}
              {%- assign step_class = step_style -%}
              {%- if sb.icon != blank -%}{%- assign step_class = 'icon' -%}{%- endif -%}
              <li class="iws__step iws__step--{{ step_class }}" {{ block.shopify_attributes }}>
                <div class="iws__step-marker"
                     style="{% if sb.marker_color != blank %}background: {{ sb.marker_color }}; border-color: {{ sb.marker_color }};{% endif %}">
                  {%- if sb.icon != blank -%}
                    {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy' }}
                  {%- elsif step_style == 'numbered' or step_style == 'numbered_outline' -%}
                    {{ forloop.index }}
                  {%- elsif step_style == 'dot' or step_style == 'dot_outline' -%}
                  {%- endif -%}
                </div>
                <div class="iws__step-content">
                  <p class="iws__step-title" style="{% if sb.title_color != blank %}color: {{ sb.title_color }};{% endif %}">
                    {%- if step_style == 'prefixed' -%}
                      <span class="iws__step-prefix">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                    {%- endif -%}
                    {{ sb.title | default: fb_accessibility_step_title | escape }}
                  </p>
                  {%- if sb.description != blank -%}
                    <div class="iws__step-desc" style="{% if sb.description_color != blank %}color: {{ sb.description_color }};{% endif %}">{{ sb.description }}</div>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- for block in button_blocks -%}
          {%- assign bs = block.settings -%}
          {%- if bs.label != blank -%}
            <a class="iws__btn" href="{{ bs.url | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-with-text-steps",
  "name": "Image With Text Steps",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Column vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Vertical gap between text elements",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Lifestyle image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "placeholder_url",
      "label": "Fallback image URL",
      "info": "Used when no image is picked. Defaults to a sample lookbook placeholder."
    },
    {
      "type": "select",
      "id": "image_aspect_desktop",
      "label": "Aspect ratio (desktop)",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect",
      "label": "Aspect ratio (mobile)",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image placeholder bg",
      "default": "#F4EEE7"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Step style"
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Marker style",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Filled dot"
        },
        {
          "value": "dot_outline",
          "label": "Outlined dot"
        },
        {
          "value": "numbered",
          "label": "Numbered (filled)"
        },
        {
          "value": "numbered_outline",
          "label": "Numbered (outline)"
        },
        {
          "value": "prefixed",
          "label": "Prefix in title (01.)"
        },
        {
          "value": "icon",
          "label": "Custom icon (per step)"
        }
      ]
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker color",
      "default": "#1F1F8C"
    },
    {
      "type": "color",
      "id": "marker_text_color",
      "label": "Marker text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Connecting line color",
      "default": "#1F1F8C"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ]
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "marker_font_size",
      "label": "Marker text size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "step_gap_inline",
      "label": "Marker → text gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "step_gap_below",
      "label": "Vertical gap between steps",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "steps_margin_top",
      "label": "Space above first step",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Step text"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title color",
      "default": "#1F1F8C"
    },
    {
