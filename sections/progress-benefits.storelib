<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Progress Circles
  Two-column: heading/subheading on the left, 2×2 stat grid (percent + ring + label)
  on the right. Block-based: heading, subheading, stat, footnote.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.text_position
    when 'right'
      assign _flex_dir = 'row-reverse'
    else
      assign _flex_dir = 'row'
  endcase

  case st.text_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.text_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase
-%}

<style>
  {%- if st.enable_custom_fonts and st.body_font -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} :is(p, div, span, a, li) {
      font-family: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};
      font-weight: {{ st.body_font.weight }};
    }
  {%- endif -%}
  {%- if st.enable_custom_fonts and st.heading_font -%}
    #shopify-section-{{ sid }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
      font-weight: {{ st.heading_font.weight }};
    }
  {%- endif -%}

  #shopify-section-{{ sid }} {
    background-color: {{ st.section_bg | default: '#FFFFFF' }};
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
  {%- endif -%}

  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pgc__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pgc__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .pgc__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  #shopify-section-{{ sid }} .pgc {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgc {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .pgc__inner { width: 100%; box-sizing: border-box; }

  #shopify-section-{{ sid }} .pgc__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 36 }}px;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .pgc__grid {
      flex-direction: {{ _flex_dir }};
      gap: {{ st.gap_desktop | default: 80 }}px;
      align-items: flex-start;
    }
  }
  #shopify-section-{{ sid }} .pgc__col-text,
  #shopify-section-{{ sid }} .pgc__col-stats { width: 100%; box-sizing: border-box; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .pgc__col-text  { width: {{ st.text_column_width | default: 42 }}%; }
    #shopify-section-{{ sid }} .pgc__col-stats { width: calc(100% - {{ st.text_column_width | default: 42 }}%); }
  }

  /* Text column */
  #shopify-section-{{ sid }} .pgc__col-text {
    display: flex;
    flex-direction: column;
    gap: {{ st.text_gap | default: 22 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {{ st.text_color | default: '#0F172A' }};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .pgc__col-text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .pgc__col-text > * { margin: 0; max-width: 100%; }
  /* Tighter override: vertical gap between heading and subheading specifically */
  #shopify-section-{{ sid }} .pgc__heading + .pgc__subheading,
  #shopify-section-{{ sid }} .pgc__subheading + .pgc__subheading,
  #shopify-section-{{ sid }} .pgc__heading   + .pgc__heading {
    margin-top: calc({{ st.heading_subheading_gap | default: 14 }}px - {{ st.text_gap | default: 22 }}px);
  }

  #shopify-section-{{ sid }} .pgc__heading {
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .pgc__subheading {
    line-height: 1.6;
    max-width: 480px;
  }
  #shopify-section-{{ sid }} .pgc__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .pgc__subheading p:last-child { margin: 0; }

  /* per-block heading / subheading / footnote */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .pgc__heading[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#0F172A' }};
        font-size: {{ bs.size_mobile | default: 32 }}px;
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
      }
      #shopify-section-{{ sid }} .pgc__heading[data-block-id="{{ block.id }}"] em {
        color: {{ bs.accent_color | default: '#7C3AED' }};
        font-style: normal;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .pgc__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 44 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .pgc__subheading[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#475569' }};
        font-size: {{ bs.size_mobile | default: 14 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .pgc__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 16 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'footnote' -%}
      #shopify-section-{{ sid }} .pgc__footnote[data-block-id="{{ block.id }}"],
      #shopify-section-{{ sid }} .pgc__footnote[data-block-id="{{ block.id }}"] * {
        color: {{ bs.color | default: '#4E4E4E' }} !important;
      }
      #shopify-section-{{ sid }} .pgc__footnote[data-block-id="{{ block.id }}"] {
        font-size: {{ bs.size | default: 12 }}px;
        margin-top: {{ bs.margin_top | default: 24 }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  /* Stats grid */
  #shopify-section-{{ sid }} .pgc__stats {
    display: grid;
    grid-template-columns: repeat({{ st.stats_per_row_mobile | default: 1 }}, minmax(0, 1fr));
    gap: {{ st.stat_gap_mobile | default: 28 }}px {{ st.stat_gap_x_mobile | default: 20 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgc__stats {
      grid-template-columns: repeat({{ st.stats_per_row_desktop | default: 2 }}, minmax(0, 1fr));
      gap: {{ st.stat_gap_desktop | default: 40 }}px {{ st.stat_gap_x_desktop | default: 32 }}px;
    }
  }

  #shopify-section-{{ sid }} .pgc__stat {
    display: flex;
    flex-direction: column;
    gap: {{ st.stat_inner_gap | default: 10 }}px;
    color: {{ st.stat_text_color | default: '#475569' }};
  }
  #shopify-section-{{ sid }} .pgc__stat-row {
    display: flex;
    align-items: center;
    gap: {{ st.percent_ring_gap | default: 8 }}px;
  }
  #shopify-section-{{ sid }} .pgc__stat-percent {
    font-size: {{ st.percent_size_mobile | default: 40 }}px;
    line-height: 1;
    font-weight: 800;
    color: {{ st.percent_color | default: '#0F172A' }};
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgc__stat-percent {
      font-size: {{ st.percent_size_desktop | default: 48 }}px;
    }
  }
  #shopify-section-{{ sid }} .pgc__stat-ring {
    width: {{ st.ring_size | default: 37 }}px;
    height: {{ st.ring_size | default: 37 }}px;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .pgc__stat-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); display: block; }
  #shopify-section-{{ sid }} .pgc__ring-bg   { stroke: {{ st.ring_track | default: '#E5E7EB' }}; }
  #shopify-section-{{ sid }} .pgc__ring-fill {
    stroke-linecap: round;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #shopify-section-{{ sid }} .pgc__stat-label {
    font-size: {{ st.label_size | default: 14 }}px;
    line-height: 1.45;
  }
  #shopify-section-{{ sid }} .pgc__stat-label p { margin: 0; }

  /* gentle reveal on view-in. Hidden only once the script has armed it, so
     the text shows when the script does not run. */
  #pgc-{{ sid }}[data-pgc-armed] .pgc__stat,
  #pgc-{{ sid }}[data-pgc-armed] .pgc__heading,
  #pgc-{{ sid }}[data-pgc-armed] .pgc__subheading,
  #pgc-{{ sid }}[data-pgc-armed] .pgc__footnote {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .55s ease, transform .55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__heading,
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__subheading,
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__footnote { opacity: 1; transform: none; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat { opacity: 1; transform: none; }
  /* small stagger via nth-child */
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(1) { transition-delay: .05s; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(2) { transition-delay: .15s; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(3) { transition-delay: .25s; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(4) { transition-delay: .35s; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(5) { transition-delay: .45s; }
  #pgc-{{ sid }}[data-pgc-revealed="1"] .pgc__stat:nth-child(6) { transition-delay: .55s; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pgc__stat,
    #shopify-section-{{ sid }} .pgc__heading,
    #shopify-section-{{ sid }} .pgc__subheading,
    #shopify-section-{{ sid }} .pgc__footnote { opacity: 1; transform: none; transition: none; }
    #shopify-section-{{ sid }} .pgc__ring-fill { transition: none; }
  }
{% comment %}{% endcomment %}</style>

<div id="pgc-{{ sid }}" class="pgc section sec__progress-circles" data-section-id="{{ sid }}">
  <div class="pgc__inner">
    <div class="pgc__grid">

      {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}

      <div class="pgc__col-text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- assign htag = bs.tag | default: 'h2' -%}
              <{{ htag }} class="pgc__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text }}{%- else -%}Heading text{%- endif -%}</{{ htag }}>

            {%- when 'subheading' -%}
              <div class="pgc__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text }}{%- else -%}<p>{{ 'accessibility.add_supporting_copy' | t }}</p>{%- endif -%}</div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="pgc__col-stats">
        <div class="pgc__stats">
          {%- if stat_blocks.size > 0 -%}
            {%- for stat in stat_blocks -%}
              {%- assign sb = stat.settings -%}
              {%- assign pct = sb.percent | default: 90 -%}
              {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
              {%- if pct < 0 -%}{%- assign pct = 0 -%}{%- endif -%}
              {%- assign circumference = 175.93 -%}
              {%- assign offset = circumference | times: pct | divided_by: 100.0 -%}
              {%- assign final_offset = circumference | minus: offset -%}
              <div class="pgc__stat" {{ stat.shopify_attributes }}>
                <div class="pgc__stat-row">
                  <span class="pgc__stat-percent">{{ pct }}%</span>
                  <span class="pgc__stat-ring">
                    <svg viewBox="0 0 64 64" aria-hidden="true">
                      <circle class="pgc__ring-bg" cx="32" cy="32" r="28" fill="none" stroke-width="6"/>
                      <circle class="pgc__ring-fill" cx="32" cy="32" r="28" fill="none" stroke-width="6"
                        stroke="{{ sb.color | default: st.ring_color | default: '#A3B8FF' }}"
                        stroke-dasharray="{{ circumference }}"
                        stroke-dashoffset="{{ circumference }}"
                        data-pgc-target-offset="{{ final_offset }}"/>
                    </svg>
                  </span>
                </div>
                <div class="pgc__stat-label">{%- if sb.text != blank -%}{{ sb.text }}{%- else -%}<p>{{ 'accessibility.describe_stat' | t }}</p>{%- endif -%}</div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="pgc__stat" style="opacity:.5"><div class="pgc__stat-label">{{ 'accessibility.add_stat_blocks' | t }}</div></div>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'footnote' -%}
            {%- assign fbs = block.settings -%}
            <p class="pgc__footnote" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if fbs.text != blank -%}{{ fbs.text }}{%- else -%}Add a small footnote here.{%- endif -%}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    var sec = document.getElementById('pgc-{{ sid }}');
    if (!sec) return;
    function reveal() {
      if (sec.dataset.pgcRevealed === '1') return;
      sec.dataset.pgcRevealed = '1';
      sec.querySelectorAll('.pgc__ring-fill[data-pgc-target-offset]').forEach(function(r){
        var t = r.getAttribute('data-pgc-target-offset');
        if (t !== null) r.setAttribute('stroke-dashoffset', t);
      });
    }
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      reveal();
    } else if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if (e.isIntersecting) { reveal(); io.unobserve(e.target); } });
      }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
      sec.setAttribute('data-pgc-armed', '');
      io.observe(sec);
    } else { reveal(); }
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "progress-benefits",
  "name": "Progress Benefits",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text column position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment (mobile)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width (desktop)",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Vertical gap inside text column",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_subheading_gap",
      "label": "Gap between heading and subheading",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Stats grid"
    },
    {
      "type": "select",
      "id": "stats_per_row_desktop",
      "label": "Stats per row (desktop)",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "stats_per_row_mobile",
      "label": "Stats per row (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "stat_gap_desktop",
      "label": "Row gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "stat_gap_mobile",
      "label": "Row gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "stat_gap_x_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "stat_gap_x_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "stat_inner_gap",
      "label": "Percent → label gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "percent_ring_gap",
      "label": "Percent → ring gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
