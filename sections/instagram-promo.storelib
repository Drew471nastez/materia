<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  /* Section width: the inner wrapper's class (live-social-dividers.js swaps it) */
  #shopify-section-{{ section.id }} .container {
    max-width: calc(var(--page-width, 1300px) + 3rem) !important;
    margin-inline: auto !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .fluid_container {
    max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
    margin-inline: auto !important;
    box-sizing: border-box !important;
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .stretch_width {
      padding-inline: 3rem;
    }
  }
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Instagram Promo: heading and text blocks, a row of
  picture tiles (Instagram image blocks) and a follow button block. Tiles
  and the button link to their own URL or, when empty, to the Instagram link
  in Theme settings > Social media. Colours, fonts and the button follow the
  theme until Enable custom styling / custom fonts / the button's own shape
  are on. A section saved before the button block keeps its Instagram
  Button settings. The values are --ig-* variables, which
  live-social-dividers.js writes on a live edit.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign own_colors = s.enable_custom_style
  assign ig_link = settings.instagram | default: ''
  assign fonts_on = false
  if s.enable_custom_fonts
    assign fonts_on = true
  endif
  assign ig_hf = false
  assign ig_bf = false
  if fonts_on and s.heading_font.family != blank
    assign ig_hf = true
  endif
  if fonts_on and s.body_font.family != blank
    assign ig_bf = true
  endif
  assign btn_block = section.blocks | where: 'type', 'button' | first
  assign btn_show = false
  if btn_block
    assign bb = btn_block.settings
    assign btn_show = true
    assign btn_label = bb.label
    assign btn_link = bb.link | default: ig_link
    assign btn_custom = bb.enable_custom_style
    assign btn_bg = bb.bg_color
    assign btn_text = bb.text_color
    assign btn_bg_hover = bb.bg_color_hover
    assign btn_text_hover = bb.text_color_hover
    assign btn_shape = false
    if bb.use_theme_button == false
      assign btn_shape = true
    endif
    assign btn_fs_d = bb.size_desktop
    assign btn_fs_m = bb.size_mobile
    assign btn_weight = bb.font_weight
  elsif s.show_instagram_button
    assign btn_show = true
    assign btn_label = s.button_text | default: 'Follow'
    assign btn_link = s.button_link_url | default: ig_link
    assign btn_custom = own_colors
    assign btn_bg = s.button_bg_color
    assign btn_text = s.button_text_color
    assign btn_bg_hover = s.button_hover_bg_color
    assign btn_text_hover = s.button_text_hover_color
    assign btn_shape = false
    if s.use_theme_button == false
      assign btn_shape = true
    endif
    assign btn_fs_d = s.button_size_desktop
    assign btn_fs_m = s.button_size_mobile
    assign btn_weight = s.button_font_weight
  endif
  assign ig_bg = ''
  if own_colors
    assign ig_bg = s.background_color
  endif
-%}
{%- capture ig_vars -%}
--ig-ml: {{ s.margin_left | default: 0 }}px; --ig-mr: {{ s.margin_right | default: 0 }}px; --ig-bg: {% render 'scheme-color', color: ig_bg, fallback: 'var(--color-background)' %};
--ig-pt-d: {{ s.padding_top_desktop | default: 0 }}px; --ig-pb-d: {{ s.padding_bottom_desktop | default: 0 }}px; --ig-px-d: {% if s.full_width_desktop %}0px{% else %}{{ s.padding_lr_desktop | default: 0 }}px{% endif %};
--ig-pt-m: {{ s.padding_top_mobile | default: 0 }}px; --ig-pb-m: {{ s.padding_bottom_mobile | default: 0 }}px; --ig-px-m: {% if s.full_width_mobile %}0px{% else %}{{ s.padding_lr_mobile | default: 0 }}px{% endif %};
--ig-gap-d: {{ s.horizontal_gap_desktop | default: 0 }}px; --ig-gap-m: {{ s.vertical_gap_mobile | default: 0 }}px;
--ig-iw-d: {{ s.image_width_desktop }}px; --ig-ih-d: {{ s.image_height_desktop }}px; --ig-iw-m: {{ s.image_width_mobile }}px; --ig-ih-m: {{ s.image_height_mobile }}px;
--ig-radius: {% if s.circular_images %}50%{% else %}{{ s.image_border_radius | default: 0 }}px{% endif %};
--ig-shadow: {% case s.image_shadow %}{% when 'low' %}0 2px 5px rgba(0,0,0,0.1){% when 'medium' %}0 4px 10px rgba(0,0,0,0.2){% when 'high' %}0 6px 15px rgba(0,0,0,0.3){% else %}none{% endcase %};
{%- if ig_hf %} --ig-hf: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};{% endif -%}
{%- if ig_bf %} --ig-bf: {{ s.body_font.family }}, {{ s.body_font.fallback_families }};{% endif -%}
{%- endcapture -%}
<div class="ti-section-wrap color-{{ color_scheme }} gradient {{ s.section_width | default: 'container' }}" data-sd-root="instagram-promo" data-sd-section="{{ section.id }}" data-sd-settings="{{ section.settings | json | escape }}" data-sd-socials="{{ ig_link | json | escape }}">
{%- if ig_hf or ig_bf -%}<style>{% if ig_hf %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if ig_bf %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}{% comment %}{% endcomment %}</style>{%- endif -%}
<style>
  #shopify-section-{{ section.id }} .instagram-promo-section { font-family: var(--body-font, inherit); font-weight: var(--body-weight, inherit); color: var(--color-text); margin-left: var(--ig-ml); margin-right: var(--ig-mr); padding: 0; background-color: transparent; text-align: center; }
  #shopify-section-{{ section.id }} .instagram-promo-section.hide-all,
  #shopify-section-{{ section.id }} .instagram-promo-section.show-mobile,
  #shopify-section-{{ section.id }} .instagram-promo-section.show-desktop { display: none; }
  #shopify-section-{{ section.id }} .instagram-promo-section.show-all { display: block; }
  #shopify-section-{{ section.id }} .promo-container { background-color: var(--ig-bg) !important; padding: var(--ig-pt-m) var(--ig-px-m) var(--ig-pb-m); }
  #shopify-section-{{ section.id }} .ig-heading { margin: 0 0 10px; font-size: var(--ig-h-m); font-weight: var(--ig-h-w, var(--heading-weight, 500)); color: var(--ig-h-c) !important; font-family: var(--ig-hf, var(--heading-font, inherit)); }
  #shopify-section-{{ section.id }} .ig-sub { margin: 0 0 30px; font-size: var(--ig-p-m); color: var(--ig-p-c) !important; font-family: var(--ig-bf, inherit); }
  #shopify-section-{{ section.id }} .image-row { display: flex; justify-content: center; gap: var(--ig-gap-m); flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .image-container { position: relative; width: var(--ig-iw-m); height: var(--ig-ih-m); max-width: 100%; border-radius: var(--ig-radius); overflow: hidden; box-shadow: var(--ig-shadow); transition: box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); }
  #shopify-section-{{ section.id }} .ig-tile { display: block; width: 100%; height: 100%; position: relative; color: var(--color-text); }
  #shopify-section-{{ section.id }} .ig-tile:focus-visible { outline: 2px solid var(--color-heading); outline-offset: -4px; }
  #shopify-section-{{ section.id }} .ig-tile > svg[data-sd-ph] { width: 100%; height: 100%; display: block; background: color-mix(in srgb, currentColor 10%, transparent); opacity: .6; }
  #shopify-section-{{ section.id }} .ig-tile > img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; display: block; transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), filter var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); }
  #shopify-section-{{ section.id }} .overlay { position: absolute; inset: 0; background-color: rgba(0, 0, 0, 0.3); opacity: 0; display: flex; justify-content: center; align-items: center; transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); pointer-events: none; }
  #shopify-section-{{ section.id }} .overlay svg { fill: #fff; width: 2em; height: 2em; }
  #shopify-section-{{ section.id }} .image-container:is(:hover, :focus-within) .overlay { opacity: 1; }
  #shopify-section-{{ section.id }} [data-ig-hover="fade-in"] .image-container:hover .ig-tile > img { opacity: 0.7; }
  #shopify-section-{{ section.id }} [data-ig-hover="scale-in"] .image-container:hover .ig-tile > img { transform: scale(1.05); }
  #shopify-section-{{ section.id }} [data-ig-hover="rotate"] .image-container:hover .ig-tile > img { transform: rotate(5deg); }
  #shopify-section-{{ section.id }} [data-ig-hover="slide-up"] .image-container:hover .ig-tile > img { transform: translateY(-10px); }
  #shopify-section-{{ section.id }} [data-ig-hover="blur"] .image-container:hover .ig-tile > img { filter: blur(2px); }
  #shopify-section-{{ section.id }} .instagram-button { margin-top: 30px; width: 80%; max-width: 300px; }
  #shopify-section-{{ section.id }} .instagram-button[data-own-shape] { --mb-padding-y: 10px; --mb-padding-x: 20px; --mb-radius: 5px; --mb-border-width: 0px; --mb-font-size: var(--ig-btn-fs-m); }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .instagram-promo-section.show-desktop { display: block; }
    #shopify-section-{{ section.id }} .promo-container { padding: var(--ig-pt-d) var(--ig-px-d) var(--ig-pb-d); }
    #shopify-section-{{ section.id }} .ig-heading { font-size: var(--ig-h-d); }
    #shopify-section-{{ section.id }} .ig-sub { font-size: var(--ig-p-d); }
    #shopify-section-{{ section.id }} .image-row { flex-wrap: nowrap; gap: var(--ig-gap-d); }
    #shopify-section-{{ section.id }} .image-container { width: var(--ig-iw-d); height: var(--ig-ih-d); flex-shrink: 1; }
    #shopify-section-{{ section.id }} .instagram-button { width: auto; max-width: 100%; }
    #shopify-section-{{ section.id }} .instagram-button[data-own-shape] { --mb-font-size: var(--ig-btn-fs-d); }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .instagram-promo-section.show-mobile { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} :is(.image-container, .ig-tile > img, .overlay) { transition: none !important; }
    #shopify-section-{{ section.id }} .image-container:hover .ig-tile > img { transform: none !important; }
  }
{% comment %}{% endcomment %}</style>
{%- if request.design_mode -%}<template data-sd-ph><svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-sd-ph><g fill="currentColor" opacity=".55"><circle cx="160" cy="150" r="22"/><path d="M110 270l60-70 40 45 30-28 50 53z"/></g></svg></template>{%- endif -%}
<div class="instagram-promo-section show-{% case s.show_section_on %}{% when 'no_devices' %}none hide-all{% when 'mobile_only' %}mobile{% when 'desktop_only' %}desktop{% else %}all{% endcase %}" data-sd-ig data-ig-hover="{{ s.image_hover_animation | default: 'none' }}" style="{{ ig_vars | strip_newlines }}">
  <div class="promo-container">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign bc = ''
        if b.enable_custom_style
          assign bc = b.color
        endif
      -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- liquid
            assign hw = b.font_weight | default: 'theme'
            if hw == 'theme' and ig_hf and s.heading_font.weight != blank
              assign hw = s.heading_font.weight
            endif
          -%}
          <h2 class="ig-heading" data-sd-block="{{ block.id }}" data-sd-type="heading" data-sd-settings="{{ block.settings | json | escape }}"{% if ig_hf %} data-own-font{% endif %}{% if hw != 'theme' %} data-own-weight{% endif %} {{ block.shopify_attributes }} style="--ig-h-d: {{ b.size_desktop }}px; --ig-h-m: {{ b.size_mobile }}px; --ig-h-c: {% render 'scheme-color', color: bc, fallback: 'var(--color-heading)' %};{% if hw != 'theme' %} --ig-h-w: {{ hw }};{% endif %}">{{ b.text }}</h2>
        {%- when 'subheading' -%}
          <p class="ig-sub" data-sd-block="{{ block.id }}" data-sd-type="subheading" data-sd-settings="{{ block.settings | json | escape }}"{% if ig_bf %} data-own-font{% endif %} {{ block.shopify_attributes }} style="--ig-p-d: {{ b.size_desktop }}px; --ig-p-m: {{ b.size_mobile }}px; --ig-p-c: {% render 'scheme-color', color: bc, fallback: 'var(--color-text)' %};">{{ b.text | escape | newline_to_br }}</p>
      {%- endcase -%}
    {%- endfor -%}
    <div class="image-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          {%- liquid
            assign b = block.settings
            assign tile_link = b.link_url | default: ig_link
          -%}
          <div class="image-container" data-sd-block="{{ block.id }}" data-sd-type="image" data-sd-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>
            <{% if tile_link != blank %}a href="{{ tile_link }}" target="_blank" rel="noopener" aria-label="{{ b.alt_text | escape }}"{% else %}div{% endif %} class="ig-tile" data-ig-tile>
              {%- if b.enable_image_url and b.image_url != blank -%}
                <img data-sd-img alt="{{ b.alt_text | escape }}" src="{{ b.image_url }}" loading="lazy" decoding="async">
              {%- elsif b.image != blank -%}
                <img data-sd-img alt="{{ b.alt_text | escape }}" src="{{ b.image | image_url: width: 600 }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
              {%- else -%}
                <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-sd-ph><g fill="currentColor" opacity=".55"><circle cx="160" cy="150" r="22"/><path d="M110 270l60-70 40 45 30-28 50 53z"/></g></svg>
              {%- endif -%}
              <span class="overlay" aria-hidden="true">{%- render 'icon-instagram', custom_width: 32 -%}</span>
            </{% if tile_link != blank %}a{% else %}div{% endif %}>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if btn_show -%}
      {%- liquid
        assign mb_bg = ''
        assign mb_text = ''
        assign mb_bg_hover = ''
        assign mb_text_hover = ''
        if btn_custom
          assign mb_bg = btn_bg
          assign mb_text = btn_text
          assign mb_bg_hover = btn_bg_hover
          assign mb_text_hover = btn_text_hover
        endif
      -%}
      {%- if btn_link != blank or request.design_mode -%}
      <{% if btn_link != blank %}a href="{{ btn_link }}" target="_blank" rel="noopener"{% else %}button type="button"{% endif %} class="instagram-button" data-theme-button="primary" data-sl-button data-ig-button
        {%- if btn_block %} data-sd-block="{{ btn_block.id }}" data-sd-type="button" data-sd-settings="{{ btn_block.settings | json | escape }}" {{ btn_block.shopify_attributes }}{% endif -%}
        {%- if btn_shape %} data-own-shape data-own-weight{% endif %}{% if ig_bf %} data-own-font{% endif %}
        style="{% if btn_custom %}--mb-bg: {% render 'scheme-color', color: mb_bg, fallback: 'var(--btn-primary-bg-color)' %}; --mb-border: {% render 'scheme-color', color: mb_bg, fallback: 'var(--btn-primary-bg-color)' %}; --mb-text: {% render 'scheme-color', color: mb_text, fallback: 'var(--btn-primary-color)' %}; --mb-hover-bg: {% render 'scheme-color', color: mb_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %}; --mb-hover-border: {% render 'scheme-color', color: mb_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %}; --mb-hover-text: {% render 'scheme-color', color: mb_text_hover, fallback: 'var(--btn-primary-hover-color)' %};{% endif %}{% if btn_shape %} --ig-btn-fs-d: {{ btn_fs_d }}px; --ig-btn-fs-m: {{ btn_fs_m }}px; --mb-weight: {{ btn_weight | default: 700 }};{% endif %}{% if ig_bf %} --mb-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families }};{% endif %}"
      >{{ btn_label | escape }}</{% if btn_link != blank %}a{% else %}button{% endif %}>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
</div>
<!-- ti-theme:end -->
</template>

<schema>
{
  "type": "instagram-promo",
  "name": "Instagram Promo Pro 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "options": [
        {
          "value": "no_devices",
          "label": "No Devices"
        },
        {
          "value": "all_devices",
          "label": "All Devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile Devices Only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop/Large Screens Only"
        }
      ],
      "default": "all_devices"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_instagram_button",
      "label": "Show button",
      "default": false,
      "hidden": true,
      "info": "Legacy: used only when the section has no Button block.",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Follow us on Instagram",
      "hidden": true,
      "info": "Legacy: used only when the section has no Button block.",
      "visible_if": "{{ false }}"
    },
    {
