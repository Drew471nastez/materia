<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<div class="ti-section-wrap {{ section.settings.section_width | default: 'container' }}">
<!-- External CSS Links -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">

<style>
  /* Dynamic Import of Google Fonts */
  {% if section.settings.enable_custom_fonts %}
    @import url('https://fonts.googleapis.com/css2?family={{ section.settings.custom_font | replace: ' ', '+' }}&display=swap');
  {% endif %}

  /* Scoped CSS for Instagram Promo Section */
  .instagram-promo-section {
      font-family: 'Roboto', sans-serif;
      margin-left: {{ section.settings.margin_left }}px;
      margin-right: {{ section.settings.margin_right }}px;
      padding: 0;
      background-color: #fff;
      text-align: center;
  }

  /* Visibility Classes Based on Device */
  .instagram-promo-section.hide-all { display: none; }
  .instagram-promo-section.show-mobile { display: none; }
  .instagram-promo-section.show-desktop { display: none; }

  @media (max-width: 767px) {
      .instagram-promo-section.show-mobile { display: block; }
      .instagram-promo-section.show-desktop,
      .instagram-promo-section.hide-all { display: none; }
  }
  @media (min-width: 768px) {
      .instagram-promo-section.show-desktop { display: block; }
      .instagram-promo-section.show-mobile,
      .instagram-promo-section.hide-all { display: none; }
  }
  .instagram-promo-section.show-all { display: block; }

  /* Promo Container Base – background only; padding set via media queries */
  .instagram-promo-section .promo-container {
      background-color: {{ section.settings.background_color }} !important;
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
      .instagram-promo-section .promo-container {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
          {% if section.settings.full_width_desktop %}
            padding-left: 0;
            padding-right: 0;
            width: 100%;
          {% else %}
            padding-left: {{ section.settings.padding_lr_desktop }}px;
            padding-right: {{ section.settings.padding_lr_desktop }}px;
          {% endif %}
      }
  }

  /* Mobile Styles */
  @media (max-width: 767px) {
      .instagram-promo-section .promo-container {
          padding-top: {{ section.settings.padding_top_mobile }}px;
          padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
          {% if section.settings.full_width_mobile %}
            padding-left: 0;
            padding-right: 0;
            width: 100%;
          {% else %}
            padding-left: {{ section.settings.padding_lr_mobile }}px;
            padding-right: {{ section.settings.padding_lr_mobile }}px;
          {% endif %}
      }
  }

  /* Keep generic margins; actual sizes/colors come from block-scoped styles below */
  .instagram-promo-section .promo-container h1 { margin-bottom: 10px; }
  .instagram-promo-section .promo-container p { margin-bottom: 30px; }

  .instagram-promo-section .image-row {
      display: flex;
      justify-content: center;
      gap: {{ section.settings.horizontal_gap_desktop }}px;
      flex-wrap: wrap;
  }

  /* Desktop: Ensure images are in one horizontal row */
  @media (min-width: 768px) {
      .instagram-promo-section .image-row { flex-wrap: nowrap; }
  }

  .instagram-promo-section .image-row .image-container {
      position: relative;
      width: {{ section.settings.image_width_desktop }}px;
      height: {{ section.settings.image_height_desktop }}px;
      border-radius:
        {% if section.settings.circular_images %}50%
        {% else %}{{ section.settings.image_border_radius }}px
        {% endif %};
      overflow: hidden;
      box-shadow:
        {% case section.settings.image_shadow %}
          {% when 'low' %}0 2px 5px rgba(0,0,0,0.1)
          {% when 'medium' %}0 4px 10px rgba(0,0,0,0.2)
          {% when 'high' %}0 6px 15px rgba(0,0,0,0.3)
          {% else %}none
        {% endcase %};
      transition: all 0.3s ease;
  }

  .instagram-promo-section .image-row img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: all 0.3s ease;
      border-radius: inherit; /* Inherit border-radius from container */
      display: block;
  }

  .instagram-promo-section .image-row .overlay {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background-color: rgba(0, 0, 0, 0.3);
      opacity: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
  }
  .instagram-promo-section .image-row .overlay i {
      color: #fff;
      font-size: 2em;
  }

  /* Hover Animations */
  {% case section.settings.image_hover_animation %}
    {% when 'none' %}
      .instagram-promo-section .image-row .image-container:hover img { filter: none; }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
    {% when 'fade-in' %}
      .instagram-promo-section .image-row .image-container:hover img { opacity: 0.7; }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
    {% when 'scale-in' %}
      .instagram-promo-section .image-row .image-container:hover img { transform: scale(1.05); }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
    {% when 'rotate' %}
      .instagram-promo-section .image-row .image-container:hover img { transform: rotate(5deg); }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
    {% when 'slide-up' %}
      .instagram-promo-section .image-row .image-container:hover img { transform: translateY(-10px); }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
    {% when 'blur' %}
      .instagram-promo-section .image-row .image-container:hover img { filter: blur(2px); }
      .instagram-promo-section .image-row .image-container:hover .overlay { opacity: 1; }
  {% endcase %}

  .instagram-promo-section .image-row .image-container:hover .overlay { cursor: pointer; }

  /* Instagram Button */
  .instagram-promo-section .instagram-button {
      margin-top: 30px;
      display: inline-block;
      padding: 10px 20px;
      background-color: {{ section.settings.button_bg_color }} !important;
      color: {{ section.settings.button_text_color }} !important;
      font-size: {{ section.settings.button_size_desktop }}px;
      font-weight: {{ section.settings.button_font_weight }};
      border: none;
      border-radius: 5px;
      text-decoration: none;
      transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
      {% if section.settings.enable_custom_fonts %}
        font-family: '{{ section.settings.custom_font }}', sans-serif;
      {% endif %}
  }
  .instagram-promo-section .instagram-button:hover {
      background-color: {{ section.settings.button_hover_bg_color }} !important;
      color: {{ section.settings.button_text_hover_color }} !important;
      transform: translateY(-2px);
  }

  /* Mobile Text and Button Adjustments */
  @media (max-width: 767px) {
      .instagram-promo-section .image-row {
          gap: {{ section.settings.vertical_gap_mobile }}px;
      }
      .instagram-promo-section .image-row .image-container {
          width: {{ section.settings.image_width_mobile }}px;
          height: {{ section.settings.image_height_mobile }}px;
          border-radius:
            {% if section.settings.circular_images %}50%
            {% else %}{{ section.settings.image_border_radius }}px
            {% endif %};
      }
      .instagram-promo-section .instagram-button {
          width: 80%;
          max-width: 300px;
          font-size: {{ section.settings.button_size_mobile }}px;
      }
  }
{% comment %}{% endcomment %}</style>

<div
  class="
    instagram-promo-section
    {% case section.settings.show_section_on %}
        {% when 'no_devices' %} hide-all
        {% when 'all_devices' %} show-all
        {% when 'mobile_only' %} show-mobile
        {% when 'desktop_only' %} show-desktop
    {% endcase %}
  "
>
  <div class="promo-container">

    {%- comment -%}
      Render text blocks (Heading/Subheading) in the order the merchant sets.
      Each block injects its own scoped styles for sizes/colors and mobile overrides.
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <style>
            #heading-{{ block.id }}{
              font-size: {{ block.settings.size_desktop }}px;
              font-weight: {{ block.settings.font_weight }};
              color: {{ block.settings.color }} !important;
              {% if section.settings.enable_custom_fonts %}
                font-family: '{{ section.settings.custom_font }}', sans-serif;
              {% endif %}
            }
            @media (max-width: 767px){
              #heading-{{ block.id }}{ font-size: {{ block.settings.size_mobile }}px; }
            }
{% comment %}{% endcomment %}          </style>
          <h1 id="heading-{{ block.id }}">{{ block.settings.text }}</h1>

        {%- when 'subheading' -%}
          <style>
            #subheading-{{ block.id }}{
              font-size: {{ block.settings.size_desktop }}px;
              color: {{ block.settings.color }} !important;
              {% if section.settings.enable_custom_fonts %}
                font-family: '{{ section.settings.custom_font }}', sans-serif;
              {% endif %}
            }
            @media (max-width: 767px){
              #subheading-{{ block.id }}{ font-size: {{ block.settings.size_mobile }}px; }
            }
{% comment %}{% endcomment %}          </style>
          <p id="subheading-{{ block.id }}">{{ block.settings.text }}</p>

      {%- endcase -%}
    {%- endfor -%}

    <div class="image-row">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="image-container">
            <a href="{{ block.settings.link_url | default: '#' }}" target="_blank">
              {%- assign _img = block.settings.image -%}
              <img
                alt="{{ block.settings.alt_text | escape }}"
                src="{% if block.settings.enable_image_url and block.settings.image_url != blank %}{{ block.settings.image_url }}{% elsif _img != blank %}{{ _img | img_url: '500x' }}{% else %}https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg{% endif %}"
              >
              <div class="overlay">
                <i class="fab fa-instagram"></i>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_instagram_button %}
      <a
        href="{{ section.settings.button_link_url | default: 'https://instagram.com/' | append: section.settings.instagram_username }}"
        target="_blank"
        class="instagram-button"
      >
        {{ section.settings.button_text | default: 'Follow @' | append: section.settings.instagram_username }}
      </a>
    {% endif %}
  </div>
</div>

</div>
<!-- ti-theme:end -->


</template>

<schema>
{
  "type": "instagram-promo",
  "name": "Instagram Promo Pro 1",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show Section On",
      "options": [
        {
          "value": "no_devices",
          "label": "No Devices"
        },
        {
          "value": "all_devices",
          "label": "All Devices"
        },
        {
          "value": "mobile_only",
          "label": "Mobile Devices Only"
        },
        {
          "value": "desktop_only",
          "label": "Desktop/Large Screens Only"
        }
      ],
      "default": "all_devices"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Header Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable Custom Fonts",
      "default": false
    },
    {
      "type": "select",
      "id": "custom_font",
      "label": "Select Custom Font",
      "options": [
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Open+Sans",
          "label": "Open Sans"
        },
        {
          "value": "Lato",
          "label": "Lato"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Oswald",
          "label": "Oswald"
        },
        {
          "value": "Raleway",
          "label": "Raleway"
        },
        {
          "value": "PT+Sans",
          "label": "PT Sans"
        },
        {
          "value": "Ubuntu",
          "label": "Ubuntu"
        },
        {
          "value": "Source+Sans+Pro",
          "label": "Source Sans Pro"
        },
        {
          "value": "Playfair+Display",
          "label": "Playfair Display"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Nunito",
          "label": "Nunito"
        },
        {
          "value": "Fira+Sans",
          "label": "Fira Sans"
        },
        {
          "value": "Merriweather",
          "label": "Merriweather"
        },
        {
          "value": "Roboto+Condensed",
          "label": "Roboto Condensed"
        },
        {
          "value": "Cabin",
          "label": "Cabin"
        },
        {
          "value": "Bitter",
          "label": "Bitter"
        },
        {
          "value": "Work+Sans",
          "label": "Work Sans"
        },
        {
          "value": "Rubik",
          "label": "Rubik"
        },
        {
          "value": "Varela+Round",
          "label": "Varela Round"
        },
        {
          "value": "Quicksand",
          "label": "Quicksand"
        },
        {
          "value": "Mukta",
          "label": "Mukta"
        },
        {
          "value": "Barlow",
          "label": "Barlow"
        },
        {
          "value": "Josefin+Sans",
          "label": "Josefin Sans"
        },
        {
          "value": "Karla",
          "label": "Karla"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Spectral",
          "label": "Spectral"
        },
        {
          "value": "Dosis",
          "label": "Dosis"
        }
      ],
      "default": "Roboto"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Items / Layout"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Images Width (Desktop)",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 290
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Images Height (Desktop)",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 270
    },
    {
      "type": "range",
      "id": "horizontal_gap_desktop",
      "label": "Horizontal Gap Between Images (Desktop)",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "circular_images",
      "label": "Make Images Circle",
      "default": false
    },
    {
      "type": "select",
      "id": "image_shadow",
      "label": "Images Shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "low",
          "label": "Low Shadow"
        },
        {
          "value": "medium",
          "label": "Medium Shadow"
        },
        {
          "value": "high",
          "label": "High Shadow"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Images Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "select",
      "id": "image_hover_animation",
      "label": "Images Hover Animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade-in",
          "label": "Smooth Fade-In"
        },
        {
          "value": "scale-in",
          "label": "Smooth Scale-In"
        },
        {
          "value": "rotate",
          "label": "Rotate"
        },
        {
          "value": "slide-up",
          "label": "Slide Up"
        },
        {
          "value": "blur",
          "label": "Blur"
        }
      ],
