            "label": "Below the grid (centered)"
          }
        ],
        "hidden": true,
        "info": "Legacy: used only when the section has no View all button block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "text",
        "id": "view_all_label",
        "label": "View all label",
        "hidden": true,
        "info": "Legacy: used only when the section has no View all button block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "url",
        "id": "view_all_url",
        "label": "View all link",
        "hidden": true,
        "info": "Legacy: used only when the section has no View all button block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "header_alignment",
        "label": "Header alignment",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "header_size",
        "label": "Heading size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ]
      },
      {
        "type": "range",
        "id": "header_spacing",
        "label": "Space below header",
        "min": 0,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 32
      },
      {
        "type": "select",
        "id": "display_mode",
        "label": "Layout",
        "default": "carousel",
        "options": [
          {
            "value": "grid",
            "label": "Grid"
          },
          {
            "value": "carousel",
            "label": "Carousel"
          }
        ]
      },
      {
        "type": "range",
        "id": "items_per_row",
        "label": "Collections per row",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "column_gap",
        "label": "Gap between collections",
        "min": 0,
        "max": 50,
        "step": 2,
        "default": 10,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Images"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Image shape",
        "default": "square",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "square",
            "label": "Square (1:1)"
          },
          {
            "value": "portrait",
            "label": "Portrait (3:4)"
          },
          {
            "value": "landscape",
            "label": "Landscape (4:3)"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom shape",
        "info": "Width / height, for example 4/5.",
        "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
      },
      {
        "type": "range",
        "id": "image_overlay_opacity",
        "label": "Image shade",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "rounded_image",
        "label": "Round images",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "checkbox",
        "id": "image_custom_width",
        "label": "Custom image width",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "range",
        "id": "image_width",
        "label": "Image width",
        "min": 100,
        "max": 300,
        "step": 5,
        "default": 200,
        "unit": "px",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' and section.settings.image_custom_width }}"
      },
      {
        "type": "range",
        "id": "information_spacing",
        "label": "Space above names",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ section.settings.collection_information_position == 'below_image' }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_bg",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "custom_section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_bg }}"
      },
      {
        "type": "select",
        "id": "design",
        "label": "Card design",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Classic"
          },
          {
            "value": "morden",
            "label": "Modern"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_information_position",
        "label": "Name position",
        "default": "below_image",
        "options": [
          {
            "value": "overlay_image",
            "label": "On the image"
          },
          {
            "value": "below_image",
            "label": "Below"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_product_count",
        "label": "Show product count"
      },
      {
        "type": "checkbox",
        "id": "show_icon",
        "label": "Show arrow button",
        "visible_if": "{{ section.settings.design == 'morden' and section.settings.collection_information_position == 'overlay_image' }}"
      },
      {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show collection description",
        "visible_if": "{{ section.settings.design == 'morden' }}"
      },
      {
        "type": "checkbox",
        "id": "heading_underline",
        "label": "Line under the heading",
        "default": false
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "font_size",
        "label": "Name size",
        "min": 12,
        "max": 24,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "font_weight",
        "label": "Name weight",
        "default": "heading_weight",
        "options": [
          {
            "value": "body_weight",
            "label": "Body"
          },
          {
            "value": "subheading_weight",
            "label": "Subheading"
          },
          {
            "value": "heading_weight",
            "label": "Heading"
          }
        ]
      },
      {
        "type": "select",
        "id": "text_alignment",
        "label": "Name alignment",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "select",
        "id": "card_hover_effect",
        "label": "Card hover effect",
        "default": "zoom",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "zoom",
            "label": "Zoom in"
          },
          {
            "value": "fade",
            "label": "Fade overlay"
          },
          {
            "value": "lift",
            "label": "Lift + shadow"
          },
          {
            "value": "tilt",
            "label": "Subtle 3D tilt"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_arrow",
        "label": "Show arrows",
        "default": false,
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "select",
        "id": "carousel_pagination",
        "label": "Pagination",
        "default": "show_dots",
        "options": [
          {
            "value": "disable",
            "label": "Disable"
          },
          {
            "value": "show_dots",
            "label": "Show dots"
          },
          {
            "value": "show_dots_on_mobile",
            "label": "Mobile only"
          },
          {
            "value": "show_progress_bar",
            "label": "Progress bar"
          }
        ],
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "select",
        "id": "pagination_style",
        "label": "Pagination style",
        "default": "pill",
        "options": [
          {
            "value": "dot",
            "label": "Dot (default)"
          },
          {
            "value": "pill",
            "label": "Pill (active expands)"
          },
          {
            "value": "line",
            "label": "Line / bar"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "ring",
            "label": "Ring (hollow)"
          },
          {
            "value": "number",
            "label": "Numbers"
          },
          {
            "value": "progress",
            "label": "Progress fill"
          }
        ],
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "select",
        "id": "pagination_position",
        "label": "Pagination position",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "checkbox",
        "id": "infinite",
        "label": "Loop",
        "default": false,
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false,
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}",
        "info": "Stops off screen and under reduced motion."
      },
      {
        "type": "range",
        "id": "autorotate_speed",
        "label": "Change every",
        "max": 6,
        "min": 2,
        "step": 1,
        "unit": "s",
        "default": 5,
        "visible_if": "{{ section.settings.display_mode == 'carousel' and section.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Show part of the next card",
        "default": false,
        "visible_if": "{{ section.settings.display_mode == 'carousel' }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 50,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 50,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "items_per_row_mobile",
        "label": "Collections per row (mobile)",
        "min": 1,
        "max": 3,
        "step": 0.5,
        "default": 1.5
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Shop by collection"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Description",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Pick a collection to start browsing.</p>"
          }
        ]
      },
      {
        "type": "button",
        "name": "View all button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Label",
            "default": "View all"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Empty: all collections."
          },
          {
            "type": "select",
            "id": "position",
            "label": "Position",
            "default": "header",
            "options": [
              {
                "value": "header",
                "label": "Header"
              },
              {
                "value": "bottom",
                "label": "Below"
              }
            ],
            "info": "With a centred header the button sits below the collections."
          }
        ]
      },
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "image_picker",
            "id": "collection_image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "collection_title",
            "label": "Collection title"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collections Display",
        "settings": {
          "display_mode": "grid",
          "items_per_row": 4,
          "column_gap": 10,
          "header_alignment": "left"
        },
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "Best collections"
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>Our latest pieces, sorted by collection.</p>"
            }
          },
          {
            "type": "collection"
          },
          {
            "type": "collection"
          },
          {
            "type": "collection"
          },
          {
            "type": "collection"
          }
        ],
        "category": "Collections"
