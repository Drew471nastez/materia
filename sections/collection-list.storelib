<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background. Transparent by default (inherits the page). When the
  "Enable custom section background color" toggle is on, paint the chosen
  colour edge-to-edge AND on the inner .section so it overrides whatever the
  active color scheme would set. Fully independent of the color scheme.
{%- endcomment -%}
{%- if section.settings.enable_custom_bg and section.settings.custom_section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > .section.gradient {
      background-color: {{ section.settings.custom_section_bg }} !important;
      background-image: none !important;
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'pagination-styles.css' | asset_url }}" media="print" onload="this.media='all'">
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign column_gap = section_st.column_gap
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign heading = section_st.heading
  assign description = section_st.description
  assign show_view_all_button = section_st.show_view_all_button
  assign view_all_pos = section_st.view_all_position | default: 'header'
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign collection_information_position = section_st.collection_information_position
  assign design = section_st.design
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign reveal = section_st.reveal
  assign display_mode = section_st.display_mode
  assign items_per_row = section_st.items_per_row
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3
    assign data_free_scroll = 'true'
  endif
  assign rounded_image = section_st.rounded_image
  assign image_custom_width = section_st.image_custom_width
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  {%- if section_st.enable_custom_bg and section_st.custom_section_bg != blank -%}
    background-color: {{ section_st.custom_section_bg }} !important; background-image: none !important;
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Per-section CSS for the new settings: heading underline, header→grid spacing, card hover, image overlay {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .section__header {
    margin-bottom: {{ section_st.header_spacing | default: 32 }}px !important;
  }
  {%- if section_st.heading_underline -%}
    #shopify-section-{{ section.id }} .section__header-heading {
      display: inline-block;
      position: relative;
      padding-bottom: 12px;
    }
    #shopify-section-{{ section.id }} .section__header-heading::after {
      content: "";
      position: absolute;
      left: 0; bottom: 0;
      width: 48px; height: 2px;
      background: currentColor;
      opacity: 0.85;
      border-radius: 2px;
    }
    #shopify-section-{{ section.id }} .section__header[data-align="center"] .section__header-heading::after,
    #shopify-section-{{ section.id }} .text-center .section__header-heading::after {
      left: 50%; transform: translateX(-50%);
    }
    #shopify-section-{{ section.id }} .text-right .section__header-heading::after {
      left: auto; right: 0;
    }
  {%- endif -%}
  {%- comment -%}
    Unified image overlay. A single ::after always exists on the media and is
    driven by two variables:
      --ov-base  : the persistent "Image overlay opacity" dim (0 when unused)
      --ov-hover : the opacity to fade to on hover (only the 'fade' effect sets it)
    This lets the persistent overlay and the 'fade' hover effect coexist without
    fighting, and means 'fade' works even when overlay opacity is 0.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .collection-item .collection-item__media {
    --ov-base: {{ section_st.image_overlay_opacity | default: 0 | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .collection-item .collection-item__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--ov-base, 0);
    pointer-events: none;
    z-index: 1;
    transition: opacity .35s ease;
  }
  #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media::after {
    opacity: var(--ov-hover, var(--ov-base, 0));
  }
  {%- assign hover_fx = section_st.card_hover_effect | default: 'zoom' -%}
  {%- comment -%} Base image transition — shared by all effects for smoothness {%- endcomment -%}
  #shopify-section-{{ section.id }} .collection-item .collection-item__media :is(img, picture, .placeholder-image) {
    transition: transform .55s cubic-bezier(.2,.7,.2,1), filter .35s ease;
    will-change: transform;
    backface-visibility: hidden;
    transform-origin: center center;
  }
  #shopify-section-{{ section.id }} .collection-item {
    transition: transform .4s cubic-bezier(.2,.7,.2,1), box-shadow .4s ease;
  }
  {%- case hover_fx -%}
    {%- when 'none' -%}
      {%- comment -%} Truly none — neutralize any inherited theme hover zoom {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media :is(img, picture) {
        transform: none !important;
      }
    {%- when 'zoom' -%}
      #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media :is(img, picture) {
        transform: scale(1.06);
      }
    {%- when 'fade' -%}
      {%- comment -%} Dim overlay fades in; image itself stays put {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection-item .collection-item__media {
        --ov-hover: 0.22;
      }
      #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media :is(img, picture) {
        transform: none !important;
      }
    {%- when 'lift' -%}
      #shopify-section-{{ section.id }} .collection-item:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px -14px rgba(0,0,0,.22);
      }
      #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media :is(img, picture) {
        transform: none !important;
      }
    {%- when 'tilt' -%}
      #shopify-section-{{ section.id }} .collection-item .collection-item__media {
        perspective: 800px;
      }
      #shopify-section-{{ section.id }} .collection-item:hover .collection-item__media :is(img, picture) {
        transform: rotateX(2deg) rotateY(-3deg) scale(1.03);
      }
  {%- endcase -%}
  /* Modern card arrow button — colors (background, arrow/text, hover) come
     from the color scheme's PRIMARY BUTTON via .btn-primary. These rules only
     lock the shape so the button styling can't stretch it into a pill. */
  #shopify-section-{{ section.id }} .icon_collection.btn-primary {
    width: 45px;
    height: 45px;
    min-width: 45px;
    padding: 0;
    border-radius: 50%;
    flex: 0 0 auto;
    line-height: 0;
  }
  /* Default design — overlay name pill. The label is forced to sit centered
     with balanced padding so it doesn't ride high or crowd the edges, which is
     how it looked before. .btn-white is only applied in the Default overlay
     case, so this never touches the Modern layout. */
  #shopify-section-{{ section.id }} .collection-item__name.btn-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0.72em 1.15em;
    line-height: 1.15;
    text-align: center;
    white-space: normal;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .collection-item__name.btn-white .collection-item__name-inner {
    line-height: 1.15;
    display: inline-block;
  }
{% comment %}{% endcomment %}</style>
{%- capture col_style -%}
--col-desktop: {{ items_per_row }};--col-number:{{ items_per_row_mobile }};{% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  column_gap }}px;{% endif %}--repeat: {{ section.blocks.size }}; --col-mobile: {{ items_per_row_mobile }}
{%- endcapture -%}
{% if collection_information_position == 'below_image' and image_custom_width and rounded_image %}
  {%- style -%}
    .collection-item__media--ratio {
      --aspect-ratio: 1 !important;
    }
  {%- endstyle -%}
{% endif %}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if heading != blank or description != blank or show_view_all_button == true -%}
      <div class="section__header mb-33 mb-sm-20 text-{{ section_st.header_alignment }} {% if section_st.section_width == 'full_width' %} px-20 {% endif %}{% if show_view_all_button == true %} flex gap-15 gap-md-30 flex-wrap {% if section_st.header_alignment == 'center'  %} justify-content-{{ section_st.header_alignment }} {% else %} justify-between {% endif %} align-center{% if section_st.header_alignment == 'right' %} flex-row-reverse{% endif %}{% endif %}">
        {%- if heading != blank or description != blank -%}
          <div class="secion__header-inner">
            {%- if section_st.heading != blank -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="50"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="block  {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
                style="
                  {%- if scroll_animation != 'none' -%}
                    --animation-order: 0;
                  {% endif %}
                "
              >
                <h2
                  class="section__header-heading heading-letter-spacing {{ header_size  }} mt-0 {% if section_st.description != blank %} mb-10 {% else %} mb-0{% endif %}"
                >
                  {{ section_st.heading }}
                </h2>
              </motion-element>
            {% endif %}
            {%- if section_st.description != blank -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="150"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="block {% if scroll_animation != 'none' -%} scroll-trigger {{ scroll_animation }}{% endif %} "
                style="
                  {%- if scroll_animation != 'none' -%}
                    --animation-order: 1;
                  {% endif %}
                "
              >
                <div
                  class="section__header-des rich__text-m0 "
                >
                  {{ section_st.description }}
                </div>
              </motion-element>
            {% endif %}
          </div>
        {% endif %}
        {% if show_view_all_button == true and section_st.header_alignment != 'center' and view_all_pos == 'header' %}
          {%- assign view_all_href = section_st.view_all_url -%}
          {%- if view_all_href == blank -%}
            {%- assign view_all_href = section_st.collection.url | default: routes.collections_url -%}
          {%- endif -%}
          <a
            class="btn_view-all no-underline inline-flex btn-link align-center gap-5"
            href="{{ view_all_href }}"
            aria-label="{{ section_st.view_all_label | default: 'general.view_all' | t }}"
          >
            <span>{{ section_st.view_all_label | default: 'general.view_all' | t }}</span>
            {%- comment -%} New icon — long arrow forward (replaces the diagonal up-right) {%- endcomment -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="13 6 19 12 13 18"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      {% if display_mode == 'grid' %}
        <grid-custom
          class="collection-list--grid grid grid-cols gap{% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %} grid_scroll{% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %} grid_scroll{% endif %}"
          style="{{ col_style | strip | strip_newlines }}"
          data-mobile="{{ items_per_row_mobile }}"
          data-spacing="{{ column_gap }}"
          data-free-scroll="{{ data_free_scroll }}"
        >
          {% for block in section.blocks %}
            {% assign block_st = block.settings %}
            <motion-element
              data-motion="fade-up-lg"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              data-motion-delay="{{ forloop.index0 | times: 50 }}"
              class="collection-item grid-custom-item {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }} {% endif %} {{ settings.hover_effect }}"
              {{ block.shopify_attributes }}
              {%- if scroll_animation != 'none' -%}
                style="--animation-order: {{  forloop.index }};"
              {%- endif -%}
            >
              {% render 'collection-item',
                card_collection: block_st.collection,
                custom_image: block_st.collection_image,
                custom_title: block_st.collection_title,
                section: section,
                block: block,
                index: forloop.index,
                collection_information_position: collection_information_position,
                design: design
              %}
            </motion-element>
          {% endfor %}
        </grid-custom>
      {% else %}
        {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
          <div class="free-scroll">
        {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
          <div class="free-scroll">
        {% endif %}
        <slide-section
          class="swiper{% if reveal %} reveal_on_scroll{% endif %}  {% if section.index == 1 %} lazy-loading-swiper-before {% endif %}"
          data-section-id="{{ section.id }}"
          data-autoplay="{{ autoplay }}"
          data-effect="slide"
          data-loop="{{ infinite }}"
          data-speed="500"
          data-autoplay-speed="{{ autorotate_speed }}"
          data-spacing="{{ column_gap }}"
          data-mobile="{{ items_per_row_mobile }}"
          data-desktop="{{ items_per_row }}"
          data-tablet="{% if items_per_row > 5 %}4{% elsif items_per_row > 4 %}3{% elsif items_per_row > 3 %}3{% else %}{{ items_per_row }}{% endif %}"
          data-free-scroll="{{ data_free_scroll }}"
          data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' or section_st.pagination_style == 'progress' %}true{% else %}false{% endif %}"
          data-pagination-style="{{ section_st.pagination_style | default: 'dot' }}"
          style="{{ col_style | strip | strip_newlines }}"
        >
          {% if show_arrow %}
            {%- render 'swiper-navigation' -%}
          {% endif %}
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign block_st = block.settings %}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="collection-item swiper-slide {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }} {% endif %} {{ settings.hover_effect }}"
                {{ block.shopify_attributes }}
                {%- if scroll_animation != 'none' -%}
                  style="--animation-order: {{  forloop.index }};"
                {%- endif -%}
              >
                {% render 'collection-item',
                  card_collection: block_st.collection,
                  custom_image: block_st.collection_image,
                  custom_title: block_st.collection_title,
                  section: section,
                  block: block,
                  collection_information_position: collection_information_position,
                  design: design,
                  container: section_width,
                  colunm: items_per_row,
                  index: forloop.index,
                  colunm_mobile: section_st.items_per_row_mobile,
                  padding: column_gap
                %}
              </motion-element>
            {% endfor %}
          </div>
          {%- if carousel_pagination == 'show_dots'
            or carousel_pagination == 'show_dots_on_mobile'
            or carousel_pagination == 'show_progress_bar'
          -%}
            <motion-element
              data-motion="fade-up-sm"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              data-motion-delay="150"
              class="swiper-pagination  flex flex-wrap  {% if scroll_animation == 'slide_in' %} slide_in scroll-trigger {% endif %}   px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ section_st.pagination_position | default: 'center' }}{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
              style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
            >   
            </motion-element>
          {% endif %}
        </slide-section>
        {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
          </div>
        {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
          </div>
        {% endif %}
      {% endif %}
    {% endif %}
    {%- comment -%}
      Bottom view-all button: shows when:
      a) the merchant chose "Below the grid" position, OR
      b) header_alignment is center (centered legacy behavior — preserved).
    {%- endcomment -%}
    {%- assign show_bottom_btn = false -%}
    {%- if show_view_all_button -%}
      {%- if view_all_pos == 'bottom' -%}
        {%- assign show_bottom_btn = true -%}
      {%- elsif view_all_pos == 'header' and section_st.header_alignment == 'center' -%}
        {%- assign show_bottom_btn = true -%}
      {%- endif -%}
    {%- endif -%}
    {% if show_bottom_btn %}
      {%- assign view_all_href_c = section_st.view_all_url -%}
      {%- if view_all_href_c == blank -%}
        {%- assign view_all_href_c = section_st.collection.url | default: routes.collections_url -%}
      {%- endif -%}
      <div class="text-center mt-30">
        <a
          class="inline-flex align-center gap-8 btn-primary load-more no-underline relative"
          href="{{ view_all_href_c }}"
          aria-label="{{ section_st.view_all_label | default: 'general.view_all' | t }}"
        >
          <span>{{ section_st.view_all_label | default: 'general.view_all' | t }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="13 6 19 12 13 18"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</div>



