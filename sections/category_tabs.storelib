<template>
<section class="ct ct--{{ settings.tab_style }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ settings.heading_color }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-active: {{ settings.active_color }}; --s-active-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="ct__in ct__in--{{ settings.max_width }}">

    {% if settings.heading or settings.subheading %}
      <div class="ct__head {% if settings.align == 'center' %}ct__head--center{% endif %}">
        {% if settings.heading %}<h2 class="ct__h">{{ settings.heading | raw }}</h2>{% endif %}
        {% if settings.subheading %}<div class="ct__sub">{{ settings.subheading | raw }}</div>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="ct__w">{% endif %}
      <input class="ct__r ct__r--{{ forloop.index }}" type="radio" name="{{ section.id }}-cat" id="ct-{{ section.id }}-{{ block.id }}"{% if forloop.first %} checked{% endif %}>
      {% if forloop.last %}
        <div class="ct__tabs {% if settings.align == 'center' %}ct__tabs--center{% endif %}" role="presentation">
          {% for block in blocks %}
            <label class="ct__t ct__t--{{ forloop.index }}" for="ct-{{ section.id }}-{{ block.id }}" data-block-id="{{ block.id }}">{{ block.settings.label }}</label>
          {% endfor %}
        </div>
        <div class="ct__panels">
          {% for block in blocks %}
            <div class="ct__p ct__p--{{ forloop.index }}" data-block-id="{{ block.id }}">
              {% if block.settings.collection.products.size > 0 %}
                <div class="ct__grid">
                  {% for product in block.settings.collection.products limit: settings.product_count %}
                    <a class="ct__card" href="{{ product.settings.url | default: '#' | url }}">
                      <div class="ct__media" style="aspect-ratio: {{ settings.shape }};">
                        {% if product.settings.image %}<img src="{{ product.settings.image | asset }}" alt="{{ product.settings.title }}" loading="lazy" decoding="async">{% endif %}
                      </div>
                      <h3 class="ct__title">{{ product.settings.title }}</h3>
                      {% if product.settings.price %}
                        <p class="ct__price">{{ product.settings.price }}{% if product.settings.compare_price %}<s class="ct__was">{{ product.settings.compare_price }}</s>{% endif %}</p>
                      {% endif %}
                    </a>
                  {% endfor %}
                </div>
                {% if block.settings.link_text %}
                  <div class="ct__more {% if settings.align == 'center' %}ct__more--center{% endif %}">
                    <a class="ct__all" href="{{ block.settings.link_url | default: '/collections/all' | url }}">{{ block.settings.link_text }}</a>
                  </div>
                {% endif %}
              {% elsif page.in_editor %}
                <p class="ct__empty">{% if block.settings.collection.title %}This collection has no published products yet{% else %}Choose a collection for the tab "{{ block.settings.label }}" in the sidebar{% endif %}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        </div>
      {% endif %}
    {% else %}
      {% if page.in_editor %}<p class="ct__empty">Add a tab in the sidebar, then choose a collection for it</p>{% endif %}
    {% endfor %}

  </div>
</section>
</template>

<style scoped>
.ct { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); }
.ct__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.ct__in--narrow { max-width: 720px; }
.ct__in--medium { max-width: 960px; }
.ct__in--wide { max-width: var(--theme-page-width, 1280px); }
.ct__in--full { max-width: none; }

.ct__head { max-width: 44rem; margin-bottom: 24px; }
.ct__head--center { margin-inline: auto; text-align: center; }
.ct__h { margin: 0; font-family: var(--theme-font-heading); font-size: var(--section-heading-size, clamp(30px, 5cqi, 36px)); line-height: var(--section-heading-line-height, 1.15); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); color: var(--s-heading); }
.ct__sub { margin-top: 12px; max-width: 36rem; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.ct__head--center .ct__sub { margin-inline: auto; }
.ct__sub > :first-child { margin-top: 0; }
.ct__sub > :last-child { margin-bottom: 0; }

.ct__w { position: relative; }
.ct__r { position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

.ct__tabs { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 calc(var(--theme-padding-x, 24px) * -1) 24px; padding: 2px var(--theme-padding-x, 24px); }
.ct__tabs::-webkit-scrollbar { display: none; }
.ct--underline .ct__tabs { gap: 24px; border-bottom: 1px solid var(--s-border); padding-bottom: 0; }
.ct__t { flex: none; scroll-snap-align: start; display: inline-flex; align-items: center; min-height: 44px; cursor: pointer; font-size: 15px; font-weight: 600; color: var(--s-para); white-space: nowrap; transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease; }
.ct__t:hover { color: var(--s-heading); }
.ct--underline .ct__t { padding: 0 2px; border-bottom: 2px solid transparent; margin-bottom: -1px; }
.ct--pill .ct__t { padding: 0 18px; border: 1px solid var(--s-border); border-radius: var(--s-radius); }
@container (min-width: 640px) {
  .ct__tabs { margin-inline: 0; padding-inline: 0; }
  .ct__tabs--center { justify-content: center; }
}

.ct__w:has(.ct__r--1:checked) .ct__t--1, .ct__w:has(.ct__r--2:checked) .ct__t--2, .ct__w:has(.ct__r--3:checked) .ct__t--3, .ct__w:has(.ct__r--4:checked) .ct__t--4, .ct__w:has(.ct__r--5:checked) .ct__t--5, .ct__w:has(.ct__r--6:checked) .ct__t--6, .ct__w:has(.ct__r--7:checked) .ct__t--7, .ct__w:has(.ct__r--8:checked) .ct__t--8 { color: var(--s-heading); }
.ct--underline .ct__w:has(.ct__r--1:checked) .ct__t--1, .ct--underline .ct__w:has(.ct__r--2:checked) .ct__t--2, .ct--underline .ct__w:has(.ct__r--3:checked) .ct__t--3, .ct--underline .ct__w:has(.ct__r--4:checked) .ct__t--4, .ct--underline .ct__w:has(.ct__r--5:checked) .ct__t--5, .ct--underline .ct__w:has(.ct__r--6:checked) .ct__t--6, .ct--underline .ct__w:has(.ct__r--7:checked) .ct__t--7, .ct--underline .ct__w:has(.ct__r--8:checked) .ct__t--8 { border-bottom-color: var(--s-active); }
.ct--pill .ct__w:has(.ct__r--1:checked) .ct__t--1, .ct--pill .ct__w:has(.ct__r--2:checked) .ct__t--2, .ct--pill .ct__w:has(.ct__r--3:checked) .ct__t--3, .ct--pill .ct__w:has(.ct__r--4:checked) .ct__t--4, .ct--pill .ct__w:has(.ct__r--5:checked) .ct__t--5, .ct--pill .ct__w:has(.ct__r--6:checked) .ct__t--6, .ct--pill .ct__w:has(.ct__r--7:checked) .ct__t--7, .ct--pill .ct__w:has(.ct__r--8:checked) .ct__t--8 { background: var(--s-active); border-color: var(--s-active); color: var(--s-active-text); }
.ct__w:has(.ct__r--1:focus-visible) .ct__t--1, .ct__w:has(.ct__r--2:focus-visible) .ct__t--2, .ct__w:has(.ct__r--3:focus-visible) .ct__t--3, .ct__w:has(.ct__r--4:focus-visible) .ct__t--4, .ct__w:has(.ct__r--5:focus-visible) .ct__t--5, .ct__w:has(.ct__r--6:focus-visible) .ct__t--6, .ct__w:has(.ct__r--7:focus-visible) .ct__t--7, .ct__w:has(.ct__r--8:focus-visible) .ct__t--8 { outline: 2px solid var(--s-active); outline-offset: 3px; }

.ct__p { display: none; }
.ct__w:has(.ct__r--1:checked) .ct__p--1, .ct__w:has(.ct__r--2:checked) .ct__p--2, .ct__w:has(.ct__r--3:checked) .ct__p--3, .ct__w:has(.ct__r--4:checked) .ct__p--4, .ct__w:has(.ct__r--5:checked) .ct__p--5, .ct__w:has(.ct__r--6:checked) .ct__p--6, .ct__w:has(.ct__r--7:checked) .ct__p--7, .ct__w:has(.ct__r--8:checked) .ct__p--8 { display: block; animation: ct-in 240ms ease both; }
@keyframes ct-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.ct__grid { display: grid; gap: 24px 16px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .ct__grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); gap: 32px 24px; } }
@container (min-width: 1024px) { .ct__grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }

.ct__card { display: flex; flex-direction: column; color: inherit; text-decoration: none; border-radius: var(--s-radius); }
.ct__card:focus-visible { outline: 2px solid var(--s-active); outline-offset: 4px; }
.ct__media { overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.ct__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 240ms ease; }
.ct__card:hover .ct__media img { transform: scale(1.03); }
.ct__title { margin: 12px 0 0; font-family: var(--theme-font-heading); font-size: 15px; line-height: 1.35; font-weight: 600; color: var(--s-heading); }
.ct__card:hover .ct__title { text-decoration: underline; text-underline-offset: 3px; }
.ct__price { margin: 4px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.ct__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.75; }

.ct__more { margin-top: 32px; }
.ct__more--center { text-align: center; }
.ct__all { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 4px; transition: opacity 180ms ease; }
.ct__all:hover { opacity: 0.7; }
.ct__all:focus-visible { outline: 2px solid var(--s-active); outline-offset: 3px; border-radius: 4px; }

.ct__empty { margin: 0; padding: 32px 16px; text-align: center; font-size: 14px; color: var(--s-para); border: 1px dashed var(--s-border); border-radius: var(--s-radius); }

@media (prefers-reduced-motion: reduce) {
  .ct__p { animation: none !important; }
  .ct__t, .ct__media img, .ct__all { transition: none; }
  .ct__card:hover .ct__media img { transform: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "category_tabs",
  "name": "Category Tabs",
  "category": "products",
  "description": "Tabs across the top, one per collection, with that collection's products underneath.",
  "version": "1.0.0",
  "icon": "layout",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting line",
      "default": "<p>Pick a category to see what is in it right now.</p>"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading and tabs sit",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products per tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 4,
        "tablet": 3,
        "mobile": 2
      },
      "min": 1,
      "max": 5,
      "step": 1,
      "responsive": true
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Photo shape",
      "default": "4 / 5",
      "options": [
        {
          "label": "Square",
          "value": "1 / 1"
        },
        {
          "label": "Portrait",
          "value": "4 / 5"
        },
        {
          "label": "Tall",
          "value": "3 / 4"
        },
        {
          "label": "Landscape",
          "value": "4 / 3"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "default": "underline",
      "options": [
        {
          "label": "Underline",
          "value": "underline"
        },
        {
          "label": "Filled",
          "value": "pill"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "scheme.heading"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active tab colour",
      "default": "scheme.primary_button_background"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 36,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category tab",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab name",
          "default": "New in"
        },
        {
          "type": "collection_picker",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link wording",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link",
          "default": "/collections/all",
          "info": "Point this at the same collection as the tab."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": []
}
</schema>