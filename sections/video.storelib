  "shopify": {
    "name": "Video ",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "show_on_device",
        "label": "Show section on",
        "options": [
          {
            "value": "all",
            "label": "All"
          },
          {
            "value": "mobile",
            "label": "Mobile"
          },
          {
            "value": "desktop",
            "label": "Desktop"
          }
        ],
        "default": "all"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove the theme's space between sections",
        "default": true,
        "info": "The margin sliders below still apply."
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text_alignment",
        "id": "text_alignment",
        "label": "Text alignment (desktop)",
        "default": "center"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "container_max_width",
        "label": "Content max width",
        "min": 200,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "range",
        "id": "element_spacing",
        "label": "Space between text blocks",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "desktop_spacing_gap",
        "label": "Space between text and video (desktop)",
        "min": -100,
        "max": 100,
        "step": 10,
        "unit": "px",
        "default": -30
      },
      {
        "type": "select",
        "id": "video_aspect_ratio",
        "label": "Video shape",
        "options": [
          {
            "value": "none",
            "label": "Set width and height"
          },
          {
            "value": "16:9",
            "label": "Widescreen 16:9"
          },
          {
            "value": "4:3",
            "label": "Classic 4:3"
          },
          {
            "value": "1:1",
            "label": "Square 1:1"
          },
          {
            "value": "9:16",
            "label": "Vertical 9:16"
          },
          {
            "value": "21:9",
            "label": "Cinema 21:9"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "desktop_video_width",
        "label": "Video max width (desktop)",
        "min": 100,
        "max": 2000,
        "step": 100,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "desktop_video_height",
        "label": "Video height (desktop)",
        "min": 100,
        "max": 1080,
        "step": 10,
        "unit": "px",
        "default": 500,
        "visible_if": "{{ section.settings.video_aspect_ratio == 'none' }}"
      },
      {
        "type": "select",
        "id": "video_fit",
        "label": "Video fit",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Fill"
          },
          {
            "value": "contain",
            "label": "Fit"
          }
        ]
      },
      {
        "type": "header",
        "content": "Video"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video",
        "visible_if": "{{ section.settings.enable_custom_url_video == false }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_url_video",
        "label": "Use a video URL",
        "default": false
      },
      {
        "type": "url",
        "id": "custom_video_url",
        "label": "Video URL",
        "info": "An MP4 file, YouTube or Vimeo link.",
        "visible_if": "{{ section.settings.enable_custom_url_video }}"
      },
      {
        "type": "image_picker",
        "id": "video_poster",
        "label": "Cover image",
        "info": "Shown before the video plays, or alone when there is no video."
      },
      {
        "type": "checkbox",
        "id": "video_autoplay",
        "label": "Autoplay",
        "default": true,
        "info": "Starts muted while on screen. Not for visitors who ask for reduced motion."
      },
      {
        "type": "checkbox",
        "id": "video_muted",
        "label": "Muted",
        "default": true,
        "info": "Autoplay always starts muted.",
        "visible_if": "{{ section.settings.video_autoplay == false }}"
      },
      {
        "type": "checkbox",
        "id": "video_loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "video_controls",
        "label": "Player controls",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "big_play_pause_button",
        "label": "Play / pause button",
        "default": true,
        "visible_if": "{{ section.settings.video_controls == false }}"
      },
      {
        "type": "select",
        "id": "play_button_style",
        "label": "Play button style",
        "default": "circle",
        "options": [
          {
            "value": "circle",
            "label": "Filled"
          },
          {
            "value": "outline",
            "label": "Outline"
          }
        ],
        "visible_if": "{{ section.settings.big_play_pause_button and section.settings.video_controls == false }}"
      },
      {
        "type": "checkbox",
        "id": "video_inline",
        "label": "Play inline",
        "default": true,
        "hidden": true,
        "info": "Videos always play inline so autoplay works on phones."
      },
      {
        "type": "checkbox",
        "id": "enable_lazy_loading",
        "label": "Load the video when it is scrolled to",
        "default": false
      },
      {
        "type": "text",
        "id": "video_alt",
        "label": "Video description",
        "info": "Read by screen readers."
      },
      {
        "type": "textarea",
        "id": "video_metadata",
        "label": "Video title",
        "info": "Shown as a tooltip on the video."
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "section_background_color",
        "label": "Background (legacy)",
        "hidden": true,
        "info": "Older setting kept for saved content. Section background replaces it.",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "container_background_color",
        "label": "Content background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "container_border_color",
        "label": "Content border colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Link colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Video overlay colour",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "section_background_image_color",
