              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra-bold"
            }
          ]
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 44
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 30
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.9,
          "max": 2,
          "step": 0.1,
          "default": 1.2
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Have a question, idea, or just want to say hello? Drop us a message and we'll get back as quickly as we can.</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#475569"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
