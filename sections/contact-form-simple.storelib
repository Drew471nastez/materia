<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_field = 'accessibility.field' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Contact Form Simple.
  The form fields and contact info rows are blocks, so the creator can mix
  and match what is shown. Two columns on desktop (form + info / image),
  stacked on mobile. The form is the store's contact form
  (the theme's contact form tag): its own success and error messages, every field
  with a label. Theme first: the colour scheme, Theme settings > Typography,
  Buttons and Forms and fields; Enable custom styling, Enable custom fonts,
  Match theme fields and Match theme button switch the section's own values
  on. live-contact.js applies live edits without a redraw.

  Block types:
    - heading       : Section heading
    - subheading    : Section subheading
    - field         : One form field (text / email / phone / dropdown / message)
    - submit        : The submit button
    - info          : One contact info row (icon + label + value)
    - side_image    : Optional image for the right (or left) column
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign fields  = section.blocks | where: 'type', 'field'
  assign infos   = section.blocks | where: 'type', 'info'
  assign submits = section.blocks | where: 'type', 'submit'
  assign side_image_block = nil
  for b in section.blocks
    if b.type == 'side_image' and side_image_block == nil
      assign side_image_block = b
    endif
  endfor
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
  assign side_pos = st.side_column_position | default: 'right'
  assign cfs_custom = st.enable_custom_style
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign own_field = false
  if st.use_theme_fields == false
    assign own_field = true
  endif
  assign own_shape = false
  if st.use_theme_button == false
    assign own_shape = true
  endif
  assign form_boxed = false
  if cfs_custom and st.form_bg != blank and st.form_bg.alpha != 0 and st.form_bg != 'transparent' and st.form_bg != 'rgba(0,0,0,0)'
    assign form_boxed = true
  endif
  assign label_weight = st.label_weight | default: 'theme'
  assign cfs_shop_phone = shop.phone | default: shop.address.phone
-%}
{%- capture cfs_vars -%}
  --cfs-pt-m:{{ st.padding_top_mobile | default: 56 }}px;--cfs-pb-m:{{ st.padding_bottom_mobile | default: 56 }}px;--cfs-pt-d:{{ st.padding_top_desktop | default: 96 }}px;--cfs-pb-d:{{ st.padding_bottom_desktop | default: 96 }}px;
  --cfs-w-m:{{ st.section_max_width_mobile | default: 560 }}px;--cfs-w-t:{{ st.section_max_width_tablet | default: 900 }}px;--cfs-w-d:{{ st.section_max_width_desktop | default: 1100 }}px;
  --cfs-align:{{ align }};--cfs-flex:{{ flex_align }};
  --cfs-hgap-m:{{ st.heading_sub_gap_mobile | default: 8 }}px;--cfs-hgap-d:{{ st.heading_sub_gap_desktop | default: 14 }}px;--cfs-gap-m:{{ st.gap_subheading_content_mobile | default: 32 }}px;--cfs-gap-d:{{ st.gap_subheading_content | default: 56 }}px;
  --cfs-cols:{{ st.form_col_ratio | default: '3fr' }} {{ st.side_col_ratio | default: '2fr' }};--cfs-col-gap-m:{{ st.col_gap_mobile | default: 32 }}px;--cfs-col-gap-d:{{ st.col_gap_desktop | default: 48 }}px;
  --cfs-field-gap:{{ st.field_gap | default: 16 }}px;--cfs-label-size:{{ st.label_size | default: 14 }}px;--cfs-ta-h:{{ st.textarea_min_height | default: 140 }}px;--cfs-img-r:{{ st.side_image_radius | default: 16 }}px;
  {%- if label_weight != 'theme' -%}--cfs-label-weight:{{ label_weight }};{%- endif -%}
  {%- if form_boxed -%}--cfs-form-pad:{{ st.form_padding | default: 32 }}px;--cfs-form-r:{{ st.form_radius | default: 16 }}px;{%- endif -%}
  {%- if cfs_custom -%}
    --cfs-bg:{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %};
    --cfs-form-bg:{% render 'scheme-color', color: st.form_bg, fallback: 'transparent' %};
    --cfs-label-c:{% render 'scheme-color', color: st.label_color, fallback: 'var(--color-text)' %};
    --cfs-req-c:{% render 'scheme-color', color: st.required_color, fallback: 'var(--color-primary)' %};
    --cfs-ib:{% render 'scheme-color', color: st.info_icon_bg, fallback: 'color-mix(in srgb, var(--color-heading) 8%, transparent)' %};
    --cfs-ic:{% render 'scheme-color', color: st.info_icon_color, fallback: 'var(--color-heading)' %};
    --cfs-il:{% render 'scheme-color', color: st.info_label_color, fallback: 'color-mix(in srgb, var(--color-text) 72%, transparent)' %};
    --cfs-iv:{% render 'scheme-color', color: st.info_value_color, fallback: 'var(--color-heading)' %};
    --cfs-id:{% render 'scheme-color', color: st.info_border_color, fallback: 'var(--color-border)' %};
  {%- endif -%}
  {%- if sec_font and st.heading_font.family != blank -%}--ct-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
  {%- if sec_font and st.body_font.family != blank -%}--ct-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
{%- capture cfs_field_vars -%}
  {%- if own_field -%}
    --input-border-radius:{{ st.input_radius | default: 10 }}px;--input-padding:{{ st.input_padding_y | default: 14 }}px {{ st.input_padding_x | default: 16 }}px;--inputs-border-width:{{ st.input_border_width | default: 1 }}px;--field-border-widths:{{ st.input_border_width | default: 1 }}px;--cfs-in-size:{{ st.input_size | default: 16 }}px;
    {%- if st.input_bg != blank and st.input_bg.alpha != 0 -%}--input-bg:{{ st.input_bg }};{%- endif -%}
    {%- if st.input_text_color != blank and st.input_text_color.alpha != 0 -%}--field-text:{{ st.input_text_color }};{%- endif -%}
    {%- if st.placeholder_color != blank and st.placeholder_color.alpha != 0 -%}--field-placeholder:{{ st.placeholder_color }};--field-placeholder-opacity:1;{%- endif -%}
    {%- if st.input_border_color != blank and st.input_border_color.alpha != 0 -%}--input-border-color:{{ st.input_border_color }};{%- endif -%}
    {%- if st.input_focus_color != blank and st.input_focus_color.alpha != 0 -%}--input-focus-color:{{ st.input_focus_color }};{%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture cfs_button_vars -%}
  {%- if cfs_custom -%}{% render 'button-overrides', bg: st.submit_bg, text: st.submit_color, hover_bg: st.submit_bg_hover, hover_text: st.submit_color %}{%- endif -%}
  {%- if own_shape -%}--mb-radius:{{ st.submit_radius | default: 100 }}px;--mb-font-size:{{ st.submit_size | default: 16 }}px;--mb-padding-x:{{ st.submit_pad_x | default: 32 }}px;--mb-padding-y:{{ st.submit_pad_y | default: 16 }}px;{%- endif -%}
  {%- if sec_font and st.body_font.family != blank -%}--mb-font:var(--ct-bf);{%- endif -%}
{%- endcapture -%}
{%- if sec_font -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }
  {%- render 'contact-live-width', sid: sid -%}

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .cfs {
    background: var(--cfs-bg, var(--color-background)) !important;
    padding-top: var(--cfs-pt-m);
    padding-bottom: var(--cfs-pb-m);
  }
  #shopify-section-{{ sid }} .cfs__inner {
    max-width: var(--cfs-w-m);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cfs { padding-top: var(--cfs-pt-d); padding-bottom: var(--cfs-pb-d); }
    #shopify-section-{{ sid }} .cfs__inner { max-width: var(--cfs-w-t); padding-inline: 1.5rem; }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .cfs__inner { max-width: var(--cfs-w-d); }
  }

  /* Header */
  #shopify-section-{{ sid }} .cfs__header {
    display: flex;
    flex-direction: column;
    align-items: var(--cfs-flex);
    text-align: var(--cfs-align);
    margin: 0 auto var(--cfs-gap-m);
    gap: var(--cfs-hgap-m);
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cfs__header { margin-bottom: var(--cfs-gap-d); gap: var(--cfs-hgap-d); }
  }
  #shopify-section-{{ sid }} .cfs__header > *,
  #shopify-section-{{ sid }} .cfs__header :is(h1, h2, h3, h4, h5, h6, p, div, span) {
    margin-block: 0 !important;
    padding-block: 0 !important;
  }
  #shopify-section-{{ sid }} .cfs__header[hidden],
  #shopify-section-{{ sid }} [data-ct-block][hidden] { display: none !important; }
  #shopify-section-{{ sid }} .cfs__heading { color: var(--cfs-h-c, var(--color-heading)); }
  #shopify-section-{{ sid }} .cfs__heading[data-own-weight] { font-weight: var(--cfs-h-fw); }
  #shopify-section-{{ sid }} .cfs__heading[data-own-size] { font-size: var(--cfs-h-m); line-height: var(--cfs-h-lh); letter-spacing: var(--cfs-h-ls); }
  #shopify-section-{{ sid }} .cfs__heading[data-own-font] { font-family: var(--cfs-ff, var(--ct-hf, var(--heading-font))); }
  #shopify-section-{{ sid }} .cfs__sub { color: var(--cfs-s-c, var(--color-text)); max-width: var(--cfs-s-mw); }
  #shopify-section-{{ sid }} .cfs__sub[data-own-weight] { font-weight: var(--cfs-s-fw); }
  #shopify-section-{{ sid }} .cfs__sub[data-own-size] { font-size: var(--cfs-s-fs); line-height: var(--cfs-s-lh); }
  #shopify-section-{{ sid }} .cfs__sub[data-own-size] :is(p, li, span, strong, em) { font-size: inherit; line-height: inherit; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cfs__heading[data-own-size] { font-size: var(--cfs-h-d); }
  }
  #shopify-section-{{ sid }} :is(.cfs__sub, .cfs__form, .cfs__info)[data-own-font] { font-family: var(--cfs-ff, var(--ct-bf, var(--body-font))); }
  #shopify-section-{{ sid }} .cfs__form[data-own-font] { --body-font: var(--ct-bf); }

  /* Content grid */
  #shopify-section-{{ sid }} .cfs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cfs-col-gap-m);
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cfs__grid {
      grid-template-columns: var(--cfs-cols);
      gap: var(--cfs-col-gap-d);
      align-items: start;
    }
    #shopify-section-{{ sid }} [data-cfs-side="left"] .cfs__form-col { order: 2; }
    #shopify-section-{{ sid }} [data-cfs-side="left"] .cfs__side-col { order: 1; }
  }

  /* Form */
  #shopify-section-{{ sid }} .cfs__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cfs-field-gap);
    background: var(--cfs-form-bg, transparent);
    padding: var(--cfs-form-pad, 0px);
    border-radius: var(--cfs-form-r, 0px);
  }
  #shopify-section-{{ sid }} .cfs__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    grid-column: 1 / -1;
    min-width: 0;
  }
  @media (min-width: 600px) {
    #shopify-section-{{ sid }} .cfs__form { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ sid }} .cfs__field[data-half] { grid-column: auto; }
  }
  #shopify-section-{{ sid }} .cfs__form > :not(.cfs__field):not(.cfs__submit) { grid-column: 1 / -1; }
  #shopify-section-{{ sid }} .cfs__label {
    font-size: var(--cfs-label-size);
    color: var(--cfs-label-c, var(--color-text));
    margin: 0 !important;
  }
  #shopify-section-{{ sid }} .cfs__form[data-own-weight] .cfs__label { font-weight: var(--cfs-label-weight); }
  #shopify-section-{{ sid }} .cfs__label-required { color: var(--cfs-req-c, var(--color-primary)); margin-left: 2px; }
  #shopify-section-{{ sid }} .cfs__label [hidden] { display: none; }
  #shopify-section-{{ sid }} :is(.cfs__input, .cfs__textarea, .cfs__select) {
    width: 100%;
    line-height: 1.4;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ sid }} [data-cfs-own-field] :is(.cfs__input, .cfs__textarea, .cfs__select) { --body-font-size: var(--cfs-in-size); }
  #shopify-section-{{ sid }} .cfs__textarea { min-height: var(--cfs-ta-h); resize: vertical; }

  /* Submit button: the theme button, or this section's colours and shape */
  #shopify-section-{{ sid }} .cfs__submit {
    grid-column: 1 / -1;
    justify-self: var(--cfs-flex);
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .cfs__submit[data-cfs-full] { justify-self: stretch; width: 100%; }
  #shopify-section-{{ sid }} .cfs__submit:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }

  /* Form messages */
  #shopify-section-{{ sid }} .cfs__success,
  #shopify-section-{{ sid }} .cfs__errors {
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.5;
  }
  #shopify-section-{{ sid }} .cfs__success {
    background: color-mix(in srgb, #15803D 14%, var(--color-background));
    color: color-mix(in srgb, #15803D 70%, var(--color-heading));
    border: 1px solid color-mix(in srgb, #15803D 35%, transparent);
  }
  #shopify-section-{{ sid }} .cfs__errors {
    background: color-mix(in srgb, #B91C1C 12%, var(--color-background));
    color: color-mix(in srgb, #B91C1C 70%, var(--color-heading));
    border: 1px solid color-mix(in srgb, #B91C1C 35%, transparent);
  }
  #shopify-section-{{ sid }} .cfs__errors ul { margin: 6px 0 0; padding-left: 20px; }

  /* Side column */
  #shopify-section-{{ sid }} .cfs__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #shopify-section-{{ sid }} .cfs__side-image {
    width: 100%;
    height: auto;
    border-radius: var(--cfs-img-r);
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ sid }} .cfs__side-placeholder svg { width: 100%; height: auto; aspect-ratio: 4 / 3; border-radius: var(--cfs-img-r); background: color-mix(in srgb, var(--color-text) 6%, transparent); fill: color-mix(in srgb, var(--color-text) 30%, transparent); }

  /* Info row */
  #shopify-section-{{ sid }} .cfs__info {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--cfs-id, var(--color-border));
  }
  #shopify-section-{{ sid }} .cfs__info:first-of-type { border-top: 0; padding-top: 0; }
  #shopify-section-{{ sid }} .cfs__info-icon {
    width: 40px; height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cfs-ib, color-mix(in srgb, var(--color-heading) 8%, transparent));
    color: var(--cfs-ic, var(--color-heading));
  }
  #shopify-section-{{ sid }} .cfs__info-icon svg { width: 20px; height: 20px; }
  #shopify-section-{{ sid }} .cfs__info-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--cfs-il, color-mix(in srgb, var(--color-text) 72%, transparent));
    font-weight: 600;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .cfs__info-value {
    font-size: 16px;
    color: var(--cfs-iv, var(--color-heading));
    font-weight: 500;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .cfs__info-value a { color: inherit; text-decoration: none; display: inline-block; padding-block: 12px; margin-block: -12px; }
  #shopify-section-{{ sid }} .cfs__info-value a:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} .cfs__info [hidden] { display: none; }

  /* Show / hide by device */
  #shopify-section-{{ sid }} [data-cfs-show="desktop"] { display: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} [data-cfs-show="desktop"] { display: block; }
    #shopify-section-{{ sid }} [data-cfs-show="mobile"] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.cfs__input, .cfs__textarea, .cfs__select) { transition: none; }
  }
{% comment %}{% endcomment %}</style>

<section class="cfs color-{{ color_scheme }} gradient {{ section.settings.section_width }}" id="cfs-{{ sid }}"
  data-ct-root="contact-form-simple" data-ct-section="{{ sid }}" data-ct-settings="{{ section.settings | json | escape }}" data-ct-w="{{ section.settings.section_width }}" data-ct-width
  data-cfs-show="{{ st.show_section_on | default: 'all' }}" data-cfs-side="{{ side_pos }}"
  data-cfs-shop="{{ shop.email | escape }}|{{ cfs_shop_phone | escape }}|{{ shop.address.summary | escape }}" data-cfs-word="{{ fb_accessibility_field | escape }}" data-cfs-send="{{ 'accessibility.send_message' | t | escape }}"
  style="{{ cfs_vars | strip_newlines }}">
  <div class="cfs__inner">

    {%- comment -%}========== HEADER ==========={%- endcomment -%}
    {%- assign has_header = false -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'heading' or b.type == 'subheading' -%}
        {%- if b.settings.text != blank -%}{%- assign has_header = true -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="cfs__header" data-ct-header{% unless has_header %} hidden{% endunless %}>
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- assign b_font = false -%}
        {%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign b_font = true -%}{%- endif -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- capture b_vars -%}
              {%- if bs.enable_custom_style -%}--cfs-h-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
              {%- if bs.weight != blank and bs.weight != 'theme' -%}--cfs-h-fw:{{ bs.weight }};{%- endif -%}
              {%- if bs.size_enable -%}--cfs-h-m:{{ bs.size_mobile | default: 30 }}px;--cfs-h-d:{{ bs.size_desktop | default: 44 }}px;--cfs-h-lh:{{ bs.line_height | default: 1.2 }};--cfs-h-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
              {%- if b_font -%}--cfs-ff:{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
            {%- endcapture -%}
            {%- if b_font -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <h2 id="block-{{ block.id }}" class="cfs__heading" data-ct-block="{{ block.id }}" data-ct-type="heading" data-ct-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight != blank and bs.weight != 'theme' %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if b_vars != blank %} style="{{ b_vars }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>

          {%- when 'subheading' -%}
            {%- capture b_vars -%}
              --cfs-s-mw:{{ bs.max_width | default: 600 }}px;
              {%- if bs.enable_custom_style -%}--cfs-s-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
              {%- if bs.weight_enable -%}--cfs-s-fw:{{ bs.weight | default: 400 }};{%- endif -%}
              {%- if bs.size_enable -%}--cfs-s-fs:{{ bs.size | default: 16 }}px;--cfs-s-lh:{{ bs.line_height | default: 1.5 }};{%- endif -%}
              {%- if b_font -%}--cfs-ff:{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
            {%- endcapture -%}
            {%- if b_font -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <div id="block-{{ block.id }}" class="cfs__sub" data-ct-block="{{ block.id }}" data-ct-type="subheading" data-ct-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ b_vars }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%}========== TWO-COLUMN GRID ==========={%- endcomment -%}
    <div class="cfs__grid">

      {%- comment -%}---- FORM COLUMN ----{%- endcomment -%}
      <div class="cfs__form-col">
        {%- assign form_id = 'cfs-form-' | append: sid -%}
        {%- form 'contact', id: form_id, class: 'cfs__form-tag' -%}
          {%- comment -%} The fields' wrapper carries the section's field values (Match theme fields off) and type switches. {%- endcomment -%}
          <div class="cfs__form" data-cfs-form{% if own_field %} data-cfs-own-field{% endif %}{% if sec_font %} data-own-font{% endif %}{% if label_weight != 'theme' %} data-own-weight{% endif %} style="{{ cfs_field_vars | strip_newlines }}">
          {%- if form.posted_successfully? -%}
            <div class="cfs__success" role="status">{{ st.success_message | default: 'Thanks for reaching out. We will get back to you shortly.' }}</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="cfs__errors" role="alert">
              <strong>{{ st.error_message | default: 'Please check the following:' }}</strong>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- assign field_count = fields | size -%}
          {%- if field_count == 0 -%}
            {%- comment -%} Default fields when there are no field blocks {%- endcomment -%}
            <div class="cfs__field" data-half>
              <label class="cfs__label" for="cfs-name-{{ sid }}">{{ 'accessibility.name' | t }}</label>
              <input class="cfs__input" type="text" id="cfs-name-{{ sid }}" name="contact[Name]" placeholder="{{ 'accessibility.your_name' | t }}" autocomplete="name">
            </div>
            <div class="cfs__field" data-half>
              <label class="cfs__label" for="cfs-email-{{ sid }}">{{ 'accessibility.email' | t }} <span class="cfs__label-required" aria-hidden="true">*</span></label>
              <input class="cfs__input" type="email" id="cfs-email-{{ sid }}" name="contact[email]" placeholder="you@example.com" autocomplete="email" required>
            </div>
            <div class="cfs__field">
              <label class="cfs__label" for="cfs-msg-{{ sid }}">{{ 'accessibility.message' | t }} <span class="cfs__label-required" aria-hidden="true">*</span></label>
              <textarea class="cfs__textarea" id="cfs-msg-{{ sid }}" name="contact[body]" placeholder="{{ 'accessibility.how_can_we_help' | t }}" required></textarea>
            </div>
          {%- else -%}
            {%- for fb in fields -%}
              {%- assign fs = fb.settings -%}
              {%- assign id_attr = 'cfs-' | append: sid | append: '-' | append: fb.id -%}
              {%- assign field_name = fs.name | default: fs.label | default: fb_accessibility_field -%}
              {%- assign attr_name = 'contact[' | append: field_name | append: ']' -%}
              {%- if fs.field_type == 'email' -%}
                {%- assign attr_name = 'contact[email]' -%}
              {%- elsif fs.field_type == 'textarea' -%}
                {%- assign attr_name = 'contact[body]' -%}
              {%- endif -%}
              {%- assign label_text = fs.label | default: fs.placeholder | default: field_name -%}
              <div class="cfs__field" id="block-{{ fb.id }}" data-ct-block="{{ fb.id }}" data-ct-type="field" data-ct-settings="{{ fs | json | escape }}"{% if fs.half_width and fs.field_type != 'textarea' %} data-half{% endif %} {{ fb.shopify_attributes }}>
                <label class="cfs__label{% if fs.label == blank %} visually-hidden{% endif %}" for="{{ id_attr }}"><span data-cfs-label>{{ label_text }}</span><span class="cfs__label-required" aria-hidden="true"{% unless fs.required %} hidden{% endunless %}>*</span></label>
                {%- case fs.field_type -%}
                  {%- when 'textarea' -%}
                    <textarea class="cfs__textarea" id="{{ id_attr }}" name="{{ attr_name }}" placeholder="{{ fs.placeholder | escape }}"{% if fs.required %} required{% endif %}></textarea>
                  {%- when 'email' -%}
                    <input class="cfs__input" type="email" id="{{ id_attr }}" name="{{ attr_name }}" placeholder="{{ fs.placeholder | escape }}" autocomplete="email"{% if fs.required %} required{% endif %}>
                  {%- when 'tel' -%}
                    <input class="cfs__input" type="tel" id="{{ id_attr }}" name="{{ attr_name }}" placeholder="{{ fs.placeholder | escape }}" autocomplete="tel"{% if fs.required %} required{% endif %}>
                  {%- when 'select' -%}
                    {%- assign options = fs.options | default: '' | split: ',' -%}
                    <select class="cfs__select" id="{{ id_attr }}" name="{{ attr_name }}"{% if fs.required %} required{% endif %}>
                      {%- if fs.placeholder != blank -%}<option value="">{{ fs.placeholder }}</option>{%- endif -%}
                      {%- for opt in options -%}
                        {%- assign trimmed = opt | strip -%}
                        {%- if trimmed != blank -%}<option value="{{ trimmed | escape }}">{{ trimmed }}</option>{%- endif -%}
                      {%- endfor -%}
                    </select>
                  {%- else -%}
                    <input class="cfs__input" type="text" id="{{ id_attr }}" name="{{ attr_name }}" placeholder="{{ fs.placeholder | escape }}"{% if fs.required %} required{% endif %}>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- assign send_fallback = 'accessibility.send_message' | t -%}
          {%- if field_count > 0 and submits.size > 0 -%}
            {%- for sb in submits -%}
              <button type="submit" class="cfs__submit" data-theme-button="primary" data-sl-button data-button-role="primary" id="block-{{ sb.id }}" data-ct-block="{{ sb.id }}" data-ct-type="submit" data-ct-settings="{{ sb.settings | json | escape }}"{% if st.submit_full_width %} data-cfs-full{% endif %}{% if own_shape %} data-own-shape{% endif %}{% if sec_font %} data-own-font{% endif %} style="{{ cfs_button_vars | strip_newlines }}" {{ sb.shopify_attributes }}>{{ sb.settings.label | default: send_fallback }}</button>
            {%- endfor -%}
          {%- else -%}
            <button type="submit" class="cfs__submit" data-theme-button="primary" data-sl-button data-button-role="primary" data-cfs-default-submit{% if st.submit_full_width %} data-cfs-full{% endif %}{% if own_shape %} data-own-shape{% endif %}{% if sec_font %} data-own-font{% endif %} style="{{ cfs_button_vars | strip_newlines }}">{{ st.submit_label | default: send_fallback }}</button>
          {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      {%- comment -%}---- SIDE COLUMN ----{%- endcomment -%}
      {%- if infos.size > 0 or side_image_block -%}
        <div class="cfs__side-col">
          <div class="cfs__side">
            {%- if side_image_block and side_image_block.settings.image -%}
              <img class="cfs__side-image"
                   src="{{ side_image_block.settings.image | image_url: width: 1000 }}"
                   alt="{{ side_image_block.settings.alt | default: '' | escape }}"
                   loading="lazy" decoding="async"
                   width="{{ side_image_block.settings.image.width }}"
                   height="{{ side_image_block.settings.image.height }}"
                   data-ct-block="{{ side_image_block.id }}" data-ct-type="side_image" data-ct-settings="{{ side_image_block.settings | json | escape }}"
                   {{ side_image_block.shopify_attributes }}>
            {%- elsif side_image_block -%}
              <div class="cfs__side-placeholder" data-ct-block="{{ side_image_block.id }}" data-ct-type="side_image" data-ct-settings="{{ side_image_block.settings | json | escape }}" {{ side_image_block.shopify_attributes }}>{{ 'image' | placeholder_svg_tag: 'cfs__side-image' }}</div>
            {%- endif -%}

            {%- if infos.size > 0 -%}
              <div class="cfs__info-list">
                {%- for inf in infos -%}
                  {%- assign is = inf.settings -%}
                  {%- comment -%} An empty value shows the store's own email, phone or address (Settings > Store details). {%- endcomment -%}
                  {%- assign info_value = is.value -%}
                  {%- assign info_link  = is.link -%}
                  {%- if info_value == blank -%}
                    {%- case is.icon -%}
                      {%- when 'mail', 'message' -%}{%- assign info_value = shop.email -%}
                      {%- when 'phone' -%}{%- assign info_value = cfs_shop_phone -%}
                      {%- when 'pin' -%}{%- assign info_value = shop.address.summary -%}
                    {%- endcase -%}
                  {%- endif -%}
                  {%- if info_link == blank and info_value != blank -%}
                    {%- case is.icon -%}
                      {%- when 'mail', 'message' -%}{%- assign info_link = 'mailto:' | append: info_value -%}
                      {%- when 'phone' -%}{%- assign cleaned = info_value | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}{%- assign info_link = 'tel:' | append: cleaned -%}
                    {%- endcase -%}
                  {%- endif -%}
                  <div class="cfs__info" id="block-{{ inf.id }}" data-ct-block="{{ inf.id }}" data-ct-type="info" data-ct-settings="{{ is | json | escape }}"{% if sec_font %} data-own-font{% endif %}{% if is.label == blank and info_value == blank %} hidden{% endif %} {{ inf.shopify_attributes }}>
                    <span class="cfs__info-icon" data-cfs-icon>{% render 'contact-live-icons', set: 'cfs', name: is.icon %}</span>
                    <div>
                      <div class="cfs__info-label"{% if is.label == blank %} hidden{% endif %}>{{ is.label }}</div>
                      <div class="cfs__info-value"{% if info_value == blank %} hidden{% endif %}>
                        {%- if info_link != blank -%}<a href="{{ info_link }}">{{ info_value }}</a>{%- else -%}<span>{{ info_value }}</span>{%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
  {%- render 'contact-live-icons', set: 'cfs', all: true -%}
</section>



</template>

<schema>
{
  "type": "contact-form-simple",
  "name": "Contact Form Simple",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Button label",
      "default": "Send message",
      "hidden": true,
      "info": "Legacy: used only when the section has no submit button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Messages"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out. We will get back to you shortly."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please check the following:"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Content width (desktop)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Content width (tablet)",
      "min": 500,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "section_max_width_mobile",
      "label": "Content width (mobile)",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "heading_sub_gap_desktop",
      "label": "Gap below heading (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_sub_gap_mobile",
      "label": "Gap below heading (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap_subheading_content",
      "label": "Gap above the form (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "gap_subheading_content_mobile",
      "label": "Gap above the form (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "side_column_position",
      "label": "Side column (desktop)",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "text",
      "id": "form_col_ratio",
      "label": "Form column width (desktop)",
      "default": "3fr",
      "info": "A share of the row, for example 3fr."
    },
    {
      "type": "text",
      "id": "side_col_ratio",
      "label": "Side column width (desktop)",
      "default": "2fr",
      "info": "A share of the row, for example 2fr."
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Gap between columns (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Gap between columns (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "form_bg",
      "label": "Form background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Labels",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "required_color",
      "label": "Required mark",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "submit_bg",
      "label": "Button background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "submit_bg_hover",
      "label": "Button background on hover",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "submit_color",
      "label": "Button text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "info_icon_bg",
      "label": "Info icon background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "info_icon_color",
      "label": "Info icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "info_label_color",
      "label": "Info label",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "info_value_color",
      "label": "Info value",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "info_border_color",
      "label": "Info divider",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Form"
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Gap between fields",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "form_padding",
      "label": "Form padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.form_bg != blank }}"
    },
    {
      "type": "range",
      "id": "form_radius",
      "label": "Form corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.form_bg != blank }}"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "textarea_min_height",
      "label": "Message field height",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "id": "hdr_46",
      "label": "Fields"
    },
    {
      "type": "checkbox",
      "id": "use_theme_fields",
      "label": "Match theme fields",
      "default": true,
      "info": "On: fields follow Theme settings > Forms and fields."
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Field background",
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Field text",
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Field border",
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "color",
      "id": "input_focus_color",
      "label": "Field focus ring",
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "id": "input_border_width",
      "label": "Field border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Field corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "id": "input_padding_y",
      "label": "Field padding (top and bottom)",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "id": "input_padding_x",
      "label": "Field padding (sides)",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "range",
      "id": "input_size",
      "label": "Field text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.use_theme_fields == false }}"
    },
    {
      "type": "header",
      "id": "hdr_58",
      "label": "Submit button"
    },
    {
      "type": "checkbox",
      "id": "submit_full_width",
