        "label": "Info icon",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "info_label_color",
        "label": "Info label",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "info_value_color",
        "label": "Info value",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "info_border_color",
        "label": "Info divider",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Form"
      },
      {
        "type": "range",
        "id": "field_gap",
        "label": "Gap between fields",
        "min": 4,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "form_padding",
        "label": "Form padding",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 32,
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.form_bg != blank }}"
      },
      {
        "type": "range",
        "id": "form_radius",
        "label": "Form corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.form_bg != blank }}"
      },
      {
        "type": "range",
        "id": "label_size",
        "label": "Label size",
        "min": 11,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "select",
        "id": "label_weight",
        "label": "Label weight",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "400",
            "label": "Normal"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi-bold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "range",
        "id": "textarea_min_height",
        "label": "Message field height",
        "min": 80,
        "max": 320,
        "step": 4,
        "unit": "px",
        "default": 140
      },
      {
        "type": "header",
        "content": "Fields"
      },
      {
        "type": "checkbox",
        "id": "use_theme_fields",
        "label": "Match theme fields",
        "default": true,
        "info": "On: fields follow Theme settings > Forms and fields."
      },
      {
        "type": "color",
        "id": "input_bg",
        "label": "Field background",
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "color",
        "id": "input_text_color",
        "label": "Field text",
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "color",
        "id": "placeholder_color",
        "label": "Placeholder",
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "color",
        "id": "input_border_color",
        "label": "Field border",
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "color",
        "id": "input_focus_color",
        "label": "Field focus ring",
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "range",
        "id": "input_border_width",
        "label": "Field border width",
        "min": 0,
        "max": 4,
        "step": 1,
        "unit": "px",
        "default": 1,
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "range",
        "id": "input_radius",
        "label": "Field corner radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 10,
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "range",
        "id": "input_padding_y",
        "label": "Field padding (top and bottom)",
        "min": 6,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14,
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "range",
        "id": "input_padding_x",
        "label": "Field padding (sides)",
        "min": 6,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "range",
        "id": "input_size",
        "label": "Field text size",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.use_theme_fields == false }}"
      },
      {
        "type": "header",
        "content": "Submit button"
      },
      {
        "type": "checkbox",
        "id": "submit_full_width",
        "label": "Full width button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Match theme button",
        "default": true
      },
      {
        "type": "range",
        "id": "submit_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 100,
        "info": "Max value = pill shape.",
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "submit_size",
        "label": "Button text size",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "submit_pad_x",
        "label": "Button padding (sides)",
        "min": 12,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 32,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "submit_pad_y",
        "label": "Button padding (top and bottom)",
        "min": 8,
        "max": 28,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Side image"
      },
      {
        "type": "range",
        "id": "side_image_radius",
        "label": "Side image corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "default": "assistant_n4",
        "id": "heading_font",
        "label": "Heading font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "default": "assistant_n4",
        "id": "body_font",
        "label": "Body font",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0,
        "unit": "px",
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "Get in touch"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              }
            ],
            "hidden": true,
            "info": "Legacy: the heading is always an h2 (the hero holds the page's h1).",
            "visible_if": "{{ false }}"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "default": "assistant_n4",
            "id": "font",
            "label": "Font",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 44,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 30,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.2,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -2,
            "max": 6,
            "step": 0.5,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Have a question, idea, or just want to say hello? Drop us a message and we'll get back as quickly as we can.</p>"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 900,
            "step": 10,
            "unit": "px",
            "default": 600
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "default": "assistant_n4",
            "id": "font",
            "label": "Font",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              {
                "value": "300",
                "label": "300"
              },
              {
                "value": "400",
                "label": "400"
              },
              {
                "value": "500",
                "label": "500"
              },
              {
                "value": "600",
                "label": "600"
              },
              {
                "value": "700",
                "label": "700"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "field",
        "name": "Form field",
        "settings": [
          {
            "type": "select",
            "id": "field_type",
            "label": "Field type",
            "default": "text",
            "options": [
              {
                "value": "text",
                "label": "Text"
              },
              {
                "value": "email",
                "label": "Email"
              },
              {
                "value": "tel",
                "label": "Phone"
              },
              {
                "value": "select",
                "label": "Dropdown"
              },
              {
                "value": "textarea",
                "label": "Textarea (long message)"
              }
            ]
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Name"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Field name",
            "default": "Name",
            "info": "Shown in the email you receive."
          },
          {
            "type": "text",
            "id": "placeholder",
            "label": "Placeholder",
            "default": "Your name"
          },
          {
            "type": "checkbox",
            "id": "required",
            "label": "Required",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "half_width",
            "label": "Half width on desktop",
            "default": false,
            "visible_if": "{{ block.settings.field_type != 'textarea' }}"
          },
          {
            "type": "textarea",
            "id": "options",
            "label": "Dropdown options",
            "info": "Separate the options with commas.",
            "visible_if": "{{ block.settings.field_type == 'select' }}"
          }
        ]
      },
      {
        "type": "submit",
        "name": "Submit button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Send message"
          }
        ]
      },
      {
        "type": "info",
        "name": "Contact info row",
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "mail",
            "options": [
              {
                "value": "mail",
                "label": "Mail"
              },
              {
                "value": "phone",
                "label": "Phone"
              },
              {
                "value": "pin",
                "label": "Map pin"
              },
              {
                "value": "clock",
                "label": "Clock"
              },
              {
                "value": "message",
                "label": "Message"
              }
            ]
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Email us"
          },
          {
            "type": "text",
            "id": "value",
            "label": "Value"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link (optional)"
          }
        ]
      },
      {
        "type": "side_image",
        "name": "Side image",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "alt",
            "label": "Alt text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Contact Form Simple",
        "category": "Contact",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "field",
            "settings": {
              "field_type": "text",
              "label": "Name",
              "name": "Name",
              "placeholder": "Your name",
              "required": true,
              "half_width": true
            }
          },
          {
            "type": "field",
            "settings": {
              "field_type": "email",
              "label": "Email",
              "name": "email",
              "placeholder": "you@example.com",
              "required": true,
              "half_width": true
            }
          },
          {
            "type": "field",
            "settings": {
              "field_type": "text",
              "label": "Subject",
              "name": "Subject",
              "placeholder": "What is it about?",
              "required": false,
              "half_width": false
            }
          },
          {
            "type": "field",
            "settings": {
              "field_type": "textarea",
              "label": "Message",
              "name": "body",
              "placeholder": "How can we help?",
              "required": true,
              "half_width": false
            }
          },
          {
            "type": "submit"
          },
          {
            "type": "info",
            "settings": {
              "icon": "mail",
              "label": "Email us"
            }
          },
          {
            "type": "info",
            "settings": {
              "icon": "phone",
              "label": "Call us"
            }
          },
          {
            "type": "info",
            "settings": {
              "icon": "clock",
              "label": "Hours",
              "value": "Add your opening hours"
            }
          }
        ]
      }
    ]
  }
}
</schema>
