  "presets": [
    {
      "name": "Contact Form Simple",
      "category": "Contact",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "field",
          "settings": {
            "field_type": "text",
            "label": "Name",
            "name": "Name",
            "placeholder": "Your name",
            "required": true,
            "half_width": true
          }
        },
        {
          "type": "field",
          "settings": {
            "field_type": "email",
            "label": "Email",
            "name": "email",
            "placeholder": "you@example.com",
            "required": true,
            "half_width": true
          }
        },
        {
          "type": "field",
          "settings": {
            "field_type": "text",
            "label": "Subject",
            "name": "Subject",
            "placeholder": "What is it about?",
            "required": false,
            "half_width": false
          }
        },
        {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "label": "Message",
            "name": "body",
            "placeholder": "How can we help?",
            "required": true,
            "half_width": false
          }
        },
        {
          "type": "submit"
        },
        {
          "type": "info",
          "settings": {
            "icon": "mail",
            "label": "Email us"
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "phone",
            "label": "Call us"
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "clock",
            "label": "Hours",
            "value": "Add your opening hours"
          }
        }
      ]
    }
  ],
