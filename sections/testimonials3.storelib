<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign scroll_anim = settings.scroll_animation | default: 'none'
  assign mpv = st.mobile_per_view | default: 1
  assign fb_customer = 'accessibility.customer' | t
  assign fb_published = 'accessibility.published' | t
  assign fb_photo = 'accessibility.customer_photo' | t
-%}
{%- comment -%}
  Materia Themes. Testimonials Showcase.

  Heading, eyebrow and subheading blocks above a row of review cards (photo
  or video, stars, name, date, review). One card shows on a phone (or the
  Cards on mobile setting), two on a tablet, three on a desktop. Colours
  follow the colour scheme and fonts follow Theme settings > Typography until
  custom styling or custom fonts are switched on. The row, its arrows and
  dots, and the videos are run by assets/live-testimonials.js, which also
  applies the builder's live edits.
{%- endcomment -%}
{%- if scroll_anim != blank and scroll_anim != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'live-testimonials-style', sid: sid %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { position: static; }
  #shopify-section-{{ sid }} .tsh { background: var(--tsh-bg); color: var(--tsh-text); padding-top: var(--tsh-pt); padding-bottom: var(--tsh-pb); font-family: var(--tsh-bf); overflow: hidden; }
  #shopify-section-{{ sid }} .tsh *, #shopify-section-{{ sid }} .tsh *::before, #shopify-section-{{ sid }} .tsh *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .tsh__wrap { max-width: var(--tsh-max); margin: 0 auto; padding-inline: clamp(16px, 4vw, 32px); }
  #shopify-section-{{ sid }} .tsh__head { text-align: var(--tsh-align); max-width: 720px; margin: 0 auto 36px; }
  #shopify-section-{{ sid }} .tsh__head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .tsh__eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 10px; color: var(--b-c); font-family: var(--tsh-bf); font-weight: var(--b-w, var(--body-weight, 400)); }
  #shopify-section-{{ sid }} .tsh__heading { margin: 0 0 10px; color: var(--b-c); font-family: var(--tsh-hf); font-weight: var(--b-w, var(--heading-weight, 700)); line-height: 1.1; font-size: var(--b-fs-m); }
  #shopify-section-{{ sid }} .tsh__sub { margin: 0; color: var(--b-c); font-family: var(--tsh-bf); font-weight: var(--b-w, var(--body-weight, 400)); line-height: 1.55; font-size: var(--b-fs-m); }
  #shopify-section-{{ sid }} .tsh__sub p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .tsh__sub p + p { margin-top: .6em; }
  #shopify-section-{{ sid }} .tsh__track { display: flex; gap: var(--tsh-gap); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; touch-action: pan-x pan-y; cursor: grab; }
  #shopify-section-{{ sid }} .tsh__track.is-dragging { cursor: grabbing; }
  #shopify-section-{{ sid }} .tsh__card { flex: 0 0 calc((100% - var(--tsh-gap) * (var(--tsh-mpv) - 1)) / var(--tsh-mpv)); min-width: 0; scroll-snap-align: start; display: flex; flex-direction: column; overflow: hidden; background: var(--tsh-card-bg); border-radius: var(--tsh-radius); box-shadow: 0 1px 3px rgba(0, 0, 0, .04); }
  #shopify-section-{{ sid }} .tsh__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); }
  #shopify-section-{{ sid }} .tsh__media.is-video { background: #000; }
  #shopify-section-{{ sid }} .tsh__media img, #shopify-section-{{ sid }} .tsh__media video { display: block; width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; pointer-events: none; }
  #shopify-section-{{ sid }} .tsh__ph { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; color: color-mix(in srgb, var(--color-text) 35%, transparent); }
  #shopify-section-{{ sid }} .tsh__ph svg { width: 48px; height: 48px; }
  #shopify-section-{{ sid }} .lt-vbtn { position: absolute; bottom: 8px; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: rgba(0, 0, 0, .55); color: #fff; cursor: pointer; pointer-events: auto; }
  #shopify-section-{{ sid }} .lt-vbtn:hover { background: rgba(0, 0, 0, .75); }
  #shopify-section-{{ sid }} .lt-vbtn svg { width: 16px; height: 16px; display: block; }
  #shopify-section-{{ sid }} .lt-vbtn[data-lt-play] { left: 8px; }
  #shopify-section-{{ sid }} .lt-vbtn[data-lt-mute] { right: 8px; }
  #shopify-section-{{ sid }} .lt-vbtn .lt-i-pause, #shopify-section-{{ sid }} .lt-vbtn .lt-i-off { display: none; }
  #shopify-section-{{ sid }} .lt-vbtn[data-state="playing"] .lt-i-play, #shopify-section-{{ sid }} .lt-vbtn[data-state="muted"] .lt-i-on { display: none; }
  #shopify-section-{{ sid }} .lt-vbtn[data-state="playing"] .lt-i-pause, #shopify-section-{{ sid }} .lt-vbtn[data-state="muted"] .lt-i-off { display: block; }
  #shopify-section-{{ sid }} .tsh__body { display: flex; flex: 1; flex-direction: column; gap: 10px; padding: 20px; }
  #shopify-section-{{ sid }} .tsh__name { margin: 4px 0 0; color: var(--tsh-name-c); font-family: var(--tsh-hf); font-weight: var(--heading-weight, 700); font-size: var(--tsh-name-size); line-height: 1.25; }
  #shopify-section-{{ sid }} .tsh__date { margin: 0; font-size: 13px; color: var(--tsh-muted-c); }
  #shopify-section-{{ sid }} .tsh__text { margin: 6px 0 0; font-size: var(--b-fs-m); line-height: 1.55; color: var(--tsh-body-c); white-space: pre-line; }
  #shopify-section-{{ sid }} .tsh__nav { margin-top: 28px; }
  #shopify-section-{{ sid }} .tsh[data-nav="false"] .tsh__nav, #shopify-section-{{ sid }} .tsh[data-count="1"] .tsh__nav { display: none; }
  #shopify-section-{{ sid }} .tsh[data-dots="false"] .lt-dots { display: none; }
  @media (min-width: 641px) {
    #shopify-section-{{ sid }} .tsh__card { flex-basis: calc((100% - var(--tsh-gap)) / 2); }
    #shopify-section-{{ sid }} .tsh__heading, #shopify-section-{{ sid }} .tsh__sub, #shopify-section-{{ sid }} .tsh__text { font-size: var(--b-fs-d); }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .tsh__card { flex-basis: calc((100% - var(--tsh-gap) * 2) / 3); }
  }
{% comment %}{% endcomment %}</style>
{%- assign cards = section.blocks | where: 'type', 'testimonial' -%}
<div class="lt-frame" data-width="{{ st.section_width | default: 'full_width' }}">
<div class="tsh color-{{ color_scheme }} gradient" data-lt-root="testimonials3" data-section-id="{{ sid }}" data-lt-settings="{{ st | json | escape }}" data-nav="{{ st.show_nav }}" data-dots="{{ st.show_dots }}" data-count="{{ cards.size }}"{% if fonts %} data-own-font{% endif %} style="--tsh-bg: {% render 'live-testimonials-color', on: custom, color: st.section_bg, fallback: 'var(--color-background)' %};--tsh-text: {% render 'live-testimonials-color', on: custom, color: st.text_color, fallback: 'var(--color-text)' %};--tsh-card-bg: {% render 'live-testimonials-color', on: custom, color: st.card_bg, fallback: 'color-mix(in srgb, var(--color-text) 4%, var(--color-background))' %};--tsh-name-c: {% render 'live-testimonials-color', on: custom, color: st.name_color, fallback: 'var(--color-heading)' %};--tsh-body-c: {% render 'live-testimonials-color', on: custom, color: st.body_color, fallback: 'var(--color-text)' %};--tsh-muted-c: {% render 'live-testimonials-color', on: custom, color: st.muted_color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %};--lt-star-on: {% render 'live-testimonials-color', on: custom, color: st.star_color, fallback: 'var(--color-primary)' %};--lt-star-off: {% render 'live-testimonials-color', on: custom, color: st.star_empty_color, fallback: 'color-mix(in srgb, var(--color-text) 20%, transparent)' %};--lt-arrow-bg: {% render 'live-testimonials-color', on: custom, color: st.arrow_bg, fallback: 'var(--color-background)' %};--lt-arrow-c: {% render 'live-testimonials-color', on: custom, color: st.arrow_color, fallback: 'var(--color-heading)' %};--lt-arrow-border: {% render 'live-testimonials-color', on: custom, color: st.arrow_border, fallback: 'var(--color-border)' %};--lt-arrow-bg-h: {% render 'live-testimonials-color', on: custom, color: st.arrow_bg_hover, fallback: 'var(--color-heading)' %};--lt-arrow-c-h: {% render 'live-testimonials-color', on: custom, color: st.arrow_color_hover, fallback: 'var(--color-background)' %};--lt-dot: {% render 'live-testimonials-color', on: custom, color: st.dot_color, fallback: 'color-mix(in srgb, var(--color-text) 30%, transparent)' %};--lt-dot-active: {% render 'live-testimonials-color', on: custom, color: st.dot_active_color, fallback: 'var(--color-heading)' %};--tsh-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--tsh-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--tsh-pt: {{ st.padding_top | default: 0 }}px;--tsh-pb: {{ st.padding_bottom | default: 0 }}px;--tsh-max: {{ st.max_width | default: 1280 }}px;--tsh-gap: {{ st.card_gap | default: 20 }}px;--tsh-align: {{ st.text_align | default: 'center' }};--tsh-mpv: {{ mpv }};--tsh-radius: {{ st.card_radius | default: 0 }}px;--tsh-name-size: {{ st.name_size | default: 17 }}px;--lt-star-size: {{ st.star_size | default: 18 }}px;">
  <div class="tsh__wrap">
    <div class="tsh__head">
      {%- for b in section.blocks -%}
        {%- assign bs = b.settings -%}
        {%- capture b_attrs -%}data-lt-block="{{ b.id }}" data-lt-type="{{ b.type }}" data-lt-settings="{{ bs | json | escape }}"{% if bs.weight_enable %} data-own-weight{% endif %} {{ b.shopify_attributes }}{%- endcapture -%}
        {%- capture b_style -%}--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-text)' %};{% if bs.weight_enable %}--b-w: {{ bs.weight }};{% endif %}{%- endcapture -%}
        {%- case b.type -%}
          {%- when 'eyebrow' -%}
            <p class="tsh__eyebrow" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="{{ b_style }}">{{ bs.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="tsh__heading" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-heading)' %};{% if bs.weight_enable %}--b-w: {{ bs.weight }};{% endif %}--b-fs-m: {{ bs.size_mobile | default: 28 }}px;--b-fs-d: {{ bs.size | default: 44 }}px;">{{ bs.text }}</h2>
          {%- when 'subheading' -%}
            <div class="tsh__sub" {{ b_attrs }}{% if bs.text == blank %} hidden{% endif %} style="{{ b_style }}--b-fs-m: {{ bs.size_mobile | default: 15 }}px;--b-fs-d: {{ bs.size | default: 16 }}px;">{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if cards.size > 0 -%}
      <div class="tsh__track" data-lt-track data-testimonial-row tabindex="0" role="region" aria-roledescription="carousel" aria-label="Reviews">
        {%- for b in cards -%}
          {%- assign bs = b.settings -%}
          {%- assign has_video = false -%}
          {%- if bs.shopify_video != blank or bs.video_url != blank -%}{%- assign has_video = true -%}{%- endif -%}
          <article class="tsh__card" data-lt-block="{{ b.id }}" data-lt-type="testimonial" data-lt-settings="{{ bs | json | escape }}" {{ b.shopify_attributes }}>
            <div class="tsh__media{% if has_video %} is-video{% endif %}" data-lt-media>
              {%- if has_video -%}
                {%- assign v_muted = true -%}
                {%- if bs.video_sound_on and bs.video_autoplay == false -%}{%- assign v_muted = false -%}{%- endif -%}
                <video data-lt-video preload="metadata" playsinline{% if bs.image != blank %} poster="{{ bs.image | image_url: width: 800 }}"{% endif %}{% if bs.video_autoplay %} autoplay data-lt-autoplay{% endif %}{% if bs.video_loop %} loop{% endif %}{% if v_muted %} muted{% endif %}{% if bs.video_controls %} controls controlslist="nodownload"{% endif %}>
                  {%- if bs.shopify_video != blank -%}
                    {%- for src in bs.shopify_video.sources -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endfor -%}
                  {%- else -%}
                    <source src="{{ bs.video_url }}" type="video/mp4">
                  {%- endif -%}
                </video>
                <button type="button" class="lt-vbtn" data-lt-play data-state="paused" aria-label="{{ 'accessibility.play_pause' | t | default: 'Play or pause' }}"{% if bs.video_controls %} hidden{% endif %}>
                  <svg class="lt-i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="lt-i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
                </button>
                <button type="button" class="lt-vbtn" data-lt-mute data-state="{% if v_muted %}muted{% else %}unmuted{% endif %}" aria-label="{{ 'accessibility.mute_unmute' | t | default: 'Mute or unmute' }}"{% if bs.video_controls %} hidden{% endif %}>
                  <svg class="lt-i-on" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4z"/></svg>
                  <svg class="lt-i-off" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.6 3l2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z"/></svg>
                </button>
              {%- elsif bs.image != blank -%}
                {{ bs.image | image_url: width: 800 | image_tag: loading: 'lazy', decoding: 'async', widths: '300,450,600,800', sizes: '(min-width: 1024px) 33vw, (min-width: 641px) 50vw, 100vw', alt: bs.name | default: fb_photo }}
              {%- else -%}
                <div class="tsh__ph" data-lt-ph><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
              {%- endif -%}
            </div>
            <div class="tsh__body">
              {% render 'live-testimonials-stars', rating: bs.rating %}
              <h3 class="tsh__name" data-lt-name>{{ bs.name | default: fb_customer | escape }}</h3>
              <p class="tsh__date" data-lt-date{% if bs.date == blank %} hidden{% endif %}>{{ bs.date_prefix | default: fb_published | escape }} {{ bs.date | escape }}</p>
              <p class="tsh__text" data-lt-text{% if bs.body == blank %} hidden{% endif %} style="--b-fs-m: {{ bs.body_size_mobile | default: 14 }}px;--b-fs-d: {{ bs.body_size_desktop | default: 14 }}px;">{{ bs.body | escape }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="tsh__nav lt-nav">
        <button type="button" class="lt-arrow" data-lt-prev data-tsh-prev aria-label="{{ 'accessibility.previous' | t | default: 'Previous' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg></button>
        <div class="lt-dots" data-lt-dots data-label="{{ 'accessibility.go_to_slide' | t | default: 'Go to slide' }}"></div>
        <button type="button" class="lt-arrow" data-lt-next data-tsh-next aria-label="{{ 'accessibility.next' | t | default: 'Next' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>
    {%- endif -%}
  </div>
</div>
</div>
</template>

<schema>
{
  "type": "testimonials3",
  "name": "Testimonials Showcase",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Content width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Name size",
      "default": 17
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false,
      "visible_if": "{{ section.settings.show_nav }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Appearance"
    },
    {
      "id": "enable_custom_style",
      "type": "checkbox",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Review text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Date",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Filled star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_border",
      "label": "Arrow border",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_bg_hover",
      "label": "Arrow background (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "arrow_color_hover",
      "label": "Arrow icon (hover)",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot",
