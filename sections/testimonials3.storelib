            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          }
        ]
      },
      {
        "type": "testimonial",
        "name": "Testimonial card",
        "settings": [
          {
            "type": "header",
            "content": "Review"
          },
          {
            "type": "range",
            "id": "rating",
            "min": 0.5,
            "max": 5,
            "step": 0.5,
            "label": "Star rating",
            "info": "Any value from 0.5 to 5; stars fill to the exact rating.",
            "default": 5
          },
          {
            "type": "textarea",
            "id": "body",
            "label": "Review body",
            "default": "Write what this customer said about your product."
          },
          {
            "type": "header",
            "content": "Customer"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Customer name"
          },
          {
            "type": "text",
            "id": "date_prefix",
            "label": "Date prefix",
            "default": "Published"
          },
          {
            "type": "text",
            "id": "date",
            "label": "Date"
          },
          {
            "type": "header",
            "content": "Image"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Photo"
          },
          {
            "type": "header",
            "content": "Video"
          },
          {
            "type": "video",
            "id": "shopify_video",
            "label": "Video"
          },
          {
            "type": "url",
            "id": "video_url",
            "label": "Video URL (.mp4)"
          },
          {
            "type": "checkbox",
            "id": "video_autoplay",
            "label": "Autoplay",
            "default": true,
            "info": "Autoplay starts muted and pauses off screen."
          },
          {
            "type": "checkbox",
            "id": "video_loop",
            "label": "Loop",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "video_sound_on",
            "label": "Start with sound",
            "default": false,
            "visible_if": "{{ block.settings.video_autoplay == false }}"
          },
          {
            "type": "checkbox",
            "id": "video_controls",
            "label": "Player controls",
            "default": false
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "body_size_desktop",
            "min": 11,
            "max": 28,
            "step": 1,
            "unit": "px",
            "label": "Review font size (desktop)",
            "default": 14
          },
          {
            "type": "range",
            "id": "body_size_mobile",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Review font size (mobile)",
            "default": 14
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonials Showcase",
        "category": "Testimonials",
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "What customers say"
            }
          },
          {
            "type": "subheading"
          },
          {
            "type": "testimonial",
            "settings": {
              "rating": 5
            }
          },
          {
            "type": "testimonial",
            "settings": {
              "rating": 4.5
            }
          },
          {
            "type": "testimonial",
            "settings": {
              "rating": 5
            }
          },
          {
            "type": "testimonial",
            "settings": {
              "rating": 4
            }
          }
        ]
      }
    ]
  }
}
</schema>
