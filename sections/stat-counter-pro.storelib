            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Add a short line about what these numbers count.</p>"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 280,
            "max": 1000,
            "step": 20,
            "unit": "px",
            "default": 640
          }
        ]
      },
      {
        "type": "stat",
        "name": "Stat",
        "settings": [
          {
            "type": "text",
            "id": "value",
            "label": "Number",
            "default": ""
          },
          {
            "type": "text",
            "id": "ring_max",
            "label": "Ring full at",
            "default": "100",
            "info": "The ring fills to number / this value."
          },
          {
            "type": "text",
            "id": "prefix",
            "label": "Prefix",
            "info": "e.g. $ or +"
          },
          {
            "type": "text",
            "id": "suffix",
            "label": "Suffix",
            "info": "e.g. %, K, M, +"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Stat label"
          },
          {
            "type": "text",
            "id": "trend_value",
            "label": "Trend text"
          },
          {
            "type": "select",
            "id": "trend_direction",
            "label": "Trend",
            "default": "flat",
            "options": [
              {
                "value": "up",
                "label": "Up"
              },
              {
                "value": "down",
                "label": "Down"
              },
              {
                "value": "flat",
                "label": "Flat"
              }
            ]
          },
          {
            "type": "range",
            "id": "decimals",
            "label": "Decimal places while counting",
            "min": 0,
            "max": 2,
            "step": 1,
            "default": 0
          },
          {
            "type": "html",
            "id": "icon",
            "label": "Icon (inline SVG)"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Stat Counter Pro",
        "category": "Features",
        "blocks": [
          {
            "type": "eyebrow",
            "settings": {
              "text": "Why shop with us"
            }
          },
          {
            "type": "heading",
            "settings": {
              "text": "What our numbers say"
            }
          },
          {
            "type": "subheading",
            "settings": {
              "text": "<p>Replace these with your own numbers.</p>"
            }
          },
          {
            "type": "stat",
            "settings": {}
          },
          {
            "type": "stat",
            "settings": {}
          },
          {
            "type": "stat",
            "settings": {}
          },
          {
            "type": "stat",
            "settings": {}
          }
        ]
      }
    ]
  }
}
</schema>
