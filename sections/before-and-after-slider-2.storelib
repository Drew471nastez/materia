<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_after = 'accessibility.after' | t -%}
{%- assign fb_accessibility_before = 'accessibility.before' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Before And After Image Slider 2
  Two-column hero: a draggable before/after image comparison slider on one
  side and a content column (heading, subheading, button) on the other.
  The handle drags via mouse, touch, keyboard arrows, or by clicking
  anywhere along the image. All content lives in blocks.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'

  assign slider_block = nil
  for b in section.blocks
    if b.type == 'slider' and slider_block == nil
      assign slider_block = b
    endif
  endfor
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .ba2 {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 48 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ba2 {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  #shopify-section-{{ sid }} .ba2__inner {
    max-width: {{ st.section_max_width_desktop | default: 1200 }}px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* 2-column layout */
  #shopify-section-{{ sid }} .ba2__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.layout_gap_mobile | default: 32 }}px;
    align-items: center;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .ba2__layout {
      {%- if st.image_position == 'right' -%}
        grid-template-columns: {{ st.content_col_fr | default: 1 }}fr {{ st.image_col_fr | default: 1 }}fr;
      {%- else -%}
        grid-template-columns: {{ st.image_col_fr | default: 1 }}fr {{ st.content_col_fr | default: 1 }}fr;
      {%- endif -%}
      gap: {{ st.layout_gap_desktop | default: 64 }}px;
    }
  }
  {%- if st.image_position == 'right' -%}
    @media (min-width: 992px) {
      #shopify-section-{{ sid }} .ba2__media { order: 2; }
      #shopify-section-{{ sid }} .ba2__content { order: 1; }
    }
  {%- endif -%}

  /* Content column */
  #shopify-section-{{ sid }} .ba2__content {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 18 }}px;
    text-align: {{ st.content_align | default: 'left' }};
    align-items: {%- case st.content_align -%}
      {%- when 'center' -%}center
      {%- when 'right'  -%}flex-end
      {%- else -%}flex-start
    {%- endcase -%};
  }
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .ba2__content { align-items: center; text-align: center; }
  }
  #shopify-section-{{ sid }} .ba2__content > * { margin: 0; }

  /* Slider */
  #shopify-section-{{ sid }} .ba2__slider {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.image_aspect | default: '1 / 1' }};
    border-radius: {{ st.image_radius | default: 8 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: st.image_bg, fallback: 'var(--color-background)' %};
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  #shopify-section-{{ sid }} .ba2__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  /* The "after" image is clipped from the left edge to the handle */
  #shopify-section-{{ sid }} .ba2__after-wrap {
    position: absolute;
    inset: 0;
    width: var(--ba2-pos, 50%);
    overflow: hidden;
    will-change: width;
  }
  #shopify-section-{{ sid }} .ba2__after-wrap .ba2__img {
    width: var(--ba2-img-w, 100vw);
    max-width: none;
  }
  /* Handle */
  #shopify-section-{{ sid }} .ba2__handle {
    position: absolute;
    top: 0;
    left: var(--ba2-pos, 50%);
    transform: translateX(-50%);
    height: 100%;
    width: {{ st.handle_line_width | default: 3 }}px;
    background: {% render 'scheme-color', color: st.handle_line_color, fallback: 'var(--color-border)' %};
    pointer-events: none;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .ba2__knob {
    position: absolute;
    top: 50%;
    left: var(--ba2-pos, 50%);
    transform: translate(-50%, -50%);
    width: {{ st.handle_size | default: 44 }}px;
    height: {{ st.handle_size | default: 44 }}px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: st.handle_bg, fallback: 'var(--color-background)' %};
    border: {{ st.handle_border_width | default: 2 }}px solid {% render 'scheme-color', color: st.handle_border_color, fallback: 'var(--color-border)' %};
    color: {% render 'scheme-color', color: st.handle_icon_color, fallback: 'var(--color-heading)' %};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    z-index: 3;
    box-shadow: 0 6px 18px -8px rgba(0,0,0,.35);
    transition: transform .25s ease;
  }
  #shopify-section-{{ sid }} .ba2__knob:active { transform: translate(-50%, -50%) scale(.96); }
  #shopify-section-{{ sid }} .ba2__knob svg { width: 55%; height: 55%; }

  /* Optional labels */
  #shopify-section-{{ sid }} .ba2__label {
    position: absolute;
    top: {{ st.label_offset | default: 16 }}px;
    padding: {{ st.label_pad_y | default: 6 }}px {{ st.label_pad_x | default: 12 }}px;
    border-radius: {{ st.label_radius | default: 999 }}px;
    background: {% render 'scheme-color', color: st.label_bg, fallback: 'color-mix(in srgb, var(--color-heading) 55%, transparent)' %};
    color: {% render 'scheme-color', color: st.label_color, fallback: 'var(--color-heading)' %};
    font-size: {{ st.label_size | default: 12 }}px;
    font-weight: {{ st.label_weight | default: 700 }};
    letter-spacing: {{ st.label_tracking | default: 0.5 }}px;
    text-transform: {{ st.label_transform | default: 'uppercase' }};
    z-index: 2;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .ba2__label--before { left: {{ st.label_offset | default: 16 }}px; }
  #shopify-section-{{ sid }} .ba2__label--after  { right: {{ st.label_offset | default: 16 }}px; }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .ba2 { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .ba2 { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .ba2 { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .ba2 { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="ba2 color-{{ color_scheme }} gradient {{ section.settings.section_width }}" id="ba2-{{ sid }}">
  <div class="ba2__inner">
    <div class="ba2__layout">

      {%- comment -%}========== MEDIA / SLIDER ==========={%- endcomment -%}
      <div class="ba2__media">
        {%- assign before_img = nil -%}
        {%- assign after_img  = nil -%}
        {%- assign before_label = 'Before' -%}
        {%- assign after_label  = 'After'  -%}
        {%- if slider_block -%}
          {%- assign before_img   = slider_block.settings.before_image -%}
          {%- assign after_img    = slider_block.settings.after_image  -%}
          {%- assign before_label = slider_block.settings.before_label | default: fb_accessibility_before -%}
          {%- assign after_label  = slider_block.settings.after_label  | default: fb_accessibility_after  -%}
        {%- endif -%}

        <div class="ba2__slider"
             data-ba2-slider
             role="slider"
             aria-label="{{ 'accessibility.drag_to_reveal' | t }}"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"
             tabindex="0"
             style="--ba2-pos: 50%;"
             {% if slider_block %}{{ slider_block.shopify_attributes }}{% endif %}>

          {%- comment -%}
            AFTER image is the FULL base layer (visible on the right of the
            handle). BEFORE image lives inside the .ba2__after-wrap (which
            is clipped from the left edge to the handle), so the LEFT side
            of the slider shows BEFORE and the RIGHT side shows AFTER —
            exactly what the merchant uploads for each slot.
          {%- endcomment -%}
          {%- if after_img -%}
            <img class="ba2__img ba2__img--after"
                 src="{{ after_img | image_url: width: 1600 }}"
                 alt="{{ after_label | escape }}"
                 loading="lazy"
                 width="{{ after_img.width }}" height="{{ after_img.height }}">
          {%- else -%}
            <img class="ba2__img ba2__img--after" src="{{ placeholder }}" alt="{{ after_label }}" loading="lazy">
          {%- endif -%}

          <div class="ba2__after-wrap">
            {%- if before_img -%}
              <img class="ba2__img ba2__img--before"
                   src="{{ before_img | image_url: width: 1600 }}"
                   alt="{{ before_label | escape }}"
                   loading="lazy"
                   width="{{ before_img.width }}" height="{{ before_img.height }}">
            {%- else -%}
              <img class="ba2__img ba2__img--before" src="{{ placeholder }}" alt="{{ before_label }}" loading="lazy">
            {%- endif -%}
          </div>

          {%- if st.show_labels -%}
            <span class="ba2__label ba2__label--before">{{ before_label | escape }}</span>
            <span class="ba2__label ba2__label--after">{{ after_label  | escape }}</span>
          {%- endif -%}

          <span class="ba2__handle" aria-hidden="true"></span>
          <span class="ba2__knob" aria-hidden="true">
            {%- case st.handle_icon -%}
              {%- when 'arrows' -%}
                {%- comment -%} Two outward-pointing chevrons: ‹ ›  {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="10 7 5 12 10 17"/>
                  <polyline points="14 7 19 12 14 17"/>
                </svg>
              {%- when 'chevrons' -%}
                {%- comment -%} Two pairs of chevrons (double) {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 7 4 12 9 17"/>
                  <polyline points="13 7 8 12 13 17"/>
                  <polyline points="11 7 16 12 11 17"/>
                  <polyline points="15 7 20 12 15 17"/>
                </svg>
              {%- when 'lines' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="9"  y1="6" x2="9"  y2="18"/>
                  <line x1="15" y1="6" x2="15" y2="18"/>
                </svg>
              {%- when 'dots' -%}
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <circle cx="9"  cy="12" r="1.6"/>
                  <circle cx="15" cy="12" r="1.6"/>
                </svg>
              {%- when 'plus' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="6" y1="12" x2="18" y2="12"/>
                  <polyline points="10 8 6 12 10 16"/>
                  <polyline points="14 8 18 12 14 16"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="10 7 5 12 10 17"/>
                  <polyline points="14 7 19 12 14 17"/>
                </svg>
            {%- endcase -%}
          </span>
        </div>
      </div>

      {%- comment -%}========== CONTENT ==========={%- endcomment -%}
      <div class="ba2__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="ba2__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {{ bs.color | default: '#0F172A' }} !important;
                    font-weight: {{ bs.weight | default: 700 }};
                    line-height: {{ bs.line_height | default: 1.1 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    font-size: {{ bs.size_mobile | default: 32 }}px;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 48 }}px; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="ba2__sub" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    color: {{ bs.color | default: '#475569' }} !important;
                    font-size: {{ bs.size | default: 16 }}px;
                    line-height: {{ bs.line_height | default: 1.55 }};
                    max-width: {{ bs.max_width | default: 460 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if bs.text != blank -%}
                <a id="block-{{ block.id }}" class="ba2__btn" href="{{ bs.link | default: '/' }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</a>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    text-decoration: none;
                    background: {{ bs.bg | default: '#0F172A' }} !important;
                    color: {{ bs.color | default: '#FFFFFF' }} !important;
                    border: {{ bs.border_width | default: 0 }}px solid {{ bs.border_color | default: '#0F172A' }};
                    border-radius: {{ bs.radius | default: 100 }}px;
                    font-size: {{ bs.size | default: 15 }}px;
                    font-weight: {{ bs.weight | default: 600 }};
                    padding: {{ bs.pad_y | default: 14 }}px {{ bs.pad_x | default: 28 }}px;
                    margin-top: {{ bs.gap_top | default: 6 }}px;
                    transition: background-color .25s ease, color .25s ease, transform .2s ease;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }}:hover {
                    background: {{ bs.bg_hover | default: '#1F2937' }} !important;
                    color: {{ bs.color_hover | default: '#FFFFFF' }} !important;
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('#shopify-section-{{ sid }}');
  if (!section) return;
  var slider = section.querySelector('[data-ba2-slider]');
  if (!slider) return;
  if (slider.dataset.ba2Init === '1') return;
  slider.dataset.ba2Init = '1';

  var afterWrap = slider.querySelector('.ba2__after-wrap');
  var pointerActive = false;
  var pointerId = null;

  function setPos(pct) {
    pct = Math.max(0, Math.min(100, pct));
    slider.style.setProperty('--ba2-pos', pct + '%');
    slider.setAttribute('aria-valuenow', Math.round(pct));
  }

  function setImgWidth() {
    // Force the inner "after" image to span the FULL slider width by writing
    // the slider's pixel width into a custom property — this way the .after
    // wrapper's clipped width never compresses the underlying image.
    var w = slider.getBoundingClientRect().width;
    slider.style.setProperty('--ba2-img-w', w + 'px');
  }
  setImgWidth();
  window.addEventListener('load', setImgWidth);
  window.addEventListener('resize', setImgWidth);
  if (window.ResizeObserver) {
    new ResizeObserver(setImgWidth).observe(slider);
  }

  function pctFromEvent(e) {
    var rect = slider.getBoundingClientRect();
    var x = (e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0));
    return ((x - rect.left) / rect.width) * 100;
  }

  function onDown(e) {
    pointerActive = true;
    pointerId = e.pointerId;
    setPos(pctFromEvent(e));
    if (slider.setPointerCapture && e.pointerId != null) {
      try { slider.setPointerCapture(e.pointerId); } catch (err) {}
    }
  }
  function onMove(e) {
    if (!pointerActive) return;
    if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;
    if (e.cancelable) e.preventDefault();
    setPos(pctFromEvent(e));
  }
  function onUp(e) {
    if (!pointerActive) return;
    pointerActive = false;
    pointerId = null;
    if (slider.releasePointerCapture && e.pointerId != null) {
      try { slider.releasePointerCapture(e.pointerId); } catch (err) {}
    }
  }

  if (window.PointerEvent) {
    slider.addEventListener('pointerdown',   onDown);
    slider.addEventListener('pointermove',   onMove);
    slider.addEventListener('pointerup',     onUp);
    slider.addEventListener('pointercancel', onUp);
  } else {
    slider.addEventListener('mousedown',  onDown);
    window.addEventListener('mousemove',  onMove);
    window.addEventListener('mouseup',    onUp);
    slider.addEventListener('touchstart', function(e) {
      pointerActive = true;
      setPos(pctFromEvent(e));
    }, { passive: true });
    slider.addEventListener('touchmove', function(e) {
      if (!pointerActive) return;
      e.preventDefault();
      setPos(pctFromEvent(e));
    }, { passive: false });
    slider.addEventListener('touchend', function() { pointerActive = false; });
  }

  // Block native image drag
  slider.addEventListener('dragstart', function(e) { e.preventDefault(); });

  // Keyboard
  slider.addEventListener('keydown', function(e) {
    var current = parseFloat((slider.style.getPropertyValue('--ba2-pos') || '50').replace('%','')) || 50;
    var step = e.shiftKey ? 10 : 2;
    if (e.key === 'ArrowLeft')  { setPos(current - step); e.preventDefault(); }
    if (e.key === 'ArrowRight') { setPos(current + step); e.preventDefault(); }
    if (e.key === 'Home')       { setPos(0);   e.preventDefault(); }
    if (e.key === 'End')        { setPos(100); e.preventDefault(); }
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "before-and-after-slider-2",
  "name": "Before/After Slider 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Section content width (desktop)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
