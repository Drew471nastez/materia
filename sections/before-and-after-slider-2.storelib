  "shopify": {
    "name": "Before/After Slider 2",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "show_section_on",
        "label": "Show section on",
        "default": "all",
        "options": [
          {
            "value": "all",
            "label": "All"
          },
          {
            "value": "mobile",
            "label": "Mobile"
          },
          {
            "value": "desktop",
            "label": "Desktop"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove the theme's space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "section_max_width_desktop",
        "label": "Content max width (desktop)",
        "min": 600,
        "max": 1500,
        "step": 10,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image position (desktop)",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_col_fr",
        "label": "Image column share (desktop)",
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "default": 1
      },
      {
        "type": "range",
        "id": "content_col_fr",
        "label": "Content column share (desktop)",
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "default": 1
      },
      {
        "type": "range",
        "id": "layout_gap_desktop",
        "label": "Gap between image and content (desktop)",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "content_gap",
        "label": "Gap between content blocks",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "type": "select",
        "id": "content_align",
        "label": "Content alignment (desktop)",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "info": "Content is centred on mobile."
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "text",
        "id": "image_aspect",
        "label": "Image shape",
        "default": "1 / 1",
        "info": "Width / height, for example 1 / 1, 4 / 5 or 16 / 9."
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "header",
        "content": "Slider"
      },
      {
        "type": "range",
        "id": "start_position",
        "label": "Start position",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 50,
        "info": "Where the divider sits before anyone drags it, from the left edge."
      },
      {
        "type": "select",
        "id": "handle_icon",
        "label": "Handle icon",
        "default": "arrows",
        "options": [
          {
            "value": "arrows",
            "label": "Arrows ‹ ›"
          },
          {
            "value": "chevrons",
            "label": "Double chevrons"
          },
          {
            "value": "lines",
            "label": "Two lines | |"
          },
          {
            "value": "dots",
            "label": "Two dots · ·"
          },
          {
            "value": "plus",
            "label": "Plus + arrows"
          }
        ]
      },
      {
        "type": "range",
        "id": "handle_size",
        "label": "Handle size",
        "min": 24,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 44
      },
      {
        "type": "range",
        "id": "handle_border_width",
        "label": "Handle border width",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "handle_line_width",
        "label": "Divider width",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 3
      },
      {
        "type": "header",
        "content": "Labels"
      },
      {
        "type": "checkbox",
        "id": "show_labels",
        "label": "Show Before / After labels",
        "default": false
      },
      {
        "type": "range",
        "id": "label_size",
        "label": "Label text size",
        "min": 9,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "select",
        "id": "label_weight",
        "label": "Label weight",
        "default": "700",
        "options": [
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semi-bold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ],
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "range",
        "id": "label_tracking",
        "label": "Label letter spacing",
        "min": 0,
        "max": 4,
        "step": 0.1,
        "unit": "px",
        "default": 0.5,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "select",
        "id": "label_transform",
        "label": "Label capitalisation",
        "default": "uppercase",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "lowercase",
            "label": "Lowercase"
          },
          {
            "value": "capitalize",
            "label": "Capitalize"
          }
        ],
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "range",
        "id": "label_pad_x",
        "label": "Label side padding",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 12,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "range",
        "id": "label_pad_y",
        "label": "Label top and bottom padding",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 6,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "range",
        "id": "label_radius",
        "label": "Label corner radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 100,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "range",
        "id": "label_offset",
        "label": "Label distance from edge",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.show_labels }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "image_bg",
        "label": "Empty image background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "handle_bg",
        "label": "Handle background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "handle_border_color",
        "label": "Handle border color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "handle_icon_color",
        "label": "Handle icon color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "handle_line_color",
        "label": "Divider color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "label_bg",
        "label": "Label background",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_labels }}"
      },
      {
        "type": "color",
        "id": "label_color",
        "label": "Label text",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_labels }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "layout_gap_mobile",
        "label": "Gap between image and content (mobile)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile)",
        "min": -200,
        "max": 300,
        "step": 5,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "slider",
        "name": "Before / After images",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "before_image",
            "label": "Before image"
          },
          {
            "type": "text",
            "id": "before_label",
            "label": "Before label",
            "default": "Before"
          },
          {
            "type": "text",
            "id": "before_alt",
            "label": "Before image alt text",
            "info": "Describes the picture for screen readers. Empty uses the label."
          },
          {
            "type": "image_picker",
            "id": "after_image",
            "label": "After image"
          },
          {
            "type": "text",
            "id": "after_label",
            "label": "After label",
            "default": "After"
          },
          {
            "type": "text",
            "id": "after_alt",
            "label": "After image alt text"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "See the difference, side by side"
          },
          {
            "type": "select",
            "id": "tag",
            "label": "HTML tag",
            "default": "h2",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              },
              {
                "value": "h2",
                "label": "H2"
              },
              {
                "value": "h3",
                "label": "H3"
              },
              {
                "value": "h4",
                "label": "H4"
              }
            ],
            "hidden": true,
            "visible_if": "{{ false }}",
            "info": "The section heading is always an h2, under the page h1."
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ],
            "visible_if": "{{ block.settings.weight_enable }}"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 48,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 32,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.1,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "tracking",
            "label": "Letter spacing",
            "min": -3,
            "max": 7,
            "step": 0.1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom fonts",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Drag the handle to compare and see what our product can do.</p>"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom fonts",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "range",
            "id": "max_width",
            "label": "Max width",
            "min": 200,
            "max": 700,
            "step": 10,
            "unit": "px",
            "default": 460
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "default": "/"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text color (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 15,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "600",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.weight_enable }}"
          },
          {
            "type": "range",
            "id": "pad_x",
            "label": "Padding x",
            "min": 6,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 28,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_y",
            "label": "Padding y",
            "min": 4,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "gap_top",
            "label": "Space above button",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 6
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Before/After Slider 2",
        "category": "Features",
        "blocks": [
          {
            "type": "slider"
          },
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "button"
          }
        ]
      }
    ]
  }
}
