<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_after = 'accessibility.after' | t -%}
{%- assign fb_accessibility_before = 'accessibility.before' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Before/After Slider 2: a comparison slider beside a
  content column (heading, subheading, button blocks). Drag the handle
  (mouse or touch), click the image, or focus the handle and use the arrow
  keys. Every value is a CSS variable on the section root or on its block,
  so media-live-before-after.js changes it in place without moving the
  handle or reloading an image.
{%- endcomment -%}
<style data-rs-bulletproof data-bam-reset-style{% unless section.settings.reset_spacing %} media="not all"{% endunless %}>
  #shopify-section-{{ section.id }} > .section,
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div,
  #shopify-section-{{ section.id }} > div > .section { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section,
  #shopify-section-{{ section.id }} + section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign custom = st.enable_custom_style
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.5%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign slider_block = section.blocks | where: 'type', 'slider' | first
  assign image_fr = st.image_col_fr | default: 1
  assign content_fr = st.content_col_fr | default: 1
  if st.image_position == 'right'
    assign cols = 'minmax(0, ' | append: content_fr | append: 'fr) minmax(0, ' | append: image_fr | append: 'fr)'
  else
    assign cols = 'minmax(0, ' | append: image_fr | append: 'fr) minmax(0, ' | append: content_fr | append: 'fr)'
  endif
  assign start = st.start_position | default: 50
  assign icon = st.handle_icon | default: 'arrows'
  case st.content_align
    when 'center'
      assign items = 'center'
    when 'right'
      assign items = 'flex-end'
    else
      assign items = 'flex-start'
  endcase
-%}
<style>
  {%- if st.enable_custom_fonts %}{% if st.heading_font.family %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if st.body_font.family %}{{ st.body_font | font_face: font_display: 'swap' }}{% endif %}{% endif %}
  {%- for block in section.blocks %}{% if block.settings.enable_custom_fonts and block.settings.font.family %}{{ block.settings.font | font_face: font_display: 'swap' }}{% endif %}{% endfor %}
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
    --bam-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px;
    --bam-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
    --bam-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px;
    --bam-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px;
  }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--bam-mt-m) !important; margin-bottom: var(--bam-mb-m) !important; }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--bam-mt-d) !important; margin-bottom: var(--bam-mb-d) !important; }
  }
  #shopify-section-{{ sid }} .ba2 {
    --ba2-bg: {% if custom %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --ba2-label-bg: {% if custom %}{% render 'scheme-color', color: st.label_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --ba2-label-color: {% if custom %}{% render 'scheme-color', color: st.label_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bam-empty-after: {% if custom %}{% render 'scheme-color', color: st.image_bg, fallback: 'color-mix(in srgb, var(--color-heading) 12%, var(--color-background))' %}{% else %}color-mix(in srgb, var(--color-heading) 12%, var(--color-background)){% endif %};
    --bam-knob-bg: {% if custom %}{% render 'scheme-color', color: st.handle_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --bam-knob-border-color: {% if custom %}{% render 'scheme-color', color: st.handle_border_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
    --bam-icon-color: {% if custom %}{% render 'scheme-color', color: st.handle_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bam-line-color: {% if custom %}{% render 'scheme-color', color: st.handle_line_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
    --ba2-heading-font: {% if st.enable_custom_fonts and st.heading_font.family %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
    --ba2-body-font: {% if st.enable_custom_fonts and st.body_font.family %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
    --ba2-max: {{ st.section_max_width_desktop | default: 1200 }}px;
    --ba2-cols: {{ cols }};
    --ba2-gap-d: {{ st.layout_gap_desktop | default: 0 }}px;
    --ba2-gap-m: {{ st.layout_gap_mobile | default: 0 }}px;
    --ba2-content-gap: {{ st.content_gap | default: 0 }}px;
    --ba2-align: {{ st.content_align | default: 'left' }};
    --ba2-items: {{ items }};
    --ba2-pt-d: {{ st.padding_top_desktop | default: 0 }}px;
    --ba2-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px;
    --ba2-pt-m: {{ st.padding_top_mobile | default: 0 }}px;
    --ba2-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
    --ba2-label-size: {{ st.label_size | default: 12 }}px;
    --ba2-label-weight: {{ st.label_weight | default: 700 }};
    --ba2-label-track: {{ st.label_tracking | default: 0 }}px;
    --ba2-label-case: {{ st.label_transform | default: 'none' }};
    --ba2-label-px: {{ st.label_pad_x | default: 0 }}px;
    --ba2-label-py: {{ st.label_pad_y | default: 0 }}px;
    --ba2-label-radius: {{ st.label_radius | default: 0 }}px;
    --ba2-label-offset: {{ st.label_offset | default: 0 }}px;
    --bam-ratio: {{ st.image_aspect | default: '1 / 1' }};
    --bam-radius: {{ st.image_radius | default: 0 }}px;
    --bam-knob-size: {{ st.handle_size | default: 44 }}px;
    --bam-knob-border-w: {{ st.handle_border_width | default: 0 }}px;
    --bam-line-w: {{ st.handle_line_width | default: 0 }}px;
    --bam-empty-before: color-mix(in srgb, var(--bam-empty-after) 78%, var(--color-heading));
  }
  #shopify-section-{{ sid }} .ba2 {
    box-sizing: border-box;
    width: 100%;
    margin-inline: auto;
    background: var(--ba2-bg) !important;
    padding-top: var(--ba2-pt-m);
    padding-bottom: var(--ba2-pb-m);
  }
  #shopify-section-{{ sid }} .ba2 *, #shopify-section-{{ sid }} .ba2 *::before, #shopify-section-{{ sid }} .ba2 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .ba2 [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .ba2[data-width="container"] { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .ba2[data-width="fluid_container"] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .ba2__inner { max-width: var(--ba2-max); margin-inline: auto; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .ba2__layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ba2-gap-m); align-items: center; }
  #shopify-section-{{ sid }} .ba2__media, #shopify-section-{{ sid }} .ba2__content { min-width: 0; }
  #shopify-section-{{ sid }} .ba2__content { display: flex; flex-direction: column; gap: var(--ba2-content-gap); align-items: center; text-align: center; font-family: var(--ba2-body-font); }
  #shopify-section-{{ sid }} .ba2__content > * { margin: 0; }
  #shopify-section-{{ sid }} .ba2__heading { color: var(--ba2-c, var(--color-heading)) !important; font-family: var(--ba2-font, var(--ba2-heading-font)); }
  #shopify-section-{{ sid }} .ba2__sub { color: var(--ba2-c, var(--color-text)) !important; font-family: var(--ba2-font, var(--ba2-body-font)); max-width: var(--ba2-max-w, 460px); }
  #shopify-section-{{ sid }} .ba2__sub > * { margin: 0; }
  #shopify-section-{{ sid }} .ba2__sub > * + * { margin-top: .75em; }
  #shopify-section-{{ sid }} :is(.ba2__heading, .ba2__sub)[data-weight="true"] { font-weight: var(--ba2-w); }
  #shopify-section-{{ sid }} .ba2__heading[data-size="true"] { font-size: var(--ba2-size-m); line-height: var(--ba2-lh); letter-spacing: var(--ba2-track); }
  #shopify-section-{{ sid }} .ba2__sub[data-size="true"] { font-size: var(--ba2-size); line-height: var(--ba2-lh); }
  #shopify-section-{{ sid }} .ba2 .bam-compare__label {
    top: var(--ba2-label-offset);
    padding: var(--ba2-label-py) var(--ba2-label-px);
    border-radius: var(--ba2-label-radius);
    background: var(--ba2-label-bg);
    color: var(--ba2-label-color);
    font-family: var(--ba2-body-font);
    font-size: var(--ba2-label-size);
    font-weight: var(--ba2-label-weight);
    letter-spacing: var(--ba2-label-track);
    text-transform: var(--ba2-label-case);
    line-height: 1.3;
    white-space: nowrap;
    max-width: calc(50% - var(--ba2-label-offset) - 8px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #shopify-section-{{ sid }} .ba2 .bam-compare__label--before { left: var(--ba2-label-offset); }
  #shopify-section-{{ sid }} .ba2 .bam-compare__label--after { right: var(--ba2-label-offset); }
  #shopify-section-{{ sid }} .ba2[data-labels="false"] .bam-compare__label { display: none; }
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .ba2[data-show="desktop"] { display: none; }
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .ba2 { padding-top: var(--ba2-pt-d); padding-bottom: var(--ba2-pb-d); }
    #shopify-section-{{ sid }} .ba2[data-show="mobile"] { display: none; }
    #shopify-section-{{ sid }} .ba2__layout { grid-template-columns: var(--ba2-cols); gap: var(--ba2-gap-d); }
    #shopify-section-{{ sid }} .ba2[data-position="right"] .ba2__media { order: 2; }
    #shopify-section-{{ sid }} .ba2__content { align-items: var(--ba2-items); text-align: var(--ba2-align); }
    #shopify-section-{{ sid }} .ba2__heading[data-size="true"] { font-size: var(--ba2-size-d); }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .ba2[data-width="stretch_width"] { padding-inline: 3rem; }
  }
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- case block.type -%}
      {%- when 'heading' %}
  #shopify-section-{{ sid }} [data-bam-block="{{ block.id }}"] {
    --ba2-c: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --ba2-font: {% if bs.enable_custom_fonts and bs.font.family %}{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }}{% else %}var(--ba2-heading-font){% endif %};
    --ba2-w: {{ bs.weight | default: 700 }};
    --ba2-size-d: {{ bs.size_desktop | default: 48 }}px;
    --ba2-size-m: {{ bs.size_mobile | default: 32 }}px;
    --ba2-lh: {{ bs.line_height | default: 1.1 }};
    --ba2-track: {{ bs.tracking | default: 0 }}px;
  }
      {%- when 'subheading' %}
  #shopify-section-{{ sid }} [data-bam-block="{{ block.id }}"] {
    --ba2-c: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
    --ba2-font: {% if bs.enable_custom_fonts and bs.font.family %}{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }}{% else %}var(--ba2-body-font){% endif %};
    --ba2-size: {{ bs.size | default: 16 }}px;
    --ba2-lh: {{ bs.line_height | default: 1.5 }};
    --ba2-max-w: {{ bs.max_width | default: 460 }}px;
  }
    {%- endcase -%}
  {%- endfor %}
{% comment %}{% endcomment %}</style>
{% render 'media-ba-compare-style', sid: sid %}
<section class="ba2 color-{{ color_scheme }} gradient" data-bam-root="slider-2" data-bam-section="{{ sid }}" data-bam-settings="{{ st | json | escape }}" data-bam-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","show_section_on":"all","reset_spacing":true,"section_max_width_desktop":1200,"image_position":"left","image_col_fr":1,"content_col_fr":1,"layout_gap_desktop":64,"content_gap":18,"content_align":"left","image_aspect":"1 / 1","image_radius":8,"start_position":50,"handle_icon":"arrows","handle_size":44,"handle_border_width":2,"handle_line_width":3,"show_labels":false,"label_size":12,"label_weight":"700","label_tracking":0.5,"label_transform":"uppercase","label_pad_x":12,"label_pad_y":6,"label_radius":100,"label_offset":16,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","padding_top_desktop":96,"padding_bottom_desktop":96,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"layout_gap_mobile":32,"padding_top_mobile":48,"padding_bottom_mobile":48,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-bam-block-defaults='{"slider":{"before_label":"Before","after_label":"After"},"heading":{"text":"See the difference, side by side","tag":"h2","enable_custom_style":false,"weight_enable":false,"weight":"700","size_enable":false,"size_desktop":48,"size_mobile":32,"line_height":1.1,"tracking":0,"enable_custom_fonts":false,"font":"assistant_n4"},"subheading":{"text":"<p>Drag the handle to compare and see what our product can do.</p>","enable_custom_style":false,"size_enable":false,"size":16,"line_height":1.5,"enable_custom_fonts":false,"font":"assistant_n4","max_width":460},"button":{"text":"Shop now","link":"/","enable_custom_style":false,"use_theme_button":true,"border_width":0,"radius":100,"size":15,"weight_enable":false,"weight":"600","pad_x":28,"pad_y":14,"gap_top":6}}' data-bam-placeholder="{{ placeholder | escape }}" data-width="{{ st.section_width }}" data-show="{{ st.show_section_on | default: 'all' }}" data-position="{{ st.image_position | default: 'left' }}" data-labels="{% if st.show_labels %}true{% else %}false{% endif %}">
  <div class="ba2__inner">
    <div class="ba2__layout">
      <div class="ba2__media">
        {%- liquid
          assign before_img = slider_block.settings.before_image
          assign after_img = slider_block.settings.after_image
          assign before_label = slider_block.settings.before_label | default: fb_accessibility_before | default: 'Before'
          assign after_label = slider_block.settings.after_label | default: fb_accessibility_after | default: 'After'
          assign before_alt = slider_block.settings.before_alt | default: before_img.alt | default: before_label
          assign after_alt = slider_block.settings.after_alt | default: after_img.alt | default: after_label
        -%}
        <div class="bam-compare" data-bam-compare data-bar="true" data-circle="true" style="--bam-pos: {{ start }}%;"{% if slider_block %} data-bam-block="{{ slider_block.id }}" data-bam-type="slider" data-bam-settings="{{ slider_block.settings | json | escape }}" {{ slider_block.shopify_attributes }}{% endif %}>
          {%- if after_img != blank -%}
            <img class="bam-compare__img" data-bam-image="after_image" src="{{ after_img | image_url: width: 1600 }}" srcset="{{ after_img | image_url: width: 800 }} 800w, {{ after_img | image_url: width: 1600 }} 1600w" sizes="(min-width: 992px) 50vw, 100vw" alt="{{ after_alt | escape }}" width="{{ after_img.width | default: 1600 }}" height="{{ after_img.height | default: 1600 }}" loading="lazy" decoding="async" draggable="false">
          {%- else -%}
            <img class="bam-compare__img" data-bam-image="after_image" src="{{ placeholder }}" alt="" width="1600" height="1600" loading="lazy" decoding="async" draggable="false">
          {%- endif -%}
          <span class="bam-compare__label bam-compare__label--after" data-bam-text="after_label">{{ after_label | escape }}</span>
          <div class="bam-compare__before">
            {%- if before_img != blank -%}
              <img class="bam-compare__img" data-bam-image="before_image" src="{{ before_img | image_url: width: 1600 }}" srcset="{{ before_img | image_url: width: 800 }} 800w, {{ before_img | image_url: width: 1600 }} 1600w" sizes="(min-width: 992px) 50vw, 100vw" alt="{{ before_alt | escape }}" width="{{ before_img.width | default: 1600 }}" height="{{ before_img.height | default: 1600 }}" loading="lazy" decoding="async" draggable="false">
            {%- else -%}
              <img class="bam-compare__img" data-bam-image="before_image" src="{{ placeholder }}" alt="" width="1600" height="1600" loading="lazy" decoding="async" draggable="false">
            {%- endif -%}
            <span class="bam-compare__label bam-compare__label--before" data-bam-text="before_label">{{ before_label | escape }}</span>
          </div>
          <div class="bam-compare__handle" data-bam-handle role="slider" tabindex="0" aria-label="{{ 'accessibility.drag_to_reveal' | t }}" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ start }}" aria-valuetext="{{ start }}%">
            <span class="bam-compare__bar" aria-hidden="true"></span>
            <span class="bam-compare__knob" data-bam-icon-current="{{ icon }}" aria-hidden="true">{% render 'media-ba-icon', icon: icon %}</span>
          </div>
        </div>
      </div>
      <div class="ba2__content">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="ba2__heading" data-bam-block="{{ block.id }}" data-bam-type="heading" data-bam-settings="{{ bs | json | escape }}" data-size="{% if bs.size_enable %}true{% else %}false{% endif %}" data-weight="{% if bs.weight_enable %}true{% else %}false{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="ba2__sub" data-bam-block="{{ block.id }}" data-bam-type="subheading" data-bam-settings="{{ bs | json | escape }}" data-size="{% if bs.size_enable %}true{% else %}false{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'button' -%}
              {%- capture btn_style -%}{%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover -%}{%- endif -%}{%- if bs.use_theme_button == false -%}{%- if bs.weight_enable -%}{%- assign btn_weight = bs.weight -%}{%- else -%}{%- assign btn_weight = nil -%}{%- endif -%}{%- render 'button-overrides', custom: true, radius: bs.radius, padding_y: bs.pad_y, padding_x: bs.pad_x, font_size: bs.size, weight: btn_weight, border_width: bs.border_width -%}{%- endif -%}margin-top: {{ bs.gap_top | default: 0 }}px;{%- endcapture -%}
              {%- if bs.link != blank -%}
                <a class="ba2__btn" href="{{ bs.link }}" data-bam-block="{{ block.id }}" data-bam-type="button" data-bam-settings="{{ bs | json | escape }}" data-theme-button="primary" data-sl-button data-button-role="primary" style="{{ btn_style | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</a>
              {%- else -%}
                <button class="ba2__btn" type="button" data-bam-block="{{ block.id }}" data-bam-type="button" data-bam-settings="{{ bs | json | escape }}" data-theme-button="primary" data-sl-button data-button-role="primary" style="{{ btn_style | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</button>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if request.design_mode -%}
    {%- assign icon_list = 'arrows,chevrons,lines,dots,plus' | split: ',' -%}
    {%- for name in icon_list -%}<template data-bam-icon="{{ name }}">{% render 'media-ba-icon', icon: name %}</template>{%- endfor -%}
  {%- endif -%}
</section>
</template>

<schema>
{
  "type": "before-and-after-slider-2",
  "name": "Before/After Slider 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
