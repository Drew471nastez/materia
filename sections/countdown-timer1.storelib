          {
            "value": "0deg",
            "label": "0 deg"
          },
          {
            "value": "45deg",
            "label": "45 deg"
          },
          {
            "value": "90deg",
            "label": "90 deg"
          },
          {
            "value": "135deg",
            "label": "135 deg"
          },
          {
            "value": "180deg",
            "label": "180 deg"
          },
          {
            "value": "225deg",
            "label": "225 deg"
          },
          {
            "value": "270deg",
            "label": "270 deg"
          },
          {
            "value": "315deg",
            "label": "315 deg"
          }
        ],
        "default": "180deg",
        "visible_if": "{{ section.settings.enable_timer_gradient }}"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "hidden": true,
        "info": "Legacy: painted behind the whole section with custom styling on; use Background."
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Number font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Label font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "checkbox",
        "id": "override_fonts",
        "label": "Custom fonts",
        "default": false,
        "hidden": true,
        "info": "Legacy: uses each block's font, and the text font for the numbers; use Custom font in the blocks."
      },
      {
        "type": "range",
        "id": "timer_size",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Number size (desktop)",
        "default": 41
      },
      {
        "type": "select",
        "id": "countdown_font_weight",
        "label": "Number weight",
        "options": [
          {
            "value": "light",
            "label": "Light"
          },
          {
            "value": "normal",
            "label": "Normal"
          },
          {
            "value": "bold",
            "label": "Bold"
          }
        ],
        "default": "normal"
      },
      {
        "type": "range",
        "id": "label_size",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Label size (desktop)",
        "default": 16
      },
      {
        "type": "header",
        "content": "Animation"
