<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Countdown Timer Pro 1: a heading and text over hours,
  minutes and seconds. Each visitor gets the set time (hours, minutes,
  seconds) from their first visit; when it runs out it starts again. The
  timer runs in shopify/assets/live-countdown.js, one per section, kept per
  section in the visitor's browser, paused while the section is off screen or
  the tab is hidden; a change to the time starts it again. Every setting below
  is applied live there too (data-cd-root, data-cd-settings, data-cd-block).
  Theme first: colours follow the colour scheme until Enable custom styling
  is on (the section's, or the block's for its text), fonts follow Theme
  settings > Typography until Custom font is on (data-own-font,
  data-own-weight, data-own-size keep them ahead of the theme's priority).
  Desktop from 801px.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign legacy_fonts = st.override_fonts
  assign sub_block = section.blocks | where: 'type', 'subheading' | first
  assign bg_url = ''
  if st.enable_background_image_url and st.section_background_image_url != blank and st.section_background_image_url != '/'
    assign bg_url = st.section_background_image_url
  elsif st.section_background_image != blank
    assign bg_url = st.section_background_image | image_url: width: 2400
  endif
  case st.timer_alignment
    when 'left'
      assign t_align = 'start'
    when 'right'
      assign t_align = 'end'
    else
      assign t_align = 'center'
  endcase
  case st.countdown_font_weight
    when 'light'
      assign n_weight = 300
    when 'bold'
      assign n_weight = 700
    else
      assign n_weight = 400
  endcase
  assign hh = st.start_hours | default: 0 | plus: 0
  assign mm = st.start_minutes | default: 0 | plus: 0
  assign ss = st.start_seconds | default: 0 | plus: 0
-%}
{%- capture cd1_vars -%}
--cd1-bg:{% render 'countdown-live-color', on: own, color: st.section_background_color, fallback: 'var(--color-background)' %};
--cd1-wrap-bg:{% render 'countdown-live-color', on: own, color: st.section_bg, fallback: 'transparent' %};
--cd1-box-bg:{% render 'countdown-live-color', on: own, color: st.container_background_color, fallback: 'transparent' %};
--cd1-num-bg:{% render 'countdown-live-color', on: own, color: st.countdown_background_color, fallback: 'color-mix(in srgb, var(--color-heading) 8%, var(--color-background))' %};
--cd1-num:{% render 'countdown-live-color', on: own, color: st.timer_color, fallback: 'var(--color-heading)' %};
--cd1-g1:{% render 'countdown-live-color', on: own, color: st.gradient_start_color, fallback: 'color-mix(in srgb, var(--color-heading) 65%, var(--color-background))' %};
--cd1-g2:{% render 'countdown-live-color', on: own, color: st.gradient_middle_color, fallback: 'var(--color-heading)' %};
--cd1-g3:{% render 'countdown-live-color', on: own, color: st.gradient_end_color, fallback: 'var(--color-heading)' %};
--cd1-gdeg:{{ st.gradient_degrees | default: '180deg' }};
--cd1-l1:{% render 'countdown-live-color', on: own, color: st.hours_text_color, fallback: 'var(--color-text)' %};
--cd1-l2:{% render 'countdown-live-color', on: own, color: st.minutes_text_color, fallback: 'var(--color-text)' %};
--cd1-l3:{% render 'countdown-live-color', on: own, color: st.seconds_text_color, fallback: 'var(--color-text)' %};
--cd1-img-bg:{% render 'countdown-live-color', on: own, color: st.section_background_image_color, fallback: 'transparent' %};
--cd1-img-fit:{{ st.section_background_size | default: 'cover' }};--cd1-bright:{{ st.background_image_brightness | default: 100 }}%;
--cd1-pt-d:{{ st.section_padding_top | default: 0 }}px;--cd1-pb-d:{{ st.section_padding_bottom | default: 0 }}px;--cd1-px-d:{{ st.section_padding_left_right | default: 0 }}px;
--cd1-pt-m:{{ st.mobile_section_padding_top | default: 0 }}px;--cd1-pb-m:{{ st.mobile_section_padding_bottom | default: 0 }}px;--cd1-px-m:{{ st.mobile_section_padding_left_right | default: 0 }}px;
--cd1-cpt-d:{{ st.container_padding_top | default: 0 }}px;--cd1-cpb-d:{{ st.container_padding_bottom | default: 0 }}px;--cd1-cpx-d:{{ st.container_padding_left_right | default: 0 }}px;
--cd1-cpt-m:{{ st.mobile_container_padding_top | default: 0 }}px;--cd1-cpb-m:{{ st.mobile_container_padding_bottom | default: 0 }}px;--cd1-cpx-m:{{ st.mobile_container_padding_left_right | default: 0 }}px;
--cd1-max:{{ st.container_max_width | default: 800 }}px;--cd1-text-gap:{{ st.headline_spacing | default: 0 }}px;--cd1-el-gap:{{ st.element_spacing | default: 0 }}px;
--cd1-align-d:{{ st.text_alignment | default: 'center' }};--cd1-align-m:{{ st.mobile_text_alignment | default: 'center' }};--cd1-t-align:{{ t_align }};
--cd1-col:{{ st.item_width | default: 90 }}px;--cd1-gap-d:{{ st.grid_gap | default: 0 }}px;--cd1-gap-m:{{ st.grid_gap_mobile | default: 0 }}px;--cd1-num-pad:{{ st.countdown_padding | default: 0 }}px;
--cd1-num-r:{{ st.countdown_background_border_radius | default: 0 }}px;
--cd1-ns-d:{{ st.timer_size | default: 41 }}px;--cd1-ns-m:{{ st.timer_size_mobile | default: 41 }}px;--cd1-nw:{{ n_weight }};
--cd1-ls-d:{{ st.label_size | default: 16 }}px;--cd1-ls-m:{{ st.mobile_label_size | default: 16 }}px;
{%- if fonts and st.heading_font.family != blank -%}--cd1-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- elsif legacy_fonts and sub_block.settings.text_font.family != blank -%}--cd1-hf:{{ sub_block.settings.text_font.family }}, {{ sub_block.settings.text_font.fallback_families }};{%- endif -%}
{%- if fonts and st.body_font.family != blank -%}--cd1-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- elsif legacy_fonts and sub_block.settings.text_font.family != blank -%}--cd1-bf:{{ sub_block.settings.text_font.family }}, {{ sub_block.settings.text_font.fallback_families }};{%- endif -%}
{%- if bg_url != blank -%}--cd1-img:url('{{ bg_url }}');{%- endif -%}
{%- endcapture -%}
{%- if fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 801px) { #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; } }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  #shopify-section-{{ sid }} .cd1 [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .cd1, #shopify-section-{{ sid }} .cd1 * { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cd1-wrap { background: var(--cd1-wrap-bg); }
  #shopify-section-{{ sid }} .cd1-wrap[data-cd1-width='container'] .cd1 { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cd1-wrap[data-cd1-width='fluid_container'] .cd1 { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cd1 { position: relative; z-index: 0; overflow: hidden; width: 100%; margin: 0; background-color: var(--cd1-bg); padding: var(--cd1-pt-m) var(--cd1-px-m) var(--cd1-pb-m); font-family: var(--cd1-bf, var(--body-font, inherit)); }
  #shopify-section-{{ sid }} .cd1::before { content: ''; position: absolute; inset: 0; z-index: -1; background-color: var(--cd1-img-bg); background-image: var(--cd1-img, none); background-position: center; background-repeat: no-repeat; background-size: var(--cd1-img-fit); filter: brightness(var(--cd1-bright)); }
  #shopify-section-{{ sid }} .cd1__box { position: relative; margin: 0 auto; max-width: var(--cd1-max); background-color: var(--cd1-box-bg); padding: var(--cd1-cpt-m) var(--cd1-cpx-m) var(--cd1-cpb-m); }
  #shopify-section-{{ sid }} .cd1__text { margin: 0; padding: 0 0 var(--cd1-text-gap); text-align: var(--cd1-align-m); }
  #shopify-section-{{ sid }} .cd1__text:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .cd1__heading { margin: 0 0 var(--cd1-el-gap); padding: 0; color: var(--cdb-c, var(--color-heading)); font-family: var(--cdb-ff, var(--cd1-hf, var(--heading-font, inherit))); font-weight: var(--cdb-fw, var(--heading-weight, 400)); font-size: var(--cdb-fs-m, 35px); line-height: var(--cdb-lh, var(--heading-line-height, 1.2)); }
  #shopify-section-{{ sid }} .cd1__sub { margin: 0 0 var(--cd1-el-gap); padding: 0; color: var(--cdb-c, var(--color-text)); font-family: var(--cdb-ff, var(--cd1-bf, var(--body-font, inherit))); font-size: var(--cdb-fs-m, 16px); line-height: var(--cdb-lh, var(--body-line-height, 1.5)); }
  #shopify-section-{{ sid }} .cd1__sub a { color: var(--cdb-link, var(--color-primary)); }
  #shopify-section-{{ sid }} .cd1__grid { display: grid; margin: 0 auto; grid-auto-columns: 1fr; grid-auto-flow: column; gap: var(--cd1-gap-m); }
  #shopify-section-{{ sid }} .cd1__item { padding: var(--cd1-num-pad); text-align: center; background: none; }
  #shopify-section-{{ sid }} .cd1[data-cd1-boxed] .cd1__item { background-color: var(--cd1-num-bg); min-width: 110px; border-radius: var(--cd1-num-r); }
  #shopify-section-{{ sid }} .cd1__num, #shopify-section-{{ sid }} .cd1__label { display: block; line-height: 1; text-align: center; }
  #shopify-section-{{ sid }} .cd1__num { font-family: var(--cd1-hf, inherit); font-size: var(--cd1-ns-m); font-weight: var(--cd1-nw); color: var(--cd1-num); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .cd1[data-cd1-gradient] .cd1__num { background: linear-gradient(var(--cd1-gdeg), var(--cd1-g1), var(--cd1-g2), var(--cd1-g3)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  #shopify-section-{{ sid }} .cd1__label { font-family: var(--cd1-bf, inherit); font-size: var(--cd1-ls-m); font-weight: 700; }
  #shopify-section-{{ sid }} .cd1__item[data-cd-show='h'] .cd1__label { color: var(--cd1-l1); }
  #shopify-section-{{ sid }} .cd1__item[data-cd-show='m'] .cd1__label { color: var(--cd1-l2); }
  #shopify-section-{{ sid }} .cd1__item[data-cd-show='s'] .cd1__label { color: var(--cd1-l3); }
  @media (max-width: 800px) { #shopify-section-{{ sid }} .cd1-wrap[data-cd1-show='desktop'] { display: none; } }
  @media (min-width: 801px) {
    #shopify-section-{{ sid }} .cd1-wrap[data-cd1-show='mobile'] { display: none; }
    #shopify-section-{{ sid }} .cd1 { padding: var(--cd1-pt-d) var(--cd1-px-d) var(--cd1-pb-d); }
    #shopify-section-{{ sid }} .cd1__box { padding: var(--cd1-cpt-d) var(--cd1-cpx-d) var(--cd1-cpb-d); }
    #shopify-section-{{ sid }} .cd1__text { text-align: var(--cd1-align-d); }
    #shopify-section-{{ sid }} .cd1__heading { font-size: var(--cdb-fs-d, 35px); }
    #shopify-section-{{ sid }} .cd1__sub { font-size: var(--cdb-fs-d, 16px); }
    #shopify-section-{{ sid }} .cd1__grid { grid-auto-columns: var(--cd1-col); gap: var(--cd1-gap-d); justify-content: var(--cd1-t-align); }
    #shopify-section-{{ sid }} .cd1__num { font-size: var(--cd1-ns-d); }
    #shopify-section-{{ sid }} .cd1__label { font-size: var(--cd1-ls-d); }
  }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .cd1-wrap[data-cd1-width='stretch_width'] .cd1 { padding-inline: max(var(--cd1-px-d), 3rem); } }
{% comment %}{% endcomment %}</style>

<div class="cd1-wrap color-{{ color_scheme }}" data-cd-root="countdown-timer1" data-cd-section="{{ sid }}" data-cd-settings="{{ st | json | escape }}" data-cd-state="running"{% if request.design_mode %} data-cd-editor{% endif %} data-cd1-width="{{ st.section_width }}" data-cd1-show="{{ st.show_on_device | default: 'all' }}" style="{{ cd1_vars | strip_newlines }}">
  <section class="cd1 loudecomz-section gradient"{% if st.enable_countdown_background %} data-cd1-boxed{% endif %}{% if st.enable_timer_gradient %} data-cd1-gradient{% endif %}>
    <div class="cd1__box">
      <div class="cd1__text">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- liquid
                assign bfont = false
                if bs.enable_custom_fonts or legacy_fonts
                  assign bfont = true
                endif
                assign own_lh = false
                if bs.headline_line_height != blank and bs.headline_line_height != 'inherit'
                  assign own_lh = true
                endif
                assign own_w = false
                if bs.heading_text_weight == 'light' or bs.heading_text_weight == 'normal' or bs.heading_text_weight == 'bold'
                  assign own_w = true
                endif
              -%}
              {%- capture bv -%}
                --cdb-fs-d:{{ bs.headline_size | default: 35 }}px;--cdb-fs-m:{{ bs.mobile_headline_size | default: 35 }}px;
                {%- if bs.enable_custom_style -%}--cdb-c:{% render 'scheme-color', color: bs.headline_color, fallback: 'var(--color-heading)' %};{%- endif -%}
                {%- case bs.heading_text_weight -%}{%- when 'light' -%}--cdb-fw:300;{%- when 'normal' -%}--cdb-fw:400;{%- when 'bold' -%}--cdb-fw:700;{%- endcase -%}
                {%- if own_lh -%}--cdb-lh:{{ bs.headline_line_height }};{%- endif -%}
                {%- if bfont and bs.headline_font.family != blank -%}--cdb-ff:{{ bs.headline_font.family }}, {{ bs.headline_font.fallback_families }};{%- endif -%}
              {%- endcapture -%}
              {%- if bfont -%}<style>{{ bs.headline_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
              <h2 class="cd1__heading" data-cd-block="{{ block.id }}" data-cd-type="heading" data-cd-settings="{{ bs | json | escape }}"{% if fonts or bfont %} data-own-font{% endif %}{% if own_w %} data-own-weight{% endif %}{% if own_lh %} data-own-size{% endif %}{% if bs.headline == blank %} hidden{% endif %} style="{{ bv | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.headline }}</h2>
            {%- when 'subheading' -%}
              {%- liquid
                assign bfont = false
                if bs.enable_custom_fonts or legacy_fonts
                  assign bfont = true
                endif
              -%}
              {%- capture bv -%}
                --cdb-fs-d:{{ bs.text_size | default: 16 }}px;--cdb-fs-m:{{ bs.mobile_text_size | default: 15 }}px;
                {%- if bs.enable_custom_style -%}--cdb-c:{% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-text)' %};--cdb-link:{% render 'scheme-color', color: bs.link_color, fallback: 'var(--color-primary)' %};{%- endif -%}
                {%- if bs.text_line_height != blank and bs.text_line_height != 'inherit' -%}--cdb-lh:{{ bs.text_line_height }};{%- endif -%}
                {%- if bfont and bs.text_font.family != blank -%}--cdb-ff:{{ bs.text_font.family }}, {{ bs.text_font.fallback_families }};{%- endif -%}
              {%- endcapture -%}
              {%- if bfont -%}<style>{{ bs.text_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
              <p class="cd1__sub" data-cd-block="{{ block.id }}" data-cd-type="subheading" data-cd-settings="{{ bs | json | escape }}"{% if fonts or bfont %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ bv | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</p>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="cd1__grid" role="timer" data-cd-clock>
        <div class="cd1__item" data-cd-show="h"><span class="cd1__num" data-cd-unit="h">{% if hh < 10 %}0{% endif %}{{ hh }}</span><span class="cd1__label" data-cd-label="h">{{ st.hours_text }}</span></div>
        <div class="cd1__item" data-cd-show="m"><span class="cd1__num" data-cd-unit="m">{% if mm < 10 %}0{% endif %}{{ mm }}</span><span class="cd1__label" data-cd-label="m">{{ st.minutes_text }}</span></div>
        <div class="cd1__item" data-cd-show="s"{% if st.show_seconds == false %} hidden{% endif %}><span class="cd1__num" data-cd-unit="s">{% if ss < 10 %}0{% endif %}{{ ss }}</span><span class="cd1__label" data-cd-label="s">{{ st.seconds_text }}</span></div>
      </div>
    </div>
  </section>
</div>
</template>

<schema>
{
  "type": "countdown-timer1",
  "name": "Countdown Timer Pro 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_on_device",
      "label": "Show on",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ],
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "range",
      "id": "start_hours",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Hours",
      "default": 4,
      "info": "Each visitor gets this time from their first visit; it starts again when it runs out."
    },
    {
      "type": "range",
      "id": "start_minutes",
      "min": 0,
      "max": 59,
      "step": 1,
      "label": "Minutes",
      "default": 0,
      "info": "Initial minutes."
    },
    {
      "type": "range",
      "id": "start_seconds",
      "min": 0,
      "max": 59,
      "step": 1,
      "label": "Seconds",
      "default": 0,
      "info": "Initial seconds."
    },
    {
      "type": "inline_richtext",
      "id": "hours_text",
      "label": "Hours label",
      "default": "hours"
    },
    {
      "type": "inline_richtext",
      "id": "minutes_text",
      "label": "Minutes label",
      "default": "minutes"
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "seconds_text",
      "label": "Seconds label",
      "default": "seconds",
      "visible_if": "{{ section.settings.show_seconds }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Layout"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment (desktop)",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "timer_alignment",
      "label": "Timer alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 100,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Content width",
      "default": 800
    },
    {
      "type": "range",
      "id": "headline_spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "Gap between text and timer"
    },
    {
      "type": "range",
      "id": "element_spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Gap below heading and text",
      "default": 15
    },
    {
      "type": "range",
      "id": "item_width",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Number column width (desktop)",
      "default": 90
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap between numbers (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "countdown_padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Number padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_countdown_background",
      "label": "Box behind each number",
      "default": false
    },
    {
      "type": "range",
      "id": "countdown_background_border_radius",
