        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Content bottom padding",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_container_padding_left_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Content side padding",
        "default": 0
