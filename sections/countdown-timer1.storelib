              },
              {
                "value": "2.0",
                "label": "2.0"
              }
            ],
            "default": "inherit"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Order before the timer runs out."
