        "label": "Top padding",
        "default": 30
      },
      {
        "type": "range",
        "id": "section_padding_bottom",
        "min": 0,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Bottom padding",
        "default": 30
      },
