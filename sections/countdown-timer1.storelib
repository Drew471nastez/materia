            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "light",
                "label": "Light"
              },
              {
                "value": "normal",
                "label": "Normal"
              },
              {
                "value": "bold",
                "label": "Bold"
              }
            ],
            "default": "theme"
          },
          {
            "type": "range",
            "id": "headline_size",
