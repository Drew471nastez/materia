        "step": 1,
        "unit": "px",
        "label": "Box corner radius",
        "default": 20,
        "visible_if": "{{ section.settings.enable_countdown_background }}"
      },
      {
        "type": "range",
        "id": "overall_countdown_size",
        "min": 10,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Countdown size",
        "default": 60,
        "hidden": true,
        "info": "Legacy: the numbers and labels have their own sizes."
      },
      {
        "type": "header",
        "content": "Background image"
      },
      {
        "type": "image_picker",
        "id": "section_background_image",
        "label": "Background image"
      },
      {
        "type": "select",
        "id": "section_background_size",
        "default": "cover",
        "label": "Image fit",
        "options": [
          {
            "value": "cover",
            "label": "Cover"
          },
          {
            "value": "contain",
            "label": "Contain"
          },
          {
            "value": "auto",
            "label": "Original"
          }
        ]
      },
      {
        "type": "range",
        "id": "background_image_brightness",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "Image brightness (%)",
        "default": 160
      },
      {
        "type": "checkbox",
        "id": "enable_background_image_url",
        "label": "Use image URL",
        "default": false,
        "hidden": true,
        "info": "Legacy: use Background image."
      },
      {
        "type": "text",
        "id": "section_background_image_url",
        "label": "Image URL",
        "default": "/",
        "placeholder": "https://cdn.example.com/path/to/image.jpg",
        "hidden": true,
        "info": "Legacy: used only while Use image URL is on."
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_background_color",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "container_background_color",
        "label": "Content background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "section_background_image_color",
        "label": "Behind the image",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "timer_color",
        "label": "Number color",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_timer_gradient == false }}"
      },
      {
        "type": "color",
        "id": "countdown_background_color",
        "label": "Number box",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_countdown_background }}"
      },
      {
        "type": "color",
        "id": "hours_text_color",
        "label": "Hours label color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "minutes_text_color",
        "label": "Minutes label color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "seconds_text_color",
        "label": "Seconds label color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_timer_gradient",
        "label": "Gradient numbers",
        "default": false
      },
      {
        "type": "color",
        "id": "gradient_start_color",
        "label": "Gradient start",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_timer_gradient }}"
      },
      {
        "type": "color",
        "id": "gradient_middle_color",
