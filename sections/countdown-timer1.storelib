            "max": 75,
            "step": 1,
            "unit": "px",
            "label": "Size (desktop)",
            "default": 35
          },
          {
            "type": "range",
            "id": "mobile_headline_size",
            "min": 10,
            "max": 75,
            "step": 1,
            "unit": "px",
            "label": "Size (mobile)",
            "default": 35
          },
          {
            "type": "select",
            "id": "headline_line_height",
