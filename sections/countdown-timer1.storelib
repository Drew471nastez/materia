      {
        "type": "range",
        "id": "container_padding_left_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Content side padding",
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
