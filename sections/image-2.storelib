      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill)"
        },
        {
          "value": "contain",
          "label": "Contain (fit inside)"
        }
      ]
    },
    {
      "type": "select",
