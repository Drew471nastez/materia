<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image 2
  Single image section. Image-only — no overlay text or button.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
-%}

<style>
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .img2 { background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %}; }
  #shopify-section-{{ sid }} .img2 {
    padding: {{ st.padding_top_mobile | default: 40 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .img2 {
      padding: {{ st.padding_top_desktop | default: 60 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 60 }}px;
    }
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .img2 { padding-left: 0; padding-right: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .img2__inner {
    {%- unless st.full_bleed -%}
      max-width: var(--page-width, 1300px);
      margin-inline: auto;
    {%- endunless -%}
    width: 100%;
  }
  #shopify-section-{{ sid }} .img2__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ st.aspect_w | default: 16 }} / {{ st.aspect_h | default: 9 }};
    border-radius: {{ st.radius | default: 16 }}px;
    overflow: hidden;
    background: rgba(0,0,0,0.04);
    isolation: isolate;
  }
  {%- if st.full_bleed -%}
    #shopify-section-{{ sid }} .img2__media { border-radius: 0; }
  {%- endif -%}
  #shopify-section-{{ sid }} .img2__media img,
  #shopify-section-{{ sid }} .img2__media a {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block;
  }
  #shopify-section-{{ sid }} .img2__media img {
    object-fit: {{ st.fit | default: 'cover' }};
    object-position: {{ st.focal | default: 'center' }};
  }
{% comment %}{% endcomment %}</style>

<div id="img2-{{ sid }}" class="img2 section sec__image-2 color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="img2__inner">
    <div class="img2__media">
      {%- if st.link != blank -%}<a href="{{ st.link }}" aria-label="{{ 'accessibility.image_link' | t }}">{%- endif -%}
      {%- if st.image != blank -%}
        <img
          src="{{ st.image | image_url: width: 1800 }}"
          srcset="{{ st.image | image_url: width: 800 }} 800w, {{ st.image | image_url: width: 1200 }} 1200w, {{ st.image | image_url: width: 1800 }} 1800w, {{ st.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ st.image.alt | escape }}"
          loading="lazy">
      {%- else -%}
        <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
      {%- endif -%}
      {%- if st.link != blank -%}</a>{%- endif -%}
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-2",
  "name": "Image 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full bleed (edge-to-edge)",
      "default": false
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Aspect ratio — width",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "aspect_h",
