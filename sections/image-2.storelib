<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Image 2: one image, optionally linked. Colours follow the
  colour scheme; the background is a custom colour only when "Enable custom
  styling" is on. Live edits are applied by media-live-galleries-b.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.45%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign image_alt = st.image_alt | default: st.image.alt
  assign link = st.link | url
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *::before, #shopify-section-{{ sid }} *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }}:has(> [data-mgb-reset='true']) + .shopify-section { margin-top: 0 !important; }
  #shopify-section-{{ sid }} .img2 {
    --img2-bg: {% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --img2-pt-m: {{ st.padding_top_mobile | default: 0 }}px;
    --img2-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
    --img2-px-m: {{ st.side_padding_mobile | default: 0 }}px;
    --img2-pt-d: {{ st.padding_top_desktop | default: 0 }}px;
    --img2-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px;
    --img2-px-d: {{ st.side_padding_desktop | default: 0 }}px;
    --img2-ratio: {{ st.aspect_w | default: 16 }} / {{ st.aspect_h | default: 9 }};
    --img2-radius: {{ st.radius | default: 0 }}px;
    --img2-fit: {{ st.fit | default: 'cover' }};
    --img2-pos: {{ st.focal | default: 'center' }};
    --img2-pt: var(--img2-pt-m);
    --img2-pb: var(--img2-pb-m);
    --img2-px: var(--img2-px-m);
    display: block;
    background: var(--img2-bg);
    color: var(--color-text);
    padding: var(--img2-pt) var(--img2-px) var(--img2-pb);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .img2 { --img2-pt: var(--img2-pt-d); --img2-pb: var(--img2-pb-d); --img2-px: var(--img2-px-d); }
  }
  #shopify-section-{{ sid }} .img2[data-full='true'] { padding-left: 0; padding-right: 0; }
  #shopify-section-{{ sid }} .img2__inner { width: 100%; max-width: var(--page-width, 1300px); margin-inline: auto; }
  #shopify-section-{{ sid }} .img2[data-full='true'] .img2__inner { max-width: none; }
  #shopify-section-{{ sid }} .img2__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--img2-ratio);
    border-radius: var(--img2-radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text) 8%, var(--img2-bg));
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .img2[data-full='true'] .img2__media { border-radius: 0; }
  #shopify-section-{{ sid }} .img2__media :is(img, a) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .img2__media img { object-fit: var(--img2-fit); object-position: var(--img2-pos); margin: 0; }
  #shopify-section-{{ sid }} .img2__media img[data-mgb-placeholder] { object-fit: contain; }
  #shopify-section-{{ sid }} .img2__media a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -4px; }
{% comment %}{% endcomment %}</style>

<div id="img2-{{ sid }}" class="img2 section sec__image-2 color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-mgb="image-2" data-mgb-section="{{ sid }}" data-mgb-reset="{{ st.reset_spacing }}" data-full="{{ st.full_bleed }}" data-mgb-placeholder-src="{{ placeholder }}" data-mgb-settings="{{ st | json | escape }}" data-mgb-defaults='{&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;reset_spacing&quot;:true,&quot;full_bleed&quot;:false,&quot;aspect_w&quot;:16,&quot;aspect_h&quot;:9,&quot;radius&quot;:16,&quot;fit&quot;:&quot;cover&quot;,&quot;focal&quot;:&quot;center&quot;,&quot;enable_custom_style&quot;:false,&quot;padding_top_desktop&quot;:60,&quot;padding_bottom_desktop&quot;:60,&quot;side_padding_desktop&quot;:32,&quot;padding_top_mobile&quot;:40,&quot;padding_bottom_mobile&quot;:40,&quot;side_padding_mobile&quot;:20}'>
  <div class="img2__inner">
    <div class="img2__media">
      {%- if link != blank -%}<a class="img2__link" href="{{ link }}" aria-label="{{ image_alt | default: 'Open link' | escape }}">{%- endif -%}
      {%- if st.image != blank -%}
        <img
          src="{{ st.image | image_url: width: 1800 }}"
          srcset="{{ st.image | image_url: width: 800 }} 800w, {{ st.image | image_url: width: 1200 }} 1200w, {{ st.image | image_url: width: 1800 }} 1800w, {{ st.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          width="{{ st.image.width | default: 1600 }}"
          height="{{ st.image.height | default: 900 }}"
          alt="{{ image_alt | escape }}"
          loading="lazy"
          decoding="async">
      {%- else -%}
        <img src="{{ placeholder }}" data-mgb-placeholder width="400" height="300" alt="{{ image_alt | escape }}" loading="lazy" decoding="async">
      {%- endif -%}
      {%- if link != blank -%}</a>{%- endif -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "image-2",
  "name": "Image 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "aspect_w",
      "label": "Aspect ratio — width",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "aspect_h",
      "label": "Aspect ratio — height",
      "min": 1,
      "max": 32,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill)"
        },
        {
          "value": "contain",
          "label": "Contain (fit inside)"
        }
      ]
    },
    {
      "type": "select",
      "id": "focal",
      "label": "Focal point",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Section colors + spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image 2",
      "category": "Image and video"
    }
  ],
  "shopify": {
    "name": "Image 2",
    "tag": "section",
    "class": "section sec__image-2",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove section spacing",
        "default": true
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "image_alt",
        "label": "Image alt text",
        "info": "Describes the image for screen readers. Leave empty to use the alt text saved with the image."
      },
      {
        "type": "url",
        "id": "link",
        "label": "Image link"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "checkbox",
        "id": "full_bleed",
        "label": "Full width",
        "default": false,
        "info": "Edge to edge, with no side padding or corners."
      },
      {
        "type": "range",
        "id": "aspect_w",
        "label": "Aspect ratio width",
        "min": 1,
        "max": 32,
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "aspect_h",
        "label": "Aspect ratio height",
        "min": 1,
        "max": 32,
        "step": 1,
        "default": 9
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 16,
        "visible_if": "{{ section.settings.full_bleed == false }}"
      },
      {
        "type": "select",
        "id": "fit",
        "label": "Image fit",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Cover"
          },
          {
            "value": "contain",
            "label": "Contain"
          }
        ]
      },
      {
        "type": "select",
        "id": "focal",
        "label": "Focal point",
        "default": "center",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "side_padding_desktop",
        "label": "Side padding",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "side_padding_mobile",
        "label": "Side padding",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      }
    ],
    "presets": [
      {
        "name": "Image 2",
        "category": "Image and video"
      }
    ]
  }
}
</schema>
