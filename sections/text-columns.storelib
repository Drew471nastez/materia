<template compat="shopify">
<script src="{{ 'live-r7-text.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Text Columns: a heading and a row of short texts side by
  side, one Column block each (small label, heading, text, optional link),
  with thin lines between them. Columns per row are set for desktop and
  tablet; on a phone the columns stack, or sit in one row the finger swipes
  (a native scroll with snap; the arrows only call scrollBy).

  Theme first: colours from the colour scheme, fonts and weights from Theme
  settings > Typography. Custom colours and fonts only while their switch is
  on. Every value is a CSS variable on the root, printed here for the first
  paint and written again by live-r7-text.js on a live edit (the same names
  and fallbacks). Shared styles: snippets/r7-text-base. Header blocks:
  snippets/r7-text-header.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign align = st.content_alignment | default: 'left'
  assign items = 'flex-start'
  if align == 'center'
    assign items = 'center'
  endif
  assign column_count = 0
  for block in section.blocks
    if block.type == 'column'
      assign column_count = column_count | plus: 1
    endif
  endfor
  case st.section_width
    when 'container'
      assign r7_max = 'calc(var(--page-width, 1300px) + 48px)'
      assign r7_pad = '24px'
    when 'stretch_width'
      assign r7_max = 'none'
      assign r7_pad = '30px'
    when 'full_width'
      assign r7_max = 'none'
      assign r7_pad = 'max(24px, 4vw)'
    else
      assign r7_max = 'calc(var(--fluid-container-width, 1500px) + 48px)'
      assign r7_pad = '24px'
  endcase
-%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.enable_custom_fonts -%}
<style>
  {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- render 'r7-text-base', section: section, p: 'txc' -%}
<style>
  #shopify-section-{{ section.id }} .txc { --txc-row-gap: 36px; --txc-gap-t: min(var(--txc-gap), 40px); --txc-gap-now: 32px; --txc-per-row: 1; --txc-card: min(80vw, 320px); }
  #shopify-section-{{ section.id }} .txc[data-dividers="true"] { --txc-row-gap: 48px; }
  #shopify-section-{{ section.id }} .txc__header { margin-bottom: calc(var(--txc-header-gap) * 0.75); }
  #shopify-section-{{ section.id }} .txc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--txc-row-gap);
  }
  #shopify-section-{{ section.id }} .txc__col {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: var(--r7t-items, flex-start);
    text-align: var(--r7t-align, start);
    gap: 10px;
  }
  /* The lines. ::before stands between two columns of a row. ::after lies above a row, drawn across
     the whole row by its first column. --txc-per-row and --txc-gap-now are the row's columns and gap. */
  #shopify-section-{{ section.id }} .txc__col::before,
  #shopify-section-{{ section.id }} .txc__col::after {
    content: '';
    position: absolute;
    display: none;
    background: var(--txc-divider);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .txc__col::before { top: 0; bottom: 0; inset-inline-start: calc(var(--txc-gap-now) / -2); width: 1px; }
  #shopify-section-{{ section.id }} .txc__col::after {
    inset-inline-start: 0;
    top: calc(var(--txc-row-gap) / -2);
    height: 1px;
    width: calc(100% * var(--txc-per-row) + var(--txc-gap-now) * (var(--txc-per-row) - 1));
  }
  #shopify-section-{{ section.id }} .txc__label {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: var(--subheading-weight, 500);
    color: var(--txc-label-ink);
  }
  #shopify-section-{{ section.id }} .txc .txc__title {
    margin: 0;
    max-width: 100%;
    font-family: var(--r7t-heading-font);
    font-size: var(--txc-title-m);
    color: var(--txc-title-ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .txc__nav { display: none; }
  #shopify-section-{{ section.id }} .txc__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--txc-divider);
    border-radius: 50%;
    background: transparent;
    color: var(--color-heading);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .txc__arrow svg { display: block; width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .txc__arrow:active:not(:disabled) { transform: scale(0.92); }
  #shopify-section-{{ section.id }} .txc__arrow:disabled { opacity: 0.35; cursor: default; }
  #shopify-section-{{ section.id }} .txc__arrow:focus-visible,
  #shopify-section-{{ section.id }} .txc__grid:focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 3px; }
  html[dir='rtl'] #shopify-section-{{ section.id }} .txc__arrow svg { transform: scaleX(-1); }

  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .txc[data-dividers="true"]:not([data-mobile="swipe"]) .txc__col + .txc__col::after { display: block; }
    /* Swipe: one row the finger moves, each column snapping to the page's side space
       (or to the middle of the screen when the section is centred). */
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"] .txc__grid {
      display: flex;
      align-items: stretch;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
      margin: -6px -20px;
      padding-block: 6px;
      padding-inline: 20px 0;
      scroll-padding-inline: 20px;
    }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"] .txc__grid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"] .txc__grid::after { content: ''; flex: 0 0 20px; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"] .txc__col { flex: 0 0 var(--txc-card); scroll-snap-align: start; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"] .txc__col + .txc__col { margin-inline-start: var(--txc-gap-now); }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"][data-dividers="true"] .txc__col + .txc__col::before { display: block; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"][data-align="center"] .txc__grid { padding-inline-start: calc((100vw - var(--txc-card)) / 2); scroll-padding-inline: 0; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"][data-align="center"] .txc__grid::after { flex-basis: calc((100vw - var(--txc-card)) / 2); }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"][data-align="center"] .txc__col { scroll-snap-align: center; }
    #shopify-section-{{ section.id }} .txc[data-mobile="swipe"][data-arrows="true"] .txc__nav {
      display: flex;
      gap: 8px;
      justify-content: var(--r7t-items, flex-start);
      margin-top: 20px;
    }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .txc__header { margin-bottom: var(--txc-header-gap); }
    #shopify-section-{{ section.id }} .txc .txc__title { font-size: var(--txc-title-d); }
    #shopify-section-{{ section.id }} .txc[data-dividers="true"] .txc__col::before { display: block; }
  }
  @media (min-width: 768px) and (max-width: 989.98px) {
    #shopify-section-{{ section.id }} .txc { --txc-gap-now: var(--txc-gap-t); --txc-per-row: var(--txc-cols-t); }
    #shopify-section-{{ section.id }} .txc__grid { grid-template-columns: repeat(var(--txc-cols-t), minmax(0, 1fr)); column-gap: var(--txc-gap-t); }
    #shopify-section-{{ section.id }} .txc[data-cols-t="1"] .txc__grid .txc__col::before,
    #shopify-section-{{ section.id }} .txc[data-cols-t="2"] .txc__grid .txc__col:nth-child(2n + 1)::before,
    #shopify-section-{{ section.id }} .txc[data-cols-t="3"] .txc__grid .txc__col:nth-child(3n + 1)::before { display: none; }
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-t="1"] .txc__col:nth-child(n + 2)::after,
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-t="2"] .txc__col:nth-child(2n + 1):nth-child(n + 3)::after,
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-t="3"] .txc__col:nth-child(3n + 1):nth-child(n + 4)::after { display: block; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .txc { --txc-gap-now: var(--txc-gap); --txc-per-row: var(--txc-cols-d); }
    #shopify-section-{{ section.id }} .txc__grid { grid-template-columns: repeat(var(--txc-cols-d), minmax(0, 1fr)); column-gap: var(--txc-gap); }
    #shopify-section-{{ section.id }} .txc[data-cols-d="2"] .txc__grid .txc__col:nth-child(2n + 1)::before,
    #shopify-section-{{ section.id }} .txc[data-cols-d="3"] .txc__grid .txc__col:nth-child(3n + 1)::before,
    #shopify-section-{{ section.id }} .txc[data-cols-d="4"] .txc__grid .txc__col:nth-child(4n + 1)::before { display: none; }
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-d="2"] .txc__col:nth-child(2n + 1):nth-child(n + 3)::after,
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-d="3"] .txc__col:nth-child(3n + 1):nth-child(n + 4)::after,
    #shopify-section-{{ section.id }} .txc[data-dividers="true"][data-cols-d="4"] .txc__col:nth-child(4n + 1):nth-child(n + 5)::after { display: block; }
  }
{% comment %}{% endcomment %}</style>
{%- capture r7_bg -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}{%- endcapture -%}
{%- capture txc_label -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.label_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}{%- endcapture -%}
{%- capture txc_title -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.item_heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}{%- endcapture -%}
{%- capture r7_text -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.text_color, fallback: 'unset' %}{% else %}unset{% endif %}{%- endcapture -%}
{%- assign r7_text = r7_text | strip -%}
{%- capture r7_link -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.link_color, fallback: 'var(--color-link, var(--color-heading))' %}{% else %}var(--color-link, var(--color-heading)){% endif %}{%- endcapture -%}
{%- capture txc_divider -%}{% if st.enable_custom_style %}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %}{%- endcapture -%}
{%- capture r7_heading_font -%}{% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %}{%- endcapture -%}
{%- capture r7_body_font -%}{% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %}{%- endcapture -%}
<div
  class="txc color-{{ color_scheme }} gradient"
  data-r7t="text-columns"
  data-r7t-section="{{ section.id }}"
  {% if request.design_mode %} data-r7t-settings="{{ st | json | escape }}"{% endif %}
  data-cols-d="{{ st.columns_desktop | default: 3 }}"
  data-cols-t="{{ st.columns_tablet | default: 2 }}"
  data-dividers="{% if st.show_dividers %}true{% else %}false{% endif %}"
  data-mobile="{% if st.mobile_layout == 'swipe' and column_count > 1 %}swipe{% else %}stack{% endif %}"
  data-align="{{ align }}"
  data-arrows="{% if st.show_arrows %}true{% else %}false{% endif %}"
  {% if st.enable_custom_fonts %}data-own-font{% endif %}
  {% unless st.reveal %}data-ti-no-reveal{% endunless %}
  style="--r7t-bg: {{ r7_bg | strip }}; {% if r7_text != 'unset' %}--r7t-text-ink: {{ r7_text }}; {% endif %}--r7t-link-ink: {{ r7_link | strip }}; --txc-label-ink: {{ txc_label | strip }}; --txc-title-ink: {{ txc_title | strip }}; --txc-divider: {{ txc_divider | strip }}; --r7t-heading-font: {{ r7_heading_font | strip }}; --r7t-body-font: {{ r7_body_font | strip }}; --r7t-align: {{ align }}; --r7t-items: {{ items }}; --r7t-max: {{ r7_max }}; --r7t-pad-wide: {{ r7_pad }}; --txc-cols-d: {{ st.columns_desktop | default: 3 }}; --txc-cols-t: {{ st.columns_tablet | default: 2 }}; --txc-gap: {{ st.column_gap | default: 48 }}px; --txc-header-gap: {{ st.header_gap | default: 48 }}px; --txc-title-d: {{ st.item_heading_size | default: 22 }}px; --txc-title-m: {{ st.item_heading_size_mobile | default: 20 }}px; --r7t-pt-d: {{ st.padding_top }}px; --r7t-pb-d: {{ st.padding_bottom }}px; --r7t-pt-m: {{ st.padding_top_mobile }}px; --r7t-pb-m: {{ st.padding_bottom_mobile }}px;"
>
  <div class="txc__inner">
    {%- render 'r7-text-header', section: section, p: 'txc' -%}
    {%- if column_count > 0 -%}
      <div class="txc__grid" data-r7t-track>
        {%- for block in section.blocks -%}
          {%- if block.type != 'column' -%}{%- continue -%}{%- endif -%}
          {%- assign bs = block.settings -%}
          <div class="txc__col" data-r7t-block="{{ block.id }}" data-r7t-type="column"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <p class="txc__label" data-r7t-label{% if bs.label == blank %} hidden{% endif %}>{{ bs.label | escape }}</p>
            <h3 class="txc__title" data-r7t-title{% if bs.heading == blank %} hidden{% endif %}>{{ bs.heading }}</h3>
            <div class="txc__text" data-r7t-text{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>
            <a class="txc__link" data-r7t-link{% if bs.link != blank %} href="{{ bs.link }}"{% endif %}{% if bs.link_label == blank %} hidden{% endif %}>{{ bs.link_label | escape }}</a>
          </div>
        {%- endfor -%}
      </div>
      {%- if column_count > 1 -%}
        <div class="txc__nav" data-r7t-nav>
          <button type="button" class="txc__arrow" data-r7t-prev aria-label="{{ 'accessibility.previous' | t }}" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="txc__arrow" data-r7t-next aria-label="{{ 'accessibility.next' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "shopify": {
    "name": "Text Columns",
    "tag": "section",
    "class": "section-text-columns",
    "max_blocks": 14,
    "settings": [
      { "type": "header", "content": "General" },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
      {
        "type": "select",
        "id": "section_width",
        "label": "Width",
        "default": "fluid_container",
        "options": [
          { "value": "container", "label": "Default" },
          { "value": "fluid_container", "label": "Fluid container" },
          { "value": "stretch_width", "label": "Stretched" },
          { "value": "full_width", "label": "Full width" }
        ]
      },
      { "type": "checkbox", "id": "reset_spacing", "label": "Remove space between sections", "default": true, "info": "Turn off to set top and bottom margins under Desktop spacing and Mobile." },
      { "type": "header", "content": "Layout" },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "left",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" }
        ]
      },
      { "type": "range", "id": "columns_desktop", "label": "Columns per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
      { "type": "range", "id": "columns_tablet", "label": "Columns per row (tablet)", "min": 1, "max": 3, "step": 1, "default": 2 },
      { "type": "range", "id": "column_gap", "label": "Gap between columns", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 48 },
      { "type": "range", "id": "header_gap", "label": "Space below heading", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 48 },
      { "type": "checkbox", "id": "show_dividers", "label": "Lines between columns", "default": true },
      { "type": "header", "content": "Appearance" },
      { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false, "info": "Off: colours follow the colour scheme." },
      { "type": "color", "id": "section_bg", "label": "Background", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "label_color", "label": "Label", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "item_heading_color", "label": "Column heading", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "text_color", "label": "Text", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "link_color", "label": "Link", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "divider_color", "label": "Lines", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "header", "content": "Typography" },
      { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom fonts", "default": false, "info": "Off: fonts follow Theme settings > Typography." },
      { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },
      { "type": "font_picker", "id": "body_font", "label": "Text font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },
      { "type": "range", "id": "item_heading_size", "label": "Column heading size (desktop)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 22 },
      { "type": "header", "content": "Animation" },
      { "type": "checkbox", "id": "reveal", "label": "Reveal on scroll", "default": true },
      { "type": "header", "content": "Desktop spacing" },
      { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
      { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
      { "type": "range", "id": "section_margin_top_desktop", "label": "Top margin (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_desktop", "label": "Bottom margin (desktop)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "header", "content": "Mobile" },
      { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },
      {
        "type": "select",
        "id": "mobile_layout",
        "label": "Columns on mobile",
        "default": "stack",
        "options": [
          { "value": "stack", "label": "Stack" },
          { "value": "swipe", "label": "Swipe" }
        ]
      },
      { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true, "visible_if": "{{ section.settings.mobile_layout == 'swipe' }}" },
      { "type": "range", "id": "item_heading_size_mobile", "label": "Column heading size (mobile)", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 20 },
      { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "section_margin_top_mobile", "label": "Top margin (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
