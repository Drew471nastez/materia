<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_banner = 'accessibility.banner' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Category Banners

  A list of full-width banners (image + headline overlay) that link to
  collections or custom URLs. Smooth zoom + underline reveal on hover.
  Each banner is a block with its own image, heading, link, and color
  overrides.
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign banners = section.blocks | where: 'type', 'banner'
  assign placeholder_src = s.placeholder_url | default: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E'
-%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .cb {
    container-type: inline-size;
    container-name: cb;
    background: {% render 'scheme-color', color: s.section_bg, fallback: 'var(--color-background)' %};
    padding-top:    {{ s.padding_top    | default: 0 }}px !important;
    padding-bottom: {{ s.padding_bottom | default: 0 }}px !important;
    padding-left:   {{ s.side_padding_mobile  | default: 0 }}px !important;
    padding-right:  {{ s.side_padding_mobile  | default: 0 }}px !important;
  }
  @container cb (min-width: 760px) {
    #shopify-section-{{ sid }} .cb {
      padding-left:  {{ s.side_padding_desktop | default: 0 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 0 }}px !important;
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cb {
      padding-left:  {{ s.side_padding_desktop | default: 0 }}px !important;
      padding-right: {{ s.side_padding_desktop | default: 0 }}px !important;
    }
  }

  #shopify-section-{{ sid }} .cb__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ s.gap | default: 0 }}px;
    margin: 0; padding: 0;
    list-style: none;
  }
  {%- if s.layout == 'grid_2' -%}
    @container cb (min-width: 760px) {
      #shopify-section-{{ sid }} .cb__list { grid-template-columns: 1fr 1fr; }
    }
    @media (min-width: 900px) {
      #shopify-section-{{ sid }} .cb__list { grid-template-columns: 1fr 1fr; }
    }
  {%- elsif s.layout == 'grid_3' -%}
    @container cb (min-width: 760px) {
      #shopify-section-{{ sid }} .cb__list { grid-template-columns: 1fr 1fr 1fr; }
    }
    @media (min-width: 900px) {
      #shopify-section-{{ sid }} .cb__list { grid-template-columns: 1fr 1fr 1fr; }
    }
  {%- endif -%}

  /* Banner item */
  #shopify-section-{{ sid }} .cb__item {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'var(--color-heading)' %};
    border-radius: {{ s.border_radius | default: 0 }}px;
    aspect-ratio: {{ s.aspect_ratio_mobile | default: '16 / 9' }};
  }
  @container cb (min-width: 760px) {
    #shopify-section-{{ sid }} .cb__item {
      aspect-ratio: {{ s.aspect_ratio_desktop | default: '21 / 9' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cb__item {
      aspect-ratio: {{ s.aspect_ratio_desktop | default: '21 / 9' }};
    }
  }

  /* Image */
  #shopify-section-{{ sid }} .cb__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform {{ s.hover_duration | default: 700 }}ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transform: scale({{ s.image_base_scale | default: 100 | divided_by: 100.0 }});
    will-change: transform;
  }
  #shopify-section-{{ sid }} .cb__item:hover .cb__img,
  #shopify-section-{{ sid }} .cb__item:focus-visible .cb__img {
    transform: scale({{ s.image_hover_scale | default: 105 | divided_by: 100.0 }});
  }

  /* Overlay */
  #shopify-section-{{ sid }} .cb__overlay {
    position: absolute; inset: 0;
    background: {% render 'scheme-color', color: s.overlay_color, fallback: '#000' %};
    opacity: {{ s.overlay_opacity | default: 25 | divided_by: 100.0 }};
    transition: opacity {{ s.hover_duration | default: 700 }}ms ease;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .cb__item:hover .cb__overlay,
  #shopify-section-{{ sid }} .cb__item:focus-visible .cb__overlay {
    opacity: {{ s.overlay_opacity_hover | default: 45 | divided_by: 100.0 }};
  }

  /* Content */
  #shopify-section-{{ sid }} .cb__content {
    position: absolute; inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .cb__content--top    { justify-content: flex-start; padding-top: 32px; }
  #shopify-section-{{ sid }} .cb__content--bottom { justify-content: flex-end;   padding-bottom: 32px; }
  #shopify-section-{{ sid }} .cb__content--left   { align-items: flex-start; text-align: left;  padding-left: 32px; }
  #shopify-section-{{ sid }} .cb__content--right  { align-items: flex-end;   text-align: right; padding-right: 32px; }

  #shopify-section-{{ sid }} .cb__heading {
    margin: 0;
    font-weight: {{ s.heading_weight | default: 'var(--heading-weight, 700)' }};
    color: {% render 'scheme-color', color: s.heading_color, fallback: '#fff' %};
    font-size: {{ s.heading_size_mobile | default: 28 }}px;
    letter-spacing: {{ s.heading_letter_spacing | default: 0.06 }}em;
    text-transform: {% if s.heading_uppercase %}uppercase{% else %}none{% endif %};
    text-shadow: {{ s.heading_shadow | default: '0 2px 8px rgba(0,0,0,0.25)' }};
    position: relative;
    display: inline-block;
  }
  @container cb (min-width: 760px) {
    #shopify-section-{{ sid }} .cb__heading { font-size: {{ s.heading_size_desktop | default: 42 }}px; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .cb__heading { font-size: {{ s.heading_size_desktop | default: 42 }}px; }
  }

  /* Animated underline (reveal on hover) */
  #shopify-section-{{ sid }} .cb__heading::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    bottom: -{{ s.underline_offset | default: 6 }}px;
    height: {{ s.underline_thickness | default: 2 }}px;
    background: {% render 'scheme-color', color: s.underline_color, fallback: 'currentColor' %};
    transform: scaleX(0);
    transform-origin: {% if s.underline_origin == 'right' %}right{% elsif s.underline_origin == 'center' %}center{% else %}left{% endif %} center;
    transition: transform {{ s.underline_duration | default: 350 }}ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #shopify-section-{{ sid }} .cb__item:hover .cb__heading::after,
  #shopify-section-{{ sid }} .cb__item:focus-visible .cb__heading::after {
    transform: scaleX(1);
  }

  #shopify-section-{{ sid }} .cb__sub {
    margin: 8px 0 0;
    color: {% render 'scheme-color', color: s.sub_color, fallback: 'rgba(255, 255, 255, 0.92)' %};
    font-size: {{ s.sub_size | default: 14 }}px;
    line-height: 1.5;
    max-width: 540px;
    text-shadow: {{ s.heading_shadow | default: '0 2px 8px rgba(0,0,0,0.25)' }};
    opacity: 0;
    transform: translateY(8px);
    transition: opacity {{ s.hover_duration | default: 700 }}ms ease, transform {{ s.hover_duration | default: 700 }}ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: 80ms;
  }
  {%- if s.sub_visibility == 'always' -%}
    #shopify-section-{{ sid }} .cb__sub { opacity: 1; transform: none; }
  {%- else -%}
    #shopify-section-{{ sid }} .cb__item:hover .cb__sub,
    #shopify-section-{{ sid }} .cb__item:focus-visible .cb__sub {
      opacity: 1; transform: none;
    }
  {%- endif -%}

  /* Reduced-motion: drop the zoom/transition */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .cb__img,
    #shopify-section-{{ sid }} .cb__overlay,
    #shopify-section-{{ sid }} .cb__heading::after,
    #shopify-section-{{ sid }} .cb__sub {
      transition: none !important;
    }
    #shopify-section-{{ sid }} .cb__item:hover .cb__img { transform: none !important; }
  }
{% comment %}{% endcomment %}</style>

<div class="section color-{{ color_scheme }} gradient{{ reset_spacing }}">
  <div class="cb" data-section-id="{{ sid }}">
    <ul class="cb__list">
      {%- for block in banners -%}
        {%- assign bs = block.settings -%}
        {%- assign banner_link = bs.link -%}
        {%- if banner_link == blank and bs.collection != blank -%}{%- assign banner_link = bs.collection.url -%}{%- endif -%}
        {%- assign banner_image = bs.image -%}
        {%- if banner_image == blank and bs.collection != blank -%}{%- assign banner_image = bs.collection.featured_image -%}{%- endif -%}
        {%- assign banner_heading = bs.heading -%}
        {%- if banner_heading == blank and bs.collection != blank -%}{%- assign banner_heading = bs.collection.title -%}{%- endif -%}

        <li>
          <a class="cb__item"
             href="{{ banner_link | default: '#' }}"
             aria-label="{{ banner_heading | default: fb_accessibility_banner | escape }}"
             {{ block.shopify_attributes }}>

            {%- if banner_image != blank -%}
              {{ banner_image | image_url: width: 2000 | image_tag: class: 'cb__img', loading: 'lazy', alt: banner_heading, sizes: '100vw', widths: '600, 900, 1200, 1600, 2000' }}
            {%- else -%}
              <img class="cb__img" src="{{ placeholder_src }}" alt="" loading="lazy">
            {%- endif -%}

            <div class="cb__overlay"
                 {%- if bs.overlay_color != blank or bs.overlay_opacity != blank -%}
                 style="{% if bs.overlay_color != blank %}background: {{ bs.overlay_color }};{% endif %}{% if bs.overlay_opacity != blank %}opacity: {{ bs.overlay_opacity | divided_by: 100.0 }};{% endif %}"
                 {%- endif -%}>
            </div>

            <div class="cb__content cb__content--{{ s.text_position | default: 'center' }}">
              {%- if banner_heading != blank -%}
                <h3 class="cb__heading"
                    style="{% if bs.heading_color != blank %}color: {{ bs.heading_color }};{% endif %}">{{ banner_heading | escape }}</h3>
              {%- endif -%}
              {%- if bs.subheading != blank -%}
                <p class="cb__sub"
                   style="{% if bs.sub_color != blank %}color: {{ bs.sub_color }};{% endif %}">{{ bs.subheading | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>



</template>

<schema>
{
  "type": "category-banners",
  "name": "Category Banners",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Grid"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Banners per row (desktop)",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Full-width stacked (1 per row)"
        },
        {
          "value": "grid_2",
          "label": "2 per row"
        },
        {
          "value": "grid_3",
          "label": "3 per row"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between banners",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "aspect_ratio_desktop",
      "label": "Banner aspect ratio (desktop)",
      "default": "21 / 9",
      "options": [
        {
          "value": "21 / 9",
          "label": "21:9 ultra-wide"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "3 / 1",
          "label": "3:1 wide"
        },
        {
          "value": "4 / 1",
          "label": "4:1 wider"
        },
        {
          "value": "1 / 1",
          "label": "1:1 square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 portrait"
        }
      ]
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Banner aspect ratio (mobile)",
      "default": "16 / 9",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "1 / 1",
          "label": "1:1 square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        }
      ]
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Banner corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Text overlay"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheading color"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 0.4,
      "step": 0.1,
      "unit": "em",
      "default": 0.1
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Heading weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "UPPERCASE",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_shadow",
      "label": "Heading text shadow (CSS)",
      "default": "0 2px 8px rgba(0,0,0,0.25)"
    },
    {
      "type": "range",
      "id": "sub_size",
      "label": "Subheading size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "sub_visibility",
      "label": "Subheading visibility",
      "default": "hover",
      "options": [
        {
          "value": "hover",
          "label": "Show on hover only"
        },
        {
          "value": "always",
          "label": "Always visible"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Hover effects"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (default)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "overlay_opacity_hover",
      "label": "Overlay opacity (hover)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_base_scale",
      "label": "Image scale (default)",
      "min": 100,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_hover_scale",
      "label": "Image scale (hover)",
      "min": 100,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 105
    },
    {
      "type": "range",
      "id": "hover_duration",
      "label": "Hover transition duration",
      "min": 200,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Underline reveal"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline color"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline thickness",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "underline_offset",
      "label": "Underline offset",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "underline_duration",
      "label": "Underline transition duration",
      "min": 100,
      "max": 1000,
      "step": 25,
      "unit": "ms",
      "default": 350
    },
    {
      "type": "select",
      "id": "underline_origin",
      "label": "Underline reveal origin",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left → right"
        },
        {
          "value": "right",
          "label": "Right → left"
        },
        {
          "value": "center",
          "label": "Center → out"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Image placeholder"
    },
    {
      "type": "url",
      "id": "placeholder_url",
      "label": "Fallback image URL"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image placeholder background"
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Section spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
