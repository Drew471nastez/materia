        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "select",
        "id": "aspect_ratio_mobile",
        "label": "Banner shape on phones",
        "default": "16 / 9",
        "options": [
          {
            "value": "16 / 9",
            "label": "16:9"
          },
          {
            "value": "1 / 1",
            "label": "1:1 square"
          },
          {
            "value": "4 / 5",
            "label": "4:5 portrait"
          },
          {
            "value": "3 / 4",
            "label": "3:4"
          }
        ]
      },
      {
        "type": "range",
        "id": "heading_size_mobile",
        "label": "Title size on phones",
        "min": 14,
        "max": 56,
        "step": 1,
        "unit": "px",
        "default": 28,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "side_padding_mobile",
        "label": "Side padding on phones",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "banner",
        "name": "Banner",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection",
            "info": "Its title, picture and link are used when the fields below are empty."
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Title"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Line under the title"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Image"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Title colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "sub_color",
            "label": "Line colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "overlay_color",
            "label": "Overlay color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "label": "Overlay strength",
            "min": 0,
            "max": 80,
            "step": 1,
            "unit": "%",
            "default": 25,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Category Banners",
        "category": "Collections",
        "blocks": [
          {
            "type": "banner",
            "settings": {
              "heading": "Shop"
            }
          },
          {
            "type": "banner",
            "settings": {
              "heading": "Brand mission"
            }
          },
          {
            "type": "banner",
            "settings": {
              "heading": "Building the brand"
            }
          }
        ]
      }
    ]
  }
}
