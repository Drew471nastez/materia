<template compat="shopify">
<script src="{{ 'live-collections.js' | asset_url }}" defer="defer"></script>
{%- comment -%} Runtime, once per page (the CSS and hero-image-one.js from layout/theme.storelib, every other script from the tags at the top of this file): shopify/assets/live-collections.js. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_banner = 'accessibility.banner' | t -%}
{%- comment -%}
  Materia Themes. Category Banners: a list or grid of banners (a picture with a title) that link to collections. A banner with a
  collection picked takes its title, picture and link from it; its own fields
  replace them. Colours follow the colour scheme and the titles Theme settings
  > Typography until Enable custom styling is on. Live builder updates are in
  live-collections.js (loaded on every page).
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign custom = s.enable_custom_style
  assign banner_count = 0
  for block in section.blocks
    if block.type == 'banner'
      assign banner_count = banner_count | plus: 1
    endif
  endfor
  assign img_sizes = '100vw'
  if s.layout == 'grid_2'
    assign img_sizes = '(min-width: 768px) 50vw, 100vw'
  elsif s.layout == 'grid_3'
    assign img_sizes = '(min-width: 768px) 33vw, 100vw'
  endif
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if s.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .cb1 {
    --cb-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    font-family: var(--body-font, inherit);
    background: var(--cl-section_bg);
    padding: var(--cl-padding_top) var(--cl-side_padding_mobile) var(--cl-padding_bottom);
  }
  #shopify-section-{{ sid }} .cb1, #shopify-section-{{ sid }} .cb1 *, #shopify-section-{{ sid }} .cb1 *::before, #shopify-section-{{ sid }} .cb1 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cb1__inner { margin-inline: auto; }
  #shopify-section-{{ sid }} .cb1[data-width='container'] .cb1__inner { max-width: calc(var(--page-width, 1300px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cb1[data-width='fluid_container'] .cb1__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cb1[data-width='stretch_width'] .cb1__inner { padding-inline: 1.5rem; }

  #shopify-section-{{ sid }} [hidden]:is(.cb1__heading, .cb1__sub, .cb1__content) { display: none !important; }

  /* Grid */
  #shopify-section-{{ sid }} .cb1__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--cl-gap); margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cb1__list > li { margin: 0; padding: 0; min-width: 0; }

  /* Banner */
  #shopify-section-{{ sid }} .cb1__item {
    --ov-o: var(--clb-overlay_opacity, var(--cl-overlay_opacity));
    position: relative; display: block; overflow: hidden; text-decoration: none; color: inherit;
    background: var(--cl-image_bg);
    border-radius: var(--cl-border_radius);
    aspect-ratio: var(--cl-aspect_ratio_mobile);
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} a.cb1__item { cursor: pointer; }
  #shopify-section-{{ sid }} a.cb1__item:focus-visible { outline: 2px solid #ffffff; outline-offset: -6px; box-shadow: inset 0 0 0 4px rgba(0, 0, 0, 0.6); }
  #shopify-section-{{ sid }} .cb1__media, #shopify-section-{{ sid }} .cb1__media picture { position: absolute; inset: 0; display: block; }
  #shopify-section-{{ sid }} .cb1__img, #shopify-section-{{ sid }} .cb1__ph {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(var(--cl-image_base_scale));
    transition: transform var(--cl-hover_duration) var(--cb-ease);
    backface-visibility: hidden;
  }
  #shopify-section-{{ sid }} .cb1__ph { background: color-mix(in srgb, var(--cl-image_bg) 92%, #ffffff); fill: color-mix(in srgb, #ffffff 22%, transparent); }
  #shopify-section-{{ sid }} .cb1__overlay {
    position: absolute; inset: 0; pointer-events: none;
    background: var(--clb-overlay_color, var(--cl-overlay_color)); opacity: var(--ov-o);
    transition: opacity var(--cl-hover_duration) ease;
  }
  #shopify-section-{{ sid }} .cb1__content {
    position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    padding: clamp(16px, 5%, 40px); pointer-events: none;
  }
  #shopify-section-{{ sid }} .cb1[data-text-position='top'] .cb1__content { justify-content: flex-start; }
  #shopify-section-{{ sid }} .cb1[data-text-position='bottom'] .cb1__content { justify-content: flex-end; }
  #shopify-section-{{ sid }} .cb1[data-text-position='left'] .cb1__content { align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .cb1[data-text-position='right'] .cb1__content { align-items: flex-end; text-align: right; }
  #shopify-section-{{ sid }} .cb1__heading {
    position: relative; display: inline-block; max-width: 100%; margin: 0;
    color: var(--clb-heading_color, var(--cl-heading_color));
    font-family: var(--heading-font, inherit);
    font-size: var(--cl-heading_size_mobile, var(--type-h2-size, 30px));
    font-weight: var(--cl-heading_weight, var(--heading-weight, 700));
    line-height: 1.15;
    letter-spacing: var(--cl-heading_letter_spacing);
    text-shadow: var(--cl-heading_shadow);
    text-wrap: balance; overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .cb1[data-uppercase='true'] .cb1__heading { --heading-text-transform: uppercase; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cb1__heading[data-own-size] { --heading-letter-spacing: var(--cl-heading_letter_spacing); }
  #shopify-section-{{ sid }} .cb1__sub {
    margin: 8px 0 0; max-width: 34rem;
    color: var(--clb-sub_color, var(--cl-sub_color));
    font-size: var(--cl-sub_size, var(--body-font-size, 16px));
    line-height: 1.5; text-shadow: var(--cl-heading_shadow); text-wrap: pretty;
  }
  #shopify-section-{{ sid }} .cb1__heading::after {
    content: ''; position: absolute; left: 0; right: 0;
    bottom: calc(-1 * var(--cl-underline_offset)); height: var(--cl-underline_thickness);
    background: var(--cl-underline_color);
    transform: scaleX(0); transform-origin: left center;
    transition: transform var(--cl-underline_duration) var(--cb-ease);
  }
  #shopify-section-{{ sid }} .cb1[data-underline-origin='right'] .cb1__heading::after { transform-origin: right center; }
  #shopify-section-{{ sid }} .cb1[data-underline-origin='center'] .cb1__heading::after { transform-origin: center center; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .cb1[data-sub-visibility='hover'] .cb1__sub { opacity: 0; transform: translateY(8px); transition: opacity var(--cl-hover_duration) ease 80ms, transform var(--cl-hover_duration) var(--cb-ease) 80ms; }
    #shopify-section-{{ sid }} a.cb1__item:hover :is(.cb1__img, .cb1__ph) { transform: scale(var(--cl-image_hover_scale)); }
    #shopify-section-{{ sid }} .cb1__item:hover .cb1__overlay { opacity: clamp(0, calc(var(--ov-o) + var(--cl-overlay_opacity_hover) - var(--cl-overlay_opacity)), 0.9); }
    #shopify-section-{{ sid }} a.cb1__item:hover .cb1__heading::after { transform: scaleX(1); }
    #shopify-section-{{ sid }} .cb1__item:hover .cb1__sub { opacity: 1; transform: none; }
  }
  #shopify-section-{{ sid }} a.cb1__item:focus-visible :is(.cb1__img, .cb1__ph) { transform: scale(var(--cl-image_hover_scale)); }
  #shopify-section-{{ sid }} .cb1__item:focus-visible .cb1__overlay { opacity: clamp(0, calc(var(--ov-o) + var(--cl-overlay_opacity_hover) - var(--cl-overlay_opacity)), 0.9); }
  #shopify-section-{{ sid }} a.cb1__item:focus-visible .cb1__heading::after { transform: scaleX(1); }
  #shopify-section-{{ sid }} .cb1__item:focus-visible .cb1__sub { opacity: 1; transform: none; }
  #shopify-section-{{ sid }} .cb1__empty { margin: 0; padding: 32px 16px; text-align: center; font-size: 14px; color: var(--color-text); }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cb1 { padding-left: var(--cl-side_padding_desktop); padding-right: var(--cl-side_padding_desktop); }
    #shopify-section-{{ sid }} .cb1 .cb1__list { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ sid }} .cb1[data-layout='grid_2'] .cb1__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .cb1[data-layout='grid_3'] .cb1__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .cb1__item { aspect-ratio: var(--cl-aspect_ratio_desktop); }
    #shopify-section-{{ sid }} .cb1 .cb1__heading { font-size: var(--cl-heading_size_desktop, var(--type-h2-size, 36px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.cb1__img, .cb1__ph, .cb1__overlay, .cb1__heading::after, .cb1__sub) { transition: none !important; }
    #shopify-section-{{ sid }} .cb1__heading::after { transition: none !important; }
    #shopify-section-{{ sid }} .cb1__item:is(:hover, :focus-visible) :is(.cb1__img, .cb1__ph) { transform: scale(var(--cl-image_base_scale)) !important; }
  }
{% comment %}{% endcomment %}</style>

<div class="section cb1 color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}" data-width="{{ s.section_width | default: 'full_width' }}" data-cl-banner-label="{{ fb_accessibility_banner | escape }}" {% capture cl_json %}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"layout":{{ section.settings.layout | append: '' | json }},"gap":{{ section.settings.gap | default: 0 | json }},"aspect_ratio_desktop":{{ section.settings.aspect_ratio_desktop | append: '' | json }},"text_position":{{ section.settings.text_position | append: '' | json }},"sub_visibility":{{ section.settings.sub_visibility | append: '' | json }},"border_radius":{{ section.settings.border_radius | default: 0 | json }},"image_base_scale":{{ section.settings.image_base_scale | default: 0 | json }},"placeholder_url":{{ section.settings.placeholder_url | append: '' | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"heading_color":{{ section.settings.heading_color | append: '' | json }},"sub_color":{{ section.settings.sub_color | append: '' | json }},"underline_color":{{ section.settings.underline_color | append: '' | json }},"overlay_color":{{ section.settings.overlay_color | append: '' | json }},"image_bg":{{ section.settings.image_bg | append: '' | json }},"overlay_opacity":{{ section.settings.overlay_opacity | default: 0 | json }},"heading_size_desktop":{{ section.settings.heading_size_desktop | default: 0 | json }},"heading_weight":{{ section.settings.heading_weight | default: 0 | json }},"sub_size":{{ section.settings.sub_size | default: 0 | json }},"heading_uppercase":{% if section.settings.heading_uppercase %}true{% else %}false{% endif %},"heading_letter_spacing":{{ section.settings.heading_letter_spacing | default: 0 | json }},"heading_shadow":{{ section.settings.heading_shadow | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"overlay_opacity_hover":{{ section.settings.overlay_opacity_hover | default: 0 | json }},"image_hover_scale":{{ section.settings.image_hover_scale | default: 0 | json }},"hover_duration":{{ section.settings.hover_duration | default: 0 | json }},"underline_thickness":{{ section.settings.underline_thickness | default: 0 | json }},"underline_offset":{{ section.settings.underline_offset | default: 0 | json }},"underline_duration":{{ section.settings.underline_duration | default: 0 | json }},"underline_origin":{{ section.settings.underline_origin | append: '' | json }},"padding_top":{{ section.settings.padding_top | default: 0 | json }},"padding_bottom":{{ section.settings.padding_bottom | default: 0 | json }},"side_padding_desktop":{{ section.settings.side_padding_desktop | default: 0 | json }},"aspect_ratio_mobile":{{ section.settings.aspect_ratio_mobile | append: '' | json }},"heading_size_mobile":{{ section.settings.heading_size_mobile | default: 0 | json }},"side_padding_mobile":{{ section.settings.side_padding_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-gap: {{ section.settings.gap | default: 0 }}px;--cl-padding_top: {{ section.settings.padding_top | default: 0 }}px;--cl-padding_bottom: {{ section.settings.padding_bottom | default: 0 }}px;--cl-side_padding_desktop: {{ section.settings.side_padding_desktop | default: 0 }}px;--cl-side_padding_mobile: {{ section.settings.side_padding_mobile | default: 0 }}px;--cl-aspect_ratio_desktop: {{ section.settings.aspect_ratio_desktop }};--cl-aspect_ratio_mobile: {{ section.settings.aspect_ratio_mobile }};--cl-border_radius: {{ section.settings.border_radius | default: 0 }}px;--cl-heading_letter_spacing: {{ section.settings.heading_letter_spacing | default: 0 }}em;--cl-heading_shadow: {{ section.settings.heading_shadow }};{% if section.settings.enable_custom_style %}--cl-section_bg: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};{% else %}--cl-section_bg: var(--color-background);{% endif %}{% if section.settings.enable_custom_style %}--cl-heading_color: {% render 'scheme-color', color: section.settings.heading_color, fallback: '#ffffff' %};{% else %}--cl-heading_color: #ffffff;{% endif %}{% if section.settings.enable_custom_style %}--cl-sub_color: {% render 'scheme-color', color: section.settings.sub_color, fallback: 'rgba(255, 255, 255, 0.92)' %};{% else %}--cl-sub_color: rgba(255, 255, 255, 0.92);{% endif %}{% if section.settings.enable_custom_style %}--cl-underline_color: {% render 'scheme-color', color: section.settings.underline_color, fallback: 'currentColor' %};{% else %}--cl-underline_color: currentColor;{% endif %}{% if section.settings.enable_custom_style %}--cl-overlay_color: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %};{% else %}--cl-overlay_color: #000000;{% endif %}{% if section.settings.enable_custom_style %}--cl-image_bg: {% render 'scheme-color', color: section.settings.image_bg, fallback: '#1f2937' %};{% else %}--cl-image_bg: #1f2937;{% endif %}{% if section.settings.enable_custom_style %}--cl-heading_size_desktop: {{ section.settings.heading_size_desktop | default: 0 }}px;{% endif %}{% if section.settings.enable_custom_style %}--cl-heading_size_mobile: {{ section.settings.heading_size_mobile | default: 0 }}px;{% endif %}{% if section.settings.enable_custom_style %}--cl-heading_weight: {{ section.settings.heading_weight | default: 0 }};{% endif %}{% if section.settings.enable_custom_style %}--cl-sub_size: {{ section.settings.sub_size | default: 0 }}px;{% endif %}--cl-overlay_opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};--cl-overlay_opacity_hover: {{ section.settings.overlay_opacity_hover | default: 0 | divided_by: 100.0 }};--cl-image_base_scale: {{ section.settings.image_base_scale | default: 0 | divided_by: 100.0 }};--cl-image_hover_scale: {{ section.settings.image_hover_scale | default: 0 | divided_by: 100.0 }};--cl-hover_duration: {{ section.settings.hover_duration | default: 0 }}ms;--cl-underline_thickness: {{ section.settings.underline_thickness | default: 0 }}px;--cl-underline_offset: {{ section.settings.underline_offset | default: 0 }}px;--cl-underline_duration: {{ section.settings.underline_duration | default: 0 }}ms;{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="category-banners" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","reset_spacing":true,"layout":"stack","gap":0,"aspect_ratio_desktop":"21 / 9","text_position":"center","sub_visibility":"hover","border_radius":0,"image_base_scale":100,"enable_custom_style":false,"overlay_opacity":25,"heading_size_desktop":42,"heading_weight":700,"sub_size":14,"heading_uppercase":true,"heading_letter_spacing":0.1,"heading_shadow":"0 2px 8px rgba(0,0,0,0.25)","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","overlay_opacity_hover":45,"image_hover_scale":105,"hover_duration":700,"underline_thickness":2,"underline_offset":6,"underline_duration":350,"underline_origin":"left","padding_top":0,"padding_bottom":0,"side_padding_desktop":0,"aspect_ratio_mobile":"16 / 9","heading_size_mobile":28,"side_padding_mobile":0}' data-cl-block-defaults='{"banner":{"enable_custom_style":false,"overlay_opacity":25}}' style="{{ cl_vars | strip }}" data-layout="{{ section.settings.layout }}" data-text-position="{{ section.settings.text_position }}" data-sub-visibility="{{ section.settings.sub_visibility }}" data-underline-origin="{{ section.settings.underline_origin }}" data-uppercase="{% if section.settings.heading_uppercase %}true{% else %}false{% endif %}"{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  <div class="cb1__inner">
    {%- if banner_count > 0 -%}
    <ul class="cb1__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' -%}
        {%- liquid
          assign bs = block.settings
          assign coll = bs.collection
          assign banner_link = bs.link
          if banner_link == blank and coll != blank
            assign banner_link = coll.url
          endif
          assign own_image = true
          assign banner_image = bs.image
          if banner_image == blank and coll != blank
            assign banner_image = coll.featured_image
          endif
          if banner_image == blank
            assign own_image = false
          endif
          assign banner_heading = bs.heading
          if banner_heading == blank and coll != blank
            assign banner_heading = coll.title
          endif
          assign tag = 'div'
          if banner_link != blank
            assign tag = 'a'
          endif
        -%}
{%- if request.design_mode or banner_image != blank or banner_heading != blank or s.placeholder_url != blank -%}
        <li {% capture clb_json %}{"collection":{{ block.settings.collection.handle | append: '' | json }},"heading":{{ block.settings.heading | append: '' | json }},"subheading":{{ block.settings.subheading | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"heading_color":{{ block.settings.heading_color | append: '' | json }},"sub_color":{{ block.settings.sub_color | append: '' | json }},"overlay_color":{{ block.settings.overlay_color | append: '' | json }},"overlay_opacity":{{ block.settings.overlay_opacity | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.enable_custom_style %}--clb-heading_color: {% render 'scheme-color', color: block.settings.heading_color, fallback: 'var(--cl-heading_color)' %};{% endif %}{% if block.settings.enable_custom_style %}--clb-sub_color: {% render 'scheme-color', color: block.settings.sub_color, fallback: 'var(--cl-sub_color)' %};{% endif %}{% if block.settings.enable_custom_style %}--clb-overlay_color: {% render 'scheme-color', color: block.settings.overlay_color, fallback: 'var(--cl-overlay_color)' %};{% endif %}{% if block.settings.enable_custom_style %}--clb-overlay_opacity: {{ block.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};{% endif %}{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="banner" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-coll-title="{{ coll.title | escape }}" data-cl-coll-url="{{ coll.url }}" data-cl-own-image="{{ own_image }}" {{ block.shopify_attributes }}>
          <{{ tag }} class="cb1__item"{% if tag == 'a' %} href="{{ banner_link }}"{% endif %}{% if banner_heading == blank and tag == 'a' %} aria-label="{{ fb_accessibility_banner | escape }}"{% endif %}>
            <div class="cb1__media">
              {%- if banner_image != blank -%}
                {{ banner_image | image_url: width: 2000 | image_tag: class: 'cb1__img', loading: 'lazy', alt: banner_heading, sizes: img_sizes, widths: '600, 900, 1200, 1600, 2000' }}
              {%- elsif s.placeholder_url != blank -%}
                <img class="cb1__img" src="{{ s.placeholder_url }}" alt="{{ banner_heading | escape }}" loading="lazy">
              {%- elsif request.design_mode -%}
                {{ 'collection-1' | placeholder_svg_tag: 'cb1__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
              {%- endif -%}
            </div>
            <div class="cb1__overlay" aria-hidden="true"></div>
            <div class="cb1__content">
              <h3 class="cb1__heading"{% if custom %} data-own-weight{% endif %}{% if s.heading_letter_spacing != 0 %} data-own-size{% endif %}{% if banner_heading == blank %} hidden{% endif %}>{{ banner_heading | escape }}</h3>
              <p class="cb1__sub"{% if bs.subheading == blank %} hidden{% endif %}>{{ bs.subheading | escape }}</p>
            </div>
          </{{ tag }}>
        </li>
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- elsif request.design_mode -%}
      <p class="cb1__empty">Add a Banner block to show your first banner.</p>
    {%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "type": "category-banners",
  "name": "Category Banners",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
