<template compat="shopify">
{% render 'theme-type' %}
{{ 'hero-product-two.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script>
<script src="{{ 'hero-product-two.js' | asset_url }}" defer></script>
{% assign c = section.settings %}{% assign scheme = c.color_scheme.id | default: c.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% if c.enable_custom_fonts %}<style>{% if c.heading_font.family %}{{ c.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if c.body_font.family %}{{ c.body_font | font_face: font_display: 'swap' }}{% endif %}{% if c.check_box and c.title_font.family %}{{ c.title_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="hp2-{{ section.id }}" class="hp2 color-{{ scheme }}" data-hero-product-two="{{ section.id }}" data-hp2-settings="{{ c | json | escape }}" data-hp2-defaults='{"section_width":"full_width","color_scheme":"default-color-scheme","reset_spacing":true,"image_position":"left","media_width":45,"content_gap":24,"enable_custom_style":false,"media_radius":20,"media_radius_mobile":10,"enable_custom_fonts":false,"check_box":false,"title_font":"assistant_n4","heading_font":"assistant_n4","body_font":"assistant_n4","bg_type":"img","media_height":550,"media_fit":"cover","media_position_x":50,"media_position_y":50,"animation":"theme","video_autoplay":true,"video_loop":true,"video_controls":true,"padding_top":78,"padding_bottom":78,"section_padding_x":20,"section_gap":41,"image_position_mobile":"bottom","media_height_mobile":400,"padding_top_mobile":30,"padding_bottom_mobile":30,"section_padding_x_mobile":20,"section_gap_mobile":35}' data-hp2-block-defaults='{"section_heading":{"heading_text":"Hero Product Section Placeholder","enable_custom_style":false,"heading_font_size":60,"heading_font_size_mobile":43,"heading_weight":"theme","font_source":"heading","text_case":"theme","letter_spacing":0,"line_height":1.2,"text_alignment":"left","padding_top":0,"padding_bottom":0},"section_para":{"p_text":"Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry&#39;s standard dummy text ever since the 1500s.","enable_custom_style":false,"p_font_size":16,"p_font_size_mobile":15,"p_weight":"theme","font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"text_alignment":"left","padding_top":0,"padding_bottom":0},"button":{"button_text":"Buy now","enable_custom_style":false,"use_theme_button":true,"button_font_size":16,"button_font_size_mobile":16,"button_weight":"500","button_roundness":6,"button_border":0,"padding_vertical":15,"padding_horizontal":20,"text_alignment":"left","full_width":false,"padding_top":0,"padding_bottom":0},"benefits":{"benefit_text_1":"Clinically-dosed prebiotics","benefit_svg_1":"&lt;svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"&gt;&lt;g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_iconCarrier\"&gt; &lt;path d=\"M4 12.9L7.14286 16.5L15 7.5\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;path d=\"M20 7.5625L11.4283 16.5625L11 16\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;/g&gt;&lt;/svg&gt;","benefit_text_2":"Supports digestion &amp; immunity","benefit_svg_2":"&lt;svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"&gt;&lt;g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_iconCarrier\"&gt; &lt;path d=\"M4 12.9L7.14286 16.5L15 7.5\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;path d=\"M20 7.5625L11.4283 16.5625L11 16\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;/g&gt;&lt;/svg&gt;","benefit_text_3":"No sugar. No BS.","benefit_svg_3":"&lt;svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"&gt;&lt;g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/g&gt;&lt;g id=\"SVGRepo_iconCarrier\"&gt; &lt;path d=\"M4 12.9L7.14286 16.5L15 7.5\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;path d=\"M20 7.5625L11.4283 16.5625L11 16\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"&gt;&lt;/path&gt; &lt;/g&gt;&lt;/svg&gt;","enable_custom_style":false,"font_weight":"500","font_size":16,"font_size_mobile":15,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"position":"left","top_space":10,"bottom_space":0,"vertical_gap":8,"svg_size":20,"img_size":20,"padding_top":0,"padding_bottom":0}}' data-hp2-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-hp2-button-font="{{ settings.button_font | default: 'body_font' }}" data-hp2-motion="{{ settings.scroll_animation | default: 'none' }}" data-hp2-duration="{{ settings.animation_duration | default: 700 }}" data-hp2-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="hp2__inner"><div class="hp2__row">
  <div class="hp2__media"><picture>{% if c.body_bg_image_mobile != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: c.body_bg_image_mobile, escaped: true %}">{% endif %}<img src="{% if c.body_bg_image != blank %}{% render 'offer-image-url', image: c.body_bg_image, escaped: true %}{% elsif c.body_bg_image_mobile != blank %}{% render 'offer-image-url', image: c.body_bg_image_mobile, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-hp2-placeholder="{{ placeholder | escape }}" alt="{{ c.image_alt | default: c.body_bg_image.alt | escape }}" width="1600" height="1200" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline{% unless c.video_loop == false %} loop{% endunless %}{% if c.video_controls != false %} controls{% endif %} hidden></video></div>
  <div class="hp2__content">{% for block in section.blocks %}{% unless block.hidden %}<div class="hp2__block" data-hp2-block="{{ block.id }}" data-hp2-kind="{{ block.type }}" data-hp2-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}>
  {% case block.type %}{% when 'section_heading' %}<h1 class="hp2__heading hp2__type" style="font-family:var(--hp2-font,var(--heading-font))!important;font-size:var(--hp2-size,var(--h1-size,48px))!important;font-weight:var(--hp2-weight,var(--heading-weight,600))!important;line-height:var(--hp2-line,var(--heading-line-height,1.2))!important;letter-spacing:var(--hp2-letter,var(--heading-letter-spacing,normal))!important;text-transform:var(--hp2-case,var(--heading-text-transform,none))!important;">{{ block.settings.heading_text }}</h1>
  {% when 'section_para' %}<div class="hp2__paragraph hp2__type">{{ block.settings.p_text }}</div>
  {% when 'button' %}{% if block.settings.button_link != blank and block.settings.button_link != '#' %}<a class="hp2__button" data-theme-button="primary" data-sl-button href="{{ block.settings.button_link | url | escape }}">{{ block.settings.button_text | escape }}</a>{% else %}<button type="button" class="hp2__button" data-theme-button="primary" data-sl-button>{{ block.settings.button_text | escape }}</button>{% endif %}
  {% when 'benefits' %}<div class="hp2__benefits">{% for n in (1..3) %}{% assign tk = 'benefit_text_' | append: n %}<div class="hp2__benefit" data-hp2-benefit="{{ n }}"{% if block.settings[tk] == blank %} hidden{% endif %}><span class="hp2__icon" aria-hidden="true"></span><span class="hp2__benefit-text hp2__type">{{ block.settings[tk] | escape }}</span></div>{% endfor %}</div>{% endcase %}
  </div>{% endunless %}{% endfor %}</div>
 </div></div>
</section>
</template>

<schema>
{
  "type": "hero-product2",
  "name": "Hero Product 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Media Position (Desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media column width",
      "default": 45,
      "min": 25,
      "max": 70,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between blocks",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "body_bg_color",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Media background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media Border Radius (Desktop)",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "media_radius_mobile",
      "label": "Media Border Radius (Mobile)",
      "default": 10,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "check_box",
      "label": "Use one font for the section",
      "default": false,
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Section font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box }}"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box == false }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box == false }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Media Type",
      "options": [
        {
          "value": "img",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "img"
    },
    {
      "type": "image_picker",
      "id": "body_bg_image",
      "label": "Section Image"
    },
    {
      "type": "image_picker",
      "id": "body_bg_image_mobile",
      "label": "Section Image (Mobile)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Media image description"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Section Video",
      "visible_if": "{{ section.settings.bg_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "bg_video_url",
      "label": "Video URL (desktop)",
      "info": "Direct video file URL. A video selected above takes priority.",
      "visible_if": "{{ section.settings.bg_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "bg_video_mobile",
      "label": "Section Video (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "bg_video_url_mobile",
      "label": "Video URL (mobile)",
      "info": "Optional mobile source. When empty, desktop media is used.",
      "visible_if": "{{ section.settings.bg_type == 'video' }}"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Media Layout"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Media height (Desktop)",
      "default": 550,
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_position_x",
      "label": "Horizontal media focus",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "media_position_y",
      "label": "Vertical media focus",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Animation & Behavior"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "default": "theme",
      "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay muted video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 78,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 78,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_x",
      "label": "Padding Horizontal",
      "default": 20,
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Content Gap (Desktop)",
      "default": 41,
      "min": 0,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_44",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Media Position (Mobile)",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Media height (Mobile)",
      "default": 400,
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_x_mobile",
      "label": "Padding Horizontal (mobile)",
      "default": 20,
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap_mobile",
      "label": "Content Gap (Mobile)",
      "default": 35,
      "min": 0,
      "max": 100,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "section_heading",
      "name": "Section Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "heading_text",
          "label": "Heading Text",
          "default": "Hero Product Section Placeholder"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "heading_text_color",
          "label": "Heading Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "label": "Heading Size (Desktop, px)",
          "default": 60,
          "min": 0,
          "max": 120,
          "step": 5,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "label": "Heading Size (Mobile, px)",
          "default": 43,
          "min": 0,
          "max": 80,
          "step": 1,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading Weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            }
          ],
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "font_source",
          "label": "Font",
          "options": [
            {
              "value": "heading",
              "label": "Heading font"
            },
            {
              "value": "body",
              "label": "Body font"
            }
          ],
          "default": "heading",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "select",
          "id": "text_case",
          "label": "Text case",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "none",
              "label": "Original"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "theme",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": -2,
          "max": 8,
          "step": 0.1,
          "default": 0,
          "unit": "px",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.8,
          "max": 2.4,
          "step": 0.1,
          "default": 1.2,
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_13",
          "label": "Layout & Spacing"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
