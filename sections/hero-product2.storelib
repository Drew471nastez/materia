          },
          {
            "type": "text",
            "id": "benefit_text_1",
            "label": "Benefit 1 Text",
            "default": "Clinically-dosed prebiotics"
          },
          {
            "type": "textarea",
            "id": "benefit_svg_1",
            "label": "Benefit 1 SVG (optional)",
            "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <path d=\"M4 12.9L7.14286 16.5L15 7.5\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> <path d=\"M20 7.5625L11.4283 16.5625L11 16\" stroke=\"#141414\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> </g></svg>",
            "info": "Paste a standalone SVG using shapes or paths. An uploaded icon image takes priority. SVG colors follow the theme or custom icon color."
          },
          {
            "type": "image_picker",
            "id": "benefit_img_1",
