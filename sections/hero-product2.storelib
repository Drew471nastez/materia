      },
      {
        "type": "font_picker",
        "id": "title_font",
        "label": "Section font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box }}"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box == false }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts and section.settings.check_box == false }}"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
