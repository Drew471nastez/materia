<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Testimonial logos: one large quote over (or under) a row
  of press or customer logos. Choosing a logo shows its quote.

  One testimonial block per logo and quote. Colours follow the colour
  scheme and fonts follow Theme settings > Typography until custom styling
  or custom fonts are switched on. The logo tabs, the quote change and the
  optional autoplay (paused off screen, on hover and focus, never in the
  editor or under reduced motion) live in assets/live-logos.js, which also
  applies the builder's live edits.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.quote_color_custom
  assign fonts = st.enable_custom_fonts
  assign quote_font = 'var(--lg-hf)'
  assign quote_weight = 'var(--lg-hw)'
  if st.quote_font == 'theme-body'
    assign quote_font = 'var(--lg-bf)'
    assign quote_weight = 'var(--lg-bw)'
  endif
  assign count = section.blocks.size
-%}
{% render 'logos-style', section: section, bp: 750 %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .tlg__inner { text-align: center; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .tlg[data-width='stretch_width'] .tlg__inner { padding-inline: 3rem; }
  #shopify-section-{{ sid }} .tlg__body { display: flex; flex-direction: column; gap: 28px; }
  #shopify-section-{{ sid }} .tlg[data-logos='above'] .tlg__body { flex-direction: column-reverse; }
  #shopify-section-{{ sid }} .tlg__quotewrap { position: relative; max-width: var(--tlg-qmax); width: 100%; margin: 0 auto; }
  #shopify-section-{{ sid }} .tlg[data-mark='true'] .tlg__quotewrap::before { content: '\201C'; position: absolute; top: -26px; left: -4px; z-index: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 64px; line-height: 1; font-weight: 700; color: var(--tlg-mark); pointer-events: none; user-select: none; }
  #shopify-section-{{ sid }} .tlg__quotes { position: relative; z-index: 1; transition-property: opacity, transform, filter; transition-duration: var(--tlg-speed); transition-timing-function: cubic-bezier(0.33, 0, 0.2, 1); }
  #shopify-section-{{ sid }} .tlg__quotes.is-out, #shopify-section-{{ sid }} .tlg__quotes.is-prep { opacity: 0; }
  #shopify-section-{{ sid }} .tlg__quotes.is-prep { transition: none !important; }
  #shopify-section-{{ sid }} .tlg[data-transition='fade_up'] .tlg__quotes.is-out { transform: translateY(-16px); }
  #shopify-section-{{ sid }} .tlg[data-transition='fade_up'] .tlg__quotes.is-prep { transform: translateY(18px); }
  #shopify-section-{{ sid }} .tlg[data-transition='blur'] .tlg__quotes:is(.is-out, .is-prep) { filter: blur(10px); }
  #shopify-section-{{ sid }} .tlg__quote { margin: 0; padding: 0; }
  #shopify-section-{{ sid }} .tlg__quote-text { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; font-family: var(--tlg-qf); font-weight: var(--tlg-qw); font-size: var(--tlg-qs-m); line-height: 1.45; color: var(--tlg-qc); }
  #shopify-section-{{ sid }} .tlg__quote-text p { margin: 0 0 .6em; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .tlg__quote-text p:last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .tlg__author { margin-top: 10px; font-size: var(--tlg-as-m); letter-spacing: .08em; text-transform: uppercase; color: var(--tlg-ac); }
  #shopify-section-{{ sid }} .tlg__logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px var(--tlg-gap-m); }
  #shopify-section-{{ sid }} .tlg__logo { appearance: none; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin: 0; padding: 6px 2px; border: 0; background: transparent; color: var(--lg-heading); cursor: pointer; opacity: var(--tlg-dim); transition: opacity var(--btn-anim-duration, .3s) ease, filter var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .tlg[data-gray='true'] .tlg__logo { filter: grayscale(1); }
  #shopify-section-{{ sid }} .tlg__logo:not([aria-selected='true']):hover { opacity: .7; }
  #shopify-section-{{ sid }} .tlg__logo[aria-selected='true'] { opacity: 1; filter: none; }
  #shopify-section-{{ sid }} .tlg__logo:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; border-radius: 4px; }
  #shopify-section-{{ sid }} .tlg__logo > :is(img, svg) { display: block; height: var(--tlg-lh); width: auto; max-width: 180px; object-fit: contain; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .tlg__body { gap: 38px; }
    #shopify-section-{{ sid }} .tlg[data-mark='true'] .tlg__quotewrap::before { font-size: 120px; top: -48px; left: -10px; }
    #shopify-section-{{ sid }} .tlg__quote-text { font-size: var(--tlg-qs-d); }
    #shopify-section-{{ sid }} .tlg__author { margin-top: 14px; font-size: var(--tlg-as-d); }
    #shopify-section-{{ sid }} .tlg__logos { gap: 18px var(--tlg-gap); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .tlg__quotes { transition: none !important; transform: none !important; filter: none !important; }
    #shopify-section-{{ sid }} .tlg__logo { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- if count > 0 or request.design_mode -%}
<div class="lg tlg tlg-{{ sid }} color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'testimonial-logos', width: st.width, fonts: fonts %} data-logos="{{ st.logos_position | default: 'below' }}" data-mark="{% if st.show_quote_mark %}true{% else %}false{% endif %}" data-gray="{% if st.grayscale_inactive %}true{% else %}false{% endif %}" data-transition="{{ st.transition_style | default: 'fade_up' }}" data-autoplay="{% if st.autoplay %}true{% else %}false{% endif %}" data-interval="{{ st.autoplay_interval | default: 6 }}" data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;width&quot;:&quot;fluid_container&quot;,&quot;logos_position&quot;:&quot;below&quot;,&quot;quote_max_width&quot;:900,&quot;logo_height&quot;:28,&quot;logo_gap&quot;:40,&quot;inactive_opacity&quot;:35,&quot;grayscale_inactive&quot;:true,&quot;show_quote_mark&quot;:true,&quot;quote_color_custom&quot;:false,&quot;quote_font&quot;:&quot;theme-heading&quot;,&quot;quote_size_d&quot;:26,&quot;author_size_d&quot;:13,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;transition_style&quot;:&quot;fade_up&quot;,&quot;transition_speed&quot;:400,&quot;autoplay&quot;:false,&quot;autoplay_interval&quot;:6,&quot;padding_top&quot;:60,&quot;padding_bottom&quot;:60,&quot;quote_size_m&quot;:19,&quot;author_size_m&quot;:12&#125;" data-lg-block-defaults="&#123;&quot;testimonial&quot;:&#123;&quot;quote&quot;:&quot;&lt;p&gt;Add a line a customer or a magazine wrote about your shop.&lt;/p&gt;&quot;&#125;&#125;" style="{% render 'logos-root', section: section, fonts: fonts, hfont: st.heading_font, bfont: st.body_font, pt_d: st.padding_top, pb_d: st.padding_bottom, pt_m: st.padding_top, pb_m: st.padding_bottom, px_d: 0, px_m: 0 %}--tlg-qf: {{ quote_font }};--tlg-qw: {{ quote_weight }};--tlg-qs-d: {{ st.quote_size_d | default: 26 }}px;--tlg-qs-m: {{ st.quote_size_m | default: 19 }}px;--tlg-qmax: {{ st.quote_max_width | default: 900 }}px;--tlg-qc: {% if own %}{% render 'scheme-color', color: st.quote_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--tlg-ac: {% if own %}{% render 'scheme-color', color: st.author_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--tlg-mark: {% if own %}{% render 'scheme-color', color: st.mark_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};--tlg-as-d: {{ st.author_size_d | default: 13 }}px;--tlg-as-m: {{ st.author_size_m | default: 12 }}px;--tlg-lh: {{ st.logo_height | default: 28 }}px;--tlg-gap: {{ st.logo_gap | default: 40 }}px;--tlg-gap-m: {{ st.logo_gap | default: 40 | times: 0.65 | round | at_least: 12 }}px;--tlg-dim: {{ st.inactive_opacity | default: 35 }}%;--tlg-speed: {{ st.transition_speed | default: 400 }}ms;">
  <template data-lg-ph>{% render 'logos-ph' %}</template>
  <div class="lg__inner tlg__inner">
    <div class="tlg__body">
      <div class="tlg__quotewrap">
        <div class="tlg__quotes" data-tlg-quotes aria-live="polite">
          {%- for block in section.blocks -%}
            <figure class="tlg__quote" id="tlg-panel-{{ sid }}-{{ forloop.index0 }}" role="tabpanel" aria-labelledby="tlg-tab-{{ sid }}-{{ forloop.index0 }}" data-tlg-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
              <blockquote class="tlg__quote-text"{% if st.quote_font != 'theme-body' %} data-own-font{% endif %}>{{ block.settings.quote }}</blockquote>
              <figcaption class="tlg__author"{% if block.settings.author == blank %} hidden{% endif %}>{{ block.settings.author | escape }}</figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
      <div class="tlg__logos" role="tablist" aria-label="Testimonial sources">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign label = ''
            if b.logo_image != blank
              assign label = b.logo_image.alt | strip_html | strip
            endif
            if label == blank
              assign label = 'Testimonial ' | append: forloop.index
            endif
          -%}
          <button type="button" class="tlg__logo" id="tlg-tab-{{ sid }}-{{ forloop.index0 }}" role="tab" aria-label="{{ label | escape }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="tlg-panel-{{ sid }}-{{ forloop.index0 }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-index="{{ forloop.index0 }}" data-lg-img {% render 'logos-block', block: block %}>
            {%- if b.logo_image != blank -%}
              <img src="{{ b.logo_image | image_url: height: 128 }}" alt="" width="{{ b.logo_image.width }}" height="{{ b.logo_image.height }}" loading="lazy" decoding="async">
            {%- else -%}
              {%- render 'logos-ph' -%}
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}
</template>

<schema>
{
  "type": "testimonial-logos",
  "name": "Testimonial Logos",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Quote"
    },
    {
      "type": "select",
      "id": "quote_font",
      "label": "Quote font",
      "default": "theme-heading",
      "options": [
        {
          "value": "theme-heading",
          "label": "Theme heading font"
        },
        {
          "value": "theme-body",
          "label": "Theme body font"
        }
      ]
    },
    {
      "type": "range",
      "id": "quote_size_d",
      "label": "Quote size (desktop)",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "quote_size_m",
      "label": "Quote size (mobile)",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "quote_max_width",
      "label": "Quote max width",
      "min": 500,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "checkbox",
      "id": "quote_color_custom",
      "label": "Custom quote color",
      "default": false
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "visible_if": "{{ section.settings.quote_color_custom }}"
    },
    {
      "type": "checkbox",
      "id": "show_quote_mark",
      "label": "Show decorative quote mark",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Author"
    },
    {
      "type": "range",
      "id": "author_size_d",
      "label": "Author size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "author_size_m",
      "label": "Author size (mobile)",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Logos"
    },
    {
      "type": "select",
      "id": "logos_position",
      "label": "Logos position",
      "default": "below",
      "options": [
        {
          "value": "below",
          "label": "Below quote"
        },
        {
          "value": "above",
          "label": "Above quote"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Logo spacing",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "inactive_opacity",
      "label": "Inactive logo opacity",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "grayscale_inactive",
      "label": "Grayscale inactive logos",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Animation"
    },
    {
      "type": "select",
      "id": "transition_style",
      "label": "Transition style",
      "default": "fade_up",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "blur",
          "label": "Blur"
        }
      ]
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 150,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 400
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate testimonials",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Change every",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>“This is the quote your customers and press will remember. Keep it short, confident and easy to read.”</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ],
      "limit": 8
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Testimonial Logos",
      "category": "Logos and trust",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>“The fit and finish rival brands twice the price. This is the rare piece of gear we reach for every single day.”</p>",
            "author": "Gear of the Year"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>“Effortless, considered and quietly luxurious — proof that everyday essentials can still feel special.”</p>",
            "author": "Editors’ Pick"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>“Smart details where they count and nothing where they don’t. It simply works, beautifully.”</p>",
            "author": "9/10 — Highly Recommended"
          }
        }
      ]
    }
  ],
  "shopify": {
    "name": "Testimonial Logos",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "logos_position",
        "label": "Logos position",
        "default": "below",
        "options": [
          {
            "value": "below",
            "label": "Below"
          },
          {
            "value": "above",
            "label": "Above"
          }
        ]
      },
      {
        "type": "range",
        "id": "quote_max_width",
        "label": "Quote max width",
        "min": 500,
        "max": 1200,
        "step": 50,
        "unit": "px",
        "default": 900
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 16,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "logo_gap",
        "label": "Gap between logos",
        "min": 12,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "inactive_opacity",
        "label": "Inactive logo opacity",
        "min": 10,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 35
      },
      {
        "type": "checkbox",
        "id": "grayscale_inactive",
        "label": "Greyscale inactive logos",
        "default": true
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "show_quote_mark",
        "label": "Show quote mark",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "quote_color_custom",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "quote_color",
        "label": "Quote",
        "visible_if": "{{ section.settings.quote_color_custom }}"
      },
      {
        "type": "color",
        "id": "author_color",
        "label": "Author",
        "visible_if": "{{ section.settings.quote_color_custom }}"
      },
      {
        "type": "color",
        "id": "mark_color",
        "label": "Quote mark",
        "visible_if": "{{ section.settings.quote_color_custom and section.settings.show_quote_mark }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "select",
        "id": "quote_font",
        "label": "Quote font",
        "default": "theme-heading",
        "options": [
          {
            "value": "theme-heading",
            "label": "Heading"
          },
          {
            "value": "theme-body",
            "label": "Body"
          }
        ]
      },
      {
        "type": "range",
        "id": "quote_size_d",
        "label": "Quote size (desktop)",
        "min": 16,
        "max": 48,
        "step": 1,
        "unit": "px",
        "default": 26
      },
      {
        "type": "range",
        "id": "author_size_d",
        "label": "Author size (desktop)",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}",
        "info": "Used for the quote when Quote font is Heading"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation"
