            "value": "blur",
            "label": "Blur"
          }
        ]
      },
      {
        "type": "range",
        "id": "transition_speed",
        "label": "Change speed",
        "min": 150,
        "max": 1000,
        "step": 50,
        "unit": "ms",
        "default": 400
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "autoplay_interval",
        "label": "Change every",
        "min": 3,
        "max": 12,
        "step": 1,
        "unit": "s",
        "default": 6,
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "header",
