          },
          {
            "type": "text",
            "id": "author",
            "label": "Author"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Testimonial Logos",
        "category": "Logos and trust",
        "blocks": [
