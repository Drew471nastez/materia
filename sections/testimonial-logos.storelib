        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "quote_size_m",
        "label": "Quote size (mobile)",
        "min": 14,
        "max": 36,
        "step": 1,
        "unit": "px",
        "default": 19
      },
      {
        "type": "range",
        "id": "author_size_m",
        "label": "Author size (mobile)",
        "min": 9,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 12
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial",
        "limit": 8,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
