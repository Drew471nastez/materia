  "presets": [
    {
      "name": "Product Benefits Pro",
      "category": "Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-mobile-alt",
            "icon_color": "#4368FF",
            "enable_icon_circle_bg": true,
            "icon_circle_bg_color": "#F5F5F5",
            "icon_circle_bg_size": 70,
            "icon_circle_border_radius": 50,
            "svg_icon_size": 40,
            "title": "Crisp Display",
            "description": "Delivers stunning visuals with vibrant colors and deep contrast, making every detail come to life."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-battery-full",
            "icon_color": "#F723FF",
            "enable_icon_circle_bg": true,
            "icon_circle_bg_color": "#F5F5F5",
            "icon_circle_bg_size": 70,
            "icon_circle_border_radius": 50,
            "svg_icon_size": 40,
            "title": "Longer Battery Life",
            "description": "Keeps you powered throughout the day with optimized energy efficiency, ensuring you stay connected."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-pencil-alt",
            "icon_color": "#FF2F1E",
            "enable_icon_circle_bg": true,
            "icon_circle_bg_color": "#F5F5F5",
            "icon_circle_bg_size": 70,
            "icon_circle_border_radius": 50,
            "svg_icon_size": 40,
            "title": "Durable Design",
            "description": "Built with premium materials to withstand daily use, extending the longevity of your device."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-lock",
            "icon_color": "#DFBC00",
            "enable_icon_circle_bg": true,
            "icon_circle_bg_color": "#F5F5F5",
            "icon_circle_bg_size": 70,
            "icon_circle_border_radius": 50,
            "svg_icon_size": 40,
            "title": "Seamless Integration",
            "description": "Pairs effortlessly with all your Apple devices, providing a smooth and synchronized experience."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-eye",
            "icon_color": "#45A5FF",
            "enable_icon_circle_bg": true,
            "icon_circle_bg_color": "#F5F5F5",
            "icon_circle_bg_size": 70,
            "icon_circle_border_radius": 50,
            "svg_icon_size": 40,
            "title": "Sunlight Visibility",
            "description": "Optimized screen technology ensures clear visuals, even in bright outdoor conditions."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-star",
            "icon_color": "#6B6B6B",
            "enable_icon_circle_bg": true,
