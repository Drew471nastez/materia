<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Product Shop The Look.

  A lifestyle image beside eyebrow, heading and text blocks and a list of
  the products in the look (one Product block each). Titles, prices,
  pictures and links come from the products: a compare-at price shows
  only when it is higher, a sold out product shows Sold out. "Theme card"
  draws each product with the theme's product card (snippets/product-item)
  so Theme settings > Product cards apply. Colours follow the colour
  scheme and fonts Theme settings > Typography until custom styling or
  custom fonts are on. Desktop layout starts at a 760px wide section.
  Live edits: assets/live-products-d.js.
{%- endcomment -%}
{%- comment -%}pd-gen:settings{%- endcomment -%}{%- capture pd_settings -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | json }},"reset_spacing":{{ section.settings.reset_spacing | json }},"image_position":{{ section.settings.image_position | json }},"column_valign":{{ section.settings.column_valign | json }},"image_width_pct":{{ section.settings.image_width_pct | json }},"gap_desktop":{{ section.settings.gap_desktop | json }},"text_gap":{{ section.settings.text_gap | json }},"image":{% if section.settings.image != blank %}{"src":{{ section.settings.image | image_url: width: 1600 | json }},"alt":{{ section.settings.image.alt | json }}}{% else %}null{% endif %},"placeholder_url":{{ section.settings.placeholder_url | append: '' | json }},"image_aspect_desktop":{{ section.settings.image_aspect_desktop | json }},"image_min_height":{{ section.settings.image_min_height | json }},"image_radius":{{ section.settings.image_radius | json }},"card_style":{{ section.settings.card_style | json }},"show_vendor":{{ section.settings.show_vendor | json }},"show_price":{{ section.settings.show_price | json }},"card_image_size":{{ section.settings.card_image_size | json }},"card_image_radius":{{ section.settings.card_image_radius | json }},"card_radius":{{ section.settings.card_radius | json }},"card_padding":{{ section.settings.card_padding | json }},"card_gap":{{ section.settings.card_gap | json }},"card_title_size":{{ section.settings.card_title_size | json }},"vendor_size":{{ section.settings.vendor_size | json }},"price_size":{{ section.settings.price_size | json }},"product_gap":{{ section.settings.product_gap | json }},"products_margin_top":{{ section.settings.products_margin_top | json }},"enable_custom_style":{{ section.settings.enable_custom_style | json }},"section_bg":{{ section.settings.section_bg | append: '' | json }},"image_bg":{{ section.settings.image_bg | append: '' | json }},"card_bg":{{ section.settings.card_bg | append: '' | json }},"card_border":{{ section.settings.card_border | append: '' | json }},"card_border_hover":{{ section.settings.card_border_hover | append: '' | json }},"card_image_bg":{{ section.settings.card_image_bg | append: '' | json }},"card_title_color":{{ section.settings.card_title_color | append: '' | json }},"vendor_color":{{ section.settings.vendor_color | append: '' | json }},"price_color":{{ section.settings.price_color | append: '' | json }},"price_compare_color":{{ section.settings.price_compare_color | append: '' | json }},"cta_bg":{{ section.settings.cta_bg | append: '' | json }},"cta_color":{{ section.settings.cta_color | append: '' | json }},"cta_bg_hover":{{ section.settings.cta_bg_hover | append: '' | json }},"enable_custom_fonts":{{ section.settings.enable_custom_fonts | json }},"heading_font":{"family":{{ section.settings.heading_font.family | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | json }}},"body_font":{"family":{{ section.settings.body_font.family | json }},"fallback_families":{{ section.settings.body_font.fallback_families | json }}},"padding_top":{{ section.settings.padding_top | json }},"padding_bottom":{{ section.settings.padding_bottom | json }},"side_padding_desktop":{{ section.settings.side_padding_desktop | json }},"image_aspect":{{ section.settings.image_aspect | json }},"gap_mobile":{{ section.settings.gap_mobile | json }},"side_padding_mobile":{{ section.settings.side_padding_mobile | json }}}{%- endcapture -%}{%- capture pd_defaults -%}{"color_scheme":"default-color-scheme","section_width":"full_width","reset_spacing":true,"image_position":"left","column_valign":"flex-start","image_width_pct":50,"gap_desktop":48,"text_gap":18,"image_aspect_desktop":"auto","image_min_height":520,"image_radius":16,"card_style":"compact","show_vendor":false,"show_price":true,"card_image_size":96,"card_image_radius":10,"card_radius":14,"card_padding":12,"card_gap":16,"card_title_size":15,"vendor_size":11,"price_size":14,"product_gap":16,"products_margin_top":8,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","padding_top":49,"padding_bottom":49,"side_padding_desktop":24,"image_aspect":"4 / 5","gap_mobile":28,"side_padding_mobile":16}{%- endcapture -%}{%- capture pd_block_defaults -%}{"eyebrow":{"text":"Shop the look","enable_custom_style":false,"size":12,"letter_spacing":0.2},"heading":{"text":"Get the look","tag":"h2","enable_custom_style":false,"size_desktop":40,"size_mobile":28},"subheading":{"text":"<p>Everything you need, hand-picked into one easy-to-shop edit.</p>","enable_custom_style":false,"size":15,"max_width":560},"product":{}}{%- endcapture -%}{%- comment -%}/pd-gen{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign custom = s.enable_custom_style
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign card_style = s.card_style | default: 'compact'
  assign maxw = 'none'
  if s.section_width == 'container'
    assign maxw = 'var(--page-width, 1300px)'
  elsif s.section_width == 'fluid_container'
    assign maxw = 'var(--fluid-container-width, 1500px)'
  endif
  assign xp = '0px'
  if s.section_width == 'stretch_width'
    assign xp = '1.5rem'
  endif
  assign hf = 'var(--heading-font)'
  assign bf = 'var(--body-font)'
  if s.enable_custom_fonts
    if s.heading_font.family != blank
      assign hf = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families
      if s.heading_font.fallback_families == blank
        assign hf = s.heading_font.family | append: ', sans-serif'
      endif
    endif
    if s.body_font.family != blank
      assign bf = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
      if s.body_font.fallback_families == blank
        assign bf = s.body_font.family | append: ', sans-serif'
      endif
    endif
  endif
  assign ar_d = s.image_aspect_desktop | default: 'auto'
  assign sold_out_label = 'products.product.sold_out' | t
-%}
{%- capture root_vars -%}
  --pd-pt: {{ s.padding_top | default: 0 }}px; --pd-pb: {{ s.padding_bottom | default: 0 }}px; --pd-sp-d: {{ s.side_padding_desktop | default: 0 }}px; --pd-sp-m: {{ s.side_padding_mobile | default: 0 }}px; --pd-maxw: {{ maxw }}; --pd-xp: {{ xp }};
  --pd-dir: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %}; --pd-valign: {{ s.column_valign | default: 'flex-start' }}; --pd-iw: {{ s.image_width_pct | default: 50 }}%; --pd-gap-d: {{ s.gap_desktop | default: 0 }}px; --pd-gap-m: {{ s.gap_mobile | default: 0 }}px; --pd-tgap: {{ s.text_gap | default: 0 }}px;
  --pd-ar-m: {{ s.image_aspect | default: '4 / 5' }}; --pd-ar-d: {{ ar_d }}; --pd-ih: {{ s.image_min_height | default: 520 }}px; --pd-ir: {{ s.image_radius | default: 0 }}px;
  --pd-cis: {{ s.card_image_size }}px; --pd-cir: {{ s.card_image_radius }}px; --pd-cr: {{ s.card_radius }}px; --pd-cp: {{ s.card_padding }}px; --pd-cg: {{ s.card_gap }}px; --pd-cts: {{ s.card_title_size }}px; --pd-vs: {{ s.vendor_size }}px; --pd-ps: {{ s.price_size }}px; --pd-pg: {{ s.product_gap }}px; --pd-pmt: {{ s.products_margin_top }}px;
  --pd-hf: {{ hf }}; --pd-bf: {{ bf }};
  {%- if custom -%}
    {%- for pair in 'section_bg:--pd-bg,image_bg:--pd-img-bg,card_bg:--pd-cbg,card_border:--pd-cb,card_border_hover:--pd-cbh,card_image_bg:--pd-cibg,card_title_color:--pd-ctc,vendor_color:--pd-vc,price_color:--pd-pc,price_compare_color:--pd-pcc,cta_bg:--pd-ctabg,cta_color:--pd-ctac,cta_bg_hover:--pd-ctabgh' | split: ',' -%}
      {%- assign kv = pair | split: ':' -%}
      {%- capture c -%}{% render 'scheme-color', color: s[kv[0]], fallback: 'none' %}{%- endcapture -%}
      {%- if c != 'none' -%}{{ kv[1] }}: {{ c }};{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; container: pdlook / inline-size; }
  {%- if s.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if s.enable_custom_fonts %}{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}
  #shopify-section-{{ sid }} .pstl { box-sizing: border-box; padding: var(--pd-pt) var(--pd-sp-m) var(--pd-pb); background: var(--pd-bg, var(--color-background)); color: var(--color-text); font-family: var(--pd-bf); }
  #shopify-section-{{ sid }} .pstl__inner { box-sizing: border-box; max-width: var(--pd-maxw); margin-inline: auto; padding-inline: var(--pd-xp); display: flex; flex-direction: column; gap: var(--pd-gap-m); }
  #shopify-section-{{ sid }} .pstl__media { position: relative; width: 100%; min-width: 0; overflow: hidden; border-radius: var(--pd-ir); background: var(--pd-img-bg, color-mix(in srgb, var(--color-heading) 6%, transparent)); aspect-ratio: var(--pd-ar-m); }
  #shopify-section-{{ sid }} .pstl__media > :is(img, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .pstl__media > svg { fill: color-mix(in srgb, var(--color-heading) 30%, transparent); }
  #shopify-section-{{ sid }} .pstl__col { min-width: 0; display: flex; flex-direction: column; gap: var(--pd-tgap); }
  #shopify-section-{{ sid }} .pstl__eyebrow { margin: 0; text-transform: uppercase; color: var(--pd-c, var(--color-text)); font-size: var(--pd-fs, 12px); letter-spacing: var(--pd-ls, .2em); }
  #shopify-section-{{ sid }} .pstl__heading { margin: 0; color: var(--pd-c, var(--color-heading)); font-family: var(--pd-hf); font-size: var(--pd-fs-m, 28px); line-height: 1.1; }
  #shopify-section-{{ sid }} .pstl__sub { margin: 0; color: var(--pd-c, var(--color-text)); font-size: var(--pd-fs, 15px); max-width: var(--pd-mw, 560px); line-height: 1.55; }
  #shopify-section-{{ sid }} .pstl__sub p { margin: 0 0 .5em; } #shopify-section-{{ sid }} .pstl__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .pstl__products { display: grid; grid-template-columns: 1fr; gap: var(--pd-pg); margin-top: var(--pd-pmt); }
  #shopify-section-{{ sid }} .pstl[data-card-style='theme'] .pstl__products { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  #shopify-section-{{ sid }} .pstl__card { box-sizing: border-box; display: grid; grid-template-columns: var(--pd-cis) minmax(0, 1fr) auto; align-items: center; gap: var(--pd-cg); padding: var(--pd-cp); min-height: 44px; background: var(--pd-cbg, var(--color-background)); border: 1px solid var(--pd-cb, var(--color-border)); border-radius: var(--pd-cr); color: inherit; text-decoration: none; transition: transform var(--btn-anim-duration, .3s) ease, box-shadow var(--btn-anim-duration, .3s) ease, border-color var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .pstl__card:is(a):hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(0 0 0 / .08); border-color: var(--pd-cbh, var(--color-heading)); }
  #shopify-section-{{ sid }} .pstl__card:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ sid }} .pstl__card-image { width: var(--pd-cis); height: var(--pd-cis); border-radius: var(--pd-cir); overflow: hidden; background: var(--pd-cibg, color-mix(in srgb, var(--color-heading) 6%, transparent)); }
  #shopify-section-{{ sid }} .pstl__card-image > :is(img, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .pstl__card-image > svg { fill: color-mix(in srgb, var(--color-heading) 30%, transparent); }
  #shopify-section-{{ sid }} .pstl__card-info { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  #shopify-section-{{ sid }} .pstl__card-vendor { margin: 0; font-size: var(--pd-vs); text-transform: uppercase; letter-spacing: .14em; color: var(--pd-vc, var(--color-text)); }
  #shopify-section-{{ sid }} .pstl__card-title { margin: 0; font-family: var(--pd-hf); font-weight: var(--heading-weight, 600); font-size: var(--pd-cts); line-height: 1.25; color: var(--pd-ctc, var(--color-heading)); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  #shopify-section-{{ sid }} .pstl__card-price { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; font-size: var(--pd-ps); font-weight: 600; color: var(--pd-pc, var(--color-primary)); }
  #shopify-section-{{ sid }} .pstl__card-price del { color: var(--pd-pcc, var(--color-text)); opacity: .7; font-weight: 400; }
  #shopify-section-{{ sid }} .pstl__card-soldout { font-size: .85em; font-weight: 500; color: var(--color-text); text-transform: uppercase; letter-spacing: .06em; }
  #shopify-section-{{ sid }} .pstl__card-cta { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; background: var(--pd-ctabg, var(--btn-primary-bg-color)); color: var(--pd-ctac, var(--btn-primary-color)); transition: transform var(--btn-anim-duration, .3s) ease, background-color var(--btn-anim-duration, .3s) ease, color var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .pstl__card:is(a):hover .pstl__card-cta { background: var(--pd-ctabgh, var(--btn-primary-hover-bg-color)); color: var(--pd-ctac, var(--btn-primary-hover-color)); transform: scale(1.05); }
  #shopify-section-{{ sid }} .pstl__card-cta svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .pstl :where([hidden]) { display: none !important; }
  @container pdlook (max-width: 480px) {
    #shopify-section-{{ sid }} .pstl__card { grid-template-columns: calc(var(--pd-cis) * .75) minmax(0, 1fr) auto; }
    #shopify-section-{{ sid }} .pstl__card-image { width: calc(var(--pd-cis) * .75); height: calc(var(--pd-cis) * .75); }
  }
  @container pdlook (min-width: 760px) {
    #shopify-section-{{ sid }} .pstl { padding-inline: var(--pd-sp-d); }
    #shopify-section-{{ sid }} .pstl__inner { flex-direction: var(--pd-dir); gap: var(--pd-gap-d); align-items: var(--pd-valign); }
    #shopify-section-{{ sid }} .pstl__media { flex: 0 0 calc(var(--pd-iw) - var(--pd-gap-d) / 2); max-width: calc(var(--pd-iw) - var(--pd-gap-d) / 2); aspect-ratio: var(--pd-ar-d); }
    #shopify-section-{{ sid }} .pstl[data-aspect-d='auto'] .pstl__media { height: var(--pd-ih); min-height: var(--pd-ih); }
    #shopify-section-{{ sid }} .pstl__col { flex: 1 1 0; }
    #shopify-section-{{ sid }} .pstl__heading { font-size: var(--pd-fs-d, 40px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.pstl__card, .pstl__card-cta) { transition: none; }
    #shopify-section-{{ sid }} .pstl__card:is(a):hover, #shopify-section-{{ sid }} .pstl__card:is(a):hover .pstl__card-cta { transform: none; }
  }
{% comment %}{% endcomment %}</style>
<div class="pstl pd-look section color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-pd-root="look" data-pd-section="{{ sid }}" data-pd-settings="{{ pd_settings | escape }}" data-pd-defaults="{{ pd_defaults | escape }}" data-pd-block-defaults="{{ pd_block_defaults | escape }}" data-card-style="{{ card_style }}" data-aspect-d="{% if ar_d == 'auto' %}auto{% else %}ratio{% endif %}" style="{{ root_vars | strip_newlines | strip }}">
  <div class="pstl__inner">
    <div class="pstl__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', decoding: 'async', sizes: '(min-width: 760px) 50vw, 100vw', widths: '480, 720, 960, 1200, 1600', alt: s.image.alt }}
      {%- elsif s.placeholder_url != blank -%}
        <img src="{{ s.placeholder_url | escape }}" alt="" loading="lazy" decoding="async" width="1200" height="1500">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="pstl__col">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- comment -%}pd-gen:block{%- endcomment -%}{%- case block.type -%}{%- when 'eyebrow' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | json }},"letter_spacing":{{ block.settings.letter_spacing | json }}}{%- endcapture -%}{%- when 'heading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"tag":{{ block.settings.tag | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | json }},"size_mobile":{{ block.settings.size_mobile | json }}}{%- endcapture -%}{%- when 'subheading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | json }},"max_width":{{ block.settings.max_width | json }}}{%- endcapture -%}{%- when 'product' -%}{%- capture pd_b -%}{"custom_title":{{ block.settings.custom_title | json }},"fallback_price":{{ block.settings.fallback_price | json }}}{%- endcapture -%}{%- endcase -%}{%- comment -%}/pd-gen{%- endcomment -%}
        {%- capture c -%}{% render 'scheme-color', color: bs.color, fallback: 'none' %}{%- endcapture -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="pstl__eyebrow" data-pd-block="{{ block.id }}" data-pd-type="eyebrow" data-pd-settings="{{ pd_b | escape }}" style="{% if bs.enable_custom_style and c != 'none' %}--pd-c: {{ c }}; {% endif %}--pd-fs: {{ bs.size | default: 12 }}px; --pd-ls: {{ bs.letter_spacing | default: 0 }}em;"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</p>
          {%- when 'heading' -%}
            <h2 class="pstl__heading" data-pd-block="{{ block.id }}" data-pd-type="heading" data-pd-settings="{{ pd_b | escape }}" style="{% if bs.enable_custom_style and c != 'none' %}--pd-c: {{ c }}; {% endif %}--pd-fs-m: {{ bs.size_mobile | default: 28 }}px; --pd-fs-d: {{ bs.size_desktop | default: 40 }}px;"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
          {%- when 'subheading' -%}
            <div class="pstl__sub" data-pd-block="{{ block.id }}" data-pd-type="subheading" data-pd-settings="{{ pd_b | escape }}" style="{% if bs.enable_custom_style and c != 'none' %}--pd-c: {{ c }}; {% endif %}--pd-fs: {{ bs.size | default: 15 }}px; --pd-mw: {{ bs.max_width | default: 560 }}px;"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
      {%- if product_blocks.size > 0 -%}
        <div class="pstl__products">
          {%- for block in product_blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            {%- if card_style == 'theme' -%}
              <div class="pstl__theme-card" data-pd-block="{{ block.id }}" data-pd-type="product" {{ block.shopify_attributes }}>
                {%- render 'product-item', card_product: p, section_id: sid, class: 'pstl__product-item', template_enable_action: true, template_enable_product_vendor: true, template_enable_rate: true, template_enable_price: true, template_enable_add_cart: true, template_enable_product_badges: true, template_enable_color_swatches: true, scroll_animation: 'none', indexFor: forloop.index -%}
              </div>
            {%- elsif p != blank -%}
              {%- assign title = block.settings.custom_title | default: p.title -%}
              <a href="{{ p.url }}" class="pstl__card" data-pd-block="{{ block.id }}" data-pd-type="product" {{ block.shopify_attributes }}>
                <div class="pstl__card-image">
                  {%- if p.featured_image -%}
                    {{ p.featured_image | image_url: width: 320 | image_tag: loading: 'lazy', decoding: 'async', alt: p.featured_image.alt | default: p.title, widths: '120, 240, 320' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="pstl__card-info">
                  <p class="pstl__card-vendor"{% if s.show_vendor == false or p.vendor == blank %} hidden{% endif %}>{{ p.vendor | escape }}</p>
                  <p class="pstl__card-title">{{ title | escape }}</p>
                  <p class="pstl__card-price"{% unless s.show_price %} hidden{% endunless %}>
                    {%- if p.compare_at_price > p.price -%}<del><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ p.compare_at_price | money }}</del>{%- endif -%}
                    <span>{{ p.price | money }}</span>
                    {%- unless p.available -%}<span class="pstl__card-soldout">{{ sold_out_label }}</span>{%- endunless -%}
                  </p>
                </div>
                <span class="pstl__card-cta" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
              </a>
            {%- else -%}
              <div class="pstl__card pstl__card--empty" data-pd-block="{{ block.id }}" data-pd-type="product" {{ block.shopify_attributes }}>
                <div class="pstl__card-image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="pstl__card-info">
                  <p class="pstl__card-vendor" hidden></p>
                  <p class="pstl__card-title">{{ 'accessibility.product_title' | t }}</p>
                  <p class="pstl__card-price"{% unless s.show_price %} hidden{% endunless %}><span>Choose a product</span></p>
                </div>
                <span class="pstl__card-cta" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
</template>

