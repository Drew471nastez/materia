            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Kicker size",
            "default": 14
          },
          {
            "type": "select",
            "id": "subheading_font_weight",
            "label": "Kicker weight",
            "default": "500",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "description_size",
            "min": 12,
            "max": 28,
            "step": 1,
            "unit": "px",
            "label": "Description size",
            "default": 16
          },
          {
            "type": "select",
            "id": "description_font_weight",
            "label": "Description weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "select",
            "id": "button_font_weight",
            "label": "Button weight",
            "default": "500",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ],
            "visible_if": "{{ section.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
