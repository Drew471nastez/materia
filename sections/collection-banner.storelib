<template compat="shopify">
{%- comment -%} Runtime, loaded once per page by layout/theme.storelib: shopify/assets/live-collections.js. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes. Collection Banner: a mosaic of collection banners, each a
  picture with a kicker, a title, a short description and a button. A banner
  with a collection picked takes its title, picture and link from it; its own
  fields replace them. Colours follow the colour scheme and the button Theme
  settings > Buttons until the custom switches are on. Live builder updates
  are in live-collections.js (loaded on every page).
{%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; }
  }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if st.enable_custom_fonts -%}
    {{ st.heading_font | font_face: font_display: 'swap' }}
    {{ st.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .cbn { font-family: var(--body-font, inherit); background: var(--cl-section_bg); color: var(--color-text); }
  #shopify-section-{{ sid }} .cbn, #shopify-section-{{ sid }} .cbn *, #shopify-section-{{ sid }} .cbn *::before, #shopify-section-{{ sid }} .cbn *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cbn__wrap { margin-inline: auto; }
  #shopify-section-{{ sid }} .cbn[data-width='container'] .cbn__wrap { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .cbn[data-width='fluid_container'] .cbn__wrap { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .cbn[data-width='stretch_width'] .cbn__wrap { padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cbn__list {
    display: grid; grid: auto-flow dense 200px / repeat(1, minmax(0, 1fr)); gap: var(--cl-items_gap);
    width: var(--cl-inner_width_mobile); max-width: var(--cl-section_max_width); margin: 0 auto; list-style: none;
    padding: var(--cl-padding_top_mobile) var(--cl-horizontal_padding_mobile) var(--cl-padding_bottom_mobile);
  }
  #shopify-section-{{ sid }} .cbn__card { position: relative; grid-row: span min(2, var(--clb-card_height)); margin: 0; border-radius: var(--cl-card_border_radius); overflow: hidden; isolation: isolate; color: var(--clb-text_color); background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); }
  #shopify-section-{{ sid }} .cbn__media { position: absolute; inset: 0; }
  #shopify-section-{{ sid }} .cbn__media :is(img, svg) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  #shopify-section-{{ sid }} .cbn__media svg { fill: color-mix(in srgb, var(--color-text) 25%, transparent); }
  #shopify-section-{{ sid }} .cbn__card:hover .cbn__media :is(img, svg) { transform: scale(1.04); }
  #shopify-section-{{ sid }} .cbn__media::after { content: ''; position: absolute; inset: 0; background: var(--clb-overlay_color); opacity: var(--clb-overlay_opacity); pointer-events: none; }
  #shopify-section-{{ sid }} .cbn__info {
    position: absolute; z-index: 2; display: flex; flex-direction: column; gap: var(--clb-vertical_text_gap);
    padding: 20px; max-width: 100%; pointer-events: none;
  }
  #shopify-section-{{ sid }} .cbn__info > * { margin: 0; }
  #shopify-section-{{ sid }} .cbn__info[data-p^='top'] { top: 0; } #shopify-section-{{ sid }} .cbn__info[data-p^='center'] { top: 50%; transform: translateY(-50%); } #shopify-section-{{ sid }} .cbn__info[data-p^='bottom'] { bottom: 0; }
  #shopify-section-{{ sid }} .cbn__info[data-p$='left'] { left: 0; text-align: left; align-items: flex-start; }
  #shopify-section-{{ sid }} .cbn__info[data-p$='center'] { left: 0; right: 0; text-align: center; align-items: center; }
  #shopify-section-{{ sid }} .cbn__info[data-p$='right'] { right: 0; text-align: right; align-items: flex-end; }
  #shopify-section-{{ sid }} .cbn__kicker { font-size: var(--clb-subheading_size); font-weight: var(--clb-subheading_font_weight); color: inherit; }
  #shopify-section-{{ sid }} .cbn__title { font-family: var(--heading-font, inherit); font-size: calc(var(--clb-heading_size) * .75); font-weight: var(--clb-heading_font_weight); color: inherit; line-height: 1.2; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .cbn__title a { color: inherit; text-decoration: none; pointer-events: auto; }
  #shopify-section-{{ sid }} .cbn__title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  #shopify-section-{{ sid }} .cbn__title a:focus-visible { outline: none; }
  #shopify-section-{{ sid }} .cbn__card:has(.cbn__title a:focus-visible) { outline: 2px solid var(--clb-text_color); outline-offset: -4px; }
  #shopify-section-{{ sid }} .cbn__desc { max-width: 400px; font-size: calc(var(--clb-description_size) * .88); font-weight: var(--clb-description_font_weight); color: inherit; }
  #shopify-section-{{ sid }} .cbn__btn { position: relative; z-index: 3; pointer-events: auto; width: fit-content; cursor: pointer; }
  #shopify-section-{{ sid }} .cbn__btn[data-style='link'] { appearance: none; background: none; border: 0; padding: 0; font-family: inherit; font-size: 14px; display: inline-flex; align-items: center; min-height: 44px; color: var(--clb-primary_text_color); font-weight: var(--cl-link-weight, var(--btn-font-weight, 500)); text-decoration: underline; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .cbn__btn[data-own-shape] { font-size: var(--mb-font-size); padding: var(--mb-padding-y) var(--mb-padding-x); border-radius: var(--mb-radius); }
  #shopify-section-{{ sid }} [hidden]:is(.cbn__kicker, .cbn__title, .cbn__desc, .cbn__btn) { display: none !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cbn__list { grid: auto-flow dense 290px / repeat(2, minmax(0, 1fr)); width: var(--cl-inner_width); padding: var(--cl-padding_top_desktop) var(--cl-horizontal_padding_desktop) var(--cl-padding_bottom_desktop); }
    #shopify-section-{{ sid }} .cbn__card { grid-row: span var(--clb-card_height); }
    #shopify-section-{{ sid }} .cbn__info { padding: 32px; }
    #shopify-section-{{ sid }} .cbn__title { font-size: var(--clb-heading_size); }
    #shopify-section-{{ sid }} .cbn__desc { font-size: var(--clb-description_size); }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .cbn__info[data-pm^='top'] { top: 0; bottom: auto; transform: none; } #shopify-section-{{ sid }} .cbn__info[data-pm^='center'] { top: 50%; bottom: auto; transform: translateY(-50%); } #shopify-section-{{ sid }} .cbn__info[data-pm^='bottom'] { top: auto; bottom: 0; transform: none; }
    #shopify-section-{{ sid }} .cbn__info[data-pm$='left'] { left: 0; right: auto; text-align: left; align-items: flex-start; }
    #shopify-section-{{ sid }} .cbn__info[data-pm$='center'] { left: 0; right: 0; text-align: center; align-items: center; }
    #shopify-section-{{ sid }} .cbn__info[data-pm$='right'] { left: auto; right: 0; text-align: right; align-items: flex-end; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .cbn__media :is(img, svg) { transition: none; }
    #shopify-section-{{ sid }} .cbn__card:hover .cbn__media :is(img, svg) { transform: none; }
  }
{% comment %}{% endcomment %}</style>

<section class="cbn color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}" data-width="{{ st.section_width | default: 'full_width' }}" aria-label="{{ 'accessibility.collection_banners' | t | escape }}" {% capture cl_json %}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"desktop_content_position":{{ section.settings.desktop_content_position | append: '' | json }},"items_gap":{{ section.settings.items_gap | default: 0 | json }},"inner_width":{{ section.settings.inner_width | default: 0 | json }},"section_max_width":{{ section.settings.section_max_width | append: '' | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"card_border_radius":{{ section.settings.card_border_radius | default: 0 | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"use_theme_button":{% if section.settings.use_theme_button %}true{% else %}false{% endif %},"buttons_corner":{{ section.settings.buttons_corner | default: 0 | json }},"reveal":{% if section.settings.reveal %}true{% else %}false{% endif %},"padding_top_desktop":{{ section.settings.padding_top_desktop | default: 0 | json }},"padding_bottom_desktop":{{ section.settings.padding_bottom_desktop | default: 0 | json }},"horizontal_padding_desktop":{{ section.settings.horizontal_padding_desktop | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"mobile_content_position":{{ section.settings.mobile_content_position | append: '' | json }},"inner_width_mobile":{{ section.settings.inner_width_mobile | default: 0 | json }},"padding_top_mobile":{{ section.settings.padding_top_mobile | default: 0 | json }},"padding_bottom_mobile":{{ section.settings.padding_bottom_mobile | default: 0 | json }},"horizontal_padding_mobile":{{ section.settings.horizontal_padding_mobile | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-items_gap: {{ section.settings.items_gap | default: 0 }}px;--cl-padding_top_desktop: {{ section.settings.padding_top_desktop | default: 0 }}px;--cl-padding_bottom_desktop: {{ section.settings.padding_bottom_desktop | default: 0 }}px;--cl-padding_top_mobile: {{ section.settings.padding_top_mobile | default: 0 }}px;--cl-padding_bottom_mobile: {{ section.settings.padding_bottom_mobile | default: 0 }}px;--cl-horizontal_padding_desktop: {{ section.settings.horizontal_padding_desktop | default: 0 }}px;--cl-horizontal_padding_mobile: {{ section.settings.horizontal_padding_mobile | default: 0 }}px;--cl-inner_width: {{ section.settings.inner_width | default: 0 }}%;--cl-inner_width_mobile: {{ section.settings.inner_width_mobile | default: 0 }}%;--cl-card_border_radius: {{ section.settings.card_border_radius | default: 0 }}px;--cl-section_max_width: {% if section.settings.section_max_width == blank %}none{% else %}{{ section.settings.section_max_width }}px{% endif %};{% if section.settings.enable_custom_style %}--cl-section_bg: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};{% else %}--cl-section_bg: var(--color-background);{% endif %}{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="collection-banner" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","reset_spacing":true,"desktop_content_position":"bottom-center","items_gap":20,"inner_width":85,"enable_custom_style":false,"card_border_radius":0,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","use_theme_button":true,"buttons_corner":4,"reveal":true,"padding_top_desktop":40,"padding_bottom_desktop":40,"horizontal_padding_desktop":32,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"mobile_content_position":"center-center","inner_width_mobile":100,"padding_top_mobile":20,"padding_bottom_mobile":20,"horizontal_padding_mobile":10,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-cl-block-defaults='{"collection":{"card_height":"1","vertical_text_gap":16,"enable_custom_style":false,"overlay_opacity":20,"primary_button_style":"link","heading_size":32,"heading_font_weight":"theme","subheading_size":14,"subheading_font_weight":"500","description_size":16,"description_font_weight":"theme","button_font_weight":"500"}}' style="{{ cl_vars | strip }}" data-pos="{{ section.settings.desktop_content_position }}" data-pos-m="{{ section.settings.mobile_content_position }}"{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  <div class="cbn__wrap">
    <ul class="cbn__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign coll = bs.collection
          assign heading = bs.heading | default: coll.title
          assign href = bs.primary_button_link | default: coll.url
          assign img = bs.image_desktop | default: coll.featured_image
          assign img_m = bs.image_mobile
          assign style = bs.primary_button_style | default: 'link'
          assign shape = false
          if st.use_theme_button == false and style != 'link'
            assign shape = true
          endif
        -%}
        {%- if request.design_mode or coll != blank or bs.heading != blank or img != blank -%}
        <li class="cbn__card" {% capture clb_json %}{"collection":{{ block.settings.collection.handle | append: '' | json }},"subheading":{{ block.settings.subheading | append: '' | json }},"heading":{{ block.settings.heading | append: '' | json }},"description":{{ block.settings.description | append: '' | json }},"primary_button_label":{{ block.settings.primary_button_label | append: '' | json }},"primary_button_link":{{ block.settings.primary_button_link | append: '' | json }},"image_desktop":{% if block.settings.image_desktop != blank %}{"src":{{ block.settings.image_desktop | image_url: width: 1600 | json }},"width":{{ block.settings.image_desktop.width | default: 0 | json }},"height":{{ block.settings.image_desktop.height | default: 0 | json }},"alt":{{ block.settings.image_desktop.alt | append: '' | json }}}{% else %}null{% endif %},"image_mobile":{% if block.settings.image_mobile != blank %}{"src":{{ block.settings.image_mobile | image_url: width: 1600 | json }},"width":{{ block.settings.image_mobile.width | default: 0 | json }},"height":{{ block.settings.image_mobile.height | default: 0 | json }},"alt":{{ block.settings.image_mobile.alt | append: '' | json }}}{% else %}null{% endif %},"card_height":{{ block.settings.card_height | append: '' | json }},"vertical_text_gap":{{ block.settings.vertical_text_gap | default: 0 | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"text_color":{{ block.settings.text_color | append: '' | json }},"overlay_color":{{ block.settings.overlay_color | append: '' | json }},"overlay_opacity":{{ block.settings.overlay_opacity | default: 0 | json }},"primary_button_style":{{ block.settings.primary_button_style | append: '' | json }},"primary_text_color":{{ block.settings.primary_text_color | append: '' | json }},"primary_background_color":{{ block.settings.primary_background_color | append: '' | json }},"primary_border_color":{{ block.settings.primary_border_color | append: '' | json }},"heading_size":{{ block.settings.heading_size | default: 0 | json }},"heading_font_weight":{{ block.settings.heading_font_weight | append: '' | json }},"subheading_size":{{ block.settings.subheading_size | default: 0 | json }},"subheading_font_weight":{{ block.settings.subheading_font_weight | append: '' | json }},"description_size":{{ block.settings.description_size | default: 0 | json }},"description_font_weight":{{ block.settings.description_font_weight | append: '' | json }},"button_font_weight":{{ block.settings.button_font_weight | append: '' | json }}}{% endcapture %}{% capture clb_vars %}--clb-card_height: {{ block.settings.card_height | default: 0 }};--clb-vertical_text_gap: {{ block.settings.vertical_text_gap | default: 0 }}px;--clb-heading_size: {{ block.settings.heading_size | default: 0 }}px;--clb-subheading_size: {{ block.settings.subheading_size | default: 0 }}px;--clb-description_size: {{ block.settings.description_size | default: 0 }}px;--clb-heading_font_weight: {% if block.settings.heading_font_weight == blank or block.settings.heading_font_weight == 'theme' %}var(--heading-weight, 600){% else %}{{ block.settings.heading_font_weight }}{% endif %};--clb-subheading_font_weight: {{ block.settings.subheading_font_weight }};--clb-description_font_weight: {% if block.settings.description_font_weight == blank or block.settings.description_font_weight == 'theme' %}var(--body-weight, 400){% else %}{{ block.settings.description_font_weight }}{% endif %};--clb-overlay_opacity: {{ block.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};{% if block.settings.enable_custom_style %}--clb-text_color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--color-heading)' %};{% else %}--clb-text_color: var(--color-heading);{% endif %}{% if block.settings.enable_custom_style %}--clb-overlay_color: {% render 'scheme-color', color: block.settings.overlay_color, fallback: 'transparent' %};{% else %}--clb-overlay_color: transparent;{% endif %}{% if block.settings.enable_custom_style %}--clb-primary_text_color: {% render 'scheme-color', color: block.settings.primary_text_color, fallback: 'var(--color-heading)' %};{% else %}--clb-primary_text_color: var(--color-heading);{% endif %}{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="collection" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-coll-title="{{ coll.title | escape }}" data-cl-coll-url="{{ coll.url }}" {{ block.shopify_attributes }}>
          <div class="cbn__media">
            {%- if img != blank -%}
              <picture>
                {%- if img_m != blank -%}<source media="(max-width: 767px)" srcset="{{ img_m | image_url: width: 900 }}">{%- endif -%}
                <img class="cbn__img" src="{{ img | image_url: width: 1600 }}" alt="{{ heading | escape }}" loading="lazy" width="{{ img.width }}" height="{{ img.height }}">
              </picture>
            {%- elsif request.design_mode -%}
              {{ 'collection-1' | placeholder_svg_tag: 'cbn__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
            {%- endif -%}
          </div>
          <div class="cbn__info" data-p="{{ st.desktop_content_position }}" data-pm="{{ st.mobile_content_position }}">
            <p class="cbn__kicker"{% if bs.subheading == blank %} hidden{% endif %}>{{ bs.subheading | escape }}</p>
            <h2 class="cbn__title"{% if bs.heading_font_weight != blank and bs.heading_font_weight != 'theme' %} data-own-weight{% endif %}{% if heading == blank %} hidden{% endif %}>
              {%- if href != blank -%}<a href="{{ href }}">{{ heading | escape }}</a>{%- else -%}<span>{{ heading | escape }}</span>{%- endif -%}
            </h2>
            <p class="cbn__desc"{% if bs.description == blank %} hidden{% endif %}>{{ bs.description | strip_html | truncatewords: 12 }}</p>
            {%- capture btn_style -%}{% if bs.enable_custom_style and style != 'link' %}{% render 'button-overrides', bg: bs.primary_background_color, text: bs.primary_text_color, border: bs.primary_border_color %}{% endif %}{% if shape %}--mb-radius: {{ st.buttons_corner | default: 0 }}px;--mb-padding-y: 16px;--mb-padding-x: 20px;--mb-font-size: 14px;--mb-weight: {{ bs.button_font_weight | default: 500 }};{% endif %}{% if style == 'link' and st.use_theme_button == false %}--cl-link-weight: {{ bs.button_font_weight | default: 500 }};{% endif %}{%- endcapture -%}
            {%- capture btn_attrs -%}class="cbn__btn" data-style="{{ style }}"{% if style != 'link' %} data-theme-button="primary" data-sl-button data-button-appearance="{% if style == 'outline' %}outline{% else %}solid{% endif %}"{% endif %}{% if shape %} data-own-shape data-own-weight{% endif %} style="{{ btn_style | strip }}"{% if bs.primary_button_label == blank %} hidden{% endif %}{%- endcapture -%}
            {%- if href != blank -%}
              <a href="{{ href }}" {{ btn_attrs }}>{{ bs.primary_button_label | escape }}</a>
            {%- else -%}
              <button type="button" {{ btn_attrs }}>{{ bs.primary_button_label | escape }}</button>
            {%- endif -%}
          </div>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
</template>

<schema>
{
  "type": "collection-banner",
  "name": "Collection Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Text position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center-center",
          "label": "Center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom-center"
    },
    {
      "type": "range",
      "id": "items_gap",
      "min": 0,
