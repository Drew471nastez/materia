<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
  assign __theme_section_st = section.settings
  assign __theme_section_width = __theme_section_st.section_width | default: 'full_width'
  assign __theme_color_scheme = color_scheme
  assign __theme_reset_spacing = ''
  if __theme_section_st.reset_spacing
    assign __theme_reset_spacing = ' remove_spacing'
  endif
  assign __theme_scroll_animation = settings.scroll_animation | default: 'none'
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<div
  class="section color-{{ __theme_color_scheme }} gradient{{ __theme_reset_spacing }}{% if __theme_scroll_animation != 'none' %} scroll-trigger {{ __theme_scroll_animation }}{% endif %}"
  {% if __theme_scroll_animation != 'none' %}data-cascade{% endif %}
>
  <div class="{{ __theme_section_width }}">
{% style %}
:root {
--loudibs-neutral-70: #5e5e5e;
--loudibs-neutral-01: #fff;
--loudibs-size-1: 1px;
--loudibs-size-2: 2px;
--loudibs-size-4: 4px;
--loudibs-size-14: 14px;
--loudibs-size-16: 16px;
--loudibs-size-20: 20px;
--loudibs-size-24: 24px;
--loudibs-size-32: 32px;
--loudibs-size-40: 40px;
--loudibs-font-weight-400: 400;
--loudibs-font-weight-600: 600;
--loudibs-line-height-140: 1.4;
--loudibs-text-decoration-none: none;
--loudibs-border-width-1: var(--loudibs-size-1);
--loudibs-border-width-2: var(--loudibs-size-2);
--loudibs-color-bg-fill-inverse-on-light: var(--loudibs-neutral-01);
--loudibs-color-text-disable-on-light: var(--loudibs-neutral-70);
--loudibs-space-4: var(--loudibs-size-4);
--loudibs-space-16: var(--loudibs-size-16);
--loudibs-space-20: var(--loudibs-size-20);
--loudibs-space-24: var(--loudibs-size-24);
--loudibs-space-32: var(--loudibs-size-32);
--loudibs-space-40: var(--loudibs-size-40);
--loudibs-font-size-14: var(--loudibs-size-14);
}


{% endstyle %}



<section class="Loudibs-{{ section.id | handle }}" aria-label="{{ 'accessibility.collection_banners' | t }}">
	<div class="LoudibsCollListContainer">
		<ul class="LoudibsCollList">
			{%- for block in section.blocks -%}
				{%- liquid
					assign collection_image = block.settings.collection.featured_image
					assign desktop_image = block.settings.image_desktop
					assign mobile_image = block.settings.image_mobile
					assign heading = block.settings.collection.title
					assign card_width = block.settings.card_width | default: 2

					if mobile_image == blank and desktop_image != blank
						assign mobile_image = block.settings.image_desktop
					endif
					if mobile_image == blank
						assign mobile_image = block.settings.collection.featured_image
					endif
					if desktop_image != blank
						assign collection_image = desktop_image
					endif
					if block.settings.heading != blank
						assign heading = block.settings.heading
					endif
					case block.settings.primary_button_style
						when 'solid'
							assign btn_text_fallback = 'var(--btn-primary-color)'
						when 'outline'
							assign btn_text_fallback = 'var(--btn-secondary-color)'
						else
							assign btn_text_fallback = 'var(--color-heading)'
					endcase
					assign heading_weight = block.settings.heading_font_weight | default: 'theme'
					if heading_weight == 'theme'
						assign heading_weight = 'var(--heading-weight, 600)'
					endif
					assign description_weight = block.settings.description_font_weight | default: 'theme'
					if description_weight == 'theme'
						assign description_weight = 'var(--body-weight, 400)'
					endif
					assign button_weight = block.settings.button_font_weight | default: 500
					if section.settings.use_theme_button
						assign button_weight = 'var(--btn-font-weight, 500)'
					endif
				-%}
				{%- capture block_css_variables -%}
					--block-banner-width: {{- card_width -}};
					--block-banner-height: {{- block.settings.card_height -}};

					--block-subheading-size: {{- block.settings.subheading_size -}}px;
					--block-heading-size: {{- block.settings.heading_size -}}px;
					--block-description-size: {{- block.settings.description_size -}}px;
					--block-text-color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--color-heading)' %} !important;
					--block-vertical-gap: {{- block.settings.vertical_text_gap -}}px;

					--block-primary-button-text-color: {% render 'scheme-color', color: block.settings.primary_text_color, fallback: btn_text_fallback %} !important;
					--block-primary-button-background-color: {% render 'scheme-color', color: block.settings.primary_background_color, fallback: 'var(--btn-primary-bg-color)' %} !important;
					--block-primary-button-border-color: {% render 'scheme-color', color: block.settings.primary_border_color, fallback: 'var(--btn-secondary-border-color)' %} !important;

					--block-overlay-color: {% render 'scheme-color', color: block.settings.overlay_color, fallback: 'transparent' %} !important;
					--block-overlay-opacity: {{- block.settings.overlay_opacity -}}%;
      			{%- endcapture -%}
				<li
					style="{{- block_css_variables | strip_newlines -}}"
					class="LoudibsCollListCard"
					{{ block.shopify_attributes }}
				>
					<div class="LoudibsCollListCard__Wrapper">
						<a
							href="{%- if block.settings.primary_button_link != blank -%}{{ block.settings.primary_button_link }}{% else %}{{- block.settings.collection.url -}}{%- endif -%}"
							class="
								LoudibsCollListCard__Media
								{% if block.settings.primary_button_link == blank and block.settings.collection == blank %}
								 	LoudibsCollListCard__Media--inactiveLink
								{% endif %}
							"
							aria-label="Collection banner for {{- heading | escape -}}"
						>
							{%- if collection_image -%}
								{{-
									collection_image
									| image_url: width: collection_image.width
									| image_tag:
										sizes: "100vw",
										widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
										fetchpriority: "low",
										loading: "lazy",
										class: "LoudibsCollListCard__Image LoudibsCollListCard__Image--media-desktop"
								-}}
							{%- else -%}
								<img
									src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
									alt="{{ 'accessibility.collection_banner_image' | t }}"
									width="580"
									height="580"
									loading="lazy"
									sizes="100vw"
									fetchpriority="low"
									class="LoudibsCollListCard__Image LoudibsCollListCard__Image--media-desktop"
								>
							{%- endif -%}
							{%- if mobile_image -%}
								{{-
									mobile_image
									| image_url: width: mobile_image.width
									| image_tag:
										sizes: "100vw",
										widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
										fetchpriority: "low",
										loading: "lazy",
										class: "LoudibsCollListCard__Image LoudibsCollListCard__Image--media-mobile"
								-}}
							{%- else -%}
								<img
									src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
									alt="{{ 'accessibility.collection_banner_image' | t }}"
									width="580"
									height="580"
									loading="lazy"
									sizes="100vw"
									fetchpriority="low"
									class="LoudibsCollListCard__Image LoudibsCollListCard__Image--media-mobile"
								>
							{%- endif -%}
						</a>
						<div class="LoudibsCollListCard__Content">
							<div class="LoudibsCollListCard__Information LoudibsCollListCard__Information--desktop-position--{{ section.settings.desktop_content_position }} LoudibsCollListCard__Information--mobile-position--{{ section.settings.mobile_content_position }}">
								{%- if block.settings.subheading != blank -%}
									<p class="LoudibsCollListCard__Caption" style="font-weight: {{ block.settings.subheading_font_weight | default: 500 }};">
										{{- block.settings.subheading -}}
									</p>
								{%- endif -%}
								{%- if heading -%}
									<h2>
										<a
											class="LoudibsCollListCard__Heading"
											style="font-weight: {{ heading_weight }};"
											href="{{- block.settings.collection.url -}}"
											{% if block.settings.collection == blank %}
												aria-disabled="true"
												tabindex="-1"
											{% endif %}
										>
											{{- heading | escape -}}
										</a>
									</h2>
								{%- else -%}
									<h2>
										<span class="LoudibsCollListCard__Heading" aria-label="{{ 'accessibility.collection_title' | t }}" style="font-weight: {{ heading_weight }};"> {{ 'accessibility.featured_collection' | t }} </span>
									</h2>
								{%- endif -%}
								{%- if block.settings.description != blank -%}
									<p class="LoudibsCollListCard__Description" style="font-weight: {{ description_weight }};">
										{{- block.settings.description | strip_html | truncatewords: 12 -}}
									</p>
								{%- endif -%}
								{%- if block.settings.primary_button_label != blank -%}
									<a
										{% if block.settings.primary_new_tab == true %}
											target="_blank"
											rel="noopener noreferrer"
										{% endif %}
										href="{%- if block.settings.primary_button_link != blank -%} {{ block.settings.primary_button_link }} {% else %} {{- block.settings.collection.url -}} {%- endif -%}"
										{%- if block.settings.primary_button_style == 'link' %}
										style="font-weight: {{ button_weight }};"
										{%- else -%}
										{%- liquid
											assign custom_btn = true
											if section.settings.use_theme_button
												assign custom_btn = false
											endif
										-%}
										data-theme-button="primary"
										data-button-local-appearance="{{ block.settings.primary_button_style }}"
										style="{%- render 'button-overrides', bg: block.settings.primary_background_color, text: block.settings.primary_text_color, border: block.settings.primary_border_color, custom: custom_btn, radius: section.settings.buttons_corner, padding_y: 16, padding_x: 20, font_size: 14, weight: block.settings.button_font_weight -%}"
										{%- endif %}
										class="
											LoudibsCollListCard__Button LoudibsCollListCard__Button--{{ block.settings.primary_button_style }}
											{% if block.settings.primary_button_link == blank and block.settings.collection == blank %}
											  LoudibsCollListCard__Button--inactiveLink
											{% endif %}
										"
									>
										{{- block.settings.primary_button_label | escape -}}
									</a>
								{%- endif -%}
							</div>
						</div>
					</div>
				</li>
			{%- endfor -%}
		</ul>
	</div>
</section>

  </div>
</div>
<!-- materia-theme-wrapper:end -->


{% style %}
	.Loudibs-{{ section.id | handle }} {
		--section-vertical-margin: 0px;
		--section-vertical-margin-mobile: 0px;
		--section-banners-space: {{- section.settings.items_gap -}}px;
		--section-background-color: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %} !important;
		--section-padding-top: {{- section.settings.padding_top_desktop | default: 40 -}}px;
		--section-padding-bottom: {{- section.settings.padding_bottom_desktop | default: 40 -}}px;
		--section-padding-top-mobile: {{- section.settings.padding_top_mobile | default: 20 -}}px;
		--section-padding-bottom-mobile: {{- section.settings.padding_bottom_mobile | default: 20 -}}px;
		--section-horizontal-padding-mobile: {{- section.settings.horizontal_padding_mobile -}}px;
		--section-horizontal-padding-desktop: {{- section.settings.horizontal_padding_desktop -}}px;
		--section-max-width: {{- section.settings.section_max_width -}}px;
		--section-width: {{- section.settings.inner_width_mobile | default: 100 -}}%;
		--section-buttons-corner-radius: {{- section.settings.buttons_corner -}}px;
		--section-card-border-radius: {{- section.settings.card_border_radius -}}px;
	}
	{%- if section.settings.use_theme_button -%}
	.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button:is(.LoudibsCollListCard__Button--solid, .LoudibsCollListCard__Button--outline) {
		border-radius: var(--btn-radius, 4px) !important;
		padding: var(--btn-padding-y, 16px) var(--btn-padding-x, 20px) !important;
		font-size: var(--btn-font-size, 14px) !important;
	}
	.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button--outline {
		border-width: var(--btn-border-width, 1px) !important;
	}
	.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button--solid {
		border: var(--btn-border-width, 0px) solid var(--block-primary-button-background-color);
	}
	{%- endif -%}
	@media (min-width: 768px) {
	  .Loudibs-{{ section.id | handle }} {
		--section-width: {{- section.settings.inner_width | default: 85 -}}%;
	  }
	}

	

.Loudibs-{{ section.id | handle }} .LoudibsCollListContainer{margin:var(--section-vertical-margin-mobile) 0;background-color:var(--section-background-color)}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListContainer{margin:var(--section-vertical-margin) 0}}.Loudibs-{{ section.id | handle }} .LoudibsCollList{padding:var(--section-padding-top-mobile) var(--section-horizontal-padding-mobile) var(--section-padding-bottom-mobile);display:grid;grid:auto-flow dense 200px/repeat(1, minmax(0, 1fr));max-width:var(--section-max-width);gap:var(--section-banners-space);width:var(--section-width);margin:0 auto;list-style-type:none}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollList{padding:var(--section-padding-top) var(--section-horizontal-padding-desktop) var(--section-padding-bottom);display:grid;grid:auto-flow dense 290px/repeat(4, minmax(0, 1fr));max-width:var(--section-max-width);gap:var(--section-banners-space);width:var(--section-width);margin:0 auto}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard{grid-area:span min(2, var(--block-banner-height))/span min(1,var(--block-banner-width))}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard{grid-area:span var(--block-banner-height)/span var(--block-banner-width)}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Wrapper{height:100%;position:relative;border-radius:var(--section-card-border-radius);overflow:hidden}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Media{overflow:hidden;height:100%;display:block}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Media img{width:100%;height:100%;object-fit:cover}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Media::before{position:absolute;top:0;left:0;display:block;width:100%;height:100%;content:"";z-index:2;background-color:var(--block-overlay-color);opacity:var(--block-overlay-opacity)}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Media--inactiveLink{cursor:default;pointer-events:none}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Image--media-desktop{display:none}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Image--media-mobile{display:block}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Image--media-desktop{display:block}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Image--media-mobile{display:none}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information{position:absolute;color:var(--block-text-color);width:100%;z-index:2;pointer-events:none;height:fit-content;display:flex;flex-direction:column;padding:var(--loudibs-space-20)}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information h2,.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information p{margin:0}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--top-left{top:0;left:0;text-align:left;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--top-center{top:0;left:50%;transform:translate(-50%, 0);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--top-right{top:0;right:0;text-align:right;align-items:flex-end}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--center-left{top:50%;left:0;transform:translate(0, -50%);text-align:left;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--center-center{top:50%;left:50%;transform:translate(-50%, -50%);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--center-right{top:50%;right:0;transform:translate(0, -50%);text-align:right;align-items:flex-end}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--bottom-left{bottom:0;left:0;text-align:left;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--bottom-center{top:unset;bottom:0;left:50%;transform:translate(-50%, 0);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--mobile-position--bottom-right{bottom:0;right:0;text-align:right;align-items:flex-end}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information{padding:var(--loudibs-space-32)}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--top-left{top:0;left:0;text-align:left;transform:unset;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--top-center{top:0;left:50%;transform:translate(-50%, 0);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--top-right{top:0;right:0;left:0;text-align:right;transform:unset;align-items:flex-end}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--center-left{top:50%;left:0;transform:translate(0, -50%);text-align:left;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--center-center{top:50%;left:50%;transform:translate(-50%, -50%);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--center-right{top:50%;right:0;left:unset;transform:translate(0, -50%);text-align:right;align-items:flex-end}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--bottom-left{bottom:0;left:0;text-align:left;top:unset;transform:unset;align-items:flex-start}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--bottom-center{top:unset;bottom:0;left:50%;transform:translate(-50%, 0);text-align:center;align-items:center}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Information--desktop-position--bottom-right{bottom:0;right:0;top:unset;left:unset;transform:unset;text-align:right;align-items:flex-end}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Caption{margin:0;font-size:var(--block-subheading-size);font-weight:var(--loudibs-font-weight-600);margin-bottom:var(--block-vertical-gap)}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Caption{font-size:var(--block-subheading-size)}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Heading{padding-bottom:var(--block-vertical-gap);pointer-events:auto;margin:0;font-size:calc(var(--block-heading-size)*.75);text-decoration:none;color:var(--block-text-color);display:block;width:100%;font-weight:var(--loudibs-font-weight-600);pointer-events:auto}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Heading{font-size:var(--block-heading-size)}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Description{max-width:400px;padding-bottom:var(--block-vertical-gap);font-size:calc(var(--block-description-size)*.88)}@media(min-width: 992px){.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Description{font-size:var(--block-description-size)}}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button{display:inline-flex;justify-content:center;align-items:center;cursor:pointer;font:inherit;font-size:var(--loudibs-font-size-14);text-decoration:var(--loudibs-text-decoration-none);-webkit-appearance:none;appearance:none;width:fit-content;padding:var(--loudibs-space-16) var(--loudibs-space-20);transition:all .3s ease-in;line-height:1}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button:hover{filter:brightness(0.9)}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button--solid{color:var(--block-primary-button-text-color);background:var(--block-primary-button-background-color);border-radius:var(--section-buttons-corner-radius)}.Loudibs-{{ section.id | handle }} .LoudibsCollListCard__Button--ou