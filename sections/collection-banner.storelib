<schema>
{
  "type": "collection-banner",
  "name": "Collection Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop content position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center-center",
          "label": "Center center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom-center"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "use_theme_button",
      "label": "Use theme button style",
      "default": true
    },
    {
      "type": "range",
      "id": "buttons_corner",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Buttons corner radius",
      "default": 4,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Collection cards border radius",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "inner_width",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Inner content width (desktop)",
      "default": 85
    },
    {
      "type": "range",
      "id": "inner_width_mobile",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Inner content width (mobile)",
      "default": 100
