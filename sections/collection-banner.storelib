            "info": "Its title, picture and link are used when the fields below are empty."
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Kicker"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Title"
          },
          {
            "type": "text",
            "id": "description",
            "label": "Description"
          },
          {
            "type": "text",
            "id": "primary_button_label",
            "label": "Button label"
          },
          {
            "type": "url",
            "id": "primary_button_link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Images"
          },
          {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image on phones"
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "card_height",
            "label": "Banner height",
            "options": [
              {
                "value": "1",
                "label": "Short"
              },
              {
                "value": "2",
                "label": "Tall"
              },
              {
                "value": "3",
                "label": "Taller"
              }
            ],
            "default": "1"
          },
          {
            "type": "range",
            "id": "vertical_text_gap",
            "min": 8,
            "max": 32,
            "step": 2,
            "unit": "px",
            "label": "Gap between texts",
            "default": 16
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "overlay_color",
            "label": "Overlay color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "%",
            "label": "Overlay strength",
            "default": 20
          },
          {
            "type": "select",
            "id": "primary_button_style",
            "label": "Button style",
            "options": [
              {
                "value": "solid",
                "label": "Solid"
              },
              {
                "value": "outline",
                "label": "Outline"
              },
              {
                "value": "link",
                "label": "Link"
              }
            ],
            "default": "link"
          },
          {
            "type": "color",
            "id": "primary_text_color",
            "label": "Button text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "primary_background_color",
            "label": "Button background",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.primary_button_style == 'solid' }}"
          },
          {
            "type": "color",
            "id": "primary_border_color",
            "label": "Button border",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.primary_button_style == 'outline' }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "heading_size",
            "min": 20,
            "max": 60,
            "step": 2,
            "unit": "px",
            "label": "Title size",
            "default": 32
          },
          {
            "type": "select",
            "id": "heading_font_weight",
            "label": "Title weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-Bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra Bold"
              }
            ]
          },
          {
            "type": "range",
