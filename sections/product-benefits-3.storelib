        "default": "3 / 4",
        "options": [
          {
            "value": "1 / 1",
            "label": "1:1 Square"
          },
          {
            "value": "4 / 5",
            "label": "4:5 Portrait"
          },
          {
            "value": "3 / 4",
            "label": "3:4 Portrait"
          },
          {
            "value": "4 / 3",
            "label": "4:3 Landscape"
          },
          {
            "value": "16 / 9",
            "label": "16:9 Landscape"
          }
        ]
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
