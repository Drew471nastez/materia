<template compat="shopify">
{%- assign fb_accessibility_product_benefits_image = 'accessibility.product_benefits_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Product Benefits 3
  Two-column "spotlight + benefit list" section. Image fills the left column;
  heading + description + 4 benefit cards stack on the right. Optional glass
  panel surrounds the benefit list. Block-based content, full theme integration.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
  assign panel_style = st.panel_style | default: 'glass'
  assign image_shape = st.image_shape | default: 'soft'

  case image_shape
    when 'square'
      assign image_radius = 0
    when 'soft'
      assign image_radius = 16
    when 'rounded'
      assign image_radius = 32
    when 'extra-rounded'
      assign image_radius = 56
    else
      assign image_radius = 16
  endcase
  if st.image_radius_custom_enabled
    assign image_radius = st.image_radius_custom
  endif
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Section wrapper */
  #shopify-section-{{ sid }} .pb3 {
    background-color: {{ st.section_bg | default: '#FFFFFF' }} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3 {
      padding-top: {{ st.padding_top_desktop | default: 88 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 88 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb3__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb3__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- else -%}
      #shopify-section-{{ sid }} .pb3__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Grid: image left, content right */
  #shopify-section-{{ sid }} .pb3__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ st.column_gap | default: 32 }}px;
    align-items: start;
    width: 100%;
  }
  /* Mobile alignment — center the image and content cleanly */
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .pb3__media,
    #shopify-section-{{ sid }} .pb3__content {
      width: 100%;
      max-width: 100%;
    }
    #shopify-section-{{ sid }} .pb3__panel {
      width: 100%;
    }
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb3__grid {
      grid-template-columns: {{ st.image_column_ratio | default: 40 }}fr {{ st.content_column_ratio | default: 60 }}fr;
      gap: {{ st.column_gap_desktop | default: 56 }}px;
    }
    /* Layout: reverse */
    #shopify-section-{{ sid }} .pb3__grid.pb3--reverse .pb3__media { order: 2; }
    #shopify-section-{{ sid }} .pb3__grid.pb3--reverse .pb3__content { order: 1; }
  }

  /* Image / Video side */
  #shopify-section-{{ sid }} .pb3__media {
    background-color: {{ st.image_bg | default: '#EDEDED' }};
    border-radius: {{ image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ st.image_aspect_mobile | default: '4 / 5' }};
    width: 100%;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb3__media {
      aspect-ratio: {{ st.image_aspect_desktop | default: '3 / 4' }};
    }
  }
  #shopify-section-{{ sid }} .pb3__media img,
  #shopify-section-{{ sid }} .pb3__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Content side */
  #shopify-section-{{ sid }} .pb3__content {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 18 }}px;
  }

  /* Header (heading + description) */
  #shopify-section-{{ sid }} .pb3__header {
    text-align: {{ st.text_align | default: 'left' }};
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_heading_to_desc | default: 12 }}px;
  }
  #shopify-section-{{ sid }} .pb3__heading {
    margin: 0;
    line-height: 1.1;
  }
  #shopify-section-{{ sid }} .pb3__desc {
    margin: 0;
    line-height: 1.55;
  }

  /* Benefit list panel */
  #shopify-section-{{ sid }} .pb3__panel {
    margin-top: {{ st.gap_header_to_panel | default: 8 }}px;
    padding: {{ st.panel_padding_mobile | default: 24 }}px;
    border-radius: {{ st.panel_radius | default: 16 }}px;
    {%- if panel_style == 'glass' -%}
      background-color: {{ st.panel_bg | default: '#F7F7F7' }};
      box-shadow: 0 8px 28px -16px rgba(0,0,0,.08);
    {%- elsif panel_style == 'outline' -%}
      background-color: rgba(0,0,0,0);
      border: 1px solid {{ st.panel_border | default: 'rgba(0,0,0,0.08)' }};
    {%- elsif panel_style == 'flat' -%}
      background-color: {{ st.panel_bg | default: '#F7F7F7' }};
    {%- else -%}
      /* none — no panel chrome, items flow directly */
      background-color: rgba(0,0,0,0);
      padding: 0;
    {%- endif -%}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3__panel {
      {%- if panel_style != 'none' -%}padding: {{ st.panel_padding_desktop | default: 32 }}px;{%- endif -%}
    }
  }

  /* Benefit list — items left-aligned, icon + title in a row, description below */
  #shopify-section-{{ sid }} .pb3__list {
    display: flex;
    flex-direction: column;
    gap: {{ st.benefit_gap | default: 28 }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ sid }} .pb3__item {
    text-align: left;
  }
  #shopify-section-{{ sid }} .pb3__item-row {
    display: flex;
    align-items: center;
    gap: {{ st.benefit_inner_gap | default: 12 }}px;
    margin-bottom: 6px;
  }
  #shopify-section-{{ sid }} .pb3__item-icon {
    flex-shrink: 0;
    width: {{ st.icon_box_size | default: 36 }}px;
    height: {{ st.icon_box_size | default: 36 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ st.icon_box_radius | default: 8 }}px;
  }
  #shopify-section-{{ sid }} .pb3__item-icon svg,
  #shopify-section-{{ sid }} .pb3__item-icon img {
    width: {{ st.icon_size | default: 20 }}px;
    height: {{ st.icon_size | default: 20 }}px;
  }
  #shopify-section-{{ sid }} .pb3__item-title {
    margin: 0;
    line-height: 1.25;
    font-weight: 700;
  }
  #shopify-section-{{ sid }} .pb3__item-desc {
    margin: 0;
    line-height: 1.55;
    text-align: left;
  }
{% comment %}{% endcomment %}</style>

<section class="pb3-wrap">
  <div class="pb3">
    <div class="pb3__inner">
      <div class="pb3__grid pb3--{{ st.layout | default: 'image_left' }}">
        <div class="pb3__media">
          {%- liquid
            assign has_shopify_video = false
            if st.video_shopify
              if st.video_shopify.sources and st.video_shopify.sources.size > 0
                assign has_shopify_video = true
              endif
            endif
            assign has_video_url = false
            if st.video != blank
              assign has_video_url = true
            endif
          -%}
          {%- if has_shopify_video -%}
            <video data-pb3-video autoplay muted loop playsinline webkit-playsinline preload="auto"
                   {% if st.video_shopify.preview_image %}poster="{{ st.video_shopify.preview_image | image_url: width: 1200 }}"{% endif %}>
              {%- for source in st.video_shopify.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif has_video_url -%}
            <video data-pb3-video autoplay muted loop playsinline webkit-playsinline preload="auto">
              <source src="{{ st.video }}" type="video/mp4">
            </video>
          {%- elsif st.image -%}
            <img
              src="{{ st.image | image_url: width: 1000 }}"
              srcset="{{ st.image | image_url: width: 500 }} 500w,
                      {{ st.image | image_url: width: 800 }} 800w,
                      {{ st.image | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 992px) 40vw, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_product_benefits_image | escape }}"
              loading="lazy"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            <img src="{{ placeholder }}" alt="{{ 'accessibility.product_benefits_placeholder' | t }}" loading="lazy" width="800" height="1000">
          {%- endif -%}
        </div>

        <div class="pb3__content">
          <div class="pb3__header">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if block.settings.text != blank -%}
                    <{{ block.settings.tag | default: 'h2' }}
                       id="block-{{ block.id }}"
                       class="pb3__heading"
                       style="
                         color: {{ block.settings.color | default: '#0F0F0F' }} !important;
                         font-weight: {{ block.settings.weight | default: 700 }};
                       "
                       {{ block.shopify_attributes }}>
                      {{ block.settings.text | escape }}
                    </{{ block.settings.tag | default: 'h2' }}>
                    <style>
                      #block-{{ block.id }} { font-size: {{ block.settings.size_mobile | default: 32 }}px; }
                      @media (min-width: 768px) {
                        #block-{{ block.id }} { font-size: {{ block.settings.size_desktop | default: 44 }}px; }
                      }
{% comment %}{% endcomment %}                    </style>
                  {%- endif -%}
                {%- when 'description' -%}
                  {%- if block.settings.text != blank -%}
                    <p id="block-{{ block.id }}"
                       class="pb3__desc"
                       style="color: {{ block.settings.color | default: '#555555' }} !important;"
                       {{ block.shopify_attributes }}>
                      {{ block.settings.text | escape }}
                    </p>
                    <style>
                      #block-{{ block.id }} { font-size: {{ block.settings.size_mobile | default: 15 }}px; }
                      @media (min-width: 768px) {
                        #block-{{ block.id }} { font-size: {{ block.settings.size_desktop | default: 17 }}px; }
                      }
{% comment %}{% endcomment %}                    </style>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
          {%- if benefit_blocks.size > 0 -%}
            <div class="pb3__panel">
              <ul class="pb3__list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'benefit' -%}
                    {%- assign bs = block.settings -%}
                    <li class="pb3__item" {{ block.shopify_attributes }}>
                      <div class="pb3__item-row">
                        {%- if bs.icon_source != 'none' -%}
                          <span class="pb3__item-icon"
                                style="background:{{ bs.icon_box_bg | default: '#FFFFFF' }};color:{{ bs.icon_color | default: '#0F0F0F' }};">
                            {%- case bs.icon_source -%}
                              {%- when 'icon' -%}
                                {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 20 -%}
                              {%- when 'image' -%}
                                {%- if bs.image -%}
                                  <img src="{{ bs.image | image_url: width: 60 }}" alt="{{ bs.title | default: 'icon' | escape }}" loading="lazy">
                                {%- endif -%}
                              {%- when 'svg' -%}
                                {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                            {%- endcase -%}
                          </span>
                        {%- endif -%}
                        {%- if bs.title != blank -%}
                          <h3 id="block-{{ block.id }}-title"
                              class="pb3__item-title"
                              style="color: {{ bs.title_color | default: '#0F0F0F' }} !important;">
                            {{ bs.title | escape }}
                          </h3>
                          <style>
                            #block-{{ block.id }}-title { font-size: {{ st.benefit_title_size | default: 16 }}px; }
{% comment %}{% endcomment %}                          </style>
                        {%- endif -%}
                      </div>
                      {%- if bs.description != blank -%}
                        <p id="block-{{ block.id }}-desc"
                           class="pb3__item-desc"
                           style="color: {{ bs.desc_color | default: '#555555' }} !important;">
                          {{ bs.description | escape }}
                        </p>
                        <style>
                          #block-{{ block.id }}-desc { font-size: {{ st.benefit_desc_size | default: 14 }}px; }
{% comment %}{% endcomment %}                        </style>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  /* Force-play any video in this section (covers Safari/iOS autoplay edge cases) */
  var videos = document.querySelectorAll('#shopify-section-{{ sid }} [data-pb3-video]');
  videos.forEach(function(v) {
    v.muted = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');
    var p = v.play();
    if (p && typeof p.catch === 'function') {
      p.catch(function() {
        /* Browser blocked autoplay — try once more on first user interaction */
        var resume = function() {
          v.play().catch(function() {});
          document.removeEventListener('touchstart', resume);
          document.removeEventListener('click', resume);
        };
        document.addEventListener('touchstart', resume, { once: true });
        document.addEventListener('click', resume, { once: true });
      });
    }
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "product-benefits-3",
  "name": "Product Benefits 3",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, content right"
        },
        {
          "value": "reverse",
          "label": "Image right, content left"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used if no video is provided. Falls back to a default placeholder if blank."
    },
    {
      "type": "video",
      "id": "video_shopify",
      "label": "Video (Shopify-hosted)",
      "info": "Optional. If provided, this plays instead of the image."
    },
    {
      "type": "url",
      "id": "video",
      "label": "Video URL (mp4)",
      "info": "Optional. External .mp4 URL — used only if no Shopify video is set."
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image corner radius preset",
      "default": "soft",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "extra-rounded",
          "label": "Extra rounded"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "image_radius_custom_enabled",
      "label": "Use custom corner radius",
      "default": false
    },
    {
      "type": "range",
      "id": "image_radius_custom",
      "label": "Custom corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_aspect_desktop",
      "label": "Image aspect ratio (desktop)",
      "default": "3 / 4",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "4 / 3",
          "label": "4:3 Landscape"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_aspect_mobile",
      "label": "Image aspect ratio (mobile)",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ]
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image area placeholder color",
      "default": "#EDEDED"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Benefit panel"
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "Panel style",
      "default": "glass",
      "options": [
        {
          "value": "glass",
          "label": "Soft card with shadow"
        },
        {
          "value": "flat",
          "label": "Flat fill"
        },
        {
          "value": "outline",
          "label": "Outline only"
        },
        {
          "value": "none",
          "label": "No panel (items flow directly)"
        }
      ]
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "panel_border",
      "label": "Panel border (outline style)"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel inner padding (desktop)",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel inner padding (mobile)",
      "min": 12,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Benefit list"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "label": "Icon box size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_box_radius",
      "label": "Icon box corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "benefit_title_size",
      "label": "Benefit title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
