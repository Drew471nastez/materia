        "id": "benefit_gap",
        "label": "Gap between benefits",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "benefit_inner_gap",
        "label": "Gap beside icon",
        "min": 4,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "icon_box_size",
        "label": "Icon box size",
        "min": 24,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "icon_box_radius",
        "label": "Icon box corner radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 12,
        "max": 36,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "video",
        "id": "video_shopify",
