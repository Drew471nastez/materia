<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_product_benefits_image = 'accessibility.product_benefits_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Product Benefits 3: a picture or video beside heading and
  description blocks and a panel of benefit blocks. Colours follow the colour
  scheme and fonts follow Theme settings > Typography until custom styling or
  custom fonts are switched on. Every value is a CSS variable printed here;
  assets/live-features-c.js works out the same variables for live edits and
  plays the video only while it is on screen (never under reduced motion).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign custom = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 500%22%3E%3Ccircle cx=%22172%22 cy=%22224%22 r=%2214%22 fill=%22%23888%22 fill-opacity=%22.35%22/%3E%3Cpath d=%22M140 292l40-46 25 28 20-18 35 36z%22 fill=%22%23888%22 fill-opacity=%22.35%22/%3E%3C/svg%3E'
  assign panel_style = st.panel_style | default: 'glass'
  case st.image_shape
    when 'square'
      assign image_radius = 0
    when 'rounded'
      assign image_radius = 32
    when 'extra-rounded'
      assign image_radius = 56
    else
      assign image_radius = 16
  endcase
  if st.image_radius_custom_enabled
    assign image_radius = st.image_radius_custom | default: 0
  endif
  assign soft = 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))'
-%}
{%- if fonts -%}{% style %}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% endstyle %}{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .pb3-wrap {
    display: block;
    margin-top: var(--pb3-mt-m);
    margin-bottom: var(--pb3-mb-m);
    font-family: var(--pb3-bf);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3-wrap { margin-top: var(--pb3-mt-d); margin-bottom: var(--pb3-mb-d); }
  }
  #shopify-section-{{ sid }} .pb3 {
    background-color: var(--pb3-bg);
    padding-top: var(--pb3-pt-m);
    padding-bottom: var(--pb3-pb-m);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3 { padding-top: var(--pb3-pt-d); padding-bottom: var(--pb3-pb-d); }
  }
  #shopify-section-{{ sid }} .pb3__inner { padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} [data-width='container'] .pb3__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} [data-width='fluid_container'] .pb3__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} [data-width='full_width'] .pb3__inner { padding-inline: 1rem; }
  @media (min-width: 992px) { #shopify-section-{{ sid }} [data-width='full_width'] .pb3__inner { padding-inline: 0; } }

  /* Grid: picture and content */
  #shopify-section-{{ sid }} .pb3__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pb3-cgap-m);
    align-items: start;
    width: 100%;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb3__grid {
      grid-template-columns: var(--pb3-img-col) var(--pb3-txt-col);
      gap: var(--pb3-cgap-d);
    }
    #shopify-section-{{ sid }} [data-layout='reverse'] .pb3__grid { grid-template-columns: var(--pb3-txt-col) var(--pb3-img-col); }
    #shopify-section-{{ sid }} [data-layout='reverse'] .pb3__media { order: 2; }
    #shopify-section-{{ sid }} [data-layout='reverse'] .pb3__content { order: 1; }
  }
  #shopify-section-{{ sid }} .pb3__media {
    background-color: var(--pb3-img-bg);
    border-radius: var(--pb3-radius);
    overflow: hidden;
    aspect-ratio: var(--pb3-ar-m);
    width: 100%;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb3__media { aspect-ratio: var(--pb3-ar-d); }
  }
  #shopify-section-{{ sid }} .pb3__media img,
  #shopify-section-{{ sid }} .pb3__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ sid }} .pb3__content {
    display: flex;
    flex-direction: column;
    gap: var(--pb3-content-gap);
    min-width: 0;
  }
  #shopify-section-{{ sid }} .pb3__header {
    text-align: var(--pb3-align);
    display: flex;
    flex-direction: column;
    gap: var(--pb3-hd-gap);
  }
  #shopify-section-{{ sid }} .pb3__header:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .pb3__heading {
    margin: 0;
    line-height: 1.1;
    font-family: var(--pb3-hf);
    font-weight: var(--pb3-h-weight, var(--heading-weight, 700));
    color: var(--pb3-h-color);
    font-size: var(--pb3-h-m);
  }
  #shopify-section-{{ sid }} .pb3__desc {
    margin: 0;
    line-height: 1.55;
    font-family: var(--pb3-bf);
    color: var(--pb3-d-color);
    font-size: var(--pb3-d-m);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3__heading { font-size: var(--pb3-h-d); }
    #shopify-section-{{ sid }} .pb3__desc { font-size: var(--pb3-d-d); }
  }
  #shopify-section-{{ sid }} :is(.pb3__heading, .pb3__desc, .pb3__item-title, .pb3__item-desc, .pb3__item-icon)[hidden] { display: none; }

  /* Benefit panel: glass, flat, outline or none */
  #shopify-section-{{ sid }} .pb3__panel {
    margin-top: var(--pb3-panel-top);
    padding: var(--pb3-panel-pm);
    border-radius: var(--pb3-panel-r);
    background-color: var(--pb3-panel-bg);
  }
  #shopify-section-{{ sid }} [data-panel='glass'] .pb3__panel { box-shadow: 0 8px 28px -16px rgba(0,0,0,.08); }
  #shopify-section-{{ sid }} [data-panel='outline'] .pb3__panel { background-color: transparent; border: 1px solid var(--pb3-panel-line); }
  #shopify-section-{{ sid }} [data-panel='none'] .pb3__panel { background-color: transparent; padding: 0 !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb3__panel { padding: var(--pb3-panel-pd); }
  }
  #shopify-section-{{ sid }} .pb3__list {
    display: flex;
    flex-direction: column;
    gap: var(--pb3-bgap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ sid }} .pb3__item { text-align: start; }
  #shopify-section-{{ sid }} .pb3__item-row {
    display: flex;
    align-items: center;
    gap: var(--pb3-igap);
    margin-bottom: 6px;
  }
  #shopify-section-{{ sid }} .pb3__item-icon {
    flex-shrink: 0;
    width: var(--pb3-ib);
    height: var(--pb3-ib);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--pb3-ib-r);
    background: var(--pb3-ib-bg);
    color: var(--pb3-ic);
  }
  #shopify-section-{{ sid }} .pb3__item-icon svg,
  #shopify-section-{{ sid }} .pb3__item-icon img {
    width: var(--pb3-icon);
    height: var(--pb3-icon);
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .pb3__item-title {
    margin: 0;
    line-height: 1.25;
    font-family: var(--pb3-hf);
    font-weight: var(--heading-weight, 700);
    font-size: var(--pb3-title-size);
    color: var(--pb3-t-color);
  }
  #shopify-section-{{ sid }} .pb3__item-desc {
    margin: 0;
    line-height: 1.55;
    text-align: start;
    font-family: var(--pb3-bf);
    font-size: var(--pb3-desc-size);
    color: var(--pb3-dc);
  }
{% comment %}{% endcomment %}</style>
{%- capture root_vars -%}
  --pb3-bg: {% if custom %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
  --pb3-img-bg: {% if custom %}{% render 'scheme-color', color: st.image_bg, fallback: soft %}{% else %}{{ soft }}{% endif %};
  --pb3-panel-bg: {% if custom %}{% render 'scheme-color', color: st.panel_bg, fallback: soft %}{% else %}{{ soft }}{% endif %};
  --pb3-panel-line: {% if custom %}{% render 'scheme-color', color: st.panel_border, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
  --pb3-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
  --pb3-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
  --pb3-radius: {{ image_radius }}px; --pb3-ar-d: {{ st.image_aspect_desktop | default: '3 / 4' }}; --pb3-ar-m: {{ st.image_aspect_mobile | default: '4 / 5' }};
  --pb3-img-col: {{ st.image_column_ratio | default: 40 }}fr; --pb3-txt-col: {{ st.content_column_ratio | default: 60 }}fr; --pb3-cgap-d: {{ st.column_gap_desktop | default: 0 }}px; --pb3-cgap-m: {{ st.column_gap | default: 0 }}px;
  --pb3-content-gap: {{ st.content_gap | default: 0 }}px; --pb3-align: {{ st.text_align | default: 'left' }}; --pb3-hd-gap: {{ st.gap_heading_to_desc | default: 0 }}px; --pb3-panel-top: {{ st.gap_header_to_panel | default: 0 }}px;
  --pb3-panel-r: {{ st.panel_radius | default: 0 }}px; --pb3-panel-pd: {{ st.panel_padding_desktop | default: 0 }}px; --pb3-panel-pm: {{ st.panel_padding_mobile | default: 0 }}px;
  --pb3-ib: {{ st.icon_box_size | default: 36 }}px; --pb3-ib-r: {{ st.icon_box_radius | default: 0 }}px; --pb3-icon: {{ st.icon_size | default: 20 }}px;
  --pb3-title-size: {{ st.benefit_title_size | default: 16 }}px; --pb3-desc-size: {{ st.benefit_desc_size | default: 14 }}px; --pb3-bgap: {{ st.benefit_gap | default: 0 }}px; --pb3-igap: {{ st.benefit_inner_gap | default: 0 }}px;
  --pb3-pt-d: {{ st.padding_top_desktop | default: 0 }}px; --pb3-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px; --pb3-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --pb3-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
  --pb3-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px; --pb3-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px; --pb3-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px; --pb3-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
{%- endcapture -%}
<section class="pb3-wrap color-{{ color_scheme }} gradient" data-fc-root="product-benefits-3" data-fc-section="{{ sid }}" data-fc-settings="{{ st | json | escape }}" data-width="{{ st.section_width | default: 'container' }}" data-layout="{{ st.layout | default: 'image_left' }}" data-panel="{{ panel_style }}"{% if fonts %} data-own-font{% endif %}{% unless st.reveal %} data-ti-no-reveal{% endunless %} style="{{ root_vars | strip_newlines }}">
  <div class="pb3">
    <div class="pb3__inner">
      <div class="pb3__grid">
        <div class="pb3__media" data-fc-media>
          {%- liquid
            assign has_shopify_video = false
            if st.video_shopify and st.video_shopify.sources and st.video_shopify.sources.size > 0
              assign has_shopify_video = true
            endif
          -%}
          {%- if has_shopify_video -%}
            <video data-pb3-video autoplay muted loop playsinline webkit-playsinline preload="metadata"
                   {% if st.video_shopify.preview_image %}poster="{{ st.video_shopify.preview_image | image_url: width: 1200 }}"{% endif %}>
              {%- for source in st.video_shopify.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif st.video != blank -%}
            <video data-pb3-video autoplay muted loop playsinline webkit-playsinline preload="metadata">
              <source src="{{ st.video }}" type="video/mp4">
            </video>
          {%- elsif st.image -%}
            <img
              src="{{ st.image | image_url: width: 1000 }}"
              srcset="{{ st.image | image_url: width: 500 }} 500w,
                      {{ st.image | image_url: width: 800 }} 800w,
                      {{ st.image | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 992px) 40vw, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_product_benefits_image | escape }}"
              loading="lazy"
              decoding="async"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            <img data-fc-ph src="{{ placeholder }}" alt="" loading="lazy" decoding="async" width="800" height="1000">
          {%- endif -%}
        </div>
        <div class="pb3__content">
          <div class="pb3__header">
            {%- for block in section.blocks -%}
              {%- assign bs = block.settings -%}
              {%- capture battrs -%}data-fc-block="{{ block.id }}" data-fc-type="{{ block.type }}" data-fc-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}{% if bs.text == blank %} hidden{% endif %}{%- endcapture -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- assign own_w = false -%}
                  {%- if bs.weight != blank and bs.weight != 'theme' -%}{%- assign own_w = true -%}{%- endif -%}
                  <h2 class="pb3__heading" {{ battrs }}{% if own_w %} data-own-weight{% endif %} style="--pb3-h-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pb3-h-d: {{ bs.size_desktop | default: 44 }}px; --pb3-h-m: {{ bs.size_mobile | default: 32 }}px;{% if own_w %} --pb3-h-weight: {{ bs.weight }};{% endif %}">{{ bs.text }}</h2>
                {%- when 'description' -%}
                  <p class="pb3__desc" {{ battrs }} style="--pb3-d-color: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}; --pb3-d-d: {{ bs.size_desktop | default: 17 }}px; --pb3-d-m: {{ bs.size_mobile | default: 15 }}px;">{{ bs.text | escape }}</p>
              {%- endcase -%}
            {%- endfor -%}
          </div>
          {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
          {%- if benefit_blocks.size > 0 -%}
            <div class="pb3__panel">
              <ul class="pb3__list" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'benefit' -%}
                    {%- assign bs = block.settings -%}
                    {%- assign c = bs.enable_custom_style -%}
                    <li class="pb3__item" data-fc-block="{{ block.id }}" data-fc-type="benefit" data-fc-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }} style="--pb3-ic: {% if c %}{% render 'scheme-color', color: bs.icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pb3-ib-bg: {% if c %}{% render 'scheme-color', color: bs.icon_box_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %}; --pb3-t-color: {% if c %}{% render 'scheme-color', color: bs.title_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}; --pb3-dc: {% if c %}{% render 'scheme-color', color: bs.desc_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};">
                      <div class="pb3__item-row">
                        <span class="pb3__item-icon" aria-hidden="true"{% if bs.icon_source == 'none' %} hidden{% endif %}>
                          {%- case bs.icon_source -%}
                            {%- when 'image' -%}
                              {%- if bs.image -%}
                                <img src="{{ bs.image | image_url: width: 80 }}" alt="" loading="lazy" decoding="async" width="40" height="40">
                              {%- endif -%}
                            {%- when 'svg' -%}
                              {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
                            {%- when 'none' -%}
                            {%- else -%}
                              {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 20 -%}
                          {%- endcase -%}
                        </span>
                        <h3 class="pb3__item-title"{% if bs.title == blank %} hidden{% endif %}>{{ bs.title | escape }}</h3>
                      </div>
                      <p class="pb3__item-desc"{% if bs.description == blank %} hidden{% endif %}>{{ bs.description | escape }}</p>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- if request.design_mode -%}<template data-fc-icons>{%- assign fc_icons = 'truck,shipping,shield,lock,heart,star,check,headphones,envelope,chat,tag,gift,globe,leaf,award,clock,card,wallet,lightning,recycle,sparkle,box,refresh,user,calendar,handshake,gem,organic,fire,crown' | split: ',' -%}{%- for name in fc_icons -%}<span data-icon="{{ name }}">{% render 'benefits-icon', icon: name, size: 20 %}</span>{%- endfor -%}</template>{%- endif -%}
</section>
</template>

<schema>
{
  "type": "product-benefits-3",
  "name": "Product Benefits 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image side (desktop)",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "reverse",
          "label": "Image right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_column_ratio",
      "label": "Image column share",
      "min": 30,
      "max": 60,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "content_column_ratio",
      "label": "Content column share",
      "min": 40,
      "max": 70,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between header and panel",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "gap_heading_to_desc",
      "label": "Gap below heading",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_header_to_panel",
      "label": "Extra space above panel",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "Panel style",
      "default": "glass",
      "options": [
        {
          "value": "glass",
          "label": "Soft card"
        },
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
