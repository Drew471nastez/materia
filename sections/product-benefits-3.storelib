      },
      {
        "type": "color",
        "id": "panel_border",
        "label": "Panel border",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.panel_style == 'outline' }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
