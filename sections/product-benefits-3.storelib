        "default": 32,
        "visible_if": "{{ section.settings.panel_style != 'none' }}"
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 88
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
