        "info": "Plays muted on a loop instead of the image. Stops when visitors ask for reduced motion."
      },
      {
        "type": "url",
        "id": "video",
        "label": "Video address (mp4)",
        "info": "Used when no video is uploaded."
      },
      {
        "type": "select",
        "id": "image_shape",
        "label": "Image corners",
        "default": "soft",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "soft",
            "label": "Soft"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "extra-rounded",
            "label": "Extra rounded"
          }
        ],
        "visible_if": "{{ section.settings.image_radius_custom_enabled == false }}"
      },
      {
        "type": "checkbox",
        "id": "image_radius_custom_enabled",
        "label": "Custom corner radius",
        "default": false
      },
      {
        "type": "range",
        "id": "image_radius_custom",
