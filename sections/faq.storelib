<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_question_goes_here = 'accessibility.question_goes_here' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — FAQ 6 (single-column accordion).
  Clean, fully scoped, mobile responsive, smooth CSS-only open/close.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign heading = st.heading
  assign subheading = st.subheading

  assign content_alignment = st.content_alignment | default: 'center'
  assign allow_multiple_open = st.allow_multiple_open
  assign first_item_open = st.first_item_open
  assign open_icon = st.open_icon | default: 'plus'

  assign heading_size_d = st.heading_size_desktop | default: 36
  assign heading_size_m = st.heading_size_mobile | default: 26
  assign subheading_size_d = st.subheading_size_desktop | default: 16
  assign subheading_size_m = st.subheading_size_mobile | default: 14
  assign question_size_d = st.question_size_desktop | default: 18
  assign question_size_m = st.question_size_mobile | default: 15
  assign answer_size_d = st.answer_size_desktop | default: 15
  assign answer_size_m = st.answer_size_mobile | default: 14


  assign max_content_width = st.max_content_width | default: 800

  assign reveal = st.reveal
  assign scroll_animation = st.scroll_animation | default: 'inherit'
  if scroll_animation == 'inherit'
    assign scroll_animation = settings.scroll_animation | default: 'none'
  endif
-%}
{%- capture heading_color -%}{% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture subheading_color -%}{% render 'scheme-color', color: st.subheading_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture question_color -%}{% render 'scheme-color', color: st.question_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture answer_color -%}{% render 'scheme-color', color: st.answer_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
{%- capture divider_color -%}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture icon_color -%}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture card_bg -%}{% render 'scheme-color', color: st.card_bg, fallback: 'transparent' %}{%- endcapture -%}
{%- capture card_border_color -%}{% render 'scheme-color', color: st.card_border_color, fallback: 'transparent' %}{%- endcapture -%}
{%- capture hover_color -%}{% render 'scheme-color', color: st.hover_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- capture section_bg -%}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{%- endcapture -%}

<style>
  /* ===== FAQ 6 — fully scoped to #shopify-section-{{ sid }} ===== */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }
  :where(#shopify-section-{{ sid }}) :is(h1,h2,h3,h4,h5,h6) {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, inherit);
  }

  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }

  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} .faq6 {
    background-color: {{ section_bg }} !important;
    padding-top: {{ st.padding_top | default: 60 }}px;
    padding-bottom: {{ st.padding_bottom | default: 60 }}px;
  }

  /* Section width: page-level container; the inner accordion gets its own narrower max-width */
  #shopify-section-{{ sid }} .faq6__inner {
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: 1.5rem;
  }
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .faq6__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .faq6__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .faq6__inner { padding-inline: 3rem; } }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}

  /* Header */
  #shopify-section-{{ sid }} .faq6__header {
    text-align: {{ content_alignment }};
    margin-bottom: {{ st.gap_header_to_items | default: 32 }}px;
    max-width: {{ max_content_width }}px;
    margin-inline: {% if content_alignment == 'center' %}auto{% else %}0{% endif %};
  }
  #shopify-section-{{ sid }} .faq6__heading {
    margin: 0;
    font-size: {{ heading_size_m }}px;
    line-height: 1.15;
    color: {{ heading_color }} !important;
    {% if st.enable_custom_heading_weight %}font-weight: {{ st.heading_weight | default: 600 }};{% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq6__heading { font-size: {{ heading_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq6__subheading {
    margin: {{ st.gap_heading_to_subheading | default: 12 }}px 0 0;
    font-size: {{ subheading_size_m }}px;
    color: {{ subheading_color }} !important;
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq6__subheading { font-size: {{ subheading_size_d }}px; }
  }

  /* Accordion list — narrower than the section for readability */
  #shopify-section-{{ sid }} .faq6__list {
    max-width: {{ max_content_width }}px;
    margin-inline: {% if content_alignment == 'center' %}auto{% else %}0{% endif %};
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_between_items | default: 0 }}px;
    list-style: none;
    padding: 0;
  }
  #shopify-section-{{ sid }} .faq6__item {
    background: {{ card_bg }} !important;
    border: 1px solid {{ card_border_color }};
    border-radius: {{ st.item_radius | default: 0 }}px;
    {% if st.show_dividers and st.gap_between_items == 0 %}
      border-bottom: 1px solid {{ divider_color }};
    {% endif %}
  }
  {% if st.show_dividers and st.gap_between_items == 0 %}
    #shopify-section-{{ sid }} .faq6__item:first-child { border-top: 1px solid {{ divider_color }}; }
  {% endif %}

  #shopify-section-{{ sid }} .faq6__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: {{ st.item_padding_y | default: 18 }}px {{ st.item_padding_x | default: 4 }}px;
    text-align: left;
    color: {{ question_color }} !important;
    font-size: {{ question_size_m }}px;
    line-height: 1.4;
    transition: color .2s ease;
    {% if st.enable_custom_question_weight %}font-weight: {{ st.question_weight | default: 600 }};{% else %}font-weight: var(--heading-weight, 600);{% endif %}
  }
  #shopify-section-{{ sid }} .faq6__q:hover { color: {{ hover_color }} !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq6__q { font-size: {{ question_size_d }}px; }
  }

  #shopify-section-{{ sid }} .faq6__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: {{ icon_color }} !important;
    transition: transform .35s cubic-bezier(.4,0,.2,1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  #shopify-section-{{ sid }} .faq6__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  #shopify-section-{{ sid }} .faq6__item[open] .faq6__icon-chevron {
    transform: rotate(180deg);
  }
  #shopify-section-{{ sid }} .faq6__icon-plus .v,
  #shopify-section-{{ sid }} .faq6__icon-plus .h {
    position: absolute;
    background: currentColor;
    transition: transform .35s cubic-bezier(.4,0,.2,1), opacity .25s ease;
  }
  #shopify-section-{{ sid }} .faq6__icon-plus .v { width: 2px; height: 14px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq6__icon-plus .h { width: 14px; height: 2px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  #shopify-section-{{ sid }} .faq6__item[open] .faq6__icon-plus .v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }

  /* Smooth open/close — grid-template-rows */
  #shopify-section-{{ sid }} .faq6__a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1);
  }
  #shopify-section-{{ sid }} .faq6__item[open] .faq6__a-wrap { grid-template-rows: 1fr; }
  #shopify-section-{{ sid }} .faq6__a-inner { overflow: hidden; }
  #shopify-section-{{ sid }} .faq6__a {
    margin: 0;
    padding: 0 {{ st.item_padding_x | default: 4 }}px {{ st.item_padding_y | default: 18 }}px;
    color: {{ answer_color }} !important;
    font-size: {{ answer_size_m }}px;
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .faq6__a { font-size: {{ answer_size_d }}px; }
  }
  #shopify-section-{{ sid }} .faq6__a a { color: inherit; text-decoration: underline; }

  {%- if reveal and scroll_animation != 'none' and request.design_mode != true -%}
    #shopify-section-{{ sid }} .faq6 {
      opacity: 0;
      transition: opacity .8s ease, transform .8s ease, filter .8s ease, clip-path .8s ease;
      will-change: opacity, transform;
    }
    {%- case scroll_animation -%}
      {%- when 'slide-in' -%}
        #shopify-section-{{ sid }} .faq6 { transform: translateX(-20px); }
        #shopify-section-{{ sid }} .faq6.is-revealed { transform: translateX(0); }
      {%- when 'smooth-fade-up' -%}
        #shopify-section-{{ sid }} .faq6 { transform: translateY(20px); }
        #shopify-section-{{ sid }} .faq6.is-revealed { transform: translateY(0); }
      {%- when 'blur_up' -%}
        #shopify-section-{{ sid }} .faq6 { transform: translateY(12px); filter: blur(4px); }
        #shopify-section-{{ sid }} .faq6.is-revealed { transform: none; filter: none; }
      {%- when 'slide_side' -%}
        #shopify-section-{{ sid }} .faq6 { transform: translateX(-28px); }
        #shopify-section-{{ sid }} .faq6.is-revealed { transform: none; }
      {%- when 'mask_reveal' -%}
        #shopify-section-{{ sid }} .faq6 { opacity: 1; clip-path: inset(0 0 100% 0); transform: translateY(10px); }
        #shopify-section-{{ sid }} .faq6.is-revealed { clip-path: inset(0 0 0 0); transform: none; }
    {%- endcase -%}
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .faq6 { filter: none !important; clip-path: none !important; }
    }
    #shopify-section-{{ sid }} .faq6.is-revealed { opacity: 1; }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.faq6__a-wrap, .faq6__icon, .faq6__icon-plus *, .faq6) {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
{% comment %}{% endcomment %}</style>

<div class="faq6 color-{{ color_scheme }} gradient">
  <div class="faq6__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq6__header">
        {%- if heading != blank -%}<h2 class="faq6__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<div class="faq6__subheading">{{ subheading }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq6__list" data-faq6-list data-multiple="{% if allow_multiple_open %}true{% else %}false{% endif %}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bs = block.settings
            assign open_first = false
            if first_item_open and forloop.first
              assign open_first = true
            endif
          -%}
          <div
            class="faq6__item"
            {% if open_first %}open{% endif %}
            data-faq6-item
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="faq6__q"
              aria-expanded="{% if open_first %}true{% else %}false{% endif %}"
              aria-controls="faq6-a-{{ sid }}-{{ forloop.index }}"
              data-faq6-trigger
            >
              <span>{{ bs.question | default: fb_accessibility_question_goes_here }}</span>
              <span class="faq6__icon" aria-hidden="true">
                {%- if open_icon == 'chevron' -%}
                  <svg class="faq6__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif open_icon == 'arrow' -%}
                  <svg class="faq6__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
                {%- else -%}
                  <span class="faq6__icon-plus">
                    <span class="v"></span>
                    <span class="h"></span>
                  </span>
                {%- endif -%}
              </span>
            </button>
            <div class="faq6__a-wrap" id="faq6-a-{{ sid }}-{{ forloop.index }}">
              <div class="faq6__a-inner">
                <div class="faq6__a">{{ bs.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ sid }}');
    if (!section) return;
    var list = section.querySelector('[data-faq6-list]');
    if (!list) return;
    var multiple = list.dataset.multiple === 'true';

    list.addEventListener('click', function (e) {
      var trig = e.target.closest('[data-faq6-trigger]');
      if (!trig) return;
      var item = trig.closest('[data-faq6-item]');
      if (!item) return;
      var isOpen = item.hasAttribute('open');
      if (!multiple) {
        list.querySelectorAll('[data-faq6-item][open]').forEach(function (it) {
          if (it !== item) {
            it.removeAttribute('open');
            var btn = it.querySelector('[data-faq6-trigger]');
            if (btn) btn.setAttribute('aria-expanded', 'false');
          }
        });
      }
      if (isOpen) {
        item.removeAttribute('open');
        trig.setAttribute('aria-expanded', 'false');
      } else {
        item.setAttribute('open', '');
        trig.setAttribute('aria-expanded', 'true');
      }
    });

    var animation = '{{ scroll_animation }}';
    var revealEl = section.querySelector('.faq6');
    if (document.body.classList.contains('shopify-design-mode')) {
      if (revealEl) revealEl.classList.add('is-revealed');
    } else if (animation && animation !== 'none' && revealEl) {
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            revealEl.classList.add('is-revealed');
            obs.unobserve(revealEl);
          }
        });
      }, { threshold: 0.12 });
      io.observe(revealEl);
    } else if (revealEl) {
      revealEl.classList.add('is-revealed');
    }
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "faq",
  "name": "FAQ 3",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Max content width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 800
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Heading & Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Have a question? We're here to help.</p>"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading size (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "enable_custom_heading_weight",
      "label": "Override theme heading weight",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "600",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Items"
    },
    {
      "type": "checkbox",
      "id": "first_item_open",
      "label": "Open the first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open at once",
      "default": false
    },
    {
      "type": "select",
      "id": "open_icon",
      "label": "Toggle icon",
      "default": "plus",
      "options": [
        {
          "value": "plus",
          "label": "Plus / Minus"
        },
        {
          "value": "chevron",
          "label": "Chevron arrow"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color"
    },
    {
      "type": "range",
      "id": "gap_between_items",
      "label": "Space between items",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 19
    },
