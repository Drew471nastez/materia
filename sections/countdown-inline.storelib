<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Countdown Timer Inline
  Compact pill-shaped countdown banner. Numbers and labels render
  inline on a single horizontal line, ideal for top-of-page sale
  banners, sticky bars, or compact mid-page CTAs. Distinct from the
  card-based timers (Flip / Pro 1-3) — no boxes around digits, just
  bold typography on a pill bar with optional eyebrow + CTA.

  Renders fully without JavaScript — server prints initial digits.
  JS recomputes each second. Block-organized for the eyebrow,
  message text, and CTA button.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign cta = nil
  for b in section.blocks
    if b.type == 'cta' and cta == nil
      assign cta = b
    endif
  endfor
  assign align = st.align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase

  assign end_iso = st.end_iso | default: ''
  assign initial_seconds = 86400
  if end_iso != blank
    assign end_time_t = end_iso | date: '%s' | plus: 0
    assign now_t = 'now' | date: '%s' | plus: 0
    assign initial_seconds = end_time_t | minus: now_t
    if initial_seconds < 0
      assign initial_seconds = 0
    endif
  endif
  assign d = initial_seconds | divided_by: 86400
  assign rem = initial_seconds | modulo: 86400
  assign h = rem | divided_by: 3600
  assign rem = rem | modulo: 3600
  assign m = rem | divided_by: 60
  assign s = rem | modulo: 60
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .cin {
    background: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 16 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 16 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin {
      padding-top: {{ st.padding_top_desktop | default: 24 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 24 }}px;
    }
  }

  #shopify-section-{{ sid }} .cin__inner {
    max-width: {{ st.section_max_width_mobile | default: 560 }}px;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin__inner {
      max-width: {{ st.section_max_width_tablet | default: 900 }}px;
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .cin__inner {
      max-width: {{ st.section_max_width_desktop | default: 1200 }}px;
    }
  }

  /* The pill bar — stacks vertically on narrow mobile, lays out
     horizontally on tablet+. */
  #shopify-section-{{ sid }} .cin__bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ st.gap_inline_mobile | default: 13 }}px;
    background: {% render 'scheme-color', color: st.bar_bg, fallback: 'var(--color-heading)' %};
    color: {% render 'scheme-color', color: st.bar_text, fallback: 'var(--color-background)' %};
    border: {{ st.bar_border_width | default: 0 }}px solid {% render 'scheme-color', color: st.bar_border_color, fallback: 'var(--color-heading)' %};
    border-radius: {{ st.bar_radius_mobile | default: 24 }}px;
    padding: {{ st.bar_pad_y_mobile | default: 14 }}px {{ st.bar_pad_x_mobile | default: 22 }}px;
    text-align: center;
  }
  @media (min-width: 600px) {
    #shopify-section-{{ sid }} .cin__bar {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: {{ flex_align }};
      gap: {{ st.gap_inline | default: 16 }}px;
      text-align: inherit;
      border-radius: {{ st.bar_radius | default: 100 }}px;
    }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin__bar {
      padding: {{ st.bar_pad_y_desktop | default: 18 }}px {{ st.bar_pad_x_desktop | default: 32 }}px;
    }
  }

  /* Eyebrow chip (optional) */
  #shopify-section-{{ sid }} .cin__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: {% render 'scheme-color', color: st.eyebrow_bg, fallback: 'color-mix(in srgb, var(--color-background) 12%, transparent)' %};
    color: {% render 'scheme-color', color: st.eyebrow_color, fallback: 'var(--color-background)' %};
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  #shopify-section-{{ sid }} .cin__eyebrow-dot {
    width: 6px; height: 6px;
    background: {% render 'scheme-color', color: st.eyebrow_dot_color, fallback: 'var(--color-primary)' %};
    border-radius: 999px;
    animation: cin-pulse 1.6s ease-in-out infinite;
  }
  @keyframes cin-pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: 0.5; transform: scale(1.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .cin__eyebrow-dot { animation: none; }
  }

  /* Message text */
  #shopify-section-{{ sid }} .cin__message {
    font-weight: {{ st.message_weight | default: 600 }};
    font-size: {{ st.message_size_mobile | default: 14 }}px;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin__message {
      font-size: {{ st.message_size_desktop | default: 16 }}px;
    }
  }
  #shopify-section-{{ sid }} .cin__message > * { margin: 0 !important; }

  /* Inline timer — digits + units on one line */
  #shopify-section-{{ sid }} .cin__timer {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
    align-items: baseline;
    gap: {{ st.timer_gap | default: 10 }}px;
    font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ sid }} .cin__unit {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }
  #shopify-section-{{ sid }} .cin__digits {
    color: {% render 'scheme-color', color: st.digit_color, fallback: 'var(--color-background)' %};
    background: {% render 'scheme-color', color: st.digit_bg, fallback: 'transparent' %};
    {% if st.digit_bg != blank and st.digit_bg.alpha != 0 and st.digit_bg != 'transparent' and st.digit_bg != 'rgba(0,0,0,0)' %}
    padding: 4px 8px;
    border-radius: 6px;
    {% endif %}
    font-weight: {{ st.digit_weight | default: 800 }};
    font-size: {{ st.digit_size_mobile | default: 18 }}px;
    line-height: 1;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin__digits {
      font-size: {{ st.digit_size_desktop | default: 22 }}px;
    }
  }
  #shopify-section-{{ sid }} .cin__unit-label {
    font-size: {{ st.unit_label_size | default: 12 }}px;
    font-weight: {{ st.unit_label_weight | default: 600 }};
    color: {% render 'scheme-color', color: st.unit_label_color, fallback: 'color-mix(in srgb, var(--color-background) 65%, transparent)' %};
    text-transform: lowercase;
    line-height: 1;
  }

  /* CTA: a theme button (theme-button-contract.css). Theme settings > Buttons
     draw it; colours set here, and the shape when the theme style is off, are
     --mb-* tokens. */
  #shopify-section-{{ sid }} .cin__cta {
    text-decoration: none;
    white-space: nowrap;
    {% render 'button-overrides', bg: st.cta_bg, text: st.cta_color, border: st.cta_border_color, hover_bg: st.cta_bg_hover, hover_text: st.cta_color_hover %}
    {%- unless st.use_theme_button %}
    --btn-border-width: {{ st.cta_border_width | default: 0 }}px;
    --mb-padding-y: {{ st.cta_pad_y | default: 8 }}px;
    --mb-padding-x: {{ st.cta_pad_x | default: 18 }}px;
    --mb-radius: {{ st.cta_radius | default: 100 }}px;
    --mb-font-size: {{ st.cta_size | default: 13 }}px;
    {%- endunless %}
  }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .cin { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .cin { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .cin { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .cin { display: block; } }
  {%- endif -%}

  /* Expired state */
  #shopify-section-{{ sid }}.cin-expired .cin__timer,
  #shopify-section-{{ sid }}.cin-expired .cin__cta { display: none; }
  #shopify-section-{{ sid }} .cin__expired { display: none; }
  #shopify-section-{{ sid }}.cin-expired .cin__expired {
    display: inline-block;
    color: {% render 'scheme-color', color: st.expired_color, fallback: 'inherit' %};
  }
{% comment %}{% endcomment %}</style>

<section class="cin color-{{ color_scheme }} gradient {{ section.settings.section_width }}" id="cin-{{ sid }}">
  <div class="cin__inner">
    <div class="cin__bar" data-cin-bar data-end="{{ end_iso | escape }}">

      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}

          {%- when 'eyebrow' -%}
            {%- if bs.text != blank -%}
              <span class="cin__eyebrow" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if bs.show_dot -%}<span class="cin__eyebrow-dot" aria-hidden="true"></span>{%- endif -%}
                <span>{{ bs.text }}</span>
              </span>
            {%- endif -%}

          {%- when 'message' -%}
            {%- if bs.text != blank -%}
              <div class="cin__message" id="block-{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%}========== INLINE TIMER ==========={%- endcomment -%}
      <div class="cin__timer">
        {%- if st.show_days -%}
          <span class="cin__unit">
            <span class="cin__digits" data-cin-d>{%- if d < 10 -%}0{%- endif -%}{{ d }}</span>
            <span class="cin__unit-label">{{ st.label_days | default: 'd' }}</span>
          </span>
        {%- endif -%}
        {%- if st.show_hours -%}
          <span class="cin__unit">
            <span class="cin__digits" data-cin-h>{%- if h < 10 -%}0{%- endif -%}{{ h }}</span>
            <span class="cin__unit-label">{{ st.label_hours | default: 'h' }}</span>
          </span>
        {%- endif -%}
        {%- if st.show_minutes -%}
          <span class="cin__unit">
            <span class="cin__digits" data-cin-m>{%- if m < 10 -%}0{%- endif -%}{{ m }}</span>
            <span class="cin__unit-label">{{ st.label_minutes | default: 'm' }}</span>
          </span>
        {%- endif -%}
        {%- if st.show_seconds -%}
          <span class="cin__unit">
            <span class="cin__digits" data-cin-s>{%- if s < 10 -%}0{%- endif -%}{{ s }}</span>
            <span class="cin__unit-label">{{ st.label_seconds | default: 's' }}</span>
          </span>
        {%- endif -%}
      </div>

      {%- if st.expired_message != blank -%}
        <span class="cin__expired">{{ st.expired_message }}</span>
      {%- endif -%}

      {%- if cta and cta.settings.text != blank -%}
        <a class="cin__cta" data-theme-button="primary" data-sl-button data-button-role="primary" href="{{ cta.settings.link | default: '#' }}" id="block-{{ cta.id }}" {{ cta.shopify_attributes }}>{{ cta.settings.text }}</a>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function(){
function init(){
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var __el = root.querySelector('[data-cin-bar]');
  if (!__el || __el.__cinInit) return;
  __el.__cinInit = true;
  if (root.__cinIv) clearInterval(root.__cinIv);
  root.classList.remove('cin-expired');

  var bar = root.querySelector('[data-cin-bar]');
  if (!bar) return;
  var endRaw = bar.getAttribute('data-end');
  if (!endRaw) return;
  var end = Date.parse(endRaw);
  if (isNaN(end)) return;

  var dEl = bar.querySelector('[data-cin-d]');
  var hEl = bar.querySelector('[data-cin-h]');
  var mEl = bar.querySelector('[data-cin-m]');
  var sEl = bar.querySelector('[data-cin-s]');

  function pad(n){ n = String(Math.max(0, Math.floor(n))); return n.length < 2 ? '0' + n : n; }

  function tick(){
    var diff = Math.max(0, Math.floor((end - Date.now()) / 1000));
    var d = Math.floor(diff / 86400);
    var h = Math.floor((diff % 86400) / 3600);
    var m = Math.floor((diff % 3600) / 60);
    var s = diff % 60;
    if (dEl) dEl.textContent = pad(d);
    if (hEl) hEl.textContent = pad(h);
    if (mEl) mEl.textContent = pad(m);
    if (sEl) sEl.textContent = pad(s);
    if (diff <= 0) {
      root.classList.add('cin-expired');
      clearInterval(iv);
    }
  }
  var iv = setInterval(tick, 1000);
  root.__cinIv = iv;
  tick();
}
init();
if (!window['__cinLoad_{{ sid }}']) {
  window['__cinLoad_{{ sid }}'] = true;
  document.addEventListener('storelib:section-load', function(e){
    if (e.detail && String(e.detail.sectionId) === '{{ sid }}') init();
  });
}
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "countdown-inline",
  "name": "Countdown Timer Inline",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content width"
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Section width (desktop ≥1024px)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Section width (tablet ≥768px)",
      "min": 400,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "section_max_width_mobile",
      "label": "Section width (mobile)",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Bar alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap_inline",
      "label": "Gap between bar items (desktop)",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_inline_mobile",
      "label": "Gap between bar items (mobile)",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "timer_gap",
      "label": "Gap between timer units",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "End time"
    },
    {
      "type": "text",
      "id": "end_iso",
      "label": "End date and time",
      "default": "2026-12-31T23:59:00",
      "info": "Format: 2026-12-31T23:59:00"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has ended."
    },
    {
      "type": "color",
      "id": "expired_color",
      "label": "Expired text color"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Units shown"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Show days",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Show minutes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days suffix",
      "default": "d"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours suffix",
      "default": "h"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes suffix",
      "default": "m"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds suffix",
      "default": "s"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Bar style"
    },
    {
      "type": "color",
      "id": "bar_bg",
      "label": "Bar background"
    },
    {
      "type": "color",
      "id": "bar_text",
      "label": "Bar text color"
    },
    {
      "type": "color",
      "id": "bar_border_color",
      "label": "Bar border color"
    },
    {
      "type": "range",
      "id": "bar_border_width",
      "label": "Bar border width",
      "min": 0,
      "max": 4,
