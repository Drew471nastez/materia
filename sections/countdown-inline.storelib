<template compat="shopify">
<script src="{{ 'live-countdown.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Countdown Timer Inline: one bar with an eyebrow chip, a
  message, the time left (days, hours, minutes, seconds on one line) and a
  button. The timer runs in shopify/assets/live-countdown.js, one per section,
  paused while the section is off screen or the tab is hidden, and every
  setting below is applied live there too (data-cd-root, data-cd-settings,
  data-cd-block). Theme first: colours follow the colour scheme until Enable
  custom styling is on, fonts follow Theme settings > Typography until Custom
  fonts is on, and the button is a theme button (data-theme-button) with its
  own shape only when Use theme button style is off (data-own-shape). No end
  date: the editor shows zeros and a hint, visitors see nothing. An ended
  timer shows the ended message.
  The timer's date rule, the same one live-countdown.js uses:
  function calendarOk(s){var m=/^\s*(\d{4})-(\d{1,2})-(\d{1,2})/.exec(String(s||''));if(!m)return true;var y=+m[1],mo=+m[2],d=+m[3];return mo>=1&&mo<=12&&d>=1&&d<=new Date(Date.UTC(y,mo,0)).getUTCDate();}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign shape = false
  if st.use_theme_button == false
    assign shape = true
  endif
  assign align = st.align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
  assign end_iso = st.end_iso | default: '' | strip
  assign left = 0
  assign state = 'unset'
  if end_iso != blank
    assign state = 'running'
    assign end_t = end_iso | date: '%s' | plus: 0
    assign now_t = 'now' | date: '%s' | plus: 0
    if end_t > 0 and now_t > 0
      assign left = end_t | minus: now_t
      if left <= 0
        assign left = 0
        assign state = 'expired'
      endif
    endif
  endif
  assign d = left | divided_by: 86400
  assign rem = left | modulo: 86400
  assign h = rem | divided_by: 3600
  assign rem = rem | modulo: 3600
  assign m = rem | divided_by: 60
  assign s = rem | modulo: 60
  assign cta = section.blocks | where: 'type', 'cta' | first
  assign digit_box = false
  if own and st.digit_bg != blank and st.digit_bg.alpha != 0 and st.digit_bg != 'transparent' and st.digit_bg != 'rgba(0,0,0,0)' and st.digit_bg != 'rgba(0, 0, 0, 0)'
    assign digit_box = true
  endif
-%}
{%- capture cin_vars -%}
--cin-bg:{% render 'countdown-live-color', on: own, color: st.section_bg, fallback: 'var(--color-background)' %};
--cin-pt-m:{{ st.padding_top_mobile | default: 0 }}px;--cin-pb-m:{{ st.padding_bottom_mobile | default: 0 }}px;--cin-pt-d:{{ st.padding_top_desktop | default: 0 }}px;--cin-pb-d:{{ st.padding_bottom_desktop | default: 0 }}px;
--cin-w-m:{{ st.section_max_width_mobile | default: 560 }}px;--cin-w-t:{{ st.section_max_width_tablet | default: 900 }}px;--cin-w-d:{{ st.section_max_width_desktop | default: 1200 }}px;
--cin-flex:{{ flex_align }};--cin-align:{{ align }};--cin-gap-m:{{ st.gap_inline_mobile | default: 13 }}px;--cin-gap-d:{{ st.gap_inline | default: 16 }}px;--cin-timer-gap:{{ st.timer_gap | default: 10 }}px;
--cin-bar-bg:{% render 'countdown-live-color', on: own, color: st.bar_bg, fallback: 'var(--color-heading)' %};
--cin-bar-text:{% render 'countdown-live-color', on: own, color: st.bar_text, fallback: 'var(--color-background)' %};
--cin-bar-border:{% render 'countdown-live-color', on: own, color: st.bar_border_color, fallback: 'var(--color-heading)' %};
--cin-bar-bw:{{ st.bar_border_width | default: 0 }}px;--cin-r-m:{{ st.bar_radius_mobile | default: 0 }}px;--cin-r-d:{{ st.bar_radius | default: 0 }}px;
--cin-px-m:{{ st.bar_pad_x_mobile | default: 22 }}px;--cin-py-m:{{ st.bar_pad_y_mobile | default: 14 }}px;--cin-px-d:{{ st.bar_pad_x_desktop | default: 32 }}px;--cin-py-d:{{ st.bar_pad_y_desktop | default: 18 }}px;
--cin-eb-bg:{% render 'countdown-live-color', on: own, color: st.eyebrow_bg, fallback: 'color-mix(in srgb, var(--color-background) 12%, transparent)' %};
--cin-eb-c:{% render 'countdown-live-color', on: own, color: st.eyebrow_color, fallback: 'var(--color-background)' %};
--cin-dot:{% render 'countdown-live-color', on: own, color: st.eyebrow_dot_color, fallback: 'var(--color-primary)' %};
--cin-mw:{{ st.message_weight | default: 600 }};--cin-ms-m:{{ st.message_size_mobile | default: 14 }}px;--cin-ms-d:{{ st.message_size_desktop | default: 16 }}px;
--cin-digit:{% render 'countdown-live-color', on: own, color: st.digit_color, fallback: 'var(--color-background)' %};
--cin-digit-bg:{% render 'countdown-live-color', on: own, color: st.digit_bg, fallback: 'transparent' %};
--cin-digit-pad:{% if digit_box %}4px 8px{% else %}0px{% endif %};
--cin-dw:{{ st.digit_weight | default: 800 }};--cin-ds-m:{{ st.digit_size_mobile | default: 18 }}px;--cin-ds-d:{{ st.digit_size_desktop | default: 22 }}px;
--cin-unit:{% render 'countdown-live-color', on: own, color: st.unit_label_color, fallback: 'color-mix(in srgb, var(--color-background) 65%, transparent)' %};
--cin-uw:{{ st.unit_label_weight | default: 600 }};--cin-us:{{ st.unit_label_size | default: 12 }}px;
--cin-expired:{% render 'countdown-live-color', on: own, color: st.expired_color, fallback: 'inherit' %};
{%- if fonts and st.heading_font.family != blank -%}--cin-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if fonts and st.body_font.family != blank -%}--cin-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- endcapture -%}
{%- if fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ st.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 768px) { #shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px; } }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  #shopify-section-{{ sid }} .cin [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .cin, #shopify-section-{{ sid }} .cin *, #shopify-section-{{ sid }} .cin *::before, #shopify-section-{{ sid }} .cin *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cin { display: block; background: var(--cin-bg); padding-top: var(--cin-pt-m); padding-bottom: var(--cin-pb-m); font-family: var(--cin-bf, var(--body-font, inherit)); }
  #shopify-section-{{ sid }} .cin[data-cin-width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cin[data-cin-width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  #shopify-section-{{ sid }} .cin[data-cin-width='stretch_width'] { padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cin[data-cd-state='unset']:not([data-cd-editor]) { display: none !important; }
  #shopify-section-{{ sid }} .cin__inner { max-width: var(--cin-w-m); margin-inline: auto; padding-inline: 1rem; }
  #shopify-section-{{ sid }} .cin__bar { display: flex; flex-direction: column; align-items: var(--cin-flex); justify-content: center; gap: var(--cin-gap-m); background: var(--cin-bar-bg); color: var(--cin-bar-text); border: var(--cin-bar-bw) solid var(--cin-bar-border); border-radius: var(--cin-r-m); padding: var(--cin-py-m) var(--cin-px-m); text-align: var(--cin-align); }
  #shopify-section-{{ sid }} .cin__eyebrow { display: inline-flex; align-items: center; gap: 6px; background: var(--cin-eb-bg); color: var(--cin-eb-c); border-radius: 999px; padding: 4px 10px; font-family: var(--cin-ebf, inherit); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  #shopify-section-{{ sid }} .cin__eyebrow-dot { width: 6px; height: 6px; background: var(--cin-dot); border-radius: 999px; animation: cin-pulse 1.6s ease-in-out infinite; }
  #shopify-section-{{ sid }} .cin[data-cd-paused] .cin__eyebrow-dot { animation-play-state: paused; }
  @keyframes cin-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
  #shopify-section-{{ sid }} .cin__message { color: var(--cim-c, inherit); font-family: var(--cim-ff, inherit); font-weight: var(--cin-mw); font-size: var(--cin-ms-m); line-height: 1.3; }
  #shopify-section-{{ sid }} .cin__message > * { margin: 0; }
  #shopify-section-{{ sid }} .cin__timer { display: inline-flex; flex-wrap: wrap; justify-content: var(--cin-flex); max-width: 100%; align-items: baseline; gap: var(--cin-timer-gap); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .cin__unit { display: inline-flex; align-items: baseline; gap: 2px; }
  #shopify-section-{{ sid }} .cin__digits { display: inline-block; box-sizing: content-box !important; min-width: 2ch; text-align: center; color: var(--cin-digit); background: var(--cin-digit-bg); padding: var(--cin-digit-pad); border-radius: 6px; font-family: var(--cin-hf, inherit); font-weight: var(--cin-dw); font-size: var(--cin-ds-m); line-height: 1; }
  #shopify-section-{{ sid }} .cin__unit-label { font-size: var(--cin-us); font-weight: var(--cin-uw); color: var(--cin-unit); text-transform: lowercase; line-height: 1; }
  #shopify-section-{{ sid }} .cin__cta { text-decoration: none; white-space: nowrap; }
  #shopify-section-{{ sid }} .cin__expired { display: none; color: var(--cin-expired); }
  #shopify-section-{{ sid }} .cin[data-cd-state='expired'] :is(.cin__timer, .cin__cta) { display: none; }
  #shopify-section-{{ sid }} .cin[data-cd-state='expired'] .cin__expired:not([hidden]) { display: inline-block; }
  #shopify-section-{{ sid }} .cin__hint { display: none; margin: 8px 0 0; font-size: 13px; color: var(--color-text); text-align: var(--cin-align); }
  #shopify-section-{{ sid }} .cin[data-cd-state='unset'] .cin__hint { display: block; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cin__eyebrow-dot { animation: none; } }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .cin[data-cin-show='desktop'] { display: none; } }
  @media (min-width: 600px) {
    #shopify-section-{{ sid }} .cin__bar { flex-direction: row; flex-wrap: wrap; justify-content: var(--cin-flex); align-items: center; gap: var(--cin-gap-d); border-radius: var(--cin-r-d); }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cin { padding-top: var(--cin-pt-d); padding-bottom: var(--cin-pb-d); }
    #shopify-section-{{ sid }} .cin[data-cin-show='mobile'] { display: none; }
    #shopify-section-{{ sid }} .cin__inner { max-width: var(--cin-w-t); padding-inline: 1.5rem; }
    #shopify-section-{{ sid }} .cin__bar { padding: var(--cin-py-d) var(--cin-px-d); }
    #shopify-section-{{ sid }} .cin__message { font-size: var(--cin-ms-d); }
    #shopify-section-{{ sid }} .cin__digits { font-size: var(--cin-ds-d); }
  }
  @media (min-width: 1024px) { #shopify-section-{{ sid }} .cin__inner { max-width: var(--cin-w-d); } }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .cin[data-cin-width='stretch_width'] { padding-inline: 3rem; } }
{% comment %}{% endcomment %}</style>

<section class="cin color-{{ color_scheme }} gradient" data-cd-root="countdown-inline" data-cd-section="{{ sid }}" data-cd-settings="{{ st | json | escape }}" data-cd-state="{{ state }}"{% if request.design_mode %} data-cd-editor{% endif %} data-cin-width="{{ st.section_width }}" data-cin-show="{{ st.show_section_on | default: 'all' }}" style="{{ cin_vars | strip_newlines }}">
  <div class="cin__inner">
    <div class="cin__bar">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if bs.enable_custom_fonts -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <span class="cin__eyebrow" data-cd-block="{{ block.id }}" data-cd-type="eyebrow" data-cd-settings="{{ bs | json | escape }}"{% if bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{% if bs.enable_custom_fonts and bs.font.family != blank %}--cin-ebf:{{ bs.font.family }}, {{ bs.font.fallback_families }};{% endif %}" {{ block.shopify_attributes }}>
              <span class="cin__eyebrow-dot" aria-hidden="true" data-cd-dot{% unless bs.show_dot %} hidden{% endunless %}></span>
              <span data-cd-text>{{ bs.text }}</span>
            </span>
          {%- when 'message' -%}
            {%- capture mv -%}
              {%- if bs.enable_custom_style -%}--cim-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--cin-bar-text)' %};{%- endif -%}
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--cim-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
            {%- endcapture -%}
            {%- if bs.enable_custom_fonts -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
            <div class="cin__message" data-cd-block="{{ block.id }}" data-cd-type="message" data-cd-settings="{{ bs | json | escape }}"{% if fonts or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{{ mv | strip_newlines }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- endcase -%}
      {%- endfor -%}

      <div class="cin__timer" role="timer" data-cd-clock>
        <span class="cin__unit" data-cd-show="d"{% unless st.show_days %} hidden{% endunless %}><span class="cin__digits" data-cd-unit="d">{% if d < 10 %}0{% endif %}{{ d }}</span><span class="cin__unit-label" data-cd-label="d" data-cd-fallback="d">{{ st.label_days | default: 'd' }}</span></span>
        <span class="cin__unit" data-cd-show="h"{% unless st.show_hours %} hidden{% endunless %}><span class="cin__digits" data-cd-unit="h">{% if h < 10 %}0{% endif %}{{ h }}</span><span class="cin__unit-label" data-cd-label="h" data-cd-fallback="h">{{ st.label_hours | default: 'h' }}</span></span>
        <span class="cin__unit" data-cd-show="m"{% unless st.show_minutes %} hidden{% endunless %}><span class="cin__digits" data-cd-unit="m">{% if m < 10 %}0{% endif %}{{ m }}</span><span class="cin__unit-label" data-cd-label="m" data-cd-fallback="m">{{ st.label_minutes | default: 'm' }}</span></span>
        <span class="cin__unit" data-cd-show="s"{% unless st.show_seconds %} hidden{% endunless %}><span class="cin__digits" data-cd-unit="s">{% if s < 10 %}0{% endif %}{{ s }}</span><span class="cin__unit-label" data-cd-label="s" data-cd-fallback="s">{{ st.label_seconds | default: 's' }}</span></span>
      </div>
      <span class="cin__expired" data-cd-expired{% if st.expired_message == blank %} hidden{% endif %}>{{ st.expired_message }}</span>

      {%- if cta -%}
        {%- assign cs = cta.settings -%}
        {%- capture bv -%}
          {%- if own -%}--mb-bg:{% render 'scheme-color', color: st.cta_bg, fallback: 'var(--btn-primary-bg-color)' %};--mb-text:{% render 'scheme-color', color: st.cta_color, fallback: 'var(--btn-primary-color)' %};--mb-border:{% render 'scheme-color', color: st.cta_border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};--mb-hover-bg:{% render 'scheme-color', color: st.cta_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};--mb-hover-text:{% render 'scheme-color', color: st.cta_color_hover, fallback: 'var(--btn-primary-hover-color)' %};{%- endif -%}
          {%- if shape -%}--mb-radius:{{ st.cta_radius | default: 0 }}px;--mb-padding-y:{{ st.cta_pad_y | default: 8 }}px;--mb-padding-x:{{ st.cta_pad_x | default: 18 }}px;--mb-font-size:{{ st.cta_size | default: 13 }}px;--mb-border-width:{{ st.cta_border_width | default: 0 }}px;{%- endif -%}
        {%- endcapture -%}
        {%- if cs.link != blank -%}
          <a class="cin__cta" href="{{ cs.link }}" data-cd-btn data-cd-block="{{ cta.id }}" data-cd-type="cta" data-cd-settings="{{ cs | json | escape }}" data-theme-button="primary" data-sl-button{% if shape %} data-own-shape{% endif %}{% if cs.text == blank %} hidden{% endif %} style="{{ bv | strip_newlines }}" {{ cta.shopify_attributes }}>{{ cs.text }}</a>
        {%- else -%}
          <button class="cin__cta" type="button" data-cd-btn data-cd-block="{{ cta.id }}" data-cd-type="cta" data-cd-settings="{{ cs | json | escape }}" data-theme-button="primary" data-sl-button{% if shape %} data-own-shape{% endif %}{% if cs.text == blank %} hidden{% endif %} style="{{ bv | strip_newlines }}" {{ cta.shopify_attributes }}>{{ cs.text }}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if request.design_mode -%}<p class="cin__hint" data-cd-hint>Add an end date in the section settings to start the timer.</p>{%- endif -%}
  </div>
</section>
</template>

<schema>
{
  "type": "countdown-inline",
  "name": "Countdown Timer Inline",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "end_iso",
      "label": "End date and time",
      "default": "",
      "info": "Format: 2026-12-31T23:59:00, or 2026-12-31T23:59:00+02:00 for one moment everywhere. An impossible date such as 2026-02-30 hides the timer. A date with an offset (+02:00) stays fixed; one without counts to the visitor's own clock.",
      "placeholder": "2026-12-31T23:59:00"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Message when ended",
      "default": "This offer has ended."
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Show days",
      "default": true
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days suffix",
      "default": "d",
      "visible_if": "{{ section.settings.show_days }}"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours suffix",
      "default": "h",
      "visible_if": "{{ section.settings.show_hours }}"
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Show minutes",
      "default": true
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes suffix",
      "default": "m",
      "visible_if": "{{ section.settings.show_minutes }}"
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds suffix",
      "default": "s",
      "visible_if": "{{ section.settings.show_seconds }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Content width (desktop)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Content width (tablet)",
      "min": 400,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
