<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


{%- comment -%}
  Output @font-face rule for main custom font if enabled.
{%- endcomment -%}
{% if section.settings.enable_custom_font_url
  and section.settings.custom_font_url != blank
  and section.settings.custom_font_family != blank
%}
  <style>
    @font-face {
      font-family: '{{ section.settings.custom_font_family }}';
      src: url("{{ section.settings.custom_font_url }}") format("truetype");
      font-weight: normal;
      font-style: normal;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

{%- comment -%}
  Output @font-face rule for second text custom font if enabled.
{%- endcomment -%}
{% if section.settings.enable_second_text_custom_font_url
  and section.settings.second_text_custom_font_url != blank
  and section.settings.second_text_custom_font_family != blank
%}
  <style>
    @font-face {
      font-family: '{{ section.settings.second_text_custom_font_family }}';
      src: url("{{ section.settings.second_text_custom_font_url }}") format("truetype");
      font-weight: normal;
      font-style: normal;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<div
  id="rt-elements-pro-1-wrapper-{{ section.id }}" data-text-controls="text-heading" data-tx-section="{{ section.id }}" data-tx-settings="{{ section.settings | json | escape }}" data-tx-defaults='{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"reveal":true,"show_on_mobile":true,"enable_second_text":false,"elements_alignment":"center","section_height_desktop":170,"enable_custom_font":false,"custom_font_title":"assistant_n4","title_text_size":40,"title_font_weight":"theme","title_line_height":"1.2","second_text_size_desktop":20,"second_text_font_weight":"theme","second_text_font":"assistant_n4","title_contrast":100,"title_opacity":100,"enable_title_gradient":false,"gradient_start_color":"#ff7e5f","gradient_middle_color":"#ffffff","gradient_end_color":"#feb47b","gradient_direction":"to right","enable_custom_style":false,"title_text_animation":"none","second_text_margin_left":0,"second_text_margin_right":0,"second_text_horizontal_position_desktop":0,"title_horizontal_position_desktop":0,"title_vertical_position_desktop":0,"padding_top":40,"padding_bottom":40,"padding_left_desktop":0,"padding_right_desktop":0,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"title_mobile_size":30,"second_text_size_mobile":20,"second_text_horizontal_position_mobile":0,"title_horizontal_position_mobile":0,"title_vertical_position_mobile":0,"padding_left_mobile":0,"padding_right_mobile":0,"section_height_mobile":170,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"enable_second_text_custom_font_url":false,"enable_custom_font_url":false}' data-tx-block-defaults='{"title":{"title_text":"Talk about your brand","enable_custom_fonts":false,"font":"assistant_n4","enable_custom_style":false}}' data-tx-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}"
  class="
    rt-elements-pro-1-wrapper color-{{ color_scheme }} gradient
    {% if section.settings.enable_custom_font %}custom-font{% endif %}
    {% if section.settings.enable_custom_font_url %}custom-font-url{% endif %}
    {% unless section.settings.show_on_mobile %}hide-on-mobile{% endunless %}
  "
  style="
    background-color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %}{% else %}{{ 'var(--color-background)' }}{% endif %} !important;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left_desktop }}px;
    padding-right: {{ section.settings.padding_right_desktop }}px;
    height: {{ section.settings.section_height_desktop }}px;
    position: relative;
  "
>
  <div class="rt-elements-pro-1-content-container {{ section.settings.elements_alignment }}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'title' %}
          <h2
            data-tx-block="{{ block.id }}" data-tx-type="{{ block.type }}" data-tx-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }} class="rt-elements-pro-1-title {{ section.settings.title_text_animation }} {% if section.settings.enable_title_gradient and section.settings.gradient_start_color and section.settings.gradient_middle_color and section.settings.gradient_end_color %}rt-elements-pro-1-title-gradient{% endif %}"
            data-text="{{ block.settings.title_text }}"
            style="
              {% if section.settings.enable_title_gradient and section.settings.gradient_start_color and section.settings.gradient_middle_color and section.settings.gradient_end_color %}
                background: linear-gradient({{ section.settings.gradient_direction }}, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_middle_color }}, {{ section.settings.gradient_end_color }});
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
              {% else %}
                color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.title_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %} !important;
              {% endif %}
              opacity: {{ section.settings.title_opacity | divided_by: 100.0 }};
              filter: contrast({{ section.settings.title_contrast }}%);
              line-height: {{ section.settings.title_line_height }};
              font-size: {{ section.settings.title_text_size }}px;
              translate: {{ section.settings.title_horizontal_position_desktop }}px {{ section.settings.title_vertical_position_desktop }}px;
            "
          >
            {{ block.settings.title_text }}
            {% if section.settings.enable_second_text and section.settings.second_text != blank %}
              <span
                class="rt-elements-pro-1-title-second"
                style="
                  color: {% if section.settings.enable_custom_style %}{% render 'scheme-color', color: section.settings.second_text_color, fallback: 'var(--color-heading)' %}{% else %}{{ 'var(--color-heading)' }}{% endif %} !important;
                  font-size: {{ section.settings.second_text_size_desktop }}px;
                  margin-left: {{ section.settings.second_text_margin_left }}px;
                  margin-right: {{ section.settings.second_text_margin_right }}px;
                  font-weight: {{ section.settings.second_text_font_weight }};
                  translate: {{ section.settings.second_text_horizontal_position_desktop }}px;
                "
              >
                {{ section.settings.second_text }}
              </span>
            {% endif %}
          </h2>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% comment %}
  Load Google font if "Enable Custom Font" is true.
{% endcomment %}
{% if section.settings.enable_custom_font %}
  {% assign font_title = section.settings.custom_font_title | replace: ' ', '+' %}

{% endif %}

<style>
  /* Scoped CSS for this section instance using the unique ID */
  #rt-elements-pro-1-wrapper-{{ section.id }} {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    width: 100%;
    position: relative;
    overflow: visible; /* Allow title to overlap outside the section */
  }
  /* For main title custom font */
  #rt-elements-pro-1-wrapper-{{ section.id }}.custom-font .rt-elements-pro-1-title {
    font-family: '{{ section.settings.custom_font_title }}', sans-serif;
  }
  /* For main title custom font URL */
  #rt-elements-pro-1-wrapper-{{ section.id }}.custom-font-url .rt-elements-pro-1-title {
    font-family: '{% if section.settings.custom_font_family != blank %}{{ section.settings.custom_font_family }}{% else %}sans-serif{% endif %}' !important;
  }
  /* For second text custom font URL */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title-second {
    font-family: '{% if section.settings.enable_second_text_custom_font_url and section.settings.second_text_custom_font_family != blank %}{{ section.settings.second_text_custom_font_family }}{% else %}inherit{% endif %}';
  }
  /* Container for content */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-content-container {
    align-self: center;
    margin: 0;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  /* Alignment classes */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-content-container.left {
    align-self: flex-start;
    text-align: start;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-content-container.center {
    align-self: center;
    text-align: center;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-content-container.right {
    align-self: flex-end;
    text-align: right;
  }
  /* Typography for main title */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title {
    font-weight: {% if section.settings.title_font_weight == 'theme' or section.settings.title_font_weight == blank %}var(--heading-weight, 700){% else %}{{ section.settings.title_font_weight }}{% endif %};
    margin-bottom: 15px;
    position: relative;
    transition: transform 0.3s ease;
  }
  /* Styling for second text */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title-second {
    display: inline-block;
    vertical-align: middle;
  }
  /* Gradient Title */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title-gradient {
    display: inline-block;
  }
  /* Title Text Animations and other effects (unchanged) */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer-black-gray {
    position: relative;
    overflow: hidden;
    color: transparent;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer-black-gray::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, black, gray, black);
    animation: rt-elements-pro-1-shimmer 2s infinite;
    background-size: 200% 100%;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer-lightgray-white {
    position: relative;
    overflow: hidden;
    color: transparent;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer-lightgray-white::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, lightgray, white, lightgray);
    animation: rt-elements-pro-1-shimmer 2s infinite;
    background-size: 200% 100%;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer {
    position: relative;
    overflow: hidden;
    color: transparent;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.shimmer::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,0.8), rgba(255,255,255,0));
    animation: rt-elements-pro-1-shimmer 2s infinite;
    background-size: 200% 100%;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.color-wave {
    animation: rt-elements-pro-1-colorWave 5s infinite;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.blurry-clear {
    animation: rt-elements-pro-1-blurryClear 3s infinite alternate;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.rainbow-gradient {
    background: linear-gradient(270deg, #ff0000, #ff7e00, #ffee00, #00ff00, #0000ff, #4b0082, #8f00ff, #ff0000);
    background-size: 1400% 1400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rt-elements-pro-1-rainbowGradient 10s ease infinite;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.pulsing-glow {
    animation: rt-elements-pro-1-pulsingGlow 2s infinite;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.color-fade-spectrum {
    animation: rt-elements-pro-1-colorFadeSpectrum 6s infinite;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.typing-effect {
    border-right: .15em solid orange;
    white-space: nowrap;
    overflow: hidden;
    animation: rt-elements-pro-1-typing 3.5s steps(30, end) forwards, rt-elements-pro-1-blink-caret .75s step-end infinite;
  }
  @keyframes rt-elements-pro-1-typing {
    from { width: 0 }
    to { width: 100% }
  }
  @keyframes rt-elements-pro-1-blink-caret {
    from, to { border-color: transparent }
    50% { border-color: orange; }
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.bounce {
    animation: rt-elements-pro-1-bounce 2s infinite;
  }
  @keyframes rt-elements-pro-1-bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.rotate {
    display: inline-block;
    animation: rt-elements-pro-1-rotate 4s linear infinite;
  }
  @keyframes rt-elements-pro-1-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  /* Additional Animations (unchanged) */
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.slide-in-left {
    animation: rt-elements-pro-1-slideInLeft 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.slide-in-right {
    animation: rt-elements-pro-1-slideInRight 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.fade-up {
    animation: rt-elements-pro-1-fadeUp 2s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.fade-down {
    animation: rt-elements-pro-1-fadeDown 2s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.zoom-in {
    animation: rt-elements-pro-1-zoomIn 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.zoom-out {
    animation: rt-elements-pro-1-zoomOut 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.flip-horizontal {
    animation: rt-elements-pro-1-flipHorizontal 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.flip-vertical {
    animation: rt-elements-pro-1-flipVertical 1s forwards;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.skew {
    animation: rt-elements-pro-1-skew 2s infinite alternate;
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title.wave {
    display: inline-block;
    animation: rt-elements-pro-1-wave 2s infinite;
  }
  @keyframes rt-elements-pro-1-slideInLeft {
    from { transform: translateX(-100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-fadeUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-fadeDown {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-zoomIn {
    from { transform: scale(0.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-zoomOut {
    from { transform: scale(1.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-flipHorizontal {
    from { transform: rotateY(90deg); opacity: 0; }
    to { transform: rotateY(0deg); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-flipVertical {
    from { transform: rotateX(90deg); opacity: 0; }
    to { transform: rotateX(0deg); opacity: 1; }
  }
  @keyframes rt-elements-pro-1-skew {
    from { transform: skewX(0deg); }
    to { transform: skewX(20deg); }
  }
  @keyframes rt-elements-pro-1-wave {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(5deg); }
    50% { transform: rotate(0deg); }
    75% { transform: rotate(-5deg); }
    100% { transform: rotate(0deg); }
  }
  @keyframes rt-elements-pro-1-shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  @keyframes rt-elements-pro-1-colorWave {
    0% { color: #ff0000; }
    16% { color: #ffa500; }
    33% { color: #ffff00; }
    50% { color: #008000; }
    66% { color: #0000ff; }
    83% { color: #4b0082; }
    100% { color: #ee82ee; }
  }
  @keyframes rt-elements-pro-1-blurryClear {
    0% { text-shadow: 0 0 5px rgba(0,0,0,0.5); }
    100% { text-shadow: 0 0 20px rgba(255,255,255,1); }
  }
  @keyframes rt-elements-pro-1-rainbowGradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @keyframes rt-elements-pro-1-pulsingGlow {
    0% { text-shadow: 0 0 10px rgba(255,255,255,0.5); }
    50% { text-shadow: 0 0 20px rgba(255,255,255,1); }
    100% { text-shadow: 0 0 10px rgba(255,255,255,0.5); }
  }
  @keyframes rt-elements-pro-1-colorFadeSpectrum {
    0% { color: #ff0000; }
    14% { color: #ff7f00; }
    28% { color: #ffff00; }
    42% { color: #00ff00; }
    56% { color: #0000ff; }
    70% { color: #4b0082; }
    84% { color: #8f00ff; }
    100% { color: #ff0000; }
  }
  /* Mobile-specific styles (up to 767px) */
  @media (max-width: 767px) {
    #rt-elements-pro-1-wrapper-{{ section.id }} {
      height: {{ section.settings.section_height_mobile }}px !important;
      padding-left: {{ section.settings.padding_left_mobile }}px !important;
      padding-right: {{ section.settings.padding_right_mobile }}px !important;
    }
    #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title {
      font-size: {{ section.settings.title_mobile_size }}px !important;
      translate: {{ section.settings.title_horizontal_position_mobile }}px {{ section.settings.title_vertical_position_mobile }}px !important;
    }
    #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title-second {
      font-size: {{ section.settings.second_text_size_mobile }}px !important;
      translate: {{ section.settings.second_text_horizontal_position_mobile }}px !important;
    }
    #rt-elements-pro-1-wrapper-{{ section.id }}.hide-on-mobile {
      display: none;
    }
  }
  /* Desktop-specific styles (768px and larger) */
  @media (min-width: 768px) {
    #rt-elements-pro-1-wrapper-{{ section.id }} {
      padding-left: {{ section.settings.padding_left_desktop }}px !important;
      padding-right: {{ section.settings.padding_right_desktop }}px !important;
    }
  }
  #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title::after {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title,
    #rt-elements-pro-1-wrapper-{{ section.id }} .rt-elements-pro-1-title::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% comment %}{% endcomment %}</style>
{% render 'text-controls-initial', section: section, kind: 'text-heading' %}
{{ 'text-section-controls.css' | asset_url | stylesheet_tag }}
{{ 'text-section-controls.js' | asset_url | script_tag }}
