<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Logos list: partner or stockist logos in a row that scrolls
  as a carousel when there are more logos than fit.

  Eyebrow, heading, subheading and button blocks above the logos; one logo
  block per logo. Colours follow the colour scheme and fonts follow Theme
  settings > Typography until custom styling or custom fonts are switched
  on. The older header settings (heading, view all button) are kept for
  saved pages and shown only while the section has no heading or button
  block. Shared rules: snippets/logos-style and logos-carousel-style; the
  carousel and the builder's live edits: assets/live-logos.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign fonts = st.enable_custom_fonts
  assign count = 0
  assign has_heading = false
  assign has_button = false
  for block in section.blocks
    case block.type
      when 'collection'
        assign count = count | plus: 1
      when 'heading'
        assign has_heading = true
      when 'button'
        assign has_button = true
    endcase
  endfor
  assign per_d = st.items_per_row | default: 6
  assign per_t = per_d
  if per_t > 3
    assign per_t = 3
  endif
  assign per_m = st.items_per_row_mobile | default: 2.5
  assign ratio = 'auto'
  case st.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'custom'
      assign ratio = '3 / 2'
      assign parts = st.custom_ratio | replace: '/', ':' | replace: 'x', ':' | split: ':'
      if parts.size == 2
        assign ra = parts[0] | strip | plus: 0
        assign rb = parts[1] | strip | plus: 0
        if ra > 0 and rb > 0
          assign ratio = parts[0] | strip | append: ' / ' | append: rb
        endif
      endif
  endcase
  assign justify = 'center'
  if st.text_alignment == 'left'
    assign justify = 'flex-start'
  elsif st.text_alignment == 'right'
    assign justify = 'flex-end'
  endif
  assign arrows = 'hide'
  if st.enable_navigation_arrows
    assign arrows = st.arrow_visibility | default: 'desktop_only'
  endif
  assign anim_class = ''
  if settings.scroll_animation != blank and settings.scroll_animation != 'none'
    assign anim_class = ' scroll-trigger ' | append: settings.scroll_animation
  endif
-%}
{% render 'logos-style', section: section, bp: 768 %}
{% render 'logos-carousel-style', section: section %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .ll .lg__inner { padding-left: var(--ll-pl); padding-right: var(--ll-pr); }
  #shopify-section-{{ sid }} .ll .lgc { margin-top: var(--ll-gap-top); }
  #shopify-section-{{ sid }} .ll__link { display: flex; align-items: center; justify-content: center; min-height: 44px; max-width: 100%; color: var(--lg-text); text-decoration: none; border-radius: var(--rounded-radius, 8px); }
  #shopify-section-{{ sid }} .ll__logo { display: flex; align-items: center; justify-content: center; width: var(--ll-w-m); max-width: 100%; aspect-ratio: var(--ll-ar); }
  #shopify-section-{{ sid }} .ll__logo > img { display: block; width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .ll__logo > svg { display: block; width: 100%; height: auto; }
  #shopify-section-{{ sid }} .ll[data-round='true'] .ll__logo { aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden; }
  #shopify-section-{{ sid }} .ll[data-round='true'] .ll__logo > img { object-fit: cover; }
  #shopify-section-{{ sid }} .ll[data-hover='smoot_fade'] .ll__link { transition: opacity var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .ll[data-hover='smoot_fade'] .ll__link:hover { opacity: .7; }
  #shopify-section-{{ sid }} .ll .lgc__arrow { --arrow-bg: var(--ll-arrow-bg); --arrow-c: var(--ll-arrow-c); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ll__logo { width: var(--ll-w-d); }
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .ll__link { transition: none !important; } }
{% comment %}{% endcomment %}</style>
<div class="lg ll sec__collection-list color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'logos-list', width: st.section_width, fonts: fonts %} data-head-align="{{ st.header_alignment | default: 'center' }}" data-round="{% if st.rounded_image %}true{% else %}false{% endif %}" data-hover="{{ st.collection_hover_animation | default: 'none' }}" data-reveal="{% if st.reveal %}true{% else %}false{% endif %}"{% if request.design_mode %} data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;fluid_container&quot;,&quot;header_alignment&quot;:&quot;center&quot;,&quot;heading&quot;:&quot;Our partners&quot;,&quot;header_size_slider&quot;:32,&quot;font_weight&quot;:&quot;heading_weight&quot;,&quot;view_all_text&quot;:&quot;View All&quot;,&quot;font_size&quot;:16,&quot;items_per_row&quot;:6,&quot;column_gap&quot;:30,&quot;text_alignment&quot;:&quot;center&quot;,&quot;information_spacing&quot;:20,&quot;image_width_desktop&quot;:150,&quot;image_ratio&quot;:&quot;adapt&quot;,&quot;enable_lazy_load&quot;:false,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;collection_hover_animation&quot;:&quot;smoot_fade&quot;,&quot;reveal&quot;:false,&quot;enable_navigation_arrows&quot;:false,&quot;arrow_visibility&quot;:&quot;desktop_only&quot;,&quot;arrow_bg_size&quot;:40,&quot;arrow_vertical_position_desktop&quot;:52,&quot;carousel_pagination&quot;:&quot;disable&quot;,&quot;infinite&quot;:false,&quot;autoplay&quot;:false,&quot;autorotate_speed&quot;:5,&quot;padding_top&quot;:30,&quot;padding_bottom&quot;:30,&quot;padding_left&quot;:0,&quot;padding_right&quot;:0,&quot;items_per_row_mobile&quot;:2.5,&quot;column_gap_mobile&quot;:15,&quot;image_width_mobile&quot;:100,&quot;arrow_vertical_position_mobile&quot;:90&#125;"{% endif %}{% if request.design_mode %} data-lg-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Partners&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:13,&quot;uppercase&quot;:true&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Our partners&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:32,&quot;size_mobile&quot;:26&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Shops and studios we work with.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:16,&quot;size_mobile&quot;:15&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;View all&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;,&quot;collection&quot;:&#123;&#125;&#125;"{% endif %} style="{% render 'logos-root', section: section, custom: own, fonts: fonts, hfont: st.heading_font, bfont: st.body_font, pt_d: st.padding_top, pb_d: st.padding_bottom, pt_m: st.padding_top, pb_m: st.padding_bottom, px_d: 0, px_m: 0 %}--ll-pl: {{ st.padding_left | default: 0 }}px;--ll-pr: {{ st.padding_right | default: 0 }}px;--ll-gap-top: {{ st.information_spacing | default: 0 }}px;--ll-w-d: {{ st.image_width_desktop | default: 150 }}px;--ll-w-m: {{ st.image_width_mobile | default: 100 }}px;--ll-ar: {{ ratio }};--ll-arrow-bg: {% if own %}{% render 'scheme-color', color: st.arrow_bg_color, fallback: 'color-mix(in srgb, var(--color-heading) 10%, transparent)' %}{% else %}color-mix(in srgb, var(--color-heading) 10%, transparent){% endif %};--ll-arrow-c: {% if own %}{% render 'scheme-color', color: st.arrow_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};">
  <template data-lg-ph>{% render 'logos-ph' %}</template>
  <div class="lg__inner">
    <div class="lg-head">
      {%- for block in section.blocks -%}
        {%- unless block.type == 'collection' -%}{%- render 'logos-text', block: block -%}{%- endunless -%}
      {%- endfor -%}
      {%- if has_heading == false and st.heading != blank -%}
        {%- liquid
          assign legacy_weight = 'var(--heading-weight)'
          if st.font_weight == 'body_weight'
            assign legacy_weight = 'var(--body-weight)'
          elsif st.font_weight == 'subheading_weight'
            assign legacy_weight = 'var(--subheading-weight, 500)'
          endif
          assign legacy_size = st.header_size_slider | default: 32
        -%}
        <h2 class="lg__heading" data-lg-legacy="heading" data-own-weight style="--b-c: var(--lg-heading);--b-fs-m: {{ legacy_size | at_most: 28 }}px;--b-fs-d: {{ legacy_size }}px;font-weight: {{ legacy_weight }};">{{ st.heading }}</h2>
      {%- endif -%}
      {%- if has_button == false and st.show_view_all_button -%}
        <a class="lg__btn" data-lg-legacy="button" data-theme-button="primary" data-sl-button href="{{ st.view_all_url | default: routes.all_products_collection_url | url }}">{{ st.view_all_text | escape }}</a>
      {%- endif -%}
    </div>
    <div class="lgc" id="lgc-{{ sid }}" data-lg-carousel data-arrows="{{ arrows }}" data-pagination="{{ st.carousel_pagination | default: 'disable' }}" data-pstyle="dot" data-loop="{% if st.infinite %}true{% else %}false{% endif %}" data-autoplay="{% if st.autoplay %}true{% else %}false{% endif %}" data-speed="{{ st.autorotate_speed | default: 5 }}" data-fit-d="{% if count <= per_d %}true{% else %}false{% endif %}" data-fit-t="{% if count <= per_t %}true{% else %}false{% endif %}" data-fit-m="{% if count <= per_m %}true{% else %}false{% endif %}" style="--per-d: {{ per_d }};--per-t: {{ per_t }};--per-m: {{ per_m }};--gap-d: {{ st.column_gap | default: 0 }}px;--gap-m: {{ st.column_gap_mobile | default: 0 }}px;--count: {{ count | at_least: 1 }};--lgc-justify: {{ justify }};--arrow-size: {{ st.arrow_bg_size | default: 40 }}px;--arrow-y-d: {{ st.arrow_vertical_position_desktop | default: 50 }}%;--arrow-y-m: {{ st.arrow_vertical_position_mobile | default: 50 }}%;">
      <div class="lgc__stage">
      {%- render 'logos-carousel-nav', part: 'arrows', section: section, loop: st.infinite -%}
      <ul class="lgc__track" role="list" tabindex="0" aria-label="Logos">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign b = block.settings -%}
            <li class="lgc__slide ll__item{{ anim_class }}" data-lg-reveal-item {% render 'logos-block', block: block %}>
              {%- capture logo -%}
                <span class="ll__logo" data-lg-img>
                  {%- if b.logo_image != blank -%}
                    <img src="{{ b.logo_image | image_url: width: 600 }}" alt="{{ b.logo_image.alt | escape }}" width="{{ b.logo_image.width }}" height="{{ b.logo_image.height }}"{% if st.enable_lazy_load %} loading="lazy"{% endif %} decoding="async">
                  {%- else -%}
                    {%- render 'logos-ph' -%}
                  {%- endif -%}
                </span>
              {%- endcapture -%}
              {%- if b.collection_url != blank -%}
                <a class="ll__link" data-lg-no-link="SPAN" href="{{ b.collection_url | url }}">{{ logo }}</a>
              {%- else -%}
                <span class="ll__link" data-lg-no-link="SPAN">{{ logo }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      </div>
      {%- render 'logos-carousel-nav', part: 'pagination', section: section, count: count -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "logos-list",
  "name": "Logos List",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our partners",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "header_size_slider",
      "label": "Heading size",
      "min": 12,
      "max": 72,
      "step": 1,
      "default": 32,
      "unit": "px",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Heading weight",
      "default": "heading_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "Standard Weight"
        },
        {
          "value": "subheading_weight",
          "label": "Medium Weight"
        },
        {
          "value": "heading_weight",
          "label": "Bold Weight"
        }
      ],
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Show view all button",
      "hidden": true,
      "info": "Legacy: used only when the section has no button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all label",
      "default": "View All",
      "hidden": true,
      "info": "Legacy: used only when the section has no button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link",
      "hidden": true,
      "info": "Legacy: used only when the section has no button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "View all text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px",
      "hidden": true,
      "info": "Legacy: the button follows Theme settings > Buttons",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Logos per row (desktop)",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between logos (desktop)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Logo alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "information_spacing",
      "label": "Space above logos",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Media"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Logo width (desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 150,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Logo shape",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Logo shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom shape",
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}",
      "placeholder": "3:2",
      "info": "Width and height, for example 3:2"
    },
    {
      "type": "checkbox",
      "id": "rounded_image",
      "label": "Round logos"
    },
    {
      "type": "checkbox",
      "id": "enable_lazy_load",
      "label": "Load logos lazily",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_navigation_arrows }}"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "Arrow icon",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_navigation_arrows }}"
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Animation"
    },
    {
      "type": "select",
      "id": "collection_hover_animation",
      "label": "Logo hover",
      "default": "smoot_fade",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "smoot_fade",
          "label": "Fade"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_navigation_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "select",
      "id": "arrow_visibility",
      "label": "Show arrows on",
      "default": "desktop_only",
      "options": [
        {
          "value": "both",
          "label": "All screens"
        },
        {
          "value": "desktop_only",
          "label": "Desktop"
        },
        {
          "value": "mobile_only",
          "label": "Mobile"
        },
        {
          "value": "hide",
          "label": "Nowhere"
        }
      ],
      "visible_if": "{{ section.settings.enable_navigation_arrows }}"
    },
    {
      "type": "range",
      "id": "arrow_bg_size",
      "label": "Arrow size",
      "min": 20,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_navigation_arrows }}"
    },
    {
      "type": "range",
      "id": "arrow_vertical_position_desktop",
      "label": "Arrow position (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 52,
      "unit": "%",
      "visible_if": "{{ section.settings.enable_navigation_arrows }}"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Pagination",
      "default": "disable",
      "options": [
        {
          "value": "disable",
          "label": "None"
        },
        {
          "value": "show_dots",
          "label": "Dots"
        },
        {
          "value": "show_dots_on_mobile",
          "label": "Dots on phones"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Change every",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "unit": "s",
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "id": "hdr_43",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "default": 0,
      "min": 0,
      "max": 100,
