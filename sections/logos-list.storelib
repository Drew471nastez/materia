<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign column_gap = section_st.column_gap
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign heading = section_st.heading
  assign show_view_all_button = section_st.show_view_all_button
  assign carousel_pagination = section_st.carousel_pagination

  assign design = 'default'
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign reveal = section_st.reveal
  assign items_per_row = section_st.items_per_row
  assign header_size_slider = section_st.header_size_slider

  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3
    assign data_free_scroll = 'true'
  endif

  assign rounded_image = section_st.rounded_image
  assign scroll_animation = settings.scroll_animation
  assign collection_hover_animation = section_st.collection_hover_animation
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}px;
  --section-pb: {{ section_st.padding_bottom }}px;
  --section-pl: {{ section_st.padding_left }}px;
  --section-pr: {{ section_st.padding_right }}px;
{%- endcapture -%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};
  --col-number: {{ items_per_row_mobile }};
  {% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
  --col-gap: {{ section_st.column_gap_mobile }}px;
  --col-gap-desktop: {{ section_st.column_gap }}px;
  --repeat: {{ section.blocks.size }};
  --col-mobile: {{ items_per_row_mobile }}
{%- endcapture -%}

<!-- Base CSS for Section (scoped with a unique section ID) -->
<style>
  .section-{{ section.id }} .collection-item__information {
    display: none !important;
  }
  .section-{{ section.id }} .swiper-wrapper {
    margin-top: {{ section_st.information_spacing | default: 20 }}px;
    margin-bottom: 15px;
  }
  .section-{{ section.id }} .reveal_on_scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .reveal_on_scroll { opacity: 1; transform: none; transition: none; }
  }
  .section-{{ section.id }} .reveal_on_scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  /* Navigation Arrow Styles */
  .section-{{ section.id }} .custom-swiper-button-prev,
  .section-{{ section.id }} .custom-swiper-button-next {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {% render 'scheme-color', color: section_st.arrow_bg_color, fallback: 'var(--color-border)' %};
    color: {% render 'scheme-color', color: section_st.arrow_icon_color, fallback: 'var(--color-heading)' %};
    transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    width: {{ section_st.arrow_bg_size }}px;
    height: {{ section_st.arrow_bg_size }}px;
    border-radius: 50%;
    top: {{ section_st.arrow_vertical_position_desktop }}%;
  }
  .section-{{ section.id }} .arrow-icon {
    width: {{ section_st.arrow_icon_size }}px;
    height: {{ section_st.arrow_icon_size }}px;
  }
  .section-{{ section.id }} .arrow-prev {
    transform: scaleX(-1);
  }
  .section-{{ section.id }} .custom-swiper-button-prev::after,
  .section-{{ section.id }} .custom-swiper-button-next::after {
    content: none;
  }
  /* Mobile Column Spacing */
  @media (max-width: 767px) {
    .section-{{ section.id }} .free-scroll .swiper-wrapper {
      display: flex;
      gap: var(--col-gap);
    }
    .section-{{ section.id }} .custom-swiper-button-prev,
    .section-{{ section.id }} .custom-swiper-button-next {
      top: {{ section_st.arrow_vertical_position_mobile }}%;
    }
  }
  /* Section Padding — target the wrapper itself (it has both
     .section-{id} AND .section classes on the SAME element). */
  .section-{{ section.id }}.section {
    padding: var(--section-pt) var(--section-pr) var(--section-pb) var(--section-pl) !important;
  }
{% comment %}{% endcomment %}</style>

<!-- Hover Animation CSS -->
{% if section_st.collection_hover_animation == 'smoot_fade' %}
  <style>
    .section-{{ section.id }} .hover-smoot_fade {
      transition: opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
      transform-origin: center;
    }
    .section-{{ section.id }} .hover-smoot_fade:hover {
      opacity: 0.88;
      transform: scale(1);
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<!-- Navigation Arrows Visibility -->
{% if section_st.enable_navigation_arrows and section_st.arrow_visibility != 'hide' %}
  <style>
    {% if section_st.arrow_visibility == 'both' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: flex;
      }
    {% elsif section_st.arrow_visibility == 'desktop_only' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: none;
      }
      @media (min-width: 768px) {
        .section-{{ section.id }} .custom-swiper-button-prev,
        .section-{{ section.id }} .custom-swiper-button-next {
          display: flex;
        }
      }
    {% elsif section_st.arrow_visibility == 'mobile_only' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: none;
      }
      @media (max-width: 767px) {
        .section-{{ section.id }} .custom-swiper-button-prev,
        .section-{{ section.id }} .custom-swiper-button-next {
          display: flex;
        }
      }
    {% endif %}
    .section-{{ section.id }} .custom-swiper-button-prev:hover,
    .section-{{ section.id }} .custom-swiper-button-next:hover {
      opacity: 0.8;
    }
{% comment %}{% endcomment %}  </style>
{% endif %}

<!-- Image Size CSS -->
<style>
  @media (min-width: 768px) {
    .section-{{ section.id }} .collection-item img {
      width: {{ section_st.image_width_desktop }}px;
      height: auto;
    }
  }
  @media (max-width: 767px) {
    .section-{{ section.id }} .collection-item img {
      width: {{ section_st.image_width_mobile }}px;
      height: auto;
    }
  }
  .section-{{ section.id }} .collection-item {
    display: flex;
    justify-content: {% case section_st.text_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
  }
  .section-{{ section.id }} .collection-item > a { display: block; }
  .section-{{ section.id }} .collection-item .logo-image { display: block; max-width: 100%; }
  {%- liquid
    assign ll_ratio = ''
    case section_st.image_ratio
      when 'square'
        assign ll_ratio = '1/1'
      when 'portrait'
        assign ll_ratio = '3/4'
      when 'landscape'
        assign ll_ratio = '4/3'
      when 'custom'
        if section_st.custom_ratio != blank
          assign ll_ratio = section_st.custom_ratio | replace: ':', '/'
        endif
    endcase
  -%}
  {%- if ll_ratio != '' %}
  .section-{{ section.id }} .collection-item .logo-image { aspect-ratio: {{ ll_ratio }}; object-fit: contain; }
  {%- endif %}
  .section-{{ section.id }} .collection-item svg.logo-image { aspect-ratio: {% if ll_ratio != '' %}{{ ll_ratio }}{% else %}3/2{% endif %}; height: auto; fill: currentColor; color: var(--color-text); opacity: .4; background: rgba(127,127,127,.1); }
  .section-{{ section.id }} .collection-item .logo-image.rounded { border-radius: 50%; aspect-ratio: 1/1; object-fit: cover; }
  .section-{{ section.id }} .btn_view-all { font-size: {{ section_st.font_size | default: 16 }}px; }
  .section-{{ section.id }} .custom-swiper-button-prev svg,
  .section-{{ section.id }} .custom-swiper-button-next svg {
    width: 110%; /* Scales SVG inside the circle */
    height: 110%;
    justify-content: center;
    display: block;
  }
{% comment %}{% endcomment %}</style>

<div
  class="section-{{ section.id }} section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-list color-{{ color_scheme }} gradient{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if heading != blank or show_view_all_button == true -%}
      <div
        class="section__header mb-33 mb-sm-20 text-{{ section_st.header_alignment }} {% if section_st.section_width == 'full_width' %} px-20 {% endif %}{% if show_view_all_button == true %} flex gap-15 gap-md-30 flex-wrap {% if section_st.header_alignment == 'center' %} justify-content-{{ section_st.header_alignment }} {% else %} justify-between {% endif %} align-center{% if section_st.header_alignment == 'right' %} flex-row-reverse{% endif %}{% endif %}"
      >
        {%- if heading != blank -%}
          <div class="secion__header-inner">
            <h2
              class="section__header-heading heading-letter-spacing mt-0 mb-0 {{ section_st.font_weight }} {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              style="font-size: {{ header_size_slider }}px; {% if scroll_animation != 'none' %} --animation-order: 0; {% endif %}"
            >
              {{ section_st.heading }}
            </h2>
          </div>
        {% endif %}
        {% if show_view_all_button == true and section_st.header_alignment != 'center' %}
          <a
            class="btn_view-all no-underline inline-flex btn-link"
            href="{{ section_st.view_all_url | default: section_st.collection.url }}"
            aria-label="{{ section_st.view_all_text }}"
          >
            {{ section_st.view_all_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
        <div class="free-scroll">
      {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
        <div class="free-scroll">
      {% endif %}

      <slide-section
        class="swiper{% if reveal %} reveal_on_scroll{% endif %}"
        data-section-id="{{ section.id }}"
        data-autoplay="{{ autoplay }}"
        data-effect="slide"
        data-loop="{{ infinite }}"
        data-speed="500"
        data-autoplay-speed="{{ autorotate_speed }}"
        data-spacing="{{ column_gap }}"
        data-mobile="{{ items_per_row_mobile }}"
        data-desktop="{{ items_per_row }}"
        data-tablet="{% if items_per_row > 5 %}4{% elsif items_per_row > 4 %}3{% elsif items_per_row > 3 %}3{% else %}{{ items_per_row }}{% endif %}"
        data-free-scroll="{{ data_free_scroll }}"
        style="{{ col_style | strip | strip_newlines }}"
      >
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign block_st = block.settings %}
            <div
              class="
                collection-item swiper-slide
                {% if scroll_animation != 'none' and scroll_animation != null %}
                  scroll-trigger {{ scroll_animation }}
                {% endif %}
                {% if collection_hover_animation != 'none' %}
                  hover-{{ collection_hover_animation }}
                {% endif %}
              "
              {{ block.shopify_attributes }}
              {%- if scroll_animation != 'none' -%}
                style="--animation-order: {{ forloop.index }};"
              {%- endif -%}
            >
              <a href="{{ block_st.collection_url | default: '#' }}">
                {%- if block_st.logo_image != blank -%}
                {%- assign ll_alt = 'accessibility.logo' | t -%}
                <img {% if section_st.enable_lazy_load %}loading="lazy" {% endif %}decoding="async" src="{{ block_st.logo_image | img_url: 'master' }}" width="{{ block_st.logo_image.width }}" height="{{ block_st.logo_image.height }}" alt="{{ block_st.logo_image.alt | default: ll_alt | escape }}" class="logo-image{% if section_st.rounded_image %} rounded{% endif %}">
                {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'logo-image' }}
                {%- endif -%}
              </a>
            </div>
          {% endfor %}
        </div>

        {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' -%}
          <div
            class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
            style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;"
          ></div>
        {% endif %}

        {% if section_st.enable_navigation_arrows and section_st.arrow_visibility != 'hide' %}
          <div class="swiper-button-prev custom-swiper-button-prev" style="transform: translateX(4px);">
            <!-- Left arrow (Prev) -->
            <svg width="256px" height="256px" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
              <g id="SVGRepo_iconCarrier">
                <path d="M15 7L10 12L15 17"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
              </g>
            </svg>
          </div>
          <div class="swiper-button-next custom-swiper-button-next" style="transform: translateX(4px);">
            <!-- Right arrow (Next) -->
            <svg width="256px" height="256px" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg" transform="matrix(-1, 0, 0, 1, 0, 0)">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
              <g id="SVGRepo_iconCarrier">
                <path d="M15 7L10 12L15 17"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
              </g>
            </svg>
          </div>
        {% endif %}
      </slide-section>

      {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
        </div>
      {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
        </div>
      {% endif %}
    {% endif %}

    {% if show_view_all_button == true and section_st.header_alignment == 'center' %}
      <div class="text-center mt-30">
        <a
          class="inline-flex btn-primary load-more no-underline relative"
          href="{{ section_st.view_all_url | default: section_st.collection.url }}"
          aria-label="{{ section_st.view_all_text }}"
        >
          {{ section_st.view_all_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<!-- Reveal Animation JS -->
<script>
  (function () {
    var id = '{{ section.id }}';
    function run() {
      var root = document.querySelector('.section-' + id);
      if (!root) return;
      root.querySelectorAll('.reveal_on_scroll').forEach(function (el) {
        setTimeout(function () { el.classList.add('revealed'); }, 100);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    var key = '__logosListReveal_' + id;
    if (window[key]) return;
    window[key] = true;
    ['shopify:section:load', 'storelib:section-load'].forEach(function (name) {
      document.addEventListener(name, function (event) {
        if (event.detail && event.detail.sectionId === id) run();
      });
    });
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "logos-list",
  "name": "Logos List",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Section Padding Options"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Section Padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Section Padding",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left Section Padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right Section Padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Lazy Loading Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_lazy_load",
      "label": "Activate Lazy Load Images",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Layout Options"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Layout Container Type",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Fixed Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid Container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched Container"
        },
        {
          "value": "full_width",
          "label": "Edge-to-Edge Layout"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Palette",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Title & Header Options"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Our partners"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Display 'See All' Button"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "See All Button Text",
      "default": "View All"
    },
    {
      "type": "range",
      "id": "header_size_slider",
      "label": "Title Font Size",
      "min": 12,
      "max": 72,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Title Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Align Left"
        },
        {
          "value": "center",
          "label": "Align Center"
        },
        {
          "value": "right",
          "label": "Align Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Image & Grid Options"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture Aspect Ratio",
      "default": "landscape",
      "options": [
        {
          "value": "adapt",
          "label": "Adaptive Ratio"
        },
        {
          "value": "square",
          "label": "Square Ratio"
        },
        {
          "value": "portrait",
          "label": "Portrait Ratio"
        },
        {
          "value": "landscape",
          "label": "Landscape Ratio"
        },
        {
          "value": "custom",
          "label": "Custom Ratio"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom Aspect Ratio"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Desktop Column Count",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Spacing (Desktop)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Image Width (Desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 150,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image Width (Mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_24",
      "label": "Content Display Options"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content Text Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left Justified"
        },
        {
          "value": "center",
          "label": "Center Justified"
        },
        {
          "value": "right",
          "label": "Right Justified"
        }
      ]
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Body Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Text Weight",
      "default": "heading_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "Standard Weight"
        },
        {
          "value": "subheading_weight",
          "label": "Medium Weight"
        },
        {
          "value": "heading_weight",
          "label": "Bold Weight"
        }
      ]
    },
    {
      "type": "range",
      "id": "information_spacing",
      "label": "Vertical Space Between Image And Title",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "rounded_image",
      "label": "Enable Circle Images"
    },
    {
      "type": "select",
      "id": "collection_hover_animation",
      "label": "Logos Hover Animation",
      "default": "smoot_fade",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "smoot_fade",
          "label": "Smoot Fade"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Slider Options"
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Slider Pagination Style",
      "default": "disable",
      "options": [
        {
          "value": "disable",
          "label": "No Pagination"
        },
        {
          "value": "show_dots",
