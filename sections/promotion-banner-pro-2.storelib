          "min": 8,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "pad_y",
          "label": "Button padding Y",
          "min": 4,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Button corner radius",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 100
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Promotion Banner Pro 2",
      "category": "Banners",
      "blocks": [
        {
          "type": "icon"
        },
        {
          "type": "heading",
          "settings": {
