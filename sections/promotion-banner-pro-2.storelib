        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Content alignment",
        "default": "center",
        "options": [
          {
            "value": "flex-start",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "flex-end",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color_background",
        "id": "bg_gradient",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "sticky",
        "label": "Stick to top while scrolling",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_close",
        "label": "Show close button",
        "default": false
      },
      {
        "type": "range",
        "id": "z_index",
        "label": "Z-index (stacking order)",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "select",
        "id": "animation",
        "label": "Entrance animation",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "fade",
            "label": "Fade"
          },
          {
            "value": "fade_up",
            "label": "Fade up"
          },
          {
            "value": "zoom",
            "label": "Zoom"
          }
        ],
        "default": "theme",
        "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "gap",
        "label": "Gap between elements",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "padding_y",
        "label": "Vertical padding",
        "min": 4,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "padding_x_desktop",
        "label": "Horizontal padding (desktop)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "padding_x_mobile",
        "label": "Horizontal padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "select",
        "id": "content_alignment_mobile",
        "label": "Mobile content alignment",
        "default": "inherit",
        "options": [
          {
            "value": "inherit",
            "label": "Follow desktop"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      }
    ],
    "blocks": [
      {
        "type": "icon",
        "name": "Icon",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Icon image"
          },
          {
            "type": "select",
            "id": "icon_preset",
            "label": "Library icon",
            "default": "lightning",
            "options": [
              {
                "value": "lightning",
                "label": "Lightning"
              },
              {
                "value": "gift",
                "label": "Gift"
              },
              {
                "value": "truck",
                "label": "Truck"
              },
              {
                "value": "star",
                "label": "Star"
              },
              {
                "value": "heart",
                "label": "Heart"
              },
              {
                "value": "shield",
                "label": "Shield"
              },
              {
                "value": "check",
                "label": "Check"
              }
            ]
          },
          {
            "type": "select",
            "id": "icon_source",
            "label": "Icon source",
            "default": "preset",
            "options": [
              {
                "value": "preset",
                "label": "Icon library"
              },
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "svg",
                "label": "Custom SVG"
              },
              {
                "value": "none",
                "label": "None"
              }
            ]
          },
          {
            "type": "textarea",
            "id": "svg",
            "label": "Custom SVG",
            "visible_if": "{{ block.settings.icon_source == 'svg' }}"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Icon color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Icon size",
            "min": 12,
            "max": 36,
            "step": 1,
            "unit": "px",
            "default": 22,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Heading text",
            "default": "Free shipping on orders over $99"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Heading color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "letter_spacing",
            "label": "Letter spacing",
            "min": 0,
            "max": 0.4,
            "step": 0.1,
            "unit": "em",
            "default": 0.1,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "weight",
            "label": "Heading weight",
            "min": 300,
            "max": 900,
            "step": 100,
            "default": 600,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_source",
            "label": "Font",
            "options": [
              {
                "value": "heading",
                "label": "Heading font"
              },
              {
                "value": "body",
                "label": "Body font"
              }
            ],
            "default": "heading",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "text_case",
            "label": "Text case",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "none",
                "label": "Original"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              },
              {
                "value": "lowercase",
                "label": "Lowercase"
              },
              {
                "value": "capitalize",
                "label": "Capitalize"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.8,
            "max": 2.4,
            "step": 0.1,
            "default": 1.2,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_desktop",
            "label": "Heading size (desktop)",
            "min": 11,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size_mobile",
            "label": "Heading size (mobile)",
            "min": 10,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "UPPERCASE",
            "default": true
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Subheading text"
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Subheading color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_source",
            "label": "Font",
            "options": [
              {
                "value": "heading",
                "label": "Heading font"
              },
              {
                "value": "body",
                "label": "Body font"
              }
            ],
            "default": "body",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "text_case",
            "label": "Text case",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "none",
                "label": "Original"
              },
              {
                "value": "uppercase",
                "label": "Uppercase"
              },
              {
                "value": "lowercase",
                "label": "Lowercase"
              },
              {
                "value": "capitalize",
                "label": "Capitalize"
              }
            ],
            "default": "theme",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "letter_spacing",
            "label": "Letter spacing",
            "min": -2,
            "max": 8,
            "step": 0.1,
            "default": 0,
            "unit": "px",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 0.8,
            "max": 2.4,
            "step": 0.1,
            "default": 1.5,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Subheading size",
            "min": 10,
            "max": 16,
            "step": 1,
            "unit": "px",
            "default": 13,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "Theme"
              },
              {
                "value": "300",
                "label": "300"
              },
              {
                "value": "400",
                "label": "400"
              },
              {
                "value": "500",
                "label": "500"
              },
              {
                "value": "600",
                "label": "600"
              },
              {
                "value": "700",
                "label": "700"
              },
              {
                "value": "800",
                "label": "800"
              }
            ],
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Button link"
          },
          {
            "type": "checkbox",
            "id": "show_arrow",
            "label": "Show arrow",
            "default": true
          },
          {
            "type": "header",
            "content": "Style & Colors"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Button background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Button background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Button text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color_hover",
            "label": "Button text color (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Button corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 100,
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.use_theme_button == false }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button style",
            "default": true,
            "visible_if": "{{ block.settings.enable_custom_style }}",
            "info": "Keep theme sizing, corners and type. Turn off to adjust those controls."
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Button text size",
            "min": 11,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13,
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_x",
            "label": "Button padding X",
            "min": 8,
            "max": 32,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_y",
            "label": "Button padding Y",
            "min": 4,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Promotion Banner Pro 2",
        "category": "Hero and banners",
        "blocks": [
          {
            "type": "icon"
          },
          {
            "type": "heading",
            "settings": {
              "text": "Free shipping on orders over $99"
            }
          },
          {
            "type": "button",
            "settings": {
              "label": "Shop now"
            }
          }
        ]
