<template compat="shopify">
{%- comment -%}
  Materia Themes — Promotion Banner Pro 2
  Clean modern promotional bar. Per-block customization: every visual
  setting lives inside its block (icon / heading / subheading / button),
  so the section's general settings panel stays focused on layout +
  behavior only.
{%- endcomment -%}

{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}

<style>
  #shopify-section-{{ sid }} {
    position: relative;
    /* Capped at 10 so the banner can never paint over the sticky header
       (header/navigation is z-index: 11). at_most also clamps any old saved
       value (the previous default was 50, which caused the overlap). */
    z-index: {{ s.z_index | default: 5 | at_most: 10 }} !important;
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .pbp {
    container-type: inline-size;
    container-name: pbp;
    background: {{ s.bg_color | default: '#111111' }};
    color: {{ s.text_color | default: '#FFFFFF' }};
    padding: {{ s.padding_y | default: 14 }}px {{ s.padding_x_mobile | default: 16 }}px;
    {%- if s.bg_gradient != blank -%}background: {{ s.bg_gradient }};{%- endif -%}
  }
  @container pbp (min-width: 760px) {
    #shopify-section-{{ sid }} .pbp {
      padding-left: {{ s.padding_x_desktop | default: 32 }}px;
      padding-right: {{ s.padding_x_desktop | default: 32 }}px;
    }
  }

  {%- if s.sticky -%}
    #shopify-section-{{ sid }} .pbp { position: sticky; top: 0; }
  {%- endif -%}

  #shopify-section-{{ sid }} .pbp__inner {
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: {{ s.alignment | default: 'center' }};
    gap: {{ s.gap | default: 14 }}px;
    flex-wrap: wrap;
    text-align: {{ s.alignment | default: 'center' }};
  }

  /* Per-block instances get their own styling — we still keep base
     class selectors for layout/structure-only properties */
  #shopify-section-{{ sid }} .pbp__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ sid }} .pbp__icon img,
  #shopify-section-{{ sid }} .pbp__icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #shopify-section-{{ sid }} .pbp__heading,
  #shopify-section-{{ sid }} .pbp__sub {
    margin: 0;
    line-height: 1.4;
  }
  #shopify-section-{{ sid }} .pbp__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
    border: 0;
    line-height: 1;
  }
  #shopify-section-{{ sid }} .pbp__btn:hover {
    transform: translateY(-1px);
  }
  #shopify-section-{{ sid }} .pbp__btn svg {
    width: 14px;
    height: 14px;
  }

  /* Per-block heading scaling: bigger size on desktop via container query */
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      {%- assign bs = block.settings -%}
      #shopify-section-{{ sid }} .pbp__heading[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#FFFFFF' }};
        font-size: {{ bs.size_mobile | default: 13 }}px;
        font-weight: {{ bs.weight | default: 600 }};
        letter-spacing: {{ bs.letter_spacing | default: 0.1 }}em;
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
      }
      @container pbp (min-width: 760px) {
        #shopify-section-{{ sid }} .pbp__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 14 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      {%- assign bs = block.settings -%}
      #shopify-section-{{ sid }} .pbp__sub[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: 'rgba(255,255,255,0.85)' }};
        font-size: {{ bs.size | default: 13 }}px;
      }
    {%- endif -%}
    {%- if block.type == 'icon' -%}
      {%- assign bs = block.settings -%}
      #shopify-section-{{ sid }} .pbp__icon[data-block-id="{{ block.id }}"] {
        width: {{ bs.size | default: 22 }}px;
        height: {{ bs.size | default: 22 }}px;
        color: {{ bs.color | default: '#FFFFFF' }};
      }
    {%- endif -%}
    {%- if block.type == 'button' -%}
      {%- assign bs = block.settings -%}
      #shopify-section-{{ sid }} .pbp__btn[data-block-id="{{ block.id }}"] {
        background: {{ bs.bg | default: '#FFFFFF' }};
        color: {{ bs.text_color | default: '#111111' }};
        padding: {{ bs.pad_y | default: 8 }}px {{ bs.pad_x | default: 16 }}px;
        border-radius: {{ bs.radius | default: 999 }}px;
        font-size: {{ bs.size | default: 13 }}px;
      }
      #shopify-section-{{ sid }} .pbp__btn[data-block-id="{{ block.id }}"]:hover {
        background: {{ bs.bg_hover | default: '#F0F0F0' }};
        color: {{ bs.text_color_hover | default: bs.text_color | default: '#111111' }};
      }
    {%- endif -%}
  {%- endfor -%}

  /* Dismiss button */
  #shopify-section-{{ sid }}[data-pbp-dismissed="1"] .pbp { display: none; }
  #shopify-section-{{ sid }} .pbp__close {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: transparent; border: 0; cursor: pointer;
    color: {{ s.text_color | default: '#FFFFFF' }};
    opacity: 0.7;
    width: 28px; height: 28px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    transition: opacity 0.18s ease, background 0.18s ease;
  }
  #shopify-section-{{ sid }} .pbp__close:hover { opacity: 1; background: rgba(255,255,255,0.1); }
  #shopify-section-{{ sid }} .pbp__close svg { width: 14px; height: 14px; }
{% comment %}{% endcomment %}</style>

<div class="section{{ reset_spacing }}">
  <div class="pbp" data-section-id="{{ sid }}">
    <div class="pbp__inner">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}
          {%- when 'icon' -%}
            <span class="pbp__icon" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if bs.image != blank -%}
                {{ bs.image | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}
              {%- elsif bs.svg != blank -%}
                {{ bs.svg }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7v8l10-12h-7V2z"/></svg>
              {%- endif -%}
            </span>
          {%- when 'heading' -%}
            {%- if bs.text != blank -%}
              <p class="pbp__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
            {%- endif -%}
          {%- when 'subheading' -%}
            {%- if bs.text != blank -%}
              <p class="pbp__sub" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
            {%- endif -%}
          {%- when 'button' -%}
            {%- if bs.label != blank -%}
              <a class="pbp__btn" data-block-id="{{ block.id }}" href="{{ bs.url | default: '#' }}" {{ block.shopify_attributes }}>
                {{ bs.label | escape }}
                {%- if bs.show_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>{%- endif -%}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if s.show_close -%}
      <button type="button" class="pbp__close" aria-label="{{ 'accessibility.dismiss' | t }}" data-pbp-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    {%- endif -%}
  </div>
</div>

{%- if s.show_close -%}
<script>
(function(){
  var section = document.getElementById('shopify-section-{{ sid }}');
  if (!section) return;
  var key = 'pbp-dismissed-{{ sid }}';
  if (localStorage.getItem(key) === '1') {
    section.setAttribute('data-pbp-dismissed', '1');
    return;
  }
  var btn = section.querySelector('[data-pbp-close]');
  if (btn) btn.addEventListener('click', function() {
    section.setAttribute('data-pbp-dismissed', '1');
    try { localStorage.setItem(key, '1'); } catch(e){}
  });
})();
{% comment %}{% endcomment %}</script>
{%- endif -%}



</template>

<schema>
{
  "type": "promotion-banner-pro-2",
  "name": "Promotion Banner Pro 2",
  "settings": [
    {
      "type": "paragraph",
      "id": "para_1",
      "label": "All visual styling (icon color/size, heading color/size, button colors, etc.) lives in each block below.",
      "content": "All visual styling (icon color/size, heading color/size, button colors, etc.) lives in each block below."
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to top while scrolling",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show dismiss button (remembered per visitor)",
      "default": false
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index (stacking order)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Stacking order vs. page content. Capped below the sticky header so the banner can never cover it."
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between elements",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_x_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient (overrides color)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default / close-button text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image (uses default lightning bolt if empty)"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Icon color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Icon size",
          "min": 12,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 22
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "Free shipping on orders over $99"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Heading color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Heading size (desktop)",
          "min": 11,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Heading size (mobile)",
          "min": 10,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": 0,
          "max": 0.4,
          "step": 0.1,
          "unit": "em",
          "default": 0.1
        },
        {
          "type": "range",
          "id": "weight",
          "label": "Heading weight",
          "min": 300,
          "max": 900,
          "step": 100,
          "default": 600
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "UPPERCASE",
          "default": true
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subheading text"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Subheading color",
          "default": "#FFFFFFD9"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Subheading size",
          "min": 10,
          "max": 16,
          "step": 1,
          "unit": "px",
          "default": 13
        }
      ],
      "limit": 1
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow",
          "default": true
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Button background",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
