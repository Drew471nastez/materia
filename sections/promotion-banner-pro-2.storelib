<template compat="shopify">
{% render 'theme-type' %}
{{ 'marketing-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'marketing-sections.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign bg = section.blocks | where: 'type', 'background' | first %}{% assign photo = s.background_image | default: s.image | default: bg.settings.background_image %}{% assign mobile_photo = s.background_image_mobile | default: bg.settings.background_image_mobile %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="mk-{{ section.id }}" class="mk-shell color-{{ scheme }}" data-marketing-section="{{ section.id }}" data-mk-kind="strip" data-mk-settings="{{ s | json | escape }}" data-mk-defaults='{"section_width":"full_width","color_scheme":"default-color-scheme","reset_spacing":true,"alignment":"center","enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","sticky":false,"show_close":false,"z_index":5,"animation":"theme","padding_x_mobile":16,"gap":14,"padding_y":14,"padding_x_desktop":32}' data-mk-block-defaults='{"icon":{"icon_preset":"lightning","icon_source":"preset","enable_custom_style":false,"size":22},"heading":{"text":"Free shipping on orders over $99","enable_custom_style":false,"letter_spacing":0.1,"weight":600,"font_source":"heading","text_case":"theme","line_height":1.2,"size_desktop":14,"size_mobile":13,"uppercase":true},"subheading":{"enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"size":13,"font_weight":"theme"},"button":{"label":"Shop now","show_arrow":true,"enable_custom_style":false,"radius":100,"use_theme_button":true,"size":13,"pad_x":16,"pad_y":8}}' data-mk-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-mk-button-font="{{ settings.button_font | default: 'body_font' }}" data-mk-motion="{{ settings.scroll_animation | default: 'none' }}" data-mk-duration="{{ settings.animation_duration | default: 700 }}" data-mk-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="mk-inner"><div class="mk-row"><div class="mk-media"><picture>{% if mobile_photo != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: mobile_photo, escaped: true %}">{% endif %}<img src="{% if photo != blank %}{% render 'offer-image-url', image: photo, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-mk-placeholder="{{ placeholder | escape }}" alt="{{ photo.alt | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline hidden></video><div class="mk-split" hidden><img alt="" width="960" height="1080"><img alt="" width="960" height="1080"></div><span class="mk-overlay" aria-hidden="true"></span></div>
 <div class="mk-content">{% if section.blocks.size == 0 %}{% if request.design_mode or page.in_editor %}{% render 'promo-preview-cover', name: 'Promotion Banner Pro 2', kind: 'strip' %}{% endif %}{% endif %}{% for block in section.blocks %}{% unless block.hidden %}<div class="mk-block"{% if block.type == 'secondary_button' and block.settings.enable_secondary_button != true or block.type == 'text_under_button' and block.settings.enable_text_under_button != true or block.type == 'referral_kicker' and block.settings.enable_referral_kicker == false or block.type == 'badge' and block.settings.enable_badge == false %} hidden{% endif %} data-mk-block="{{ block.id }}" data-mk-type="{{ block.type }}" data-mk-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}{% if block.type == 'background' %} hidden{% endif %}>{% render 'marketing-block', block: block, kind: 'strip' %}</div>{% endunless %}{% endfor %}</div></div><button class="mk-close" type="button" aria-label="{{ 'accessibility.dismiss' | t }}" data-mk-close hidden>×</button></div>
 {% assign icons = 'check,star,heart,gift,truck,shield,shield_check,lightning,package,leaf,lock,award,clock,return,chat,globe,credit_card,tag' | split: ',' %}{% for icon in icons %}<template data-mk-icon="{{ icon }}">{% render 'hp-icon', icon: icon %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "promotion-banner-pro-2",
  "name": "Promotion Banner Pro 2",
  "settings": [
    {
      "type": "header",
