          "label": "Button text color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "text_color_hover",
          "label": "Button text color (hover)",
          "default": "#111111"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Button text size",
          "min": 11,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "pad_x",
