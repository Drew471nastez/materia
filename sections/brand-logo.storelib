<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Brand logo: a row of brand logos that scrolls as a carousel
  when there are more logos than fit.

  Eyebrow, heading, subheading and button blocks above the logos; one brand
  block per logo. Colours follow the colour scheme and fonts follow Theme
  settings > Typography until custom fonts are switched on. The older header
  settings (heading, description, view all link) are kept for saved pages
  and shown only while the section has no heading or button block. Shared
  rules: snippets/logos-style and logos-carousel-style; the carousel and the
  builder's live edits: assets/live-logos.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign fonts = st.enable_custom_fonts
  assign count = 0
  assign has_heading = false
  assign has_button = false
  for block in section.blocks
    case block.type
      when 'brand_items'
        assign count = count | plus: 1
      when 'heading'
        assign has_heading = true
      when 'button'
        assign has_button = true
    endcase
  endfor
  assign per_d = st.items_per_row | default: 6
  assign per_t = per_d
  if per_t > 3
    assign per_t = 3
  endif
  assign per_m = st.items_per_row_mobile | default: 1
  assign ratio = 'auto'
  case st.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'custom'
      assign ratio = '3 / 2'
      assign parts = st.custom_ratio | replace: '/', ':' | replace: 'x', ':' | split: ':'
      if parts.size == 2
        assign ra = parts[0] | strip | plus: 0
        assign rb = parts[1] | strip | plus: 0
        if ra > 0 and rb > 0
          assign ratio = parts[0] | strip | append: ' / ' | append: rb
        endif
      endif
  endcase
  assign dots_justify = 'center'
  if st.pagination_position == 'left'
    assign dots_justify = 'flex-start'
  elsif st.pagination_position == 'right'
    assign dots_justify = 'flex-end'
  endif
  assign anim_class = ''
  if settings.scroll_animation != blank and settings.scroll_animation != 'none'
    assign anim_class = ' scroll-trigger ' | append: settings.scroll_animation
  endif
-%}
{% render 'logos-style', section: section, bp: 768, margins: true %}
{% render 'logos-carousel-style', section: section %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .bl__link { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; color: inherit; text-decoration: none; border-radius: var(--rounded-radius, 8px); }
  #shopify-section-{{ sid }} .bl__frame { display: flex; align-items: center; justify-content: center; width: min(100%, var(--bl-w)); aspect-ratio: var(--bl-ar); opacity: var(--bl-op); color: var(--lg-text); border-radius: var(--rounded-radius, 8px); overflow: hidden; transition: opacity var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .bl[data-framed='true'] .bl__frame { border: 1px solid var(--color-border); padding: 12px; }
  #shopify-section-{{ sid }} .bl__link:hover .bl__frame, #shopify-section-{{ sid }} .bl__link:focus-visible .bl__frame { opacity: 1; }
  #shopify-section-{{ sid }} .bl__frame > img { display: block; width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .bl__frame > svg { display: block; width: 100%; height: auto; max-height: 100%; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .bl__frame { transition: none; } }
{% comment %}{% endcomment %}</style>
<div class="lg bl sec__brand-logo color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'brand-logo', width: st.section_width, fonts: fonts %} data-head-align="{{ st.header_alignment | default: 'center' }}" data-framed="{% if st.framed %}true{% else %}false{% endif %}" data-reveal="{% if st.reveal %}true{% else %}false{% endif %}" data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;fluid_container&quot;,&quot;reset_spacing&quot;:true,&quot;header_alignment&quot;:&quot;center&quot;,&quot;open_link_newtab&quot;:true,&quot;heading&quot;:&quot;Brand logo&quot;,&quot;header_size&quot;:&quot;medium&quot;,&quot;items_per_row&quot;:6,&quot;column_gap&quot;:30,&quot;img_width&quot;:300,&quot;image_ratio&quot;:&quot;adapt&quot;,&quot;logo_opacity&quot;:100,&quot;framed&quot;:true,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;show_arrow&quot;:false,&quot;carousel_pagination&quot;:&quot;disable&quot;,&quot;pagination_style&quot;:&quot;pill&quot;,&quot;pagination_position&quot;:&quot;center&quot;,&quot;infinite&quot;:false,&quot;autoplay&quot;:false,&quot;autorotate_speed&quot;:5,&quot;reveal&quot;:false,&quot;padding_top&quot;:0,&quot;padding_bottom&quot;:0,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;items_per_row_mobile&quot;:1,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0&#125;" data-lg-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Our brands&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:13,&quot;uppercase&quot;:true&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Brands we stock&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:32,&quot;size_mobile&quot;:26&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;A few of the labels you will find in our shop.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:16,&quot;size_mobile&quot;:15&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;View all brands&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;,&quot;brand_items&quot;:&#123;&#125;&#125;" style="{% render 'logos-root', section: section, fonts: fonts, hfont: st.heading_font, bfont: st.body_font, pt_d: st.padding_top, pb_d: st.padding_bottom, pt_m: st.padding_top, pb_m: st.padding_bottom, px_d: 24, px_m: 16 %}--bl-w: {{ st.img_width | default: 300 }}px;--bl-op: {{ st.logo_opacity | default: 100 }}%;--bl-ar: {{ ratio }};">
  <template data-lg-ph>{% render 'logos-ph' %}</template>
  <div class="lg__inner">
    <div class="lg-head">
      {%- for block in section.blocks -%}
        {%- unless block.type == 'brand_items' -%}{%- render 'logos-text', block: block -%}{%- endunless -%}
      {%- endfor -%}
      {%- unless has_heading -%}
        {%- if st.heading != blank -%}
          {%- liquid
            assign legacy_size = 32
            if st.header_size == 'small'
              assign legacy_size = 24
            elsif st.header_size == 'large'
              assign legacy_size = 44
            endif
          -%}
          <h2 class="lg__heading" data-lg-legacy="heading" style="--b-c: var(--lg-heading);--b-fs-m: {{ legacy_size | times: 0.8 | round }}px;--b-fs-d: {{ legacy_size }}px;">{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.description != blank -%}
          <div class="lg__sub" data-lg-legacy="subheading" style="--b-c: var(--lg-text);--b-fs-m: 15px;--b-fs-d: 16px;">{{ st.description }}</div>
        {%- endif -%}
      {%- endunless -%}
      {%- if has_button == false and st.show_view_all_button -%}
        <a class="lg__btn" data-lg-legacy="button" data-theme-button="secondary" data-sl-button href="{{ st.view_all_button_link | default: routes.all_products_collection_url | url }}">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <div class="lgc" id="lgc-{{ sid }}" data-lg-carousel data-arrows="{% if st.show_arrow %}both{% else %}hide{% endif %}" data-pagination="{{ st.carousel_pagination | default: 'disable' }}" data-pstyle="{{ st.pagination_style | default: 'dot' }}" data-loop="{% if st.infinite %}true{% else %}false{% endif %}" data-autoplay="{% if st.autoplay %}true{% else %}false{% endif %}" data-speed="{{ st.autorotate_speed | default: 5 }}" data-fit-d="{% if count <= per_d %}true{% else %}false{% endif %}" data-fit-t="{% if count <= per_t %}true{% else %}false{% endif %}" data-fit-m="{% if count <= per_m %}true{% else %}false{% endif %}" style="--per-d: {{ per_d }};--per-t: {{ per_t }};--per-m: {{ per_m }};--gap-d: {{ st.column_gap | default: 0 }}px;--gap-m: {{ st.column_gap | default: 0 }}px;--count: {{ count | at_least: 1 }};--dots-justify: {{ dots_justify }};">
      <div class="lgc__stage">
      {%- render 'logos-carousel-nav', part: 'arrows', section: section, loop: st.infinite -%}
      <ul class="lgc__track" role="list" tabindex="0" aria-label="Brand logos">
        {%- for block in section.blocks -%}
          {%- if block.type == 'brand_items' -%}
            {%- assign b = block.settings -%}
            <li class="lgc__slide bl__item{{ anim_class }}" data-lg-reveal-item {% render 'logos-block', block: block %}>
              {%- capture frame -%}
                <span class="bl__frame" data-lg-img>
                  {%- assign demo = '' -%}
                  {%- if b.image == blank -%}{%- capture demo -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}{%- assign demo = demo | strip -%}{%- endif -%}
                  {%- if b.image != blank -%}
                    <img src="{{ b.image | image_url: width: 600 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
                  {%- elsif demo != blank -%}
                    <img src="{{ demo }}" alt="" loading="lazy" decoding="async">
                  {%- else -%}
                    {%- render 'logos-ph' -%}
                  {%- endif -%}
                </span>
              {%- endcapture -%}
              {%- if b.link != blank -%}
                <a class="bl__link" data-lg-no-link="SPAN" href="{{ b.link | url }}"{% if st.open_link_newtab %} target="_blank" rel="noopener"{% endif %}>{{ frame }}</a>
              {%- else -%}
                <span class="bl__link" data-lg-no-link="SPAN">{{ frame }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      </div>
      {%- render 'logos-carousel-nav', part: 'pagination', section: section, count: count -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "brand-logo",
  "name": "Brand logo",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "fluid_container",
      "label": "Section width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "open_link_newtab",
      "label": "Open logo links in a new tab",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Brand logo",
      "label": "Heading",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Show view all link",
      "hidden": true,
      "info": "Legacy: used only when the section has no button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "url",
      "id": "view_all_button_link",
      "label": "View all link",
      "hidden": true,
      "info": "Legacy: used only when the section has no button block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Heading size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "hidden": true,
      "info": "Legacy: used only when the section has no heading block",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Logos per row (desktop)",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between logos",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Media"
    },
    {
      "type": "range",
      "id": "img_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 5,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Logo frame shape",
      "options": [
        {
          "value": "adapt",
          "label": "Logo shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom shape",
      "info": "Width and height, for example 7:3",
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "framed",
      "label": "Frame around logos",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Pagination",
      "options": [
        {
          "value": "disable",
          "label": "None"
        },
        {
          "value": "show_dots",
          "label": "Dots"
        },
        {
          "value": "show_dots_on_mobile",
          "label": "Dots on phones"
        },
        {
          "value": "show_progress_bar",
          "label": "Progress bar"
        }
      ],
      "default": "disable"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Dot style",
      "default": "pill",
      "options": [
        {
          "value": "dot",
          "label": "Dot (default)"
        },
        {
          "value": "pill",
          "label": "Pill (active expands)"
        },
        {
          "value": "line",
          "label": "Line / bar"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "ring",
          "label": "Ring (hollow)"
        },
        {
          "value": "number",
          "label": "Numbers"
        },
        {
          "value": "progress",
          "label": "Progress fill"
        }
      ],
      "visible_if": "{{ section.settings.carousel_pagination == 'show_dots' or section.settings.carousel_pagination == 'show_dots_on_mobile' }}"
    },
    {
      "type": "select",
      "id": "pagination_position",
      "label": "Dot position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ section.settings.carousel_pagination == 'show_dots' or section.settings.carousel_pagination == 'show_dots_on_mobile' }}"
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Change every",
      "max": 6,
      "min": 2,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_36",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Logos per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Our brands"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": true
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Brands we stock"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "hidden": true,
          "options": [
            {
              "value": "h2",
