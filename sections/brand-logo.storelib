<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'pagination-styles.css' | asset_url }}" media="print" onload="this.media='all'">
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign column_gap = section_st.column_gap
  assign items_per_row = section_st.items_per_row
  assign items_per_row_tablet = 3
  if items_per_row < 3
    assign items_per_row_tablet = items_per_row
  endif
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign heading = section_st.heading
  assign description = section_st.description
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign reveal = section_st.reveal
  assign img_width = section_st.img_width
  assign image_ratio = section_st.image_ratio
  assign custom_ratio = section_st.custom_ratio
  assign logo_opacity = section_st.logo_opacity
  assign framed = ''
  if section_st.framed
    assign framed = 'border'
  endif
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --section-image-width: {{ img_width }}px;
  --logo-opacity: {{ logo_opacity }}%;
{%- endcapture -%}
{%- capture style_ratio -%}
  {%- liquid
    assign ratio = ''
    if image_ratio != 'adapt'
      case image_ratio
        when 'square'
          assign ratio = '1/1'
        when 'landscape'
          assign ratio = '4/3'
        when 'portrait'
          assign ratio = '3/4'
        else
          if custom_ratio != empty
            assign ratio = custom_ratio | replace: ':', '/'
          else
            assign ratio = '3/2'
          endif
      endcase
    else
      assign ratio = '3/2'
    endif
  -%}
  --aspect-ratio: {{ ratio }};--custom-width: {{ section_st.img_width }}px
{%- endcapture -%}
{%- style -%}
  .brand-image {
    opacity: var(--logo-opacity);
  }
  .brand-image:hover {
    opacity: 1;
  }
{%- endstyle -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__brand-logo color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if heading != blank or description != blank -%}
      <div class="section__header mb-33 mb-sm-20 text-{{ section_st.header_alignment }}{% if section_st.section_width == 'full_width' %} px-20{% endif %}{% if section_st.show_view_all_button %} flex gap-15 gap-md-30 flex-wrap {% if section_st.header_alignment == 'center'  %} justify-content-{{ section_st.header_alignment }} {% else %} justify-between {% endif %} align-center{% if section_st.header_alignment == 'right' %} flex-row-reverse{% endif %}{% endif %}">
        {%- if section_st.heading != blank -%}
          <motion-element
             data-motion="fade-up-lg"
                data-motion-delay="50"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
            class="block  {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            style="
            {%- if scroll_animation != 'none' -%}
              --animation-order: 0;
            {% endif %}
          "
          >
          <h2
            class="section__header-heading heading-letter-spacing {{ header_size  }} mt-0{% if section_st.description != blank %} mb-10{% else %} mb-0{% endif %}"
          >
            {{ section_st.heading }}
          </h2>
        </motion-element>
        {% endif %}
        {%- if section_st.description != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="150"
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
            class="section__header-des block {% if scroll_animation != 'none' -%} scroll-trigger {{ scroll_animation }}{% endif %} rich__text-m0"
            style="
              {%- if scroll_animation != 'none' -%}
                --animation-order: 1
              {% endif %}
            "
          >
            {{ section_st.description }}
          </motion-element>
        {% endif %}
        {% if section_st.show_view_all_button and section_st.header_alignment != 'center' %}
          <a
            class="btn_view-all no-underline inline-flex btn-link"
            href="{% if section_st.view_all_button_link != blank %}{{ section_st.view_all_button_link }}{% else %}#{% endif %}"
            role="link"
            aria-label="{{- 'general.view_all' | t -}}"
          >
            {{- 'general.view_all' | t -}}
          </a>
        {% endif %}
      </div>
    {% endif %}
    <slide-section
      class="swiper{% if reveal %} reveal_on_scroll{% endif %}"
      data-section-id="{{ section.id }}"
      data-autoplay="{{ autoplay }}"
      data-effect="slide"
      data-loop="{{ infinite }}"
      data-autoplay-speed="{{ autorotate_speed }}"
      data-spacing="{{ column_gap }}"
      data-mobile="{{ items_per_row_mobile }}"
      data-tablet="{{ items_per_row_tablet }}"
      data-desktop="{{ items_per_row }}"
      data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
          data-pagination-style="{{ section_st.pagination_style | default: 'dot' }}"
    >
      {% if show_arrow %}
        {%- render 'swiper-navigation' -%}
      {% endif %}
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
            assign image = block_st.image
          -%}
          <div
            {{ block.shopify_attributes }}
            class="swiper-slide "
          >
            {% if forloop.index <= items_per_row %}
              {% assign scroll_animation_custom = scroll_animation %}
            {% else %}
              {% assign scroll_animation_custom = blank %}
            {% endif %}
            <motion-element
              data-motion="fade-up-lg"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              data-motion-delay="{{ forloop.index0 | times: 50 }}"
              class="brand-item block {% if scroll_animation_custom != 'none' %} scroll-trigger {{ scroll_animation_custom }}{% endif %}"
              style="
                {%- if scroll_animation_custom != 'none' -%}
                  --animation-order: {{  forloop.index }}
                {% endif %}
              "
            >
              <a
                aria-label="{{ 'sections.brand_logo.alt' | t }}"
                {% if block_st.link == blank %}
                  role="link"
                  aria-disabled="true"
                {% else %}
                  href="{{ block_st.link }}"
                {% endif %}
                {%- if section_st.open_link_newtab != blank -%}
                  target="_blank"
                {%- else -%}
                  target="_self"
                {% endif %}
              >
                <div
                  class="brand-image transition mx-auto w-custom max-w-100 {{ framed }} rounded"
                  style="{{ style_ratio | strip | strip_newlines }}"
                >
                  {%- assign demo_bl = '' -%}
                  {%- if image == blank -%}
                    {%- capture demo_bl -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}
                    {%- assign demo_bl = demo_bl | strip -%}
                  {%- endif -%}
                  {% if image != blank %}
                    {%- liquid
                      assign alt = 'sections.brand_logo.alt' | t
                      if image.alt
                        assign alt = image.alt | escape
                      endif
                      assign sizes = block_st.image_width | append: 'px'
                    -%}
                    {% render 'responsive-image',
                      type: 'other',
                      container: section_width,
                      image: image,
                      image_alt: alt,
                      colunm: items_per_row,
                      colunm_mobile: items_per_row_mobile,
                      padding: column_gap,
                      sizes: sizes,
                      class: 'brand-image transition rounded '
                    %}
                  {% elsif demo_bl != blank %}
                    <img src="{{ demo_bl }}" alt="{{ 'sections.brand_logo.alt' | t }}" class="brand-image transition rounded" loading="lazy" style="max-width:100%;">
                  {% else %}
                    {% render 'placeholder-render', class: 'rounded' %}
                  {% endif %}
                </div>
              </a>
            </motion-element>
          </div>
        {%- endfor -%}
      </div>
      {%- if carousel_pagination == 'show_dots'
        or carousel_pagination == 'show_dots_on_mobile'
        or carousel_pagination == 'show_progress_bar'
      -%}
      <motion-element
        data-motion="fade-up-sm"
        {% if scroll_animation != 'slide_in' %}
          hold
        {% endif %}
        data-motion-delay="150"
        class="swiper-pagination  flex flex-wrap  {% if scroll_animation == 'slide_in' %} slide_in scroll-trigger {% endif %}   px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ section_st.pagination_position | default: 'center' }}{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
        style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
      >   
      </motion-element>
      {% endif %}
    </slide-section>
  </div>
</div>


</template>

<schema>
{
  "type": "brand-logo",
  "name": "Brand logo",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "fluid_container",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Brand logo",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Show view all button"
    },
    {
      "type": "url",
      "id": "view_all_button_link",
      "label": "View all button link"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Header Typography"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Items / Layout"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Items per row",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom ratio"
    },
    {
      "type": "range",
      "id": "img_width",
      "label": "Img width",
      "min": 80,
      "max": 300,
      "step": 5,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Item Content"
    },
    {
      "type": "checkbox",
      "id": "open_link_newtab",
      "label": "Open link newtab",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "framed",
      "label": "Framed",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow",
      "default": false
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Carousel pagination",
      "options": [
        {
          "value": "disable",
          "label": "Disable"
        },
        {
          "value": "show_dots",
          "label": "Show dots"
        },
        {
          "value": "show_dots_on_mobile",
          "label": "Show dots on mobile"
        },
        {
          "value": "show_progress_bar",
          "label": "Show progress bar"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "default": "pill",
      "options": [
        {
          "value": "dot",
          "label": "Dot (default)"
        },
        {
          "value": "pill",
          "label": "Pill (active expands)"
        },
        {
          "value": "line",
          "label": "Line / bar"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "ring",
          "label": "Ring (hollow)"
        },
        {
          "value": "number",
          "label": "Numbers"
        },
        {
          "value": "progress",
          "label": "Progress fill"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_position",
      "label": "Pagination position (desktop)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Autorotate speed",
      "max": 6,
      "min": 2,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_34",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Items per row mobile",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Advanced"
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Section margin (around the section)"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
