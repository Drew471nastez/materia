<template>
<section class="fw fw-benefits" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.heading }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner fw-benefits__inner">
  {% for block in blocks %}
   <div class="fw-benefits__item" data-block-id="{{ block.id }}"><span class="fw-benefits__number">{{ block.settings.symbol }}</span><span><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.text }}</small></span></div>
  {% endfor %}
  {% if blocks.size == 0 and page.in_editor %}<p>Add benefit blocks in the sidebar.</p>{% endif %}
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--theme-font-body),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) clamp(18px,4vw,48px) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:11px;font-weight:var(--subheading-weight,800);letter-spacing:.16em;text-transform:uppercase;color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading)),sans-serif;font-size:var(--section-heading-size,clamp(30px,4.2cqi,56px));font-weight:var(--section-heading-weight,650);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.044em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--theme-font-body),sans-serif;font-size:var(--section-text-size,clamp(15px,1.45cqi,18px));line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-family:var(--theme-font-body),sans-serif;font-weight:var(--type-button-weight,650);font-size:var(--type-button-size,14px);letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text)!important;border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw__action:hover{background:var(--scheme-button-primary-hover,var(--fw-button));color:var(--scheme-button-primary-hover-text,var(--fw-button-text))!important;}
.fw__action--secondary{background:transparent!important;color:var(--fw-title)!important;border-color:var(--fw-line);}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-benefits{border-top:1px solid var(--fw-line);border-bottom:1px solid var(--fw-line)}.fw-benefits__inner{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.fw-benefits__item{display:flex;align-items:flex-start;gap:15px}.fw-benefits__number{display:grid;place-items:center;height:37px;width:37px;flex:none;border:1px solid var(--fw-line);border-radius:11px;color:var(--fw-title);font-size:18px}.fw-benefits__item strong,.fw-benefits__item small{display:block}.fw-benefits__item strong{font-size:14px;color:var(--fw-title);font-weight:var(--subheading-weight,680)}.fw-benefits__item small{font-size:12px;color:var(--fw-muted);line-height:1.6;margin-top:5px}
@container(max-width:700px){.fw-benefits__inner{grid-template-columns:1fr;gap:22px}.fw-benefits__item{align-items:center}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_benefits",
  "name": "Foundation / Benefits ribbon",
  "category": "features",
  "description": "Concise trust and service benefits with responsive customisable blocks.",
  "version": "1.0.0",
  "icon": "check-circle",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 24,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 24,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "none",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "slide_left",
          "label": "From the right"
        },
        {
          "value": "slide_right",
          "label": "From the left"
        }
      ]
    }
  ],
  "presets": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "symbol",
          "label": "Symbol",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Designed with care"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "Small details, better everyday experiences."
        }
      ]
    }
  ]
}
</schema>
