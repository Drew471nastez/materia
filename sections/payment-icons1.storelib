<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Payment icons: a short heading and line over the payment
  methods the shop accepts.

  Eyebrow, heading, subheading and button blocks above the icons; a switch per
  payment method. Colours follow the colour scheme and fonts follow Theme
  settings > Typography until custom styling or custom fonts are switched
  on. The older headline and subheading settings are kept for saved pages and
  shown only while the section has no heading or subheading block. Shared
  rules: snippets/logos-style; the builder's live edits: assets/live-logos.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign own = st.enable_custom_style
  assign fonts = st.override_fonts
  assign has_heading = false
  assign has_sub = false
  for block in section.blocks
    if block.type == 'heading'
      assign has_heading = true
    elsif block.type == 'subheading'
      assign has_sub = true
    endif
  endfor
  assign own_lh = false
  if st.headline_line_height != blank and st.headline_line_height != 'inherit'
    assign own_lh = true
  endif
  assign anim_class = ''
  if settings.scroll_animation != blank and settings.scroll_animation != 'none'
    assign anim_class = ' scroll-trigger ' | append: settings.scroll_animation
  endif
-%}
{% render 'logos-style', section: section, bp: 801, margins: true %}
<style>
  {%- if fonts -%}{{ st.headline_font | font_face: font_display: 'swap' }}{{ st.text_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .pi { padding-left: var(--pi-px-m); padding-right: var(--pi-px-m); }
  #shopify-section-{{ sid }} .pi .lg-head { gap: var(--pi-gap); margin-bottom: var(--pi-head-gap); max-width: none; }
  #shopify-section-{{ sid }} .pi .lg__heading[data-own-size] { line-height: var(--pi-hlh); }
  #shopify-section-{{ sid }} .pi .lg__sub, #shopify-section-{{ sid }} .pi .lg__sub p { line-height: var(--pi-tlh); max-width: none; }
  #shopify-section-{{ sid }} .pi__icons { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px var(--pi-icon-gap-m); }
  #shopify-section-{{ sid }} .pi[data-align-m='left'] :is(.lg-head, .pi__icons) { align-items: flex-start; text-align: left; justify-content: flex-start; margin-left: 0; }
  #shopify-section-{{ sid }} .pi[data-align-m='right'] :is(.lg-head, .pi__icons) { align-items: flex-end; text-align: right; justify-content: flex-end; margin-right: 0; }
  #shopify-section-{{ sid }} .pi[data-align-m='right'] .pi__icons { align-items: center; }
  #shopify-section-{{ sid }} .pi[data-align-m='left'] .pi__icons { align-items: center; }
  #shopify-section-{{ sid }} .pi__icon { display: block; height: var(--pi-icon-h-m); width: auto; transition: transform var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .pi__icon--outline { border: 0.4px solid #d3d3d3; border-radius: 5px; }
  #shopify-section-{{ sid }} .pi__icon:hover { transform: scale(1.05); }
  #shopify-section-{{ sid }} .pi[data-show='desktop'] { display: none; }
  @media (min-width: 801px) {
    #shopify-section-{{ sid }} .pi { padding-left: var(--pi-px-d); padding-right: var(--pi-px-d); }
    #shopify-section-{{ sid }} .pi[data-show='desktop'] { display: block; }
    #shopify-section-{{ sid }} .pi[data-show='mobile'] { display: none; }
    #shopify-section-{{ sid }} .pi__icons { gap: 8px var(--pi-icon-gap-d); }
    #shopify-section-{{ sid }} .pi__icon { height: var(--pi-icon-h-d); }
    #shopify-section-{{ sid }} .pi :is(.lg-head, .pi__icons) { align-items: center; text-align: center; justify-content: center; margin-inline: auto; }
    #shopify-section-{{ sid }} .pi[data-align='left'] :is(.lg-head, .pi__icons) { align-items: flex-start; text-align: left; justify-content: flex-start; margin-left: 0; }
    #shopify-section-{{ sid }} .pi[data-align='right'] :is(.lg-head, .pi__icons) { align-items: flex-end; text-align: right; justify-content: flex-end; margin-right: 0; }
    #shopify-section-{{ sid }} .pi[data-align] .pi__icons { align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .pi__icon { transition: none; } #shopify-section-{{ sid }} .pi__icon:hover { transform: none; } }
{% comment %}{% endcomment %}</style>
<div id="loud-{{ sid }}" class="lg pi loud-wrap color-{{ scheme }} gradient" {% render 'logos-root', part: 'attrs', section: section, type: 'payment-icons1', width: st.section_width, fonts: fonts %} data-show="{{ st.show_on_device | default: 'all' }}" data-align="{{ st.text_alignment | default: 'center' }}" data-align-m="{{ st.mobile_text_alignment | default: 'center' }}" data-reveal="{% if st.reveal %}true{% else %}false{% endif %}" data-lg-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;full_width&quot;,&quot;reset_spacing&quot;:true,&quot;show_on_device&quot;:&quot;all&quot;,&quot;headline&quot;:&quot;Trusted Payments&quot;,&quot;text&quot;:&quot;We accept multiple payment options! See the list below for more information.&quot;,&quot;show_visa&quot;:true,&quot;show_mastercard&quot;:true,&quot;show_discover&quot;:true,&quot;show_paypal&quot;:true,&quot;show_apple_pay&quot;:true,&quot;show_google_pay&quot;:true,&quot;show_shop_pay&quot;:false,&quot;text_alignment&quot;:&quot;center&quot;,&quot;element_spacing&quot;:15,&quot;headline_spacing&quot;:13,&quot;icon_height&quot;:40,&quot;icon_gap&quot;:27,&quot;enable_custom_style&quot;:false,&quot;override_fonts&quot;:false,&quot;headline_font&quot;:&quot;sans-serif&quot;,&quot;text_font&quot;:&quot;sans-serif&quot;,&quot;headline_line_height&quot;:&quot;inherit&quot;,&quot;text_line_height&quot;:&quot;inherit&quot;,&quot;headline_size&quot;:33,&quot;text_size&quot;:16,&quot;reveal&quot;:true,&quot;section_padding_top_bottom&quot;:30,&quot;section_padding_left_right&quot;:30,&quot;section_margin_top_desktop&quot;:0,&quot;section_margin_bottom_desktop&quot;:0,&quot;mobile_text_alignment&quot;:&quot;center&quot;,&quot;mobile_icon_height&quot;:29,&quot;mobile_icon_gap&quot;:10,&quot;mobile_section_padding_top_bottom&quot;:30,&quot;mobile_section_padding_left_right&quot;:9,&quot;section_margin_top_mobile&quot;:0,&quot;section_margin_bottom_mobile&quot;:0,&quot;mobile_headline_size&quot;:31,&quot;mobile_text_size&quot;:14&#125;" data-lg-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Secure checkout&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:13,&quot;uppercase&quot;:true&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Trusted payments&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:33,&quot;size_mobile&quot;:31&#125;,&quot;subheading&quot;:&#123;&quot;text&quot;:&quot;&lt;p&gt;Pay with the method you already use.&lt;/p&gt;&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:16,&quot;size_mobile&quot;:14&#125;,&quot;button&quot;:&#123;&quot;label&quot;:&quot;Shop now&quot;,&quot;button_style&quot;:&quot;primary&quot;,&quot;full_width&quot;:false,&quot;enable_custom_style&quot;:false,&quot;use_theme_button&quot;:true,&quot;padding_x&quot;:26,&quot;padding_y&quot;:14,&quot;radius&quot;:8,&quot;border_width&quot;:1,&quot;font_size&quot;:14,&quot;font_weight&quot;:&quot;600&quot;,&quot;uppercase&quot;:false&#125;&#125;" style="{% render 'logos-root', section: section, custom: own, bg: st.section_background_color, text: st.text_color, heading: st.text_color, fonts: fonts, hfont: st.headline_font, bfont: st.text_font, pt_d: st.section_padding_top_bottom, pb_d: st.section_padding_top_bottom, pt_m: st.mobile_section_padding_top_bottom, pb_m: st.mobile_section_padding_top_bottom, px_d: 0, px_m: 0 %}--pi-px-d: {{ st.section_padding_left_right | default: 0 }}px;--pi-px-m: {{ st.mobile_section_padding_left_right | default: 0 }}px;--pi-gap: {{ st.element_spacing | default: 0 }}px;--pi-head-gap: {{ st.headline_spacing | default: 0 }}px;--pi-hlh: {% if own_lh %}{{ st.headline_line_height }}{% else %}var(--heading-line-height, 1.2){% endif %};--pi-tlh: {% if st.text_line_height != blank and st.text_line_height != 'inherit' %}{{ st.text_line_height }}{% else %}var(--body-line-height, 1.6){% endif %};--pi-icon-h-d: {{ st.icon_height | default: 40 }}px;--pi-icon-h-m: {{ st.mobile_icon_height | default: 29 }}px;--pi-icon-gap-d: {{ st.icon_gap | default: 0 }}px;--pi-icon-gap-m: {{ st.mobile_icon_gap | default: 0 }}px;">
  <div class="lg__inner loud-container">
    <div class="lg-head loud-headline">
      {%- for block in section.blocks -%}{%- render 'logos-text', block: block, own_size: own_lh -%}{%- endfor -%}
      {%- if has_heading == false and st.headline != blank -%}<h2 class="lg__heading" data-lg-legacy="heading"{% if own_lh %} data-own-size{% endif %} style="--b-c: var(--lg-heading);--b-fs-m: {{ st.mobile_headline_size | default: 31 }}px;--b-fs-d: {{ st.headline_size | default: 33 }}px;">{{ st.headline }}</h2>{%- endif -%}
      {%- if has_sub == false and st.text != blank -%}<div class="lg__sub" data-lg-legacy="subheading" style="--b-c: var(--lg-text);--b-fs-m: {{ st.mobile_text_size | default: 14 }}px;--b-fs-d: {{ st.text_size | default: 16 }}px;"><p>{{ st.text }}</p></div>{%- endif -%}
    </div>
    <div class="pi__icons loud-col{{ anim_class }}" data-lg-reveal-item>
        <img class="pi__icon" data-lg-pay="mastercard" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' height='48' viewBox='0 0 70 48' width='70'%3E%3Crect fill='%23fff' height='47' rx='5.5' stroke='%23d9d9d9' width='69' x='.5' y='.5'/%3E%3Cg clip-rule='evenodd' fill-rule='evenodd'%3E%3Cpath d='m35.3945 34.7619c-2.3831 2.0565-5.4745 3.298-8.8524 3.298-7.5374 0-13.6476-6.1811-13.6476-13.8059 0-7.6249 6.1102-13.806 13.6476-13.806 3.3779 0 6.4693 1.2415 8.8524 3.2981 2.3832-2.0566 5.4745-3.2981 8.8525-3.2981 7.5373 0 13.6475 6.1811 13.6475 13.806 0 7.6248-6.1102 13.8059-13.6475 13.8059-3.378 0-6.4693-1.2415-8.8525-3.298z' fill='%23ed0006'/%3E%3Cpath d='m35.3945 34.7619c2.9344-2.5323 4.7951-6.3003 4.7951-10.5079 0-4.2077-1.8607-7.9757-4.7951-10.5079 2.3832-2.0566 5.4745-3.2981 8.8525-3.2981 7.5373 0 13.6475 6.1811 13.6475 13.806 0 7.6248-6.1102 13.8059-13.6475 13.8059-3.378 0-6.4693-1.2415-8.8525-3.298z' fill='%23f9a000'/%3E%3Cpath d='m35.3946 13.7461c2.9344 2.5323 4.7951 6.3002 4.7951 10.5079 0 4.2076-1.8607 7.9755-4.7951 10.5078-2.9343-2.5323-4.795-6.3002-4.795-10.5078 0-4.2077 1.8607-7.9756 4.795-10.5079z' fill='%23ff5e00'/%3E%3C/g%3E%3C/svg%3E" alt="{{ 'payment.methods.mastercard' | t }}" loading="lazy" decoding="async"{% unless st.show_mastercard %} hidden{% endunless %}>
        <img class="pi__icon" data-lg-pay="american_express" src="data:image/svg+xml,%3Csvg width='780' height='500' enable-background='new 0 0 780 500' version='1.1' viewBox='0 0 780 500' xml:space='preserve' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='m40 1e-3h700c22.092 0 40 17.909 40 40v420c0 22.092-17.908 40-40 40h-700c-22.091 0-40-17.908-40-40v-420c0-22.091 17.909-40 40-40z' fill='%232557D6'/%3E%3Cpath d='m0.253 235.69h37.441l8.442-19.51h18.9l8.42 19.51h73.668v-14.915l6.576 14.98h38.243l6.576-15.202v15.138h183.08l-0.085-32.026h3.542c2.479 0.083 3.204 0.302 3.204 4.226v27.8h94.689v-7.455c7.639 3.92 19.518 7.455 35.148 7.455h39.836l8.525-19.51h18.9l8.337 19.51h76.765v-18.532l11.626 18.532h61.515v-122.51h-60.88v14.468l-8.522-14.468h-62.471v14.468l-7.828-14.468h-84.38c-14.123 0-26.539 1.889-36.569 7.153v-7.153h-58.229v7.153c-6.383-5.426-15.079-7.153-24.75-7.153h-212.74l-14.274 31.641-14.659-31.641h-67.005v14.468l-7.362-14.468h-57.145l-26.539 58.246v64.261h3e-3zm236.34-17.67h-22.464l-0.083-68.794-31.775 68.793h-19.24l-31.858-68.854v68.854h-44.57l-8.42-19.592h-45.627l-8.505 19.592h-23.801l39.241-87.837h32.559l37.269 83.164v-83.164h35.766l28.678 59.587 26.344-59.587h36.485l1e-3 87.838zm-165.9-37.823l-14.998-35.017-14.915 35.017h29.913zm255.3 37.821h-73.203v-87.837h73.203v18.291h-51.289v15.833h50.06v18.005h-50.061v17.542h51.289l1e-3 18.166zm103.16-64.18c0 14.004-9.755 21.24-15.439 23.412 4.794 1.748 8.891 4.838 10.84 7.397 3.094 4.369 3.628 8.271 3.628 16.116v17.255h-22.104l-0.083-11.077c0-5.285 0.528-12.886-3.458-17.112-3.202-3.09-8.083-3.76-15.973-3.76h-23.523v31.95h-21.914v-87.838h50.401c11.199 0 19.451 0.283 26.535 4.207 6.933 3.924 11.09 9.652 11.09 19.45zm-27.699 13.042c-3.013 1.752-6.573 1.81-10.841 1.81h-26.62v-19.51h26.982c3.818 0 7.804 0.164 10.393 1.584 2.842 1.28 4.601 4.003 4.601 7.765 0 3.84-1.674 6.929-4.515 8.351zm62.844 51.138h-22.358v-87.837h22.358v87.837zm259.56 0h-31.053l-41.535-65.927v65.927h-44.628l-8.527-19.592h-45.521l-8.271 19.592h-25.648c-10.649 0-24.138-2.257-31.773-9.715-7.701-7.458-11.708-17.56-11.708-33.533 0-13.027 2.395-24.936 11.812-34.347 7.085-7.01 18.18-10.242 33.28-10.242h21.215v18.821h-20.771c-7.997 0-12.514 1.14-16.862 5.203-3.735 3.699-6.298 10.69-6.298 19.897 0 9.41 1.951 16.196 6.023 20.628 3.373 3.476 9.506 4.53 15.272 4.53h9.842l30.884-69.076h32.835l37.102 83.081v-83.08h33.366l38.519 61.174v-61.174h22.445v87.833zm-133.2-37.82l-15.165-35.017-15.081 35.017h30.246zm189.04 178.08c-5.322 7.457-15.694 11.238-29.736 11.238h-42.319v-18.84h42.147c4.181 0 7.106-0.527 8.868-2.175 1.665-1.474 2.605-3.554 2.591-5.729 0-2.561-1.064-4.593-2.677-5.811-1.59-1.342-3.904-1.95-7.722-1.95-20.574-0.67-46.244 0.608-46.244-27.194 0-12.742 8.443-26.156 31.439-26.156h43.649v-17.479h-40.557c-12.237 0-21.129 2.81-27.425 7.174v-7.175h-59.985c-9.595 0-20.854 2.279-26.179 7.175v-7.175h-107.12v7.175c-8.524-5.892-22.908-7.175-29.549-7.175h-70.656v7.175c-6.745-6.258-21.742-7.175-30.886-7.175h-79.077l-18.094 18.764-16.949-18.764h-118.13v122.59h115.9l18.646-19.062 17.565 19.062 71.442 0.061v-28.838h7.021c9.479 0.14 20.66-0.228 30.523-4.312v33.085h58.928v-31.952h2.842c3.628 0 3.985 0.144 3.985 3.615v28.333h179.01c11.364 0 23.244-2.786 29.824-7.845v7.845h56.78c11.815 0 23.354-1.587 32.134-5.649l2e-3 -22.84zm-354.94-47.155c0 24.406-19.005 29.445-38.159 29.445h-27.343v29.469h-42.591l-26.984-29.086-28.042 29.086h-86.802v-87.859h88.135l26.961 28.799 27.875-28.799h70.021c17.389 0 36.929 4.613 36.929 28.945zm-174.22 40.434h-53.878v-17.48h48.11v-17.926h-48.11v-15.974h54.939l23.969 25.604-25.03 25.776zm86.81 10.06l-33.644-35.789 33.644-34.65v70.439zm49.757-39.066h-28.318v-22.374h28.572c7.912 0 13.404 3.09 13.404 10.772 0 7.599-5.238 11.602-13.658 11.602zm148.36-40.373h73.138v18.17h-51.315v15.973h50.062v17.926h-50.062v17.48l51.314 0.08v18.23h-73.139l2e-3 -87.859zm-28.119 47.029c4.878 1.725 8.865 4.816 10.734 7.375 3.095 4.291 3.542 8.294 3.631 16.037v17.418h-22.002v-10.992c0-5.286 0.531-13.112-3.542-17.198-3.201-3.147-8.083-3.8