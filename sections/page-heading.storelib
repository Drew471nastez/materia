<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign t = template | split: '.' | first
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign background_image = section_st.background_image
  assign height = section_st.height
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};{%- if background_image != blank and height == 'adapt' -%}--aspect-ratio: {{ background_image.aspect_ratio }};{% endif %}--overlay-opacity: {{ section_st.overlay_opacity }}%;
{%- endcapture -%}
{%- if section.blocks.size > 0 -%}
  <div
    class="section{% if section_st.reset_spacing %} remove_spacing{% endif %} sec__page-heading color-{{ color_scheme }} gradient{% if background_image != blank %} bg-transparent relative{% if section_st.reset_spacing == false %} mb-60{% endif %}{% else %}{% if section_st.reset_spacing == false %} mb-60{% endif %}{% endif %} align-center justify-content-{{ section_st.alignment }}{% if t == 'cart' and cart == empty %} hidden{% else %} flex{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    {%- if background_image != blank -%}
      <div class="overlay-bg">
        {%- assign image_alt = background_image.alt | default: 'product' | escape -%}
        {% render 'responsive-image',
          type: 'banner',
          container: section_width,
          image: background_image,
          image_alt: image_alt,
          class: 'background-heading absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover'
        %}
      </div>
    {% endif %}
    <div class="{{ section_width }}">
      <div class="heading-content relative text-{{ section_st.alignment }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
            assign header_size = ''
            if block_st.header_size == 'small'
              assign header_size = 'h3'
            elsif block_st.header_size == 'large'
              assign header_size = 'h1-size'
            endif
          -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="50"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
               data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="{% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
              >
                <h1
                  class="heading-title heading-letter-spacing h2 mt-8 mb-0 {{ header_size }}"
                  style="margin-bottom: {{ block_st.vertical_gap | default: 0 }}px;{% if block_st.header_size == 'medium' %} font-size: {{ block_st.heading_font_size }}px;{% endif %}{% if block_st.enable_heading_color %} color: {% render 'scheme-color', color: block_st.heading_color, fallback: 'var(--color-heading)' %};{% endif %}"
                >
                  {%- if block_st.page_title != blank -%}
                    {{ block_st.page_title }}
                  {%- else -%}
                    {% if template contains 'blog' %}
                      {{ blog.title }}
                    {% elsif template contains 'cart' %}
                      {{- 'general.cart.title' | t -}}
                    {% else %}
                      {{ page.title }}
                    {% endif %}
                  {% endif %}
                </h1>
              </motion-element>
            {%- when 'description' -%}
              {% if block_st.description != blank or page.content != blank %}
                <motion-element
                  data-motion="fade-up-lg"
                  {% if scroll_animation != 'slide_in' %}
                    hold
                  {% endif %}
                  data-motion-delay="{{ forloop.index0 | times: 50 }}"
                  class="heading-description block {% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} mt-10 rich__text-m0"
                  style="color: {% render 'scheme-color', color: block_st.description_color, fallback: 'var(--color-text)' %}; font-size: {{ block_st.description_font_size | default: 15 }}px;"
                >
                  {% if block_st.description != blank -%}
                    {{- block_st.description -}}
                  {%- else %}
                    {{ page.content -}}
                  {%- endif %}
                </motion-element>
              {% endif %}
            {%- when 'breadcrumb' -%}
              <motion-element
                data-motion="fade-up-lg"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
               data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="{% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
              >
                <div class="page-title-breadcrumb">
                  {%- render 'breadcrumbs' -%}
                </div>
              </motion-element>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}


</template>

<schema>
{
  "type": "page-heading",
  "name": "Page heading",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Style & Colors"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "based_on_content",
          "label": "Based on content"
        }
      ],
      "default": "adapt",
      "label": "Section height"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Advanced"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "settings": [],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "General"
        },
        {
          "type": "checkbox",
          "id": "enable_heading_color",
          "label": "Enable custom heading color",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Header Typography"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color"
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "label": "Heading font size",
          "min": 16,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 34
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "page_title",
          "label": "Page title"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Typography"
        },
        {
          "type": "select",
          "id": "header_size",
          "label": "Header size",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_10",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "vertical_gap",
          "label": "Spacing below heading",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 8
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Typography"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description color",
          "default": "#767676"
        },
        {
          "type": "range",
          "id": "description_font_size",
          "label": "Description font size",
          "min": 12,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 15
        }
      ],
      "limit": 2
    }
  ],
  "max_blocks": 3,
  "shopify": {
    "name": "t:sections.all.page_heading.label",
    "tag": "section",
    "class": "page-title",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ],
        "default": "stretch_width",
        "label": "Section width"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Image / Media"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "header",
        "content": "Style & Colors"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Overlay opacity",
        "default": 0
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "select",
        "id": "height",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.all.page_heading.height.option__1"
          },
          {
            "value": "based_on_content",
            "label": "t:sections.all.page_heading.height.option__2"
          }
        ],
        "default": "adapt",
        "label": "Section height"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 80,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "t:sections.all.content_settings.content_alignment.left.label"
          },
          {
            "value": "center",
            "label": "t:sections.all.content_settings.content_alignment.center.label"
          },
          {
            "value": "right",
            "label": "t:sections.all.content_settings.content_alignment.right.label"
          }
        ]
      }
    ],
    "max_blocks": 3,
    "blocks": [
      {
        "type": "breadcrumb",
        "name": "t:sections.all.page_heading.breadcrumb.label",
        "limit": 1
      },
      {
        "type": "heading",
        "name": "t:sections.all.page_heading.heading.label",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "General"
          },
          {
            "type": "checkbox",
            "id": "enable_heading_color",
            "label": "Enable custom heading color",
            "default": false
          },
          {
            "type": "header",
            "content": "Header Typography"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading color",
            "visible_if": "{{ block.settings.enable_heading_color }}"
          },
          {
            "type": "range",
            "id": "heading_font_size",
            "label": "Heading font size",
            "min": 16,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 34,
            "visible_if": "{{ block.settings.header_size == 'medium' }}"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "page_title",
            "label": "t:sections.all.page_heading.heading.label",
            "info": "t:sections.all.page_heading.heading.info"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "select",
            "id": "header_size",
            "label": "t:sections.all.content_settings.font_size.label",
            "default": "default",
            "options": [
              {
                "value": "default",
                "label": "t:sections.all.content_settings.font_size.default.label"
              },
              {
                "value": "small",
                "label": "t:sections.all.content_settings.font_size.small.label"
              },
              {
                "value": "medium",
                "label": "Custom"
              },
              {
                "value": "large",
                "label": "t:sections.all.content_settings.font_size.large.label"
              }
            ]
          },
          {
            "type": "header",
            "content": "Layout & Spacing"
          },
          {
            "type": "range",
            "id": "vertical_gap",
            "label": "Spacing below heading",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 8
          }
        ]
      },
      {
        "type": "description",
        "name": "Description",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Description"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "color",
            "id": "description_color",
            "label": "Description color"
          },
          {
            "type": "range",
            "id": "description_font_size",
            "label": "Description font size",
            "min": 12,
            "max": 36,
            "step": 1,
            "unit": "px",
            "default": 15
          }
        ]
      }
    ]
  }
}
</schema>
