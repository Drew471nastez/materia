<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
  /* Height: Adapt to image keeps the picture's shape; the picture fills it. */
  #shopify-section-{{ section.id }} .sec__page-heading[style*="--aspect-ratio"] { aspect-ratio: var(--aspect-ratio); }
  #shopify-section-{{ section.id }} .sec__page-heading .overlay-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  /* Overlay opacity: a dark layer over the background image. */
  #shopify-section-{{ section.id }} .sec__page-heading .overlay-bg::after { content: ""; position: absolute; inset: 0; background: #000000; opacity: var(--overlay-opacity, 0%); pointer-events: none; }
  /* Top and bottom padding: applied here too, at zero specificity so the theme's own spacing rule still wins where it exists. */
  :where(#shopify-section-{{ section.id }} .sec__page-heading) { padding-top: calc(var(--section-pt, 0) * 1px); padding-bottom: calc(var(--section-pb, 0) * 1px); }
  /* Custom heading size, a little smaller on phones. */
  #shopify-section-{{ section.id }} .heading-title.is-custom-size { font-size: var(--ph-size); }
  /* Description size reaches the paragraphs inside the rich text. */
  #shopify-section-{{ section.id }} .heading-description { font-size: var(--ph-desc-size, 15px); }
  #shopify-section-{{ section.id }} .heading-description :is(p, li, span) { font-size: inherit; color: inherit; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .heading-title.is-custom-size { font-size: max(16px, calc(var(--ph-size) * 0.82)); }
    #shopify-section-{{ section.id }} .heading-description { font-size: max(13px, calc(var(--ph-desc-size, 15px) * 0.94)); }
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign t = template | split: '.' | first
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign background_image = section_st.background_image
  assign height = section_st.height
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};{%- if background_image != blank and height == 'adapt' -%}--aspect-ratio: {{ background_image.aspect_ratio }};{% endif %}--overlay-opacity: {{ section_st.overlay_opacity }}%;
{%- endcapture -%}
{%- liquid
  comment
    The page's own title and text, shown when the heading or description
    block is left empty. The live controller reads them back from the page.
  endcomment
  if template contains 'blog'
    assign ph_title = blog.title | default: page_title
  elsif template contains 'cart'
    assign ph_title = 'general.cart.title' | t
  else
    assign ph_title = page.title | default: page_title
  endif
  assign ph_justify = 'center'
  if section_st.alignment == 'left'
    assign ph_justify = 'flex-start'
  elsif section_st.alignment == 'right'
    assign ph_justify = 'flex-end'
  endif
-%}
{%- if section.blocks.size > 0 -%}
  {%- comment -%} The breadcrumb trail: the same separators and colours as the Breadcrumbs section, every value a variable on the trail. {%- endcomment -%}
  <style>
    #shopify-section-{{ section.id }} .bc {
      font-family: var(--bc-font, var(--body-font, inherit));
      font-size: var(--bc-size, 13px);
      font-weight: var(--body-weight, 400);
      line-height: 1.4;
    }
    #shopify-section-{{ section.id }} .bc[data-bc-upper] { text-transform: uppercase; letter-spacing: 0.06em; }
    #shopify-section-{{ section.id }} .bc__trail {
      display: flex; align-items: center; flex-wrap: wrap; row-gap: 4px; min-width: 0; margin: 0; padding: 0; list-style: none;
      justify-content: var(--bc-justify, center);
    }
    #shopify-section-{{ section.id }} .bc__item { display: inline-flex; align-items: center; min-width: 0; }
    #shopify-section-{{ section.id }} .bc__item + .bc__item::before {
      flex: none; margin-inline: 10px; color: color-mix(in srgb, var(--bc-link) 70%, transparent);
      content: ""; width: 6px; height: 6px; border: solid currentColor; border-width: 1.5px 1.5px 0 0; transform: scaleX(var(--rtl-flip, 1)) rotate(45deg); margin-inline: 9px 11px;
    }
    #shopify-section-{{ section.id }} .bc[data-bc-sep="slash"] .bc__item + .bc__item::before { content: "/"; width: auto; height: auto; border: 0; transform: none; margin-inline: 10px; }
    #shopify-section-{{ section.id }} .bc[data-bc-sep="dot"] .bc__item + .bc__item::before { content: ""; width: 3px; height: 3px; border: 0; border-radius: 50%; background: currentColor; transform: none; margin-inline: 10px; }
    #shopify-section-{{ section.id }} .bc__link {
      position: relative;
      color: var(--bc-link); text-decoration: none; white-space: nowrap;
      background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
      transition: color .2s ease, background-size .3s cubic-bezier(.2,.7,.2,1);
    }
    #shopify-section-{{ section.id }} .bc__link::after { content: ""; position: absolute; inset: calc(50% - 22px) 0; }
    #shopify-section-{{ section.id }} .bc__link:is(:hover, :focus-visible) { color: var(--bc-current); background-size: 100% 1px; }
    #shopify-section-{{ section.id }} .bc__link:focus-visible { outline: 2px solid var(--bc-current); outline-offset: 3px; border-radius: 2px; }
    #shopify-section-{{ section.id }} .bc__current { color: var(--bc-current); overflow-wrap: anywhere; }
    @media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .bc__link { transition: none; } }
  {% comment %}{% endcomment %}</style>
  {%- for block in section.blocks -%}
    {%- if block.settings.enable_custom_fonts -%}<style>{{ block.settings.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
  {%- endfor -%}
  <div
    class="section{% if section_st.reset_spacing %} remove_spacing{% endif %} sec__page-heading color-{{ color_scheme }} gradient{% if background_image != blank %} bg-transparent relative{% if section_st.reset_spacing == false %} mb-60{% endif %}{% else %}{% if section_st.reset_spacing == false %} mb-60{% endif %}{% endif %} align-center justify-content-{{ section_st.alignment }}{% if t == 'cart' and cart == empty %} hidden{% else %} flex{% endif %}"
    style="{{ style | strip | strip_newlines }}"
    data-lcp="page-heading"
    data-lcp-id="{{ section.id }}"
    data-lcp-settings="{{ section.settings | json | escape }}"
  >
    {%- if background_image != blank -%}
      <div class="overlay-bg">
        {%- assign image_alt = background_image.alt | default: 'product' | escape -%}
        {% render 'responsive-image',
          type: 'banner',
          container: section_width,
          image: background_image,
          image_alt: image_alt,
          class: 'background-heading absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover'
        %}
      </div>
    {% endif %}
    <div class="{{ section_width }}">
      <div class="heading-content relative text-{{ section_st.alignment }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
            assign header_size = 'h2'
            if block_st.header_size == 'small'
              assign header_size = 'h3'
            elsif block_st.header_size == 'large'
              assign header_size = 'h1 h1-size'
            elsif block_st.header_size == 'medium'
              assign header_size = 'h2 is-custom-size'
            endif
            assign block_font = ''
            if block_st.enable_custom_fonts and block_st.font.family != blank
              assign block_font = block_st.font.family
              if block_st.font.fallback_families != blank
                assign block_font = block_font | append: ', ' | append: block_st.font.fallback_families
              endif
            endif
          -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <motion-element
                data-motion="fade-up-lg"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="{% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
                data-lcp-block="{{ block.id }}"
                data-lcp-block-type="heading"
                data-lcp-block-settings="{{ block.settings | json | escape }}"
                {{ block.shopify_attributes }}
              >
                <h1
                  class="heading-title heading-letter-spacing mt-8 mb-0 {{ header_size }}"
                  data-lcp-fallback="{{ ph_title | strip | escape }}"
                  {%- if block_font != blank %} data-own-font{% endif %}
                  style="margin-bottom: {{ block_st.vertical_gap | default: 0 }}px;{% if block_st.header_size == 'medium' %} --ph-size: {{ block_st.heading_font_size | default: 34 }}px;{% endif %}{% if block_st.enable_heading_color %} color: {% render 'scheme-color', color: block_st.heading_color, fallback: 'var(--color-heading)' %};{% endif %}{% if block_font != blank %} font-family: {{ block_font }};{% endif %}"
                >
                  {%- if block_st.page_title != blank -%}
                    {{ block_st.page_title }}
                  {%- else -%}
                    {{ ph_title }}
                  {% endif %}
                </h1>
              </motion-element>
            {%- when 'description' -%}
              {% if block_st.description != blank or page.content != blank %}
                <motion-element
                  data-motion="fade-up-lg"
                  {% if scroll_animation != 'slide_in' %}
                    hold
                  {% endif %}
                  data-motion-delay="{{ forloop.index0 | times: 50 }}"
                  class="heading-description block {% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} mt-10 rich__text-m0"
                  data-lcp-block="{{ block.id }}"
                  data-lcp-block-type="description"
                  data-lcp-block-settings="{{ block.settings | json | escape }}"
                  {%- if page.content != blank %} data-lcp-has-fallback{% endif %}
                  {%- if block_font != blank %} data-own-font{% endif %}
                  {{ block.shopify_attributes }}
                  style="color: {% if block_st.enable_custom_style %}{% render 'scheme-color', color: block_st.description_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %}; --ph-desc-size: {{ block_st.description_font_size | default: 15 }}px;{% if block_font != blank %} font-family: {{ block_font }};{% endif %}"
                >
                  {% if block_st.description != blank -%}
                    {{- block_st.description -}}
                  {%- else %}
                    {{ page.content -}}
                  {%- endif %}
                </motion-element>
              {% endif %}
            {%- when 'breadcrumb' -%}
              <motion-element
                data-motion="fade-up-lg"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="{% if scroll_animation == 'slide_in' %} opacity-0 {% endif %} block"
                data-lcp-block="{{ block.id }}"
                data-lcp-block-type="breadcrumb"
                data-lcp-block-settings="{{ block.settings | json | escape }}"
              >
                {%- liquid
                  assign bc_current = page_title
                  case t
                    when 'page'
                      assign bc_current = page.title | default: page_title
                    when 'cart'
                      assign bc_current = 'general.cart.title' | t
                    when 'blog'
                      assign bc_current = blog.title | default: page_title
                    when 'article'
                      assign bc_current = article.title | default: page_title
                  endcase
                -%}
                <nav
                  class="bc page-title-breadcrumb"
                  aria-label="{{ 'general.breadcrumb.home' | t | escape }}"
                  data-bc-sep="{{ block_st.separator | default: 'chevron' }}"
                  {%- if block_st.uppercase %} data-bc-upper{% endif %}
                  style="--bc-link: {% render 'scheme-color', color: block_st.link_color, fallback: 'color-mix(in srgb, var(--color-text) 72%, transparent)' %}; --bc-current: {% render 'scheme-color', color: block_st.current_color, fallback: 'var(--color-heading)' %}; --bc-size: {{ block_st.font_size | default: 13 }}px; --bc-justify: {{ ph_justify }};"
                  {{ block.shopify_attributes }}
                >
                  <ol class="bc__trail">
                    <li class="bc__item"><a class="bc__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a></li>
                    {%- if t == 'blog' and current_tags -%}
                      <li class="bc__item"><a class="bc__link" href="{{ blog.url }}">{{ blog.title }}</a></li>
                      <li class="bc__item"><span class="bc__current" aria-current="page">{{ current_tags | join: ' + ' }}</span></li>
                    {%- else -%}
                      {%- if t == 'article' and blog.url != blank -%}
                        <li class="bc__item"><a class="bc__link" href="{{ blog.url }}">{{ blog.title }}</a></li>
                      {%- endif -%}
                      {%- if bc_current != blank -%}
                        <li class="bc__item"><span class="bc__current" aria-current="page">{{ bc_current }}</span></li>
                      {%- endif -%}
                    {%- endif -%}
                  </ol>
                </nav>
              </motion-element>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}

</template>

<schema>
{
  "type": "page-heading",
  "name": "Page heading",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "stretch_width",
      "label": "Section width"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Picture shape"
        },
        {
          "value": "based_on_content",
          "label": "Fit the text"
        }
      ],
      "default": "adapt",
      "label": "Height with a picture",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background picture"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb",
      "name": "Breadcrumbs",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Layout"
        },
        {
          "type": "select",
          "id": "separator",
          "label": "Separator",
          "options": [
            {
              "value": "chevron",
              "label": "Arrow"
            },
            {
              "value": "slash",
              "label": "Slash"
            },
            {
              "value": "dot",
              "label": "Dot"
            }
          ],
          "default": "chevron"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "color",
          "id": "link_color",
          "label": "Link colour",
          "info": "Empty follows the colour scheme."
        },
        {
          "type": "color",
          "id": "current_color",
          "label": "Current page colour",
          "info": "Empty follows the colour scheme."
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Typography"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Text size",
          "min": 11,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Capital letters",
          "default": false
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "page_title",
          "label": "Heading",
          "info": "Empty shows the page's own title."
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_heading_color",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading colour",
          "visible_if": "{{ block.settings.enable_heading_color }}"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Heading font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "select",
          "id": "header_size",
          "label": "Heading size",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Custom size"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "type": "range",
          "id": "heading_font_size",
          "label": "Custom heading size",
          "min": 16,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 34,
          "visible_if": "{{ block.settings.header_size == 'medium' }}"
        },
        {
          "type": "header",
          "id": "hdr_11",
          "label": "Spacing"
        },
        {
          "type": "range",
          "id": "vertical_gap",
          "label": "Space below the heading",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 8
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Text",
          "info": "Empty shows the page's own text."
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Text colour",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Text font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "range",
          "id": "description_font_size",
          "label": "Text size",
          "min": 12,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 15
        }
      ],
      "limit": 2
    }
  ],
  "max_blocks": 3,
  "shopify": {
    "name": "Page heading",
    "tag": "section",
    "class": "page-title",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Colour scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "stretch_width",
        "label": "Section width"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "height",
        "options": [
          {
            "value": "adapt",
            "label": "Picture shape"
          },
          {
            "value": "based_on_content",
            "label": "Fit the text"
          }
        ],
        "default": "adapt",
        "label": "Height with a picture",
        "visible_if": "{{ section.settings.background_image != blank }}"
      },
      {
        "type": "header",
        "content": "Media"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background picture"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Overlay opacity",
        "default": 0,
        "visible_if": "{{ section.settings.background_image != blank }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "default": 80,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      }
    ],
    "max_blocks": 3,
    "blocks": [
      {
        "type": "breadcrumb",
        "name": "Breadcrumbs",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "separator",
            "label": "Separator",
            "options": [
              {
                "value": "chevron",
                "label": "Arrow"
              },
              {
                "value": "slash",
                "label": "Slash"
              },
              {
                "value": "dot",
                "label": "Dot"
              }
            ],
            "default": "chevron"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "color",
            "id": "link_color",
            "label": "Link colour",
            "info": "Empty follows the colour scheme."
          },
          {
            "type": "color",
            "id": "current_color",
            "label": "Current page colour",
            "info": "Empty follows the colour scheme."
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "min": 11,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 13
          },
          {
            "type": "checkbox",
            "id": "uppercase",
            "label": "Capital letters",
            "default": false
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "page_title",
            "label": "Heading",
            "info": "Empty shows the page's own title."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_heading_color",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading colour",
            "visible_if": "{{ block.settings.enable_heading_color }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Heading font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "select",
            "id": "header_size",
            "label": "Heading size",
            "default": "default",
            "options": [
              {
                "value": "default",
                "label": "Default"
              },
              {
                "value": "small",
                "label": "Small"
              },
              {
                "value": "medium",
                "label": "Custom size"
              },
              {
                "value": "large",
                "label": "Large"
              }
            ]
          },
          {
            "type": "range",
            "id": "heading_font_size",
            "label": "Custom heading size",
            "min": 16,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 34,
            "visible_if": "{{ block.settings.header_size == 'medium' }}"
          },
          {
            "type": "header",
            "content": "Spacing"
          },
          {
            "type": "range",
            "id": "vertical_gap",
            "label": "Space below the heading",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 8
          }
        ]
      },
      {
        "type": "description",
        "name": "Description",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Text",
            "info": "Empty shows the page's own text."
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "description_color",
            "label": "Text colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Text font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "range",
            "id": "description_font_size",
            "label": "Text size",
            "min": 12,
            "max": 36,
            "step": 1,
            "unit": "px",
            "default": 15
          }
        ]
      }
    ]
  }
}
</schema>