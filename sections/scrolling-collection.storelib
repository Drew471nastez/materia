            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      },
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection",
            "info": "Its title, picture, product count and link are used when the fields below are empty."
          },
          {
            "type": "text",
            "id": "label_first",
            "label": "Label",
            "info": "Defaults to the collection title."
          },
          {
            "type": "text",
            "id": "label_second",
            "label": "Second label",
            "info": "Optional smaller line"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "header",
            "content": "Image"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
