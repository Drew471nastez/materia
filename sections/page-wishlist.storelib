<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
{{ 'wishlist-page.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign scroll_animation = settings.scroll_animation
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign empty_text = 'templates.wishlist.empty_des' | t
  if section_st.empty_text != blank
    assign empty_text = section_st.empty_text
  endif
  assign empty_button_label = 'templates.wishlist.redirect' | t
  if section_st.empty_button_label != blank
    assign empty_button_label = section_st.empty_button_label
  endif
  assign empty_button_url = section_st.empty_button_url | default: routes.all_products_collection_url | default: '/products'
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--col-gap-desktop: 30px;--col-desktop: 4;--col-number: 2;--col-desktop-small: 3;--col-tablet: 3;--col-gap: 15px;
{%- endcapture -%}
{%- comment -%}
  The saved list lives in the visitor's browser (localStorage
  "materia__wishlist-items", product ids), so the page is drawn empty and
  assets/wishlist.js asks Storelib for the saved products' cards:
  /search?q=id:<id> OR id:<id>&section_id=page-wishlist, which answers
  this same section with search.results, so the cards are the theme's own
  product cards with the theme settings. In the builder a few products
  stand in when nothing is saved, so the cards can be styled.
{%- endcomment -%}
<div
  class="section product wishlist-page-section color-{{ color_scheme }} gradient"
  data-section-type="page-wishlist"
  data-section-id="{{ section.id }}"
  data-wishlist-page
  data-render-section="page-wishlist"
  data-view="{{ template.name }}"
  {%- if settings.show_message_when_remove %} data-removed-message="{{ section_st.removed_message | default: 'Removed from your wishlist' | escape }}"{% endif %}
  style="{{ style | strip | strip_newlines }}"
>
  <div class="wishlist-page-section-inner">
    <div class="{{ section_width }} wishlist-page-main">
      {%- if search.results != blank -%}
        <div class="wishlist-list-items grid grid-cols gap" data-wishlist-items>
          {%- for product in search.results limit: 50 -%}
            {%- if product.id != blank -%}
              <div
                class="col-6 col-md-4 col-lg-3 product-load wl-product-js wishlist-list"
                data-wishlist-card
                data-wishlist-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
              >
                {% render 'product-item',
                  card_product: product,
                  section_id: section.id,
                  template_enable_action: true,
                  template_enable_price: true,
                  template_enable_product_vendor: true,
                  template_enable_rate: true,
                  template_enable_add_cart: true,
                  template_enable_product_badges: true,
                  template_enable_product_short_description: true,
                  template_enable_color_swatches: true,
                  template_enable_remove_in_wishlist_page: true,
                  type: 'gird',
                  scroll_animation: 'none',
                  indexFor: forloop.index
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="wishlist-list-items grid grid-cols gap" data-wishlist-items aria-busy="true">
          {%- if request.design_mode -%}
            {%- for product in collections.all.products limit: 4 -%}
              <div class="col-6 col-md-4 col-lg-3 product-load wl-product-js wishlist-list" data-wishlist-card data-wishlist-sample data-wishlist-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
                {% render 'product-item',
                  card_product: product,
                  section_id: section.id,
                  template_enable_action: true,
                  template_enable_price: true,
                  template_enable_product_vendor: true,
                  template_enable_rate: true,
                  template_enable_add_cart: true,
                  template_enable_product_badges: true,
                  template_enable_product_short_description: true,
                  template_enable_color_swatches: true,
                  template_enable_remove_in_wishlist_page: true,
                  type: 'gird',
                  scroll_animation: 'none',
                  indexFor: forloop.index
                %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="wishlist-page__loading" data-wishlist-loading aria-hidden="true">
          {%- for i in (1..4) -%}<span class="wishlist-page__ghost"></span>{%- endfor -%}
        </div>
      {%- endif -%}
      <div class="wishlist-no-product-js wishlist-page__empty text-center" data-wishlist-empty hidden>
        <p class="wishlist-page__empty-text">{{ empty_text }}</p>
        <a
          class="wishlist-no-product-url btn-primary no-underline inline-flex"
          data-theme-button="primary" data-sl-button
          href="{{ empty_button_url | url }}"
        >
          {{- empty_button_label -}}
        </a>
      </div>
      <p class="wishlist-page__status visually-hidden" role="status" aria-live="polite" data-wishlist-status></p>
    </div>
  </div>
</div>

{% render 'theme-type' %}


</template>

<schema>
{
  "type": "page-wishlist",
  "name": "Wish list",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "fluid_container",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Nothing saved yet"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Message",
      "info": "Empty: the theme's own words."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "info": "Empty: the theme's own words."
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Button link",
      "info": "Empty: all products."
    },
    {
      "type": "text",
      "id": "removed_message",
      "label": "Message after a remove",
      "default": "Removed from your wishlist",
      "info": "Shown when Theme settings > Wishlist > Show a message when removed is on."
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "shopify": {
    "name": "t:sections.page-wishlist.name",
    "tag": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ],
        "default": "fluid_container",
        "label": "t:sections.all.section_width.label"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Nothing saved yet"
      },
      {
        "type": "textarea",
        "id": "empty_text",
        "label": "Message",
        "info": "Empty: the theme's own words."
      },
      {
        "type": "text",
        "id": "empty_button_label",
        "label": "Button label",
        "info": "Empty: the theme's own words."
      },
      {
        "type": "url",
        "id": "empty_button_url",
        "label": "Button link",
        "info": "Empty: all products."
      },
      {
        "type": "text",
        "id": "removed_message",
        "label": "Message after a remove",
        "default": "Removed from your wishlist",
        "info": "Shown when Theme settings > Wishlist > Show a message when removed is on."
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.all.section_padding.top.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.all.section_padding.bottom.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      }
    ]
  }
}
</schema>
