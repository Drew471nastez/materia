<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
{{ 'wishlist-page.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--col-gap-desktop: 30px;--col-desktop: 4;--col-number: 2;--col-desktop-small: 3;--col-tablet: 3;--col-gap: 15px;
{%- endcapture -%}
<div
  class="section product wishlist-page-section"
  data-section-type="page-wishlist"
  data-section-id="{{ section.id }}"
  data-view="{{ template.name }}"
  style="{{ style | strip | strip_newlines }}"
>
  <skeleton-page></skeleton-page>
  <div class="wishlist-page-section-inner">
    <div class="{{ section_width }} wishlist-page-main">
      {%- if search.results != blank -%}
        {% paginate search.results by 50 %}
          <div class="wishlist-list-items grid grid-cols gap fadeIn">
            {%- for product in search.results -%}
              <div
                class="col-6 col-md-4 col-lg-3 product-load wl-product-js product-preload-js wishlist-list"
                data-product-handle="{{ product.handle }}"
              >
                {% render 'product-item',
                  card_product: product,
                  section_id: section.id,
                  template_enable_action: true,
                  template_enable_price: true,
                  template_enable_product_vendor: true,
                  template_enable_rate: true,
                  template_enable_add_cart: true,
                  template_enable_product_short_description: false,
                  template_enable_color_swatches: true,
                  template_enable_remove_in_wishlist_page: true,
                  type: 'gird',
                  scroll_animation: scroll_animation,
                  indexFor: forloop.index
                %}
              </div>
            {%- endfor -%}
          </div>
        {% endpaginate %}
      {% endif %}
      <div class="wishlist-no-product-js fadeIn hidden text-center empty-hidden-heading">
        <p class="mb-30">{{ 'templates.wishlist.empty_des' | t }}</p>
        <a
          class="wishlist-no-product-url btn-primary no-underline inline-block"
          href="{{ routes.all_products_collection_url }}"
        >
          {{- 'templates.wishlist.redirect' | t -}}
        </a>
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "page-wishlist",
  "name": "Page wishlist",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "fluid_container",
      "label": "Section width"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "shopify": {
    "name": "t:sections.page-wishlist.name",
    "tag": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ],
        "default": "fluid_container",
        "label": "t:sections.all.section_width.label"
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.all.section_padding.top.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.all.section_padding.bottom.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      }
    ]
  }
}
</schema>
