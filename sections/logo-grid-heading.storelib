<template compat="shopify">
<script src="{{ 'live-r7-trust.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes. Logo Wall: a heading, a short line and every logo at once
  in a tidy grid (stockists, press, partners), wrapping onto as many rows as
  it needs. No marquee and no carousel: nothing moves, so it reads well
  under a hero or above the footer. One Logo block per logo (a picture, its
  description and an optional link). Logos can stay grey until a pointer
  rests on them or a key focuses them; a touch screen always shows them in
  colour. An empty Logo block shows the theme's logo placeholder in the
  builder and nothing on the storefront. Live builder edits are in
  shopify/assets/live-r7-trust.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign design = request.design_mode
  assign logo_count = 0
  for block in section.blocks
    if block.type == 'logo'
      if design or block.settings.logo != blank
        assign logo_count = logo_count | plus: 1
      endif
    endif
  endfor
  assign custom = st.enable_custom_style
  assign has_bg = false
  if custom
    capture lw_bg
      render 'scheme-color', color: st.section_bg, fallback: 'none'
    endcapture
    assign lw_bg = lw_bg | strip
    if lw_bg != 'none'
      assign has_bg = true
    endif
  endif
  assign own_fonts = false
  if st.enable_custom_fonts
    if st.heading_font.family != blank or st.body_font.family != blank
      assign own_fonts = true
    endif
  endif
-%}
{%- if design or logo_count > 0 -%}
<style data-r7t-space>#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}@media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}{% if st.reset_spacing %}#shopify-section-{{ sid }}{margin-top:0!important;margin-bottom:0!important}#shopify-section-{{ sid }} + .shopify-section{margin-top:0!important}{% endif %}{% comment %}{% endcomment %}</style>
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if st.enable_custom_fonts -%}
    {{ st.heading_font | font_face: font_display: 'swap' }}
    {{ st.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .lw {
    --lw-edge: 20px;
    font-family: var(--body-font, inherit); color: var(--color-text);
    padding-top: var(--lw-pt-m, 48px); padding-bottom: var(--lw-pb-m, 48px);
  }
  #shopify-section-{{ sid }} .lw[data-bg] { background: var(--lw-bg); }
  #shopify-section-{{ sid }} .lw, #shopify-section-{{ sid }} .lw *, #shopify-section-{{ sid }} .lw *::before, #shopify-section-{{ sid }} .lw *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .lw [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .lw__inner { width: 100%; margin-inline: auto; padding-inline: var(--lw-edge); }

  /* Heading and line */
  #shopify-section-{{ sid }} .lw__head { display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 720px; margin: 0 auto 28px; text-align: center; }
  #shopify-section-{{ sid }} .lw[data-align='left'] .lw__head { align-items: flex-start; margin-inline: 0; text-align: start; }
  #shopify-section-{{ sid }} .lw__head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .lw__heading { margin: 0; max-width: 100%; font-size: var(--b-fs-m, 26px); color: var(--b-c, var(--color-heading)); text-wrap: balance; overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .lw__sub { max-width: 100%; font-size: var(--b-fs-m, 15px); line-height: var(--body-line-height, 1.6); color: var(--b-c, var(--color-text)); }
  #shopify-section-{{ sid }} .lw__sub p { margin: 0 0 .5em; color: inherit; }
  #shopify-section-{{ sid }} .lw__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .lw__sub a { color: inherit; }

  /* The wall: rows that wrap, the last one centred (or from the left) */
  #shopify-section-{{ sid }} .lw__grid {
    --cols: var(--lw-cols-m, 2); --gx: 12px; --gy: 12px; --pad: 20px;
    display: flex; flex-wrap: wrap; justify-content: center; column-gap: var(--gx); row-gap: var(--gy);
    margin: 0; padding: 0; list-style: none;
  }
  #shopify-section-{{ sid }} .lw[data-align='left'] .lw__grid { justify-content: flex-start; }
  #shopify-section-{{ sid }} .lw[data-tiles='plain'] .lw__grid { --gx: 16px; --gy: 8px; --pad: 10px; }
  #shopify-section-{{ sid }} .lw[data-tiles='lines'] .lw__grid { --gx: 0px; --gy: 0px; --pad: 24px; }
  #shopify-section-{{ sid }} .lw__item { display: flex; flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gx)) / var(--cols)); min-width: 0; margin: 0; }
  #shopify-section-{{ sid }} .lw__tile {
    flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0;
    min-height: max(44px, calc(var(--lw-h-m, 32px) + 2 * var(--pad)));
    padding: var(--pad) 12px; color: inherit; text-decoration: none; outline: none;
    border-radius: var(--rounded-radius, 8px); -webkit-tap-highlight-color: transparent;
    transition: background-color .2s ease;
  }
  #shopify-section-{{ sid }} .lw[data-tiles='plain'][data-align='left'] .lw__tile { justify-content: flex-start; padding-inline: 0; }
  #shopify-section-{{ sid }} .lw[data-tiles='tiles'] .lw__tile { background: var(--lw-tile, color-mix(in srgb, var(--color-text) 7%, var(--color-background))); }
  /* Lines: one hairline between logos, never doubled, whatever the number of rows */
  #shopify-section-{{ sid }} .lw[data-tiles='lines'] .lw__tile { border-radius: 0; box-shadow: 1px 0 0 0 var(--lw-line, var(--color-border)), 0 1px 0 0 var(--lw-line, var(--color-border)), 1px 1px 0 0 var(--lw-line, var(--color-border)), inset 1px 0 0 0 var(--lw-line, var(--color-border)), inset 0 1px 0 0 var(--lw-line, var(--color-border)); }
  #shopify-section-{{ sid }} .lw__img { display: block; width: auto; max-width: 100%; height: var(--lw-h-m, 32px); object-fit: contain; transition: filter .25s ease, opacity .25s ease, transform .2s ease; }
  #shopify-section-{{ sid }} .lw__tile .lg__ph { display: block; width: auto; max-width: 100%; height: calc(var(--lw-h-m, 32px) + 8px); aspect-ratio: 160 / 64; color: var(--color-text); }
  #shopify-section-{{ sid }} .lw[data-style='mono'] .lw__img { filter: grayscale(1); opacity: .62; }
  #shopify-section-{{ sid }} a.lw__tile[href]:focus-visible { box-shadow: inset 0 0 0 2px var(--color-heading); }
  #shopify-section-{{ sid }} .lw[data-style='mono'] a.lw__tile:focus-visible .lw__img { filter: none; opacity: 1; }
  #shopify-section-{{ sid }} a.lw__tile[href]:active .lw__img { transform: scale(.96); }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .lw[data-style='mono'] .lw__tile:hover .lw__img { filter: none; opacity: 1; }
    #shopify-section-{{ sid }} .lw[data-tiles='tiles'] a.lw__tile[href]:hover { background: color-mix(in srgb, var(--color-text) 6%, var(--lw-tile, color-mix(in srgb, var(--color-text) 7%, var(--color-background)))); }
  }
  /* A touch screen has no hover: logos show in colour there. */
  @media (hover: none) {
    #shopify-section-{{ sid }} .lw[data-style='mono'] .lw__img { filter: none; opacity: 1; }
  }
  #shopify-section-{{ sid }} .lw__empty { margin: 0; padding: 24px 0; text-align: center; font-size: 14px; color: var(--color-text); }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .lw { --lw-edge: 24px; padding-top: var(--lw-pt, 56px); padding-bottom: var(--lw-pb, 56px); }
    #shopify-section-{{ sid }} .lw__head { margin-bottom: 36px; }
    #shopify-section-{{ sid }} .lw__heading, #shopify-section-{{ sid }} .lw__sub { font-size: var(--b-fs-d, 32px); }
    #shopify-section-{{ sid }} .lw__grid { --cols: var(--lw-cols, 5); --gx: 16px; --gy: 16px; --pad: 28px; }
    #shopify-section-{{ sid }} .lw[data-tiles='plain'] .lw__grid { --gx: 24px; --gy: 12px; --pad: 12px; }
    #shopify-section-{{ sid }} .lw[data-tiles='lines'] .lw__grid { --gx: 0px; --gy: 0px; --pad: 32px; }
    #shopify-section-{{ sid }} .lw__tile { min-height: max(44px, calc(var(--lw-h, 44px) + 2 * var(--pad))); padding-inline: 20px; }
    #shopify-section-{{ sid }} .lw__img { height: var(--lw-h, 44px); }
    #shopify-section-{{ sid }} .lw__tile .lg__ph { height: calc(var(--lw-h, 44px) + 8px); }
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ sid }} .lw[data-width='container'] .lw__inner { width: 90%; }
    #shopify-section-{{ sid }} .lw[data-width='fluid_container'] .lw__inner { width: 95%; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .lw[data-width='container'] .lw__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
    #shopify-section-{{ sid }} .lw[data-width='fluid_container'] .lw__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
    #shopify-section-{{ sid }} .lw[data-width='stretch_width'] { --lw-edge: 3rem; }
  }
  /* Full width: the logos reach the edges, the words keep a margin. */
  #shopify-section-{{ sid }} .lw[data-width='full_width'] .lw__inner { padding-inline: 0; }
  #shopify-section-{{ sid }} .lw[data-width='full_width'] .lw__head { padding-inline: var(--lw-edge); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.lw__tile, .lw__img) { transition: none; }
    #shopify-section-{{ sid }} a.lw__tile[href]:active .lw__img { transform: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture lw_vars -%}
--lw-cols: {{ st.columns | default: 5 }};--lw-cols-m: {{ st.columns_mobile | default: 2 }};--lw-h: {{ st.logo_height | default: 0 }}px;--lw-h-m: {{ st.logo_height_mobile | default: 0 }}px;--lw-pt: {{ st.padding_top | default: 0 }}px;--lw-pb: {{ st.padding_bottom | default: 0 }}px;--lw-pt-m: {{ st.padding_top_mobile | default: 0 }}px;--lw-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;
{%- if has_bg -%}--lw-bg: {{ lw_bg }};{%- endif -%}
{%- if custom -%}--lw-line: {% render 'scheme-color', color: st.line_color, fallback: 'var(--color-border)' %};--lw-tile: {% render 'scheme-color', color: st.tile_bg, fallback: 'color-mix(in srgb, var(--color-text) 7%, var(--color-background))' %};{%- endif -%}
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--heading-font: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--body-font: {{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
{%- if design -%}
{%- capture lw_json -%}{"color_scheme":{{ color_scheme | json }},"section_width":{{ st.section_width | append: '' | json }},"reset_spacing":{% if st.reset_spacing %}true{% else %}false{% endif %},"alignment":{{ st.alignment | append: '' | json }},"columns":{{ st.columns | default: 0 | json }},"tile_style":{{ st.tile_style | append: '' | json }},"logo_height":{{ st.logo_height | default: 0 | json }},"logo_style":{{ st.logo_style | append: '' | json }},"enable_custom_style":{% if st.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ st.section_bg | append: '' | json }},"line_color":{{ st.line_color | append: '' | json }},"tile_bg":{{ st.tile_bg | append: '' | json }},"enable_custom_fonts":{% if st.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ st.heading_font.family | append: '' | json }},"fallback_families":{{ st.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ st.body_font.family | append: '' | json }},"fallback_families":{{ st.body_font.fallback_families | append: '' | json }}},"padding_top":{{ st.padding_top | default: 0 | json }},"padding_bottom":{{ st.padding_bottom | default: 0 | json }},"section_margin_top_desktop":{{ st.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ st.section_margin_bottom_desktop | default: 0 | json }},"columns_mobile":{{ st.columns_mobile | default: 0 | json }},"logo_height_mobile":{{ st.logo_height_mobile | default: 0 | json }},"padding_top_mobile":{{ st.padding_top_mobile | default: 0 | json }},"padding_bottom_mobile":{{ st.padding_bottom_mobile | default: 0 | json }},"section_margin_top_mobile":{{ st.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ st.section_margin_bottom_mobile | default: 0 | json }}}{%- endcapture -%}
{%- endif -%}
<div class="lw color-{{ color_scheme }} gradient{% if st.reset_spacing %} remove_spacing{% endif %}" data-r7t="logo-grid-heading" data-r7t-section="{{ sid }}"{% if design %} data-r7t-settings="{{ lw_json | escape }}"{% endif %} data-width="{{ st.section_width | default: 'fluid_container' }}" data-align="{{ st.alignment | default: 'center' }}" data-tiles="{{ st.tile_style | default: 'lines' }}" data-style="{{ st.logo_style | default: 'original' }}"{% if has_bg %} data-bg{% endif %}{% if own_fonts %} data-own-font{% endif %} style="{{ lw_vars | strip }}">
  {%- if design -%}<template data-r7t-ph>{%- render 'logos-ph' -%}</template>{%- endif -%}
  <div class="lw__inner">
    <div class="lw__head">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' or block.type == 'subheading' -%}{%- render 'r7-trust-text', block: block, p: 'lw', design: design -%}{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if logo_count > 0 -%}
    <ul class="lw__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
        {%- assign bs = block.settings -%}
        {%- if design or bs.logo != blank -%}
        {%- assign alt = bs.alt | default: bs.logo.alt -%}
        <li class="lw__item" data-r7t-block="{{ block.id }}" data-r7t-type="logo"{% if design %} data-r7t-settings="{% capture lwb_json %}{"logo":{% if bs.logo != blank %}{{ bs.logo | image_url: width: 480 | json }}{% else %}""{% endif %},"alt":{{ bs.alt | append: '' | json }},"url":{{ bs.url | append: '' | json }}}{% endcapture %}{{ lwb_json | escape }}" data-r7t-own-alt="{{ bs.logo.alt | escape }}"{% endif %} {{ block.shopify_attributes }}>
          <a class="lw__tile"{% if bs.url != blank %} href="{{ bs.url | url }}"{% endif %}>
            {%- if bs.logo != blank -%}
              <img class="lw__img" src="{{ bs.logo | image_url: width: 480 }}" srcset="{{ bs.logo | image_url: width: 240 }} 240w, {{ bs.logo | image_url: width: 480 }} 480w" sizes="240px" width="{{ bs.logo.width | default: 240 }}" height="{{ bs.logo.height | default: 96 }}" alt="{{ alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              {%- render 'logos-ph' -%}
            {%- endif -%}
          </a>
        </li>
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- elsif design -%}
      <p class="lw__empty">Add a Logo block to show your first logo.</p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
</template>

<schema>
{
  "shopify": {
    "name": "Logo Wall",
    "settings": [
      { "type": "header", "content": "General" },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
      {
        "type": "select", "id": "section_width", "label": "Section width", "default": "fluid_container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "fluid_container", "label": "Fluid container" },
          { "value": "stretch_width", "label": "Stretched" },
          { "value": "full_width", "label": "Full width" }
        ]
      },
      { "type": "checkbox", "id": "reset_spacing", "label": "Remove default space between sections", "default": true },

      { "type": "header", "content": "Layout" },
      {
        "type": "select", "id": "alignment", "label": "Alignment", "default": "center",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" }
        ]
      },
      { "type": "range", "id": "columns", "label": "Logos per row", "min": 2, "max": 8, "step": 1, "default": 5 },
      {
        "type": "select", "id": "tile_style", "label": "Logo frames", "default": "lines",
        "options": [
          { "value": "plain", "label": "None" },
          { "value": "lines", "label": "Lines" },
          { "value": "tiles", "label": "Tiles" }
        ]
      },

      { "type": "header", "content": "Images" },
      { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 44 },
      {
        "type": "select", "id": "logo_style", "label": "Logo colour", "default": "original",
        "info": "Touch screens always show the colours.",
        "options": [
          { "value": "original", "label": "Original" },
          { "value": "mono", "label": "Grey until hover" }
        ]
      },

      { "type": "header", "content": "Appearance" },
      { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false, "info": "Off: colours follow the colour scheme." },
      { "type": "color", "id": "section_bg", "label": "Section background", "visible_if": "{{ section.settings.enable_custom_style }}" },
      { "type": "color", "id": "line_color", "label": "Line colour", "visible_if": "{{ section.settings.enable_custom_style and section.settings.tile_style == 'lines' }}" },
      { "type": "color", "id": "tile_bg", "label": "Tile colour", "visible_if": "{{ section.settings.enable_custom_style and section.settings.tile_style == 'tiles' }}" },

      { "type": "header", "content": "Typography" },
      { "type": "checkbox", "id": "enable_custom_fonts", "label": "Enable custom fonts", "default": false },
      { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },
      { "type": "font_picker", "id": "body_font", "label": "Text font", "default": "assistant_n4", "visible_if": "{{ section.settings.enable_custom_fonts }}" },

      { "type": "header", "content": "Desktop spacing" },
      { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
      { "type": "range", "id": "section_margin_top_desktop", "label": "Top margin", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_desktop", "label": "Bottom margin", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },

      { "type": "header", "content": "Mobile" },
      { "type": "range", "id": "columns_mobile", "label": "Logos per row (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
      { "type": "range", "id": "logo_height_mobile", "label": "Logo height (mobile)", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 32 },
      { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 48 },
      { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 48 },
      { "type": "range", "id": "section_margin_top_mobile", "label": "Top margin (mobile)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" },
      { "type": "range", "id": "section_margin_bottom_mobile", "label": "Bottom margin (mobile)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0, "visible_if": "{{ section.settings.reset_spacing == false }}" }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          { "type": "header", "content": "Content" },
          { "type": "inline_richtext", "id": "text", "label": "Heading", "default": "Where you can find us" },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Text color", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Typography" },
          { "type": "range", "id": "size_desktop", "label": "Size (desktop)", "min": 18, "max": 72, "step": 1, "unit": "px", "default": 32 },
          { "type": "range", "id": "size_mobile", "label": "Size (mobile)", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 26 }
        ]
      },
      {
        "type": "subheading",
        "name": "Text",
        "limit": 1,
        "settings": [
          { "type": "header", "content": "Content" },
          { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a line about these logos, such as the shops that stock you or the press that wrote about you.</p>" },
          { "type": "header", "content": "Appearance" },
          { "type": "checkbox", "id": "enable_custom_style", "label": "Enable custom styling", "default": false },
          { "type": "color", "id": "color", "label": "Text color", "visible_if": "{{ block.settings.enable_custom_style }}" },
          { "type": "header", "content": "Typography" },
