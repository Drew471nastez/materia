  "presets": [
    {
      "name": "Text Comparisons",
      "category": "Features",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "negative",
          "settings": {
            "text": "The cheap option wears out and needs replacing"
          }
        },
        {
          "type": "negative",
          "settings": {
            "text": "The expensive one spends on the box, not the product"
          }
        },
        {
          "type": "negative",
          "settings": {
            "text": "Doing it yourself takes time and rarely gets it right"
          }
        },
        {
          "type": "divider"
        },
        {
          "type": "positive",
          "settings": {
            "text": "<strong>Our product</strong>, made to last and made for you"
          }
        }
      ]
    }
  ],
