<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Text Comparisons
  Simple text-only comparison list. A stack of "negative" rows with cross
  icons (the alternative) followed by a divider and a "positive" row with
  a check (the brand). Reads like a quick punch list of reasons-to-believe.
  All rows are blocks; icons, colors, separators and spacing are fully
  customizable. Section width has separate desktop/tablet/mobile sliders.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id
  assign align = st.header_align | default: 'center'
  case align
    when 'left'
      assign flex_align = 'flex-start'
    when 'right'
      assign flex_align = 'flex-end'
    else
      assign flex_align = 'center'
  endcase
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }
  #shopify-section-{{ sid }} *, #shopify-section-{{ sid }} *:before, #shopify-section-{{ sid }} *:after { box-sizing: border-box; }

  /* Margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .ctxt {
    background: {{ st.section_bg | default: '#FFFFFF' }} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt {
      padding-top: {{ st.padding_top_desktop | default: 96 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Section width — separate sliders for mobile/tablet/desktop */
  #shopify-section-{{ sid }} .ctxt__inner {
    max-width: {{ st.section_max_width_mobile | default: 560 }}px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt__inner {
      max-width: {{ st.section_max_width_tablet | default: 720 }}px;
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ sid }} .ctxt__inner {
      max-width: {{ st.section_max_width_desktop | default: 880 }}px;
    }
  }

  /* Header — flex column, alignment controls BOTH heading & subheading */
  #shopify-section-{{ sid }} .ctxt__header {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    margin: 0 auto {{ st.gap_header_mobile | default: 28 }}px;
    gap: {{ st.heading_sub_gap_mobile | default: 8 }}px;
    width: 100%;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt__header {
      margin-bottom: {{ st.gap_header | default: 48 }}px;
      gap: {{ st.heading_sub_gap_desktop | default: 14 }}px;
    }
  }
  /* Hard reset margins (incl. logical props) on all header descendants */
  /* Reset margins on header DESCENDANTS only (not the header itself,
     so its margin-bottom gap to the rows is preserved). */
  #shopify-section-{{ sid }} .ctxt__header > *,
  #shopify-section-{{ sid }} .ctxt__header :is(h1, h2, h3, h4, h5, h6, p, div, span) {
    margin-block: 0 !important;
    margin-block-start: 0 !important;
    margin-block-end: 0 !important;
    padding-block: 0 !important;
  }

  /* Rows wrapper */
  #shopify-section-{{ sid }} .ctxt__list {
    display: flex;
    flex-direction: column;
    gap: {{ st.row_gap_mobile | default: 16 }}px;
    align-items: {{ flex_align }};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt__list { gap: {{ st.row_gap_desktop | default: 22 }}px; }
  }

  /* Row */
  #shopify-section-{{ sid }} .ctxt__row {
    display: inline-grid;
    grid-template-columns: {{ st.icon_size | default: 24 }}px 1fr;
    gap: {{ st.icon_text_gap | default: 14 }}px;
    align-items: center;
    color: {{ st.row_color | default: '#0F172A' }};
    font-size: {{ st.row_size_mobile | default: 16 }}px;
    line-height: {{ st.row_line_height | default: 1.5 }};
    max-width: 100%;
    text-align: left;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt__row { font-size: {{ st.row_size_desktop | default: 20 }}px; }
  }
  #shopify-section-{{ sid }} .ctxt__row strong { font-weight: 700; }
  #shopify-section-{{ sid }} .ctxt__row a      { color: inherit; text-decoration: underline; }
  #shopify-section-{{ sid }} .ctxt__row em     { font-style: italic; }

  /* Icon */
  #shopify-section-{{ sid }} .ctxt__icon {
    width: {{ st.icon_size | default: 24 }}px;
    height: {{ st.icon_size | default: 24 }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .ctxt__icon svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .ctxt__icon img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .ctxt__icon--cross { color: {{ st.cross_color | default: '#EF4444' }}; }
  #shopify-section-{{ sid }} .ctxt__icon--check { color: {{ st.check_color | default: '#16A34A' }}; }
  #shopify-section-{{ sid }} .ctxt__icon--minus { color: {{ st.minus_color | default: '#94A3B8' }}; }

  /* Divider */
  #shopify-section-{{ sid }} .ctxt__divider {
    border: 0;
    border-top: 1px solid {{ st.divider_color | default: '#E2E8F0' }};
    margin: {{ st.divider_margin_mobile | default: 12 }}px 0;
    width: 100%;
    align-self: stretch;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ctxt__divider { margin: {{ st.divider_margin_desktop | default: 18 }}px 0; }
  }

  /* Positive row variant */
  #shopify-section-{{ sid }} .ctxt__row--positive {
    color: {{ st.positive_color | default: '#0F172A' }};
    font-weight: {{ st.positive_weight | default: 600 }};
  }

  /* Show / hide by device */
  {%- if st.show_section_on == 'mobile' -%}
    #shopify-section-{{ sid }} .ctxt { display: none; }
    @media (max-width: 767px) { #shopify-section-{{ sid }} .ctxt { display: block; } }
  {%- elsif st.show_section_on == 'desktop' -%}
    #shopify-section-{{ sid }} .ctxt { display: none; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .ctxt { display: block; } }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<section class="ctxt" id="ctxt-{{ sid }}">
  <div class="ctxt__inner">

    {%- comment -%}========== HEADER ==========={%- endcomment -%}
    {%- assign has_header = false -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'heading' or b.type == 'subheading' -%}
        {%- assign has_header = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_header -%}
      <div class="ctxt__header">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} id="block-{{ block.id }}" class="ctxt__heading" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {{ bs.color | default: '#0F172A' }} !important;
                    font-weight: {{ bs.weight | default: 700 }};
                    line-height: {{ bs.line_height | default: 1.2 }};
                    letter-spacing: {{ bs.tracking | default: 0 }}px;
                    font-size: {{ bs.size_mobile | default: 30 }}px !important;
                  }
                  @media (min-width: 768px) {
                    #shopify-section-{{ sid }} #block-{{ block.id }} { font-size: {{ bs.size_desktop | default: 48 }}px !important; }
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div id="block-{{ block.id }}" class="ctxt__sub" {{ block.shopify_attributes }}>{{ bs.text }}</div>
                <style>
                  #shopify-section-{{ sid }} #block-{{ block.id }} {
                    margin: 0 !important;
                    margin-block: 0 !important;
                    padding: 0 !important;
                    color: {{ bs.color | default: '#475569' }} !important;
                    font-size: {{ bs.size | default: 16 }}px;
                    line-height: {{ bs.line_height | default: 1.5 }};
                    max-width: {{ bs.max_width | default: 560 }}px;
                  }
                  #shopify-section-{{ sid }} #block-{{ block.id }} > * { margin: 0 !important; margin-block: 0 !important; padding: 0 !important; }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}========== ROWS ==========={%- endcomment -%}
    <div class="ctxt__list">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- case block.type -%}

          {%- when 'negative' -%}
            {%- assign t = bs.icon_type | default: 'cross' -%}
            <div class="ctxt__row" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
              <span class="ctxt__icon ctxt__icon--{{ t }}">
                {%- case t -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'cross' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                  {%- when 'minus' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  {%- when 'image' -%}
                    {%- if bs.icon_image -%}<img src="{{ bs.icon_image | image_url: width: 80 }}" alt="" loading="lazy" width="40" height="40">{%- endif -%}
                  {%- when 'svg' -%}
                    {{ bs.icon_svg }}
                {%- endcase -%}
              </span>
              <span>{{ bs.text }}</span>
            </div>

          {%- when 'divider' -%}
            <hr class="ctxt__divider" id="block-{{ block.id }}" {{ block.shopify_attributes }}>

          {%- when 'positive' -%}
            {%- assign t = bs.icon_type | default: 'check' -%}
            <div class="ctxt__row ctxt__row--positive" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
              <span class="ctxt__icon ctxt__icon--{{ t }}">
                {%- case t -%}
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'cross' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                  {%- when 'minus' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  {%- when 'image' -%}
                    {%- if bs.icon_image -%}<img src="{{ bs.icon_image | image_url: width: 80 }}" alt="" loading="lazy" width="40" height="40">{%- endif -%}
                  {%- when 'svg' -%}
                    {{ bs.icon_svg }}
                {%- endcase -%}
              </span>
              <span>{{ bs.text }}</span>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</section>



</template>

<schema>
{
  "type": "comparison-text",
  "name": "Text Comparisons",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Section width"
    },
    {
      "type": "range",
      "id": "section_max_width_desktop",
      "label": "Section width (desktop ≥1024px)",
      "min": 600,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 880
    },
    {
      "type": "range",
      "id": "section_max_width_tablet",
      "label": "Section width (tablet ≥768px)",
      "min": 400,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "section_max_width_mobile",
      "label": "Section width (mobile)",
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Header layout"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Aligns both heading and subheading."
    },
    {
      "type": "range",
      "id": "gap_header",
      "label": "Gap subheading → rows (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_header_mobile",
      "label": "Gap subheading → rows (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_sub_gap_desktop",
      "label": "Gap heading → subheading (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_sub_gap_mobile",
      "label": "Gap heading → subheading (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "List layout"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Gap between rows (desktop)",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Gap between rows (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_size_desktop",
      "label": "Row text size (desktop)",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_size_mobile",
      "label": "Row text size (mobile)",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_line_height",
      "label": "Row line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Gap icon → text",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Colors"
    },
    {
      "type": "color",
      "id": "row_color",
      "label": "Negative row text color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "positive_color",
      "label": "Positive row text color",
      "default": "#0F172A"
    },
    {
      "type": "select",
      "id": "positive_weight",
      "label": "Positive row weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ]
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Cross icon color",
      "default": "#EF4444"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Check icon color",
      "default": "#16A34A"
    },
    {
      "type": "color",
      "id": "minus_color",
      "label": "Minus icon color",
      "default": "#94A3B8"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#E2E8F0"
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Divider defaults"
    },
    {
      "type": "range",
      "id": "divider_margin_desktop",
      "label": "Divider margin (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "divider_margin_mobile",
      "label": "Divider margin (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 300,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 300,
      "step": 5,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_40",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
