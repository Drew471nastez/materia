        "max": 200,
        "step": 10,
        "default": 100,
        "visible_if": "{{ section.settings.use_theme_button == false }}",
        "unit": "%"
      },
      {
        "type": "range",
        "id": "button_font_size",
        "label": "Button text size",
        "min": 10,
        "max": 40,
        "step": 1,
        "default": 18,
        "visible_if": "{{ section.settings.use_theme_button == false }}",
        "unit": "px"
      },
      {
        "type": "select",
