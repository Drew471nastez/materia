          {
            "value": "light",
            "label": "Light"
          },
          {
            "value": "normal",
            "label": "Normal"
          },
          {
            "value": "bold",
            "label": "Bold"
          }
        ],
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
