<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Quick Add to Cart.

  One product's add to cart button, with an optional variant picker,
  heading and text as blocks. The form posts to the theme's cart: "Open
  cart" goes through the theme's <product-form> (assets/theme.js, the
  same as product cards), "Checkout" posts with return_to=/checkout. The
  variant id is the selected variant's, and a sold out variant disables
  the button. Colours follow the colour scheme and Theme settings >
  Buttons until custom styling is on. Live edits: assets/live-products-d.js.
{%- endcomment -%}
{%- comment -%}pd-gen:settings{%- endcomment -%}{%- capture pd_settings -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | json }},"reset_spacing":{{ section.settings.reset_spacing | json }},"show_variant_picker":{{ section.settings.show_variant_picker | json }},"after_add":{{ section.settings.after_add | json }},"button_text":{{ section.settings.button_text | json }},"alignment":{{ section.settings.alignment | json }},"content_gap":{{ section.settings.content_gap | json }},"enable_custom_style":{{ section.settings.enable_custom_style | json }},"button_bg_color":{{ section.settings.button_bg_color | append: '' | json }},"button_text_color":{{ section.settings.button_text_color | append: '' | json }},"button_hover_color":{{ section.settings.button_hover_color | append: '' | json }},"button_border_color":{{ section.settings.button_border_color | append: '' | json }},"enable_gradient":{{ section.settings.enable_gradient | json }},"gradient_selector":{{ section.settings.gradient_selector | json }},"gradient_color_1":{{ section.settings.gradient_color_1 | append: '' | json }},"gradient_color_2":{{ section.settings.gradient_color_2 | append: '' | json }},"gradient_color_3":{{ section.settings.gradient_color_3 | append: '' | json }},"use_theme_button":{{ section.settings.use_theme_button | json }},"button_border_radius":{{ section.settings.button_border_radius | json }},"button_border_thickness":{{ section.settings.button_border_thickness | json }},"button_overall_size":{{ section.settings.button_overall_size | json }},"button_font_size":{{ section.settings.button_font_size | json }},"button_font_weight":{{ section.settings.button_font_weight | json }},"enable_custom_fonts":{{ section.settings.enable_custom_fonts | json }},"heading_font":{"family":{{ section.settings.heading_font.family | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | json }}},"body_font":{"family":{{ section.settings.body_font.family | json }},"fallback_families":{{ section.settings.body_font.fallback_families | json }}},"reveal":{{ section.settings.reveal | json }},"padding_top":{{ section.settings.padding_top | json }},"padding_bottom":{{ section.settings.padding_bottom | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | json }}}{%- endcapture -%}{%- capture pd_defaults -%}{"color_scheme":"default-color-scheme","section_width":"fluid_container","reset_spacing":true,"show_variant_picker":false,"after_add":"checkout","button_text":"Add to Cart & Checkout","alignment":"center","content_gap":12,"enable_custom_style":false,"enable_gradient":false,"gradient_selector":"linear","use_theme_button":true,"button_border_radius":5,"button_border_thickness":0,"button_overall_size":100,"button_font_size":18,"button_font_weight":"normal","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":true,"padding_top":20,"padding_bottom":20,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}{%- endcapture -%}{%- capture pd_block_defaults -%}{"button":{"text":"Buy now"},"heading":{"text":"Add it to your cart","enable_custom_style":false,"size_enable":false,"size_desktop":32,"size_mobile":28},"subheading":{"text":"<p>Choose an option and add it to your cart.</p>","enable_custom_style":false,"size_enable":false,"size":18}}{%- endcapture -%}{%- comment -%}/pd-gen{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.selected_product
  if p == blank and product != blank and product.id != blank
    assign p = product
  endif
  assign v = p.selected_or_first_available_variant
  assign sold_out_label = 'products.product.actions.add_to_cart.sold_out.label' | t
  assign flex = 'center'
  if s.alignment == 'left'
    assign flex = 'flex-start'
  elsif s.alignment == 'right'
    assign flex = 'flex-end'
  endif
  assign maxw = 'none'
  if s.section_width == 'container'
    assign maxw = 'calc(var(--page-width, 1300px) + 3rem)'
  elsif s.section_width == 'fluid_container'
    assign maxw = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
  endif
  assign px = '1.5rem'
  if s.section_width == 'full_width'
    assign px = '0px'
  endif
  assign hf = 'var(--heading-font)'
  assign bf = 'var(--body-font)'
  if s.enable_custom_fonts
    if s.heading_font.family != blank
      assign hf = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families | default: 'sans-serif'
      if s.heading_font.fallback_families == blank
        assign hf = s.heading_font.family | append: ', sans-serif'
      endif
    endif
    if s.body_font.family != blank
      assign bf = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
      if s.body_font.fallback_families == blank
        assign bf = s.body_font.family | append: ', sans-serif'
      endif
    endif
  endif
  assign weight = 400
  if s.button_font_weight == 'light'
    assign weight = 300
  elsif s.button_font_weight == 'bold'
    assign weight = 700
  endif
  assign has_button = false
  for block in section.blocks
    if block.type == 'button'
      assign has_button = true
    endif
  endfor
-%}
{%- capture gradient -%}
  {%- capture g1 -%}{% render 'scheme-color', color: s.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
  {%- capture g2 -%}{% render 'scheme-color', color: s.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}{%- endcapture -%}
  {%- capture g3 -%}{% render 'scheme-color', color: s.gradient_color_3, fallback: 'var(--color-primary)' %}{%- endcapture -%}
  {%- case s.gradient_selector -%}
    {%- when 'radial' -%}radial-gradient(circle, {{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'angular' -%}conic-gradient({{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'diagonal' -%}linear-gradient(45deg, {{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'vertical' -%}linear-gradient(180deg, {{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'horizontal' -%}linear-gradient(270deg, {{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'cool' -%}linear-gradient(135deg, {{ g1 }}, {{ g2 }}, {{ g3 }})
    {%- when 'warm' -%}linear-gradient(45deg, {{ g3 }}, {{ g2 }}, {{ g1 }})
    {%- when 'pastel' -%}linear-gradient(60deg, {{ g1 }} 0%, {{ g2 }} 70%, {{ g3 }} 100%)
    {%- else -%}linear-gradient(90deg, {{ g1 }}, {{ g2 }}, {{ g3 }})
  {%- endcase -%}
{%- endcapture -%}
{%- capture root_vars -%}
  --pd-pt: {{ s.padding_top | default: 0 }}px; --pd-pb: {{ s.padding_bottom | default: 0 }}px; --pd-gap: {{ s.content_gap | default: 0 }}px; --pd-flex: {{ flex }}; --pd-ta: {{ s.alignment | default: 'center' }}; --pd-maxw: {{ maxw }}; --pd-px: {{ px }}; --pd-hf: {{ hf }}; --pd-bf: {{ bf }};
  {%- if s.enable_custom_style -%}
    {%- if s.enable_gradient -%}
      {% render 'button-overrides', text: s.button_text_color, border: s.button_border_color %}--mb-bg: {{ gradient }}; --mb-hover-bg: {{ gradient }};
    {%- else -%}
      {% render 'button-overrides', bg: s.button_bg_color, text: s.button_text_color, border: s.button_border_color, hover_bg: s.button_hover_color %}
    {%- endif -%}
  {%- endif -%}
  {%- if s.use_theme_button == false -%}
    --mb-radius: {{ s.button_border_radius }}px; --mb-padding-y: 15px; --mb-padding-x: 25px; --mb-font-size: {{ s.button_font_size }}px; --mb-weight: {{ weight }}; --btn-border-width: {{ s.button_border_thickness }}px; --pd-btn-scale: {{ s.button_overall_size | divided_by: 100.0 }};
  {%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; margin-top: {{ s.section_margin_top_mobile | default: 0 }}px; margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px; }
  @media (min-width: 768px) { #shopify-section-{{ sid }} { margin-top: {{ s.section_margin_top_desktop | default: 0 }}px; margin-bottom: {{ s.section_margin_bottom_desktop | default: 0 }}px; } }
  {%- if s.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if s.enable_custom_fonts %}{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}
  #shopify-section-{{ sid }} .pd-atc { box-sizing: border-box; padding: var(--pd-pt) 0 var(--pd-pb); background: var(--color-background); color: var(--color-text); font-family: var(--pd-bf); }
  #shopify-section-{{ sid }} .pd-atc__inner { box-sizing: border-box; max-width: var(--pd-maxw); margin-inline: auto; padding-inline: var(--pd-px); display: flex; flex-direction: column; align-items: var(--pd-flex); text-align: var(--pd-ta); gap: var(--pd-gap); }
  #shopify-section-{{ sid }} .pd-atc__heading { margin: 0; color: var(--pd-c, var(--color-heading)); font-family: var(--pd-hf); font-size: var(--pd-fs-m, var(--h4-size)); line-height: var(--heading-line-height, 1.2); }
  #shopify-section-{{ sid }} .pd-atc__sub { margin: 0; color: var(--pd-c, var(--color-text)); font-family: var(--pd-bf); font-size: var(--pd-fs, inherit); max-width: 64ch; }
  #shopify-section-{{ sid }} .pd-atc__sub > :first-child { margin-top: 0; } #shopify-section-{{ sid }} .pd-atc__sub > :last-child { margin-bottom: 0; }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .pd-atc__heading { font-size: var(--pd-fs-d, var(--h3-size)); } }
  #shopify-section-{{ sid }} .pd-atc__buy { display: flex; flex-direction: column; align-items: var(--pd-flex); gap: 10px; max-width: 100%; }
  #shopify-section-{{ sid }} .pd-atc__form { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: var(--pd-flex); gap: 10px; margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .pd-atc__field { display: flex; flex-direction: column; gap: 4px; text-align: start; min-width: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .pd-atc__variant-label { font-size: 1.3rem; color: var(--color-text); }
  #shopify-section-{{ sid }} .pd-atc__variant { min-height: 44px; max-width: 100%; padding: 0 36px 0 12px; border: 1px solid var(--color-border); border-radius: var(--btn-radius, 4px); background-color: var(--color-background); color: var(--color-heading); font: inherit; }
  #shopify-section-{{ sid }} .pd-atc__variant:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ sid }} .pd-atc__button { scale: var(--pd-btn-scale, 1); }
  #shopify-section-{{ sid }} .pd-atc[data-gradient='true'] .pd-atc__button:not(:disabled):hover { filter: brightness(90%); }
  #shopify-section-{{ sid }} .pd-atc__button .icon-load { position: absolute; inset: 0; margin: auto; }
  #shopify-section-{{ sid }} .pd-atc__note { margin: 0; font-size: 1.3rem; color: var(--color-text); opacity: .75; }
{% comment %}{% endcomment %}</style>
{%- if p != blank or request.design_mode -%}
<div class="pd-atc color-{{ color_scheme }} gradient" data-pd-root="atc" data-pd-section="{{ sid }}" data-pd-settings="{{ pd_settings | escape }}" data-pd-defaults="{{ pd_defaults | escape }}" data-pd-block-defaults="{{ pd_block_defaults | escape }}" data-pd-sold-out="{{ sold_out_label | escape }}" data-gradient="{% if s.enable_custom_style and s.enable_gradient %}true{% else %}false{% endif %}" style="{{ root_vars | strip_newlines | strip }}">
  <div class="pd-atc__inner">
    {%- capture buy -%}
      {%- if p != blank -%}
        {%- if s.after_add == 'cart' -%}<product-form class="pd-atc__product-form">{%- endif -%}
        <form method="post" action="{{ routes.cart_add_url | default: '/cart/add' }}" accept-charset="UTF-8" enctype="multipart/form-data" class="pd-atc__form" novalidate data-type="add-to-cart-form">
          <input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓">
          {%- if s.after_add != 'cart' -%}<input type="hidden" name="return_to" value="/checkout">{%- endif -%}
          {%- if s.show_variant_picker and p.has_only_default_variant == false and p.variants.size > 1 -%}
            <div class="pd-atc__field">
              <label class="pd-atc__variant-label" for="pd-atc-{{ sid }}-%%BLOCK%%-variant">{{ p.options | join: ' / ' }}</label>
              <select class="pd-atc__variant" id="pd-atc-{{ sid }}-%%BLOCK%%-variant" name="id" data-pd-variant>
                {%- for variant in p.variants -%}
                  <option value="{{ variant.id }}" data-available="{{ variant.available }}"{% if variant.id == v.id %} selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} ({{ sold_out_label | escape }}){% endunless %}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ v.id }}">
          {%- endif -%}
          <input type="hidden" name="quantity" value="1">
          <button type="submit" name="add" class="pd-atc__button btn-primary" data-theme-button="primary" data-sl-button data-button-role="primary" data-available="{{ v.available }}" aria-live="polite"{% unless v.available %} disabled aria-disabled="true"{% endunless %}>
            <span class="pd-atc__label hidden-on-load">{% if v.available %}%%LABEL%%{% else %}{{ sold_out_label | escape }}{% endif %}</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="spin opacity-0 icon-load" aria-hidden="true" focusable="false"><use href="#icon-load"></use></svg>
          </button>
        </form>
        {%- if s.after_add == 'cart' -%}</product-form>{%- endif -%}
      {%- else -%}
        <button type="button" class="pd-atc__button btn-primary" data-theme-button="primary" data-sl-button data-button-role="primary" data-available="true" data-pd-preview><span class="pd-atc__label">%%LABEL%%</span></button>
        <p class="pd-atc__note">Choose a product in this section's settings.</p>
      {%- endif -%}
    {%- endcapture -%}
    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      {%- comment -%}pd-gen:block{%- endcomment -%}{%- case block.type -%}{%- when 'button' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }}}{%- endcapture -%}{%- when 'heading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size_enable":{{ block.settings.size_enable | json }},"size_desktop":{{ block.settings.size_desktop | json }},"size_mobile":{{ block.settings.size_mobile | json }}}{%- endcapture -%}{%- when 'subheading' -%}{%- capture pd_b -%}{"text":{{ block.settings.text | json }},"enable_custom_style":{{ block.settings.enable_custom_style | json }},"color":{{ block.settings.color | append: '' | json }},"size_enable":{{ block.settings.size_enable | json }},"size":{{ block.settings.size | json }}}{%- endcapture -%}{%- endcase -%}{%- comment -%}/pd-gen{%- endcomment -%}
      {%- capture bvars -%}
        {%- capture c -%}{% render 'scheme-color', color: bs.color, fallback: 'none' %}{%- endcapture -%}
        {%- if bs.enable_custom_style and c != 'none' -%}--pd-c: {{ c }};{%- endif -%}
        {%- if bs.size_enable -%}{%- if block.type == 'heading' -%}--pd-fs-d: {{ bs.size_desktop }}px; --pd-fs-m: {{ bs.size_mobile }}px;{%- else -%}--pd-fs: {{ bs.size }}px;{%- endif -%}{%- endif -%}
      {%- endcapture -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="pd-atc__heading" data-pd-block="{{ block.id }}" data-pd-type="heading" data-pd-settings="{{ pd_b | escape }}" style="{{ bvars }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
        {%- when 'subheading' -%}
          <div class="pd-atc__sub" data-pd-block="{{ block.id }}" data-pd-type="subheading" data-pd-settings="{{ pd_b | escape }}" style="{{ bvars }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
        {%- when 'button' -%}
          {%- assign label = bs.text | default: s.button_text | escape -%}
          <div class="pd-atc__buy" data-pd-block="{{ block.id }}" data-pd-type="button" data-pd-settings="{{ pd_b | escape }}" data-label="{{ label }}" {{ block.shopify_attributes }}>{{ buy | replace: '%%LABEL%%', label | replace: '%%BLOCK%%', block.id }}</div>
      {%- endcase -%}
    {%- endfor -%}
    {%- unless has_button -%}
      {%- assign label = s.button_text | escape -%}
      <div class="pd-atc__buy" data-pd-legacy data-label="{{ label }}">{{ buy | replace: '%%LABEL%%', label | replace: '%%BLOCK%%', 'legacy' }}</div>
    {%- endunless -%}
  </div>
</div>
{%- endif -%}
</template>

<schema>
{
  "type": "addtocartbutton",
  "name": "Quick Add to Cart",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "product",
      "id": "selected_product",
      "label": "Select Product"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "use_theme_button",
      "label": "Match theme button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart & Checkout"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_border_thickness",
      "label": "Button Border Thickness (px)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color"
    },
    {
      "type": "range",
      "id": "button_overall_size",
      "label": "Button Overall Size (%)",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Text Font Weight",
      "default": "normal",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable Button Background Gradient",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient Color 1"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color 2"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Gradient Color 3"
    },
    {
      "type": "select",
      "id": "gradient_selector",
      "label": "Gradient Style",
      "default": "linear",
      "options": [
        {
          "value": "linear",
          "label": "Linear"
        },
        {
          "value": "radial",
          "label": "Radial"
        },
        {
          "value": "angular",
          "label": "Angular"
        },
        {
          "value": "diagonal",
          "label": "Diagonal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
