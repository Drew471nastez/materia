<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->


<div
  class="quick-add-to-cart-wrapper color-{{ color_scheme }} gradient {{ section.settings.section_width }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="quick-add-to-cart">
    <button class="quick-add-button btn-primary" data-theme-button="primary" data-sl-button data-button-role="primary" id="quick-add-button">
      {{ section.settings.button_text }}
    </button>
  </div>
</div>

<script>
  (function(){
    function addToCart() {
      // Use the first variant of the selected product.
      var productVariantId = {{ section.settings.selected_product.variants[0].id | default: 0 | json }};
      if (!productVariantId) return;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: productVariantId, quantity: 1 })
      })
      .then(function(response) {
        return response.json();
      })
      .then(function(data) {
        // Redirect to the checkout page after a successful add.
        window.location.href = '/checkout';
      })
      .catch(function(error) {
        console.error('Error:', error);
      });
    }

    var button = document.getElementById('quick-add-button');
    if (button) {
      button.addEventListener('click', addToCart);
    }
  })();
{% comment %}{% endcomment %}</script>

<style>
  .quick-add-to-cart-wrapper {
    text-align: center;
  }
  .quick-add-to-cart {
    display: inline-block;
    z-index: 999;
  }
  /* The button is a theme button (theme-button-contract.css): Theme settings >
     Buttons draw it. Colours and gradients set here, and the shape when the
     theme style is off, reach it as --mb-* tokens. */
  .quick-add-to-cart-wrapper .quick-add-button {
    {%- unless section.settings.use_theme_button -%}
    --mb-padding-y: 15px;
    --mb-padding-x: 25px;
    --mb-font-size: {{ section.settings.button_font_size }}px;
    --btn-border-width: {{ section.settings.button_border_thickness }}px;
    --mb-radius: {{ section.settings.button_border_radius }}px;
    --mb-weight: {{ section.settings.button_font_weight }};
    scale: {{ section.settings.button_overall_size | divided_by: 100.0 }};
    {%- endunless -%}
    --mb-text: {% render 'scheme-color', color: section.settings.button_text_color, fallback: 'var(--btn-primary-color)' %};
    --mb-border: {% render 'scheme-color', color: section.settings.button_border_color, fallback: 'var(--btn-primary-border-color)' %};
    cursor: pointer;
    {% if section.settings.enable_gradient %}
      {% if section.settings.gradient_selector == 'linear' %}
        --mb-bg: linear-gradient(90deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'radial' %}
        --mb-bg: radial-gradient(circle, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'angular' %}
        --mb-bg: conic-gradient({% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'diagonal' %}
        --mb-bg: linear-gradient(45deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'vertical' %}
        --mb-bg: linear-gradient(180deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'horizontal' %}
        --mb-bg: linear-gradient(90deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'cool' %}
        --mb-bg: linear-gradient(135deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'warm' %}
        --mb-bg: linear-gradient(45deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% elsif section.settings.gradient_selector == 'pastel' %}
        --mb-bg: linear-gradient(60deg, {% render 'scheme-color', color: section.settings.gradient_color_1, fallback: 'var(--btn-primary-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_2, fallback: 'var(--btn-primary-hover-bg-color)' %}, {% render 'scheme-color', color: section.settings.gradient_color_3, fallback: 'var(--color-primary)' %});
      {% else %}
        --mb-bg: {% render 'scheme-color', color: section.settings.button_bg_color, fallback: 'var(--btn-primary-bg-color)' %};
      {% endif %}
    {% else %}
      --mb-bg: {% render 'scheme-color', color: section.settings.button_bg_color, fallback: 'var(--btn-primary-bg-color)' %};
    {% endif %}
  }
  .quick-add-to-cart-wrapper .quick-add-button {
    {% if section.settings.enable_gradient %}
      --mb-hover-bg: var(--mb-bg);
    {% else %}
      --mb-hover-bg: {% render 'scheme-color', color: section.settings.button_hover_color, fallback: 'var(--btn-primary-hover-bg-color)' %};
    {% endif %}
  }
  {%- if section.settings.enable_gradient %}
  .quick-add-to-cart-wrapper .quick-add-button:hover { filter: brightness(90%); }
  {%- endif %}
{% comment %}{% endcomment %}</style>

</template>

<schema>
{
  "type": "addtocartbutton",
  "name": "Quick Add to Cart",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "product",
      "id": "selected_product",
      "label": "Select Product"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "use_theme_button",
      "label": "Match theme button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart & Checkout"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_border_thickness",
      "label": "Button Border Thickness (px)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color"
    },
    {
      "type": "range",
      "id": "button_overall_size",
      "label": "Button Overall Size (%)",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18,
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Text Font Weight",
      "default": "normal",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.use_theme_button == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable Button Background Gradient",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient Color 1"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color 2"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Gradient Color 3"
    },
    {
      "type": "select",
      "id": "gradient_selector",
      "label": "Gradient Style",
      "default": "linear",
      "options": [
        {
          "value": "linear",
          "label": "Linear"
        },
        {
          "value": "radial",
          "label": "Radial"
        },
        {
          "value": "angular",
          "label": "Angular"
        },
        {
          "value": "diagonal",
          "label": "Diagonal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "cool",
          "label": "Cool Gradient"
        },
        {
          "value": "warm",
          "label": "Warm Gradient"
        },
        {
          "value": "pastel",
          "label": "Pastel Gradient"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding (px)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (px)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Quick Add Button",
      "category": "Products"
    }
  ],
  "shopify": {
    "name": "Quick Add to Cart",
    "presets": [
      {
        "name": "Quick Add Button",
        "category": "Products"
      }
    ],
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "product",
        "id": "selected_product",
        "label": "Select Product"
      },
      {
        "type": "header",
        "content": "Buttons"
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Match theme button",
        "default": true
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Add to Cart & Checkout"
      },
      {
        "type": "color",
        "id": "button_bg_color",
        "label": "Button Background Color"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button Text Color"
      },
      {
        "type": "color",
        "id": "button_hover_color",
        "label": "Button Hover Color"
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button Border Radius (px)",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 5,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_border_thickness",
        "label": "Button Border Thickness (px)",
        "min": 0,
        "max": 5,
        "step": 1,
        "default": 0,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "color",
        "id": "button_border_color",
        "label": "Button Border Color"
      },
      {
        "type": "range",
        "id": "button_overall_size",
        "label": "Button Overall Size (%)",
        "min": 50,
        "max": 200,
        "step": 10,
        "default": 100,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "range",
        "id": "button_font_size",
        "label": "Button Font Size (px)",
        "min": 10,
        "max": 40,
        "step": 1,
        "default": 18,
        "visible_if": "{{ section.settings.use_theme_button == false }}"
      },
      {
        "type": "select",
        "id": "button_font_weight",
        "label": "Button Text Font Weight",
        "default": "normal",
        "options": [
          {
            "value": "light",
            "label": "Light"
