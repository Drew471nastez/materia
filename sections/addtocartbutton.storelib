  "shopify": {
    "name": "Quick Add to Cart",
    "presets": [
      {
        "name": "Quick Add Button",
        "category": "Products",
        "blocks": [
          {
            "type": "button"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "product",
        "id": "selected_product",
        "label": "Product",
        "info": "On a product page, an empty picker uses that page's product."
      },
      {
        "type": "checkbox",
        "id": "show_variant_picker",
        "label": "Show variant picker",
        "default": false
      },
      {
        "type": "select",
        "id": "after_add",
        "label": "After adding",
        "default": "checkout",
        "options": [
          {
            "value": "checkout",
            "label": "Checkout"
          },
          {
            "value": "cart",
            "label": "Open cart"
          }
        ]
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button label",
        "default": "Add to Cart & Checkout",
        "hidden": true,
        "info": "Legacy: used only when the section has no button block."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "content_gap",
        "label": "Gap between items",
        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "button_bg_color",
        "label": "Button background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_hover_color",
        "label": "Button background (hover)",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_border_color",
        "label": "Button border",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "enable_gradient",
        "label": "Gradient background",
        "default": false,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "select",
        "id": "gradient_selector",
        "label": "Gradient style",
        "default": "linear",
        "options": [
          {
            "value": "linear",
            "label": "Linear"
          },
          {
            "value": "radial",
            "label": "Radial"
          },
          {
            "value": "angular",
            "label": "Angular"
          },
          {
            "value": "diagonal",
            "label": "Diagonal"
          },
          {
            "value": "vertical",
            "label": "Vertical"
          },
          {
            "value": "horizontal",
            "label": "Horizontal"
          },
          {
            "value": "cool",
            "label": "Cool Gradient"
          },
          {
            "value": "warm",
            "label": "Warm Gradient"
          },
          {
            "value": "pastel",
            "label": "Pastel Gradient"
          }
        ],
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "color",
        "id": "gradient_color_1",
        "label": "Gradient color 1",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "color",
        "id": "gradient_color_2",
        "label": "Gradient color 2",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "color",
        "id": "gradient_color_3",
        "label": "Gradient color 3",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.enable_gradient }}"
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Use theme button shape",
        "default": true
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 5,
        "visible_if": "{{ section.settings.use_theme_button == false }}",
        "unit": "px"
      },
      {
        "type": "range",
        "id": "button_border_thickness",
        "label": "Button border width",
        "min": 0,
        "max": 5,
        "step": 1,
        "default": 0,
        "visible_if": "{{ section.settings.use_theme_button == false }}",
        "unit": "px"
      },
      {
