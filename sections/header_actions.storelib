<template>
<header class="s hb" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --hb-logo-w: {{ settings.logo_width }}px; --hb-logo-w-m: {{ settings.logo_width_mobile }}px; --hb-act-size: {{ settings.action_text_size }}px; --hb-gap: {{ settings.action_gap }}px; --hb-bg: {{ settings.button_bg }}; --hb-text: {{ settings.button_text_color }}; --hb-border: {{ settings.button_border }}; --hb-hover-bg: {{ settings.button_hover_bg }}; --hb-hover-text: {{ settings.button_hover_text }}; --hb-hover-border: {{ settings.button_hover_border }};{% if settings.logo_custom_position %} --hb-logo-x: {{ settings.logo_offset_x }}px; --hb-logo-x-m: {{ settings.logo_offset_x_mobile }}px;{% endif %}">
  <div class="hb__in hb__in--{{ settings.max_width }} hb__in--nav-{{ settings.nav_align }} hb--show-{{ settings.actions_display }}">

    <button type="button" class="hb__toggle" data-storelib-menu aria-label="Menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a class="hb__logo" href="{{ settings.logo_url | default: '/' | url }}">
      {% if settings.logo %}
        <img src="{{ settings.logo | asset }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: 3 }}" loading="eager" decoding="async">
      {% elsif theme.logo %}
        <img src="{{ theme.logo.url | asset }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: 3 }}" loading="eager" decoding="async">
      {% else %}
        <span class="hb__name">{{ shop.name }}</span>
      {% endif %}
    </a>

    <nav class="hb__nav" aria-label="Main">
      <ul class="hb__menu">
        {% for link in settings.menu.links %}
          <li class="hb__item{% if link.links.size > 0 %} hb__item--sub{% endif %}">
            <a class="hb__link" href="{{ link.url | url }}">{{ link.title }}</a>
            {% if link.links.size > 0 %}
              <ul class="hb__sub">
                {% for sub in link.links %}
                  <li><a class="hb__sublink" href="{{ sub.url | url }}">{{ sub.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% else %}
          {% if page.in_editor %}<li class="hb__empty">Choose a menu in the sidebar</li>{% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="hb__actions">
      {% if settings.show_search %}
        <button type="button" class="hb__act" data-storelib-search aria-label="Search">
          <svg class="hb__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
          <span class="hb__label">Search</span>
        </button>
      {% endif %}
      {% if settings.show_account %}
        <a class="hb__act" href="{{ routes.account_url | url }}" aria-label="Account">
          <svg class="hb__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          <span class="hb__label">Account</span>
        </a>
      {% endif %}
      {% if settings.show_wishlist %}
        <a class="hb__act" href="{{ settings.wishlist_url | default: '/wishlist' | url }}" aria-label="Wishlist">
          <svg class="hb__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/></svg>
          <span class="hb__label">Wishlist</span>
        </a>
      {% endif %}
      {% if settings.show_cart %}
        <button type="button" class="hb__act" data-storelib-cart aria-label="Cart">
          <svg class="hb__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
          <span class="hb__label">Cart</span>
        </button>
      {% endif %}
      {% if settings.button_label %}
        <a class="hb__btn hb__btn--{{ settings.button_style }}{% if settings.button_custom or settings.button_style == 'custom' %} hb__btn--custom{% endif %}{% if settings.button_mobile %} hb__btn--phone{% endif %}" data-sl-button href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_label }}</a>
      {% endif %}
    </div>

  </div>
</header>
</template>

<style scoped>
.hb { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-family: var(--theme-font-body); position: relative; z-index: 20; }
.hb__in { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: 12px; margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.hb__in--narrow { max-width: 720px; }
.hb__in--medium { max-width: 960px; }
.hb__in--wide { max-width: var(--theme-page-width, 1280px); }
.hb__in--full { max-width: none; }

.hb__toggle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-left: -10px; padding: 0; background: none; border: 0; color: var(--s-heading); cursor: pointer; border-radius: var(--s-radius); }
.hb__toggle svg, .hb__icon { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }

.hb__logo { display: inline-flex; align-items: center; justify-self: start; min-width: 0; max-width: 100%; color: var(--s-heading); text-decoration: none; transform: translateX(var(--hb-logo-x-m, 0px)); }
.hb__logo img { display: block; width: var(--hb-logo-w-m); max-width: 100%; height: auto; object-fit: contain; }
.hb__name { font-family: var(--theme-font-heading); font-size: 20px; font-weight: 700; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.hb__nav { display: none; min-width: 0; }
.hb__menu { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; margin: 0; padding: 0; list-style: none; }
.hb__item { position: relative; }
.hb__link { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 500; color: var(--s-heading); text-decoration: none; white-space: nowrap; transition: opacity 150ms ease; }
.hb__link:hover { opacity: 0.7; }
.hb__sub { position: absolute; top: 100%; left: -16px; min-width: 200px; margin: 0; padding: 8px 0; list-style: none; background: var(--s-bg); border: 1px solid var(--s-border); border-radius: var(--s-radius); opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity 180ms ease, transform 180ms ease, visibility 180ms; }
.hb__item--sub:hover .hb__sub, .hb__item--sub:focus-within .hb__sub { opacity: 1; visibility: visible; transform: none; }
.hb__sublink { display: block; padding: 10px 16px; font-size: 14px; color: var(--s-text); text-decoration: none; }
.hb__sublink:hover { color: var(--s-heading); background: var(--s-border); }
.hb__empty { font-size: 14px; opacity: 0.6; }

.hb__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 4px var(--hb-gap); min-width: 0; }
.hb__act, .hb__act:link, .hb__act:visited, .hb__act:hover, .hb__act:active, .hb__act:focus, .hb__act .hb__label { text-decoration: none; }
.hb__act { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; min-width: 44px; padding: 0; margin: 0; background: none; border: 0; color: var(--s-heading); font-family: var(--theme-font-body); font-size: var(--hb-act-size); font-weight: 500; line-height: 1.2; white-space: nowrap; cursor: pointer; transition: opacity 150ms ease; }
.hb__act:hover { opacity: 0.7; }
.hb__label { display: inline; }
.hb--show-icon .hb__label { display: none; }
.hb--show-text .hb__icon { display: none; }
.hb--show-text .hb__act { min-width: 0; }
.hb--show-both .hb__label { display: none; }

.hb__btn { display: none; align-items: center; justify-content: center; min-height: 44px; padding: var(--sl-button-padding, 12px 22px); font-family: var(--sl-button-font, var(--theme-font-body)); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height, 1.2); font-weight: var(--theme-button-weight, 600); letter-spacing: var(--sl-button-tracking, normal); text-transform: var(--sl-button-transform, none); text-decoration: none; white-space: nowrap; border-radius: var(--theme-button-radius, var(--s-radius)); border: var(--theme-button-border-width, 1px) solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease; }
.hb__btn--phone { display: inline-flex; }
.hb__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.hb__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.hb__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.hb__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); border-color: var(--s-btn2-border); }
.hb__btn.hb__btn--custom { background: var(--hb-bg); color: var(--hb-text); border-color: var(--hb-border); }
.hb__btn.hb__btn--custom:hover { background: var(--hb-hover-bg); color: var(--hb-hover-text); border-color: var(--hb-hover-border); }

.hb__act:focus-visible, .hb__btn:focus-visible, .hb__link:focus-visible, .hb__sublink:focus-visible, .hb__toggle:focus-visible, .hb__logo:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }

@container (min-width: 640px) {
  .hb--show-both .hb__label { display: inline; }
  .hb__btn { display: inline-flex; }
}

@container (min-width: 1024px) {
  .hb__in { column-gap: 32px; }
  .hb__toggle { display: none; }
  .hb__logo { transform: translateX(var(--hb-logo-x, 0px)); }
  .hb__logo img { width: var(--hb-logo-w); }
  .hb__nav { display: block; }
  .hb__in--nav-center .hb__menu { justify-content: center; }
}

@media (prefers-reduced-motion: reduce) { .hb__sub, .hb__btn, .hb__act, .hb__link { transition: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "header_actions",
  "name": "Header With Actions",
  "kind": "header",
  "category": "header",
  "description": "Logo, main menu, search, account, wishlist and cart, and one button that follows the theme's button styles.",
  "version": "1.0.0",
  "icon": "menu",
  "settings": [
    {"type":"header","id":"hdr_content","label":"Content"},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"select","id":"nav_align","label":"Menu position","default":"left","options":[{"label":"Beside the logo","value":"left"},{"label":"Centre","value":"center"}]},
    {"type":"select","id":"actions_display","label":"Actions show as","default":"icon","options":[{"label":"Icon","value":"icon"},{"label":"Text","value":"text"},{"label":"Icon and text","value":"both"}]},
    {"type":"toggle","id":"show_search","label":"Show search","default":true},
    {"type":"toggle","id":"show_account","label":"Show account","default":true},
    {"type":"toggle","id":"show_wishlist","label":"Show wishlist","default":true},
    {"type":"url","id":"wishlist_url","label":"Wishlist link","default":"/wishlist","visible_if":"{{ section.settings.show_wishlist }}"},
    {"type":"toggle","id":"show_cart","label":"Show cart","default":true},
    {"type":"range","id":"action_text_size","label":"Action text size","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"action_gap","label":"Space between actions","min":4,"max":40,"step":4,"unit":"px","default":16},
    {"type":"header","id":"hdr_button","label":"Button"},
    {"type":"text","id":"button_label","label":"Button text","default":"Shop now"},
    {"type":"url","id":"button_url","label":"Button link","default":"/products"},
    {"type":"select","id":"button_style","label":"Button style","default":"primary","options":[{"label":"Theme primary","value":"primary"},{"label":"Theme secondary","value":"secondary"},{"label":"Custom","value":"custom"}]},
    {"type":"toggle","id":"button_mobile","label":"Show button on phones","default":false},
    {"type":"toggle","id":"button_custom","label":"Customise button colours","default":false},
    {"type":"color","id":"button_bg","label":"Background","default":"scheme.primary_button_background","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"button_text_color","label":"Text","default":"scheme.primary_button_text","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"button_border","label":"Border","default":"scheme.primary_button_border","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"button_hover_bg","label":"Hover background","default":"scheme.primary_button_hover_background","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"button_hover_text","label":"Hover text","default":"scheme.primary_button_hover_text","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"color","id":"button_hover_border","label":"Hover border","default":"scheme.primary_button_hover_background","visible_if":"{{ section.settings.button_custom or section.settings.button_style == 'custom' }}"},
    {"type":"header","id":"hdr_logo","label":"Logo"},
    {"type":"image_picker","id":"logo","label":"Logo picture","default":"","info":"Leave empty to use the theme's logo."},
    {"type":"url","id":"logo_url","label":"Logo link","default":"/"},
    {"type":"range","id":"logo_width","label":"Logo width","min":40,"max":300,"step":4,"unit":"px","default":120},
    {"type":"range","id":"logo_width_mobile","label":"Logo width on phones","min":40,"max":200,"step":4,"unit":"px","default":96},
    {"type":"toggle","id":"logo_custom_position","label":"Enable custom logo position","default":false},
    {"type":"range","id":"logo_offset_x","label":"Logo horizontal position","min":-200,"max":200,"step":2,"unit":"px","default":0,"visible_if":"{{ section.settings.logo_custom_position }}"},
    {"type":"range","id":"logo_offset_x_mobile","label":"Logo horizontal position on phones","min":-120,"max":120,"step":2,"unit":"px","default":0,"visible_if":"{{ section.settings.logo_custom_position }}"},
    {"type":"header","id":"hdr_layout","label":"Layout"},
    {"type":"select","id":"max_width","label":"Content width","default":"wide","options":[{"label":"Narrow","value":"narrow"},{"label":"Medium","value":"medium"},{"label":"Wide","value":"wide"},{"label":"Full","value":"full"}]},
    {"type":"header","id":"hdr_style","label":"Style"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"white"},
    {"type":"header","id":"hdr_spacing","label":"Spacing"},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":36},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":36}
  ],
  "presets": [
    {"name":"Header With Actions","settings":{"menu":"main-menu","actions_display":"icon","button_label":"Shop now","button_url":"/products","padding_top":20,"padding_bottom":20}},
    {"name":"Header With Actions on dark","settings":{"menu":"main-menu","color_scheme":"dark","actions_display":"both","padding_top":20,"padding_bottom":20}}
  ]
}
</schema>