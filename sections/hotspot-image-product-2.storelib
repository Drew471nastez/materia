<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- assign fb_accessibility_shop_now = 'accessibility.shop_now' | t -%}
{%- assign fb_accessibility_featured_product = 'accessibility.featured_product' | t -%}
{%- assign fb_accessibility_view_product = 'accessibility.view_product' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Hotspot Image Product 2

  A modern lifestyle/editorial image with circular hotspots overlaid.
  Each hotspot is a block, positioned by % X/Y on the image, tied to a
  product. Clicking a hotspot reveals a small product card popover
  (title, price, image, "shop" link). Mobile-responsive via container
  queries.
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id
  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign hotspot_blocks = section.blocks | where: 'type', 'hotspot'
-%}

<style>
  {%- if s.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .hsp2 {
    container-type: inline-size;
    container-name: hsp2;
    padding: {{ s.padding_top | default: 49 }}px {{ s.side_padding_desktop | default: 24 }}px {{ s.padding_bottom | default: 49 }}px;
    background: {% render 'scheme-color', color: s.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %};
  }
  @container hsp2 (max-width: 760px) {
    #shopify-section-{{ sid }} .hsp2 {
      padding-left: {{ s.side_padding_mobile | default: 16 }}px;
      padding-right: {{ s.side_padding_mobile | default: 16 }}px;
    }
  }

  #shopify-section-{{ sid }} .hsp2__inner {
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .hsp2__head {
    text-align: {{ s.text_align | default: 'center' }};
    margin: 0 0 {{ s.head_gap | default: 24 }}px;
    display: flex; flex-direction: column; gap: 8px;
    align-items: {% if s.text_align == 'left' %}flex-start{% elsif s.text_align == 'right' %}flex-end{% else %}center{% endif %};
  }
  #shopify-section-{{ sid }} .hsp2__eyebrow { margin: 0; text-transform: uppercase; }
  #shopify-section-{{ sid }} .hsp2__heading { margin: 0; font-weight: var(--heading-weight, 700); line-height: 1.1; }
  @container hsp2 (min-width: 760px) {
    #shopify-section-{{ sid }} .hsp2__heading { font-size: var(--h-size-desk, 44px) !important; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .hsp2__heading { font-size: var(--h-size-desk, 44px) !important; }
  }
  #shopify-section-{{ sid }} .hsp2__sub { margin: 0; line-height: 1.55; }
  #shopify-section-{{ sid }} .hsp2__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .hsp2__sub p:last-child { margin: 0; }

  /* Image with hotspots — stage allows popover overflow,
     image is clipped by inner wrap for rounded corners. */
  #shopify-section-{{ sid }} .hsp2__stage {
    position: relative;
    width: 100%;
    aspect-ratio: {{ s.image_aspect_mobile | default: '4 / 5' }};
    overflow: visible;
  }
  #shopify-section-{{ sid }} .hsp2__image-wrap {
    position: absolute; inset: 0;
    border-radius: {{ s.image_radius | default: 18 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'var(--color-border)' %};
  }
  @container hsp2 (min-width: 760px) {
    #shopify-section-{{ sid }} .hsp2__stage {
      aspect-ratio: {{ s.image_aspect_desktop | default: '16 / 9' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .hsp2__stage {
      aspect-ratio: {{ s.image_aspect_desktop | default: '16 / 9' }};
    }
  }
  #shopify-section-{{ sid }} .hsp2__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hotspot dots */
  #shopify-section-{{ sid }} .hsp2__dot {
    position: absolute;
    width: {{ s.dot_size | default: 32 }}px;
    height: {{ s.dot_size | default: 32 }}px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: s.dot_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: s.dot_color, fallback: 'var(--color-heading)' %};
    border: 2px solid {% render 'scheme-color', color: s.dot_border, fallback: 'var(--color-border)' %};
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    z-index: 2;
    padding: 0;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  #shopify-section-{{ sid }} .hsp2__dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: s.dot_pulse_color, fallback: 'color-mix(in srgb, var(--color-background) 50%, transparent)' %};
    opacity: 0;
    animation: hsp2-pulse 2.4s ease-out infinite;
    pointer-events: none;
    z-index: -1;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .hsp2__dot::before { animation: none; }
    #shopify-section-{{ sid }} .hsp2__dot, #shopify-section-{{ sid }} .hsp2__pop { transition: none; }
  }
  @keyframes hsp2-pulse {
    0%   { opacity: 0.6; transform: scale(0.85); }
    70%  { opacity: 0;   transform: scale(1.6);  }
    100% { opacity: 0;   transform: scale(1.6);  }
  }
  #shopify-section-{{ sid }} .hsp2__dot:hover,
  #shopify-section-{{ sid }} .hsp2__dot[aria-expanded="true"] {
    transform: translate(-50%, -50%) scale(1.1);
    box-shadow: 0 6px 20px rgba(0,0,0,0.28);
  }
  #shopify-section-{{ sid }} .hsp2__dot svg {
    width: 50%; height: 50%; fill: currentColor;
  }

  /* Product card popover — smart-positioned & smoothly animated.
     `--pop-y-dir`: 1 = popover BELOW dot, -1 = popover ABOVE dot
     `--pop-x-anchor`: shift x to keep popover inside the stage on edges */
  #shopify-section-{{ sid }} .hsp2__pop {
    position: absolute;
    z-index: 3;
    width: {{ s.pop_width | default: 260 }}px;
    max-width: min({{ s.pop_width | default: 260 }}px, calc(100% - 16px));
    background: {% render 'scheme-color', color: s.pop_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: s.pop_color, fallback: 'var(--color-text)' %};
    border-radius: {{ s.pop_radius | default: 14 }}px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    padding: 12px;
    text-decoration: none;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(calc(-50% + var(--pop-x-shift, 0px)), calc((var(--pop-y-dir, -1) * (100% + {{ s.dot_size | default: 32 | plus: 16 }}px)) + var(--pop-y-bias, -8px)));
    transition: opacity 0.18s ease, transform 0.18s cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0.18s linear;
  }
  #shopify-section-{{ sid }} .hsp2__pop[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(calc(-50% + var(--pop-x-shift, 0px)), calc((var(--pop-y-dir, -1) * (100% + {{ s.dot_size | default: 32 | plus: 16 }}px))));
  }
  #shopify-section-{{ sid }} .hsp2__pop-grid {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    align-items: center;
  }
  #shopify-section-{{ sid }} .hsp2__pop-img {
    width: 64px; height: 64px;
    border-radius: 8px;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'var(--color-border)' %};
  }
  #shopify-section-{{ sid }} .hsp2__pop-img img,
  #shopify-section-{{ sid }} .hsp2__pop-img svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ sid }} .hsp2__pop-info {
    min-width: 0;
    display: flex; flex-direction: column; gap: 2px;
  }
  #shopify-section-{{ sid }} .hsp2__pop-vendor {
    margin: 0;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }
  #shopify-section-{{ sid }} .hsp2__pop-title {
    margin: 0;
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 600);
    font-size: 14px;
    line-height: 1.25;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  #shopify-section-{{ sid }} .hsp2__pop-price {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
  }
  #shopify-section-{{ sid }} .hsp2__pop-price del {
    color: color-mix(in srgb, currentColor 55%, transparent);
    margin-right: 4px;
    font-weight: 400;
  }
  #shopify-section-{{ sid }} .hsp2__pop-cta {
    margin-top: 10px;
    display: block;
    width: 100%;
    text-align: center;
    padding: 8px 12px;
    background: {% render 'scheme-color', color: s.pop_cta_bg, fallback: 'var(--btn-primary-bg-color)' %};
    color: {% render 'scheme-color', color: s.pop_cta_color, fallback: 'var(--btn-primary-color)' %};
    text-decoration: none;
    border-radius: var(--btn-radius, 8px);
    font-size: 13px;
    font-weight: var(--btn-font-weight, 600);
  }

  @container hsp2 (max-width: 540px) {
    #shopify-section-{{ sid }} .hsp2__dot {
      width: {{ s.dot_size | default: 32 | minus: 6 }}px;
      height: {{ s.dot_size | default: 32 | minus: 6 }}px;
    }
    #shopify-section-{{ sid }} .hsp2__pop {
      width: 220px;
    }
  }
{% comment %}{% endcomment %}</style>

<div class="section{{ reset_spacing }}">
  <div class="hsp2 color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
    <div class="hsp2__inner">

      {%- assign eyebrow_block   = section.blocks | where: 'type', 'eyebrow'   | first -%}
      {%- assign heading_block   = section.blocks | where: 'type', 'heading'   | first -%}
      {%- assign sub_block       = section.blocks | where: 'type', 'subheading'| first -%}
      {%- if eyebrow_block or heading_block or sub_block -%}
        <header class="hsp2__head">
          {%- if eyebrow_block and eyebrow_block.settings.text != blank -%}
            {%- assign eb = eyebrow_block.settings -%}
            <p class="hsp2__eyebrow"
               style="color: {% render 'scheme-color', color: eb.color, fallback: 'var(--color-text)' %}; font-size: {{ eb.size | default: 12 }}px; letter-spacing: {{ eb.letter_spacing | default: 0.2 }}em;"
               {{ eyebrow_block.shopify_attributes }}>{{ eb.text | escape }}</p>
          {%- endif -%}
          {%- if heading_block and heading_block.settings.text != blank -%}
            {%- assign hb_t = heading_block.settings -%}
            <{{ hb_t.tag | default: 'h2' }} class="hsp2__heading"
               style="color: {% render 'scheme-color', color: hb_t.color, fallback: 'var(--color-heading)' %}; font-size: {{ hb_t.size_mobile | default: 28 }}px; --h-size-desk: {{ hb_t.size_desktop | default: 44 }}px;"
               {{ heading_block.shopify_attributes }}>{{ hb_t.text | escape }}</{{ hb_t.tag | default: 'h2' }}>
          {%- endif -%}
          {%- if sub_block and sub_block.settings.text != blank -%}
            {%- assign sb = sub_block.settings -%}
            <div class="hsp2__sub"
                 style="color: {% render 'scheme-color', color: sb.color, fallback: 'var(--color-text)' %}; font-size: {{ sb.size | default: 15 }}px; max-width: {{ sb.max_width | default: 560 }}px;"
                 {{ sub_block.shopify_attributes }}>{{ sb.text }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="hsp2__stage" data-hsp2-stage data-hsp2-mode="{{ s.interaction_mode | default: 'click' }}">
        <div class="hsp2__image-wrap">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1800 | image_tag: class: 'hsp2__img', loading: 'lazy', sizes: '(max-width: 760px) 100vw, 90vw', widths: '600, 900, 1200, 1600, 2000' }}
          {%- else -%}
            <img class="hsp2__img" src="{{ s.placeholder_url | default: 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg' }}" alt="" loading="lazy">
          {%- endif -%}
        </div>

        {%- for block in hotspot_blocks -%}
          {%- assign hb = block.settings -%}
          {%- assign p = hb.product -%}
          {%- assign x = hb.position_x | default: 50 -%}
          {%- assign y = hb.position_y | default: 50 -%}
          {%- assign hid = block.id -%}
          <button type="button"
                  class="hsp2__dot"
                  style="left: {{ x }}%; top: {{ y }}%;"
                  aria-expanded="false"
                  aria-controls="hsp2-pop-{{ hid }}"
                  data-hsp2-trigger="{{ hid }}"
                  {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>
            <span class="visually-hidden">{{ p.title | default: fb_accessibility_view_product | escape }}</span>
          </button>
          {%- assign placeholder_src = s.placeholder_url | default: 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg' -%}
          {%- comment -%} If dot is in upper third → popover BELOW dot. Else above. {%- endcomment -%}
          {%- assign pop_y_dir = -1 -%}
          {%- if y < 35 -%}{%- assign pop_y_dir = 1 -%}{%- endif -%}
          {%- comment -%} If dot is far left/right, shift popover so it stays in stage. {%- endcomment -%}
          {%- assign pop_x_shift = 0 -%}
          {%- if x < 25 -%}{%- assign pop_x_shift = 80 -%}{%- elsif x > 75 -%}{%- assign pop_x_shift = -80 -%}{%- endif -%}
          <a class="hsp2__pop"
             id="hsp2-pop-{{ hid }}"
             href="{{ p.url | default: '#' }}"
             style="left: {{ x }}%; top: {{ y }}%; --pop-y-dir: {{ pop_y_dir }}; --pop-x-shift: {{ pop_x_shift }}px;"
             data-hsp2-pop="{{ hid }}"
             data-open="false">
            <div class="hsp2__pop-grid">
              <div class="hsp2__pop-img">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 200 | image_tag: alt: p.title, loading: 'lazy', widths: '120, 200' }}
                {%- else -%}
                  <img src="{{ placeholder_src }}" alt="" loading="lazy">
                {%- endif -%}
              </div>
              <div class="hsp2__pop-info">
                {%- if s.show_vendor and p.vendor != blank -%}<p class="hsp2__pop-vendor">{{ p.vendor }}</p>{%- endif -%}
                <p class="hsp2__pop-title" style="color: {% render 'scheme-color', color: s.pop_title_color, fallback: 'var(--color-heading)' %};">{{ hb.custom_title | default: p.title | default: fb_accessibility_featured_product | escape }}</p>
                {%- if s.show_price and p != blank or s.show_price and hb.fallback_price != blank -%}
                  <p class="hsp2__pop-price" style="color: {% render 'scheme-color', color: s.pop_price_color, fallback: 'var(--color-primary)' %};">
                    {%- if p != blank -%}
                      {%- if p.compare_at_price > p.price -%}<del>{{ p.compare_at_price | money }}</del>{%- endif -%}
                      {{ p.price | money }}
                    {%- else -%}
                      {{ hb.fallback_price | escape }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </div>
            <span class="hsp2__pop-cta">{{ s.cta_label | default: fb_accessibility_shop_now | escape }}</span>
          </a>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  var sid = '{{ sid }}';
  function getStage() {
    var section = document.getElementById('shopify-section-' + sid);
    return section ? section.querySelector('[data-hsp2-stage]') : null;
  }
  function init() {
    var stage = getStage();
    if (!stage || stage.__hsp2Ready) return;
    stage.__hsp2Ready = true;
    var mode = stage.getAttribute('data-hsp2-mode') || 'click';
    var triggers = stage.querySelectorAll('[data-hsp2-trigger]');
    var pops = stage.querySelectorAll('[data-hsp2-pop]');

    function open(trigger, pop) {
      trigger.setAttribute('aria-expanded', 'true');
      pop.setAttribute('data-open', 'true');
    }
    function close(trigger, pop) {
      trigger.setAttribute('aria-expanded', 'false');
      pop.setAttribute('data-open', 'false');
    }
    function closeAll(except) {
      triggers.forEach(function(t) { if (t !== except) t.setAttribute('aria-expanded', 'false'); });
      pops.forEach(function(p) { p.setAttribute('data-open', 'false'); });
    }
    stage.__hsp2CloseAll = closeAll;

    triggers.forEach(function(trigger) {
      var id = trigger.getAttribute('data-hsp2-trigger');
      var pop = stage.querySelector('[data-hsp2-pop="' + id + '"]');
      if (!pop) return;

      // Always handle click: toggles open/close in both modes
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          close(trigger, pop);
        } else {
          closeAll();
          open(trigger, pop);
        }
      });

      if (mode === 'hover') {
        var hoverTimeout;
        function showPop() {
          clearTimeout(hoverTimeout);
          closeAll(trigger);
          open(trigger, pop);
        }
        function hidePop() {
          hoverTimeout = setTimeout(function() { close(trigger, pop); }, 180);
        }
        trigger.addEventListener('pointerenter', showPop);
        trigger.addEventListener('pointerleave', hidePop);
        pop.addEventListener('pointerenter', function() { clearTimeout(hoverTimeout); });
        pop.addEventListener('pointerleave', hidePop);
      }
    });
  }
  init();

  var key = '__hsp2Bound_' + sid;
  if (window[key]) return;
  window[key] = true;
  // Close on any click that is not a dot or popover; Escape closes too
  document.addEventListener('click', function(e) {
    var stage = getStage();
    if (!stage || !stage.__hsp2CloseAll) return;
    var clickedDot = e.target.closest && e.target.closest('[data-hsp2-trigger]');
    var clickedPop = e.target.closest && e.target.closest('[data-hsp2-pop]');
    if (!clickedDot && !clickedPop) stage.__hsp2CloseAll();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    var stage = getStage();
    if (stage && stage.__hsp2CloseAll) stage.__hsp2CloseAll();
  });
  document.addEventListener('storelib:section-load', function(e) {
    if (e.detail && String(e.detail.sectionId) === sid) init();
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "hotspot-image-product-2",
  "name": "Hotspot Image Product 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Heading layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
