            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 9,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 12,
            "visible_if": "{{ block.settings.enable_custom_style }}"
