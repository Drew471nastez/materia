<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Hotspot Image Product 2: a lifestyle image with a dot per
  Hotspot block, placed by % on the picture itself (the cover crop is worked
  out in CSS from the picture's and the frame's aspect ratios, so a dot stays
  on its spot at every width). A dot opens a card with the picked product's
  picture, title, price and link. The dots, cards and live editor updates are
  run by shopify/assets/live-products-c.js (one copy for every instance).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign custom = s.enable_custom_style
  assign fonts = s.enable_custom_fonts
  assign mode = s.interaction_mode | default: 'click'
  assign hotspot_blocks = section.blocks | where: 'type', 'hotspot'
  assign ar_d = s.image_aspect_desktop | default: '16 / 9'
  assign ar_m = s.image_aspect_mobile | default: '4 / 5'
  assign ia = 1.3333
  if s.image != blank and s.image.aspect_ratio != blank
    assign ia = s.image.aspect_ratio
  elsif s.image != blank and s.image.width and s.image.height
    assign ia = s.image.width | times: 1.0 | divided_by: s.image.height
  endif
  case s.text_align
    when 'left'
      assign items = 'flex-start'
    when 'right'
      assign items = 'flex-end'
    else
      assign items = 'center'
  endcase
  assign placeholder_src = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23888%22 fill-opacity=%22.16%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23888%22 fill-opacity=%22.45%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23888%22 fill-opacity=%22.45%22/%3E%3C/svg%3E'
  if s.placeholder_url != blank
    assign placeholder_src = s.placeholder_url
  endif
-%}
{%- if fonts -%}
  {%- if s.heading_font.family != blank -%}{%- assign ff = s.heading_font.fallback_families | default: 'sans-serif' -%}{%- assign hf = s.heading_font.family | append: ', ' | append: ff -%}{%- endif -%}
  {%- if s.body_font.family != blank -%}{%- assign ff = s.body_font.fallback_families | default: 'sans-serif' -%}{%- assign bf = s.body_font.family | append: ', ' | append: ff -%}{%- endif -%}
  <style>{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- capture c_bg -%}{%- if custom -%}{% render 'scheme-color', color: s.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %}{%- else -%}var(--gradient-background, var(--color-background)){%- endif -%}{%- endcapture -%}
{%- capture c_img -%}{%- if custom -%}{% render 'scheme-color', color: s.image_bg, fallback: 'var(--color-border)' %}{%- else -%}var(--color-border){%- endif -%}{%- endcapture -%}
{%- capture c_dot_bg -%}{%- if custom -%}{% render 'scheme-color', color: s.dot_bg, fallback: 'var(--color-background)' %}{%- else -%}var(--color-background){%- endif -%}{%- endcapture -%}
{%- capture c_dot -%}{%- if custom -%}{% render 'scheme-color', color: s.dot_color, fallback: 'var(--color-heading)' %}{%- else -%}var(--color-heading){%- endif -%}{%- endcapture -%}
{%- capture c_dot_border -%}{%- if custom -%}{% render 'scheme-color', color: s.dot_border, fallback: 'var(--color-border)' %}{%- else -%}var(--color-border){%- endif -%}{%- endcapture -%}
{%- capture c_pulse -%}{%- if custom -%}{% render 'scheme-color', color: s.dot_pulse_color, fallback: 'var(--color-background)' %}{%- else -%}var(--color-background){%- endif -%}{%- endcapture -%}
{%- capture c_pop_bg -%}{%- if custom -%}{% render 'scheme-color', color: s.pop_bg, fallback: 'var(--color-background)' %}{%- else -%}var(--color-background){%- endif -%}{%- endcapture -%}
{%- capture c_pop -%}{%- if custom -%}{% render 'scheme-color', color: s.pop_color, fallback: 'var(--color-text)' %}{%- else -%}var(--color-text){%- endif -%}{%- endcapture -%}
{%- capture c_title -%}{%- if custom -%}{% render 'scheme-color', color: s.pop_title_color, fallback: 'var(--color-heading)' %}{%- else -%}var(--color-heading){%- endif -%}{%- endcapture -%}
{%- capture c_price -%}{%- if custom -%}{% render 'scheme-color', color: s.pop_price_color, fallback: 'var(--color-text)' %}{%- else -%}var(--color-text){%- endif -%}{%- endcapture -%}
{%- capture cta_style -%}{%- if custom -%}{% render 'button-overrides', bg: s.pop_cta_bg, text: s.pop_cta_color %}{%- endif -%}{%- endcapture -%}
{%- capture root_vars -%}
--pch-pt: {{ s.padding_top | default: 0 }}px; --pch-pb: {{ s.padding_bottom | default: 0 }}px; --pch-px-d: {{ s.side_padding_desktop | default: 0 }}px; --pch-px-m: {{ s.side_padding_mobile | default: 0 }}px;
--pch-bg: {{ c_bg | strip }}; --pch-hf: {{ hf | default: 'var(--heading-font)' }}; --pch-bf: {{ bf | default: 'var(--body-font)' }};
--pch-align: {{ s.text_align | default: 'center' }}; --pch-items: {{ items }}; --pch-head-gap: {{ s.head_gap | default: 0 }}px;
--pch-ar-d: {{ ar_d }}; --pch-ar-m: {{ ar_m }}; --pch-ba-d: calc({{ ar_d }}); --pch-ba-m: calc({{ ar_m }}); --pch-ia: {{ ia }};
--pch-radius: {{ s.image_radius | default: 0 }}px; --pch-img-bg: {{ c_img | strip }};
--pch-dot: {{ s.dot_size | default: 32 }}px; --pch-dot-bg: {{ c_dot_bg | strip }}; --pch-dot-ink: {{ c_dot | strip }}; --pch-dot-line: {{ c_dot_border | strip }}; --pch-pulse: {{ c_pulse | strip }};
--pch-pop-w: {{ s.pop_width | default: 260 }}px; --pch-pop-r: {{ s.pop_radius | default: 14 }}px; --pch-pop-bg: {{ c_pop_bg | strip }}; --pch-pop-ink: {{ c_pop | strip }}; --pch-title: {{ c_title | strip }}; --pch-price: {{ c_price | strip }};
{%- endcapture -%}

<style>
  {%- if s.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .hsp2 { padding: var(--pch-pt) var(--pch-px-m) var(--pch-pb); background: var(--pch-bg); overflow-x: clip; box-sizing: border-box; }
  #shopify-section-{{ sid }} .hsp2__inner { margin-inline: auto; }
  #shopify-section-{{ sid }} .hsp2[data-width="container"] .hsp2__inner { max-width: var(--page-width, 1300px); }
  #shopify-section-{{ sid }} .hsp2[data-width="fluid_container"] .hsp2__inner { max-width: var(--fluid-container-width, 1500px); }
  #shopify-section-{{ sid }} .hsp2[data-width="stretch_width"] .hsp2__inner { max-width: calc(100% - 3rem); }
  #shopify-section-{{ sid }} .hsp2__head { display: flex; flex-direction: column; gap: 8px; align-items: var(--pch-items); text-align: var(--pch-align); margin: 0 0 var(--pch-head-gap); }
  #shopify-section-{{ sid }} .hsp2__head[hidden], #shopify-section-{{ sid }} .hsp2__head > [hidden] { display: none; }
  #shopify-section-{{ sid }} .hsp2__eyebrow { margin: 0; text-transform: uppercase; color: var(--b-c, var(--color-text)); font-family: var(--pch-bf); font-size: var(--b-fs, 12px); letter-spacing: var(--b-ls, .2em); line-height: 1.4; }
  #shopify-section-{{ sid }} .hsp2__heading { margin: 0; color: var(--b-c, var(--color-heading)); font-family: var(--pch-hf); font-weight: var(--heading-weight, 700); font-size: var(--b-fs-m, var(--h2-size, 32px)); line-height: 1.1; }
  #shopify-section-{{ sid }} .hsp2__sub { margin: 0; color: var(--b-c, var(--color-text)); font-family: var(--pch-bf); font-size: var(--b-fs, var(--body-font-size, 16px)); max-width: var(--b-max, 560px); line-height: 1.55; }
  #shopify-section-{{ sid }} .hsp2__sub > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .hsp2__sub > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .hsp2__stage { position: relative; width: 100%; aspect-ratio: var(--pch-ar-m); --pch-ba: var(--pch-ba-m); --pch-kx: max(1, calc(var(--pch-ia) / var(--pch-ba))); --pch-ky: max(1, calc(var(--pch-ba) / var(--pch-ia))); }
  #shopify-section-{{ sid }} .hsp2__image-wrap { position: absolute; inset: 0; border-radius: var(--pch-radius); overflow: hidden; background: var(--pch-img-bg); }
  #shopify-section-{{ sid }} .hsp2__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .pch-spot { position: absolute; width: 0; height: 0; z-index: 2; left: clamp(22px, calc(50% + (var(--x) - 50%) * var(--pch-kx)), calc(100% - 22px)); top: clamp(22px, calc(50% + (var(--y) - 50%) * var(--pch-ky)), calc(100% - 22px)); }
  #shopify-section-{{ sid }} .pch-spot[data-open] { z-index: 5; }
  #shopify-section-{{ sid }} .pch-spot[hidden] { display: none; }
  #shopify-section-{{ sid }} .pch-dot { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); width: max(44px, var(--pch-dot)); height: max(44px, var(--pch-dot)); display: grid; place-items: center; margin: 0; padding: 0; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} .pch-dot:focus-visible { outline: 2px solid var(--pch-dot-ink); outline-offset: 2px; border-radius: 999px; }
  #shopify-section-{{ sid }} .pch-dot__core { position: relative; width: calc(var(--pch-dot) - 6px); height: calc(var(--pch-dot) - 6px); border-radius: 999px; background: var(--pch-dot-bg); color: var(--pch-dot-ink); border: 2px solid var(--pch-dot-line); box-shadow: 0 4px 14px rgba(0, 0, 0, .18); display: grid; place-items: center; box-sizing: border-box; transition: transform .18s ease; }
  #shopify-section-{{ sid }} .pch-dot__core svg { width: 50%; height: 50%; fill: currentColor; }
  #shopify-section-{{ sid }} .pch-dot__core::before { content: ''; position: absolute; inset: -5px; border-radius: inherit; background: var(--pch-pulse); opacity: 0; z-index: -1; pointer-events: none; }
  #shopify-section-{{ sid }} .hsp2[data-pulse="true"] .pch-dot__core::before { animation: hsp2-pulse 2.4s ease-out infinite; }
  #shopify-section-{{ sid }} .pch-dot:hover .pch-dot__core, #shopify-section-{{ sid }} .pch-dot[aria-expanded="true"] .pch-dot__core { transform: scale(1.1); }
  @keyframes hsp2-pulse { 0% { opacity: .6; transform: scale(.85); } 70%, 100% { opacity: 0; transform: scale(1.6); } }
  #shopify-section-{{ sid }} .pch-pop { position: absolute; left: 0; bottom: calc(var(--pch-dot) / 2 + 10px); transform: translateX(calc(-50% + var(--pch-shift, 0px))); width: min(var(--pch-pop-w), calc(100vw - 32px)); box-sizing: border-box; padding: 12px; border-radius: var(--pch-pop-r); background: var(--pch-pop-bg); color: var(--pch-pop-ink); box-shadow: 0 12px 32px rgba(0, 0, 0, .18); text-align: left; animation: pch-pop-in .18s ease both; }
  #shopify-section-{{ sid }} .pch-pop[data-place="below"] { bottom: auto; top: calc(var(--pch-dot) / 2 + 10px); }
  #shopify-section-{{ sid }} .pch-pop[hidden] { display: none; }
  @keyframes pch-pop-in { from { opacity: 0; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
  #shopify-section-{{ sid }} .hsp2__pop-main { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; align-items: center; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .hsp2__pop-main:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 6px; }
  #shopify-section-{{ sid }} .hsp2__pop-img { width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: var(--pch-img-bg); }
  #shopify-section-{{ sid }} .hsp2__pop-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .hsp2__pop-info { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #shopify-section-{{ sid }} .hsp2__pop-vendor { margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: .12em; opacity: .7; }
  #shopify-section-{{ sid }} .hsp2__pop-title { margin: 0; color: var(--pch-title); font-family: var(--pch-hf); font-weight: var(--heading-weight, 600); font-size: 15px; line-height: 1.25; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  #shopify-section-{{ sid }} .hsp2__pop-price { margin: 0; color: var(--pch-price); font-size: 14px; font-weight: 600; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  #shopify-section-{{ sid }} .hsp2__pop-price s { font-weight: 400; opacity: .6; }
  #shopify-section-{{ sid }} .pch-badge { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: 2px 6px; border-radius: 4px; background: var(--pch-price); color: var(--pch-pop-bg); }
  #shopify-section-{{ sid }} .hsp2__pop-cta { margin-top: 10px; width: 100%; }
  #shopify-section-{{ sid }} [data-pch-hide] { display: none !important; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .hsp2 { padding-inline: var(--pch-px-d); }
    #shopify-section-{{ sid }} .hsp2__heading { font-size: var(--b-fs-d, var(--h2-size, 32px)); }
    #shopify-section-{{ sid }} .hsp2__stage { aspect-ratio: var(--pch-ar-d); --pch-ba: var(--pch-ba-d); }
    #shopify-section-{{ sid }} .pch-dot__core { width: var(--pch-dot); height: var(--pch-dot); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .hsp2[data-pulse="true"] .pch-dot__core::before { animation: none; }
    #shopify-section-{{ sid }} .pch-dot__core { transition: none; }
    #shopify-section-{{ sid }} .pch-pop { animation: none; }
  }
{% comment %}{% endcomment %}</style>

<div class="section{% if s.reset_spacing %} remove_spacing{% endif %}">
  <div class="hsp2 pch color-{{ color_scheme }} gradient" data-section-id="{{ sid }}" data-pch="hsp2" data-pch-section="{{ sid }}" data-pch-mode="{{ mode }}" data-width="{{ s.section_width | default: 'full_width' }}" data-pulse="{% if s.show_pulse == false %}false{% else %}true{% endif %}" data-pch-editing="{% if request.design_mode %}true{% else %}false{% endif %}" data-pch-placeholder="{{ placeholder_src | escape }}" data-pch-settings="{{ s | json | escape }}" data-pch-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;section_width&quot;:&quot;full_width&quot;,&quot;reset_spacing&quot;:true,&quot;show_vendor&quot;:false,&quot;show_price&quot;:true,&quot;cta_label&quot;:&quot;Shop now&quot;,&quot;sold_out_label&quot;:&quot;Sold out&quot;,&quot;text_align&quot;:&quot;center&quot;,&quot;head_gap&quot;:24,&quot;image_aspect_desktop&quot;:&quot;16 / 9&quot;,&quot;image_aspect_mobile&quot;:&quot;4 / 5&quot;,&quot;image_radius&quot;:18,&quot;interaction_mode&quot;:&quot;click&quot;,&quot;dot_size&quot;:32,&quot;show_pulse&quot;:true,&quot;pop_width&quot;:260,&quot;pop_radius&quot;:14,&quot;enable_custom_style&quot;:false,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;padding_top&quot;:49,&quot;padding_bottom&quot;:49,&quot;side_padding_desktop&quot;:24,&quot;side_padding_mobile&quot;:16&#125;" data-pch-block-defaults="&#123;&quot;eyebrow&quot;:&#123;&quot;text&quot;:&quot;Lookbook&quot;,&quot;enable_custom_style&quot;:false,&quot;size&quot;:12,&quot;letter_spacing&quot;:0.2&#125;,&quot;heading&quot;:&#123;&quot;text&quot;:&quot;Shop the look&quot;,&quot;tag&quot;:&quot;h2&quot;,&quot;enable_custom_style&quot;:false,&quot;size_desktop&quot;:44,&quot;size_mobile&quot;:28&#125;,&quot;subheading&quot;:&#123;&quot;max_width&quot;:560,&quot;enable_custom_style&quot;:false,&quot;size&quot;:15&#125;,&quot;hotspot&quot;:&#123;&quot;position_x&quot;:50,&quot;position_y&quot;:50&#125;&#125;" style="{{ root_vars | strip_newlines }}">
    <div class="hsp2__inner">
      {%- assign head_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type != 'hotspot' and block.settings.text != blank -%}{%- assign head_count = head_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      <header class="hsp2__head"{% if head_count == 0 %} hidden{% endif %}>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign own = b.enable_custom_style -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- capture b_c -%}{%- if own -%}{% render 'scheme-color', color: b.color, fallback: 'var(--color-text)' %}{%- else -%}var(--color-text){%- endif -%}{%- endcapture -%}
              <p class="hsp2__eyebrow" data-pch-block="{{ block.id }}" data-pch-type="eyebrow" data-pch-settings="{{ b | json | escape }}" style="--b-c: {{ b_c | strip }}; --b-fs: {% if own %}{{ b.size | default: 12 }}px{% else %}12px{% endif %}; --b-ls: {% if own %}{{ b.letter_spacing | default: 0.2 }}em{% else %}.2em{% endif %};"{% if b.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ b.text }}</p>
            {%- when 'heading' -%}
              {%- capture b_c -%}{%- if own -%}{% render 'scheme-color', color: b.color, fallback: 'var(--color-heading)' %}{%- else -%}var(--color-heading){%- endif -%}{%- endcapture -%}
              <h2 class="hsp2__heading" data-pch-block="{{ block.id }}" data-pch-type="heading" data-pch-settings="{{ b | json | escape }}" style="--b-c: {{ b_c | strip }};{% if own %} --b-fs-d: {{ b.size_desktop | default: 44 }}px; --b-fs-m: {{ b.size_mobile | default: 28 }}px;{% endif %}"{% if b.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ b.text }}</h2>
            {%- when 'subheading' -%}
              {%- capture b_c -%}{%- if own -%}{% render 'scheme-color', color: b.color, fallback: 'var(--color-text)' %}{%- else -%}var(--color-text){%- endif -%}{%- endcapture -%}
              <div class="hsp2__sub" data-pch-block="{{ block.id }}" data-pch-type="subheading" data-pch-settings="{{ b | json | escape }}" style="--b-c: {{ b_c | strip }}; --b-max: {{ b.max_width | default: 560 }}px;{% if own %} --b-fs: {{ b.size | default: 15 }}px;{% endif %}"{% if b.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ b.text }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </header>

      <div class="hsp2__stage" data-pch-stage>
        <div class="hsp2__image-wrap">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1800 | image_tag: class: 'hsp2__img', loading: 'lazy', decoding: 'async', alt: s.image.alt, sizes: '(max-width: 749px) 100vw, 90vw', widths: '600, 900, 1200, 1600, 2000' }}
          {%- else -%}
            <img class="hsp2__img" src="{{ placeholder_src }}" alt="" width="400" height="300" loading="lazy" decoding="async">
          {%- endif -%}
        </div>

        {%- for block in hotspot_blocks -%}
          {%- liquid
            assign hb = block.settings
            assign p = hb.product
            if p != blank and p.title == blank
              assign p = all_products[hb.product]
            endif
            assign title = hb.custom_title | default: p.title
            assign hide_spot = false
            if p == blank and request.design_mode != true
              assign hide_spot = true
            endif
          -%}
          {%- capture spot_json -%}{"position_x":{{ hb.position_x | default: 50 | json }},"position_y":{{ hb.position_y | default: 50 | json }},"custom_title":{{ hb.custom_title | json }}}{%- endcapture -%}
          <div class="pch-spot" data-pch-spot data-pch-block="{{ block.id }}" data-pch-type="hotspot" data-pch-settings="{{ spot_json | escape }}" style="--x: {{ hb.position_x | default: 50 }}%; --y: {{ hb.position_y | default: 50 }}%;"{% if hide_spot %} hidden{% endif %} {{ block.shopify_attributes }}>
            <button type="button" class="pch-dot" data-pch-dot aria-expanded="false" aria-controls="pch-pop-{{ sid }}-{{ block.id }}">
              <span class="pch-dot__core" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg></span>
              <span class="visually-hidden" data-pch-dot-label>{{ title | default: 'Choose a product' | escape }}</span>
            </button>
            <div class="pch-pop hsp2__pop" id="pch-pop-{{ sid }}-{{ block.id }}" data-pch-pop role="group" aria-label="{{ title | default: 'Choose a product' | escape }}" hidden>
              <a class="hsp2__pop-main" href="{% if p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
                <span class="hsp2__pop-img">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 200 | image_tag: alt: '', width: 64, height: 64, loading: 'lazy', decoding: 'async' }}
                  {%- else -%}
                    <img src="{{ placeholder_src }}" alt="" width="64" height="64" loading="lazy" decoding="async">
                  {%- endif -%}
                </span>
                <span class="hsp2__pop-info">
                  {%- if p.vendor != blank -%}<span class="hsp2__pop-vendor" data-pch-show="show_vendor"{% unless s.show_vendor %} data-pch-hide{% endunless %}>{{ p.vendor | escape }}</span>{%- endif -%}
                  <span class="hsp2__pop-title" data-pch-title>{{ title | default: 'Choose a product' | escape }}</span>
                  {%- if p != blank -%}
                    <span class="hsp2__pop-price" data-pch-show="show_price"{% unless s.show_price %} data-pch-hide{% endunless %}>
                      {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
                      <span>{{ p.price | money }}</span>
                      {%- unless p.available -%}<span class="pch-badge" data-pch-text="sold_out_label">{{ s.sold_out_label | default: 'Sold out' | escape }}</span>{%- endunless -%}
                    </span>
                  {%- endif -%}
                </span>
              </a>
              {%- if p != blank -%}
                <a class="hsp2__pop-cta" href="{{ p.url }}" data-theme-button="primary" data-sl-button data-pch-cta data-pch-text="cta_label" style="{{ cta_style | strip }}"{% if s.cta_label == blank %} hidden{% endif %}>{{ s.cta_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
</template>

