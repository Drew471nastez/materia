            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Colour",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 15,
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "hotspot",
        "name": "Hotspot",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product",
            "info": "The card shows its picture, title, price and link. A hotspot with no product is hidden on the live store."
          },
          {
            "type": "text",
            "id": "custom_title",
            "label": "Custom title",
            "hidden": true,
            "info": "Legacy: the card uses the product title."
          },
          {
            "type": "text",
            "id": "fallback_price",
            "label": "Price without product",
            "hidden": true,
            "info": "Legacy: the price comes from the product."
          },
          {
            "type": "range",
            "id": "position_x",
            "label": "Left to right",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50,
            "info": "Measured on the picture, so the dot stays on its spot on phones and desktops."
          },
          {
            "type": "range",
            "id": "position_y",
            "label": "Top to bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          }
        ]
      }
