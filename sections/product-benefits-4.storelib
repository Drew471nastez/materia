        "default": 18
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "label": "Top margin",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "What sets it apart"
          },
          {
            "type": "text",
            "id": "accent",
            "label": "Accent word",
            "default": "apart",
            "info": "A word from the heading drawn in the accent colour."
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "accent_color",
            "label": "Accent color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "spot",
        "name": "Hotspot",
        "limit": 4,
        "settings": [
          {
            "type": "image_picker",
            "id": "thumb",
            "label": "Thumbnail"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Feature"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "A short line about one feature of the product."
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "desc_color",
            "label": "Description",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "text",
            "id": "cta_label",
            "label": "Label",
            "default": "Shop Now"
          },
          {
            "type": "url",
            "id": "cta_link",
            "label": "Link"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "cta_bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "cta_bg_hover",
            "label": "Hover background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "cta_text",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "info": "Colours set above still apply",
            "default": true
          },
          {
            "type": "range",
            "id": "cta_size",
            "label": "Text size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_pad_x",
            "label": "Horizontal padding",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 36,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_pad_y",
            "label": "Vertical padding",
            "min": 8,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_radius",
            "label": "Corner radius",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 4,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Benefits 4",
        "category": "Features",
        "blocks": [
          {
            "type": "heading",
            "settings": {
              "text": "What sets it apart",
              "accent": "apart"
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Crafted with care",
              "description": "Say what the product is made of and how it is finished."
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Built to last",
              "description": "Say how it holds up to daily use."
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Thoughtful design",
              "description": "Point out one detail customers notice first."
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Easy to use",
              "description": "Say how it fits into a normal day."
            }
          },
          {
            "type": "button",
            "settings": {
              "cta_label": "Shop now"
            }
          }
        ]
      }
    ]
