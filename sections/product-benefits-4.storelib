        "type": "range",
        "id": "section_margin_bottom_mobile",
        "label": "Bottom margin (mobile px)",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background"
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "spot",
        "name": "Hotspot",
        "limit": 4,
        "settings": [
          {
            "type": "image_picker",
            "id": "thumb",
            "label": "Thumbnail image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Feature"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title color"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "A short benefit description that highlights one feature of the product."
          },
          {
            "type": "color",
            "id": "desc_color",
            "label": "Description color"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "cta_label",
            "label": "Button label",
            "default": "Shop Now"
          },
          {
            "type": "url",
            "id": "cta_link",
            "label": "Button link"
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "color",
            "id": "cta_bg",
            "label": "Background"
          },
          {
            "type": "color",
            "id": "cta_bg_hover",
            "label": "Hover background"
          },
          {
            "type": "color",
            "id": "cta_text",
            "label": "Text color"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Use theme button style",
            "info": "Colours set above still apply",
            "default": true
          },
          {
            "type": "range",
            "id": "cta_size",
            "label": "Text size",
            "min": 12,
            "max": 22,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_pad_x",
            "label": "Horizontal padding",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 36,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_pad_y",
            "label": "Vertical padding",
            "min": 8,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "cta_radius",
            "label": "Corner radius",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 4,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Benefits 4",
        "category": "Features",
        "blocks": [
          {
            "type": "spot",
            "settings": {
              "title": "Crafted with care",
              "description": "Every detail is considered, from the materials we choose to the finish on each piece."
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Built to last",
