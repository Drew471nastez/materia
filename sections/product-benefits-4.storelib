      },
      {
        "type": "select",
        "id": "heading_font_weight",
        "label": "Heading weight",
        "default": "inherit",
        "options": [
          {
            "value": "inherit",
            "label": "Theme default"
          },
          {
            "value": "300",
            "label": "Light (300)"
          },
          {
            "value": "400",
            "label": "Regular (400)"
          },
          {
            "value": "500",
            "label": "Medium (500)"
          },
          {
            "value": "600",
            "label": "Semibold (600)"
          },
          {
            "value": "700",
            "label": "Bold (700)"
          },
          {
            "value": "800",
            "label": "Extra bold (800)"
          },
          {
            "value": "900",
            "label": "Black (900)"
          }
        ],
        "visible_if": "{{ section.settings.heading_custom_font_enable }}"
      },
      {
        "type": "header",
        "content": "Animation"
