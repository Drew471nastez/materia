        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "desc_size",
        "label": "Feature text size",
        "min": 11,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
