<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_product_label = 'accessibility.product_label' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Product Benefits 4 (Hotspot)
  Center product image with up to 4 feature thumbnails connected by animated
  SVG lines that draw smoothly into the product when the section enters the
  viewport. Endpoint circles pulse after the line completes. Mobile shows a
  smooth horizontal swipeable slider.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}
{%- capture accent -%}{% render 'scheme-color', color: st.line_color, fallback: 'var(--color-primary)' %}{%- endcapture -%}

{%- if st.heading_custom_font_enable and st.heading_font != blank -%}
  {% style %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endstyle %}
{%- endif -%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Margins + reset */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer */
  #shopify-section-{{ sid }} .pb4h {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.padding_top_mobile | default: 56 }}px;
    padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb4h {
      padding-top: {{ st.padding_top_desktop | default: 88 }}px;
      padding-bottom: {{ st.padding_bottom_desktop | default: 88 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb4h__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb4h__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'full_width' -%}
      #shopify-section-{{ sid }} .pb4h__inner { padding-inline: 1rem; }
      @media (min-width: 992px) { #shopify-section-{{ sid }} .pb4h__inner { padding-inline: 0; } }
    {%- else -%}
      #shopify-section-{{ sid }} .pb4h__inner { padding-inline: 1.5rem; }
  {%- endcase -%}

  /* Header */
  #shopify-section-{{ sid }} .pb4h__header {
    text-align: center;
    margin-bottom: {{ st.gap_header_to_grid | default: 32 }}px;
  }
  #shopify-section-{{ sid }} .pb4h__heading { margin: 0; line-height: 1.15; font-size: {{ st.heading_size_mobile | default: 32 }}px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb4h__heading { font-size: {{ st.heading_size_desktop | default: 56 }}px; }
  }

  /* Desktop hotspot grid */
  #shopify-section-{{ sid }} .pb4h__stage {
    position: relative;
    display: none;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb4h__stage {
      display: grid;
      grid-template-columns: 1fr {{ st.image_size_desktop | default: 460 }}px 1fr;
      gap: {{ st.col_gap | default: 24 }}px;
      align-items: center;
    }
  }
  #shopify-section-{{ sid }} .pb4h__col {
    display: flex;
    flex-direction: column;
    gap: {{ st.tab_gap_desktop | default: 64 }}px;
  }
  #shopify-section-{{ sid }} .pb4h__col--left  { align-items: flex-start; }
  #shopify-section-{{ sid }} .pb4h__col--right { align-items: flex-end;   }

  /* Tab thumbnail + content */
  #shopify-section-{{ sid }} .pb4h__tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: inherit;
    text-align: inherit;
    max-width: 320px;
  }
  #shopify-section-{{ sid }} .pb4h__col--left  .pb4h__tab { text-align: center; align-items: center; }
  #shopify-section-{{ sid }} .pb4h__col--right .pb4h__tab { text-align: center; align-items: center; }
  #shopify-section-{{ sid }} .pb4h__thumb {
    width: {{ st.thumb_size | default: 80 }}px;
    height: {{ st.thumb_size | default: 80 }}px;
    border-radius: {{ st.thumb_radius | default: 16 }}px;
    overflow: hidden;
    background-color: {% render 'scheme-color', color: st.thumb_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
    {%- if st.thumb_shadow -%}
    box-shadow: 0 6px 18px -8px rgba(0,0,0,.18);
    {%- else -%}
    box-shadow: none;
    {%- endif -%}
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .pb4h__thumb img,
  #shopify-section-{{ sid }} .pb4h__thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ sid }} .pb4h__title  {
    margin: {{ st.gap_thumb_to_title | default: 12 }}px 0 6px;
    line-height: 1.25;
    font-size: {{ st.title_size | default: 18 }}px;
    font-weight: var(--heading-weight, 700);
  }
  #shopify-section-{{ sid }} .pb4h__desc {
    margin: 0;
    line-height: 1.55;
    font-size: {{ st.desc_size | default: 14 }}px;
  }

  /* Center product image */
  #shopify-section-{{ sid }} .pb4h__product {
    width: 100%;
    max-width: {{ st.image_size_desktop | default: 460 }}px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    border-radius: {{ st.product_radius | default: 24 }}px;
    overflow: hidden;
    background-color: {% render 'scheme-color', color: st.product_bg, fallback: 'var(--color-background)' %};
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ sid }} .pb4h__product img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ===== Product image animation (constant / looping) =====
     Applied to both the desktop centre image and the mobile slide image.
     Default is "none". Honors prefers-reduced-motion. */
  {%- assign pb4_anim = st.product_image_animation | default: 'none' -%}
  {%- if pb4_anim != 'none' and pb4_anim != blank -%}
    {%- liquid
      assign pb4_anim_timing = 'ease-in-out'
      assign pb4_anim_dur = '4s'
      assign pb4_anim_name = ''
      case pb4_anim
        when 'float_up'
          assign pb4_anim_name = 'pb4hFloatUp'
          assign pb4_anim_kf = '0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}'
          assign pb4_anim_dur = '4s'
        when 'float_right'
          assign pb4_anim_name = 'pb4hFloatRight'
          assign pb4_anim_kf = '0%,100%{transform:translateX(0)}50%{transform:translateX(10px)}'
          assign pb4_anim_dur = '4s'
        when 'float_diagonal'
          assign pb4_anim_name = 'pb4hFloatDiag'
          assign pb4_anim_kf = '0%,100%{transform:translate(0,0)}50%{transform:translate(9px,-9px)}'
          assign pb4_anim_dur = '4.5s'
        when 'push'
          assign pb4_anim_name = 'pb4hPush'
          assign pb4_anim_kf = '0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-7px) scale(1.03)}'
          assign pb4_anim_dur = '3s'
        when 'zoom'
          assign pb4_anim_name = 'pb4hZoom'
          assign pb4_anim_kf = '0%,100%{transform:scale(1)}50%{transform:scale(1.06)}'
          assign pb4_anim_dur = '3.5s'
        when 'buzz'
          assign pb4_anim_name = 'pb4hBuzz'
          assign pb4_anim_kf = '0%,100%{transform:translate(0,0)}10%{transform:translate(-1px,-1px)}20%{transform:translate(1px,1px)}30%{transform:translate(-1px,1px)}40%{transform:translate(1px,-1px)}50%{transform:translate(-1px,-1px)}60%{transform:translate(1px,1px)}70%{transform:translate(-1px,1px)}80%{transform:translate(1px,-1px)}90%{transform:translate(-1px,0)}'
          assign pb4_anim_dur = '0.7s'
          assign pb4_anim_timing = 'linear'
        when 'sway'
          assign pb4_anim_name = 'pb4hSway'
          assign pb4_anim_kf = '0%,100%{transform:rotate(-1.6deg)}50%{transform:rotate(1.6deg)}'
          assign pb4_anim_dur = '4s'
      endcase
    -%}
    {%- if pb4_anim_name != '' -%}
      @keyframes {{ pb4_anim_name }}-{{ sid }} { {{ pb4_anim_kf }} }
      #shopify-section-{{ sid }} .pb4h__product img,
      #shopify-section-{{ sid }} .pb4h__slide-product img {
        animation: {{ pb4_anim_name }}-{{ sid }} {{ pb4_anim_dur }} {{ pb4_anim_timing }} infinite;
        transform-origin: center;
        will-change: transform;
        backface-visibility: hidden;
      }
      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ sid }} .pb4h__product img,
        #shopify-section-{{ sid }} .pb4h__slide-product img { animation: none !important; }
      }
    {%- endif -%}
  {%- endif -%}

  /* SVG line overlay (desktop only) — sits ABOVE the product so dots are visible
     and the lines don't get hidden behind the product image */
  #shopify-section-{{ sid }} .pb4h__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }
  #shopify-section-{{ sid }} .pb4h__lines svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  #shopify-section-{{ sid }} .pb4h__line {
    fill: none;
    stroke: {{ accent }};
    stroke-width: {{ st.line_thickness | default: 2 }};
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 1.4s cubic-bezier(.45,.05,.25,1);
    vector-effect: non-scaling-stroke;
  }
  #shopify-section-{{ sid }} .pb4h--revealed .pb4h__line {
    stroke-dashoffset: 0;
  }
  /* Per-line stagger for more natural reveal */
  #shopify-section-{{ sid }} .pb4h__line:nth-child(2) { transition-delay: .12s; }
  #shopify-section-{{ sid }} .pb4h__line:nth-child(3) { transition-delay: .24s; }
  #shopify-section-{{ sid }} .pb4h__line:nth-child(4) { transition-delay: .36s; }
  /* Dots are rendered as their own absolutely-positioned divs (not SVG) so
     they always paint as a perfect circle regardless of the SVG's
     preserveAspectRatio stretching. */
  #shopify-section-{{ sid }} .pb4h__dot {
    position: absolute;
    width: {{ st.dot_size | default: 12 }}px;
    height: {{ st.dot_size | default: 12 }}px;
    background: {{ accent }};
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
    transition: opacity .3s ease 1.2s;
    z-index: 4;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .pb4h--revealed .pb4h__dot {
    opacity: 1;
    animation: pb4h-pulse 1.8s ease-in-out 1.3s infinite;
  }
  @keyframes pb4h-pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-50%, -50%) scale(1.5); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pb4h__line { transition: none; stroke-dashoffset: 0; }
    #shopify-section-{{ sid }} .pb4h__dot  { animation: none; opacity: 1; }
  }

  /* Mobile slider — single feature visible at a time WITH product image + line */
  #shopify-section-{{ sid }} .pb4h__slider {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    padding: 4px 16px 16px;
    margin: 0 -16px;
  }
  #shopify-section-{{ sid }} .pb4h__slider::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .pb4h__slide {
    flex: 0 0 calc(100% - 32px);
    scroll-snap-align: center;
    background-color: {% render 'scheme-color', color: st.mobile_card_bg, fallback: 'var(--color-background)' %};
    border-radius: {{ st.mobile_card_radius | default: 18 }}px;
    padding: 20px;
    box-shadow: 0 8px 24px -14px rgba(0,0,0,.12);
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    overflow: hidden;
  }
  /* Top row: thumb + title + description */
  #shopify-section-{{ sid }} .pb4h__slide-top {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    position: relative;
    z-index: 2;
  }
  #shopify-section-{{ sid }} .pb4h__slide-thumb {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    background-color: {% render 'scheme-color', color: st.thumb_bg, fallback: 'color-mix(in srgb, var(--color-text) 5%, var(--color-background))' %};
    {%- if st.thumb_shadow -%}
    box-shadow: 0 6px 18px -8px rgba(0,0,0,.18);
    {%- else -%}
    box-shadow: none;
    {%- endif -%}
    flex-shrink: 0;
  }
  #shopify-section-{{ sid }} .pb4h__slide-thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ sid }} .pb4h__slide-text { flex: 1; min-width: 0; }
  #shopify-section-{{ sid }} .pb4h__slide-title {
    margin: 0 0 4px; font-weight: var(--heading-weight, 700); line-height: 1.25; font-size: 16px;
  }
  #shopify-section-{{ sid }} .pb4h__slide-desc {
    margin: 0; line-height: 1.5; font-size: 13px;
  }

  /* Bottom row: product image fills the width and the L-shaped connector
     OVERLAYS the image (z-index above) so the line + pulsing dot visually
     point INTO the product. The thumb's bottom-center anchors the vertical
     segment; the horizontal segment crosses ~30% into the image and the dot
     sits on the image surface itself. */
  #shopify-section-{{ sid }} .pb4h__slide-bottom {
    position: relative;
    margin-top: 4px;
    overflow: visible;
  }
  #shopify-section-{{ sid }} .pb4h__slide-product {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: {% render 'scheme-color', color: st.product_bg, fallback: 'var(--color-background)' %};
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ sid }} .pb4h__slide-product img {
    width: 100%; height: 100%; object-fit: contain; display: block;
  }
  #shopify-section-{{ sid }} .pb4h__slide-connector {
    position: absolute;
    top: 0;
    left: 0;
    /* Overlay extends past the image's left edge into ~30% of the image so
       the dot lands on top of the product. */
    width: calc(28px + {{ st.mobile_line_reach | default: 30 }}%);
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }
  #shopify-section-{{ sid }} .pb4h__slide-connector::before {
    /* Vertical segment — STOPS at the bend (50% down) so the connector
       forms a clean L without continuing past the horizontal segment. */
    content: '';
    position: absolute;
    top: 0;
    left: 28px;
    transform: translateX(-50%);
    width: {{ st.line_thickness | default: 2 }}px;
    height: calc(50% + {{ st.line_thickness | default: 2 | divided_by: 2 }}px);
    background: {{ accent }};
    border-radius: 999px;
  }
  #shopify-section-{{ sid }} .pb4h__slide-connector::after {
    /* Horizontal segment from the vertical line into the product image. */
    content: '';
    position: absolute;
    top: calc(50% - {{ st.line_thickness | default: 2 | divided_by: 2 }}px);
    left: 28px;
    width: calc(100% - 28px);
    height: {{ st.line_thickness | default: 2 }}px;
    background: {{ accent }};
    border-radius: 999px;
  }
  #shopify-section-{{ sid }} .pb4h__slide-dot {
    position: absolute;
    top: 50%;
    right: 0;
    width: {{ st.dot_size | default: 12 }}px;
    height: {{ st.dot_size | default: 12 }}px;
    margin-right: -{{ st.dot_size | default: 12 | divided_by: 2 }}px;
    background: {{ accent }};
    border-radius: 50%;
    transform: translateY(-50%);
    animation: pb4h-mpulse 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pb4h__slide-dot { animation: none; }
  }
  @keyframes pb4h-mpulse {
    0%, 100% { transform: translateY(-50%) scale(1); }
    50%      { transform: translateY(-50%) scale(1.6); }
  }
  #shopify-section-{{ sid }} .pb4h__slider-arrows {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 12px;
    padding-inline: 16px;
  }
  #shopify-section-{{ sid }} .pb4h__arrow {
    width: 44px; height: 44px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background-color: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-heading);
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .pb4h__arrow:hover { background-color: var(--color-heading); color: var(--color-background); border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .pb4h__arrow svg { width: 16px; height: 16px; }
  @media (min-width: 992px) {
    #shopify-section-{{ sid }} .pb4h__mobile { display: none; }
  }
  @media (max-width: 991.98px) {
    #shopify-section-{{ sid }} .pb4h__stage { display: none; }
  }

  /* CTA (rendered from Button blocks — colors/sizing are scoped per block) */
  #shopify-section-{{ sid }} .pb4h__cta-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: {{ st.gap_grid_to_cta | default: 36 }}px;
  }
  #shopify-section-{{ sid }} .pb4h__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pb4h__cta,
    #shopify-section-{{ sid }} .pb4h__arrow { transition: none; }
  }
{% comment %}{% endcomment %}</style>

<section class="pb4h-wrap color-{{ color_scheme }} gradient"{% unless st.reveal %} data-ti-no-reveal{% endunless %}>
  <div class="pb4h">
    <div class="pb4h__inner">
      {%- if st.heading != blank or st.heading_accent != blank -%}
        {%- liquid
          # Color the accent IN PLACE: find the accent word inside the heading
          # text and wrap THAT occurrence in a colored span. It does NOT append
          # a separate word. If the accent word isn't found in the heading, the
          # heading is shown unchanged (nothing extra is added).
          assign pb4_accent_color = accent
          if st.heading_accent_color != blank and st.heading_accent_color.alpha != 0
            assign pb4_accent_color = st.heading_accent_color
          endif
          capture pb4_accent_span
            echo '<span style="color: '
            echo pb4_accent_color
            echo '">'
            echo st.heading_accent
            echo '</span>'
          endcapture
          assign pb4_heading_html = st.heading
          if st.heading != blank and st.heading_accent != blank and st.heading contains st.heading_accent
            assign pb4_heading_html = st.heading | replace: st.heading_accent, pb4_accent_span
          elsif st.heading == blank and st.heading_accent != blank
            assign pb4_heading_html = pb4_accent_span
          endif
        -%}
        <div class="pb4h__header">
          <{{ st.heading_tag | default: 'h2' }} class="pb4h__heading"
             style="color: {% render 'scheme-color', color: st.heading_color, fallback: 'var(--color-heading)' %} !important;{% if st.heading_custom_font_enable and st.heading_font != blank %}font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};font-style: {{ st.heading_font.style }};{% endif %}{% if st.heading_font_weight != blank and st.heading_font_weight != 'inherit' %}font-weight: {{ st.heading_font_weight }};{% elsif st.heading_custom_font_enable and st.heading_font != blank %}font-weight: {{ st.heading_font.weight }};{% endif %}">{{ pb4_heading_html }}</{{ st.heading_tag | default: 'h2' }}>
        </div>
      {%- endif -%}

      {%- comment -%}========== Desktop hotspot stage ==========={%- endcomment -%}
      <div class="pb4h__stage" data-pb4h-stage>
        <div class="pb4h__col pb4h__col--left">
          {%- assign idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'spot' and idx < 2 -%}
              {%- assign bs = block.settings -%}
              <div class="pb4h__tab" {{ block.shopify_attributes }}>
                <div class="pb4h__thumb">
                  {%- if bs.thumb -%}
                    <img src="{{ bs.thumb | image_url: width: 200 }}" alt="{{ bs.title | default: 'thumb' | escape }}" loading="lazy">
                  {%- else -%}
                    {%- capture demo_thumb -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}
                    {%- assign demo_thumb = demo_thumb | strip -%}
                    {%- if demo_thumb != blank -%}
                      <img src="{{ demo_thumb }}" alt="{{ bs.title | default: 'thumb' | escape }}" loading="lazy">
                    {%- else -%}
                      <img src="{{ placeholder }}" alt="thumb" loading="lazy">
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if bs.title != blank -%}<h3 class="pb4h__title" style="color: {% render 'scheme-color', color: bs.title_color, fallback: 'var(--color-heading)' %} !important;">{{ bs.title | escape }}</h3>{%- endif -%}
                {%- if bs.description != blank -%}<p class="pb4h__desc" style="color: {% render 'scheme-color', color: bs.desc_color, fallback: 'var(--color-text)' %} !important;">{{ bs.description | escape }}</p>{%- endif -%}
              </div>
              {%- assign idx = idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pb4h__product">
          {%- if st.product_image -%}
            <img src="{{ st.product_image | image_url: width: 900 }}" alt="{{ st.product_image.alt | default: fb_accessibility_product_label | escape }}" loading="lazy" width="{{ st.product_image.width }}" height="{{ st.product_image.height }}">
          {%- else -%}
            {%- capture demo_product -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
            {%- assign demo_product = demo_product | strip -%}
            {%- if demo_product != blank -%}
              <img src="{{ demo_product }}" alt="{{ fb_accessibility_product_label | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ placeholder }}" alt="{{ 'accessibility.product_placeholder' | t }}" loading="lazy" width="900" height="900">
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="pb4h__col pb4h__col--right">
          {%- assign idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'spot' -%}
              {%- if idx >= 2 -%}
                {%- assign bs = block.settings -%}
                <div class="pb4h__tab" {{ block.shopify_attributes }}>
                  <div class="pb4h__thumb">
                    {%- if bs.thumb -%}
                      <img src="{{ bs.thumb | image_url: width: 200 }}" alt="{{ bs.title | default: 'thumb' | escape }}" loading="lazy">
                    {%- else -%}
                      {%- capture demo_thumb -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}
                      {%- assign demo_thumb = demo_thumb | strip -%}
                      {%- if demo_thumb != blank -%}
                        <img src="{{ demo_thumb }}" alt="{{ bs.title | default: 'thumb' | escape }}" loading="lazy">
                      {%- else -%}
                        <img src="{{ placeholder }}" alt="thumb" loading="lazy">
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                  {%- if bs.title != blank -%}<h3 class="pb4h__title" style="color: {% render 'scheme-color', color: bs.title_color, fallback: 'var(--color-heading)' %} !important;">{{ bs.title | escape }}</h3>{%- endif -%}
                  {%- if bs.description != blank -%}<p class="pb4h__desc" style="color: {% render 'scheme-color', color: bs.desc_color, fallback: 'var(--color-text)' %} !important;">{{ bs.description | escape }}</p>{%- endif -%}
                </div>
              {%- endif -%}
              {%- assign idx = idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%}
          SVG lines: each line goes from a thumbnail edge straight horizontally
          toward the product, then bends down into a hotspot point on the image.
          Path style matches the screenshot reference (right-angled bends).
        {%- endcomment -%}
        <div class="pb4h__lines">
          <svg viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
            <!--
              Lines connect the corner thumbnails to the corners of the product.
              Each line runs horizontally from thumb, then bends 90° down/up to
              land at the perimeter of the product image (not inside it).
            -->
            <!-- Top-left thumb (240,150) → product top-left corner (335,200) -->
            <path class="pb4h__line" d="M 240 150 H 335 V 200"/>
            <!-- Bottom-left thumb (240,450) → product bottom-left corner (335,400) -->
            <path class="pb4h__line" d="M 240 450 H 335 V 400"/>
            <!-- Top-right thumb (760,150) → product top-right corner (665,200) -->
            <path class="pb4h__line" d="M 760 150 H 665 V 200"/>
            <!-- Bottom-right thumb (760,450) → product bottom-right corner (665,400) -->
            <path class="pb4h__line" d="M 760 450 H 665 V 400"/>
          </svg>
          <!-- Hotspot dots positioned with % so they remain perfect circles
               regardless of the SVG's non-uniform aspect ratio. -->
          <span class="pb4h__dot" style="left: 33.5%; top: 33.33%;"></span>
          <span class="pb4h__dot" style="left: 33.5%; top: 66.66%;"></span>
          <span class="pb4h__dot" style="left: 66.5%; top: 33.33%;"></span>
          <span class="pb4h__dot" style="left: 66.5%; top: 66.66%;"></span>
        </div>
      </div>

      {%- comment -%}========== Mobile slider ==========={%- endcomment -%}
      <div class="pb4h__mobile">
        <div class="pb4h__slider" data-pb4h-slider>
          {%- for block in section.blocks -%}
            {%- if block.type == 'spot' -%}
              {%- assign bs = block.settings -%}
              <div class="pb4h__slide" {{ block.shopify_attributes }}>
                <div class="pb4h__slide-top">
                  {%- if bs.thumb -%}
                    <div class="pb4h__slide-thumb">
                      <img src="{{ bs.thumb | image_url: width: 200 }}" alt="" loading="lazy">
                    </div>
                  {%- else -%}
                    {%- capture demo_thumb -%}{%- render 'demo-image', key: block.id -%}{%- endcapture -%}
                    {%- assign demo_thumb = demo_thumb | strip -%}
                    <div class="pb4h__slide-thumb">
                      {%- if demo_thumb != blank -%}
                        <img src="{{ demo_thumb }}" alt="" loading="lazy">
                      {%- else -%}
                        <img src="{{ placeholder }}" alt="" loading="lazy">
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <div class="pb4h__slide-text">
                    {%- if bs.title != blank -%}
                      <h3 class="pb4h__slide-title" style="color: {% render 'scheme-color', color: bs.title_color, fallback: 'var(--color-heading)' %} !important;">{{ bs.title | escape }}</h3>
                    {%- endif -%}
                    {%- if bs.description != blank -%}
                      <p class="pb4h__slide-desc" style="color: {% render 'scheme-color', color: bs.desc_color, fallback: 'var(--color-text)' %} !important;">{{ bs.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
                <div class="pb4h__slide-bottom">
                  <span class="pb4h__slide-connector" aria-hidden="true">
                    <span class="pb4h__slide-dot"></span>
                  </span>
                  <div class="pb4h__slide-product">
                    {%- if st.product_image -%}
                      <img src="{{ st.product_image | image_url: width: 600 }}" alt="" loading="lazy">
                    {%- else -%}
                      {%- capture demo_product -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
                      {%- assign demo_product = demo_product | strip -%}
                      {%- if demo_product != blank -%}
                        <img src="{{ demo_product }}" alt="" loading="lazy">
                      {%- else -%}
                        <img src="{{ placeholder }}" alt="" loading="lazy">
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="pb4h__slider-arrows">
          <button type="button" class="pb4h__arrow" data-pb4h-prev aria-label="{{ 'accessibility.previous' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="pb4h__arrow" data-pb4h-next aria-label="{{ 'accessibility.next' | t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      {%- comment -%}========== Button blocks ==========={%- endcomment -%}
      {%- assign button_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' and block.settings.cta_label != blank -%}{%- assign button_count = button_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if button_count > 0 -%}
        <div class="pb4h__cta-wrap">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' and block.settings.cta_label != blank -%}
              {%- assign cs = block.settings -%}
              <style>
                #shopify-section-{{ sid }} #pb4h-cta-{{ block.id }} {
                  {%- if cs.use_theme_button == false %}
                  padding: {{ cs.cta_pad_y | default: 16 }}px {{ cs.cta_pad_x | default: 36 }}px;
                  border-radius: {{ cs.cta_radius | default: 4 }}px;
                  font-size: {{ cs.cta_size | default: 16 }}px;
                  --btn-primary-bg-color: {% render 'scheme-color', color: cs.cta_bg, fallback: 'var(--color-primary)' %};
                  --btn-primary-color: {% render 'scheme-color', color: cs.cta_text, fallback: 'var(--color-background)' %};
                  --btn-primary-hover-bg-color: {% render 'scheme-color', color: cs.cta_bg_hover, fallback: 'var(--color-heading)' %};
                  --btn-primary-hover-color: {% render 'scheme-color', color: cs.cta_text_hover, fallback: 'var(--color-background)' %};
                  --btn-bg: var(--btn-primary-bg-color);
                  --btn-rest-bg: var(--btn-primary-bg-color);
                  --btn-color: var(--btn-primary-color);
                  --btn-border-color: var(--btn-primary-bg-color);
                  background-color: var(--btn-primary-bg-color);
                  color: var(--btn-primary-color);
                  {%- endif %}
                }
{% comment %}{% endcomment %}              </style>
              <a id="pb4h-cta-{{ block.id }}" class="pb4h__cta btn btn-primary" data-sl-button data-button-role="primary" href="{{ cs.cta_link | default: routes.all_products_collection_url | default: '/collections/all' }}" {{ block.shopify_attributes }}>{{ cs.cta_label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  function initPb4h() {
  var stage = document.querySelector('#shopify-section-{{ sid }} [data-pb4h-stage]');
  if (stage && !stage.__pb4hInit) {
    stage.__pb4hInit = true;
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          stage.classList.add('pb4h--revealed');
          io.disconnect();
        }
      });
    }, { threshold: 0.25, rootMargin: '0px 0px -80px 0px' });
    io.observe(stage);
  }

  var slider = document.querySelector('#shopify-section-{{ sid }} [data-pb4h-slider]');
  if (slider && !slider.__pb4hInit) {
    slider.__pb4hInit = true;
    var prev = document.querySelector('#shopify-section-{{ sid }} [data-pb4h-prev]');
    var next = document.querySelector('#shopify-section-{{ sid }} [data-pb4h-next]');
    function scrollByCard(dir) {
      var card = slider.querySelector('.pb4h__slide');
      if (!card) return;
      var w = card.getBoundingClientRect().width + 16;
      slider.scrollBy({ left: dir * w, behavior: 'smooth' });
    }
    if (prev) prev.addEventListener('click', function() { scrollByCard(-1); });
    if (next) next.addEventListener('click', function() { scrollByCard(1);  });
  }
  }
  initPb4h();
  window.__pb4hListen = window.__pb4hListen || {};
  if (!window.__pb4hListen['{{ sid }}']) {
    window.__pb4hListen['{{ sid }}'] = true;
    document.addEventListener('storelib:section-load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ sid }}') initPb4h();
    });
  }
})();
{% comment %}{% endcomment %}</script>



</template>

