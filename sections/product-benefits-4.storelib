            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Thoughtful design",
              "description": "Refined details that elevate the everyday, made to look as good as they feel."
            }
          },
          {
            "type": "spot",
            "settings": {
              "title": "Trusted by many",
              "description": "Loved by customers and reviewers who care about quality and longevity."
            }
          },
          {
            "type": "button",
            "settings": {
