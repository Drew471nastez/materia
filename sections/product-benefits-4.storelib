        "unit": "px",
        "default": 88
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 88
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin",
        "min": -200,
        "max": 200,
        "step": 4,
        "default": 0
      },
