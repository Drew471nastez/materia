<template compat="shopify">
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Progress Circles
  Single row of large stat rings: percent inside the ring, label below.
  Block-based: stat (icon-style cards). Optional heading + subheading + footnote.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.text_align
    when 'left'
      assign _ai = 'flex-start'
      assign _ta = 'left'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'center'
      assign _ta = 'center'
  endcase

  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign stat_count  = stat_blocks | size
  if stat_count == 0
    assign stat_count = 1
  endif
-%}

<style>
  {%- if st.enable_custom_fonts and st.body_font -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} :is(p, div, span, a, li) {
      font-family: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};
      font-weight: {{ st.body_font.weight }};
    }
  {%- endif -%}
  {%- if st.enable_custom_fonts and st.heading_font -%}
    #shopify-section-{{ sid }} :is(h1, h2, h3, h4, h5, h6) {
      font-family: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};
      font-weight: {{ st.heading_font.weight }};
    }
  {%- endif -%}

  #shopify-section-{{ sid }} {
    background-color: {{ st.section_bg | default: '#FAFAFA' }};
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
  {%- endif -%}

  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pgr__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pgr__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .pgr__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  #shopify-section-{{ sid }} .pgr {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 20 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgr {
      padding: {{ st.padding_top_desktop | default: 92 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 92 }}px;
    }
  }
  #shopify-section-{{ sid }} .pgr__inner {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: {{ st.heading_to_grid_gap | default: 36 }}px;
    align-items: {{ _ai }};
    text-align: {{ _ta }};
    color: {{ st.text_color | default: '#0F172A' }};
  }
  /* Tighter gap between consecutive heading/subheading blocks (overrides the larger inner gap) */
  #shopify-section-{{ sid }} .pgr__heading + .pgr__subheading,
  #shopify-section-{{ sid }} .pgr__subheading + .pgr__subheading,
  #shopify-section-{{ sid }} .pgr__heading   + .pgr__heading {
    margin-top: calc({{ st.heading_subheading_gap | default: 14 }}px - {{ st.heading_to_grid_gap | default: 36 }}px);
  }

  /* Heading / subheading */
  #shopify-section-{{ sid }} .pgr__heading {
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 800px;
  }
  #shopify-section-{{ sid }} .pgr__subheading {
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }
  #shopify-section-{{ sid }} .pgr__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .pgr__subheading p:last-child { margin: 0; }

  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .pgr__heading[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#0F172A' }};
        font-size: {{ bs.size_mobile | default: 30 }}px;
        text-transform: {% if bs.uppercase %}uppercase{% else %}none{% endif %};
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .pgr__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 42 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .pgr__subheading[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#475569' }};
        font-size: {{ bs.size_mobile | default: 14 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .pgr__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 16 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'footnote' -%}
      #shopify-section-{{ sid }} .pgr__footnote[data-block-id="{{ block.id }}"] {
        color: {{ bs.color | default: '#94A3B8' }};
        font-size: {{ bs.size | default: 12 }}px;
        margin-top: {{ bs.margin_top | default: 16 }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  /* Rings row */
  #shopify-section-{{ sid }} .pgr__row {
    display: grid;
    grid-template-columns: repeat({{ st.per_row_mobile | default: 2 }}, minmax(0, 1fr));
    gap: {{ st.row_gap_mobile | default: 28 }}px {{ st.col_gap_mobile | default: 16 }}px;
    width: 100%;
    justify-items: center;
    align-items: start;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgr__row {
      grid-template-columns: repeat({{ st.per_row_desktop | default: 4 }}, minmax(0, 1fr));
      gap: {{ st.row_gap_desktop | default: 40 }}px {{ st.col_gap_desktop | default: 32 }}px;
    }
  }

  /* Single ring item */
  #shopify-section-{{ sid }} .pgr__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ st.ring_to_label_gap | default: 18 }}px;
    text-align: center;
    width: 100%;
  }
  #shopify-section-{{ sid }} .pgr__ring {
    position: relative;
    width: {{ st.ring_size_mobile | default: 110 }}px;
    height: {{ st.ring_size_mobile | default: 110 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgr__ring {
      width: {{ st.ring_size_desktop | default: 137 }}px;
      height: {{ st.ring_size_desktop | default: 137 }}px;
    }
  }
  #shopify-section-{{ sid }} .pgr__ring svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    display: block;
  }
  #shopify-section-{{ sid }} .pgr__ring-bg   { stroke: {{ st.ring_track | default: '#F1DFE0' }}; }
  #shopify-section-{{ sid }} .pgr__ring-fill {
    stroke-linecap: round;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #shopify-section-{{ sid }} .pgr__percent {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: {{ st.percent_size_mobile | default: 29 }}px;
    color: {{ st.percent_color | default: '#0F172A' }};
    letter-spacing: -0.02em;
    line-height: 1;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgr__percent {
      font-size: {{ st.percent_size_desktop | default: 32 }}px;
    }
  }
  #shopify-section-{{ sid }} .pgr__label {
    font-size: {{ st.label_size_mobile | default: 14 }}px;
    line-height: 1.45;
    font-weight: {{ st.label_weight | default: 500 }};
    color: {{ st.label_color | default: '#0F172A' }};
    margin: 0;
    max-width: {{ st.label_max_width | default: 240 }}px;
  }
  #shopify-section-{{ sid }} .pgr__label p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .pgr__label p:last-child { margin: 0; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pgr__label {
      font-size: {{ st.label_size_desktop | default: 16 }}px;
    }
  }

  /* heading accent (em) color */
  #shopify-section-{{ sid }} .pgr__heading em {
    font-style: normal;
  }
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .pgr__heading[data-block-id="{{ block.id }}"] em {
        color: {{ block.settings.accent_color | default: '#7C3AED' }};
      }
    {%- endif -%}
  {%- endfor -%}

  /* gentle reveal — only arms when JS adds .pgr--armed (so editor preview + no-JS show content immediately) */
  #pgr-{{ sid }}.pgr--armed .pgr__heading,
  #pgr-{{ sid }}.pgr--armed .pgr__subheading,
  #pgr-{{ sid }}.pgr--armed .pgr__footnote,
  #pgr-{{ sid }}.pgr--armed .pgr__item {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .55s ease, transform .55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__heading,
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__subheading,
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__footnote,
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item { opacity: 1; transform: none; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(1) { transition-delay: .05s; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(2) { transition-delay: .15s; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(3) { transition-delay: .25s; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(4) { transition-delay: .35s; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(5) { transition-delay: .45s; }
  #pgr-{{ sid }}[data-pgr-revealed="1"] .pgr__item:nth-child(6) { transition-delay: .55s; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.pgr__heading, .pgr__subheading, .pgr__footnote, .pgr__item) {
      opacity: 1; transform: none; transition: none;
    }
    #shopify-section-{{ sid }} .pgr__ring-fill { transition: none; }
  }
{% comment %}{% endcomment %}</style>

<div id="pgr-{{ sid }}" class="pgr section sec__progress-circles" data-section-id="{{ sid }}">
  <div class="pgr__inner">

    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      {%- if block.type == 'heading' -%}
        {%- assign htag = bs.tag | default: 'h2' -%}
        <{{ htag }} class="pgr__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text }}{%- else -%}Heading text{%- endif -%}</{{ htag }}>
      {%- elsif block.type == 'subheading' -%}
        <div class="pgr__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if bs.text != blank -%}{{ bs.text }}{%- else -%}<p>{{ 'accessibility.add_supporting_copy' | t }}</p>{%- endif -%}</div>
      {%- endif -%}
    {%- endfor -%}

    <div class="pgr__row">
      {%- if stat_blocks.size > 0 -%}
        {%- for stat in stat_blocks -%}
          {%- assign sb = stat.settings -%}
          {%- assign pct = sb.percent | default: 80 -%}
          {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
          {%- if pct < 0 -%}{%- assign pct = 0 -%}{%- endif -%}
          {%- assign circumference = 175.93 -%}
          {%- assign offset = circumference | times: pct | divided_by: 100.0 -%}
          {%- assign final_offset = circumference | minus: offset -%}
          {%- comment -%}
            Ring fill color — three-tier fallback:
              1. If the block's own `color` is set to a real colour
                 (not blank, not transparent) → use it (per-ring override).
              2. Else fall back to the section-level `ring_color`.
              3. Else fall back to the hard-coded #F8B7BC.

            The transparent check is required because Shopify's color
            picker default for an unset value is `rgba(0,0,0,0)`. The
            previous code used Liquid's `default` filter, which only
            fires on blank/empty values — NOT on the string
            `"rgba(0,0,0,0)"`. That made the section-level setting
            non-functional whenever a block was added (the block's own
            default colour kept winning).
          {%- endcomment -%}
          {%- assign ring_stroke = st.ring_color | default: '#F8B7BC' -%}
          {%- if sb.color != blank and sb.color != 'rgba(0,0,0,0)' -%}
            {%- assign ring_stroke = sb.color -%}
          {%- endif -%}
          <div class="pgr__item" {{ stat.shopify_attributes }}>
            <div class="pgr__ring">
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <circle class="pgr__ring-bg" cx="32" cy="32" r="28" fill="none" stroke-width="{{ st.ring_thickness | default: 4 }}"/>
                <circle class="pgr__ring-fill" cx="32" cy="32" r="28" fill="none" stroke-width="{{ st.ring_thickness | default: 4 }}"
                  stroke="{{ ring_stroke }}"
                  stroke-dasharray="{{ circumference }}"
                  stroke-dashoffset="{{ circumference }}"
                  data-pgr-target-offset="{{ final_offset }}"/>
              </svg>
              <span class="pgr__percent">{{ pct }}%</span>
            </div>
            <p class="pgr__label">{%- if sb.label != blank -%}{{ sb.label | strip_html | strip | escape }}{%- else -%}Label{%- endif -%}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pgr__item" style="opacity:.5"><p class="pgr__label">{{ 'accessibility.add_stat_blocks' | t }}</p></div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'footnote' -%}
        {%- assign fbs = block.settings -%}
        <p class="pgr__footnote" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{%- if fbs.text != blank -%}{{ fbs.text }}{%- else -%}Footnote{%- endif -%}</p>
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

<script>
  (function() {
    var sec = document.getElementById('pgr-{{ sid }}');
    if (!sec) return;
    function setRingTargets() {
      sec.querySelectorAll('.pgr__ring-fill[data-pgr-target-offset]').forEach(function(r){
        var t = r.getAttribute('data-pgr-target-offset');
        if (t !== null) r.setAttribute('stroke-dashoffset', t);
      });
    }
    // Always animate the ring fill smoothly: defer the target write past the first paint
    // so the CSS transition runs from the initial empty state to the filled state.
    function fillRingsSmoothly() {
      if (sec.dataset.pgrRingsFilled === '1') return;
      sec.dataset.pgrRingsFilled = '1';
      // Two rAFs guarantee the browser has committed the initial frame before we
      // change stroke-dashoffset, so the transition definitely runs.
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){
          setRingTargets();
        });
      });
    }
    function reveal() {
      if (sec.dataset.pgrRevealed === '1') return;
      sec.dataset.pgrRevealed = '1';
      fillRingsSmoothly();
    }
    var inDesignMode = !!(window.Shopify && Shopify.designMode);
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      // Reduced motion: snap to filled, no animation
      setRingTargets();
      return;
    }
    if (inDesignMode) {
      // Editor: skip the gentle reveal but still animate the rings smoothly
      fillRingsSmoothly();
      return;
    }
    // Decide whether to arm the heading/item reveal: only if below the fold
    var rect = sec.getBoundingClientRect();
    var vh = window.innerHeight || document.documentElement.clientHeight;
    var below = rect.top > vh * 0.85;
    if (!below) {
      // Already in view at boot — heading/items stay fully visible, but still fill rings smoothly
      fillRingsSmoothly();
      return;
    }
    sec.classList.add('pgr--armed');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if (e.isIntersecting) { reveal(); io.unobserve(e.target); } });
      }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
      io.observe(sec);
    } else { reveal(); }
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "progress-circles",
  "name": "Progress Circles",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_subheading_gap",
      "label": "Gap between heading and subheading",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_to_grid_gap",
      "label": "Gap between heading and rings",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Ring grid"
    },
    {
      "type": "select",
      "id": "per_row_desktop",
      "label": "Rings per row (desktop)",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "select",
      "id": "per_row_mobile",
      "label": "Rings per row (mobile)",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Row gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Row gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "ring_to_label_gap",
      "label": "Ring → label gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Ring style"
    },
    {
      "type": "range",
      "id": "ring_size_desktop",
      "label": "Ring size (desktop)",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 137
    },
    {
      "type": "range",
      "id": "ring_size_mobile",
      "label": "Ring size (mobile)",
      "min": 60,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "ring_thickness",
      "label": "Ring thickness",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Ring fill color",
      "default": "#7C3AED"
    },
    {
      "type": "color",
      "id": "ring_track",
      "label": "Ring track color",
      "default": "#F1DFE0"
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Percent text + label"
    },
    {
      "type": "range",
      "id": "percent_size_desktop",
      "label": "Percent size (desktop)",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
