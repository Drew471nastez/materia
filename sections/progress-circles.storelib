          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Font size",
            "min": 10,
            "max": 18,
            "step": 1,
            "unit": "px",
            "default": 12
          },
          {
            "type": "range",
            "id": "margin_top",
            "label": "Top margin",
            "min": 0,
            "max": 60,
            "step": 2,
            "unit": "px",
            "default": 16
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Progress Circles",
