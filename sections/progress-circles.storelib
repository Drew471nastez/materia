<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: the theme's own space between sections is removed; the margin sliders below still apply */
    #shopify-section-{{ section.id }} { padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ section.id }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Progress Circles.

  A row of large percentage rings with the number inside and a label below,
  with optional heading, subheading and footnote blocks. Every value is a
  CSS variable on the section root, so shopify/assets/live-features-d.js
  applies builder edits in place. On the storefront the rings fill and the
  numbers count up once, when the section first comes into view; in the
  builder and under reduced motion they are drawn at their final values.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign custom = st.enable_custom_style
  case st.text_align
    when 'left'
      assign _ai = 'flex-start'
    when 'right'
      assign _ai = 'flex-end'
    else
      assign _ai = 'center'
  endcase
  assign pending = false
  if st.animate != false
    assign pending = true
  endif
  if request.design_mode
    assign pending = false
  endif
  assign stat_blocks = section.blocks | where: 'type', 'stat'
-%}
{%- capture pgr_style -%}
--pgr-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --pgr-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --pgr-px-m: {{ st.side_padding_mobile | default: 0 }}px;
--pgr-pt-d: {{ st.padding_top_desktop | default: 0 }}px; --pgr-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px; --pgr-px-d: {{ st.side_padding_desktop | default: 0 }}px;
--pgr-ai: {{ _ai }}; --pgr-ta: {{ st.text_align | default: 'center' }};
--pgr-head-gap: {{ st.heading_subheading_gap | default: 0 }}px; --pgr-grid-gap: {{ st.heading_to_grid_gap | default: 0 }}px;
--pgr-cols-m: {{ st.per_row_mobile | default: 2 }}; --pgr-cols-d: {{ st.per_row_desktop | default: 4 }};
--pgr-row-m: {{ st.row_gap_mobile | default: 0 }}px; --pgr-row-d: {{ st.row_gap_desktop | default: 0 }}px; --pgr-col-m: {{ st.col_gap_mobile | default: 0 }}px; --pgr-col-d: {{ st.col_gap_desktop | default: 0 }}px;
--pgr-label-gap: {{ st.ring_to_label_gap | default: 0 }}px;
--pgr-ring-m: {{ st.ring_size_mobile | default: 110 }}px; --pgr-ring-d: {{ st.ring_size_desktop | default: 137 }}px; --pgr-thick: {{ st.ring_thickness | default: 4 }};
--pgr-pct-m: {{ st.percent_size_mobile | default: 29 }}px; --pgr-pct-d: {{ st.percent_size_desktop | default: 32 }}px;
--pgr-label-m: {{ st.label_size_mobile | default: 14 }}px; --pgr-label-d: {{ st.label_size_desktop | default: 16 }}px; --pgr-label-max: {{ st.label_max_width | default: 240 }}px; --pgr-label-weight: {{ st.label_weight | default: 500 }};
--fd-dur: 1400ms;
{%- render 'media-msr-var', name: '--pgr-bg', color: st.section_bg, on: custom -%}
{%- render 'media-msr-var', name: '--pgr-text', color: st.text_color, on: custom -%}
{%- render 'media-msr-var', name: '--pgr-pct-color', color: st.percent_color, on: custom -%}
{%- render 'media-msr-var', name: '--pgr-ring-color', color: st.ring_color, on: custom -%}
{%- render 'media-msr-var', name: '--pgr-track', color: st.ring_track, on: custom -%}
{%- render 'media-msr-var', name: '--pgr-label-color', color: st.label_color, on: custom -%}
{%- if st.enable_custom_fonts -%}
  {%- if st.heading_font.family != blank -%}--pgr-hfont: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'serif' }};{%- endif -%}
  {%- if st.body_font.family != blank -%}--pgr-bfont: {{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}
<style>
  {%- if st.enable_custom_fonts -%}
    {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endif -%}
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} {
    --fd-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px; --fd-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
    --fd-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px; --fd-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    margin-top: var(--fd-mt-m) !important; margin-bottom: var(--fd-mb-m) !important;
    {% render 'media-msr-var', name: '--fd-wrap-bg', color: st.section_bg, on: custom %}
    background: var(--fd-wrap-bg, none);
  }
  #shopify-section-{{ sid }} .pgr {
    background: var(--pgr-bg, var(--color-background)); color: var(--pgr-text, var(--color-text));
    font-family: var(--pgr-bfont, var(--body-font)); padding: var(--pgr-pt-m) var(--pgr-px-m) var(--pgr-pb-m); box-sizing: border-box;
  }
  #shopify-section-{{ sid }} .pgr *, #shopify-section-{{ sid }} .pgr *::before, #shopify-section-{{ sid }} .pgr *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .pgr__inner { width: 100%; display: flex; flex-direction: column; gap: var(--pgr-grid-gap); align-items: var(--pgr-ai); text-align: var(--pgr-ta); }
  #shopify-section-{{ sid }} .pgr__inner > * { margin: 0; }
  #shopify-section-{{ sid }} .pgr__heading + .pgr__subheading,
  #shopify-section-{{ sid }} .pgr__subheading + .pgr__subheading,
  #shopify-section-{{ sid }} .pgr__heading + .pgr__heading { margin-top: calc(var(--pgr-head-gap) - var(--pgr-grid-gap)); }
  #shopify-section-{{ sid }} .pgr__heading {
    font-family: var(--pgr-hfont, var(--heading-font)); font-weight: var(--heading-weight, 700); max-width: 800px;
    font-size: var(--b-size-m); line-height: var(--heading-line-height, 1.1); letter-spacing: var(--heading-letter-spacing, normal);
    color: var(--b-color, var(--color-heading)); text-transform: var(--b-case, var(--heading-text-transform, none));
  }
  #shopify-section-{{ sid }} .pgr__heading em { font-style: normal; color: var(--b-accent, var(--color-primary)); }
  #shopify-section-{{ sid }} .pgr__subheading { font-size: var(--b-size-m); line-height: 1.6; max-width: 640px; color: var(--b-color, var(--pgr-text, var(--color-text))); }
  #shopify-section-{{ sid }} .pgr__subheading p, #shopify-section-{{ sid }} .pgr__footnote p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .pgr__subheading p:last-child, #shopify-section-{{ sid }} .pgr__footnote p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .pgr__footnote { font-size: var(--b-size); margin-top: var(--b-mt); color: var(--b-color, var(--pgr-text, var(--color-text))); }
  #shopify-section-{{ sid }} .pgr__row {
    display: grid; width: 100%; grid-template-columns: repeat(var(--pgr-cols-m), minmax(0, 1fr)); gap: var(--pgr-row-m) var(--pgr-col-m);
    justify-items: center; align-items: start;
  }
  #shopify-section-{{ sid }} .pgr__item { display: flex; flex-direction: column; align-items: center; gap: var(--pgr-label-gap); text-align: center; width: 100%; min-width: 0; }
  #shopify-section-{{ sid }} .pgr__ring { position: relative; width: var(--pgr-ring-m); height: var(--pgr-ring-m); max-width: 100%; }
  #shopify-section-{{ sid }} .pgr__ring svg { width: 100%; height: 100%; transform: rotate(-90deg); display: block; overflow: visible; }
  #shopify-section-{{ sid }} .pgr__ring-bg { stroke: var(--pgr-track, var(--color-border)); stroke-width: var(--pgr-thick); }
  #shopify-section-{{ sid }} .pgr__ring-fill {
    stroke: var(--b-ring, var(--pgr-ring-color, var(--color-primary))); stroke-width: var(--pgr-thick); stroke-linecap: round;
    stroke-dasharray: 175.93; stroke-dashoffset: var(--fd-off, 0); transition: stroke-dashoffset var(--fd-dur) cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #shopify-section-{{ sid }} .pgr__percent {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--pgr-hfont, var(--heading-font)); font-weight: var(--heading-weight, 700); font-size: var(--pgr-pct-m);
    line-height: 1; letter-spacing: -0.02em; color: var(--pgr-pct-color, var(--color-heading)); font-variant-numeric: tabular-nums; transition: opacity 0.4s ease;
  }
  #shopify-section-{{ sid }} .pgr__label {
    margin: 0; font-size: var(--pgr-label-m); line-height: 1.45; font-weight: var(--pgr-label-weight); max-width: var(--pgr-label-max);
    color: var(--pgr-label-color, var(--color-heading));
  }
  #shopify-section-{{ sid }} .pgr[data-fd-reveal='pending'] .pgr__ring-fill { stroke-dashoffset: 175.93; }
  #shopify-section-{{ sid }} .pgr[data-fd-reveal='pending'] .pgr__percent { opacity: 0; }
  #shopify-section-{{ sid }} .pgr:not([data-fd-reveal]) .pgr__ring-fill { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pgr .pgr__ring-fill { stroke-dashoffset: var(--fd-off, 0); transition: none; }
    #shopify-section-{{ sid }} .pgr .pgr__percent { opacity: 1; transition: none; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .pgr.stretch_width .pgr__inner { padding-inline: 3rem; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--fd-mt-d) !important; margin-bottom: var(--fd-mb-d) !important; }
    #shopify-section-{{ sid }} .pgr { padding: var(--pgr-pt-d) var(--pgr-px-d) var(--pgr-pb-d); }
    #shopify-section-{{ sid }} .pgr__heading, #shopify-section-{{ sid }} .pgr__subheading { font-size: var(--b-size-d); }
    #shopify-section-{{ sid }} .pgr__row { grid-template-columns: repeat(var(--pgr-cols-d), minmax(0, 1fr)); gap: var(--pgr-row-d) var(--pgr-col-d); }
    #shopify-section-{{ sid }} .pgr__ring { width: var(--pgr-ring-d); height: var(--pgr-ring-d); }
    #shopify-section-{{ sid }} .pgr__percent { font-size: var(--pgr-pct-d); }
    #shopify-section-{{ sid }} .pgr__label { font-size: var(--pgr-label-d); }
  }
{% comment %}{% endcomment %}</style>
<noscript><style>#shopify-section-{{ sid }} .pgr[data-fd-reveal='pending'] .pgr__ring-fill { stroke-dashoffset: var(--fd-off, 0); } #shopify-section-{{ sid }} .pgr[data-fd-reveal='pending'] .pgr__percent { opacity: 1; }</style></noscript>

<div id="pgr-{{ sid }}" class="pgr section sec__progress-circles color-{{ color_scheme }} gradient {{ st.section_width | default: 'container' }}" data-fd="pgr" data-fd-section="{{ sid }}" data-fd-settings="{{ st | json | escape }}"{% if st.enable_custom_fonts %} data-own-font{% endif %}{% if pending %} data-fd-reveal="pending"{% endif %} style="{{ pgr_style | strip_newlines }}">
  <div class="pgr__inner">
    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- assign htext = bs.text | remove: '<p>' | remove: '</p>' -%}
          <h2 class="pgr__heading" data-fd-block="{{ block.id }}" data-fd-type="heading" data-fd-settings="{{ bs | json | escape }}" style="--b-size-m: {{ bs.size_mobile | default: 30 }}px; --b-size-d: {{ bs.size_desktop | default: 42 }}px;{% if bs.uppercase %} --b-case: uppercase; --heading-text-transform: uppercase;{% endif %}{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}{% render 'media-msr-var', name: '--b-accent', color: bs.accent_color, on: bs.enable_custom_style %}"{% if htext == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ htext }}</h2>
        {%- when 'subheading' -%}
          <div class="pgr__subheading" data-fd-block="{{ block.id }}" data-fd-type="subheading" data-fd-settings="{{ bs | json | escape }}" style="--b-size-m: {{ bs.size_mobile | default: 14 }}px; --b-size-d: {{ bs.size_desktop | default: 16 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
      {%- endcase -%}
    {%- endfor -%}

    <div class="pgr__row">
      {%- for stat in stat_blocks -%}
        {%- liquid
          assign sb = stat.settings
          assign pct = sb.percent | default: 0 | round
          if pct > 100
            assign pct = 100
          endif
          if pct < 0
            assign pct = 0
          endif
          assign off = 100 | minus: pct | times: 1.7593 | round: 2
        -%}
        <div class="pgr__item" data-fd-block="{{ stat.id }}" data-fd-type="stat" data-fd-settings="{{ sb | json | escape }}" style="--fd-off: {{ off }};{% render 'media-msr-var', name: '--b-ring', color: sb.color, on: sb.enable_custom_style %}" {{ stat.shopify_attributes }}>
          <div class="pgr__ring">
            <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
              <circle class="pgr__ring-bg" cx="32" cy="32" r="28" fill="none"/>
              <circle class="pgr__ring-fill" cx="32" cy="32" r="28" fill="none"/>
            </svg>
            <span class="pgr__percent" data-fd-count data-to="{{ pct }}" data-suffix="%">{{ pct }}%</span>
          </div>
          <p class="pgr__label"{% if sb.label == blank %} hidden{% endif %}>{{ sb.label | strip_html | strip | escape }}</p>
        </div>
      {%- else -%}
        {%- if request.design_mode -%}<p class="pgr__label">{{ 'accessibility.add_stat_blocks' | t }}</p>{%- endif -%}
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'footnote' -%}
        {%- assign fbs = block.settings -%}
        <div class="pgr__footnote" data-fd-block="{{ block.id }}" data-fd-type="footnote" data-fd-settings="{{ fbs | json | escape }}" style="--b-size: {{ fbs.size | default: 12 }}px; --b-mt: {{ fbs.margin_top | default: 0 }}px;{% render 'media-msr-var', name: '--b-color', color: fbs.color, on: fbs.enable_custom_style %}"{% if fbs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ fbs.text }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- comment -%} Ring fill, count up and live edits: shopify/assets/live-features-d.js (loaded on every page). {%- endcomment -%}



</template>
<schema>
{
  "type": "progress-circles",
  "name": "Progress Circles",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove theme spacing between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_subheading_gap",
      "label": "Heading to subheading gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_to_grid_gap",
      "label": "Text to rings gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "per_row_desktop",
      "label": "Rings per row",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "label": "Row gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "ring_to_label_gap",
      "label": "Ring to label gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "label_max_width",
      "label": "Label max width",
      "min": 140,
      "max": 360,
      "step": 5,
      "unit": "px",
      "default": 240
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "ring_size_desktop",
      "label": "Ring size",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 137
    },
    {
      "type": "range",
      "id": "ring_thickness",
      "label": "Ring thickness",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "percent_size_desktop",
      "label": "Percent size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "label_size_desktop",
      "label": "Label size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "percent_color",
      "label": "Percent",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Ring",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "ring_track",
      "label": "Ring track",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Animation"
    },
    {
      "type": "checkbox",
