        "info": "Off: the section follows the colour scheme, the theme fonts and Theme settings > Buttons. On: the colours and fonts you set below are used.",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "default": 60
      },
      {
        "type": "range",
        "id": "desktop_padding_left",
        "label": "Left padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "desktop_padding_right",
        "label": "Right padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "mobile_padding_left",
        "label": "Left padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "mobile_padding_right",
        "label": "Right padding (mobile)",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "default": 10
      },
      {
        "type": "header",
        "content": "Background & overlay"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "select",
        "id": "video_overlay_color_selector",
        "label": "Card overlay color",
        "default": "black",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "black",
            "label": "Black"
          },
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "gray",
            "label": "Gray"
          },
          {
            "value": "light-gray",
            "label": "Light Gray"
          },
          {
            "value": "dark-gray",
            "label": "Dark Gray"
          }
        ]
      },
      {
        "type": "range",
        "id": "video_overlay_opacity",
        "label": "Card overlay opacity",
        "min": 0,
        "max": 1,
        "step": 0.1,
        "default": 0.3
      },
      {
        "type": "header",
        "content": "Cards"
      },
      {
        "type": "range",
        "id": "video_card_size",
        "label": "Card width (desktop)",
        "min": 150,
        "max": 320,
        "step": 10,
        "unit": "px",
        "default": 220
      },
      {
        "type": "range",
        "id": "mobile_column_count",
        "label": "Cards visible (mobile)",
        "min": 1,
        "max": 2.5,
        "step": 0.5,
        "default": 1.5
      },
      {
        "type": "range",
        "id": "video_cards_gap_desktop",
        "label": "Gap between cards (desktop)",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "video_cards_gap_mobile",
        "label": "Gap between cards (mobile)",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "select",
        "id": "hover_animation",
        "label": "Card hover animation",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "smooth-zoom",
            "label": "Smooth Zoom"
          },
          {
            "value": "scale-in",
            "label": "Scale In"
          },
          {
            "value": "scale-in-up",
            "label": "Scale In Up"
          },
          {
            "value": "subtle-shadow",
            "label": "Subtle Shadow"
          },
          {
            "value": "subtle-white-glow-pulse",
            "label": "Subtle White Glow Pulse"
          },
          {
            "value": "subtle-gray-glow-pulse",
            "label": "Subtle Gray Glow Pulse"
          }
        ]
      },
      {
        "type": "header",
        "content": "Product text"
      },
      {
        "type": "color",
        "id": "product_name_color",
        "label": "Card text color",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "product_price_color",
        "label": "Stars color",
        "default": "#FFD700",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "header",
        "content": "Add-ons & button"
      },
      {
        "type": "checkbox",
        "id": "hide_addons",
        "label": "Hide card overlay text",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_button",
        "label": "Show button on each card",
        "default": false
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "Learn More"
      },
      {
        "type": "checkbox",
        "id": "use_theme_button",
        "label": "Use theme button style",
        "visible_if": "{{ section.settings.enable_custom_styling }}",
        "default": true
      },
      {
        "type": "color",
        "id": "button_background_color",
        "label": "Button background",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text color",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 25,
        "visible_if": "{{ section.settings.enable_custom_styling and section.settings.use_theme_button == false }}"
      },
      {
        "type": "header",
        "content": "Progress bar"
      },
      {
        "type": "checkbox",
        "id": "show_progress_bar",
        "label": "Show progress bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "hide_progress_bar_desktop",
        "label": "Hide progress bar on desktop",
        "default": false
      },
      {
        "type": "color",
        "id": "pagination_bullet_color",
        "label": "Track color",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "color",
        "id": "pagination_bullet_active_color",
        "label": "Fill color",
        "visible_if": "{{ section.settings.enable_custom_styling }}"
      },
      {
        "type": "range",
        "id": "progress_bar_height",
        "label": "Height",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "progress_bar_max_width",
        "label": "Max width",
        "min": 60,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 90
      },
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Use a Google font from the list",
        "visible_if": "{{ section.settings.enable_custom_styling }}",
        "default": false
      },
      {
        "type": "select",
        "id": "selected_custom_font",
        "label": "Select font",
        "visible_if": "{{ section.settings.enable_custom_styling and section.settings.enable_custom_fonts }}",
        "default": "Roboto",
        "options": [
          {
            "value": "Roboto",
            "label": "Roboto"
          },
          {
            "value": "Open Sans",
            "label": "Open Sans"
          },
          {
            "value": "Lato",
            "label": "Lato"
          },
          {
            "value": "Montserrat",
            "label": "Montserrat"
          },
          {
            "value": "Poppins",
            "label": "Poppins"
          },
          {
            "value": "Playfair Display",
            "label": "Playfair Display"
          },
          {
            "value": "Lora",
            "label": "Lora"
          },
          {
            "value": "Nunito",
            "label": "Nunito"
          },
          {
            "value": "Work Sans",
            "label": "Work Sans"
          },
          {
            "value": "Raleway",
            "label": "Raleway"
          },
          {
            "value": "Merriweather",
            "label": "Merriweather"
          },
          {
            "value": "Bebas Neue",
            "label": "Bebas Neue"
          }
        ]
      },
      {
        "type": "textarea",
        "id": "custom_font_url",
        "label": "Custom font @import URL",
        "info": "Used when the Google font list is off. Paste the @import address and the font's family name below.",
        "visible_if": "{{ section.settings.enable_custom_styling and section.settings.enable_custom_fonts == false }}"
      },
      {
        "type": "text",
        "id": "custom_font_family",
        "label": "Custom font family name",
        "default": "",
        "visible_if": "{{ section.settings.enable_custom_styling and section.settings.enable_custom_fonts == false }}"
      }
    ],
    "max_blocks": 30,
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Our customers love it."
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading color",
            "visible_if": "{{ section.settings.enable_custom_styling }}"
          },
          {
            "type": "select",
            "id": "heading_font_weight",
            "label": "Heading font weight",
            "default": "700",
            "options": [
              {
                "value": "300",
                "label": "Light"
              },
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semibold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "heading_font_size_desktop",
            "label": "Heading size (desktop)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 29
          },
          {
            "type": "range",
            "id": "heading_font_size_mobile",
            "label": "Heading size (mobile)",
            "min": 14,
            "max": 44,
            "step": 1,
            "unit": "px",
            "default": 25
          },
          {
            "type": "range",
            "id": "space_below_desktop",
            "label": "Space below (desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 20
          },
          {
            "type": "range",
            "id": "space_below_mobile",
            "label": "Space below (mobile)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 10
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Express your style with our standout collection."
          },
          {
            "type": "color",
            "id": "subheading_color",
            "label": "Subheading color",
            "visible_if": "{{ section.settings.enable_custom_styling }}"
          },
          {
            "type": "range",
            "id": "subheading_font_size_desktop",
            "label": "Subheading size (desktop)",
            "min": 12,
            "max": 36,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "subheading_font_size_mobile",
            "label": "Subheading size (mobile)",
            "min": 10,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 14
          },
          {
            "type": "range",
            "id": "space_below_desktop",
            "label": "Space below (desktop)",
            "min": 0,
            "max": 120,
            "step": 5,
            "unit": "px",
            "default": 40
          },
          {
            "type": "range",
            "id": "space_below_mobile",
            "label": "Space below (mobile)",
            "min": 0,
            "max": 120,
            "step": 5,
            "unit": "px",
            "default": 30
          }
        ]
      },
      {
        "type": "video_card",
        "name": "Video Card",
        "settings": [
          {
            "type": "header",
            "content": "Media"
          },
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "type": "video",
            "id": "video",
            "label": "Video (upload)"
          },
          {
            "type": "url",
            "id": "video_url",
            "label": "Video address (.mp4)"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "username",
            "label": "Username",
            "default": "@user"
          },
          {
            "type": "text",
            "id": "product_name",
            "label": "Product name",
            "default": "Product Name"
          },
          {
            "type": "range",
            "id": "rating",
            "label": "Rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "default": 5
          },
          {
            "type": "url",
            "id": "product_link",
            "label": "Card link"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Video Testimonials 5",
        "category": "Testimonials",
        "blocks": [
          {
