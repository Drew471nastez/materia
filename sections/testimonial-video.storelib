<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
{%- comment -%} Connect to the theme's global Animations & motion settings (Theme settings > Animations). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

{%- comment -%} Remove default space between sections (margins only — never touches padding). {%- endcomment -%}
{%- if section.settings.reset_spacing -%}
<style>
  #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'image' | placeholder_svg_tag: 'placeholder-svg'

  # --- Overlay colour -> RGB ---
  case st.video_overlay_color_selector
    when 'none'
      assign overlay_rgb = '0,0,0'
      assign overlay_opacity = 0
    when 'white'
      assign overlay_rgb = '255,255,255'
      assign overlay_opacity = st.video_overlay_opacity
    when 'gray'
      assign overlay_rgb = '128,128,128'
      assign overlay_opacity = st.video_overlay_opacity
    when 'light-gray'
      assign overlay_rgb = '211,211,211'
      assign overlay_opacity = st.video_overlay_opacity
    when 'dark-gray'
      assign overlay_rgb = '169,169,169'
      assign overlay_opacity = st.video_overlay_opacity
    else
      assign overlay_rgb = '0,0,0'
      assign overlay_opacity = st.video_overlay_opacity
  endcase

  # --- Find the single heading + subheading blocks, count cards ---
  assign card_count = 0
  assign heading_found = false
  assign subheading_found = false
  for block in section.blocks
    case block.type
      when 'video_card'
        assign card_count = card_count | plus: 1
      when 'heading'
        unless heading_found
          assign heading_block = block
          assign heading_found = true
        endunless
      when 'subheading'
        unless subheading_found
          assign subheading_block = block
          assign subheading_found = true
        endunless
    endcase
  endfor
  if heading_found
    assign hb = heading_block.settings
  endif
  if subheading_found
    assign sb = subheading_block.settings
  endif

  # --- Theme connection: custom colours only when the creator turns them on ---
  assign custom = st.enable_custom_styling
  assign c_bg = ''
  assign c_heading = ''
  assign c_sub = ''
  assign c_card = ''
  assign c_star = '#FFD700'
  assign c_btn_bg = ''
  assign c_btn_text = ''
  assign c_track = ''
  assign c_fill = ''
  if custom
    assign c_bg = st.background_color
    if heading_found
      assign c_heading = hb.heading_color
    endif
    if subheading_found
      assign c_sub = sb.subheading_color
    endif
    assign c_card = st.product_name_color
    if st.product_price_color != blank
      assign c_star = st.product_price_color
    endif
    assign c_btn_bg = st.button_background_color
    assign c_btn_text = st.button_text_color
    assign c_track = st.pagination_bullet_color
    assign c_fill = st.pagination_bullet_active_color
  endif
-%}

<style>
  /* ---- Isolation: this section never overlaps or styles anything else ---- */
  #shopify-section-{{ sid }} { position: static; z-index: 0; }
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) { font-family: inherit; }
  #community-stories-slider-{{ sid }} *,
  #community-stories-slider-{{ sid }} *::before,
  #community-stories-slider-{{ sid }} *::after { box-sizing: border-box; }

  /* ---- Section shell + padding (works on desktop AND mobile) ---- */
  #community-stories-slider-{{ sid }} {
    position: relative;
    overflow: hidden;
    z-index: 0;
    text-align: center;
    background-color: {% render 'scheme-color', color: c_bg, fallback: 'var(--color-background)' %};
    padding-top: {{ st.padding_top | default: 60 }}px;
    padding-bottom: {{ st.padding_bottom | default: 60 }}px;
  }
  #community-stories-slider-{{ sid }} .ctv__inner {
    padding-left: {{ st.desktop_padding_left | default: 15 }}px;
    padding-right: {{ st.desktop_padding_right | default: 15 }}px;
  }
  @media (max-width: 768px) {
    #community-stories-slider-{{ sid }} .ctv__inner {
      padding-left: {{ st.mobile_padding_left | default: 10 }}px;
      padding-right: {{ st.mobile_padding_right | default: 10 }}px;
    }
  }

  /* ---- Heading + subheading (theme font by default) ---- */
  #community-stories-slider-{{ sid }} .ctv__heading {
    font-family: var(--heading-font, inherit);
    color: {% render 'scheme-color', color: c_heading, fallback: 'var(--color-heading)' %};
    font-weight: {{ hb.heading_font_weight | default: '700' }};
    font-size: {{ hb.heading_font_size_mobile | default: 25 }}px;
    margin: 0 0 {{ hb.space_below_mobile | default: 10 }}px;
    line-height: 1.2;
  }
  #community-stories-slider-{{ sid }} .ctv__subheading {
    font-family: inherit;
    color: {% render 'scheme-color', color: c_sub, fallback: 'var(--color-text)' %};
    font-size: {{ sb.subheading_font_size_mobile | default: 14 }}px;
    margin: 0 0 {{ sb.space_below_mobile | default: 28 }}px;
    line-height: 1.5;
  }
  @media (min-width: 769px) {
    #community-stories-slider-{{ sid }} .ctv__heading {
      font-size: {{ hb.heading_font_size_desktop | default: 29 }}px;
      margin-bottom: {{ hb.space_below_desktop | default: 20 }}px;
    }
    #community-stories-slider-{{ sid }} .ctv__subheading {
      font-size: {{ sb.subheading_font_size_desktop | default: 16 }}px;
      margin-bottom: {{ sb.space_below_desktop | default: 40 }}px;
    }
  }

  /* ---- Carousel rail (native scroll + drag, centred when it fits) ---- */
  #community-stories-slider-{{ sid }} .ctv__viewport {
    width: 100%;
    position: relative;
    touch-action: pan-y;
    cursor: grab;
  }
  #community-stories-slider-{{ sid }} .ctv__viewport.is-dragging { cursor: grabbing; }
  #community-stories-slider-{{ sid }} .ctv__rail {
    --ctv-cols: {{ st.mobile_column_count | default: 1.5 }};
    --ctv-gap: {{ st.video_cards_gap_mobile | default: 12 }}px;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: var(--ctv-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 2px 12px;
  }
  /* When all cards fit, centre them (fixes the "stuck to the left" look). */
  #community-stories-slider-{{ sid }} .ctv__rail.is-centered { justify-content: center; }
  #community-stories-slider-{{ sid }} .ctv__rail::-webkit-scrollbar { display: none; }
  #community-stories-slider-{{ sid }} .ctv__viewport.is-dragging .ctv__rail {
    scroll-behavior: auto !important;
    scroll-snap-type: none !important;
  }
  @media (min-width: 769px) {
    #community-stories-slider-{{ sid }} .ctv__rail { --ctv-gap: {{ st.video_cards_gap_desktop | default: 16 }}px; }
  }

  #community-stories-slider-{{ sid }} .ctv__slide {
    flex: 0 0 calc((100% - (var(--ctv-cols) - 1) * var(--ctv-gap)) / var(--ctv-cols));
    scroll-snap-align: start;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 769px) {
    #community-stories-slider-{{ sid }} .ctv__slide { flex: 0 0 {{ st.video_card_size | default: 220 }}px; }
  }

  /* ---- Card ---- */
  #community-stories-slider-{{ sid }} .ctv__card-link {
    position: absolute; inset: 0; z-index: 2;
    text-decoration: none; color: inherit;
  }
  #community-stories-slider-{{ sid }} .ctv__slide img,
  #community-stories-slider-{{ sid }} .ctv__slide video { -webkit-user-drag: none; pointer-events: none; }
  #community-stories-slider-{{ sid }} .video-overlay { z-index: 3; pointer-events: none; }
  #community-stories-slider-{{ sid }} .custom-button { position: relative; z-index: 4; pointer-events: auto; }
  #community-stories-slider-{{ sid }} .ctv__viewport.is-dragging * { pointer-events: none; }
  #community-stories-slider-{{ sid }} .video-card {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 16;
    border-radius: {{ st.card_corner_radius | default: 12 }}px;
    overflow: hidden;
    transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    cursor: pointer;
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
  }
  #community-stories-slider-{{ sid }} .media-content,
  #community-stories-slider-{{ sid }} .media-content video,
  #community-stories-slider-{{ sid }} video.media-content {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hover animations */
  #community-stories-slider-{{ sid }} .video-card .media-content { transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  #community-stories-slider-{{ sid }} .video-card .placeholder-svg { width: 100%; height: 100%; display: block; }
  #community-stories-slider-{{ sid }} .video-card.smooth-zoom:hover .media-content { transform: scale(1.05); }
  #community-stories-slider-{{ sid }} .video-card.scale-in:hover .media-content { transform: scale(1.1); }
  #community-stories-slider-{{ sid }} .video-card.scale-in-up:hover { transform: translateY(-6px); }
  #community-stories-slider-{{ sid }} .video-card.scale-in-up:hover .media-content { transform: scale(1.08); }
  #community-stories-slider-{{ sid }} .video-card.subtle-shadow:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.3); }
  #community-stories-slider-{{ sid }} .video-card.subtle-white-glow-pulse:hover { box-shadow: 0 0 10px rgba(255,255,255,0.7); animation: ctvWhiteGlow-{{ sid }} 1.5s infinite; }
  #community-stories-slider-{{ sid }} .video-card.subtle-gray-glow-pulse:hover { box-shadow: 0 0 10px rgba(128,128,128,0.7); animation: ctvGrayGlow-{{ sid }} 1.5s infinite; }
  @keyframes ctvWhiteGlow-{{ sid }} { 0%,100%{ box-shadow:0 0 10px rgba(255,255,255,.7);} 50%{ box-shadow:0 0 20px rgba(255,255,255,.9);} }
  @keyframes ctvGrayGlow-{{ sid }} { 0%,100%{ box-shadow:0 0 10px rgba(128,128,128,.7);} 50%{ box-shadow:0 0 20px rgba(128,128,128,.9);} }

  /* Overlay + product info */
  #community-stories-slider-{{ sid }} .video-overlay {
    position: absolute; left: 0; bottom: 0; width: 100%;
    display: flex; flex-direction: column; align-items: stretch; gap: 10px;
    padding: 14px;
  }
  #community-stories-slider-{{ sid }} .video-overlay--bare { background: none; }
  #community-stories-slider-{{ sid }} .product-info { color: var(--ctv-card-text, #ffffff); text-shadow: 0 1px 2px rgba(0,0,0,.25); min-width: 0; }
  #community-stories-slider-{{ sid }} .product-info .username,
  #community-stories-slider-{{ sid }} .product-info .product-name { color: inherit; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #community-stories-slider-{{ sid }} .product-info { display: flex; flex-direction: column; align-items: flex-start; width: 100%; text-align: left; }
  #community-stories-slider-{{ sid }} .username { font-size: 12px; font-weight: 700; font-family: inherit; margin-bottom: 2px; }
  #community-stories-slider-{{ sid }} .product-name { font-size: 14px; font-weight: 700; font-family: inherit; margin-bottom: 2px; }
  #community-stories-slider-{{ sid }} .stars { display: flex; font-size: 14px; font-family: inherit; }
  #community-stories-slider-{{ sid }} .star { color: var(--star-off, #c9c9c9); }
  #community-stories-slider-{{ sid }} .star.filled { color: var(--star-on, #ffd700); }

  /* Button: a theme button (theme-button-contract.css). Theme settings >
     Buttons draw it; colours set here, and the shape when the theme style is
     off, are --mb-* tokens. */
  #community-stories-slider-{{ sid }} .custom-button {
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-height: 44px; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    {% render 'button-overrides', bg: c_btn_bg, text: c_btn_text %}
    {%- if custom and st.use_theme_button == false %}
    --mb-radius: {{ st.button_border_radius | default: 25 }}px;
    --mb-padding-y: 8px;
    --mb-padding-x: 16px;
    --mb-font-size: 14px;
    {%- endif %}
  }
  @media (prefers-reduced-motion: reduce) {
    #community-stories-slider-{{ sid }} .video-card,
    #community-stories-slider-{{ sid }} .video-card .media-content { transition: none; animation: none !important; }
    #community-stories-slider-{{ sid }} .video-card:hover,
    #community-stories-slider-{{ sid }} .video-card:hover .media-content { transform: none; }
  }

  /* Progress bar */
  {%- if st.show_progress_bar == false -%}
  #community-stories-slider-{{ sid }} .ctv__progress { display: none !important; }
  {%- endif -%}
  {%- if st.hide_progress_bar_desktop -%}
  @media (min-width: 769px) { #community-stories-slider-{{ sid }} .ctv__progress { display: none !important; } }
  {%- endif -%}
  #community-stories-slider-{{ sid }} .ctv__progress {
    position: relative; display: block; margin: 22px auto 0;
    width: {{ st.progress_bar_max_width | default: 90 }}%;
    height: {{ st.progress_bar_height | default: 2 }}px;
    background: {% render 'scheme-color', color: c_track, fallback: 'var(--color-border)' %};
    border-radius: 999px; overflow: hidden; cursor: pointer;
  }
  #community-stories-slider-{{ sid }} .ctv__progress-fill {
    position: absolute; inset: 0 auto 0 0; width: 0%;
    background: {% render 'scheme-color', color: c_fill, fallback: 'var(--color-heading)' %};
    border-radius: 999px; transition: width .15s linear;
  }
  /* Hide the progress bar entirely when nothing scrolls (cards fit). */
  #community-stories-slider-{{ sid }} .ctv__viewport.is-static .ctv__progress { visibility: hidden; }
  #community-stories-slider-{{ sid }} .ctv__viewport:focus { outline: none; }
  #community-stories-slider-{{ sid }} .ctv__viewport:focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 4px; border-radius: 4px; }
  #community-stories-slider-{{ sid }} .ctv__card-link:focus-visible,
  #community-stories-slider-{{ sid }} .custom-button:focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    #community-stories-slider-{{ sid }} .ctv__rail { scroll-behavior: auto; }
  }
{% comment %}{% endcomment %}</style>

{%- if custom and st.enable_custom_fonts and st.selected_custom_font != blank -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family={{ st.selected_custom_font | replace: ' ', '+' }}&display=swap');
    #community-stories-slider-{{ sid }} * { font-family: '{{ st.selected_custom_font }}', sans-serif !important; }
{% comment %}{% endcomment %}  </style>
{%- elsif custom and st.custom_font_url != blank and st.custom_font_family != blank -%}
  <style>
    @import url('{{ st.custom_font_url }}');
    #community-stories-slider-{{ sid }} * { font-family: '{{ st.custom_font_family }}', sans-serif !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}

<section id="community-stories-slider-{{ sid }}" class="community-stories-slider-{{ sid }} color-{{ color_scheme }} gradient">
  <div class="ctv__inner">

    {%- if heading_found and hb.heading != blank -%}
      <h2 class="ctv__heading" {{ heading_block.shopify_attributes }}>{{ hb.heading }}</h2>
    {%- endif -%}

    {%- if subheading_found and sb.subheading != blank -%}
      <p class="ctv__subheading" {{ subheading_block.shopify_attributes }}>{{ sb.subheading }}</p>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="ctv__viewport" data-ctv-viewport>
        <div class="ctv__rail" data-ctv-rail>
          {%- for block in section.blocks -%}
            {%- if block.type == 'video_card' -%}
              {%- liquid
                assign card = block.settings
                assign prod = card.product
                assign pname = card.product_name
                if pname == blank and prod != blank
                  assign pname = prod.title
                endif
                assign plink = card.product_link
                if plink == blank or plink == '/'
                  if prod != blank
                    assign plink = prod.url
                  endif
                endif
                assign demo_src = ''
                if card.image == blank and card.video == blank and card.video_url == blank
                  capture demo_src
                    render 'demo-image', key: block.id
                  endcapture
                  assign demo_src = demo_src | strip
                endif
              -%}
              <div class="ctv__slide">
                <div class="video-card {{ st.hover_animation }}" {{ block.shopify_attributes }}>
                    {%- if card.image != blank -%}
                      <img src="{{ card.image | image_url: width: 600 }}" alt="{{ pname | escape }}" class="media-content" loading="lazy" width="{{ card.image.width }}" height="{{ card.image.height }}">
                    {%- elsif card.video != blank -%}
                      {{ card.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'auto', class: 'media-content' }}
                    {%- elsif card.video_url != blank -%}
                      <video class="media-content" autoplay muted loop playsinline preload="auto">
                        <source src="{{ card.video_url }}" type="video/mp4">
                      </video>
                    {%- elsif prod != blank and prod.featured_image != blank -%}
                      <img src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ pname | escape }}" class="media-content" loading="lazy">
                    {%- elsif demo_src != blank -%}
                      <video class="media-content" autoplay muted loop playsinline preload="auto">
                        <source src="{{ demo_src }}" type="video/mp4">
                      </video>
                    {%- else -%}
                      {{ placeholder }}
                    {%- endif -%}

                    <a class="ctv__card-link" href="{{ plink | default: '/' }}" aria-label="{{ pname | default: 'View' | escape }}"></a>

                    {%- liquid
                      assign rating = card.rating | default: 5
                      assign blink = card.button_link
                      if blink == blank or blink == '/'
                        assign blink = plink
                      endif
                      assign show_btn = false
                      if st.enable_button and st.button_text != blank
                        assign show_btn = true
                      endif
                    -%}
                    {%- if st.hide_addons == false or show_btn -%}
                      <div class="video-overlay{% if st.hide_addons %} video-overlay--bare{% endif %}"{% unless st.hide_addons %} style="background-color: rgba({{ overlay_rgb }},{{ overlay_opacity }});"{% endunless %}>
                        {%- unless st.hide_addons -%}
                          <div class="product-info" style="--ctv-card-text: {% render 'scheme-color', color: c_card, fallback: '#ffffff' %}; --star-on: {{ c_star }};">
                            {%- if card.username != blank -%}<span class="username">{{ card.username }}</span>{%- endif -%}
                            {%- if pname != blank -%}<span class="product-name">{{ pname }}</span>{%- endif -%}
                            <div class="stars" role="img" aria-label="{{ rating }} / 5">
                              {%- for i in (1..5) -%}
                                {%- if i <= rating -%}<span class="star filled" aria-hidden="true">&#9733;</span>{%- else -%}<span class="star" aria-hidden="true">&#9734;</span>{%- endif -%}
                              {%- endfor -%}
                            </div>
                          </div>
                        {%- endunless -%}
                        {%- if show_btn -%}
                          <a class="custom-button" data-theme-button="primary" data-sl-button href="{{ blink | default: '/' }}">{{ st.button_text }}</a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="ctv__progress" data-ctv-progress role="progressbar" aria-label="{{ 'accessibility.carousel_progress' | t | default: 'Carousel progress' }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="ctv__progress-fill" data-ctv-progress-fill></div>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var sid = '{{ sid }}';
    function init() {
      var section = document.getElementById('community-stories-slider-' + sid);
      if (!section || section.__ctvInited) return;
      section.__ctvInited = true;

      var viewport = section.querySelector('[data-ctv-viewport]');
      var rail = section.querySelector('[data-ctv-rail]');
      var progress = section.querySelector('[data-ctv-progress]');
      var fill = section.querySelector('[data-ctv-progress-fill]');

      /* ---- 1. Keep videos alive: play visible ones, pause off-screen ones to
         avoid exceeding the browser's concurrent-decoder limit (the usual cause
         of frozen first frames), and auto-resume if anything stalls or another
         script pauses them. We never pause a video that's on screen. ---- */
      var videos = section.querySelectorAll('video');
      function inView(v) {
        var r = v.getBoundingClientRect();
        return r.bottom > 0 && r.top < (window.innerHeight || document.documentElement.clientHeight) &&
               r.right > 0 && r.left < (window.innerWidth || document.documentElement.clientWidth);
      }
      function kick(v) { v.muted = true; var p = v.play(); if (p && p.catch) p.catch(function(){}); }
      if ('IntersectionObserver' in window) {
        var vio = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { kick(en.target); }
            else { try { en.target.pause(); } catch (e) {} }
          });
        }, { threshold: 0.05 });
        Array.prototype.forEach.call(videos, function (v) { vio.observe(v); });
      }
      Array.prototype.forEach.call(videos, function (v) {
        ['stalled', 'suspend', 'error', 'pause'].forEach(function (ev) {
          v.addEventListener(ev, function () {
            if (inView(v)) { try { kick(v); } catch (e) {} }
          });
        });
      });

      if (!viewport || !rail) return;

      /* ---- 2. Progress bar + centre-when-it-fits ---- */
      function update() {
        var max = rail.scrollWidth - rail.clientWidth;
        var fits = max <= 1;
        rail.classList.toggle('is-centered', fits);
        viewport.classList.toggle('is-static', fits);
        if (!progress || !fill) return;
        var pct = fits ? 0 : Math.max(0, Math.min(100, (rail.scrollLeft / max) * 100));
        fill.style.width = pct + '%';
        progress.setAttribute('aria-valuenow', Math.round(pct));
      }
      if (progress) {
        progress.addEventListener('click', function (e) {
          var rect = progress.getBoundingClientRect();
          var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
          var max = rail.scrollWidth - rail.clientWidth;
          rail.scrollTo({ left: max * pct, behavior: 'smooth' });
        });
      }
      var ticking = false;
      rail.addEventListener('scroll', function () {
        if (!ticking) { window.requestAnimationFrame(function () { update(); ticking = false; }); ticking = true; }
      }, { passive: true });
      // Page wide listeners remove themselves once this slider is gone (the
      // builder draws the section again), so they never pile up.
      function whileHere(target, type, fn, opts) {
        function h(e) { if (!rail.isConnected) { target.removeEventListener(type, h, opts); return; } fn(e); }
        target.addEventListener(type, h, opts);
      }
      // Measured after the browser has laid the page out, never while the
      // page loads: a ResizeObserver reports the rail and its cards once they
      // have a size (before the first paint) and again only when one changes.
      // Reading scrollWidth here at DOMContentLoaded forced the whole page's
      // first layout inside this script (50-130ms).
      if ('ResizeObserver' in window) {
        var ro = new ResizeObserver(function () {
          if (!rail.isConnected) { ro.disconnect(); return; }
          update();
        });
        ro.observe(rail);
        Array.prototype.forEach.call(rail.children, function (card) { ro.observe(card); });
      } else {
        whileHere(window, 'resize', update);
        window.requestAnimationFrame(update);
      }

      /* ---- 3. Desktop mouse drag with rAF + inertia ---- */
      var isDown = false, moved = false, startX = 0, startScroll = 0;
      var lastX = 0, lastT = 0, velocity = 0, pendingX = 0, dragRaf = null, inertiaRaf = null;
      var THRESH = 3;
      function cancelInertia() { if (inertiaRaf) { cancelAnimationFrame(inertiaRaf); inertiaRaf = null; } }
      function dragFrame() { if (dragRaf) return; dragRaf = requestAnimationFrame(function () { dragRaf = null; rail.scrollLeft = pendingX; }); }
      function onDown(e) {
        if (e.button !== undefined && e.button !== 0) return;
        cancelInertia(); isDown = true; moved = false;
        startX = e.pageX; lastX = e.pageX; lastT = performance.now(); velocity = 0; startScroll = rail.scrollLeft;
      }
      function onMove(e) {
        if (!isDown) return;
        var dx = e.pageX - startX;
        if (!moved && Math.abs(dx) < THRESH) return;
        if (!moved) { moved = true; viewport.classList.add('is-dragging'); }
        if (e.cancelable !== false) e.preventDefault();
        var now = performance.now(), dt = Math.max(1, now - lastT);
        velocity = velocity * 0.7 + ((lastX - e.pageX) / dt) * 0.3;
        lastX = e.pageX; lastT = now;
        pendingX = startScroll - dx; dragFrame();
      }
      function onUp() {
        if (!isDown) return; isDown = false;
        if (!moved) return;
        viewport.classList.remove('is-dragging');
        var v = velocity * 16;
        if (Math.abs(v) > 0.5) {
          (function step() {
            v *= 0.92;
            if (Math.abs(v) < 0.4) { setTimeout(function () { moved = false; }, 30); return; }
            rail.scrollLeft += v;
            if (rail.scrollLeft <= 0 || rail.scrollLeft >= (rail.scrollWidth - rail.clientWidth)) { setTimeout(function () { moved = false; }, 30); return; }
            inertiaRaf = requestAnimationFrame(step);
          })();
        } else { setTimeout(function () { moved = false; }, 30); }
      }
      viewport.addEventListener('mousedown', onDown);
      whileHere(window, 'mousemove', onMove, { passive: false });
      whileHere(window, 'mouseup', onUp);
      viewport.addEventListener('mouseleave', onUp);
      viewport.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

      /* ---- 4. Keyboard ---- */
      viewport.tabIndex = 0;
      viewport.addEventListener('keydown', function (e) {
        var step = rail.clientWidth * 0.8;
        if (e.key === 'ArrowRight') { rail.scrollBy({ left: step, behavior: 'smooth' }); e.preventDefault(); }
        if (e.key === 'ArrowLeft') { rail.scrollBy({ left: -step, behavior: 'smooth' }); e.preventDefault(); }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else { init(); }
    function onLoad(e) {
      if (e.detail && e.detail.sectionId === sid) {
        var s = document.getElementById('community-stories-slider-' + sid);
        if (s) s.__ctvInited = false;
        init();
      }
    }
    if (!window['__ctvLoad_' + sid]) {
      window['__ctvLoad_' + sid] = true;
      document.addEventListener('shopify:section:load', onLoad);
      document.addEventListener('storelib:section-load', onLoad);
    }
  })();
{% comment %}{% endcomment %}</script>



