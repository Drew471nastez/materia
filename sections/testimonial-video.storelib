          },
          {
            "type": "subheading",
            "settings": {
              "subheading": "Express your style with our standout collection."
            }
          },
          {
            "type": "video_card",
            "settings": {
              "username": "@user1",
              "product_name": "Product 1",
              "rating": 5
            }
          },
          {
            "type": "video_card",
            "settings": {
              "username": "@user2",
              "product_name": "Product 2",
              "rating": 4
            }
          },
          {
            "type": "video_card",
            "settings": {
              "username": "@user3",
              "product_name": "Product 3",
              "rating": 5
            }
          },
          {
            "type": "video_card",
            "settings": {
