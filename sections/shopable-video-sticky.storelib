<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} The floating video slides in on its own (live-product-extras.js); the theme's section reveal is not used, because fading the zero-height wrapper would hide the fixed video with it. {%- endcomment -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  
  /* Reset spacing between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
/* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'shopable-video.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  assign image_ratio = section_st.image_ratio
  assign custom_ratio = section_st.custom_ratio
  assign offset_bottom = section_st.offset_bottom
  assign offset_left = section_st.offset_left
  assign action_close = section_st.action_close
-%}

<style>
  #shopify-section-{{ section.id }} .close-mini-video {
    background: var(--btn-primary-bg-color, var(--color-heading)) !important;
    color: var(--btn-primary-color, var(--color-background)) !important;
  }
  #shopify-section-{{ section.id }} .close-mini-video__hit {
    position: absolute;
    inset: -11px;
    border-radius: 50%;
  }
  #shopify-section-{{ section.id }} .close-mini-video:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 2px;
  }
  {%- comment -%} In the builder the video is shown at once, so the creator sees what they edit. {%- endcomment %}
  html.shopify-design-mode #shopify-section-{{ section.id }} .mini-video__video {
    transform: translateX(var(--left));
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .mini-video__video { transition: none; }
  }
  #shopify-section-{{ section.id }} .mini-video__product-link:focus-visible {
    outline: 2px solid var(--color-heading);
    outline-offset: 3px;
  }
{% comment %}{% endcomment %}</style>
<shopable-video-sticky class="shopable-video-sticky__mini-video color-{{ color_scheme }}" data-action-close="{{ action_close }}" data-svs-root data-svs-section="{{ section.id }}">
  <div class="mini-video__video fixed z-16" style="bottom: {{ offset_bottom }}px; --left: {{ offset_left }}px;"{% if request.design_mode %} data-svs-design{% endif %}>
      {% liquid
          assign block_st = section.blocks[0].settings
          assign poster_image = block_st.poster_image
          assign video_url = block_st.video_url
          assign local_video = block_st.local_video
      %}
      {%- assign mini_product = section.blocks[0].settings.product -%}
      <div class="mini-video__video-wrapper" style="position: relative;">
        {%- if mini_product != blank -%}
          <a class="mini-video__product-link" href="{{ mini_product.url }}" aria-label="{{ mini_product.title | escape }}" style="position: absolute; inset: 0; z-index: 1; border-radius: 100%;"></a>
        {%- endif -%}
        {% if poster_image != blank or video_url != blank or local_video != blank %}
          {%- liquid
            assign ratio = ''
            if image_ratio != 'adapt'
              case image_ratio
                when 'square'
                  assign ratio = '1/1'
                when 'landscape'
                  assign ratio = '4/3'
                when 'portrait'
                  assign ratio = '3/4'
                else
                  if custom_ratio != empty
                    assign ratio = custom_ratio | replace: ':', '/'
                  else
                    assign ratio = '3/4'
                  endif
              endcase
            else
              if poster_image != blank
                assign ratio = poster_image.aspect_ratio
              else
                assign ratio = local_video.aspect_ratio
              endif
            endif
          -%}
          <div
            class="video-mini-item__popup"
            style="--aspect-ratio: {{ ratio }};"
          >
            {% if local_video != blank %}
              {%- liquid
                assign source = local_video.sources
                assign source_url = ''
                for s in source
                  if s.format == 'mp4'
                    assign source_url = s.url
                    break
                  endif
                endfor
                assign poster = local_video.preview_image | image_url: width: 1100
                if poster_image != blank
                  assign poster = poster_image | image_url: width: 1100
                endif
              -%}
              <video
                loop="true"
                data-src="{{ source_url }}"
                data-poster="{{ poster }}"
                playsinline="true"
                autoplay="true"
                muted="true"
                aria-hidden="true"
                class="lazy-video-item"
              ></video>
            {% else %}
              {% if poster_image != blank %}
                {%- assign image_alt = poster_image.alt | default: mini_product.title | escape -%}
                {% render 'responsive-image', type: 'banner', image: poster_image, image_alt: image_alt %}
              {% else %}
                {% render 'placeholder-render' %}
              {% endif %}
            {% endif %}
          </div>
        {% else %}
          {%- liquid
            assign ratio = ''
            if image_ratio != 'adapt'
              case image_ratio
                when 'square'
                  assign ratio = '1/1'
                when 'landscape'
                  assign ratio = '4/3'
                when 'portrait'
                  assign ratio = '3/4'
                else
                  if custom_ratio != empty
                    assign ratio = custom_ratio | replace: ':', '/'
                  else
                    assign ratio = '3/4'
                  endif
              endcase
            else
              assign ratio = '3/4'
            endif
          -%}
          <div
            class="video-mini-item__popup"
            style="--aspect-ratio: {{ ratio }};"
          >
            {%- render 'placeholder-render', class: 'rounded' -%}
          </div>
        {% endif %}
        <button
          type="button"
          class="btn-reset button-close close-mini-video justify-center pointer inline-flex align-center"
          style="z-index: 2;"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="close-mini-video__hit" aria-hidden="true"></span>
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" class="transition" aria-hidden="true">
            <use href="#icon-close" />
          </svg>
        </button>
      </div>
  </div>
  <div class="shopable-video-sticky__blocks-content">
  
  </div>
</shopable-video-sticky>
<script src="{{ 'shopable-video-sticky.js' | asset_url }}" defer="defer"></script>



</template>

<schema>
{
  "type": "shopable-video-sticky",
  "name": "Shopable video sticky",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "action_close",
      "label": "Action close",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "text",
      "id": "custom_ratio",
      "label": "Custom ratio"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "offset_bottom",
      "label": "Offset bottom",
      "default": 150,
      "min": 5,
      "max": 300,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "offset_left",
      "label": "Offset left",
      "default": 25,
      "min": 5,
      "max": 155,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Image / Media"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster image"
        },
        {
          "type": "video",
          "id": "local_video",
          "label": "Local video"
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Content"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ],
      "limit": 10
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "shopify": {
    "name": "Floating video",
    "tag": "section",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Colour scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "action_close",
        "label": "Stay closed for a day",
        "default": false,
        "info": "After a visitor closes the video, it stays hidden for 24 hours."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "offset_bottom",
        "label": "Distance from bottom",
        "default": 150,
        "min": 5,
        "max": 300,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "offset_left",
        "label": "Distance from side",
        "default": 25,
        "min": 5,
        "max": 155,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "hidden": true,
        "info": "Legacy: the floating video slides in on its own after the visitor scrolls.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "adapt",
        "hidden": true,
        "info": "Legacy: the floating video is always a 150px circle.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "text",
        "id": "custom_ratio",
        "label": "Custom ratio",
        "hidden": true,
        "info": "Legacy: the floating video is always a 150px circle.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "hidden": true,
        "info": "Legacy: the floating video has no background area.",
        "visible_if": "{{ false }}"
      }
    ],
    "blocks": [
      {
        "type": "video",
        "limit": 1,
        "name": "Video",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "product",
            "id": "product",
            "label": "Product",
            "info": "The video links to this product."
          },
          {
            "type": "header",
            "content": "Media"
          },
          {
            "type": "image_picker",
            "id": "poster_image",
            "label": "Poster image",
            "info": "Shown before the video plays, and instead of it when motion is reduced."
          },
          {
            "type": "video",
            "id": "local_video",
            "label": "Video"
          }
        ]
      }
    ]
  }
}
</schema>