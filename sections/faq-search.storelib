<template compat="shopify">
<script src="{{ 'live-r7-faq.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. FAQ Search: heading and subheading blocks, a search field
  and the questions under it. Every question is a <details>, so the list
  opens and closes with scripts off; live-r7-faq.js filters it as the visitor
  types (question, answer and each question's extra search words, without
  minding capitals or accents), marks the matches, says how many are left
  and applies the builder's live edits. Styles: r7-faq.css, reading the
  --r7f-* variables on the root (snippets/r7-faq-vars).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign faq_items = section.blocks | where: 'type', 'faq_item'
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign header_count = heading_blocks.size | plus: sub_blocks.size
  assign group = ''
  unless st.allow_multiple_open
    assign group = 'r7f-' | append: sid
  endunless
  assign search_fallback = 'general.search.search' | t
  assign search_label = st.search_label | default: search_fallback
-%}
<style>
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }},#shopify-section-{{ sid }}>.section,#shopify-section-{{ sid }}>section,#shopify-section-{{ sid }}>div,#shopify-section-{{ sid }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ sid }}+.shopify-section,#shopify-section-{{ sid }}+section,.shopify-section+#shopify-section-{{ sid }}{margin-top:0!important}
  {%- endif %}
  #shopify-section-{{ sid }}{isolation:isolate;position:relative;margin-top:{{ st.section_margin_top_mobile | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_mobile | default: 0 }}px}
  @media (min-width:768px){#shopify-section-{{ sid }}{margin-top:{{ st.section_margin_top_desktop | default: 0 }}px;margin-bottom:{{ st.section_margin_bottom_desktop | default: 0 }}px}}
{% comment %}{% endcomment %}</style>
{%- comment -%} The builder also gets the styles inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'r7-faq.css' | inline_asset_content }}</style>{%- endif %}
{{ 'r7-faq.css' | asset_url | stylesheet_tag }}
{%- capture r7f_vars -%}{% render 'r7-faq-vars', section: section, kind: 'search' %}{%- endcapture -%}
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}

<div class="r7f r7f--search color-{{ color_scheme }} gradient" data-r7f="faq-search" data-r7f-section="{{ sid }}"{% if request.design_mode %} data-r7f-settings="{{ st | json | escape }}"{% endif %} data-r7f-width="{{ st.section_width | default: 'fluid_container' }}" data-r7f-align="{{ st.content_alignment | default: 'center' }}" data-r7f-icon="{{ st.open_icon | default: 'plus' }}"{% if st.enable_custom_question_weight %} data-r7f-qw{% endif %} style="{{ r7f_vars | strip_newlines }}">
  <div class="r7f__inner">
    <div class="r7f__col">
      {%- if header_count > 0 -%}
        <div class="r7f__header">
          {%- for block in section.blocks -%}
            {%- if block.type == 'heading' or block.type == 'subheading' -%}{%- render 'r7-faq-block', block: block, section: section -%}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if faq_items.size > 0 -%}
        <div class="r7f__search" role="search" data-r7f-search>
          <label class="visually-hidden" for="r7f-q-{{ sid }}" data-r7f-search-label{% if request.design_mode %} data-fallback="{{ search_fallback | escape }}"{% endif %}>{{ search_label | escape }}</label>
          <svg class="r7f__search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.8-3.8" stroke-linecap="round"/></svg>
          <input class="r7f__input" id="r7f-q-{{ sid }}" type="search" enterkeyhint="search" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="{{ search_label | escape }}" aria-controls="r7f-list-{{ sid }}" data-r7f-input{% if st.enable_custom_fonts and st.body_font.family != blank %} style="--body-font:{{ st.body_font.family }}, {{ st.body_font.fallback_families }}"{% endif %}>
          <button type="button" class="r7f__clear" data-r7f-clear hidden aria-label="{{ 'collections.sidebar.clear' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg></button>
        </div>
        <div class="r7f__status" data-r7f-status aria-hidden="true" data-count="{{ st.count_text | escape }}" data-empty="{{ st.empty_text | escape }}"></div>
        <span class="visually-hidden" role="status" aria-live="polite" data-r7f-live></span>
        <div class="r7f__list" id="r7f-list-{{ sid }}" data-r7f-list>
          {%- for block in faq_items -%}
            {%- assign open = false -%}
            {%- if st.first_item_open and forloop.first -%}{%- assign open = true -%}{%- endif -%}
            {%- render 'r7-faq-block', block: block, section: section, group: group, open: open -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- if request.design_mode -%}
{%- comment -%} The builder runs a redrawn or newly added section's inline scripts: load the controller if this page did not have it yet, or set this section up. {%- endcomment -%}
<script>(function(){if(window.MateriaR7Faq)return window.MateriaR7Faq.scan();if(document.querySelector('script[data-r7f-boot]'))return;var s=document.createElement('script');s.src="{{ 'live-r7-faq.js' | asset_url }}";s.setAttribute('data-r7f-boot','');document.head.appendChild(s);})();{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- if st.structured_data -%}{% render 'faq-live-jsonld', items: faq_items %}{%- endif -%}
</template>

<schema>
{
  "type": "faq-search",
  "name": "FAQ Search",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Add FAQ structured data",
      "default": false,
      "info": "Lets search engines read these questions. Turn it on for one FAQ section per page."
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search field text",
      "default": "Search the questions",
      "info": "Shown in the empty field and read out as its label."
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Result count text",
      "default": "Showing [count] of [total] questions",
      "info": "[count] and [total] become the numbers."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Nothing found text",
      "default": "No questions match your search. Try another word."
    },
    {
      "type": "checkbox",
      "id": "first_item_open",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow several open",
      "default": false
    },
    {
      "type": "select",
      "id": "open_icon",
      "label": "Icon",
      "default": "plus",
      "options": [
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "chevron",
          "label": "Chevron"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Content width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "gap_header_to_items",
      "label": "Gap below header",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "label": "Question padding (top and bottom)",
      "min": 6,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_18",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme and Theme settings > Forms and fields."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Question on hover",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "field_bg",
      "label": "Search field background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "field_border_color",
      "label": "Search field border",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "field_text_color",
      "label": "Search field text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading and question font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Text and answer font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "question_size_desktop",
      "label": "Question size (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "question_size_mobile",
      "label": "Question size (mobile)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_custom_question_weight",
      "label": "Custom question weight",
      "default": false
    },
    {
      "type": "select",
      "id": "question_weight",
      "label": "Question weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_question_weight }}"
    },
    {
      "type": "range",
      "id": "answer_size_desktop",
      "label": "Answer size (desktop)",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "answer_size_mobile",
      "label": "Answer size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "id": "hdr_39",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Follows Theme settings > Animations."
    },
    {
      "type": "header",
      "id": "hdr_41",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_46",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Questions and answers"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "700",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ],
          "visible_if": "{{ block.settings.weight_enable }}"
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 36,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 26,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.8,
          "max": 2,
          "step": 0.05,
          "default": 1.15,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "tracking",
          "label": "Letter spacing",
          "min": -2,
          "max": 10,
          "step": 0.5,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Type a word to find the answer you need.</p>"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "400",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "visible_if": "{{ block.settings.weight_enable }}"
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 11,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 16,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 1,
          "max": 2.2,
          "step": 0.05,
          "default": 1.5,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "faq_item",
