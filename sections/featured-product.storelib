<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign center = section_st.center
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign product = section_st.product
  assign first_3_d_model = product.media | where: 'media_type', 'model' | first
  assign desktop_layout = section_st.desktop_layout
  assign image_list = ''
  assign filtered_images = ''
  assign scroll_animation = settings.scroll_animation
-%}
{% for image in product.media %}
  {% if image.alt == 'image-360' and image.media_type == 'image' %}
    {% capture filtered_images %}{{ filtered_images }}{{ image.preview_image | image_url }},{% endcapture %}
  {% endif %}
{% endfor %}
{% assign filtered_images = filtered_images | split: ',' | compact %}
{% for image in filtered_images %}
  {% capture image_json %}"{{ image }}"{%- unless forloop.last -%},{%- endunless -%}{% endcapture %}
  {% capture image_list %}{{ image_list }}{{ image_json }}{% endcapture %}
{% endfor %}
{{ 'main-product.css' | asset_url | stylesheet_tag }}
{%- capture style -%}
      --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --gap: {{ section_st.space_between_text }}px; --speed: {{ section_st.speed }}s; --font-size: {{ section_st.font_size }};
{%- endcapture -%}
{%- comment -%} Square product images: snippets/product-media-layout draws every slide and thumbnail 1:1. {%- endcomment -%}
{%- if section_st.show_thumbnails == false -%}
<style>
  /* Hide thumbnail strip for this section instance only */
  #shopify-section-{{ section.id }} .media-thumb-swiper,
  #shopify-section-{{ section.id }} .thumbnail-slide,
  #shopify-section-{{ section.id }} [class*="thumb-"] {
    display: none !important;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- if first_3_d_model -%}
  {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
  >
{% endif %}
{% if image_list.size != 0 %}
  <script src="{{ 'js-cloudimage-360-view.min.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- comment -%} The same media options as Main product: hover zoom, dots on a phone. {%- endcomment -%}
{%- assign fp_zoom = section_st.image_zoom | default: 'no_zoom' -%}
{%- if fp_zoom == 'external_zoom' or fp_zoom == 'inner_zoom_circle' or fp_zoom == 'inner_zoom_square' -%}
  {{ 'photoswipe.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section_st.enable_nav_dots_mobile -%}
  {%- render 'product-extras', mode: 'nav_dots', section_id: section.id -%}
{%- endif -%}
{%- if section_st.enable_size_chart == false or section_st.enable_dynamic_checkout == false -%}
<style>
  {%- if section_st.enable_size_chart == false %}#shopify-section-{{ section.id }} :is(.scp, .mt-size-guide-root, .materia-chart-preview) { display: none !important; }{% endif -%}
  {%- if section_st.enable_dynamic_checkout == false %}#shopify-section-{{ section.id }} .btn-checkout-dynamic { display: none !important; }{% endif -%}
{% comment %}{% endcomment %}</style>
{%- endif -%}
<div
  class="product__item-js section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__featured-product color-{{ color_scheme }} gradient{{ reset_spacing }} {% if center == true %} feature_product-center {% endif %}"
  style="{{ style | strip | strip_newlines }}"
  data-desktop-layout="{{ desktop_layout }}"
  data-mobile-layout="{{ section_st.mobile_options | default: 'show_thumbnails' }}"
  data-color-trigger="{{ settings.color_swatch_trigger }}"
  data-section="{{ section.id }}"
  data-zoom="no_zoom"
  data-type-element="feature_product"
>
  <div
    class="featured-product__content {{ section_width }} "

  >
    {% render 'product-single-layout', product: section_st.product, section: section, type: 'single' %}
  </div>
  {%- render 'product-variant-media-json', product: product -%}
  {%- unless product.has_only_default_variant -%}
    <script type="application/json" class="productVariantsQty">
      [
        {%- for variant in product.variants -%}
          { "id": {{ variant.id | json }}, "option": {{ variant.option1 | append: '' | json }}, "qty": {{ variant.inventory_quantity | default: 0 | json }}, "available": {% if variant.available %}true{% else %}false{% endif %}, "mamagement": {{ variant.inventory_management | append: '' | json }}, "incoming": {% if variant.incoming %}true{% else %}false{% endif %}, "incoming_date": {{ variant.next_incoming_date | append: '' | json }} }
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
{% comment %}{% endcomment %}    </script>
  {%- endunless -%}
  {%- if first_3_d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
{% comment %}{% endcomment %}    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {% endif %}
</div>


{%- liquid
  assign fp_fx = false
  for fp_b in section.blocks
    if fp_b.type == 'bundle' or fp_b.type == 'upsell_pro' or fp_b.type == 'pair_with_upsell'
      assign fp_fx = true
    endif
  endfor
-%}
{%- if fp_fx -%}
<style>
  #shopify-section-{{ section.id }} .fp-bb { transition: background-color .3s ease, color .3s ease, box-shadow .3s ease, opacity .2s ease, transform .18s cubic-bezier(.2,.7,.2,1); }
  #shopify-section-{{ section.id }} .fp-bb:active { transform: scale(.985); }
  #shopify-section-{{ section.id }} .fp-bb--loading { pointer-events: none; cursor: progress; opacity: .9; }
  #shopify-section-{{ section.id }} .fp-bb--added { pointer-events: none; }
  #shopify-section-{{ section.id }} .fp-ab--loading { pointer-events: none; cursor: progress; opacity: .6; transition: opacity .15s ease; }
  #shopify-section-{{ section.id }} .fp-bb__inner { display: inline-flex; align-items: center; justify-content: center; gap: 8px; animation: fpBbIn .3s cubic-bezier(.2,.7,.2,1) both; }
  #shopify-section-{{ section.id }} .fp-bb__spin { flex: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: fpBbSpin .7s linear infinite; }
  #shopify-section-{{ section.id }} .fp-bb__check { flex: none; width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .fp-bb__check path { stroke-dasharray: 24; stroke-dashoffset: 24; animation: fpBbDraw .42s .08s cubic-bezier(.2,.7,.2,1) forwards; }
  #shopify-section-{{ section.id }} .fp-bb--error { animation: fpBbShake .4s ease; }
  @keyframes fpBbIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes fpBbSpin { to { transform: rotate(360deg); } }
  @keyframes fpBbDraw { to { stroke-dashoffset: 0; } }
  @keyframes fpBbShake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 50% { transform: translateX(4px); } 75% { transform: translateX(-2px); } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .fp-bb, #shopify-section-{{ section.id }} .fp-bb__inner, #shopify-section-{{ section.id }} .fp-bb--error { transition: none; animation: none; }
    #shopify-section-{{ section.id }} .fp-bb__check path { animation: none; stroke-dashoffset: 0; }
    #shopify-section-{{ section.id }} .fp-bb__spin { animation-duration: 1.6s; }
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.__fpBundleFx) return;
    root.__fpBundleFx = true;
    var confs = [
{%- for fp_b in section.blocks -%}
{%- if fp_b.type == 'bundle' -%}
      { kind: 'full', bundle: true, label: {{ fp_b.settings.button_label | default: 'Add bundle to cart' | json }}, adding: {{ fp_b.settings.adding_label | default: 'Adding to cart' | json }}, added: {{ fp_b.settings.added_label | default: 'Added to cart' | json }}, error: {{ fp_b.settings.error_text | default: 'These could not be added. Try again.' | json }}, open: {% if fp_b.settings.open_cart_after_add == false %}false{% else %}true{% endif %} },
{%- elsif fp_b.type == 'upsell_pro' -%}
      { kind: 'full', label: {{ fp_b.settings.add_selected_label | default: 'Add chosen items' | json }}, adding: {{ fp_b.settings.add_selected_label | default: 'Add chosen items' | json }}, added: {{ fp_b.settings.added_text | default: 'Added' | json }}, error: {{ fp_b.settings.error_text | default: 'This could not be added. Try again.' | json }}, open: true },
      { kind: 'light', label: {{ fp_b.settings.upsell_button_text | default: 'Add' | json }}, added: {{ fp_b.settings.added_text | default: 'Added' | json }}, open: {% if fp_b.settings.open_drawer_after_add %}true{% else %}false{% endif %} },
{%- elsif fp_b.type == 'pair_with_upsell' -%}
      { kind: 'light', label: {{ fp_b.settings.btn_label | default: 'Add product' | json }}, added: {{ fp_b.settings.btn_label_added | default: 'Added' | json }}, open: {% if fp_b.settings.open_drawer_after_add %}true{% else %}false{% endif %} },
{%- endif -%}
{%- endfor -%}
    ];
    var fullBundle = null;
    for (var ci = 0; ci < confs.length; ci++) { if (confs[ci].bundle) { fullBundle = confs[ci]; break; } }
    var WRAP = '[class*="bundle"], [data-bundle], [data-block-type="bundle"], [class*="upsell"], [class*="pair"], [data-upsell]';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var pending = null;

    if (!window.__fpCartFetchPatched && window.fetch) {
      window.__fpCartFetchPatched = true;
      var nativeFetch = window.fetch;
      window.fetch = function(input, init){
        var url = typeof input === 'string' ? input : ((input && input.url) || '');
        var method = String((init && init.method) || (input && input.method) || 'GET').toUpperCase();
        var watch = method !== 'GET' && /cart/i.test(url);
        if (watch) document.dispatchEvent(new CustomEvent('fp:cart-start'));
        var p = nativeFetch.apply(this, arguments);
        if (watch) {
          p.then(function(r){ document.dispatchEvent(new CustomEvent('fp:cart-end', { detail: { ok: !!(r && r.ok) } })); },
                 function(){ document.dispatchEvent(new CustomEvent('fp:cart-end', { detail: { ok: false } })); });
        }
        return p;
      };
    }
    if (!window.__fpCartXhrPatched && window.XMLHttpRequest) {
      window.__fpCartXhrPatched = true;
      var xo = XMLHttpRequest.prototype.open, xs = XMLHttpRequest.prototype.send;
      XMLHttpRequest.prototype.open = function(m, u){ this.__fpWatch = String(m || 'GET').toUpperCase() !== 'GET' && /cart/i.test(String(u || '')); return xo.apply(this, arguments); };
      XMLHttpRequest.prototype.send = function(){
        if (this.__fpWatch) {
          var x = this;
          document.dispatchEvent(new CustomEvent('fp:cart-start'));
          x.addEventListener('loadend', function(){ document.dispatchEvent(new CustomEvent('fp:cart-end', { detail: { ok: x.status >= 200 && x.status < 300 } })); });
        }
        return xs.apply(this, arguments);
      };
    }
    function countText(){
      var c = document.querySelector('[data-storelib-cart-count], .cart-count-bubble, [data-cart-count]');
      return c ? String(c.textContent || '').trim() : null;
    }

    function norm(s){ return String(s || '').replace(/\s+/g, ' ').trim().toLowerCase(); }
    function findBtn(t){
      var b = t && t.closest ? t.closest('button, input[type="submit"], a') : null;
      if (!b || !root.contains(b) || b.disabled) return null;
      // These controls own their request/confirmation lifecycle in product-offers.js.
      if (b.closest('product-bundle, quantity-offer, upsell-pro, pair-with, storelib-product-offers')) return null;
      var wrap = b.closest(WRAP);
      var txt = norm(b.value || b.textContent);
      var i, c, l;
      for (i = 0; i < confs.length; i++) {
        c = confs[i]; l = norm(c.label);
        if (c.kind === 'full' && l && txt.indexOf(l) !== -1) {
          if (!wrap && b.closest('form[action*="/cart/add"]')) continue;
          return { btn: b, conf: c };
        }
      }
      if (!wrap) return null;
      for (i = 0; i < confs.length; i++) {
        c = confs[i]; l = norm(c.label);
        if (c.kind === 'light' && l && txt.indexOf(l) === 0 && txt !== norm(c.added)) return { btn: b, conf: c };
      }
      var bw = b.closest('[class*="bundle"], [data-bundle], [data-block-type="bundle"]');
      if (bw && fullBundle) {
        var all = bw.querySelectorAll('button, input[type="submit"]');
        if (all.length && all[all.length - 1] === b) return { btn: b, conf: fullBundle };
      }
      return null;
    }

    function setState(b, state, text){
      var isInput = b.tagName === 'INPUT';
      if (state === 'idle') {
        if (b.__fpOrig != null) { if (isInput) b.value = b.__fpOrig; else b.innerHTML = b.__fpOrig; }
        b.__fpOrig = null;
        b.classList.remove('fp-bb--loading', 'fp-bb--added', 'fp-bb--error', 'fp-ab--loading');
        b.style.minWidth = '';
        b.removeAttribute('aria-busy');
        return;
      }
      if (b.__fpOrig == null) { b.__fpOrig = isInput ? b.value : b.innerHTML; b.style.minWidth = b.offsetWidth + 'px'; }
      b.classList.add('fp-bb');
      b.classList.remove('fp-bb--loading', 'fp-bb--added', 'fp-bb--error');
      b.classList.add('fp-bb--' + state);
      if (state === 'loading') b.setAttribute('aria-busy', 'true'); else b.removeAttribute('aria-busy');
      if (isInput) { b.value = text; return; }
      var icon = '';
      if (state === 'loading') icon = '<span class="fp-bb__spin" aria-hidden="true"></span>';
      if (state === 'added') icon = '<svg class="fp-bb__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
      var span = document.createElement('span');
      span.textContent = text;
      b.innerHTML = '<span class="fp-bb__inner" role="status">' + icon + span.outerHTML + '</span>';
    }

    function cartIsOpen(){
      if (document.querySelector('[data-storelib-cart][aria-expanded="true"], [data-storelib-cart-panel][open], [data-storelib-cart-panel].is-open, [data-storelib-cart-panel].active, cart-drawer[open], cart-drawer.active, .cart-drawer.active, .cart-drawer.is-open, .cart-drawer.open, #CartDrawer.active, #CartDrawer.is-open')) return true;
      var els = document.querySelectorAll('[class*="cart"][class*="drawer"], [id*="art"][id*="rawer"]');
      for (var i = 0; i < els.length; i++) { if (/(^|\s)(open|active|is-open|is-active|is-visible|show)(\s|$)/.test(els[i].className)) return true; }
      return false;
    }
    function openCart(){
      if (cartIsOpen()) return;
      document.dispatchEvent(new CustomEvent('storelib:cart:open'));
      requestAnimationFrame(function(){
        if (cartIsOpen()) return;
        var triggers = document.querySelectorAll('[data-storelib-cart]');
        for (var i = 0; i < triggers.length; i++) { if (triggers[i].offsetParent !== null) { triggers[i].click(); return; } }
      });
    }

    function finish(ok){
      if (!pending) return;
      var p = pending, b = p.btn, c = p.conf;
      clearTimeout(p.guard); clearTimeout(p.settle); clearTimeout(p.early); clearInterval(p.poll);
      pending = null;
      if (ok) { ['storelib:cart:refresh', 'cart:refresh'].forEach(function(ev){ try { document.dispatchEvent(new CustomEvent(ev, { detail: { source: 'fp' } })); } catch (err) {} }); }
      b.classList.remove('fp-ab--loading');
      if (c.kind !== 'full') {
        b.removeAttribute('aria-busy');
        if (ok && c.open && !p.opened) openCart();
        return;
      }
      if (ok) {
        setState(b, 'added', c.added);
        if (c.open && !p.opened) openCart();
        setTimeout(function(){ setState(b, 'idle'); }, 2200);
      } else {
        setState(b, 'error', c.error);
        setTimeout(function(){ setState(b, 'idle'); }, 2600);
      }
    }
    function settleSoon(){
      if (!pending) return;
      if (!pending.failed && !pending.opened && pending.conf.open) { pending.opened = true; openCart(); }
      clearTimeout(pending.settle);
      pending.settle = setTimeout(function(){
        if (pending && pending.inflight <= 0) finish(!pending.failed);
      }, 20);
    }

    document.addEventListener('click', function(e){
      var hit = findBtn(e.target);
      if (!hit || pending) return;
      var b = hit.btn, conf = hit.conf;
      if (b.classList.contains('fp-bb--added')) return;
      pending = { btn: b, conf: conf, opened: false, inflight: 0, started: false, failed: false, guard: null, settle: null, early: null, poll: null, count: countText() };
      if (conf.open) {
        pending.early = setTimeout(function(){
          if (pending && pending.btn === b && !pending.opened && !pending.failed) { pending.opened = true; openCart(); }
        }, 250);
      }
      pending.poll = setInterval(function(){
        if (!pending) return;
        if (pending.conf.open && !pending.opened && cartIsOpen()) pending.opened = true;
        var now = countText();
        if (pending.count !== null && now !== null && now !== pending.count && pending.inflight <= 0) { pending.started = true; settleSoon(); }
      }, 40);
      if (conf.kind === 'full') {
        requestAnimationFrame(function(){ if (pending && pending.btn === b) setState(b, 'loading', conf.adding); });
      } else {
        b.classList.add('fp-ab--loading');
        b.setAttribute('aria-busy', 'true');
      }
      pending.guard = setTimeout(function(){
        if (!pending) return;
        if (pending.count !== null && countText() !== pending.count) { finish(true); return; }
        if (!pending.failed && pending.inflight <= 0) { finish(true); return; }
        var pb = pending.btn; clearInterval(pending.poll); clearTimeout(pending.early); pending = null; setState(pb, 'idle');
      }, 4000);
    }, true);

    document.addEventListener('fp:cart-start', function(){
      if (!pending) return;
      pending.started = true; pending.inflight++; clearTimeout(pending.settle);
      if (pending.conf.open && !pending.opened) { pending.opened = true; requestAnimationFrame(openCart); }
    });
    document.addEventListener('fp:cart-end', function(e){
      if (!pending) return;
      pending.inflight = Math.max(0, pending.inflight - 1);
      if (!e.detail || !e.detail.ok) pending.failed = true;
      if (pending.inflight === 0) settleSoon();
    });
    ['cart:updated', 'cart:refresh', 'cart:change', 'storelib:cart:updated', 'storelib:cart:change', 'theme:cart:change'].forEach(function(ev){
      document.addEventListener(ev, function(){ if (pending && pending.inflight === 0) { pending.started = true; settleSoon(); } });
    });
    var counts = document.querySelectorAll('[data-storelib-cart-count], .cart-count-bubble, [data-cart-count]');
    if (counts.length && window.MutationObserver) {
      var mo = new MutationObserver(function(){ if (pending && pending.inflight === 0) { pending.started = true; settleSoon(); } });
      for (var i = 0; i < counts.length; i++) mo.observe(counts[i], { childList: true, characterData: true, subtree: true });
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
</template>

