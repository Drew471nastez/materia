    {
      "type": "bundle_deal",
      "name": "Bundle & Save",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "How it works (read me)"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Header & dividers"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Save more"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading size",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 18
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show side lines",
          "default": true
        },
        {
          "type": "color",
          "id": "divider_color",
          "label": "Line color",
          "default": "#C7CDD4"
        },
        {
          "type": "select",
          "id": "divider_style",
          "label": "Line style",
          "default": "solid",
          "options": [
            {
              "value": "solid",
