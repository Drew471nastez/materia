      {
        "type": "size_guide",
        "name": "Size guide",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Sizes"
          },
          {
            "type": "paragraph",
            "content": "Shows the size chart you gave this product in Storelib (Products > Size charts), so each product gets its own. A product without one shows your Size rows, then the text or page below."
          },
          {
            "type": "checkbox",
            "id": "use_storelib_chart",
            "label": "Use the product's Storelib size chart",
            "default": true
          },
          {
            "type": "textarea",
            "id": "table_data",
            "label": "Size rows",
            "placeholder": "Size | Chest | Waist\nS | 86-91 | 71-76\nM | 92-97 | 77-82",
            "info": "First line: the column names. Then one size per line, cells split by |, for example Size | Chest | Waist, then S | 86-91 | 71-76."
          },
          {
            "type": "select",
            "id": "table_unit",
            "label": "Size rows are in",
            "default": "none",
            "options": [
              {
                "value": "none",
                "label": "No switch"
              },
              {
                "value": "cm",
                "label": "cm"
              },
              {
                "value": "in",
                "label": "in"
              }
            ],
            "info": "Pick the unit you typed to give visitors a cm / in switch."
          },
          {
            "type": "header",
            "content": "Link"
          },
          {
            "type": "text",
            "id": "size_guide_label",
            "label": "Link or button label",
            "default": "Size guide"
          },
