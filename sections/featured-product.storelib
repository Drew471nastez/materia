            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 16
          },
          {
            "type": "range",
            "id": "divider_max",
            "label": "Max line length (0 = full width)",
            "min": 0,
            "max": 300,
            "step": 10,
            "unit": "px",
            "default": 0
          },
          {
            "type": "header",
