            "type": "checkbox",
            "id": "show_price",
            "label": "Show price",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "show_compare_at",
            "label": "Show compare-at price",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "show_sale_badge",
            "label": "Show sale badge",
            "default": true
          },
          {
            "type": "text",
            "id": "sale_badge_text",
            "label": "Sale badge text",
            "default": "Sale",
            "visible_if": "{{ block.settings.show_sale_badge }}"
          },
          {
            "type": "checkbox",
            "id": "show_variant_selector",
            "label": "Show option picker",
            "default": false
          },
          {
            "type": "header",
            "content": "Adding to cart"
          },
          {
            "type": "select",
            "id": "purchase_action",
            "label": "Purchase buttons",
            "default": "own",
            "options": [
              {
                "value": "own",
                "label": "Block button"
              },
              {
                "value": "main",
                "label": "Main buttons"
              },
              {
                "value": "both",
                "label": "Both"
              }
            ],
            "info": "Main buttons include this selection in the product Add to cart and Buy now. Buy now uses cart checkout, including existing cart items and required cart terms."
          },
          {
            "type": "checkbox",
            "id": "show_button",
            "label": "Show block Add to cart button",
            "default": true,
            "info": "Choose Main buttons above to purchase this selection without its own button."
          },
          {
            "type": "select",
            "id": "add_mode",
            "label": "Add",
            "default": "each",
            "options": [
              {
                "value": "each",
                "label": "Each card"
              },
              {
                "value": "selected",
                "label": "Tick and add"
              }
            ],
            "info": "Tick and add: the buyer ticks products and adds them in one step, with the total shown."
          },
          {
            "type": "checkbox",
            "id": "preselect",
            "label": "Start ticked",
            "default": true,
            "visible_if": "{{ block.settings.add_mode == 'selected' }}"
          },
          {
            "type": "text",
            "id": "upsell_button_text",
            "label": "Button text",
            "default": "Add",
            "visible_if": "{{ block.settings.add_mode == 'each' }}"
          },
          {
            "type": "text",
            "id": "added_text",
            "label": "Added button text",
            "default": "Added",
            "visible_if": "{{ block.settings.add_mode == 'each' }}"
          },
          {
            "type": "text",
            "id": "add_selected_label",
            "label": "Add selected button",
            "default": "Add chosen items",
            "visible_if": "{{ block.settings.add_mode == 'selected' }}"
          },
          {
            "type": "text",
            "id": "total_label",
            "label": "Total label",
            "default": "Total",
            "visible_if": "{{ block.settings.add_mode == 'selected' }}"
          },
          {
            "type": "text",
            "id": "soldout_text",
            "label": "Sold out text",
            "default": "Sold out"
          },
          {
            "type": "text",
            "id": "error_text",
            "label": "Error message",
            "default": "This could not be added. Try again."
          },
          {
            "type": "checkbox",
            "id": "open_drawer_after_add",
            "label": "Open cart drawer after add",
