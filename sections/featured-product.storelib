<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign center = section_st.center
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign product = section_st.product
  assign first_3_d_model = product.media | where: 'media_type', 'model' | first
  assign desktop_layout = section_st.desktop_layout
  assign image_list = ''
  assign filtered_images = ''
  assign scroll_animation = settings.scroll_animation
-%}
{% for image in product.media %}
  {% if image.alt == 'image-360' and image.media_type == 'image' %}
    {% capture filtered_images %}{{ filtered_images }}{{ image.preview_image | image_url }},{% endcapture %}
  {% endif %}
{% endfor %}
{% assign filtered_images = filtered_images | split: ',' | compact %}
{% for image in filtered_images %}
  {% capture image_json %}"{{ image }}"{%- unless forloop.last -%},{%- endunless -%}{% endcapture %}
  {% capture image_list %}{{ image_list }}{{ image_json }}{% endcapture %}
{% endfor %}
{{ 'main-product.css' | asset_url | stylesheet_tag }}
{%- capture style -%}
      --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --gap: {{ section_st.space_between_text }}px; --speed: {{ section_st.speed }}s; --font-size: {{ section_st.font_size }};
{%- endcapture -%}
{%- if section_st.enable_image_square -%}
<style>
  /* Square product images — overrides the inline --aspect-ratio CSS variable
     set by the media-gallery / product-media-layout snippets, scoped to this
     section instance only. */
  #shopify-section-{{ section.id }} .media-gallery__image,
  #shopify-section-{{ section.id }} .media-main-swiper .swiper-slide,
  #shopify-section-{{ section.id }} .swiper-wrapper-preview .swiper-slide,
  #shopify-section-{{ section.id }} [style*="--aspect-ratio"],
  #shopify-section-{{ section.id }} .product-detail__media .swiper-slide,
  #shopify-section-{{ section.id }} .thumbnail-slide [class*="media-gallery__"] {
    --aspect-ratio: 1 / 1 !important;
    aspect-ratio: 1 / 1 !important;
  }
  #shopify-section-{{ section.id }} .media-gallery__image img,
  #shopify-section-{{ section.id }} .media-gallery__image video,
  #shopify-section-{{ section.id }} .media-gallery__image picture img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    aspect-ratio: 1 / 1 !important;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- if section_st.show_thumbnails == false -%}
<style>
  /* Hide thumbnail strip for this section instance only */
  #shopify-section-{{ section.id }} .media-thumb-swiper,
  #shopify-section-{{ section.id }} .thumbnail-slide,
  #shopify-section-{{ section.id }} [class*="thumb-"] {
    display: none !important;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- if first_3_d_model -%}
  {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{% endif %}
{% if image_list.size != 0 %}
  <script src="{{ 'js-cloudimage-360-view.min.js' | asset_url }}" defer="defer"></script>
{% endif %}
<div
  class="product__item-js section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__featured-product color-{{ color_scheme }} gradient{{ reset_spacing }} {% if center == true %} feature_product-center {% endif %}"
  style="{{ style | strip | strip_newlines }}"
  data-desktop-layout="{{ desktop_layout }}"
  data-color-trigger="{{ settings.color_swatch_trigger }}"
  data-section="{{ section.id }}"
  data-zoom="no_zoom"
  data-type-element="feature_product"
>
  <div
    class="featured-product__content {{ section_width }} "

  >
    {% render 'product-single-layout', product: section_st.product, section: section, type: 'single' %}
  </div>
  {%- unless product.has_only_default_variant -%}
    <script type="application/json" class="productVariantsQty">
      [
        {%- for variant in product.variants -%}
          { "id": {{ variant.id | json }}, "option": {{ variant.option1 | append: '' | json }}, "qty": {{ variant.inventory_quantity | default: 0 | json }}, "available": {% if variant.available %}true{% else %}false{% endif %}, "mamagement": {{ variant.inventory_management | append: '' | json }}, "incoming": {% if variant.incoming %}true{% else %}false{% endif %}, "incoming_date": {{ variant.next_incoming_date | append: '' | json }} }
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
{% comment %}{% endcomment %}    </script>
  {%- endunless -%}
  {%- if first_3_d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
{% comment %}{% endcomment %}    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {% endif %}
</div>


</template>

<schema>
{
  "type": "featured-product",
  "name": "Featured product",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Style & Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Pick a product"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "Show color swatches in product info",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_size_chart",
      "label": "Show size chart link",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Image / Media"
    },
    {
      "type": "select",
      "id": "desktop_main_image_position",
      "label": "Main image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_image_square",
      "label": "Square product images",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Carousel Options"
    },
    {
      "type": "checkbox",
      "id": "enable_video_autoplay",
      "label": "Auto-play product videos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop product videos",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "enable_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 32,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 32,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Center information",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_media_width",
      "label": "Desktop media width",
      "default": 50,
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Thumbnails layout",
      "default": "thumbnail_bottom",
      "options": [
        {
          "value": "thumbnail_left",
          "label": "Thumbnails on the left"
        },
        {
          "value": "thumbnail_bottom",
          "label": "Thumbnails below"
        },
        {
          "value": "hidden_thumbnail",
          "label": "Hide thumbnails"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "delivery_pills",
      "name": "Delivery & warranty pills",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Layout"
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "label": "Columns (desktop)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 2
        },
        {
          "type": "select",
          "id": "columns_mobile",
          "label": "Columns (mobile)",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            }
          ]
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Gap between pills",
          "min": 4,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "select",
          "id": "align",
          "label": "Content alignment",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ]
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Top margin",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Bottom margin",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Pill style"
        },
        {
          "type": "color",
          "id": "pill_bg",
          "label": "Pill background",
          "default": "#EEF4FB"
        },
        {
          "type": "range",
          "id": "pill_radius",
          "label": "Corner radius",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "pill_padding_y",
          "label": "Vertical padding",
          "min": 4,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "pill_padding_x",
          "label": "Horizontal padding",
          "min": 4,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "pill_border_width",
          "label": "Border width",
          "min": 0,
          "max": 4,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "pill_border_color",
          "label": "Border color"
        },
        {
          "type": "header",
          "id": "hdr_15",
          "label": "Icon & text"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 14,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 22
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#1B1B1B"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Title color",
          "default": "#1B1B1B"
        },
        {
          "type": "range",
          "id": "subtitle_size",
          "label": "Subtitle size",
          "min": 10,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle color",
          "default": "#5B6470"
        },
        {
          "type": "header",
          "id": "hdr_22",
          "label": "Pill 1"
        },
        {
          "type": "checkbox",
          "id": "pill_1_enable",
          "label": "Show pill 1",
          "default": true
        },
        {
          "type": "select",
          "id": "pill_1_icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "refresh",
              "label": "Returns / refresh"
            },
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "globe",
              "label": "Globe"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "headphones",
              "label": "Support"
            },
            {
              "value": "handshake",
              "label": "Handshake"
            },
            {
              "value": "recycle",
              "label": "Recycle"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ]
        },
        {
          "type": "text",
          "id": "pill_1_title",
          "label": "Title",
          "default": "Fast 2-5 Day Europe Delivery"
        },
        {
          "type": "text",
          "id": "pill_1_subtitle",
          "label": "Subtitle (optional)"
        },
