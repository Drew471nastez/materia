      {
        "type": "bundle_deal",
        "name": "Bundle & Save",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "How it works (read me)"
          },
          {
            "type": "header",
            "content": "Header & dividers"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Save more"
          },
          {
            "type": "range",
            "id": "heading_size",
            "label": "Heading size",
            "min": 12,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 18
          },
          {
            "type": "checkbox",
            "id": "show_divider",
