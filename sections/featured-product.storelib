      {
        "type": "bundle",
        "name": "Bundle",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Products"
          },
          {
            "type": "product",
            "id": "product_1",
            "label": "Product 1"
          },
          {
            "type": "product",
            "id": "product_2",
            "label": "Product 2"
          },
          {
            "type": "product",
            "id": "product_3",
            "label": "Product 3"
          },
          {
            "type": "paragraph",
            "content": "Sells this product with one to three others you pick, added to the cart in one step. Prices come from your products. Storelib checkout takes the saving off when the store has the same bundle under Products › Upsells and bundles; the block then shows that bundle's saving by itself. Otherwise set a discount code below and keep the saving shown the same."
          },
          {
            "type": "header",
            "content": "Style"
          },
          {
            "type": "select",
            "id": "style",
            "label": "Style",
            "default": "cards",
            "options": [
              {
                "value": "cards",
                "label": "Cards"
              },
              {
                "value": "list",
                "label": "List"
              },
              {
                "value": "bold",
                "label": "Bold"
              },
              {
                "value": "soft",
                "label": "Soft"
              },
              {
                "value": "minimal",
                "label": "Minimal"
              },
              {
                "value": "compact",
                "label": "Compact rows"
              },
              {
                "value": "accent",
                "label": "Accent outline"
              },
              {
                "value": "editorial",
                "label": "Editorial"
              },
              {
                "value": "contrast",
                "label": "Contrast panels"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "show_images",
            "label": "Show pictures",
            "default": true
          },
          {
            "type": "checkbox",
            "id": "show_compare",
            "label": "Show compare at prices",
            "default": true
          },
          {
            "type": "color",
            "id": "accent_color",
            "visible_if": "{{ block.settings.custom_style }}",
            "label": "Accent",
            "info": "Empty follows the colour scheme."
          },
          {
            "type": "range",
            "id": "padding_top",
            "label": "Top spacing",
            "min": 0,
            "max": 40,
            "step": 2,
            "unit": "px",
            "default": 8
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "label": "Bottom spacing",
            "min": 0,
            "max": 40,
            "step": 2,
            "unit": "px",
            "default": 16
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Buy it together"
          },
          {
            "type": "text",
            "id": "caption",
            "label": "Caption",
            "info": "A short line above the box, such as Bundle & save."
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "text",
            "id": "badge",
            "label": "Badge",
            "info": "Optional, on the box's top edge, such as Best value."
          },
          {
            "type": "text",
            "id": "this_item_label",
            "label": "Label on this product",
            "default": "This item"
          },
          {
            "type": "text",
            "id": "option_label",
            "label": "Option list name",
            "default": "Option"
          },
          {
            "type": "header",
            "content": "Saving"
          },
          {
            "type": "range",
            "id": "discount_percent",
            "label": "Saving shown",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "%",
            "default": 0,
            "info": "Shown when every product is ticked. A matching Storelib bundle's own saving is shown instead. 0 shows no saving."
          },
          {
            "type": "text",
            "id": "discount_code",
            "label": "Discount code",
            "info": "Optional. Applied to the cart when the whole set is added. Create the code in Storelib first."
          },
          {
            "type": "text",
            "id": "total_label",
            "label": "Total label",
            "default": "Total"
          },
          {
            "type": "text",
            "id": "savings_label",
            "label": "Saving label",
            "default": "You save"
          },
          {
            "type": "text",
            "id": "checkout_note",
            "label": "Note when Storelib takes the saving off",
            "default": "The saving comes off at checkout."
          },
          {
            "type": "header",
            "content": "Button"
          },
          {
            "type": "select",
            "id": "purchase_action",
            "label": "Purchase buttons",
            "default": "own",
            "options": [
              {
                "value": "own",
                "label": "Block button"
              },
              {
                "value": "main",
                "label": "Main buttons"
              },
              {
                "value": "both",
                "label": "Both"
              }
            ],
            "info": "Main buttons include this selection in the product Add to cart and Buy now. Buy now uses cart checkout, including existing cart items and required cart terms."
          },
          {
            "type": "checkbox",
            "id": "show_button",
            "label": "Show block Add to cart button",
            "default": true,
            "info": "Choose Main buttons above to purchase this selection without its own button."
