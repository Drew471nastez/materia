<template compat="shopify">
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'page-password.css' | asset_url | stylesheet_tag }}

{% render 'theme-type' %}
<style type="text/css">
  .password-logo {
    max-width: {{ settings.desktop_logo_width }}px;
  }
  .password-logo img { display: block; width: 100%; height: auto; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
  assign password_logo = settings.logo | default: settings.mobile_logo
-%}
<header class="password-header color-{{ color_scheme }} gradient flex justify-content-center py-20 px-15">
  <a href="{{ routes.root_url }}" class="password-logo inline-block no-underline heading-color">
    {%- if password_logo != blank -%}
      <img src="{{ password_logo | image_url: width: 600 }}" alt="{{ password_logo.alt | default: shop.name | escape }}" width="{{ password_logo.width | default: 300 }}" height="{{ password_logo.height | default: 100 }}">
    {%- else -%}
      <span class="h3">{{ shop.name }}</span>
    {%- endif -%}
  </a>
</header>
</template>

<schema>
{
  "type": "main-password-header",
  "name": "Password header",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Shows the logo from Theme settings.",
      "default": "scheme-1"
    }
  ],
  "shopify": {
    "name": "t:sections.main-password-header.name",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "info": "Shows the logo from Theme settings.",
        "default": "scheme-1"
      }
    ]
  }
}
</schema>
