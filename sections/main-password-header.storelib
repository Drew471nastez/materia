<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The password page's header: the theme logo, or the store name.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
{%- assign password_logo = settings.logo | default: settings.mobile_logo -%}
<style>
  #shopify-section-{{ sid }} .password-header { display: flex; justify-content: var(--ap-justify, center); padding-inline: 20px; margin: 0; }
  #shopify-section-{{ sid }} .password-logo { display: inline-flex; align-items: center; min-height: 44px; width: min(100%, var(--ap-logo-m, 120px)); color: var(--ap-h-c, var(--color-heading)); text-decoration: none; }
  @media (min-width: 768px) { #shopify-section-{{ sid }} .password-logo { width: min(100%, var(--ap-logo-d, 160px)); } }
  #shopify-section-{{ sid }} .password-logo img { display: block; width: 100%; height: auto; }
  #shopify-section-{{ sid }} .password-logo .ap__h { margin: 0; white-space: nowrap; }
  #shopify-section-{{ sid }} .password-logo:has(> .ap__h:not([hidden])) { width: auto; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign justify = 'center'
  if st.logo_alignment == 'left'
    assign justify = 'flex-start'
  elsif st.logo_alignment == 'right'
    assign justify = 'flex-end'
  endif
-%}
<header
  class="ap password-header color-{{ scheme }} gradient"
  data-ap-root="main-password-header"
  data-ap-section="{{ sid }}"{% if request.design_mode %}
  data-ap-settings="{{ st | json | escape }}"{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-logo-d: {{ st.logo_width | default: 160 }}px; --ap-logo-m: {{ st.logo_width_mobile | default: 120 }}px; --ap-justify: {{ justify }};{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{{ fonts }}"
>
  <a href="{{ routes.root_url }}" class="password-logo">
    {%- if password_logo != blank -%}
      <img src="{{ password_logo | image_url: width: 600 }}" alt="{{ password_logo.alt | default: shop.name | escape }}" width="{{ password_logo.width | default: 300 }}" height="{{ password_logo.height | default: 100 }}" data-ap-show="show_logo"{% unless st.show_logo %} hidden{% endunless %}>
      <span class="ap__h h3" data-ap-hide="show_logo"{% if st.show_logo %} hidden{% endif %}>{{ shop.name }}</span>
    {%- else -%}
      <span class="ap__h h3">{{ shop.name }}</span>
    {%- endif -%}
  </a>
</header>
</template>

<schema>
{
  "type": "main-password-header",
  "name": "Password header",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true,
      "info": "The logo comes from Theme settings > Logo. Without one, the store name shows."
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "logo_alignment",
      "label": "Logo alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Appearance"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Store name color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 20,
      "unit": "px"
    }
  ],
  "shopify": {
    "name": "Password header",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "show_logo",
        "label": "Show logo",
        "default": true,
        "info": "The logo comes from Theme settings > Logo. Without one, the store name shows."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "logo_alignment",
        "label": "Logo alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (desktop)",
        "min": 50,
        "max": 400,
        "step": 10,
        "default": 160,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Store name color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "Logo width (mobile)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 120,
        "step": 2,
        "default": 20,
        "unit": "px"
      }
    ]
  }
}
</schema>