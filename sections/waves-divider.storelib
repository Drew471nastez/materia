<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<div class="ti-section-wrap color-{{ color_scheme }} gradient {{ section.settings.section_width | default: 'container' }}">
{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign wave_height_mobile = section.settings.wave_height_mobile
  assign wave_height = section.settings.wave_height
  assign wave_color = section.settings.wave_color
  assign wave_rotate = section.settings.wave_rotate
  assign wave_variant = section.settings.wave_variant
  assign enable_second_color = section.settings.enable_second_color
  assign wave_color_2 = section.settings.wave_color_2
-%}
{%- capture wave_color -%}{% render 'scheme-color', color: section.settings.wave_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
{%- capture wave_color_2 -%}{% render 'scheme-color', color: section.settings.wave_color_2, fallback: 'var(--color-primary)' %}{%- endcapture -%}
{%- capture border_color -%}{% render 'scheme-color', color: section.settings.border_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
{%- capture background_color -%}{% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %}{%- endcapture -%}

{%- liquid
  case wave_variant
    when 'curve'
      assign wave_path = 'M0,50 C 25,0 75,100 100,50 L100,100 L0,100 Z'
    when 'fan'
      assign wave_path = 'M0,100 L100,0 L100,100 Z'
    when 'curve-opacity'
      assign wave_path = 'M0,60 C 25,10 75,110 100,60 L100,100 L0,100 Z'
    when 'mountains'
      assign wave_path = 'M0,100 L20,40 L40,80 L60,20 L80,70 L100,100 Z'
    when 'curve-asym'
      assign wave_path = 'M0,60 C 15,10 85,90 100,40 L100,100 L0,100 Z'
    when 'curve-asym-alt'
      assign wave_path = 'M0,40 C 15,90 85,10 100,60 L100,100 L0,100 Z'
    when 'tilt'
      assign wave_path = 'M0,0 L100,20 L100,100 L0,100 Z'
    when 'tilt-alt'
      assign wave_path = 'M0,20 L100,0 L100,100 L0,100 Z'
    when 'triangle'
      assign wave_path = 'M0,100 L50,0 L100,100 Z'
    when 'waves'
      assign wave_path = 'M0,50 C 25,40 25,60 50,50 C 75,40 75,60 100,50 L100,100 L0,100 Z'
    when 'waves-opacity'
      assign wave_path = 'M0,50 C 25,30 25,70 50,50 C 75,30 75,70 100,50 L100,100 L0,100 Z'
    when 'waves-opacity2'
      assign wave_path = 'M0,50 C 20,40 40,60 60,50 C 80,40 80,60 100,50 L100,100 L0,100 Z'
    when 'clouds'
      assign wave_path = 'M0,70 C 15,70 15,40 35,40 C 55,40 55,70 75,70 C 95,70 95,40 100,40 L100,100 L0,100 Z'
    when 'speech'
      assign wave_path = 'M0,30 C0,0 100,0 100,30 L100,60 C100,80 80,80 70,90 L60,100 40,80 0,80 Z'
    when 'blob'
      assign wave_path = 'M0,50 C20,30 80,70 100,50 L100,100 L0,100 Z'
    when 'arch'
      assign wave_path = 'M0,50 C10,10 90,10 100,50 L100,100 L0,100 Z'
    when 'arch-alt'
      assign wave_path = 'M0,50 C10,90 90,90 100,50 L100,100 L0,100 Z'
    when 'drops'
      assign wave_path = 'M0,50 C20,20 20,80 50,50 C80,20 80,80 100,50 L100,100 L0,100 Z'
    when 'drops-alt'
      assign wave_path = 'M0,50 C15,25 35,75 50,50 C65,25 85,75 100,50 L100,100 L0,100 Z'
    when 'wave-slope'
      assign wave_path = 'M0,50 C25,10 75,90 100,50 L100,100 L0,100 Z'
    when 'wave-slope-alt'
      assign wave_path = 'M0,50 C25,90 75,10 100,50 L100,100 L0,100 Z'
    when 'slant'
      assign wave_path = 'M0,30 L100,70 L100,100 L0,100 Z'
    when 'slant-alt'
      assign wave_path = 'M0,70 L100,30 L100,100 L0,100 Z'
    when 'peak'
      assign wave_path = 'M0,100 L20,30 L50,0 L80,30 L100,100 Z'
    else
      assign wave_path = 'M0,50 C 25,0 75,100 100,50 L100,100 L0,100 Z'
  endcase
-%}

{%- style -%}
  /* --- Begin Scoped CSS --- */
  /* The styles below use the unique wrapper ID (#waves-divider-{{ section.id }})
     to ensure that they only apply to this instance of the wave divider */
  #waves-divider-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ background_color }} !important;
    {%- if background_gradient != blank %}
    background-image: {{ background_gradient }};
    {%- endif %}
  }

  #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  #waves-divider-{{ section.id }} .wave-item-{{ section.id }} svg {
    color: {{ wave_color }} !important;
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    max-height: {{ wave_height_mobile }}px;
  }

  #waves-divider-{{ section.id }} .wave-parallax2-{{ section.id }} > use {
    opacity: 0.4;
  }
  #waves-divider-{{ section.id }} .wave-parallax3-{{ section.id }} > use {
    opacity: 0.3;
  }
  #waves-divider-{{ section.id }} .wave-parallax4-{{ section.id }} > use {
    opacity: 0.2;
  }

  @media(min-width: 1024px) {
    #waves-divider-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }
    #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }
    #waves-divider-{{ section.id }} .wave-item-{{ section.id }} svg {
      max-height: {{ wave_height }}px;
    }
  }
  /* --- End Scoped CSS --- */
{%- endstyle -%}

{% unless full_width %}
  <style>
    /* --- Begin Scoped CSS for Content Width --- */
    #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem;
    }
    /* --- End Scoped CSS for Content Width --- */
{% comment %}{% endcomment %}  </style>
{% endunless %}

{% if wave_rotate %}
  <style>
    /* --- Begin CSS for Wave Rotation --- */
    #waves-divider-{{ section.id }} .wave-item-{{ section.id }} {
      transform: rotate(180deg);
    }
    /* --- End CSS for Wave Rotation --- */
{% comment %}{% endcomment %}  </style>
{% endif %}

<div id="waves-divider-{{ section.id }}" class="waves-divider-wrapper section-{{ section.id }} wave-{{ section.id }}">
  <div class="section-{{ section.id }}-settings">
    <div class="wave-item-{{ section.id }}">
      <svg class="waves-animated-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs>
          <path id="modern-wave-{{ section.id }}" d="{{ wave_path }}"></path>
        </defs>
        <!-- Wave Layer 1 (always uses primary wave color) -->
        <g class="wave-parallax1-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="0" style="fill: {{ wave_color }}"></use>
        </g>
        <!-- Wave Layer 2 (uses secondary color if enabled) -->
        <g class="wave-parallax2-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="5" style="fill: {% if enable_second_color %}{{ wave_color_2 }}{% else %}{{ wave_color }}{% endif %}"></use>
        </g>
        <!-- Wave Layer 3 (always uses primary wave color) -->
        <g class="wave-parallax3-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="10" style="fill: {{ wave_color }}"></use>
        </g>
        <!-- Wave Layer 4 (uses secondary color if enabled) -->
        <g class="wave-parallax4-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="15" style="fill: {% if enable_second_color %}{{ wave_color_2 }}{% else %}{{ wave_color }}{% endif %}"></use>
        </g>
      </svg>
    </div>
  </div>
</div>

</div>
<!-- ti-theme:end -->



</template>

<schema>
{
  "type": "waves-divider",
  "name": "Waves Divider 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section gap",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Wave"
    },
    {
      "type": "select",
      "id": "wave_variant",
      "label": "Wave style",
      "default": "curve",
      "options": [
        {
          "value": "curve",
          "label": "Smooth Curve"
        },
        {
          "value": "fan",
          "label": "Fan Shape"
        },
        {
          "value": "curve-opacity",
          "label": "Faded Curve"
        },
        {
          "value": "mountains",
          "label": "Mountain Range"
        },
        {
          "value": "curve-asym",
          "label": "Asymmetric Curve"
        },
        {
          "value": "curve-asym-alt",
          "label": "Alternate Asymmetric Curve"
        },
        {
          "value": "tilt",
          "label": "Tilted Edge"
        },
        {
          "value": "tilt-alt",
          "label": "Alternate Tilt"
        },
        {
          "value": "triangle",
          "label": "Triangular"
        },
        {
          "value": "waves",
          "label": "Double Wave"
        },
        {
          "value": "waves-opacity",
          "label": "Faded Double Wave"
        },
        {
          "value": "waves-opacity2",
          "label": "Subtle Double Wave"
        },
        {
          "value": "clouds",
          "label": "Cloudy Wave"
        },
        {
          "value": "speech",
          "label": "Speech Bubble"
        },
        {
          "value": "blob",
          "label": "Blob Shape"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "arch-alt",
          "label": "Alternate Arch"
        },
        {
          "value": "drops",
          "label": "Water Drops"
        },
        {
          "value": "drops-alt",
          "label": "Alternate Drops"
        },
        {
          "value": "wave-slope",
          "label": "Sloped Wave"
        },
        {
          "value": "wave-slope-alt",
          "label": "Alternate Sloped Wave"
        },
        {
          "value": "slant",
          "label": "Slanted Edge"
        },
        {
          "value": "slant-alt",
          "label": "Alternate Slanted Edge"
        },
        {
          "value": "peak",
          "label": "Peak Shape"
        }
      ]
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "checkbox",
      "id": "wave_rotate",
      "label": "Flip wave",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Second color"
    },
    {
      "type": "checkbox",
      "id": "enable_second_color",
      "label": "Use second color",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "label": "Wave color",
      "id": "wave_color"
    },
    {
      "type": "color",
      "label": "Second wave color",
      "id": "wave_color_2",
      "visible_if": "{{ section.settings.enable_second_color }}"
    },
    {
      "type": "color",
      "label": "Background",
      "id": "background_color"
    },
    {
      "type": "color",
      "label": "Border color",
      "id": "border_color"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "rem",
      "label": "Side padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "wave_height",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Wave height",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Top offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Bottom offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "rem",
      "label": "Max content width",
      "default": 120,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Side padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "wave_height_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Wave height",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
