<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Shoppable Video section (modern).
  Clean, swipeable video showcase. Each block is a video card with:
  - Local video upload OR external URL OR poster image only
  - Optional auto-play, loop, muted
  - Optional headline + CTA overlay (top/center/bottom)
  - Optional product tag pulled from a single product picker
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'pagination-styles.css' | asset_url }}" media="print" onload="this.media='all'">
{%- liquid
  assign s = section.settings
  assign section_width = s.section_width | default: 'container'
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign columns = s.columns | default: 4
  assign columns_mobile = s.columns_mobile | default: 1
  assign column_gap = s.column_gap | default: 16
  assign image_ratio = s.image_ratio | default: 'portrait'
  assign custom_ratio = s.custom_ratio
  assign autoplay_videos = s.autoplay_videos
  assign muted = s.muted
  assign loop_videos = s.loop_videos
  assign show_controls = s.show_controls
  assign show_arrow = s.show_arrow
  assign carousel_pagination = s.carousel_pagination | default: 'show_dots'
  assign infinite = s.infinite
  assign autoplay_carousel = s.autoplay_carousel
  assign autorotate_speed = s.autorotate_speed | default: 5
  assign overlay_opacity = s.overlay_opacity | default: 30
  assign reveal = s.reveal
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top }};
  --section-pb: {{ s.padding_bottom }};
  --sv-cols: {{ columns }};
  --sv-cols-mb: {{ columns_mobile }};
  --sv-gap: {{ column_gap }}px;
  --sv-radius: {{ s.card_radius | default: 16 }}px;
  --sv-overlay: {{ overlay_opacity | divided_by: 100.0 }};
  --sv-overlay-color: {{ s.custom_card_overlay_color | default: '#000000' }} !important;
  --sv-cta-bg: {% render 'scheme-color', color: s.custom_cta_bg, fallback: 'var(--btn-primary-bg-color)' %};
  --sv-cta-text: {% render 'scheme-color', color: s.custom_cta_text, fallback: 'var(--btn-primary-color)' %};
  --sv-heading-color: {% render 'scheme-color', color: s.custom_heading_color, fallback: '#ffffff' %} !important;
  --sv-card-padding: {{ s.custom_card_padding | default: 18 }}px;
  --sv-heading-size: {{ s.custom_heading_size | default: 18 }}px;
  {%- if s.custom_section_bg != blank -%}--sv-section-bg: {{ s.custom_section_bg }};{%- endif -%}
  {%- case image_ratio -%}
    {%- when 'square' -%}--sv-ratio: 1/1;
    {%- when 'portrait' -%}--sv-ratio: 3/4;
    {%- when 'tall' -%}--sv-ratio: 9/16;
    {%- when 'landscape' -%}--sv-ratio: 16/9;
    {%- when 'custom' -%}--sv-ratio: {{ custom_ratio | default: '3/4' | replace: ':', '/' }};
    {%- else -%}--sv-ratio: 3/4;
  {%- endcase -%}
{%- endcapture -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sv-card {
    position: relative;
    border-radius: var(--sv-radius);
    overflow: hidden;
    aspect-ratio: var(--sv-ratio);
    background: color-mix(in srgb, var(--color-text) 8%, var(--color-background));
  }
  #shopify-section-{{ section.id }} .sv-card svg.sv-card__placeholder {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    fill: color-mix(in srgb, var(--color-text) 35%, transparent);
  }
  #shopify-section-{{ section.id }} .sv-card--has-media {
    background: #000;
  }
  #shopify-section-{{ section.id }} .sv-card video,
  #shopify-section-{{ section.id }} .sv-card img,
  #shopify-section-{{ section.id }} .sv-card iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    border: 0;
  }
  #shopify-section-{{ section.id }} .sv-card__overlay {
    position: absolute; inset: 0;
    background: color-mix(in srgb, var(--sv-overlay-color) calc(var(--sv-overlay) * 100%), transparent);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .sv-card__content {
    position: absolute; left: 0; right: 0; padding: var(--sv-card-padding);
    color: var(--sv-heading-color);
    pointer-events: none;
    z-index: 2;
    display: flex; flex-direction: column; gap: 8px;
  }
  #shopify-section-{{ section.id }} .sv-card__content--top { top: 0; }
  #shopify-section-{{ section.id }} .sv-card__content--center { top: 50%; transform: translateY(-50%); text-align: center; align-items: center; }
  #shopify-section-{{ section.id }} .sv-card__content--bottom { bottom: 0; }
  #shopify-section-{{ section.id }} .sv-card__heading {
    font-size: var(--sv-heading-size);
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, 600);
    line-height: 1.25;
    margin: 0;
    color: var(--sv-heading-color);
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }
  {%- if s.custom_section_bg != blank -%}
    #shopify-section-{{ section.id }} > .section { background: var(--sv-section-bg) !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .sv-card__cta {
    pointer-events: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--sv-cta-bg);
    color: var(--sv-cta-text);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(0);
    transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .sv-card__cta:hover { transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .sv-card__product { transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease); }
  #shopify-section-{{ section.id }} .sv-card__product:hover { transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sv-card__cta,
    #shopify-section-{{ section.id }} .sv-card__product { transition: none; transform: none; }
  }
  #shopify-section-{{ section.id }} .sv-card__content--center .sv-card__cta { align-self: center; }
  #shopify-section-{{ section.id }} .sv-card__content--bottom .sv-card__cta { align-self: flex-start; }
  #shopify-section-{{ section.id }} .sv-card__product {
    position: absolute;
    left: 14px; bottom: 14px;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 14px 8px 8px;
    background: var(--color-background);
    color: var(--color-heading);
    border-radius: 999px;
    text-decoration: none;
    pointer-events: auto;
    z-index: 3;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    max-width: calc(100% - 28px);
  }
  #shopify-section-{{ section.id }} .sv-card__product img {
    position: static;
    width: 36px; height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .sv-card__product-name {
    font-size: 12px; font-weight: 600; line-height: 1.2; max-width: 16ch;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .sv-card__product-price {
    font-size: 11px; opacity: 0.7;
  }
{%- endstyle -%}

<div
  class="section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if s.heading != blank or s.subheading != blank or s.description != blank -%}
      <div class="section__header text-{{ s.header_alignment | default: 'left' }} mb-30 mb-md-40">
        {%- if s.subheading != blank -%}
          <p class="m-0 mb-5 fs-custom subheading_weight">{{ s.subheading }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="section__header-heading heading-letter-spacing mt-0 mb-10">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <div class="section__header-des rich__text-m0">{{ s.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% if section.blocks.size > 0 %}
      <slide-section
        class="swiper{% if reveal %} reveal_on_scroll{% endif %} lazy-loading-swiper-before"
        data-section-id="{{ section.id }}"
        data-autoplay="{{ autoplay_carousel }}"
        data-effect="slide"
        data-loop="{{ infinite }}"
        data-speed="500"
        data-autoplay-speed="{{ autorotate_speed }}"
        data-spacing="{{ column_gap }}"
        data-mobile="{{ columns_mobile }}"
        data-desktop="{{ columns }}"
        data-tablet="{% if columns > 3 %}3{% else %}{{ columns }}{% endif %}"
        data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' or s.pagination_style == 'progress' %}true{% else %}false{% endif %}"
        data-pagination-style="{{ s.pagination_style | default: 'pill' }}"
      >
        {% if show_arrow %}{%- render 'swiper-navigation' -%}{% endif %}
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign has_media = false -%}
            {%- if b.local_video != blank or b.video_url != blank or b.poster_image != blank -%}
              {%- assign has_media = true -%}
            {%- endif -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="sv-card {% if has_media %}sv-card--has-media{% endif %}">
                {%- if b.local_video != blank -%}
                  {%- liquid
                    assign vid_src = ''
                    for src in b.local_video.sources
                      if src.format == 'mp4'
                        assign vid_src = src.url
                        break
                      endif
                    endfor
                  -%}
                  <video
                    data-sv-video{% if autoplay_videos %} data-sv-autoplay{% endif %}
                    {% if autoplay_videos %}autoplay{% endif %}
                    {% if muted or autoplay_videos %}muted{% endif %}
                    {% if loop_videos %}loop{% endif %}
                    {% if show_controls %}controls{% endif %}
                    playsinline preload="metadata"
                    {% if b.poster_image != blank %}poster="{{ b.poster_image | image_url: width: 800 }}"{% endif %}
                  >
                    <source src="{{ vid_src }}" type="video/mp4">
                  </video>
                {%- elsif b.video_url != blank -%}
                  {%- assign yt_id = b.video_url.id -%}
                  {%- if b.video_url.type == 'youtube' -%}
                    <iframe src="https://www.youtube.com/embed/{{ yt_id }}?{% if autoplay_videos %}autoplay=1&{% endif %}{% if muted or autoplay_videos %}mute=1&{% endif %}{% if loop_videos %}loop=1&playlist={{ yt_id }}&{% endif %}{% unless show_controls %}controls=0&{% endunless %}rel=0&modestbranding=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                  {%- elsif b.video_url.type == 'vimeo' -%}
                    <iframe src="https://player.vimeo.com/video/{{ yt_id }}?{% if autoplay_videos %}autoplay=1&{% endif %}{% if muted or autoplay_videos %}muted=1&{% endif %}{% if loop_videos %}loop=1&{% endif %}{% unless show_controls %}controls=0&{% endunless %}" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                  {%- endif -%}
                {%- elsif b.poster_image != blank -%}
                  <img src="{{ b.poster_image | image_url: width: 800 }}" alt="{{ b.poster_image.alt | escape }}" width="{{ b.poster_image.width }}" height="{{ b.poster_image.height }}" loading="lazy" decoding="async">
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'sv-card__placeholder' }}
                {%- endif -%}

                {%- assign show_overlay = false -%}
                {%- if overlay_opacity > 0 -%}
                  {%- if b.heading != blank or b.cta_label != blank -%}
                    {%- assign show_overlay = true -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if show_overlay -%}
                  <div class="sv-card__overlay"></div>
                {%- endif -%}

                {%- if b.heading != blank or b.cta_label != blank -%}
                  <div class="sv-card__content sv-card__content--{{ b.content_position | default: 'bottom' }}">
                    {%- if b.heading != blank -%}
                      <h3 class="sv-card__heading">{{ b.heading }}</h3>
                    {%- endif -%}
                    {%- if b.cta_label != blank -%}
                      <a class="sv-card__cta" href="{{ b.cta_link | default: '#' }}">
                        {{ b.cta_label }}
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if b.product != blank -%}
                  {%- assign p = b.product -%}
                  <a class="sv-card__product" href="{{ p.url }}" aria-label="Shop {{ p.title | escape }}">
                    {%- if p.featured_image != blank -%}
                      <img src="{{ p.featured_image | image_url: width: 80 }}" alt="{{ p.title | escape }}" loading="lazy">
                    {%- endif -%}
                    <div>
                      <div class="sv-card__product-name">{{ p.title }}</div>
                      <div class="sv-card__product-price">{{ p.price | money }}</div>
                    </div>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' or carousel_pagination == 'show_progress_bar' -%}
          <div
            class="swiper-pagination flex flex-wrap px-15 lh-1 mt-20 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ s.pagination_position | default: 'center' }}"
            style="--swiper-pagination-position: static;"
          ></div>
        {%- endif -%}
      </slide-section>
    {% endif %}
  </div>
</div>
<script>
  (function () {
    var sid = {{ section.id | json }};
    function svInit() {
      var root = document.getElementById('shopify-section-' + sid);
      if (!root) return;
      if (root._svObserver) { root._svObserver.disconnect(); root._svObserver = null; }
      var videos = root.querySelectorAll('video[data-sv-video]');
      if (!videos.length || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            if (v.hasAttribute('data-sv-autoplay')) {
              var pr = v.play();
              if (pr && pr.catch) pr.catch(function () {});
            }
          } else if (!v.paused) {
            v.pause();
          }
        });
      }, { threshold: 0.25 });
      videos.forEach(function (v) { io.observe(v); });
      root._svObserver = io;
    }
    svInit();
    window.__svListen = window.__svListen || {};
    if (!window.__svListen[sid]) {
      window.__svListen[sid] = true;
      document.addEventListener('storelib:section-load', function (e) {
        if (e.detail && e.detail.sectionId && String(e.detail.sectionId) !== String(sid)) return;
        svInit();
      });
    }
  })();
{% comment %}{% endcomment %}</script>

</template>

<schema>
{
  "type": "shopable-video",
  "name": "Shoppable Video",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "right",
