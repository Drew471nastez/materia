<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_save = 'accessibility.save' | t -%}
{%- assign fb_accessibility_product_title = 'accessibility.product_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Materia Themes. Product Spotlight Hero: the picked product beside its
  blocks (Eyebrow, Heading, Subheading, Rating, Price, Description,
  Buttons). Title, picture, price, rating and link come from the product;
  the blocks' own text replaces them. Colours follow the colour scheme until
  Enable custom styling is on, fonts follow Theme settings > Typography until
  Enable custom fonts is on, and the buttons are theme buttons.
  live-products-b.js applies the style and text settings in the builder.
{%- endcomment -%}
{%- liquid
  assign s   = section.settings
  assign sid = section.id
  assign own = s.enable_custom_style
  assign feat = s.product
  assign featured_img = feat.featured_media.preview_image | default: feat.featured_image
  if s.image != blank
    assign featured_img = s.image
  endif
  assign title_fallback = feat.title | default: fb_accessibility_product_title
  # The product's own reviews rating, read like snippets/review.
  assign rating_value = feat.metafields.reviews.rating.value.rating | default: feat.metafields.reviews.rating.value.value | default: feat.metafields.storelib.reviews.value.average | default: feat.metafields.reviews.rating.value | default: feat.rating
  assign rating_count = feat.metafields.reviews.rating_count.value | default: feat.metafields.reviews.rating_count | default: feat.metafields.storelib.reviews.value.count | default: feat.review_count
  assign sticky = true
  if s.enable_sticky_content_on_desktop == false
    assign sticky = false
  endif
  assign variant = feat.selected_or_first_available_variant
-%}
{%- capture pb_json -%}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"image":{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | json }}{% else %}""{% endif %},"placeholder_url":{{ section.settings.placeholder_url | append: '' | json }},"image_position":{{ section.settings.image_position | append: '' | json }},"image_width_pct":{{ section.settings.image_width_pct | default: 0 | json }},"column_valign":{{ section.settings.column_valign | append: '' | json }},"text_align":{{ section.settings.text_align | append: '' | json }},"enable_sticky_content_on_desktop":{% if section.settings.enable_sticky_content_on_desktop %}true{% else %}false{% endif %},"gap_desktop":{{ section.settings.gap_desktop | default: 0 | json }},"text_gap":{{ section.settings.text_gap | default: 0 | json }},"sub_max_width":{{ section.settings.sub_max_width | default: 0 | json }},"desc_max_width":{{ section.settings.desc_max_width | default: 0 | json }},"cta_margin_top":{{ section.settings.cta_margin_top | default: 0 | json }},"image_aspect_desktop":{{ section.settings.image_aspect_desktop | append: '' | json }},"image_radius":{{ section.settings.image_radius | default: 0 | json }},"enable_custom_style":{% if section.settings.enable_custom_style %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"image_bg":{{ section.settings.image_bg | append: '' | json }},"cta_bg":{{ section.settings.cta_bg | append: '' | json }},"cta_color":{{ section.settings.cta_color | append: '' | json }},"cta_bg_hover":{{ section.settings.cta_bg_hover | append: '' | json }},"cta_secondary_color":{{ section.settings.cta_secondary_color | append: '' | json }},"cta_secondary_border":{{ section.settings.cta_secondary_border | append: '' | json }},"cta_secondary_hover_bg":{{ section.settings.cta_secondary_hover_bg | append: '' | json }},"price_compare_color":{{ section.settings.price_compare_color | append: '' | json }},"sale_badge_bg":{{ section.settings.sale_badge_bg | append: '' | json }},"sale_badge_color":{{ section.settings.sale_badge_color | append: '' | json }},"rating_color":{{ section.settings.rating_color | append: '' | json }},"rating_star_color":{{ section.settings.rating_star_color | append: '' | json }},"use_theme_button":{% if section.settings.use_theme_button %}true{% else %}false{% endif %},"cta_size":{{ section.settings.cta_size | default: 0 | json }},"cta_pad_x":{{ section.settings.cta_pad_x | default: 0 | json }},"cta_pad_y":{{ section.settings.cta_pad_y | default: 0 | json }},"cta_radius":{{ section.settings.cta_radius | default: 0 | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"rating_size":{{ section.settings.rating_size | default: 0 | json }},"padding_top":{{ section.settings.padding_top | default: 0 | json }},"padding_bottom":{{ section.settings.padding_bottom | default: 0 | json }},"side_padding_desktop":{{ section.settings.side_padding_desktop | default: 0 | json }},"image_aspect_mobile":{{ section.settings.image_aspect_mobile | append: '' | json }},"gap_mobile":{{ section.settings.gap_mobile | default: 0 | json }},"side_padding_mobile":{{ section.settings.side_padding_mobile | default: 0 | json }}}{%- endcapture -%}
{%- capture psh_vars -%}
  --psh-pt: {{ s.padding_top | default: 0 }}px;--psh-pb: {{ s.padding_bottom | default: 0 }}px;--psh-px-d: {{ s.side_padding_desktop | default: 0 }}px;--psh-px-m: {{ s.side_padding_mobile | default: 0 }}px;
  --psh-gap-d: {{ s.gap_desktop | default: 0 }}px;--psh-gap-m: {{ s.gap_mobile | default: 0 }}px;--psh-dir: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %};--psh-valign: {{ s.column_valign | default: 'center' }};
  --psh-img-w: {{ s.image_width_pct | default: 50 }}%;--psh-ar-d: {{ s.image_aspect_desktop | default: '4 / 5' }};--psh-ar-m: {{ s.image_aspect_mobile | default: '4 / 5' }};--psh-r: {{ s.image_radius | default: 0 }}px;
  --psh-tgap: {{ s.text_gap | default: 14 }}px;--psh-align: {% if s.text_align == 'center' %}center{% elsif s.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};--psh-talign: {{ s.text_align | default: 'left' }};
  --psh-sub-max: {{ s.sub_max_width | default: 560 }}px;--psh-desc-max: {{ s.desc_max_width | default: 560 }}px;--psh-cta-mt: {{ s.cta_margin_top | default: 0 }}px;--psh-rating-fs: {{ s.rating_size | default: 13 }}px;
  {%- if own -%}
    --psh-bg: {% render 'scheme-color', color: s.section_bg, fallback: 'transparent' %};--psh-img-bg: {% render 'scheme-color', color: s.image_bg, fallback: 'color-mix(in srgb, var(--color-heading) 6%, var(--color-background))' %};
    --psh-compare: {% render 'scheme-color', color: s.price_compare_color, fallback: 'color-mix(in srgb, var(--color-text) 55%, transparent)' %};--psh-badge-bg: {% render 'scheme-color', color: s.sale_badge_bg, fallback: 'var(--color-primary)' %};--psh-badge-c: {% render 'scheme-color', color: s.sale_badge_color, fallback: 'var(--btn-primary-color)' %};
    --psh-rating-c: {% render 'scheme-color', color: s.rating_color, fallback: 'var(--color-text)' %};--psh-star: {% render 'scheme-color', color: s.rating_star_color, fallback: 'var(--color-primary)' %};
    {%- if s.cta_bg != blank and s.cta_bg.alpha != 0 -%}--psh-cta-bg: {{ s.cta_bg }};{%- endif -%}
    {%- if s.cta_color != blank and s.cta_color.alpha != 0 -%}--psh-cta-c: {{ s.cta_color }};{%- endif -%}
    {%- if s.cta_bg_hover != blank and s.cta_bg_hover.alpha != 0 -%}--psh-cta-hbg: {{ s.cta_bg_hover }};{%- endif -%}
    {%- if s.cta_secondary_color != blank and s.cta_secondary_color.alpha != 0 -%}--psh-cta2-c: {{ s.cta_secondary_color }};{%- endif -%}
    {%- if s.cta_secondary_border != blank and s.cta_secondary_border.alpha != 0 -%}--psh-cta2-b: {{ s.cta_secondary_border }};{%- endif -%}
    {%- if s.cta_secondary_hover_bg != blank and s.cta_secondary_hover_bg.alpha != 0 -%}--psh-cta2-hbg: {{ s.cta_secondary_hover_bg }};{%- endif -%}
  {%- endif -%}
  {%- if s.use_theme_button == false -%}--mb-radius: {{ s.cta_radius | default: 0 }}px;--mb-padding-x: {{ s.cta_pad_x | default: 0 }}px;--mb-padding-y: {{ s.cta_pad_y | default: 0 }}px;--mb-font-size: {{ s.cta_size | default: 15 }}px;{%- endif -%}
  {%- if s.enable_custom_fonts and s.heading_font.family != blank -%}--heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
  {%- if s.enable_custom_fonts and s.body_font.family != blank -%}--body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endcapture -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #shopify-section-{{ sid }} .psh-root { box-sizing: border-box; font-family: var(--body-font); color: var(--color-text); }
  #shopify-section-{{ sid }} .psh-root[data-width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .psh-root[data-width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .psh-root[data-width='stretch_width'] { padding-inline: 1.5rem; }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .psh-root[data-width='stretch_width'] { padding-inline: 3rem; } }
  #shopify-section-{{ sid }} .psh {
    container-type: inline-size; container-name: psh;
    padding: var(--psh-pt) var(--psh-px-m) var(--psh-pb);
    background: var(--psh-bg, transparent);
  }
  @media (min-width: 760px) { #shopify-section-{{ sid }} .psh { padding-left: var(--psh-px-d); padding-right: var(--psh-px-d); } }
  #shopify-section-{{ sid }} .psh__inner { max-width: var(--page-width, 1300px); margin-inline: auto; display: flex; flex-direction: column; gap: var(--psh-gap-m); }
  #shopify-section-{{ sid }} .psh__media {
    flex: 0 0 100%; width: 100%; min-width: 0; position: relative; overflow: hidden;
    border-radius: var(--psh-r); aspect-ratio: var(--psh-ar-m);
    background: var(--psh-img-bg, color-mix(in srgb, var(--color-heading) 6%, var(--color-background)));
  }
  #shopify-section-{{ sid }} .psh__media img, #shopify-section-{{ sid }} .psh__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .psh__media svg.psh__ph { padding: 22%; box-sizing: border-box; color: color-mix(in srgb, var(--color-text) 30%, var(--color-background)); }
  #shopify-section-{{ sid }} .psh__info {
    flex: 1 1 100%; min-width: 0; display: flex; flex-direction: column;
    gap: var(--psh-tgap); align-items: var(--psh-align); text-align: var(--psh-talign);
  }
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} .psh__inner { flex-direction: var(--psh-dir); gap: var(--psh-gap-d); align-items: var(--psh-valign); }
    #shopify-section-{{ sid }} .psh__media { flex: 0 0 calc(var(--psh-img-w) - var(--psh-gap-d) / 2); max-width: calc(var(--psh-img-w) - var(--psh-gap-d) / 2); aspect-ratio: var(--psh-ar-d); }
    #shopify-section-{{ sid }} .psh__info { flex: 1 1 0; }
  }
  {%- if sticky %}
  /* Sticky media: side by side, the shorter column stays in view under the
     sticky header while the other scrolls (product-page-ui.js lets a column
     taller than the screen scroll to its end first). */
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} [data-mt-sticky] {
      position: sticky;
      top: calc(var(--product-sticky-top, var(--sticky-top, 0px)) + 20px);
      transition: top 420ms cubic-bezier(.22, .61, .36, 1);
    }
    #shopify-section-{{ sid }} [data-mt-sticky].mt-sticky-tall { top: var(--mt-sticky-tall); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} [data-mt-sticky] { transition: none; }
  }
  {%- endif %}
  #shopify-section-{{ sid }} .psh__eyebrow { margin: 0; text-transform: uppercase; letter-spacing: .22em; color: var(--pb-c, var(--color-text)); font-size: var(--pb-fs, 12px); }
  #shopify-section-{{ sid }} .psh__heading { margin: 0; font-weight: var(--heading-weight, 700); line-height: 1.05; color: var(--pb-c, var(--color-heading)); font-size: var(--pb-fs-m, 32px); }
  @container psh (min-width: 760px) { #shopify-section-{{ sid }} .psh__heading { font-size: var(--pb-fs-d, 52px); } }
  #shopify-section-{{ sid }} .psh__sub { margin: 0; line-height: 1.55; max-width: var(--psh-sub-max); color: var(--pb-c, var(--color-text)); font-size: var(--pb-fs, 16px); }
  #shopify-section-{{ sid }} .psh__sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .psh__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .psh__price { margin: 0; font-weight: 600; display: inline-flex; align-items: baseline; gap: 8px; flex-wrap: wrap; color: var(--pb-c, var(--color-primary)); font-size: var(--pb-fs, 22px); }
  #shopify-section-{{ sid }} .psh__price del { color: var(--psh-compare, color-mix(in srgb, var(--color-text) 55%, transparent)); font-weight: 400; }
  #shopify-section-{{ sid }} .psh__price-badge, #shopify-section-{{ sid }} .psh__soldout {
    display: inline-block; padding: 2px 8px; border-radius: 999px;
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em; font-weight: 700;
  }
  #shopify-section-{{ sid }} .psh__price-badge { background: var(--psh-badge-bg, var(--color-primary)); color: var(--psh-badge-c, var(--btn-primary-color)); }
  #shopify-section-{{ sid }} .psh__soldout { border: 1px solid currentColor; color: var(--color-text); }
  #shopify-section-{{ sid }} .psh__skeleton { display: inline-block; width: 6em; height: .9em; border-radius: 4px; background: currentColor; opacity: .15; }
  #shopify-section-{{ sid }} .psh__desc { margin: 0; line-height: 1.55; max-width: var(--psh-desc-max); color: var(--pb-c, var(--color-text)); font-size: var(--pb-fs, 15px); }
  #shopify-section-{{ sid }} .psh__desc p { margin: 0 0 .6em; }
  #shopify-section-{{ sid }} .psh__desc p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .psh__note { margin: 0 0 .6em; padding: 8px 12px; border: 1px dashed currentColor; border-radius: 6px; font-size: 13px; opacity: .7; }
  #shopify-section-{{ sid }} .psh__cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: var(--psh-cta-mt); justify-content: var(--psh-align); }
  #shopify-section-{{ sid }} .psh__cta-row form, #shopify-section-{{ sid }} .psh__cta-row product-form { display: contents; }
  /* Buttons are theme buttons (theme-button-contract.css). The section's
     colours, when custom styling is on, reach them as --mb-* tokens. */
  #shopify-section-{{ sid }} .psh__cta:not(.psh__cta--secondary) { --mb-bg: var(--psh-cta-bg); --mb-border: var(--psh-cta-bg); --mb-text: var(--psh-cta-c); --mb-hover-bg: var(--psh-cta-hbg); --mb-hover-border: var(--psh-cta-hbg); }
  #shopify-section-{{ sid }} .psh__cta--secondary { --mb-text: var(--psh-cta2-c); --mb-border: var(--psh-cta2-b); --mb-hover-bg: var(--psh-cta2-hbg); --mb-hover-border: var(--psh-cta2-b); --mb-hover-text: var(--psh-cta2-c); }
  #shopify-section-{{ sid }} .psh__rating { display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: var(--psh-rating-fs); color: var(--psh-rating-c, var(--color-text)); }
  #shopify-section-{{ sid }} .psh__stars { position: relative; display: inline-block; letter-spacing: .04em; white-space: nowrap; }
  #shopify-section-{{ sid }} .psh__stars-base { color: color-mix(in srgb, var(--psh-star, var(--color-primary)) 30%, transparent); }
  #shopify-section-{{ sid }} .psh__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--psh-star, var(--color-primary)); }
  #shopify-section-{{ sid }} :is(.psh__eyebrow, .psh__heading, .psh__sub, .psh__rating, .psh__price-badge, .psh__desc, .psh__cta)[hidden] { display: none !important; }
{% comment %}{% endcomment %}</style>

{%- if sticky -%}
<script src="{{ 'product-page-ui.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<div class="section psh-root color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}" data-pb-root="featured-product2" data-pb-section="{{ sid }}" data-pb-settings="{{ pb_json | escape }}" data-pb-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","reset_spacing":true,"image_position":"left","image_width_pct":50,"column_valign":"center","text_align":"left","enable_sticky_content_on_desktop":true,"gap_desktop":56,"text_gap":14,"sub_max_width":560,"desc_max_width":560,"cta_margin_top":12,"image_aspect_desktop":"4 / 5","image_radius":20,"enable_custom_style":false,"rating_star_color":"#E2A938","use_theme_button":true,"cta_size":15,"cta_pad_x":24,"cta_pad_y":14,"cta_radius":100,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","rating_size":13,"padding_top":49,"padding_bottom":49,"side_padding_desktop":24,"image_aspect_mobile":"4 / 5","gap_mobile":24,"side_padding_mobile":16}' data-pb-block-defaults='{"eyebrow":{"text":"Spotlight","enable_custom_style":false,"size":12},"heading":{"tag":"h2","enable_custom_style":false,"size_desktop":52,"size_mobile":32},"subheading":{"text":"&lt;p>Add a short introduction here.&lt;/p>","enable_custom_style":false,"size":16},"rating":{"show":true,"reviews_label":"reviews"},"price":{"enable_custom_style":false,"size":22,"show_sale_badge":true,"sale_badge_text":"Save","offer_unit_price_label":"Product price (per item)","selected_offer_total_label":"Selected total"},"description":{"use_product_description":true,"truncate_chars":220,"enable_custom_style":false,"size":15},"buttons":{"primary_action":"link","primary_label":"Shop now"}}' data-pb-title="{{ title_fallback | escape }}" data-pb-name="{{ feat.title | escape }}" data-pb-product-url="{{ feat.url | default: routes.all_products_collection_url | default: '/collections/all' }}" data-width="{{ s.section_width | default: 'full_width' }}" style="{{ psh_vars | strip_newlines | strip }}">
  <div class="psh" data-section-id="{{ sid }}">
    <div class="psh__inner">
      {%- liquid
        # The picture loads first only when the section opens the page.
        assign fp2_priority = 'auto'
        assign fp2_loading = 'lazy'
        if section.index != blank and section.index <= 2
          assign fp2_priority = 'high'
          assign fp2_loading = 'eager'
        endif
      -%}
      {%- assign img_alt = featured_img.alt | default: feat.title | default: '' -%}
      <div class="psh__media"{% if sticky %} data-mt-sticky{% endif %} data-pb-media>
        {%- if featured_img != blank -%}
          {{ featured_img | image_url: width: 1400 | image_tag: fetchpriority: fp2_priority, loading: fp2_loading, alt: img_alt, sizes: '(max-width: 760px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- elsif s.placeholder_url != blank -%}
          <img src="{{ s.placeholder_url }}" alt="" width="1200" height="1500" loading="{{ fp2_loading }}">
        {%- else -%}
          <svg class="psh__ph" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g fill="currentColor"><circle cx="172" cy="124" r="14"/><path d="M140 192l40-46 25 28 20-18 35 36z"/></g></svg>
        {%- endif -%}
      </div>

      <div class="psh__info"{% if sticky %} data-mt-sticky{% endif %}>
        {%- if section.blocks.size == 0 -%}
          {%- comment -%} Legacy instances without blocks: the product's title, price, description and link. {%- endcomment -%}
          <p class="psh__eyebrow">{{ 'accessibility.spotlight' | t }}</p>
          <h2 class="psh__heading">{{ title_fallback | escape }}</h2>
          {%- if feat != blank -%}
            <p class="psh__price">
              {%- if feat.compare_at_price > feat.price -%}<del>{{ feat.compare_at_price | money }}</del>{%- endif -%}
              <span>{{ feat.price | money }}</span>
            </p>
          {%- endif -%}
          <div class="psh__desc">
            {%- if feat != blank and feat.description != blank -%}
              <p>{{ feat.description | strip_html | strip_newlines | truncate: 220 }}</p>
            {%- elsif request.design_mode -%}
              <p class="psh__note">Pick a product with a description, or add a Description block with your own text.</p>
            {%- endif -%}
          </div>
          <div class="psh__cta-row">
            <a class="psh__cta" data-theme-button="primary" data-sl-button href="{{ feat.url | default: routes.all_products_collection_url | default: '/collections/all' }}">{{ 'accessibility.shop_now' | t }}</a>
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- capture pb_bjson -%}{%- case block.type -%}{%- when 'eyebrow' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'heading' -%}{"text":{{ block.settings.text | append: '' | json }},"tag":{{ block.settings.tag | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size_desktop":{{ block.settings.size_desktop | default: 0 | json }},"size_mobile":{{ block.settings.size_mobile | default: 0 | json }}}{%- when 'subheading' -%}{"text":{{ block.settings.text | append: '' | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'rating' -%}{"show":{% if block.settings.show %}true{% else %}false{% endif %},"rating":{{ block.settings.rating | append: '' | json }},"reviews_count":{{ block.settings.reviews_count | append: '' | json }},"reviews_label":{{ block.settings.reviews_label | append: '' | json }}}{%- when 'price' -%}{"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }},"show_sale_badge":{% if block.settings.show_sale_badge %}true{% else %}false{% endif %},"sale_badge_text":{{ block.settings.sale_badge_text | append: '' | json }},"fallback_price":{{ block.settings.fallback_price | append: '' | json }},"offer_unit_price_label":{{ block.settings.offer_unit_price_label | append: '' | json }},"selected_offer_total_label":{{ block.settings.selected_offer_total_label | append: '' | json }}}{%- when 'description' -%}{"text":{{ block.settings.text | append: '' | json }},"use_product_description":{% if block.settings.use_product_description %}true{% else %}false{% endif %},"truncate_chars":{{ block.settings.truncate_chars | default: 0 | json }},"enable_custom_style":{% if block.settings.enable_custom_style %}true{% else %}false{% endif %},"color":{{ block.settings.color | append: '' | json }},"size":{{ block.settings.size | default: 0 | json }}}{%- when 'buttons' -%}{"primary_action":{{ block.settings.primary_action | append: '' | json }},"primary_label":{{ block.settings.primary_label | append: '' | json }},"primary_url":{{ block.settings.primary_url | append: '' | json }},"secondary_label":{{ block.settings.secondary_label | append: '' | json }},"secondary_url":{{ block.settings.secondary_url | append: '' | json }}}{%- else -%}{}{%- endcase -%}{%- endcapture -%}
          {%- capture battrs -%}data-pb-block="{{ block.id }}" data-pb-type="{{ block.type }}" data-pb-settings="{{ pb_bjson | escape }}" {{ block.shopify_attributes }}{%- endcapture -%}
          {%- capture bcolor -%}{%- if bs.enable_custom_style -%}--pb-c: {% if block.type == 'heading' %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% elsif block.type == 'price' %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-primary)' %}{% else %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% endif %};{%- endif -%}{%- endcapture -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <p class="psh__eyebrow" {{ battrs }} style="{{ bcolor }}--pb-fs: {{ bs.size | default: 12 }}px;"{% if bs.text == blank %} hidden{% endif %}>{{ bs.text | escape }}</p>

            {%- when 'heading' -%}
              <h2 class="psh__heading" {{ battrs }} style="{{ bcolor }}--pb-fs-d: {{ bs.size_desktop | default: 52 }}px;--pb-fs-m: {{ bs.size_mobile | default: 32 }}px;">{% if bs.text != blank %}{{ bs.text }}{% else %}{{ title_fallback | escape }}{% endif %}</h2>

            {%- when 'subheading' -%}
              <div class="psh__sub" {{ battrs }} style="{{ bcolor }}--pb-fs: {{ bs.size | default: 16 }}px;"{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>

            {%- when 'rating' -%}
              {%- liquid
                assign r_value = rating_value | default: bs.rating
                assign r_count = rating_count | default: bs.reviews_count
                assign r_pct = r_value | plus: 0 | times: 20
                if r_pct > 100
                  assign r_pct = 100
                endif
              -%}
              <p class="psh__rating" {{ battrs }} data-pb-own-rating="{% if rating_value != blank %}false{% else %}true{% endif %}"{% if bs.show == false or r_value == blank %} hidden{% endif %}>
                <span class="psh__stars" role="img" aria-label="{{ r_value }} / 5" data-pb-stars><span class="psh__stars-base" aria-hidden="true">★★★★★</span><span class="psh__stars-fill" aria-hidden="true" style="width: {{ r_pct }}%;">★★★★★</span></span>
                <span data-pb-rating-text>{{ r_value }}{% if r_count != blank %} · {{ r_count }} {{ bs.reviews_label | default: 'reviews' | escape }}{% endif %}</span>
              </p>


            {%- when 'price' -%}
              <p class="psh__price" {{ battrs }} style="{{ bcolor }}--pb-fs: {{ bs.size | default: 22 }}px;">
                {%- if feat != blank -%}
                  {%- if feat.compare_at_price > feat.price -%}<del>{{ feat.compare_at_price | money }}</del>{%- endif -%}
                  <span>{{ feat.price | money }}</span>
                  {%- if feat.compare_at_price > feat.price -%}
                    {%- assign discount = feat.compare_at_price | minus: feat.price | times: 100 | divided_by: feat.compare_at_price -%}
                    <span class="psh__price-badge" data-pb-badge data-pct="{{ discount | round }}" data-save="{{ fb_accessibility_save | escape }}"{% unless bs.show_sale_badge %} hidden{% endunless %}>{{ bs.sale_badge_text | default: fb_accessibility_save | escape }} {{ discount | round }}%</span>
                  {%- endif -%}
                  {%- unless feat.available -%}<span class="psh__soldout">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
                {%- elsif request.design_mode -%}
                  <span class="psh__skeleton" aria-hidden="true"></span>
                {%- endif -%}
              </p>

            {%- when 'description' -%}
              <div class="psh__desc" {{ battrs }} style="{{ bcolor }}--pb-fs: {{ bs.size | default: 15 }}px;">
                {%- if bs.text != blank -%}
                  {{ bs.text }}
                {%- elsif feat != blank and feat.description != blank and bs.use_product_description -%}
                  {%- assign fp2_len = bs.truncate_chars | default: 220 | plus: 0 -%}
                  {%- liquid
              assign fp2_desc = feat.description | replace: '</p>', ' </p>' | replace: '<br', ' <br' | replace: '</li>', ' </li>' | strip_html | strip_newlines | replace: '&nbsp;', ' ' | strip
              if fp2_desc.size > fp2_len
                assign fp2_cut = fp2_desc | truncate: fp2_len, ''
                assign fp2_words = fp2_cut | split: ' '
                if fp2_words.size > 1
                  assign fp2_cut = ''
                  for fp2_word in fp2_words
                    unless forloop.last
                      assign fp2_cut = fp2_cut | append: fp2_word | append: ' '
                    endunless
                  endfor
                endif
                assign fp2_desc = fp2_cut | strip | append: '…'
              endif
            -%}<p>{{ fp2_desc }}</p>
                {%- elsif request.design_mode -%}
                  <p class="psh__note">Write a description here, or pick a product that has one and turn on Use the product description.</p>
                {%- endif -%}
              </div>

            {%- when 'buttons' -%}
              <div class="psh__cta-row" {{ battrs }}>
                {%- if bs.primary_action == 'add_to_cart' and feat != blank -%}
                  {%- assign psh_form_id = 'psh-form-' | append: sid -%}
                  <product-form class="psh__form">
                    {%- form 'product', feat, id: psh_form_id, class: 'psh__form-el', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ variant.id }}">
                      <button type="submit" name="add" class="psh__cta product__add-cart" data-theme-button="primary" data-sl-button data-pb-primary aria-live="polite"{% if variant.available == false %} disabled{% endif %}{% if bs.primary_label == blank %} hidden{% endif %}>
                        <span class="btn-action" data-pb-label>{% if variant.available == false %}{{ 'products.product.sold_out' | t }}{% else %}{{ bs.primary_label | escape }}{% endif %}</span>
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- else -%}
                  <a class="psh__cta" data-theme-button="primary" data-sl-button data-pb-primary href="{% if bs.primary_url != blank %}{{ bs.primary_url | url }}{% else %}{{ feat.url | default: routes.all_products_collection_url | default: '/collections/all' }}{% endif %}"{% if bs.primary_label == blank %} hidden{% endif %}><span data-pb-label>{{ bs.primary_label | escape }}</span></a>
                {%- endif -%}
                <a class="psh__cta psh__cta--secondary" data-theme-button="secondary" data-sl-button data-pb-secondary href="{% if bs.secondary_url != blank %}{{ bs.secondary_url | url }}{% else %}{{ feat.url | default: routes.all_products_collection_url | default: '/collections/all' }}{% endif %}"{% if bs.secondary_label == blank %} hidden{% endif %}>{{ bs.secondary_label | escape }}</a>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "featured-product2",
  "name": "Product Spotlight Hero",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
