          "id": "text",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Heading tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 20,
          "max": 96,
          "step": 1,
          "unit": "px",
          "default": 52
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 18,
          "max": 64,
          "step": 1,
          "unit": "px",
          "default": 32
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading text",
          "default": "<p>Add a short introduction here.</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 12,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 16
        }
      ],
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "settings": [
        {
          "type": "checkbox",
          "id": "show",
          "label": "Show rating",
          "default": true
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating value",
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "reviews_count",
          "label": "Reviews count",
          "default": "128"
        },
        {
          "type": "text",
          "id": "reviews_label",
          "label": "Reviews label",
          "default": "reviews"
        }
      ],
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "settings": [
        {
          "type": "color",
          "id": "color",
          "label": "Price color"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Price size",
          "min": 14,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 22
        },
        {
          "type": "checkbox",
          "id": "show_sale_badge",
          "label": "Show sale badge when on sale",
          "default": true
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale badge text",
          "default": "Save"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback price"
        },
        {
          "type": "text",
          "id": "offer_unit_price_label",
          "label": "Product price label",
          "default": "Product price (per item)",
          "info": "Legacy label, kept only to preserve saved settings. Offer totals belong to the offer block, not the product price.",
          "visible_if": "{{ false }}"
        },
        {
          "type": "text",
          "id": "selected_offer_total_label",
          "label": "Selected offer total label",
          "default": "Selected total",
          "info": "Legacy label, kept only to preserve saved settings. Offer totals belong to the offer block, not the product price.",
          "visible_if": "{{ false }}"
        }
      ],
      "limit": 1
    },
