          "id": "size",
          "label": "Size",
          "min": 10,
          "max": 16,
          "step": 1,
          "unit": "px",
          "default": 12
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
