<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_save = 'accessibility.save' | t -%}
{%- assign fb_accessibility_product_title = 'accessibility.product_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Product Spotlight Hero (rebuilt)

  A modern hero-style featured product section. Two-column layout on
  desktop (image / info), stacked on mobile.

  Text-column blocks:
    Eyebrow / Heading / Subheading / Rating / Price / Description / Buttons

  Section settings cover layout, image, colors, spacing, and a small
  set of behavioural toggles. All blocks are reorderable.
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign feat = s.product
  assign featured_img = feat.featured_image
  if s.image != blank
    assign featured_img = s.image
  endif
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>

<style>
  {%- if s.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }

  #shopify-section-{{ sid }} .psh {
    container-type: inline-size;
    container-name: psh;
    padding: {{ s.padding_top | default: 49 }}px {{ s.side_padding_desktop | default: 24 }}px {{ s.padding_bottom | default: 49 }}px;
    background: {% render 'scheme-color', color: s.section_bg, fallback: 'transparent' %};
  }
  @container psh (max-width: 760px) {
    #shopify-section-{{ sid }} .psh {
      padding-left: {{ s.side_padding_mobile | default: 16 }}px;
      padding-right: {{ s.side_padding_mobile | default: 16 }}px;
    }
  }

  #shopify-section-{{ sid }} .psh__inner {
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: {{ s.gap_mobile | default: 24 }}px;
  }
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} .psh__inner {
      flex-direction: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 56 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .psh__inner {
      flex-direction: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %};
      gap: {{ s.gap_desktop | default: 56 }}px;
      align-items: {{ s.column_valign | default: 'center' }};
    }
  }

  /* Image column */
  #shopify-section-{{ sid }} .psh__media {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
    border-radius: {{ s.image_radius | default: 20 }}px;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'rgba(var(--color-heading-rgb), 0.06)' %};
    aspect-ratio: {{ s.image_aspect_mobile | default: '4 / 5' }};
    position: relative;
  }
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} .psh__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 56 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 56 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .psh__media {
      flex: 0 0 calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 56 | divided_by: 2 }}px);
      max-width: calc({{ s.image_width_pct | default: 50 }}% - {{ s.gap_desktop | default: 56 | divided_by: 2 }}px);
      aspect-ratio: {{ s.image_aspect_desktop | default: '4 / 5' }};
    }
  }
  #shopify-section-{{ sid }} .psh__media img,
  #shopify-section-{{ sid }} .psh__media svg {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Info column */
  #shopify-section-{{ sid }} .psh__info {
    flex: 1 1 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: {{ s.text_gap | default: 14 }}px;
    align-items: {% if s.text_align == 'center' %}center{% elsif s.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    text-align: {{ s.text_align | default: 'left' }};
  }
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} .psh__info { flex: 1 1 0; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .psh__info { flex: 1 1 0; }
  }
  {%- if s.enable_sticky_content_on_desktop != false %}
  /* Sticky media: side by side, the shorter column stays in view under the
     sticky header while the other scrolls (product-page-ui.js lets a column
     taller than the screen scroll to its end first). */
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} [data-mt-sticky] {
      position: sticky;
      top: calc(var(--product-sticky-top, var(--sticky-top, 0px)) + 20px);
      transition: top 420ms cubic-bezier(.22, .61, .36, 1);
    }
    #shopify-section-{{ sid }} [data-mt-sticky].mt-sticky-tall { top: var(--mt-sticky-tall); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} [data-mt-sticky] { transition: none; }
  }
  {%- endif %}

  #shopify-section-{{ sid }} .psh__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }
  #shopify-section-{{ sid }} .psh__heading {
    margin: 0;
    font-weight: var(--heading-weight, 700);
    line-height: 1.05;
  }
  @container psh (min-width: 760px) {
    #shopify-section-{{ sid }} .psh__heading[style*="--psh-h-d"] { font-size: var(--psh-h-d) !important; }
  }
  #shopify-section-{{ sid }} .psh__sub {
    margin: 0;
    line-height: 1.55;
    max-width: {{ s.sub_max_width | default: 560 }}px;
  }
  #shopify-section-{{ sid }} .psh__sub p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .psh__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .psh__price {
    margin: 0;
    font-weight: 600;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  #shopify-section-{{ sid }} .psh__price del {
    color: {% render 'scheme-color', color: s.price_compare_color, fallback: 'rgba(var(--color-text-rgb), 0.55)' %};
    font-weight: 400;
  }
  #shopify-section-{{ sid }} .psh__price-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: {% render 'scheme-color', color: s.sale_badge_bg, fallback: 'var(--color-primary)' %};
    color: {% render 'scheme-color', color: s.sale_badge_color, fallback: 'var(--btn-primary-color)' %};
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }
  #shopify-section-{{ sid }} .psh__desc {
    margin: 0;
    line-height: 1.55;
    max-width: {{ s.desc_max_width | default: 560 }}px;
  }
  #shopify-section-{{ sid }} .psh__desc p { margin: 0 0 0.6em; }
  #shopify-section-{{ sid }} .psh__note { margin: 0 0 0.6em; padding: 8px 12px; border: 1px dashed currentColor; border-radius: 6px; font-size: 13px; opacity: .7; }
  #shopify-section-{{ sid }} .psh__desc p:last-child { margin: 0; }

  #shopify-section-{{ sid }} .psh__cta-row {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-top: {{ s.cta_margin_top | default: 12 }}px;
  }
  #shopify-section-{{ sid }} .psh__cta {
    --mb-bg: {% render 'scheme-color', color: s.cta_bg, fallback: 'var(--btn-primary-bg-color)' %};
    --mb-text: {% render 'scheme-color', color: s.cta_color, fallback: 'var(--btn-primary-color)' %};
    --mb-hover-bg: {% render 'scheme-color', color: s.cta_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    {%- if s.use_theme_button != false -%}
    padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 24px);
    border-radius: var(--btn-radius, 999px);
    font-weight: var(--btn-font-weight, 600);
    font-size: var(--btn-font-size, 15px);
    {%- else -%}
    padding: {{ s.cta_pad_y | default: 14 }}px {{ s.cta_pad_x | default: 24 }}px;
    --mb-padding-y: {{ s.cta_pad_y | default: 14 }}px; --mb-padding-x: {{ s.cta_pad_x | default: 24 }}px;
    --mb-radius: {{ s.cta_radius | default: 999 }}px; --mb-font-size: {{ s.cta_size | default: 15 }}px;
    border-radius: {{ s.cta_radius | default: 999 }}px;
    font-weight: 600;
    font-size: {{ s.cta_size | default: 15 }}px;
    {%- endif -%}
    background: {% render 'scheme-color', color: s.cta_bg, fallback: 'var(--btn-primary-bg-color)' %};
    color: {% render 'scheme-color', color: s.cta_color, fallback: 'var(--btn-primary-color)' %};
    text-decoration: none;
    transition: transform 0.18s ease, background 0.18s ease;
    border: 0;
    cursor: pointer;
  }
  #shopify-section-{{ sid }} .psh__cta:hover {
    background: {% render 'scheme-color', color: s.cta_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
    {%- if s.cta_color == blank or s.cta_color.alpha == 0 %} color: var(--btn-primary-hover-color);{% endif %}
    transform: translateY(-1px);
  }
  #shopify-section-{{ sid }} .psh__cta--secondary {
    --mb-bg: transparent;
    --mb-text: {% render 'scheme-color', color: s.cta_secondary_color, fallback: 'var(--btn-secondary-color)' %};
    --mb-border: {% render 'scheme-color', color: s.cta_secondary_border, fallback: 'var(--btn-secondary-border-color)' %};
    --mb-hover-bg: {% render 'scheme-color', color: s.cta_secondary_hover_bg, fallback: 'var(--btn-secondary-hover-bg-color)' %};
    background: transparent;
    color: {% render 'scheme-color', color: s.cta_secondary_color, fallback: 'var(--btn-secondary-color)' %};
    border: {% if s.use_theme_button != false %}var(--btn-border-width, 1.5px){% else %}1.5px{% endif %} solid {% render 'scheme-color', color: s.cta_secondary_border, fallback: 'var(--btn-secondary-border-color)' %};
  }
  #shopify-section-{{ sid }} .psh__cta--secondary:hover {
    background: {% render 'scheme-color', color: s.cta_secondary_hover_bg, fallback: 'rgba(var(--color-heading-rgb), 0.06)' %};
    color: {% render 'scheme-color', color: s.cta_secondary_color, fallback: 'var(--btn-secondary-color)' %};
  }

  #shopify-section-{{ sid }} .psh__rating {
    display: inline-flex; align-items: center; gap: 6px;
    margin: 0;
    font-size: {{ s.rating_size | default: 13 }}px;
    color: {% render 'scheme-color', color: s.rating_color, fallback: 'rgba(var(--color-text-rgb), 0.8)' %};
  }
  #shopify-section-{{ sid }} .psh__rating-stars {
    color: {% render 'scheme-color', color: s.rating_star_color, fallback: '#E2A938' %};
    letter-spacing: 0.04em;
  }
{% comment %}{% endcomment %}</style>

{%- if s.enable_sticky_content_on_desktop != false -%}
<script src="{{ 'product-page-ui.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<div class="section color-{{ color_scheme }} gradient{{ reset_spacing }}">
  <div class="psh" data-section-id="{{ sid }}">
    <div class="psh__inner">

      {%- liquid
        # The picture loads first only when the section opens the page.
        assign fp2_priority = 'auto'
        assign fp2_loading = 'lazy'
        if section.index != blank and section.index <= 2
          assign fp2_priority = 'high'
          assign fp2_loading = 'eager'
        endif
      -%}
      {%- assign placeholder_src = s.placeholder_url | default: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' -%}
      <div class="psh__media"{% if s.enable_sticky_content_on_desktop != false %} data-mt-sticky{% endif %}>
        {%- if featured_img != blank -%}
          {{ featured_img | image_url: width: 1400 | image_tag: fetchpriority: fp2_priority, loading: fp2_loading, alt: feat.title, sizes: '(max-width: 760px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- else -%}
          <img src="{{ placeholder_src }}" alt="" width="1200" height="1500">
        {%- endif -%}
      </div>

      <div class="psh__info"{% if s.enable_sticky_content_on_desktop != false %} data-mt-sticky{% endif %}>
        {%- if section.blocks.size == 0 -%}
          {%- comment -%} Fallback for legacy instances without blocks configured. Renders even if no product is set. {%- endcomment -%}
          <p class="psh__eyebrow" style="color: var(--color-text); font-size: 12px;">{{ 'accessibility.spotlight' | t }}</p>
          <h2 class="psh__heading" style="font-size: 32px; color: var(--color-heading);">{{ feat.title | default: fb_accessibility_product_title | escape }}</h2>
          <p class="psh__price" style="font-size: 22px; color: var(--color-heading);">
            {%- if feat != blank -%}
              {%- if feat.compare_at_price > feat.price -%}<del>{{ feat.compare_at_price | money }}</del>{%- endif -%}
              <span>{{ feat.price | money }}</span>
            {%- else -%}
              <span>$0.00</span>
            {%- endif -%}
          </p>
          <div class="psh__desc" style="font-size: 15px; color: var(--color-text);">
            {%- if feat != blank and feat.description != blank -%}
              {%- assign fp2_len = 220 -%}
              {%- liquid
              assign fp2_desc = feat.description | replace: '</p>', ' </p>' | replace: '<br', ' <br' | replace: '</li>', ' </li>' | strip_html | strip_newlines | replace: '&nbsp;', ' ' | strip
              if fp2_desc.size > fp2_len
                assign fp2_cut = fp2_desc | truncate: fp2_len, ''
                assign fp2_words = fp2_cut | split: ' '
                if fp2_words.size > 1
                  assign fp2_cut = ''
                  for fp2_word in fp2_words
                    unless forloop.last
                      assign fp2_cut = fp2_cut | append: fp2_word | append: ' '
                    endunless
                  endfor
                endif
                assign fp2_desc = fp2_cut | strip | append: '…'
              endif
            -%}<p>{{ fp2_desc }}</p>
            {%- elsif request.design_mode -%}
              <p class="psh__note">Pick a product with a description, or add a Description block with your own text.</p>
            {%- endif -%}
          </div>
          <div class="psh__cta-row">
            <a class="psh__cta" data-theme-button="primary" data-sl-button href="{{ feat.url | default: '#' }}">{{ 'accessibility.shop_now' | t }}</a>
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="psh__eyebrow"
                   style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}; font-size: {{ bs.size | default: 12 }}px;"
                   {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- assign h_text = bs.text | default: feat.title | default: fb_accessibility_product_title -%}
              <{{ bs.tag | default: 'h2' }} class="psh__heading"
                style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}; font-size: {{ bs.size_mobile | default: 32 }}px; --psh-h-d: {{ bs.size_desktop | default: 52 }}px;"
                {{ block.shopify_attributes }}>{{ h_text | escape }}</{{ bs.tag | default: 'h2' }}>

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="psh__sub"
                     style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}; font-size: {{ bs.size | default: 16 }}px;"
                     {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- else -%}
                {%- render 'editor-block-preview', block: block, title: 'Subheading', message: 'Add a short introduction in this block.' -%}
              {%- endif -%}

            {%- when 'rating' -%}
              {%- if bs.show -%}
                <p class="psh__rating" {{ block.shopify_attributes }}>
                  <span class="psh__rating-stars" aria-hidden="true">★★★★★</span>
                  <span>{{ bs.rating | default: '4.8' }} · {{ bs.reviews_count | default: '128' }} {{ bs.reviews_label | default: 'reviews' | escape }}</span>
                </p>
              {%- endif -%}

            {%- when 'price' -%}
              <p class="psh__price"
                 style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-primary)' %}; font-size: {{ bs.size | default: 22 }}px;"
                 {{ block.shopify_attributes }}>
                {%- if feat != blank -%}
                  {%- if feat.compare_at_price > feat.price -%}<del>{{ feat.compare_at_price | money }}</del>{%- endif -%}
                  <span>{{ feat.price | money }}</span>
                  {%- if feat.compare_at_price > feat.price and bs.show_sale_badge -%}
                    {%- assign discount = feat.compare_at_price | minus: feat.price | times: 100 | divided_by: feat.compare_at_price -%}
                    <span class="psh__price-badge">{{ bs.sale_badge_text | default: fb_accessibility_save | escape }} {{ discount | round }}%</span>
                  {%- endif -%}
                {%- else -%}
                  <span>{{ bs.fallback_price | default: '$0.00' | escape }}</span>
                {%- endif -%}
              </p>

            {%- when 'description' -%}
              <div class="psh__desc"
                   style="color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}; font-size: {{ bs.size | default: 15 }}px;"
                   {{ block.shopify_attributes }}>
                {%- if bs.text != blank -%}
                  {{ bs.text }}
                {%- elsif feat != blank and feat.description != blank and bs.use_product_description -%}
                  {%- assign fp2_len = bs.truncate_chars | default: 220 | plus: 0 -%}
                  {%- liquid
              assign fp2_desc = feat.description | replace: '</p>', ' </p>' | replace: '<br', ' <br' | replace: '</li>', ' </li>' | strip_html | strip_newlines | replace: '&nbsp;', ' ' | strip
              if fp2_desc.size > fp2_len
                assign fp2_cut = fp2_desc | truncate: fp2_len, ''
                assign fp2_words = fp2_cut | split: ' '
                if fp2_words.size > 1
                  assign fp2_cut = ''
                  for fp2_word in fp2_words
                    unless forloop.last
                      assign fp2_cut = fp2_cut | append: fp2_word | append: ' '
                    endunless
                  endfor
                endif
                assign fp2_desc = fp2_cut | strip | append: '…'
              endif
            -%}<p>{{ fp2_desc }}</p>
                {%- elsif request.design_mode -%}
                  <p class="psh__note">Write a description here, or pick a product that has one and turn on Fallback to product description.</p>
                {%- endif -%}
              </div>

            {%- when 'buttons' -%}
              <div class="psh__cta-row" {{ block.shopify_attributes }}>
                {%- if bs.primary_label != blank -%}
                  <a class="psh__cta" data-theme-button="primary" data-sl-button href="{{ bs.primary_url | default: feat.url | default: '#' }}">
                    {{ bs.primary_label | escape }}
                  </a>
                {%- endif -%}
                {%- if bs.secondary_label != blank -%}
                  <a class="psh__cta psh__cta--secondary" data-theme-button="secondary" data-sl-button href="{{ bs.secondary_url | default: '#' }}">
                    {{ bs.secondary_label | escape }}
                  </a>
                {%- endif -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "featured-product2",
  "name": "Product Spotlight Hero",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
