      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content_on_desktop",
      "label": "Sticky media",
      "default": true,
      "info": "On a computer, the shorter column stays in view while the other one scrolls."
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
