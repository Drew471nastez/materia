    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Typography"
    },
    {
      "type": "checkbox",
