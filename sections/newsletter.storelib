            "label": "Font",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "400",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              {
                "value": "300",
                "label": "300"
              },
              {
                "value": "400",
                "label": "400"
              },
              {
                "value": "500",
                "label": "500"
              },
              {
                "value": "600",
                "label": "600"
              },
              {
                "value": "700",
                "label": "700"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "default": false
          },
          {
            "type": "range",
            "id": "size",
            "label": "Size",
            "min": 12,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 16,
            "visible_if": "{{ block.settings.size_enable }}"
          },
          {
            "type": "range",
            "id": "line_height",
            "label": "Line height",
            "min": 1,
            "max": 2,
            "step": 0.05,
            "default": 1.5,
            "visible_if": "{{ block.settings.size_enable }}"
          }
        ]
      }
    ]
  }
}
</schema>
