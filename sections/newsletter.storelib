<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
  /* Form fields follow Theme settings > Forms and fields */
  #shopify-section-{{ section.id }} .subscribe-form .subcribe-input {
    min-height: var(--input-height, 50px);
    padding: var(--input-padding, 1rem 16px);
    border: var(--inputs-border-width, 1px) solid var(--color-border);
    border-radius: var(--input-border-radius, 4px);
    background-color: var(--input-bg, var(--color-background));
    color: var(--input-color, var(--color-text));
    font-size: var(--input-font-size, 16px);
    box-sizing: border-box;
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .subscribe-form .subcribe-input::placeholder { color: var(--input-placeholder-color, currentColor); opacity: 1; }
  #shopify-section-{{ section.id }} .subscribe-form .subcribe-input:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .subscribe-form .subcribe-button { min-height: var(--input-height, 50px); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .subscribe-form .subcribe-input { transition: none; }
  }
  /* Newsletter icon */
  #shopify-section-{{ section.id }} .newsletter-icon { line-height: 0; }
  #shopify-section-{{ section.id }} .newsletter-icon svg { display: block; }
  #shopify-section-{{ section.id }} .newsletter-icon img { display: block; height: auto; }
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
<style>
  /* Theme editor: force popup-style sections (fixed/centered) to render inline so a preview shows */
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="-popup"],
  .shopify-design-mode #shopify-section-{{ section.id }} .popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .modal,
  .shopify-design-mode #shopify-section-{{ section.id }} [data-popup],
  .shopify-design-mode #shopify-section-{{ section.id }} > .promotional,
  .shopify-design-mode #shopify-section-{{ section.id }} .age-verifier-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotion-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promobanner,
  .shopify-design-mode #shopify-section-{{ section.id }} .newsletter-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promo-newsletter-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotional-image-popup,
  .shopify-design-mode #shopify-section-{{ section.id }} .promotional-popup {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    display: block !important;
    margin: 20px auto !important;
    z-index: auto !important;
    pointer-events: auto !important;
  }
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="overlay"],
  .shopify-design-mode #shopify-section-{{ section.id }} *[class*="backdrop"] {
    display: none !important;
  }
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'banner.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme | default: 'default-color-scheme'
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign heading = section_st.heading
  assign description = section_st.description
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
  assign header_alignment = section_st.header_alignment
  assign form_layout = section_st.form_layout
  assign scroll_animation = settings.scroll_animation | default: 'none'
  if section_st.reveal == false
    assign scroll_animation = 'none'
  endif
  assign icon_size = section_st.icon_size | default: 40
  assign has_header = false
  if heading != blank or description != blank or section_st.show_icon
    assign has_header = true
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--max-width: 60rem;
{%- endcapture -%}
{% if form_layout == 'horizontal' %}
  {% style %}
    @media screen and (min-width: 768px) {
      #shopify-section-{{ section.id }} .sec__newsletter .section__header {
        flex: 0 0 30%;
      }
      #shopify-section-{{ section.id }} .sec_newsletter_note {
        width: 83%;
      }
    }
  {% endstyle %}
{% endif %}
<div class="{{ section_width }}">
  <div
    class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__newsletter color-{{ color_scheme }} gradient{{ reset_spacing }}{% if section_st.background_image != blank %} bg-transparent relative{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    {%- if section_st.background_image != blank -%}
      {%- assign image_alt = section_st.background_image.alt | default: 'product_image' | escape -%}
      {% render 'responsive-image',
        type: 'banner',
        image: section_st.background_image,
        image_alt: image_alt,
        class: 'absolute inset-0 z--1 pointer-none w-full h-full object-position-center object-fit-cover'
      %}
      {%- comment -%} Background overlay — same negative z as the image but later in
        the DOM, so it sits over the image and under the content. {%- endcomment -%}
      {%- if section_st.bg_overlay_opacity > 0 -%}
        <div
          class="absolute inset-0 z--1 pointer-none"
          style="background: {{ section_st.bg_overlay_color | default: '#000000' }}; opacity: {{ section_st.bg_overlay_opacity | divided_by: 100.0 }};"
        ></div>
      {%- endif -%}
    {% endif %}

    <div class="sec__inner flex justify-content-center px-30">
      <div
        class="flex flex-wrap justify-content-center{% if form_layout != 'horizontal' %} flex-column{% else %} flex-md-nowrap gap-30{% endif %}{% if section_st.show_content_background %} content-box relative p-30 p-1025-50{% endif %}"
        style="{% if section_st.show_content_background %}--content-bg: {% render 'scheme-color', color: section_st.content_background, fallback: 'var(--color-background)' %}; --opacity:{{ section_st.content_box_opacity }}%;{% endif %}"
      >
        {%- if has_header -%}
          <div class="section__header text-{{ section_st.header_alignment }}{% if form_layout != 'horizontal' %} mb-30{% if section_st.section_width == 'full_width' %} px-20{% endif %}{% endif %}">
            {%- comment -%} Optional icon above the text {%- endcomment -%}
            {%- if section_st.show_icon -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="0"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="newsletter-icon mb-15 flex justify-content-{{ header_alignment }}{% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
                style="{% if scroll_animation != 'none' %}--animation-order: 0;{% endif %}color: {% render 'scheme-color', color: section_st.icon_color, fallback: 'var(--color-heading)' %};"
              >
                {%- if section_st.custom_icon_image != blank -%}
                  <img
                    src="{{ section_st.custom_icon_image | image_url: width: 240 }}"
                    alt=""
                    width="{{ icon_size }}"
                    height="{{ icon_size }}"
                    loading="lazy"
                    style="width: {{ icon_size }}px;"
                  >
                {%- else -%}
                  {%- case section_st.icon -%}
                    {%- when 'paper_plane' -%}
                      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
                    {%- when 'bell' -%}
                      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    {%- when 'gift' -%}
                      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
                    {%- when 'sparkles' -%}
                      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6.3 6.3 2.4 2.4M15.3 15.3l2.4 2.4M17.7 6.3l-2.4 2.4M8.7 15.3l-2.4 2.4"/></svg>
                    {%- else -%}
                      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </motion-element>
            {%- endif -%}
            {%- if section_st.heading != blank -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="50"         
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="block  {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
                style="
                {%- if scroll_animation != 'none' -%}
                  --animation-order: 0;
                {% endif %}
              "
              >
              <h2
                class="section__header-heading heading-letter-spacing  {{ header_size  }} mt-0{% if section_st.description != blank %} mb-10{% else %} mb-0{% endif %}"
              >
                {{ section_st.heading }}
              </h2>
            </motion-element>
            {% endif %}
            {%- if section_st.description != blank -%}
              <motion-element
                data-motion="fade-up-lg"
                data-motion-delay="150"
                {% if scroll_animation != 'slide_in' %}
                  hold
                {% endif %}
                class="section__header-des block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %} rich__text-m0"
                style="
                  {%- if scroll_animation != 'none' -%}
                    --animation-order: 1
                  {% endif %}
                "
              >
                {{ section_st.description }}
              </motion-element>
            {% endif %}
          </div>
        {% endif %}
        <motion-element 
          data-motion="fade-up-lg"
          data-motion-delay="150"
          {% if scroll_animation != 'slide_in' %}
            hold
          {% endif %}
          class="subcribe-submit {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}  {% if form_layout == 'horizontal' %} flex-grow{% else %} max-w-custom mx-auto{% endif %} flex flex-column text-{{ header_alignment }} justify-content-{{ header_alignment }}"
          style="
            {%- if scroll_animation != 'none' -%}
              --animation-order: 1
            {% endif %}
          "
        >
          {%- form 'customer', class: 'subscribe-form flex justify-content-inherit' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-inner flex flex-wrap gap-10 w-full justify-content-{{ header_alignment }}">
              <input
                type="email"
                required
                name="contact[email]"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section_st.email_placeholder }}"
                class="subcribe-input btn-radius flex-1 flex-grow{% if form_layout == 'horizontal' %} col {% else %} input-vertical{% endif %}"
              >
              <button
                type="submit"
                name="commit"
                class="subcribe-button btn-primary"
                data-theme-button="primary" data-sl-button
                aria-label="{%- if section_st.btn_text != blank -%}{{ section_st.btn_text }} {%- else -%} {{ 'subscribe.button_label' | t }} {% endif %}"
              >
                {%- if section_st.btn_text != blank -%}
                  {{ section_st.btn_text }}
                {%- else -%}
                  {{ 'newsletter.button_label' | t }}
                {% endif %}
              </button>
            </div>
          {%- endform -%}
          {%- if section_st.note != blank -%}
            <div class="sec_newsletter_note newsletter-note mt-12 mx-auto fs-12">{{ section_st.note }}</div>
          {% endif %}
        </motion-element>
      </div>
    </div>
  </div>
</div>


</template>

<schema>
{
  "type": "newsletter",
  "name": "Newsletter",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "fluid_container",
      "label": "Section width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form layout",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon above the text",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "envelope",
      "info": "Used without custom image",
      "options": [
        {
          "value": "envelope",
          "label": "Envelope"
        },
        {
          "value": "paper_plane",
          "label": "Paper plane"
        },
        {
          "value": "bell",
          "label": "Bell"
        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "sparkles",
          "label": "Sparkles"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Custom icon image",
      "info": "Overrides the icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Newsletters",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address..."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Btn text",
      "default": "Subscribe"
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "default": "Your personal data will be used to support your experience throughout this website, and for other purposes described in our Privacy Policy.",
      "label": "Note"
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Background overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Background overlay opacity",
      "info": "0 = no overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Content box"
    },
    {
      "type": "checkbox",
      "id": "show_content_background",
      "label": "Show content background"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background"
    },
    {
      "type": "range",
      "id": "content_box_opacity",
      "label": "Content box opacity",
      "default": 100,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "Header size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_29",
