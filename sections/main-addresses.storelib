<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The account's addresses (/account/addresses). Storelib saves a
  customer's addresses at checkout, so this page lists them and edits nothing.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="ap ap-addresses bls__page-addresses color-{{ scheme }} gradient"
  data-ap-root="main-addresses"
  data-ap-section="{{ sid }}"
  data-ap-settings="{{ st | json | escape }}"
  {% if st.reset_spacing %}data-ap-reset{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-hfs-d: {{ st.heading_size_desktop | default: 30 }}px; --ap-hfs-m: {{ st.heading_size_mobile | default: 24 }}px;{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  <div class="{{ st.section_width | default: 'container' }}" data-ap-width>
    <div class="ap-acc__grid">
      <div>{% render 'customer-nav', st: st %}</div>
      <div>
        <h1 class="ap__h" data-ap-text="heading" data-ap-opt{% if st.heading == blank %} hidden{% endif %}>{{ st.heading | escape }}</h1>
        <div class="ap__t ap-addr__intro" data-ap-rich="text" data-ap-opt{% if st.text == blank %} hidden{% endif %}>{{ st.text }}</div>
        {%- if customer.addresses.size > 0 -%}
          <ul class="ap-addr__list" role="list">
            {%- for address in customer.addresses -%}
              <li class="ap-card ap-addr__card">
                {%- if address == customer.default_address -%}
                  <p class="ap-addr__default" data-ap-text="default_label">{{ st.default_label | escape }}</p>
                {%- endif -%}
                <div class="ap-addr__body">{{ address | format_address }}</div>
                {%- if address.phone != blank -%}<p class="ap-addr__phone">{{ address.phone }}</p>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="ap-card ap__t ap-addr__none" data-ap-text="empty_text">{{ st.empty_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ sid }} .ap-addr__intro { margin-bottom: 24px; }
  #shopify-section-{{ sid }} .ap-addr__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .ap-addr__card p { margin: 0; }
  #shopify-section-{{ sid }} .ap-addr__default { color: var(--ap-h-c, var(--color-heading)); font-weight: 600; margin-bottom: 8px !important; }
  #shopify-section-{{ sid }} .ap-addr__body { overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .ap-addr__none { margin: 0; }
{% comment %}{% endcomment %}</style>
</template>

<schema>
{
  "type": "main-addresses",
  "name": "Main addresses",
  "settings": [],
  "shopify": {
    "name": "Addresses",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Your addresses"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Addresses are saved when you check out.</p>"
      },
      {
        "type": "text",
        "id": "default_label",
        "label": "Default address label",
        "default": "Default address"
      },
      {
        "type": "text",
        "id": "empty_text",
        "label": "No addresses text",
        "default": "You have no saved addresses yet."
      },
      {
        "type": "text",
        "id": "nav_dashboard",
        "label": "Menu: account",
        "default": "Account"
      },
      {
        "type": "text",
        "id": "nav_addresses",
        "label": "Menu: addresses",
        "default": "Addresses"
      },
      {
        "type": "text",
        "id": "nav_wishlist",
        "label": "Menu: wishlist",
        "default": "Wishlist"
      },
      {
        "type": "text",
        "id": "nav_logout",
        "label": "Menu: log out",
        "default": "Log out"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "heading_size_desktop",
        "label": "Heading size (desktop)",
        "min": 14,
        "max": 60,
        "step": 1,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding (desktop)",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "min": 14,
        "max": 48,
        "step": 1,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 30,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 40,
        "unit": "px"
      }
    ]
  }
}
</schema>