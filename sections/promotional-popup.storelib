<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Signup Discount Popup: a picture beside an eyebrow, a
  heading, a line of text, a signup form (Storelib Subscribers,
  data-storelib-form="subscribe") and a "no thanks" link, in a native
  <dialog> (snippets/page-popup-dialog). Every setting reaches the page as a
  CSS variable, an attribute or a text on its element, so
  shopify/assets/live-page-popups.js applies a builder edit in place, the
  same as this Liquid draws it. Each block is always drawn (hidden while
  empty) so it can be filled in live.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign eyebrow_block = section.blocks | where: 'type', 'eyebrow' | first
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign sub_block = section.blocks | where: 'type', 'subheading' | first
  assign form_block = section.blocks | where: 'type', 'form' | first
  assign dismiss_block = section.blocks | where: 'type', 'dismiss' | first
  assign ppd_c = false
  if s.enable_custom_style == true
    assign ppd_c = true
  endif
  assign email_ph_default = 'accessibility.email_placeholder' | t
  assign phone_ph_default = 'accessibility.phone_placeholder' | t
  assign get_coupon_default = 'accessibility.get_my_coupon' | t
  case s.trigger
    when 'scroll'
      assign ppd_mode = 'scroll'
    when 'exit'
      assign ppd_mode = 'exit'
    when 'click'
      assign ppd_mode = 'manual'
    when 'pageviews'
      assign ppd_mode = 'pageviews'
    else
      assign ppd_mode = 'delay'
  endcase
  assign ppd_img_w = s.image_width_pct | default: 50
  assign ppd_text_w = 100 | minus: ppd_img_w
  assign ppd_align_items = 'center'
  if s.content_align == 'left'
    assign ppd_align_items = 'flex-start'
  elsif s.content_align == 'right'
    assign ppd_align_items = 'flex-end'
  endif
-%}
<style>
  #shopify-section-{{ sid }} {
    position: relative;
    z-index: {{ s.z_index | default: 1000 }};
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .ppd-backdrop {
    position: fixed; inset: 0;
    background: var(--ppd-backdrop, rgba(0,0,0,0.55));
    z-index: var(--ppd-z, 1000);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--ppd-backdrop-pad, 16px);
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; visibility: hidden;
    transition: opacity 0.28s ease, visibility 0s linear 0.32s;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] { opacity: 1; visibility: visible; transition-delay: 0s; }
  #shopify-section-{{ sid }} .ppd-backdrop[data-preview] { background: var(--ppd-preview-bg, var(--ppd-backdrop, rgba(0,0,0,0.55))); }
  /* the builder draws it in the page: the preview background frames the card */
  #shopify-section-{{ sid }} dialog[data-pg-dialog][open]:not(:modal) .ppd-backdrop[data-preview] {
    background: var(--ppd-preview-bg, transparent) !important;
    padding: 24px 0 !important;
  }
  #shopify-section-{{ sid }} .ppd {
    position: relative;
    width: 100%;
    max-width: var(--ppd-max-w, 760px);
    background: var(--ppd-bg, var(--color-background));
    color: var(--ppd-text, var(--color-text));
    border-radius: var(--ppd-radius, 18px);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    margin: auto;
    transform: translateY(20px) scale(0.96);
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: grid;
    grid-template-columns: 1fr;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] .ppd { transform: translateY(0) scale(1); }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd { grid-template-columns: var(--ppd-img-fr, 50fr) var(--ppd-text-fr, 50fr); }
    #shopify-section-{{ sid }} [data-ppd-image="right"] .ppd__media { order: 2; }
  }
  #shopify-section-{{ sid }} .ppd__media {
    position: relative;
    overflow: hidden;
    background: var(--ppd-image-bg, color-mix(in srgb, var(--color-heading) 10%, var(--color-background)));
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__media { aspect-ratio: auto; min-height: 100%; }
  }
  #shopify-section-{{ sid }} .ppd__media img,
  #shopify-section-{{ sid }} .ppd__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .ppd__content {
    padding: var(--ppd-pad-m, 28px) var(--ppd-pad-m, 28px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--ppd-gap, 12px);
    text-align: var(--ppd-align, center);
    align-items: var(--ppd-align-items, center);
  }
  #shopify-section-{{ sid }} .ppd__content > [hidden] { display: none !important; }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__content { padding: var(--ppd-pad-d, 36px) var(--ppd-pad-d, 36px); }
  }
  #shopify-section-{{ sid }} .ppd__close {
    position: absolute;
    top: var(--ppd-close-off, 12px); inset-inline-end: var(--ppd-close-off, 12px);
    z-index: 5;
    width: var(--ppd-close-size, 36px);
    height: var(--ppd-close-size, 36px);
    min-width: 44px; min-height: 44px;
    border: 0;
    background-color: var(--ppd-close-bg, color-mix(in srgb, currentColor 10%, transparent));
    color: var(--ppd-close, var(--color-heading));
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__close:hover { background-color: var(--ppd-close-bg-hover, color-mix(in srgb, currentColor 20%, transparent)); }
  #shopify-section-{{ sid }} .ppd__close svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .ppd__eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.18em; }
  #shopify-section-{{ sid }} .ppd__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); line-height: 1.15; font-size: var(--ppd-h-m, 26px); }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__heading { font-size: var(--ppd-h-d, 32px); }
  }
  #shopify-section-{{ sid }} .ppd__sub     { margin: 0; line-height: 1.5; }
  #shopify-section-{{ sid }} .ppd__sub p   { margin: 0 0 0.4em; }
  #shopify-section-{{ sid }} .ppd__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .ppd__form { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; width: 100%; }
  #shopify-section-{{ sid }} .ppd__field {
    width: 100%;
    min-height: var(--ppd-input-height, auto);
    border: var(--ppd-input-border-width, 0px) solid var(--color-border);
    border-radius: var(--ppd-input-radius, 10px);
    padding: var(--ppd-input-padding, 14px 16px);
    font-size: var(--ppd-input-size, 15px);
    background: var(--ppd-input-bg, var(--input-bg));
    color: var(--ppd-input-color, var(--input-color));
    outline: none;
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__field[hidden] { display: none; }
  #shopify-section-{{ sid }} .ppd__field:focus-visible { border-color: var(--color-heading); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent); }
  #shopify-section-{{ sid }} .ppd__field::placeholder { color: var(--ppd-input-placeholder, var(--input-placeholder-color)); }
  /* The submit is a theme button (theme-button-contract.css); the form's
     own colours, and its shape with the theme's style off, arrive as --mb-* tokens. */
  #shopify-section-{{ sid }} .ppd__btn { cursor: pointer; width: 100%; }
  #shopify-section-{{ sid }} .ppd__btn:focus-visible,
  #shopify-section-{{ sid }} .ppd__close:focus-visible,
  #shopify-section-{{ sid }} .ppd__dismiss:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #shopify-section-{{ sid }} .ppd__success { margin: 8px 0 0; font-weight: 600; color: var(--ppd-success-color); text-align: center; }
  #shopify-section-{{ sid }} .ppd__error { margin: 8px 0 0; font-weight: 500; color: var(--ppd-error-color); text-align: center; }
  #shopify-section-{{ sid }} .ppd__dismiss {
    margin-top: 6px;
    background: none; border: 0; cursor: pointer;
    text-decoration: none;
    color: var(--ppd-dismiss-color);
    transition: color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    align-self: center;
    min-height: 44px; padding: 8px 12px;
  }
  #shopify-section-{{ sid }} .ppd__dismiss:hover { text-decoration: underline; color: var(--ppd-dismiss-hover); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.ppd, .ppd-backdrop, .ppd__close, .ppd__field, .ppd__dismiss) { transition: none; }
    #shopify-section-{{ sid }} .ppd { transform: none; }
  }
{% comment %}{% endcomment %}</style>
{%- capture ppd_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ s.show_in_builder | json }},
   "trigger": {"mode": {{ ppd_mode | json }}, "delay": {{ s.delay | default: 3 | json }}, "scroll": {{ s.scroll_pct | default: 40 | json }}, "views": {{ s.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ s.frequency | default: 'session' | json }} } }
{%- endcapture -%}
{%- capture ppd_vars -%}
--ppd-z: {{ s.z_index | default: 1000 }}; --ppd-backdrop-pad: {{ s.backdrop_padding | default: 16 }}px; --ppd-max-w: {{ s.modal_max_width | default: 760 }}px; --ppd-radius: {{ s.modal_radius | default: 18 }}px; --ppd-img-fr: {{ ppd_img_w }}fr; --ppd-text-fr: {{ ppd_text_w }}fr; --ppd-pad-m: {{ s.content_padding_mobile | default: 28 }}px; --ppd-pad-d: {{ s.content_padding_desktop | default: 36 }}px; --ppd-gap: {{ s.content_gap | default: 12 }}px; --ppd-align: {{ s.content_align | default: 'center' }}; --ppd-align-items: {{ ppd_align_items }}; --ppd-close-off: {{ s.close_offset | default: 12 }}px; --ppd-close-size: {{ s.close_size | default: 36 }}px;
{%- if ppd_c %} --ppd-backdrop: {% render 'scheme-color', color: s.backdrop_color, fallback: 'rgba(0,0,0,0.55)' %}; --ppd-preview-bg: {% render 'scheme-color', color: s.editor_preview_bg, fallback: 'transparent' %}; --ppd-bg: {% render 'scheme-color', color: s.modal_bg, fallback: 'var(--color-background)' %}; --ppd-text: {% render 'scheme-color', color: s.modal_text_color, fallback: 'var(--color-text)' %}; --ppd-image-bg: {% render 'scheme-color', color: s.image_bg, fallback: 'color-mix(in srgb, var(--color-heading) 10%, var(--color-background))' %}; --ppd-close: {% render 'scheme-color', color: s.close_color, fallback: 'var(--color-heading)' %}; --ppd-close-bg: {% render 'scheme-color', color: s.close_bg, fallback: 'color-mix(in srgb, currentColor 10%, transparent)' %}; --ppd-close-bg-hover: {% render 'scheme-color', color: s.close_bg_hover, fallback: 'color-mix(in srgb, currentColor 20%, transparent)' %};{%- endif -%}
{%- render 'page-popup-fonts', st: s -%}
{%- endcapture -%}
{% render 'page-popup-dialog', sid: sid, st: s %}
<div class="ppd-root" data-pg-root="promotional-popup" data-pg-section="{{ sid }}" data-pg-settings="{{ s | json | escape }}"{% if s.enable_custom_fonts %} data-pg-fonts data-own-font{% endif %} data-ppd-image="{{ s.image_position | default: 'left' }}" style="{{ ppd_vars | strip_newlines | strip }}">
<dialog class="pg-dialog" data-pg-dialog aria-labelledby="ppd-title-{{ sid }}">
<div
  id="ppd-{{ sid }}"
  class="ppd-backdrop"
  data-pg-frame
  data-open="false"
  data-section-id="{{ sid }}"
  data-popup-root="{{ sid }}"
  data-popup-config="{{ ppd_config | strip_newlines | escape }}"
  aria-hidden="true"
>
  <div class="ppd color-{{ color_scheme }} gradient" data-pg-card data-pg-scheme tabindex="-1">
    <button type="button" class="ppd__close" aria-label="{{ 'accessibility.close' | t }}" data-popup-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
    <div class="ppd__media" data-ppd-media>
      <template data-pg-ph>{{ 'lifestyle-1' | placeholder_svg_tag }}</template>
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '320, 480, 640, 800, 1000' }}
      {%- elsif s.placeholder_url != blank -%}
        <img src="{{ s.placeholder_url }}" alt="" loading="lazy" width="800" height="1000">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="ppd__content">
      {%- if eyebrow_block -%}
        {%- liquid
          assign eb = eyebrow_block.settings
          assign c = ''
          if eb.enable_custom_style == true
            assign c = eb.color
          endif
        -%}
        <p class="ppd__eyebrow" data-pg-block="{{ eyebrow_block.id }}" data-pg-type="eyebrow" data-pg-settings="{{ eb | json | escape }}"{% if eb.text == blank %} hidden{% endif %}
           style="color: {% render 'scheme-color', color: c, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; font-size: {{ eb.size | default: 12 }}px; letter-spacing: {{ eb.letter_spacing | default: 0.18 }}em;"
           {{ eyebrow_block.shopify_attributes }}>{{ eb.text | escape }}</p>
      {%- endif -%}
      {%- if heading_block -%}
        {%- liquid
          assign hb = heading_block.settings
          assign c = ''
          if hb.enable_custom_style == true
            assign c = hb.color
          endif
        -%}
        <h2 class="ppd__heading" id="ppd-title-{{ sid }}" data-pg-block="{{ heading_block.id }}" data-pg-type="heading" data-pg-settings="{{ hb | json | escape }}"{% if hb.text == blank %} hidden{% endif %}
          style="color: {% render 'scheme-color', color: c, fallback: 'var(--color-heading)' %}; --ppd-h-m: {{ hb.size_mobile | default: 26 }}px; --ppd-h-d: {{ hb.size_desktop | default: 32 }}px;"
          {{ heading_block.shopify_attributes }}>{{ hb.text | escape }}</h2>
      {%- endif -%}
      {%- if sub_block -%}
        {%- liquid
          assign subbs = sub_block.settings
          assign c = ''
          if subbs.enable_custom_style == true
            assign c = subbs.color
          endif
        -%}
        <div class="ppd__sub" data-pg-block="{{ sub_block.id }}" data-pg-type="subheading" data-pg-settings="{{ subbs | json | escape }}"{% if subbs.text == blank %} hidden{% endif %}
             style="color: {% render 'scheme-color', color: c, fallback: 'color-mix(in srgb, var(--color-text) 85%, transparent)' %}; font-size: {{ subbs.size | default: 14 }}px;"
             {{ sub_block.shopify_attributes }}>{{ subbs.text }}</div>
      {%- endif -%}
      {%- if form_block -%}
        {%- liquid
          assign fbs = form_block.settings
          assign ppd_form_id = 'ppd-form-' | append: form_block.id
          assign fc = false
          if fbs.enable_custom_style == true
            assign fc = true
          endif
          assign f_ib = ''
          assign f_ic = ''
          assign f_ip = ''
          assign f_bb = ''
          assign f_bbh = ''
          assign f_bc = ''
          assign f_ok = ''
          assign f_err = ''
          if fc
            assign f_ib = fbs.input_bg
            assign f_ic = fbs.input_color
            assign f_ip = fbs.input_placeholder_color
            assign f_bb = fbs.btn_bg
            assign f_bbh = fbs.btn_bg_hover
            assign f_bc = fbs.btn_color
            assign f_ok = fbs.success_color
            assign f_err = fbs.error_color
          endif
          assign ppd_custom = false
          assign ppd_transform = blank
          if fbs.use_theme_button == false
            assign ppd_custom = true
            assign ppd_transform = 'uppercase'
          endif
        -%}
        <div class="ppd__form-wrap" data-pg-block="{{ form_block.id }}" data-pg-type="form" data-pg-settings="{{ fbs | json | escape }}" data-pg-i18n='{"email":{{ email_ph_default | json | escape }},"phone":{{ phone_ph_default | json | escape }},"submit":{{ get_coupon_default | json | escape }}}'
             style="--ppd-input-bg: {% render 'scheme-color', color: f_ib, fallback: 'var(--input-bg)' %}; --ppd-input-color: {% render 'scheme-color', color: f_ic, fallback: 'var(--input-color)' %}; --ppd-input-placeholder: {% render 'scheme-color', color: f_ip, fallback: 'var(--input-placeholder-color)' %};{% if fbs.use_theme_fields != false %} --ppd-input-radius: var(--input-border-radius, 10px); --ppd-input-height: var(--input-height, 50px); --ppd-input-padding: var(--input-padding, 14px 16px); --ppd-input-size: var(--input-font-size, 15px); --ppd-input-border-width: var(--inputs-border-width, 1px);{% else %} --ppd-input-radius: {{ fbs.input_radius | default: 10 }}px; --ppd-input-padding: {{ fbs.input_pad_y | default: 14 }}px 16px; --ppd-input-size: {{ fbs.input_size | default: 15 }}px; --mt-select-radius: {{ fbs.input_radius | default: 10 }}px;{% endif %}{% if fc %} --mt-select-bg: {% render 'scheme-color', color: f_ib, fallback: 'var(--input-bg)' %}; --mt-select-text: {% render 'scheme-color', color: f_ic, fallback: 'var(--input-color)' %};{% endif %} --ppd-success-color: {% render 'scheme-color', color: f_ok, fallback: 'color-mix(in srgb, #2e9e57 70%, var(--color-text))' %}; --ppd-error-color: {% render 'scheme-color', color: f_err, fallback: 'color-mix(in srgb, #e04848 70%, var(--color-text))' %};"
             {{ form_block.shopify_attributes }}>
          <form id="{{ ppd_form_id }}" class="ppd__form" data-storelib-form="subscribe">
            <input type="email" class="ppd__field" name="email" autocomplete="email" placeholder="{{ fbs.email_placeholder | default: email_ph_default | escape }}" aria-label="{{ 'accessibility.email_placeholder' | t }}" required data-popup-autofocus>
            <input type="tel" class="ppd__field" name="phone" autocomplete="tel" placeholder="{{ fbs.phone_placeholder | default: phone_ph_default | escape }}" aria-label="{{ 'accessibility.phone_placeholder' | t }}" data-ppd-phone{% unless fbs.show_phone %} hidden disabled{% endunless %}>
            <button type="submit" class="ppd__btn btn-primary" data-theme-button="primary" data-sl-button{% if ppd_custom %} data-own-shape{% endif %} style="{%- render 'button-overrides', bg: f_bb, text: f_bc, hover_bg: f_bbh, custom: ppd_custom, radius: fbs.btn_radius, padding_y: fbs.btn_pad_y, font_size: fbs.btn_size, border_width: 0, transform: ppd_transform -%}">{{ fbs.button_label | default: get_coupon_default | escape }}</button>
            <p class="ppd__success" data-storelib-success hidden>{{ fbs.success_text | default: 'Check your inbox. Your code is on the way.' | escape }}</p>
          </form>
        </div>
      {%- endif -%}
      {%- if dismiss_block -%}
        {%- liquid
          assign dbs = dismiss_block.settings
          assign d1 = ''
          assign d2 = ''
          if dbs.enable_custom_style == true
            assign d1 = dbs.color
            assign d2 = dbs.hover_color
          endif
        -%}
        <button type="button" class="ppd__dismiss" data-popup-close data-pg-block="{{ dismiss_block.id }}" data-pg-type="dismiss" data-pg-settings="{{ dbs | json | escape }}"{% if dbs.label == blank %} hidden{% endif %}
                style="--ppd-dismiss-color: {% render 'scheme-color', color: d1, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; --ppd-dismiss-hover: {% render 'scheme-color', color: d2, fallback: 'var(--color-text)' %}; font-size: {{ dbs.size | default: 13 }}px;"
                {{ dismiss_block.shopify_attributes }}>{{ dbs.label | escape }}</button>
      {%- endif -%}
    </div>
  </div>
</div>
</dialog>
</div>
<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ sid | json }};
  function setup(P){
    var modal = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!modal || modal.__ppd) return;
    modal.__ppd = true;
    var CFG = JSON.parse(modal.getAttribute('data-popup-config') || '{}');
    var form = modal.querySelector('.ppd__form');
    var api = P.register({
      id: SID, root: modal, dialog: modal.querySelector('.ppd'), backdrop: modal,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-ppd-trigger="' + SID + '"]' }, CFG.trigger),
      frequency: CFG.frequency,
      open: function(o){ if (o.preview) modal.setAttribute('data-preview', ''); modal.setAttribute('data-open', 'true'); },
      close: function(){ modal.setAttribute('data-open', 'false'); modal.removeAttribute('data-preview'); }
    });
    // Signed up: do not offer the discount again.
    if (form) new MutationObserver(function(){
      if (form.getAttribute('data-state') === 'done' && api) api.done(365);
    }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "promotional-popup",
  "name": "Signup Discount Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Opens",
      "default": "load",
      "options": [
        {
          "value": "load",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        },
        {
          "value": "exit",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "click",
          "label": "From a link"
        }
      ]
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
