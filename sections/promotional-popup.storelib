<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes — Promotion Popup Discount (Promotional Popup category).
  Block-organized popup modal: image + heading + subheading + form +
  dismiss link, each as its own block with its own settings. Every
  slider, color, and toggle is wired through to CSS via inline styles.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  assign placeholder_src = s.placeholder_url | default: 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'

  assign eyebrow_block  = section.blocks | where: 'type', 'eyebrow'    | first
  assign heading_block  = section.blocks | where: 'type', 'heading'    | first
  assign sub_block      = section.blocks | where: 'type', 'subheading' | first
  assign form_block     = section.blocks | where: 'type', 'form'       | first
  assign dismiss_block  = section.blocks | where: 'type', 'dismiss'    | first
-%}

<style>
  #shopify-section-{{ sid }} {
    position: relative;
    z-index: {{ s.z_index | default: 1000 }};
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .ppd-backdrop {
    position: fixed; inset: 0;
    background: {{ s.backdrop_color | default: 'rgba(0,0,0,0.55)' }};
    z-index: {{ s.z_index | default: 1000 }};
    display: none;
    opacity: 0;
    transition: opacity 0.28s ease;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] {
    display: flex;
    opacity: 1;
    align-items: center;
    justify-content: center;
    padding: {{ s.backdrop_padding | default: 16 }}px;
  }

  #shopify-section-{{ sid }} .ppd {
    position: relative;
    width: 100%;
    max-width: {{ s.modal_max_width | default: 760 }}px;
    background: {% render 'scheme-color', color: s.modal_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: s.modal_text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ s.modal_radius | default: 18 }}px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    transform: translateY(20px) scale(0.96);
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: grid;
    grid-template-columns: 1fr;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] .ppd {
    transform: translateY(0) scale(1);
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd { grid-template-columns: {{ s.image_width_pct | default: 50 }}fr {{ 100 | minus: s.image_width_pct | default: 50 }}fr; }
    {%- if s.image_position == 'right' -%}
      #shopify-section-{{ sid }} .ppd { direction: rtl; }
      #shopify-section-{{ sid }} .ppd > * { direction: ltr; }
    {%- endif -%}
  }

  #shopify-section-{{ sid }} .ppd__media {
    position: relative;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'color-mix(in srgb, var(--color-heading) 10%, var(--color-background))' %};
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__media { aspect-ratio: auto; min-height: 100%; }
  }
  #shopify-section-{{ sid }} .ppd__media img,
  #shopify-section-{{ sid }} .ppd__media svg {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  #shopify-section-{{ sid }} .ppd__content {
    padding: {{ s.content_padding_mobile | default: 28 }}px {{ s.content_padding_mobile | default: 28 }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ s.content_gap | default: 12 }}px;
    text-align: {{ s.content_align | default: 'center' }};
    align-items: {% if s.content_align == 'left' %}flex-start{% elsif s.content_align == 'right' %}flex-end{% else %}center{% endif %};
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__content { padding: {{ s.content_padding_desktop | default: 36 }}px {{ s.content_padding_desktop | default: 36 }}px; }
  }

  #shopify-section-{{ sid }} .ppd__close {
    position: absolute;
    top: {{ s.close_offset | default: 12 }}px; right: {{ s.close_offset | default: 12 }}px;
    z-index: 5;
    width: {{ s.close_size | default: 36 }}px;
    height: {{ s.close_size | default: 36 }}px;
    border: 0;
    background-color: {% render 'scheme-color', color: s.close_bg, fallback: 'color-mix(in srgb, currentColor 10%, transparent)' %};
    color: {% render 'scheme-color', color: s.close_color, fallback: 'var(--color-heading)' %};
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__close:hover {
    background-color: {% render 'scheme-color', color: s.close_bg_hover, fallback: 'color-mix(in srgb, currentColor 20%, transparent)' %};
    transform: scale(1.05);
  }
  #shopify-section-{{ sid }} .ppd__close svg { width: 16px; height: 16px; }

  /* Block elements (set inline styles per block — defaults below cover unset cases) */
  #shopify-section-{{ sid }} .ppd__eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.18em; }
  #shopify-section-{{ sid }} .ppd__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); line-height: 1.15; }
  #shopify-section-{{ sid }} .ppd__sub     { margin: 0; line-height: 1.5; }
  #shopify-section-{{ sid }} .ppd__sub p   { margin: 0 0 0.4em; }
  #shopify-section-{{ sid }} .ppd__sub p:last-child { margin: 0; }

  /* Form */
  #shopify-section-{{ sid }} .ppd__form {
    display: flex;
    flex-direction: column;
    gap: {{ s.form_gap | default: 10 }}px;
    margin-top: {{ s.form_margin_top | default: 8 }}px;
    width: 100%;
  }
  #shopify-section-{{ sid }} .ppd__field {
    width: 100%;
    min-height: var(--ppd-input-height, auto);
    border: var(--ppd-input-border-width, 0px) solid var(--color-border);
    border-radius: var(--ppd-input-radius, 10px);
    padding: var(--ppd-input-padding, 14px 16px);
    font-size: var(--ppd-input-size, 15px);
    background: var(--ppd-input-bg, var(--input-bg));
    color: var(--ppd-input-color, var(--input-color));
    outline: none;
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__field:focus-visible { border-color: var(--color-heading); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent); }
  #shopify-section-{{ sid }} .ppd__field::placeholder { color: var(--ppd-input-placeholder, var(--input-placeholder-color)); }
  #shopify-section-{{ sid }} .ppd__btn {
    cursor: pointer;
    width: 100%;
    padding: var(--ppd-btn-pad-y, 14px) var(--ppd-btn-pad-x, 16px);
    background-color: var(--ppd-btn-bg);
    color: var(--ppd-btn-color);
    border: var(--ppd-btn-border-width, 0px) solid var(--ppd-btn-bg);
    border-radius: var(--ppd-btn-radius, 10px);
    font-weight: var(--btn-font-weight, 700);
    font-size: var(--ppd-btn-size, 14px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__btn:hover {
    background-color: var(--ppd-btn-bg-hover);
    border-color: var(--ppd-btn-bg-hover);
    color: var(--ppd-btn-color-hover);
    transform: translateY(-1px);
  }
  #shopify-section-{{ sid }} .ppd__btn:focus-visible,
  #shopify-section-{{ sid }} .ppd__close:focus-visible,
  #shopify-section-{{ sid }} .ppd__dismiss:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #shopify-section-{{ sid }} .ppd__success {
    margin: 8px 0 0;
    font-weight: 600;
    color: var(--ppd-success-color);
    text-align: center;
  }
  #shopify-section-{{ sid }} .ppd__error {
    margin: 8px 0 0;
    font-weight: 500;
    color: var(--ppd-error-color);
    text-align: center;
  }

  /* Dismiss link */
  #shopify-section-{{ sid }} .ppd__dismiss {
    margin-top: {{ s.dismiss_margin_top | default: 6 }}px;
    background: none; border: 0; cursor: pointer;
    text-decoration: none;
    color: var(--ppd-dismiss-color);
    transition: color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    align-self: center;
  }
  #shopify-section-{{ sid }} .ppd__dismiss:hover { text-decoration: underline; color: var(--ppd-dismiss-hover); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ppd,
    #shopify-section-{{ sid }} .ppd-backdrop,
    #shopify-section-{{ sid }} .ppd__btn,
    #shopify-section-{{ sid }} .ppd__close,
    #shopify-section-{{ sid }} .ppd__field,
    #shopify-section-{{ sid }} .ppd__dismiss { transition: none; }
    #shopify-section-{{ sid }} .ppd__btn:hover,
    #shopify-section-{{ sid }} .ppd__close:hover { transform: none; }
  }

  /* Editor preview — show inline (not as fixed modal) when in design mode */
  .shopify-design-mode #shopify-section-{{ sid }} .ppd-backdrop {
    position: relative !important;
    display: flex !important;
    opacity: 1 !important;
    inset: auto !important;
    padding: 24px;
    background: {% render 'scheme-color', color: s.editor_preview_bg, fallback: 'transparent' %};
  }
{% comment %}{% endcomment %}</style>

<div
  id="ppd-{{ sid }}"
  class="ppd-backdrop"
  data-open="false"
  data-trigger="{{ s.trigger | default: 'load' }}"
  data-delay="{{ s.delay | default: 3 }}"
  data-scroll-pct="{{ s.scroll_pct | default: 40 }}"
  data-frequency="{{ s.frequency | default: 'session' }}"
  data-section-id="{{ sid }}"
  role="dialog"
  aria-modal="true"
>
  <div class="ppd color-{{ color_scheme }} gradient" role="document">
    <button type="button" class="ppd__close" aria-label="{{ 'accessibility.close' | t }}" data-ppd-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>

    <div class="ppd__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '320, 480, 640, 800, 1000' }}
      {%- else -%}
        <img src="{{ placeholder_src }}" alt="" loading="lazy">
      {%- endif -%}
    </div>

    <div class="ppd__content">
      {%- if eyebrow_block and eyebrow_block.settings.text != blank -%}
        {%- assign eb = eyebrow_block.settings -%}
        <p class="ppd__eyebrow"
           style="color: {% render 'scheme-color', color: eb.color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; font-size: {{ eb.size | default: 12 }}px; letter-spacing: {{ eb.letter_spacing | default: 0.18 }}em;"
           {{ eyebrow_block.shopify_attributes }}>{{ eb.text | escape }}</p>
      {%- endif -%}

      {%- if heading_block and heading_block.settings.text != blank -%}
        {%- assign hb = heading_block.settings -%}
        <{{ hb.tag | default: 'h2' }} class="ppd__heading"
          data-bid="{{ heading_block.id }}"
          style="color: {% render 'scheme-color', color: hb.color, fallback: 'var(--color-heading)' %}; font-size: {{ hb.size_mobile | default: 26 }}px;"
          {{ heading_block.shopify_attributes }}>{{ hb.text | escape }}</{{ hb.tag | default: 'h2' }}>
        <style>
          @media (min-width: 760px) {
            #shopify-section-{{ sid }} [data-bid="{{ heading_block.id }}"] { font-size: {{ hb.size_desktop | default: 32 }}px !important; }
          }
{% comment %}{% endcomment %}        </style>
      {%- endif -%}

      {%- if sub_block and sub_block.settings.text != blank -%}
        {%- assign subbs = sub_block.settings -%}
        <div class="ppd__sub"
             style="color: {% render 'scheme-color', color: subbs.color, fallback: 'color-mix(in srgb, var(--color-text) 85%, transparent)' %}; font-size: {{ subbs.size | default: 14 }}px;"
             {{ sub_block.shopify_attributes }}>{{ subbs.text }}</div>
      {%- endif -%}

      {%- if form_block -%}
        {%- assign fbs = form_block.settings -%}
        {%- assign ppd_form_id = 'ppd-form-' | append: form_block.id -%}
        <div class="ppd__form-wrap"
             style="
               --ppd-input-bg: {% render 'scheme-color', color: fbs.input_bg, fallback: 'var(--input-bg)' %};
               --ppd-input-color: {% render 'scheme-color', color: fbs.input_color, fallback: 'var(--input-color)' %};
               --ppd-input-placeholder: {% render 'scheme-color', color: fbs.input_placeholder_color, fallback: 'var(--input-placeholder-color)' %};
               {%- if fbs.use_theme_fields != false %}
               --ppd-input-radius: var(--input-border-radius, 10px);
               --ppd-input-height: var(--input-height, 50px);
               --ppd-input-padding: var(--input-padding, 14px 16px);
               --ppd-input-size: var(--input-font-size, 15px);
               --ppd-input-border-width: var(--inputs-border-width, 1px);
               {%- else %}
               --ppd-input-radius: {{ fbs.input_radius | default: 10 }}px;
               --ppd-input-padding: {{ fbs.input_pad_y | default: 14 }}px 16px;
               --ppd-input-size: {{ fbs.input_size | default: 15 }}px;
               {%- endif %}
               --ppd-btn-bg: {% render 'scheme-color', color: fbs.btn_bg, fallback: 'var(--btn-primary-bg-color)' %};
               --ppd-btn-bg-hover: {% render 'scheme-color', color: fbs.btn_bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
               --ppd-btn-color: {% render 'scheme-color', color: fbs.btn_color, fallback: 'var(--btn-primary-color)' %};
               --ppd-btn-color-hover: {% render 'scheme-color', color: fbs.btn_color, fallback: 'var(--btn-primary-hover-color)' %};
               {%- if fbs.use_theme_button != false %}
               --ppd-btn-radius: var(--btn-radius, 10px);
               --ppd-btn-size: var(--btn-font-size, 14px);
               --ppd-btn-pad-y: var(--btn-padding-y, 14px);
               --ppd-btn-pad-x: var(--btn-padding-x, 16px);
               --ppd-btn-border-width: var(--btn-border-width, 0px);
               {%- else %}
               --ppd-btn-radius: {{ fbs.btn_radius | default: 10 }}px;
               --ppd-btn-size: {{ fbs.btn_size | default: 14 }}px;
               --ppd-btn-pad-y: {{ fbs.btn_pad_y | default: 14 }}px;
               {%- endif %}
               --ppd-success-color: {% render 'scheme-color', color: fbs.success_color, fallback: 'color-mix(in srgb, #2e9e57 70%, var(--color-text))' %};
               --ppd-error-color: {% render 'scheme-color', color: fbs.error_color, fallback: 'color-mix(in srgb, #e04848 70%, var(--color-text))' %};
             "
             {{ form_block.shopify_attributes }}>
          {%- assign email_ph_default = 'accessibility.email_placeholder' | t -%}
          {%- assign phone_ph_default = 'accessibility.phone_placeholder' | t -%}
          {%- assign get_coupon_default = 'accessibility.get_my_coupon' | t -%}
          {%- form 'customer', id: ppd_form_id, class: 'ppd__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,promo-popup">
            <input type="email" class="ppd__field" name="contact[email]" placeholder="{{ fbs.email_placeholder | default: email_ph_default | escape }}" aria-label="{{ 'accessibility.email_placeholder' | t }}" required>
            {%- if fbs.show_phone -%}
              <input type="tel" class="ppd__field" name="contact[phone]" placeholder="{{ fbs.phone_placeholder | default: phone_ph_default | escape }}" aria-label="{{ 'accessibility.phone_placeholder' | t }}">
            {%- endif -%}
            <button type="submit" class="ppd__btn">{{ fbs.button_label | default: get_coupon_default | escape }}</button>
            {%- if form.posted_successfully? -%}
              <p class="ppd__success">{{ fbs.success_text | default: 'Check your inbox — your coupon is on the way!' | escape }}</p>
            {%- elsif form.errors -%}
              <p class="ppd__error">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if dismiss_block and dismiss_block.settings.label != blank -%}
        {%- assign dbs = dismiss_block.settings -%}
        <button type="button" class="ppd__dismiss" data-ppd-close
                style="--ppd-dismiss-color: {% render 'scheme-color', color: dbs.color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; --ppd-dismiss-hover: {% render 'scheme-color', color: dbs.hover_color, fallback: 'var(--color-text)' %}; font-size: {{ dbs.size | default: 13 }}px;"
                {{ dismiss_block.shopify_attributes }}>{{ dbs.label | escape }}</button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function(){
  function init() {
  var modal = document.getElementById('ppd-{{ sid }}');
  if (!modal || modal.__ppdInit) return;
  modal.__ppdInit = true;
  var inDesignMode = document.documentElement.classList.contains('shopify-design-mode') ||
                     (window.Shopify && window.Shopify.designMode);
  var key = 'ppd-dismissed-{{ sid }}';
  var freq = modal.getAttribute('data-frequency') || 'session';
  var trigger = modal.getAttribute('data-trigger') || 'load';
  var delay = parseFloat(modal.getAttribute('data-delay')) || 0;
  var scrollPct = parseInt(modal.getAttribute('data-scroll-pct'), 10) || 40;

  function alreadySeen() {
    if (inDesignMode) return false;
    if (freq === 'always') return false;
    try {
      if (freq === 'session') return sessionStorage.getItem(key) === '1';
      if (freq === 'once')    return localStorage.getItem(key) === '1';
    } catch(e) { return false; }
    return false;
  }
  function markSeen() {
    if (inDesignMode) return;
    try {
      if (freq === 'session') sessionStorage.setItem(key, '1');
      if (freq === 'once')    localStorage.setItem(key, '1');
    } catch(e){}
  }

  function open() {
    modal.setAttribute('data-open', 'true');
    document.body.style.overflow = 'hidden';
    var firstField = modal.querySelector('input[type="email"]');
    if (firstField) setTimeout(function(){ firstField.focus(); }, 320);
  }
  function close() {
    modal.setAttribute('data-open', 'false');
    document.body.style.overflow = '';
    markSeen();
  }

  modal.querySelectorAll('[data-ppd-close]').forEach(function(el){
    el.addEventListener('click', close);
  });
  modal.addEventListener('click', function(e){
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && modal.getAttribute('data-open') === 'true') close();
  });

  if (alreadySeen()) return;

  if (trigger === 'load') {
    setTimeout(open, Math.max(0, delay) * 1000);
  } else if (trigger === 'scroll') {
    var fired = false;
    function onScroll() {
      var doc = document.documentElement;
      var scrolled = (window.scrollY + window.innerHeight) / doc.scrollHeight * 100;
      if (scrolled >= scrollPct && !fired) {
        fired = true;
        open();
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  } else if (trigger === 'exit') {
    var fired = false;
    document.addEventListener('mouseleave', function(e) {
      if (e.clientY < 0 && !fired) { fired = true; open(); }
    });
  } else if (trigger === 'click') {
    var selector = '[data-ppd-trigger="{{ sid }}"]';
    document.querySelectorAll(selector).forEach(function(el) {
      el.addEventListener('click', function(e){ e.preventDefault(); open(); });
    });
  }

  if (inDesignMode) modal.setAttribute('data-open', 'true');
  }
  init();
  document.addEventListener('storelib:section-load', function(e){
    if (e.detail && String(e.detail.sectionId) === '{{ sid }}') init();
  });
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "promotional-popup",
  "name": "Promotion Popup Discount",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_3",
      "label": "When to open"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Open the popup on",
      "default": "load",
      "options": [
        {
          "value": "load",
          "label": "Page load (after delay)"
        },
        {
          "value": "scroll",
          "label": "Scroll percentage"
        },
        {
          "value": "exit",
          "label": "Exit intent (mouse leaves window)"
        },
        {
          "value": "click",
          "label": "Custom button click"
        }
      ]
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Page-load delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "scroll_pct",
      "label": "Scroll percentage",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show frequency",
      "default": "session",
      "options": [
        {
          "value": "session",
          "label": "Once per session"
        },
        {
          "value": "once",
          "label": "Once per visitor (remembered forever)"
        },
        {
          "value": "always",
          "label": "Every page load"
        }
      ]
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index (stacking order)",
      "min": 100,
      "max": 5000,
      "step": 50,
      "default": 1000
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "placeholder_url",
