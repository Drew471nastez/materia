<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%}
  Materia Themes — Promotion Popup Discount (Promotional Popup category).
  Block-organized popup modal: image + heading + subheading + form +
  dismiss link, each as its own block with its own settings. Every
  slider, color, and toggle is wired through to CSS via inline styles.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  assign placeholder_src = s.placeholder_url

  assign eyebrow_block  = section.blocks | where: 'type', 'eyebrow'    | first
  assign heading_block  = section.blocks | where: 'type', 'heading'    | first
  assign sub_block      = section.blocks | where: 'type', 'subheading' | first
  assign form_block     = section.blocks | where: 'type', 'form'       | first
  assign dismiss_block  = section.blocks | where: 'type', 'dismiss'    | first
-%}

<style>
  #shopify-section-{{ sid }} {
    position: relative;
    z-index: {{ s.z_index | default: 1000 }};
    isolation: isolate;
  }
  #shopify-section-{{ sid }} .ppd-backdrop {
    position: fixed; inset: 0;
    background: {{ s.backdrop_color | default: 'rgba(0,0,0,0.55)' }};
    z-index: {{ s.z_index | default: 1000 }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ s.backdrop_padding | default: 16 }}px;
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; visibility: hidden;
    transition: opacity 0.28s ease, visibility 0s linear 0.32s;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] {
    opacity: 1; visibility: visible; transition-delay: 0s;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-preview] {
    {%- assign ppd_backdrop = s.backdrop_color | default: 'rgba(0,0,0,0.55)' -%}
    background: {% render 'scheme-color', color: s.editor_preview_bg, fallback: ppd_backdrop %};
  }

  #shopify-section-{{ sid }} .ppd {
    position: relative;
    width: 100%;
    max-width: {{ s.modal_max_width | default: 760 }}px;
    background: {% render 'scheme-color', color: s.modal_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: s.modal_text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ s.modal_radius | default: 18 }}px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    margin: auto;
    transform: translateY(20px) scale(0.96);
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: grid;
    grid-template-columns: 1fr;
  }
  #shopify-section-{{ sid }} .ppd-backdrop[data-open="true"] .ppd {
    transform: translateY(0) scale(1);
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd { grid-template-columns: {{ s.image_width_pct | default: 50 }}fr {{ 100 | minus: s.image_width_pct | default: 50 }}fr; }
    {%- if s.image_position == 'right' -%}
      #shopify-section-{{ sid }} .ppd__media { order: 2; }
    {%- endif -%}
  }

  #shopify-section-{{ sid }} .ppd__media {
    position: relative;
    overflow: hidden;
    background: {% render 'scheme-color', color: s.image_bg, fallback: 'color-mix(in srgb, var(--color-heading) 10%, var(--color-background))' %};
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__media { aspect-ratio: auto; min-height: 100%; }
  }
  #shopify-section-{{ sid }} .ppd__media img,
  #shopify-section-{{ sid }} .ppd__media svg {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }

  #shopify-section-{{ sid }} .ppd__content {
    padding: {{ s.content_padding_mobile | default: 28 }}px {{ s.content_padding_mobile | default: 28 }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ s.content_gap | default: 12 }}px;
    text-align: {{ s.content_align | default: 'center' }};
    align-items: {% if s.content_align == 'left' %}flex-start{% elsif s.content_align == 'right' %}flex-end{% else %}center{% endif %};
  }
  @media (min-width: 760px) {
    #shopify-section-{{ sid }} .ppd__content { padding: {{ s.content_padding_desktop | default: 36 }}px {{ s.content_padding_desktop | default: 36 }}px; }
  }

  #shopify-section-{{ sid }} .ppd__close {
    position: absolute;
    top: {{ s.close_offset | default: 12 }}px; inset-inline-end: {{ s.close_offset | default: 12 }}px;
    z-index: 5;
    width: {{ s.close_size | default: 36 }}px;
    height: {{ s.close_size | default: 36 }}px;
    min-width: 44px; min-height: 44px;
    border: 0;
    background-color: {% render 'scheme-color', color: s.close_bg, fallback: 'color-mix(in srgb, currentColor 10%, transparent)' %};
    color: {% render 'scheme-color', color: s.close_color, fallback: 'var(--color-heading)' %};
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__close:hover {
    background-color: {% render 'scheme-color', color: s.close_bg_hover, fallback: 'color-mix(in srgb, currentColor 20%, transparent)' %};
  }
  #shopify-section-{{ sid }} .ppd__close svg { width: 16px; height: 16px; }

  /* Block elements (set inline styles per block — defaults below cover unset cases) */
  #shopify-section-{{ sid }} .ppd__eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.18em; }
  #shopify-section-{{ sid }} .ppd__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); line-height: 1.15; }
  #shopify-section-{{ sid }} .ppd__sub     { margin: 0; line-height: 1.5; }
  #shopify-section-{{ sid }} .ppd__sub p   { margin: 0 0 0.4em; }
  #shopify-section-{{ sid }} .ppd__sub p:last-child { margin: 0; }

  /* Form */
  #shopify-section-{{ sid }} .ppd__form {
    display: flex;
    flex-direction: column;
    gap: {{ s.form_gap | default: 10 }}px;
    margin-top: {{ s.form_margin_top | default: 8 }}px;
    width: 100%;
  }
  #shopify-section-{{ sid }} .ppd__field {
    width: 100%;
    min-height: var(--ppd-input-height, auto);
    border: var(--ppd-input-border-width, 0px) solid var(--color-border);
    border-radius: var(--ppd-input-radius, 10px);
    padding: var(--ppd-input-padding, 14px 16px);
    font-size: var(--ppd-input-size, 15px);
    background: var(--ppd-input-bg, var(--input-bg));
    color: var(--ppd-input-color, var(--input-color));
    outline: none;
    transition: border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .ppd__field:focus-visible { border-color: var(--color-heading); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-heading) 25%, transparent); }
  #shopify-section-{{ sid }} .ppd__field::placeholder { color: var(--ppd-input-placeholder, var(--input-placeholder-color)); }
  /* The submit is a theme button (theme-button-contract.css): Theme settings >
     Buttons draw it; colours set on the form, and the shape when the theme
     style is off, are passed as tokens by the button-overrides snippet. */
  #shopify-section-{{ sid }} .ppd__btn {
    cursor: pointer;
    width: 100%;
  }
  #shopify-section-{{ sid }} .ppd__btn:focus-visible,
  #shopify-section-{{ sid }} .ppd__close:focus-visible,
  #shopify-section-{{ sid }} .ppd__dismiss:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  #shopify-section-{{ sid }} .ppd__success {
    margin: 8px 0 0;
    font-weight: 600;
    color: var(--ppd-success-color);
    text-align: center;
  }
  #shopify-section-{{ sid }} .ppd__error {
    margin: 8px 0 0;
    font-weight: 500;
    color: var(--ppd-error-color);
    text-align: center;
  }

  /* Dismiss link */
  #shopify-section-{{ sid }} .ppd__dismiss {
    margin-top: {{ s.dismiss_margin_top | default: 6 }}px;
    background: none; border: 0; cursor: pointer;
    text-decoration: none;
    color: var(--ppd-dismiss-color);
    transition: color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
    align-self: center;
    min-height: 44px; padding: 8px 12px;
  }
  #shopify-section-{{ sid }} .ppd__dismiss:hover { text-decoration: underline; color: var(--ppd-dismiss-hover); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ppd,
    #shopify-section-{{ sid }} .ppd-backdrop,
    #shopify-section-{{ sid }} .ppd__close,
    #shopify-section-{{ sid }} .ppd__field,
    #shopify-section-{{ sid }} .ppd__dismiss { transition: none; }
    #shopify-section-{{ sid }} .ppd { transform: none; }
  }

{% comment %}{% endcomment %}</style>

{%- liquid
  case s.trigger
    when 'scroll'
      assign ppd_mode = 'scroll'
    when 'exit'
      assign ppd_mode = 'exit'
    when 'click'
      assign ppd_mode = 'manual'
    when 'pageviews'
      assign ppd_mode = 'pageviews'
    else
      assign ppd_mode = 'delay'
  endcase
-%}
{%- capture ppd_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ s.show_in_builder | json }},
   "trigger": {"mode": {{ ppd_mode | json }}, "delay": {{ s.delay | default: 3 | json }}, "scroll": {{ s.scroll_pct | default: 40 | json }}, "views": {{ s.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ s.frequency | default: 'session' | json }} } }
{%- endcapture -%}
<div
  id="ppd-{{ sid }}"
  class="ppd-backdrop"
  data-open="false"
  data-section-id="{{ sid }}"
  data-popup-root="{{ sid }}"
  data-popup-config="{{ ppd_config | strip_newlines | escape }}"
  aria-hidden="true"
>
  <div class="ppd color-{{ color_scheme }} gradient" role="dialog" aria-modal="true"{% if heading_block %} aria-labelledby="ppd-title-{{ sid }}"{% endif %} tabindex="-1">
    <button type="button" class="ppd__close" aria-label="{{ 'accessibility.close' | t }}" data-popup-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>

    <div class="ppd__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '320, 480, 640, 800, 1000' }}
      {%- else -%}
        {%- if placeholder_src != blank -%}
          <img src="{{ placeholder_src }}" alt="" loading="lazy" width="800" height="1000">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="ppd__content">
      {%- if eyebrow_block and eyebrow_block.settings.text != blank -%}
        {%- assign eb = eyebrow_block.settings -%}
        <p class="ppd__eyebrow"
           style="color: {% render 'scheme-color', color: eb.color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; font-size: {{ eb.size | default: 12 }}px; letter-spacing: {{ eb.letter_spacing | default: 0.18 }}em;"
           {{ eyebrow_block.shopify_attributes }}>{{ eb.text | escape }}</p>
      {%- endif -%}

      {%- if heading_block and heading_block.settings.text != blank -%}
        {%- assign hb = heading_block.settings -%}
        <{{ hb.tag | default: 'h2' }} class="ppd__heading" id="ppd-title-{{ sid }}"
          data-bid="{{ heading_block.id }}"
          style="color: {% render 'scheme-color', color: hb.color, fallback: 'var(--color-heading)' %}; font-size: {{ hb.size_mobile | default: 26 }}px;"
          {{ heading_block.shopify_attributes }}>{{ hb.text | escape }}</{{ hb.tag | default: 'h2' }}>
        <style>
          @media (min-width: 760px) {
            #shopify-section-{{ sid }} [data-bid="{{ heading_block.id }}"] { font-size: {{ hb.size_desktop | default: 32 }}px !important; }
          }
{% comment %}{% endcomment %}        </style>
      {%- endif -%}

      {%- if sub_block and sub_block.settings.text != blank -%}
        {%- assign subbs = sub_block.settings -%}
        <div class="ppd__sub"
             style="color: {% render 'scheme-color', color: subbs.color, fallback: 'color-mix(in srgb, var(--color-text) 85%, transparent)' %}; font-size: {{ subbs.size | default: 14 }}px;"
             {{ sub_block.shopify_attributes }}>{{ subbs.text }}</div>
      {%- endif -%}

      {%- if form_block -%}
        {%- assign fbs = form_block.settings -%}
        {%- assign ppd_form_id = 'ppd-form-' | append: form_block.id -%}
        <div class="ppd__form-wrap"
             style="
               --ppd-input-bg: {% render 'scheme-color', color: fbs.input_bg, fallback: 'var(--input-bg)' %};
               --ppd-input-color: {% render 'scheme-color', color: fbs.input_color, fallback: 'var(--input-color)' %};
               --ppd-input-placeholder: {% render 'scheme-color', color: fbs.input_placeholder_color, fallback: 'var(--input-placeholder-color)' %};
               {%- if fbs.use_theme_fields != false %}
               --ppd-input-radius: var(--input-border-radius, 10px);
               --ppd-input-height: var(--input-height, 50px);
               --ppd-input-padding: var(--input-padding, 14px 16px);
               --ppd-input-size: var(--input-font-size, 15px);
               --ppd-input-border-width: var(--inputs-border-width, 1px);
               {%- else %}
               --ppd-input-radius: {{ fbs.input_radius | default: 10 }}px;
               --ppd-input-padding: {{ fbs.input_pad_y | default: 14 }}px 16px;
               --ppd-input-size: {{ fbs.input_size | default: 15 }}px;
               {%- endif %}
               --ppd-success-color: {% render 'scheme-color', color: fbs.success_color, fallback: 'color-mix(in srgb, #2e9e57 70%, var(--color-text))' %};
               --ppd-error-color: {% render 'scheme-color', color: fbs.error_color, fallback: 'color-mix(in srgb, #e04848 70%, var(--color-text))' %};
             "
             {{ form_block.shopify_attributes }}>
          {%- assign email_ph_default = 'accessibility.email_placeholder' | t -%}
          {%- assign phone_ph_default = 'accessibility.phone_placeholder' | t -%}
          {%- assign get_coupon_default = 'accessibility.get_my_coupon' | t -%}
          <form id="{{ ppd_form_id }}" class="ppd__form" data-storelib-form="subscribe">
            <input type="email" class="ppd__field" name="email" autocomplete="email" placeholder="{{ fbs.email_placeholder | default: email_ph_default | escape }}" aria-label="{{ 'accessibility.email_placeholder' | t }}" required data-popup-autofocus>
            {%- if fbs.show_phone -%}
              <input type="tel" class="ppd__field" name="phone" autocomplete="tel" placeholder="{{ fbs.phone_placeholder | default: phone_ph_default | escape }}" aria-label="{{ 'accessibility.phone_placeholder' | t }}">
            {%- endif -%}
            {%- liquid
              assign ppd_custom = false
              assign ppd_transform = blank
              if fbs.use_theme_button == false
                assign ppd_custom = true
                assign ppd_transform = 'uppercase'
              endif
            -%}
            <button type="submit" class="ppd__btn btn-primary" data-theme-button="primary" data-sl-button style="{%- render 'button-overrides', bg: fbs.btn_bg, text: fbs.btn_color, hover_bg: fbs.btn_bg_hover, custom: ppd_custom, radius: fbs.btn_radius, padding_y: fbs.btn_pad_y, font_size: fbs.btn_size, border_width: 0, transform: ppd_transform -%}">{{ fbs.button_label | default: get_coupon_default | escape }}</button>
            <p class="ppd__success" data-storelib-success hidden>{{ fbs.success_text | default: 'Check your inbox. Your code is on the way.' | escape }}</p>
          </form>
        </div>
      {%- endif -%}

      {%- if dismiss_block and dismiss_block.settings.label != blank -%}
        {%- assign dbs = dismiss_block.settings -%}
        <button type="button" class="ppd__dismiss" data-popup-close
                style="--ppd-dismiss-color: {% render 'scheme-color', color: dbs.color, fallback: 'color-mix(in srgb, var(--color-text) 70%, transparent)' %}; --ppd-dismiss-hover: {% render 'scheme-color', color: dbs.hover_color, fallback: 'var(--color-text)' %}; font-size: {{ dbs.size | default: 13 }}px;"
                {{ dismiss_block.shopify_attributes }}>{{ dbs.label | escape }}</button>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ sid | json }};
  function setup(P){
    var modal = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!modal || modal.__ppd) return;
    modal.__ppd = true;
    var CFG = JSON.parse(modal.getAttribute('data-popup-config') || '{}');
    var form = modal.querySelector('.ppd__form');
    var api = P.register({
      id: SID, root: modal, dialog: modal.querySelector('.ppd'), backdrop: modal,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-ppd-trigger="' + SID + '"]' }, CFG.trigger),
      frequency: CFG.frequency,
      open: function(o){ if (o.preview) modal.setAttribute('data-preview', ''); modal.setAttribute('data-open', 'true'); },
      close: function(){ modal.setAttribute('data-open', 'false'); modal.removeAttribute('data-preview'); }
    });
    // Signed up: do not offer the discount again.
    if (form) new MutationObserver(function(){
      if (form.getAttribute('data-state') === 'done' && api) api.done(365);
    }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "promotional-popup",
  "name": "Signup Discount Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Opens",
      "default": "load",
      "options": [
        {
          "value": "load",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        },
        {
          "value": "exit",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "click",
          "label": "From a link"
        }
      ]
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "scroll_pct",
      "label": "Scrolled",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.trigger == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "page_views",
      "label": "Page views",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.trigger == 'pageviews' }}"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Behaviour"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show",
      "default": "session",
      "options": [
        {
          "value": "session",
          "label": "Once a visit"
        },
        {
          "value": "once",
          "label": "Once"
        },
        {
          "value": "always",
          "label": "Every page"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_in_builder",
      "label": "Show in the builder",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "placeholder_url",
      "label": "Image address (if none picked)"
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "modal_max_width",
      "label": "Width",
      "min": 360,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "modal_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "backdrop_padding",
      "label": "Space around",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_padding_desktop",
      "label": "Padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Padding on phones",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap",
      "min": 4,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
