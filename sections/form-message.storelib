<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--page-width, 1300px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
<div class="color-{{ color_scheme }}">
<div class="product-form__error-message-wrapper" role="alert" hidden>
  <div class="form__message error inline-flex align-center">
    {%- render 'icon-error' -%}
    <span class="product-form__error-message ml-5"></span>
  </div>
</div>

<div class="newsletter-form__success-message-wrapper" role="alert" hidden>
  <div
    class="mt-10 newsletter-form__message--success success form__message inline-flex align-center"
    id="ContactFooter-success"
    tabindex="-1"
  >
    {%- render 'icon-success' -%}
    <span class="newsletter-form__message ml-5">{{- 'newsletter.success' | t }}</span>
  </div>
</div>

<div class="newsletter-form__error-message-wrapper" role="alert" hidden>
  <div
    class="mt-10 newsletter-form__message--error error form__message inline-flex align-center"
    id="ContactFooter-success"
    tabindex="-1"
  >
    {%- render 'icon-error' -%}
    <span class="newsletter-form__message ml-5">{{- 'newsletter.error' | t }}</span>
  </div>
</div>
</div>
</template>

<schema>
{
  "type": "form-message",
  "name": "Form message",
  "settings": [],
  "shopify": {
    "name": "Form message",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "container"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      }
    ]
  }
}
</schema>
