<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Form messages. Never placed on a page: assets/theme.js and global.js
  ask for ?section_id=form-message and show one of these wrappers as a toast
  after a newsletter sign up or a failed add to cart. The words are the
  settings' defaults.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
<div class="ap ap-msgs color-{{ scheme }}" data-ap-root="form-message" data-ap-section="{{ sid }}"{% if request.design_mode %} data-ap-settings="{{ st | json | escape }}"{% endif %}>
  <div class="{{ st.section_width | default: 'container' }}" data-ap-width>
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <div class="form__message error inline-flex align-center">
        {%- render 'icon-error' -%}
        <span class="product-form__error-message ml-5"></span>
      </div>
    </div>
    <div class="newsletter-form__success-message-wrapper" role="status" hidden>
      <div class="mt-10 newsletter-form__message--success success form__message inline-flex align-center" tabindex="-1">
        {%- render 'icon-success' -%}
        <span class="newsletter-form__message ml-5" data-ap-text="success_text">{{ st.success_text | escape }}</span>
      </div>
    </div>
    <div class="newsletter-form__error-message-wrapper" role="alert" hidden>
      <div class="mt-10 newsletter-form__message--error error form__message inline-flex align-center" tabindex="-1">
        {%- render 'icon-error' -%}
        <span class="newsletter-form__message ml-5" data-ap-text="error_text">{{ st.error_text | escape }}</span>
      </div>
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "form-message",
  "name": "Form message",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Messages"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Newsletter success",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Newsletter error",
      "default": "That email is not valid, or it is already subscribed."
    }
  ],
  "shopify": {
    "name": "Form message",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ],
        "default": "container"
      },
      {
        "type": "header",
        "content": "Messages"
      },
      {
        "type": "text",
        "id": "success_text",
        "label": "Newsletter success",
        "default": "Thanks for subscribing."
      },
      {
        "type": "text",
        "id": "error_text",
        "label": "Newsletter error",
        "default": "That email is not valid, or it is already subscribed."
      }
    ]
  }
}
</schema>