<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false and section.settings.reveal != 'false' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger') || document.documentElement.classList.contains('shopify-design-mode') || (window.Shopify && window.Shopify.designMode)) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* === MOBILE FONT SIZE OVERRIDES ===
     Each text element gets its desktop font-size from the existing
     fs-custom / fs-medium / fs-big classes, fed by --font-size set
     inline. To give the merchant an independent MOBILE font size,
     we set a second variable inline (--font-size-mobile-sub /
     -heading / -des) and override font-size below 768px using calc()
     to convert the unitless slider value into px.

     We use !important to win over the theme's fs-custom/fs-medium/fs-big
     class rules from theme.css/critical.css which use cascaded specificity.
     This only fires on mobile, so the desktop chain stays untouched. */
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} .sec__content-subheading {
      font-size: calc(var(--font-size-mobile-sub) * 1px) !important;
      line-height: 1.3;
    }
    #shopify-section-{{ section.id }} .sec__content-heading,
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6).sec__content-heading {
      font-size: calc(var(--font-size-mobile-heading) * 1px) !important;
      line-height: 1.1;
    }
    #shopify-section-{{ section.id }} .sec__content-des,
    #shopify-section-{{ section.id }} .sec__content-des * {
      font-size: calc(var(--font-size-mobile-des) * 1px) !important;
      line-height: 1.5;
    }
  }
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'banner.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'slideshow.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'pagination-styles.css' | asset_url }}" media="print" onload="this.media='all'">
{% liquid
  assign section_st = section.settings
  assign theme_st  = settings
  assign section_width = section_st.section_width
  assign slide_height = section_st.slide_height
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign slide_effect = section_st.slide_effect
  assign pagination_position = section_st.pagination_position
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign enable_preload = theme_st.enable_preload

  comment
    Mobile font sizes — if the merchant leaves the slider at 0 (the default),
    fall back to the desktop value so behavior matches the old single-slider
    setup. Only kicks in when merchant actually moves the mobile slider.
  endcomment
  assign sub_mobile = section_st.subheading_font_size_mobile
  if sub_mobile == 0 or sub_mobile == blank
    assign sub_mobile = section_st.subheading_font_size
  endif
  assign heading_mobile = section_st.heading_font_size_mobile
  if heading_mobile == 0 or heading_mobile == blank
    assign heading_mobile = section_st.heading_font_size
  endif
  assign des_mobile = section_st.des_font_size_mobile
  if des_mobile == 0 or des_mobile == blank
    assign des_mobile = section_st.des_font_size
  endif

  comment
    Button bug fix: when 'Show content below image on mobile' is on, the
    content block sits outside the over-image context and the primary button
    loses its color-scheme background (renders solid black). We read the
    scheme's button colors straight off the color_scheme object and re-assert
    them on the button below with high specificity so it looks identical in
    both states. Scheme setting ids differ between theme versions, so we try
    the common keys defensively and fall back to a CSS variable chain.
  endcomment
  assign scheme = section_st.color_scheme
  assign sch_btn_bg = scheme.settings.button | default: scheme.settings.button_background | default: scheme.settings.solid_button_background | default: scheme.settings.primary_button_background | default: scheme.settings.bg_button | default: scheme.settings.buttons | default: scheme.settings.color_button
  assign sch_btn_text = scheme.settings.button_label | default: scheme.settings.button_text | default: scheme.settings.solid_button_text_color | default: scheme.settings.button_text_color | default: scheme.settings.on_button | default: scheme.settings.text_button
  assign sch_outline_text = scheme.settings.text | default: scheme.settings.outline_button_label | default: sch_btn_bg
%}
{%- capture video_attribute -%}
    muted autoplay
{%- endcapture -%}
{%- capture style -%}
--section-pt: {{ section_st.padding_top }};--section-pb: {{ section_st.padding_bottom }}; {%- if slide_height == 'custom' -%}
  --height: {{ section_st.mobile_height }}px;--height-desktop: {{ section_st.desktop_height }}px;
  {% endif %}
{%- endcapture -%}

{%- comment -%}
  Section-level styles: split-images layout + custom button colors override.
  Scoped to this section instance so multiple slideshows don't collide.
{%- endcomment -%}
<style>
  #{{ section.id }} .banner__media--split {
    background: transparent;
  }
  #{{ section.id }} .banner__media-split {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--split-gap, 0px);
    width: 100%;
    height: 100%;
  }
  #{{ section.id }} .banner__media-split-left,
  #{{ section.id }} .banner__media-split-right {
    position: relative;
    overflow: hidden;
    height: 100%;
  }
  #{{ section.id }} .banner__split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 767.98px) {
    #{{ section.id }} .banner__media-split {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
    #{{ section.id }} .banner__media-split--hide-mobile {
      display: none !important;
    }
  }
  /* Hide mobile-primary on desktop, show on mobile */
  #{{ section.id }} .banner__split-mobile-primary { display: none; }
  @media (max-width: 767.98px) {
    #{{ section.id }} .banner__split-mobile-primary {
      display: block;
      position: absolute; inset: 0;
      width: 100%; height: 100%;
    }
    #{{ section.id }} .banner__split-mobile-primary img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
  }
  /* ───────── Image effects (controlled by section.image_effect) ───────── */
  {%- assign fx = section_st.image_effect | default: 'none' -%}
  {%- assign fxi = section_st.image_effect_intensity | default: 5 | times: 1.0 -%}
  {%- comment -%} Integer intensity for `scale(1.NN)` / `.NN` string concatenation:
    `fxi` is a float (times: 1.0) so e.g. `1.{{ fxi | times: 2 | plus: 5 }}` would
    render `1.15.0` (two decimals = invalid CSS, declaration dropped). Use `fxn`
    wherever the value is concatenated after a literal `1.`/`.`; keep `fxi` for the
    divided_by float maths (parallax / durations). {%- endcomment -%}
  {%- assign fxn = section_st.image_effect_intensity | default: 5 -%}
  {%- comment -%} Only the transition-driven effects want the generic 1.2s transform/
     filter transition. The animation/keyframe effects (ken_burns, pan_*, zoom_pan)
     must NOT inherit it — otherwise when a slide loses .swiper-slide-active the image
     eases from its mid-keyframe transform back to the resting transform and fights
     Swiper's slide translate (a visible jolt). will-change is scoped too so it isn't
     pinned on every slide image forever. {%- endcomment -%}
  {%- assign fx_anim = 'ken_burns,pan_right,pan_left,zoom_pan' | split: ',' -%}
  {%- assign is_anim = false -%}
  {%- if fx_anim contains fx -%}{%- assign is_anim = true -%}{%- endif -%}
  {%- if fx != 'none' and is_anim == false -%}
    #{{ section.id }} .banner__media :is(img, picture, .banner__split-img) {
      will-change: transform, filter;
      transition: transform 1.2s cubic-bezier(.2,.7,.2,1), filter .8s ease;
    }
  {%- endif -%}
  {%- comment -%} Scale/pan effects: clip the magnified image so its overhang never
     bleeds over the neighbouring slide while Swiper is translating. {%- endcomment -%}
  {%- assign fx_clip = 'ken_burns,pan_right,pan_left,zoom_pan,zoom_in,zoom_out,mouse_track,blur_in,fade_in,reveal_up' | split: ',' -%}
  {%- if fx_clip contains fx -%}
    #{{ section.id }} .banner__media { overflow: hidden; }
  {%- endif -%}
  /* Slide video / iframe — fills the slide using cover behavior so
     external YouTube / Vimeo / direct .mp4 sources match the visual
     style of an image slide. Iframes can't use object-fit, so we use
     a `transform: scale + min-width/height` trick to ensure no letterbox
     bars regardless of the source aspect ratio. */
  #{{ section.id }} .banner__media video.slideshow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ section.id }} .banner__media iframe.slideshow {
    position: absolute;
    top: 50%;
    left: 50%;
    /* 177.78vh = 16:9 aspect ratio in width terms — use vmax / aspect
       trick so the iframe fully covers the slide on every screen
       ratio without black bars. */
    width: 177.78vh;
    height: 56.25vw;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%);
    border: 0;
    display: block;
    pointer-events: none;
  }
  {%- case fx -%}
    {%- when 'parallax' -%}
      /* Oversize the image so the vertical parallax shift never exposes the slide
         background as a gray bar at the top/bottom edge, and clip the overflow so the
         magnified image can't bleed onto the neighbouring slide. --scroll-y is clamped
         to ±100px (JS below), so at max intensity the shift is only ±20px — scale(1.15)
         covers it on any slide height. */
      #{{ section.id }} .banner__media { transform: translate3d(0,0,0); overflow: hidden; }
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: translateY(calc(var(--scroll-y, 0) * {{ fxi | divided_by: 50.0 }})) scale(1.15);
        will-change: transform;
      }
    {%- when 'ken_burns' -%}
      /* Resting base transform on every slide image == keyframe start, so when a
         slide loses .swiper-slide-active the animation removal eases (1s) back to
         this matching scale instead of snapping to none. No jolt against Swiper. */
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: scale(1) translate(0,0);
        transition: transform 1s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .swiper-slide-active .banner__media :is(img, picture) {
        animation: kb-{{ section.id }} {{ 14 | minus: fxi }}s ease-in-out infinite alternate;
        transition: none;
      }
      @keyframes kb-{{ section.id }} {
        0%   { transform: scale(1) translate(0,0); }
        100% { transform: scale(1.{{ fxn | times: 2 | plus: 5 }}) translate(-2%, -1%); }
      }
    {%- when 'mouse_track' -%}
      #{{ section.id }} .banner__media {
        perspective: 1200px;
      }
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: rotateX(calc(var(--mx, 0) * -{{ fxi }}deg)) rotateY(calc(var(--my, 0) * {{ fxi }}deg)) scale(1.05);
        transition: transform .35s cubic-bezier(.2,.7,.2,1);
      }
    {%- when 'zoom_in' -%}
      /* Hover zoom — snappier transition than the generic 1.2s base for a hover feel. */
      #{{ section.id }} .banner__media :is(img, picture) {
        transition: transform .6s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .banner__media:hover :is(img, picture) {
        transform: scale(1.{{ fxn | times: 2 | plus: 3 }});
      }
    {%- when 'zoom_out' -%}
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: scale(1.{{ fxn | times: 2 | plus: 3 }});
        transition: transform .6s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .banner__media:hover :is(img, picture) {
        transform: scale(1);
      }
    {%- when 'pan_right' -%}
      /* Resting transform == mid-pan (scale only) so deactivation eases to a still,
         already-zoomed frame instead of snapping back to none. */
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: scale(1.1);
        transition: transform 1s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .swiper-slide-active .banner__media :is(img, picture) {
        animation: pan-r-{{ section.id }} {{ 18 | minus: fxi }}s linear infinite alternate;
        transition: none;
      }
      @keyframes pan-r-{{ section.id }} {
        from { transform: scale(1.1) translateX(-2%); }
        to   { transform: scale(1.1) translateX(2%); }
      }
    {%- when 'pan_left' -%}
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: scale(1.1);
        transition: transform 1s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .swiper-slide-active .banner__media :is(img, picture) {
        animation: pan-l-{{ section.id }} {{ 18 | minus: fxi }}s linear infinite alternate;
        transition: none;
      }
      @keyframes pan-l-{{ section.id }} {
        from { transform: scale(1.1) translateX(2%); }
        to   { transform: scale(1.1) translateX(-2%); }
      }
    {%- when 'blur_in' -%}
      #{{ section.id }} .banner__media :is(img, picture) {
        filter: blur({{ fxi | times: 2 }}px);
        transform: scale(1.05);
      }
      #{{ section.id }} .swiper-slide-active .banner__media :is(img, picture) {
        filter: blur(0);
        transform: scale(1);
      }
    {%- when 'vignette' -%}
      /* Static vignette on every slide; the pulse runs only on the active slide so
         off-screen / incoming slides show a calm resting vignette (no mid-pulse
         flicker as a slide enters). The ::after is a separate layer that never
         touches Swiper's transform. */
      #{{ section.id }} .banner__media::after {
        content: ""; position: absolute; inset: 0;
        background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.{{ fxn | times: 5 }}) 100%);
        pointer-events: none;
        opacity: .35;
        transition: opacity .8s ease;
      }
      #{{ section.id }} .swiper-slide-active .banner__media::after {
        animation: vig-{{ section.id }} {{ 8 | minus: fxi | plus: 6 }}s ease-in-out infinite alternate;
      }
      @keyframes vig-{{ section.id }} {
        from { opacity: .35; }
        to   { opacity: 1; }
      }
    {%- when 'fade_in' -%}
      /* Glitch-free entrance: instead of a one-shot keyframe on .swiper-slide-active
         (which RESTARTS — and flickers — every time the active class is re-added on a
         rapid arrow click), we use a STABLE resting state + a SHORT INTERRUPTIBLE CSS
         transition keyed off the JS state class `.is-entering` (added on
         slideChangeTransitionStart, removed on End in global.js). A second fast click
         just re-eases the transition from its current value — no snap-back, no flicker.
         Resting state = fully visible; only while entering is the active image faded. */
      #{{ section.id }} .banner__media :is(img, picture) {
        opacity: 1;
        transform: scale(1);
        transition: opacity {{ fxi | divided_by: 10.0 | plus: 0.4 }}s ease, transform {{ fxi | divided_by: 10.0 | plus: 0.4 }}s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }}.is-entering .swiper-slide-active .banner__media :is(img, picture) {
        opacity: 0;
        transform: scale(1.04);
      }
    {%- when 'zoom_pan' -%}
      /* Cinematic combined slow zoom + diagonal drift — smoother than ken_burns.
         Resting base == keyframe 0% (scale only) so deactivation eases, no snap. */
      #{{ section.id }} .banner__media :is(img, picture) {
        transform: scale(1.04);
        transform-origin: 50% 50%;
        transition: transform 1s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }} .swiper-slide-active .banner__media :is(img, picture) {
        animation: zp-{{ section.id }} {{ 26 | minus: fxi }}s ease-in-out infinite alternate;
        transition: none;
      }
      @keyframes zp-{{ section.id }} {
        0%   { transform: scale(1.04) translate3d(-1.5%, -1%, 0); }
        50%  { transform: scale({{ fxi | times: 0.012 | plus: 1.04 }}) translate3d(0.5%, 1%, 0); }
        100% { transform: scale(1.04) translate3d(1.5%, -0.5%, 0); }
      }
    {%- when 'reveal_up' -%}
      /* Glitch-free clip-path wipe: same fix as fade_in. We drop the one-shot brev-
         keyframe (which restarted/snapped on rapid arrow clicks) for a STABLE resting
         state (clip fully open) + a SHORT INTERRUPTIBLE transition gated by `.is-entering`
         (toggled in global.js on slideChangeTransitionStart/End). A fast second click
         just re-eases the clip from where it is — no re-open snap, no flicker. */
      #{{ section.id }} .banner__media :is(img, picture) {
        clip-path: inset(0 0 0 0);
        transform: scale(1);
        transition: clip-path {{ fxi | divided_by: 8.0 | plus: 0.5 }}s cubic-bezier(.2,.7,.2,1), transform {{ fxi | divided_by: 8.0 | plus: 0.5 }}s cubic-bezier(.2,.7,.2,1);
      }
      #{{ section.id }}.is-entering .swiper-slide-active .banner__media :is(img, picture) {
        clip-path: inset({{ fxi | times: 8 | plus: 12 }}% 0 0 0);
        transform: scale(1.04);
      }
  {%- endcase -%}
  /* Premium slide-transition easing for the Swiper horizontal/creative move.
     Scoped to this section only. `.is-entering` is toggled by global.js for the
     duration of a slide change so the entrance image-effects (fade_in / reveal_up)
     use a stable, interruptible transition instead of a restartable keyframe. */
  #{{ section.id }} .swiper-wrapper {
    transition-timing-function: cubic-bezier(.22,.61,.36,1);
  }
  /* Steady first paint: before the slider script starts, show only the first
     slide at its final size, so the hero never stacks, flashes or jumps. */
  #{{ section.id }} slide-section:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    overflow: hidden;
  }
  #{{ section.id }} slide-section:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 100%;
    width: 100%;
  }
  #{{ section.id }} slide-section:not(.swiper-initialized) .swiper-slide ~ .swiper-slide {
    visibility: hidden;
  }
  #{{ section.id }} slide-section:not(.swiper-initialized) :is(.swiper-pagination, .swiper-button-next, .swiper-button-prev) {
    opacity: 0;
  }
  #{{ section.id }} :is(.swiper-pagination, .swiper-button-next, .swiper-button-prev) {
    transition: opacity .3s ease;
  }
  #{{ section.id }} .banner__media :is(img, video) {
    backface-visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ section.id }} .banner__media :is(img, picture, .banner__split-img) {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      clip-path: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
    #{{ section.id }} .banner__media::after {
      animation: none !important;
    }
  }
  {%- if section_st.btn_custom_enable -%}
  /* Custom button colors — overrides theme color scheme for this slideshow only */
  #{{ section.id }} .sec__content .btn,
  #{{ section.id }} .sec__content .btn-primary,
  #{{ section.id }} .sec__content .btn-outline {
    border-radius: {{ section_st.btn_radius_override | default: 8 }}px !important;
    padding: {{ section_st.btn_padding_y_override | default: 14 }}px {{ section_st.btn_padding_x_override | default: 26 }}px !important;
    text-transform: {{ section_st.btn_text_transform_override | default: 'none' }} !important;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .25s ease;
  }
  #{{ section.id }} .sec__content .btn-primary {
    {% if section_st.btn_first_bg     != blank %}background: {{ section_st.btn_first_bg }} !important;{% endif %}
    {% if section_st.btn_first_text   != blank %}color: {{ section_st.btn_first_text }} !important;{% endif %}
    {% if section_st.btn_first_border != blank %}border-color: {{ section_st.btn_first_border }} !important;{% endif %}
  }
  #{{ section.id }} .sec__content .btn-primary:hover,
  #{{ section.id }} .sec__content .btn-primary:focus-visible {
    {% if section_st.btn_first_bg_hover   != blank %}background: {{ section_st.btn_first_bg_hover }} !important;{% endif %}
    {% if section_st.btn_first_text_hover != blank %}color: {{ section_st.btn_first_text_hover }} !important;{% endif %}
  }
  #{{ section.id }} .sec__content .btn-outline {
    {% if section_st.btn_second_bg     != blank %}background: {{ section_st.btn_second_bg }} !important;{% endif %}
    {% if section_st.btn_second_text   != blank %}color: {{ section_st.btn_second_text }} !important;{% endif %}
    {% if section_st.btn_second_border != blank %}border-color: {{ section_st.btn_second_border }} !important;{% endif %}
  }
  #{{ section.id }} .sec__content .btn-outline:hover,
  #{{ section.id }} .sec__content .btn-outline:focus-visible {
    {% if section_st.btn_second_bg_hover   != blank %}background: {{ section_st.btn_second_bg_hover }} !important;{% endif %}
    {% if section_st.btn_second_text_hover != blank %}color: {{ section_st.btn_second_text_hover }} !important;{% endif %}
  }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Primary button color-scheme fix + trust-badge styling.
  The button rule is gated by `unless btn_custom_enable` so the manual
  override above still wins when it's turned on. Single-ID specificity
  (#section-id) beats the theme defaults but stays below the per-slide
  custom-color rules (which use #section-id + [data-slide-id]), so a
  merchant's per-slide button colour still takes priority.
{%- endcomment -%}
<style>
  {%- unless section_st.btn_custom_enable -%}
  #{{ section.id }} .sec__content .btn-primary,
  #{{ section.id }} .sec__content .btn-primary:link,
  #{{ section.id }} .sec__content .btn-primary:visited {
    {%- if sch_btn_bg != blank %}
    background: {{ sch_btn_bg }} !important;
    background-color: {{ sch_btn_bg }} !important;
    border-color: {{ sch_btn_bg }} !important;
    {%- else %}
    background: var(--btn-background, var(--button-background, var(--colors-button, var(--btn-bg, var(--button, var(--accent)))))) !important;
    border-color: var(--btn-background, var(--button-background, var(--colors-button, var(--btn-bg, var(--button, var(--accent)))))) !important;
    {%- endif %}
    {%- if sch_btn_text != blank %}
    color: {{ sch_btn_text }} !important;
    {%- endif %}
  }
  #{{ section.id }} .sec__content .btn-outline,
  #{{ section.id }} .sec__content .btn-outline:link,
  #{{ section.id }} .sec__content .btn-outline:visited {
    {%- if sch_outline_text != blank %}
    color: {{ sch_outline_text }} !important;
    border-color: {{ sch_outline_text }} !important;
    {%- endif %}
  }
  {%- endunless -%}

  /* Trust badges / social proof */
  #{{ section.id }} .banner__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--badge-gap, 12px);
    margin-top: var(--badge-space-above, 18px);
    margin-bottom: var(--badge-space-below, 0px);
  }
  #{{ section.id }} .banner__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--badge-fs, 14px);
    line-height: 1.25;
    color: var(--badge-text, inherit);
  }
  #{{ section.id }} .banner__badge-text {
    font-weight: var(--badge-weight, 500);
    letter-spacing: .2px;
  }
  #{{ section.id }} .banner__badge svg {
    width: calc(var(--badge-fs, 14px) + 7px);
    height: calc(var(--badge-fs, 14px) + 7px);
    flex: 0 0 auto;
    color: var(--badge-accent, #f5a623);
    stroke: currentColor;
  }
  /* Star rating widget — empty row + clipped gold overlay for half stars */
  #{{ section.id }} .badge-stars {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    line-height: 1;
    font-size: calc(var(--badge-fs, 14px) + 3px);
    letter-spacing: 1px;
  }
  #{{ section.id }} .badge-stars__bg {
    color: var(--badge-star-empty, color-mix(in srgb, var(--badge-accent, #f5a623) 28%, transparent));
  }
  #{{ section.id }} .badge-stars__fg {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--badge-accent, #f5a623);
  }
{% comment %}{% endcomment %}</style>

{%- if section_st.image_effect == 'parallax' or section_st.image_effect == 'mouse_track' -%}
<script>
  (function(){
    var section = document.getElementById({{ section.id | json }});
    if (!section) return;
    var fx = {{ section_st.image_effect | json }};
    if (fx === 'parallax') {
      var raf = null;
      var update = function(){
        var rect = section.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var progress = Math.max(-1, Math.min(1, (rect.top - vh / 2) / vh));
        section.style.setProperty('--scroll-y', (progress * 100) + 'px');
        raf = null;
      };
      window.addEventListener('scroll', function(){
        if (!raf) raf = requestAnimationFrame(update);
      }, { passive: true });
      update();
    }
    if (fx === 'mouse_track') {
      section.querySelectorAll('.banner__media').forEach(function(el){
        el.addEventListener('mousemove', function(e){
          var rect = el.getBoundingClientRect();
          var mx = (e.clientX - rect.left) / rect.width - 0.5;
          var my = (e.clientY - rect.top) / rect.height - 0.5;
          el.style.setProperty('--mx', mx);
          el.style.setProperty('--my', my);
        });
        el.addEventListener('mouseleave', function(){
          el.style.setProperty('--mx', 0);
          el.style.setProperty('--my', 0);
        });
      });
    }
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

<div
  id="{{ section.id }}"
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} gradient slideshow {{ slide_effect }} color-{{ color_scheme }}{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
  data-id="{{ section.id }}"
>
  <div class="{{ section_width }}">
    {% if section.blocks.size > 0 %}
      <slide-section
        id="swiper-{{ section.id }}"
        class="swiper slideshow   lazy-loading-swiper-before"
        data-section-id="{{ section.id }}"
        data-autoplay="{{ autoplay }}"
        data-autoplay-speed="{{ autorotate_speed }}"
        data-effect="{{ slide_effect }}"
        data-pagination-style="{{ section_st.pagination_style | default: 'dot' }}"
        data-loop="true"
        data-speed="700"
        data-slideshow="1"
        data-mobile="1"
        data-tablet="1"
        data-desktop="1"
      >
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign block_st = block.settings
              assign image = block_st.image
              assign image_mobile = block_st.image_mobile | default: image
              assign slider_effect = block_st.slider_effect
              assign local_video = block_st.local_video
              assign video_url   = block_st.video_url
              assign lazy_load = false
              assign slide_loading = 'lazy'
              assign ratio_dk = ''
              assign ratio_mb = ''
              if slide_height == 'adapt' or slide_height == 'full_screen'
                if section.blocks.first.settings.image != blank and section.blocks.first.settings.image_mobile != blank
                  assign ratio_dk = section.blocks.first.settings.image.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image_mobile.aspect_ratio | default: ratio_dk
                elsif section.blocks.first.settings.image == blank and section.blocks.first.settings.image_mobile != blank
                  assign ratio_dk = section.blocks.first.settings.image_mobile.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image_mobile.aspect_ratio
                elsif section.blocks.first.settings.image != blank and section.blocks.first.settings.image_mobile == blank
                  assign ratio_dk = section.blocks.first.settings.image.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image.aspect_ratio
                elsif section.blocks.first.settings.local_video != blank
                  assign ratio_dk = section.blocks.first.settings.local_video.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.local_video.aspect_ratio
                else
                  assign ratio_dk = '3/2'
                  assign ratio_mb = '2/3'
                endif
              else
                assign ratio_dk = '3/2'
                assign ratio_mb = '2/3'
              endif
              if forloop.first
                assign lazy_load = true
                assign slide_loading = 'eager'
              endif
              assign demo_src = ''
              assign demo_src_mobile = ''
              if block_st.image == blank and block_st.image_mobile == blank and block_st.local_video == blank and block_st.video_url == blank
                assign demo_mobile_key = block.id | append: '_mobile'
                capture demo_src
                  render 'demo-image', key: block.id
                endcapture
                assign demo_src = demo_src | strip
                capture demo_src_mobile
                  render 'demo-image', key: demo_mobile_key
                endcapture
                assign demo_src_mobile = demo_src_mobile | strip
              endif
            %}
            <div {{ block.shopify_attributes }} class="swiper-slide" data-slide-id="{{ block.id }}">
              {%- comment -%}
                Per-slide FONT FAMILY overrides — gated by `enable_custom_fonts`.
                Same scoping pattern as the colour overrides: scoped via
                [data-slide-id] + #section-id ancestor so each slide is
                independent. The `font_face` filter outputs raw
                `@font-face {...}` CSS text — it MUST live inside a
                `<style>` element or the browser renders it as text.
                (Previous version emitted it outside the style tag,
                which is the bug the merchant reported.)
              {%- endcomment -%}
              {%- if block_st.enable_custom_fonts -%}
                <style>
                  {%- if block_st.subheading_font %}{{ block_st.subheading_font | font_face: font_display: 'swap' }}{% endif -%}
                  {%- if block_st.heading_font    %}{{ block_st.heading_font    | font_face: font_display: 'swap' }}{% endif -%}
                  {%- if block_st.description_font %}{{ block_st.description_font | font_face: font_display: 'swap' }}{% endif -%}
                  {%- if block_st.subheading_font -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-subheading,
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-subheading * {
                    font-family: {{ block_st.subheading_font.family }}, {{ block_st.subheading_font.fallback_families }} !important;
                    font-style: {{ block_st.subheading_font.style }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.heading_font -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6, .sec__content-heading),
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6) * {
                    font-family: {{ block_st.heading_font.family }}, {{ block_st.heading_font.fallback_families }} !important;
                    font-style: {{ block_st.heading_font.style }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.description_font -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des,
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des * {
                    font-family: {{ block_st.description_font.family }}, {{ block_st.description_font.fallback_families }} !important;
                    font-style: {{ block_st.description_font.style }} !important;
                  }
                  {%- endif -%}
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

              {%- comment -%}
                Per-slide FONT WEIGHT overrides — independent toggle so
                merchants can override just the weights without changing
                the family (e.g. make the same font lighter/heavier for
                this one slide).
              {%- endcomment -%}
              {%- if block_st.enable_custom_font_weights -%}
                <style>
                  {%- if block_st.subheading_weight != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-subheading,
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-subheading * {
                    font-weight: {{ block_st.subheading_weight }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.heading_weight != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6, .sec__content-heading),
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6) * {
                    font-weight: {{ block_st.heading_weight }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.description_weight != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des,
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des * {
                    font-weight: {{ block_st.description_weight }} !important;
                  }
                  {%- endif -%}
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

              {%- if block_st.enable_custom_colors -%}
                {%- comment -%}
                  Per-slide colour overrides. Scoped via [data-slide-id]
                  attribute selector + #section-id ancestor so they only
                  affect THIS slide, never bleed to other slides or to
                  the section-level scheme defaults. !important wins
                  over the cascaded `.btn-primary` rules from theme.css
                  / critical.css without needing to re-architect them.
                {%- endcomment -%}
                <style>
                  {%- if block_st.subheading_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-subheading {
                    color: {{ block_st.subheading_color }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.heading_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6, .heading-color, .sec__content-heading),
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] :is(h1, h2, h3, h4, h5, h6) * {
                    color: {{ block_st.heading_color }} !important;
                  }
                  {%- endif -%}
                  {%- if block_st.description_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des,
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-des * {
                    color: {{ block_st.description_color }} !important;
                  }
                  {%- endif -%}

                  {%- comment -%} First button — primary or outline {%- endcomment -%}
                  {%- if block_st.first_button_bg != blank or block_st.first_button_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-btn > a:nth-of-type(1):is(.btn-primary, .btn-outline) {
                    {%- if block_st.first_button_bg    != blank -%}background: {{ block_st.first_button_bg }} !important; border-color: {{ block_st.first_button_bg }} !important;{%- endif -%}
                    {%- if block_st.first_button_color != blank -%}color: {{ block_st.first_button_color }} !important;{%- endif -%}
                  }
                  {%- endif -%}
                  {%- if block_st.first_button_hover_bg != blank or block_st.first_button_hover_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-btn > a:nth-of-type(1):is(.btn-primary, .btn-outline):hover {
                    {%- if block_st.first_button_hover_bg    != blank -%}background: {{ block_st.first_button_hover_bg }} !important; border-color: {{ block_st.first_button_hover_bg }} !important;{%- endif -%}
                    {%- if block_st.first_button_hover_color != blank -%}color: {{ block_st.first_button_hover_color }} !important;{%- endif -%}
                  }
                  {%- endif -%}

                  {%- comment -%} Second button {%- endcomment -%}
                  {%- if block_st.second_button_bg != blank or block_st.second_button_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-btn > a:nth-of-type(2):is(.btn-primary, .btn-outline) {
                    {%- if block_st.second_button_bg    != blank -%}background: {{ block_st.second_button_bg }} !important; border-color: {{ block_st.second_button_bg }} !important;{%- endif -%}
                    {%- if block_st.second_button_color != blank -%}color: {{ block_st.second_button_color }} !important;{%- endif -%}
                  }
                  {%- endif -%}
                  {%- if block_st.second_button_hover_bg != blank or block_st.second_button_hover_color != blank -%}
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-btn > a:nth-of-type(2):is(.btn-primary, .btn-outline):hover {
                    {%- if block_st.second_button_hover_bg    != blank -%}background: {{ block_st.second_button_hover_bg }} !important; border-color: {{ block_st.second_button_hover_bg }} !important;{%- endif -%}
                    {%- if block_st.second_button_hover_color != blank -%}color: {{ block_st.second_button_hover_color }} !important;{%- endif -%}
                  }
                  {%- endif -%}
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

              {%- comment -%}
                Accent heading words. When enabled, each word the merchant
                typed in `accent_heading_text` is matched (case-insensitive,
                punctuation-tolerant) against the heading and wrapped in a
                .hero-accent span that gets its own colour / italic. Scoped
                per slide and given higher specificity than the per-slide
                heading colour override so the accent colour always wins.
              {%- endcomment -%}
              {%- if block_st.enable_accent_heading -%}
                <style>
                  #{{ section.id }} [data-slide-id="{{ block.id }}"] .sec__content-heading .hero-accent {
                    {%- if block_st.accent_heading_color != blank %}color: {{ block_st.accent_heading_color }} !important;{% endif %}
                    {%- if block_st.accent_heading_italic %}font-style: italic !important;{% endif %}
                  }
{% comment %}{% endcomment %}                </style>
              {%- endif -%}

              {%- comment -%}
                Trust badges / social proof for THIS slide. Built once into
                badges_html, then printed at the chosen position (above the
                subheading, below the description, or below the buttons).
                Each of the 3 slots can be a star rating, an icon + text, or
                plain text. Star fill is rating / 5, so 4.5 = 90% gold.
              {%- endcomment -%}
              {%- liquid
                assign show_badges = false
                if block_st.enable_trust_badges
                  if block_st.badge_1_type != 'none' or block_st.badge_2_type != 'none' or block_st.badge_3_type != 'none'
                    assign show_badges = true
                  endif
                endif
                assign badge_pos = block_st.trust_badge_position | default: 'below_buttons'
              -%}
              {%- capture badges_html -%}
                {%- if show_badges -%}
                  <motion-element
                    data-motion="fade-up-lg"
                    hold
                    data-motion-delay="450"
                    class="banner__badges flex flex-wrap align-center gap-15 justify-content-{{ block_st.content_alignment_mobile }} justify-content-md-{{ block_st.content_alignment }}"
                    style="--badge-accent: {{ block_st.trust_badge_accent_color | default: '#f5a623' }};{% if block_st.trust_badge_star_empty_color != blank %}--badge-star-empty: {{ block_st.trust_badge_star_empty_color }};{% endif %}{% if block_st.trust_badge_text_color != blank %}--badge-text: {{ block_st.trust_badge_text_color }};{% endif %}--badge-fs: {{ block_st.trust_badge_font_size | default: 14 }}px;--badge-weight: {{ block_st.badge_text_weight | default: 500 }};--badge-gap: {{ block_st.trust_badge_gap | default: 12 }}px;--badge-space-above: {{ block_st.trust_badge_space_above | default: 18 }}px;--badge-space-below: {{ block_st.trust_badge_space_below | default: 0 }}px;"
                  >
                    {%- for n in (1..3) -%}
                      {%- liquid
                        case n
                          when 1
                            assign b_type = block_st.badge_1_type
                            assign b_rating = block_st.badge_1_rating
                            assign b_icon = block_st.badge_1_icon
                            assign b_text = block_st.badge_1_text
                          when 2
                            assign b_type = block_st.badge_2_type
                            assign b_rating = block_st.badge_2_rating
                            assign b_icon = block_st.badge_2_icon
                            assign b_text = block_st.badge_2_text
                          when 3
                            assign b_type = block_st.badge_3_type
                            assign b_rating = block_st.badge_3_rating
                            assign b_icon = block_st.badge_3_icon
                            assign b_text = block_st.badge_3_text
                        endcase
                        assign star_fill = b_rating | times: 20
                      -%}
                      {%- if b_type == 'stars' -%}
                        <span class="banner__badge">
                          <span class="badge-stars" role="img" aria-label="{{ b_rating }} out of 5 stars">
                            <span class="badge-stars__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                            <span class="badge-stars__fg" style="width: {{ star_fill }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                          </span>
                          {%- if b_text != blank -%}<span class="banner__badge-text">{{ b_text }}</span>{%- endif -%}
                        </span>
                      {%- elsif b_type == 'icon' -%}
                        <span class="banner__badge">
                          {%- case b_icon -%}
                            {%- when 'shield_check' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                            {%- when 'refresh' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
                            {%- when 'truck' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6H1v12h13z"/><path d="M14 9h4l3 3v6h-7"/><circle cx="6.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                            {%- when 'users' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {%- when 'lock' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            {%- when 'heart' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                            {%- when 'leaf' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 4 13c0-6 7-9 16-9 0 9-3 16-9 16z"/><path d="M4 20c2.5-4 6-7 12-9"/></svg>
                            {%- when 'medal' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="14" r="6"/><path d="m9 8-3-6"/><path d="m15 8 3-6"/><path d="m12 12 1 2 2 .2-1.5 1.4.4 2-1.9-1-1.9 1 .4-2L10 14.2 12 14z"/></svg>
                            {%- when 'clock' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            {%- when 'tag' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h6.6a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                            {%- else -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                          {%- endcase -%}
                          {%- if b_text != blank -%}<span class="banner__badge-text">{{ b_text }}</span>{%- endif -%}
                        </span>
                      {%- elsif b_type == 'text' -%}
                        {%- if b_text != blank -%}
                          <span class="banner__badge"><span class="banner__badge-text">{{ b_text }}</span></span>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </motion-element>
                {%- endif -%}
              {%- endcapture -%}
              <div
                class="sec__inner flex relative{% if section_st.content_below_image %} flex-column flex-md-row text-below-mb{% endif %}{% if slide_height == 'adapt' and image_mobile != blank %} ratio-mobile{% endif %} h-{{ slide_height }}"
                style="--overlay-opacity: {{ block_st.overlay_opacity }}%;{% if slide_height == 'adapt' or  slide_height == 'full_screen' %}--aspect-ratio: {{ ratio_dk }};--aspect-ratio-mb: {{ ratio_mb }};{% endif %}"
              >
                <div
                  class="banner__media w-full overlay-bg{% if section_st.section_width != "full_width" %} rounded{% endif %}{% if section_st.content_below_image %} absolute-md mb-40 mb-md-0{% else %} absolute{% endif %} inset-0{% if slide_height == 'adapt' and image_mobile != blank %} ratio-mobile{% endif %}{% if slide_height == 'full_screen' %} h-{{ slide_height }}{% endif %}{% if block_st.split_images_enable %} banner__media--split{% endif %}"
                  style="--aspect-ratio: {{ ratio_dk }};--aspect-ratio-mb: {{ ratio_mb }};--point:{{ image.presentation.focal_point }};{% if block_st.split_images_enable %} --split-gap: {{ block_st.split_gap | default: 0 }}px;{% endif %}"
                >
                  {%- if block_st.split_images_enable -%}
                    {%- comment -%}
                      If 'mobile show primary' is on AND a mobile primary image is set,
                      render that single image on mobile via a separate <picture> wrapper.
                      The split layout still renders for ≥768px via CSS.
                    {%- endcomment -%}
                    {%- if block_st.split_mobile_use_primary and block_st.split_mobile_primary_image != blank -%}
                      <picture class="banner__split-mobile-primary">
                        <source media="(min-width: 768px)" srcset="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'/>">
                        <img src="{{ block_st.split_mobile_primary_image | image_url: width: 800 }}"
                             srcset="{{ block_st.split_mobile_primary_image | image_url: width: 600 }} 600w, {{ block_st.split_mobile_primary_image | image_url: width: 800 }} 800w, {{ block_st.split_mobile_primary_image | image_url: width: 1200 }} 1200w"
                             sizes="100vw"
                             alt="{{ block_st.heading | escape }}"
                             loading="{{ slide_loading }}"
                             class="banner__split-img">
                      </picture>
                    {%- endif -%}
                    <div class="banner__media-split{% if block_st.split_mobile_use_primary %} banner__media-split--hide-mobile{% endif %}">
                      <div class="banner__media-split-left">
                        {%- if block_st.image_split_left != blank -%}
                          {{ block_st.image_split_left | image_url: width: 1200 | image_tag: alt: block_st.heading, class: 'banner__split-img', loading: slide_loading, widths: '600, 900, 1200, 1600' }}
                        {%- else -%}
                          {%- render 'placeholder-render', class: 'absolute inset-0 w-full h-full object-fit-cover' -%}
                        {%- endif -%}
                      </div>
                      <div class="banner__media-split-right">
                        {%- if block_st.image_split_right != blank -%}
                          {{ block_st.image_split_right | image_url: width: 1200 | image_tag: alt: block_st.heading, class: 'banner__split-img', loading: slide_loading, widths: '600, 900, 1200, 1600' }}
                        {%- else -%}
                          {%- render 'placeholder-render', class: 'absolute inset-0 w-full h-full object-fit-cover' -%}
                        {%- endif -%}
                      </div>
                    </div>
                  {%- elsif image != blank or image_mobile != blank or local_video != blank or video_url != blank -%}
                    {% if local_video != blank %}
                      {%- liquid
                        assign source = local_video.sources
                        assign source_url = ''
                        for s in source
                          if s.format == 'mp4'
                            assign source_url = s.url
                            break
                          endif
                        endfor
                        assign poster = local_video.preview_image | image_url: width: 1100
                      -%}
                      <video
                        class="slideshow"
                        loop="true"
                        data-src="{{ source_url }}"
                        poster="{{ poster }}"
                        playsinline="true"
                        {{ video_attribute }}
                      ></video>
                    {%- elsif video_url != blank -%}
                      {%- comment -%}
                        External video URL — auto-detect YouTube, Vimeo,
                        or a direct file URL (mp4/webm/mov). Each gets
                        the embed markup native to its host so autoplay,
                        loop, mute and playsinline work everywhere.

                        YouTube loop requires `playlist={video_id}` —
                        a quirk of their embed player; without it the
                        video only plays once.
                      {%- endcomment -%}
                      {%- liquid
                        assign vu_lower = video_url | downcase
                        assign yt_id = ''
                        assign vimeo_id = ''
                        if vu_lower contains 'youtube.com/watch'
                          assign yt_id = video_url | split: 'v=' | last | split: '&' | first
                        elsif vu_lower contains 'youtu.be/'
                          assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
                        elsif vu_lower contains 'youtube.com/embed/'
                          assign yt_id = video_url | split: 'embed/' | last | split: '?' | first
                        elsif vu_lower contains 'youtube.com/shorts/'
                          assign yt_id = video_url | split: 'shorts/' | last | split: '?' | first
                        elsif vu_lower contains 'vimeo.com/'
                          assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last
                        endif
                        assign poster_url = ''
                        if image != blank
                          assign poster_url = image | image_url: width: 1200
                        endif
                      -%}
                      {%- if yt_id != '' -%}
                        <iframe
                          class="slideshow"
                          src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&playlist={{ yt_id }}"
                          title="{{ block_st.heading | escape }}"
                          frameborder="0"
                          allow="autoplay; encrypted-media; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        ></iframe>
                      {%- elsif vimeo_id != '' -%}
                        <iframe
                          class="slideshow"
                          src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&playsinline=1&autopause=0"
                          title="{{ block_st.heading | escape }}"
                          frameborder="0"
                          allow="autoplay; encrypted-media; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                        ></iframe>
                      {%- else -%}
                        {%- comment -%} Treat as a direct video file URL (.mp4 / .webm / .mov) {%- endcomment -%}
                        <video
                          class="slideshow"
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          {% if poster_url != '' %}poster="{{ poster_url }}"{% endif %}
                        >
                          <source src="{{ video_url }}">
                        </video>
                      {%- endif -%}
                    {% else %}
                      {%- liquid
                        if block.settings.image.alt == blank
                          assign image_alt = block.settings.heading
                        else
                          assign image_alt = block.settings.image.alt
                        endif
                      -%}
                        {% render 'responsive-image',
                          type: 'banner',
                          container: section_width,
                          image: image,
                          image_mobile: image_mobile,
                          image_alt: image_alt,
                          lazy_load: lazy_load,
                          no_animate: true,
                          first: forloop.first
                        %}
                    {% endif %}
                  {%- elsif demo_src != blank -%}
                    {%- if demo_src_mobile != blank -%}
                      <picture>
                        <source media="(max-width: 767px)" srcset="{{ demo_src_mobile }}">
                        <img src="{{ demo_src }}" alt="{{ block_st.heading | escape }}" class="absolute inset-0 w-full h-full object-fit-cover" loading="{{ slide_loading }}">
                      </picture>
                    {%- else -%}
                      <img src="{{ demo_src }}" alt="{{ block_st.heading | escape }}" class="absolute inset-0 w-full h-full object-fit-cover" loading="{{ slide_loading }}">
                    {%- endif -%}
                  {%- else -%}
                    {%- render 'placeholder-render', class: 'absolute inset-0 w-full h-full object-fit-cover' -%}
                  {% endif %}
                </div>
                {% if block_st.heading != blank
                  or block_st.subheading != blank
                  or block_st.description != blank
                  or block_st.first_button_label != blank
                  or block_st.second_button_label != blank
                %}
                  <div
                    class="sec__content relative z-1 flex{% if block_st.content_width == 'full_width' %} w-full{% else %} w-1024-full{% endif %} {{ block_st.content_position_mobile | default: block_st.content_position }} pos-md-{{ block_st.content_position }} {{ block_st.content_width }} text-{{block_st.content_alignment_mobile}} text-md-{{ block_st.content_alignment }}{% if block_st.show_content_background %} py-custom px-custom{% if block_st.content_padding_inline < 15 %} min-value{% endif %}{% endif %}"
                    style="--padding-inline: {{ block_st.content_padding_inline }};--padding-block: {{ block_st.content_padding_block }};"
                  >
                    <div
                      class="sec__content-inner w-full w-md-unset invisible max-w-custom{% if section_st.content_below_image %} w-full w-md-unset{% endif %}{% if block_st.show_content_background == blank %} py-custom px-custom{% if block_st.content_padding_inline < 15 %} min-value{% endif %}{% endif %}{% if block_st.show_content_background %} content-box relative p-30 p-1025-50{% endif %} {{ slider_effect }}"
                      style="--max-width: {{ block_st.content_max_width }}%;{% if block_st.show_content_background %}--content-bg: {{ block_st.content_background}}; --opacity:{{ block_st.content_box_opacity }}%;{% endif %}"
                    >
                      {%- if show_badges and badge_pos == 'above_subheading' -%}{{ badges_html }}{%- endif -%}
                      {% if block_st.subheading != blank %}
                        <motion-element
                          data-motion="fade-up-lg"                   
                              hold                                     
                          data-motion-delay="100"
                          class="sec__content-subheading  {% if block_st.slider_effect == 'effect_fadeinup' %} opacity-0  {{ slider_effect }}  {% endif %}  block heading{% if section_st.subheading_spacing_bottom > 41 %} mb-big{% elsif section_st.subheading_spacing_bottom > 30 %} mb-medium {% else %} mb-custom{% endif %} fs-custom {{ section_st.subheading_font_weight }}"
                          style="--font-size: {{ section_st.subheading_font_size }};--font-size-mobile-sub: {{ sub_mobile }};--space-bottom: {{ section_st.subheading_spacing_bottom }}"
                        >
                          
                          {{ block_st.subheading | escape }}
                        </motion-element>
                      {% endif %}
                      {% if block_st.heading != blank %}
                        {%- liquid
                          assign heading_display = block_st.heading
                          if block_st.enable_accent_heading and block_st.accent_heading_text != blank
                            assign accent_set = block_st.accent_heading_text | downcase | split: ' '
                            assign h_words = block_st.heading | split: ' '
                            assign heading_display = ''
                            for w in h_words
                              assign cmp = w | downcase | replace: ',', '' | replace: '.', '' | replace: '!', '' | replace: '?', '' | replace: ':', '' | replace: ';', '' | strip
                              assign is_acc = false
                              for aw in accent_set
                                assign aw2 = aw | strip
                                if aw2 != blank and cmp == aw2
                                  assign is_acc = true
                                  break
                                endif
                              endfor
                              if is_acc
                                assign piece = '<span class="hero-accent">' | append: w | append: '</span>'
                              else
                                assign piece = w
                              endif
                              if forloop.first
                                assign heading_display = piece
                              else
                                assign heading_display = heading_display | append: ' ' | append: piece
                              endif
                            endfor
                          endif
                        -%}
                        <motion-element
                          data-motion="fade-up-lg"
                            hold
                          data-motion-delay="200"
                          class="block  {% if block_st.slider_effect == 'effect_fadeinup' %} opacity-0 {{ slider_effect }} {% endif %}"
                        >
                          <h2
                            class="sec__content-heading   heading-letter-spacing mt-0{% if section_st.heading_spacing_bottom > 41 %} mb-big{% elsif section_st.heading_spacing_bottom > 30 %} mb-medium {% else %} mb-custom{% endif %}{% if section_st.heading_uppercase %} uppercase{% endif %}{% if section_st.heading_font_size > 41 %} fs-big{% elsif section_st.heading_font_size > 24 %} fs-medium{% else %} fs-custom{% endif %} {{ section_st.heading_font_weight }}"
                            style="--font-size: {{ section_st.heading_font_size }};--font-size-mobile-heading: {{ heading_mobile }};--space-bottom: {{ section_st.heading_spacing_bottom }}"
                            {{ block.shopify_attributes }}
                          >
                            {{ heading_display }}
                          </h2>
                        </motion-element>
                      {% endif %}
                      {% if block_st.description != blank %}
                        <motion-element
                          data-motion="fade-up-lg"                     
                            hold                 
                          data-motion-delay="300"
                          class="sec__content-des {% if block_st.slider_effect == 'effect_fadeinup' %} opacity-0  {{ slider_effect }}  {% endif %} block rich__text-m0 {% if section_st.des_spacing_bottom > 41 %} mb-big{% elsif section_st.des_spacing_bottom > 30 %} mb-medium {% else %} mb-custom{% endif %}{% if section_st.des_font_size > 24 %} fs-medium{% else %} fs-custom{% endif %} {{ section_st.des_font_weight }}"
                          style="--font-size: {{ section_st.des_font_size }};--font-size-mobile-des: {{ des_mobile }};--space-bottom: {{ section_st.des_spacing_bottom }}"
                          {{ block.shopify_attributes }}
                        >
                          {{ block_st.description }}
                        </motion-element>
                      {% endif %}
                      {%- if show_badges and badge_pos == 'below_description' -%}{{ badges_html }}{%- endif -%}
                      {% if block_st.first_button_label != blank or block_st.second_button_label != blank %}
                        <motion-element
                          data-motion="fade-up-lg"                    
                            hold                   
                          data-motion-delay="400"
                          class="sec__content-btn {% if block_st.slider_effect == 'effect_fadeinup' %} opacity-0  {{ slider_effect }}  {% endif %} align-center flex flex-wrap gap-15 justify-content-{{ block_st.content_alignment_mobile }} justify-content-md-{{ block_st.content_alignment }}"
                        >
                          {% if block_st.first_button_label != blank %}
                            <a
                              {% if block_st.first_button_link == blank %}
                                role="link" aria-disabled="true"
                              {% else %}
                                href="{{ block_st.first_button_link | default: "#" }}"
                              {% endif %}
                              aria-label="{{ block_st.first_button_label }}"
                              class="inline-flex no-underline{% if block_st.first_button_style %} btn-outline{% else %} btn-primary{% endif %}"
                            >
                              {{ block_st.first_button_label }}
                            </a>
                          {% endif %}
                          {% if block_st.second_button_label != blank %}
                            <a
                              {% if block_st.second_button_link == blank %}
                                role="link" aria-disabled="true"
                              {% else %}
                                href="{{ block_st.second_button_link | default: "#" }}"
                              {% endif %}
                              aria-label="{{ block_st.second_button_label }}"
                              class="inline-flex no-underline{% if block_st.second_button_style %} btn-outline{% else %} btn-primary{% endif %}"
                            >
                              {{ block_st.second_button_label }}
                            </a>
                          {% endif %}
                        </motion-element>
                      {% endif %}
                      {%- if show_badges and badge_pos == 'below_buttons' -%}{{ badges_html }}{%- endif -%}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        {% if show_arrow %}
          {%- render 'swiper-navigation', class: 'original-style' -%}
        {% endif %}
        {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' -%}
          <div
            class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ pagination_position }}{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
            style="--swiper-pagination-bottom: clamp(1.2rem, 2vw, 3rem);{% if section_st.content_below_image %}--swiper-pagination-position: static;{% else %}--swiper-pagination-position: absolute;{% endif %}"
          ></div>
        {% endif %}
      </slide-section>
    {% endif %}
  </div>
</div>



</template>

<schema>
{
  "type": "slideshow",
  "name": "Slideshow",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Basics"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "slide_effect",
      "label": "Slide effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade in"
        },
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "coverflow",
          "label": "Coverflow"
        },
        {
          "value": "creative",
          "label": "Creative"
        },
        {
          "value": "fade_scale",
          "label": "Fade & scale"
        },
        {
          "value": "slide_push",
          "label": "Slide push"
        },
        {
          "value": "stack_up",
          "label": "Stack up"
        },
        {
          "value": "slide_over",
          "label": "Slide over"
        },
        {
          "value": "zoom_reveal",
          "label": "Zoom reveal"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Typography — Top text"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Font size (desktop)",
      "default": 15,
      "min": 12,
      "max": 300,
      "step": 3,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Font size (mobile)",
      "info": "Leave at 0 to use the desktop value on mobile.",
      "default": 15,
      "min": 0,
      "max": 300,
      "step": 3,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Font weight",
      "default": "body_weight",
      "options": [
        {
          "value": "body_weight",
          "label": "Body weight"
        },
        {
          "value": "subheading_weight",
          "label": "Subheading weight"
        },
        {
          "value": "heading_weight",
          "label": "Heading weight"
        }
      ]
    },
    {
      "type": "range",
      "id": "subheading_spacing_bottom",
      "label": "Spacing below",
      "default": 10,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Typography — Heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font size (desktop)",
      "default": 72,
      "min": 12,
      "max": 300,
      "step": 3,
      "unit": "px"
    },
    {
