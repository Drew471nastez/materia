            "step": 1,
            "unit": "%",
            "default": 100
          },
          {
            "type": "range",
            "id": "content_padding_block",
            "label": "Text padding (top and bottom)",
            "min": 40,
            "max": 120,
            "step": 5,
            "unit": "px",
            "default": 60
          },
          {
            "type": "range",
            "id": "content_padding_inline",
