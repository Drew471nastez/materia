          "label": "Second button label",
          "info": "Empty hides the button."
        },
        {
          "type": "url",
          "id": "second_button_link",
          "label": "Second button link"
        },
        {
          "type": "checkbox",
          "id": "second_button_style",
          "label": "Second button outline"
        },
        {
          "type": "checkbox",
          "id": "enable_accent_heading",
          "label": "Accent words in the heading",
          "default": false,
          "info": "Highlight specific words inside the heading with their own colour and optional italic."
        },
        {
          "type": "text",
          "id": "accent_heading_text",
          "label": "Accent words",
          "info": "Type the word(s) from the heading you want accented, separated by spaces. Each matching word is styled.",
          "visible_if": "{{ block.settings.enable_accent_heading }}"
        },
        {
          "type": "color",
          "id": "accent_heading_color",
          "label": "Accent colour",
          "default": "#e0a536",
          "visible_if": "{{ block.settings.enable_accent_heading }}"
        },
        {
          "type": "checkbox",
          "id": "accent_heading_italic",
          "label": "Make accent italic",
          "default": false,
          "visible_if": "{{ block.settings.enable_accent_heading }}"
        },
        {
          "type": "header",
          "id": "hdr_15",
          "label": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "1920 × 800 px recommended"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "600 × 480 px recommended"
        },
        {
          "type": "video",
          "id": "local_video",
          "label": "Video"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video link",
          "info": "YouTube, Vimeo, or a direct .mp4 / .webm / .mov file URL. Used only when 'Local video' is empty. Overrides the desktop / mobile image when present."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "split_images_enable",
          "label": "Two images side by side",
          "info": "When on, the slide shows two side-by-side images instead of one full-width background. Ideal for diptych hero layouts.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_split_left",
          "label": "Left image",
          "info": "Recommended 960 × 800 px",
          "visible_if": "{{ block.settings.split_images_enable }}"
        },
        {
          "type": "image_picker",
          "id": "image_split_right",
          "label": "Right image",
          "info": "Recommended 960 × 800 px",
          "visible_if": "{{ block.settings.split_images_enable }}"
        },
        {
          "type": "range",
          "id": "split_gap",
          "label": "Gap between split images",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.split_images_enable }}"
        },
        {
          "type": "checkbox",
          "id": "split_mobile_use_primary",
          "label": "One image on mobile",
          "info": "When ON, the slide hides the left/right split layout on mobile and uses the image picker below for a single mobile-only image. Recommended for narrow screens where a diptych feels cramped.",
          "default": false,
          "visible_if": "{{ block.settings.split_images_enable }}"
        },
        {
          "type": "image_picker",
          "id": "split_mobile_primary_image",
