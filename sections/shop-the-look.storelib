<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Product Shop The Look 2: a lookbook picture with a dot and
  a label per Hotspot block, placed by % on the picture (its own desktop and
  mobile positions, and an optional mobile picture). A dot opens a card with
  the picked product's picture, title, price and link. The dots, cards and
  live editor updates are run by shopify/assets/live-products-c.js.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign uid = section.id
  assign custom = s.enable_custom_style
  assign mode = s.interaction_mode | default: 'click'
  assign fonts = s.enable_custom_fonts
-%}
{%- if fonts -%}
  {%- if s.heading_font.family != blank -%}{%- assign ff = s.heading_font.fallback_families | default: 'sans-serif' -%}{%- assign hf = s.heading_font.family | append: ', ' | append: ff -%}{%- endif -%}
  {%- if s.body_font.family != blank -%}{%- assign ff = s.body_font.fallback_families | default: 'sans-serif' -%}{%- assign bf = s.body_font.family | append: ', ' | append: ff -%}{%- endif -%}
  <style>{{ s.heading_font | font_face: font_display: 'swap' }}{{ s.body_font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>
{%- endif -%}
{%- capture c_dot -%}{%- if custom -%}{% render 'scheme-color', color: s.dot_color, fallback: 'var(--color-background)' %}{%- else -%}var(--color-background){%- endif -%}{%- endcapture -%}
{%- capture c_card_bg -%}{%- if custom -%}{% render 'scheme-color', color: s.card_bg, fallback: 'var(--color-background)' %}{%- else -%}var(--color-background){%- endif -%}{%- endcapture -%}
{%- capture c_card_text -%}{%- if custom -%}{% render 'scheme-color', color: s.card_text, fallback: 'var(--color-text)' %}{%- else -%}var(--color-text){%- endif -%}{%- endcapture -%}
{%- capture c_title -%}{%- if custom -%}{% render 'scheme-color', color: s.card_title, fallback: 'var(--color-heading)' %}{%- else -%}var(--color-heading){%- endif -%}{%- endcapture -%}
{%- capture c_line -%}{%- if custom -%}{% render 'scheme-color', color: s.card_border, fallback: 'var(--color-border)' %}{%- else -%}var(--color-border){%- endif -%}{%- endcapture -%}
{%- capture c_bg -%}{%- if custom -%}{% render 'scheme-color', color: s.section_bg, fallback: 'var(--gradient-background, var(--color-background))' %}{%- else -%}var(--gradient-background, var(--color-background)){%- endif -%}{%- endcapture -%}
{%- capture root_vars -%}
--pch-pt: {{ s.padding_top | default: 0 }}px; --pch-pb: {{ s.padding_bottom | default: 0 }}px; --pch-bg: {{ c_bg | strip }};
--pch-dot: {{ s.dot_size | default: 18 }}px; --pch-dot-bg: {{ c_dot | strip }}; --pch-pop-bg: {{ c_card_bg | strip }}; --pch-pop-ink: {{ c_card_text | strip }}; --pch-title: {{ c_title | strip }}; --pch-line: {{ c_line | strip }};
--pch-hf: {{ hf | default: 'var(--heading-font)' }}; --pch-bf: {{ bf | default: 'var(--body-font)' }}; --pch-radius: {{ s.image_radius | default: 0 }}px;
{%- endcapture -%}

<style>
  #shopify-section-{{ uid }} .stl { padding-top: var(--pch-pt); padding-bottom: var(--pch-pb); background: var(--pch-bg); color: var(--color-text); overflow-x: clip; box-sizing: border-box; }
  #shopify-section-{{ uid }} .stl__inner { width: 100%; margin-inline: auto; padding-inline: 1.5rem; box-sizing: border-box; }
  #shopify-section-{{ uid }} .stl[data-width="container"] .stl__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ uid }} .stl[data-width="fluid_container"] .stl__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ uid }} .stl[data-width="stretch_width"] .stl__inner { padding-inline: 3rem; }
  #shopify-section-{{ uid }} .stl__stage { position: relative; display: block; }
  #shopify-section-{{ uid }} .stl__media { border-radius: var(--pch-radius); overflow: hidden; }
  #shopify-section-{{ uid }} .stl__img, #shopify-section-{{ uid }} .stl__placeholder { width: 100%; height: auto; display: block; }
  #shopify-section-{{ uid }} .stl__placeholder { aspect-ratio: 16 / 10; background: color-mix(in srgb, var(--color-text) 8%, var(--color-background)); fill: color-mix(in srgb, var(--color-text) 35%, transparent); }
  #shopify-section-{{ uid }} .stl__img--mobile { display: none; }
  #shopify-section-{{ uid }} .pch-spot { --x: var(--x-m, 50%); --y: var(--y-m, 50%); position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; z-index: 2; }
  #shopify-section-{{ uid }} .pch-spot[data-open] { z-index: 5; }
  #shopify-section-{{ uid }} .pch-spot[hidden] { display: none; }
  #shopify-section-{{ uid }} .pch-dot { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); width: max(44px, calc(var(--pch-dot) + 14px)); height: max(44px, calc(var(--pch-dot) + 14px)); display: grid; place-items: center; margin: 0; padding: 0; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ uid }} .pch-dot:focus-visible { outline: 2px solid var(--pch-dot-bg); outline-offset: 2px; border-radius: 50%; }
  #shopify-section-{{ uid }} .pch-dot__core { width: var(--pch-dot); height: var(--pch-dot); border-radius: 50%; background: var(--pch-dot-bg); box-shadow: 0 1px 5px rgba(0, 0, 0, .35); transition: transform .2s ease; }
  #shopify-section-{{ uid }} .stl[data-pulse="true"] .pch-dot__core { animation: stl-pulse 2.4s cubic-bezier(.45, 0, .55, 1) infinite; }
  #shopify-section-{{ uid }} .pch-dot:hover .pch-dot__core, #shopify-section-{{ uid }} .pch-dot[aria-expanded="true"] .pch-dot__core { transform: scale(1.18); }
  @keyframes stl-pulse { 0% { box-shadow: 0 1px 5px rgba(0, 0, 0, .35), 0 0 0 0 color-mix(in srgb, var(--pch-dot-bg) 55%, transparent); } 70%, 100% { box-shadow: 0 1px 5px rgba(0, 0, 0, .35), 0 0 0 12px transparent; } }
  #shopify-section-{{ uid }} .stl__label { position: absolute; top: 0; left: calc(var(--pch-dot) / 2 + 2px); transform: translateY(-50%); display: flex; align-items: center; pointer-events: none; transition: opacity .2s ease, visibility .2s ease; }
  #shopify-section-{{ uid }} .stl__label::before { content: ""; flex: 0 0 auto; width: 16px; height: 2px; background: var(--pch-dot-bg); }
  #shopify-section-{{ uid }} .stl__label-text { display: block; max-width: 34vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--pch-pop-bg); color: var(--pch-title); border: 1px solid var(--pch-line); font-family: var(--pch-bf); font-size: 11px; font-weight: var(--subheading-weight, 600); letter-spacing: .08em; text-transform: uppercase; line-height: 1; padding: 6px 9px; border-radius: 4px; }
  #shopify-section-{{ uid }} .pch-spot[data-flip-m] .stl__label { left: auto; right: calc(var(--pch-dot) / 2 + 2px); flex-direction: row-reverse; }
  #shopify-section-{{ uid }} .stl[data-labels="false"] .stl__label, #shopify-section-{{ uid }} .pch-spot[data-open] .stl__label { opacity: 0; visibility: hidden; }
  #shopify-section-{{ uid }} .pch-pop { position: absolute; top: 0; left: calc(var(--pch-dot) / 2 + 14px); transform: translate(var(--pch-shift, 0px), -50%); width: min(240px, calc(100vw - 32px)); box-sizing: border-box; background: var(--pch-pop-bg); color: var(--pch-pop-ink); border: 1px solid var(--pch-line); border-radius: 10px; box-shadow: 0 12px 32px rgba(0, 0, 0, .18); padding: 10px; animation: pch-pop-in .18s ease both; }
  #shopify-section-{{ uid }} .pch-pop[data-place="left"] { left: auto; right: calc(var(--pch-dot) / 2 + 14px); transform: translate(0, -50%); }
  #shopify-section-{{ uid }} .pch-pop[data-place="below"] { left: 0; top: calc(var(--pch-dot) / 2 + 14px); transform: translateX(calc(-50% + var(--pch-shift, 0px))); }
  #shopify-section-{{ uid }} .pch-pop[data-place="above"] { left: 0; top: auto; bottom: calc(var(--pch-dot) / 2 + 14px); transform: translateX(calc(-50% + var(--pch-shift, 0px))); }
  #shopify-section-{{ uid }} .pch-pop[hidden] { display: none !important; }
  @keyframes pch-pop-in { from { opacity: 0; scale: .96; } to { opacity: 1; scale: 1; } }
  #shopify-section-{{ uid }} .stl__card-row { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
  #shopify-section-{{ uid }} .stl__card-media { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 6px; overflow: hidden; background: var(--pch-line); }
  #shopify-section-{{ uid }} .stl__card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ uid }} .stl__card-info { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  #shopify-section-{{ uid }} .stl__card-title { margin: 0; font-family: var(--pch-hf); font-size: 14px; font-weight: var(--heading-weight, 600); line-height: 1.3; color: var(--pch-title); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  #shopify-section-{{ uid }} .stl__card-price { margin: 0; font-family: var(--pch-bf); font-size: 13px; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  #shopify-section-{{ uid }} .stl__card-price s { opacity: .6; }
  #shopify-section-{{ uid }} .pch-badge { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: 2px 6px; border-radius: 4px; background: var(--pch-title); color: var(--pch-pop-bg); }
  #shopify-section-{{ uid }} .stl__card-link { margin-top: 10px; width: 100%; }
  #shopify-section-{{ uid }} [data-pch-hide] { display: none !important; }
  @media (min-width: 750px) {
    #shopify-section-{{ uid }} .pch-spot { --x: var(--x-d, 50%); --y: var(--y-d, 50%); }
    #shopify-section-{{ uid }} .pch-spot[data-flip-m] .stl__label { left: calc(var(--pch-dot) / 2 + 2px); right: auto; flex-direction: row; }
    #shopify-section-{{ uid }} .pch-spot[data-flip-d] .stl__label { left: auto; right: calc(var(--pch-dot) / 2 + 2px); flex-direction: row-reverse; }
    #shopify-section-{{ uid }} .stl__label-text { max-width: 24ch; }
  }
  @media (max-width: 749.98px) {
    #shopify-section-{{ uid }} .stl[data-has-mobile="true"] .stl__img--desktop { display: none; }
    #shopify-section-{{ uid }} .stl[data-has-mobile="true"] .stl__img--mobile { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ uid }} .stl[data-pulse="true"] .pch-dot__core { animation: none; }
    #shopify-section-{{ uid }} .pch-dot__core, #shopify-section-{{ uid }} .stl__label { transition: none; }
    #shopify-section-{{ uid }} .pch-pop { animation: none; }
  }
{% comment %}{% endcomment %}</style>

<div class="stl pch shop-the-look-{{ uid }} color-{{ scheme }} gradient" data-pch="stl" data-pch-section="{{ uid }}" data-pch-mode="{{ mode }}" data-pch-place="side" data-width="{{ s.width | default: 'fluid_container' }}" data-pulse="{% if s.pulse %}true{% else %}false{% endif %}" data-labels="{% if s.show_labels %}true{% else %}false{% endif %}" data-has-mobile="{% if s.image_mobile != blank %}true{% else %}false{% endif %}" data-pch-editing="{% if request.design_mode %}true{% else %}false{% endif %}" data-pch-settings="{{ s | json | escape }}" data-pch-defaults="&#123;&quot;color_scheme&quot;:&quot;default-color-scheme&quot;,&quot;width&quot;:&quot;fluid_container&quot;,&quot;show_price&quot;:true,&quot;link_label&quot;:&quot;View product&quot;,&quot;sold_out_label&quot;:&quot;Sold out&quot;,&quot;image_radius&quot;:0,&quot;interaction_mode&quot;:&quot;click&quot;,&quot;dot_size&quot;:18,&quot;pulse&quot;:true,&quot;show_labels&quot;:true,&quot;enable_custom_style&quot;:false,&quot;dot_color&quot;:&quot;#FFFFFF&quot;,&quot;enable_custom_fonts&quot;:false,&quot;heading_font&quot;:&quot;assistant_n4&quot;,&quot;body_font&quot;:&quot;assistant_n4&quot;,&quot;padding_top&quot;:36,&quot;padding_bottom&quot;:36&#125;" data-pch-block-defaults="&#123;&quot;hotspot&quot;:&#123;&quot;x_d&quot;:50,&quot;y_d&quot;:50,&quot;x_m&quot;:50,&quot;y_m&quot;:50&#125;&#125;" style="{{ root_vars | strip_newlines }}">
  <div class="stl__inner">
    <div class="stl__stage" data-pch-stage role="group" aria-label="Shop the look">
      <div class="stl__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 2200 | image_tag: loading: 'lazy', decoding: 'async', alt: s.image.alt, widths: '550,750,1100,1500,1800,2200', sizes: '100vw', class: 'stl__img stl__img--desktop' }}
          {%- if s.image_mobile != blank -%}
            {{ s.image_mobile | image_url: width: 1100 | image_tag: loading: 'lazy', decoding: 'async', alt: s.image_mobile.alt, widths: '375,550,750,1100', sizes: '100vw', class: 'stl__img stl__img--mobile' }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'stl__placeholder' }}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            if p != blank and p.title == blank
              assign p = all_products[b.product]
            endif
            assign xd = b.x_d | default: 50
            assign yd = b.y_d | default: 50
            assign xm = b.x_m | default: 50
            assign ym = b.y_m | default: 50
            assign label_text = b.custom_label
            if label_text == blank and p != blank
              assign label_text = p.title
            endif
            if label_text == blank
              assign label_text = 'Choose a product'
            endif
            assign card_title = p.title | default: label_text
            assign hide_spot = false
            if p == blank and request.design_mode != true
              assign hide_spot = true
            endif
            assign card_id = 'pch-pop-' | append: uid | append: '-' | append: block.id
          -%}
          {%- capture spot_json -%}{"custom_label":{{ b.custom_label | json }},"x_d":{{ xd | json }},"y_d":{{ yd | json }},"x_m":{{ xm | json }},"y_m":{{ ym | json }},"title":{{ p.title | json }}}{%- endcapture -%}
          <div class="pch-spot stl__hotspot" data-pch-spot data-pch-block="{{ block.id }}" data-pch-type="hotspot" data-pch-settings="{{ spot_json | escape }}"{% if xd > 50 %} data-flip-d{% endif %}{% if xm > 50 %} data-flip-m{% endif %} style="--x-d: {{ xd }}%; --y-d: {{ yd }}%; --x-m: {{ xm }}%; --y-m: {{ ym }}%;"{% if hide_spot %} hidden{% endif %} {{ block.shopify_attributes }}>
            <button type="button" class="pch-dot stl__dot" data-pch-dot aria-expanded="false" aria-controls="{{ card_id }}">
              <span class="pch-dot__core" aria-hidden="true"></span>
              <span class="visually-hidden" data-pch-dot-label>{{ label_text | escape }}</span>
            </button>
            <span class="stl__label" aria-hidden="true"><span class="stl__label-text" data-pch-label>{{ label_text | escape }}</span></span>
            <div class="pch-pop stl__card" id="{{ card_id }}" data-pch-pop role="group" aria-label="{{ card_title | escape }}" hidden>
              <a class="stl__card-row" href="{% if p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
                <span class="stl__card-media">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', decoding: 'async', alt: '', width: 72, height: 72, widths: '72,144', class: 'stl__card-img' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'stl__card-img' }}
                  {%- endif -%}
                </span>
                <span class="stl__card-info">
                  <span class="stl__card-title">{{ card_title | escape }}</span>
                  {%- if p != blank -%}
                    <span class="stl__card-price" data-pch-show="show_price"{% if s.show_price == false %} data-pch-hide{% endif %}>
                      {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
                      <span>{{ p.price | money }}</span>
                      {%- unless p.available -%}<span class="pch-badge" data-pch-text="sold_out_label">{{ s.sold_out_label | default: 'Sold out' | escape }}</span>{%- endunless -%}
                    </span>
                  {%- endif -%}
                </span>
              </a>
              {%- if p != blank -%}
                {%- capture cta_style -%}{%- if custom -%}{% render 'button-overrides', bg: s.button_bg, text: s.button_text %}{%- endif -%}{%- endcapture -%}
                <a class="stl__card-link" href="{{ p.url }}" data-theme-button="secondary" data-sl-button data-pch-cta data-pch-text="link_label" style="{{ cta_style | strip }}"{% if s.link_label == blank %} hidden{% endif %}>{{ s.link_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "shop-the-look",
  "name": "Product Shop The Look 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Hotspots"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse animation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label",
          "info": "Defaults to product title"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Position"
        },
        {
          "type": "range",
          "id": "x_d",
          "label": "Horizontal (desktop)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_d",
          "label": "Vertical (desktop)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "x_m",
          "label": "Horizontal (mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_m",
          "label": "Vertical (mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product Shop The Look 2",
      "category": "Products",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x_d": 35,
            "y_d": 40,
            "x_m": 35,
            "y_m": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x_d": 60,
            "y_d": 70,
            "x_m": 60,
            "y_m": 70
          }
        }
      ]
    }
  ],
  "shopify": {
    "name": "Product Shop The Look 2",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "header",
        "content": "Product card"
      },
      {
        "type": "checkbox",
        "id": "show_price",
        "label": "Show price",
        "default": true
      },
      {
        "type": "text",
        "id": "link_label",
        "label": "Card button label",
        "default": "View product",
        "info": "Links to the product. Empty hides the button."
      },
      {
        "type": "text",
        "id": "sold_out_label",
        "label": "Sold out label",
        "default": "Sold out"
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "Mobile image",
        "info": "Optional. Hotspots use their mobile positions on it."
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Hotspots"
      },
      {
        "type": "select",
        "id": "interaction_mode",
        "label": "Open card on",
        "default": "click",
        "options": [
          {
            "value": "click",
            "label": "Click"
          },
          {
            "value": "hover",
            "label": "Hover"
          }
        ]
      },
      {
        "type": "range",
        "id": "dot_size",
        "label": "Dot size",
        "min": 12,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 18
      },
      {
        "type": "checkbox",
        "id": "pulse",
        "label": "Pulse the dots",
        "default": true,
        "info": "Stops when the visitor asks for reduced motion."
      },
      {
        "type": "checkbox",
        "id": "show_labels",
        "label": "Show labels",
        "default": true
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme and Theme settings > Buttons."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "dot_color",
        "label": "Dot and line",
        "default": "#FFFFFF",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card and label background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_text",
        "label": "Card text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_title",
        "label": "Card title and label text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_border",
        "label": "Card border",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Card button background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text",
        "label": "Card button text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "hotspot",
        "name": "Hotspot",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product",
            "info": "The card shows its picture, title, price and link. A hotspot with no product is hidden on the live store."
          },
          {
            "type": "text",
            "id": "custom_label",
            "label": "Label",
            "info": "Empty uses the product title."
          },
          {
            "type": "header",
            "content": "Desktop position"
          },
          {
            "type": "range",
            "id": "x_d",
            "label": "Left to right (desktop)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          },
          {
            "type": "range",
            "id": "y_d",
            "label": "Top to bottom (desktop)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          },
          {
            "type": "header",
            "content": "Mobile position"
          },
          {
            "type": "range",
            "id": "x_m",
            "label": "Left to right (mobile)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          },
          {
            "type": "range",
            "id": "y_m",
            "label": "Top to bottom (mobile)",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Product Shop The Look 2",
        "category": "Products",
        "blocks": [
          {
            "type": "hotspot",
            "settings": {
              "x_d": 35,
              "y_d": 40,
              "x_m": 35,
              "y_m": 40
            }
          },
          {
            "type": "hotspot",
            "settings": {
              "x_d": 60,
              "y_d": 70,
              "x_m": 60,
              "y_m": 70
            }
          }
        ]
      }
    ]
  }
}
</schema>
