<template compat="shopify">
{%- comment -%}
  Shop The Look
  Lookbook image with product hotspots: pulsing dot + connector + label box;
  clicking a dot opens a product card popover. Self-contained, scoped to
  #shopify-section-{{ section.id }}; colors come from the theme color scheme
  (color-{{ scheme }} class + --color-text/-heading/-background/-border vars).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme | default: 'scheme-1'
  assign uid = section.id

  assign pt = s.padding_top | default: 36
  assign pb = s.padding_bottom | default: 36
  assign dot_size = s.dot_size | default: 18
  assign dot_color = s.dot_color | default: '#ffffff'

  assign width = s.width | default: 'fluid_container'
  case width
    when 'container'
      assign maxw = 'calc(var(--page-width, 1300px) + 3rem)'
      assign padx = '1.5rem'
    when 'stretch_width'
      assign maxw = 'none'
      assign padx = '3rem'
    when 'full_width'
      assign maxw = 'none'
      assign padx = '1.5rem'
    else
      assign maxw = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
      assign padx = '1.5rem'
  endcase
-%}

<style>
  #shopify-section-{{ uid }} .shop-the-look-{{ uid }} {
    --stl-dot: {{ dot_size }}px;
    --stl-dot-color: {{ dot_color }};
    color: var(--color-text);
    background: var(--gradient-background, var(--color-background));
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ uid }} .stl__inner {
    width: 100%;
    max-width: {{ maxw }};
    margin-inline: auto;
    padding-inline: {{ padx }};
    box-sizing: border-box;
  }

  #shopify-section-{{ uid }} stl-shop-the-look {
    position: relative;
    display: block;
  }

  #shopify-section-{{ uid }} .stl__img,
  #shopify-section-{{ uid }} .stl__placeholder {
    width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ uid }} .stl__img--mobile {
    display: none;
  }

  {%- if s.image_mobile != blank %}
  @media (max-width: 749.98px) {
    #shopify-section-{{ uid }} .stl__img--desktop { display: none; }
    #shopify-section-{{ uid }} .stl__img--mobile { display: block; }
  }
  {%- endif %}

  /* ----- Hotspot ----- */
  #shopify-section-{{ uid }} .stl__hotspot {
    --x: var(--x-d, 50%);
    --y: var(--y-d, 50%);
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  #shopify-section-{{ uid }} .stl__hotspot.is-open {
    z-index: 4;
  }

  @media (max-width: 749.98px) {
    #shopify-section-{{ uid }} .stl__hotspot {
      --x: var(--x-m, 50%);
      --y: var(--y-m, 50%);
    }
  }

  #shopify-section-{{ uid }} .stl__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: max(32px, calc(var(--stl-dot) + 14px));
    height: max(32px, calc(var(--stl-dot) + 14px));
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-section-{{ uid }} .stl__dot-core {
    width: var(--stl-dot);
    height: var(--stl-dot);
    border-radius: 50%;
    background: var(--stl-dot-color);
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease;
    {%- if s.pulse %}
    animation: stl-pulse-{{ uid }} 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    {%- endif %}
  }

  #shopify-section-{{ uid }} .stl__dot:hover .stl__dot-core,
  #shopify-section-{{ uid }} .stl__hotspot.is-open .stl__dot-core {
    transform: scale(1.18);
  }

  #shopify-section-{{ uid }} .stl__dot:focus-visible {
    outline: 2px solid var(--stl-dot-color);
    outline-offset: 2px;
    border-radius: 50%;
  }

  {%- if s.pulse %}
  @keyframes stl-pulse-{{ uid }} {
    0%   { box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35), 0 0 0 0 {{ dot_color | color_modify: 'alpha', 0.55 }}; }
    70%  { box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35), 0 0 0 12px {{ dot_color | color_modify: 'alpha', 0 }}; }
    100% { box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35), 0 0 0 0 {{ dot_color | color_modify: 'alpha', 0 }}; }
  }
  {%- endif %}

  /* ----- Label box + connector ----- */
  #shopify-section-{{ uid }} .stl__label {
    position: absolute;
    top: 50%;
    left: calc(100% + 2px);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  #shopify-section-{{ uid }} .stl__label::before {
    content: "";
    flex: 0 0 auto;
    width: 16px;
    height: 2px;
    background: var(--stl-dot-color);
  }

  #shopify-section-{{ uid }} .stl__label-text {
    background: var(--color-background);
    color: var(--color-heading);
    border: 1px solid var(--color-border);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    padding: 6px 9px;
    border-radius: 4px;
  }

  #shopify-section-{{ uid }} .stl__hotspot.is-open .stl__label {
    opacity: 0;
    visibility: hidden;
  }

  /* ----- Product card popover ----- */
  #shopify-section-{{ uid }} .stl__card {
    position: absolute;
    top: 50%;
    left: calc(100% + 12px);
    transform: translateY(-50%);
    width: min(240px, 64vw);
    box-sizing: border-box;
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    padding: 10px;
    z-index: 5;
    animation: stl-card-in-{{ uid }} 0.18s ease;
  }

  #shopify-section-{{ uid }} .stl__card[hidden] {
    display: none !important;
  }

  @keyframes stl-card-in-{{ uid }} {
    from { opacity: 0; transform: translateY(-50%) scale(0.96); }
    to   { opacity: 1; transform: translateY(-50%) scale(1); }
  }

  #shopify-section-{{ uid }} .stl__card-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ uid }} .stl__card-media {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-border);
  }

  #shopify-section-{{ uid }} .stl__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ uid }} .stl__card-info {
    min-width: 0;
  }

  #shopify-section-{{ uid }} .stl__card-title {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-heading);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  #shopify-section-{{ uid }} .stl__card-price {
    margin: 0;
    font-size: 13px;
    color: var(--color-text);
  }

  #shopify-section-{{ uid }} .stl__card-link {
    display: block;
    margin-top: 10px;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-heading);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 8px 10px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ uid }} .stl__card-link:hover {
    background: var(--color-primary, var(--color-heading));
    border-color: var(--color-primary, var(--color-heading));
    color: var(--color-background);
  }

  /* ----- Horizontal flip (hotspot on the right half) ----- */
  @media (min-width: 750px) {
    #shopify-section-{{ uid }} .stl__hotspot--flip-d .stl__card {
      left: auto;
      right: calc(100% + 12px);
    }
    #shopify-section-{{ uid }} .stl__hotspot--flip-d .stl__label {
      left: auto;
      right: calc(100% + 2px);
      flex-direction: row-reverse;
    }
  }

  @media (max-width: 749.98px) {
    #shopify-section-{{ uid }} .stl__hotspot--flip-m .stl__card {
      left: auto;
      right: calc(100% + 12px);
    }
    #shopify-section-{{ uid }} .stl__hotspot--flip-m .stl__label {
      left: auto;
      right: calc(100% + 2px);
      flex-direction: row-reverse;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ uid }} .stl__dot-core {
      animation: none;
      transition: none;
    }
    #shopify-section-{{ uid }} .stl__card {
      animation: none;
    }
    #shopify-section-{{ uid }} .stl__label,
    #shopify-section-{{ uid }} .stl__card-link {
      transition: none;
    }
  }
{% comment %}{% endcomment %}</style>

<div class="shop-the-look-{{ uid }} color-{{ scheme }}">
  <div class="stl__inner">
    <stl-shop-the-look aria-label="{{ 'Shop the look' | escape }}">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '550,750,1100,1500,1800,2200', sizes: '100vw', class: 'stl__img stl__img--desktop' }}
        {%- if s.image_mobile != blank -%}
          {{ s.image_mobile | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '375,550,750,1100', sizes: '100vw', class: 'stl__img stl__img--mobile' }}
        {%- endif -%}
      {%- else -%}
        <img
          src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
          alt=""
          loading="lazy"
          class="stl__placeholder"
          width="1600"
          height="1000"
        >
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            assign xd = b.x_d | default: 50
            assign yd = b.y_d | default: 50
            assign xm = b.x_m | default: 50
            assign ym = b.y_m | default: 50

            assign label_text = b.custom_label
            if label_text == blank and p != blank
              assign label_text = p.title
            endif
            if label_text == blank
              assign label_text = 'Product'
            endif

            assign flip_d = false
            if xd > 50
              assign flip_d = true
            endif
            assign flip_m = false
            if xm > 50
              assign flip_m = true
            endif

            assign card_id = 'stl-card-' | append: uid | append: '-' | append: forloop.index
          -%}
          <div
            class="stl__hotspot{% if flip_d %} stl__hotspot--flip-d{% endif %}{% if flip_m %} stl__hotspot--flip-m{% endif %}"
            style="--x-d: {{ xd }}%; --y-d: {{ yd }}%; --x-m: {{ xm }}%; --y-m: {{ ym }}%;"
            data-stl-hotspot
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="stl__dot"
              data-stl-dot
              aria-expanded="false"
              aria-controls="{{ card_id }}"
              aria-label="{{ 'Show product:' | append: ' ' | append: label_text | escape }}"
            >
              <span class="stl__dot-core" aria-hidden="true"></span>
            </button>

            {%- if s.show_labels -%}
              <span class="stl__label" aria-hidden="true">
                <span class="stl__label-text">{{ label_text | escape }}</span>
              </span>
            {%- endif -%}

            <div class="stl__card" id="{{ card_id }}" data-stl-card hidden>
              {%- if p != blank -%}
                <div class="stl__card-row">
                  {%- if p.featured_image -%}
                    <div class="stl__card-media">
                      {{ p.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', widths: '72,144', class: 'stl__card-img' }}
                    </div>
                  {%- endif -%}
                  <div class="stl__card-info">
                    <p class="stl__card-title">{{ p.title | escape }}</p>
                    <p class="stl__card-price">{{ p.price | money }}</p>
                  </div>
                </div>
                <a class="stl__card-link" href="{{ p.url }}">View product</a>
              {%- else -%}
                <div class="stl__card-row">
                  <div class="stl__card-info">
                    <p class="stl__card-title">{{ label_text | escape }}</p>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </stl-shop-the-look>
  </div>
</div>

<script>
  /* Shop The Look — vanilla JS, scoped per instance (each <stl-shop-the-look>
     manages only its own hotspots). Double-init safe: customElements.define is
     guarded; shopify:section:load re-inserts the DOM, re-running connectedCallback. */
  (function () {
    if (customElements.get('stl-shop-the-look')) return;

    customElements.define(
      'stl-shop-the-look',
      class extends HTMLElement {
        connectedCallback() {
          if (this._stlBound) return;
          this._stlBound = true;
          this._openHotspot = null;

          this._onClick = this._handleClick.bind(this);
          this._onDocClick = this._handleDocClick.bind(this);
          this._onKeydown = this._handleKeydown.bind(this);
          this._onBlockSelect = this._handleBlockSelect.bind(this);
          this._onBlockDeselect = this._handleBlockDeselect.bind(this);

          this.addEventListener('click', this._onClick);
          this.addEventListener('shopify:block:select', this._onBlockSelect);
          this.addEventListener('shopify:block:deselect', this._onBlockDeselect);
          document.addEventListener('click', this._onDocClick);
          document.addEventListener('keydown', this._onKeydown);
        }

        disconnectedCallback() {
          this.removeEventListener('click', this._onClick);
          this.removeEventListener('shopify:block:select', this._onBlockSelect);
          this.removeEventListener('shopify:block:deselect', this._onBlockDeselect);
          document.removeEventListener('click', this._onDocClick);
          document.removeEventListener('keydown', this._onKeydown);
          this._openHotspot = null;
          this._stlBound = false;
        }

        _handleClick(event) {
          var dot = event.target.closest('[data-stl-dot]');
          if (!dot || !this.contains(dot)) return;
          var hotspot = dot.closest('[data-stl-hotspot]');
          if (!hotspot) return;
          if (hotspot === this._openHotspot) {
            this.closeAll();
          } else {
            this.openHotspot(hotspot);
          }
        }

        _handleDocClick(event) {
          if (this._openHotspot && !this.contains(event.target)) {
            this.closeAll();
          }
        }

        _handleKeydown(event) {
          if (event.key !== 'Escape' || !this._openHotspot) return;
          var dot = this._openHotspot.querySelector('[data-stl-dot]');
          this.closeAll();
          if (dot) dot.focus();
        }

        _handleBlockSelect(event) {
          var hotspot = event.target.closest('[data-stl-hotspot]');
          if (hotspot && this.contains(hotspot)) this.openHotspot(hotspot);
        }

        _handleBlockDeselect() {
          this.closeAll();
        }

        openHotspot(hotspot) {
          this.closeAll();
          var card = hotspot.querySelector('[data-stl-card]');
          var dot = hotspot.querySelector('[data-stl-dot]');
          if (card) card.hidden = false;
          if (dot) dot.setAttribute('aria-expanded', 'true');
          hotspot.classList.add('is-open');
          this._openHotspot = hotspot;
        }

        closeAll() {
          var open = this.querySelectorAll('[data-stl-hotspot].is-open');
          for (var i = 0; i < open.length; i++) {
            var card = open[i].querySelector('[data-stl-card]');
            var dot = open[i].querySelector('[data-stl-dot]');
            if (card) card.hidden = true;
            if (dot) dot.setAttribute('aria-expanded', 'false');
            open[i].classList.remove('is-open');
          }
          this._openHotspot = null;
        }
      }
    );
  })();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "shop-the-look",
  "name": "Product Shop The Look 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "The lookbook photo the hotspots sit on. A placeholder is shown until an image is chosen."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Replaces the desktop image below 750px — use the mobile position sliders on each hotspot to match it."
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Hotspots"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse animation",
      "default": true,
      "info": "Disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true,
      "info": "A small label box next to each dot with the product or custom label."
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label",
          "info": "Leave blank to use the product title."
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Position"
        },
        {
          "type": "range",
          "id": "x_d",
          "label": "Horizontal (desktop)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_d",
          "label": "Vertical (desktop)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "x_m",
          "label": "Horizontal (mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_m",
          "label": "Vertical (mobile)",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product Shop The Look 2",
      "category": "Products",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x_d": 35,
            "y_d": 40,
            "x_m": 35,
            "y_m": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x_d": 60,
            "y_d": 70,
            "x_m": 60,
            "y_m": 70
          }
        }
      ]
    }
  ],
  "shopify": {
    "name": "Product Shop The Look 2",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "width",
        "label": "Section width",
        "default": "fluid_container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "info": "The lookbook photo the hotspots sit on. A placeholder is shown until an image is chosen."
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "Mobile image",
        "info": "Optional. Replaces the desktop image below 750px — use the mobile position sliders on each hotspot to match it."
      },
      {
        "type": "header",
        "content": "Hotspots"
      },
      {
        "type": "color",
        "id": "dot_color",
        "label": "Dot color",
        "default": "#FFFFFF"
      },
      {
