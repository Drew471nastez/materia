        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "What appears in the wheel slice. Keep it SHORT (≤6 chars) so neighboring labels don't visually crowd each other — e.g. \"10%\", \"15%\", \"FREE\", \"TRY\". Long labels like \"FREE SHIPPING\" usually overflow into adjacent slices.",
          "default": "10%"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Coupon code",
          "info": "Must match a real discount code in Shopify admin → Discounts. Leave empty for non-winning slices (e.g. TRY AGAIN).",
          "default": "SPIN10"
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Win chance"
        },
        {
          "type": "range",
          "id": "weight",
          "min": 0,
          "max": 100,
          "step": 1,
          "label": "Win chance (weight)",
          "info": "Relative odds of landing here. Tip: if you make every prize's weights sum to 100, each weight is exactly the percentage probability — e.g. weight 80 on '15% OFF' + 20 split across the others = 80% chance to win 15% OFF. Set to 0 to make this slice visual-only (never wins).",
          "default": 1
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Color"
