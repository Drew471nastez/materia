            "label": "Text",
            "default": "Enter your email and spin the wheel."
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Custom colours",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style == true }}"
          }
        ]
      },
