      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "close_after_copy",
      "label": "Close after copying",
      "default": true
    },
    {
      "type": "range",
      "id": "close_after_copy_delay_s",
      "label": "Close after",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 10,
      "visible_if": "{{ section.settings.close_after_copy == true }}"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Words"
    },
    {
      "type": "text",
      "id": "win_label",
      "label": "Above the prize",
      "default": "YOU WON!"
    },
    {
      "type": "text",
