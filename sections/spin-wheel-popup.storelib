      "min": 30,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 68
    },
    {
      "type": "color",
      "id": "segment_divider",
      "label": "Divider"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Spin to reveal your discount"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        }
      ],
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Enter your email for a chance to win up to 15% off your order."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        }
      ],
      "limit": 1
    },
    {
      "type": "prize",
      "name": "Prize",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "10%"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Code (empty = no prize)",
          "default": "SPIN10"
        },
        {
