            "default": "#ffd6e0"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Label color",
            "default": "#111111"
          }
        ]
      },
      {
        "type": "form",
        "name": "Email form",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Content"
