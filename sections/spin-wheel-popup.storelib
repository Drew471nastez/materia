            "default": "US",
            "visible_if": "{{ block.settings.collect_phone == true }}"
          },
          {
            "type": "checkbox",
            "id": "phone_required",
            "label": "Phone required",
            "default": false,
            "visible_if": "{{ block.settings.collect_phone == true }}"
          }
        ]
      },
      {
        "type": "dismiss",
        "name": "No-thanks link",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
