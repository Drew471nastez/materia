        }
      ],
      "limit": 1
    }
  ],
  "presets": [],
  "enabled_on": {
    "groups": [
      "overlay"
    ]
  },
  "shopify": {
    "name": "Spin Wheel Popup",
    "tag": "section",
    "class": "sw-section",
    "enabled_on": {
      "groups": [
        "custom.overlay"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "Trigger"
      },
      {
        "type": "select",
        "id": "open_mode",
        "label": "Opens",
        "default": "delay",
        "options": [
