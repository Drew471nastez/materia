<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_spin_again = 'accessibility.spin_again' | t -%}
{%- assign fb_accessibility_you_won = 'accessibility.you_won' | t -%}
{%- assign fb_accessibility_spin_to_win = 'accessibility.spin_to_win' | t -%}
{%- assign fb_accessibility_enter_your_email = 'accessibility.enter_your_email' | t -%}
{%- comment -%}
  Spin Wheel Popup
  --------------------------------------------------------------
  A gamified discount popup. Visitor enters their email (+ optional
  phone with country code), clicks Spin, the wheel animates and
  lands on one of the prize segments. The winning segment's coupon
  code is revealed and copyable. Submission posts to Shopify's
  customer endpoint so the email + phone are captured.

  Structure:
    Section-level: trigger / overlay / layout / colors / fonts
    Blocks:
      - heading        (limit 1)
      - description    (limit 1)
      - prize          (up to 8, ordered, each with label + coupon code + color)
      - form           (limit 1) — email + optional phone
      - dismiss        (limit 1)

  All popups follow the same z-index (2147483647), position:static
  wrapper, body-scroll-lock, focus management and editor-mode pattern.
{%- endcomment -%}

{%- assign sw_open_mode = section.settings.open_mode | default: 'delay' -%}
{%- assign sw_delay_s = section.settings.delay_s | default: 5 -%}
{%- assign sw_after_dismiss = section.settings.after_dismiss | default: 'after_days' -%}
{%- assign sw_hide_days = section.settings.hide_days | default: 1 -%}
{%- assign sw_mobile_gutter = section.settings.mobile_gutter | default: 32 -%}
{%- assign sw_editor_mode = section.settings.editor_mode -%}

{%- assign block_heading = blank -%}
{%- assign block_description = blank -%}
{%- assign block_form = blank -%}
{%- assign block_dismiss = blank -%}
{%- assign prize_blocks = '' | split: '' -%}
{%- for b in section.blocks -%}
  {%- case b.type -%}
    {%- when 'heading' -%}{%- assign block_heading = b -%}
    {%- when 'description' -%}{%- assign block_description = b -%}
    {%- when 'form' -%}{%- assign block_form = b -%}
    {%- when 'dismiss' -%}{%- assign block_dismiss = b -%}
    {%- when 'prize' -%}{%- assign prize_blocks = prize_blocks | concat: b.id | join: ',' -%}
  {%- endcase -%}
{%- endfor -%}

{%- comment -%} Collect prize blocks in order so the wheel + JS use the same array {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { position: static; }

  .sw-{{ section.id }} { font-family: var(--body-font, inherit); }
  .sw-{{ section.id }} *, .sw-{{ section.id }} *::before, .sw-{{ section.id }} *::after { box-sizing: border-box; }

  .sw-overlay-{{ section.id }} {
    position: fixed; inset: 0;
    background: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %};
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: opacity .3s ease, visibility 0s linear .3s;
    z-index: 2147483646;
  }
  .sw-{{ section.id }}.sw-open .sw-overlay-{{ section.id }} {
    opacity: {{ section.settings.overlay_opacity | default: 60 | times: 0.01 }};
    pointer-events: auto; visibility: visible; transition-delay: 0s;
  }

  .sw-card-{{ section.id }} {
    position: fixed; left: 50%; top: 50%;
    transform: translate(-50%, -50%) scale(.96);
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s ease, visibility 0s linear .35s;
    z-index: 2147483647;
    width: min(calc(100vw - {{ sw_mobile_gutter }}px), {{ section.settings.popup_width | default: 920 }}px);
    max-height: calc(var(--sl-vh, 1vh) * 100 - 24px);
    overflow: hidden auto; overscroll-behavior: contain;
    background: {% render 'scheme-color', color: section.settings.card_bg, fallback: 'var(--color-background)' %};
    color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %};
    border-radius: {{ section.settings.popup_radius | default: 16 }}px;
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
  }
  .sw-{{ section.id }}.sw-open .sw-card-{{ section.id }} {
    opacity: 1; pointer-events: auto; visibility: visible; transition-delay: 0s;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (min-width: 750px) {
    .sw-card-{{ section.id }} {
      width: min(92vw, {{ section.settings.popup_width | default: 920 }}px);
    }
  }

  .sw-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: {% if section.settings.wheel_side == 'wheel-right' %}1.05fr .95fr{% else %}.95fr 1.05fr{% endif %};
    align-items: stretch;
    gap: 0;
  }
  .sw-grid-{{ section.id }}.sw-wheel-right .sw-text-{{ section.id }} { order: 1; }
  .sw-grid-{{ section.id }}.sw-wheel-right .sw-wheel-col-{{ section.id }} { order: 2; }
  @media (max-width: 749px) {
    .sw-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }
    .sw-grid-{{ section.id }} .sw-wheel-col-{{ section.id }} { order: 1; }
    .sw-grid-{{ section.id }} .sw-text-{{ section.id }} { order: 2; }
  }

  .sw-text-{{ section.id }} {
    padding: 28px 28px;
    display: flex; flex-direction: column;
    justify-content: center;
    text-align: {{ section.settings.text_align | default: 'left' }};
    {% if section.settings.text_align == 'center' %}align-items: center;{% endif %}
    min-height: 0;
  }
  @media (max-width: 749px) {
    .sw-text-{{ section.id }} { padding: 20px 22px; }
  }

  .sw-heading-{{ section.id }} { font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 800); font-size: 28px; line-height: 1.1; margin: 0 0 10px; }
  .sw-description-{{ section.id }} { font-size: 15px; line-height: 1.45; margin: 0 0 16px; }
  @media (max-width: 749px) {
    .sw-heading-{{ section.id }} { font-size: 22px; }
    .sw-description-{{ section.id }} { font-size: 14px; }
  }

  .sw-close-{{ section.id }} {
    position: absolute; top: 12px; right: 12px;
    width: 44px; height: 44px; padding: 0;
    border: none; border-radius: 50%;
    background: color-mix(in srgb, var(--color-background) 95%, transparent);
    color: {% render 'scheme-color', color: section.settings.close_color, fallback: 'var(--color-heading)' %};
    font-size: 20px; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
    transition: transform var(--btn-anim-duration, .25s) var(--btn-anim-ease, ease), background-color var(--btn-anim-duration, .25s) var(--btn-anim-ease, ease);
    z-index: 2;
  }
  .sw-close-{{ section.id }}:hover { background: var(--color-background); }
  .sw-close-{{ section.id }} svg { width: 18px; height: 18px; }
  .sw-close-{{ section.id }}:focus-visible, .sw-win-code-{{ section.id }}:focus-visible, .sw-dismiss-{{ section.id }}:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  /* Wheel area */
  .sw-wheel-col-{{ section.id }} {
    background: {% render 'scheme-color', color: section.settings.wheel_panel_bg, fallback: 'color-mix(in srgb, var(--color-primary) 6%, var(--color-background))' %};
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
    overflow: hidden;
  }
  .sw-wheel-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1 / 1;
  }
  @media (max-width: 749px) {
    .sw-wheel-col-{{ section.id }} { padding: 20px 16px 8px; }
    .sw-wheel-{{ section.id }} { max-width: min(240px, 64vw); }
  }
  .sw-wheel-svg-{{ section.id }} {
    width: 100%; height: 100%;
    border-radius: 50%;
    position: relative;
    transform: rotate(0deg);
    transition: transform {{ section.settings.spin_duration_s | default: 5 }}s cubic-bezier(.12,.6,.12,1);
    will-change: transform;
    display: block;
    overflow: hidden;
    border: 6px solid {% render 'scheme-color', color: section.settings.hub_color, fallback: 'var(--color-background)' %};
    box-shadow: 0 6px 24px rgba(0,0,0,.18);
  }
  /* Hub border on each segment is rendered via SVG <line> elements in the
     labels overlay below (`.sw-wheel-divider`). Kept as SVG for crisp rendering
     and reliable cross-browser support. */
  .sw-wheel-svg-{{ section.id }} .sw-wheel-divider {
    stroke: {% render 'scheme-color', color: section.settings.segment_divider, fallback: 'color-mix(in srgb, var(--color-border) 60%, transparent)' %};
    stroke-width: 1;
  }
  /* SVG label overlay — text is positioned at the mid-radius of each
     segment and rotated to read radially. Sized via CSS to match wheel. */
  .sw-wheel-labels-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .sw-wheel-labels-{{ section.id }} text {
    font-weight: 800;
    letter-spacing: .04em;
    font-family: var(--body-font, inherit);
  }
  .sw-wheel-pointer-{{ section.id }} {
    position: absolute;
    top: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 14px solid transparent;
    border-right: 14px solid transparent;
    border-top: 22px solid {% render 'scheme-color', color: section.settings.pointer_color, fallback: 'var(--color-heading)' %};
    filter: drop-shadow(0 2px 4px rgba(0,0,0,.25));
    z-index: 3;
  }
  /* Center hub — decorative button-style ring with brand mark in the middle.
     Sits above the conic-gradient and labels (z-index: 2) so it covers the
     center where labels would otherwise crowd. */
  .sw-wheel-hub-{{ section.id }} {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 24%; height: 24%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(255,255,255,.95) 0%, {% render 'scheme-color', color: section.settings.hub_color, fallback: 'var(--color-background)' %} 65%);
    box-shadow:
      0 4px 12px rgba(0,0,0,.18),
      inset 0 0 0 6px {% render 'scheme-color', color: section.settings.pointer_color, fallback: 'var(--color-heading)' %},
      inset 0 0 0 8px rgba(255,255,255,.85);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--body-font, inherit);
  }
  .sw-wheel-hub-{{ section.id }}::after {
    content: "{{ section.settings.hub_text | default: '%' }}";
    color: {% render 'scheme-color', color: section.settings.pointer_color, fallback: 'var(--color-heading)' %};
    font-weight: 900;
    font-size: clamp(14px, 4.4vw, 30px);
    line-height: 1;
    letter-spacing: -.02em;
  }
  /* Subtle bounce-in animation when the popup opens */
  @keyframes sw-hub-pop-{{ section.id }} {
    0%   { transform: translate(-50%, -50%) scale(.6); opacity: 0; }
    60%  { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1); }
  }
  .sw-{{ section.id }}.sw-open .sw-wheel-hub-{{ section.id }} {
    animation: sw-hub-pop-{{ section.id }} .55s cubic-bezier(.4,0,.2,1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .sw-{{ section.id }}.sw-open .sw-wheel-hub-{{ section.id }} { animation: none; }
  }

  /* Form & button */
  .sw-form-{{ section.id }} { display: flex; flex-direction: column; gap: 12px; max-width: 420px; {% if section.settings.text_align == 'center' %}margin-inline: auto;{% endif %} }
  .sw-form-{{ section.id }} > form { display: flex; flex-direction: column; gap: 12px; }
  .sw-form-{{ section.id }} input[type="email"] {
    width: 100%; min-height: var(--input-height, 46px); padding: var(--input-padding, 12px 14px);
    border-radius: var(--input-border-radius, 8px); border: max(1px, var(--inputs-border-width, 1px)) solid var(--color-border, #cccccc);
    font-family: var(--body-font, inherit); font-size: var(--input-font-size, 15px); background: var(--input-bg, var(--color-background)); color: var(--input-color, var(--color-text));
    outline: none;
  }
  /* Ghost-text placeholder — light gray, full opacity (Firefox default
     gives placeholders reduced opacity which can read as off-white on
     some forms; force 1 so the colour stays consistent across browsers). */
  .sw-form-{{ section.id }} input[type="email"]::placeholder {
    color: var(--input-placeholder-color, color-mix(in srgb, var(--color-text) 55%, transparent));
    opacity: 1;
  }
  .sw-form-{{ section.id }} input[type="email"]::-webkit-input-placeholder { color: var(--input-placeholder-color, color-mix(in srgb, var(--color-text) 55%, transparent)); opacity: 1; }
  .sw-form-{{ section.id }} input[type="email"]::-moz-placeholder         { color: var(--input-placeholder-color, color-mix(in srgb, var(--color-text) 55%, transparent)); opacity: 1; }
  .sw-form-{{ section.id }} input[type="email"]:-ms-input-placeholder      { color: var(--input-placeholder-color, color-mix(in srgb, var(--color-text) 55%, transparent)); opacity: 1; }
  .sw-form-{{ section.id }} input[type="email"]:focus {
    border-color: color-mix(in srgb, var(--color-text) 40%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-text) 8%, transparent);
  }
  /* Spin and Spin again are theme buttons (theme-button-contract.css); the
     section's own spin button colours arrive as --mb-* tokens. */
  .sw-spin-btn-{{ section.id }} { width: 100%; }

  /* Pre/Post panes */
  .sw-pre-{{ section.id }} { display: block; }
  .sw-{{ section.id }}.sw-spun .sw-pre-{{ section.id }} { display: none; }
  .sw-post-{{ section.id }} { display: none; }
  .sw-{{ section.id }}.sw-spun .sw-post-{{ section.id }} { display: block; }

  /* Re-spin button — hidden by default, only shown when the visitor lands
     on a no-code slice (e.g. TRY AGAIN) AND there are retries left. */
  .sw-respin-btn-{{ section.id }} { display: none; margin-top: 14px; }
  .sw-{{ section.id }}.sw-can-respin .sw-respin-btn-{{ section.id }} { display: inline-flex; }

  .sw-win-label-{{ section.id }} { font-size: 14px; font-weight: 600; opacity: .85; margin: 0 0 6px; letter-spacing: .04em; text-transform: uppercase; }
  .sw-win-title-{{ section.id }} { font-family: var(--heading-font, inherit); font-size: 28px; font-weight: var(--heading-weight, 800); margin: 0 0 12px; line-height: 1.1; }
  .sw-win-code-{{ section.id }} {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700; letter-spacing: .12em; font-size: 17px;
    min-height: 44px; padding: 10px 14px;
    border: 2px dashed currentColor; color: inherit;
    border-radius: 8px;
    cursor: pointer; user-select: all;
    background: transparent;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .sw-win-code-{{ section.id }}.is-copied {
    background: #1c8d3a; color: #fff; border-color: #1c8d3a;
  }

  .sw-dismiss-wrap-{{ section.id }} { margin-top: 12px; text-align: {{ section.settings.dismiss_align | default: 'center' }}; }
  .sw-dismiss-{{ section.id }} {
    background: none; border: none; cursor: pointer;
    font-size: 13px; text-decoration: underline;
    color: inherit; opacity: .7;
    min-height: 44px; padding: 4px 8px;
    transition: opacity var(--btn-anim-duration, .25s) var(--btn-anim-ease, ease);
  }
  .sw-dismiss-{{ section.id }}:hover { opacity: 1; }


  @media (prefers-reduced-motion: reduce) {
    .sw-card-{{ section.id }}, .sw-overlay-{{ section.id }},
    .sw-spin-btn-{{ section.id }}, .sw-respin-btn-{{ section.id }}, .sw-dismiss-{{ section.id }}, .sw-win-code-{{ section.id }}, .sw-close-{{ section.id }} {
      transition: none !important;
    }
    .sw-wheel-svg-{{ section.id }} { transition: transform 0.001ms !important; }
    .sw-card-{{ section.id }} { transform: translate(-50%, -50%) !important; }
  }
{% comment %}{% endcomment %}</style>

{%- capture sw_config -%}
  {"design": {{ request.design_mode | json }}, "preview": {{ sw_editor_mode | json }},
   "trigger": {"mode": {{ sw_open_mode | json }}, "delay": {{ sw_delay_s | json }}, "scroll": {{ section.settings.scroll_pct | default: 50 | json }}, "views": {{ section.settings.page_views | default: 2 | json }} },
   "frequency": {"mode": {{ sw_after_dismiss | json }}, "days": {{ sw_hide_days | json }} },
   "spin": {"seconds": {{ section.settings.spin_duration_s | default: 5 | json }}, "turns": {{ section.settings.spin_full_turns | default: 5 | json }}, "respins": {{ section.settings.max_respins | default: 2 | json }},
     "closeAfterCopy": {{ section.settings.close_after_copy | json }}, "closeDelay": {{ section.settings.close_after_copy_delay_s | default: 10 | json }},
     "noWin": {{ section.settings.no_win_label | default: 'Better luck next time' | json }}, "copied": {{ section.settings.copy_done_label | default: 'Copied!' | json }}, "spinning": {{ section.settings.spinning_label | default: 'Spinning' | json }} } }
{%- endcapture -%}
<section class="sw-{{ section.id }} color-{{ color_scheme }}"
         data-sw-section="{{ section.id }}" data-popup-root="{{ section.id }}"
         data-popup-config="{{ sw_config | strip_newlines | escape }}"
         aria-hidden="true">
  <div class="sw-overlay-{{ section.id }}" aria-hidden="true"></div>
  <div class="sw-card-{{ section.id }}" role="dialog" aria-modal="true"
       aria-labelledby="sw-title-{{ section.id }}" tabindex="-1">
    <button type="button" class="sw-close-{{ section.id }}" data-popup-close aria-label="{{ 'accessibility.close_popup' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

    <div class="sw-grid-{{ section.id }}{% if section.settings.wheel_side == 'wheel-right' %} sw-wheel-right{% endif %}">
      <div class="sw-text-{{ section.id }}">
        {%- if block_heading != blank and block_heading.settings.text != blank -%}
          <h2 class="sw-heading-{{ section.id }}" id="sw-title-{{ section.id }}"
              style="color: {% render 'scheme-color', color: block_heading.settings.color, fallback: 'var(--color-heading)' %};"
              {{ block_heading.shopify_attributes }}>{{ block_heading.settings.text }}</h2>
        {%- endif -%}
        {%- if block_description != blank and block_description.settings.text != blank -%}
          <p class="sw-description-{{ section.id }}"
             style="color: {% render 'scheme-color', color: block_description.settings.color, fallback: 'var(--color-text)' %};"
             {{ block_description.shopify_attributes }}>{{ block_description.settings.text }}</p>
        {%- endif -%}

        <div class="sw-pre-{{ section.id }}">
          {%- if block_form != blank -%}
            {%- assign sw_form_id = 'sw-form-' | append: section.id -%}
            {%- assign sw_form_class = 'sw-formel-' | append: section.id -%}
            <div class="sw-form-{{ section.id }}" {{ block_form.shopify_attributes }}>
              <form id="{{ sw_form_id }}" class="{{ sw_form_class }}" data-storelib-form="subscribe">
                {%- assign sw_email_ph = block_form.settings.email_placeholder | default: 'Email address' -%}
                <input type="email" name="email" required
                       autocomplete="email"
                       placeholder="{{ sw_email_ph | escape }}"
                       aria-label="{{ sw_email_ph | escape }}" data-popup-autofocus>
                {%- if block_form.settings.collect_phone -%}
                  {%- if block_form.settings.phone_required -%}{%- assign sw_phone_req = 'true' -%}{%- else -%}{%- assign sw_phone_req = 'false' -%}{%- endif -%}
                  {%- render 'cpnb-phone-field',
                      scope: section.id,
                      default_country: block_form.settings.phone_default_country,
                      phone_placeholder: block_form.settings.phone_placeholder,
                      required: sw_phone_req -%}
                {%- endif -%}
                <button type="submit" class="sw-spin-btn-{{ section.id }} btn-primary" data-theme-button="primary" data-sl-button
                        style="{%- render 'button-overrides', bg: section.settings.spin_btn_bg, text: section.settings.spin_btn_text, hover_bg: section.settings.spin_btn_bg_hover, hover_text: section.settings.spin_btn_text_hover -%}">
                  {{ block_form.settings.spin_label | default: fb_accessibility_spin_to_win }}
                </button>
              </form>
            </div>
          {%- endif -%}

          {%- if block_dismiss != blank and block_dismiss.settings.text != blank -%}
            <div class="sw-dismiss-wrap-{{ section.id }}" {{ block_dismiss.shopify_attributes }}>
              <button type="button" class="sw-dismiss-{{ section.id }}" data-popup-close>{{ block_dismiss.settings.text }}</button>
            </div>
          {%- endif -%}
        </div>

        <div class="sw-post-{{ section.id }}" aria-live="polite">
          <p class="sw-win-label-{{ section.id }}" data-sw-win-label-text>{{ section.settings.win_label | default: fb_accessibility_you_won }}</p>
          <h3 class="sw-win-title-{{ section.id }}" data-sw-win-title></h3>
          <button type="button" class="sw-win-code-{{ section.id }}" data-sw-win-code aria-label="{{ 'accessibility.copy_coupon_code' | t }}"></button>
          {%- comment -%}
            Re-spin CTA — only shown when the visitor lands on a no-code slice
            (TRY AGAIN). JS toggles its visibility via the .sw-can-respin
            class on the root.
          {%- endcomment -%}
          <button type="button" class="sw-respin-btn-{{ section.id }} btn-primary" data-theme-button="primary" data-sl-button data-sw-respin
                  style="{%- render 'button-overrides', bg: section.settings.spin_btn_bg, text: section.settings.spin_btn_text, hover_bg: section.settings.spin_btn_bg_hover, hover_text: section.settings.spin_btn_text_hover -%}">
            {{ section.settings.respin_label | default: fb_accessibility_spin_again }}
          </button>
        </div>
      </div>

      <div class="sw-wheel-col-{{ section.id }}">
        <div class="sw-wheel-{{ section.id }}">
          <div class="sw-wheel-pointer-{{ section.id }}"></div>
          {%- assign prize_count = 0 -%}
          {%- for b in section.blocks -%}{% if b.type == 'prize' %}{%- assign prize_count = prize_count | plus: 1 -%}{% endif %}{%- endfor -%}
          {%- comment -%}
            Wheel uses a conic-gradient for segment colors. Labels are absolutely
            positioned and rotated so each sits at its segment's center angle.
            All math is degree-based (Liquid has no trig); CSS handles the
            polar→cartesian conversion via rotate() transforms.
          {%- endcomment -%}
          {%- if prize_count == 0 -%}
            <div class="sw-wheel-svg-{{ section.id }}" style="background:#eee; display:flex; align-items:center; justify-content:center;">
              <span style="color:#999; font-size:12px;">{{ 'accessibility.add_prize_blocks' | t }}</span>
            </div>
          {%- else -%}
            {%- capture gradient -%}
              {%- assign idx = 0 -%}
              {%- for b in section.blocks -%}
                {%- if b.type == 'prize' -%}
                  {%- assign start_deg = idx | times: 360.0 | divided_by: prize_count | round: 3 -%}
                  {%- assign end_deg = idx | plus: 1 | times: 360.0 | divided_by: prize_count | round: 3 -%}
                  {%- assign segment_color = b.settings.color | default: '#ffffff' -%}
                  {%- if idx > 0 -%}, {% endif -%}{{ segment_color }} {{ start_deg }}deg {{ end_deg }}deg
                  {%- assign idx = idx | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            <div class="sw-wheel-svg-{{ section.id }}" style="background: conic-gradient(from 0deg, {{ gradient | strip }});">
              {%- comment -%}
                SVG label overlay. Each <text> sits at (100, 36) inside a 200×200
                viewBox (so y=36 is 64 units above the wheel center cy=100, putting
                the label at 64% radius). The transform rotates each label by its
                segment's mid-angle around the wheel center (100, 100), placing
                the text radially in its segment.
              {%- endcomment -%}
              <svg class="sw-wheel-labels-{{ section.id }}" viewBox="0 0 200 200" aria-hidden="true">
                {%- comment -%}
                  Label radial position: percentage of radius (0–100). y=100-radius
                  puts the text-anchor that far above the wheel center.
                {%- endcomment -%}
                {%- assign label_radius_pct = section.settings.label_radius | default: 68 -%}
                {%- assign label_y = 100 | minus: label_radius_pct -%}
                {%- assign label_font_size = section.settings.label_font_size | default: 10 -%}
                {%- comment -%}
                  Cap the merchant's font-size based on segment count. With more
                  segments, each slice is narrower so a smaller font is needed.
                  Cap formula: ~70 / N gives a sensible upper bound in viewBox
                  units. JS then fine-tunes via getBBox-based auto-fit.
                {%- endcomment -%}
                {%- assign cap = 60 | divided_by: prize_count -%}
                {%- if label_font_size > cap -%}
                  {%- assign label_font_size = cap -%}
                {%- endif -%}
                {%- assign idx = 0 -%}
                {%- for b in section.blocks -%}
                  {%- if b.type == 'prize' -%}
                    {%- assign mid_deg = idx | plus: 0.5 | times: 360.0 | divided_by: prize_count | round: 3 -%}
                    {%- comment -%}
                      Divider lines between slices intentionally omitted — the
                      conic-gradient already produces a clean boundary between
                      colors. Adding SVG lines on top creates a busy look.
                    {%- endcomment -%}
                    {%- comment -%}
                      Position the label at (100, label_y) — that's directly
                      above the wheel center at the configured radius — then
                      rotate the whole label by the segment's mid-angle around
                      the wheel center. A second inverse rotation around the
                      label's own anchor keeps the text axis-aligned (upright)
                      so it never appears tilted or upside-down regardless of
                      which slice it's in.
                    {%- endcomment -%}
                    <text
                      data-sw-segment="{{ idx }}"
                      data-sw-code="{{ b.settings.code | escape }}"
                      data-sw-label="{{ b.settings.label | default: '?' | escape }}"
                      data-sw-weight="{{ b.settings.weight | default: 1 }}"
                      x="100"
                      y="{{ label_y }}"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      font-size="{{ label_font_size }}"
                      fill="{{ b.settings.text_color | default: '#111111' }}"
                      transform="rotate({{ mid_deg }} 100 100) rotate({{ mid_deg | times: -1 }} 100 {{ label_y }})"
                    >{{ b.settings.label | default: '?' }}</text>
                    {%- assign idx = idx | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </svg>
            </div>
          {%- endif -%}
          <div class="sw-wheel-hub-{{ section.id }}"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  var WON_KEY = 'sw_won_' + SID;
  var RESPIN_KEY = 'sw_respins_' + SID;

  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__sw) return;
    root.__sw = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var SPIN = CFG.spin || {};
    var card = root.querySelector('.sw-card-' + SID);
    var form = root.querySelector('.sw-formel-' + SID);
    var spinBtn = form ? form.querySelector('.sw-spin-btn-' + SID) : null;
    var wheel = root.querySelector('.sw-wheel-svg-' + SID);
    var segments = Array.prototype.slice.call(root.querySelectorAll('[data-sw-segment]'));
    var titleEl = root.querySelector('[data-sw-win-title]');
    var codeEl = root.querySelector('[data-sw-win-code]');
    var labelEl = root.querySelector('[data-sw-win-label-text]');
    var respinBtn = root.querySelector('[data-sw-respin]');
    var design = !!CFG.design;
    var rotation = 0, running = false, closeTimer = 0, resetTimer = 0;
    var respinsLeft = parseInt(P.store.get(RESPIN_KEY) || '', 10);
    if (!isFinite(respinsLeft)) respinsLeft = +SPIN.respins || 0;

    var api = P.register({
      id: SID, root: root, dialog: card, backdrop: root.querySelector('.sw-overlay-' + SID),
      design: design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-sw-trigger="' + SID + '"]' }, CFG.trigger),
      frequency: { mode: CFG.frequency.mode === 'every_visit' ? 'always' : CFG.frequency.mode, days: CFG.frequency.days },
      open: function(){ root.classList.add('sw-open'); requestAnimationFrame(fitLabels); },
      close: function(){ root.classList.remove('sw-open'); clearTimeout(closeTimer); }
    });

    // Labels shrink until they fit their slice (measured once painted).
    function fitLabels(){
      var n = segments.length;
      if (!n) return;
      var r = 68;
      var maxW = Math.min(2 * Math.PI * r / n, 2 * r * Math.sin(Math.PI / n)) * 0.65;
      segments.forEach(function(text){
        var size = parseFloat(text.getAttribute('font-size')) || 11;
        for (var i = 0; i < 18; i++) {
          var box; try { box = text.getBBox(); } catch (e) { return; }
          if (!box.width || (box.width <= maxW && box.height <= r * 0.35) || size <= 5) break;
          size -= 1; text.setAttribute('font-size', size);
        }
      });
    }

    // Weighted pick; a weight of 0 never wins.
    function pick(){
      var w = segments.map(function(s){ var v = parseFloat(s.getAttribute('data-sw-weight')); return isFinite(v) && v >= 0 ? v : 1; });
      var total = w.reduce(function(a, b){ return a + b; }, 0);
      if (total <= 0) return Math.floor(Math.random() * segments.length);
      var x = Math.random() * total;
      for (var i = 0; i < w.length; i++) { x -= w[i]; if (x < 0) return i; }
      return w.length - 1;
    }
    // Slice i spans [i, i+1] x step degrees clockwise from the top, where the
    // pointer is. Turning the wheel by R puts local angle (360 - R) under it.
    function landed(){
      var step = 360 / segments.length;
      var under = ((360 - rotation % 360) % 360 + 360) % 360;
      return Math.min(segments.length - 1, Math.floor(under / step));
    }
    function spin(done){
      if (!wheel || !segments.length) { done(null); return; }
      var i = pick();
      var step = 360 / segments.length;
      var jitter = (Math.random() - 0.5) * step * 0.6;              // stays well inside the slice
      var target = (360 - ((i + 0.5) * step + jitter) % 360) % 360;
      var base = rotation - rotation % 360;
      rotation = base + (Math.max(3, +SPIN.turns || 5)) * 360 + target;
      var quick = P.reduced();
      wheel.style.transform = 'rotate(' + rotation + 'deg)';
      setTimeout(function(){ done(segments[landed()]); }, quick ? 60 : (+SPIN.seconds || 5) * 1000 + 120);
    }

    function reveal(seg){
      root.classList.add('sw-spun');
      if (!seg) return;
      var code = seg.getAttribute('data-sw-code') || '';
      var win = !!code;
      root.setAttribute('data-sw-result', win ? 'win' : 'none');
      if (titleEl) titleEl.textContent = win ? (seg.getAttribute('data-sw-label') || '') : (SPIN.noWin || '');
      if (labelEl) labelEl.hidden = !win;
      if (codeEl) { codeEl.textContent = code; codeEl.dataset.code = code; codeEl.style.display = win ? '' : 'none'; }
      root.classList.toggle('sw-can-respin', !win && respinsLeft > 0);
      var focus = win ? codeEl : (respinsLeft > 0 ? respinBtn : root.querySelector('.sw-close-' + SID));
      if (focus) { try { focus.focus({ preventScroll: true }); } catch (e) {} }
      if (win && !design) { P.store.set(WON_KEY, '1'); api && api.done(); }
      if (design) { clearTimeout(resetTimer); resetTimer = setTimeout(function(){ root.classList.remove('sw-spun', 'sw-can-respin'); }, 8000); }
    }

    function run(){
      if (running) return;
      running = true;
      var label = spinBtn ? spinBtn.textContent : '';
      if (spinBtn) { spinBtn.disabled = true; spinBtn.textContent = SPIN.spinning || label; }
      root.classList.add('sw-spinning');
      spin(function(seg){
        running = false;
        root.classList.remove('sw-spinning');
        if (spinBtn) { spinBtn.disabled = false; spinBtn.textContent = label; }
        reveal(seg);
      });
    }

    // The email goes to Storelib's Subscribers through the form itself
    // (data-storelib-form="subscribe"); the spin starts on that same submit.
    if (form) form.addEventListener('submit', function(e){
      var email = form.querySelector('input[type="email"]');
      if (email && email.checkValidity && !email.checkValidity()) return;
      if (design) e.preventDefault();
      run();
    });
    if (respinBtn) respinBtn.addEventListener('click', function(){
      if (running || respinsLeft <= 0) return;
      respinsLeft -= 1;
      if (!design) P.store.set(RESPIN_KEY, String(respinsLeft));
      root.classList.remove('sw-spun', 'sw-can-respin');
      run();
    });
    if (codeEl) codeEl.addEventListener('click', function(){
      var code = (codeEl.dataset.code || '').trim();
      if (!code) return;
      P.copy(code).catch(function(){}).then(function(){
        codeEl.classList.add('is-copied');
        codeEl.textContent = SPIN.copied || code;
        setTimeout(function(){ codeEl.classList.remove('is-copied'); codeEl.textContent = code; }, 2200);
        if (SPIN.closeAfterCopy && !design) { clearTimeout(closeTimer); closeTimer = setTimeout(function(){ api.hide(); }, (+SPIN.closeDelay || 10) * 1000); }
      });
    });

    window['SW_open_' + SID] = function(){ api.show(); };
    window['SW_close_' + SID] = function(){ api.hide(); };
    window['SW_reset_' + SID] = function(){ P.store.rm(WON_KEY); P.store.rm(RESPIN_KEY); api.reset(); respinsLeft = +SPIN.respins || 0; root.classList.remove('sw-spun', 'sw-can-respin'); };
  }

  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
{% comment %}{% endcomment %}</script>



</template>

<schema>
{
  "type": "spin-wheel-popup",
  "name": "Spin Wheel Popup",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Trigger"
    },
    {
      "type": "select",
      "id": "open_mode",
      "label": "Opens",
      "default": "delay",
      "options": [
        {
          "value": "immediate",
          "label": "On page load"
        },
        {
          "value": "delay",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        },
        {
          "value": "exit",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "manual",
          "label": "From a link"
        }
      ]
    },
    {
      "type": "range",
      "id": "delay_s",
      "label": "Delay",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "scroll_pct",
      "label": "Scrolled",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "page_views",
      "label": "Page views",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.open_mode == 'pageviews' }}"
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Behaviour"
    },
    {
      "type": "select",
      "id": "after_dismiss",
      "label": "Show again",
      "default": "after_days",
      "options": [
        {
          "value": "every_visit",
          "label": "Every visit"
        },
        {
          "value": "after_days",
          "label": "After days"
        },
        {
          "value": "never",
          "label": "Never"
        }
      ]
    },
    {
