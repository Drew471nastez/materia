    {
      "type": "color",
      "id": "separator_icon_color",
      "label": "Separator Icon Color",
      "info": "Set the color of the separator icon."
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Behavior & Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Automatically start scrolling the messages."
    },
    {
      "type": "number",
      "id": "scroll_speed",
      "label": "Scroll Speed (milliseconds)",
      "default": 1300,
      "info": "Set the duration for one complete scroll cycle."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true,
      "info": "Pause the scrolling when hovered over."
    },
    {
      "type": "checkbox",
      "id": "enable_link_redirect",
      "label": "Enable Link Redirection",
      "default": false,
      "info": "Make the bar clickable and redirect to a URL."
    },
    {
      "type": "select",
      "id": "background_animation",
      "label": "Background Animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "animation1",
          "label": "Subtle Pulse"
        },
        {
          "value": "animation6",
          "label": "Blur Transition"
        },
        {
          "value": "animation7",
          "label": "Zoom In-Out"
        },
        {
          "value": "animation10",
          "label": "Opacity Change"
        }
      ],
      "default": "none",
      "info": "Select the animation style for the background."
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover Effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "grow",
          "label": "Grow"
        },
        {
          "value": "color_change",
          "label": "Color Change"
        }
      ],
      "default": "none",
      "info": "Effect applied when the user hovers over the bar."
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar Height (px)",
      "min": 30,
      "max": 100,
      "step": 1,
      "default": 52,
      "info": "Adjust the height of the announcement bar."
    },
    {
      "type": "range",
      "id": "message_spacing",
      "label": "Spacing Between Messages (px)",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 22,
      "info": "Space between individual announcement messages."
    },
    {
      "type": "range",
      "id": "repetition_spacing",
      "label": "Spacing Between Repetitions (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 35,
      "info": "Space between repeated cycles of messages."
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
