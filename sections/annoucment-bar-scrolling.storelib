        "id": "message_1",
        "label": "Announcement Message 1",
        "default": "50% Off Everything Shop & Save ⚡",
        "hidden": true,
        "info": "Legacy: used only when the section has no Message block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "inline_richtext",
        "id": "message_2",
        "label": "Announcement Message 2",
        "default": "Free Shipping on Orders Over $99",
        "hidden": true,
        "info": "Legacy: used only when the section has no Message block.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "inline_richtext",
        "id": "message_3",
        "label": "Announcement Message 3",
        "info": "Legacy: used only when the section has no Message block.",
        "hidden": true,
        "visible_if": "{{ false }}"
      },
      {
        "type": "inline_richtext",
        "id": "message_4",
        "label": "Announcement Message 4",
        "info": "Legacy: used only when the section has no Message block.",
        "hidden": true,
        "visible_if": "{{ false }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "message_spacing",
        "label": "Space between messages",
        "min": 10,
        "max": 50,
        "step": 1,
        "default": 22
      },
      {
        "type": "range",
        "id": "repetition_spacing",
        "label": "Space between repeats",
        "min": 20,
        "max": 100,
        "step": 5,
        "default": 35
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "select",
        "id": "background_type",
        "label": "Background",
        "options": [
          {
            "value": "solid",
            "label": "Solid Color"
          },
          {
            "value": "gradient",
            "label": "Gradient"
          }
        ],
        "default": "solid"
      },
      {
        "type": "range",
        "id": "gradient_angle",
        "label": "Gradient angle",
        "min": 0,
