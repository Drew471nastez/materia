            "label": "Dot"
          },
          {
            "value": "fa-square",
            "label": "Square"
          },
          {
            "value": "fa-diamond",
            "label": "Diamond"
          },
          {
            "value": "fa-bolt",
            "label": "Bolt"
          },
          {
            "value": "fa-moon",
            "label": "Moon"
          },
          {
            "value": "fa-check",
            "label": "Check"
          },
          {
            "value": "fa-plus",
            "label": "Plus"
