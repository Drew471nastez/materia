<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- liquid
  assign __ab_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ab_reveal = section.settings.reveal
-%}
<style>
  /* Theme typography for announcement bars */
  #shopify-section-{{ section.id }} { font-family: var(--body-font, inherit); }
{% comment %}{% endcomment %}</style>
<!-- ab-theme:start -->
<!-- ti-theme:end -->



<div
  id="announcement-bar-pro-1-{{ section.id }}"
  class="announcement-bar-pro-1 announcement-bar-container color-{{ color_scheme }} gradient {{ section.settings.section_width }} {% if section.settings.enable_sticky_bar %}sticky{% endif %} {% if section.settings.background_animation != 'none' %}{{ section.settings.background_animation }}{% endif %} {% if section.settings.hover_effect != 'none' %}hover-{{ section.settings.hover_effect }}{% endif %}"
  aria-live="polite"
>
  {% if section.settings.enable_link_redirect and section.settings.redirect_url != '#' %}
    <a
      href="{{ section.settings.redirect_url }}"
      class="announcement-bar-link"
      target="_blank"
      rel="noopener noreferrer"
    >
  {% endif %}
  <div class="announcement-bar{% unless section.settings.autoplay %} no-autoplay{% endunless %}{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}">
    <div class="announcement-content">
      {% assign messages = '' %}
      {% for i in (1..4) %}
        {% assign message_key = 'message_' | append: i %}
        {% assign msg = section.settings[message_key] %}
        {% if msg != blank %}
          {% assign messages = messages | append: msg | append: '\n' %}
        {% endif %}
      {% endfor %}
      {% assign messages = messages | split: '\n' %}
      {% for n in (1..100) %}
        {% for message in messages %}
          <span class="announcement-message">{{ message | upcase }}</span>
          {% if forloop.last == false %}
            {% if section.settings.separator_icon != blank %}
              <i class="separator-icon fas {{ section.settings.separator_icon }}"></i>
            {% else %}
              <span class="separator-icon">●●</span>
            {% endif %}
          {% endif %}
        {% endfor %}
        {% unless forloop.last %}
          <span class="repetition-spacing" style="margin-right: {{ section.settings.repetition_spacing }}px;"></span>
        {% endunless %}
      {% endfor %}
    </div>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <!-- Duplicate the announcement-content for seamless infinite scrolling -->
    <div class="announcement-content">
      {% for n in (1..100) %}
        {% for message in messages %}
          <span class="announcement-message">{{ message | upcase }}</span>
          {% if forloop.last == false %}
            {% if section.settings.separator_icon != blank %}
              <i class="separator-icon fas {{ section.settings.separator_icon }}"></i>
            {% else %}
              <span class="separator-icon">●●</span>
            {% endif %}
          {% endif %}
        {% endfor %}
        {% unless forloop.last %}
          <span class="repetition-spacing" style="margin-right: {{ section.settings.repetition_spacing }}px;"></span>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
  {% if section.settings.enable_link_redirect and section.settings.redirect_url != '#' %}
    </a>
  {% endif %}
</div>

<style>
  {% if section.settings.enable_custom_font %}
    {{ section.settings.announcement_font | font_face }}
  {% endif %}

  /* Containment — guarantees the announcement bar can NEVER overlap
     the header (which is z-index 11 when sticky). `isolation: isolate`
     creates a stacking context so internal z-indexes can't escape;
     `z-index: 0` keeps the section anchored well below the header. */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    z-index: 0;
  }

  /* All rules are instance-scoped by section id to avoid cross-instance bleed. */
  #announcement-bar-pro-1-{{ section.id }} {
    position: relative;
    z-index: 0;
    width: 100%;
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container {
    width: 100%;
    color: {% render 'scheme-color', color: section.settings.message_text_color, fallback: 'var(--color-text)' %} !important;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    height: {{ section.settings.bar_height }}px;
    display: flex;
    align-items: center;
    background: {% if section.settings.background_type == 'solid' %}
      {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};
    {% else %}
      linear-gradient({{ section.settings.gradient_angle }}deg, {% render 'scheme-color', color: section.settings.gradient_start_color, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: section.settings.gradient_end_color, fallback: 'var(--color-primary)' %});
    {% endif %};
    transition: all 0.3s ease;
  }

  #announcement-bar-pro-1-{{ section.id }} .announcement-message {
    display: inline-block;
    font-size: {{ section.settings.font_size }}px;
    margin-right: {{ section.settings.message_spacing }}px;
    line-height: 1.2;
    color: {% render 'scheme-color', color: section.settings.message_text_color, fallback: 'var(--color-text)' %} !important;
    font-weight: {{ section.settings.message_font_weight }}; /* NEW: weight selector */
    {% if section.settings.enable_custom_font %}
      font-family: {{ section.settings.announcement_font.family }}, sans-serif !important;
    {% else %}
      font-family: inherit;
    {% endif %}
  }

  #announcement-bar-pro-1-{{ section.id }} .separator-icon {
    display: inline-block;
    vertical-align: middle;
    margin-right: {{ section.settings.message_spacing }}px;
    color: {% render 'scheme-color', color: section.settings.separator_icon_color, fallback: 'var(--color-primary)' %} !important;
    font-size: {{ section.settings.font_size }}px;
  }

  #announcement-bar-pro-1-{{ section.id }}.sticky {
    position: sticky;
    top: 0;
    /* Lowered from 10 → 5 so the announcement bar sits SAFELY below
       the theme header in every scenario. The header uses z-index 11
       when sticky; when not sticky it uses z-index auto and we still
       can't overlap because the outer wrapper has `isolation: isolate`
       which prevents this internal z-index from escaping anyway. */
    z-index: 5;
    transition: all 0.3s ease-in-out;
  }

  .content-below {
    margin-top: var(--announcement-bar-height, 0px);
    transition: margin-top 0.3s ease-in-out;
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.animation1 {
    animation: announcementPulse 5s infinite;
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.animation6 {
    animation: announcementBlurTransition 7s infinite;
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.animation7 {
    animation: announcementZoomInOut 9s infinite;
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.animation10 {
    animation: announcementOpacityChange 4s infinite;
  }

  /* Hover Effects */
  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.hover-grow:hover {
    transform: scale(1.05);
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.hover-shrink:hover {
    transform: scale(0.95);
  }

  #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container.hover-color_change:hover {
    filter: brightness(1.2);
  }

  /* Keyframe Animations (global names, harmless across instances) */
  @keyframes announcementPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @keyframes announcementSmoothFade {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  @keyframes announcementSlideIn {
    0% { background-position: -100% 0; }
    100% { background-position: 100% 0; }
  }

  @keyframes announcementColorShift {
    0% {
      background: {% if section.settings.background_type == 'solid' %}
        {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};
      {% else %}
        linear-gradient({{ section.settings.gradient_angle }}deg, {% render 'scheme-color', color: section.settings.gradient_start_color, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: section.settings.gradient_end_color, fallback: 'var(--color-primary)' %});
      {% endif %};
    }
    50% {
      background: {% if section.settings.background_type == 'solid' %}
        {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};
      {% else %}
        linear-gradient({{ section.settings.gradient_angle }}deg, {% render 'scheme-color', color: section.settings.gradient_end_color, fallback: 'var(--color-primary)' %}, {% render 'scheme-color', color: section.settings.gradient_start_color, fallback: 'var(--color-background)' %});
      {% endif %};
    }
    100% {
      background: {% if section.settings.background_type == 'solid' %}
        {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};
      {% else %}
        linear-gradient({{ section.settings.gradient_angle }}deg, {% render 'scheme-color', color: section.settings.gradient_start_color, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: section.settings.gradient_end_color, fallback: 'var(--color-primary)' %});
      {% endif %};
    }
  }

  @keyframes announcementWave {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes announcementBlurTransition {
    0%, 100% { filter: blur(0px); }
    50% { filter: blur(2px); }
  }

  @keyframes announcementZoomInOut {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @keyframes announcementRotateBackground {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes announcementScalePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes announcementOpacityChange {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  #announcement-bar-pro-1-{{ section.id }} .announcement-bar {
    display: flex;
    {% if section.settings.autoplay %}
      animation: announcementScroll {{ section.settings.scroll_speed }}s linear infinite; /* kept as-is */
    {% endif %}
  }

  #announcement-bar-pro-1-{{ section.id }} .announcement-bar-link {
    display: flex;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  {% if section.settings.pause_on_hover %}
  #announcement-bar-pro-1-{{ section.id }} .announcement-bar.pause-on-hover:hover {
    animation-play-state: paused;
  }
  {% endif %}

  #announcement-bar-pro-1-{{ section.id }} .announcement-content {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  @keyframes announcementScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    #announcement-bar-pro-1-{{ section.id }}.announcement-bar-container {
      height: calc({{ section.settings.bar_height }}px - 5px);
    }

    #announcement-bar-pro-1-{{ section.id }} .announcement-message {
      font-size: calc({{ section.settings.font_size }}px - 2px);
      margin-right: {{ section.settings.message_spacing }}px;
    }

    #announcement-bar-pro-1-{{ section.id }} .separator-icon {
      margin-right: {{ section.settings.message_spacing }}px;
      font-size: calc({{ section.settings.font_size }}px - 2px);
    }
  }
{% comment %}{% endcomment %}</style>

<script>
  // Scoped JavaScript for Announcement Bar Pro 1 (for any additional logic)
  document.addEventListener('DOMContentLoaded', function() {
    const root = document.getElementById('announcement-bar-pro-1-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.announcement-bar').forEach(function(announcementBar) {
      // Reserved for per-instance enhancements if needed
    });
  });
{% comment %}{% endcomment %}</script>

<script>
  // Adjust sticky behavior and margin for this instance only
  document.addEventListener("DOMContentLoaded", function () {
    const stickyBar = document.getElementById("announcement-bar-pro-1-{{ section.id }}");
    if (!stickyBar) return;

    const nextSibling = stickyBar.nextElementSibling;
    if (nextSibling && nextSibling.classList.contains("content-below")) {
      nextSibling.style.marginTop = stickyBar.offsetHeight + "px";
    }

    // Only toggle 'sticky' on this instance to avoid cross-instance interference
    window.addEventListener("scroll", function () {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      if (scrollTop > 0) {
        stickyBar.classList.add("sticky");
      } else {
        stickyBar.classList.remove("sticky");
      }
    });
  });
{% comment %}{% endcomment %}</script>

</template>

<schema>
{
  "type": "annoucment-bar-scrolling",
  "name": "Announcement Bar Pro 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "General"
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "message_1",
      "label": "Announcement Message 1",
      "default": "50% Off Everything Shop & Save ⚡",
      "info": "First announcement message displayed in the bar."
    },
    {
      "type": "inline_richtext",
      "id": "message_2",
      "label": "Announcement Message 2",
      "default": "Free Shipping on Orders Over $99",
      "info": "Second announcement message displayed in the bar."
    },
    {
      "type": "inline_richtext",
      "id": "message_3",
      "label": "Announcement Message 3",
      "info": "Optional third announcement message."
    },
    {
      "type": "inline_richtext",
      "id": "message_4",
      "label": "Announcement Message 4",
      "info": "Optional fourth announcement message."
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "Redirect URL",
      "default": "/",
      "info": "Set the URL to redirect when the bar is clicked."
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Enable Custom Font",
      "default": false,
      "info": "Toggle to enable or disable custom fonts for text."
    },
    {
      "type": "font_picker",
      "id": "announcement_font",
      "label": "Announcement Font",
      "default": "sans-serif",
      "info": "Select the font family for the announcement text."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 15,
      "info": "Adjust the size of the announcement text."
    },
    {
      "type": "select",
      "id": "message_font_weight",
      "label": "Announcement Message Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light (300)"
        },
        {
          "value": "400",
          "label": "Regular (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semibold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        }
      ],
      "default": "600",
      "info": "Font weight for the announcement messages."
    },
    {
      "type": "color",
      "id": "message_text_color",
      "label": "Announcement Message Text Color",
      "info": "Color of the announcement messages text."
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Style & Colors"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "solid",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "solid",
      "info": "Select the type of background for the bar."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "info": "Background color when using a solid color type."
    },
    {
      "type": "color",
      "id": "gradient_start_color",
      "label": "Gradient Start Color",
      "info": "Starting color of the gradient background."
    },
    {
      "type": "color",
      "id": "gradient_end_color",
      "label": "Gradient End Color",
      "info": "Ending color of the gradient background."
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient Angle (degrees)",
      "min": 0,
      "max": 360,
      "step": 10,
      "default": 90,
      "info": "Set the angle of the gradient background."
    },
    {
      "type": "select",
      "id": "separator_icon",
      "label": "Separator Icon",
      "options": [
