      },
      {
        "type": "color",
        "id": "gradient_start_color",
        "label": "Gradient start",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.background_type == 'gradient' }}"
      },
      {
        "type": "color",
        "id": "gradient_end_color",
        "label": "Gradient end",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.background_type == 'gradient' }}"
      },
      {
        "type": "color",
        "id": "separator_icon_color",
        "label": "Separator",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.separator_icon != 'none' }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_font",
