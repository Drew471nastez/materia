      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "Each Message block is one announcement. The messages repeat across the bar."
      },
      {
        "type": "checkbox",
        "id": "enable_link_redirect",
        "label": "Link the whole bar",
        "default": false
