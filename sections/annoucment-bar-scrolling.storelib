            "label": "Leaf"
          },
          {
            "value": "fa-fire",
            "label": "Flame"
          },
          {
            "value": "fa-gift",
            "label": "Gift"
          },
          {
            "value": "fa-truck",
            "label": "Truck"
          },
          {
            "value": "fa-snowflake",
            "label": "Snowflake"
          },
          {
            "value": "none",
            "label": "None"
          }
        ],
        "default": "fa-sun"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "message_text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colour",
