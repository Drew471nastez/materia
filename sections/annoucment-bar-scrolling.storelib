        "min": 12,
        "max": 100,
        "step": 1,
        "default": 15,
        "info": "2px smaller on mobile."
      },
      {
        "type": "select",
        "id": "message_font_weight",
        "label": "Text weight",
        "options": [
          {
            "value": "300",
            "label": "Light (300)"
          },
          {
            "value": "400",
            "label": "Regular (400)"
          },
          {
            "value": "500",
            "label": "Medium (500)"
          },
          {
            "value": "600",
            "label": "Semibold (600)"
          },
          {
            "value": "700",
            "label": "Bold (700)"
          }
        ],
        "default": "600"
      },
      {
        "type": "checkbox",
        "id": "uppercase",
        "label": "Uppercase",
        "default": true
