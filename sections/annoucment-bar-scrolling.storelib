    "class": "section-edge-bleed",
    "blocks": [
      {
        "type": "message",
        "name": "Message",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text",
            "default": "Write your announcement"
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
