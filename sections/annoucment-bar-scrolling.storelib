      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Scroll the messages",
        "default": true,
        "info": "Stops for visitors who reduce motion."
      },
      {
        "type": "number",
        "id": "scroll_speed",
        "label": "Scroll duration",
        "default": 1300,
        "info": "Higher is slower.",
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": true,
        "visible_if": "{{ section.settings.autoplay }}"
      },
      {
        "type": "select",
        "id": "background_animation",
        "label": "Background animation",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "animation1",
            "label": "Subtle Pulse"
          },
          {
            "value": "animation6",
            "label": "Blur Transition"
          },
          {
            "value": "animation7",
            "label": "Zoom In-Out"
          },
          {
            "value": "animation10",
            "label": "Opacity Change"
          }
        ],
        "default": "none"
      },
      {
        "type": "select",
        "id": "hover_effect",
        "label": "Hover effect",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "grow",
            "label": "Grow"
          },
          {
            "value": "color_change",
            "label": "Color Change"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "bar_height",
        "label": "Bar height",
        "min": 30,
        "max": 100,
        "step": 1,
        "default": 52,
        "info": "5px lower on mobile."
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "label": "Top margin (desktop)",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "label": "Bottom margin (desktop)",
