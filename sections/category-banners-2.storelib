        "options": [
          {
            "value": "21 / 9",
            "label": "Ultra wide (21:9)"
          },
          {
            "value": "16 / 9",
            "label": "Wide (16:9)"
          },
          {
            "value": "3 / 1",
            "label": "Banner (3:1)"
          },
          {
            "value": "4 / 1",
            "label": "Thin banner (4:1)"
          },
          {
            "value": "1 / 1",
            "label": "Square (1:1)"
          },
          {
            "value": "4 / 5",
            "label": "Portrait (4:5)"
          }
        ]
      },
      {
        "type": "select",
        "id": "aspect_ratio_mobile",
        "label": "Banner shape on phones",
