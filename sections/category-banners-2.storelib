<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_banner = 'accessibility.banner' | t -%}
{%- comment -%} Connect this section to the theme-level animation settings (Theme settings > Animations). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%} Remove default space between sections (margins only, never padding). {%- endcomment -%}
{%- if section.settings.reset_spacing -%}
<style>
  #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
<style>
  /* Section width */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc({{ settings.page_width | default: 1300 }}px + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem);
        margin-inline: auto;
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ section.id }} {
        padding-inline: 1.5rem;
        box-sizing: border-box;
      }
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} { padding-inline: 3rem; }
      }
    {%- when 'full_width' -%}
      /* full bleed */
  {%- endcase -%}
{% comment %}{% endcomment %}</style>

{%- liquid
  assign s   = section.settings
  assign sid = section.id
  assign custom = s.enable_custom_styling

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  # --- Blocks: one optional heading, one optional subheading, then banners ---
  assign banner_count = 0
  assign heading_found = false
  assign subheading_found = false
  for block in section.blocks
    case block.type
      when 'banner'
        assign banner_count = banner_count | plus: 1
      when 'heading'
        unless heading_found
          assign heading_block = block
          assign heading_found = true
        endunless
      when 'subheading'
        unless subheading_found
          assign subheading_block = block
          assign subheading_found = true
        endunless
    endcase
  endfor
  if heading_found
    assign hb = heading_block.settings
  endif
  if subheading_found
    assign sb = subheading_block.settings
  endif

  # --- Section heading + subheading blocks: theme type unless the block's own style is on ---
  assign h_custom = false
  assign h_style = 'h2'
  assign c_head = ''
  if heading_found
    assign h_style = hb.heading_size | default: 'h2'
    if hb.custom_style
      assign h_custom = true
      assign c_head = hb.heading_color
    endif
  endif
  assign s_custom = false
  assign s_style = 'body'
  assign c_headsub = ''
  if subheading_found
    assign s_style = sb.text_size | default: 'body'
    if sb.custom_style
      assign s_custom = true
      assign c_headsub = sb.subheading_color
    endif
  endif
  case h_style
    when 'h1'
      assign h_fb = 56
      assign h_fb_m = 36
    when 'h3'
      assign h_fb = 24
      assign h_fb_m = 20
    else
      assign h_fb = 36
      assign h_fb_m = 30
  endcase
  case s_style
    when 'body_large'
      assign s_fb = 18
    when 'body_small'
      assign s_fb = 14
    else
      assign s_fb = 16
  endcase

  # --- Banner title + line: theme text styles by default ---
  assign t_style = s.heading_style | default: 'h2'
  case t_style
    when 'h1'
      assign t_fb = 56
      assign t_fb_m = 36
    when 'h3'
      assign t_fb = 24
      assign t_fb_m = 20
    when 'h4'
      assign t_fb = 20
      assign t_fb_m = 18
    else
      assign t_fb = 36
      assign t_fb_m = 30
  endcase
  assign b_style = s.sub_style | default: 'body'
  case b_style
    when 'body_large'
      assign b_fb = 18
    when 'body_small'
      assign b_fb = 14
    else
      assign b_fb = 16
  endcase

  # --- Custom colours only when the creator turns them on ---
  assign c_title = ''
  assign c_sub = ''
  assign c_line = ''
  assign c_img_bg = ''
  assign c_bg = ''
  if custom
    assign c_title = s.heading_color
    assign c_sub = s.sub_color
    assign c_line = s.underline_color
    assign c_img_bg = s.image_bg
    assign c_bg = s.section_bg
  endif

  # --- Grid + image sizes ---
  assign cols = 1
  if s.layout == 'grid_2'
    assign cols = 2
  elsif s.layout == 'grid_3'
    assign cols = 3
  endif
  assign mcols = 1
  if s.mobile_layout == 'grid_2'
    assign mcols = 2
  endif
  case cols
    when 2
      assign img_sizes = '(min-width: 750px) 50vw, 100vw'
    when 3
      assign img_sizes = '(min-width: 750px) 33vw, 100vw'
    else
      assign img_sizes = '100vw'
  endcase
  if mcols == 2 and cols == 1
    assign img_sizes = '(min-width: 750px) 100vw, 50vw'
  endif

  # --- Overlay: base and hover; per-banner overrides keep the same hover lift ---
  assign ov_base = s.overlay_opacity | default: 0
  assign ov_hover = s.overlay_opacity_hover | default: 0
  assign ov_delta = ov_hover | minus: ov_base | divided_by: 100.0
  assign ov_base_f = ov_base | divided_by: 100.0
-%}

<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} .cb-wrap { container-type: inline-size; container-name: cb2-{{ sid }}; }
  #shopify-section-{{ sid }} .cb,
  #shopify-section-{{ sid }} .cb *,
  #shopify-section-{{ sid }} .cb *::before,
  #shopify-section-{{ sid }} .cb *::after { box-sizing: border-box; }

  /* ---- Shell + spacing ---- */
  #shopify-section-{{ sid }} .cb {
    background: {% render 'scheme-color', color: c_bg, fallback: 'transparent' %};
    padding: {{ s.padding_top | default: 0 }}px {{ s.side_padding_mobile | default: 0 }}px {{ s.padding_bottom | default: 0 }}px;
  }
  @container cb2-{{ sid }} (min-width: 750px) {
    #shopify-section-{{ sid }} .cb {
      padding-left: {{ s.side_padding_desktop | default: 0 }}px;
      padding-right: {{ s.side_padding_desktop | default: 0 }}px;
    }
  }

  /* ---- Optional section heading + subheading (theme typography by default) ---- */
  #shopify-section-{{ sid }} .cb__head {
    padding-inline: 16px;
    text-align: {% if s.header_alignment == 'left' %}left{% else %}center{% endif %};
  }
  #shopify-section-{{ sid }} .cb__head-title {
    max-width: 52rem;
    margin: 0 {% if s.header_alignment == 'left' %}0{% else %}auto{% endif %} {{ hb.space_below_mobile | default: 10 }}px;
    font-family: var(--type-{{ h_style }}-font, var(--heading-font, inherit));
    font-size: var(--type-{{ h_style }}-size, {{ h_fb_m }}px);
    font-weight: var(--type-{{ h_style }}-weight, 700);
    line-height: var(--type-{{ h_style }}-line-height, 1.2);
    letter-spacing: var(--type-{{ h_style }}-letter-spacing, normal);
    text-transform: var(--type-{{ h_style }}-transform, none);
    color: {% render 'scheme-color', color: c_head, fallback: 'var(--color-heading)' %};
    text-wrap: balance;
  }
  #shopify-section-{{ sid }} .cb__head-sub {
    max-width: 40rem;
    margin: 0 {% if s.header_alignment == 'left' %}0{% else %}auto{% endif %} {{ sb.space_below_mobile | default: 24 }}px;
    font-family: var(--type-{{ s_style }}-font, var(--body-font, inherit));
    font-size: var(--type-{{ s_style }}-size, {{ s_fb }}px);
    font-weight: var(--type-{{ s_style }}-weight, 400);
    line-height: var(--type-{{ s_style }}-line-height, 1.6);
    color: {% render 'scheme-color', color: c_headsub, fallback: 'var(--color-text)' %};
    text-wrap: pretty;
  }
  #shopify-section-{{ sid }} .cb__head-title:last-child { margin-bottom: {{ sb.space_below_mobile | default: 24 }}px; }
  {%- if h_custom %}
  #shopify-section-{{ sid }} .cb__head-title {
    font-weight: {{ hb.heading_font_weight | default: '700' }};
    font-size: {{ hb.heading_font_size_mobile | default: 26 }}px;
    line-height: 1.2;
  }
  {%- endif %}
  {%- if s_custom %}
  #shopify-section-{{ sid }} .cb__head-sub {
    font-weight: {{ sb.subheading_font_weight | default: '400' }};
    font-size: {{ sb.subheading_font_size_mobile | default: 14 }}px;
    line-height: 1.5;
  }
  {%- endif %}
  @container cb2-{{ sid }} (min-width: 750px) {
    #shopify-section-{{ sid }} .cb__head-title {
      margin-bottom: {{ hb.space_below_desktop | default: 16 }}px;
      {%- if h_custom %}
      font-size: {{ hb.heading_font_size_desktop | default: 32 }}px;
      {%- else %}
      font-size: var(--type-{{ h_style }}-size, {{ h_fb }}px);
      {%- endif %}
    }
    #shopify-section-{{ sid }} .cb__head-sub {
      margin-bottom: {{ sb.space_below_desktop | default: 32 }}px;
      {%- if s_custom %}
      font-size: {{ sb.subheading_font_size_desktop | default: 16 }}px;
      {%- endif %}
    }
  }
  #shopify-section-{{ sid }} .cb__rt p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .cb__rt p + p { margin-top: 0.6em; }
  #shopify-section-{{ sid }} .cb__rt strong,
  #shopify-section-{{ sid }} .cb__rt b { font-weight: 700; }
  #shopify-section-{{ sid }} .cb__rt em { font-style: italic; }
  #shopify-section-{{ sid }} .cb__head .cb__rt a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }

  /* ---- Grid ---- */
  #shopify-section-{{ sid }} .cb__list {
    display: grid;
    grid-template-columns: repeat({{ mcols }}, minmax(0, 1fr));
    gap: {{ s.gap | default: 0 }}px;
    margin: 0; padding: 0;
    list-style: none;
  }
  #shopify-section-{{ sid }} .cb__list > li { margin: 0; padding: 0; min-width: 0; }
  @container cb2-{{ sid }} (min-width: 750px) {
    #shopify-section-{{ sid }} .cb__list { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); }
  }

  /* ---- Banner ---- */
  #shopify-section-{{ sid }} .cb__item {
    --cb-ov: {% render 'scheme-color', color: s.overlay_color, fallback: '#000000' %};
    --cb-ov-o: {{ ov_base_f }};
    --cb-title: {% render 'scheme-color', color: c_title, fallback: '#ffffff' %};
    --cb-sub: {% render 'scheme-color', color: c_sub, fallback: 'rgba(255, 255, 255, 0.92)' %};
    --cb-dur: {{ s.hover_duration | default: 700 }}ms;
    --cb-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: {% render 'scheme-color', color: c_img_bg, fallback: '#1f2937' %};
    border-radius: {% if s.corner_style == 'theme' %}var(--media-radius, var(--image-radius, 8px)){% else %}{{ s.border_radius | default: 0 }}px{% endif %};
    aspect-ratio: {{ s.aspect_ratio_mobile | default: '16 / 9' }};
    -webkit-tap-highlight-color: transparent;
  }
  @container cb2-{{ sid }} (min-width: 750px) {
    #shopify-section-{{ sid }} .cb__item { aspect-ratio: {{ s.aspect_ratio_desktop | default: '21 / 9' }}; }
  }
  #shopify-section-{{ sid }} a.cb__item { cursor: pointer; }
  #shopify-section-{{ sid }} a.cb__item:focus-visible { outline: 2px solid #ffffff; outline-offset: -6px; }

  #shopify-section-{{ sid }} .cb__media,
  #shopify-section-{{ sid }} .cb__media picture { position: absolute; inset: 0; display: block; }
  #shopify-section-{{ sid }} .cb__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transform: scale({{ s.image_base_scale | default: 100 | divided_by: 100.0 }});
    transition: transform var(--cb-dur) var(--cb-ease);
    backface-visibility: hidden;
  }

  #shopify-section-{{ sid }} .cb__overlay {
    position: absolute; inset: 0;
    background: var(--cb-ov);
    opacity: var(--cb-ov-o);
    transition: opacity var(--cb-dur) ease;
    pointer-events: none;
  }

  /* ---- Text ---- */
  #shopify-section-{{ sid }} .cb__content {
    position: absolute; inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(16px, 5cqi, 40px);
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .cb__content--top    { justify-content: flex-start; }
  #shopify-section-{{ sid }} .cb__content--bottom { justify-content: flex-end; }
  #shopify-section-{{ sid }} .cb__content--left   { align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .cb__content--right  { align-items: flex-end; text-align: right; }

  #shopify-section-{{ sid }} .cb__heading {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin: 0;
    color: var(--cb-title);
    font-family: var(--type-{{ t_style }}-font, var(--heading-font, inherit));
    font-size: var(--type-{{ t_style }}-size, {{ t_fb_m }}px);
    font-weight: var(--type-{{ t_style }}-weight, 700);
    line-height: var(--type-{{ t_style }}-line-height, 1.15);
    letter-spacing: {{ s.heading_letter_spacing | default: 0 }}em;
    text-transform: {% if s.heading_uppercase %}uppercase{% else %}none{% endif %};
    text-shadow: {{ s.heading_shadow | default: 'none' }};
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .cb__sub {
    margin: 8px 0 0;
    max-width: 34rem;
    color: var(--cb-sub);
    font-family: var(--type-{{ b_style }}-font, var(--body-font, inherit));
    font-size: var(--type-{{ b_style }}-size, {{ b_fb }}px);
    font-weight: var(--type-{{ b_style }}-weight, 400);
    line-height: var(--type-{{ b_style }}-line-height, 1.5);
    text-shadow: {{ s.heading_shadow | default: 'none' }};
    text-wrap: pretty;
  }
  {%- if custom %}
  #shopify-section-{{ sid }} .cb__heading {
    font-size: {{ s.heading_size_mobile | default: 28 }}px;
    font-weight: {{ s.heading_weight | default: 700 }};
    line-height: 1.1;
  }
  #shopify-section-{{ sid }} .cb__sub { font-size: {{ s.sub_size | default: 14 }}px; }
  {%- endif %}
  @container cb2-{{ sid }} (min-width: 750px) {
    #shopify-section-{{ sid }} .cb__heading {
      {%- if custom %}
      font-size: {{ s.heading_size_desktop | default: 42 }}px;
      {%- else %}
      font-size: var(--type-{{ t_style }}-size, {{ t_fb }}px);
      {%- endif %}
    }
  }

  /* Underline that draws in on hover */
  #shopify-section-{{ sid }} .cb__heading::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    bottom: -{{ s.underline_offset | default: 6 }}px;
    height: {{ s.underline_thickness | default: 2 }}px;
    background: {% render 'scheme-color', color: c_line, fallback: 'currentColor' %};
    transform: scaleX(0);
    transform-origin: {% if s.underline_origin == 'right' %}right{% elsif s.underline_origin == 'center' %}center{% else %}left{% endif %} center;
    transition: transform {{ s.underline_duration | default: 350 }}ms var(--cb-ease);
  }

  /* Subheading on hover only, but always on touch screens where there is no hover */
  {%- if s.sub_visibility != 'always' %}
  @media (hover: hover) {
    #shopify-section-{{ sid }} .cb__sub {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity var(--cb-dur) ease 80ms, transform var(--cb-dur) var(--cb-ease) 80ms;
    }
  }
  {%- endif %}

  /* Hover + keyboard focus, only on devices that hover (no sticky taps on phones) */
  @media (hover: hover) {
    #shopify-section-{{ sid }} a.cb__item:hover .cb__img { transform: scale({{ s.image_hover_scale | default: 105 | divided_by: 100.0 }}); }
    #shopify-section-{{ sid }} .cb__item:hover .cb__overlay { opacity: clamp(0, calc(var(--cb-ov-o) + {{ ov_delta }}), 0.9); }
    #shopify-section-{{ sid }} a.cb__item:hover .cb__heading::after { transform: scaleX(1); }
    #shopify-section-{{ sid }} .cb__item:hover .cb__sub { opacity: 1; transform: none; }
  }
  #shopify-section-{{ sid }} a.cb__item:focus-visible .cb__img { transform: scale({{ s.image_hover_scale | default: 105 | divided_by: 100.0 }}); }
  #shopify-section-{{ sid }} .cb__item:focus-visible .cb__overlay { opacity: clamp(0, calc(var(--cb-ov-o) + {{ ov_delta }}), 0.9); }
  #shopify-section-{{ sid }} a.cb__item:focus-visible .cb__heading::after { transform: scaleX(1); }
  #shopify-section-{{ sid }} .cb__item:focus-visible .cb__sub { opacity: 1; transform: none; }

  #shopify-section-{{ sid }} .cb__empty {
    margin: 0; padding: 32px 16px; text-align: center;
    font-size: 14px; color: var(--color-text); opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .cb__img,
    #shopify-section-{{ sid }} .cb__overlay,
    #shopify-section-{{ sid }} .cb__heading::after,
    #shopify-section-{{ sid }} .cb__sub { transition: none !important; }
    #shopify-section-{{ sid }} .cb__item:hover .cb__img,
    #shopify-section-{{ sid }} .cb__item:focus-visible .cb__img { transform: scale({{ s.image_base_scale | default: 100 | divided_by: 100.0 }}) !important; }
  }
{% comment %}{% endcomment %}</style>

<div class="section cb-wrap color-{{ color_scheme }} gradient{{ reset_spacing }}">
  <div class="cb" data-section-id="{{ sid }}">

    {%- if heading_found and hb.heading != blank or subheading_found and sb.subheading != blank -%}
      <div class="cb__head">
        {%- if heading_found and hb.heading != blank -%}
          <h2 class="cb__head-title cb__rt" {{ heading_block.shopify_attributes }}>{{ hb.heading }}</h2>
        {%- endif -%}
        {%- if subheading_found and sb.subheading != blank -%}
          <div class="cb__head-sub cb__rt" {{ subheading_block.shopify_attributes }}>{{ sb.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if banner_count > 0 -%}
    <ul class="cb__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' -%}
        {%- liquid
          assign bs = block.settings
          assign banner_link = bs.link
          if banner_link == blank and bs.collection != blank
            assign banner_link = bs.collection.url
          endif
          assign banner_image = bs.image
          if banner_image == blank and bs.collection != blank
            assign banner_image = bs.collection.featured_image
          endif
          assign banner_mobile = bs.image_mobile
          if banner_image == blank and banner_mobile != blank
            assign banner_image = banner_mobile
            assign banner_mobile = blank
          endif
          if banner_image == blank and s.placeholder_url != blank
            assign banner_image = s.placeholder_url
          endif
          assign banner_heading = bs.heading
          if banner_heading == blank and bs.collection != blank
            assign banner_heading = bs.collection.title
          endif
          assign tag = 'div'
          if banner_link != blank
            assign tag = 'a'
          endif
          assign b_vars = ''
          if bs.custom_style
            if bs.overlay_color != blank
              assign b_vars = b_vars | append: '--cb-ov: ' | append: bs.overlay_color | append: ';'
            endif
            assign b_ov = bs.overlay_opacity | default: 0 | divided_by: 100.0
            assign b_vars = b_vars | append: '--cb-ov-o: ' | append: b_ov | append: ';'
            if bs.heading_color != blank
              assign b_vars = b_vars | append: '--cb-title: ' | append: bs.heading_color | append: ';'
            endif
            if bs.sub_color != blank
              assign b_vars = b_vars | append: '--cb-sub: ' | append: bs.sub_color | append: ';'
            endif
          endif
        -%}
        <li>
          <{{ tag }} class="cb__item"
             {%- if tag == 'a' %} href="{{ banner_link }}"{% endif %}
             {%- if banner_heading == blank and tag == 'a' %} aria-label="{{ fb_accessibility_banner | escape }}"{% endif %}
             {%- if b_vars != blank %} style="{{ b_vars }}"{% endif %}
             {{ block.shopify_attributes }}>

            <div class="cb__media">
              {%- if banner_image != blank -%}
                <picture>
                  {%- if banner_mobile != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ banner_mobile | image_url: width: 750 }} 750w, {{ banner_mobile | image_url: width: 1100 }} 1100w, {{ banner_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
                  {%- endif -%}
                  {{ banner_image | image_url: width: 2000 | image_tag: class: 'cb__img', loading: 'lazy', alt: banner_heading, sizes: img_sizes, widths: '600, 900, 1200, 1600, 2000' }}
                </picture>
              {%- endif -%}
            </div>

            <div class="cb__overlay" aria-hidden="true"></div>

            {%- if banner_heading != blank or bs.subheading != blank -%}
              <div class="cb__content cb__content--{{ s.text_position | default: 'center' }}">
                {%- if banner_heading != blank -%}
                  <h3 class="cb__heading">{{ banner_heading | escape }}</h3>
                {%- endif -%}
                {%- if bs.subheading != blank -%}
                  <div class="cb__sub cb__rt">{{ bs.subheading }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </{{ tag }}>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- else -%}
      {%- if request.design_mode -%}<p class="cb__empty">Add a Banner block to show your first banner.</p>{%- endif -%}
    {%- endif -%}
  </div>
</div>

</template>

<schema>
{
  "type": "category-banners-2",
  "name": "Category Banners 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Page width"
        },
        {
          "value": "fluid_container",
          "label": "Wide"
        },
        {
          "value": "stretch_width",
