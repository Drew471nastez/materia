<template compat="shopify">
{%- comment -%} Runtime, loaded once per page by layout/theme.storelib: shopify/assets/live-collections.js. {%- endcomment -%}
{% render 'theme-type' %}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_banner = 'accessibility.banner' | t -%}
{%- comment -%}
  Materia Themes. Category Banners 2: a heading, a line of text and a grid of
  banners (a picture with a title) that link to collections. A banner with a
  collection picked takes its title, picture and link from it; its own fields
  replace them. Colours follow the colour scheme and the titles Theme settings
  > Typography until Enable custom styling is on. Live builder updates are in
  live-collections.js (loaded on every page).
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign custom = s.enable_custom_styling
  assign banner_count = 0
  assign head_count = 0
  for block in section.blocks
    if block.type == 'banner'
      assign banner_count = banner_count | plus: 1
    elsif block.type == 'heading' and block.settings.heading != blank
      assign head_count = head_count | plus: 1
    elsif block.type == 'subheading' and block.settings.subheading != blank
      assign head_count = head_count | plus: 1
    endif
  endfor
  assign img_sizes = '100vw'
  if s.layout == 'grid_2'
    assign img_sizes = '(min-width: 768px) 50vw, 100vw'
  elsif s.layout == 'grid_3'
    assign img_sizes = '(min-width: 768px) 33vw, 100vw'
  endif
  if s.mobile_layout == 'grid_2' and s.layout == 'stack'
    assign img_sizes = '(min-width: 768px) 100vw, 50vw'
  endif
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if s.reset_spacing %}
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif %}
  {%- if s.enable_custom_fonts -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
  {%- endif %}
  #shopify-section-{{ sid }} .cb2 {
    --cb-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    font-family: var(--body-font, inherit);
    background: var(--cl-section_bg);
    padding: var(--cl-padding_top) var(--cl-side_padding_mobile) var(--cl-padding_bottom);
  }
  #shopify-section-{{ sid }} .cb2, #shopify-section-{{ sid }} .cb2 *, #shopify-section-{{ sid }} .cb2 *::before, #shopify-section-{{ sid }} .cb2 *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .cb2__inner { margin-inline: auto; }
  #shopify-section-{{ sid }} .cb2[data-width='container'] .cb2__inner { max-width: calc(var(--page-width, 1300px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cb2[data-width='fluid_container'] .cb2__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); padding-inline: 1.5rem; }
  #shopify-section-{{ sid }} .cb2[data-width='stretch_width'] .cb2__inner { padding-inline: 1.5rem; }

  /* Heading and line of text: theme type unless the block's own style is on */
  #shopify-section-{{ sid }} .cb2__head { padding: 32px 16px 0; text-align: center; }
  #shopify-section-{{ sid }} .cb2[data-header-align='left'] .cb2__head { text-align: left; }
  #shopify-section-{{ sid }} .cb2__head-title {
    max-width: 52rem; margin: 0 auto var(--clb-space_below_mobile);
    font-family: var(--heading-font, inherit);
    font-size: var(--clb-heading_font_size_mobile, var(--cb-h-size-m, 30px));
    font-weight: var(--clb-heading_font_weight, var(--heading-weight, 700));
    color: var(--clb-heading_color);
    text-wrap: balance;
  }
  #shopify-section-{{ sid }} .cb2__head-title[data-size='lg'] { --cb-h-size-m: var(--type-h1-size, 36px); --cb-h-size: var(--type-h1-size, 56px); }
  #shopify-section-{{ sid }} .cb2__head-title[data-size='md'] { --cb-h-size-m: var(--type-h2-size, 30px); --cb-h-size: var(--type-h2-size, 36px); }
  #shopify-section-{{ sid }} .cb2__head-title[data-size='sm'] { --cb-h-size-m: var(--type-h3-size, 20px); --cb-h-size: var(--type-h3-size, 24px); }
  #shopify-section-{{ sid }} .cb2__head-sub {
    max-width: 40rem; margin: 0 auto var(--clb-space_below_mobile);
    font-size: var(--clb-subheading_font_size_mobile, var(--cb-s-size, 16px));
    font-weight: var(--clb-subheading_font_weight, var(--body-weight, 400));
    line-height: var(--body-line-height, 1.6);
    color: var(--clb-subheading_color);
    text-wrap: pretty;
  }
  #shopify-section-{{ sid }} .cb2__head-sub[data-size='body_large'] { --cb-s-size: 18px; }
  #shopify-section-{{ sid }} .cb2__head-sub[data-size='body_small'] { --cb-s-size: 14px; }
  #shopify-section-{{ sid }} .cb2[data-header-align='left'] :is(.cb2__head-title, .cb2__head-sub) { margin-left: 0; }
  #shopify-section-{{ sid }} .cb2__rt p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ sid }} .cb2__rt p + p { margin-top: 0.6em; }
  #shopify-section-{{ sid }} .cb2__rt a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }
  #shopify-section-{{ sid }} [hidden]:is(.cb2__head, .cb2__head-title, .cb2__head-sub, .cb2__heading, .cb2__sub, .cb2__content) { display: none !important; }

  /* Grid */
  #shopify-section-{{ sid }} .cb2__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--cl-gap); margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cb2[data-mobile-layout='grid_2'] .cb2__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #shopify-section-{{ sid }} .cb2__list > li { margin: 0; padding: 0; min-width: 0; }

  /* Banner */
  #shopify-section-{{ sid }} .cb2__item {
    --ov-o: var(--clb-overlay_opacity, var(--cl-overlay_opacity));
    position: relative; display: block; overflow: hidden; text-decoration: none; color: inherit;
    background: var(--cl-image_bg);
    border-radius: var(--cl-border_radius);
    aspect-ratio: var(--cl-aspect_ratio_mobile);
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .cb2[data-corner='theme'] .cb2__item { border-radius: var(--media-radius, var(--rounded-radius, 8px)); }
  #shopify-section-{{ sid }} a.cb2__item { cursor: pointer; }
  #shopify-section-{{ sid }} a.cb2__item:focus-visible { outline: 2px solid #ffffff; outline-offset: -6px; box-shadow: inset 0 0 0 4px rgba(0, 0, 0, 0.6); }
  #shopify-section-{{ sid }} .cb2__media, #shopify-section-{{ sid }} .cb2__media picture { position: absolute; inset: 0; display: block; }
  #shopify-section-{{ sid }} .cb2__img, #shopify-section-{{ sid }} .cb2__ph {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(var(--cl-image_base_scale));
    transition: transform var(--cl-hover_duration) var(--cb-ease);
    backface-visibility: hidden;
  }
  #shopify-section-{{ sid }} .cb2__ph { background: color-mix(in srgb, var(--cl-image_bg) 92%, #ffffff); fill: color-mix(in srgb, #ffffff 22%, transparent); }
  #shopify-section-{{ sid }} .cb2__overlay {
    position: absolute; inset: 0; pointer-events: none;
    background: var(--clb-overlay_color, var(--cl-overlay_color)); opacity: var(--ov-o);
    transition: opacity var(--cl-hover_duration) ease;
  }
  #shopify-section-{{ sid }} .cb2__content {
    position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    padding: clamp(16px, 5%, 40px); pointer-events: none;
  }
  #shopify-section-{{ sid }} .cb2[data-text-position='top'] .cb2__content { justify-content: flex-start; }
  #shopify-section-{{ sid }} .cb2[data-text-position='bottom'] .cb2__content { justify-content: flex-end; }
  #shopify-section-{{ sid }} .cb2[data-text-position='left'] .cb2__content { align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .cb2[data-text-position='right'] .cb2__content { align-items: flex-end; text-align: right; }
  #shopify-section-{{ sid }} .cb2__heading {
    position: relative; display: inline-block; max-width: 100%; margin: 0;
    color: var(--clb-heading_color, var(--cl-heading_color));
    font-family: var(--heading-font, inherit);
    font-size: var(--cl-heading_size_mobile, var(--cb-t-size-m, 30px));
    font-weight: var(--cl-heading_weight, var(--heading-weight, 700));
    line-height: 1.15;
    letter-spacing: var(--cl-heading_letter_spacing);
    text-shadow: var(--cl-heading_shadow);
    text-wrap: balance; overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .cb2[data-uppercase='true'] .cb2__heading { --heading-text-transform: uppercase; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cb2__heading[data-own-size] { --heading-letter-spacing: var(--cl-heading_letter_spacing); }
  #shopify-section-{{ sid }} .cb2[data-title-style='xl'] { --cb-t-size-m: var(--type-h1-size, 36px); --cb-t-size: var(--type-h1-size, 56px); }
  #shopify-section-{{ sid }} .cb2[data-title-style='lg'] { --cb-t-size-m: var(--type-h2-size, 30px); --cb-t-size: var(--type-h2-size, 36px); }
  #shopify-section-{{ sid }} .cb2[data-title-style='md'] { --cb-t-size-m: var(--type-h3-size, 20px); --cb-t-size: var(--type-h3-size, 24px); }
  #shopify-section-{{ sid }} .cb2[data-title-style='sm'] { --cb-t-size-m: var(--type-h4-size, 18px); --cb-t-size: var(--type-h4-size, 20px); }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .cb2[data-mobile-layout='grid_2'] .cb2__heading { font-size: min(var(--cl-heading_size_mobile, var(--cb-t-size-m, 30px)), 6vw); }
  }
  #shopify-section-{{ sid }} .cb2__sub {
    margin: 8px 0 0; max-width: 34rem;
    color: var(--clb-sub_color, var(--cl-sub_color));
    font-size: var(--cl-sub_size, var(--cb-b-size, 16px));
    line-height: 1.5; text-shadow: var(--cl-heading_shadow); text-wrap: pretty;
  }
  #shopify-section-{{ sid }} .cb2[data-sub-style='body_large'] { --cb-b-size: 18px; }
  #shopify-section-{{ sid }} .cb2[data-sub-style='body_small'] { --cb-b-size: 14px; }
  #shopify-section-{{ sid }} .cb2__heading::after {
    content: ''; position: absolute; left: 0; right: 0;
    bottom: calc(-1 * var(--cl-underline_offset)); height: var(--cl-underline_thickness);
    background: var(--cl-underline_color);
    transform: scaleX(0); transform-origin: left center;
    transition: transform var(--cl-underline_duration) var(--cb-ease);
  }
  #shopify-section-{{ sid }} .cb2[data-underline-origin='right'] .cb2__heading::after { transform-origin: right center; }
  #shopify-section-{{ sid }} .cb2[data-underline-origin='center'] .cb2__heading::after { transform-origin: center center; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .cb2[data-sub-visibility='hover'] .cb2__sub { opacity: 0; transform: translateY(8px); transition: opacity var(--cl-hover_duration) ease 80ms, transform var(--cl-hover_duration) var(--cb-ease) 80ms; }
    #shopify-section-{{ sid }} a.cb2__item:hover :is(.cb2__img, .cb2__ph) { transform: scale(var(--cl-image_hover_scale)); }
    #shopify-section-{{ sid }} .cb2__item:hover .cb2__overlay { opacity: clamp(0, calc(var(--ov-o) + var(--cl-overlay_opacity_hover) - var(--cl-overlay_opacity)), 0.9); }
    #shopify-section-{{ sid }} a.cb2__item:hover .cb2__heading::after { transform: scaleX(1); }
    #shopify-section-{{ sid }} .cb2__item:hover .cb2__sub { opacity: 1; transform: none; }
  }
  #shopify-section-{{ sid }} a.cb2__item:focus-visible :is(.cb2__img, .cb2__ph) { transform: scale(var(--cl-image_hover_scale)); }
  #shopify-section-{{ sid }} .cb2__item:focus-visible .cb2__overlay { opacity: clamp(0, calc(var(--ov-o) + var(--cl-overlay_opacity_hover) - var(--cl-overlay_opacity)), 0.9); }
  #shopify-section-{{ sid }} a.cb2__item:focus-visible .cb2__heading::after { transform: scaleX(1); }
  #shopify-section-{{ sid }} .cb2__item:focus-visible .cb2__sub { opacity: 1; transform: none; }
  #shopify-section-{{ sid }} .cb2__empty { margin: 0; padding: 32px 16px; text-align: center; font-size: 14px; color: var(--color-text); }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .cb2 { padding-left: var(--cl-side_padding_desktop); padding-right: var(--cl-side_padding_desktop); }
    #shopify-section-{{ sid }} .cb2__head-title { margin-bottom: var(--clb-space_below_desktop); font-size: var(--clb-heading_font_size_desktop, var(--cb-h-size, 36px)); }
    #shopify-section-{{ sid }} .cb2__head-sub { margin-bottom: var(--clb-space_below_desktop); font-size: var(--clb-subheading_font_size_desktop, var(--cb-s-size, 16px)); }
    #shopify-section-{{ sid }} .cb2 .cb2__list { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ sid }} .cb2[data-layout='grid_2'] .cb2__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .cb2[data-layout='grid_3'] .cb2__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .cb2__item { aspect-ratio: var(--cl-aspect_ratio_desktop); }
    #shopify-section-{{ sid }} .cb2 .cb2__heading { font-size: var(--cl-heading_size_desktop, var(--cb-t-size, 36px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} :is(.cb2__img, .cb2__ph, .cb2__overlay, .cb2__heading::after, .cb2__sub) { transition: none !important; }
    #shopify-section-{{ sid }} .cb2__heading::after { transition: none !important; }
    #shopify-section-{{ sid }} .cb2__item:is(:hover, :focus-visible) :is(.cb2__img, .cb2__ph) { transform: scale(var(--cl-image_base_scale)) !important; }
  }
{% comment %}{% endcomment %}</style>

<div class="section cb2 color-{{ color_scheme }} gradient{% if s.reset_spacing %} remove_spacing{% endif %}" data-width="{{ s.section_width | default: 'full_width' }}" data-cl-banner-label="{{ fb_accessibility_banner | escape }}" {% capture cl_json %}{"color_scheme":{{ section.settings.color_scheme.id | default: section.settings.color_scheme | append: '' | json }},"section_width":{{ section.settings.section_width | append: '' | json }},"reset_spacing":{% if section.settings.reset_spacing %}true{% else %}false{% endif %},"layout":{{ section.settings.layout | append: '' | json }},"gap":{{ section.settings.gap | default: 0 | json }},"aspect_ratio_desktop":{{ section.settings.aspect_ratio_desktop | append: '' | json }},"header_alignment":{{ section.settings.header_alignment | append: '' | json }},"text_position":{{ section.settings.text_position | append: '' | json }},"sub_visibility":{{ section.settings.sub_visibility | append: '' | json }},"corner_style":{{ section.settings.corner_style | append: '' | json }},"border_radius":{{ section.settings.border_radius | default: 0 | json }},"image_base_scale":{{ section.settings.image_base_scale | default: 0 | json }},"placeholder_url":{% if section.settings.placeholder_url != blank %}{"src":{{ section.settings.placeholder_url | image_url: width: 1600 | json }},"width":{{ section.settings.placeholder_url.width | default: 0 | json }},"height":{{ section.settings.placeholder_url.height | default: 0 | json }},"alt":{{ section.settings.placeholder_url.alt | append: '' | json }}}{% else %}null{% endif %},"enable_custom_styling":{% if section.settings.enable_custom_styling %}true{% else %}false{% endif %},"section_bg":{{ section.settings.section_bg | append: '' | json }},"heading_color":{{ section.settings.heading_color | append: '' | json }},"sub_color":{{ section.settings.sub_color | append: '' | json }},"underline_color":{{ section.settings.underline_color | append: '' | json }},"overlay_color":{{ section.settings.overlay_color | append: '' | json }},"image_bg":{{ section.settings.image_bg | append: '' | json }},"overlay_opacity":{{ section.settings.overlay_opacity | default: 0 | json }},"title_style":{{ section.settings.title_style | append: '' | json }},"heading_style":{{ section.settings.heading_style | append: '' | json }},"sub_style":{{ section.settings.sub_style | append: '' | json }},"heading_size_desktop":{{ section.settings.heading_size_desktop | default: 0 | json }},"heading_weight":{{ section.settings.heading_weight | default: 0 | json }},"sub_size":{{ section.settings.sub_size | default: 0 | json }},"heading_uppercase":{% if section.settings.heading_uppercase %}true{% else %}false{% endif %},"heading_letter_spacing":{{ section.settings.heading_letter_spacing | default: 0 | json }},"heading_shadow":{{ section.settings.heading_shadow | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"overlay_opacity_hover":{{ section.settings.overlay_opacity_hover | default: 0 | json }},"image_hover_scale":{{ section.settings.image_hover_scale | default: 0 | json }},"hover_duration":{{ section.settings.hover_duration | default: 0 | json }},"underline_thickness":{{ section.settings.underline_thickness | default: 0 | json }},"underline_offset":{{ section.settings.underline_offset | default: 0 | json }},"underline_duration":{{ section.settings.underline_duration | default: 0 | json }},"underline_origin":{{ section.settings.underline_origin | append: '' | json }},"padding_top":{{ section.settings.padding_top | default: 0 | json }},"padding_bottom":{{ section.settings.padding_bottom | default: 0 | json }},"side_padding_desktop":{{ section.settings.side_padding_desktop | default: 0 | json }},"mobile_layout":{{ section.settings.mobile_layout | append: '' | json }},"aspect_ratio_mobile":{{ section.settings.aspect_ratio_mobile | append: '' | json }},"heading_size_mobile":{{ section.settings.heading_size_mobile | default: 0 | json }},"side_padding_mobile":{{ section.settings.side_padding_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-gap: {{ section.settings.gap | default: 0 }}px;--cl-padding_top: {{ section.settings.padding_top | default: 0 }}px;--cl-padding_bottom: {{ section.settings.padding_bottom | default: 0 }}px;--cl-side_padding_desktop: {{ section.settings.side_padding_desktop | default: 0 }}px;--cl-side_padding_mobile: {{ section.settings.side_padding_mobile | default: 0 }}px;--cl-aspect_ratio_desktop: {{ section.settings.aspect_ratio_desktop }};--cl-aspect_ratio_mobile: {{ section.settings.aspect_ratio_mobile }};--cl-border_radius: {{ section.settings.border_radius | default: 0 }}px;--cl-heading_letter_spacing: {{ section.settings.heading_letter_spacing | default: 0 }}em;--cl-heading_shadow: {{ section.settings.heading_shadow }};{% if section.settings.enable_custom_styling %}--cl-section_bg: {% render 'scheme-color', color: section.settings.section_bg, fallback: 'var(--color-background)' %};{% else %}--cl-section_bg: var(--color-background);{% endif %}{% if section.settings.enable_custom_styling %}--cl-heading_color: {% render 'scheme-color', color: section.settings.heading_color, fallback: '#ffffff' %};{% else %}--cl-heading_color: #ffffff;{% endif %}{% if section.settings.enable_custom_styling %}--cl-sub_color: {% render 'scheme-color', color: section.settings.sub_color, fallback: 'rgba(255, 255, 255, 0.92)' %};{% else %}--cl-sub_color: rgba(255, 255, 255, 0.92);{% endif %}{% if section.settings.enable_custom_styling %}--cl-underline_color: {% render 'scheme-color', color: section.settings.underline_color, fallback: 'currentColor' %};{% else %}--cl-underline_color: currentColor;{% endif %}{% if section.settings.enable_custom_styling %}--cl-overlay_color: {% render 'scheme-color', color: section.settings.overlay_color, fallback: '#000000' %};{% else %}--cl-overlay_color: #000000;{% endif %}{% if section.settings.enable_custom_styling %}--cl-image_bg: {% render 'scheme-color', color: section.settings.image_bg, fallback: '#1f2937' %};{% else %}--cl-image_bg: #1f2937;{% endif %}{% if section.settings.enable_custom_styling %}--cl-heading_size_desktop: {{ section.settings.heading_size_desktop | default: 0 }}px;{% endif %}{% if section.settings.enable_custom_styling %}--cl-heading_size_mobile: {{ section.settings.heading_size_mobile | default: 0 }}px;{% endif %}{% if section.settings.enable_custom_styling %}--cl-heading_weight: {{ section.settings.heading_weight | default: 0 }};{% endif %}{% if section.settings.enable_custom_styling %}--cl-sub_size: {{ section.settings.sub_size | default: 0 }}px;{% endif %}--cl-overlay_opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};--cl-overlay_opacity_hover: {{ section.settings.overlay_opacity_hover | default: 0 | divided_by: 100.0 }};--cl-image_base_scale: {{ section.settings.image_base_scale | default: 0 | divided_by: 100.0 }};--cl-image_hover_scale: {{ section.settings.image_hover_scale | default: 0 | divided_by: 100.0 }};--cl-hover_duration: {{ section.settings.hover_duration | default: 0 }}ms;--cl-underline_thickness: {{ section.settings.underline_thickness | default: 0 }}px;--cl-underline_offset: {{ section.settings.underline_offset | default: 0 }}px;--cl-underline_duration: {{ section.settings.underline_duration | default: 0 }}ms;{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="category-banners-2" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","reset_spacing":true,"layout":"grid_2","gap":0,"aspect_ratio_desktop":"21 / 9","header_alignment":"center","text_position":"center","sub_visibility":"hover","corner_style":"custom","border_radius":0,"image_base_scale":100,"enable_custom_styling":false,"overlay_opacity":25,"title_style":"lg","heading_style":"h2","sub_style":"body","heading_size_desktop":42,"heading_weight":700,"sub_size":14,"heading_uppercase":true,"heading_letter_spacing":0.1,"heading_shadow":"0 2px 8px rgba(0,0,0,0.25)","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","overlay_opacity_hover":45,"image_hover_scale":105,"hover_duration":700,"underline_thickness":2,"underline_offset":6,"underline_duration":350,"underline_origin":"left","padding_top":0,"padding_bottom":0,"side_padding_desktop":0,"mobile_layout":"stack","aspect_ratio_mobile":"16 / 9","heading_size_mobile":28,"side_padding_mobile":0}' data-cl-block-defaults='{"heading":{"heading":"Shop by category","size_style":"md","heading_size":"h2","custom_style":false,"heading_font_weight":"700","heading_font_size_desktop":32,"heading_font_size_mobile":26,"space_below_desktop":16,"space_below_mobile":8},"subheading":{"subheading":"<p>Pick a collection to start browsing.</p>","text_size":"body","custom_style":false,"subheading_font_weight":"400","subheading_font_size_desktop":16,"subheading_font_size_mobile":14,"space_below_desktop":32,"space_below_mobile":24},"banner":{"custom_style":false,"overlay_opacity":25}}' style="{{ cl_vars | strip }}" data-layout="{{ section.settings.layout }}" data-mobile-layout="{{ section.settings.mobile_layout }}" data-header-align="{{ section.settings.header_alignment }}" data-text-position="{{ section.settings.text_position }}" data-sub-visibility="{{ section.settings.sub_visibility }}" data-corner="{{ section.settings.corner_style }}" data-underline-origin="{{ section.settings.underline_origin }}" data-uppercase="{% if section.settings.heading_uppercase %}true{% else %}false{% endif %}"{% if section.settings.enable_custom_styling %} data-title-style="custom"{% else %} data-title-style="{{ section.settings.title_style }}"{% endif %}{% if section.settings.enable_custom_styling %} data-sub-style="custom"{% else %} data-sub-style="{{ section.settings.sub_style }}"{% endif %}{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  <div class="cb2__inner">
    <div class="cb2__head"{% if head_count == 0 %} hidden{% endif %}>
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 class="cb2__head-title cb2__rt" {% capture clb_json %}{"heading":{{ block.settings.heading | append: '' | json }},"size_style":{{ block.settings.size_style | append: '' | json }},"heading_size":{{ block.settings.heading_size | append: '' | json }},"custom_style":{% if block.settings.custom_style %}true{% else %}false{% endif %},"heading_color":{{ block.settings.heading_color | append: '' | json }},"heading_font_weight":{{ block.settings.heading_font_weight | append: '' | json }},"heading_font_size_desktop":{{ block.settings.heading_font_size_desktop | default: 0 | json }},"heading_font_size_mobile":{{ block.settings.heading_font_size_mobile | default: 0 | json }},"space_below_desktop":{{ block.settings.space_below_desktop | default: 0 | json }},"space_below_mobile":{{ block.settings.space_below_mobile | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.custom_style %}--clb-heading_color: {% render 'scheme-color', color: block.settings.heading_color, fallback: 'var(--color-heading)' %};{% else %}--clb-heading_color: var(--color-heading);{% endif %}{% if block.settings.custom_style %}--clb-heading_font_weight: {{ block.settings.heading_font_weight | default: 0 }};{% endif %}{% if block.settings.custom_style %}--clb-heading_font_size_desktop: {{ block.settings.heading_font_size_desktop | default: 0 }}px;{% endif %}{% if block.settings.custom_style %}--clb-heading_font_size_mobile: {{ block.settings.heading_font_size_mobile | default: 0 }}px;{% endif %}--clb-space_below_desktop: {{ block.settings.space_below_desktop | default: 0 }}px;--clb-space_below_mobile: {{ block.settings.space_below_mobile | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="heading" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if block.settings.custom_style %} data-size="custom"{% else %} data-size="{{ block.settings.size_style }}"{% endif %}{% if block.settings.custom_style %} data-own-weight=""{% endif %}{% if block.settings.heading == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- elsif block.type == 'subheading' -%}
          <div class="cb2__head-sub cb2__rt" {% capture clb_json %}{"subheading":{{ block.settings.subheading | append: '' | json }},"text_size":{{ block.settings.text_size | append: '' | json }},"custom_style":{% if block.settings.custom_style %}true{% else %}false{% endif %},"subheading_color":{{ block.settings.subheading_color | append: '' | json }},"subheading_font_weight":{{ block.settings.subheading_font_weight | append: '' | json }},"subheading_font_size_desktop":{{ block.settings.subheading_font_size_desktop | default: 0 | json }},"subheading_font_size_mobile":{{ block.settings.subheading_font_size_mobile | default: 0 | json }},"space_below_desktop":{{ block.settings.space_below_desktop | default: 0 | json }},"space_below_mobile":{{ block.settings.space_below_mobile | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.custom_style %}--clb-subheading_color: {% render 'scheme-color', color: block.settings.subheading_color, fallback: 'var(--color-text)' %};{% else %}--clb-subheading_color: var(--color-text);{% endif %}{% if block.settings.custom_style %}--clb-subheading_font_weight: {{ block.settings.subheading_font_weight | default: 0 }};{% endif %}{% if block.settings.custom_style %}--clb-subheading_font_size_desktop: {{ block.settings.subheading_font_size_desktop | default: 0 }}px;{% endif %}{% if block.settings.custom_style %}--clb-subheading_font_size_mobile: {{ block.settings.subheading_font_size_mobile | default: 0 }}px;{% endif %}--clb-space_below_desktop: {{ block.settings.space_below_desktop | default: 0 }}px;--clb-space_below_mobile: {{ block.settings.space_below_mobile | default: 0 }}px;{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="subheading" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}"{% if block.settings.custom_style %} data-size="custom"{% else %} data-size="{{ block.settings.text_size }}"{% endif %}{% if block.settings.custom_style %} data-own-weight=""{% endif %}{% if block.settings.subheading == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ block.settings.subheading }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if banner_count > 0 -%}
    <ul class="cb2__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'banner' -%}
        {%- liquid
          assign bs = block.settings
          assign coll = bs.collection
          assign banner_link = bs.link
          if banner_link == blank and coll != blank
            assign banner_link = coll.url
          endif
          assign own_image = true
          assign banner_image = bs.image
          if banner_image == blank and coll != blank
            assign banner_image = coll.featured_image
          endif
          assign banner_mobile = bs.image_mobile
          if banner_image == blank and banner_mobile != blank
            assign banner_image = banner_mobile
            assign banner_mobile = blank
          endif
          if banner_image == blank
            assign own_image = false
            if s.placeholder_url != blank
              assign banner_image = s.placeholder_url
            endif
          endif
          assign banner_heading = bs.heading
          if banner_heading == blank and coll != blank
            assign banner_heading = coll.title
          endif
          assign tag = 'div'
          if banner_link != blank
            assign tag = 'a'
          endif
        -%}
{%- if request.design_mode or banner_image != blank or banner_heading != blank -%}
        <li {% capture clb_json %}{"collection":{{ block.settings.collection.handle | append: '' | json }},"heading":{{ block.settings.heading | append: '' | json }},"subheading":{{ block.settings.subheading | append: '' | json }},"link":{{ block.settings.link | append: '' | json }},"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %},"image_mobile":{% if block.settings.image_mobile != blank %}{"src":{{ block.settings.image_mobile | image_url: width: 1600 | json }},"width":{{ block.settings.image_mobile.width | default: 0 | json }},"height":{{ block.settings.image_mobile.height | default: 0 | json }},"alt":{{ block.settings.image_mobile.alt | append: '' | json }}}{% else %}null{% endif %},"custom_style":{% if block.settings.custom_style %}true{% else %}false{% endif %},"heading_color":{{ block.settings.heading_color | append: '' | json }},"sub_color":{{ block.settings.sub_color | append: '' | json }},"overlay_color":{{ block.settings.overlay_color | append: '' | json }},"overlay_opacity":{{ block.settings.overlay_opacity | default: 0 | json }}}{% endcapture %}{% capture clb_vars %}{% if block.settings.custom_style %}--clb-heading_color: {% render 'scheme-color', color: block.settings.heading_color, fallback: 'var(--cl-heading_color)' %};{% endif %}{% if block.settings.custom_style %}--clb-sub_color: {% render 'scheme-color', color: block.settings.sub_color, fallback: 'var(--cl-sub_color)' %};{% endif %}{% if block.settings.custom_style %}--clb-overlay_color: {% render 'scheme-color', color: block.settings.overlay_color, fallback: 'var(--cl-overlay_color)' %};{% endif %}{% if block.settings.custom_style %}--clb-overlay_opacity: {{ block.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};{% endif %}{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="banner" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-coll-title="{{ coll.title | escape }}" data-cl-coll-url="{{ coll.url }}" data-cl-own-image="{{ own_image }}" {{ block.shopify_attributes }}>
          <{{ tag }} class="cb2__item"{% if tag == 'a' %} href="{{ banner_link }}"{% endif %}{% if banner_heading == blank and tag == 'a' %} aria-label="{{ fb_accessibility_banner | escape }}"{% endif %}>
            <div class="cb2__media">
              {%- if banner_image != blank -%}
                <picture>
                  {%- if banner_mobile != blank -%}
                    <source media="(max-width: 767px)" srcset="{{ banner_mobile | image_url: width: 750 }} 750w, {{ banner_mobile | image_url: width: 1100 }} 1100w, {{ banner_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
                  {%- endif -%}
                  {{ banner_image | image_url: width: 2000 | image_tag: class: 'cb2__img', loading: 'lazy', alt: banner_heading, sizes: img_sizes, widths: '600, 900, 1200, 1600, 2000' }}
                </picture>
              {%- elsif request.design_mode -%}
                {{ 'collection-1' | placeholder_svg_tag: 'cb2__ph' | replace: '<svg ', '<svg data-cl-ph aria-hidden="true" preserveAspectRatio="xMidYMid slice" ' }}
              {%- endif -%}
            </div>
            <div class="cb2__overlay" aria-hidden="true"></div>
            <div class="cb2__content">
              <h3 class="cb2__heading"{% if custom %} data-own-weight{% endif %}{% if s.heading_letter_spacing != 0 %} data-own-size{% endif %}{% if banner_heading == blank %} hidden{% endif %}>{{ banner_heading | escape }}</h3>
              <div class="cb2__sub cb2__rt"{% if bs.subheading == blank %} hidden{% endif %}>{{ bs.subheading }}</div>
            </div>
          </{{ tag }}>
        </li>
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- elsif request.design_mode -%}
      <p class="cb2__empty">Add a Banner block to show your first banner.</p>
    {%- endif -%}
  </div>
</div>
</template>

<schema>
{
  "type": "category-banners-2",
  "name": "Category Banners 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Page width"
        },
        {
          "value": "fluid_container",
          "label": "Wide"
        },
        {
          "value": "stretch_width",
          "label": "Edge to edge with side margins"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove the theme's space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Banners per row",
      "default": "grid_2",
      "options": [
        {
          "value": "stack",
          "label": "1 (stacked)"
        },
        {
          "value": "grid_2",
          "label": "2"
        },
        {
          "value": "grid_3",
          "label": "3"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between banners",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "aspect_ratio_desktop",
      "label": "Banner shape",
      "default": "21 / 9",
      "options": [
        {
          "value": "21 / 9",
          "label": "Ultra wide (21:9)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 1",
          "label": "Banner (3:1)"
        },
        {
          "value": "4 / 1",
          "label": "Thin banner (4:1)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "info": "For the optional Heading and Subheading blocks.",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "sub_visibility",
      "label": "Line under the title",
      "info": "Phones and tablets always show it, as they have no hover.",
      "default": "hover",
      "options": [
        {
          "value": "hover",
          "label": "On hover"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Images"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "info": "Follow theme uses the picture corners in Theme settings. Custom uses the slider below.",
      "default": "custom",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "border_radius",
      "visible_if": "{{ section.settings.corner_style == 'custom' }}",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_base_scale",
      "label": "Image zoom",
      "min": 100,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "placeholder_url",
      "label": "Image for banners without one",
      "info": "Used when a banner has no image and its collection has none either."
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_styling",
      "label": "Enable custom styling",
      "info": "Off: colours and title sizes follow the colour scheme and Theme settings.",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "info": "Leave empty to use the colour scheme.",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title colour",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Line colour",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline colour",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "info": "Tints the photo so the title reads. Leave empty for black.",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Banner background",
      "visible_if": "{{ section.settings.enable_custom_styling }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Typography"
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title size",
      "default": "lg",
      "options": [
        {
          "value": "xl",
          "label": "Extra large"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "sm",
          "label": "Small"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_styling == false }}"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Title text style",
      "info": "Legacy: replaced by Title size.",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        }
      ],
      "hidden": true
    },
    {
      "type": "select",
      "id": "sub_style",
      "label": "Line size",
      "info": "Font and size come from Theme settings > Typography.",
      "default": "body",
      "options": [
        {
          "value": "body_large",
          "label": "Body large"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "body_small",
          "label": "Body small"
        }
      ],
      "visible_if": "{{ section.settings.enable_custom_styling == false }}"
    },
    {
