      {
        "type": "header",
        "content": "Banner text"
      },
      {
        "type": "select",
        "id": "heading_style",
        "label": "Title text style",
        "info": "Follows Theme settings > Typography.",
        "default": "h2",
        "options": [
          {
            "value": "h1",
            "label": "Heading 1"
          },
          {
            "value": "h2",
            "label": "Heading 2"
          },
          {
            "value": "h3",
            "label": "Heading 3"
          },
          {
            "value": "h4",
            "label": "Heading 4"
          }
