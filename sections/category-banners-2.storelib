            "type": "range",
            "id": "overlay_opacity",
            "label": "Overlay strength",
            "min": 0,
            "max": 80,
            "step": 1,
            "unit": "%",
            "default": 25,
            "visible_if": "{{ block.settings.custom_style }}"
          }
