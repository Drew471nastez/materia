        "min": 100,
        "max": 130,
        "step": 1,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "image_hover_scale",
        "label": "Image zoom on hover",
        "min": 100,
        "max": 130,
        "step": 1,
        "unit": "%",
        "default": 105
