<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_image = 'accessibility.image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Image With Icons

  Two-column section: image on one side, copy + a row of feature
  icons on the other (matches the "Why is better?" reference layout).

  Every text element is a block, every feature is a block. Icons
  support three input modes per feature:
    1. Icon library (29 built-in stroke icons via the hp-icon snippet)
    2. Raw SVG (paste your own SVG markup)
    3. Image upload (PNG / JPG / SVG file)

  Fully scoped to #shopify-section-{{ id }} so it never interferes
  with other sections.
{%- endcomment -%}

{%- liquid
  assign st  = section.settings
  assign sid = section.id

  case st.image_position
    when 'right'
      assign _flex_dir_d = 'row-reverse'
    else
      assign _flex_dir_d = 'row'
  endcase
  case st.content_align
    when 'center'
      assign _ai = 'center'
      assign _ta = 'center'
    when 'right'
      assign _ai = 'flex-end'
      assign _ta = 'right'
    else
      assign _ai = 'flex-start'
      assign _ta = 'left'
  endcase
  case st.content_align_mobile
    when 'center'
      assign _ai_m = 'center'
      assign _ta_m = 'center'
    when 'right'
      assign _ai_m = 'flex-end'
      assign _ta_m = 'right'
    else
      assign _ai_m = 'flex-start'
      assign _ta_m = 'left'
  endcase

  assign features_count = 0
  assign image_block = null
  for blk in section.blocks
    if blk.type == 'feature'
      assign features_count = features_count | plus: 1
    elsif blk.type == 'image' and image_block == null
      assign image_block = blk
    endif
  endfor
  if features_count < 1
    assign features_count = 1
  endif

  if image_block
    assign img_aspect_w = image_block.settings.aspect_w | default: 4
    assign img_aspect_h = image_block.settings.aspect_h | default: 3
    assign img_radius = image_block.settings.radius | default: 12
    assign img_fit = image_block.settings.fit | default: 'cover'
  else
    assign img_aspect_w = 4
    assign img_aspect_h = 3
    assign img_radius = 12
    assign img_fit = 'cover'
  endif
-%}

<style>
  /* Custom fonts (override theme defaults inside this section only) */
  {%- if section.settings.enable_custom_fonts and section.settings.body_font -%}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} :is(p, div, span, a, li) {
      font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      font-weight: {{ section.settings.body_font.weight }};
    }
  {%- endif -%}
  {%- if section.settings.enable_custom_fonts and section.settings.heading_font -%}
    #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6),
    #shopify-section-{{ section.id }} .iwi__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}

  /* Theme typography inheritance */
  :where(#shopify-section-{{ sid }}) { font-family: var(--body-font, inherit); }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) { font-family: var(--heading-font, inherit); }

  /* Section margins + reset */
  {%- if st.section_bg != blank and st.section_bg.alpha != 0 -%}
  #shopify-section-{{ sid }} .iwi { background: {{ st.section_bg }}; }
  {%- endif -%}
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      --section-spacing: 0px;
    }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
    .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .iwi__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .iwi__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ sid }} .iwi__inner { padding-inline: 3rem; }
      }
  {%- endcase -%}

  #shopify-section-{{ sid }} .iwi {
    padding: {{ st.padding_top_mobile | default: 60 }}px {{ st.side_padding_mobile | default: 16 }}px {{ st.padding_bottom_mobile | default: 60 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwi {
      padding: {{ st.padding_top_desktop | default: 100 }}px {{ st.side_padding_desktop | default: 32 }}px {{ st.padding_bottom_desktop | default: 100 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwi__inner { width: 100%; box-sizing: border-box; }

  /* Grid */
  #shopify-section-{{ sid }} .iwi__grid {
    display: flex;
    flex-direction: column;
    gap: {{ st.gap_mobile | default: 32 }}px;
    align-items: center;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwi__grid {
      flex-direction: {{ _flex_dir_d }};
      gap: {{ st.gap_desktop | default: 64 }}px;
      align-items: center;
    }
  }

  /* Columns */
  #shopify-section-{{ sid }} .iwi__media,
  #shopify-section-{{ sid }} .iwi__text { width: 100%; box-sizing: border-box; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwi__text  { width: {{ st.text_column_width | default: 50 }}%; }
    #shopify-section-{{ sid }} .iwi__media { width: calc(100% - {{ st.text_column_width | default: 50 }}%); }
  }

  /* Image */
  #shopify-section-{{ sid }} .iwi__media {
    border-radius: {{ img_radius }}px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    aspect-ratio: {{ img_aspect_w }} / {{ img_aspect_h }};
  }
  #shopify-section-{{ sid }} .iwi__media img,
  #shopify-section-{{ sid }} .iwi__media .iwi__placeholder {
    width: 100%;
    height: 100%;
    object-fit: {{ img_fit }};
    display: block;
  }
  #shopify-section-{{ sid }} .iwi__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0,0,0,0.18);
  }
  #shopify-section-{{ sid }} .iwi__placeholder svg { width: 64px; height: 64px; }

  /* Content column */
  #shopify-section-{{ sid }} .iwi__text {
    display: flex;
    flex-direction: column;
    gap: {{ st.content_gap | default: 16 }}px;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    color: {% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %};
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwi__text {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .iwi__text > * { margin: 0; max-width: 100%; }

  /* Eyebrow / heading / subheading defaults */
  #shopify-section-{{ sid }} .iwi__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  :where(#shopify-section-{{ sid }}) .iwi__heading {
    color: var(--color-heading);
    font-weight: var(--heading-weight, 700);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ sid }} .iwi__subheading {
    line-height: 1.6;
    max-width: 560px;
  }
  #shopify-section-{{ sid }} .iwi__subheading p { margin: 0 0 0.5em; }
  #shopify-section-{{ sid }} .iwi__subheading p:last-child { margin: 0; }

  /* Features row — grid of icon + label tiles */
  #shopify-section-{{ sid }} .iwi__features {
    display: grid;
    grid-template-columns: repeat({{ st.features_columns_mobile | default: 2 }}, minmax(0, 1fr));
    gap: {{ st.features_gap | default: 18 }}px;
    width: 100%;
    margin-top: {{ st.features_margin_top | default: 8 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .iwi__features {
      grid-template-columns: repeat({{ st.features_columns_desktop | default: 4 }}, minmax(0, 1fr));
      gap: {{ st.features_gap_desktop | default: 22 }}px;
    }
  }
  #shopify-section-{{ sid }} .iwi__feature {
    display: flex;
    flex-direction: column;
    align-items: {{ _ai_m }};
    text-align: {{ _ta_m }};
    gap: 8px;
    min-width: 0;
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .iwi__feature {
      align-items: {{ _ai }};
      text-align: {{ _ta }};
    }
  }
  #shopify-section-{{ sid }} .iwi__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ st.icon_size | default: 44 }}px;
    height: {{ st.icon_size | default: 44 }}px;
    {%- case st.icon_radius_style -%}
      {%- when 'rounded' -%}border-radius: 8px;
      {%- when 'square' -%}border-radius: 0;
      {%- else -%}border-radius: 999px;
    {%- endcase -%}
    background: {% render 'scheme-color', color: st.icon_bg, fallback: 'var(--color-heading)' %};
    color: {% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-background)' %};
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .iwi__icon svg {
    width: {{ st.icon_glyph_size | default: 60 }}%;
    height: {{ st.icon_glyph_size | default: 60 }}%;
    display: block;
  }
  #shopify-section-{{ sid }} .iwi__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ sid }} .iwi__feature-label {
    font-size: {{ st.feature_label_size | default: 13 }}px;
    font-weight: {{ st.feature_label_weight | default: '500' }};
    line-height: 1.3;
    color: {% render 'scheme-color', color: st.feature_label_color, fallback: 'var(--color-text)' %};
  }

  /* Per-block style overrides */
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- if block.type == 'eyebrow' -%}
      #shopify-section-{{ sid }} .iwi__eyebrow[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size | default: 12 }}px;
      }
    {%- endif -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ sid }} .iwi__heading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};
        font-size: {{ bs.size_mobile | default: 32 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwi__heading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 44 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'subheading' -%}
      #shopify-section-{{ sid }} .iwi__subheading[data-block-id="{{ block.id }}"] {
        color: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};
        font-size: {{ bs.size_mobile | default: 15 }}px;
      }
      @media (min-width: 768px) {
        #shopify-section-{{ sid }} .iwi__subheading[data-block-id="{{ block.id }}"] {
          font-size: {{ bs.size_desktop | default: 17 }}px;
        }
      }
    {%- endif -%}
    {%- if block.type == 'feature' -%}
      {%- if bs.icon_bg != blank and bs.icon_bg.alpha != 0 -%}
        #shopify-section-{{ sid }} .iwi__feature[data-block-id="{{ block.id }}"] .iwi__icon { background: {{ bs.icon_bg }}; }
      {%- endif -%}
      {%- if bs.icon_color != blank and bs.icon_color.alpha != 0 -%}
        #shopify-section-{{ sid }} .iwi__feature[data-block-id="{{ block.id }}"] .iwi__icon { color: {{ bs.icon_color }}; }
      {%- endif -%}
      {%- if bs.label_color != blank and bs.label_color.alpha != 0 -%}
        #shopify-section-{{ sid }} .iwi__feature[data-block-id="{{ block.id }}"] .iwi__feature-label {
          color: {{ bs.label_color }};
        }
      {%- endif -%}
    {%- endif -%}
    {%- if block.type == 'button' -%}
      #shopify-section-{{ sid }} .iwi__btn[data-block-id="{{ block.id }}"] {
        display: {% if bs.full_width %}flex{% else %}inline-flex{% endif %};
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        line-height: 1;
        --iwi-btn-bg: {% render 'scheme-color', color: bs.bg, fallback: 'var(--btn-primary-bg-color)' %};
        --iwi-btn-color: {% render 'scheme-color', color: bs.color, fallback: 'var(--btn-primary-color)' %};
        --iwi-btn-border: {% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--iwi-btn-bg))' %};
        background-color: var(--iwi-btn-bg);
        color: var(--iwi-btn-color);
        border-color: var(--iwi-btn-border);
        {%- if bs.use_theme_button %}
        border-width: var(--btn-border-width, 1px);
        padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
        border-radius: var(--btn-radius, 8px);
        font-size: var(--btn-font-size, 14px);
        font-weight: var(--btn-font-weight, 600);
        {%- else %}
        border-width: {{ bs.border_width | default: 0 }}px;
        padding: {{ bs.padding_y | default: 14 }}px {{ bs.padding_x | default: 26 }}px;
        border-radius: {{ bs.radius | default: 8 }}px;
        font-size: {{ bs.font_size | default: 14 }}px;
        font-weight: {{ bs.font_weight | default: '600' }};
        {%- endif %}
        border-style: solid;
        text-transform: {% if bs.uppercase %}uppercase{% elsif bs.use_theme_button %}var(--btn-text-transform, none){% else %}none{% endif %};
        width: {% if bs.full_width %}100%{% else %}auto{% endif %};
        max-width: {% if bs.full_width %}100%{% else %}max-content{% endif %};
        transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
      }
      #shopify-section-{{ sid }} .iwi__btn[data-block-id="{{ block.id }}"]:hover,
      #shopify-section-{{ sid }} .iwi__btn[data-block-id="{{ block.id }}"]:focus-visible {
        background-color: {% render 'scheme-color', color: bs.bg_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};
        color: {% render 'scheme-color', color: bs.color_hover, fallback: 'var(--btn-primary-hover-color)' %};
        border-color: {% render 'scheme-color', color: bs.border_color_hover, fallback: 'var(--btn-primary-hover-border-color)' %};
        transform: translateY(-1px);
      }
      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ sid }} .iwi__btn[data-block-id="{{ block.id }}"],
        #shopify-section-{{ sid }} .iwi__btn[data-block-id="{{ block.id }}"]:hover { transition: none; transform: none; }
      }
    {%- endif -%}
  {%- endfor -%}
{% comment %}{% endcomment %}</style>

<div id="iwi-{{ sid }}" class="iwi section sec__image-with-icons color-{{ color_scheme }} gradient" data-section-id="{{ sid }}">
  <div class="iwi__inner">
    <div class="iwi__grid">

      <div class="iwi__media"{% if image_block %} {{ image_block.shopify_attributes }}{% endif %}>
        {%- if image_block and image_block.settings.image != blank -%}
          {%- assign ib_img = image_block.settings.image -%}
          <img
            src="{{ ib_img | image_url: width: 1400 }}"
            srcset="{{ ib_img | image_url: width: 600 }} 600w,
                    {{ ib_img | image_url: width: 900 }} 900w,
                    {{ ib_img | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ ib_img.alt | default: fb_accessibility_image | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.placeholder' | t }}" loading="lazy">
        {%- endif -%}
      </div>

      <div class="iwi__text">
        {%- comment -%} Render text/button blocks first, in user order. Features collected separately and rendered as one row. {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              {%- if bs.text != blank -%}
                <p class="iwi__eyebrow" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if bs.text != blank -%}
                <{{ bs.tag | default: 'h2' }} class="iwi__heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</{{ bs.tag | default: 'h2' }}>
              {%- endif -%}

            {%- when 'subheading' -%}
              {%- if bs.text != blank -%}
                <div class="iwi__subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ bs.text }}</div>
              {%- endif -%}

            {%- when 'features_row' -%}
              <div class="iwi__features" {{ block.shopify_attributes }}>
                {%- for feat_block in section.blocks -%}
                  {%- if feat_block.type == 'feature' -%}
                    {%- assign fs = feat_block.settings -%}
                    <div class="iwi__feature" data-block-id="{{ feat_block.id }}" {{ feat_block.shopify_attributes }}>
                      <span class="iwi__icon" aria-hidden="true">
                        {%- case fs.icon_type -%}
                          {%- when 'image' -%}
                            {%- if fs.icon_image != blank -%}
                              <img src="{{ fs.icon_image | image_url: width: 200 }}" alt="">
                            {%- endif -%}
                          {%- when 'svg' -%}
                            {%- if fs.icon_svg != blank -%}
                              {{ fs.icon_svg }}
                            {%- endif -%}
                          {%- else -%}
                            {%- render 'hp-icon', icon: fs.icon_library -%}
                        {%- endcase -%}
                      </span>
                      {%- if fs.label != blank -%}
                        <span class="iwi__feature-label">{{ fs.label | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'button' -%}
              {%- if bs.label != blank -%}
                {%- liquid
                  assign custom_btn = true
                  if bs.use_theme_button
                    assign custom_btn = false
                  endif
                  assign btn_case = blank
                  if bs.uppercase
                    assign btn_case = 'uppercase'
                  elsif custom_btn
                    assign btn_case = 'none'
                  endif
                -%}
                <a class="iwi__btn" data-block-id="{{ block.id }}" data-theme-button="primary" style="{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover, custom: custom_btn, radius: bs.radius, padding_y: bs.padding_y, padding_x: bs.padding_x, font_size: bs.font_size, weight: bs.font_weight, border_width: bs.border_width, transform: btn_case -%}" href="{{ bs.link | default: '#' }}" {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "image-with-text-icons",
  "name": "Image With Icons",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "select",
