          "min": 18,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 56
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 32
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra-bold"
            }
          ]
        }
      ],
      "limit": 2
    },
    {
