<template compat="shopify">
{% render 'theme-type' %}
{{ 'marketing-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'marketing-sections.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign bg = section.blocks | where: 'type', 'background' | first %}{% assign photo = s.background_image | default: s.image | default: bg.settings.background_image %}{% assign mobile_photo = s.background_image_mobile | default: bg.settings.background_image_mobile %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="mk-{{ section.id }}" class="mk-shell color-{{ scheme }}" data-marketing-section="{{ section.id }}" data-mk-kind="background" data-mk-settings="{{ s | json | escape }}" data-mk-defaults='{"section_width":"full_width","color_scheme":"default-color-scheme","reset_spacing":true,"display_section_on":"all","content_alignment_h":"left","content_alignment_v":"center","content_max_width":720,"card_radius":0,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":true,"animation":"theme","min_height_mobile":360,"padding_top_mobile":64,"padding_bottom_mobile":64,"side_padding_mobile":24,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0,"use_solid_bg":false,"image_position_x":50,"image_position_y":50,"background_brightness":100,"enable_overlay":true,"overlay_opacity":35,"content_gap":16,"min_height_desktop":280,"padding_top_desktop":96,"padding_bottom_desktop":96,"side_padding_desktop":48,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0}' data-mk-block-defaults='{"tag":{"text":"New collection","enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"font_weight":"theme"},"heading":{"text":"Bold style. Big season.","enable_custom_style":false,"tag":"h2","weight":"theme","font_source":"heading","text_case":"theme","letter_spacing":0,"line_height":1.2,"size_desktop":56,"size_mobile":32},"subtext":{"text":"&lt;p&gt;Discover the looks everyone is talking about — limited drops, free shipping over $50.&lt;/p&gt;","enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"size_desktop":18,"size_mobile":16,"font_weight":"theme"},"buttons":{"primary_label":"Shop now","enable_custom_style":false,"primary_border_width":0,"secondary_border_width":1,"btn_radius":6,"use_theme_button":true,"btn_size":14,"btn_pad_x":30,"btn_pad_y":14,"gap_top":8}}' data-mk-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-mk-button-font="{{ settings.button_font | default: 'body_font' }}" data-mk-motion="{{ settings.scroll_animation | default: 'none' }}" data-mk-duration="{{ settings.animation_duration | default: 700 }}" data-mk-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="mk-inner"><div class="mk-row"><div class="mk-media"><picture>{% if mobile_photo != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: mobile_photo, escaped: true %}">{% endif %}<img src="{% if photo != blank %}{% render 'offer-image-url', image: photo, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-mk-placeholder="{{ placeholder | escape }}" alt="{{ photo.alt | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline hidden></video><div class="mk-split" hidden><img alt="" width="960" height="1080"><img alt="" width="960" height="1080"></div><span class="mk-overlay" aria-hidden="true"></span></div>
 <div class="mk-content">{% for block in section.blocks %}{% unless block.hidden %}<div class="mk-block" data-mk-block="{{ block.id }}" data-mk-type="{{ block.type }}" data-mk-block-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}{% if block.type == 'background' %} hidden{% endif %}>{% render 'marketing-block', block: block, kind: 'background' %}</div>{% endunless %}{% endfor %}</div></div><button class="mk-close" type="button" aria-label="{{ 'accessibility.dismiss' | t }}" data-mk-close hidden>×</button></div>
 {% assign icons = 'check,star,heart,gift,truck,shield,shield_check,lightning,package,leaf,lock,award,clock,return,chat,globe,credit_card,tag' | split: ',' %}{% for icon in icons %}<template data-mk-icon="{{ icon }}">{% render 'hp-icon', icon: icon %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "promo-banner-2",
  "name": "Promo Banner 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "display_section_on",
      "label": "Display section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Image / Media"
    },
    {
      "type": "checkbox",
      "id": "use_solid_bg",
      "label": "Use solid background",
      "default": false
    },
    {
      "type": "color",
      "id": "solid_bg",
      "label": "Background color",
      "visible_if": "{{ section.settings.use_solid_bg }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "background_brightness",
      "label": "Background brightness",
      "min": 30,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable image overlay",
      "default": true,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "visible_if": "{{ section.settings.use_solid_bg == false and section.settings.enable_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35,
      "visible_if": "{{ section.settings.use_solid_bg == false and section.settings.enable_overlay }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "content_alignment_h",
      "label": "Horizontal alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment_v",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Block gap",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag / pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New collection"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Pill background"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Pill text color"
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Bold style. Big season."
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
