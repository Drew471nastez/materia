          "id": "btn_pad_y",
          "label": "Vertical padding",
          "min": 6,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
