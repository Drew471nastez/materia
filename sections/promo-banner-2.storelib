<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_promo_banner_background = 'accessibility.promo_banner_background' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Promo Banner 2 (block-based — full-bleed hero card)
  Full-bleed background image (or solid color) with stacked, centered content
  using blocks. Similar in spirit to the original PB2 but with cleaner liquid,
  block-based content, modern defaults, and equal-height button stretching.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign content_align_h = st.content_alignment_h | default: 'center'
  assign content_align_v = st.content_alignment_v | default: 'center'
  assign show_on = st.display_section_on | default: 'all'

-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins + reset spacing */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Display device gating */
  {%- if show_on == 'mobile_only' -%}
    @media (min-width: 768px) { #shopify-section-{{ sid }} { display: none !important; } }
  {%- elsif show_on == 'desktop_only' -%}
    @media (max-width: 767px) { #shopify-section-{{ sid }} { display: none !important; } }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb2 { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb2 { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .pb2-wrap { padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .pb2-wrap { padding-inline: 3rem; } }
  {%- endcase -%}

  /* Outer banner */
  #shopify-section-{{ sid }} .pb2 {
    position: relative;
    overflow: hidden;
    border-radius: {{ st.card_radius | default: 0 }}px;
    {%- if st.use_solid_bg -%}
      background-color: {% render 'scheme-color', color: st.solid_bg, fallback: 'var(--color-background)' %} !important;
    {%- endif -%}
    min-height: {{ st.min_height_mobile | default: 360 }}px;
    padding: {{ st.padding_top_mobile | default: 64 }}px {{ st.side_padding_mobile | default: 24 }}px {{ st.padding_bottom_mobile | default: 64 }}px;
    display: flex;
    align-items:
      {%- if content_align_v == 'top' -%} flex-start
      {%- elsif content_align_v == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    justify-content:
      {%- if content_align_h == 'left' -%} flex-start
      {%- elsif content_align_h == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2 {
      min-height: {{ st.min_height_desktop | default: 480 }}px;
      padding: {{ st.padding_top_desktop | default: 96 }}px {{ st.side_padding_desktop | default: 48 }}px {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Background image */
  #shopify-section-{{ sid }} .pb2__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ sid }} .pb2__bg svg {
    width: 100%;
    height: 100%;
    display: block;
    background: rgba(var(--color-heading-rgb), 0.5);
    fill: rgba(255, 255, 255, 0.35);
  }
  #shopify-section-{{ sid }} .pb2__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ st.image_position_x | default: 50 }}% {{ st.image_position_y | default: 50 }}%;
    display: block;
    {%- if st.background_brightness -%}
      filter: brightness({{ st.background_brightness }}%);
    {%- endif -%}
  }

  /* Overlay */
  {%- if st.enable_overlay -%}
    #shopify-section-{{ sid }} .pb2__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {% render 'scheme-color', color: st.overlay_color, fallback: '#000000' %};
      opacity: {{ st.overlay_opacity | default: 30 | divided_by: 100.0 }};
      pointer-events: none;
    }
  {%- endif -%}

  /* Content stack */
  #shopify-section-{{ sid }} .pb2__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ st.content_max_width | default: 720 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if content_align_h == 'left' -%} flex-start
      {%- elsif content_align_h == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    text-align: {{ content_align_h }};
    gap: {{ st.content_gap | default: 16 }}px;
  }

  /* Block — Tag/eyebrow */
  #shopify-section-{{ sid }} .pb2__tag {
    margin: 0;
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Block — Heading */
  #shopify-section-{{ sid }} .pb2__heading {
    margin: 0;
    line-height: 1.1;
  }

  /* Block — Subtext */
  #shopify-section-{{ sid }} .pb2__subtext {
    margin: 0;
    line-height: 1.55;
  }
  #shopify-section-{{ sid }} .pb2__subtext p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .pb2__subtext p:last-child { margin: 0; }

  /* Block — Buttons (equal-height stretch) */
  #shopify-section-{{ sid }} .pb2__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    justify-content: {% if content_align_h == 'left' %}flex-start{% elsif content_align_h == 'right' %}flex-end{% else %}center{% endif %};
  }
  #shopify-section-{{ sid }} .pb2__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    letter-spacing: .4px;
  }
  #shopify-section-{{ sid }} .pb2__btn {
    background-color: var(--xb-bg);
    color: var(--xb-fg);
    border: var(--xb-bw, var(--btn-border-width, 1px)) solid var(--xb-bd);
    padding: var(--xb-py, var(--btn-padding-y, 13px)) var(--xb-px, var(--btn-padding-x, 28px));
    border-radius: var(--xb-r, var(--btn-radius, 6px));
    font-size: var(--xb-fs, var(--btn-font-size, 14px));
    font-weight: var(--xb-fw, var(--btn-font-weight, 600));
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), border-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), opacity var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ sid }} .pb2__btn:hover {
    background-color: var(--xb-bgh);
    color: var(--xb-fgh);
    border-color: var(--xb-bdh);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .pb2__btn { transition: none; }
    #shopify-section-{{ sid }} .pb2__btn:hover { transform: none; }
  }
  #shopify-section-{{ sid }} .pb2__btn:hover { transform: translateY(-1px); }
{% comment %}{% endcomment %}</style>

<section class="pb2-wrap">
  <div class="pb2 color-{{ color_scheme }} gradient">
    {%- if st.use_solid_bg == false -%}
      <div class="pb2__bg">
        {%- if st.background_image -%}
          <img
            src="{{ st.background_image | image_url: width: 1920 }}"
            srcset="{{ st.background_image | image_url: width: 800 }} 800w,
                    {{ st.background_image | image_url: width: 1200 }} 1200w,
                    {{ st.background_image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ st.background_image.alt | default: fb_accessibility_promo_banner_background | escape }}"
            decoding="async"
            width="{{ st.background_image.width }}"
            height="{{ st.background_image.height }}"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pb2__placeholder' }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pb2__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'tag' -%}
            {%- if block.settings.text != blank -%}
              <span class="pb2__tag"
                    style="
                      background:{% render 'scheme-color', color: block.settings.bg, fallback: 'var(--color-background)' %};
                      color:{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
                    "
                    {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.text != blank -%}
              {%- assign pb2_htag = block.settings.tag | default: 'h2' -%}
              <{{ pb2_htag }} class="pb2__heading pb2__heading--{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </{{ pb2_htag }}>
              {%- comment -%} Per-block scoped CSS (NOT keyed on block.shopify_attributes, which only exists in the editor) so every heading setting applies on the live storefront. {%- endcomment -%}
              {%- style -%}
                #shopify-section-{{ sid }} .pb2__heading--{{ block.id }} {
                  font-size: {{ block.settings.size_mobile | default: 32 }}px !important;
                  color: {% if st.use_solid_bg %}{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %}{% else %}{% render 'scheme-color', color: block.settings.color, fallback: '#FFFFFF' %}{% endif %} !important;
                  font-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %} !important;
                }
                @media (min-width: 768px) {
                  #shopify-section-{{ sid }} .pb2__heading--{{ block.id }} {
                    font-size: {{ block.settings.size_desktop | default: 56 }}px !important;
                  }
                }
              {%- endstyle -%}
            {%- endif -%}

          {%- when 'subtext' -%}
            {%- if block.settings.text != blank -%}
              <div class="pb2__subtext pb2__subtext--{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
              {%- style -%}
                #shopify-section-{{ sid }} .pb2__subtext--{{ block.id }} {
                  font-size: {{ block.settings.size_mobile | default: 16 }}px !important;
                  color: {% if st.use_solid_bg %}{% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %}{% else %}{% render 'scheme-color', color: block.settings.color, fallback: '#FFFFFF' %}{% endif %} !important;
                }
                @media (min-width: 768px) {
                  #shopify-section-{{ sid }} .pb2__subtext--{{ block.id }} {
                    font-size: {{ block.settings.size_desktop | default: 18 }}px !important;
                  }
                }
              {%- endstyle -%}
            {%- endif -%}

          {%- when 'buttons' -%}
            {%- assign primary_label = block.settings.primary_label -%}
            {%- assign secondary_label = block.settings.secondary_label -%}
            {%- if primary_label != blank or secondary_label != blank -%}
              <div class="pb2__buttons" {{ block.shopify_attributes }}
                   style="margin-top: {{ block.settings.gap_top | default: 8 }}px;">
                {%- if primary_label != blank -%}
                  <a class="pb2__btn pb2__btn--primary"
                     href="{{ block.settings.primary_link | default: '#' }}"
                     style="--xb-bg: {% render 'scheme-color', color: block.settings.primary_bg, fallback: 'var(--btn-primary-bg-color)' %}; --xb-fg: {% render 'scheme-color', color: block.settings.primary_text, fallback: 'var(--btn-primary-color)' %}; --xb-bd: {% render 'scheme-color', color: block.settings.primary_border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %}; --xb-bgh: {% render 'scheme-color', color: block.settings.primary_bg, fallback: 'var(--btn-primary-hover-bg-color)' %}; --xb-fgh: {% render 'scheme-color', color: block.settings.primary_text, fallback: 'var(--btn-primary-hover-color)' %}; --xb-bdh: {% render 'scheme-color', color: block.settings.primary_border_color, fallback: 'var(--btn-primary-hover-border-color, var(--btn-primary-hover-bg-color))' %}; {% unless block.settings.use_theme_button %}--xb-bw: {{ block.settings.primary_border_width | default: 0 }}px; --xb-py: {{ block.settings.btn_pad_y | default: 14 }}px; --xb-px: {{ block.settings.btn_pad_x | default: 30 }}px; --xb-r: {{ block.settings.btn_radius | default: 6 }}px; --xb-fs: {{ block.settings.btn_size | default: 14 }}px; --xb-fw: 600;{% endunless %}">
                    {{ primary_label | escape }}
                  </a>
                {%- endif -%}
                {%- if secondary_label != blank -%}
                  <a class="pb2__btn pb2__btn--secondary"
                     href="{{ block.settings.secondary_link | default: '#' }}"
                     style="--xb-bg: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_bg, fallback: 'transparent' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_bg, fallback: 'var(--btn-secondary-bg-color, transparent)' %}{% endif %}; --xb-fg: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_text, fallback: '#FFFFFF' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_text, fallback: 'var(--btn-secondary-color)' %}{% endif %}; --xb-bd: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_border_color, fallback: '#FFFFFF' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_border_color, fallback: 'var(--btn-secondary-border-color)' %}{% endif %}; --xb-bgh: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_bg, fallback: 'rgba(255,255,255,0.12)' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_bg, fallback: 'var(--btn-secondary-hover-bg-color, var(--btn-secondary-bg-color, transparent))' %}{% endif %}; --xb-fgh: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_text, fallback: '#FFFFFF' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_text, fallback: 'var(--btn-secondary-hover-color, var(--btn-secondary-color))' %}{% endif %}; --xb-bdh: {% if st.use_solid_bg == false %}{% render 'scheme-color', color: block.settings.secondary_border_color, fallback: '#FFFFFF' %}{% else %}{% render 'scheme-color', color: block.settings.secondary_border_color, fallback: 'var(--btn-secondary-hover-border-color, var(--btn-secondary-border-color))' %}{% endif %}; {% unless block.settings.use_theme_button %}--xb-bw: {{ block.settings.secondary_border_width | default: 1 }}px; --xb-py: {{ block.settings.btn_pad_y | default: 14 }}px; --xb-px: {{ block.settings.btn_pad_x | default: 30 }}px; --xb-r: {{ block.settings.btn_radius | default: 6 }}px; --xb-fs: {{ block.settings.btn_size | default: 14 }}px; --xb-fw: 600;{% endunless %}">
                    {{ secondary_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "promo-banner-2",
  "name": "Promo Banner 2",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "display_section_on",
      "label": "Display section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Image / Media"
    },
    {
      "type": "checkbox",
      "id": "use_solid_bg",
      "label": "Use solid background",
      "default": false
    },
    {
      "type": "color",
      "id": "solid_bg",
      "label": "Background color",
      "visible_if": "{{ section.settings.use_solid_bg }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "range",
      "id": "background_brightness",
      "label": "Background brightness",
      "min": 30,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable image overlay",
      "default": true,
      "visible_if": "{{ section.settings.use_solid_bg == false }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "visible_if": "{{ section.settings.use_solid_bg == false and section.settings.enable_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35,
      "visible_if": "{{ section.settings.use_solid_bg == false and section.settings.enable_overlay }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_19",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "content_alignment_h",
      "label": "Horizontal alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment_v",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
