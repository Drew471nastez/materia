        },
        {
          "type": "range",
          "id": "btn_pad_x",
          "label": "Horizontal padding",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 30,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
