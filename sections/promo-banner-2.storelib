<template compat="shopify">
{%- assign fb_accessibility_promo_banner_background = 'accessibility.promo_banner_background' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Promo Banner 2 (block-based — full-bleed hero card)
  Full-bleed background image (or solid color) with stacked, centered content
  using blocks. Similar in spirit to the original PB2 but with cleaner liquid,
  block-based content, modern defaults, and equal-height button stretching.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign content_align_h = st.content_alignment_h | default: 'center'
  assign content_align_v = st.content_alignment_v | default: 'center'
  assign show_on = st.display_section_on | default: 'all'

  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins + reset spacing */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Display device gating */
  {%- if show_on == 'mobile_only' -%}
    @media (min-width: 768px) { #shopify-section-{{ sid }} { display: none !important; } }
  {%- elsif show_on == 'desktop_only' -%}
    @media (max-width: 767px) { #shopify-section-{{ sid }} { display: none !important; } }
  {%- endif -%}

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb2 { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb2 { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; }
  {%- endcase -%}

  /* Outer banner */
  #shopify-section-{{ sid }} .pb2 {
    position: relative;
    overflow: hidden;
    border-radius: {{ st.card_radius | default: 0 }}px;
    {%- if st.use_solid_bg -%}
      background-color: {{ st.solid_bg | default: '#0F0F0F' }} !important;
    {%- endif -%}
    min-height: {{ st.min_height_mobile | default: 360 }}px;
    padding: {{ st.padding_top_mobile | default: 64 }}px {{ st.side_padding_mobile | default: 24 }}px {{ st.padding_bottom_mobile | default: 64 }}px;
    display: flex;
    align-items:
      {%- if content_align_v == 'top' -%} flex-start
      {%- elsif content_align_v == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    justify-content:
      {%- if content_align_h == 'left' -%} flex-start
      {%- elsif content_align_h == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb2 {
      min-height: {{ st.min_height_desktop | default: 480 }}px;
      padding: {{ st.padding_top_desktop | default: 96 }}px {{ st.side_padding_desktop | default: 48 }}px {{ st.padding_bottom_desktop | default: 96 }}px;
    }
  }

  /* Background image */
  #shopify-section-{{ sid }} .pb2__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ sid }} .pb2__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ st.image_position_x | default: 50 }}% {{ st.image_position_y | default: 50 }}%;
    display: block;
    {%- if st.background_brightness -%}
      filter: brightness({{ st.background_brightness }}%);
    {%- endif -%}
  }

  /* Overlay */
  {%- if st.enable_overlay -%}
    #shopify-section-{{ sid }} .pb2__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: {{ st.overlay_color | default: '#000000' }};
      opacity: {{ st.overlay_opacity | default: 30 | divided_by: 100.0 }};
      pointer-events: none;
    }
  {%- endif -%}

  /* Content stack */
  #shopify-section-{{ sid }} .pb2__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: {{ st.content_max_width | default: 720 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if content_align_h == 'left' -%} flex-start
      {%- elsif content_align_h == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    text-align: {{ content_align_h }};
    gap: {{ st.content_gap | default: 16 }}px;
  }

  /* Block — Tag/eyebrow */
  #shopify-section-{{ sid }} .pb2__tag {
    margin: 0;
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Block — Heading */
  #shopify-section-{{ sid }} .pb2__heading {
    margin: 0;
    line-height: 1.1;
  }

  /* Block — Subtext */
  #shopify-section-{{ sid }} .pb2__subtext {
    margin: 0;
    line-height: 1.55;
  }
  #shopify-section-{{ sid }} .pb2__subtext p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .pb2__subtext p:last-child { margin: 0; }

  /* Block — Buttons (equal-height stretch) */
  #shopify-section-{{ sid }} .pb2__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    justify-content: {% if content_align_h == 'left' %}flex-start{% elsif content_align_h == 'right' %}flex-end{% else %}center{% endif %};
  }
  #shopify-section-{{ sid }} .pb2__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform .15s ease, background-color .2s ease, color .2s ease;
    border: 0;
    cursor: pointer;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .4px;
  }
  #shopify-section-{{ sid }} .pb2__btn:hover { transform: translateY(-1px); }
{% comment %}{% endcomment %}</style>

<section class="pb2-wrap">
  <div class="pb2">
    {%- if st.use_solid_bg == false -%}
      <div class="pb2__bg">
        {%- if st.background_image -%}
          <img
            src="{{ st.background_image | image_url: width: 1920 }}"
            srcset="{{ st.background_image | image_url: width: 800 }} 800w,
                    {{ st.background_image | image_url: width: 1200 }} 1200w,
                    {{ st.background_image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ st.background_image.alt | default: fb_accessibility_promo_banner_background | escape }}"
            loading="lazy"
            width="{{ st.background_image.width }}"
            height="{{ st.background_image.height }}"
          >
        {%- else -%}
          <img
            src="{{ placeholder }}"
            alt="{{ 'accessibility.promo_banner_bg_placeholder' | t }}"
            loading="lazy"
            width="1920"
            height="800"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pb2__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'tag' -%}
            {%- if block.settings.text != blank -%}
              <span class="pb2__tag"
                    style="
                      background:{{ block.settings.bg }};
                      color:{{ block.settings.color }} !important;
                    "
                    {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.text != blank -%}
              {%- assign pb2_htag = block.settings.tag | default: 'h2' -%}
              <{{ pb2_htag }} class="pb2__heading pb2__heading--{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </{{ pb2_htag }}>
              {%- comment -%} Per-block scoped CSS (NOT keyed on block.shopify_attributes, which only exists in the editor) so every heading setting applies on the live storefront. {%- endcomment -%}
              {%- style -%}
                #shopify-section-{{ sid }} .pb2__heading--{{ block.id }} {
                  font-size: {{ block.settings.size_mobile | default: 32 }}px !important;
                  color: {{ block.settings.color | default: '#FFFFFF' }} !important;
                  font-weight: {{ block.settings.weight | default: 700 }} !important;
                }
                @media (min-width: 768px) {
                  #shopify-section-{{ sid }} .pb2__heading--{{ block.id }} {
                    font-size: {{ block.settings.size_desktop | default: 56 }}px !important;
                  }
                }
              {%- endstyle -%}
            {%- endif -%}

          {%- when 'subtext' -%}
            {%- if block.settings.text != blank -%}
              <div class="pb2__subtext pb2__subtext--{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
              {%- style -%}
                #shopify-section-{{ sid }} .pb2__subtext--{{ block.id }} {
                  font-size: {{ block.settings.size_mobile | default: 16 }}px !important;
                  color: {{ block.settings.color | default: '#FFFFFF' }} !important;
                }
                @media (min-width: 768px) {
                  #shopify-section-{{ sid }} .pb2__subtext--{{ block.id }} {
                    font-size: {{ block.settings.size_desktop | default: 18 }}px !important;
                  }
                }
              {%- endstyle -%}
            {%- endif -%}

          {%- when 'buttons' -%}
            {%- assign primary_label = block.settings.primary_label -%}
            {%- assign secondary_label = block.settings.secondary_label -%}
            {%- if primary_label != blank or secondary_label != blank -%}
              <div class="pb2__buttons" {{ block.shopify_attributes }}
                   style="margin-top: {{ block.settings.gap_top | default: 8 }}px;">
                {%- if primary_label != blank -%}
                  <a class="pb2__btn pb2__btn--primary"
                     href="{{ block.settings.primary_link | default: '#' }}"
                     style="
                       background-color: {{ block.settings.primary_bg | default: '#FFFFFF' }} !important;
                       color: {{ block.settings.primary_text | default: '#0F0F0F' }} !important;
                       border: {{ block.settings.primary_border_width | default: 0 }}px solid {{ block.settings.primary_border_color | default: '#FFFFFF' }};
                       padding: {{ block.settings.btn_pad_y | default: 14 }}px {{ block.settings.btn_pad_x | default: 30 }}px;
                       border-radius: {{ block.settings.btn_radius | default: 6 }}px;
                       font-size: {{ block.settings.btn_size | default: 14 }}px;
                     ">
                    {{ primary_label | escape }}
                  </a>
                {%- endif -%}
                {%- if secondary_label != blank -%}
                  <a class="pb2__btn pb2__btn--secondary"
                     href="{{ block.settings.secondary_link | default: '#' }}"
                     style="
                       background-color: {{ block.settings.secondary_bg | default: 'rgba(0,0,0,0)' }} !important;
                       color: {{ block.settings.secondary_text | default: '#FFFFFF' }} !important;
                       border: {{ block.settings.secondary_border_width | default: 1 }}px solid {{ block.settings.secondary_border_color | default: '#FFFFFF' }};
                       padding: {{ block.settings.btn_pad_y | default: 14 }}px {{ block.settings.btn_pad_x | default: 30 }}px;
                       border-radius: {{ block.settings.btn_radius | default: 6 }}px;
                       font-size: {{ block.settings.btn_size | default: 14 }}px;
                     ">
                    {{ secondary_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "promo-banner-2",
  "name": "Promo Banner 2",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "display_section_on",
      "label": "Display section on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "desktop_only",
          "label": "Desktop only"
        },
        {
          "value": "mobile_only",
          "label": "Mobile only"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Image / Media"
    },
    {
      "type": "checkbox",
      "id": "use_solid_bg",
      "label": "Use solid background instead of image",
      "default": false
    },
    {
      "type": "color",
      "id": "solid_bg",
      "label": "Solid background color",
      "default": "#0F0F0F"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Falls back to a default placeholder if blank."
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "background_brightness",
      "label": "Background brightness",
      "min": 30,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable image overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "content_alignment_h",
      "label": "Content horizontal alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment_v",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_30",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag / pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New collection"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Pill background",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Pill text color",
          "default": "#000000"
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Bold style. Big season."
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 56
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 32
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "700",
