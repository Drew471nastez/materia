        "label": "Reel headline size",
        "min": 11,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "custom_caption_size",
        "label": "Reel caption size",
        "min": 10,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses the animation in Theme settings."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
