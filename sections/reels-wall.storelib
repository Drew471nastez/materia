<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes — Reels Wall section.
  Inspired by TikTok / Instagram Reels but more capable:
   - Vertical 9:16 video tiles arranged as a swipeable carousel OR a grid
   - Auto-play muted videos in viewport (pauses when out of view, saves CPU)
   - Tap-to-unmute with a sound icon overlay
   - Per-tile: video upload OR YouTube/Vimeo URL OR poster-only,
     headline, CTA button, and an optional product chip (auto-shows image, title, price)
   - Click-through link on the whole tile (or nothing — just decorative)
   - Card style: rounded · square · pill (extra-rounded)
   - Optional username + avatar pill in the top-left, like a creator handle
   - Optional like / share / save counters on the right edge
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'pagination-styles.css' | asset_url }}" media="print" onload="this.media='all'">
{%- liquid
  assign s = section.settings
  assign section_width = s.section_width | default: 'container'
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign display_mode = s.display_mode | default: 'carousel'
  assign card_shape = s.card_shape | default: 'rounded'
  assign columns = s.columns | default: 4
  assign columns_mobile = s.columns_mobile | default: 1
  assign column_gap = s.column_gap | default: 14
  assign autoplay_videos = s.autoplay_videos
  assign loop_videos = s.loop_videos
  assign show_unmute = s.show_unmute
  assign show_handle = s.show_handle
  assign show_actions = s.show_actions
  assign overlay_strength = s.overlay_strength | default: 25
  assign show_arrow = s.show_arrow
  assign carousel_pagination = s.carousel_pagination | default: 'show_dots'
  assign reveal = s.reveal
  assign scroll_animation = settings.scroll_animation | default: 'none'
  unless reveal
    assign scroll_animation = 'none'
  endunless
-%}
{%- capture style -%}
  --section-pt: {{ s.padding_top }};
  --section-pb: {{ s.padding_bottom }};
  --rw-cols: {{ columns }};
  --rw-cols-mb: {{ columns_mobile }};
  --rw-cols-mb-int: {{ columns_mobile | floor | at_least: 1 }};
  --rw-gap: {{ column_gap }}px;
  --rw-overlay: {{ overlay_strength | divided_by: 100.0 }};
  --rw-accent: {% render 'scheme-color', color: s.accent_color, fallback: 'var(--color-primary)' %};
  --rw-tile-bg: {% render 'scheme-color', color: s.tile_bg, fallback: '#000000' %};
  --rw-heading-size: {{ s.custom_heading_size | default: 15 }}px;
  --rw-caption-size: {{ s.custom_caption_size | default: 12 }}px;
  {%- if s.custom_tile_text != blank -%}--rw-tile-text: {{ s.custom_tile_text }};{%- endif -%}
  {%- if s.custom_cta_bg != blank -%}--rw-cta-bg: {{ s.custom_cta_bg }};{%- endif -%}
  {%- if s.custom_cta_text != blank -%}--rw-cta-text: {{ s.custom_cta_text }};{%- endif -%}
  {%- case card_shape -%}
    {%- when 'rounded' -%}--rw-radius: 18px;
    {%- when 'square' -%}--rw-radius: 0px;
    {%- when 'pill' -%}--rw-radius: 28px;
  {%- endcase -%}
{%- endcapture -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rw-grid {
    display: grid;
    grid-template-columns: repeat(var(--rw-cols-mb-int), minmax(0, 1fr));
    gap: var(--rw-gap);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .rw-grid {
      grid-template-columns: repeat(var(--rw-cols), minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .rw-tile {
    position: relative;
    aspect-ratio: 9/16;
    background: var(--rw-tile-bg);
    border-radius: var(--rw-radius);
    overflow: hidden;
    display: block;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    transition: transform var(--btn-anim-duration, .35s) var(--btn-anim-ease, cubic-bezier(.2,.7,.2,1)), box-shadow var(--btn-anim-duration, .35s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .rw-tile:focus-visible,
  #shopify-section-{{ section.id }} .rw-action:focus-visible,
  #shopify-section-{{ section.id }} .rw-sound:focus-visible,
  #shopify-section-{{ section.id }} .rw-product:focus-visible { outline: 2px solid var(--rw-accent); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .rw-tile:hover { transform: translateY(-4px); }
  #shopify-section-{{ section.id }} .rw-tile video,
  #shopify-section-{{ section.id }} .rw-tile img,
  #shopify-section-{{ section.id }} .rw-tile iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    border: 0;
  }
  #shopify-section-{{ section.id }} .rw-tile__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,calc(var(--rw-overlay) * 1.6)) 0%, rgba(0,0,0,calc(var(--rw-overlay) * 0.5)) 35%, transparent 65%);
    pointer-events: none;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .rw-handle {
    position: absolute; top: 12px; left: 12px;
    z-index: 3;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 10px 5px 5px;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rw-handle img {
    position: static;
    width: 22px; height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .rw-handle__avatar-fallback {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--rw-accent);
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 11px;
  }
  #shopify-section-{{ section.id }} .rw-actions {
    position: absolute; right: 10px; bottom: 80px;
    z-index: 3;
    display: flex; flex-direction: column; gap: 14px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .rw-action {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    color: #fff;
    background: none; border: 0; padding: 0;
    cursor: pointer;
    font-size: 11px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    transition: transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .rw-action svg {
    width: 32px; height: 32px;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.4));
  }
  #shopify-section-{{ section.id }} .rw-action:hover { transform: scale(1.06); }
  #shopify-section-{{ section.id }} .rw-action.is-active svg path { fill: var(--rw-accent); }
  #shopify-section-{{ section.id }} .rw-content {
    position: absolute; left: 0; right: 0; bottom: 0;
    z-index: 3;
    padding: 14px 64px 14px 14px;
    display: flex; flex-direction: column; gap: 8px;
  }
  #shopify-section-{{ section.id }} .rw-content__heading {
    font-size: var(--rw-heading-size);
    font-weight: var(--heading-weight, 600);
    line-height: 1.3;
    margin: 0;
    color: var(--rw-tile-text, #fff);
  }
  #shopify-section-{{ section.id }} .rw-content__caption {
    font-size: var(--rw-caption-size);
    line-height: 1.4;
    margin: 0;
    opacity: 0.92;
    color: var(--rw-tile-text, #fff);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .rw-cta {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px;
    background-color: var(--rw-cta-bg, var(--btn-primary-bg-color, #fff));
    color: var(--rw-cta-text, var(--btn-primary-color, #111));
    border-radius: 999px;
    font-size: 12px;
    font-weight: var(--btn-font-weight, 600);
    text-decoration: none;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .rw-product {
    position: absolute; left: 12px; bottom: 12px;
    z-index: 3;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 10px 6px 6px;
    background: rgba(255,255,255,0.95);
    color: #111;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
    max-width: calc(100% - 80px);
    transition: box-shadow var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .rw-product:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.26); }
  #shopify-section-{{ section.id }} .rw-product img {
    position: static;
    width: 28px; height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .rw-product__name {
    font-size: 11px; font-weight: 600; line-height: 1.2;
    max-width: 12ch;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .rw-product__price {
    font-size: 10px; opacity: 0.7;
  }
  /* Sound toggle */
  #shopify-section-{{ section.id }} .rw-sound {
    position: absolute; right: 10px; top: 12px;
    z-index: 3;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 0;
    color: #fff;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background-color var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease), transform var(--btn-anim-duration, .3s) var(--btn-anim-ease, ease);
  }
  #shopify-section-{{ section.id }} .rw-sound:hover { background-color: rgba(0,0,0,0.7); }
  #shopify-section-{{ section.id }} .rw-sound svg { width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .rw-sound .icon-on { display: none; }
  #shopify-section-{{ section.id }} .rw-sound.is-on .icon-off { display: none; }
  #shopify-section-{{ section.id }} .rw-sound.is-on .icon-on  { display: block; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rw-tile,
    #shopify-section-{{ section.id }} .rw-action,
    #shopify-section-{{ section.id }} .rw-cta,
    #shopify-section-{{ section.id }} .rw-product,
    #shopify-section-{{ section.id }} .rw-sound { transition: none; }
    #shopify-section-{{ section.id }} .rw-tile:hover,
    #shopify-section-{{ section.id }} .rw-action:hover { transform: none; }
  }
  /* Custom customization overrides */
  {%- if s.custom_section_bg != blank -%}
    #shopify-section-{{ section.id }} > .section { background: {{ s.custom_section_bg }} !important; }
  {%- endif -%}
  {%- if s.custom_heading_color != blank -%}
    #shopify-section-{{ section.id }} .section__header-heading { color: {{ s.custom_heading_color }} !important; }
  {%- endif -%}
  {%- if s.custom_eyebrow_color != blank -%}
    #shopify-section-{{ section.id }} .section__header p.subheading_weight { color: {{ s.custom_eyebrow_color }} !important; }
  {%- endif -%}
{%- endstyle -%}

<div
  class="section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- liquid
      assign has_header_blocks = false
      for block in section.blocks
        if block.type == 'heading' or block.type == 'top_text' or block.type == 'subheading'
          assign has_header_blocks = true
          break
        endif
      endfor
    -%}
    {%- if has_header_blocks -%}
      <div class="section__header text-{{ s.header_alignment | default: 'left' }} mb-30 mb-md-40">
          {%- for block in section.blocks -%}
            {%- assign hb = block.settings -%}
            {%- case block.type -%}
              {%- when 'top_text' -%}
                {%- if hb.text != blank -%}
                  <style>#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_mobile | default: 14 }}px;{% if hb.enable_custom_weight %}font-weight:{{ hb.font_weight }};{% endif %}margin:{{ hb.space_above | default: 0 }}px 0 {{ hb.space_below | default: 6 }}px;}@media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_desktop | default: 15 }}px;}}</style>
                  <p class="m-0 fs-custom subheading_weight" data-bid="{{ block.id }}" {{ block.shopify_attributes }}>{{ hb.text }}</p>
                {%- endif -%}
              {%- when 'heading' -%}
                {%- if hb.text != blank -%}
                  <style>#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_mobile | default: 28 }}px;{% if hb.enable_custom_weight %}font-weight:{{ hb.font_weight }};{% endif %}margin:{{ hb.space_above | default: 0 }}px 0 {{ hb.space_below | default: 10 }}px;}@media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_desktop | default: 40 }}px;}}</style>
                  <h2 class="section__header-heading heading-letter-spacing" data-bid="{{ block.id }}" {{ block.shopify_attributes }}>{{ hb.text }}</h2>
                {%- endif -%}
              {%- when 'subheading' -%}
                {%- if hb.text != blank -%}
                  <style>#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_mobile | default: 15 }}px;{% if hb.enable_custom_weight %}font-weight:{{ hb.font_weight }};{% endif %}margin:{{ hb.space_above | default: 0 }}px 0 {{ hb.space_below | default: 0 }}px;}@media(min-width:768px){#shopify-section-{{ section.id }} [data-bid="{{ block.id }}"]{font-size:{{ hb.font_size_desktop | default: 17 }}px;}}</style>
                  <div class="section__header-des rich__text-m0" data-bid="{{ block.id }}" {{ block.shopify_attributes }}>{{ hb.text }}</div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign reels = section.blocks | where: 'type', 'reel' -%}
    {% if reels.size > 0 %}
      {%- if display_mode == 'carousel' -%}
        <slide-section
          class="swiper{% if reveal %} reveal_on_scroll{% endif %} lazy-loading-swiper-before rw-carousel"
          data-section-id="{{ section.id }}"
          data-autoplay="false"
          data-effect="slide"
          data-loop="false"
          data-speed="500"
          data-spacing="{{ column_gap }}"
          data-mobile="{{ columns_mobile }}"
          data-desktop="{{ columns }}"
          data-tablet="{% if columns > 3 %}3{% else %}{{ columns }}{% endif %}"
          data-pagination-style="{{ s.pagination_style | default: 'pill' }}"
        >
          {% if show_arrow %}{%- render 'swiper-navigation' -%}{% endif %}
          <div class="swiper-wrapper">
            {%- for block in reels -%}
              {%- assign b = block.settings -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {% render 'reel-tile', b: b, s: s, section_id: section.id %}
              </div>
            {%- endfor -%}
          </div>
          {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' -%}
            <div
              class="swiper-pagination flex flex-wrap px-15 lh-1 mt-20 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-{{ s.pagination_position | default: 'center' }}"
              style="--swiper-pagination-position: static;"
            ></div>
          {%- endif -%}
        </slide-section>
      {%- else -%}
        <div class="rw-grid">
          {%- for block in reels -%}
            {%- assign b = block.settings -%}
            <motion-element
              data-motion="fade-up-sm"
              data-motion-delay="{{ forloop.index0 | times: 60 }}"
              {% if scroll_animation != 'slide_in' %}hold{% endif %}
              {{ block.shopify_attributes }}
              class="{% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              style="--animation-order: {{ forloop.index }};"
            >
              {%- include 'reel-tile' -%}
            </motion-element>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {% endif %}
  </div>
</div>

{% comment %} Inline tile snippet {% endcomment %}
{% capture _ %}{% endcapture %}

<script>
(function () {
  var SID = '{{ section.id }}';
  var KEY = '__rwReels_' + SID;
  function init() {
  var section = document.getElementById('shopify-section-' + SID);
  if (!section) return;
  var root = section.querySelector('.section');
  if (!root || root.__rwInit) return;
  root.__rwInit = true;
  if (window[KEY] && window[KEY].disconnect) window[KEY].disconnect();
  var tiles = section.querySelectorAll('.rw-tile');

  // Auto-play in view + pause out of view
  if ('IntersectionObserver' in window) {
    var io = window[KEY] = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var v = entry.target.querySelector('video');
        if (!v) return;
        if (entry.isIntersecting && {{ autoplay_videos | json }}) {
          v.play().catch(function () {});
        } else {
          v.pause();
        }
      });
    }, { threshold: 0.4 });
    tiles.forEach(function (t) { io.observe(t); });
  }

  // Mute toggle
  section.querySelectorAll('.rw-sound').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var tile = btn.closest('.rw-tile');
      var v = tile && tile.querySelector('video');
      if (!v) return;
      v.muted = !v.muted;
      btn.classList.toggle('is-on', !v.muted);
    });
  });

  // Action button: like-toggle (visual only, no persistence)
  section.querySelectorAll('.rw-action[data-action="like"]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      btn.classList.toggle('is-active');
    });
  });
  }
  init();
  document.addEventListener('storelib:section-load', function (e) {
    if (e.detail && String(e.detail.sectionId) === SID) init();
  });
})();
{% comment %}{% endcomment %}</script>



