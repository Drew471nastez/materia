<template compat="shopify">
<script src="{{ 'live-r7-features.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Guarantee Banner.

  One calm band that states a promise (returns, warranty, delivery): a seal
  (an icon from the theme's guarantee icons, or a picked image), a heading, a
  line of text, an optional link to the policy page, and up to three short
  supporting points. Wide columns put the points beside the promise or centre
  everything; a phone (or any column under 750px) stacks it.

  Nothing moves here. Colours follow the colour scheme until Enable custom
  styling is on, fonts follow Theme settings until Enable custom fonts is on.
  The shared CSS is snippets/r7-features-base, the heading, text and button
  blocks are snippets/r7-features-block, and builder edits are applied in
  place by shopify/assets/live-r7-features.js.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign points = section.blocks | where: 'type', 'point'
  assign main_count = section.blocks.size | minus: points.size
  assign icon = st.icon | default: 'shield_check'
  assign icon_names = 'shield_check,badge_check,award,refresh,truck,package,lock,clock,check_circle,heart,leaf,globe' | split: ','
  assign seal_empty = false
  if st.image == blank and icon == 'none'
    assign seal_empty = true
  endif
  assign spx = 'content_max_width,icon_size,padding_top_desktop,padding_bottom_desktop,section_margin_top_desktop,section_margin_bottom_desktop,padding_top_mobile,padding_bottom_mobile,section_margin_top_mobile,section_margin_bottom_mobile'
  assign sc = 'section_bg,icon_color,border_color,point_color,marker_color'
  assign sf = 'enable_custom_fonts:heading_font,enable_custom_fonts:body_font'
  assign sa = 'section_width,show_section_on,reset_spacing,layout,frame,point_style'
  assign sa_list = sa | split: ','
-%}
{% render 'r7-features-base', sid: sid, st: st %}
<style>
  #shopify-section-{{ sid }} .gbn { --r7h-m: 24px; --r7h-d: 30px; --gbn-line: var(--r7-border_color, var(--color-border)); }
  #shopify-section-{{ sid }} .gbn__band { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: var(--r7-content_max_width); margin-inline: auto; }
  #shopify-section-{{ sid }} .gbn[data-frame='lines'] .gbn__band { padding-block: 28px; border-block: 1px solid var(--gbn-line); }
  #shopify-section-{{ sid }} .gbn[data-frame='box'] .gbn__band { padding: 28px 22px; border: 1px solid var(--gbn-line); border-radius: var(--rounded-radius, 8px); }
  #shopify-section-{{ sid }} .gbn__seal { flex: 0 0 auto; display: block; width: min(var(--r7-icon_size), 72px); height: min(var(--r7-icon_size), 72px); color: var(--r7-icon_color, var(--color-heading)); }
  #shopify-section-{{ sid }} .gbn__icon { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .gbn__icon svg { display: block; width: 100%; height: 100%; }
  #shopify-section-{{ sid }} .gbn__icon svg [stroke='#ffffff'] { stroke: var(--r7-section_bg, var(--color-background)); }
  #shopify-section-{{ sid }} .gbn__seal-img { display: block; width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ sid }} .gbn__main { flex: 1.25 1 0; gap: 8px; }
  #shopify-section-{{ sid }} .gbn__main .r7b { margin-top: 6px; }
  #shopify-section-{{ sid }} .gbn__main .r7b[data-style='link'] { margin-top: 0; }
  #shopify-section-{{ sid }} .gbn__points { flex: 1 1 0; align-self: stretch; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; min-width: 0; }
  #shopify-section-{{ sid }} .gbn__point {
    display: flex; align-items: flex-start; gap: 12px; margin: 0; padding: 14px 0; border-top: 1px solid var(--gbn-line);
    color: var(--r7-point_color, var(--color-heading)); font-size: var(--body-font-size, 16px); font-weight: 500; line-height: 1.45; overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .gbn__point:last-child { padding-bottom: 0; }
  #shopify-section-{{ sid }} .gbn__tick { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 20px; height: 1.45em; color: var(--r7-marker_color, var(--color-primary)); }
  #shopify-section-{{ sid }} .gbn__tick svg { display: block; width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .gbn[data-point_style='dot'] .gbn__tick svg { display: none; }
  #shopify-section-{{ sid }} .gbn[data-point_style='dot'] .gbn__tick::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  #shopify-section-{{ sid }} .gbn[data-point_style='plain'] .gbn__tick { display: none; }
  #shopify-section-{{ sid }} .gbn__ptext { min-width: 0; }
  #shopify-section-{{ sid }} .gbn__ptext :is(strong, b) { color: inherit; }
  #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__band { align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__main { flex: 0 1 auto; align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__points { flex: 0 1 auto; align-self: center; gap: 10px; }
  #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__point { padding: 0; border-top: 0; text-align: left; }
  #shopify-section-{{ sid }} .gbn[data-layout='stacked'][data-point_style='plain'] .gbn__point { justify-content: center; text-align: center; }
  @container r7s (min-width: 750px) {
    #shopify-section-{{ sid }} .gbn__band { flex-direction: row; align-items: center; gap: 36px; }
    #shopify-section-{{ sid }} .gbn[data-frame='lines'] .gbn__band { padding-block: 40px; }
    #shopify-section-{{ sid }} .gbn[data-frame='box'] .gbn__band { padding: 40px 44px; }
    #shopify-section-{{ sid }} .gbn__seal { width: var(--r7-icon_size); height: var(--r7-icon_size); }
    #shopify-section-{{ sid }} .gbn__points { align-self: center; padding-left: 36px; border-left: 1px solid var(--gbn-line); }
    #shopify-section-{{ sid }} .gbn__point:first-child { padding-top: 0; border-top: 0; }
    #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__band { flex-direction: column; gap: 24px; }
    #shopify-section-{{ sid }} .gbn[data-layout='stacked'] .gbn__points { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 12px 40px; padding-left: 0; border-left: 0; }
  }
{% comment %}{% endcomment %}</style>
{%- capture spec -%}{"px":"{{ spx }}","c":"{{ sc }}","f":"{{ sf }}","a":"{{ sa }}","own":"font:enable_custom_fonts","seal":"icon:image:image_alt"}{%- endcapture -%}
{%- capture bspec -%}{"heading":{"px":"size_desktop:px:size_enable,size_mobile:px:size_enable,line_height:n:size_enable,tracking:px:size_enable","c":"color","w":"weight:weight_enable","own":"size:size_enable,weight:weight_enable","r":"text"},"subheading":{"px":"size:px:size_enable","c":"color","r":"text"},"point":{"r":"text"},"button":{"kind":"button"}}{%- endcapture -%}
<div class="r7s gbn color-{{ color_scheme }} gradient" data-r7e="guarantee-banner" data-r7e-section="{{ sid }}"{% if request.design_mode %} data-r7e-editing data-r7e-settings="{{ st | json | escape }}" data-r7e-spec="{{ spec | escape }}" data-r7e-bspec="{{ bspec | escape }}"{% endif %}{% for k in sa_list %} data-{{ k }}="{{ st[k] }}"{% endfor %}{% if st.enable_custom_fonts %} data-own-font{% endif %} style="{% render 'r7-features-vars', s: st, px: spx, c: sc, f: sf, gate: st.enable_custom_style %}">
  {%- if request.design_mode -%}{%- for n in icon_names -%}<template data-r7e-icon-src="{{ n }}">{% render 'guarantee-icon', icon: n, stroke: 1.5 %}</template>{%- endfor -%}{%- endif -%}
  <div class="r7s__inner">
    <div class="gbn__band">
      {%- unless seal_empty and request.design_mode != true -%}
        <div class="gbn__seal" data-r7e-seal{% if seal_empty %} hidden{% endif %}>
          {%- if st.image != blank or request.design_mode -%}
            <img class="gbn__seal-img" data-r7e-i="image"{% if st.image != blank %} src="{{ st.image | image_url: width: 240 }}" width="{{ st.image.width | default: 240 }}" height="{{ st.image.height | default: 240 }}"{% else %} hidden{% endif %} alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
          {%- endif -%}
          {%- if st.image == blank or request.design_mode -%}
            <span class="gbn__icon" data-r7e-icon="{{ icon }}" aria-hidden="true"{% if st.image != blank or icon == 'none' %} hidden{% endif %}>{%- if icon != 'none' -%}{%- render 'guarantee-icon', icon: icon, stroke: 1.5 -%}{%- endif -%}</span>
          {%- endif -%}
        </div>
      {%- endunless -%}
      {%- if main_count > 0 -%}
        <div class="r7h gbn__main">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'point' -%}
              {%- render 'r7-features-block', block: block -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if points.size > 0 -%}
        <ul class="gbn__points" role="list">
          {%- for block in points limit: 3 -%}
            {%- assign bs = block.settings -%}
            <li class="gbn__point" data-r7e-block="{{ block.id }}" data-r7e-type="point" data-r7e-hide{% if request.design_mode %} data-r7e-bs="{{ bs | json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
              <span class="gbn__tick" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4.5 10.5l3.5 3.5 7.5-8"/></svg></span>
              <span class="gbn__ptext" data-r7e-bt="{{ block.id }}:text">{{ bs.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "guarantee-banner",
  "name": "Guarantee Banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "show_section_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All Devices"
        },
        {
          "value": "mobile",
          "label": "Only Mobile"
        },
        {
          "value": "desktop",
          "label": "Only Desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "split",
      "info": "A phone stacks the seal, the promise and the points.",
      "options": [
        {
          "value": "split",
          "label": "Side by side"
        },
        {
          "value": "stacked",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "select",
      "id": "frame",
      "label": "Frame",
      "default": "box",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lines",
          "label": "Lines"
        },
        {
          "value": "box",
          "label": "Box"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content width",
      "min": 600,
      "max": 1300,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Media"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Seal icon",
      "default": "shield_check",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "shield_check",
          "label": "Shield"
        },
        {
          "value": "badge_check",
          "label": "Seal"
        },
        {
          "value": "award",
          "label": "Award"
        },
        {
          "value": "refresh",
          "label": "Returns"
        },
        {
          "value": "truck",
          "label": "Delivery"
        },
        {
          "value": "package",
          "label": "Package"
        },
        {
          "value": "lock",
          "label": "Lock"
        },
        {
          "value": "clock",
          "label": "Clock"
        },
        {
          "value": "check_circle",
          "label": "Check"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "globe",
          "label": "Globe"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Seal image",
      "info": "Shown in place of the icon."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Seal image description",
      "info": "Read aloud by screen readers. Leave empty for a decorative image.",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Seal size",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56,
      "info": "A phone shows it at 72px at most."
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Appearance"
    },
    {
      "type": "select",
      "id": "point_style",
      "label": "Point marker",
      "default": "check",
      "options": [
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "plain",
          "label": "None"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Seal icon colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Frame and dividers",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "point_color",
      "label": "Point text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Point marker colour",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_27",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop)",
      "min": -200,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop)",
      "min": -200,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile)",
      "min": -200,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile)",
      "min": -200,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Our guarantee"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "weight_enable",
          "label": "Custom font weight",
          "default": false
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "700",
          "visible_if": "{{ block.settings.weight_enable }}",
          "options": [
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra bold"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "size_enable",
          "label": "Custom size",
          "default": false
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 30,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 24,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 0.9,
          "max": 2,
          "step": 0.1,
          "default": 1.2,
          "visible_if": "{{ block.settings.size_enable }}"
        },
        {
          "type": "range",
          "id": "tracking",
          "label": "Letter spacing",
          "min": -3,
          "max": 7,
          "step": 0.5,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.size_enable }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Say what you promise in one line: returns, warranty or delivery.</p>"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
