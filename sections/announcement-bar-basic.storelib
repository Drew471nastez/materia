  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Write your announcement here"
        },
        {
          "type": "textarea",
          "id": "text_mobile",
          "label": "Text on mobile",
          "info": "Optional. Leave empty to use the text above."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in a new tab",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Layout"
        },
        {
          "type": "select",
          "id": "visibility",
          "label": "Show on",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "All devices"
            },
            {
              "value": "desktop",
              "label": "Desktop only"
            },
            {
              "value": "mobile",
              "label": "Mobile only"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "header",
          "id": "hdr_11",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in a new tab",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_5",
          "label": "Layout"
        },
        {
          "type": "select",
          "id": "visibility",
          "label": "Show on",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "All devices"
            },
            {
              "value": "desktop",
              "label": "Desktop only"
            },
            {
              "value": "mobile",
              "label": "Mobile only"
            }
          ]
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "filled",
          "options": [
            {
              "value": "filled",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ]
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Appearance"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false,
          "info": "Off: the button follows Theme settings > Buttons."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.style == 'filled' }}"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text and border",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "bg_hover",
          "label": "Background on hover",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "color_hover",
          "label": "Text on hover",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "checkbox",
          "id": "use_theme_button",
          "label": "Theme button size and shape",
          "default": true
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Text size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "radius",
          "label": "Corner radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 50,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "padding_x",
          "label": "Horizontal padding",
          "min": 6,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 18,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "padding_y",
          "label": "Vertical padding",
          "min": 2,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 8,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "header",
          "id": "hdr_19",
          "label": "Typography"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_fonts",
          "label": "Enable custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "font",
          "label": "Font",
          "default": "assistant_n4",
          "visible_if": "{{ block.settings.enable_custom_fonts }}"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement Bar Basic ",
      "category": "Announcements",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Write your announcement here",
            "text_mobile": "Your announcement"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Shop now"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header",
      "template"
    ]
  },
  "shopify": {
    "enabled_on": {
      "groups": [
        "header",
        "template"
      ]
    },
    "name": "Announcement Bar Basic ",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "full_width",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "display_section_on",
        "label": "Show on",
        "default": "display_all",
        "options": [
          {
            "value": "display_all",
            "label": "All devices"
          },
          {
            "value": "display_only_desktop",
            "label": "Desktop only"
          },
          {
            "value": "display_mobile",
            "label": "Mobile only"
          },
          {
            "value": "display_none",
            "label": "Hidden"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "Add Message and Button blocks. Each block can show on all devices, desktop only or mobile only."
      },
      {
        "type": "textarea",
        "id": "message",
        "label": "Announcement text (Desktop)",
        "default": "",
        "info": "Legacy: used only when the section has no blocks.",
        "hidden": true,
        "visible_if": "{{ false }}"
      },
      {
        "type": "textarea",
        "id": "message_mobile",
        "label": "Announcement text (Mobile)",
        "default": "",
        "hidden": true,
        "info": "Legacy: used only when the section has no blocks.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Message link",
        "default": "/",
        "hidden": true,
        "info": "Legacy: used only when the section has no blocks.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "checkbox",
        "id": "open_in_new_tab",
        "label": "Open message link in new tab",
        "default": false,
        "hidden": true,
        "info": "Legacy: used only when the section has no blocks.",
        "visible_if": "{{ false }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "content_gap",
        "label": "Gap between items",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "bar_padding_x",
        "label": "Side padding (desktop)",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "select",
        "id": "background_type",
        "label": "Background",
        "default": "solid",
        "options": [
          {
            "value": "solid",
            "label": "Solid color"
          },
          {
            "value": "gradient",
            "label": "Gradient"
          }
        ]
      },
      {
        "type": "range",
        "id": "gradient_angle",
        "label": "Gradient angle",
        "min": 0,
        "max": 360,
        "step": 10,
        "unit": "deg",
        "default": 90,
        "visible_if": "{{ section.settings.background_type == 'gradient' }}"
      },
      {
        "type": "checkbox",
        "id": "show_border_bottom",
        "label": "Bottom border",
        "default": false
      },
      {
        "type": "range",
        "id": "border_width",
        "label": "Border width",
        "min": 1,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 1,
        "visible_if": "{{ section.settings.show_border_bottom }}"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme."
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colour",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.background_type == 'solid' }}"
      },
      {
        "type": "color",
        "id": "gradient_start_color",
        "label": "Gradient start",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.background_type == 'gradient' }}"
      },
      {
        "type": "color",
        "id": "gradient_end_color",
        "label": "Gradient end",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.background_type == 'gradient' }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.show_border_bottom }}"
      },
