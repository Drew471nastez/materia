<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- liquid
  assign __ab_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ab_reveal = section.settings.reveal
-%}
<style>
  /* Theme typography for announcement bars */
  #shopify-section-{{ section.id }} { font-family: var(--body-font, inherit); }
{% comment %}{% endcomment %}</style>
<!-- ab-theme:start -->
{% comment %}
  Announcement Bar Section
  This section creates a customizable announcement bar at the top of your Shopify store.
{% endcomment %}

{%- liquid
  assign ab_align = section.settings.content_alignment | default: 'center'
  case ab_align
    when 'left'
      assign ab_justify = 'flex-start'
      assign ab_text_align = 'left'
    when 'right'
      assign ab_justify = 'flex-end'
      assign ab_text_align = 'right'
    else
      assign ab_justify = 'center'
      assign ab_text_align = 'center'
  endcase
-%}

<section
  id="announcement-bar"
  class="unique-announcement-bar color-{{ color_scheme }} gradient {{ section.settings.section_width }}"
  style="
    background: {% if section.settings.background_type == 'solid' %}
                 {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};
               {% elsif section.settings.background_type == 'gradient' %}
                 linear-gradient({{ section.settings.gradient_angle }}deg, {% render 'scheme-color', color: section.settings.gradient_start_color, fallback: 'var(--color-background)' %}, {% render 'scheme-color', color: section.settings.gradient_end_color, fallback: 'var(--color-primary)' %});
               {% endif %};
    color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %} !important;
  "
>
  <style>
    /* Scoped CSS for Announcement Bar */
    /* Import Custom Font if Enabled */
    {% if section.settings.enable_custom_font %}
      @import url('https://fonts.googleapis.com/css2?family={{ section.settings.custom_font | replace: ' ', '+' }}&display=swap');
    {% endif %}

    /* Base Styles */
    #announcement-bar.unique-announcement-bar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: {{ ab_justify }};
      gap: {{ section.settings.content_gap | default: 12 }}px;
      padding: 0 {{ section.settings.bar_padding_x | default: 20 }}px;
      box-sizing: border-box;
      transition: all 0.3s ease;
      text-align: {{ ab_text_align }};
      letter-spacing: {{ section.settings.letter_spacing | default: 0 }}px;
      text-transform: {{ section.settings.text_transform | default: 'none' }};
      flex-wrap: wrap;
      font-family: {% if section.settings.enable_custom_font %}"{{ section.settings.custom_font }}"{% else %}inherit{% endif %};
      /* Inherit the theme's body weight unless a custom weight is enabled. */
      font-weight: {% if section.settings.enable_custom_font_weight %}{{ section.settings.message_font_weight | default: 400 }}{% else %}var(--body-weight, inherit){% endif %};
      {% if section.settings.show_border_bottom %}
        border-bottom: {{ section.settings.border_width | default: 1 }}px solid {% render 'scheme-color', color: section.settings.border_color, fallback: 'var(--color-border)' %};
      {% endif %}
    }
    #announcement-bar.unique-announcement-bar a {
      color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %} !important;
      text-decoration: none;
    }
    #announcement-bar.unique-announcement-bar a:hover {
      text-decoration: underline;
    }
    #announcement-bar.unique-announcement-bar .close-button {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: {% render 'scheme-color', color: section.settings.text_color, fallback: 'var(--color-text)' %} !important;
      font-size: 20px;
      cursor: pointer;
      padding: 0;
      line-height: 1;
      z-index: 1;
    }

    /* Per-device visibility helpers (used by message & button blocks) */
    @media (max-width: 767px) {
      #announcement-bar.unique-announcement-bar .ab-hide-mobile { display: none !important; }
    }
    @media (min-width: 768px) {
      #announcement-bar.unique-announcement-bar .ab-hide-desktop { display: none !important; }
    }

    /* Message text — weight follows the custom-weight toggle, else theme. */
    #announcement-bar.unique-announcement-bar .ab-msg {
      flex: 0 1 auto;
      margin: 0;
      {% if section.settings.enable_custom_font_weight %}font-weight: {{ section.settings.message_font_weight | default: 400 }};{% endif %}
    }

    /* Button — shared layout; colors / size set per block */
    #announcement-bar.unique-announcement-bar a.ab-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-weight: {% if section.settings.enable_custom_font_weight %}{{ section.settings.button_font_weight | default: 600 }}{% else %}inherit{% endif %};
      line-height: 1;
      white-space: nowrap;
      text-decoration: none !important;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    #announcement-bar.unique-announcement-bar a.ab-button:hover {
      text-decoration: none !important;
      opacity: 0.88;
      transform: translateY(-1px);
    }

    /* Display Section On Settings */
    {% case section.settings.display_section_on %}
      {% when 'display_none' %}
        #announcement-bar.unique-announcement-bar {
          display: none;
        }
      {% when 'display_only_desktop' %}
        /* Hide on Mobile */
        @media (max-width: 767px) {
          #announcement-bar.unique-announcement-bar {
            display: none;
          }
        }
      {% when 'display_mobile' %}
        /* Hide on Desktop */
        @media (min-width: 768px) {
          #announcement-bar.unique-announcement-bar {
            display: none;
          }
        }
      {% when 'display_all' %}
        /* Display on All Devices */
    {% endcase %}

    /* Desktop Styles — min-height so a tall button is never clipped */
    @media (min-width: 768px) {
      #announcement-bar.unique-announcement-bar {
        min-height: {{ section.settings.bar_height }}px;
        height: auto;
        font-size: {{ section.settings.font_size }}px;
      }
    }

    /* Mobile Styles — grow to fit (min-height + wrap) so the message and
       button are never clipped, and reserve side room for the close button. */
    @media (max-width: 767px) {
      #announcement-bar.unique-announcement-bar {
        min-height: {{ section.settings.mobile_bar_height }}px;
        height: auto;
        font-size: {{ section.settings.mobile_font_size }}px;
        padding: 8px {% if section.settings.show_close_button_mobile %}36px{% else %}14px{% endif %};
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: {{ ab_justify }};
        row-gap: 6px;
      }
      #announcement-bar.unique-announcement-bar .close-button {
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
      }
      {% if section.settings.show_close_button_mobile %}
        #announcement-bar.unique-announcement-bar .close-button { display: block; }
      {% else %}
        #announcement-bar.unique-announcement-bar .close-button { display: none; }
      {% endif %}
    }
{% comment %}{% endcomment %}  </style>

  <!-- Announcement content (blocks) -->
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- assign _vis = block.settings.visibility | default: 'all' -%}
      {%- assign _viscls = '' -%}
      {%- if _vis == 'desktop' -%}{%- assign _viscls = 'ab-hide-mobile' -%}{%- elsif _vis == 'mobile' -%}{%- assign _viscls = 'ab-hide-desktop' -%}{%- endif -%}
      {%- case block.type -%}
        {%- when 'message' -%}
          {%- assign _nt = '' -%}
          {%- if block.settings.open_in_new_tab -%}{%- assign _nt = 'target="_blank" rel="noopener"' -%}{%- endif -%}
          {%- if _vis == 'all' and block.settings.text_mobile != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ab-msg ab-hide-mobile" {{ _nt }} {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
              <a href="{{ block.settings.link }}" class="ab-msg ab-hide-desktop" {{ _nt }}>{{ block.settings.text_mobile }}</a>
            {%- else -%}
              <span class="ab-msg ab-hide-mobile" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              <span class="ab-msg ab-hide-desktop">{{ block.settings.text_mobile }}</span>
            {%- endif -%}
          {%- else -%}
            {%- assign _txt = block.settings.text -%}
            {%- if _vis == 'mobile' and block.settings.text_mobile != blank -%}{%- assign _txt = block.settings.text_mobile -%}{%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ab-msg {{ _viscls }}" {{ _nt }} {{ block.shopify_attributes }}>{{ _txt }}</a>
            {%- else -%}
              <span class="ab-msg {{ _viscls }}" {{ block.shopify_attributes }}>{{ _txt }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- when 'button' -%}
          <style>
            #announcement-bar #ab-btn-{{ block.id }} {
              {%- if block.settings.use_theme_button -%}
              padding: var(--btn-padding-y, 14px) var(--btn-padding-x, 26px);
              border-radius: var(--btn-radius, 8px);
              font-size: var(--btn-font-size, 14px);
              font-weight: var(--btn-font-weight, 500);
              font-family: var(--btn-font, var(--body-font));
              letter-spacing: var(--btn-letter-spacing, 0);
              text-transform: var(--btn-text-transform, none);
              {%- else -%}
              padding: {{ block.settings.padding_y | default: 8 }}px {{ block.settings.padding_x | default: 18 }}px;
              border-radius: {{ block.settings.radius | default: 50 }}px;
              font-size: {{ block.settings.font_size | default: 14 }}px;
              {%- endif -%}
              transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
              {%- if block.settings.style == 'outline' -%}
                background: transparent;
                color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--btn-primary-color)' %} !important;
                border: var(--btn-border-width, 1px) solid {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--btn-primary-color)' %};
              {%- else -%}
                background: {% render 'scheme-color', color: block.settings.bg_color, fallback: 'var(--btn-primary-bg-color)' %};
                color: {% render 'scheme-color', color: block.settings.text_color, fallback: 'var(--btn-primary-color)' %} !important;
                border: var(--btn-border-width, 1px) solid {% render 'scheme-color', color: block.settings.bg_color, fallback: 'var(--btn-primary-border-color)' %};
              {%- endif -%}
            }
{% comment %}{% endcomment %}          </style>
          <a id="ab-btn-{{ block.id }}" class="ab-button {{ _viscls }}" href="{{ block.settings.link | default: '#' }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label | default: 'Shop now' }}</a>
      {%- endcase -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} No blocks yet — fall back to the default message settings. {%- endcomment -%}
    {%- if section.settings.message_mobile != blank -%}
      <a href="{{ section.settings.link }}" class="ab-msg ab-hide-mobile"{% if section.settings.open_in_new_tab %} target="_blank"{% endif %}>{{ section.settings.message }}</a>
      <span class="ab-msg ab-hide-desktop">{{ section.settings.message_mobile }}</span>
    {%- else -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="ab-msg"{% if section.settings.open_in_new_tab %} target="_blank"{% endif %}>{{ section.settings.message }}</a>
      {%- else -%}
        <span class="ab-msg">{{ section.settings.message }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  <!-- Close Button -->
  {% if section.settings.show_close_button %}
    <button class="close-button" aria-label="{{ 'accessibility.close' | t }}">&times;</button>
  {% endif %}

  <!-- Updated Scoped JavaScript -->
  <script>
    (function() {
      document.addEventListener('DOMContentLoaded', function() {
        var announcementBar = document.getElementById('announcement-bar');
        if (!announcementBar) return;

        // If closed flag exists and is still valid, hide bar immediately
        var closedUntil = localStorage.getItem('announcementBarClosedUntil');
        if (closedUntil && Date.now() < parseInt(closedUntil, 10)) {
          announcementBar.style.display = 'none';
          return;
        }

        var closeButton = announcementBar.querySelector('.close-button');
        if (closeButton) {
          closeButton.addEventListener('click', function() {
            // Hide the bar and set expiry for 1 day
            announcementBar.style.display = 'none';
            var expireTime = Date.now() + {{ section.settings.close_persistence_days | default: 1 }} * 24 * 60 * 60 * 1000;
            localStorage.setItem('announcementBarClosedUntil', expireTime);
          });
        }
      });
    })();
{% comment %}{% endcomment %}  </script>
</section>



</template>

<schema>
{
  "type": "announcement-bar-basic",
  "name": "Announcement Bar Basic ",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Visibility"
    },
    {
      "type": "select",
      "id": "display_section_on",
      "label": "Display section on",
      "default": "display_all",
      "options": [
        {
          "value": "display_none",
          "label": "Hidden (off)"
        },
        {
          "value": "display_all",
          "label": "All devices"
        },
        {
          "value": "display_only_desktop",
          "label": "Desktop / larger screens only"
        },
        {
          "value": "display_mobile",
          "label": "Mobile only"
        }
      ],
      "info": "Choose where the announcement bar appears."
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Default message"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Announcement text (Desktop)",
      "default": "Click and Collect is now available. Complimentary shipping over $400.",
      "info": "Fallback desktop text."
    },
    {
      "type": "textarea",
      "id": "message_mobile",
      "label": "Announcement text (Mobile)",
      "default": "FREE SHIPPING ON ORDERS OVER 50$",
      "info": "Shown on mobile. Leave blank to reuse the desktop text."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Message link",
      "default": "/",
      "info": "Where the announcement text links to when clicked."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open message link in new tab",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Enable custom font",
      "default": false,
      "info": "Enable to choose a Google font for the announcement text."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size (Desktop)",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Font size (Mobile)",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "custom_font",
      "label": "Custom Fonts",
      "default": "Roboto",
      "options": [
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Open Sans",
          "label": "Open Sans"
        },
        {
          "value": "Lato",
          "label": "Lato"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Oswald",
          "label": "Oswald"
        },
        {
          "value": "Source Sans Pro",
          "label": "Source Sans Pro"
        },
        {
          "value": "Raleway",
          "label": "Raleway"
        },
        {
          "value": "Yanone Kaffeesatz",
          "label": "Yanone Kaffeesatz"
        },
        {
          "value": "Merriweather",
          "label": "Merriweather"
        },
        {
          "value": "PT Sans",
          "label": "PT Sans"
        },
        {
          "value": "Noto Sans",
          "label": "Noto Sans"
        },
        {
          "value": "Nunito",
          "label": "Nunito"
        },
        {
          "value": "Ubuntu",
          "label": "Ubuntu"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        },
        {
          "value": "Slabo 27px",
          "label": "Slabo 27px"
        },
        {
          "value": "Lora",
          "label": "Lora"
        },
        {
          "value": "Fira Sans",
