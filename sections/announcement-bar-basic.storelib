      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (Desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (Desktop)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (Mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (Mobile)",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_42",
      "label": "Behavior & Animation"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button (Desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_button_mobile",
      "label": "Show close button (Mobile)",
      "default": true
    },
    {
      "type": "range",
      "id": "close_persistence_days",
      "label": "Stay closed for (days)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 1,
      "info": "How long the bar stays hidden after a visitor closes it. 0 = reappears on next page load."
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses your global Animations & motion setting."
    }
  ],
