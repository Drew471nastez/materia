    "blocks": [
      {
        "type": "message",
        "name": "Message",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Write your announcement here"
          },
          {
            "type": "textarea",
            "id": "text_mobile",
            "label": "Text on mobile",
            "info": "Optional. Leave empty to use the text above."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open link in a new tab",
            "default": false
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "visibility",
            "label": "Show on",
            "default": "all",
            "options": [
              {
                "value": "all",
                "label": "All devices"
              },
              {
                "value": "desktop",
                "label": "Desktop only"
              },
              {
                "value": "mobile",
                "label": "Mobile only"
              }
            ]
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open link in a new tab",
            "default": false
          },
          {
            "type": "header",
            "content": "Layout"
          },
          {
            "type": "select",
            "id": "visibility",
            "label": "Show on",
            "default": "all",
            "options": [
              {
                "value": "all",
                "label": "All devices"
              },
              {
                "value": "desktop",
                "label": "Desktop only"
              },
              {
                "value": "mobile",
                "label": "Mobile only"
              }
            ]
          },
          {
            "type": "select",
            "id": "style",
            "label": "Style",
            "default": "filled",
            "options": [
              {
                "value": "filled",
                "label": "Filled"
              },
              {
                "value": "outline",
                "label": "Outline"
              }
            ]
          },
          {
            "type": "header",
            "content": "Appearance"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: the button follows Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg_color",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style and block.settings.style == 'filled' }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text and border",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text on hover",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Theme button size and shape",
            "default": true
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Text size",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 50,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Horizontal padding",
            "min": 6,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 18,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Vertical padding",
            "min": 2,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom font",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Announcement Bar Basic ",
        "category": "Announcements",
        "blocks": [
          {
            "type": "message",
            "settings": {
              "text": "Write your announcement here",
              "text_mobile": "Your announcement"
            }
          },
          {
            "type": "button",
            "settings": {
              "label": "Shop now"
            }
          }
        ]
      }
    ],
    "class": "section-edge-bleed"
  }
}
</schema>
