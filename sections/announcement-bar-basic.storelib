            "label": "Background"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text / border"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "range",
            "id": "font_size",
            "label": "Font size",
            "min": 10,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 50,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_x",
            "label": "Padding (horizontal)",
            "min": 6,
            "max": 40,
            "step": 1,
            "unit": "px",
            "default": 18,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "padding_y",
            "label": "Padding (vertical)",
            "min": 2,
            "max": 24,
            "step": 1,
            "unit": "px",
            "default": 8,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
