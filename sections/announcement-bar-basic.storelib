      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Close button (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_button_mobile",
      "label": "Close button (mobile)",
      "default": true
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "default": "Close announcement",
      "info": "Read by screen readers.",
      "visible_if": "{{ section.settings.show_close_button or section.settings.show_close_button_mobile }}"
    },
    {
      "type": "range",
      "id": "close_persistence_days",
      "label": "Stay closed for (days)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 1,
      "info": "0 keeps it closed until the browser tab closes.",
      "visible_if": "{{ section.settings.show_close_button or section.settings.show_close_button_mobile }}"
    },
    {
      "type": "header",
      "id": "hdr_44",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
