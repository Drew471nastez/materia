    "presets": [
      {
        "name": "Before and After Image Slider",
        "category": "Features",
        "blocks": [
          {
            "type": "heading"
          },
          {
            "type": "subheading"
          },
          {
            "type": "button"
          }
        ]
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "<strong>Before and after</strong>"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Typography"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "700",
            "visible_if": "{{ block.settings.weight_enable }}",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              },
              {
                "value": "800",
                "label": "Extra-bold"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "size_enable",
            "label": "Custom size",
            "info": "Off: uses the section's heading size.",
            "default": false
          },
          {
            "type": "range",
            "id": "size_desktop",
            "visible_if": "{{ block.settings.size_enable }}",
            "label": "Size (desktop)",
            "min": 18,
            "max": 80,
            "step": 1,
            "unit": "px",
            "default": 36
          },
          {
            "type": "range",
            "id": "size_mobile",
            "visible_if": "{{ block.settings.size_enable }}",
            "label": "Size (mobile)",
            "min": 16,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 30
          },
          {
            "type": "range",
            "id": "line_height",
            "visible_if": "{{ block.settings.size_enable }}",
            "label": "Line height",
            "min": 0.9,
            "max": 2,
            "step": 0.1,
            "default": 1.1
          },
          {
            "type": "range",
            "id": "tracking",
            "visible_if": "{{ block.settings.size_enable }}",
            "label": "Letter spacing",
            "min": -3,
            "max": 7,
            "step": 0.1,
            "unit": "px",
            "default": 0
          },
          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom fonts",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "subheading",
