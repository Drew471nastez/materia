<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- comment -%}
  Materia Themes. Before and After Slider: a heading, text and button beside
  or above a comparison slider. Drag the handle (mouse or touch), click the
  image, or focus the handle and use the arrow keys. Every value is a CSS
  variable on the section root, so media-live-before-after.js changes it in
  place without moving the handle or reloading an image.
{%- endcomment -%}
<style data-rs-bulletproof data-bam-reset-style{% unless section.settings.reset_spacing %} media="not all"{% endunless %}>
  #shopify-section-{{ section.id }} > .section,
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div,
  #shopify-section-{{ section.id }} > div > .section { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section,
  #shopify-section-{{ section.id }} + section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign custom = st.enable_custom_style
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Cg fill=%22%23808080%22 fill-opacity=%220.5%22%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22/%3E%3C/g%3E%3C/svg%3E'
  assign ratio = st.media_aspect_ratio | default: '16 / 9'
  assign wide = '1fr'
  case ratio
    when '21 / 9', '3 / 1'
      assign wide = '3fr'
    when '16 / 9', '3 / 2', '5 / 4'
      assign wide = '2fr'
  endcase
  if st.media_location == 'right'
    assign cols = '1fr ' | append: wide
  else
    assign cols = wide | append: ' 1fr'
  endif
  assign start = st.start_percent | default: 50
  # Heading, text and button are blocks. The old section settings
  # (headline, content, link_text, link) are drawn only when the section
  # has no block of that type, so instances saved before the blocks keep
  # their words.
  assign has_heading_block = false
  assign has_sub_block = false
  assign has_button_block = false
  assign block_text = false
  for block in section.blocks
    case block.type
      when 'heading'
        assign has_heading_block = true
      when 'subheading'
        assign has_sub_block = true
      when 'button'
        assign has_button_block = true
    endcase
    if block.settings.text != blank
      assign block_text = true
    endif
  endfor
  assign legacy_heading = false
  if has_heading_block == false and st.headline != blank
    assign legacy_heading = true
  endif
  assign legacy_content = false
  if has_sub_block == false and st.content != blank
    assign legacy_content = true
  endif
  assign show_button = false
  if has_button_block == false and st.enable_button and st.link_text != blank
    assign show_button = true
  endif
  assign show_text = false
  if legacy_heading or legacy_content or show_button or block_text
    assign show_text = true
  endif
  assign before_alt = st.before_image.alt | default: st.before_caption | strip_html | default: 'Before'
  assign after_alt = st.after_image.alt | default: st.after_caption | strip_html | default: 'After'
  assign icon = st.circle_icon | default: 'icon2'
-%}
<style>
  {%- if st.enable_custom_fonts %}{% if st.heading_font.family %}{{ st.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if st.body_font.family %}{{ st.body_font | font_face: font_display: 'swap' }}{% endif %}{% endif %}
  {%- for block in section.blocks %}{% if block.settings.enable_custom_fonts and block.settings.font.family %}{{ block.settings.font | font_face: font_display: 'swap' }}{% endif %}{% endfor %}
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
    --bam-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px;
    --bam-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
    --bam-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px;
    --bam-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px;
  }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--bam-mt-m) !important; margin-bottom: var(--bam-mb-m) !important; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--bam-mt-d) !important; margin-bottom: var(--bam-mb-d) !important; }
  }
  #shopify-section-{{ sid }} .bas {
    --bas-bg: {% if custom %}{% render 'scheme-color', color: st.section_background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --bas-bg-image: {% if st.section_background_image != blank %}url("{{ st.section_background_image | image_url: width: 2400 }}"){% else %}none{% endif %};
    --bas-heading-color: {% if custom %}{% render 'scheme-color', color: st.headline_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bas-text-color: {% if custom %}{% render 'scheme-color', color: st.content_text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
    --bas-label-bg: {% if custom %}{% render 'scheme-color', color: st.before_after_background_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --bas-label-color: {% if custom %}{% render 'scheme-color', color: st.before_after_text_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bam-line-color: {% if custom %}{% render 'scheme-color', color: st.bar_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bam-knob-bg: {% if custom %}{% render 'scheme-color', color: st.circle_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
    --bam-icon-color: {% if custom %}{% render 'scheme-color', color: st.circle_icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
    --bas-heading-font: {% if st.enable_custom_fonts and st.heading_font.family %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};
    --bas-body-font: {% if st.enable_custom_fonts and st.body_font.family %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};
    --bas-heading-size-d: {{ st.headline_size | default: 36 }}px;
    --bas-heading-size-m: {{ st.mobile_headline_size | default: 38 }}px;
    --bas-heading-lh: {{ st.headline_line_height | default: '1.0' }};
    --bas-text-size: {{ st.text_size | default: 17 }}px;
    --bas-text-lh: {{ st.text_line_height | default: '1.4' }};
    --bas-align: {{ st.text_alignment | default: 'center' }};
    --bas-text-gap: {{ st.headline_spacing | default: 0 }}px;
    --bas-el-gap: {{ st.element_spacing | default: 0 }}px;
    --bas-col-gap: {{ st.horizontal_gap | default: 0 }}px;
    --bas-cols: {{ cols }};
    --bas-max: {{ st.container_max_width | default: 850 }}px;
    --bas-pad-y-d: {{ st.section_padding_top_bottom | default: 0 }}px;
    --bas-pad-x-d: {{ st.section_padding_left_right | default: 0 }}px;
    --bas-pad-y-m: {{ st.mobile_section_padding_top_bottom | default: 0 }}px;
    --bas-pad-x-m: {{ st.mobile_section_padding_left_right | default: 0 }}px;
    --bas-cpad-y-d: {{ st.container_padding_top_bottom | default: 0 }}px;
    --bas-cpad-x-d: {{ st.container_padding_left_right | default: 0 }}px;
    --bas-cpad-y-m: {{ st.mobile_container_padding_top_bottom | default: 0 }}px;
    --bas-cpad-x-m: {{ st.mobile_container_padding_left_right | default: 0 }}px;
    --bam-ratio: {{ ratio }};
    --bam-radius: {{ st.media_radius | default: 0 }}px;
    --bam-line-w: {{ st.vertical_line_weight | default: 3 }}px;
    --bam-line-opacity: {{ st.bar_opacity | default: 100 | divided_by: 100.0 }};
    --bam-knob-opacity: {{ st.circle_opacity | default: 100 | divided_by: 100.0 }};
    --bam-knob-size: 50px;
    --bam-icon-size: 25px;
  }
  #shopify-section-{{ sid }} .bas {
    box-sizing: border-box;
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
    background-color: var(--bas-bg) !important;
    background-image: var(--bas-bg-image);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    padding: var(--bas-pad-y-m) var(--bas-pad-x-m);
  }
  #shopify-section-{{ sid }} .bas *, #shopify-section-{{ sid }} .bas *::before, #shopify-section-{{ sid }} .bas *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .bas [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .bas[data-width="container"] { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .bas[data-width="fluid_container"] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .bas__container { position: relative; max-width: var(--bas-max); margin: 0 auto; padding: var(--bas-cpad-y-m) var(--bas-cpad-x-m); }
  #shopify-section-{{ sid }} .bas__grid { display: flex; flex-direction: column; gap: var(--bas-el-gap); }
  #shopify-section-{{ sid }} .bas__text { display: flex; flex-direction: column; gap: var(--bas-el-gap); padding-bottom: var(--bas-text-gap); text-align: var(--bas-align); min-width: 0; }
  #shopify-section-{{ sid }} .bas__heading { margin: 0; font-family: var(--bas-font, var(--bas-heading-font)); font-size: var(--bas-heading-size-m); line-height: var(--bas-heading-lh); color: var(--bas-c, var(--bas-heading-color)) !important; }
  #shopify-section-{{ sid }} .bas__content { font-family: var(--bas-font, var(--bas-body-font)); font-size: var(--bas-text-size); line-height: var(--bas-text-lh); color: var(--bas-c, var(--bas-text-color)) !important; }
  #shopify-section-{{ sid }} :is(.bas__heading, .bas__content)[data-weight="true"] { font-weight: var(--bas-w); }
  #shopify-section-{{ sid }} :is(.bas__heading, .bas__content)[data-weight="true"] > * { font-weight: inherit; }
  #shopify-section-{{ sid }} .bas__heading[data-size="true"] { font-size: var(--bas-size-m); line-height: var(--bas-lh); letter-spacing: var(--bas-track); }
  #shopify-section-{{ sid }} .bas__content[data-size="true"] { font-size: var(--bas-size); line-height: var(--bas-lh); }
  #shopify-section-{{ sid }} .bas__content > * { margin: 0 0 var(--bas-el-gap); font-size: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ sid }} .bas__content > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .bas__content li { margin: 0 0 5px; }
  #shopify-section-{{ sid }} .bas__actions { margin: 0; text-align: var(--bas-align); }
  #shopify-section-{{ sid }} .bas__media { min-width: 0; }
  #shopify-section-{{ sid }} .bas .bam-compare__label { top: 15px; padding: 5px 10px; border-radius: 5px; font-family: var(--bas-body-font); font-size: 13px; line-height: 1.3; background: var(--bas-label-bg); color: var(--bas-label-color); white-space: nowrap; max-width: calc(50% - 20px); overflow: hidden; text-overflow: ellipsis; }
  #shopify-section-{{ sid }} .bas .bam-compare__label--before { left: 15px; }
  #shopify-section-{{ sid }} .bas .bam-compare__label--after { right: 15px; }
  #shopify-section-{{ sid }} .bas[data-shadow="low"] .bam-compare { box-shadow: 2px 2px 5px rgba(0, 0, 0, .3); }
  #shopify-section-{{ sid }} .bas[data-shadow="medium"] .bam-compare { box-shadow: 4px 4px 10px rgba(0, 0, 0, .5); }
  #shopify-section-{{ sid }} .bas[data-shadow="high"] .bam-compare { box-shadow: 6px 6px 15px rgba(0, 0, 0, .7); }
  #shopify-section-{{ sid }} .bas [data-hover-anim="fade-in"]:hover { opacity: .8; }
  #shopify-section-{{ sid }} .bas [data-hover-anim="shadow"]:hover { --btn-shadow: 0 4px 10px rgba(0, 0, 0, .3); }
  @media (max-width: 899.98px) {
    #shopify-section-{{ sid }} .bas[data-show="desktop"] { display: none; }
  }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .bas { padding: var(--bas-pad-y-d) var(--bas-pad-x-d); }
    #shopify-section-{{ sid }} .bas[data-show="mobile"] { display: none; }
    #shopify-section-{{ sid }} .bas__container { padding: var(--bas-cpad-y-d) var(--bas-cpad-x-d); }
    #shopify-section-{{ sid }} .bas__heading { font-size: var(--bas-heading-size-d); }
    #shopify-section-{{ sid }} .bas__heading[data-size="true"] { font-size: var(--bas-size-d); }
    #shopify-section-{{ sid }} .bas:is([data-location="left"], [data-location="right"]) .bas__grid:has(> .bas__text:not([hidden])) { display: grid; grid-template-columns: var(--bas-cols); align-items: center; column-gap: var(--bas-col-gap); }
    #shopify-section-{{ sid }} .bas[data-location="left"] .bas__media { grid-column: 1; grid-row: 1; }
    #shopify-section-{{ sid }} .bas[data-location="left"] .bas__text { grid-column: 2; grid-row: 1; }
    #shopify-section-{{ sid }} .bas[data-location="right"] .bas__media { grid-column: 2; grid-row: 1; }
    #shopify-section-{{ sid }} .bas[data-location="right"] .bas__text { grid-column: 1; grid-row: 1; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .bas[data-width="stretch_width"] { padding-inline: 3rem; }
  }
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- case block.type -%}
      {%- when 'heading' %}
  #shopify-section-{{ sid }} [data-bam-block="{{ block.id }}"] {
    --bas-c: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--bas-heading-color)' %}{% else %}var(--bas-heading-color){% endif %};
    --bas-font: {% if bs.enable_custom_fonts and bs.font.family %}{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }}{% else %}var(--bas-heading-font){% endif %};
    --bas-w: {{ bs.weight | default: 700 }};
    --bas-size-d: {{ bs.size_desktop | default: 36 }}px;
    --bas-size-m: {{ bs.size_mobile | default: 30 }}px;
    --bas-lh: {{ bs.line_height | default: 1.1 }};
    --bas-track: {{ bs.tracking | default: 0 }}px;
  }
      {%- when 'subheading' %}
  #shopify-section-{{ sid }} [data-bam-block="{{ block.id }}"] {
    --bas-c: {% if bs.enable_custom_style %}{% render 'scheme-color', color: bs.color, fallback: 'var(--bas-text-color)' %}{% else %}var(--bas-text-color){% endif %};
    --bas-font: {% if bs.enable_custom_fonts and bs.font.family %}{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }}{% else %}var(--bas-body-font){% endif %};
    --bas-w: {{ bs.weight | default: 400 }};
    --bas-size: {{ bs.size | default: 17 }}px;
    --bas-lh: {{ bs.line_height | default: 1.4 }};
  }
    {%- endcase -%}
  {%- endfor %}
{% comment %}{% endcomment %}</style>
{% render 'media-ba-compare-style', sid: sid %}
{%- capture cta_style -%}{%- if custom -%}{%- render 'button-overrides', bg: st.button_background_color, text: st.button_text_color -%}{%- endif -%}{%- if st.use_theme_button == false -%}{%- render 'button-overrides', custom: true, radius: st.button_border_radius, padding_y: st.button_padding_tb, padding_x: st.button_padding_lr, font_size: st.button_text_size -%}{%- endif -%}{%- endcapture -%}
<div class="bas color-{{ color_scheme }} gradient" data-bam-root="slider" data-bam-section="{{ sid }}" data-bam-settings="{{ st | json | escape }}" data-bam-defaults='{"color_scheme":"default-color-scheme","section_width":"full_width","show_on_device":"all","reset_spacing":true,"before_caption":"Before","after_caption":"After","enable_button":true,"text_alignment":"center","media_location":"bottom","horizontal_gap":100,"container_max_width":850,"element_spacing":21,"headline_spacing":15,"media_aspect_ratio":"16 / 9","media_radius":5,"image_shadow":"none","start_percent":50,"show_bar":true,"vertical_line_weight":3,"bar_opacity":75,"show_circle":true,"circle_icon":"icon2","circle_opacity":95,"use_theme_button":true,"button_text_size":14,"button_padding_tb":9,"button_padding_lr":23,"button_border_radius":5,"button_hover_animation":"fade-in","enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","headline_size":36,"headline_line_height":"1.0","text_size":17,"text_line_height":"1.4","reveal":true,"section_padding_top_bottom":30,"section_padding_left_right":25,"container_padding_top_bottom":10,"container_padding_left_right":10,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"mobile_headline_size":38,"mobile_section_padding_top_bottom":30,"mobile_section_padding_left_right":25,"mobile_container_padding_top_bottom":10,"mobile_container_padding_left_right":0,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-bam-block-defaults='{"heading":{"text":"<strong>Before and after</strong>","enable_custom_style":false,"weight_enable":false,"weight":"700","size_enable":false,"size_desktop":36,"size_mobile":30,"line_height":1.1,"tracking":0,"enable_custom_fonts":false,"font":"assistant_n4"},"subheading":{"text":"<p>Present comparisons between two images, for showcasing product benefits.</p>","enable_custom_style":false,"weight_enable":false,"weight":"400","size_enable":false,"size":17,"line_height":1.4,"enable_custom_fonts":false,"font":"assistant_n4"},"button":{"text":"Shop now","link":"/collections/all","enable_custom_style":false,"use_theme_button":true,"border_width":0,"radius":5,"size":14,"weight_enable":false,"weight":"600","pad_x":23,"pad_y":9}}' data-bam-placeholder="{{ placeholder | escape }}" data-width="{{ st.section_width }}" data-show="{{ st.show_on_device | default: 'all' }}" data-location="{{ st.media_location | default: 'bottom' }}" data-shadow="{{ st.image_shadow | default: 'none' }}">
  <div class="bas__container">
    <div class="bas__grid">
      <div class="bas__text"{% unless show_text %} hidden{% endunless %}>
        {%- unless has_heading_block -%}
          <h2 class="bas__heading" data-bam-text="headline"{% unless legacy_heading %} hidden{% endunless %}>{{ st.headline }}</h2>
        {%- endunless -%}
        {%- unless has_sub_block -%}
          <div class="bas__content" data-bam-text="content"{% unless legacy_content %} hidden{% endunless %}>{{ st.content }}</div>
        {%- endunless -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="bas__heading" data-bam-block="{{ block.id }}" data-bam-type="heading" data-bam-settings="{{ bs | json | escape }}" data-size="{% if bs.size_enable %}true{% else %}false{% endif %}" data-weight="{% if bs.weight_enable %}true{% else %}false{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="bas__content" data-bam-block="{{ block.id }}" data-bam-type="subheading" data-bam-settings="{{ bs | json | escape }}" data-size="{% if bs.size_enable %}true{% else %}false{% endif %}" data-weight="{% if bs.weight_enable %}true{% else %}false{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'button' -%}
              {%- capture btn_style -%}{%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover -%}{%- endif -%}{%- if bs.use_theme_button == false -%}{%- if bs.weight_enable -%}{%- assign btn_weight = bs.weight -%}{%- else -%}{%- assign btn_weight = nil -%}{%- endif -%}{%- render 'button-overrides', custom: true, radius: bs.radius, padding_y: bs.pad_y, padding_x: bs.pad_x, font_size: bs.size, weight: btn_weight, border_width: bs.border_width -%}{%- endif -%}{%- endcapture -%}
              <div class="bas__actions" data-bam-button-wrap{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
                {%- if bs.link != blank -%}
                  <a class="bas__cta" href="{{ bs.link }}" data-bam-block="{{ block.id }}" data-bam-type="button" data-bam-settings="{{ bs | json | escape }}" data-theme-button="primary" data-sl-button data-button-role="primary"{% if btn_style != blank %} style="{{ btn_style | strip }}"{% endif %}>{{ bs.text | escape }}</a>
                {%- else -%}
                  <button class="bas__cta" type="button" data-bam-block="{{ block.id }}" data-bam-type="button" data-bam-settings="{{ bs | json | escape }}" data-theme-button="primary" data-sl-button data-button-role="primary"{% if btn_style != blank %} style="{{ btn_style | strip }}"{% endif %}>{{ bs.text | escape }}</button>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- unless has_button_block -%}
        <div class="bas__actions" data-bam-legacy-button{% unless show_button %} hidden{% endunless %}>
          {%- if st.link != blank -%}
            <a class="bas__cta" href="{{ st.link }}" data-bam-cta data-theme-button="primary" data-sl-button data-button-role="primary"{% if st.use_theme_button == false and st.button_hover_animation != 'none' %} data-hover-anim="{{ st.button_hover_animation }}"{% endif %}{% if cta_style != blank %} style="{{ cta_style | strip }}"{% endif %}>{{ st.link_text }}</a>
          {%- else -%}
            <button class="bas__cta" type="button" data-bam-cta data-theme-button="primary" data-sl-button data-button-role="primary"{% if st.use_theme_button == false and st.button_hover_animation != 'none' %} data-hover-anim="{{ st.button_hover_animation }}"{% endif %}{% if cta_style != blank %} style="{{ cta_style | strip }}"{% endif %}>{{ st.link_text }}</button>
          {%- endif -%}
        </div>
        {%- endunless -%}
      </div>
      <div class="bas__media">
        <div class="bam-compare" data-bam-compare data-bar="{% if st.show_bar == false %}false{% else %}true{% endif %}" data-circle="{% if st.show_circle == false %}false{% else %}true{% endif %}" style="--bam-pos: {{ start }}%;">
          {%- if st.after_image != blank -%}
            <img class="bam-compare__img" data-bam-image="after_image" src="{{ st.after_image | image_url: width: 1200 }}" srcset="{{ st.after_image | image_url: width: 600 }} 600w, {{ st.after_image | image_url: width: 1200 }} 1200w, {{ st.after_image | image_url: width: 1800 }} 1800w" sizes="(min-width: 900px) 850px, 100vw" alt="{{ after_alt | escape }}" width="{{ st.after_image.width | default: 1600 }}" height="{{ st.after_image.height | default: 900 }}" loading="lazy" decoding="async" draggable="false">
          {%- else -%}
            <img class="bam-compare__img" data-bam-image="after_image" src="{{ placeholder }}" alt="" width="1600" height="900" loading="lazy" decoding="async" draggable="false">
          {%- endif -%}
          <span class="bam-compare__label bam-compare__label--after" data-bam-text="after_caption"{% if st.after_caption == blank %} hidden{% endif %}>{{ st.after_caption }}</span>
          <div class="bam-compare__before">
            {%- if st.before_image != blank -%}
              <img class="bam-compare__img" data-bam-image="before_image" src="{{ st.before_image | image_url: width: 1200 }}" srcset="{{ st.before_image | image_url: width: 600 }} 600w, {{ st.before_image | image_url: width: 1200 }} 1200w, {{ st.before_image | image_url: width: 1800 }} 1800w" sizes="(min-width: 900px) 850px, 100vw" alt="{{ before_alt | escape }}" width="{{ st.before_image.width | default: 1600 }}" height="{{ st.before_image.height | default: 900 }}" loading="lazy" decoding="async" draggable="false">
            {%- else -%}
              <img class="bam-compare__img" data-bam-image="before_image" src="{{ placeholder }}" alt="" width="1600" height="900" loading="lazy" decoding="async" draggable="false">
            {%- endif -%}
            <span class="bam-compare__label bam-compare__label--before" data-bam-text="before_caption"{% if st.before_caption == blank %} hidden{% endif %}>{{ st.before_caption }}</span>
          </div>
          <div class="bam-compare__handle" data-bam-handle role="slider" tabindex="0" aria-label="{{ 'accessibility.drag_to_reveal' | t }}" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ start }}" aria-valuetext="{{ start }}%">
            <span class="bam-compare__bar" aria-hidden="true"></span>
            <span class="bam-compare__knob" data-bam-icon-current="{{ icon }}" aria-hidden="true">{% render 'media-ba-icon', icon: icon %}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {%- if request.design_mode -%}
    {%- assign icon_list = 'icon1,icon2,icon3,icon10,icon11,icon12,icon13,icon14' | split: ',' -%}
    {%- for name in icon_list -%}<template data-bam-icon="{{ name }}">{% render 'media-ba-icon', icon: name %}</template>{%- endfor -%}
  {%- endif -%}
</div>
</template>

