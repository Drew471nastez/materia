          {
            "type": "checkbox",
            "id": "enable_custom_fonts",
            "label": "Enable custom fonts",
            "default": false
          },
          {
            "type": "font_picker",
            "id": "font",
            "label": "Font",
            "default": "assistant_n4",
            "visible_if": "{{ block.settings.enable_custom_fonts }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Label",
            "default": "Shop now"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "default": "/collections/all"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color",
            "label": "Text color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "color_hover",
            "label": "Text color (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "header",
            "content": "Shape and type"
          },
          {
            "type": "checkbox",
            "id": "use_theme_button",
            "label": "Match theme button",
            "default": true
          },
          {
            "type": "range",
            "id": "border_width",
            "label": "Border width",
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "px",
            "default": 0,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 5,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "size",
            "label": "Text size",
            "min": 10,
            "max": 30,
            "step": 1,
            "unit": "px",
            "default": 14,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "checkbox",
            "id": "weight_enable",
            "label": "Custom font weight",
            "default": false,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "select",
            "id": "weight",
            "label": "Weight",
            "default": "600",
            "visible_if": "{{ block.settings.use_theme_button == false and block.settings.weight_enable }}",
            "options": [
              {
                "value": "400",
                "label": "Normal"
              },
              {
                "value": "500",
                "label": "Medium"
              },
              {
                "value": "600",
                "label": "Semi-bold"
              },
              {
                "value": "700",
                "label": "Bold"
              }
            ]
          },
          {
            "type": "range",
            "id": "pad_x",
            "label": "Side padding",
            "min": 6,
            "max": 60,
            "step": 1,
            "unit": "px",
            "default": 23,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          },
          {
            "type": "range",
            "id": "pad_y",
            "label": "Top and bottom padding",
            "min": 4,
            "max": 28,
            "step": 1,
            "unit": "px",
            "default": 9,
            "visible_if": "{{ block.settings.use_theme_button == false }}"
          }
        ]
      }
    ]
  }
}
</schema>
