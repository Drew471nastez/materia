<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if section.settings.reveal == false -%}<span data-ti-no-reveal hidden></span>{%- endif -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
{%- comment -%}
  The section wrapper's own rules (spacing, width, isolation), which need its
  id. The rest of the bar's CSS is benefits-bar.css, its script
  benefits-bar.js.
{%- endcomment -%}
<style>
  {%- if section.settings.reset_spacing %}
  #shopify-section-{{ section.id }},#shopify-section-{{ section.id }}>.section,#shopify-section-{{ section.id }}>section,#shopify-section-{{ section.id }}>div,#shopify-section-{{ section.id }}>div>.section{margin-top:0!important;margin-bottom:0!important}
  #shopify-section-{{ section.id }}>.section,#shopify-section-{{ section.id }}>section,#shopify-section-{{ section.id }}>div>.section{padding-top:0!important;padding-bottom:0!important}
  #shopify-section-{{ section.id }}+.shopify-section,#shopify-section-{{ section.id }}+section{margin-top:0!important}
  .shopify-section:has(+ #shopify-section-{{ section.id }}){margin-bottom:0!important}
  @supports not selector(:has(*)){#shopify-section-{{ section.id }}{margin-top:0!important}}
  {%- endif %}
  #shopify-section-{{ section.id }}{isolation:isolate;font-weight:var(--body-weight,inherit);max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;padding-left:0!important;padding-right:0!important;position:relative!important;box-sizing:border-box!important}
  :where(#shopify-section-{{ section.id }}){font-family:var(--body-font,inherit)}
  :where(#shopify-section-{{ section.id }}) :where(button,input,textarea,select,optgroup){font-family:inherit}
  :where(#shopify-section-{{ section.id }}) :is(h1,h2,h3,h4,h5,h6){font-weight:var(--heading-weight,inherit);font-family:var(--heading-font,inherit)}
  #shopify-section-{{ section.id }}>:where(div,section,header,footer,aside,main,article):first-child{max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;box-sizing:border-box!important}
{% comment %}{% endcomment %}</style>
{%- comment -%} The builder also gets it inline, so a section it draws again is never shown for a frame before the file applies. {%- endcomment -%}
{%- if request.design_mode -%}<style>{{ 'benefits-bar.css' | inline_asset_content }}</style>{%- endif %}
{{ 'benefits-bar.css' | asset_url | stylesheet_tag }}
<!-- ti-theme:start -->
{%- liquid
  assign __bb_reset_spacing = ''
  if section.settings.reset_spacing
    assign __bb_reset_spacing = ' remove_spacing'
  endif
  assign __bb_scroll_anim = settings.scroll_animation | default: 'none'
  assign __bb_reveal = section.settings.reveal
-%}
{%- comment -%}
  Theme integration wrapper:
   - color-{{scheme}} class brings in --color-foreground / --color-background / --color-heading
   - body font hook so untyped text inherits theme typography
   - scroll-trigger class fires the global Animations & motion reveal
{%- endcomment -%}
<section
  class="Loudz-{{ section.id | handle }} LoudzValueIconsBar color-{{ color_scheme }} gradient {{ section.settings.section_width }}{{ __bb_reset_spacing }}{% if section.settings.bar_width == 100 %} LoudzValueIconsBar--fullWidth{% endif %}{% if request.visual_preview_mode %} LoudzValueIconsBar--previewStyles{% endif %}"
>
{%- liquid
if section.settings.icons_mobile_layout == "slider"
assign slider_wrapper = "vtls-values-icons-slider"
else
assign slider_wrapper = "div"
endif
-%}
<{{ slider_wrapper }}
class="
LoudzValueIconsBarContainer
{% if section.settings.background_image == blank and section.settings.section_background_style == 'image' %}LoudzValueIconsBarContainer--emptyImage{% endif %}
LoudzValueIconsBarContainer--backgroundStyle-{{ section.settings.section_background_style }}
"
>
{%- if section.blocks.size > 1 and section.settings.icons_mobile_layout == "slider" -%}
<button
class="LoudzValueIconsBarContainer__Btn LoudzValueIconsBarContainer__Btn--prev"
aria-controls="value-icons-bar"
aria-label="{{ 'accessibility.previous' | t }}"
>
<svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M12.375 2.75L5.625 9.5L12.375 16.25" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</button>
{%- endif -%}
<ul class="LoudzValueIconsBarList LoudzValueIconsBarList--mobileLayout-{{ section.settings.icons_mobile_layout }}">
{%- for block in section.blocks -%}
{%- comment -%} The icon library is snippets/features-a-fa-icon (also Benefits Icons'). {%- endcomment -%}
{%- liquid
assign heading = block.settings.icon_title
assign icon = block.settings.icon
assign font_awesome = block.settings.font_awesome
assign custom_icon = block.settings.custom_icon
if block.settings.icon_type == 'upload' and custom_icon != blank
assign icon = 'none'
assign font_awesome = ''
endif
-%}
<li
class="
LoudzValueIconsBarBlock
{% if section.settings.icons_mobile_layout == "slider" %}LoudzValueIconsBarBlock__Slide{% endif %}
"
data-block-id="{{ block.id }}"
{{ block.shopify_attributes }}
>
<div class="LoudzValueIconsBarBlockContent">
<div class="LoudzValueIconsBarBlock__IconWrapper">
{%- if font_awesome != blank -%}
<div class="LoudzValueIconsBarBlock__Icon">
{{ font_awesome }}
</div>
{%- elsif icon != "none" -%}
<div class="LoudzValueIconsBarBlock__Icon">
{%- render 'features-a-fa-icon', name: icon -%}
</div>
{%- elsif custom_icon != blank -%}
<div class="LoudzValueIconsBarBlock__Icon">
{{-
custom_icon
| image_url: width: custom_icon.width
| image_tag:
sizes: "100vw",
widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
fetchpriority: "low",
loading: "lazy"
-}}
</div>
{%- else -%}
<div class="LoudzValueIconsBarBlock__Icon">
<img
src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E"
alt="{{ 'accessibility.abstract_figure_image' | t }}"
width="580"
height="580"
loading="lazy"
sizes="100vw"
fetchpriority="low"
class="LoudzValueIconsBarBlock__IconDefault"
>
</div>
{%- endif -%}
</div>
<div class="LoudzValueIconsBarBlock__TextContent">
{%- if heading != blank -%}
<p class="LoudzValueIconsBarBlock__Heading">
{{- heading -}}
</p>
{%- endif -%}
</div>
</div>
</li>
{%- endfor -%}
</ul>
{%- if section.blocks.size > 1 and section.settings.icons_mobile_layout == "slider" -%}
<button
class="LoudzValueIconsBarContainer__Btn LoudzValueIconsBarContainer__Btn--next"
aria-controls="value-icons-bar"
aria-label="{{ 'accessibility.next' | t }}"
>
<svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.625 2.75L12.375 9.5L5.625 16.25" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</button>
{%- endif -%}
</{{ slider_wrapper }}>
</section>

{%- comment -%} This bar's values, read by benefits-bar.css. {%- endcomment -%}
{% style %}
.Loudz-{{ section.id | handle }} {
--section-top-margin: 0px;
--section-bottom-margin: 0px;
--section-left-margin: {{ section.settings.left_margin_desktop }}px;
--section-right-margin: {{ section.settings.right_margin_desktop }}px;
--section-top-padding: {{ section.settings.top_padding_desktop }}px;
--section-bottom-padding: {{ section.settings.bottom_padding_desktop }}px;
--section-left-padding: {{ section.settings.left_padding_desktop }}px;
--section-right-padding: {{ section.settings.right_padding_desktop }}px;
--section-top-margin-mobile: 0px;
--section-bottom-margin-mobile: 0px;
--section-left-margin-mobile: {{ section.settings.left_margin_mobile }}px;
--section-right-margin-mobile: {{ section.settings.right_margin_mobile }}px;
--section-top-padding-mobile: {{ section.settings.top_padding_mobile }}px;
--section-bottom-padding-mobile: {{ section.settings.bottom_padding_mobile }}px;
--section-left-padding-mobile: {{ section.settings.left_padding_mobile }}px;
--section-right-padding-mobile: {{ section.settings.right_padding_mobile }}px;
{%- if section.settings.section_max_width != blank -%}
--section-max-width: {{- section.settings.section_max_width -}}px;
{%- endif -%}
--section-width: {{- section.settings.bar_width -}}%;
--horizontal-gap-desktop: {{ section.settings.horizontal_gap_desktop }}px;
--horizontal-gap-mobile: {{ section.settings.horizontal_gap_mobile }}px;
--vertical-gap-mobile: {{ section.settings.vertical_gap_mobile }}px;
--section-background-color: {% render 'scheme-color', color: section.settings.section_background, fallback: 'var(--color-background)' %} !important;
--section-background-gradient: {{ section.settings.section_gradient }} !important;
--section-icon-color: {% render 'scheme-color', color: section.settings.icon_color, fallback: 'var(--color-heading)' %} !important;
--section-icon-title-color: {% render 'scheme-color', color: section.settings.icon_title_color, fallback: 'var(--color-heading)' %} !important;
--section-icon-title-weight: {% if section.settings.icon_title_style == 'theme' or section.settings.icon_title_style == blank %}var(--subheading-weight, 500){% else %}{{ section.settings.icon_title_style }}{% endif %};
--section-icon-size: {{- section.settings.icon_size -}}px;
--section-icon-title-size: {{- section.settings.icon_title_size -}}px;
--icon-border-radius: {%- if section.settings.enable_circle_icons -%}50%{%- else -%}0{%- endif -%};
--section-icons-per-row-desktop: {{- section.settings.icons_per_row_desktop -}};
--section-icons-mobile-layout: {{- section.settings.icons_mobile_layout -}};
}
{% endstyle %}
<script src="{{ 'benefits-bar.js' | asset_url }}" defer></script>
{%- if request.design_mode -%}
{%- comment -%} The builder runs a redrawn or newly added section's inline scripts: load the script if this page did not have it yet, or set this section up again. {%- endcomment -%}
<script>(function(){if(window.MateriaBenefitsBar)return window.MateriaBenefitsBar.init();if(document.querySelector('script[data-bb-boot]'))return;var s=document.createElement('script');s.src="{{ 'benefits-bar.js' | asset_url }}";s.setAttribute('data-bb-boot','');document.head.appendChild(s);})();{% comment %}{% endcomment %}</script>
{%- endif -%}
</template>

<schema>
{
  "type": "benefits-bar",
  "name": "Benefits Bar",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "range",
      "id": "bar_width",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Bar width (desktop)",
      "default": 64
    },
    {
      "type": "header",
      "id": "hdr_7",
      "label": "Items / Icons"
    },
    {
      "type": "range",
      "id": "icons_per_row_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Items per row (desktop)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_circle_icons",
      "label": "Round icons / images into a circle",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 28
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Item Typography"
    },
    {
      "type": "range",
      "id": "icon_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "icon_title_color",
      "label": "Title color"
    },
    {
      "type": "select",
      "id": "icon_title_style",
      "label": "Title weight",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "200",
          "label": "Extra Light"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Style & Colors"
    },
    {
      "type": "select",
      "id": "section_background_style",
      "label": "Background type",
      "default": "color",
      "options": [
        {
          "value": "color",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "visible_if": "{{ section.settings.section_background_style == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "section_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(to right, #fed951, #ff46c7)",
      "visible_if": "{{ section.settings.section_background_style == 'gradient' }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal section on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "horizontal_gap_desktop",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Horizontal gap (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "bottom_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "left_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "right_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right padding (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "left_margin_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left margin (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "right_margin_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right margin (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Mobile"
    },
    {
      "type": "select",
      "id": "icons_mobile_layout",
      "label": "Mobile layout",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 per row"
        },
        {
          "value": "2",
          "label": "2 per row"
        },
        {
          "value": "slider",
          "label": "Slider (swipeable)"
        }
      ]
    },
    {
      "type": "range",
      "id": "horizontal_gap_mobile",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Horizontal gap (mobile)",
      "default": 22
    },
    {
      "type": "range",
      "id": "vertical_gap_mobile",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Vertical gap (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "left_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left padding (mobile)",
      "default": 68
    },
    {
      "type": "range",
      "id": "right_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right padding (mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "left_margin_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "right_margin_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right margin (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type",
          "options": [
            {
              "value": "icon",
              "label": "Built-in icon"
            },
            {
              "value": "upload",
              "label": "Custom upload"
            }
          ],
          "default": "icon"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Select icon",
          "visible_if": "{{ block.settings.icon_type == 'icon' }}",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "lock",
              "label": "Secure checkout"
            },
            {
              "value": "shield_alt",
              "label": "Buyer protection"
            },
            {
              "value": "user_shield",
              "label": "Data privacy"
            },
            {
              "value": "check_circle",
              "label": "Satisfaction guarantee"
            },
            {
              "value": "key",
              "label": "Verified and Secure"
            },
            {
              "value": "shipping_fast",
              "label": "Fast shipping"
            },
            {
              "value": "box",
              "label": "Discreet packaging"
            },
            {
              "value": "truck",
              "label": "Free delivery"
            },
            {
              "value": "route",
              "label": "Trackable orders"
            },
            {
              "value": "headset",
              "label": "Customer support"
            },
            {
              "value": "envelope",
              "label": "Email us"
            },
            {
              "value": "comments",
              "label": "Live chat"
            },
            {
              "value": "question_circle",
              "label": "FAQs"
            },
            {
              "value": "map_marker_alt",
              "label": "Our location"
            },
            {
              "value": "award",
              "label": "Certified product"
            },
            {
              "value": "gem",
              "label": "Premium quality"
            },
            {
              "value": "hands",
              "label": "Handmade"
            },
            {
              "value": "thumbs-up",
              "label": "Customer approved"
            },
