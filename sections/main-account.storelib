      "default": "Account"
    },
    {
      "type": "text",
      "id": "nav_addresses",
      "label": "Menu: addresses",
      "default": "Addresses"
    },
    {
      "type": "text",
      "id": "nav_wishlist",
      "label": "Menu: wishlist",
      "default": "Wishlist"
    },
    {
      "type": "text",
