      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
