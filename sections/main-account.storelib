<template compat="shopify">
{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. The account page (/account): the signed in customer's orders and details,
  with the account menu. Storelib gives the page its customer (in the builder a
  sample one) and saves addresses at checkout.
 
  Live edits: shopify/assets/live-account-pages.js.
{%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
  <style>
    #shopify-section-{{ section.id }}.scroll-trigger {
      --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
      --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
    }
{% comment %}{% endcomment %}  </style>
  <script>
    (function(){
      var el = document.getElementById('shopify-section-{{ section.id }}');
      if (!el || el.classList.contains('scroll-trigger')) return;
      el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
    })();
{% comment %}{% endcomment %}  </script>
{%- endif -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign custom = st.enable_custom_style
-%}
{% render 'account-pages-base', sid: sid %}
{% render 'account-pages-font-face', st: st %}
{%- capture fonts -%}{% render 'account-pages-font-vars', st: st %}{%- endcapture -%}
<div
  class="ap ap-account bls__page-account color-{{ scheme }} gradient"
  data-ap-root="main-account"
  data-ap-section="{{ sid }}"{% if request.design_mode %}
  data-ap-settings="{{ st | json | escape }}"{% endif %}
  {% if st.reset_spacing %}data-ap-reset{% endif %}
  style="--ap-pt: {{ st.padding_top | default: 0 }}px; --ap-pb: {{ st.padding_bottom | default: 0 }}px; --ap-pt-m: {{ st.padding_top_mobile | default: 0 }}px; --ap-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px; --ap-hfs-d: {{ st.heading_size_desktop | default: 30 }}px; --ap-hfs-m: {{ st.heading_size_mobile | default: 24 }}px;{% if custom and st.heading_color != blank %} --ap-h-c: {{ st.heading_color }};{% endif %}{% if custom and st.text_color != blank %} --ap-t-c: {{ st.text_color }};{% endif %}{{ fonts }}"
>
  {%- assign container = st.container | replace: 'strecth-width', 'stretch_width' | replace: 'full-width', 'full_width' | replace: 'container-fluid', 'fluid_container' -%}
  <div class="{{ container }}" data-ap-width>
    <div class="ap-acc__grid">
      <div>{% render 'customer-nav', st: st %}</div>
      <div>
        <div class="ap-block">
          <h1 class="ap__h" data-ap-text="heading" data-ap-opt{% if st.heading == blank %} hidden{% endif %}>{{ st.heading | escape }}</h1>
          <p class="ap__t ap-account__welcome"><span data-ap-text="welcome_text">{{ st.welcome_text | escape }}</span> <strong>{{ customer.name | default: customer.email }}</strong></p>
        </div>
        <div class="ap-block bls__order-history">
          <h2 class="ap__h ap__h--sub" data-ap-text="orders_heading" data-ap-opt{% if st.orders_heading == blank %} hidden{% endif %}>{{ st.orders_heading | escape }}</h2>
          {%- paginate customer.orders by 10 -%}
            {%- if customer.orders.size > 0 -%}
              <div class="ap-table-wrap">
                <table class="ap-table table-history-order">
                  <thead>
                    <tr>
                      <th scope="col" data-ap-text="order_label">{{ st.order_label | escape }}</th>
                      <th scope="col" data-ap-text="date_label">{{ st.date_label | escape }}</th>
                      <th scope="col" data-ap-text="status_label">{{ st.status_label | escape }}</th>
                      <th scope="col" data-ap-text="total_label">{{ st.total_label | escape }}</th>
                    </tr>
                  </thead>
                  <tbody class="loadmore-lists">
                    {%- for order in customer.orders -%}
                      {%- assign order_url = order.customer_url | default: order.action_url | default: order.url -%}
                      {%- assign order_name = order.name | default: order.number | default: order.order_number -%}
                      <tr class="loadmore-item">
                        <td>{% if order_url != blank %}<a class="ap__link" href="{{ order_url }}">{{ order_name }}</a>{% else %}{{ order_name }}{% endif %}</td>
                        <td>{% if order.created_at != blank %}{{ order.created_at | date: '%b %d, %Y' }}{% else %}{{ order.date }}{% endif %}</td>
                        <td>{{ order.fulfillment_status_label | default: order.status | default: order.financial_status_label }}</td>
                        <td>{% if order.total_price != blank %}{{ order.total_price | money }}{% else %}{{ order.total }}{% endif %}</td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', section_st: st, pagination: st.pagination, number_page: 10, count: customer.orders_count, paginate: paginate %}
              {%- endif -%}
            {%- else -%}
              <div class="ap-card ap-account__none">
                <p class="ap__t" data-ap-text="no_orders_text">{{ st.no_orders_text | escape }}</p>
                <a class="ap__link" href="{{ routes.all_products_collection_url | default: '/collections/all' }}" data-ap-text="shop_link_label" data-ap-opt{% if st.shop_link_label == blank %} hidden{% endif %}>{{ st.shop_link_label | escape }}</a>
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
        <div class="ap-block bls__account-details">
          <h2 class="ap__h ap__h--sub" data-ap-text="details_heading" data-ap-opt{% if st.details_heading == blank %} hidden{% endif %}>{{ st.details_heading | escape }}</h2>
          <dl class="ap-card ap-account__details">
            <div><dt data-ap-text="name_label">{{ st.name_label | escape }}</dt><dd>{{ customer.name }}</dd></div>
            <div><dt data-ap-text="email_label">{{ st.email_label | escape }}</dt><dd>{{ customer.email }}</dd></div>
          </dl>
          <a href="{{ routes.account_addresses_url | default: '/account/addresses' }}" class="btn btn-primary no-underline ap-account__addresses" data-theme-button="primary" data-sl-button data-ap-text="addresses_button_label" data-ap-opt{% if st.addresses_button_label == blank %} hidden{% endif %}>{{ st.addresses_button_label | escape }}</a>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ sid }} .ap-account__details { display: grid; gap: 10px; margin: 0 0 20px; }
  #shopify-section-{{ sid }} .ap-account__details > div { display: grid; grid-template-columns: minmax(90px, 30%) minmax(0, 1fr); gap: 12px; }
  #shopify-section-{{ sid }} .ap-account__details :is(dt, dd) { margin: 0; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .ap-account__details dt { color: var(--ap-h-c, var(--color-heading)); }
  #shopify-section-{{ sid }} .ap-account__none .ap__t { margin: 0; }
{% comment %}{% endcomment %}</style>
</template>

<schema>
{
  "type": "main-account",
  "name": "Account",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
