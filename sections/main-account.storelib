<template compat="shopify">
{% render 'theme-type' %}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'my-account.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign container = st.container | replace: 'strecth-width', 'stretch_width' | replace: 'full-width', 'full_width'
-%}

<section class="bls__section bls__page-account mt-40">
  <div class="{{ container }} section-full">
    <div class="flex flex-wrap gap" style="--col-gap: 30px;--col-width: 25%;">
      <div class="w-full col-sm-w-custom">
        <div class="account-dashboard border rounded-5 sticky top-30">
          {% render 'customer-nav' %}
        </div>
      </div>
      <div class="col-sm-remaining mb-20 w-full">
        <div class="mb-30">
          <span>
            {{- 'customer.account.welcome' | t }}
            <strong>{{ customer.name }}</strong>!</span
          >
          <span
            >({{ 'customer.account.no' | t }}
            <strong>{{ customer.name }}</strong>
            <a href="{{ routes.account_logout_url }}" class="underline">{{ 'customer.log_out' | t }}</a>)</span
          >
        </div>
        <div class="bls__order-history mb-30">
          <h3 class="mb-15">{{ 'customer.orders.title' | t }}</h3>
          {% paginate customer.orders by 10 %}
            {%- if customer.orders.size > 0 -%}
              <table class="table-history-order">
                <thead>
                  <tr>
                    <th>{{ 'customer.orders.order_number' | t }}</th>
                    <th>{{ 'customer.orders.date' | t }}</th>
                    <th>{{ 'customer.orders.payment_status' | t }}</th>
                    <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                    <th>{{ 'customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody class="loadmore-lists">
                  {%- for order in customer.orders -%}
                    <tr class="loadmore-item">
                      <td>
                        <a href="{{ order.customer_url }}">{{ order.name }}</a>
                      </td>
                      <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination',
                  section_st: st,
                  pagination: st.pagination,
                  number_page: 10,
                  count: customer.orders_count,
                  paginate: paginate
                %}
              {%- endif -%}
            {%- else -%}
              <div class="no-order">
                <span class="icon-done"></span>
                <a class="no-underline" href="{{ routes.collections_url }}">{{ 'customer.orders.make' | t }}</a>
                {{ 'customer.orders.none' | t }}
              </div>
            {% endif %}
          {% endpaginate %}
        </div>
        <div class="bls__account-details mb-15">
          <h3 class="mb-15">{{ 'customer.account.details' | t }}</h3>
          <div class="account-details mb-30">
            <div class="account-name">
              <span>{{ 'customer.addresses.name' | t }}</span>
              <span>{{ customer.name }}</span>
            </div>
            <div class="account-email">
              <span>{{ 'customer.addresses.email' | t }}</span>
              <span>{{ customer.email }}</span>
            </div>
            {%- if customer.phone != blank -%}
              <div class="">
                <span>{{ 'customer.addresses.phone' | t }}</span>
                <span>{{ customer.phone }}</span>
              </div>
            {% endif %}
            {%- if customer.country != blank -%}
              <div class="">
                <span>{{ 'customer.addresses.country' | t }}</span>
                <span>{{ customer.country }}</span>
              </div>
            {% endif %}
          </div>
          <a href="{{ routes.account_addresses_url }}" class="btn btn-primary no-underline inline-block" data-theme-button="primary" data-sl-button>
            {{- 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a
          >
        </div>
      </div>
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "main-account",
  "name": "Account",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Other"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Layout",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "container-fluid",
          "label": "Fluid container"
        },
        {
          "value": "strecth-width",
          "label": "Stretch width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "load_more",
          "label": "Load more"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    }
  ],
  "shopify": {
    "name": "Account",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Other"
      },
      {
        "type": "select",
        "id": "container",
        "label": "Layout",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "container-fluid",
            "label": "Fluid container"
          },
          {
            "label": "Stretch width",
            "value": "strecth-width"
          },
          {
            "value": "full-width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "select",
        "id": "pagination",
        "label": "Pagination",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "load_more",
            "label": "Load more"
          },
          {
            "value": "infinit_scrolling",
            "label": "Infinite scroll"
          }
        ]
      }
    ]
  }
}
</schema>
