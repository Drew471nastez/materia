<template compat="shopify">
<script src="{{ 'live-r7-testimonials.js' | asset_url }}" defer="defer"></script>
{% render 'theme-type' %}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign fonts = st.enable_custom_fonts
  assign scroll_anim = settings.scroll_animation | default: 'none'
  assign cards = section.blocks | where: 'type', 'testimonial'
  assign total = cards.size
  assign columns = st.columns | default: 3
  assign few = false
  if total < columns
    assign few = true
    assign columns = total | at_least: 1
  endif
  assign columns_tablet = columns | at_most: 2
  assign collapse = st.collapse | default: 'mobile'
  if total < 5
    assign collapse = 'none'
  endif
  assign part = st.collapsed_part | default: 40 | divided_by: 100.0
  assign more_label = st.more_label | default: 'Show more'
-%}
{%- comment -%}
  Materia Themes. Testimonial Wall.

  Eyebrow, heading and subheading blocks over a wall of quote cards of any
  length, laid out in CSS columns so short and long quotes fit together. One
  testimonial block is one card: an optional photo, stars (only when a
  rating is set), the customer's words, picture, name and a line under it.
  Fewer quotes than columns use as many columns as there are quotes.
  With five or more quotes the wall can show its first part with a Show more
  button that opens the rest (on phones only, or on every screen): the wall
  is one grid row sized as a fraction of its own height (the row clips
  what is under it), so nothing is measured and every card keeps its place
  when it opens. Button blocks sit
  under the wall as theme buttons. Colours follow the colour scheme and
  fonts follow Theme settings > Typography until custom styling or custom
  fonts are switched on. The Show more button and the builder's live edits
  are run by assets/live-r7-testimonials.js; without scripts the whole wall
  shows.
{%- endcomment -%}
{%- if scroll_anim != blank and scroll_anim != 'none' and st.reveal -%}
<style>
  #shopify-section-{{ sid }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ sid }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ scroll_anim | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
{% render 'r7-testimonial-base', sid: sid %}
<style>
  {%- if fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} .r7w__clip { display: grid; grid-template-rows: 1fr; overflow: hidden; transition: grid-template-rows .4s cubic-bezier(.3, 1, .3, 1); }
  #shopify-section-{{ sid }} .r7w[data-instant] .r7w__clip { transition: none; }
  #shopify-section-{{ sid }} .r7w__inner { min-height: 0; }
  #shopify-section-{{ sid }} .r7w__wall { column-count: 1; column-gap: var(--r7t-gap); margin-bottom: calc(var(--r7t-gap) * -1); }
  {%- comment -%} Fewer quotes than columns: as many columns as quotes, at a card's usual width, under the heading. {%- endcomment %}
  #shopify-section-{{ sid }} .r7w[data-few="true"] .r7w__wall { max-width: calc(var(--r7w-cols) * 440px + (var(--r7w-cols) - 1) * var(--r7t-gap)); }
  #shopify-section-{{ sid }} .r7w[data-few="true"][data-align="center"] .r7w__wall { margin-inline: auto; }
  {%- comment -%} The space under a card is padding on its item: a margin at the foot of a column is dropped by some browsers and kept by others, padding never is. {%- endcomment %}
  #shopify-section-{{ sid }} .r7w__item { padding-bottom: var(--r7t-gap); break-inside: avoid; -webkit-column-break-inside: avoid; page-break-inside: avoid; }
  #shopify-section-{{ sid }} .r7w__photo { align-self: stretch; aspect-ratio: var(--r7w-ar, auto); max-height: 440px; margin: -20px -20px 0; overflow: hidden; border-radius: max(0px, calc(var(--r7t-radius) - 1px)) max(0px, calc(var(--r7t-radius) - 1px)) 0 0; background: color-mix(in srgb, var(--r7t-text) 8%, transparent); }
  #shopify-section-{{ sid }} .r7w[data-card="plain"] .r7w__photo { margin: 0; border-radius: var(--r7t-radius); }
  #shopify-section-{{ sid }} .r7w__photo img { display: block; width: 100%; height: 100%; max-height: 440px; object-fit: cover; }
  #shopify-section-{{ sid }} .r7t__more { display: none; }
  #shopify-section-{{ sid }} .r7w[data-collapse="always"] .r7t__more { display: inline-flex; }
  #shopify-section-{{ sid }} .r7w[data-collapse="always"][data-open="false"] .r7w__clip { grid-template-rows: var(--r7w-part); -webkit-mask-image: linear-gradient(to top, transparent, #000 96px); mask-image: linear-gradient(to top, transparent, #000 96px); }
  #shopify-section-{{ sid }} .r7w[data-open="true"][data-less="false"] .r7t__more { display: none; }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .r7w[data-collapse="mobile"] .r7t__more { display: inline-flex; }
    #shopify-section-{{ sid }} .r7w[data-collapse="mobile"][data-open="false"] .r7w__clip { grid-template-rows: var(--r7w-part); -webkit-mask-image: linear-gradient(to top, transparent, #000 96px); mask-image: linear-gradient(to top, transparent, #000 96px); }
    #shopify-section-{{ sid }} .r7w[data-collapse="mobile"][data-open="true"][data-less="false"] .r7t__more { display: none; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .r7w__wall { column-count: var(--r7w-cols-t); }
    #shopify-section-{{ sid }} .r7w__photo { margin: -24px -24px 0; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .r7w__wall { column-count: var(--r7w-cols-l); }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .r7w__wall { column-count: var(--r7w-cols); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .r7w__clip { transition: none; }
  }
  {%- comment -%} Without scripts the button cannot open the wall, so the whole wall shows. {%- endcomment %}
  .no-js #shopify-section-{{ sid }} .r7w__clip { grid-template-rows: 1fr !important; transition: none !important; -webkit-mask-image: none !important; mask-image: none !important; }
  .no-js #shopify-section-{{ sid }} .r7t__more { display: none !important; }
{% comment %}{% endcomment %}</style>
<div class="r7t r7w color-{{ color_scheme }} gradient" data-r7t-root="testimonial-wall" data-section-id="{{ sid }}"{% if request.design_mode %} data-r7t-settings="{{ st | json | escape }}"{% endif %} data-card="{{ st.card_style | default: 'filled' }}" data-align="{{ st.text_align | default: 'center' }}" data-collapse="{{ collapse }}" data-few="{% if few %}true{% else %}false{% endif %}" data-open="false" data-less="{% if st.less_label != blank %}true{% else %}false{% endif %}" data-reset="{% if st.reset_spacing %}true{% else %}false{% endif %}"{% if fonts %} data-own-font{% endif %} style="{% render 'r7-testimonial-vars', st: st %}--r7w-cols: {{ columns }};--r7w-cols-l: {{ columns | at_most: 3 }};--r7w-cols-t: {{ columns_tablet }};--r7w-part: {{ part }}fr;">
  <div class="r7t__frame" data-width="{{ st.section_width | default: 'container' }}">
    {% render 'r7-testimonial-head', section: section %}

    {%- if total > 0 -%}
      <div class="r7w__clip" id="r7w-wall-{{ sid }}" data-r7t-clip>
        <div class="r7w__inner">
          <div class="r7w__wall" data-r7t-wall>
            {%- for b in cards -%}
              {%- assign bs = b.settings -%}
              <div class="r7w__item">
              <div class="r7t-card r7w__card" data-r7t-block="{{ b.id }}" data-r7t-type="testimonial"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %} {{ b.shopify_attributes }}>
                <div class="r7w__photo" data-r7t-photo{% if bs.image == blank %} hidden{% endif %}{% if bs.image.aspect_ratio != blank %} style="--r7w-ar: {{ bs.image.aspect_ratio }};"{% endif %}>
                  {%- if bs.image != blank -%}
                    {%- assign photo_alt = bs.image_alt | default: bs.image.alt -%}
                    {{ bs.image | image_url: width: 900 | image_tag: loading: 'lazy', decoding: 'async', widths: '360,540,720,900', sizes: '(min-width: 1200px) 400px, (min-width: 768px) 50vw, 100vw', alt: photo_alt }}
                  {%- endif -%}
                </div>
                {% render 'r7-testimonial-quote', bs: bs %}
              </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="r7t__actions">
      {%- if total > 0 -%}
        <button type="button" class="r7t__more" data-theme-button="secondary" data-sl-button data-r7t-more data-more="{{ more_label | escape }}"{% if st.less_label != blank %} data-less="{{ st.less_label | escape }}"{% endif %} aria-expanded="false" aria-controls="r7w-wall-{{ sid }}">{{ more_label | escape }}</button>
      {%- endif -%}
      {%- for b in section.blocks -%}
        {%- if b.type != 'button' -%}{%- continue -%}{%- endif -%}
        {%- assign bs = b.settings -%}
        {% render 'r7-testimonial-button', b: b, bs: bs %}
      {%- endfor -%}
    </div>
  </div>
</div>
</template>

<schema>
{
  "type": "testimonial-wall",
  "name": "Testimonial Wall",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Show more button label",
      "default": "Show more",
      "visible_if": "{{ section.settings.collapse != 'none' }}"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Show less button label",
      "default": "Show less",
      "info": "Empty: the button goes away once the wall is open.",
      "visible_if": "{{ section.settings.collapse != 'none' }}"
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3,
      "info": "Tablets show two columns and phones one."
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "filled",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "plain",
          "label": "Line"
        }
      ]
    },
    {
      "type": "select",
      "id": "collapse",
      "label": "Show more button",
      "default": "mobile",
      "options": [
        {
          "value": "none",
          "label": "Off"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ],
      "info": "Shows the first part of the wall and a button that opens the rest. Needs five quotes or more."
    },
    {
      "type": "range",
      "id": "collapsed_part",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Wall shown before the button",
      "default": 40,
      "visible_if": "{{ section.settings.collapse != 'none' }}"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false,
      "info": "Off: colours follow the colour scheme and corners follow Theme settings."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style == 'filled' }}"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style != 'filled' }}"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Filled star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star",
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_style }}"
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false,
      "info": "Off: fonts follow Theme settings > Typography."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading and name font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Quote size (desktop)",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Uses Theme settings > Animations."
    },
    {
      "type": "header",
      "id": "hdr_33",
      "label": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Top margin (desktop)",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin (desktop)",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "header",
      "id": "hdr_38",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "quote_size_mobile",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Quote size (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Top margin (mobile)",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin (mobile)",
      "default": 0,
      "visible_if": "{{ section.settings.reset_spacing == false }}"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "Customer wall"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "In our customers' words"
        },
        {
          "type": "range",
          "id": "size",
          "min": 20,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Font size (desktop)",
          "default": 40
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 16,
          "max": 48,
          "step": 1,
          "unit": "px",
          "label": "Font size (mobile)",
          "default": 26
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading",
          "default": "<p>Quotes from people who bought from your store, one block for each.</p>"
        },
        {
          "type": "range",
          "id": "size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 16
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 1
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "body",
          "label": "Quote",
          "default": "Paste a customer's words here."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Line under the name",
          "default": "",
          "info": "For example the city, or what they bought."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "label": "Star rating",
          "default": 0,
          "info": "0 shows no stars. Use the rating your customer gave."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer picture"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo above the quote",
          "info": "Optional. A photo the customer sent, shown in its own proportions."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo description",
          "info": "Read out by screen readers. Empty uses the photo's own description.",
          "visible_if": "{{ block.settings.image != blank }}"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Read more reviews"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false,
          "info": "Off: the button follows Theme settings > Buttons."
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "bg_hover",
          "label": "Background (hover)",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        },
        {
          "type": "color",
          "id": "text_hover",
          "label": "Text (hover)",
          "visible_if": "{{ block.settings.enable_custom_style }}"
        }
      ],
      "limit": 2
    }
  ],
  "presets": [
    {
      "name": "Testimonial Wall",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "subheading"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial",
          "settings": {
            "body": "A longer quote sits well in the wall. Paste two or three sentences from an email or a product review here, and keep the customer's own wording."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "body": "Short quotes fit beside long ones."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "body": "Add the customer's name under each quote, and a picture if they sent one."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "body": "Set a star rating only when the customer gave one. Left at 0, no stars show."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "body": "Add as many quotes as you like. On a phone the wall shows its first part, and a button opens the rest."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "shopify": {
    "name": "Testimonial Wall",
    "tag": "section",
    "class": "section-testimonial-wall",
    "disabled_on": {
      "groups": [
        "header",
        "footer"
      ]
    },
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "default-color-scheme"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Default"
          },
          {
            "value": "fluid_container",
            "label": "Fluid container"
          },
          {
            "value": "stretch_width",
            "label": "Stretched"
          },
          {
            "value": "full_width",
            "label": "Full width"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "text_align",
        "label": "Heading alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "text",
        "id": "more_label",
        "label": "Show more button label",
        "default": "Show more",
        "visible_if": "{{ section.settings.collapse != 'none' }}"
      },
      {
        "type": "text",
        "id": "less_label",
        "label": "Show less button label",
        "default": "Show less",
        "info": "Empty: the button goes away once the wall is open.",
        "visible_if": "{{ section.settings.collapse != 'none' }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "columns",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Columns (desktop)",
        "default": 3,
        "info": "Tablets show two columns and phones one."
      },
      {
        "type": "range",
        "id": "card_gap",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Gap between cards",
        "default": 20
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Card style",
        "default": "filled",
        "options": [
          {
            "value": "filled",
            "label": "Filled"
          },
          {
            "value": "outline",
            "label": "Outline"
          },
          {
            "value": "plain",
            "label": "Line"
          }
        ]
      },
      {
        "type": "select",
        "id": "collapse",
        "label": "Show more button",
        "default": "mobile",
        "options": [
          {
            "value": "none",
            "label": "Off"
          },
          {
            "value": "mobile",
            "label": "Mobile"
          },
          {
            "value": "always",
            "label": "Always"
          }
        ],
        "info": "Shows the first part of the wall and a button that opens the rest. Needs five quotes or more."
      },
      {
        "type": "range",
        "id": "collapsed_part",
        "min": 20,
        "max": 80,
        "step": 5,
        "unit": "%",
        "label": "Wall shown before the button",
        "default": 40,
        "visible_if": "{{ section.settings.collapse != 'none' }}"
      },
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false,
        "info": "Off: colours follow the colour scheme and corners follow Theme settings."
      },
      {
        "type": "color",
        "id": "section_bg",
        "label": "Section background",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style == 'filled' }}"
      },
      {
        "type": "color",
        "id": "card_border_color",
        "label": "Card border",
        "visible_if": "{{ section.settings.enable_custom_style and section.settings.card_style != 'filled' }}"
      },
      {
        "type": "color",
        "id": "quote_color",
        "label": "Quote",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "name_color",
        "label": "Name",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Filled star",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_empty_color",
        "label": "Empty star",
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Card corner radius",
        "default": 12,
        "visible_if": "{{ section.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_fonts",
        "label": "Enable custom fonts",
        "default": false,
        "info": "Off: fonts follow Theme settings > Typography."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading and name font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4",
        "visible_if": "{{ section.settings.enable_custom_fonts }}"
      },
      {
        "type": "range",
        "id": "quote_size",
        "min": 13,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Quote size (desktop)",
        "default": 16
      },
      {
        "type": "header",
        "content": "Animation"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "default": true,
        "info": "Uses Theme settings > Animations."
      },
      {
        "type": "header",
        "content": "Desktop spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Top padding",
        "default": 60
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding",
        "default": 60
      },
      {
        "type": "range",
        "id": "section_margin_top_desktop",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Top margin (desktop)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_desktop",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Bottom margin (desktop)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "quote_size_mobile",
        "min": 13,
        "max": 22,
        "step": 1,
        "unit": "px",
        "label": "Quote size (mobile)",
        "default": 15
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Top padding (mobile)",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "Bottom padding (mobile)",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_margin_top_mobile",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Top margin (mobile)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      },
      {
        "type": "range",
        "id": "section_margin_bottom_mobile",
        "min": 0,
        "max": 300,
        "step": 4,
        "unit": "px",
        "label": "Bottom margin (mobile)",
        "default": 0,
        "visible_if": "{{ section.settings.reset_spacing == false }}"
      }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Eyebrow text",
            "default": "Customer wall"
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Heading",
            "default": "In our customers' words"
          },
          {
            "type": "range",
            "id": "size",
            "min": 20,
            "max": 72,
            "step": 1,
            "unit": "px",
            "label": "Font size (desktop)",
            "default": 40
          },
          {
            "type": "range",
            "id": "size_mobile",
            "min": 16,
            "max": 48,
            "step": 1,
            "unit": "px",
            "label": "Font size (mobile)",
            "default": 26
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "subheading",
        "name": "Subheading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Subheading",
            "default": "<p>Quotes from people who bought from your store, one block for each.</p>"
          },
          {
            "type": "range",
            "id": "size",
            "min": 12,
            "max": 24,
            "step": 1,
            "unit": "px",
            "label": "Font size",
            "default": 16
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false
          },
          {
            "type": "color",
            "id": "color",
            "label": "Color",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      },
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "textarea",
            "id": "body",
            "label": "Quote",
            "default": "Paste a customer's words here."
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Customer name"
          },
          {
            "type": "text",
            "id": "role",
            "label": "Line under the name",
            "default": "",
            "info": "For example the city, or what they bought."
          },
          {
            "type": "range",
            "id": "rating",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "label": "Star rating",
            "default": 0,
            "info": "0 shows no stars. Use the rating your customer gave."
          },
          {
            "type": "image_picker",
            "id": "avatar",
            "label": "Customer picture"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Photo above the quote",
            "info": "Optional. A photo the customer sent, shown in its own proportions."
          },
          {
            "type": "text",
            "id": "image_alt",
            "label": "Photo description",
            "info": "Read out by screen readers. Empty uses the photo's own description.",
            "visible_if": "{{ block.settings.image != blank }}"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 2,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Read more reviews"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "default": "primary",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              }
            ]
          },
          {
            "type": "checkbox",
            "id": "enable_custom_style",
            "label": "Enable custom styling",
            "default": false,
            "info": "Off: the button follows Theme settings > Buttons."
          },
          {
            "type": "color",
            "id": "bg",
            "label": "Background",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "bg_hover",
            "label": "Background (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          },
          {
            "type": "color",
            "id": "text_hover",
            "label": "Text (hover)",
            "visible_if": "{{ block.settings.enable_custom_style }}"
          }
        ]
      }
    ],
