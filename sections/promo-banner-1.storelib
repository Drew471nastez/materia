<template compat="shopify">
{%- assign fb_accessibility_promo_banner_image = 'accessibility.promo_banner_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Promo Banner 1 (block-based — split deal banner)
  Horizontal split layout: image on one side, text panel on the other.
  Content uses blocks (eyebrow / heading / highlight / buttons) so merchants
  can reorder, hide, or duplicate any element.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign layout = st.layout | default: 'image_left'
  assign panel_style = st.panel_style | default: 'solid'
  assign image_fit = st.image_fit | default: 'fit'

  assign content_align = st.content_alignment | default: 'center'
  assign text_align = st.text_align | default: 'center'

  assign placeholder = 'https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg'
-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer wrapper */
  #shopify-section-{{ sid }} .pb1 {
    background-color: {{ st.section_bg | default: '#FFFFFF' }} !important;
    padding-top: {{ st.section_padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ st.section_padding_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1 {
      padding-top: {{ st.section_padding_top_desktop | default: 0 }}px;
      padding-bottom: {{ st.section_padding_bottom_desktop | default: 0 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb1__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb1__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .pb1__inner { padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .pb1__inner { padding-inline: 3rem; } }
    {%- else -%}
      #shopify-section-{{ sid }} .pb1__inner { padding-inline: 0; }
  {%- endcase -%}

  /* Split card */
  #shopify-section-{{ sid }} .pb1__split {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: {{ st.card_radius | default: 0 }}px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__split {
      grid-template-columns: {{ st.image_ratio | default: 60 }}% 1fr;
      {% if image_fit == 'fit' %}
        /* Fit: banner has a strict fixed height — image is cropped to fit, banner never grows */
        height: {{ st.min_height_desktop | default: 440 }}px;
      {% elsif image_fit == 'cover' %}
        /* Cover: banner has minimum height — can grow with content */
        min-height: {{ st.min_height_desktop | default: 380 }}px;
      {% endif %}
    }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse {
      grid-template-columns: 1fr {{ st.image_ratio | default: 60 }}%;
    }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse .pb1__media { order: 2; }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse .pb1__panel { order: 1; }
  }

  /* Image side */
  #shopify-section-{{ sid }} .pb1__media {
    position: relative;
    overflow: hidden;
    background-color: {{ st.image_bg | default: '#EDEDED' }};
    {% if image_fit == 'fit' or image_fit == 'cover' %}
      aspect-ratio: 16 / 11;
    {% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__media {
      {% if image_fit == 'fit' %}
        aspect-ratio: auto;
        height: 100%;
      {% elsif image_fit == 'cover' %}
        aspect-ratio: auto;
        min-height: {{ st.min_height_desktop | default: 380 }}px;
      {% endif %}
    }
  }
  #shopify-section-{{ sid }} .pb1__media img {
    display: block;
    width: 100%;
    {% if image_fit == 'fit' or image_fit == 'cover' %}
      height: 100%;
      object-fit: cover;
      object-position: {{ st.image_position_x | default: 50 }}% {{ st.image_position_y | default: 50 }}%;
    {% else %}
      /* Adapt: preserve image's natural aspect ratio (no cropping) */
      height: auto;
      object-fit: contain;
    {% endif %}
  }

  /* Panel (content) side */
  #shopify-section-{{ sid }} .pb1__panel {
    {%- if panel_style == 'gradient' -%}
      background: linear-gradient(
        {{ st.gradient_angle | default: 135 }}deg,
        {{ st.gradient_start | default: '#7C3AED' }} 0%,
        {%- if st.enable_gradient_middle -%}
          {{ st.gradient_middle | default: '#FFFFFF' }} 50%,
        {%- endif -%}
        {{ st.gradient_end | default: '#EC4899' }} 100%
      ) !important;
    {%- else -%}
      background-color: {{ st.panel_bg | default: '#0F0F0F' }} !important;
    {%- endif -%}
    padding: {{ st.panel_padding_mobile | default: 32 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if text_align == 'left' -%} flex-start
      {%- elsif text_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    justify-content:
      {%- if content_align == 'top' -%} flex-start
      {%- elsif content_align == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    text-align: {{ text_align }};
    gap: {{ st.content_gap | default: 14 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__panel {
      padding: {{ st.panel_padding_desktop | default: 48 }}px;
    }
  }

  /* Block — Eyebrow */
  #shopify-section-{{ sid }} .pb1__eyebrow {
    margin: 0;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.3;
    opacity: .85;
  }

  /* Block — Heading */
  #shopify-section-{{ sid }} .pb1__heading {
    margin: 0;
    line-height: 1.1;
  }

  /* Block — Highlight */
  #shopify-section-{{ sid }} .pb1__highlight {
    margin: 0;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: .3px;
  }

  /* Block — Buttons (equal-height stretch) */
  #shopify-section-{{ sid }} .pb1__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    justify-content:
      {%- if text_align == 'left' -%} flex-start
      {%- elsif text_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
  }
  #shopify-section-{{ sid }} .pb1__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform .15s ease, background-color .2s ease, color .2s ease;
    border: 0;
    cursor: pointer;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .4px;
  }
  #shopify-section-{{ sid }} .pb1__btn:hover {
    transform: translateY(-1px);
  }

  /* Mobile: image-first by default */
  @media (max-width: 767px) {
    {%- if st.mobile_image_first == false -%}
      #shopify-section-{{ sid }} .pb1__media { order: 2; }
      #shopify-section-{{ sid }} .pb1__panel { order: 1; }
    {%- endif -%}
  }
{% comment %}{% endcomment %}</style>

<section class="pb1-wrap">
  <div class="pb1">
    <div class="pb1__inner">
      <div class="pb1__split pb1--{{ layout }}">
        <div class="pb1__media">
          {%- if st.image -%}
            <img
              src="{{ st.image | image_url: width: 1400 }}"
              srcset="{{ st.image | image_url: width: 600 }} 600w,
                      {{ st.image | image_url: width: 900 }} 900w,
                      {{ st.image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 768px) 60vw, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_promo_banner_image | escape }}"
              loading="lazy"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            <img
              src="{{ placeholder }}"
              alt="{{ 'accessibility.promo_banner_placeholder' | t }}"
              loading="lazy"
              width="1200"
              height="900"
            >
          {%- endif -%}
        </div>

        <div class="pb1__panel">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb1__eyebrow"
                     style="
                       font-size: {{ block.settings.size_mobile | default: 13 }}px;
                       color: {{ block.settings.color }} !important;
                     "
                     {{ block.shopify_attributes }}>
                    <span class="pb1__eyebrow-d" style="font-size: {{ block.settings.size_desktop | default: 13 }}px;">{{ block.settings.text | escape }}</span>
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  <{{ block.settings.tag | default: 'h2' }} class="pb1__heading"
                     style="
                       font-size: {{ block.settings.size_mobile | default: 32 }}px;
                       color: {{ block.settings.color }} !important;
                       font-weight: {{ block.settings.weight | default: 700 }};
                     "
                     {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </{{ block.settings.tag | default: 'h2' }}>
                  <style>
                    @media (min-width: 768px) {
                      #block-{{ block.id }}.pb1__heading,
                      #shopify-section-{{ sid }} [data-shopify-editor-block="{{ block.id }}"] .pb1__heading {
                        font-size: {{ block.settings.size_desktop | default: 48 }}px !important;
                      }
                    }
{% comment %}{% endcomment %}                  </style>
                {%- endif -%}

              {%- when 'highlight' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb1__highlight"
                     style="
                       font-size: {{ block.settings.size_mobile | default: 18 }}px;
                       color: {{ block.settings.color }} !important;
                     "
                     {{ block.shopify_attributes }}>
                    <span style="font-size: {{ block.settings.size_desktop | default: 22 }}px;">{{ block.settings.text | escape }}</span>
                  </p>
                {%- endif -%}

              {%- when 'buttons' -%}
                {%- assign primary_label = block.settings.primary_label -%}
                {%- assign secondary_label = block.settings.secondary_label -%}
                {%- if primary_label != blank or secondary_label != blank -%}
                  <div class="pb1__buttons" {{ block.shopify_attributes }}
                       style="margin-top: {{ block.settings.gap_top | default: 6 }}px;">
                    {%- if primary_label != blank -%}
                      <a class="pb1__btn pb1__btn--primary"
                         href="{{ block.settings.primary_link | default: '#' }}"
                         style="
                           background-color: {{ block.settings.primary_bg | default: '#FFFFFF' }} !important;
                           color: {{ block.settings.primary_text | default: '#0F0F0F' }} !important;
                           border: {{ block.settings.primary_border_width | default: 0 }}px solid {{ block.settings.primary_border_color | default: '#FFFFFF' }};
                           padding: {{ block.settings.btn_pad_y | default: 13 }}px {{ block.settings.btn_pad_x | default: 28 }}px;
                           border-radius: {{ block.settings.btn_radius | default: 6 }}px;
                           font-size: {{ block.settings.btn_size | default: 14 }}px;
                         ">
                        {{ primary_label | escape }}
                      </a>
                    {%- endif -%}
                    {%- if secondary_label != blank -%}
                      <a class="pb1__btn pb1__btn--secondary"
                         href="{{ block.settings.secondary_link | default: '#' }}"
                         style="
                           background-color: {{ block.settings.secondary_bg | default: 'rgba(0,0,0,0)' }} !important;
                           color: {{ block.settings.secondary_text | default: '#FFFFFF' }} !important;
                           border: {{ block.settings.secondary_border_width | default: 1 }}px solid {{ block.settings.secondary_border_color | default: '#FFFFFF' }};
                           padding: {{ block.settings.btn_pad_y | default: 13 }}px {{ block.settings.btn_pad_x | default: 28 }}px;
                           border-radius: {{ block.settings.btn_radius | default: 6 }}px;
                           font-size: {{ block.settings.btn_size | default: 14 }}px;
                         ">
                        {{ secondary_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "promo-banner-1",
  "name": "Promo Banner 1",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, text right"
        },
        {
          "value": "reverse",
          "label": "Image right, text left"
        }
      ]
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "Text panel background",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Falls back to a default placeholder if blank."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "fit",
      "info": "Fit: banner stays at its set height — image is cropped to fit (recommended). Cover: banner can grow if image is taller. Adapt: banner takes the image's natural height (no cropping).",
      "options": [
        {
          "value": "fit",
          "label": "Fit (banner stays at fixed height)"
        },
        {
          "value": "cover",
          "label": "Cover (banner grows with image)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image height"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Only applies when image fit is 'Cover'."
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Only applies when image fit is 'Cover'."
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image area placeholder color",
      "default": "#EDEDED"
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel — solid background",
      "default": "#0F0F0F"
    },
    {
      "type": "header",
      "id": "hdr_15",
      "label": "Gradient (when panel style = Gradient)"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient — start",
      "default": "#7C3AED"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_middle",
      "label": "Add a middle color stop",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "Gradient — middle",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient — end",
      "default": "#EC4899"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 135
    },
    {
      "type": "header",
      "id": "hdr_21",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 380,
      "info": "Only applies when image fit is 'Cover'."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel padding (desktop)",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Vertical gap between blocks",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Section bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_35",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image above text on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel padding (mobile)",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Section top padding (mobile)",
