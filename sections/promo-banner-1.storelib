<template compat="shopify">
{%- comment -%}Removed at the creator's request. StoreLib retains Git-deleted definitions; this retired definition stays empty and out of Add section.{%- endcomment -%}
</template>

<schema>
{
  "type": "promo-banner-1",
  "name": "Promo Banner 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, text right"
        },
        {
          "value": "reverse",
          "label": "Image right, text left"
        }
      ]
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "Text panel background",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "fit",
      "options": [
        {
          "value": "fit",
          "label": "Fit (banner stays at fixed height)"
        },
        {
          "value": "cover",
          "label": "Cover (banner grows with image)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image height"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Placeholder background"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "visible_if": "{{ section.settings.panel_style == 'solid' }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Gradient"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_middle",
      "label": "Middle color stop",
      "default": false,
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "Gradient middle",
      "visible_if": "{{ section.settings.panel_style == 'gradient' and section.settings.enable_gradient_middle }}"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 135,
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 380,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel padding (desktop)",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Block gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Section bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom margin (desktop px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_37",
      "label": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Show image above text on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel padding (mobile)",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Section top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Section bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom margin (mobile px)",
      "min": -200,
      "max": 200,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow / tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Brand deal of the month"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 9,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 12
        }
      ],
      "limit": 2
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "New season styles"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "default": "h2",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 18,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 32
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "default": "theme",
          "options": [
            {
              "value": "theme",
              "label": "Theme"
            },
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "600",
              "label": "Semi-bold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extra-bold"
            }
          ]
        }
      ],
      "limit": 2
    },
    {
      "type": "highlight",
      "name": "Highlight text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Up to 50% off"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Size (desktop)",
          "min": 12,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 22
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Size (mobile)",
          "min": 11,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 18
        }
      ],
      "limit": 2
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Primary button"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary link"
        },
        {
          "type": "color",
          "id": "primary_bg",
          "label": "Primary background"
        },
        {
          "type": "color",
          "id": "primary_text",
          "label": "Primary text"
        },
        {
          "type": "color",
          "id": "primary_border_color",
          "label": "Primary border color"
        },
        {
          "type": "range",
          "id": "primary_border_width",
          "label": "Primary border width",
          "min": 0,
          "max": 6,
          "step": 1,
          "unit": "px",
          "default": 0,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "header",
          "id": "hdr_8",
          "label": "Secondary button"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary label"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary link"
        },
        {
          "type": "color",
          "id": "secondary_bg",
          "label": "Secondary background"
        },
        {
          "type": "color",
          "id": "secondary_text",
          "label": "Secondary text"
        },
        {
          "type": "color",
          "id": "secondary_border_color",
          "label": "Secondary border color"
        },
        {
          "type": "range",
          "id": "secondary_border_width",
          "label": "Secondary border width",
          "min": 0,
          "max": 6,
          "step": 1,
          "unit": "px",
          "default": 1,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "header",
          "id": "hdr_15",
          "label": "Shared"
        },
        {
          "type": "checkbox",
          "id": "use_theme_button",
          "label": "Use theme button style",
          "default": true
        },
        {
          "type": "range",
          "id": "btn_size",
          "label": "Text size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "btn_pad_x",
          "label": "Horizontal padding",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 28,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "btn_pad_y",
          "label": "Vertical padding",
          "min": 6,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 13,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "btn_radius",
          "label": "Corner radius",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 6,
          "visible_if": "{{ block.settings.use_theme_button == false }}"
        },
        {
          "type": "range",
          "id": "gap_top",
          "label": "Gap above buttons",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 6
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
