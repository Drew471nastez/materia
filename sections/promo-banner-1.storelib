<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- assign fb_accessibility_promo_banner_image = 'accessibility.promo_banner_image' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' and section.settings.reveal != false -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes — Promo Banner 1 (block-based — split deal banner)
  Horizontal split layout: image on one side, text panel on the other.
  Content uses blocks (eyebrow / heading / highlight / buttons) so merchants
  can reorder, hide, or duplicate any element.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign sid = section.id

  assign layout = st.layout | default: 'image_left'
  assign panel_style = st.panel_style | default: 'solid'
  assign image_fit = st.image_fit | default: 'fit'

  assign content_align = st.content_alignment | default: 'center'
  assign text_align = st.text_align | default: 'center'

-%}

<style>
  /* Section isolation */
  #shopify-section-{{ sid }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ sid }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  :where(#shopify-section-{{ sid }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *:before,
  #shopify-section-{{ sid }} *:after {
    box-sizing: border-box;
  }

  /* Section margins */
  #shopify-section-{{ sid }} {
    margin-top: {{ st.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} {
      margin-top: {{ st.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}

  /* Outer wrapper */
  #shopify-section-{{ sid }} .pb1 {
    background-color: {% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %} !important;
    padding-top: {{ st.section_padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ st.section_padding_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1 {
      padding-top: {{ st.section_padding_top_desktop | default: 0 }}px;
      padding-bottom: {{ st.section_padding_bottom_desktop | default: 0 }}px;
    }
  }

  /* Section width */
  {%- case st.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ sid }} .pb1__inner { max-width: calc(var(--page-width, 1300px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ sid }} .pb1__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); margin-inline: auto; padding-inline: 1.5rem; }
    {%- when 'stretch_width' -%}
      #shopify-section-{{ sid }} .pb1__inner { padding-inline: 1.5rem; }
      @media (min-width: 1200px) { #shopify-section-{{ sid }} .pb1__inner { padding-inline: 3rem; } }
    {%- else -%}
      #shopify-section-{{ sid }} .pb1__inner { padding-inline: 0; }
  {%- endcase -%}

  /* Split card */
  #shopify-section-{{ sid }} .pb1__split {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: {{ st.card_radius | default: 0 }}px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__split {
      grid-template-columns: {{ st.image_ratio | default: 60 }}% 1fr;
      {% if image_fit == 'fit' %}
        /* Fit: banner has a strict fixed height — image is cropped to fit, banner never grows */
        height: {{ st.min_height_desktop | default: 440 }}px;
      {% elsif image_fit == 'cover' %}
        /* Cover: banner has minimum height — can grow with content */
        min-height: {{ st.min_height_desktop | default: 380 }}px;
      {% endif %}
    }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse {
      grid-template-columns: 1fr {{ st.image_ratio | default: 60 }}%;
    }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse .pb1__media { order: 2; }
    #shopify-section-{{ sid }} .pb1__split.pb1--reverse .pb1__panel { order: 1; }
  }

  /* Image side */
  #shopify-section-{{ sid }} .pb1__media {
    position: relative;
    overflow: hidden;
    background-color: {% render 'scheme-color', color: st.image_bg, fallback: 'rgba(var(--color-heading-rgb), 0.06)' %};
    {% if image_fit == 'fit' or image_fit == 'cover' %}
      aspect-ratio: 16 / 11;
    {% endif %}
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__media {
      {% if image_fit == 'fit' %}
        aspect-ratio: auto;
        height: 100%;
      {% elsif image_fit == 'cover' %}
        aspect-ratio: auto;
        min-height: {{ st.min_height_desktop | default: 380 }}px;
      {% endif %}
    }
  }
  #shopify-section-{{ sid }} .pb1__media svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
    fill: currentColor;
    opacity: .35;
  }
  #shopify-section-{{ sid }} .pb1__media img {
    display: block;
    width: 100%;
    {% if image_fit == 'fit' or image_fit == 'cover' %}
      height: 100%;
      object-fit: cover;
      object-position: {{ st.image_position_x | default: 50 }}% {{ st.image_position_y | default: 50 }}%;
    {% else %}
      /* Adapt: preserve image's natural aspect ratio (no cropping) */
      height: auto;
      object-fit: contain;
    {% endif %}
  }

  /* Panel (content) side */
  #shopify-section-{{ sid }} .pb1__panel {
    {%- if panel_style == 'gradient' -%}
      background: linear-gradient(
        {{ st.gradient_angle | default: 135 }}deg,
        {% render 'scheme-color', color: st.gradient_start, fallback: 'var(--color-primary)' %} 0%,
        {%- if st.enable_gradient_middle -%}
          {% render 'scheme-color', color: st.gradient_middle, fallback: 'var(--color-background)' %} 50%,
        {%- endif -%}
        {% render 'scheme-color', color: st.gradient_end, fallback: 'var(--color-heading)' %} 100%
      ) !important;
    {%- else -%}
      background-color: {% render 'scheme-color', color: st.panel_bg, fallback: 'var(--color-background)' %} !important;
    {%- endif -%}
    padding: {{ st.panel_padding_mobile | default: 32 }}px;
    display: flex;
    flex-direction: column;
    align-items:
      {%- if text_align == 'left' -%} flex-start
      {%- elsif text_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    justify-content:
      {%- if content_align == 'top' -%} flex-start
      {%- elsif content_align == 'bottom' -%} flex-end
      {%- else -%} center
      {%- endif -%};
    text-align: {{ text_align }};
    gap: {{ st.content_gap | default: 14 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__panel {
      padding: {{ st.panel_padding_desktop | default: 48 }}px;
    }
  }

  /* Block — Eyebrow */
  #shopify-section-{{ sid }} .pb1__eyebrow,
  #shopify-section-{{ sid }} .pb1__heading,
  #shopify-section-{{ sid }} .pb1__highlight { font-size: var(--fs-m); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pb1__eyebrow,
    #shopify-section-{{ sid }} .pb1__heading,
    #shopify-section-{{ sid }} .pb1__highlight { font-size: var(--fs-d); }
  }
  #shopify-section-{{ sid }} .pb1__eyebrow {
    margin: 0;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.3;
    opacity: .85;
  }

  /* Block — Heading */
  #shopify-section-{{ sid }} .pb1__heading {
    margin: 0;
    line-height: 1.1;
  }

  /* Block — Highlight */
  #shopify-section-{{ sid }} .pb1__highlight {
    margin: 0;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: .3px;
  }

  /* Block — Buttons (equal-height stretch) */
  #shopify-section-{{ sid }} .pb1__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
    justify-content:
      {%- if text_align == 'left' -%} flex-start
      {%- elsif text_align == 'right' -%} flex-end
      {%- else -%} center
      {%- endif -%};
  }
  #shopify-section-{{ sid }} .pb1__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
  }
  /* The buttons are theme buttons (theme-button-contract.css): paint, shape,
     type, padding, hover effect and timing come from Theme settings > Buttons.
     A colour set on the block, or the shape when the theme style is off,
     is passed as a token by the button-overrides snippet. */

  /* Mobile: image-first by default */
  @media (max-width: 767px) {
    {%- if st.mobile_image_first == false -%}
      #shopify-section-{{ sid }} .pb1__media { order: 2; }
      #shopify-section-{{ sid }} .pb1__panel { order: 1; }
    {%- endif -%}
  }
{% comment %}{% endcomment %}</style>

<section class="pb1-wrap">
  <div class="pb1 color-{{ color_scheme }} gradient">
    <div class="pb1__inner">
      <div class="pb1__split pb1--{{ layout }}">
        <div class="pb1__media">
          {%- if st.image -%}
            <img
              src="{{ st.image | image_url: width: 1400 }}"
              srcset="{{ st.image | image_url: width: 600 }} 600w,
                      {{ st.image | image_url: width: 900 }} 900w,
                      {{ st.image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 768px) 60vw, 100vw"
              alt="{{ st.image.alt | default: fb_accessibility_promo_banner_image | escape }}"
              decoding="async"
              width="{{ st.image.width }}"
              height="{{ st.image.height }}"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'pb1__placeholder' }}
          {%- endif -%}
        </div>

        <div class="pb1__panel">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb1__eyebrow"
                     style="
                       --fs-m: {{ block.settings.size_mobile | default: 13 }}px;
                       --fs-d: {{ block.settings.size_desktop | default: 13 }}px;
                       color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-text)' %} !important;
                     "
                     {{ block.shopify_attributes }}>
                    <span class="pb1__eyebrow-d">{{ block.settings.text | escape }}</span>
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.text != blank -%}
                  <{{ block.settings.tag | default: 'h2' }} class="pb1__heading"
                     style="
                       --fs-m: {{ block.settings.size_mobile | default: 32 }}px;
                       --fs-d: {{ block.settings.size_desktop | default: 48 }}px;
                       color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-heading)' %} !important;
                       font-weight: {% if block.settings.weight == blank or block.settings.weight == 'theme' %}var(--heading-weight, 700){% else %}{{ block.settings.weight }}{% endif %};
                     "
                     {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </{{ block.settings.tag | default: 'h2' }}>
                {%- endif -%}

              {%- when 'highlight' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pb1__highlight"
                     style="
                       --fs-m: {{ block.settings.size_mobile | default: 18 }}px;
                       --fs-d: {{ block.settings.size_desktop | default: 22 }}px;
                       color: {% render 'scheme-color', color: block.settings.color, fallback: 'var(--color-primary)' %} !important;
                     "
                     {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text | escape }}</span>
                  </p>
                {%- endif -%}

              {%- when 'buttons' -%}
                {%- assign primary_label = block.settings.primary_label -%}
                {%- assign secondary_label = block.settings.secondary_label -%}
                {%- liquid
                  assign pb_custom = false
                  if block.settings.use_theme_button == false
                    assign pb_custom = true
                  endif
                -%}
                {%- if primary_label != blank or secondary_label != blank -%}
                  <div class="pb1__buttons" {{ block.shopify_attributes }}
                       style="margin-top: {{ block.settings.gap_top | default: 6 }}px;">
                    {%- if primary_label != blank -%}
                      <a class="pb1__btn pb1__btn--primary" data-theme-button="primary" data-sl-button
                         href="{{ block.settings.primary_link | default: '#' }}"
                         style="{%- render 'button-overrides', bg: block.settings.primary_bg, text: block.settings.primary_text, border: block.settings.primary_border_color, custom: pb_custom, radius: block.settings.btn_radius, padding_y: block.settings.btn_pad_y, padding_x: block.settings.btn_pad_x, font_size: block.settings.btn_size, weight: 600, border_width: block.settings.primary_border_width -%}">
                        {{ primary_label | escape }}
                      </a>
                    {%- endif -%}
                    {%- if secondary_label != blank -%}
                      <a class="pb1__btn pb1__btn--secondary" data-theme-button="secondary" data-sl-button
                         href="{{ block.settings.secondary_link | default: '#' }}"
                         style="{%- render 'button-overrides', bg: block.settings.secondary_bg, text: block.settings.secondary_text, border: block.settings.secondary_border_color, custom: pb_custom, radius: block.settings.btn_radius, padding_y: block.settings.btn_pad_y, padding_x: block.settings.btn_pad_x, font_size: block.settings.btn_size, weight: 600, border_width: block.settings.secondary_border_width -%}">
                        {{ secondary_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>



</template>

<schema>
{
  "type": "promo-banner-1",
  "name": "Promo Banner 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_5",
      "label": "General"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_left",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, text right"
        },
        {
          "value": "reverse",
          "label": "Image right, text left"
        }
      ]
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "Text panel background",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Image / Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "fit",
      "options": [
        {
          "value": "fit",
          "label": "Fit (banner stays at fixed height)"
        },
        {
          "value": "cover",
          "label": "Cover (banner grows with image)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image height"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image horizontal focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image vertical focus",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Placeholder background"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Style & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "visible_if": "{{ section.settings.panel_style == 'solid' }}"
    },
    {
      "type": "header",
      "id": "hdr_17",
      "label": "Gradient"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_middle",
      "label": "Middle color stop",
      "default": false,
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "Gradient middle",
      "visible_if": "{{ section.settings.panel_style == 'gradient' and section.settings.enable_gradient_middle }}"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 135,
      "visible_if": "{{ section.settings.panel_style == 'gradient' }}"
    },
    {
      "type": "header",
      "id": "hdr_23",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_25",
      "label": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content vertical alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 380,
      "visible_if": "{{ section.settings.image_fit != 'adapt' }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel padding (desktop)",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Block gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Section top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Section bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
