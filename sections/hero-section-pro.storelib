  {%- assign badge_font_size = badge_block.settings.badge_font_size -%}
  {%- assign badge_text_color = badge_block.settings.badge_text_color -%}
  {%- assign badge_background_color = badge_block.settings.badge_background_color -%}
  {%- assign enable_badge_background_gradient = badge_block.settings.enable_badge_background_gradient -%}
  {%- assign badge_background_gradient_1 = badge_block.settings.badge_background_gradient_1 -%}
  {%- assign badge_background_gradient_2 = badge_block.settings.badge_background_gradient_2 -%}
  {%- assign badge_background_gradient_degrees = badge_block.settings.badge_background_gradient_degrees -%}
  {%- assign badge_vertical_gap = badge_block.settings.badge_vertical_gap -%}
  {%- assign badge_border_thickness = badge_block.settings.badge_border_thickness -%}
  {%- assign badge_border_color = badge_block.settings.badge_border_color -%}
  {%- assign enable_badge_svg_icon = badge_block.settings.enable_badge_svg_icon -%}
  {%- assign badge_svg_code = badge_block.settings.badge_svg_code -%}
  {%- assign badge_svg_icon_size_desktop = badge_block.settings.badge_svg_icon_size_desktop -%}
  {%- assign badge_svg_icon_size_mobile = badge_block.settings.badge_svg_icon_size_mobile -%}
  {%- assign badge_svg_icon_gap_desktop = badge_block.settings.badge_svg_icon_gap_desktop -%}
  {%- assign badge_svg_icon_gap_mobile = badge_block.settings.badge_svg_icon_gap_mobile -%}
  {%- assign badge_svg_icon_vertical_position_desktop = badge_block.settings.badge_svg_icon_vertical_position_desktop -%}
  {%- assign badge_svg_icon_vertical_position_mobile = badge_block.settings.badge_svg_icon_vertical_position_mobile -%}
{%- else -%}
  {%- assign enable_badge = false -%}
  {%- assign badge_text = '' -%}
  {%- assign badge_font_size = 14 -%}
  {%- assign badge_text_color = '#ffffff' -%}
  {%- assign badge_background_color = '#000000' -%}
  {%- assign enable_badge_background_gradient = false -%}
  {%- assign badge_background_gradient_1 = '#000000' -%}
  {%- assign badge_background_gradient_2 = '#333333' -%}
  {%- assign badge_background_gradient_degrees = '90deg' -%}
  {%- assign badge_vertical_gap = 10 -%}
  {%- assign badge_border_thickness = 0 -%}
  {%- assign badge_border_color = '#000000' -%}
  {%- assign enable_badge_svg_icon = false -%}
  {%- assign badge_svg_code = '' -%}
  {%- assign badge_svg_icon_size_desktop = 20 -%}
  {%- assign badge_svg_icon_size_mobile = 16 -%}
  {%- assign badge_svg_icon_gap_desktop = 6 -%}
  {%- assign badge_svg_icon_gap_mobile = 6 -%}
  {%- assign badge_svg_icon_vertical_position_desktop = 0 -%}
  {%- assign badge_svg_icon_vertical_position_mobile = 0 -%}
{%- endif -%}

{%- comment -%} Heading variables {%- endcomment -%}
{%- if heading_block -%}
  {%- assign title_text = heading_block.settings.title_text -%}
  {%- assign enable_special_word = heading_block.settings.enable_special_word -%}
  {%- assign special_word = heading_block.settings.special_word -%}
  {%- assign special_word_color = heading_block.settings.special_word_color -%}
  {%- assign title_text_color = heading_block.settings.title_text_color -%}
  {%- assign title_size_desktop = heading_block.settings.title_size_desktop -%}
  {%- assign title_size_mobile = heading_block.settings.title_size_mobile -%}
  {%- assign title_left_padding_desktop = heading_block.settings.title_left_padding_desktop -%}
  {%- assign title_right_padding_desktop = heading_block.settings.title_right_padding_desktop -%}
  {%- assign title_left_padding_mobile = heading_block.settings.title_left_padding_mobile -%}
  {%- assign title_right_padding_mobile = heading_block.settings.title_right_padding_mobile -%}
  {%- assign title_line_height_desktop = heading_block.settings.title_line_height_desktop -%}
  {%- assign title_line_height_mobile = heading_block.settings.title_line_height_mobile -%}
  {%- assign title_width_desktop = heading_block.settings.title_width_desktop -%}
  {%- assign title_font_weight = heading_block.settings.title_font_weight -%}
  {%- assign title_font_weight_input = heading_block.settings.title_font_weight_input -%}
  {%- assign enable_title_custom_font = heading_block.settings.enable_title_custom_font -%}
  {%- assign custom_title_font = heading_block.settings.custom_title_font -%}
  {%- assign enable_title_gradient = heading_block.settings.enable_title_gradient -%}
  {%- assign gradient_start_color = heading_block.settings.gradient_start_color -%}
  {%- assign gradient_middle_color = heading_block.settings.gradient_middle_color -%}
  {%- assign gradient_end_color = heading_block.settings.gradient_end_color -%}
  {%- assign gradient_degrees = heading_block.settings.gradient_degrees -%}
{%- else -%}
  {%- assign title_text = '' -%}
  {%- assign enable_special_word = false -%}
  {%- assign special_word = '' -%}
  {%- assign special_word_color = '#FF5A3D' -%}
  {%- assign title_text_color = '#FFFFFF' -%}
  {%- assign title_size_desktop = 120 -%}
  {%- assign title_size_mobile = 60 -%}
  {%- assign title_left_padding_desktop = 0 -%}
  {%- assign title_right_padding_desktop = 0 -%}
  {%- assign title_left_padding_mobile = 0 -%}
  {%- assign title_right_padding_mobile = 0 -%}
  {%- assign title_line_height_desktop = 0.9 -%}
  {%- assign title_line_height_mobile = 1.1 -%}
  {%- assign title_width_desktop = 74 -%}
  {%- assign title_font_weight = 'bold' -%}
  {%- assign title_font_weight_input = '700' -%}
  {%- assign enable_title_custom_font = false -%}
  {%- assign custom_title_font = 'Anton' -%}
  {%- assign enable_title_gradient = false -%}
  {%- assign gradient_start_color = '#ff0000' -%}
  {%- assign gradient_middle_color = '#00ff00' -%}
  {%- assign gradient_end_color = '#0000ff' -%}
  {%- assign gradient_degrees = '90deg' -%}
{%- endif -%}

{%- comment -%} Subheading variables {%- endcomment -%}
{%- if subheading_block -%}
  {%- assign subheading_text = subheading_block.settings.subheading_text -%}
  {%- assign subheading_text_color = subheading_block.settings.subheading_text_color -%}
  {%- assign subheading_text_size_desktop = subheading_block.settings.subheading_text_size_desktop -%}
