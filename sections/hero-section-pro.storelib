  {%- assign subheading_vertical_gap = subheading_block.settings.subheading_vertical_gap -%}
  {%- assign subheading_to_button_gap = subheading_block.settings.subheading_to_button_gap -%}
  {%- assign subheading_font_weight = subheading_block.settings.subheading_font_weight -%}
  {%- assign subheading_line_height_desktop = subheading_block.settings.subheading_line_height_desktop -%}
  {%- assign subheading_line_height_mobile = subheading_block.settings.subheading_line_height_mobile -%}
{%- else -%}
  {%- assign subheading_text = '' -%}
  {%- assign subheading_text_color = '#ffffff' -%}
  {%- assign subheading_text_size_desktop = 24 -%}
  {%- assign subheading_text_size_mobile = 18 -%}
  {%- assign subheading_left_padding_desktop = 0 -%}
  {%- assign subheading_right_padding_desktop = 0 -%}
  {%- assign subheading_left_padding_mobile = 0 -%}
  {%- assign subheading_right_padding_mobile = 0 -%}
  {%- assign subheading_vertical_gap = 20 -%}
  {%- assign subheading_to_button_gap = 20 -%}
  {%- assign subheading_font_weight = '400' -%}
  {%- assign subheading_line_height_desktop = '1.4' -%}
  {%- assign subheading_line_height_mobile = '1.3' -%}
{%- endif -%}

{%- comment -%} Image over text variables {%- endcomment -%}
{%- if image_over_text_block -%}
  {%- assign enable_image_over_text = image_over_text_block.settings.enable_image_over_text -%}
  {%- assign image_over_text = image_over_text_block.settings.image_over_text -%}
  {%- assign image_over_text_width_desktop = image_over_text_block.settings.image_over_text_width_desktop -%}
  {%- assign image_over_text_height_desktop = image_over_text_block.settings.image_over_text_height_desktop -%}
  {%- assign image_over_text_width_mobile = image_over_text_block.settings.image_over_text_width_mobile -%}
  {%- assign image_over_text_height_mobile = image_over_text_block.settings.image_over_text_height_mobile -%}
  {%- assign image_over_text_vertical_position_desktop = image_over_text_block.settings.image_over_text_vertical_position_desktop -%}
  {%- assign image_over_text_vertical_position_mobile = image_over_text_block.settings.image_over_text_vertical_position_mobile -%}
  {%- assign image_over_text_constant_animation = image_over_text_block.settings.image_over_text_constant_animation -%}
  {%- assign image_over_text_hover_animation = image_over_text_block.settings.image_over_text_hover_animation -%}
  {%- assign enable_image_over_text_horizontal_position = image_over_text_block.settings.enable_image_over_text_horizontal_position -%}
  {%- assign image_over_text_horizontal_position_desktop = image_over_text_block.settings.image_over_text_horizontal_position_desktop -%}
  {%- assign image_over_text_horizontal_position_mobile = image_over_text_block.settings.image_over_text_horizontal_position_mobile -%}
{%- else -%}
