<template compat="shopify">
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default-color-scheme'
-%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Block-driven settings. Blocks are the source of truth for visible
  elements. If a block isn't present, locals fall back to sensible
  defaults so the section renders without errors but with no content.
{%- endcomment -%}

{%- assign background_block = nil -%}
{%- assign top_text_block = nil -%}
{%- assign referral_block = nil -%}
{%- assign badge_block = nil -%}
{%- assign heading_block = nil -%}
{%- assign subheading_block = nil -%}
{%- assign image_over_text_block = nil -%}
{%- assign primary_button_block = nil -%}
{%- assign secondary_button_block = nil -%}
{%- assign text_under_button_block = nil -%}

{%- for b in section.blocks -%}
  {%- if b.type == 'background' and background_block == nil -%}
    {%- assign background_block = b -%}
  {%- endif -%}
  {%- if b.type == 'top_text' and top_text_block == nil -%}
    {%- assign top_text_block = b -%}
  {%- endif -%}
  {%- if b.type == 'referral_kicker' and referral_block == nil -%}
    {%- assign referral_block = b -%}
  {%- endif -%}
  {%- if b.type == 'badge' and badge_block == nil -%}
    {%- assign badge_block = b -%}
  {%- endif -%}
  {%- if b.type == 'heading' and heading_block == nil -%}
    {%- assign heading_block = b -%}
  {%- endif -%}
  {%- if b.type == 'subheading' and subheading_block == nil -%}
    {%- assign subheading_block = b -%}
  {%- endif -%}
  {%- if b.type == 'image_over_text' and image_over_text_block == nil -%}
    {%- assign image_over_text_block = b -%}
  {%- endif -%}
  {%- if b.type == 'primary_button' and primary_button_block == nil -%}
    {%- assign primary_button_block = b -%}
  {%- endif -%}
  {%- if b.type == 'secondary_button' and secondary_button_block == nil -%}
    {%- assign secondary_button_block = b -%}
  {%- endif -%}
  {%- if b.type == 'text_under_button' and text_under_button_block == nil -%}
    {%- assign text_under_button_block = b -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Background variables {%- endcomment -%}
{%- if background_block -%}
  {%- assign enable_parallax_mouse = background_block.settings.enable_parallax_mouse -%}
  {%- assign background_image = background_block.settings.background_image -%}
  {%- assign background_image_mobile = background_block.settings.background_image_mobile -%}
  {%- assign background_brightness = background_block.settings.background_brightness -%}
  {%- assign enable_split_images = background_block.settings.enable_split_images -%}
  {%- assign split_image_left = background_block.settings.split_image_left -%}
  {%- assign split_image_right = background_block.settings.split_image_right -%}
  {%- assign video_url = background_block.settings.video_url -%}
  {%- assign video_file = background_block.settings.video_file -%}
  {%- assign video_brightness = background_block.settings.video_brightness -%}
  {%- assign enable_video_on_mobile = background_block.settings.enable_video_on_mobile -%}
  {%- assign enable_background_color = background_block.settings.enable_background_color -%}
  {%- assign background_color = background_block.settings.background_color -%}
  {%- assign enable_background_color_gradient = background_block.settings.enable_background_color_gradient -%}
  {%- assign background_color_gradient_1 = background_block.settings.background_color_gradient_1 -%}
  {%- assign background_color_gradient_2 = background_block.settings.background_color_gradient_2 -%}
  {%- assign background_color_gradient_3 = background_block.settings.background_color_gradient_3 -%}
  {%- assign background_color_gradient_degrees = background_block.settings.background_color_gradient_degrees -%}
  {%- assign image_reveal_animation = background_block.settings.image_reveal_animation -%}
{%- else -%}
  {%- assign enable_parallax_mouse = false -%}
  {%- assign background_image = blank -%}
  {%- assign background_image_mobile = blank -%}
  {%- assign background_brightness = 0.5 -%}
  {%- assign enable_split_images = false -%}
  {%- assign split_image_left = blank -%}
  {%- assign split_image_right = blank -%}
  {%- assign video_url = '' -%}
  {%- assign video_file = blank -%}
  {%- assign video_brightness = 1 -%}
  {%- assign enable_video_on_mobile = false -%}
  {%- assign enable_background_color = false -%}
  {%- assign background_color = '#ffffff' -%}
  {%- assign enable_background_color_gradient = false -%}
  {%- assign background_color_gradient_1 = '#ffffff' -%}
  {%- assign background_color_gradient_2 = '#ffffff' -%}
  {%- assign background_color_gradient_3 = '#ffffff' -%}
  {%- assign background_color_gradient_degrees = '90deg' -%}
  {%- assign image_reveal_animation = 'none' -%}
{%- endif -%}

{%- comment -%} Top text variables {%- endcomment -%}
{%- if top_text_block -%}
  {%- assign top_text = top_text_block.settings.top_text -%}
  {%- assign top_text_color = top_text_block.settings.top_text_color -%}
  {%- assign top_text_size_desktop = top_text_block.settings.top_text_size_desktop -%}
  {%- assign top_text_size_mobile = top_text_block.settings.top_text_size_mobile -%}
  {%- assign top_text_gap_from_title = top_text_block.settings.top_text_gap_from_title -%}
{%- else -%}
  {%- assign top_text = '' -%}
  {%- assign top_text_color = '#FFFFFF' -%}
  {%- assign top_text_size_desktop = 24 -%}
  {%- assign top_text_size_mobile = 18 -%}
  {%- assign top_text_gap_from_title = 10 -%}
{%- endif -%}

{%- comment -%} Referral kicker variables {%- endcomment -%}
{%- if referral_block -%}
  {%- assign enable_referral_kicker = referral_block.settings.enable_referral_kicker -%}
  {%- assign referral_text = referral_block.settings.referral_text -%}
  {%- assign referral_accent_text = referral_block.settings.referral_accent_text -%}
  {%- assign referral_text_color = referral_block.settings.referral_text_color -%}
  {%- assign referral_accent_color = referral_block.settings.referral_accent_color -%}
  {%- assign referral_to_title_gap_desktop = referral_block.settings.referral_to_title_gap_desktop -%}
  {%- assign referral_to_title_gap_mobile = referral_block.settings.referral_to_title_gap_mobile -%}
  {%- assign referral_inline_gap_desktop = referral_block.settings.referral_inline_gap_desktop -%}
  {%- assign referral_inline_gap_mobile = referral_block.settings.referral_inline_gap_mobile -%}
  {%- assign ref_avatar_1 = referral_block.settings.ref_avatar_1 -%}
  {%- assign ref_avatar_2 = referral_block.settings.ref_avatar_2 -%}
  {%- assign ref_avatar_3 = referral_block.settings.ref_avatar_3 -%}
  {%- assign ref_avatar_4 = referral_block.settings.ref_avatar_4 -%}
  {%- assign ref_avatar_5 = referral_block.settings.ref_avatar_5 -%}
  {%- assign ref_avatar_size_desktop = referral_block.settings.ref_avatar_size_desktop -%}
  {%- assign ref_avatar_size_mobile = referral_block.settings.ref_avatar_size_mobile -%}
  {%- assign ref_avatar_overlap_desktop = referral_block.settings.ref_avatar_overlap_desktop -%}
  {%- assign ref_avatar_overlap_mobile = referral_block.settings.ref_avatar_overlap_mobile -%}
  {%- assign ref_avatar_border_thickness = referral_block.settings.ref_avatar_border_thickness -%}
  {%- assign ref_avatar_border_color = referral_block.settings.ref_avatar_border_color -%}
  {%- assign referral_display_type = referral_block.settings.referral_display_type -%}
  {%- assign referral_text_font_weight = referral_block.settings.referral_text_font_weight -%}
  {%- assign referral_text_size_desktop = referral_block.settings.referral_text_size_desktop -%}
  {%- assign referral_text_size_mobile = referral_block.settings.referral_text_size_mobile -%}
  {%- assign ref_star_rating = referral_block.settings.ref_star_rating -%}
  {%- assign ref_star_filled_color = referral_block.settings.ref_star_filled_color -%}
  {%- assign ref_star_unfilled_color = referral_block.settings.ref_star_unfilled_color -%}
  {%- assign ref_star_size_desktop = referral_block.settings.ref_star_size_desktop -%}
  {%- assign ref_star_size_mobile = referral_block.settings.ref_star_size_mobile -%}
  {%- assign referral_stars_position = referral_block.settings.referral_stars_position -%}
{%- else -%}
  {%- assign enable_referral_kicker = false -%}
  {%- assign referral_text = '' -%}
  {%- assign referral_accent_text = '' -%}
  {%- assign referral_text_color = '#ffffff' -%}
  {%- assign referral_accent_color = '#FF5A3D' -%}
  {%- assign referral_to_title_gap_desktop = 20 -%}
  {%- assign referral_to_title_gap_mobile = 10 -%}
  {%- assign referral_inline_gap_desktop = 12 -%}
  {%- assign referral_inline_gap_mobile = 8 -%}
  {%- assign ref_avatar_1 = blank -%}
  {%- assign ref_avatar_2 = blank -%}
  {%- assign ref_avatar_3 = blank -%}
  {%- assign ref_avatar_4 = blank -%}
  {%- assign ref_avatar_5 = blank -%}
  {%- assign ref_avatar_size_desktop = 36 -%}
  {%- assign ref_avatar_size_mobile = 32 -%}
  {%- assign ref_avatar_overlap_desktop = 10 -%}
  {%- assign ref_avatar_overlap_mobile = 8 -%}
  {%- assign ref_avatar_border_thickness = 2 -%}
  {%- assign ref_avatar_border_color = '#FFFFFF' -%}
  {%- assign referral_display_type = 'avatars' -%}
  {%- assign referral_text_font_weight = '400' -%}
  {%- assign referral_text_size_desktop = 16 -%}
  {%- assign referral_text_size_mobile = 15 -%}
  {%- assign ref_star_rating = 5 -%}
  {%- assign ref_star_filled_color = '#FFB400' -%}
  {%- assign ref_star_unfilled_color = '#D9D9D9' -%}
  {%- assign ref_star_size_desktop = 20 -%}
  {%- assign ref_star_size_mobile = 18 -%}
  {%- assign referral_stars_position = 'above' -%}
{%- endif -%}

{%- comment -%} Badge variables {%- endcomment -%}
{%- if badge_block -%}
