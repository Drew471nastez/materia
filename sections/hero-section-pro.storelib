<template compat="shopify">
{% render 'theme-type' %}
{{ 'marketing-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-image-one.js' | asset_url }}" defer></script><script src="{{ 'hero-product-two.js' | asset_url }}" defer></script><script src="{{ 'marketing-sections.js' | asset_url }}" defer></script>
{% assign s = section.settings %}{% assign bg = section.blocks | where: 'type', 'background' | first %}{% assign photo = s.background_image | default: s.image | default: bg.settings.background_image %}{% assign mobile_photo = s.background_image_mobile | default: bg.settings.background_image_mobile %}{% assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme' %}{% assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect width=%22400%22 height=%22300%22 fill=%22%23efefef%22/%3E%3Ccircle cx=%22172%22 cy=%22124%22 r=%2214%22 fill=%22%23cfcfcf%22/%3E%3Cpath d=%22M140 192l40-46 25 28 20-18 35 36z%22 fill=%22%23cfcfcf%22/%3E%3C/svg%3E' %}
{% if s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display: 'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display: 'swap' }}{% endif %}</style>{% endif %}
<section id="mk-{{ section.id }}" class="mk-shell color-{{ scheme }}" data-marketing-section="{{ section.id }}" data-mk-kind="pro" style="{% render 'hero-pro-initial-style', section: section %}" data-mk-settings="{{ s | json | escape }}" data-mk-defaults='{"section_width":"full_width","color_scheme":"default-color-scheme","reset_spacing":true,"elements_alignment_desktop":"center","elements_alignment_mobile":"center","desktop_width":500,"enable_custom_style":false,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","texts_reveal_animation":"none","reveal_speed":700,"reveal_stagger":100,"reveal_easing":"cubic-bezier(.22,.61,.36,1)","animation":"theme","background_height_mobile":55,"padding_top_mobile":30,"padding_bottom_mobile":20,"hero_content_padding_left_mobile":40,"hero_content_padding_right_mobile":40,"background_height_desktop":70,"padding_top":130,"padding_bottom":130,"hero_content_padding_left_desktop":100,"hero_content_padding_right_desktop":100}' data-mk-block-defaults='{"background":{"enable_parallax_mouse":false,"enable_split_images":false,"enable_video_on_mobile":true,"enable_custom_style":false,"enable_background_color":false,"enable_background_color_gradient":false,"background_color_gradient_1":"#ffffff","background_color_gradient_2":"#ffffff","background_color_gradient_3":"#ffffff","background_color_gradient_degrees":"90deg","background_brightness":0.5,"video_brightness":1,"image_reveal_animation":"none","video_autoplay":true,"video_loop":true,"video_controls":false},"top_text":{"enable_custom_style":false,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"top_text_size_desktop":24,"top_text_size_mobile":18,"top_text_gap_from_title":10,"font_weight":"theme"},"referral_kicker":{"enable_referral_kicker":true,"referral_text":"Trusted by 1,250+ customers","referral_accent_text":"1,250+","enable_custom_style":false,"referral_text_font_weight":"400","ref_star_filled_color":"#FFB400","ref_star_unfilled_color":"#D9D9D9","ref_avatar_border_thickness":2,"ref_avatar_border_color":"#FFFFFF","font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"referral_text_size_desktop":16,"referral_text_size_mobile":15,"referral_display_type":"avatars","referral_to_title_gap_desktop":20,"referral_to_title_gap_mobile":10,"referral_inline_gap_desktop":12,"referral_inline_gap_mobile":8,"ref_star_rating":5,"ref_star_size_desktop":20,"ref_star_size_mobile":18,"referral_stars_position":"above","ref_avatar_size_desktop":36,"ref_avatar_size_mobile":32,"ref_avatar_overlap_desktop":10,"ref_avatar_overlap_mobile":8},"badge":{"enable_badge":true,"badge_text":"NEW","enable_badge_svg_icon":false,"badge_icon_source":"preset","badge_icon_preset":"star","enable_custom_style":false,"badge_font_size":14,"enable_badge_background_gradient":false,"badge_background_gradient_1":"#000000","badge_background_gradient_2":"#333333","badge_background_gradient_degrees":"90deg","badge_border_thickness":0,"font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"badge_vertical_gap":10,"badge_svg_icon_size_desktop":20,"badge_svg_icon_size_mobile":16,"badge_svg_icon_gap_desktop":6,"badge_svg_icon_gap_mobile":6,"badge_svg_icon_vertical_position_desktop":0,"badge_svg_icon_vertical_position_mobile":0,"font_weight":"theme"},"heading":{"title_text":"Hero Image","enable_special_word":false,"enable_custom_style":false,"title_line_height_desktop":0.9,"title_line_height_mobile":1.1,"title_font_weight":"inherit","enable_title_custom_font":false,"custom_title_font":"assistant_n4","enable_title_gradient":false,"gradient_start_color":"#ff0000","gradient_middle_color":"#00ff00","gradient_end_color":"#0000ff","gradient_degrees":"90deg","font_source":"heading","text_case":"theme","letter_spacing":0,"line_height":1.2,"title_size_desktop":100,"title_size_mobile":60,"title_left_padding_desktop":0,"title_right_padding_desktop":0,"title_left_padding_mobile":0,"title_right_padding_mobile":0,"title_width_desktop":74},"subheading":{"enable_custom_style":false,"subheading_font_weight":"400","subheading_line_height_desktop":"1.4","subheading_line_height_mobile":"1.3","font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"subheading_text_size_desktop":24,"subheading_text_size_mobile":18,"subheading_left_padding_desktop":0,"subheading_right_padding_desktop":0,"subheading_left_padding_mobile":0,"subheading_right_padding_mobile":0,"subheading_vertical_gap":20,"subheading_to_button_gap":20},"image_over_text":{"enable_image_over_text_horizontal_position":false,"enable_custom_style":false,"enable_image_over_text":false,"image_over_text_hover_animation":"none","image_over_text_hover_duration":500,"image_over_text_width_desktop":200,"image_over_text_height_desktop":200,"image_over_text_width_mobile":100,"image_over_text_height_mobile":100,"image_over_text_vertical_position_desktop":0,"image_over_text_vertical_position_mobile":0,"image_over_text_horizontal_position_desktop":50,"image_over_text_horizontal_position_mobile":50,"image_over_text_constant_animation":"none","image_over_text_constant_duration":3000},"primary_button":{"button_text":"Shop Now","selected_icon":"none","enable_custom_style":false,"button_font_size":15,"button_border_enabled":true,"button_border_thickness":1,"button_border_radius":6,"enable_button_custom_font_weight":false,"button_font_weight":"700","button_hover_animation":"glow-white","icon_size":16,"use_theme_button":true,"button_size_desktop":10,"button_size_mobile":12,"button_width_desktop":20,"button_width_mobile":20,"button_vertical_gap":20},"secondary_button":{"enable_secondary_button":false,"secondary_button_text":"Learn More","enable_custom_style":false,"secondary_button_border_radius":5,"secondary_button_border_thickness":0,"secondary_button_font_size":15,"secondary_button_font_weight":"400","use_theme_button":true,"secondary_button_horizontal_gap":15},"text_under_button":{"enable_text_under_button":false,"enable_custom_style":false,"text_under_button_font_size":16,"text_under_button_font_weight":"400","font_source":"body","text_case":"theme","letter_spacing":0,"line_height":1.5,"text_under_button_gap":10}}' data-mk-editor="{% if request.design_mode or page.in_editor %}true{% else %}false{% endif %}" data-mk-button-font="{{ settings.button_font | default: 'body_font' }}" data-mk-motion="{{ settings.scroll_animation | default: 'none' }}" data-mk-duration="{{ settings.animation_duration | default: 700 }}" data-mk-delay="{{ settings.animation_delay | default: 0 }}">
 <div class="mk-inner"><div class="mk-row"><div class="mk-media" {{ bg.shopify_attributes }}><picture>{% if mobile_photo != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: mobile_photo, escaped: true %}">{% endif %}<img src="{% if photo != blank %}{% render 'offer-image-url', image: photo, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-mk-placeholder="{{ placeholder | escape }}" style="opacity:{% if photo == blank %}.2{% else %}1{% endif %};" alt="{{ photo.alt | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async"></picture><video muted playsinline hidden></video><div class="mk-split" hidden><img alt="" width="960" height="1080"><img alt="" width="960" height="1080"></div><span class="mk-overlay" aria-hidden="true"></span></div>
 <div class="mk-content">{% if section.blocks.size == 0 %}{% if request.design_mode or page.in_editor %}{% render 'promo-preview-cover', name: 'Hero Pro 1', kind: 'pro' %}{% endif %}{% endif %}{% for block in section.blocks %}{% unless block.hidden %}<div class="mk-block"{% case block.type %}{% when 'secondary_button' %}{% unless block.settings.enable_secondary_button %} hidden{% endunless %}{% when 'text_under_button' %}{% unless block.settings.enable_text_under_button %} hidden{% endunless %}{% when 'referral_kicker' %}{% if block.settings.enable_referral_kicker == false %} hidden{% endif %}{% when 'badge' %}{% if block.settings.enable_badge == false %} hidden{% endif %}{% when 'top_text' %}{% if block.settings.top_text == blank %} hidden{% endif %}{% when 'subheading' %}{% if block.settings.subheading_text == blank %} hidden{% endif %}{% when 'heading' %}{% if block.settings.title_text == blank %} hidden{% endif %}{% when 'primary_button' %}{% if block.settings.button_text == blank %} hidden{% endif %}{% when 'image_over_text' %}{% unless block.settings.enable_image_over_text %} hidden{% endunless %}{% endcase %} data-mk-block="{{ block.id }}" data-mk-type="{{ block.type }}" style="{% render 'hero-pro-block-initial-style', block: block %}" data-mk-block-settings="{{ block.settings | json | escape }}" {% unless block.type == 'background' or block.type == 'image_over_text' %}{{ block.shopify_attributes }}{% endunless %}{% if block.type == 'background' %} hidden{% endif %}>{% render 'marketing-block', block: block, kind: 'pro' %}</div>{% endunless %}{% endfor %}</div></div><button class="mk-close" type="button" aria-label="{{ 'accessibility.dismiss' | t }}" data-mk-close hidden>×</button></div>
 {% assign icons = 'check,star,heart,gift,truck,shield,shield_check,lightning,package,leaf,lock,award,clock,return,chat,globe,credit_card,tag' | split: ',' %}{% for icon in icons %}<template data-mk-icon="{{ icon }}">{% render 'hp-icon', icon: icon %}</template>{% endfor %}
</section>
</template>

<schema>
{
  "type": "hero-section-pro",
  "name": "Hero Pro 1",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": true
    },
    {
      "type": "select",
      "id": "elements_alignment_desktop",
      "label": "Elements Alignment (Desktop)",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "elements_alignment_mobile",
      "label": "Elements Alignment (Mobile)",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width",
      "label": "Desktop Width",
      "min": 0,
      "max": 1000,
      "default": 500,
      "step": 10
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style & Colors"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": false
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "visible_if": "{{ section.settings.enable_custom_style }}",
      "info": "Base surface behind media. To replace the hero image or video with a color, use the Background block."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "visible_if": "{{ section.settings.enable_custom_style }}",
      "info": "Base copy color. A block with custom styling can override it."
    },
    {
      "type": "header",
      "id": "hdr_12",
      "label": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_fonts",
      "label": "Enable custom fonts",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.enable_custom_fonts }}"
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Animation & Behavior"
    },
    {
      "type": "select",
      "id": "texts_reveal_animation",
      "label": "Heading & Text Reveal Animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade In"
        },
        {
          "value": "slide-up",
          "label": "Slide Up"
        },
        {
          "value": "slide-left",
          "label": "Slide Left"
        },
        {
          "value": "zoom-in",
          "label": "Zoom In"
        },
        {
          "value": "rotate",
          "label": "Rotate"
        },
        {
          "value": "flip",
          "label": "Flip"
        },
        {
          "value": "slide-down",
          "label": "Slide Down"
        },
        {
          "value": "bounce",
          "label": "Bounce"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "reveal_speed",
      "label": "Reveal speed",
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "range",
      "id": "reveal_stagger",
      "label": "Reveal stagger (order & frequency)",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 100
    },
    {
      "type": "select",
      "id": "reveal_easing",
      "label": "Reveal smoothness (easing)",
      "options": [
        {
          "value": "cubic-bezier(.22,.61,.36,1)",
          "label": "Smooth (recommended)"
        },
        {
          "value": "ease-in-out",
          "label": "Gentle"
        },
        {
          "value": "ease-out",
          "label": "Ease out"
        },
        {
          "value": "cubic-bezier(.34,1.56,.64,1)",
          "label": "Springy"
        },
        {
          "value": "linear",
          "label": "Linear"
        }
      ],
      "default": "cubic-bezier(.22,.61,.36,1)"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "fade_up",
          "label": "Fade up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        }
      ],
      "default": "theme",
      "info": "Follows Theme settings by default. Editor controls do not replay entrance motion on every change."
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "background_height_desktop",
      "label": "Minimum background height (desktop, vh)",
      "min": 50,
      "max": 150,
      "default": 70,
      "step": 5
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding (Desktop)",
      "min": 0,
      "max": 700,
      "default": 130,
      "step": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (Desktop)",
      "min": 0,
      "max": 700,
      "default": 130,
      "step": 10
    },
    {
      "type": "range",
      "id": "hero_content_padding_left_desktop",
      "label": "Content Padding Left (Desktop)",
      "min": 0,
      "max": 300,
      "default": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "hero_content_padding_right_desktop",
      "label": "Content Padding Right (Desktop)",
      "min": 0,
      "max": 300,
      "default": 100,
      "step": 5
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Mobile"
    },
    {
      "type": "range",
      "id": "background_height_mobile",
      "label": "Minimum background height (mobile, vh)",
      "min": 50,
      "max": 150,
      "default": 55,
      "step": 5
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile)",
      "min": -30,
      "max": 400,
      "default": 30,
      "step": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile)",
      "min": -30,
      "max": 400,
      "default": 20,
      "step": 10
    },
    {
      "type": "range",
      "id": "hero_content_padding_left_mobile",
      "label": "Content Padding Left (Mobile)",
      "min": 0,
      "max": 100,
      "default": 40,
      "step": 5
    },
    {
      "type": "range",
      "id": "hero_content_padding_right_mobile",
      "label": "Content Padding Right (Mobile)",
      "min": 0,
      "max": 100,
      "default": 40,
      "step": 5
    }
  ],
  "blocks": [
    {
      "type": "background",
      "name": "Background",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "background_image_mobile",
          "label": "Background Image (Mobile)"
        },
        {
          "type": "checkbox",
          "id": "enable_parallax_mouse",
          "label": "Enable Image Parallax Mouse Move",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "enable_split_images",
          "label": "Enable Split Images",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "split_image_left",
          "label": "Split Image (Left)"
        },
        {
          "type": "image_picker",
          "id": "split_image_right",
          "label": "Split Image (Right)"
        },
        {
          "type": "video",
          "id": "video_file",
          "label": "Video (Upload)"
        },
        {
          "type": "textarea",
          "id": "video_url",
          "label": "Video URL",
          "info": "Optional direct video file URL, such as an MP4. A selected video file takes priority."
        },
        {
          "type": "checkbox",
          "id": "enable_video_on_mobile",
          "label": "Display Hero Video On Mobile",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_background_color",
          "label": "Enable Background Color",
          "default": false
        },
        {
          "type": "header",
          "id": "hdr_12",
          "label": "Style & Colors"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_style",
          "label": "Enable custom styling",
          "default": false
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color }}"
        },
        {
          "type": "checkbox",
          "id": "enable_background_color_gradient",
          "label": "Enable Background Color Gradient",
          "default": false,
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color }}"
        },
        {
          "type": "color",
          "id": "background_color_gradient_1",
          "label": "Gradient Color 1",
          "default": "#ffffff",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color and block.settings.enable_background_color_gradient }}"
        },
        {
          "type": "color",
          "id": "background_color_gradient_2",
          "label": "Gradient Color 2",
          "default": "#ffffff",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color and block.settings.enable_background_color_gradient }}"
        },
        {
          "type": "color",
          "id": "background_color_gradient_3",
          "label": "Gradient Color 3",
          "default": "#ffffff",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color and block.settings.enable_background_color_gradient }}"
        },
        {
          "type": "select",
          "id": "background_color_gradient_degrees",
          "label": "Background Gradient Degrees",
          "options": [
            {
              "value": "45deg",
              "label": "45°"
            },
            {
              "value": "90deg",
              "label": "90°"
            },
            {
              "value": "135deg",
              "label": "135°"
            },
            {
              "value": "180deg",
              "label": "180°"
            },
            {
              "value": "225deg",
              "label": "225°"
            },
            {
              "value": "270deg",
              "label": "270°"
            }
          ],
          "default": "90deg",
          "visible_if": "{{ block.settings.enable_custom_style and block.settings.enable_background_color and block.settings.enable_background_color_gradient }}"
        },
        {
          "type": "header",
          "id": "hdr_20",
          "label": "Layout & Spacing"
        },
        {
          "type": "range",
          "id": "background_brightness",
          "label": "Background Image Brightness",
          "min": 0,
          "max": 2,
          "default": 0.5,
          "step": 0.1
        },
        {
          "type": "range",
          "id": "video_brightness",
          "label": "Video Brightness",
          "min": 0,
          "max": 2,
          "default": 1,
          "step": 0.1
        },
        {
          "type": "select",
          "id": "image_reveal_animation",
          "label": "Image Reveal Animation",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "fade",
              "label": "Fade"
            },
            {
              "value": "slide-down",
              "label": "Slide Down"
            },
            {
              "value": "scale-up",
