  {%- assign image_over_text_vertical_position_mobile = 0 -%}
  {%- assign image_over_text_constant_animation = 'none' -%}
  {%- assign image_over_text_hover_animation = 'none' -%}
  {%- assign enable_image_over_text_horizontal_position = false -%}
  {%- assign image_over_text_horizontal_position_desktop = 50 -%}
  {%- assign image_over_text_horizontal_position_mobile = 50 -%}
{%- endif -%}

{%- comment -%} Primary button variables {%- endcomment -%}
{%- if primary_button_block -%}
  {%- assign button_text = primary_button_block.settings.button_text -%}
  {%- assign button_link = primary_button_block.settings.button_link -%}
  {%- assign selected_icon = primary_button_block.settings.selected_icon -%}
  {%- assign icon_size = primary_button_block.settings.icon_size -%}
  {%- assign button_size_desktop = primary_button_block.settings.button_size_desktop -%}
  {%- assign button_size_mobile = primary_button_block.settings.button_size_mobile -%}
  {%- assign button_width_desktop = primary_button_block.settings.button_width_desktop -%}
  {%- assign button_width_mobile = primary_button_block.settings.button_width_mobile -%}
  {%- assign button_background_color = primary_button_block.settings.button_background_color -%}
  {%- assign button_background_hover_color = primary_button_block.settings.button_background_hover_color -%}
  {%- assign button_text_color = primary_button_block.settings.button_text_color -%}
  {%- assign button_text_hover_color = primary_button_block.settings.button_text_hover_color -%}
  {%- assign button_icon_color = primary_button_block.settings.button_icon_color -%}
  {%- assign button_border_enabled = primary_button_block.settings.button_border_enabled -%}
  {%- assign button_border_color = primary_button_block.settings.button_border_color -%}
  {%- assign button_border_thickness = primary_button_block.settings.button_border_thickness -%}
  {%- assign button_border_radius = primary_button_block.settings.button_border_radius -%}
  {%- assign button_hover_animation = primary_button_block.settings.button_hover_animation -%}
  {%- assign button_vertical_gap = primary_button_block.settings.button_vertical_gap -%}
  {%- assign enable_button_custom_font_weight = primary_button_block.settings.enable_button_custom_font_weight -%}
  {%- assign button_font_weight = primary_button_block.settings.button_font_weight -%}
  {%- assign button_font_size = primary_button_block.settings.button_font_size -%}
  {%- assign has_primary_button = true -%}
{%- else -%}
  {%- assign button_text = '' -%}
  {%- assign button_link = '' -%}
  {%- assign selected_icon = 'none' -%}
  {%- assign icon_size = 16 -%}
  {%- assign button_size_desktop = 10 -%}
  {%- assign button_size_mobile = 12 -%}
  {%- assign button_width_desktop = 20 -%}
  {%- assign button_width_mobile = 20 -%}
  {%- assign button_background_color = '#1D1D1D' -%}
  {%- assign button_background_hover_color = '#282828' -%}
  {%- assign button_text_color = '#FFFFFF' -%}
  {%- assign button_text_hover_color = '#FFFFFF' -%}
  {%- assign button_icon_color = '#6CAAFF' -%}
  {%- assign button_border_enabled = true -%}
  {%- assign button_border_color = '#494949' -%}
  {%- assign button_border_thickness = 1 -%}
  {%- assign button_border_radius = 6 -%}
  {%- assign button_hover_animation = 'none' -%}
  {%- assign enable_button_custom_font_weight = false -%}
  {%- assign button_font_weight = '700' -%}
  {%- assign button_font_size = 15 -%}
  {%- assign button_vertical_gap = 20 -%}
  {%- assign has_primary_button = false -%}
{%- endif -%}

{%- comment -%} Secondary button variables {%- endcomment -%}
{%- if secondary_button_block -%}
  {%- assign enable_secondary_button = secondary_button_block.settings.enable_secondary_button -%}
  {%- assign secondary_button_text = secondary_button_block.settings.secondary_button_text -%}
  {%- assign secondary_button_link = secondary_button_block.settings.secondary_button_link -%}
  {%- assign secondary_button_background_color = secondary_button_block.settings.secondary_button_background_color -%}
  {%- assign secondary_button_text_color = secondary_button_block.settings.secondary_button_text_color -%}
  {%- assign secondary_button_background_hover_color = secondary_button_block.settings.secondary_button_background_hover_color -%}
  {%- assign secondary_button_text_hover_color = secondary_button_block.settings.secondary_button_text_hover_color -%}
  {%- assign secondary_button_border_radius = secondary_button_block.settings.secondary_button_border_radius -%}
  {%- assign secondary_button_border_thickness = secondary_button_block.settings.secondary_button_border_thickness -%}
  {%- assign secondary_button_border_color = secondary_button_block.settings.secondary_button_border_color -%}
  {%- assign secondary_button_horizontal_gap = secondary_button_block.settings.secondary_button_horizontal_gap -%}
  {%- assign secondary_button_font_weight = secondary_button_block.settings.secondary_button_font_weight -%}
  {%- assign secondary_button_font_size = secondary_button_block.settings.secondary_button_font_size -%}
{%- else -%}
  {%- assign enable_secondary_button = false -%}
  {%- assign secondary_button_text = '' -%}
  {%- assign secondary_button_link = '' -%}
  {%- assign secondary_button_background_color = '#000000' -%}
  {%- assign secondary_button_text_color = '#ffffff' -%}
  {%- assign secondary_button_background_hover_color = '#222222' -%}
  {%- assign secondary_button_text_hover_color = '#ffffff' -%}
  {%- assign secondary_button_border_radius = 5 -%}
  {%- assign secondary_button_border_thickness = 0 -%}
  {%- assign secondary_button_border_color = '#ffffff' -%}
  {%- assign secondary_button_horizontal_gap = 15 -%}
  {%- assign secondary_button_font_weight = 'normal' -%}
  {%- assign secondary_button_font_size = 15 -%}
{%- endif -%}

{%- comment -%} Text under button variables {%- endcomment -%}
{%- if text_under_button_block -%}
  {%- assign enable_text_under_button = text_under_button_block.settings.enable_text_under_button -%}
  {%- assign text_under_button = text_under_button_block.settings.text_under_button -%}
  {%- assign text_under_button_font_size = text_under_button_block.settings.text_under_button_font_size -%}
  {%- assign text_under_button_color = text_under_button_block.settings.text_under_button_color -%}
  {%- assign text_under_button_gap = text_under_button_block.settings.text_under_button_gap -%}
  {%- assign text_under_button_font_weight = text_under_button_block.settings.text_under_button_font_weight -%}
{%- else -%}
  {%- assign enable_text_under_button = false -%}
  {%- assign text_under_button = '' -%}
  {%- assign text_under_button_font_size = 16 -%}
  {%- assign text_under_button_color = '#000000' -%}
  {%- assign text_under_button_gap = 10 -%}
  {%- assign text_under_button_font_weight = 'normal' -%}
{%- endif -%}

{%- comment -%} Colours: an empty setting follows the colour scheme (text over an image stays light). {%- endcomment -%}
{%- if enable_background_color -%}{%- capture top_text_color -%}{% render 'scheme-color', color: top_text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}{%- else -%}{%- capture top_text_color -%}{% render 'scheme-color', color: top_text_color, fallback: '#FFFFFF' %}{%- endcapture -%}{%- endif -%}
{%- if enable_background_color -%}{%- capture referral_text_color -%}{% render 'scheme-color', color: referral_text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}{%- else -%}{%- capture referral_text_color -%}{% render 'scheme-color', color: referral_text_color, fallback: '#FFFFFF' %}{%- endcapture -%}{%- endif -%}
{%- if enable_background_color -%}{%- capture title_text_color -%}{% render 'scheme-color', color: title_text_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}{%- else -%}{%- capture title_text_color -%}{% render 'scheme-color', color: title_text_color, fallback: '#FFFFFF' %}{%- endcapture -%}{%- endif -%}
{%- if enable_background_color -%}{%- capture subheading_text_color -%}{% render 'scheme-color', color: subheading_text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}{%- else -%}{%- capture subheading_text_color -%}{% render 'scheme-color', color: subheading_text_color, fallback: '#FFFFFF' %}{%- endcapture -%}{%- endif -%}
{%- if enable_background_color -%}{%- capture text_under_button_color -%}{% render 'scheme-color', color: text_under_button_color, fallback: 'var(--color-text)' %}{%- endcapture -%}{%- else -%}{%- capture text_under_button_color -%}{% render 'scheme-color', color: text_under_button_color, fallback: '#FFFFFF' %}{%- endcapture -%}{%- endif -%}
{%- capture referral_accent_color -%}{% render 'scheme-color', color: referral_accent_color, fallback: '#FF5A3D' %}{%- endcapture -%}
{%- capture special_word_color -%}{% render 'scheme-color', color: special_word_color, fallback: '#FF5A3D' %}{%- endcapture -%}
{%- capture badge_text_color -%}{% render 'scheme-color', color: badge_text_color, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}
{%- capture badge_background_color -%}{% render 'scheme-color', color: badge_background_color, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture badge_border_color -%}{% render 'scheme-color', color: badge_border_color, fallback: 'var(--btn-primary-border-color)' %}{%- endcapture -%}
{%- capture button_background_color -%}{% render 'scheme-color', color: button_background_color, fallback: 'var(--btn-primary-bg-color)' %}{%- endcapture -%}
{%- capture button_background_hover_color -%}{% render 'scheme-color', color: button_background_hover_color, fallback: 'var(--btn-primary-hover-bg-color)' %}{%- endcapture -%}
{%- capture button_text_color -%}{% render 'scheme-color', color: button_text_color, fallback: 'var(--btn-primary-color)' %}{%- endcapture -%}
{%- capture button_text_hover_color -%}{% render 'scheme-color', color: button_text_hover_color, fallback: 'var(--btn-primary-hover-color)' %}{%- endcapture -%}
{%- capture button_icon_color -%}{% render 'scheme-color', color: button_icon_color, fallback: 'currentColor' %}{%- endcapture -%}
{%- capture button_border_color -%}{% render 'scheme-color', color: button_border_color, fallback: 'var(--btn-primary-border-color)' %}{%- endcapture -%}
{%- capture secondary_button_background_color -%}{% render 'scheme-color', color: secondary_button_background_color, fallback: 'var(--btn-secondary-bg-color)' %}{%- endcapture -%}
{%- capture secondary_button_text_color -%}{% render 'scheme-color', color: secondary_button_text_color, fallback: 'var(--btn-secondary-color)' %}{%- endcapture -%}
{%- capture secondary_button_background_hover_color -%}{% render 'scheme-color', color: secondary_button_background_hover_color, fallback: 'var(--btn-secondary-hover-bg-color)' %}{%- endcapture -%}
{%- capture secondary_button_text_hover_color -%}{% render 'scheme-color', color: secondary_button_text_hover_color, fallback: 'var(--btn-secondary-hover-color)' %}{%- endcapture -%}
{%- capture secondary_button_border_color -%}{% render 'scheme-color', color: secondary_button_border_color, fallback: 'var(--btn-secondary-border-color)' %}{%- endcapture -%}
{%- capture background_color -%}{% render 'scheme-color', color: background_color, fallback: 'var(--color-background)' %}{%- endcapture -%}
{%- liquid
  if title_font_weight_input != blank
    assign hsp_title_fw = title_font_weight_input
  elsif title_font_weight == blank or title_font_weight == 'inherit'
    assign hsp_title_fw = 'var(--heading-weight, 700)'
  else
    assign hsp_title_fw = title_font_weight
  endif
  assign hsp_btn_theme = true
  if primary_button_block and primary_button_block.settings.use_theme_button == false
    assign hsp_btn_theme = false
  endif
  assign hsp_btn2_theme = true
  if secondary_button_block and secondary_button_block.settings.use_theme_button == false
    assign hsp_btn2_theme = false
  endif
-%}
{%- comment -%} Section frame heights live at section level (not in any block) {%- endcomment -%}
{%- assign background_height_desktop = section.settings.background_height_desktop -%}
{%- assign background_height_mobile = section.settings.background_height_mobile -%}

<style>
  /* Section isolation — prevent CSS/JS bleed between sections.
     Explicit `z-index: 0` keeps the hero in the parent stacking
     context below the sticky header (z-index: 11 in theme.css).
     `isolation: isolate` creates a new stacking context so the
     internal `z-index: 99999` etc. can't escape upward. */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    z-index: 0;
  }
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Section width — universal selector that works regardless of inner markup */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- Hero Section -->

<!-- Import Google Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

<!-- Import Google Fonts Dynamically -->
{% assign google_fonts = '' %}

{% if enable_title_custom_font %}
  {% assign font_name = custom_title_font %}
  {% assign font_slug = font_name | replace: ' ', '+' %}
  {% unless google_fonts contains font_slug %}
    {% if google_fonts != '' %}
      {% assign google_fonts = google_fonts | append: '&family=' | append: font_slug %}
    {% else %}
      {% assign google_fonts = google_fonts | append: 'family=' | append: font_slug %}
    {% endif %}
  {% endunless %}
{% endif %}

{% if google_fonts != '' %}
  <link href="https://fonts.googleapis.com/css2?{{ google_fonts }}&display=swap" rel="stylesheet">
{% endif %}

<style>
  #unique-hero-section-{{ section.id }} .hero-background,
  #unique-hero-section-{{ section.id }} .hero-background-mobile {
    position: absolute !important;
    z-index: -2 !important; /* Lower than all other elements */
  }

  /* Scoped CSS for Hero Section with !important on every declaration */
  #unique-hero-section-{{ section.id }}.hero-section {
    display: flex !important;
    flex-direction: column !important;
    position: relative !important;
    width: 100% !important;
    align-items: var(--elements-alignment-desktop, center) !important;
    justify-content: center !important;
    padding-top: var(--hero-padding-top, 240px) !important;
    padding-bottom: var(--hero-padding-bottom, 80px) !important;
    min-height: var(--hero-section-height-desktop, 900px) !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }}.hero-section {
      padding-top: var(--hero-padding-top-mobile, 100px) !important;
      padding-bottom: var(--hero-padding-bottom-mobile, 20px) !important;
      min-height: var(--hero-section-height-mobile, 600px) !important;
      line-height: var(--hero-title-line-height-mobile, 1.1) !important;
    }
  }

  #unique-hero-section-{{ section.id }} .hero-background,
  #unique-hero-section-{{ section.id }} .hero-background-mobile {
    position: absolute !important;
    inset: 0 !important;
    height: 100% !important;
    width: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    filter: brightness(var(--hero-background-brightness, 1)) !important;
    /* Parallax — short transition keeps the bg snappy while the
       cursor is moving but smooths the reset on mouseleave. */
    will-change: transform !important;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
  }

  /* Hide mobile background on desktop and vice versa */
  #unique-hero-section-{{ section.id }} .hero-background-mobile {
    display: none !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-background {
      display: none !important;
    }
    #unique-hero-section-{{ section.id }} .hero-background-mobile {
      display: block !important;
    }
  }

  /* Split Images Container for Desktop Only */
  #unique-hero-section-{{ section.id }} .split-images-container {
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    flex-direction: row !important;
    z-index: -2 !important; /* Keep behind hero content */
  }
  #unique-hero-section-{{ section.id }} .split-images-container img {
    width: 50% !important;
    height: 100% !important;
    object-fit: cover !important;
    /* Apply same brightness control to split images */
    filter: brightness(var(--hero-background-brightness, 1)) !important;
  }
  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .split-images-container {
      display: none !important;
    }
  }

  /* Video background styling */
  #unique-hero-section-{{ section.id }} .hero-video {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    z-index: -2 !important;
    filter: brightness(var(--hero-video-brightness, 1)) !important;
  }

  /* Conditionally hide/show the video on mobile */
  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-video {
      {% unless enable_video_on_mobile %}
        display: none !important;
      {% endunless %}
    }
  }

  #unique-hero-section-{{ section.id }} .hero-content {
    position: relative !important;
    display: flex !important;
    width: var(--hero-content-width-desktop, 876px) !important;
    max-width: 100% !important;
    flex-direction: column !important;
    align-items: var(--elements-alignment-desktop, center) !important;
    text-align: var(--text-alignment-desktop, center) !important;
    padding-left: var(--hero-content-padding-left-desktop, 0px) !important;
    padding-right: var(--hero-content-padding-right-desktop, 0px) !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-content {
      width: 100% !important;
      align-items: var(--elements-alignment-mobile, center) !important;
      text-align: var(--text-alignment-mobile, center) !important;
      padding-left: var(--hero-content-padding-left-mobile, 0px) !important;
      padding-right: var(--hero-content-padding-right-mobile, 0px) !important;
    }
  }

  #unique-hero-section-{{ section.id }} .hero-top-text,
  #unique-hero-section-{{ section.id }} .hero-title,
  #unique-hero-section-{{ section.id }} .cta-button {
    text-align: inherit !important;
  }

  #unique-hero-section-{{ section.id }} .hero-top-text {
    color: {{ top_text_color }} !important;
    font-size: var(--hero-top-text-size-desktop, 24px) !important;
    margin-bottom: var(--top-text-gap-from-title, 10px) !important; /* gap to next element (now Referral Kicker if enabled) */
    font-family: var(--custom-text-font) !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-top-text {
      font-size: var(--hero-top-text-size-mobile, 18px) !important;
    }
  }

  /* =========================
     REFERRAL KICKER (avatars + message)
     ========================= */
  #unique-hero-section-{{ section.id }} .referral-kicker {
    width: 100% !important;
    display: flex !important; /* toggled in HTML when enabled */
    align-items: center !important;
    justify-content: var(--elements-alignment-desktop, center) !important;
    gap: var(--referral-inline-gap-desktop, 12px) !important;
    margin-bottom: var(--referral-to-title-gap-desktop, 16px) !important; /* controls gap to headline */
    font-family: var(--custom-text-font) !important;
  }

  #unique-hero-section-{{ section.id }} .referral-avatars {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #unique-hero-section-{{ section.id }} .referral-avatars img {
    width: var(--ref-avatar-size-desktop, 36px) !important;
    height: var(--ref-avatar-size-desktop, 36px) !important;
    border-radius: 9999px !important;
    object-fit: cover !important;
    border: var(--ref-avatar-border-thickness, 2px) solid var(--ref-avatar-border-color, #ffffff) !important;
    box-shadow: 0 0 0 0 rgba(0,0,0,0) !important;
  }
  /* overlap for all but the first */
  #unique-hero-section-{{ section.id }} .referral-avatars img + img {
    margin-left: calc(var(--ref-avatar-overlap-desktop, 10) * -1px) !important;
  }

  #unique-hero-section-{{ section.id }} .referral-message {
    color: var(--referral-text-color, #111827) !important;
    font-size: 16px !important;
    line-height: 1.4 !important;
    white-space: normal !important;
  }
  #unique-hero-section-{{ section.id }} .referral-message .referral-accent {
    color: var(--referral-accent-color, #FF5A3D) !important; /* orange-like */
    font-weight: 700 !important;
  }

  /* Star rating display (alternative to avatars). Two stacked layers:
     a base row in the unfilled color and a clipped overlay row in the
     filled color whose width = rating/5. Supports half/quarter stars. */
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars {
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
  }
  /* Stars positioned to the RIGHT of the message (row layout, message
     first then stars). */
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: var(--elements-alignment-desktop, center) !important;
    text-align: left !important;
  }
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right .referral-message { order: 1 !important; }
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right .referral-stars   { order: 2 !important; }
  /* Stars positioned to the LEFT of the message (row layout, stars
     first then message). */
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left {
    flex-direction: row !important;
    align-items: center !important;
    justify-content: var(--elements-alignment-desktop, center) !important;
    text-align: left !important;
  }
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left .referral-stars   { order: 1 !important; }
  #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left .referral-message { order: 2 !important; }
  /* On mobile, stars ALWAYS stack above the message (left/right inline
     looks cramped on small screens). Higher specificity + a media query
     placed after the desktop row rules so it wins. */
  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left,
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right {
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
    }
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left .referral-stars,
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right .referral-stars   { order: 1 !important; }
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-left .referral-message,
    #unique-hero-section-{{ section.id }} .referral-kicker.is-stars-right .referral-message { order: 2 !important; }
  }
  #unique-hero-section-{{ section.id }} .referral-stars {
    position: relative !important;
    display: inline-block !important;
    line-height: 1 !important;
    font-size: 20px !important; /* overridden by direct-emit star size */
    white-space: nowrap !important;
  }
  #unique-hero-section-{{ section.id }} .referral-stars .stars-base,
  #unique-hero-section-{{ section.id }} .referral-stars .stars-fill {
    letter-spacing: 2px !important;
    font-family: inherit !important;
  }
  #unique-hero-section-{{ section.id }} .referral-stars .stars-base {
    color: var(--ref-star-unfilled, #D9D9D9) !important;
  }
  #unique-hero-section-{{ section.id }} .referral-stars .stars-fill {
    color: var(--ref-star-filled, #FFB400) !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: var(--ref-star-fill, 100%) !important;
    overflow: hidden !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .referral-kicker {
      flex-direction: column !important; /* avatars row on top, message below */
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      gap: var(--referral-inline-gap-mobile, 8px) !important;
      margin-bottom: var(--referral-to-title-gap-mobile, 12px) !important;
    }
    #unique-hero-section-{{ section.id }} .referral-avatars img {
      width: var(--ref-avatar-size-mobile, 32px) !important;
      height: var(--ref-avatar-size-mobile, 32px) !important;
    }
    #unique-hero-section-{{ section.id }} .referral-avatars img + img {
      margin-left: calc(var(--ref-avatar-overlap-mobile, 8) * -1px) !important;
    }
    #unique-hero-section-{{ section.id }} .referral-message {
      font-size: 15px !important;
    }
  }
  /* ========================= */

  #unique-hero-section-{{ section.id }} .hero-title {
    color: {{ title_text_color }} !important;
    font-size: var(--hero-title-size-desktop, 160px) !important;
    line-height: var(--hero-title-line-height-desktop, 1) !important;
    font-weight: var(--title-font-weight, normal) !important;
    font-family: var(--custom-title-font) !important;
    margin: 0 !important;
    padding-left: var(--hero-title-left-padding-desktop, 0px) !important;
    padding-right: var(--hero-title-right-padding-desktop, 0px) !important;
    max-width: var(--hero-title-width-desktop, 74%) !important;
    {% if enable_title_gradient %}
      background: linear-gradient(var(--gradient-degrees, 90deg), var(--gradient-start-color, #000), var(--gradient-middle-color, #fff), var(--gradient-end-color, #000)) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    {% endif %}
    position: relative !important;
    z-index: 1 !important;
  }

  /* Special colored word inside the headline */
  #unique-hero-section-{{ section.id }} .hero-title .hero-special-word {
    background: none !important;
    -webkit-background-clip: initial !important;
    -webkit-text-fill-color: var(--special-word-color, inherit) !important;
    color: var(--special-word-color, inherit) !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-title {
      font-size: var(--hero-title-size-mobile, 40px) !important;
      line-height: var(--hero-title-line-height-mobile, 1.1) !important;
      padding-left: var(--hero-title-left-padding-mobile, 20px) !important;
      padding-right: var(--hero-title-right-padding-mobile, 20px) !important;
    }
  }

  /* Pill Badge */
  #unique-hero-section-{{ section.id }} .badge-pill {
    display: inline-flex !important;
    align-items: center !important;
    font-size: var(--badge-font-size, 14px) !important;
    color: var(--badge-text-color, #ffffff) !important;
    border-radius: 9999px !important;
    padding: 6px 12px !important;
    margin-bottom: var(--badge-vertical-gap, 10px) !important;
    font-family: var(--custom-text-font) !important;
    border: var(--badge-border-thickness, 0px) solid var(--badge-border-color, #000) !important;

    {% if enable_badge_background_gradient %}
      background: linear-gradient(
        {{ badge_background_gradient_degrees }},
        {{ badge_background_gradient_1 }},
        {{ badge_background_gradient_2 }}
      ) !important;
    {% else %}
      background-color: var(--badge-background-color, #000000) !important;
    {% endif %}
  }
  #unique-hero-section-{{ section.id }} .badge-svg-icon {
    display: inline-block !important;
    margin-right: var(--badge-svg-icon-gap-desktop, 6px) !important;
    width: var(--badge-svg-icon-size-desktop, 20px) !important;
    height: auto !important;
    transform: translateY(var(--badge-svg-icon-translateY-desktop, 0px)) !important;
  }
  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .badge-svg-icon {
      margin-right: var(--badge-svg-icon-gap-mobile, 6px) !important;
      width: var(--badge-svg-icon-size-mobile, 16px) !important;
      transform: translateY(var(--badge-svg-icon-translateY-mobile, 0px)) !important;
    }
  }

  /* Subheading text */
  #unique-hero-section-{{ section.id }} .hero-subheading {
    margin-top: var(--subheading-vertical-gap, 20px) !important;
    margin-bottom: var(--subheading-to-button-gap, 20px) !important;
    color: var(--subheading-text-color, #ffffff) !important;
    font-size: var(--subheading-text-size-desktop, 24px) !important;
    padding-left: var(--subheading-left-padding-desktop, 0px) !important;
    padding-right: var(--subheading-right-padding-desktop, 0px) !important;
    font-family: var(--custom-text-font) !important;
    font-weight: var(--subheading-font-weight, 400) !important;
    line-height: var(--subheading-line-height-desktop, 1.4) !important;
  }
  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .hero-subheading {
      font-size: var(--subheading-text-size-mobile, 18px) !important;
      padding-left: var(--subheading-left-padding-mobile, 0px) !important;
      line-height: var(--subheading-line-height-mobile, 1.3) !important;
      padding-right: var(--subheading-right-padding-mobile, 0px) !important;
    }
  }

  #unique-hero-section-{{ section.id }} .cta-buttons-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: var(--secondary-button-horizontal_gap, 15px) !important;
    margin-top: var(--button-vertical-gap, 20px) !important;
  }

  #unique-hero-section-{{ section.id }} .cta-button {
    background-color: var(--button-background-color, #fff) !important;
    color: var(--button-text-color, #010203) !important;
    display: flex !important;
    gap: 8px !important;
    justify-content: center !important;
    align-items: center !important;
    padding: var(--button-size-desktop, 16px) var(--button-width-desktop, 40px) !important;
    /* Font properties split out of the `font:` shorthand because some
       browsers/parsers were silently dropping the entire shorthand
       when `--button-font-weight` resolved to a custom value — causing
       the Font Weight selector to appear to do nothing. Separate
       declarations always win. */
    font-family: var(--custom-text-font) !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
    font-weight: var(--button-font-weight, 700) !important;
    border: var(--button-border-thickness, 0px) solid var(--button-border-color, transparent) !important;
    border-radius: var(--button-border-radius, 5px) !important;
    text-decoration: none !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease !important;
  }

  /* Secondary Button (optional) */
  #unique-hero-section-{{ section.id }} .secondary-cta-button {
    background-color: var(--secondary-button-background-color, #000) !important;
    color: var(--secondary-button-text-color, #ffffff) !important;
    display: flex !important;
    gap: 8px !important;
    justify-content: center !important;
    align-items: center !important;
    padding: var(--secondary-button-padding-vertical, 16px) var(--secondary-button-padding-horizontal, 40px) !important;
    border: var(--secondary-button-border-thickness, 0px) solid var(--secondary-button-border-color, transparent) !important;
    border-radius: var(--secondary-button-border-radius, 5px) !important;
    text-decoration: none !important;
    /* Same fix as primary button — split `font:` shorthand so the
       font-weight CSS var always applies even if a particular value
       doesn't parse cleanly as part of the shorthand. */
    font-family: var(--custom-text-font) !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
    font-weight: var(--secondary-button-font-weight, normal) !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease !important;
  }

  /* Hover State Styles — actually consume the hover-colour CSS vars
     (previously this only set `opacity: 0.9`, so the merchant's
     "Button Background Hover Color" and "Button Text Hover Color"
     pickers had no visible effect). Border color flips with hover bg
     for outline-style buttons; transitions inherit the base rule. */
  #unique-hero-section-{{ section.id }} .cta-button:hover,
  #unique-hero-section-{{ section.id }} .cta-button:focus-visible {
    background-color: var(--button-background-hover-color, #3A3A3A) !important;
    color: var(--button-text-hover-color, #FFFFFF) !important;
    border-color: var(--button-background-hover-color, var(--button-border-color, transparent)) !important;
    opacity: 1 !important;
  }
  #unique-hero-section-{{ section.id }} .cta-button:hover .cta-icon {
    color: var(--button-text-hover-color, var(--button-icon-color, inherit)) !important;
  }
  #unique-hero-section-{{ section.id }} .secondary-cta-button:hover,
  #unique-hero-section-{{ section.id }} .secondary-cta-button:focus-visible {
    background-color: var(--secondary-button-background-hover-color, var(--secondary-button-background-color)) !important;
    color: var(--secondary-button-text-hover-color, var(--secondary-button-text-color)) !important;
    opacity: 1 !important;
  }

  @media (max-width: 991px) {
    #unique-hero-section-{{ section.id }} .cta-button {
      padding: var(--button-size-mobile, 12px) var(--button-width-mobile, 24px) !important;
      font-size: 14px !important;
      width: auto !important;
      max-width: 100% !important;
      text-align: center !important;
    }
    #unique-hero-section-{{ section.id }} .secondary-cta-button {
      padding: var(--button-size-mobile, 12px) var(--button-width-mobile, 24px) !important;
      font-size: 14px !important;
      width: auto !important;
      max-width: 100% !important;
      text-align: center !important;
    }
  }

  #unique-hero-section-{{ section.id }} .cta-icon {
    font-size: var(--icon-size, 24px) !important;
    color: var(--button-icon-color, inherit) !important;
  }

  /* ──────────────────────────────────────────────────────────────────
     BUTTON HOVER ANIMATIONS

     Previously the schema offered 8 hover animation options and the
     button rendered `class="cta-button hover-animation-<name>"`, but
     NO CSS rules existed for any of `.hover-animation-*` — so picking
     a value in the schema visibly did nothing.

     Below: every option in the schema gets a real, self-contained
     animation. All scoped via `#unique-hero-section-{{ section.id }} .hover-animation-X`
     so they only fire inside this section, never bleeding to other
     button instances. Each transition runs on hover and reverts
     cleanly on mouse-leave (no stuck states).
     ────────────────────────────────────────────────────────────── */
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-shadow,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-glow-white,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale-in,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-zoom-in,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-vibrate,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-blink,
  #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-glow {
    transition: background-color .25s ease, color .25s ease, border-color .25s ease,
                box-shadow .3s ease, transform .25s cubic-bezier(.34, 1.2, .64, 1) !important;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Subtle shadow — soft drop on hover */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-shadow:hover {
      box-shadow: 0 6px 18px rgba(0, 0, 0, .18) !important;
    }
    /* Glow white — soft white halo */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-glow-white:hover {
      box-shadow: 0 0 0 4px rgba(255, 255, 255, .25), 0 0 18px rgba(255, 255, 255, .35) !important;
    }
    /* Subtle scale — gentle 1.02× scale */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale:hover {
      transform: scale(1.02) !important;
    }
    /* Subtle scale in — 1.04× with smooth ease */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale-in:hover {
      transform: scale(1.04) !important;
    }
    /* Smooth zoom in — 1.06× more pronounced */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-zoom-in:hover {
      transform: scale(1.06) !important;
    }
    /* Smooth vibrate — quick L↔R sway, single cycle */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-vibrate:hover {
      animation: hp1-btn-vibrate .35s ease-in-out 1 !important;
    }
    @keyframes hp1-btn-vibrate {
      0%, 100% { transform: translateX(0); }
      25%      { transform: translateX(-3px); }
      75%      { transform: translateX(3px); }
    }
    /* Smooth blink — opacity pulse */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-blink:hover {
      animation: hp1-btn-blink 1.2s ease-in-out infinite !important;
    }
    @keyframes hp1-btn-blink {
      0%, 100% { opacity: 1; }
      50%      { opacity: .65; }
    }
    /* Smooth glow — animated halo that breathes */
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-glow:hover {
      animation: hp1-btn-smooth-glow 1.6s ease-in-out infinite !important;
    }
    @keyframes hp1-btn-smooth-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, .35); }
      50%      { box-shadow: 0 0 0 8px rgba(255, 255, 255, 0); }
    }
  }
  /* Touch / reduced-motion safety — no transforms on devices that
     can't hover or for users who prefer reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-shadow:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-glow-white:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-subtle-scale-in:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-zoom-in:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-vibrate:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-blink:hover,
    #unique-hero-section-{{ section.id }} .cta-button.hover-animation-smooth-glow:hover {
      animation: none !important;
      transform: none !important;
    }
  }

  #unique-hero-section-{{ section.id }} .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Keyframes Scoped */
  @keyframes vibrate {
    0% { transform: translate(0); }
    25% { transform: translate(-2px, 2px); }
    50% { transform: translate(-2px, -2px); }
    75% { transform: translate(2px, 2px); }
    100% { transform: translate(2px, -2px); }
  }

  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0.5; }
    100% { opacity: 1; }
  }

  /* =========================
     Extended Title Reveal Animations
     ========================= */
  @keyframes reveal-fade {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes reveal-slide-up {
    from { opacity: 0; transform: translateY(100%); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes reveal-slide-left {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes reveal-zoom-in {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes reveal-rotate {
    from { opacity: 0; transform: rotate(-10deg); }
    to { opacity: 1; transform: rotate(0deg); }
  }
  @keyframes reveal-flip {
    from { opacity: 0; transform: rotateY(90deg); }
    to { opacity: 1; transform: rotateY(0deg); }
  }
  @keyframes reveal-slide-down {
    from { opacity: 0; transform: translateY(-100%); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes reveal-bounce {
    0% { opacity: 0; transform: translateY(-50px); }
    50% { transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* Staggered reveal — animate each child of .hero-content in sequence
     instead of the whole block at once (which looked abrupt). Elements
     cascade in: top text, social proof, badge, title, subheading,
     image, buttons, text-under. `both` fill keeps each element in its
     start state during its delay (no flash) and its end state after. */
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > * {
    animation-duration: {{ section.settings.reveal_speed | default: 700 }}ms !important;
    animation-timing-function: {{ section.settings.reveal_easing | default: 'cubic-bezier(.22,.61,.36,1)' }} !important;
    animation-fill-mode: both !important;
  }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-fade > *       { animation-name: reveal-fade !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-slide-up > *   { animation-name: reveal-slide-up !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-slide-left > * { animation-name: reveal-slide-left !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-zoom-in > *    { animation-name: reveal-zoom-in !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-rotate > *     { animation-name: reveal-rotate !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-flip > *       { animation-name: reveal-flip !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-slide-down > * { animation-name: reveal-slide-down !important; }
  #unique-hero-section-{{ section.id }} .hero-content.reveal-texts-bounce > *     { animation-name: reveal-bounce !important; }
  /* Stepped delays so each element cascades after the previous one (stagger slider) */
  {%- assign rstag = section.settings.reveal_stagger | default: 100 -%}
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(1) { animation-delay: 0ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(2) { animation-delay: {{ rstag | times: 1 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(3) { animation-delay: {{ rstag | times: 2 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(4) { animation-delay: {{ rstag | times: 3 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(5) { animation-delay: {{ rstag | times: 4 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(6) { animation-delay: {{ rstag | times: 5 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(7) { animation-delay: {{ rstag | times: 6 }}ms !important; }
  #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > *:nth-child(8) { animation-delay: {{ rstag | times: 7 }}ms !important; }
  @media (prefers-reduced-motion: reduce) {
    #unique-hero-section-{{ section.id }} .hero-content[class*="reveal-texts-"] > * { animation: none !important; }
  }

  /* =========================
     IMAGE REVEAL ANIMATIONS
     ========================= */
  @keyframes image-reveal-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes image-reveal-slide-down {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes image-reveal-scale-up {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes image-reveal-blur {
    from { opacity: 0; filter: blur(10px); }
    to { opacity: 1; filter: blur(0); }
  }
  @keyframes image-reveal-rotate {
    from { opacity: 0; transform: rotate(-10deg); }
    to { opacity: 1; transform: rotate(0deg); }
  }

  {%- assign rdur = section.settings.reveal_speed | default: 700 -%}
  {%- assign reas = section.settings.reveal_easing | default: 'cubic-bezier(.22,.61,.36,1)' -%}
  .reveal-image-fade { animation: image-reveal-fade {{ rdur }}ms {{ reas }} forwards !important; }
  .reveal-image-slide-down { animation: image-reveal-slide-down {{ rdur }}ms {{ reas }} forwards !important; }
  .reveal-image-scale-up { animation: image-reveal-scale-up {{ rdur }}ms {{ reas }} forwards !important; }
  .reveal-image-blur { animation: image-reveal-blur {{ rdur }}ms {{ reas }} forwards !important; }
  .reveal-image-rotate { animation: image-reveal-rotate {{ rdur }}ms {{ reas }} forwards !important; }

  /* =========================
     IMAGE OVER TEXT FEATURE
     ========================= */

  /* Image Over Text — values emitted directly (no CSS-var indirection)
     so every slider in the editor updates immediately on change. The
     `#shopify-section-{{ section.id }}` prefix gives this rule higher
     specificity than any inherited or cached stylesheet. */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .image-over-text-container,
  #unique-hero-section-{{ section.id }} .image-over-text-container {
    position: absolute !important;
    top: {{ image_over_text_vertical_position_desktop }}px !important;
    width: {{ image_over_text_width_desktop }}px !important;
    height: {{ image_over_text_height_desktop }}px !important;
    {% if enable_image_over_text_horizontal_position %}
      left: {{ image_over_text_horizontal_position_desktop }}% !important;
      transform: translateX(0) !important;
    {% else %}
      left: 50% !important;
      transform: translateX(-50%) !important;
    {% endif %}
    z-index: 1 !important;
    pointer-events: auto !important;
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .image-over-text-container,
    #unique-hero-section-{{ section.id }} .image-over-text-container {
      top: {{ image_over_text_vertical_position_mobile }}px !important;
      width: {{ image_over_text_width_mobile }}px !important;
      height: {{ image_over_text_height_mobile }}px !important;
      {% if enable_image_over_text_horizontal_position %}
        left: {{ image_over_text_horizontal_position_mobile }}% !important;
        transform: translateX(0) !important;
      {% else %}
        left: 50% !important;
        transform: translateX(-50%) !important;
      {% endif %}
    }
  }
  /*
    ⚠️ REMOVED — a nuclear `#unique-hero-section-{{ section.id }}, #unique-hero-section-{{ section.id }} *`
    rule that forced `animation: none; transition: none; transform: none;
    opacity: 1;` on every descendant. That rule was killing:
      • Parallax mouse move (transform overridden → no translation)
      • Button hover transitions (transition: none)
      • Image Over Text animations (animation: none + transform: none)
      • The translateX(-50%) centering trick used by .image-over-text-container
      • Any reveal / fade animations baked into the section
    If a future requirement is to disable all motion in this section,
    do it scoped to a specific class or via `@media (prefers-reduced-motion)`,
    not a blanket `*` selector.
  */
  #unique-hero-section-{{ section.id }} .image-over-text {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    /* z-index normalised — was `99999` which is meaningless and
       suggested a stacking-context escape attempt. The section
       wrapper has `isolation: isolate`, so 2 is more than enough
       to sit above the background (z-index: -2) without polluting
       the cascade. */
    z-index: 2 !important;
    display: block !important;
    transition: transform var(--iot-hover-dur, 0.5s) ease-in-out, opacity var(--iot-hover-dur, 0.5s) ease-in-out !important;
  }

  /* Constant animations for Image Over Text */
  @keyframes floatUpDown {
    0% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0); }
  }
  .image-over-text-constant-floating-up-down {
    animation: floatUpDown var(--iot-const-dur, 3s) ease-in-out infinite;
  }

  @keyframes fadeInOut {
    0%, 100% { opacity: 0.95; filter: contrast(0.8); }
    50% { opacity: 1; filter: contrast(1.4); }
  }
  .image-over-text-constant-smooth-fade {
    animation: fadeInOut var(--iot-const-dur, 3s) ease-in-out infinite;
  }

  @keyframes rotateLeftRight {
    0% { transform: rotate(0deg); }
    50% { transform: rotate(5deg); }
    100% { transform: rotate(0deg); }
  }
  .image-over-text-constant-rotate-left-right {
    animation: rotateLeftRight var(--iot-const-dur, 3s) ease-in-out infinite;
  }

  @keyframes zoomInOut {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  .image-over-text-constant-smooth-zoom {
    animation: zoomInOut var(--iot-const-dur, 3s) ease-in-out infinite;
  }

  /* Hover animations for Image Over Text */
  @keyframes shakeSmooth {
    0% { transform: translateX(0); }
    100% { transform: translateX(5px); }
  }
  .image-over-text-hover-fade-in {
    transition: opacity var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-fade-in:hover {
    opacity: 0.6;
  }
  .image-over-text-hover-shake-smooth:hover {
    animation: shakeSmooth var(--iot-hover-dur, 0.5s) infinite alternate;
  }
  .image-over-text-hover-smooth-zoom-in {
    transition: transform var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-smooth-zoom-in:hover {
    transform: scale(1.1);
  }
  .image-over-text-hover-fade-in-up {
    transition: transform var(--iot-hover-dur, 0.5s) ease, opacity var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-fade-in-up:hover {
    transform: translateY(-10px);
    opacity: 0.8;
  }
  @keyframes shakeLR {
    0% { transform: translateX(0); }
    100% { transform: translateX(5px); }
  }
  .image-over-text-hover-floating-up-down:hover {
    animation: floatUpDown var(--iot-const-dur, 3s) ease-in-out infinite;
  }
  .image-over-text-hover-left-right-shake-smooth:hover {
    animation: shakeLR var(--iot-hover-dur, 0.5s) infinite alternate;
  }
  .image-over-text-hover-white-glow {
    transition: filter var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-white-glow:hover {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.8));
  }
  .image-over-text-hover-black-glow {
    transition: filter var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-black-glow:hover {
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.8));
  }
  .image-over-text-hover-blue-glow {
    transition: filter var(--iot-hover-dur, 0.5s) ease;
  }
  .image-over-text-hover-blue-glow:hover {
    filter: drop-shadow(0 0 10px rgba(0, 0, 255, 0.8));
  }
  @media (max-width: 991px) {
  #unique-hero-section-{{ section.id }}.hero-section {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }
}

  /* Enable text under button (optional) */
  #unique-hero-section-{{ section.id }} .text-under-button {
    margin-top: var(--text-under-button-gap, 10px) !important;
    font-size: var(--text-under-button-font-size, 16px) !important;
    color: var(--text-under-button-color, #000) !important;
    font-weight: var(--text-under-button-font-weight, normal) !important;
    font-family: var(--custom-text-font) !important;
  }

  /* =========================
     BACKGROUND COLOR / GRADIENT
     ========================= */
  #unique-hero-section-{{ section.id }} .hero-background-color {
    position: absolute !important;
    inset: 0 !important;
    z-index: -2 !important;
    width: 100% !important;
    height: 100% !important;
  }
{% comment %}{% endcomment %}</style>

<style>
  /* ──────────────────────────────────────────────────────────────────
     DIRECT-EMIT OVERRIDES

     Same approach already proven on Image Over Text: emit the editor
     values straight into the rule (no CSS-var indirection) and prefix
     with `#shopify-section-{{ section.id }}` so the rule outranks the
     base `#unique-hero-section-{{ section.id }}` styles AND repaints live in the editor.
     Routing these through custom properties on the inline style was
     unreliable in the theme editor, which is why Video Brightness and
     the whole Social Proof block looked like they "did nothing".
     ────────────────────────────────────────────────────────────── */

  /* --- Video brightness --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-video {
    filter: brightness({{ video_brightness | default: 1 }}) !important;
  }

  /* --- Social proof / referral kicker (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-kicker {
    gap: {{ referral_inline_gap_desktop }}px !important;
    margin-bottom: {{ referral_to_title_gap_desktop }}px !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-avatars img {
    width: {{ ref_avatar_size_desktop }}px !important;
    height: {{ ref_avatar_size_desktop }}px !important;
    border: {{ ref_avatar_border_thickness }}px solid {{ ref_avatar_border_color }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-avatars img + img {
    margin-left: -{{ ref_avatar_overlap_desktop }}px !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message {
    color: {{ referral_text_color }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message .referral-accent {
    color: {{ referral_accent_color }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message {
    font-weight: {{ referral_text_font_weight }} !important;
    font-size: {{ referral_text_size_desktop }}px !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-stars {
    font-size: {{ ref_star_size_desktop }}px !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-stars .stars-base {
    color: {{ ref_star_unfilled_color }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-stars .stars-fill {
    color: {{ ref_star_filled_color }} !important;
    width: {{ ref_star_rating | times: 20 }}% !important;
  }

  /* --- Social proof / referral kicker (mobile) --- */
  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-stars {
      font-size: {{ ref_star_size_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message {
      font-size: {{ referral_text_size_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-kicker {
      gap: {{ referral_inline_gap_mobile }}px !important;
      margin-bottom: {{ referral_to_title_gap_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-avatars img {
      width: {{ ref_avatar_size_mobile }}px !important;
      height: {{ ref_avatar_size_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-avatars img + img {
      margin-left: -{{ ref_avatar_overlap_mobile }}px !important;
    }
  }
{% comment %}{% endcomment %}</style>

<style>
  /* ============================================================
     AUTHORITATIVE DIRECT-EMIT OVERRIDES
     Every setting below is written as a LITERAL value (not through a
     CSS custom property) into rules prefixed with
     #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} — higher
     specificity than the base var()-driven rules and the same
     !important, so these always win and update live in the editor.
     This is the same approach already proven on Image Over Text and
     Social Proof. If a setting ever looks like it "doesn't apply",
     it is emitted here. ============================================ */

  /* --- Section frame (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }}.hero-section {
    background: transparent !important;
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
    min-height: {{ background_height_desktop }}vh !important;
    align-items: {{ section.settings.elements_alignment_desktop }} !important;
  }
  /* --- Background image brightness (single image, mobile image, split) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-background,
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-background-mobile,
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .split-images-container img {
    filter: brightness({{ background_brightness }}) !important;
  }
  /* --- Hero content box (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-content {
    {% if section.settings.desktop_width and section.settings.desktop_width > 0 %}width: {{ section.settings.desktop_width }}px !important;{% endif %}
    align-items: {{ section.settings.elements_alignment_desktop }} !important;
    text-align: {% if section.settings.elements_alignment_desktop == 'flex-start' %}left{% elsif section.settings.elements_alignment_desktop == 'flex-end' %}right{% else %}center{% endif %} !important;
    {% if section.settings.elements_alignment_desktop == 'flex-start' %}
      padding-left: {{ section.settings.hero_content_padding_left_desktop }}px !important; padding-right: 0px !important;
    {% elsif section.settings.elements_alignment_desktop == 'flex-end' %}
      padding-left: 0px !important; padding-right: {{ section.settings.hero_content_padding_right_desktop }}px !important;
    {% else %}
      padding-left: 0px !important; padding-right: 0px !important;
    {% endif %}
  }

  /* --- Social proof alignment: follow the section's Elements
     Alignment in every mode (avatars, stars above/left/right) so the
     block lines up cleanly with the heading/text instead of always
     centering. --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-kicker {
    justify-content: {{ section.settings.elements_alignment_desktop }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-kicker.is-stars {
    align-items: {{ section.settings.elements_alignment_desktop }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message {
    text-align: {% if section.settings.elements_alignment_desktop == 'flex-start' %}left{% elsif section.settings.elements_alignment_desktop == 'flex-end' %}right{% else %}center{% endif %} !important;
  }

  /* --- Top text (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-top-text {
    color: {{ top_text_color }} !important;
    font-size: {{ top_text_size_desktop }}px !important;
    margin-bottom: {{ top_text_gap_from_title }}px !important;
  }

  /* --- Heading (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-title {
    {% unless enable_title_gradient %}color: {{ title_text_color }} !important;{% endunless %}
    font-size: {{ title_size_desktop }}px !important;
    line-height: {{ title_line_height_desktop }} !important;
    font-weight: {{ hsp_title_fw }} !important;
    padding-left: {{ title_left_padding_desktop }}px !important;
    padding-right: {{ title_right_padding_desktop }}px !important;
    max-width: {{ title_width_desktop }}% !important;
    font-family: {% if enable_title_custom_font %}'{{ custom_title_font }}', sans-serif{% else %}var(--heading-font, inherit){% endif %} !important;
  }
  {% if enable_title_gradient %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-title {
    background: linear-gradient({{ gradient_degrees }}, {{ gradient_start_color }}, {{ gradient_middle_color }}, {{ gradient_end_color }}) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
  {% endif %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-title .hero-special-word {
    color: {{ special_word_color }} !important;
    -webkit-text-fill-color: {{ special_word_color }} !important;
  }

  /* --- Badge (desktop) --- */
  {% if enable_badge %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .badge-pill {
    font-size: {{ badge_font_size }}px !important;
    color: {{ badge_text_color }} !important;
    margin-bottom: {{ badge_vertical_gap }}px !important;
    border: {{ badge_border_thickness }}px solid {{ badge_border_color }} !important;
    {% if enable_badge_background_gradient %}
      background: linear-gradient({{ badge_background_gradient_degrees }}, {{ badge_background_gradient_1 }}, {{ badge_background_gradient_2 }}) !important;
    {% else %}
      background-color: {{ badge_background_color }} !important;
    {% endif %}
  }
  {% if enable_badge_svg_icon %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .badge-svg-icon {
    width: {{ badge_svg_icon_size_desktop }}px !important;
    margin-right: {{ badge_svg_icon_gap_desktop }}px !important;
    transform: translateY({{ badge_svg_icon_vertical_position_desktop }}px) !important;
  }
  {% endif %}
  {% endif %}

  /* --- Subheading (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-subheading {
    color: {{ subheading_text_color }} !important;
    font-size: {{ subheading_text_size_desktop }}px !important;
    padding-left: {{ subheading_left_padding_desktop }}px !important;
    padding-right: {{ subheading_right_padding_desktop }}px !important;
    margin-top: {{ subheading_vertical_gap }}px !important;
    margin-bottom: {{ subheading_to_button_gap }}px !important;
    font-weight: {{ subheading_font_weight }} !important;
    line-height: {{ subheading_line_height_desktop }} !important;
  }

  /* --- Buttons wrapper + buttons (desktop) --- */
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-buttons-wrapper {
    gap: {{ secondary_button_horizontal_gap }}px !important;
    margin-top: {{ button_vertical_gap }}px !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-button {
    background-color: {{ button_background_color }} !important;
    color: {{ button_text_color }} !important;
    {% if hsp_btn_theme %}
    padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 24px) !important;
    font-size: var(--btn-font-size, 15px) !important;
    border: {% if button_border_enabled %}var(--btn-border-width, 1px){% else %}0px{% endif %} solid {{ button_border_color }} !important;
    border-radius: var(--btn-radius, 6px) !important;
    font-weight: var(--btn-font-weight, 700) !important;
    {% else %}
    padding: {{ button_size_desktop }}px {{ button_width_desktop }}px !important;
    font-size: {{ button_font_size }}px !important;
    border: {% if button_border_enabled %}{{ button_border_thickness }}px{% else %}0px{% endif %} solid {{ button_border_color }} !important;
    border-radius: {{ button_border_radius }}px !important;
    {% if enable_button_custom_font_weight %}font-weight: {{ button_font_weight | default: '700' }} !important;{% endif %}
    {% endif %}
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-button:hover,
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-button:focus-visible {
    background-color: {{ button_background_hover_color }} !important;
    color: {{ button_text_hover_color }} !important;
  }
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-icon {
    font-size: {{ icon_size }}px !important;
    color: {{ button_icon_color }} !important;
  }
  {% if enable_secondary_button %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .secondary-cta-button {
    background-color: {{ secondary_button_background_color }} !important;
    color: {{ secondary_button_text_color }} !important;
    {% if hsp_btn2_theme %}
    padding: var(--btn-padding-y, 12px) var(--btn-padding-x, 24px) !important;
    font-size: var(--btn-font-size, 15px) !important;
    border: var(--btn-border-width, 1px) solid {{ secondary_button_border_color }} !important;
    border-radius: var(--btn-radius, 5px) !important;
    font-weight: var(--btn-font-weight, 400) !important;
    {% else %}
    padding: {{ button_size_desktop }}px {{ button_width_desktop }}px !important;
    font-size: {{ secondary_button_font_size }}px !important;
    border: {{ secondary_button_border_thickness }}px solid {{ secondary_button_border_color }} !important;
    border-radius: {{ secondary_button_border_radius }}px !important;
    font-weight: {{ secondary_button_font_weight }} !important;
    {% endif %}
  }
  {% endif %}

  /* --- Text under button (desktop) --- */
  {% if enable_text_under_button %}
  #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .text-under-button {
    margin-top: {{ text_under_button_gap }}px !important;
    font-size: {{ text_under_button_font_size }}px !important;
    color: {{ text_under_button_color }} !important;
    font-weight: {{ text_under_button_font_weight }} !important;
  }
  {% endif %}

  /* ===================== MOBILE OVERRIDES ===================== */
  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }}.hero-section {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
      min-height: {{ background_height_mobile }}vh !important;
      align-items: {{ section.settings.elements_alignment_mobile }} !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-content {
      width: 100% !important;
      align-items: {{ section.settings.elements_alignment_mobile }} !important;
      text-align: {% if section.settings.elements_alignment_mobile == 'flex-start' %}left{% elsif section.settings.elements_alignment_mobile == 'flex-end' %}right{% else %}center{% endif %} !important;
      {% if section.settings.elements_alignment_mobile == 'flex-start' %}
        padding-left: {{ section.settings.hero_content_padding_left_mobile }}px !important; padding-right: 0px !important;
      {% elsif section.settings.elements_alignment_mobile == 'flex-end' %}
        padding-left: 0px !important; padding-right: {{ section.settings.hero_content_padding_right_mobile }}px !important;
      {% else %}
        padding-left: 0px !important; padding-right: 0px !important;
      {% endif %}
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-top-text {
      font-size: {{ top_text_size_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-kicker {
      align-items: {{ section.settings.elements_alignment_mobile }} !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .referral-message {
      text-align: {% if section.settings.elements_alignment_mobile == 'flex-start' %}left{% elsif section.settings.elements_alignment_mobile == 'flex-end' %}right{% else %}center{% endif %} !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-title {
      font-size: {{ title_size_mobile }}px !important;
      line-height: {{ title_line_height_mobile }} !important;
      padding-left: {{ title_left_padding_mobile }}px !important;
      padding-right: {{ title_right_padding_mobile }}px !important;
    }
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .hero-subheading {
      font-size: {{ subheading_text_size_mobile }}px !important;
      padding-left: {{ subheading_left_padding_mobile }}px !important;
      padding-right: {{ subheading_right_padding_mobile }}px !important;
      line-height: {{ subheading_line_height_mobile }} !important;
    }
    {% if enable_badge and enable_badge_svg_icon %}
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .badge-svg-icon {
      width: {{ badge_svg_icon_size_mobile }}px !important;
      margin-right: {{ badge_svg_icon_gap_mobile }}px !important;
      transform: translateY({{ badge_svg_icon_vertical_position_mobile }}px) !important;
    }
    {% endif %}
    {% unless hsp_btn_theme %}
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .cta-button {
      padding: {{ button_size_mobile }}px {{ button_width_mobile }}px !important;
      font-size: {{ button_font_size }}px !important;
    }
    {% endunless %}
    {% if enable_secondary_button %}
    {% unless hsp_btn2_theme %}
    #shopify-section-{{ section.id }} #unique-hero-section-{{ section.id }} .secondary-cta-button {
      padding: {{ button_size_mobile }}px {{ button_width_mobile }}px !important;
      font-size: {{ secondary_button_font_size }}px !important;
    }
    {% endunless %}
    {% endif %}
  }
{% comment %}{% endcomment %}</style>

<section
  id="unique-hero-section-{{ section.id }}"
  class="hero-section color-{{ color_scheme }} gradient"
  style="
    /* Desktop Settings */
    --hero-padding-top: {{ section.settings.padding_top }}px !important;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px !important;
    --hero-top-text-size-desktop: {{ top_text_size_desktop }}px !important;
    --hero-title-size-desktop: {{ title_size_desktop }}px !important;
    --hero-title-left-padding-desktop: {{ title_left_padding_desktop }}px !important;
    --hero-title-right-padding-desktop: {{ title_right_padding_desktop }}px !important;
    --button-size-desktop: {{ button_size_desktop }}px !important;
    --button-width-desktop: {{ button_width_desktop }}px !important;
    --hero-title-line-height-desktop: {{ title_line_height_desktop }} !important;
    --button-size-mobile: {{ button_size_mobile }}px !important;
    --button-width-mobile: {{ button_width_mobile }}px !important;
    --button-background-color: {{ button_background_color }} !important;
    --title-font-weight: {{ hsp_title_fw }} !important;
    --button-background-hover-color: {{ button_background_hover_color }} !important;
    --button-text-color: {{ button_text_color }} !important;
    --button-text-hover-color: {{ button_text_hover_color }} !important;
    --button-icon-color: {{ button_icon_color }} !important;
    --hero-title-width-desktop: {{ title_width_desktop }}% !important;
    --hero-background-brightness: {{ background_brightness }} !important;
    --hero-section-height-desktop: calc({{ background_height_desktop }}vh) !important;
    --hero-section-height-mobile: calc({{ background_height_mobile }}vh) !important;
    --button-border-radius: {{ button_border_radius }}px !important;
    --button-border-color: {{ button_border_color }} !important;
    --button-border-thickness: {% if button_border_enabled %}{{ button_border_thickness }}px{% else %}0px{% endif %} !important;
    /* Button font weight — only emitted when the merchant toggles
       "Enable Button Custom Font Weight" on. Otherwise the CSS
       fallback (700) takes over. */
    {% if enable_button_custom_font_weight %}--button-font-weight: {{ button_font_weight | default: '700' }} !important;{% endif %}
    --elements-alignment-desktop: {{ section.settings.elements_alignment_desktop }} !important;
    --text-alignment-desktop: {% if section.settings.elements_alignment_desktop == 'flex-start' %}left{% elsif section.settings.elements_alignment_desktop == 'flex-end' %}right{% else %}center{% endif %} !important;
    {% if section.settings.desktop_width and section.settings.desktop_width > 0 %}--hero-content-width-desktop: {{ section.settings.desktop_width }}px !important;{% endif %}

    /* Mobile Settings */
    --hero-padding-top-mobile: {{ section.settings.padding_top_mobile }}px !important;
    --hero-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px !important;
    --hero-top-text-size-mobile: {{ top_text_size_mobile }}px !important;
    --hero-title-size-mobile: {{ title_size_mobile }}px !important;
    --hero-title-left-padding-mobile: {{ title_left_padding_mobile }}px !important;
    --hero-title-right-padding-mobile: {{ title_right_padding_mobile }}px !important;
    --hero-title-line-height-mobile: {{ title_line_height_mobile }} !important;
    --text-alignment-mobile: {% if section.settings.elements_alignment_mobile == 'flex-start' %}left{% elsif section.settings.elements_alignment_mobile == 'flex-end' %}right{% else %}center{% endif %} !important;
    --elements-alignment-mobile: {{ section.settings.elements_alignment_mobile }} !important;

    /* Icon Size */
    --icon-size: {{ icon_size }}px !important;

    /* NEW: Top Text gap to next block (Referral Kicker if enabled) */
    --top-text-gap-from-title: {{ top_text_gap_from_title }}px !important;

    /* NEW: Referral Kicker custom properties */
    --referral-to-title-gap-desktop: {{ referral_to_title_gap_desktop }}px !important;
    --referral-to-title-gap-mobile: {{ referral_to_title_gap_mobile }}px !important;
    --referral-inline-gap-desktop: {{ referral_inline_gap_desktop }}px !important;
    --referral-inline-gap-mobile: {{ referral_inline_gap_mobile }}px !important;
    --ref-avatar-size-desktop: {{ ref_avatar_size_desktop }}px !important;
    --ref-avatar-size-mobile: {{ ref_avatar_size_mobile }}px !important;
    --ref-avatar-overlap-desktop: {{ ref_avatar_overlap_desktop }} !important;
    --ref-avatar-overlap-mobile: {{ ref_avatar_overlap_mobile }} !important;
    --ref-avatar-border-thickness: {{ ref_avatar_border_thickness }}px !important;
    --ref-avatar-border-color: {{ ref_avatar_border_color }} !important;
    --referral-text-color: {{ referral_text_color }} !important;
    --referral-accent-color: {{ referral_accent_color }} !important;

    /* NEW: Headline Special Word Color */
    --special-word-color: {{ special_word_color }} !important;

    /* NEW: Badge SVG icon vertical offsets */
    --badge-svg-icon-translateY-desktop: {{ badge_svg_icon_vertical_position_desktop }}px !important;
    --badge-svg-icon-translateY-mobile: {{ badge_svg_icon_vertical_position_mobile }}px !important;

    /* Gradient Settings for Title */
    {% if enable_title_gradient %}
      --gradient-start-color: {{ gradient_start_color }} !important;
      --gradient-middle-color: {{ gradient_middle_color }} !important;
      --gradient-end-color: {{ gradient_end_color }} !important;
      --gradient-degrees: {{ gradient_degrees }} !important;
    {% endif %}

    /* Button Hover Animation */
    --button-hover-animation: {{ button_hover_animation }} !important;

    /* Custom Fonts */
    --custom-text-font: inherit !important;
    --custom-title-font: {% if enable_title_custom_font %}'{{ custom_title_font }}', sans-serif{% else %}var(--heading-font, inherit){% endif %} !important;

    /* Conditional Padding Based on Desktop Alignment */
    {% if section.settings.elements_alignment_desktop == 'flex-start' %}
      --hero-content-padding-left-desktop: {{ section.settings.hero_content_padding_left_desktop }}px !important;
      --hero-content-padding-right-desktop: 0px !important;
    {% elsif section.settings.elements_alignment_desktop == 'flex-end' %}
      --hero-content-padding-left-desktop: 0px !important;
      --hero-content-padding-right-desktop: {{ section.settings.hero_content_padding_right_desktop }}px !important;
    {% else %}
      --hero-content-padding-left-desktop: 0px !important;
      --hero-content-padding-right-desktop: 0px !important;
    {% endif %}

    /* Conditional Padding Based on Mobile Alignment */
    {% if section.settings.elements_alignment_mobile == 'flex-start' %}
      --hero-content-padding-left-mobile: {{ section.settings.hero_content_padding_left_mobile }}px !important;
      --hero-content-padding-right-mobile: 0px !important;
    {% elsif section.settings.elements_alignment_mobile == 'flex-end' %}
      --hero-content-padding-left-mobile: 0px !important;
      --hero-content-padding-right-mobile: {{ section.settings.hero_content_padding_right_mobile }}px !important;
    {% else %}
      --hero-content-padding-left-mobile: 0px !important;
      --hero-content-padding-right-mobile: 0px !important;
    {% endif %}

    /* Video Brightness Variable */
    --hero-video-brightness: {{ video_brightness }};

    /* Image Over Text Variables (Desktop & Mobile) */
    --image-over-text-width-desktop: {{ image_over_text_width_desktop }}px !important;
    --image-over-text-height-desktop: {{ image_over_text_height_desktop }}px !important;
    --image-over-text-width-mobile: {{ image_over_text_width_mobile }}px !important;
    --image-over-text-height-mobile: {{ image_over_text_height_mobile }}px !important;
    --image-over-text-vertical-position-desktop: {{ image_over_text_vertical_position_desktop }}px !important;
    --image-over-text-vertical-position-mobile: {{ image_over_text_vertical_position_mobile }}px !important;

    /* Pill Badge Custom Properties */
    {% if enable_badge %}
      --badge-font-size: {{ badge_font_size }}px !important;
      --badge-text-color: {{ badge_text_color }} !important;
      --badge-background-color: {{ badge_background_color }} !important;
      --badge-vertical-gap: {{ badge_vertical_gap }}px !important;
      --badge-border-thickness: {{ badge_border_thickness }}px !important;
      --badge-border-color: {{ badge_border_color }} !important;
    {% endif %}

    {% if enable_badge_background_gradient %}
      --badge-background-gradient-1: {{ badge_background_gradient_1 }} !important;
      --badge-background-gradient-2: {{ badge_background_gradient_2 }} !important;
      --badge-background-gradient-degrees: {{ badge_background_gradient_degrees }} !important;
    {% endif %}

    /* Badge SVG Icon Sizes */
    {% if enable_badge_svg_icon %}
      --badge-svg-icon-size-desktop: {{ badge_svg_icon_size_desktop }}px !important;
      --badge-svg-icon-size-mobile: {{ badge_svg_icon_size_mobile }}px !important;
      --badge-svg-icon-gap-desktop: {{ badge_svg_icon_gap_desktop }}px !important;
      --badge-svg-icon-gap-mobile: {{ badge_svg_icon_gap_mobile }}px !important;
    {% endif %}

    /* Subheading Custom Properties */
    --subheading-text-color: {{ subheading_text_color }} !important;
    --subheading-text-size-desktop: {{ subheading_text_size_desktop }}px !important;
    --subheading-text-size-mobile: {{ subheading_text_size_mobile }}px !important;
    --subheading-left-padding-desktop: {{ subheading_left_padding_desktop }}px !important;
    --subheading-right-padding-desktop: {{ subheading_right_padding_desktop }}px !important;
    --subheading-left-padding-mobile: {{ subheading_left_padding_mobile }}px !important;
    --subheading-right-padding-mobile: {{ subheading_right_padding_mobile }}px !important;
    --subheading-vertical-gap: {{ subheading_vertical_gap }}px !important;
    --subheading-to-button-gap: {{ subheading_to_button_gap }}px !important;
    --subheading-font-weight: {{ subheading_font_weight }} !important;
    --subheading-line-height-desktop: {{ subheading_line_height_desktop }} !important;
    --subheading-line-height-mobile: {{ subheading_line_height_mobile }} !important;

    /* Vertical Gap Between Button And Texts */
    --button-vertical-gap: {{ button_vertical_gap }}px !important;

    /* Text Under Button custom properties */
    {% if enable_text_under_button %}
      --text-under-button-gap: {{ text_under_button_gap }}px !important;
      --text-under-button-font-size: {{ text_under_button_font_size }}px !important;
      --text-under-button-color: {{ text_under_button_color }} !important;
      --text-under-button-font-weight: {{ text_under_button_font_weight }} !important;
    {% endif %}

    /* Secondary Button custom properties */
    {% if enable_secondary_button %}
      --secondary-button-background-color: {{ secondary_button_background_color }} !important;
      --secondary-button-text-color: {{ secondary_button_text_color }} !important;
      --secondary-button-background-hover-color: {{ secondary_button_background_hover_color }} !important;
      --secondary-button-text-hover-color: {{ secondary_button_text_hover_color }} !important;
      --secondary-button-border-radius: {{ secondary_button_border_radius }}px !important;
      --secondary-button-border-thickness: {{ secondary_button_border_thickness }}px !important;
      --secondary-button-border-color: {{ secondary_button_border_color }} !important;
      --secondary-button-horizontal_gap: {{ secondary_button_horizontal_gap }}px !important;
      --secondary-button-padding-vertical: {{ button_size_desktop }}px !important;
      --secondary-button-padding-horizontal: {{ button_width_desktop }}px !important;
      --secondary-button-font-weight: {{ secondary_button_font_weight }} !important;
    {% endif %}
  "
>
  {% comment %}
    ======================================================
    BACKGROUND LOGIC
    ======================================================
  {% endcomment %}

  {% if enable_background_color %}
    {% if enable_background_color_gradient %}
      <!-- GRADIENT BACKGROUND -->
      <div
        class="hero-background-color {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        style="
          background: linear-gradient(
            {{ background_color_gradient_degrees }},
            {{ background_color_gradient_1 }},
            {{ background_color_gradient_2 }},
            {{ background_color_gradient_3 }}
          );
        "
      >
      </div>
    {% else %}
      <!-- SOLID COLOR BACKGROUND -->
      <div
        class="hero-background-color {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        style="background-color: {{ background_color }};"
      >
      </div>
    {% endif %}
  {% elsif video_file != blank or video_url != blank %}
    <!-- VIDEO BACKGROUND for Desktop (uploaded file takes priority over URL) -->
    {% if video_file != blank %}
      <video
        class="hero-video {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        autoplay
        muted
        loop
        playsinline
        {% if video_file.preview_image %}poster="{{ video_file.preview_image | image_url: width: 1600 }}"{% endif %}
      >
        {% for source in video_file.sources %}
          <source src="{{ source.url }}" type="video/{{ source.format }}">
        {% endfor %}
      </video>
    {% else %}
      <video
        class="hero-video {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        autoplay
        muted
        loop
        playsinline
        src="{{ video_url }}"
      ></video>
    {% endif %}
  {% elsif enable_split_images %}
    <!-- SPLIT IMAGES for Desktop -->
    <div class="split-images-container {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}">
      {% if split_image_left != blank %}
        <img
          src="{{ split_image_left | image_url: width: 1200 }}"
          srcset="{{ split_image_left | image_url: width: 600 }} 600w, {{ split_image_left | image_url: width: 900 }} 900w, {{ split_image_left | image_url: width: 1200 }} 1200w, {{ split_image_left | image_url: width: 1600 }} 1600w"
          sizes="50vw"
          width="{{ split_image_left.width }}" height="{{ split_image_left.height }}"
          alt="{{ 'accessibility.split_left_image' | t }}" loading="eager" fetchpriority="high" decoding="async">
      {% else %}
        <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.split_left_image' | t }}" loading="eager" decoding="async">
      {% endif %}
      {% if split_image_right != blank %}
        <img
          src="{{ split_image_right | image_url: width: 1200 }}"
          srcset="{{ split_image_right | image_url: width: 600 }} 600w, {{ split_image_right | image_url: width: 900 }} 900w, {{ split_image_right | image_url: width: 1200 }} 1200w, {{ split_image_right | image_url: width: 1600 }} 1600w"
          sizes="50vw"
          width="{{ split_image_right.width }}" height="{{ split_image_right.height }}"
          alt="{{ 'accessibility.split_right_image' | t }}" loading="eager" fetchpriority="high" decoding="async">
      {% else %}
        <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg" alt="{{ 'accessibility.split_right_image' | t }}" loading="eager" decoding="async">
      {% endif %}
    </div>
  {% else %}
    <!-- SINGLE BACKGROUND IMAGE for Desktop -->
    {% if background_image != blank %}
      <img
        class="hero-background {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        src="{{ background_image | image_url: width: 1600 }}"
        srcset="{{ background_image | image_url: width: 750 }} 750w, {{ background_image | image_url: width: 1100 }} 1100w, {{ background_image | image_url: width: 1500 }} 1500w, {{ background_image | image_url: width: 1900 }} 1900w, {{ background_image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        width="{{ background_image.width }}" height="{{ background_image.height }}"
        alt="" loading="eager" fetchpriority="high" decoding="async">
    {% else %}
      <img
        class="hero-background {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
        alt="" loading="eager" decoding="async">
    {% endif %}
  {% endif %}

  {%- comment -%}
    Mobile background image.
    • If a Background Image (Mobile) is uploaded → use it.
    • If not → fall back to the desktop Background Image so mobile is never empty.
    • If neither exists but Split Images is on → fall back to the left split image.
    Only render the <img> when there is an actual image to show (no external
    placeholder). On mobile the desktop `.hero-background` is hidden via CSS and
    this `.hero-background-mobile` is shown.
  {%- endcomment -%}
  {%- assign hero_mobile_bg = background_image_mobile -%}
  {%- if hero_mobile_bg == blank -%}
    {%- assign hero_mobile_bg = background_image -%}
  {%- endif -%}
  {%- if hero_mobile_bg == blank and enable_split_images -%}
    {%- assign hero_mobile_bg = split_image_left -%}
  {%- endif -%}
  {%- comment -%}
    Suppress the mobile background image ONLY when a real video actually plays
    on mobile, or a background color is enabled. The previous check tested
    `enable_video_on_mobile` alone — but that flag stays true even when NO video
    is uploaded, so the mobile image was hidden and the hero rendered white.
  {%- endcomment -%}
  {%- assign hero_has_video = false -%}
  {%- if video_file != blank or video_url != blank -%}
    {%- assign hero_has_video = true -%}
  {%- endif -%}
  {%- assign suppress_mobile_bg = false -%}
  {%- if hero_has_video and enable_video_on_mobile -%}
    {%- assign suppress_mobile_bg = true -%}
  {%- endif -%}
  {%- if enable_background_color -%}
    {%- assign suppress_mobile_bg = true -%}
  {%- endif -%}
  {% unless suppress_mobile_bg %}
    {% if hero_mobile_bg != blank %}
      <img
        class="hero-background-mobile {% if image_reveal_animation != 'none' %}reveal-image-{{ image_reveal_animation }}{% endif %}"
        src="{{ hero_mobile_bg | image_url: width: 1100 }}"
        srcset="{{ hero_mobile_bg | image_url: width: 480 }} 480w, {{ hero_mobile_bg | image_url: width: 750 }} 750w, {{ hero_mobile_bg | image_url: width: 1100 }} 1100w, {{ hero_mobile_bg | image_url: width: 1500 }} 1500w"
        sizes="100vw"
        width="{{ hero_mobile_bg.width }}" height="{{ hero_mobile_bg.height }}"
        alt="" loading="eager" fetchpriority="high" decoding="async">
    {% endif %}
  {% endunless %}

  <div class="hero-content {% if section.settings.texts_reveal_animation != 'none' %}reveal-texts-{{ section.settings.texts_reveal_animation }}{% endif %}">

    {% if top_text %}
      <p class="hero-top-text">{{ top_text }}</p>
    {% endif %}

    {% if enable_referral_kicker %}
      {% assign referral_message_raw = referral_text %}
      {% if referral_accent_text != blank %}
        {% capture ref_accent_open %}<span class='referral-accent'>{% endcapture %}
        {% capture ref_accent_html %}{{ ref_accent_open }}{{ referral_accent_text }}</span>{% endcapture %}
        {% assign referral_message_raw = referral_message_raw | replace: referral_accent_text, ref_accent_html %}
      {% endif %}
      <div class="referral-kicker{% if referral_display_type == 'stars' %}{% if referral_stars_position == 'right' %} is-stars-right{% elsif referral_stars_position == 'left' %} is-stars-left{% else %} is-stars{% endif %}{% endif %}" style="display:flex !important;">
        {% if referral_display_type == 'stars' %}
          <div class="referral-stars" role="img" aria-label="{{ ref_star_rating }} out of 5 stars">
            <span class="stars-base" aria-hidden="true">★★★★★</span>
            <span class="stars-fill" aria-hidden="true">★★★★★</span>
          </div>
        {% else %}
          <div class="referral-avatars">
            {% if ref_avatar_1 != blank %}
              <img loading="lazy" src="{{ ref_avatar_1 | img_url: '120x120' }}" alt="referral avatar 1">
            {% endif %}
            {% if ref_avatar_2 != blank %}
              <img loading="lazy" src="{{ ref_avatar_2 | img_url: '120x120' }}" alt="referral avatar 2">
            {% endif %}
            {% if ref_avatar_3 != blank %}
              <img loading="lazy" src="{{ ref_avatar_3 | img_url: '120x120' }}" alt="referral avatar 3">
            {% endif %}
            {% if ref_avatar_4 != blank %}
              <img loading="lazy" src="{{ ref_avatar_4 | img_url: '120x120' }}" alt="referral avatar 4">
            {% endif %}
            {% if ref_avatar_5 != blank %}
              <img loading="lazy" src="{{ ref_avatar_5 | img_url: '120x120' }}" alt="referral avatar 5">
            {% endif %}
          </div>
        {% endif %}
        <div class="referral-message">{{ referral_message_raw }}</div>
      </div>
    {% endif %}

    {% if enable_badge %}
      <div class="badge-pill">
        {% if enable_badge_svg_icon and badge_svg_code != blank %}
          <span class="badge-svg-icon">
            {{ badge_svg_code | strip }}
          </span>
        {% endif %}
        {{ badge_text }}
      </div>
    {% endif %}

    {% if title_text != blank %}
      {%- assign title_processed = title_text -%}
      {% if enable_special_word and special_word != blank %}
        {% capture special_open %}<span class='hero-special-word'>{% endcapture %}
        {% capture special_html %}{{ special_open }}{{ special_word }}</span>{% endcapture %}
        {% assign title_processed = title_processed | replace: special_word, special_html %}
      {% endif %}

      <h1 class="hero-title">{{ title_processed | newline_to_br }}</h1>
    {% endif %}

    {% if subheading_text %}
      <p class="hero-subheading">{{ subheading_text }}</p>
    {% endif %}

    {% if enable_image_over_text and image_over_text != blank %}
      <div
        class="image-over-text-container"
        {% if image_over_text_block %}{{ image_over_text_block.shopify_attributes }}{% endif %}
      >
        <img
          class="image-over-text{% if image_over_text_constant_animation != 'none' %} image-over-text-constant-{{ image_over_text_constant_animation }}{% endif %}{% if image_over_text_hover_animation != 'none' %} image-over-text-hover-{{ image_over_text_hover_animation }}{% endif %}"
          src="{{ image_over_text | image_url: width: 800 }}"
          srcset="{{ image_over_text | image_url: width: 300 }} 300w, {{ image_over_text | image_url: width: 500 }} 500w, {{ image_over_text | image_url: width: 800 }} 800w, {{ image_over_text | image_url: width: 1100 }} 1100w, {{ image_over_text | image_url: width: 1500 }} 1500w"
          sizes="(max-width: 991px) {{ image_over_text_width_mobile | default: 100 }}px, {{ image_over_text_width_desktop | default: 200 }}px"
          width="{{ image_over_text.width }}" height="{{ image_over_text.height }}"
          style="--iot-const-dur: {{ image_over_text_block.settings.image_over_text_constant_duration | default: 3000 }}ms; --iot-hover-dur: {{ image_over_text_block.settings.image_over_text_hover_duration | default: 500 }}ms; -webkit-user-drag: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;"
          draggable="false" oncontextmenu="return false"
          alt="{{ image_over_text.alt | default: 'Image over text' | escape }}"
          loading="eager" decoding="async">
      </div>
    {% endif %}

    {% if has_primary_button or enable_secondary_button %}
      <div class="cta-buttons-wrapper">
        {% if has_primary_button %}
          <!-- Primary Button -->
          <a
            href="{{ button_link }}"
            class="cta-button {% if button_hover_animation != 'none' %}hover-animation-{{ button_hover_animation | replace: ' ', '-' | downcase }}{% endif %}"
            role="button"
          >
            {% if selected_icon != 'none' and selected_icon != blank %}
              <span class="material-icons cta-icon">{{ selected_icon }}</span>
            {% endif %}
            <span class="cta-text">{{ button_text }}</span>
          </a>
        {% endif %}

        <!-- Secondary Button (conditionally shown) -->
        {% if enable_secondary_button %}
          <a
            href="{{ secondary_button_link }}"
            class="secondary-cta-button"
            role="button"
          >
            <span class="secondary-cta-text">{{ secondary_button_text }}</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if enable_text_under_button %}
      <p class="text-under-button">
        {{ text_under_button }}
      </p>
    {% endif %}
  </div>
</section>



<!-- Scoped JavaScript -->
<script>
  (function () {
    var hspSid = {{ section.id | json }};
    function hspInit() {
      const heroSection = document.getElementById('unique-hero-section-{{ section.id }}');
      if (!heroSection || heroSection.dataset.hspInit) return;
      heroSection.dataset.hspInit = '1';
      // Main CTA Button
      const ctaButton = heroSection.querySelector('.cta-button');
      if (ctaButton) {
        ctaButton.addEventListener('click', function () {
          console.log('Main CTA Button clicked within Hero Section');
        });
      }

      // Secondary CTA Button
      const secondaryCtaButton = heroSection.querySelector('.secondary-cta-button');
      if (secondaryCtaButton) {
        secondaryCtaButton.addEventListener('click', function () {
          console.log('Secondary CTA Button clicked within Hero Section');
        });
      }

      /* ──────────────────────────────────────────────────────────
         Mouse-move parallax effect.

         Previous version:
           • Only ran on `.hero-background` (desktop image only)
           • No `mouseleave` — bg stayed in last position when mouse left
           • No requestAnimationFrame throttle — every pixel move
             triggered a layout-affecting style write
           • No baseline scale — bg only scaled to 1.03 INSIDE the
             handler, so the first mousemove caused a visible jump

         New version:
           • Targets BOTH `.hero-background` and `.hero-background-mobile`
             so the effect works on tablets / desktop preview at every
             breakpoint
           • Baseline `scale(1.05)` applied immediately on init, then
             the handler only translates within that — no jump
           • `mouseleave` smoothly returns to center
           • RAF-throttled so we paint at most once per frame regardless
             of cursor speed
           • `@media (hover: none)` short-circuit: touch devices skip the
             parallax entirely (mousemove can fire spuriously on touch)
         ────────────────────────────────────────────────────────── */
      const enableParallax = {{ enable_parallax_mouse | json }};
      const supportsHover  = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reducedMotion  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parallaxTargets = Array.from(
        heroSection.querySelectorAll('.hero-background, .hero-background-mobile')
      );

      if (enableParallax && supportsHover && !reducedMotion && parallaxTargets.length) {
        const BASE_SCALE = 1.05;
        const STRENGTH   = 12; /* max pixels of translation in either direction */
        let ticking = false;
        let lastX = 0, lastY = 0;

        const apply = function() {
          ticking = false;
          parallaxTargets.forEach(function(el) {
            el.style.transform = 'translate(' + lastX.toFixed(2) + 'px, ' + lastY.toFixed(2) + 'px) scale(' + BASE_SCALE + ')';
          });
        };
        const schedule = function() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(apply);
        };

        /* Lock the baseline scale immediately so the first mousemove
           doesn't cause a 5% visual jump from scale(1) → scale(1.05). */
        parallaxTargets.forEach(function(el) {
          el.style.transform = 'translate(0px, 0px) scale(' + BASE_SCALE + ')';
        });

        heroSection.addEventListener('mousemove', function(e) {
          const rect = heroSection.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const dx = (e.clientX - rect.left) / rect.width  - 0.5; /* -0.5 … +0.5 */
          const dy = (e.clientY - rect.top)  / rect.height - 0.5;
          /* Invert so background moves OPPOSITE the cursor — feels
             like the camera tracking the cursor, the canonical
             parallax direction. */
          lastX = -dx * STRENGTH;
          lastY = -dy * STRENGTH;
          schedule();
        }, { passive: true });

        heroSection.addEventListener('mouseleave', function() {
          lastX = 0;
          lastY = 0;
          schedule();
        });
      }
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', hspInit); } else { hspInit(); }
    if (!window['__hspBound' + hspSid]) {
      window['__hspBound' + hspSid] = true;
      document.addEventListener('storelib:section-load', function (e) {
        if (e.detail && e.detail.sectionId && e.detail.sectionId !== hspSid) return;
        hspInit();
      });
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId && e.detail.sectionId !== hspSid) return;
        hspInit();
      });
    }
  })();
{% comment %}{% endcomment %}</script>

