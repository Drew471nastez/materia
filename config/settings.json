  "custom_css": "/* Variant pickers, site wide: calm and flat. No lift, scale, pulse or bounce on hover, focus, click or when chosen. Colours still come from each block's own settings or the colour scheme. */\n:where(variant-picker, variant-radios, variant-selects, [class*=\"variant\"], [class*=\"swatch\"], [class*=\"vsp\"], [class*=\"option-value\"], [data-variant-picker]) :is(label, button, a, input, span, div, li, img) {\n  transform: none !important;\n  animation: none !important;\n  translate: none !important;\n  scale: none !important;\n  transition-property: background-color, border-color, color, box-shadow, opacity !important;\n  transition-duration: 180ms !important;\n  transition-timing-function: ease !important;\n}\n:where(variant-picker, variant-radios, variant-selects, [class*=\"variant\"], [class*=\"swatch\"], [class*=\"vsp\"], [class*=\"option-value\"], [data-variant-picker]) :is(label, button, a, div, li):is(:hover, :active, :focus, :focus-visible) {\n  transform: none !important;\n  top: auto;\n}\n/* No grey tile behind round colour swatches */\n:where([class*=\"swatch\"], [class*=\"color-swatch\"], [class*=\"colour-swatch\"]) :is(label, .swatch-wrapper, [class*=\"swatch-item\"], [class*=\"swatch__item\"]) {\n  background-color: transparent !important;\n}\n/* Keyboard focus stays visible without moving anything */\n:where(variant-picker, variant-radios, [class*=\"variant\"], [class*=\"swatch\"], [class*=\"vsp\"]) :is(label, button):focus-visible {\n  outline: 2px solid currentColor;\n  outline-offset: 2px;\n}\n@media (prefers-reduced-motion: reduce) {\n  :where(variant-picker, variant-radios, [class*=\"variant\"], [class*=\"swatch\"], [class*=\"vsp\"]) * { transition: none !important; }\n}",
