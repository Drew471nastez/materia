<template compat="shopify">
{%- comment -%}
  Materia Themes. The eyebrow, heading and subheading blocks of Testimonial
  Wall and Testimonial With Product, in the order the creator put them. A
  block with no words is printed hidden, so words typed in the builder show
  at once. The heading is the section's h2. Colours follow the colour scheme
  until the block's custom styling is on.
  section: the section.
{%- endcomment -%}
<div class="r7t__head">
  {%- for b in section.blocks -%}
    {%- assign bs = b.settings -%}
    {%- unless b.type == 'eyebrow' or b.type == 'heading' or b.type == 'subheading' -%}{%- continue -%}{%- endunless -%}
    {%- capture b_attrs -%}data-r7t-block="{{ b.id }}" data-r7t-type="{{ b.type }}"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %} {{ b.shopify_attributes }}{%- endcapture -%}
    {%- case b.type -%}
      {%- when 'eyebrow' -%}
        <p class="r7t__eyebrow" {{ b_attrs }} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-text)' %};">{{ bs.text | escape }}</p>
      {%- when 'heading' -%}
        <h2 class="r7t__heading" {{ b_attrs }} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-heading)' %};--b-fs-d: {{ bs.size | default: 40 }}px;--b-fs-m: {{ bs.size_mobile | default: 26 }}px;">{{ bs.text }}</h2>
      {%- when 'subheading' -%}
        <div class="r7t__sub" {{ b_attrs }} style="--b-c: {% render 'live-testimonials-color', on: bs.enable_custom_style, color: bs.color, fallback: 'var(--color-text)' %};--b-fs: {{ bs.size | default: 16 }}px;">{{ bs.text }}</div>
    {%- endcase -%}
  {%- endfor -%}
</div>
</template>
