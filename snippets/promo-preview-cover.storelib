<template compat="shopify">
{%- comment -%}Editor-only cover inside the banner's real media/content layout. Never shown to visitors.{%- endcomment -%}
{% if kind == "strip" %}<div class="promo-preview-cover" role="img" aria-label="{{ name | escape }} layout preview" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:16px;width:100%;color:var(--color-heading);font-family:var(--body-font);font-size:var(--body-font-size,16px);"><span>{{ name | escape }}</span><span aria-hidden="true" style="display:block;width:130px;height:44px;border-radius:var(--btn-radius,6px);background:var(--btn-primary-bg-color);"></span></div>{% else %}<div class="promo-preview-cover" role="img" aria-label="{{ name | escape }} layout preview" style="width:100%;max-width:600px;text-align:inherit;color:var(--color-heading);font-family:var(--heading-font);">
 <div style="font-size:var(--h2-size,32px);font-weight:var(--heading-weight,600);line-height:var(--heading-line-height,1.2);">{{ name | escape }}</div>
 <div aria-hidden="true" style="margin-top:20px;display:grid;gap:9px;"><span style="height:9px;background:currentColor;opacity:.25;width:88%;"></span><span style="height:9px;background:currentColor;opacity:.25;width:64%;"></span></div>
 <div aria-hidden="true" style="margin-top:24px;width:150px;max-width:100%;height:46px;display:inline-block;border-radius:var(--btn-radius,6px);background:var(--btn-primary-bg-color);border:var(--btn-border-width,1px) solid var(--btn-primary-border-color);"></div>
</div>
{% endif %}
</template>
