<template compat="shopify">
{%- comment -%}
  Materia Themes. One Benefit block of Image With Text Benefits: icon,
  heading (h3) and text. Colours and sizes come from the section.
{%- endcomment -%}
{%- assign bb = block.settings -%}
{%- assign src = bb.icon_source | default: 'library' -%}
<div class="{{ p }}__benefit" {% render 'media-benefits-block', block: block %}>
  <div class="{{ p }}__benefit-icon" aria-hidden="true"{% if src == 'none' %} hidden{% endif %}>{%- render 'iwb-icon', bb: bb -%}</div>
  <div class="{{ p }}__benefit-body">
    <h3 class="{{ p }}__benefit-heading"{% if bb.heading == blank %} hidden{% endif %}>{{ bb.heading }}</h3>
    <div class="{{ p }}__benefit-text"{% if bb.text == blank %} hidden{% endif %}>{{ bb.text }}</div>
  </div>
</div>
</template>
