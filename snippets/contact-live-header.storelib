<template compat="shopify">
{%- comment -%}
  Materia Themes. The header of Google map and Newsletter: the older Heading
  and Description settings (shown only when the section has no heading or
  subheading block), then the heading and subheading blocks in their order.
  section: the section. anim: the reveal ('none' when off). size_class: the
  Heading size class (h3, h1-size or empty). sec_font: Enable custom fonts
  on the section. data-own-font / data-own-weight / data-own-size keep a
  custom font, weight or size ahead of Theme settings > Typography priority;
  live-contact.js toggles them and the --ch-* values on live edits.
  {% render 'contact-live-header', section: section, anim: anim, size_class: size_class, sec_font: sec_font %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign legacy_heading = false
  if heading_blocks.size == 0 and st.heading != blank
    assign legacy_heading = true
  endif
  assign legacy_sub = false
  if sub_blocks.size == 0 and st.description != blank
    assign legacy_sub = true
  endif
  assign order = 0
-%}
<style>
  #shopify-section-{{ section.id }} .ct-header > :not([hidden]) ~ :not([hidden]) { margin-top: 1rem; }
  #shopify-section-{{ section.id }} .ct-header [data-ct-block][hidden],
  #shopify-section-{{ section.id }} .ct-header[hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .ct-h { color: var(--ch-c, var(--color-heading)); margin-block: 0; }
  #shopify-section-{{ section.id }} .ct-h[data-own-font] { font-family: var(--ch-ff, var(--ct-hf, var(--heading-font))); }
  #shopify-section-{{ section.id }} .ct-h[data-own-weight] { font-weight: var(--ch-fw, var(--heading-weight)); }
  #shopify-section-{{ section.id }} .ct-h[data-own-size] { font-size: var(--ch-fs-m); line-height: var(--ch-lh); letter-spacing: var(--ch-ls); }
  #shopify-section-{{ section.id }} .ct-s { color: var(--ch-c, inherit); }
  #shopify-section-{{ section.id }} .ct-s[data-own-font] { font-family: var(--ch-ff, var(--ct-bf, var(--body-font))); }
  #shopify-section-{{ section.id }} .ct-s[data-own-weight] { font-weight: var(--ch-fw); }
  #shopify-section-{{ section.id }} .ct-s[data-own-size] { font-size: var(--ch-fs); line-height: var(--ch-lh); }
  #shopify-section-{{ section.id }} .ct-s[data-own-size] :is(p, li, span, strong, em) { font-size: inherit; line-height: inherit; }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .ct-h[data-own-size] { font-size: var(--ch-fs-d); }
  }
{% comment %}{% endcomment %}</style>
{%- if legacy_heading -%}
  <motion-element data-motion="fade-up-lg" data-motion-delay="50"{% if anim != 'slide_in' %} hold{% endif %} class="block{% if anim != 'none' %} scroll-trigger {{ anim }}{% endif %}"{% if anim != 'none' %} style="--animation-order: 0;"{% endif %}>
    <h2 class="section__header-heading heading-letter-spacing {{ size_class }} mt-0 mb-0 ct-h" data-ct-legacy="heading"{% if sec_font %} data-own-font{% endif %}>{{ st.heading }}</h2>
  </motion-element>
  {%- assign order = order | plus: 1 -%}
{%- endif -%}
{%- if legacy_sub -%}
  <motion-element data-motion="fade-up-lg" data-motion-delay="150"{% if anim != 'slide_in' %} hold{% endif %} class="section__header-des block rich__text-m0{% if anim != 'none' %} scroll-trigger {{ anim }}{% endif %}"{% if anim != 'none' %} style="--animation-order: {{ order }};"{% endif %}>
    <div class="ct-s" data-ct-legacy="description"{% if sec_font %} data-own-font{% endif %}>{{ st.description }}</div>
  </motion-element>
  {%- assign order = order | plus: 1 -%}
{%- endif -%}
{%- for block in section.blocks -%}
  {%- assign bs = block.settings -%}
  {%- case block.type -%}
    {%- when 'heading' -%}
      {%- capture ch_vars -%}
        {%- if bs.enable_custom_style -%}--ch-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
        {%- if bs.weight_enable -%}--ch-fw:{{ bs.weight | default: 700 }};{%- endif -%}
        {%- if bs.size_enable -%}--ch-fs-d:{{ bs.size_desktop | default: 36 }}px;--ch-fs-m:{{ bs.size_mobile | default: 26 }}px;--ch-lh:{{ bs.line_height | default: 1.15 }};--ch-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
        {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--ch-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
      {%- endcapture -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
      <motion-element data-motion="fade-up-lg" data-motion-delay="50"{% if anim != 'slide_in' %} hold{% endif %} class="block{% if anim != 'none' %} scroll-trigger {{ anim }}{% endif %}"{% if anim != 'none' %} style="--animation-order: {{ order }};"{% endif %} data-ct-block="{{ block.id }}" data-ct-type="heading" data-ct-settings="{{ bs | json | escape }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
        <h2 class="section__header-heading heading-letter-spacing {{ size_class }} mt-0 mb-0 ct-h" id="block-{{ block.id }}" data-ct-el{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if ch_vars != blank %} style="{{ ch_vars }}"{% endif %}>{{ bs.text }}</h2>
      </motion-element>
      {%- assign order = order | plus: 1 -%}
    {%- when 'subheading' -%}
      {%- capture ch_vars -%}
        {%- if bs.enable_custom_style -%}--ch-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
        {%- if bs.weight_enable -%}--ch-fw:{{ bs.weight | default: 400 }};{%- endif -%}
        {%- if bs.size_enable -%}--ch-fs:{{ bs.size | default: 16 }}px;--ch-lh:{{ bs.line_height | default: 1.5 }};{%- endif -%}
        {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--ch-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
      {%- endcapture -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
      <motion-element data-motion="fade-up-lg" data-motion-delay="150"{% if anim != 'slide_in' %} hold{% endif %} class="section__header-des block rich__text-m0{% if anim != 'none' %} scroll-trigger {{ anim }}{% endif %}"{% if anim != 'none' %} style="--animation-order: {{ order }};"{% endif %} data-ct-block="{{ block.id }}" data-ct-type="subheading" data-ct-settings="{{ bs | json | escape }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
        <div class="ct-s" id="block-{{ block.id }}" data-ct-el{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if ch_vars != blank %} style="{{ ch_vars }}"{% endif %}>{{ bs.text }}</div>
      </motion-element>
      {%- assign order = order | plus: 1 -%}
  {%- endcase -%}
{%- endfor -%}
</template>
