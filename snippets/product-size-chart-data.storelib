<template compat="shopify">
{%- comment -%}
  Background chart source on the product page, independent of page sections.
  Featured products read this from the product URL without creating an empty
  section in the editor. Measurements always come from Storelib.
{%- endcomment -%}
{%- assign chart_product = product | default: page.product -%}
{%- if chart_product.id != blank -%}
  <div data-size-chart-data data-product="{{ chart_product.id }}" hidden>{%- render 'product-size-chart-content', product: chart_product, chart_id: 'background' -%}</div>
{%- endif -%}
</template>
