<template compat="shopify">
{%- comment -%}
  Materia Themes. The CSS Feature Timeline and Guarantee Banner share: the
  section root (.r7s: colour scheme background, section width, Show on,
  margins and padding), the eyebrow, heading and subheading blocks (.r7h) and
  the button block (.r7b). Every value is a CSS variable the section prints
  on its root or on the block (snippets/r7-features-vars), so a builder edit
  is one variable changed. The layout follows the section's own width
  (container query at 750px); margins and Show on follow the window.
    sid   section.id
    st    section.settings
{%- endcomment -%}
<style data-rs-bulletproof>
  {%- if st.reset_spacing -%}
    #shopify-section-{{ sid }},
    #shopify-section-{{ sid }} > .r7s {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ sid }} + .shopify-section,
    .shopify-section + #shopify-section-{{ sid }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  {%- if st.enable_custom_fonts -%}{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif %}
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .r7s {
    --r7-hf: var(--r7-heading_font, var(--heading-font)); --r7-bf: var(--r7-body_font, var(--body-font));
    container: r7s / inline-size; background: var(--r7-section_bg, var(--color-background)); color: var(--color-text); font-family: var(--r7-bf);
    margin-block: var(--r7-section_margin_top_mobile) var(--r7-section_margin_bottom_mobile);
  }
  #shopify-section-{{ sid }} .r7s[data-reset_spacing='true'] { margin-block: 0; }
  #shopify-section-{{ sid }} .r7s *, #shopify-section-{{ sid }} .r7s *::before, #shopify-section-{{ sid }} .r7s *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .r7s[data-section_width='container'] { max-width: calc(var(--page-width, 1300px) + 40px); margin-inline: auto; }
  #shopify-section-{{ sid }} .r7s[data-section_width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 40px); margin-inline: auto; }
  #shopify-section-{{ sid }} .r7s[data-show_section_on='desktop'] { display: none; }
  #shopify-section-{{ sid }} .r7s__inner { max-width: calc(var(--page-width, 1300px) + 40px); margin-inline: auto; padding: var(--r7-padding_top_mobile) 20px var(--r7-padding_bottom_mobile); }
  #shopify-section-{{ sid }} .r7s[data-section_width='stretch_width'] .r7s__inner { max-width: none; }

  #shopify-section-{{ sid }} .r7h { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; text-align: left; min-width: 0; }
  #shopify-section-{{ sid }} .r7h > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .r7s[data-text_align='center'] .r7h { align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .r7h__eyebrow { color: var(--r7-color, var(--color-text)); font-size: 12px; font-weight: 600; line-height: 1.4; letter-spacing: 0.14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .r7h__heading {
    color: var(--r7-color, var(--color-heading)); font-family: var(--r7-hf); font-weight: var(--r7-weight, var(--heading-weight, 700));
    font-size: var(--r7-size_mobile, calc(var(--heading-font-scale, 1) * var(--r7h-m, 28px))); line-height: var(--r7-line_height, var(--heading-line-height, 1.2));
    letter-spacing: var(--r7-tracking, var(--heading-letter-spacing, normal)); overflow-wrap: anywhere; text-wrap: balance;
  }
  #shopify-section-{{ sid }} .r7h__sub { color: var(--r7-color, var(--color-text)); font-size: var(--r7-size, var(--body-font-size, 16px)); line-height: var(--body-line-height, 1.6); max-width: 60ch; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .r7h__sub :is(p, ul, ol) { margin: 0 0 0.6em; line-height: inherit; }
  #shopify-section-{{ sid }} .r7h__sub :is(p, ul, ol):last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .r7h__sub a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  #shopify-section-{{ sid }} .r7b { max-width: 100%; cursor: pointer; text-decoration: none; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} .r7b:active { opacity: 0.75; }
  #shopify-section-{{ sid }} .r7b:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  #shopify-section-{{ sid }} .r7b__arrow { display: none; flex: 0 0 auto; width: 16px; height: 16px; transition: transform 0.2s ease; }
  #shopify-section-{{ sid }} .r7b[data-style='link'] {
    appearance: none; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: none;
    color: var(--r7-color, var(--color-heading)); font: inherit; font-weight: 600; line-height: 1.4; text-align: inherit; transition: opacity 0.2s ease;
  }
  #shopify-section-{{ sid }} .r7b[data-style='link'] .r7b__label { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  #shopify-section-{{ sid }} .r7b[data-style='link'] .r7b__arrow { display: block; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .r7b[data-style='link']:hover .r7b__arrow { transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .r7b, #shopify-section-{{ sid }} .r7b__arrow { transition: none; }
    #shopify-section-{{ sid }} .r7b[data-style='link']:hover .r7b__arrow { transform: none; }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .r7s { margin-block: var(--r7-section_margin_top_desktop) var(--r7-section_margin_bottom_desktop); }
    #shopify-section-{{ sid }} .r7s[data-reset_spacing='true'] { margin-block: 0; }
    #shopify-section-{{ sid }} .r7s[data-show_section_on='desktop'] { display: block; }
    #shopify-section-{{ sid }} .r7s[data-show_section_on='mobile'] { display: none; }
  }
  @container r7s (min-width: 750px) {
    #shopify-section-{{ sid }} .r7s__inner { padding: var(--r7-padding_top_desktop) 32px var(--r7-padding_bottom_desktop); }
    #shopify-section-{{ sid }} .r7h__heading { font-size: var(--r7-size_desktop, calc(var(--heading-font-scale, 1) * var(--r7h-d, 36px))); }
  }
{% comment %}{% endcomment %}</style>
</template>
