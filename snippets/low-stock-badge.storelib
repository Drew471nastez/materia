<template compat="shopify">
{%- comment -%}
  Materia Themes — Low Stock Badge block.
  Pill-shaped low-stock indicator with pulsing dot. Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'low-stock-' | append: block.id
  assign label_text = s.label_text | default: 'Low Stock:'
  assign body_text = s.body_text | default: 'Only [count] units left in stock'
  assign count = s.units_count | default: 15
  assign body_text_rendered = body_text | replace: '[count]', count
  assign accent_color = s.accent_color | default: '#ef4444'
  assign dot_color = s.dot_color | default: '#ef4444'
  assign text_color = s.text_color
  assign bg_color = s.bg_color | default: '#fff5f5'
  assign border_color = s.border_color | default: 'transparent'
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 8 }}px;
    padding-bottom: {{ s.padding_bottom | default: 8 }}px;
    text-align: {{ s.alignment | default: 'left' }};
  }
  #{{ block_id }} .ls-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ s.padding_y | default: 10 }}px {{ s.padding_x | default: 18 }}px;
    border-radius: {{ s.border_radius | default: 100 }}px;
    background: {{ bg_color }};
    border: {{ s.border_width | default: 0 }}px solid {{ border_color }};
    {% if s.show_shadow %}box-shadow: {{ s.shadow_value | default: '0 2px 10px -2px rgba(0,0,0,0.08)' }};{% endif %}
    font-size: {{ s.font_size_mobile | default: 13 }}px;
    font-weight: {{ s.font_weight | default: '500' }};
    line-height: 1.3;
    {% if text_color != blank %}color: {{ text_color }};{% else %}color: var(--color-text, #111);{% endif %}
    max-width: 100%;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .ls-badge { font-size: {{ s.font_size_desktop | default: 14 }}px; }
  }
  #{{ block_id }} .ls-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: {{ dot_color }};
    flex: 0 0 auto;
    position: relative;
  }
  {%- if s.enable_pulse -%}
    #{{ block_id }} .ls-dot::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: {{ dot_color }};
      opacity: 0.55;
      animation: ls-pulse-{{ block.id }} 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes ls-pulse-{{ block.id }} {
      0%   { transform: scale(1);   opacity: 0.55; }
      70%  { transform: scale(2.4); opacity: 0;    }
      100% { transform: scale(2.4); opacity: 0;    }
    }
    @media (prefers-reduced-motion: reduce) {
      #{{ block_id }} .ls-dot::after { animation: none; opacity: 0; }
    }
  {%- endif -%}
  #{{ block_id }} .ls-label {
    font-weight: 700;
    color: {{ accent_color }};
    margin-right: 6px;
  }
  #{{ block_id }} .ls-body-text { display: inline; }
  #{{ block_id }} .ls-count {
    font-weight: 700;
    color: {{ accent_color }};
  }
  #{{ block_id }} .ls-body {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="low-stock-badge-block" {{ block.shopify_attributes }}>
  <span class="ls-badge">
    <span class="ls-dot" aria-hidden="true"></span>
    <span class="ls-body">
      <span class="ls-label">{{ label_text }}</span>
      {%- assign body_parts = body_text_rendered | split: count -%}
      <span class="ls-body-text">{%- if body_parts.size == 2 -%}{{ body_parts[0] }}<span class="ls-count">{{ count }}</span>{{ body_parts[1] }}{%- else -%}{{ body_text_rendered }}{%- endif -%}</span>
    </span>
  </span>
</div>

</template>