<template compat="shopify">
{%- comment -%}
  Materia Themes — Shared 30-icon library (stroke-style, modern, currentColor).
  Usage: {% render 'benefits-icon', icon: 'truck', size: 32, color: '#000', class: 'foo' %}
  Falls back to nothing if `icon` is 'none' or unknown — caller decides display.
{%- endcomment -%}

{%- liquid
  assign icon = icon | default: 'none'
  assign size = size | default: 32
  assign stroke_width = stroke_width | default: 1.75
  assign color = color | default: 'currentColor'
  assign css_class = class | default: ''
  assign attrs = 'width="' | append: size | append: '" height="' | append: size | append: '" viewBox="0 0 24 24" fill="none" stroke="' | append: color | append: '" stroke-width="' | append: stroke_width | append: '" stroke-linecap="round" stroke-linejoin="round" class="' | append: css_class | append: '"'
-%}

{%- case icon -%}
  {%- when 'truck' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
  {%- when 'shipping' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M16 3h5v5"/><path d="M21 3 9 15"/><path d="M21 21H3V3h11"/></svg>
  {%- when 'shield' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'lock' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  {%- when 'heart' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
  {%- when 'star' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
  {%- when 'check' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
  {%- when 'headphones' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a1 1 0 0 1-1-1z"/><path d="M21 14h-3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2a1 1 0 0 0 1-1z"/><path d="M3 14a9 9 0 0 1 18 0"/></svg>
  {%- when 'envelope' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
  {%- when 'chat' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  {%- when 'tag' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
  {%- when 'gift' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
  {%- when 'globe' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
  {%- when 'leaf' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96a1 1 0 0 1 1.6.8c0 3.32-.34 6.07-.59 7.91a4.85 4.85 0 0 1-1.78 3.43 7 7 0 0 1-7.43 4.9z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
  {%- when 'award' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
  {%- when 'clock' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
  {%- when 'card' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
  {%- when 'wallet' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
  {%- when 'lightning' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
  {%- when 'recycle' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/><path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/><path d="m14 16-3 3 3 3"/><path d="M8.293 13.596 7.196 9.5 3.1 10.598"/><path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/><path d="m13.378 9.633 4.096 1.098 1.097-4.096"/></svg>
  {%- when 'sparkle' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
  {%- when 'box' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
  {%- when 'refresh' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
  {%- when 'user' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  {%- when 'calendar' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
  {%- when 'handshake' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
  {%- when 'gem' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M6 3h12l4 6-10 13L2 9z"/><path d="m12 22 4-13-3-6"/><path d="M12 22 8 9l3-6"/><path d="M2 9h20"/></svg>
  {%- when 'organic' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M21.5 22a8 8 0 0 0 0-16h-1A11.5 11.5 0 0 0 9 17.5a4.5 4.5 0 0 0 4.5 4.5"/><path d="M3 13a4 4 0 0 1 4-4h1a8 8 0 0 1 8 8 5 5 0 0 1-5 5"/></svg>
  {%- when 'fire' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5"/></svg>
  {%- when 'crown' -%}
    <svg xmlns="http://www.w3.org/2000/svg" {{ attrs }}><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.964.734H5.81a1 1 0 0 1-.964-.734L2.012 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/></svg>
  {%- else -%}
    {%- comment -%}icon = 'none' or unknown — render nothing{%- endcomment -%}
{%- endcase -%}

</template>