<template compat="shopify">
{%- comment -%}
  ═══════════════════════════════════════════════════════════════════════
  BUNDLE & SAVE — RENDER SNIPPET
  ═══════════════════════════════════════════════════════════════════════
  Tier-based bundle picker with real-time pricing, multi-variant pickers,
  and two discount modes:
  Mode A — Shopify Automatic Quantity Discount (no code needed)
  Mode B — per-tier discount code applied via /discount/CODE on submit

  On click, a tier syncs to the main product form so the inline Add-to-Cart
  posts exactly N items (one per variant picker). The capture-phase submit
  listener runs BEFORE Shopify's <product-form> so multi-item bundles use
  our own /cart/add.js POST instead of the form's single-variant flow.

  Inputs passed by main-product.liquid render call: block, section, product, shop
{%- endcomment -%}
{%- assign bs = block.settings -%}

{%- assign tiers = '' -%}
{%- if bs.enable_tier_1 -%}{% assign tiers = tiers | append: '1,' %}{%- endif -%}
{%- if bs.enable_tier_2 -%}{% assign tiers = tiers | append: '2,' %}{%- endif -%}
{%- if bs.enable_tier_3 -%}{% assign tiers = tiers | append: '3,' %}{%- endif -%}
{%- if bs.enable_tier_4 -%}{% assign tiers = tiers | append: '4,' %}{%- endif -%}
{%- assign tiers = tiers | split: ',' -%}
{%- assign bs_default_tier = bs.default_selected_tier | default: '1' -%}

<div id="BundleSave-{{ block.id }}" class="bundle-save {% if bs.enable_animations %}has-anim{% endif %}" {{ block.shopify_attributes }}
     style="
       --bs-accent: {{ bs.accent | default: '#E93B3B' }};
       --bs-title:  {{ bs.heading_color | default: '#111111' }};
       --bs-title-size-d: {{ bs.heading_size_d | default: 22 }}px;
       --bs-title-size-m: {{ bs.heading_size_m | default: 18 }}px;
       --bs-title-w: {{ bs.heading_weight | default: 800 }};
       --bs-title-align: {{ bs.heading_align | default: 'center' }};
       --bs-price-size-d: {{ bs.price_size_d | default: 18 }}px;
       --bs-price-size-m: {{ bs.price_size_m | default: 16 }}px;
       --bs-price-w: {{ bs.price_weight | default: 800 }};
       --bs-label-w: {{ bs.label_weight | default: 700 }};
       --bs-idx-w: {{ bs.idx_weight | default: 700 }};
       --bs-unit-size-d:  {{ bs.unit_size_d  | default: 14 }}px;
       --bs-unit-size-m:  {{ bs.unit_size_m  | default: 13 }}px;
       --bs-unit-color:   {{ bs.unit_text_color | default: '#666666' }} !important;
       --bs-selected-border: {{ bs.selected_border_color | default: bs.accent }};
       --bs-selected-dot:    {{ bs.selected_dot_color    | default: bs.accent }};
       --bs-dot-ring:        {{ bs.dot_ring_color        | default: '#FFFFFF' }};
       --bs-ribbon-bg:   {{ bs.ribbon_bg | default: bs.accent }};
       --bs-ribbon-text: {{ bs.ribbon_text | default: '#FFFFFF' }};
       --bs-maxw: {{ bs.maxw_d | default: 1200 }}px;
       --bs-pl:   {{ bs.pl_d   | default: 0 }}px;
       --bs-pr:   {{ bs.pr_d   | default: 0 }}px;
       --bs-pt:   {{ bs.pt_d   | default: 0 }}px;
       --bs-pb:   {{ bs.pb_d   | default: 0 }}px;
       --bs-pl-m: {{ bs.pl_m   | default: 0 }}px;
       --bs-pr-m: {{ bs.pr_m   | default: 0 }}px;
       --bs-pt-m: {{ bs.pt_m   | default: 0 }}px;
       --bs-pb-m: {{ bs.pb_m   | default: 0 }}px;
       --bs-scale-d: {{ bs.scale_d | default: 1 }};
       --bs-scale-m: {{ bs.scale_m | default: 1 }};
       --bs-gap-heading: {{ bs.gap_heading_tiers | default: 12 }}px;
       --bs-tier-gap: {{ bs.tier_gap | default: 14 }}px;
       --bs-card-radius: {{ bs.card_radius | default: 14 }}px;
       --bs-card-padding: {{ bs.card_padding | default: 16 }}px;
       --bs-card-border-w: {{ bs.card_border_width | default: 2 }}px;
       --bs-card-bg: {{ bs.card_bg | default: '#FFFFFF' }};
       --bs-card-bg-selected: {{ bs.card_bg_selected | default: '#FFF8F8' }};
       --bs-card-border: {{ bs.card_border_color | default: '#FFD1D1' }};
       --bs-card-shadow: {{ bs.card_shadow | default: 6 }}px;
     ">
  <div class="bundle-save__inner">
    <div class="bundle-save__scale">
      <h3 class="bundle-save__title">{{ bs.heading }}</h3>

      <div class="bundle-save__group" role="radiogroup" aria-label="{{ 'accessibility.bundle_save_options' | t }}">
        {%- for t in tiers -%}{% if t != blank %}
          {%- assign k_qty      = 't' | append: t | append: '_qty' -%}
          {%- assign k_label    = 't' | append: t | append: '_label' -%}
          {%- assign k_disc     = 't' | append: t | append: '_discount_percent' -%}
          {%- assign k_popular  = 't' | append: t | append: '_popular' -%}
          {%- assign k_freeship = 't' | append: t | append: '_free_shipping' -%}
          {%- assign k_code     = 't' | append: t | append: '_discount_code' -%}

          {%- assign qty       = bs[k_qty] | plus: 0 -%}
          {%- assign label     = bs[k_label] -%}
          {%- assign disc_pct  = bs[k_disc] | plus: 0 -%}
          {%- assign is_pop    = bs[k_popular] -%}
          {%- assign has_free  = bs[k_freeship] -%}
          {%- assign disc_code = bs[k_code] | default: '' | strip -%}
          {%- assign eff_qty   = qty | minus: 1 -%}
          {%- if eff_qty < 0 -%}{% assign eff_qty = 0 %}{%- endif -%}

          {%- assign is_default_tier = false -%}
          {%- if t == bs_default_tier -%}{% assign is_default_tier = true %}{%- endif -%}
          <label class="bundle-card" data-tier="{{ t }}" data-qty="{{ qty }}" data-disc="{{ disc_pct }}" data-eff-qty="{{ eff_qty }}"{% if disc_code != blank %} data-discount-code="{{ disc_code | escape }}"{% endif %}>
            <input class="bundle-card__radio" type="radio" name="bundle_tier_{{ section.id }}" value="{{ t }}" {% if is_default_tier %}checked{% endif %}>
            <span class="bundle-card__body">
              <span class="bundle-card__left">
                <span class="bundle-card__dot" aria-hidden="true"></span>
                <span class="bundle-card__label">{{ label }}</span>
                {% if has_free %}<span class="bundle-card__badge">{{ bs.free_shipping_label | default: 'Free Shipping' | escape }}</span>{% endif %}
              </span>

              <span class="bundle-card__right">
                <span class="bundle-card__price" data-price>—</span>
                {% if bs.show_compare %}<span class="bundle-card__compare" data-compare></span>{% endif %}
                {% if bs.show_per_unit %}<span class="bundle-card__unit" data-unit>—</span>{% endif %}
              </span>

              {% if is_pop %}<span class="bundle-card__ribbon">{{ bs.popular_label | default: 'Most Popular' | escape }}</span>{% endif %}
            </span>

            {%- if bs.show_variant_pickers != false -%}
            <div class="bundle-card__variants" hidden>
              {%- comment -%} One variant selector per item in the bundle (qty=3 → 3 selectors). Each row picks a variant for that item; on Add-to-Cart the JS posts ALL items together. {%- endcomment -%}
              {%- for i in (1..20) -%}{% if i <= qty %}
                <div class="bundle-variant">
                  <span class="bundle-variant__idx">#{{ i }}</span>
                  <select class="bundle-variant__select" aria-label="Variant for bundle item {{ i }}">
                    {%- for v in product.variants -%}
                      <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                        {{ v.title }} {% unless v.available %}- {{ 'products.product.sold_out' | t }}{% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {% endif %}{%- endfor -%}
            </div>
            {%- endif -%}
          </label>
        {% endif %}{%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="BundleVariantPrices-{{ block.id }}">
{
  "currency": {{ cart.currency.iso_code | json }},
  "money_format": {{ shop.money_format | json }},
  "variants": [
    {%- for v in product.variants -%}
      {"id":{{ v.id }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: v.price }},"available":{{ v.available | json }}}
      {%- unless forloop.last -%},{% endunless -%}
    {%- endfor -%}
  ],
  "fallback_price": {{ product.price }},
  "fallback_compare": {{ product.compare_at_price | default: product.price }},
  "product_title": {{ product.title | json }}
}
{% comment %}{% endcomment %}</script>

<style>
  #BundleSave-{{ block.id }} .bundle-save__inner{
    max-width: var(--bs-maxw);
    margin-inline: auto;
    padding-left: var(--bs-pl);
    padding-right: var(--bs-pr);
    padding-top: var(--bs-pt);
    padding-bottom: var(--bs-pb);
  }
  @media (max-width: 768px){
    #BundleSave-{{ block.id }} .bundle-save__inner{
      padding-left: var(--bs-pl-m);
      padding-right: var(--bs-pr-m);
      padding-top: var(--bs-pt-m);
      padding-bottom: var(--bs-pb-m);
    }
  }
  #BundleSave-{{ block.id }} .bundle-save__scale{
    transform-origin: top center;
    transform: scale(var(--bs-scale-d));
  }
  @media (max-width:768px){
    #BundleSave-{{ block.id }} .bundle-save__scale{
      transform: scale(var(--bs-scale-m));
    }
  }
  #BundleSave-{{ block.id }} .bundle-save__title{
    margin: 0 0 var(--bs-gap-heading);
    font-weight: var(--bs-title-w);
    color: var(--bs-title) !important;
    text-align: var(--bs-title-align);
    font-size: var(--bs-title-size-d);
    letter-spacing:.02em;
  }
  @media (max-width:768px){
    #BundleSave-{{ block.id }} .bundle-save__title{ font-size: var(--bs-title-size-m); }
  }
  #BundleSave-{{ block.id }} .bundle-save__group{ display:flex; flex-direction:column; gap: var(--bs-tier-gap); }
  #BundleSave-{{ block.id }} .bundle-card{
    position:relative; display:block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #BundleSave-{{ block.id }} .bundle-card__radio{ position:absolute; opacity:0; pointer-events:none; }
  #BundleSave-{{ block.id }} .bundle-card__body{
    display:grid; grid-template-columns: 1fr auto; gap:12px;
    padding: var(--bs-card-padding);
    border: var(--bs-card-border-w) solid var(--bs-card-border);
    border-radius: var(--bs-card-radius);
    background: var(--bs-card-bg);
    cursor: pointer;
    transition:
      border-color .25s cubic-bezier(.4, 0, .2, 1),
      background-color .25s cubic-bezier(.4, 0, .2, 1),
      box-shadow .25s cubic-bezier(.4, 0, .2, 1),
      transform .2s cubic-bezier(.4, 0, .2, 1);
  }
  /* Hover affordance — both with and without `has-anim` so the cursor
     change is always reinforced visually. With has-anim we add the
     soft shadow lift; without it we still tint the border so shoppers
     see the card is interactive. */
  #BundleSave-{{ block.id }} .bundle-card:hover .bundle-card__body{
    border-color: color-mix(in srgb, var(--bs-card-border) 60%, var(--bs-accent) 40%);
  }
  #BundleSave-{{ block.id }}.has-anim .bundle-card:hover .bundle-card__body{
    box-shadow: 0 4px var(--bs-card-shadow) -2px rgba(0,0,0,.08);
    transform: translateY(-1px);
  }
  #BundleSave-{{ block.id }}.has-anim .bundle-card:active .bundle-card__body{
    transform: translateY(0);
    transition-duration: .1s;
  }
  /* When a card is already selected, hover should NOT bounce — it would
     feel jittery because the selected card stays put while the cursor
     passes over it. */
  #BundleSave-{{ block.id }}.has-anim .bundle-card__radio:checked + .bundle-card__body,
  #BundleSave-{{ block.id }}.has-anim .bundle-card:has(.bundle-card__radio:checked):hover .bundle-card__body{
    transform: none;
  }
  #BundleSave-{{ block.id }} .bundle-card__radio:checked + .bundle-card__body{
    border-color: var(--bs-selected-border);
    background: var(--bs-card-bg-selected);
  }
  @media (prefers-reduced-motion: reduce){
    #BundleSave-{{ block.id }} .bundle-card__body{ transition: none !important; }
    #BundleSave-{{ block.id }}.has-anim .bundle-card:hover .bundle-card__body{ transform: none; }
  }
  #BundleSave-{{ block.id }} .bundle-card__left{ display:flex; align-items:center; gap:10px; min-width:0; }
  #BundleSave-{{ block.id }} .bundle-card__dot{
    width: 18px; height: 18px; border-radius: 50%;
    box-sizing: content-box;
    border: 2px solid var(--bs-accent);
    background: var(--bs-card-bg);
    display:inline-block;
    position: relative; flex:0 0 auto;
  }
  #BundleSave-{{ block.id }} .bundle-card__radio:checked + .bundle-card__body .bundle-card__dot{
    background: var(--bs-selected-dot);
    border-color: var(--bs-selected-border);
    box-shadow: 0 0 0 2px var(--bs-dot-ring) inset;
  }
  /* Tier label ("Buy 1", "Buy 2", …) — uses scheme HEADING colour so it
     matches the section's typographic system across light/dark schemes. */
  #BundleSave-{{ block.id }} .bundle-card__label{
    font-weight: var(--bs-label-w);
    color: var(--bs-title);
  }
  /* Free-shipping pill — soft accent tint background + accent text/border,
     derived from the merchant's chosen Accent colour via color-mix. */
  #BundleSave-{{ block.id }} .bundle-card__badge{
    margin-left:8px; font-size:.8rem; padding:4px 8px; border-radius:999px;
    background: color-mix(in srgb, var(--bs-accent) 12%, transparent);
    color: var(--bs-accent);
    border: 1px solid color-mix(in srgb, var(--bs-accent) 28%, transparent);
    white-space:nowrap;
  }
  #BundleSave-{{ block.id }} .bundle-card__right{ text-align:right; display:flex; flex-direction:column; align-items:flex-end; }
  #BundleSave-{{ block.id }} .bundle-card__price{
    color: var(--bs-accent); font-weight: var(--bs-price-w); line-height:1; font-size: var(--bs-price-size-d);
  }
  /* Crossed-out compare price — follows the muted "Under-Price" colour
     customiser, same token the per-unit text uses. One source of truth. */
  #BundleSave-{{ block.id }} .bundle-card__compare{
    color: var(--bs-unit-color);
    text-decoration: line-through;
    margin-top:4px; line-height:1;
  }
  #BundleSave-{{ block.id }} .bundle-card__unit{
    color: var(--bs-unit-color);
    margin-top:6px; font-size: var(--bs-unit-size-d);
  }
  @media (max-width:768px){
    #BundleSave-{{ block.id }} .bundle-card__price{ font-size: var(--bs-price-size-m); }
    #BundleSave-{{ block.id }} .bundle-card__unit{  font-size: var(--bs-unit-size-m); }
  }
  #BundleSave-{{ block.id }} .bundle-card__ribbon{
    position:absolute; right:14px; top:-10px;
    background: var(--bs-ribbon-bg); color: var(--bs-ribbon-text);
    font-size:.8rem; font-weight:700; padding:4px 10px; border-radius:7px; transform:rotate(7deg);
  }
  /* Variant-picker dashed separator — mixes the card-border setting with
     transparency, so it always reads on whatever card background the
     merchant picks (works on dark + light variants alike). */
  #BundleSave-{{ block.id }} .bundle-card__variants{
    border-top: 1px dashed color-mix(in srgb, var(--bs-card-border) 70%, transparent);
    margin: -6px 16px 12px;
    padding-top:10px;
  }
  #BundleSave-{{ block.id }} .bundle-variant{ display:flex; align-items:center; gap:8px; margin:6px 0; }
  #BundleSave-{{ block.id }} .bundle-variant__idx{
    font-weight: var(--bs-idx-w);
    color: var(--bs-title);
  }
  #BundleSave-{{ block.id }} .bundle-variant__select{
    height: 30px; line-height:30px; padding: 0 8px;
    border: 1px solid var(--bs-card-border);
    border-radius: 8px;
    background: var(--bs-card-bg);
    color: var(--bs-title);
    font-size: 14px; min-width: 120px;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  #BundleSave-{{ block.id }}.has-anim .bundle-variant__select:focus{
    border-color: var(--bs-selected-border);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--bs-accent) 15%, transparent);
    outline: none;
  }
  @media (max-width: 768px){
    #BundleSave-{{ block.id }} .bundle-card__body{ padding:14px; }
    #BundleSave-{{ block.id }} .bundle-variant__select{ min-width: 110px; }
  }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  const root = document.getElementById('BundleSave-{{ block.id }}');
  if(!root) return;

  const priceJSON = document.getElementById('BundleVariantPrices-{{ block.id }}');
  const cfg = priceJSON ? JSON.parse(priceJSON.textContent) : {variants:[],fallback_price:0,fallback_compare:0,product_title:'unit',currency:'USD'};
  const vmap = new Map(cfg.variants.map(v => [String(v.id), v]));
  const perUnitSuffix = {{ bs.per_unit_suffix | default: '/ per unit' | json }};

  function firstAvailable(){
    return cfg.variants.find(v => v.available) || cfg.variants[0] || {id:null,price:cfg.fallback_price, compare_at_price:cfg.fallback_compare || cfg.fallback_price};
  }
  function formatMoney(cents){
    try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: cfg.currency }).format(cents/100); }
    catch(_){ return (cents/100).toFixed(2); }
  }

  const cards  = Array.from(root.querySelectorAll('.bundle-card'));
  const radios = Array.from(root.querySelectorAll('.bundle-card__radio'));
  const isSelected = card => card.querySelector('.bundle-card__radio')?.checked;

  /* Real-time tier price math. Reads each visible per-item variant
     dropdown; falls back to firstAvailable variant for missing rows.
     Recomputes the full bundle total + per-unit + crossed-out compare.
     Runs on every tier click AND every per-item variant change so
     totals stay in sync as the shopper edits. */
  function updateCardPrices(card){
    const qty = Math.max(1, parseInt(card.dataset.qty || '1', 10));
    const def = firstAvailable();
    let totalBase = 0, totalCompare = 0;
    const rows = Array.from(card.querySelectorAll('.bundle-variant'));
    for(let i = 0; i < qty; i++){
      let price = def.price;
      let compare = def.compare_at_price || def.price;
      const row = rows[i];
      if(row){
        const sel = row.querySelector('.bundle-variant__select');
        const v = vmap.get(String(sel?.value));
        if(v){ price = v.price; compare = v.compare_at_price || v.price; }
      }
      totalBase    += price;
      totalCompare += compare;
    }
    const disc = parseFloat(card.dataset.disc || '0');
    const discounted = Math.round(totalBase * (1 - (disc/100)));
    const unitPrice  = Math.round(discounted / qty);
    const priceEl   = card.querySelector('[data-price]');
    const compareEl = card.querySelector('[data-compare]');
    const unitEl    = card.querySelector('[data-unit]');
    if(priceEl)   priceEl.textContent   = formatMoney(discounted);
    if(compareEl) compareEl.textContent = totalCompare > discounted ? formatMoney(totalCompare) : '';
    if(unitEl)    unitEl.textContent    = unitPrice ? (formatMoney(unitPrice) + ' ' + perUnitSuffix) : '';
  }

  function showCardVariants(card){
    const lists = Array.from(root.querySelectorAll('.bundle-card__variants'));
    lists.forEach(l => l.setAttribute('hidden',''));
    // Only reveal per-item pickers for tiers with qty >= 2.
    // Buy 1 has nothing extra to pick (main form's variant picker handles it).
    const qty = parseInt(card.dataset.qty || '1', 10);
    if(qty >= 2){
      card.querySelector('.bundle-card__variants')?.removeAttribute('hidden');
    }
  }

  /* ── Functionality model (multi-variant, bullet-proof) ─────────────
     • Tier click → visual selection + real-time price math. No silent
       cart adds — the cart only changes when the shopper clicks the
       page's Add-to-Cart button.
     • Add-to-Cart click → for Tier 1 we let the theme's standard
       <product-form> handle the single-item add. For Tier 2+ we
       intercept the BUTTON click in capture phase (preventDefault +
       stopImmediatePropagation + stopPropagation in one step, before
       any other handler runs) and POST a multi-item FormData payload
       to /cart/add. Each slot's variant becomes its own cart line —
       a unique `_bundle_slot` property keeps same-variant slots from
       merging into a single line. After the POST lands, we refresh
       the cart drawer's sections and call `cartAction()` so the drawer
       opens with the same animation the standard flow uses.
     • A double-click guard on the button (`__bundleAdding` flag) +
       aria-disabled + loading class prevent the previous "6 items per
       slot from impatient clicking" bug.
     • Discount code (Mode B) attaches via the same handler after the
       POST resolves; Tier 1 attaches via passive submit observer.
     • Mode A (Shopify Automatic Quantity Discount) needs no JS.       */
  function buildBundleItems(card){
    const qty = Math.max(1, parseInt(card.dataset.qty || '1', 10));
    const rows = Array.from(card.querySelectorAll('.bundle-variant'));
    const fallback = firstAvailable();
    const items = [];
    for(let i = 0; i < qty; i++){
      let id = fallback.id;
      if(rows[i]){
        const sel = rows[i].querySelector('.bundle-variant__select');
        const chosen = vmap.get(String(sel && sel.value));
        if(chosen && chosen.id) id = chosen.id;
      }
      if(!id) continue;
      items.push({ id: Number(id), quantity: 1, slot: i + 1 });
    }
    return items;
  }
  function getCartEl(){
    return document.querySelector('cart-notification') ||
           document.querySelector('cart-drawer');
  }
  function syncQuantity(qty){
    if(!qty || qty < 1) return;
    document.querySelectorAll('form[action*="/cart/add"] input[name="quantity"]').forEach(inp => {
      inp.value = qty;
      inp.dispatchEvent(new Event('change', { bubbles: true }));
      inp.dispatchEvent(new Event('input',  { bubbles: true }));
    });
  }
  function applyDiscountCode(code){
    if(!code) return;
    setTimeout(() => {
      try{
        fetch('/discount/' + encodeURIComponent(code), { credentials: 'same-origin' }).catch(()=>{});
      }catch(_){}
    }, 500);
  }

  let pendingDiscountCode = null;
  function selectCard(card){
    if(!card) return;
    cards.forEach(c => {
      c.classList.toggle('is-selected', c === card);
      const r = c.querySelector('.bundle-card__radio');
      if(r) r.checked = (c === card);
    });
    showCardVariants(card);
    cards.forEach(updateCardPrices);
    const qty = parseInt(card.dataset.qty || '1', 10);
    syncQuantity(qty);
    pendingDiscountCode = card.getAttribute('data-discount-code') || null;
  }

  // Initial state — paint prices, sync qty for whichever tier is checked.
  const selected = cards.find(c => isSelected(c)) || cards[0];
  if(selected) selectCard(selected);

  // Click anywhere on a card selects it (radio is visually hidden).
  cards.forEach(card => {
    card.addEventListener('click', (e)=>{
      if(e.target && e.target.matches('select, option')) return;
      selectCard(card);
    });
    card.addEventListener('change', e=>{
      if(e.target.matches('.bundle-variant__select')){
        updateCardPrices(card);
      }
    });
  });
  radios.forEach(r => r.addEventListener('change', ()=>{
    if(r.checked) selectCard(r.closest('.bundle-card'));
  }));

  /* Passive submit observer — fires the Mode-B discount code via
     /discount/CODE after the standard Tier 1 form submit lands.
     Bubble phase, NO preventDefault. */
  document.addEventListener('submit', (e) => {
    if(!e.target || !e.target.matches || !e.target.matches('form[action*="/cart/add"]')) return;
    if(pendingDiscountCode) applyDiscountCode(pendingDiscountCode);
  });

  /* Multi-variant Add-to-Cart — capture-phase click on every Add-to-Cart
     button. For Tier 1 we return without preventDefault so the standard
     form flow runs. For Tier 2+ we cancel the click (so the form never
     submits + no other listener runs) and POST our own FormData. */
  async function handleAddClick(e){
    const card = cards.find(c => isSelected(c));
    if(!card) return;
    const qty = parseInt(card.dataset.qty || '1', 10);
    if(qty <= 1) return; // Standard form handles Buy 1.

    e.preventDefault();
    e.stopImmediatePropagation();
    e.stopPropagation();

    const btn = e.currentTarget;
    if(btn.__bundleAdding) return;
    btn.__bundleAdding = true;
    btn.setAttribute('aria-disabled', 'true');
    btn.classList.add('loading');

    try{
      const items = buildBundleItems(card);
      if(!items.length){
        console.warn('[bundle-save] no items resolved');
        return;
      }
      const cartEl = getCartEl();
      const sectionsParam = (cartEl && typeof cartEl.getSectionsToRender === 'function')
        ? cartEl.getSectionsToRender().map(s => s.id).join(',')
        : '';

      const fd = new FormData();
      items.forEach((it, i) => {
        fd.append('items[' + i + '][id]', String(it.id));
        fd.append('items[' + i + '][quantity]', String(it.quantity));
        /* Unique `_bundle_slot` value per slot keeps Shopify from
           merging same-variant slots into a single line. Underscore
           prefix hides the property from the customer-facing cart. */
        fd.append('items[' + i + '][properties][_bundle_slot]', String(it.slot));
      });
      if(sectionsParam){
        fd.append('sections', sectionsParam);
        fd.append('sections_url', window.location.pathname);
      }

      const cartAddUrl = (window.routes && window.routes.cart_add_url) || '/cart/add';
      const res = await fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' },
        body: fd
      });
      const data = await res.json().catch(() => null);

      if(!data || data.status || data.errors){
        console.warn('[bundle-save] Shopify rejected the add', data);
        return;
      }

      // Swap cart drawer section HTML in-place.
      if(data.sections){
        Object.keys(data.sections).forEach(sid => {
          const target = document.getElementById(sid);
          if(!target) return;
          const html = new DOMParser().parseFromString(data.sections[sid], 'text/html');
          const fresh = html.querySelector('#minicart-form');
          if(fresh) target.innerHTML = fresh.innerHTML;
        });
      }

      /* Match the theme's own post-add flow exactly:
           1) cartAction()   → re-bind event listeners inside the
                                freshly-rendered drawer DOM
           2) open()         → animate the drawer into view
           3) defer a tick so the section HTML has finished mounting
              before we trigger the open transition (avoids a flash
              of un-styled drawer content). */
      if(cartEl){
        if(typeof cartEl.cartAction === 'function'){
          try{ cartEl.cartAction(); }catch(_){}
        }
        if(cartEl.classList && cartEl.classList.contains('is-empty')){
          cartEl.classList.remove('is-empty');
        }
        setTimeout(() => {
          if(typeof cartEl.open === 'function'){
            try{ cartEl.open(); }catch(_){}
          }
        }, 0);
      }

      // Update header cart counts via a fresh /cart.json read.
      try{
        const cartRes  = await fetch('/cart.json');
        const cartJson = await cartRes.json();
        if(cartJson && cartJson.item_count !== undefined){
          document.querySelectorAll('.cart-count').forEach(el => {
            if(el.classList.contains('cart-count-drawer')){
              el.innerHTML = '(' + cartJson.item_count + ')';
            } else {
              el.innerHTML = cartJson.item_count > 100 ? '~' : cartJson.item_count;
            }
          });
        }
      }catch(_){}

      // Mode B discount code attaches after a successful add.
      if(pendingDiscountCode) applyDiscountCode(pendingDiscountCode);
    }catch(err){
      console.warn('[bundle-save] add-to-cart failed', err);
    }finally{
      btn.__bundleAdding = false;
      btn.removeAttribute('aria-disabled');
      btn.classList.remove('loading');
    }
  }
  function hookButton(btn){
    if(btn.__bundleHooked) return;
    btn.__bundleHooked = true;
    btn.addEventListener('click', handleAddClick, true);
  }
  function hookAddButtons(){
    document.querySelectorAll(
      'button[name="add"], form[action*="/cart/add"] button[type="submit"]'
    ).forEach(hookButton);
  }
  hookAddButtons();
  new MutationObserver(() => hookAddButtons())
    .observe(document.body, { childList: true, subtree: true });
})();
{% comment %}{% endcomment %}</script>


</template>