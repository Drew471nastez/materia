<template compat="shopify">
{%- comment -%}
  Materia Themes. Eyebrow, heading, subheading and button blocks of the Logos
  and trust sections. Colours follow the colour scheme until the block's
  custom styling is on; the button follows Theme settings > Buttons until its
  theme shape is off. live-logos.js derives the same values in the builder.
  {% render 'logos-text', block: block, fallback_href: '' %}
  own_size: true marks a heading whose line height the section sets (data-own-size).
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign own = bs.enable_custom_style -%}
{%- case block.type -%}
  {%- when 'eyebrow' -%}
    <p class="lg__eyebrow" {% render 'logos-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--lg-text)' %}{% else %}var(--lg-text){% endif %};--b-fs: {{ bs.size | default: 13 }}px;--b-tt: {% if bs.uppercase == false %}none{% else %}uppercase{% endif %};">{{ bs.text }}</p>
  {%- when 'heading' -%}
    <h2 class="lg__heading" {% render 'logos-block', block: block %}{% if bs.text == blank %} hidden{% endif %}{% if own_size %} data-own-size{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--lg-heading)' %}{% else %}var(--lg-heading){% endif %};--b-fs-m: {{ bs.size_mobile | default: 26 }}px;--b-fs-d: {{ bs.size_desktop | default: 32 }}px;">{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    <div class="lg__sub" {% render 'logos-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--lg-text)' %}{% else %}var(--lg-text){% endif %};--b-fs-m: {{ bs.size_mobile | default: 15 }}px;--b-fs-d: {{ bs.size_desktop | default: 16 }}px;">{{ bs.text }}</div>
  {%- when 'button' -%}
    {%- capture btn_style -%}
      {%- if own -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
      {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius }}px;--mb-padding-y: {{ bs.padding_y }}px;--mb-padding-x: {{ bs.padding_x }}px;--mb-font-size: {{ bs.font_size }}px;--mb-weight: {{ bs.font_weight | default: 600 }};--btn-border-width: {{ bs.border_width }}px;--mb-border-width: {{ bs.border_width }}px;{%- endif -%}
      {%- if bs.uppercase -%}--btn-text-transform: uppercase;{%- endif -%}
    {%- endcapture -%}
    {%- capture btn_attrs -%}class="lg__btn" data-theme-button="{% if bs.button_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-full="{% if bs.full_width %}true{% else %}false{% endif %}"{% if bs.use_theme_button == false %} data-own-shape data-own-weight{% endif %} {% render 'logos-block', block: block %}{% if bs.label == blank %} hidden{% endif %} style="{{ btn_style }}"{%- endcapture -%}
    {%- assign href = bs.link | default: fallback_href -%}
    {%- if href != blank -%}
      <a href="{{ href | url }}" {{ btn_attrs }}>{{ bs.label | escape }}</a>
    {%- else -%}
      <button type="button" {{ btn_attrs }}>{{ bs.label | escape }}</button>
    {%- endif -%}
{%- endcase -%}
</template>
