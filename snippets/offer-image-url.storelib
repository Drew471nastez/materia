<template compat="shopify">
{%- liquid
  assign src = image.src | default: image.url | default: image.preview_image.src | default: image.preview_image.url
  if src == blank and image != blank
    if image.id != blank
      assign sized = image | image_url: width: 480
      assign src = sized.src | default: sized.url | default: sized
    else
      assign src = image
    endif
  endif
  if src contains 'object Object'
    assign src = ''
  endif
-%}
{%- if escaped -%}{{- src | escape -}}{%- else -%}{{- src -}}{%- endif -%}
</template>
