<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared frame of the two round 7 Image and video sections
  (Lightbox Gallery, Video Playlist): section margins, the theme's space
  between sections, padding, width and the heading and text blocks. Every
  value is a CSS variable the section prints on its root (.r7m) and
  live-r7-media.js writes again in the builder, so the first paint and a live
  edit use the same rules.
  {% render 'r7-media-style', section: section, bp: 750 %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign bp = bp | default: 750
-%}
<style>
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} {
    --r7-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px; --r7-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
    --r7-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px; --r7-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px;
    margin-top: var(--r7-mt-m) !important; margin-bottom: var(--r7-mb-m) !important;
  }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: var(--r7-mt-d) !important; margin-bottom: var(--r7-mb-d) !important; }
  }
  #shopify-section-{{ sid }} .r7m { background: var(--r7-bg); color: var(--r7-text); font-family: var(--r7-bf); padding: var(--r7-pt-m) var(--r7-px-m) var(--r7-pb-m); box-sizing: border-box; }
  #shopify-section-{{ sid }} .r7m *, #shopify-section-{{ sid }} .r7m *::before, #shopify-section-{{ sid }} .r7m *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .r7m [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .r7m :is(h2, h3) { font-family: var(--r7-hf); }
  #shopify-section-{{ sid }} .r7m__inner { width: 100%; margin-inline: auto; }
  #shopify-section-{{ sid }} .r7m[data-width='container'] .r7m__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .r7m[data-width='fluid_container'] .r7m__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .r7m[data-width='stretch_width'] .r7m__inner { padding-inline: 3rem; } }

  #shopify-section-{{ sid }} .r7m__header { display: flex; flex-direction: column; gap: var(--r7-cgap); align-items: flex-start; text-align: left; margin-bottom: 24px; }
  #shopify-section-{{ sid }} .r7m[data-align-m='center'] .r7m__header { align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .r7m[data-align-m='right'] .r7m__header { align-items: flex-end; text-align: right; }
  #shopify-section-{{ sid }} .r7m__header > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .r7m__heading { color: var(--b-c); font-size: var(--b-fs-m); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .r7m__sub { color: var(--b-c); font-size: var(--b-fs-m); line-height: 1.6; max-width: 640px; }
  #shopify-section-{{ sid }} .r7m__sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .r7m__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .r7m__sub a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }} .r7m { padding: var(--r7-pt-d) var(--r7-px-d) var(--r7-pb-d); }
    #shopify-section-{{ sid }} .r7m__header { margin-bottom: 36px; }
    #shopify-section-{{ sid }} .r7m[data-align='left'] .r7m__header { align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .r7m[data-align='center'] .r7m__header { align-items: center; text-align: center; }
    #shopify-section-{{ sid }} .r7m[data-align='right'] .r7m__header { align-items: flex-end; text-align: right; }
    #shopify-section-{{ sid }} .r7m__heading, #shopify-section-{{ sid }} .r7m__sub { font-size: var(--b-fs-d); }
  }
</style>
<style data-rs-bulletproof data-r7m-reset{% unless st.reset_spacing %} media="not all"{% endunless %}>
  #shopify-section-{{ sid }} { padding-top: 0 !important; padding-bottom: 0 !important; --section-spacing: 0px; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
  .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
</style>
</template>
