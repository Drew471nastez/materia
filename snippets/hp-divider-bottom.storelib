<template compat="shopify">
{%- comment -%}
  Materia Themes — Bottom pattern divider snippet.

  Drop at the bottom of any section to add a wavy / zig-zag / curve /
  scallop / triangle / arch / line shaped transition into the next
  section. The SVG is painted in `color` (typically the next section's
  background) and overlaps the section's bottom edge.

  Usage:
    {% render 'hp-divider-bottom',
       style: 'wave',
       color: '#ffffff',
       height_desktop: 60,
       height_mobile: 40,
       flip: false
    %}

  Available styles:
    none, wave, wave_soft, zigzag, curve_down, arch_up, triangles,
    scallop, tilt_left, tilt_right, straight
{%- endcomment -%}

{%- liquid
  assign _style = style | default: 'wave'
  if _style == 'none' or _style == blank
    assign _style = 'none'
  endif
  assign _color = color | default: '#FFFFFF'
  assign _hd = height_desktop | default: 60
  assign _hm = height_mobile  | default: 40
  assign _did = id_suffix | default: ''
-%}

{%- if _style != 'none' -%}
  <div class="hp-divider-bottom hp-divider-bottom--{{ _style }}{% if flip %} hp-divider-bottom--flipped{% endif %}"
       data-style="{{ _style }}"
       aria-hidden="true">
    {%- case _style -%}
      {%- when 'wave' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,60 C200,120 400,0 600,60 C800,120 1000,0 1200,60 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'wave_soft' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,80 Q300,40 600,80 T1200,80 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'zigzag' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,90 L60,30 L120,90 L180,30 L240,90 L300,30 L360,90 L420,30 L480,90 L540,30 L600,90 L660,30 L720,90 L780,30 L840,90 L900,30 L960,90 L1020,30 L1080,90 L1140,30 L1200,90 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'curve_down' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,0 Q600,140 1200,0 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'arch_up' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,120 Q600,-30 1200,120 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'triangles' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,120 L60,0 L120,120 L180,0 L240,120 L300,0 L360,120 L420,0 L480,120 L540,0 L600,120 L660,0 L720,120 L780,0 L840,120 L900,0 L960,120 L1020,0 L1080,120 L1140,0 L1200,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'scallop' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,30 A60,60 0 0 1 120,30 A60,60 0 0 1 240,30 A60,60 0 0 1 360,30 A60,60 0 0 1 480,30 A60,60 0 0 1 600,30 A60,60 0 0 1 720,30 A60,60 0 0 1 840,30 A60,60 0 0 1 960,30 A60,60 0 0 1 1080,30 A60,60 0 0 1 1200,30 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'tilt_left' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M0,30 L1200,120 L0,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'tilt_right' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <path d="M1200,30 L0,120 L1200,120 Z" fill="{{ _color }}"/>
        </svg>

      {%- when 'straight' -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
          <rect x="0" y="60" width="1200" height="60" fill="{{ _color }}"/>
        </svg>
    {%- endcase -%}
  </div>

  <style>
    .hp-divider-bottom {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      width: 100%;
      height: {{ _hm }}px;
      pointer-events: none;
      line-height: 0;
      z-index: 5;
    }
    @media (min-width: 768px) {
      .hp-divider-bottom { height: {{ _hd }}px; }
    }
    .hp-divider-bottom svg {
      display: block;
      width: 100%;
      height: 100%;
    }
    .hp-divider-bottom--flipped svg {
      transform: scaleX(-1);
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}

</template>