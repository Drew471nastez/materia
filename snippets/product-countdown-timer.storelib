<template compat="shopify">
{%- assign timer_end = product.metafields.custom.countdown_timer.value | default: product.metafields.custom.countdown_timer | default: block.settings.end_iso -%}
<product-countdown-badge class="mt-countdown-timer mt-countdown-timer--{{ block.settings.timer_style | default: 'default' }}" data-invalid="{% if timer_end == blank %}true{% else %}false{% endif %}" data-end="{{ timer_end | escape }}" data-on-end="zeros"{% if request.design_mode %} data-editor-preview{% endif %} {{ block.shopify_attributes }}>
  {%- if block.settings.content != blank -%}<p class="mt-countdown-timer__heading">{{ block.settings.content }}</p>{%- endif -%}
  <div class="cd-row" role="timer" aria-live="off">
    <span><strong data-cd="days">00</strong><small>{{ 'products.product.countdown.days' | t }}</small></span>
    <span><strong data-cd="hours">00</strong><small>{{ 'products.product.countdown.hours' | t }}</small></span>
    <span><strong data-cd="mins">00</strong><small>{{ 'products.product.countdown.mins' | t }}</small></span>
    <span><strong data-cd="secs">00</strong><small>{{ 'products.product.countdown.secs' | t }}</small></span>
  </div>
</product-countdown-badge>
</template>
