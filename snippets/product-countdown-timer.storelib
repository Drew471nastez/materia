<template compat="shopify">
{%- assign ts = block.settings -%}
{%- capture timer_end -%}{%- render 'countdown-schedule', controls: ts, product: product, allow_product: true -%}{%- endcapture -%}
{%- assign timer_end = timer_end | strip -%}
<product-countdown-badge class="mt-countdown-timer mt-countdown-timer--{{ ts.timer_style | default: 'default' }}{% if ts.enable_custom_style %} mt-countdown-timer--custom{% endif %}" data-invalid="{% if timer_end == blank %}true{% else %}false{% endif %}" data-end="{{ timer_end | escape }}" data-on-end="{{ ts.on_end | default: 'zeros' }}"{% if request.design_mode %} data-editor-preview{% endif %} {{ block.shopify_attributes }}
 style="--ct-gap:{{ ts.item_gap | default: 8 }}px;--ct-top:{{ ts.padding_top | default: 8 }}px;--ct-bottom:{{ ts.padding_bottom | default: 20 }}px;{% if ts.enable_custom_style %}--ct-bg:{{ ts.custom_bg | default: 'var(--color-background)' }};--ct-number:{{ ts.custom_number_color | default: 'var(--color-heading)' }};--ct-heading:{{ ts.custom_heading_color | default: 'var(--color-heading)' }};--ct-label:{{ ts.custom_label_color | default: 'var(--color-text)' }};--ct-border:{{ ts.custom_border | default: 'var(--color-border)' }};--ct-radius:{{ ts.custom_radius | default: 6 }}px;--ct-number-size:{{ ts.number_size | default: 20 }}px;--ct-pad:{{ ts.custom_padding | default: 12 }}px;{% endif %}">
  {%- if block.settings.content != blank -%}<p class="mt-countdown-timer__heading">{{ block.settings.content }}</p>{%- endif -%}
  <div class="cd-row" role="timer" aria-live="off">
    <span><strong data-cd="days">00</strong><small>{{ 'products.product.countdown.days' | t }}</small></span>
    <span><strong data-cd="hours">00</strong><small>{{ 'products.product.countdown.hours' | t }}</small></span>
    <span><strong data-cd="mins">00</strong><small>{{ 'products.product.countdown.mins' | t }}</small></span>
    <span><strong data-cd="secs">00</strong><small>{{ 'products.product.countdown.secs' | t }}</small></span>
  </div>
  <p class="cd-ended" hidden>{{ ts.ended_text | default: 'Countdown ended' | escape }}</p>
  <p data-countdown-status>{{ ts.invalid_date_label | default: 'Choose a valid end date and time.' | escape }}</p>
</product-countdown-badge>
</template>
