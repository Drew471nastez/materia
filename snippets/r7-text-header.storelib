<template compat="shopify">
{%- comment -%}
  Materia Themes. The header of Text Columns and Sticky Heading Text: the
  eyebrow, heading, subheading and button blocks in their order.
  p: the section's class prefix (txc, sht).

  Theme first: colours from the colour scheme, type from Theme settings >
  Typography, the button from Theme settings > Buttons. A block's own colour,
  font, weight, size or button shape is printed only while its switch is on,
  as a CSS variable the section's styles read, and the element then carries
  data-own-font / data-own-weight / data-own-size / data-own-shape so it
  keeps its value ahead of "Use in every section" (snippets/theme-controls).
  live-r7-text.js writes the same variables and attributes on a live edit.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign has_header = false
  for block in section.blocks
    if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subheading' or block.type == 'button'
      assign has_header = true
    endif
  endfor
-%}
{%- if has_header -%}
<div class="{{ p }}__header" data-r7t-header>
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- case block.type -%}
      {%- when 'eyebrow' -%}
        {%- capture hb_vars -%}
          {%- if bs.enable_custom_style -%}--hb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
        {%- endcapture -%}
        <p class="{{ p }}__eyebrow" data-r7t-block="{{ block.id }}" data-r7t-type="eyebrow"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if hb_vars != blank %} style="{{ hb_vars | strip }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
      {%- when 'heading' -%}
        {%- capture hb_vars -%}
          {%- if bs.enable_custom_style -%}--hb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
          {%- if bs.weight_enable -%}--hb-fw:{{ bs.weight | default: 700 }};{%- endif -%}
          {%- if bs.size_enable -%}--hb-fs-d:{{ bs.size_desktop | default: 40 }}px;--hb-fs-m:{{ bs.size_mobile | default: 30 }}px;--hb-lh:{{ bs.line_height | default: 1.15 }};--hb-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
          {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--hb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
        {%- endcapture -%}
        {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
        <h2 class="{{ p }}__heading" data-r7t-block="{{ block.id }}" data-r7t-type="heading"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if hb_vars != blank %} style="{{ hb_vars | strip }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
      {%- when 'subheading' -%}
        {%- capture hb_vars -%}
          {%- if bs.enable_custom_style -%}--hb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
          {%- if bs.weight_enable -%}--hb-fw:{{ bs.weight | default: 400 }};{%- endif -%}
          {%- if bs.size_enable -%}--hb-fs:{{ bs.size | default: 17 }}px;--hb-lh:{{ bs.line_height | default: 1.6 }};{%- endif -%}
          {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--hb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families | default: 'sans-serif' }};{%- endif -%}
        {%- endcapture -%}
        {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
        <div class="{{ p }}__subheading" data-r7t-block="{{ block.id }}" data-r7t-type="subheading"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if hb_vars != blank %} style="{{ hb_vars | strip }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
      {%- when 'button' -%}
        {%- liquid
          assign own_shape = false
          if bs.use_theme_button == false
            assign own_shape = true
          endif
          assign role = 'primary'
          if bs.style == 'secondary'
            assign role = 'secondary'
          endif
        -%}
        {%- capture btn_vars -%}
          {%- if bs.enable_custom_style -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.bg_color, fallback: 'unset' %}{%- endcapture -%}{%- assign c = c | strip -%}
            {%- if c != 'unset' -%}--mb-bg:{{ c }};--mb-border:{{ c }};{%- endif -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.text_color, fallback: 'unset' %}{%- endcapture -%}{%- assign c = c | strip -%}
            {%- if c != 'unset' -%}--mb-text:{{ c }};{%- endif -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.border_color, fallback: 'unset' %}{%- endcapture -%}{%- assign c = c | strip -%}
            {%- if c != 'unset' -%}--mb-border:{{ c }};{%- endif -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.bg_color_hover, fallback: 'unset' %}{%- endcapture -%}{%- assign c = c | strip -%}
            {%- if c != 'unset' -%}--mb-hover-bg:{{ c }};--mb-hover-border:{{ c }};{%- endif -%}
            {%- capture c -%}{% render 'scheme-color', color: bs.text_color_hover, fallback: 'unset' %}{%- endcapture -%}{%- assign c = c | strip -%}
            {%- if c != 'unset' -%}--mb-hover-text:{{ c }};{%- endif -%}
          {%- endif -%}
          {%- if own_shape -%}--mb-radius:{{ bs.radius | default: 0 }}px;--mb-padding-x:{{ bs.pad_x | default: 28 }}px;--mb-padding-y:{{ bs.pad_y | default: 14 }}px;--mb-font-size:{{ bs.size | default: 16 }}px;{%- endif -%}
        {%- endcapture -%}
        <div class="{{ p }}__action" data-r7t-block="{{ block.id }}" data-r7t-type="button"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>
          {%- if bs.link != blank -%}
            <a class="{{ p }}__btn" href="{{ bs.link }}" data-theme-button="{{ role }}" data-sl-button data-r7t-btn{% if own_shape %} data-own-shape{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip }}"{% endif %}>{{ bs.label | escape }}</a>
          {%- else -%}
            <button type="button" class="{{ p }}__btn" data-theme-button="{{ role }}" data-sl-button data-r7t-btn{% if own_shape %} data-own-shape{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip }}"{% endif %}>{{ bs.label | escape }}</button>
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>
{%- endif -%}
</template>
