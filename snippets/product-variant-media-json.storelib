<template compat="shopify">
{%- comment -%}
  Materia Themes. Each variant's picture, so the gallery can always go to it
  (theme.js variantMediaInfo / updateMedia). Main product and Featured
  product.
{%- endcomment -%}
{%- unless product == empty or product == blank -%}
<script type="application/json" data-variant-media>
  {
  {%- for variant in product.variants -%}
    {%- assign vm_media = variant.featured_media -%}
    {%- assign vm_id = vm_media.id | default: variant.featured_image.id | default: '' | append: '' -%}
    {%- assign vm_src = vm_media.preview_image.src | default: variant.featured_image.src | default: '' | append: '' -%}
    {{ variant.id | append: '' | json }}: { "id": {{ vm_id | json }}, "src": {{ vm_src | json }} }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  }
{% comment %}{% endcomment %}</script>
{%- endunless -%}
</template>
