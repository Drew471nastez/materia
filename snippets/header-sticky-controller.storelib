<template compat="shopify">
<style>
  /* One sticky engine. The bar sticks under the announcement, and "show on
     scroll up" slides the whole section. Transform stays off the header itself
     so the fixed mobile menu is never trapped inside the bar. */
  #shopify-section-{{ section.id }}[data-storelib-sticky] {
    animation: none !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="none"] {
    position: relative !important;
    top: auto !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]) {
    position: sticky !important;
    top: var(--storelib-header-top, 0px) !important;
    z-index: 11;
    transform: none !important;
    animation: none !important;
    /* Coming back on scroll up: a gentle ease in and out, so the bar glides
       in instead of jumping most of the way in the first frames. */
    transition: transform 450ms cubic-bezier(.45, 0, .2, 1), z-index 0s 0.55s;
  }
  /* Show on scroll up keeps the bar on its own layer from the start, so
     Safari never creates one in the first frame of the slide (a snap). */
  #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"] {
    will-change: transform;
    backface-visibility: hidden;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"].shopify-section-header-hidden {
    transform: translate3d(0, calc(-100% - var(--storelib-header-top, 0px)), 0) !important;
    pointer-events: none;
    /* A gentle start when leaving, rather than snapping off on a small scroll. */
    transition: transform 520ms cubic-bezier(.4, 0, .2, 1), z-index 0s 0.55s;
  }
  #shopify-section-{{ section.id }} > header.header {
    transition: box-shadow .42s ease, background-color .42s ease, color .42s ease;
  }
  #shopify-section-{{ section.id }} > header.header::before {
    transition: opacity .42s ease, background-color .42s ease;
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  }
  {% if pgs.header_pill_mobile %}
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  {% endif %}
  /* Open menu covers the announcement and the bottom bar, and stays
     above them until the slide finishes. */
  html.nav-open #shopify-section-{{ section.id }}[data-storelib-sticky],
  html.nav-open #shopify-section-{{ section.id }} {
    transform: none !important;
    z-index: 40 !important;
    pointer-events: auto;
    overflow: visible !important;
    transition: z-index 0s 0s !important;
  }
  @media (max-width: 1024.98px) {
    .navigation.mobile {
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      height: 100dvh !important;
      max-height: none !important;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-sizing: border-box;
    }
  }
  /* While open on a phone the drawer is promoted to the browser's top layer
     (popover), so no wrapper, sticky bar or bottom bar can sit above it. */
  @media (max-width: 1024.98px) {
    .navigation.mobile[popover] {
      position: fixed !important;
      inset: 0 !important;
      margin: 0 !important;
      border: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      height: 100dvh !important;
      max-height: none !important;
      overflow: hidden;
      color: inherit;
      background: var(--color-background);
      z-index: auto;
    }
    .navigation.mobile[popover]::backdrop { background: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }}[data-storelib-sticky],
    #shopify-section-{{ section.id }} > header.header,
    #shopify-section-{{ section.id }} > header.header::before { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
<script>
(() => {
  if (!window.StorelibStickyStack) {
    /* Heights come from the ResizeObserver, which reports them after the
       browser's own layout, so this never lays out a page still arriving.
       Reads first, then only the values that changed are written. */
    let frame, top = 0;
    const html = document.documentElement;
    const sectionOf = el => el.closest('.shopify-section, [id^="shopify-section-"]');
    const observed = new Set();
    const heights = new WeakMap();
    const written = new WeakMap();
    const observer = new ResizeObserver(entries => {
      for (const entry of entries) {
        const box = entry.borderBoxSize && entry.borderBoxSize[0];
        heights.set(entry.target, box ? box.blockSize : entry.target.getBoundingClientRect().height);
      }
      update();
    });
    const attributes = new MutationObserver(schedule);
    function update() {
      if (frame != null) { cancelAnimationFrame(frame); frame = null; }
      const header = document.querySelector('header.header[data-sticky]');
      const bars = [...document.querySelectorAll('[data-sticky-announcement]')];
      const current = new Set(bars.flatMap(bar => [bar, sectionOf(bar)]).filter(Boolean));
      let changed = false;
      for (const el of observed) if (!current.has(el)) { observer.unobserve(el); observed.delete(el); changed = true; }
      for (const el of current) if (!observed.has(el)) { observed.add(el); observer.observe(el); changed = true; }
      if (changed) {
        attributes.disconnect();
        attributes.observe(html, {attributes: true, attributeFilter: ['class']});
        for (const el of observed) attributes.observe(el, {attributes: true, attributeFilter: ['data-sticky-announcement', 'hidden', 'class']});
      }
      let offset = 0;
      const tops = new Map();
      for (const bar of bars) {
        const root = sectionOf(bar);
        if (!root) continue;
        tops.set(root, offset);
        if (bar.dataset.stickyAnnouncement !== 'true') continue;
        if (header && !(bar.compareDocumentPosition(header) & Node.DOCUMENT_POSITION_FOLLOWING)) continue;
        const height = Math.round(heights.get(root) || 0);
        // Not laid out yet, or display: none (the observer reports 0).
        if (!height) continue;
        if (!heights.get(bar) && !bar.getClientRects().length) continue;
        const style = getComputedStyle(bar);
        if (style.display === 'none' || style.visibility === 'hidden') continue;
        offset += height;
      }
      for (const [root, value] of tops) {
        if (written.get(root) === value) continue;
        written.set(root, value);
        root.style.setProperty('--storelib-announcement-top', value + 'px');
      }
      const px = Math.max(0, offset) + 'px';
      if (written.get(html) !== px) {
        written.set(html, px);
        top = Math.max(0, offset);
        html.style.setProperty('--storelib-header-top', px);
        html.style.setProperty('--sl-header-offset', px);
        html.style.setProperty('--height-bar', px);
        window.StorelibHeaderSticky?.refresh();
      }
    }
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    // Sections added later (a builder redraw). Watched once the page has
    // arrived: during parsing every inserted node would be a record.
    const watch = () => new MutationObserver(records => {
      if (records.some(record => [...record.addedNodes, ...record.removedNodes].some(node => node.nodeType === 1 &&
          (node.matches?.('[data-sticky-announcement], header.header') || node.querySelector?.('[data-sticky-announcement], header.header'))))) schedule();
    }).observe(html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    addEventListener('resize', schedule, {passive:true});
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibStickyStack = {refresh: schedule, get top() { return top; }};
  }
  window.StorelibStickyStack.refresh();
})();
(() => {
  if (!window.StorelibHeaderSticky) {
    /* One read pass, then one write pass, writing only what changed. The
       header's height comes from a ResizeObserver (reported after the
       browser's own layout); the scroll position is not read until the page
       has been scrolled or has loaded, because before that it is at the top
       and reading it would lay out a page still arriving. */
    let state, frame;
    let measured = document.readyState === 'complete';
    const html = document.documentElement;
    const wide = matchMedia('(min-width: 1025px)');
    const classes = ['scroll-up', 'header-sticky', 'scr-pass-header', 'animate', 'shopify-section-header-sticky', 'shopify-section-header-hidden'];
    const stale = ['animate', 'sl-hdr-hidden', 'sl-header-snap'];
    const pinsQuery = '.nav-open, .open-search, .open-minicart';
    let rootPinned = html.matches(pinsQuery);
    const findHeader = () => document.querySelector('header.header[data-sticky]');
    const teardown = () => {
      state?.resize?.disconnect();
      state?.attributes?.disconnect();
      state?.marker?.remove();
    };
    const update = () => {
      if (frame != null) { cancelAnimationFrame(frame); frame = null; }
      const header = findHeader();
      if (!header) {
        teardown();
        state = null;
        return;
      }
      if (!state || state.header !== header) {
        teardown();
        const section = header.closest('.section-header, .shopify-section, [id^="shopify-section-"]');
        if (!section) return;
        const own = state = {header, section, lastY: 0, mode: null, hidden: false, height: null};
        own.resize = new ResizeObserver(entries => {
          if (state !== own) return;
          const box = entries[entries.length - 1].borderBoxSize?.[0];
          const height = Math.round(box ? box.blockSize : header.offsetHeight);
          if (height === own.height) return;
          own.height = height;
          update();
        });
        own.resize.observe(header);
        own.attributes = new MutationObserver(schedule);
        own.attributes.observe(header, {attributes: true, attributeFilter: ['data-sticky', 'data-sticky-mobile']});
      }
      const {section} = state;
      // Reads.
      const headerHeight = state.height;
      const stack = window.StorelibStickyStack;
      let mode = header.dataset.sticky;
      if (!['always', 'on-scroll-up'].includes(mode) ||
          (!wide.matches && header.dataset.stickyMobile === 'false')) mode = 'none';
      const changed = mode !== state.mode;
      /* Clamped to the real scroll range: the rubber band past the top or the
         bottom of the page on a phone is not a scroll up or down. */
      const y = measured && mode !== 'none' ? Math.min(Math.max(0, scrollY), Math.max(0, html.scrollHeight - innerHeight)) : 0;
      const barTop = typeof stack?.top === 'number' ? stack.top : (parseFloat(getComputedStyle(html).getPropertyValue('--storelib-header-top')) || 0);
      let pass = false;
      if (mode === 'on-scroll-up' && y > 0 && !changed && state.marker?.isConnected) {
        const threshold = state.marker.getBoundingClientRect().top + y + (headerHeight || 0);
        pass = y > threshold;
        const pinned = html.matches(pinsQuery) || header.contains(document.activeElement) ||
          (header.classList.contains('open-submenu') && header.matches(':hover'));
        const delta = y - state.lastY;
        if (!pass || pinned) {
          state.hidden = false;
          state.lastY = y;
        } else if (delta > 24) {
          state.hidden = true;
          state.lastY = y;
        } else if (delta < -12) {
          state.hidden = false;
          state.lastY = y;
        }
      } else {
        state.hidden = false;
        state.lastY = y;
      }
      // Writes.
      if (changed) {
        if (classes.some(c => section.classList.contains(c))) section.classList.remove(...classes);
        section.removeAttribute('data-sticky-always');
        state.mode = mode;
      }
      if (!state.marker?.isConnected) {
        state.marker = document.createElement('span');
        state.marker.dataset.headerAnchor = '';
        state.marker.style.cssText = 'display:block;height:0;pointer-events:none;';
        section.before(state.marker);
      }
      if (section.dataset.storelibSticky !== mode) section.dataset.storelibSticky = mode;
      section.toggleAttribute('data-sticky-always', mode === 'always');
      section.classList.toggle('scroll-up', mode === 'on-scroll-up');
      section.classList.toggle('scr-pass-header', pass);
      section.classList.toggle('header-sticky', pass);
      if (headerHeight != null) {
        const overlay = (header.classList.contains('transparent') && wide.matches) ||
          (header.classList.contains('transparent-mobile') && !wide.matches);
        const margin = overlay ? (-headerHeight) + 'px' : '';
        if (state.margin !== margin) {
          state.margin = margin;
          if (margin) section.style.setProperty('margin-bottom', margin, 'important');
          else section.style.removeProperty('margin-bottom');
        }
      }
      /* Solid only after leaving the top. A full header-height threshold left
         the bar transparent for a stretch of the scroll, then snapped solid. */
      section.classList.toggle('shopify-section-header-sticky', mode !== 'none' && y > 16);
      section.classList.toggle('shopify-section-header-hidden', state.hidden);
      /* --sticky-top: the bottom edge of what is pinned at the top right now
         (sticky announcement, plus the header while it shows). Sticky columns
         such as the product gallery sit under it. */
      if (headerHeight != null) {
        const stickyTop = Math.round(barTop + (mode !== 'none' && !state.hidden ? headerHeight : 0)) + 'px';
        if (state.productTop !== stickyTop) {
          state.productTop = stickyTop;
          html.style.setProperty('--product-sticky-top', stickyTop);
        }
        if (state.stickyTop !== stickyTop) {
          state.stickyTop = stickyTop;
          html.style.setProperty('--sticky-top', stickyTop);
        }
      }
      for (const c of stale) if (section.classList.contains(c)) section.classList.remove(c);
    };
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    // A header added later (a builder redraw). Watched once the page has
    // arrived: during parsing every inserted node would be a record.
    const watch = () => new MutationObserver(records => {
      if (records.some(r => [...r.addedNodes, ...r.removedNodes].some(n =>
        n.nodeType === 1 && (n.matches?.('header.header[data-sticky]') || n.querySelector?.('header.header[data-sticky]'))))) schedule();
    }).observe(html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    // Only the classes that hold the header in view matter here.
    new MutationObserver(() => {
      const pinned = html.matches(pinsQuery);
      if (pinned !== rootPinned) { rootPinned = pinned; schedule(); }
    }).observe(html, {attributes: true, attributeFilter: ['class']});
    const seen = () => { measured = true; };
    addEventListener('scroll', seen, {passive: true, once: true});
    addEventListener('scroll', schedule, {passive: true});
    addEventListener('resize', schedule, {passive: true});
    addEventListener('pageshow', () => { seen(); schedule(); });
    const inHeader = event => { if (state?.header.contains(event.target)) schedule(); };
    document.addEventListener('focusin', inHeader);
    document.addEventListener('focusout', inHeader);
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibHeaderSticky = {register: schedule, refresh: schedule};
  }
  window.StorelibHeaderSticky.refresh();
})();
{% comment %}{% endcomment %}</script>
{%- comment -%} The overlay fade, the Back button clean-up and the phone menu's top layer only answer the shopper, after the theme's deferred scripts: a cached file. {%- endcomment -%}
<script src="{{ 'header-sticky-extras.js' | asset_url }}" defer="defer"></script>
</template>
