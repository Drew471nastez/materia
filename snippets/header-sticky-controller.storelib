<template compat="shopify">
<style>
  /* Native position: sticky under any sticky bar above it, so the bar never
     trails the scroll. "Show on scroll up" only slides it (transform); its
     place in the page never changes. */
  #shopify-section-{{ section.id }}[data-storelib-sticky] {
    animation: none !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="none"] {
    position: relative !important;
    top: auto !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):not(:has(header.is-pill)) {
    position: sticky !important;
    top: var(--storelib-header-top, 0px) !important;
    z-index: 11;
    transform: none;
    animation: none !important;
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Own layer while it can slide (not with the phone menu open). */
  html:not(.nav-open) #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"].shopify-section-header-sticky {
    will-change: transform;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"].shopify-section-header-hidden:not(:has(header.is-pill)) {
    transform: translate3d(0, calc(-100% - var(--storelib-header-top, 0px) - 4px), 0) !important;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"].shopify-section-header-hidden > header.header {
    box-shadow: none !important;
  }
  span[data-header-anchor] {
    display: block;
    flex: 0 0 0px;
    height: 0;
    margin: 0;
    overflow-anchor: none;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} > header.header {
    transition: box-shadow .42s ease, background-color .42s ease, color .42s ease;
  }
  #shopify-section-{{ section.id }} > header.header::before {
    transition: opacity .42s ease, background-color .42s ease;
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  }
  {% if pgs.header_pill_mobile %}
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  {% endif %}
  /* While the phone menu is open the bar stays put, above the page. */
  html.nav-open #shopify-section-{{ section.id }} {
    transform: none !important;
    z-index: 40 !important;
    pointer-events: auto;
    overflow: visible !important;
    transition: none !important;
  }
  @media (max-width: 1024.98px) {
    .navigation.mobile {
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      height: 100dvh !important;
      max-height: none !important;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-sizing: border-box;
    }
  }
  /* While open on a phone the drawer is promoted to the browser's top layer
     (popover), so no wrapper, sticky bar or bottom bar can sit above it. */
  @media (max-width: 1024.98px) {
    .navigation.mobile[popover] {
      position: fixed !important;
      inset: 0 !important;
      /* The browser's popover padding (0.25em) was a dark strip down the
         left of the Menu bar. 100vw is wider than the screen once a
         scrollbar exists, which shoved that same edge out of place. */
      margin: 0 !important;
      border: 0 !important;
      padding: 0 !important;
      width: auto !important;
      max-width: none !important;
      height: 100dvh !important;
      max-height: none !important;
      overflow: hidden;
      color: inherit;
      background: var(--color-background);
      z-index: auto;
    }
    .navigation.mobile[popover]::backdrop { background: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }}[data-storelib-sticky],
    #shopify-section-{{ section.id }} > header.header,
    #shopify-section-{{ section.id }} > header.header::before { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
<script>
(() => {
  if (!window.StorelibStickyStack) {
    /* Heights come from the ResizeObserver, which reports them after the
       browser's own layout, so this never lays out a page still arriving.
       Reads first, then only the values that changed are written. */
    let frame, top = 0;
    const html = document.documentElement;
    const sectionOf = el => el.closest('.shopify-section, [id^="shopify-section-"]');
    const observed = new Set();
    const heights = new WeakMap();
    const written = new WeakMap();
    const observer = new ResizeObserver(entries => {
      for (const entry of entries) {
        const box = entry.borderBoxSize && entry.borderBoxSize[0];
        heights.set(entry.target, box ? box.blockSize : entry.target.getBoundingClientRect().height);
      }
      update();
    });
    const attributes = new MutationObserver(schedule);
    function update() {
      if (frame != null) { cancelAnimationFrame(frame); frame = null; }
      const header = document.querySelector('header.header[data-sticky]');
      const bars = [...document.querySelectorAll('[data-sticky-announcement]')];
      const current = new Set(bars.flatMap(bar => [bar, sectionOf(bar)]).filter(Boolean));
      let changed = false;
      for (const el of observed) if (!current.has(el)) { observer.unobserve(el); observed.delete(el); changed = true; }
      for (const el of current) if (!observed.has(el)) { observed.add(el); observer.observe(el); changed = true; }
      if (changed) {
        attributes.disconnect();
        attributes.observe(html, {attributes: true, attributeFilter: ['class']});
        for (const el of observed) attributes.observe(el, {attributes: true, attributeFilter: ['data-sticky-announcement', 'hidden', 'class']});
      }
      let offset = 0;
      const tops = new Map();
      for (const bar of bars) {
        const root = sectionOf(bar);
        if (!root) continue;
        tops.set(root, offset);
        if (bar.dataset.stickyAnnouncement !== 'true') continue;
        if (header && !(bar.compareDocumentPosition(header) & Node.DOCUMENT_POSITION_FOLLOWING)) continue;
        const height = heights.get(root) || 0;
        // Not laid out yet, or display: none (the observer reports 0).
        if (!height) continue;
        if (!heights.get(bar) && !bar.getClientRects().length) continue;
        const style = getComputedStyle(bar);
        if (style.display === 'none' || style.visibility === 'hidden') continue;
        offset += height;
      }
      for (const [root, value] of tops) {
        if (written.get(root) === value) continue;
        written.set(root, value);
        root.style.setProperty('--storelib-announcement-top', value + 'px');
      }
      const px = Math.max(0, offset) + 'px';
      if (written.get(html) !== px) {
        written.set(html, px);
        top = Math.max(0, offset);
        /* --storelib-header-top is the live bottom of every bar still on
           screen, written by the header pass. A sticky-only value here put
           the header underneath bars that are not marked sticky. */
        window.StorelibHeaderSticky?.refresh();
      }
    }
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    // Sections added later (a builder redraw). Watched once the page has
    // arrived: during parsing every inserted node would be a record.
    const watch = () => new MutationObserver(records => {
      if (records.some(record => [...record.addedNodes, ...record.removedNodes].some(node => node.nodeType === 1 &&
          (node.matches?.('[data-sticky-announcement], header.header') || node.querySelector?.('[data-sticky-announcement], header.header'))))) schedule();
    }).observe(html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    addEventListener('resize', schedule, {passive:true});
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibStickyStack = {refresh: schedule, get top() { return top; }};
  }
  window.StorelibStickyStack.refresh();
})();
(() => {
  if (!window.StorelibHeaderSticky) {
    /* Per frame at most one read pass, then only changed values written. */
    let state, frame;
    // The scroll position is not read before the page is scrolled or loaded.
    let measured = document.readyState === 'complete';
    const html = document.documentElement;
    const wide = matchMedia('(min-width: 1025px)');
    const LOCK = '.nav-open, .nav-closing, .open-drawer, .open-search, .open-minicart';
    const legacy = ['animate', 'scr-pass-header', 'sl-hdr-hidden', 'sl-header-snap'];
    const findHeader = () => document.querySelector('header.header[data-sticky]');
    const setVar = (el, name, value) => { if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value); };
    const teardown = () => {
      state?.resize?.disconnect();
      state?.attributes?.disconnect();
      state?.marker?.remove();
    };
    const setup = header => {
      teardown();
      const section = header.closest('.section-header, .shopify-section, [id^="shopify-section-"]');
      if (!section) return null;
      const own = {header, section, mode: null, hidden: false, height: 0, lastY: 0, turnY: 0, dir: 0, locked: false};
      own.resize = new ResizeObserver(entries => {
        if (state !== own) return;
        // The open phone menu lives in the bar; its full-screen size is not the bar's.
        if (html.matches(LOCK)) return;
        const box = entries[entries.length - 1].borderBoxSize?.[0];
        const height = Math.round(box ? box.blockSize : header.offsetHeight);
        if (height && height !== own.height) { own.height = height; schedule(); }
      });
      own.resize.observe(header);
      own.attributes = new MutationObserver(schedule);
      own.attributes.observe(header, {attributes: true, attributeFilter: ['data-sticky', 'data-sticky-mobile', 'class']});
      /* A wrapper around the whole header group would end sticky when it
         scrolls away: it is laid out as if it were not there. */
      const group = section.parentElement;
      if (group && group !== document.body && group.tagName !== 'MAIN' && !group.querySelector('main') &&
          [...group.children].some(el => el !== section && el.matches('.shopify-section, [id^="shopify-section-"]'))) {
        group.style.setProperty('display', 'contents', 'important');
      }
      own.marker = document.createElement('span');
      own.marker.dataset.headerAnchor = '';
      own.marker.setAttribute('aria-hidden', 'true');
      section.before(own.marker);
      return own;
    };
    const update = () => {
      frame = null;
      const header = findHeader();
      if (!header) { teardown(); state = null; return; }
      if (!state || state.header !== header || !state.section.isConnected) {
        state = setup(header);
        if (!state) return;
      }
      if (!state.marker.isConnected) state.section.before(state.marker);
      const s = state, {section} = s;
      let mode = header.dataset.sticky;
      if (!['always', 'on-scroll-up'].includes(mode) || (!wide.matches && header.dataset.stickyMobile === 'false')) mode = 'none';
      const pill = header.classList.contains('is-pill');
      const top = Math.max(0, window.StorelibStickyStack?.top || 0);
      /* A drawer or the phone menu locks the page. If the page still scrolls
         a good way, the class was left behind and no longer holds the bar. */
      let locked = html.matches(LOCK);
      if (locked) {
        if (s.lockY == null) s.lockY = scrollY;
        else if (Math.abs(scrollY - s.lockY) > 120) locked = false;
      } else s.lockY = null;
      // Reads.
      const y = measured ? Math.min(Math.max(0, scrollY), Math.max(0, html.scrollHeight - innerHeight)) : 0;
      // At the top of the page nothing needs the layout: it is not read.
      if (!s.height && y > 0) s.height = Math.round(header.getBoundingClientRect().height);
      const height = s.height;
      const slot = y > 0 ? s.marker.getBoundingClientRect().top : Infinity;
      // Decide.
      if (locked) {
        // A drawer, search or the phone menu holds the page: nothing moves.
        s.locked = true;
      } else {
        if (s.locked) { s.locked = false; s.lastY = s.turnY = y; s.hidden = false; }
        if (mode === 'on-scroll-up' && !pill) {
          /* Hides once its place has scrolled away, on a real change of
             direction (12px down hides, 8px up shows). */
          const delta = y - s.lastY;
          const dir = delta > 0 ? 1 : delta < 0 ? -1 : s.dir;
          if (dir !== s.dir) { s.dir = dir; s.turnY = s.lastY; }
          const away = slot + height <= top + 1;
          /* Over an open dropdown it stays. Focus never holds it: closing the
             phone menu focuses the hamburger, which froze the bar. */
          const held = header.classList.contains('open-submenu') && header.matches(':hover');
          if (s.reveal) { s.reveal = false; s.hidden = false; s.turnY = y; }
          if (!away || held || y <= 0) s.hidden = false;
          else if (dir > 0 && y - s.turnY > 12) s.hidden = true;
          else if (dir < 0 && s.turnY - y > 8) s.hidden = false;
        } else {
          s.hidden = false;
        }
        s.lastY = y;
      }
      const overlay = (header.classList.contains('transparent') && wide.matches) ||
        (header.classList.contains('transparent-mobile') && !wide.matches);
      // Writes.
      if (mode !== s.mode) {
        s.mode = mode;
        section.classList.remove(...legacy);
        s.hidden = false;
      }
      if (section.dataset.storelibSticky !== mode) section.dataset.storelibSticky = mode;
      section.toggleAttribute('data-sticky-always', mode === 'always');
      section.classList.toggle('scroll-up', mode === 'on-scroll-up');
      // Solid once the page has left the top (the transparent header fades to it).
      const scrolled = mode !== 'none' && y > 8;
      section.classList.toggle('shopify-section-header-sticky', scrolled);
      section.classList.toggle('header-sticky', scrolled && slot <= top + 1);
      section.classList.toggle('shopify-section-header-hidden', s.hidden);
      // A transparent header lies over what follows it.
      const margin = overlay && height ? -height + 'px' : '';
      if (s.margin !== margin) {
        s.margin = margin;
        if (margin) section.style.setProperty('margin-bottom', margin, 'important');
        else section.style.removeProperty('margin-bottom');
      }
      const px = top + 'px';
      setVar(html, '--storelib-header-top', px);
      setVar(html, '--sl-header-offset', px);
      // --sticky-top: bottom edge of what is pinned now; sticky columns sit under it.
      const pinned = mode !== 'none' && !s.hidden ? height : 0;
      const stickyTop = Math.round(top + pinned) + 'px';
      setVar(html, '--sticky-top', stickyTop);
      setVar(html, '--product-sticky-top', stickyTop);
    };
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    // A header drawn again (a builder redraw) or added later.
    const watch = () => new MutationObserver(records => {
      for (const r of records) for (const n of [...r.addedNodes, ...r.removedNodes]) {
        if (n.nodeType === 1 && (n.matches('header.header[data-sticky]') || n.querySelector('header.header[data-sticky]'))) return schedule();
      }
    }).observe(document.body || html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    new MutationObserver(schedule).observe(html, {attributes: true, attributeFilter: ['class']});
    const seen = () => { measured = true; };
    addEventListener('scroll', seen, {passive: true, once: true});
    addEventListener('scroll', schedule, {passive: true});
    addEventListener('resize', schedule, {passive: true});
    addEventListener('pageshow', () => { seen(); schedule(); });
    addEventListener('load', () => { seen(); schedule(); }, {once: true});
    wide.addEventListener?.('change', schedule);
    // Tabbing into the hidden bar brings it into view once; scrolling still hides it.
    let tabbing = false;
    document.addEventListener('keydown', e => { tabbing = e.key === 'Tab'; }, true);
    document.addEventListener('pointerdown', () => { tabbing = false; }, true);
    document.addEventListener('focusin', e => {
      if (tabbing && state?.header.contains(e.target)) { state.reveal = true; schedule(); }
    });
    ['storelib:section-load', 'shopify:section:load', 'shopify:section:unload'].forEach(n => document.addEventListener(n, schedule));
    window.StorelibHeaderSticky = {register: schedule, refresh: schedule};
  }
  window.StorelibHeaderSticky.refresh();
})();
{% comment %}{% endcomment %}</script>
{%- comment -%} The overlay fade, the Back button clean-up and the phone menu's top layer only answer the shopper, after the theme's deferred scripts: a cached file. {%- endcomment -%}
<script src="{{ 'header-sticky-extras.js' | asset_url }}" defer="defer"></script>
</template>
