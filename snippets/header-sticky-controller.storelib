<template compat="shopify">
<style>
  /* One sticky engine. The bar sticks under the announcement, and "show on
     scroll up" slides the whole section. Transform stays off the header itself
     so the fixed mobile menu is never trapped inside the bar. */
  #shopify-section-{{ section.id }}[data-storelib-sticky] {
    animation: none !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="none"] {
    position: relative !important;
    top: auto !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]) {
    position: sticky !important;
    top: var(--storelib-header-top, 0px) !important;
    z-index: 11;
    transform: none !important;
    animation: none !important;
    transition: transform 420ms cubic-bezier(.22, .61, .36, 1), z-index 0s 0.55s;
  }
  #shopify-section-{{ section.id }}[data-storelib-sticky="on-scroll-up"].shopify-section-header-hidden {
    transform: translate3d(0, calc(-100% - var(--storelib-header-top, 0px)), 0) !important;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} > header.header {
    transition: box-shadow .42s ease, background-color .42s ease, color .42s ease;
  }
  #shopify-section-{{ section.id }} > header.header::before {
    transition: opacity .42s ease, background-color .42s ease;
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  }
  {% if pgs.header_pill_mobile %}
    #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: fixed !important; }
  {% endif %}
  /* Open menu covers the announcement and the bottom bar, and stays
     above them until the slide finishes. */
  html.nav-open #shopify-section-{{ section.id }}[data-storelib-sticky],
  html.nav-open #shopify-section-{{ section.id }} {
    transform: none !important;
    z-index: 40 !important;
    pointer-events: auto;
    overflow: visible !important;
    transition: z-index 0s 0s !important;
  }
  @media (max-width: 1024.98px) {
    .navigation.mobile {
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      height: 100dvh !important;
      max-height: none !important;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-sizing: border-box;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }}[data-storelib-sticky],
    #shopify-section-{{ section.id }} > header.header,
    #shopify-section-{{ section.id }} > header.header::before { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
<script>
(() => {
  if (!window.StorelibStickyStack) {
    let frame;
    const observed = new Set();
    const observer = new ResizeObserver(schedule);
    function update() {
      frame = null;
      const header = document.querySelector('header.header[data-sticky]');
      const bars = [...document.querySelectorAll('[data-sticky-announcement]')];
      const current = new Set(bars.flatMap(bar => [bar, bar.closest('.shopify-section, [id^="shopify-section-"]')]).filter(Boolean));
      for (const el of observed) if (!current.has(el)) { observer.unobserve(el); observed.delete(el); }
      for (const el of current) if (!observed.has(el)) { observed.add(el); observer.observe(el); }
      let offset = 0;
      for (const bar of bars) {
        const root = bar.closest('.shopify-section, [id^="shopify-section-"]');
        if (!root) continue;
        root.style.setProperty('--storelib-announcement-top', offset + 'px');
        const style = getComputedStyle(bar);
        const rootStyle = getComputedStyle(root);
        const visible = bar.getClientRects().length && style.display !== 'none' && rootStyle.display !== 'none' && style.visibility !== 'hidden';
        const beforeHeader = !header || (bar.compareDocumentPosition(header) & Node.DOCUMENT_POSITION_FOLLOWING);
        if (bar.dataset.stickyAnnouncement === 'true' && visible && beforeHeader) {
          offset += Math.round(root.getBoundingClientRect().height);
        }
      }
      const px = Math.max(0, offset) + 'px';
      document.documentElement.style.setProperty('--storelib-header-top', px);
      document.documentElement.style.setProperty('--sl-header-offset', px);
      document.documentElement.style.setProperty('--height-bar', px);
    }
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    new MutationObserver(records => {
      if (records.some(record => record.type === 'attributes' && (observed.has(record.target) || record.target === document.documentElement) ||
        record.type === 'childList' && [...record.addedNodes, ...record.removedNodes].some(node => node.nodeType === 1 &&
          (node.matches?.('[data-sticky-announcement], header.header') || node.querySelector?.('[data-sticky-announcement], header.header'))))) schedule();
    }).observe(document.documentElement, {subtree:true,childList:true,attributes:true,attributeFilter:['data-sticky-announcement','hidden','class']});
    addEventListener('resize', schedule, {passive:true});
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibStickyStack = {refresh:schedule};
  }
  window.StorelibStickyStack.refresh();
})();
(() => {
  if (!window.StorelibHeaderSticky) {
    let state, frame;
    const classes = ['scroll-up', 'header-sticky', 'scr-pass-header', 'animate', 'shopify-section-header-sticky', 'shopify-section-header-hidden'];
    const findHeader = () => document.querySelector('header.header[data-sticky]');
    const update = () => {
      frame = null;
      const header = findHeader();
      if (!header) {
        state?.resize?.disconnect();
        state?.attributes?.disconnect();
        state?.marker?.remove();
        state = null;
        return;
      }
      if (!state || state.header !== header) {
        state?.resize?.disconnect();
        state?.attributes?.disconnect();
        state?.marker?.remove();
        const section = header.closest('.section-header, .shopify-section, [id^="shopify-section-"]');
        if (!section) return;
        state = {header, section, lastY: Math.max(0, scrollY), mode: null, hidden: false};
        state.resize = new ResizeObserver(schedule);
        state.resize.observe(header);
        state.attributes = new MutationObserver(schedule);
        state.attributes.observe(header, {attributes: true, attributeFilter: ['data-sticky', 'data-sticky-mobile']});
      }
      const {section} = state;
      const y = Math.max(0, scrollY);
      let mode = header.dataset.sticky;
      if (!['always', 'on-scroll-up'].includes(mode) ||
          (innerWidth < 1025 && header.dataset.stickyMobile === 'false')) mode = 'none';
      const changed = mode !== state.mode;
      if (changed) {
        section.classList.remove(...classes);
        section.removeAttribute('data-sticky-always');
        state.hidden = false;
        state.lastY = y;
        state.mode = mode;
      }
      if (!state.marker?.isConnected) {
        state.marker = document.createElement('span');
        state.marker.dataset.headerAnchor = '';
        state.marker.style.cssText = 'display:block;height:0;pointer-events:none;';
        section.before(state.marker);
      }
      const threshold = state.marker.getBoundingClientRect().top + y + header.offsetHeight;
      const pinned = document.documentElement.matches('.nav-open, .open-search, .open-minicart') ||
        header.contains(document.activeElement) ||
        (header.classList.contains('open-submenu') && header.matches(':hover'));
      const delta = y - state.lastY;
      if (mode !== 'on-scroll-up' || y <= threshold || pinned || changed) {
        state.hidden = false;
        state.lastY = y;
      } else if (delta > 8) {
        state.hidden = true;
        state.lastY = y;
      } else if (delta < -8) {
        state.hidden = false;
        state.lastY = y;
      }
      section.dataset.storelibSticky = mode;
      section.toggleAttribute('data-sticky-always', mode === 'always');
      section.classList.toggle('scroll-up', mode === 'on-scroll-up');
      section.classList.toggle('scr-pass-header', mode === 'on-scroll-up' && y > threshold);
      section.classList.toggle('header-sticky', mode === 'on-scroll-up' && y > threshold);
      const overlay = (header.classList.contains('transparent') && innerWidth >= 1025) ||
        (header.classList.contains('transparent-mobile') && innerWidth < 1025);
      if (overlay) section.style.setProperty('margin-bottom', (-header.offsetHeight) + 'px', 'important');
      else section.style.removeProperty('margin-bottom');
      /* Solid only after leaving the top. A full header-height threshold left
         the bar transparent for a stretch of the scroll, then snapped solid. */
      section.classList.toggle('shopify-section-header-sticky', mode !== 'none' && y > 16);
      section.classList.toggle('shopify-section-header-hidden', state.hidden);
      section.classList.remove('animate', 'sl-hdr-hidden', 'sl-header-snap');
    };
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    const mutations = new MutationObserver(records => {
      if (records.some(r => [...r.addedNodes, ...r.removedNodes].some(n =>
        n.nodeType === 1 && (n.matches?.('header.header[data-sticky]') || n.querySelector?.('header.header[data-sticky]'))))) schedule();
    });
    mutations.observe(document.documentElement, {subtree: true, childList: true});
    const rootClasses = new MutationObserver(schedule);
    rootClasses.observe(document.documentElement, {attributes: true, attributeFilter: ['class']});
    addEventListener('scroll', schedule, {passive: true});
    addEventListener('resize', schedule, {passive: true});
    addEventListener('pageshow', schedule);
    document.addEventListener('focusin', schedule);
    document.addEventListener('focusout', schedule);
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibHeaderSticky = {register: schedule, refresh: schedule};
  }
  window.StorelibHeaderSticky.refresh();
})();
{% comment %}{% endcomment %}</script>
</template>
