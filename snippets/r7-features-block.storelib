<template compat="shopify">
{%- comment -%}
  Materia Themes. One eyebrow, heading, subheading or button block of Feature
  Timeline and Guarantee Banner, styled by snippets/r7-features-base.
  The heading is always an h2. A button with a link is an <a>, without one a
  <button>; Primary and Secondary are theme buttons (data-theme-button), Link
  is an underlined text link. A custom switch that is on marks its element
  (data-own-size, data-own-weight, data-own-shape) so Theme settings >
  "Use in every section" leaves that one value alone.
    block   the block
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- case block.type -%}
  {%- when 'eyebrow' -%}
    <p class="r7h__eyebrow" data-r7f-block="{{ block.id }}" data-r7f-type="eyebrow"{% if request.design_mode %} data-r7f-bs="{{ bs | json | escape }}"{% endif %} data-r7f-bt="{{ block.id }}:text" style="{% render 'r7-features-vars', s: bs, c: 'color', gate: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
  {%- when 'heading' -%}
    <h2 class="r7h__heading" data-r7f-block="{{ block.id }}" data-r7f-type="heading"{% if request.design_mode %} data-r7f-bs="{{ bs | json | escape }}"{% endif %} data-r7f-bt="{{ block.id }}:text"{% if bs.size_enable %} data-own-size{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %} style="{% render 'r7-features-vars', s: bs, px: 'size_desktop:px:size_enable,size_mobile:px:size_enable,line_height:n:size_enable,tracking:px:size_enable', c: 'color', gate: bs.enable_custom_style %}{% if bs.weight_enable %}--r7-weight:{{ bs.weight }};{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    <div class="r7h__sub" data-r7f-block="{{ block.id }}" data-r7f-type="subheading"{% if request.design_mode %} data-r7f-bs="{{ bs | json | escape }}"{% endif %} data-r7f-bt="{{ block.id }}:text" style="{% render 'r7-features-vars', s: bs, c: 'color', gate: bs.enable_custom_style %}{% if bs.size_enable %}--r7-size:{{ bs.size }}px;{% endif %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
  {%- when 'button' -%}
    {%- liquid
      assign r7_style = bs.style | default: 'primary'
      assign r7_role = 'primary'
      if r7_style == 'secondary'
        assign r7_role = 'secondary'
      endif
      assign r7_geo = false
      if bs.use_theme_button == false and r7_style != 'link'
        assign r7_geo = true
      endif
    -%}
    {%- capture r7_btn_style -%}
      {%- if bs.enable_custom_style -%}
        {%- if r7_style == 'link' -%}
          {%- render 'r7-features-vars', s: bs, c: 'color', gate: true -%}
        {%- else -%}
          {%- render 'button-overrides', bg: bs.bg, text: bs.color, hover_bg: bs.bg_hover -%}
        {%- endif -%}
      {%- endif -%}
      {%- if r7_geo -%}--mb-radius:{{ bs.radius }}px;--mb-padding-y:{{ bs.pad_y }}px;--mb-padding-x:{{ bs.pad_x }}px;--mb-font-size:{{ bs.size }}px;{%- endif -%}
    {%- endcapture -%}
    {%- capture r7_btn_attrs -%}
      class="r7b" data-r7f-block="{{ block.id }}" data-r7f-type="button" data-r7f-hide{% if request.design_mode %} data-r7f-bs="{{ bs | json | escape }}"{% endif %} data-style="{{ r7_style }}"{% if r7_style != 'link' %} data-theme-button="{{ r7_role }}" data-sl-button{% endif %}{% if r7_geo %} data-own-shape{% endif %} style="{{ r7_btn_style | strip | strip_newlines }}"{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}
    {%- endcapture -%}
    {%- capture r7_btn_inner -%}
      <span class="r7b__label" data-r7f-bt="{{ block.id }}:label">{{ bs.label | escape }}</span><svg class="r7b__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    {%- endcapture -%}
    {%- if bs.link != blank -%}
      <a href="{{ bs.link | url }}" {{ r7_btn_attrs | strip }}>{{ r7_btn_inner | strip }}</a>
    {%- else -%}
      <button type="button" {{ r7_btn_attrs | strip }}>{{ r7_btn_inner | strip }}</button>
    {%- endif -%}
{%- endcase -%}
</template>
