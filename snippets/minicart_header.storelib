<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.

  Params:
    type     - 'header_mega' for the mega-menu header variant
    as_text  - when true, render a "Cart (count)" text label instead of the bag
               icon. The #cart-icon-bubble anchor, its drawer-open behavior and
               the live .cart-count span (updated by JS on add-to-cart) are all
               preserved, so the count stays in sync.
{%- endcomment -%}
{%- liquid
  # Icon mode keeps the fixed 44x44 square; text mode flexes to fit the label.
  assign btn_size = 'w-44 h-44'
  if as_text
    assign btn_size = 'header-action-text-btn'
  endif
-%}
<div class="minicart">
  <div>
    <div
      id="header__minicart"
      class="header__minicart {% if type == 'header_mega' %}header__minicart--mega{% endif %} {{ action_after_add_cart }}{% if action_after_add_cart == 'show_popup' %} relative{% endif %}"
    >
      <a
        id="cart-icon-bubble"
        href="{{ routes.cart_url }}"
        arial-label="{{ 'general.cart.label' | t }}"
        class="no-underline {% if template != 'cart' and action_after_add_cart != 'go_to_cart_page' %}minicart__action{% endif %} header-icon header-color {{ btn_size }} inline-flex content-center  {% if action_after_add_cart == 'show_popup' %}show-overlay{% else %}overlayminicart{% endif %}"
      >
        {%- if as_text -%}
          <span class="header-action-text{{ text_class }}">
            {{ 'general.cart.label' | t }}&nbsp;(<span class="cart-count lh-1">
              {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}~{%- endif -%}
            </span>)
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </span>
        {%- else -%}
          <h-count class="relative lh-1 fs-0">
            {% if type != 'header_mega' %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5 8.5h14l-1.1 10.2a2 2 0 0 1-2 1.8H8.1a2 2 0 0 1-2-1.8L5 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M8.5 11V7.5a3.5 3.5 0 1 1 7 0V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 8.5h14l-1.1 10.2a2 2 0 0 1-2 1.8H8.1a2 2 0 0 1-2-1.8L5 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M8.5 11V7.5a3.5 3.5 0 1 1 7 0V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {% endif %}
            <span class="absolute lh-1 cart-count h-count inline-flex align-center justify-content-center rounded-50 overflow-hidden fs-10">
              {%- if cart.item_count < 100 -%}
                {{ cart.item_count }}
              {%- else -%}
                ~
              {% endif %}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </span>
          </h-count>
        {%- endif -%}
        {% if type == 'header_mega' %}
          <header-total-price>
            <span class="text-icons  d-inline-flex fs-11 fw-500 ml-15 text-left d-none-mb">
              <span class="text-icons-top">{{ 'general.cart.label' | t }}</span>
              <span class="fs-14 menu-cart" data-cart-subtotal-price>
                {% if settings.currency_code_enabled %}
                  {{ cart.total_price | money_with_currency }}
                {% else %}
                  {{ cart.total_price | money }}
                {% endif %}
              </span>
            </span>
          </header-total-price>
        {% endif %}
      </a>
    </div>
  </div>
</div>

</template>