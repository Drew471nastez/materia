<template compat="shopify">
{% assign b = block.settings %}
{% assign render_kind = kind | default: block.type %}{% case render_kind %}
{% when 'heading' %}<h1 class="hp3__heading hp3__type" data-field="heading_text" data-rich style="font-family:var(--hp3-font,var(--heading-font))!important;font-size:var(--hp3-size,var(--h1-size,48px))!important;font-weight:var(--hp3-weight,var(--heading-weight,600))!important;line-height:var(--hp3-line,var(--heading-line-height,1.2))!important;text-transform:var(--hp3-case,var(--heading-text-transform,none))!important;letter-spacing:var(--hp3-letter,var(--heading-letter-spacing,normal))!important;">{{ b.heading_text | default: b.heading }}</h1>
{% when 'subheading', 'rich_text' %}<div class="hp3__copy hp3__type" data-field="text" data-rich>{{ b.text }}</div>
{% when 'primary_button', 'secondary_button' %}{% assign button_link = b.link | default: b.button_link %}{% assign button_label = b.label | default: b.button_label %}{% assign role = 'primary' %}{% if block.type == 'secondary_button' %}{% assign role = 'secondary' %}{% endif %}{% if button_link != blank and button_link != '#' %}<a class="hp3__button" data-theme-button="{{ role }}" data-sl-button href="{{ button_link | url | escape }}" data-field="label">{{ button_label | escape }}</a>{% else %}<button type="button" class="hp3__button" data-theme-button="{{ role }}" data-sl-button data-field="label">{{ button_label | escape }}</button>{% endif %}
{% when 'guarantee_badge' %}{% assign benefit_text = b.text | default: b.benefit_text %}{% assign benefit_icon = b.icon | default: b.icon_preset %}<div class="hp3__inline"><span class="hp3__icon" data-icon="icon" aria-hidden="true">{% render 'hp-icon', icon: benefit_icon %}</span><span class="hp3__type" data-field="text">{{ benefit_text | escape }}</span></div>
{% when 'pill_badge' %}<div class="hp3__pill"><span data-field="icon" aria-hidden="true">{{ b.icon | escape }}</span><span class="hp3__type" data-field="text">{{ b.text | escape }}</span></div>
{% when 'accent_block' %}<span class="hp3__type" data-field="text">{{ b.text | escape }}</span>
{% when 'social_proof_avatars', 'happy_customers' %}<div class="hp3__social"><div class="hp3__avatars">{% for n in (1..6) %}<span data-avatar="{{ n }}" hidden></span>{% endfor %}</div><div><div class="hp3__type" data-field="{% if block.type == 'happy_customers' %}heading{% else %}referral_text{% endif %}">{% if block.type == 'happy_customers' %}{{ b.heading | escape }}{% else %}{{ b.referral_text | escape }}{% endif %}</div><div class="hp3__inline"><div data-hp3-stars>{% render 'hero-image-one-stars', filled: b.filled_stars, total: b.total_stars %}</div><span data-field="rating_text" class="hp3__type">{{ b.rating_text | escape }}</span></div></div></div>
{% when 'simple_rating', 'rating_badge' %}<div class="hp3__rating-link hp3__inline"><div data-hp3-stars>{% assign initial_rating = b.rating | default: b.rating_value | default: b.filled_stars %}{% render 'hero-image-one-stars', filled: initial_rating, total: b.total_stars, tiles: false %}</div><span class="hp3__type" data-field="{% if render_kind == 'rating_badge' %}label_text{% else %}text{% endif %}" data-rich>{% if render_kind == 'rating_badge' %}{{ b.label_text }}{% else %}{{ b.text | default: b.rating_text | escape }}{% endif %}</span></div>
{% when 'divider' %}<hr class="hp3__rule">
{% when 'benefits_pills', 'benefits_tab', 'benefits_stack_badge' %}<div data-benefit-heading class="hp3__type">{{ b.heading_text | escape }}</div><div class="hp3__benefits">{% for n in (1..6) %}<div class="hp3__benefit" data-benefit="{{ n }}"><span class="hp3__icon" aria-hidden="true"></span><span class="hp3__type" data-benefit-text></span></div>{% endfor %}</div>
{% when 'low_stock_badge' %}<div class="hp3__stock hp3__inline"><span class="hp3__dot" aria-hidden="true"></span><strong data-field="label_text">{{ b.label_text | escape }}</strong><span data-stock-body></span></div>
{% when 'countdown_badge' %}<div class="hp3__countdown"><div data-field="heading_text" class="hp3__timer-heading">{{ b.heading_text | escape }}</div><div class="hp3__timer" role="timer">{% assign units = 'days,hours,mins,secs' | split: ',' %}{% for unit in units %}<div class="hp3__unit"><span data-time="{{ unit }}">00</span><span data-time-label="{{ unit }}"></span></div>{% endfor %}</div><div data-ended hidden>{{ b.ended_text | escape }}</div><div data-timer-error role="status" hidden></div></div>
{% when 'price_inline' %}<div class="hp3__price hp3__inline"><span data-price class="hp3__current"></span><s data-compare></s><span data-save class="hp3__saving"></span></div>
{% when 'scarcity_meter' %}<div class="hp3__meter"><div class="hp3__meter-labels"><span data-field="left_label">{{ b.left_label | escape }}</span><span data-meter-label></span></div><div class="hp3__track"><div class="hp3__fill"></div></div></div>
{% when 'bullet_checklist' %}<ul class="hp3__checklist"></ul>
{% when 'bonus_offer' %}<div class="hp3__bonus"><span class="hp3__icon" data-icon="icon" aria-hidden="true">{% render 'hp-icon', icon: b.icon %}</span><div><strong data-field="title" class="hp3__bonus-title">{{ b.title | escape }}</strong><div data-field="body" data-rich class="hp3__bonus-body">{{ b.body }}</div></div></div>
{% endcase %}
</template>
