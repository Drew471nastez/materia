<template compat="shopify">
<style>
  #shopify-section-{{ section.id }} {
    --header-height-desktop: {{ section.settings.header_height | default: 64 }}px;
    --header-height-mobile: {{ section.settings.header_height_mobile | default: section.settings.header_height | default: 64 }}px;
    --header-bar-height: var(--header-height-desktop);
  }
  #shopify-section-{{ section.id }} header.header {
    height: var(--header-bar-height) !important;
    min-height: 0 !important;
    padding-block: 0 !important;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .header__inner,
  #shopify-section-{{ section.id }} .header__inner > div,
  #shopify-section-{{ section.id }} header-inner {
    height: 100%;
    min-height: 0 !important;
    padding-block: 0 !important;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .header__logo { min-width: 0; max-height: 100%; }
  #shopify-section-{{ section.id }} header-inner { grid-template-rows: minmax(0, 1fr); }
  #shopify-section-{{ section.id }} .header__logo a { display: flex; align-items: center; max-height: 100%; }
  #shopify-section-{{ section.id }} .header__logo :is(img, svg) {
    max-height: calc(var(--header-bar-height) - 8px) !important;
    max-width: 100%;
    height: auto !important;
    width: var(--header-logo-width) !important;
    object-fit: contain;
    transition: none !important;
    animation: none !important;
  }
  /* Match the actual mobile navigation breakpoint (phones AND tablets). */
  @media (max-width: 1024.98px) {
    #shopify-section-{{ section.id }} { --header-bar-height: var(--header-height-mobile); }
    #shopify-section-{{ section.id }} .header__logo :is(img, svg) {
      width: var(--header-logo-width-mobile) !important;
    }
  }
  @media (min-width: 768px) and (max-width: 1024.98px) {
    #shopify-section-{{ section.id }} .header:not(.transparent):not(.transparent-mobile) .header__normal-logo--desktop-only { display: none !important; }
    #shopify-section-{{ section.id }} .header:not(.transparent):not(.transparent-mobile) .header__mobile-logo { display: inline-block !important; }
    #shopify-section-{{ section.id }}.shopify-section-header-sticky .header .header__normal-logo--desktop-only { display: none !important; }
    #shopify-section-{{ section.id }}.shopify-section-header-sticky .header .header__mobile-logo { display: inline-block !important; }
  }
  #shopify-section-{{ section.id }} .header__action { column-gap: clamp(8px, 1.2vw, 18px); }
  #shopify-section-{{ section.id }} .header__action .header-icon,
  #shopify-section-{{ section.id }} .header__menu .nav-toggle {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
  }
  #shopify-section-{{ section.id }} .header__action .header-action-text-btn { width: auto; height: 44px; }
  @media (min-width: 1025px) {
    #shopify-section-{{ section.id }} .header__logo :is(img, svg) { width: var(--header-logo-width, 82px) !important; }
    #shopify-section-{{ section.id }} .header__menu,
    #shopify-section-{{ section.id }} .header__menu .navigation.horizontal,
    #shopify-section-{{ section.id }} .header__menu > .navigation.horizontal > .navigation__menu-content,
    #shopify-section-{{ section.id }} .header__menu .min-h-1025-50,
    #shopify-section-{{ section.id }} .header__menu .horizontal-list,
    #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0,
    #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0 > menu-item {
      height: var(--header-bar-height);
      min-height: 0 !important;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0 > menu-item > a {
      display: inline-flex;
      align-items: center;
      height: 100%;
      min-height: 44px !important;
      padding-block: 0 !important;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .header__menu .horizontal-list:has(.menu_label) > .level0 > menu-item > a { padding-top: 16px !important; }
    #shopify-section-{{ section.id }} .header__menu .menu_label { top: max(0px, calc(50% - 24px)) !important; }
    /* The hover line sits under the words, not at a fixed spot in the link box,
       so a badge's extra top padding or a larger menu font never lets it cross the text. */
    #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0 > menu-item > a::after { display: none !important; }
    #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0 > menu-item > a > span:first-child {
      position: relative;
      display: inline-block;
      line-height: 1.25;
    }
    #shopify-section-{{ section.id }} header.header[data-menu-hover^='underline'] .header__menu .horizontal-list > .level0 > menu-item > a > span:first-child::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.3em;
      height: 1px;
      background-color: currentColor;
      transform: scaleX(0);
      transform-origin: 100% 0;
      transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} header.header[data-menu-hover='underline'] .header__menu .horizontal-list > .level0 > menu-item > a:is(:hover, :focus-visible) > span:first-child::after {
      transform: scaleX(1);
      transform-origin: 0 100%;
    }
    #shopify-section-{{ section.id }} header.header[data-menu-hover='underline_reverse'] .header__menu .horizontal-list > .level0 > menu-item > a > span:first-child::after { transform-origin: 0 0; }
    #shopify-section-{{ section.id }} header.header[data-menu-hover='underline_reverse'] .header__menu .horizontal-list > .level0 > menu-item > a:is(:hover, :focus-visible) > span:first-child::after { transform: scaleX(1); }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .header__menu .horizontal-list > .level0 > menu-item > a > span:first-child::after { transition: none; }
    }
  }
{% comment %}{% endcomment %}</style>
<script>
/* Apply slider drags to two variables, once per frame, without rebuilding the
   header, measuring it or rebinding its menu. The existing resize observer
   keeps sticky offsets in step with the resulting layout. */
(() => {
  if (window.MateriaHeaderDimensions) return;
  window.MateriaHeaderDimensions = true;
  let frame, pending = {};
  document.addEventListener('storelib:settings-change', event => {
    const detail = event.detail || {}, settings = detail.settings || {};
    for (const key of ['header_height', 'header_height_mobile']) {
      if (Object.prototype.hasOwnProperty.call(settings, key)) pending[key] = settings[key];
    }
    if (!Object.keys(pending).length || frame) return;
    frame = requestAnimationFrame(() => {
      frame = null;
      const header = document.querySelector('header.header');
      const section = header?.closest('.section-header, [id^="shopify-section-"]');
      for (const [key, value] of Object.entries(pending)) {
        const height = Number(value);
        if (section && Number.isFinite(height)) section.style.setProperty(
          key === 'header_height' ? '--header-height-desktop' : '--header-height-mobile',
          Math.min(160, Math.max(48, height)) + 'px'
        );
      }
      pending = {};
    });
  });
})();
{% comment %}{% endcomment %}</script>
</template>
