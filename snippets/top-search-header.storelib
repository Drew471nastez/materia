<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.

  Params:
    type     - 'header_mega' for the mega-menu header variant
    as_text  - when true, render a "Search" text label instead of the icon.
               The .top-search-toggle hook + search behavior are unchanged.
{%- endcomment -%}
{% # theme-check-disable ContentForHeaderModification %}
{%- liquid
  assign theme_st = settings
  assign search_type = theme_st.search_type
  # Icon mode keeps the fixed 44x44 square; text mode flexes to fit the label.
  assign btn_size = 'w-44 h-44'
  if as_text
    assign btn_size = 'header-action-text-btn'
  endif
-%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if lis_language_rtl contains iso_code
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<div class="header_search {% if type == 'header_mega' %}header_search-mega{% endif %}">
  <div class="block block-quick-search block-search predictive_search_suggest search_{{ search_type }}">
    {%- if search_type == 'none' -%}
      <a
        class="btn-reset top-search-toggle header-icon header-color {{ btn_size }} inline-flex content-center header-color overlay pointer transition no-underline"
        href="{{ routes.search_url }}"
        aria-label="{{ 'templates.search.tooltip' | t }}"
      >
        {%- if as_text -%}
          <span class="header-action-text{{ text_class }}">{{ 'general.search.search' | t }}</span>
        {%- else -%}
          <svg width="17" height="17" viewBox="0 0 17 17" fill="currentColor">
            <use href="#icon-search" />
          </svg>
        {%- endif -%}
      </a>
    {%- else -%}
      <div class="dropdown-toggle">
        <button
          class="btn-reset top-search-toggle header-icon header-color {{ btn_size }} inline-flex content-center header-color overlay pointer transition"
          aria-label="{{ 'templates.search.tooltip' | t }}"
        >
          {%- if as_text -%}
            <span class="header-action-text{{ text_class }}">{{ 'general.search.search' | t }}</span>
          {%- else -%}
            <svg width="17" height="17" viewBox="0 0 17 17" fill="currentColor">
              <use href="#icon-search" />
            </svg>
          {%- endif -%}
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

</template>