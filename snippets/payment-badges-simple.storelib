<template compat="shopify">
{%- comment -%}
  Materia Themes — Payment Badges (Simple) block.
  Just the icons. Toggle each one, set alignment, badge size, and padding.
  Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'payment-badges-simple-' | append: block.id

  assign align = s.alignment | default: 'left'
  assign justify = 'flex-start'
  if align == 'center'
    assign justify = 'center'
  elsif align == 'right'
    assign justify = 'flex-end'
  endif
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 12 }}px;
    padding-bottom: {{ s.padding_bottom | default: 12 }}px;
  }
  #{{ block_id }} .pbs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: {%- if s.allow_wrap %} wrap{% else %} nowrap{% endif %};
    align-items: center;
    justify-content: {{ justify }};
    gap: {{ s.gap | default: 8 }}px;
  }
  #{{ block_id }} .pbs-item {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  #{{ block_id }} .pbs-svg {
    height: {{ s.badge_size_mobile | default: 22 }}px;
    width: auto;
    display: block;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .pbs-svg {
      height: {{ s.badge_size_desktop | default: 26 }}px;
    }
  }
  {%- if s.grayscale -%}
    #{{ block_id }} .pbs-svg {
      filter: grayscale(1);
      opacity: {{ s.grayscale_opacity | default: 0.85 }};
      transition: filter .2s ease, opacity .2s ease;
    }
    #{{ block_id }} .pbs-svg:hover {
      filter: grayscale(0);
      opacity: 1;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="payment-badges-simple-block" {{ block.shopify_attributes }}>
  <ul class="pbs-list" role="list" aria-label="{{ s.a11y_label | default: 'Accepted payments' }}">

    {%- if s.show_visa -%}
      <li class="pbs-item">
        <svg class="pbs-svg" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa">
          <title>Visa</title>
          <path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/>
          <path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/>
          <path d="M28.3 10.1H28c-.4 1-.7 1.5-1 3h1.9c-.3-1.5-.3-2.2-.6-3zm2.9 5.9h-1.7c-.1 0-.1 0-.2-.1l-.2-.9-.1-.2h-2.4c-.1 0-.2 0-.2.2l-.3.9c0 .1-.1.1-.1.1h-2.1l.2-.5L27 8.7c0-.5.3-.7.8-.7h1.5c.1 0 .2 0 .2.2l1.4 6.5c.1.4.2.7.2 1.1.1.1.1.1.1.2zm-13.4-.3l.4-1.8c.1 0 .2.1.2.1.7.3 1.4.5 2.1.4.2 0 .5-.1.7-.2.5-.2.5-.7.1-1.1-.2-.2-.5-.3-.8-.5-.4-.2-.8-.4-1.1-.7-1.2-1-.8-2.4-.1-3.1.6-.4.9-.8 1.7-.8 1.2 0 2.5 0 3.1.2h.1c-.1.6-.2 1.1-.4 1.7-.5-.2-1-.4-1.5-.4-.3 0-.6 0-.9.1-.2 0-.3.1-.4.2-.2.2-.2.5 0 .7l.5.4c.4.2.8.4 1.1.6.5.3 1 .8 1.1 1.4.2.9-.1 1.7-.9 2.3-.5.4-.7.6-1.4.6-1.4 0-2.5.1-3.4-.2-.1.2-.1.2-.2.1zm-3.5.3c.1-.7.1-.7.2-1 .5-2.2 1-4.5 1.4-6.7.1-.2.1-.3.3-.3H18c-.2 1.2-.4 2.1-.7 3.2-.3 1.5-.6 3-1 4.5 0 .2-.1.2-.3.2M5 8.2c0-.1.2-.2.3-.2h3.4c.5 0 .9.3 1 .8l.9 4.4c0 .1 0 .1.1.2 0-.1.1-.1.1-.1l2.1-5.1c-.1-.1 0-.2.1-.2h2.1c0 .1 0 .1-.1.2l-3.1 7.3c-.1.2-.1.3-.2.4-.1.1-.3 0-.5 0H9.7c-.1 0-.2 0-.2-.2L7.9 9.5c-.2-.2-.5-.5-.9-.6-.6-.3-1.7-.5-1.9-.5L5 8.2z" fill="#142688"/>
        </svg>
      </li>
    {%- endif -%}

    {%- if s.show_mastercard -%}
