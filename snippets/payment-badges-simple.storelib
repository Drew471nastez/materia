        </svg>
      </li>
    {%- endif -%}

    {%- if s.show_diners -%}
      <li class="pbs-item">
        <svg class="pbs-svg" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diners Club">
          <title>Diners Club</title>
