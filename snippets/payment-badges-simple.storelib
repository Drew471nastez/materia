        </svg>
      </li>
    {%- endif -%}

    {%- if s.show_afterpay -%}
      <li class="pbs-item">
        <svg class="pbs-svg" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Afterpay">
          <title>Afterpay</title>
          <path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/>
