<template compat="shopify">
{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign launch_logo = s.logo_image | default: settings.logo
-%}
{{ 'password-launch.css' | asset_url | stylesheet_tag }}
{{ 'materia-forms.css' | asset_url | stylesheet_tag }}
{{ 'theme-button-contract.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-launch.js' | asset_url }}" defer></script>
<script src="{{ 'materia-forms.js' | asset_url }}" defer></script>
{% if s.reset_spacing %}<style>#shopify-section-{{ section.id }}{margin-block:0!important}</style>{% endif %}
<section id="Launch-{{ section.id }}" class="pw-launch color-{{ scheme }} {{ s.section_width }}" data-password-launch {{ section.shopify_attributes }}
  style="--pw-align:{{ s.content_alignment | default: 'center' }};--pw-valign:{{ s.vertical_alignment | default: 'center' }};--pw-vh:{{ s.viewport_height | default: 84 }};--pw-gap:{{ s.block_gap | default: 24 }}px;{% if s.enable_custom_style %}--pw-content-bg:{{ s.content_background }};--pw-content-pad:{{ s.content_padding | default: 0 }}px;--pw-content-radius:{{ s.content_radius | default: 0 }}px;{% endif %}--pw-email-gap:{{ s.email_gap_top_mobile | default: 20 }}px;--pw-email-gap-d:{{ s.email_gap_top | default: 20 }}px;--pw-width:{{ s.content_width | default: 640 }}px;--pw-top:{{ s.padding_top_mobile | default: 32 }}px;--pw-bottom:{{ s.padding_bottom_mobile | default: 32 }}px;--pw-left:{{ s.padding_left_mobile | default: 20 }}px;--pw-right:{{ s.padding_right_mobile | default: 20 }}px;--pw-top-d:{{ s.padding_top_desktop | default: 64 }}px;--pw-bottom-d:{{ s.padding_bottom_desktop | default: 64 }}px;--pw-left-d:{{ s.padding_left_desktop | default: 24 }}px;--pw-right-d:{{ s.padding_right_desktop | default: 24 }}px;--pw-logo:{{ s.logo_size_mobile | default: 100 }}px;--pw-logo-d:{{ s.logo_size_desktop | default: 160 }}px;{% if s.enable_custom_style and s.background_color != blank %}--pw-bg:{{ s.background_color }};{% endif %}{% if s.enable_custom_style and s.enable_bg_gradient %}--pw-bg:linear-gradient({{ s.bg_gradient_degree | default: 90 }}deg,{{ s.bg_gradient_color1 }},{{ s.bg_gradient_color2 }},{{ s.bg_gradient_color3 }});{% endif %}">
  {%- if s.enable_custom_video_background and s.custom_bg_video != blank -%}
    <div class="pw-launch__media" style="filter:brightness({{ s.video_brightness | default: 1 }})">{{ s.custom_bg_video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'metadata' }}</div>
  {%- elsif s.enable_custom_video_background and s.custom_bg_video_url != blank -%}
    <video class="pw-launch__media" autoplay muted loop playsinline preload="metadata" style="filter:brightness({{ s.video_brightness | default: 1 }})"><source src="{{ s.custom_bg_video_url | escape }}" type="video/mp4"></video>
  {%- elsif s.enable_custom_bg_image and s.custom_bg_image != blank -%}
    <div class="pw-launch__media" style="filter:brightness({{ s.bg_image_brightness | default: 1 }})">{{ s.custom_bg_image | image_url: width: 2200 | image_tag: loading: 'eager', alt: '' }}</div>
  {%- endif -%}
  <div class="pw-launch__content">
    {%- if s.enable_logo and launch_logo != blank -%}<div class="pw-launch__logo">{{ launch_logo | image_url: width: 600 | image_tag: alt: shop.name }}</div>{%- endif -%}
    {%- assign launch_heading = false -%}
    {%- for block in section.blocks -%}
      {%- if block.hidden -%}{%- continue -%}{%- endif -%}
      {%- assign b = block.settings -%}
      <div class="pw-launch__block pw-launch__block--{{ block.type }}" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- if launch_heading -%}<h2 class="pw-launch__heading"{% if s.enable_custom_style %} style="font-size:clamp(28px,6vw,{{ b.heading_font_size | default: 48 }}px);color:{{ b.heading_color }};{% if b.enable_heading_gradient %}background:linear-gradient({{ b.heading_gradient_degree | default: 90 }}deg,{{ b.heading_gradient_color1 }},{{ b.heading_gradient_color2 }},{{ b.heading_gradient_color3 }});background-clip:text;-webkit-background-clip:text;color:transparent;{% endif %}"{% endif %}>{{ b.heading | escape }}</h2>
          {%- else -%}<h1 class="pw-launch__heading"{% if s.enable_custom_style %} style="font-size:clamp(28px,6vw,{{ b.heading_font_size | default: 48 }}px);color:{{ b.heading_color }};{% if b.enable_heading_gradient %}background:linear-gradient({{ b.heading_gradient_degree | default: 90 }}deg,{{ b.heading_gradient_color1 }},{{ b.heading_gradient_color2 }},{{ b.heading_gradient_color3 }});background-clip:text;-webkit-background-clip:text;color:transparent;{% endif %}"{% endif %}>{{ b.heading | escape }}</h1>{%- assign launch_heading = true -%}{%- endif -%}
        {%- when 'subheading' -%}
          <div class="pw-launch__description rte"{% if s.enable_custom_style %} style="font-size:{{ b.subheading_font_size | default: 16 }}px;color:{{ b.subheading_color }}"{% endif %}>{{ b.subheading }}</div>
        {%- when 'countdown' -%}
          {%- if b.countdown_date != blank -%}<div class="pw-launch__countdown" data-launch-date="{{ b.countdown_date | escape }}"{% if s.enable_custom_style %} style="--pw-count-bg:{{ b.countdown_unit_bg_color }};--pw-count-text:{{ b.countdown_text_color }};--pw-count-border:{{ b.countdown_border_color }};--pw-count-radius:{{ b.countdown_border_radius | default: 8 }}px;--pw-count-size:{{ b.countdown_size_mobile | default: 1.5 }}rem;--pw-count-size-d:{{ b.countdown_size_desktop | default: 2 }}rem"{% endif %}>
            <span><strong data-launch-unit="days">00</strong><small>{{ s.days_label | default: 'Days' | escape }}</small></span><span><strong data-launch-unit="hours">00</strong><small>{{ s.hours_label | default: 'Hours' | escape }}</small></span><span><strong data-launch-unit="minutes">00</strong><small>{{ s.minutes_label | default: 'Minutes' | escape }}</small></span><span><strong data-launch-unit="seconds">00</strong><small>{{ s.seconds_label | default: 'Seconds' | escape }}</small></span>
          </div>{%- endif -%}
        {%- when 'email' -%}
          {%- assign signup_id = 'LaunchSignup-' | append: section.id | append: '-' | append: block.id -%}
          {%- form 'customer', id: signup_id, class: 'pw-launch__signup', data-storelib-form: 'subscribe', data-mt-inline-subscribe: 'true' -%}
            <input type="hidden" name="contact[tags]" value="waitlist">
            <span hidden data-mt-words data-success-message="{{ s.success_text | escape }}" data-error-message="{{ s.error_text | escape }}"></span>
            {%- if form.posted_successfully? -%}<span hidden data-mt-posted></span>{%- endif -%}
            <label for="LaunchEmail-{{ section.id }}-{{ block.id }}">{{ s.email_label | default: 'Email address' | escape }}</label>
            <div class="pw-launch__fields" data-signup-layout="{{ s.signup_layout | default: 'inline' }}" style="{% if s.enable_custom_style %}{% if b.enable_email_input_bg %}--input-bg:{{ b.email_input_bg_color }};{% endif %}--input-border-color:{{ b.email_input_border_color }};--field-placeholder:{{ b.placeholder_color }};{% if b.email_text_color != blank %}--field-text:{{ b.email_text_color }};{% endif %}{% endif %}">
              <input id="LaunchEmail-{{ section.id }}-{{ block.id }}" name="contact[email]" type="email" required autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="{{ s.email_placeholder | default: 'you@example.com' | escape }}">
              <button type="submit" data-theme-button="primary"{% if s.enable_custom_style %} style="{%- render 'button-overrides', bg: b.button_bg_color, text: b.button_text_color, hover_bg: b.button_hover_bg, hover_text: b.button_hover_text -%}"{% endif %}><span class="hidden-on-load">{{ s.button_label | default: 'Join the waitlist' | escape }}</span><span class="icon-load" aria-hidden="true"></span></button>
            </div>
            {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- endform -%}
      {%- endcase -%}
      </div>
    {%- endfor -%}
    {%- if s.show_owner_login -%}<a class="pw-launch__owner" href="{{ s.owner_login_url | default: '/admin' | url }}">{{ s.owner_login_label | default: 'Store owner login' | escape }}</a>{%- endif -%}
  </div>
</section>
</template>
