<template compat="shopify">
{%- comment -%}
  Materia Themes. The Coming soon section (sections/coming-soon). Only that
  section renders it. Live edits: shopify/assets/live-account-pages.js
  (every style, text and link setting; a new picture or video waits for the
  builder's redraw). The countdown runs in assets/password-launch.js.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign launch_logo = s.logo_image | default: settings.logo
  assign custom = s.enable_custom_style
-%}
{{ 'password-launch.css' | asset_url | stylesheet_tag }}
{{ 'materia-forms.css' | asset_url | stylesheet_tag }}
{{ 'theme-button-contract.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-launch.js' | asset_url }}" defer></script>
<script src="{{ 'materia-forms.js' | asset_url }}" defer></script>
{% render 'account-pages-font-face', st: s %}
<style>#shopify-section-{{ section.id }}:has([data-ap-reset]){margin-block:0!important;padding-block:0!important}</style>
{%- capture fonts -%}{% render 'account-pages-font-vars', st: s %}{%- endcapture -%}
<section id="Launch-{{ section.id }}" class="pw-launch color-{{ scheme }} {{ s.section_width }}" data-password-launch data-fill-screen="{{ s.fill_screen | default: true, allow_false: true }}"
  data-ap-root="coming-soon" data-ap-section="{{ section.id }}" data-ap-settings="{{ s | json | escape }}"{% if s.reset_spacing %} data-ap-reset{% endif %} {{ section.shopify_attributes }}
  style="--pw-align:{{ s.content_alignment | default: 'center' }};--pw-valign:{{ s.vertical_alignment | default: 'center' }};--pw-vh:{{ s.viewport_height | default: 84 }};--pw-gap:{{ s.block_gap | default: 24 }}px;{% if custom %}{% if s.content_background != blank %}--pw-content-bg:{{ s.content_background }};{% endif %}--pw-content-pad:{{ s.content_padding | default: 0 }}px;--pw-content-radius:{{ s.content_radius | default: 0 }}px;{% endif %}--pw-email-gap:{{ s.email_gap_top_mobile | default: 20 }}px;--pw-email-gap-d:{{ s.email_gap_top | default: 20 }}px;--pw-width:{{ s.content_width | default: 640 }}px;--pw-top:{{ s.padding_top_mobile | default: 32 }}px;--pw-bottom:{{ s.padding_bottom_mobile | default: 32 }}px;--pw-left:{{ s.padding_left_mobile | default: 20 }}px;--pw-right:{{ s.padding_right_mobile | default: 20 }}px;--pw-top-d:{{ s.padding_top_desktop | default: 64 }}px;--pw-bottom-d:{{ s.padding_bottom_desktop | default: 64 }}px;--pw-left-d:{{ s.padding_left_desktop | default: 24 }}px;--pw-right-d:{{ s.padding_right_desktop | default: 24 }}px;--pw-logo:{{ s.logo_size_mobile | default: 100 }}px;--pw-logo-d:{{ s.logo_size_desktop | default: 160 }}px;{% if custom and s.enable_bg_gradient %}--pw-bg:linear-gradient({{ s.bg_gradient_degree | default: 90 }}deg,{{ s.bg_gradient_color1 }},{{ s.bg_gradient_color2 }},{{ s.bg_gradient_color3 }});{% elsif custom and s.background_color != blank %}--pw-bg:{{ s.background_color }};{% endif %}{{ fonts }}">
  {%- if s.enable_custom_video_background and s.custom_bg_video != blank -%}
    <div class="pw-launch__media" data-pw-media="video" style="filter:brightness({{ s.video_brightness | default: 1 }})">{{ s.custom_bg_video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'metadata' }}</div>
  {%- elsif s.enable_custom_video_background and s.custom_bg_video_url != blank -%}
    <video class="pw-launch__media" data-pw-media="video" autoplay muted loop playsinline preload="metadata" style="filter:brightness({{ s.video_brightness | default: 1 }})"><source src="{{ s.custom_bg_video_url | escape }}" type="video/mp4"></video>
  {%- elsif s.enable_custom_bg_image and s.custom_bg_image != blank -%}
    <div class="pw-launch__media" data-pw-media="image" style="filter:brightness({{ s.bg_image_brightness | default: 1 }})">{{ s.custom_bg_image | image_url: width: 2200 | image_tag: loading: 'eager', alt: '' }}</div>
  {%- endif -%}
  <div class="pw-launch__content">
    {%- if launch_logo != blank -%}<div class="pw-launch__logo" data-ap-show="enable_logo"{% unless s.enable_logo %} hidden{% endunless %}>{{ launch_logo | image_url: width: 600 | image_tag: alt: shop.name }}</div>{%- endif -%}
    {%- assign launch_heading = false -%}
    {%- for block in section.blocks -%}
      {%- if block.hidden -%}{%- continue -%}{%- endif -%}
      {%- assign b = block.settings -%}
      <div class="pw-launch__block pw-launch__block--{{ block.type }}" data-ap-block="{{ block.id }}" data-ap-type="{{ block.type }}" data-ap-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- capture heading_attrs -%} class="pw-launch__heading" data-ap-brich="heading"{% if custom %} data-pw-custom style="--pw-h-size:{{ b.heading_font_size | default: 48 }}px;{% if b.heading_color != blank %}--pw-h-c:{{ b.heading_color }};{% endif %}{% if b.enable_heading_gradient %}--pw-h-grad:linear-gradient({{ b.heading_gradient_degree | default: 90 }}deg,{{ b.heading_gradient_color1 }},{{ b.heading_gradient_color2 }},{{ b.heading_gradient_color3 }});{% endif %}"{% if b.enable_heading_gradient %} data-pw-grad{% endif %}{% endif %}{%- endcapture -%}
          {%- if launch_heading -%}<h2{{ heading_attrs }}>{{ b.heading }}</h2>
          {%- else -%}<h1{{ heading_attrs }}>{{ b.heading }}</h1>{%- assign launch_heading = true -%}{%- endif -%}
        {%- when 'subheading' -%}
          <div class="pw-launch__description rte" data-ap-brich="subheading"{% if custom %} data-pw-custom style="--pw-s-size:{{ b.subheading_font_size | default: 16 }}px;{% if b.subheading_color != blank %}--pw-s-c:{{ b.subheading_color }};{% endif %}"{% endif %}>{{ b.subheading }}</div>
        {%- when 'countdown' -%}
          {%- if b.countdown_date != blank -%}<div class="pw-launch__countdown" data-launch-date="{{ b.countdown_date | escape }}"{% if custom %} style="{% if b.countdown_unit_bg_color != blank %}--pw-count-bg:{{ b.countdown_unit_bg_color }};{% endif %}{% if b.countdown_text_color != blank %}--pw-count-text:{{ b.countdown_text_color }};{% endif %}{% if b.countdown_border_color != blank %}--pw-count-border:{{ b.countdown_border_color }};{% endif %}--pw-count-radius:{{ b.countdown_border_radius | default: 8 }}px;--pw-count-size:{{ b.countdown_size_mobile | default: 1.5 }}rem;--pw-count-size-d:{{ b.countdown_size_desktop | default: 2 }}rem"{% endif %}>
            <span><strong data-launch-unit="days">00</strong><small data-ap-text="days_label">{{ s.days_label | default: 'Days' | escape }}</small></span><span><strong data-launch-unit="hours">00</strong><small data-ap-text="hours_label">{{ s.hours_label | default: 'Hours' | escape }}</small></span><span><strong data-launch-unit="minutes">00</strong><small data-ap-text="minutes_label">{{ s.minutes_label | default: 'Minutes' | escape }}</small></span><span><strong data-launch-unit="seconds">00</strong><small data-ap-text="seconds_label">{{ s.seconds_label | default: 'Seconds' | escape }}</small></span>
          </div>{%- endif -%}
        {%- when 'email' -%}
          {%- assign signup_id = 'LaunchSignup-' | append: section.id | append: '-' | append: block.id -%}
          {%- form 'customer', id: signup_id, class: 'pw-launch__signup', data-storelib-form: 'subscribe', data-mt-inline-subscribe: 'true' -%}
            <span hidden data-preview-mode="{{ s.preview_submit_mode | default: 'live' }}"></span>
            <input type="hidden" name="contact[tags]" value="waitlist">
            <span hidden data-mt-words data-success-message="{{ s.success_text | default: 'Thanks for subscribing.' | escape }}" data-error-message="{{ s.error_text | default: 'Unable to subscribe. Please try again.' | escape }}" data-preview-success-message="{{ s.preview_success_text | default: 'Preview complete. No email was saved.' | escape }}" data-preview-subscribed-label="{{ s.preview_subscribed_label | default: 'Subscribed (preview)' | escape }}"></span>
            {%- if form.posted_successfully? -%}<span hidden data-mt-posted></span>{%- endif -%}
            <label for="LaunchEmail-{{ section.id }}-{{ block.id }}" data-ap-text="email_label">{{ s.email_label | default: 'Email address' | escape }}</label>
            <div class="pw-launch__fields" data-signup-layout="{{ s.signup_layout | default: 'inline' }}" style="{% if custom %}{% if b.enable_email_input_bg and b.email_input_bg_color != blank %}--input-bg:{{ b.email_input_bg_color }};{% endif %}{% if b.email_input_border_color != blank %}--input-border-color:{{ b.email_input_border_color }};{% endif %}{% if b.placeholder_color != blank %}--field-placeholder:{{ b.placeholder_color }};{% endif %}{% if b.email_text_color != blank %}--field-text:{{ b.email_text_color }};{% endif %}{% endif %}">
              <input id="LaunchEmail-{{ section.id }}-{{ block.id }}" name="contact[email]" type="email" required autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="{{ s.email_placeholder | default: 'you@example.com' | escape }}">
              <button type="submit" data-theme-button="primary"{% if custom %} style="{%- render 'button-overrides', bg: b.button_bg_color, text: b.button_text_color, hover_bg: b.button_hover_bg, hover_text: b.button_hover_text -%}"{% endif %}><span class="hidden-on-load" data-inline-label data-ap-text="button_label">{{ s.button_label | default: 'Join the waitlist' | escape }}</span><span class="icon-load" aria-hidden="true"></span></button>
            </div>
            {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- endform -%}
      {%- endcase -%}
      </div>
    {%- endfor -%}
    <a class="pw-launch__owner" href="{{ s.owner_login_url | default: 'https://storelib.com' | url }}"{% if s.owner_open_new_tab != false %} target="_blank" rel="noopener"{% endif %} data-ap-text="owner_login_label"{% unless s.show_owner_login %} hidden{% endunless %}>{{ s.owner_login_label | default: 'Website owner? Log in' | escape }}</a>
  </div>
</section>
</template>
