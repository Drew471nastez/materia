<template compat="shopify">
{%- comment -%}
  Materia Themes. A Button block of Products Listing: a theme button
  (data-theme-button), so Theme settings > Buttons draw it. Its colours
  apply when its custom styling is on, its shape when Match theme button is
  off. Without a link of its own it opens the collection (href).
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture pb_style -%}
  {%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
  {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius | default: 0 }}px;--mb-padding-x: {{ bs.pad_x | default: 0 }}px;--mb-padding-y: {{ bs.pad_y | default: 0 }}px;--mb-font-size: {{ bs.size | default: 15 }}px;--btn-border-width: {{ bs.border_width | default: 0 }}px;{%- endif -%}
{%- endcapture -%}
<a class="pl-btn" href="{% if bs.link != blank %}{{ bs.link | url }}{% else %}{{ href }}{% endif %}" data-theme-button="{% if bs.button_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-pb-order="{{ order }}" data-pb-block="{{ block.id }}" data-pb-type="button" data-pb-settings="{{ json | escape }}" style="{{ pb_style | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</a>
</template>
