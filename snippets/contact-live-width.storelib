<template compat="shopify">
{%- comment -%}
  Materia Themes. Section width for the contact sections (Contact Form
  Simple, Contact Form Simple 2, Google map, Newsletter): the element that
  carries the Section width class (container, fluid_container,
  stretch_width or full_width) gets the theme's width, so live-contact.js
  changes the width by changing that class, without a redraw. The same
  rules the sections printed for their chosen width before.
  {% render 'contact-live-width', sid: section.id %}
{%- endcomment -%}
  #shopify-section-{{ sid }} .container {
    max-width: calc(var(--page-width, 1300px) + 3rem) !important;
    margin-inline: auto !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ sid }} .fluid_container {
    max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
    margin-inline: auto !important;
    box-sizing: border-box !important;
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .stretch_width {
      padding-inline: 3rem;
    }
  }
</template>
