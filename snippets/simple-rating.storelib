<template compat="shopify">
{%- comment -%}
  Materia Themes — Simple Rating block.
  Stars + text rating, supports half stars (4.5). Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'simple-rating-' | append: block.id
  assign filled = s.filled_stars | default: 5
  assign total = s.total_stars | default: 5
  assign star_size = s.star_size | default: 18
  assign filled_color = s.filled_color | default: '#fbbf24'
  assign unfilled_color = s.unfilled_color | default: '#e5e7eb'
  assign text_color = s.text_color
  assign font_size_d = s.font_size_desktop | default: 16
  assign font_size_m = s.font_size_mobile | default: 14
  assign full_count = filled | floor
  assign frac = filled | minus: full_count
  assign has_half = false
  if frac >= 0.5
    assign has_half = true
  endif
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 8 }}px;
    padding-bottom: {{ s.padding_bottom | default: 8 }}px;
    text-align: {{ s.alignment | default: 'left' }};
  }
  #{{ block_id }} .sr-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  #{{ block_id }} .sr-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  #{{ block_id }} .sr-star {
    width: {{ star_size }}px;
    height: {{ star_size }}px;
    display: inline-block;
    color: {{ unfilled_color }};
    flex: 0 0 auto;
    position: relative;
  }
  #{{ block_id }} .sr-star.is-filled { color: {{ filled_color }}; }
  #{{ block_id }} .sr-star svg { width: 100%; height: 100%; display: block; }
  /* Half-filled star: layer the filled half over the unfilled background. */
  #{{ block_id }} .sr-star.is-half {
    color: {{ unfilled_color }};
  }
  #{{ block_id }} .sr-star.is-half::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 50%;
    overflow: hidden;
    background: {{ filled_color }};
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>");
            mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>");
    -webkit-mask-size: {{ star_size }}px {{ star_size }}px;
            mask-size: {{ star_size }}px {{ star_size }}px;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: left center;
            mask-position: left center;
    pointer-events: none;
  }
  #{{ block_id }} .sr-text {
    font-size: {{ font_size_m }}px;
    font-weight: {{ s.font_weight | default: '500' }};
    line-height: 1;
    {% if text_color != blank %}color: {{ text_color }};{% endif %}
  }
  @media (min-width: 750px) {
    #{{ block_id }} .sr-text { font-size: {{ font_size_d }}px; }
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="simple-rating-block" {{ block.shopify_attributes }}>
  <div class="sr-row">
    <span class="sr-stars" aria-label="{{ filled }} out of {{ total }} stars">
      {%- assign half_idx = full_count | plus: 1 -%}
      {%- for n in (1..total) -%}
        {%- assign idx = forloop.index -%}
        {%- assign cls = '' -%}
        {%- if idx <= full_count -%}
          {%- assign cls = 'is-filled' -%}
        {%- else -%}
          {%- if has_half and idx == half_idx -%}
            {%- assign cls = 'is-half' -%}
          {%- endif -%}
        {%- endif -%}
        <span class="sr-star {{ cls }}">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
      {%- endfor -%}
    </span>
    {%- if s.text != blank -%}
      <span class="sr-text">{{ s.text }}</span>
    {%- endif -%}
  </div>
</div>

</template>