<template compat="shopify">
{%- comment -%}
  Materia Themes. The header of Stat Counter and Stat Counter Pro: eyebrow,
  heading and subheading blocks in their block order. A section saved before
  these blocks existed keeps its text in the old section settings
  (subheading, heading, description); each one is drawn only while the
  section has no block of that type. shopify/assets/live-features-d.js
  applies edits to both in place.
  {% render 'features-d-header', section: section %}
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign eyebrow_blocks = section.blocks | where: 'type', 'eyebrow'
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign legacy_eyebrow = false
  assign legacy_heading = false
  assign legacy_sub = false
  if eyebrow_blocks.size == 0 and s.subheading != blank
    assign legacy_eyebrow = true
  endif
  if heading_blocks.size == 0 and s.heading != blank
    assign legacy_heading = true
  endif
  if sub_blocks.size == 0 and s.description != blank
    assign legacy_sub = true
  endif
  assign header_count = eyebrow_blocks.size | plus: heading_blocks.size | plus: sub_blocks.size
  if legacy_eyebrow or legacy_heading or legacy_sub
    assign header_count = header_count | plus: 1
  endif
-%}
{%- if header_count > 0 -%}
  <div class="section__header fd-header text-{{ s.header_alignment | default: 'center' }}" data-fd-header>
    {%- if legacy_eyebrow -%}<p class="fd-eyebrow m-0 fs-custom subheading_weight" data-fd-legacy="subheading">{{ s.subheading | escape }}</p>{%- endif -%}
    {%- if legacy_heading -%}<h2 class="fd-heading section__header-heading heading-letter-spacing" data-fd-legacy="heading">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="fd-eyebrow m-0 fs-custom subheading_weight" data-fd-block="{{ block.id }}" data-fd-type="eyebrow" data-fd-settings="{{ bs | json | escape }}" style="{% if bs.size_enable %}--b-size: {{ bs.size | default: 14 }}px;{% endif %}{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="fd-heading section__header-heading heading-letter-spacing" data-fd-block="{{ block.id }}" data-fd-type="heading" data-fd-settings="{{ bs | json | escape }}"{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.enable_custom_fonts %} data-own-font{% endif %} style="{% if bs.size_enable %}--b-size-m: {{ bs.size_mobile | default: 28 }}px; --b-size-d: {{ bs.size_desktop | default: 40 }}px;{% endif %}{% if bs.weight_enable %} --b-weight: {{ bs.weight | default: 700 }};{% endif %}{% if bs.enable_custom_fonts and bs.font.family != blank %} --b-font: {{ bs.font.family }}, {{ bs.font.fallback_families | default: 'serif' }};{% endif %}{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
          {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}</style>{%- endif -%}
        {%- when 'subheading' -%}
          <div class="fd-sub section__header-des rich__text-m0" data-fd-block="{{ block.id }}" data-fd-type="subheading" data-fd-settings="{{ bs | json | escape }}" style="--b-max: {{ bs.max_width | default: 640 }}px;{% if bs.size_enable %} --b-size: {{ bs.size | default: 16 }}px;{% endif %}{% render 'media-msr-var', name: '--b-color', color: bs.color, on: bs.enable_custom_style %}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
    {%- if legacy_sub -%}<div class="fd-sub section__header-des rich__text-m0" data-fd-legacy="description">{{ s.description }}</div>{%- endif -%}
  </div>
{%- endif -%}
</template>
