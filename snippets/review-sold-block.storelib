<template compat="shopify">
{%- liquid
  assign st = block.settings
  assign sold_raw = product.metafields.custom.sold_count.value | default: product.metafields.custom.sold_count
  if st.sold_source == 'manual'
    assign sold_raw = st.sold
  endif
  assign sold_count = sold_raw | plus: 0
  assign sold_integer = sold_count | floor
  if sold_count != sold_integer
    assign sold_count = 0
  endif
  if sold_raw contains ','
    assign sold_count = 0
  endif
  assign sold_hours = 0
  if st.sold_source == 'manual'
    assign sold_hours = st.hours | plus: 0
    if st.hours contains ','
      assign sold_hours = 0
    endif
  endif
-%}
{%- capture review_markup -%}
  {%- if st.show_review != false -%}
    {%- if st.review_source == 'manual' -%}
      {%- assign manual_rating = st.manual_review_rating | plus: 0 -%}
      {%- assign manual_count = st.manual_review_count | plus: 0 -%}
      {%- assign manual_integer = manual_count | floor -%}
      {%- if manual_rating > 0 and manual_rating <= 5 and manual_count > 0 and manual_count == manual_integer -%}
        <span class="product-reviews"><span aria-hidden="true">★</span> {{ manual_rating | round: 1 }} / 5 · {{ manual_count }} {{ st.review_label | default: 'reviews' | escape }}</span>
      {%- endif -%}
    {%- else -%}{%- render 'review', product: product, review_label: st.review_label -%}{%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- if review_markup != blank or st.show_sold_products != false and sold_count > 0 -%}
<div class="review_sold" id="review-sold-{{ block.id }}" {{ block.shopify_attributes }} style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;font-size:{{ st.font_size_mobile | default: 13 }}px;padding-top:{{ st.padding_top | default: 0 }}px;padding-bottom:{{ st.padding_bottom | default: 0 }}px;">
  {{- review_markup -}}
  {%- if st.show_sold_products != false and sold_count > 0 -%}
    <span class="product-sold" style="display:inline-flex;align-items:center;gap:6px;">{% if st.show_live_dot != false %}<span class="product-sold__dot" aria-hidden="true" style="flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:{{ st.live_dot_color | default: 'var(--color-heading, currentColor)' }};"></span>{% endif %}<span>{{ sold_count }} {{ st.sold_label | default: 'sold' | escape }}{% if sold_hours > 0 %} {{ st.sold_period_label | default: 'in the last' | escape }} {{ sold_hours }} {{ st.hours_label | default: 'hours' | escape }}{% endif %}</span></span>
  {%- endif -%}
</div>
<style>@media(min-width:1025px){#review-sold-{{ block.id }}{font-size:{{ st.font_size_desktop | default: 14 }}px!important;}}{% comment %}{% endcomment %}</style>
{%- elsif st.show_review != false or st.show_sold_products != false -%}
  {%- render 'editor-block-preview', block: block, title: 'Reviews & sold counter', message: 'Reviews use this product’s actual rating data. The sold counter reads custom.sold_count, or an exact verified count set in this block. No random reviews or sales are generated.' -%}
{%- endif -%}
</template>
