<template compat="shopify">
{%- assign st = block.settings -%}
<div class="menu-block-preview" data-block-preview-root="{{ block.id }}" {{ block.shopify_attributes }}>
  <p class="menu-block-preview__title">{{ st.text | default: title | escape_once }}</p>
  {%- if st.heading != blank -%}<p>{{ st.heading | escape_once }}</p>{%- endif -%}
  <div class="menu-block-preview__items">
    {%- assign shown = 0 -%}
    {%- for entry in st.collection_list -%}
      {%- assign collection = entry -%}
      {%- if collection.title == blank -%}{%- assign collection = collections[entry] -%}{%- endif -%}
      {%- if collection.title != blank -%}
        <div>{% if collection.image != blank %}<img src="{{ collection.image | image_url: width: 240 }}" alt="" width="100" height="100">{% endif %}<span>{{ collection.title | escape }}</span></div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
      {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- assign slots = '1,2,3' | split: ',' -%}
    {%- for slot in slots -%}
      {%- assign image_key = 'promotion_image_' | append: slot -%}
      {%- assign caption_key = 'promotion_label_' | append: slot -%}
      {%- assign product_key = 'product_' | append: slot -%}
      {%- assign collection_key = 'collection_' | append: slot -%}
      {%- assign item = st[product_key] | default: st[collection_key] -%}
      {%- if item != blank and item.title == blank -%}{%- assign item = all_products[item] | default: collections[item] -%}{%- endif -%}
      {%- assign image = st[image_key] | default: item.featured_image | default: item.image -%}
      {%- if image != blank or item.title != blank -%}<div>{% if image != blank %}<img src="{{ image | image_url: width: 240 }}" alt="" width="100" height="100">{% endif %}<span>{{ item.title | default: st[caption_key] | escape_once }}</span></div>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if st.image != blank -%}<div><img src="{{ st.image | image_url: width: 360 }}" alt="" width="180" height="100"><span>{{ st.label | escape_once }}</span></div>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- if shown == 0 -%}<div class="menu-block-preview__empty" aria-hidden="true"><i></i><i></i><i></i></div>{%- endif -%}
  </div>
  {%- if shown == 0 -%}<p class="menu-block-preview__hint">{% if block.type == 'pill_glass' %}Customize the header shape, spacing and surface.{% elsif block.type == 'menu_badges' %}Customize the badges attached to navigation links.{% else %}Configure this block to preview its content. Menu blocks appear under their matching navigation link.{% endif %}</p>{%- endif -%}
</div>
<style>
.menu-block-preview { padding:20px; border:1px solid var(--color-border,#ddd); color:var(--color-text,#222); background:var(--color-background,#fff); font-family:var(--body-font,inherit); border-radius:var(--input-border-radius,4px); }
.menu-block-preview__title { font:inherit; font-weight:var(--heading-weight,600); margin:0 0 16px; }
.menu-block-preview__items { display:flex; gap:12px; flex-wrap:wrap; }
.menu-block-preview__items > div { flex:1 1 100px; min-width:0; }
.menu-block-preview__items img { display:block; max-width:100%; object-fit:cover; margin-bottom:8px; }
.menu-block-preview__empty { display:flex; gap:12px; }
.menu-block-preview__empty i { flex:1; min-height:80px; border:1px solid currentColor; opacity:.15; }
.menu-block-preview__hint { font-size:.875em; line-height:1.5; margin:12px 0 0; opacity:.7; }
{% comment %}{% endcomment %}</style>
</template>
