<template compat="shopify">
{%- comment -%}
  Materia Themes. One message of Announcement Bar Pro 2: its text and, when
  it has an end date, its countdown. shopify/assets/live-announcements.js
  ticks every countdown of the bar once a second while it is on screen.
  {% render 'announce-ab2-message', block: block, section: section %}
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign st = section.settings -%}
<span class="ab2__text" data-an-text>{{ bs.text }}</span>
<span class="ab2__timer" data-an-timer data-end="{{ bs.countdown_deadline | escape }}" role="timer" aria-live="off"{% if bs.countdown_deadline == blank %} hidden{% endif %}>
  <span class="ab2__unit"><span class="ab2__num" data-u="d">00</span><span class="ab2__lbl" data-l="label_days">{{ st.label_days | escape }}</span></span>
  <span class="ab2__unit"><span class="ab2__num" data-u="h">00</span><span class="ab2__lbl" data-l="label_hours">{{ st.label_hours | escape }}</span></span>
  <span class="ab2__unit"><span class="ab2__num" data-u="m">00</span><span class="ab2__lbl" data-l="label_minutes">{{ st.label_minutes | escape }}</span></span>
  <span class="ab2__unit"><span class="ab2__num" data-u="s">00</span><span class="ab2__lbl" data-l="label_seconds">{{ st.label_seconds | escape }}</span></span>
  <span class="ab2__ended" data-an-ended hidden>{{ bs.ended_text | escape }}</span>
</span>
</template>
