<template compat="shopify">
{%- comment -%}
  Materia Themes. The values r7-faq.css reads, as --r7f-* variables for the
  root's style attribute of FAQ Search (kind: 'search') and FAQ With Contact
  Card (kind: 'card'). live-r7-faq.js derives the same list from the settings
  and writes the ones a live edit changes. Colours follow the colour scheme
  until "Enable custom styling" is on; fonts follow the theme until "Enable
  custom fonts" is on.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign own = st.enable_custom_style
-%}
--r7f-bg:{% if own %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--r7f-pt-m:{{ st.padding_top_mobile | default: 56 }}px;--r7f-pb-m:{{ st.padding_bottom_mobile | default: 56 }}px;--r7f-pt-d:{{ st.padding_top | default: 60 }}px;--r7f-pb-d:{{ st.padding_bottom | default: 60 }}px;
--r7f-maxw:{{ st.max_content_width | default: 760 }}px;--r7f-gap-header:{{ st.gap_header_to_items | default: 28 }}px;--r7f-py:{{ st.item_padding_y | default: 20 }}px;
--r7f-q-m:{{ st.question_size_mobile | default: 16 }}px;--r7f-q-d:{{ st.question_size_desktop | default: 18 }}px;--r7f-a-m:{{ st.answer_size_mobile | default: 15 }}px;--r7f-a-d:{{ st.answer_size_desktop | default: 16 }}px;
--r7f-q-color:{% if own %}{% render 'scheme-color', color: st.question_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--r7f-hover:{% if own %}{% render 'scheme-color', color: st.hover_color, fallback: 'var(--color-primary)' %}{% else %}var(--color-primary){% endif %};--r7f-icon:{% if own %}{% render 'scheme-color', color: st.icon_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
--r7f-a-color:{% if own %}{% render 'scheme-color', color: st.answer_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--r7f-divider:{% if own %}{% render 'scheme-color', color: st.divider_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
{%- if st.enable_custom_question_weight -%}--r7f-qw:{{ st.question_weight | default: 600 }};{%- endif -%}
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--r7f-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--r7f-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- if kind == 'card' -%}
--r7f-col-gap:{{ st.col_gap | default: 56 }}px;
--r7f-card-bg:{% if own %}{% render 'scheme-color', color: st.card_bg, fallback: 'color-mix(in srgb, var(--color-heading) 5%, var(--color-background))' %}{% else %}color-mix(in srgb, var(--color-heading) 5%, var(--color-background)){% endif %};--r7f-card-border:{% if own %}{% render 'scheme-color', color: st.card_border_color, fallback: 'transparent' %}{% else %}transparent{% endif %};
--r7f-card-h:{% if own %}{% render 'scheme-color', color: st.card_heading_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--r7f-card-text:{% if own %}{% render 'scheme-color', color: st.card_text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
{%- else -%}
{%- if own -%}--r7f-field-bg:{% render 'scheme-color', color: st.field_bg, fallback: 'var(--input-bg, var(--color-background))' %};--r7f-field-border:{% render 'scheme-color', color: st.field_border_color, fallback: 'var(--input-border-color, var(--color-border))' %};--r7f-field-text:{% render 'scheme-color', color: st.field_text_color, fallback: 'var(--field-text, var(--field-text-override, var(--color-text)))' %};{%- endif -%}
{%- endif -%}
</template>
