<template compat="shopify">
{%- comment -%}
  Materia Themes. Hero Benefits only. A custom font for one part of the
  section: the native font picker (picker) unless it is still on its default
  (Assistant) while the hidden legacy font list (legacy) holds another font,
  so a font saved before the picker existed still draws. mode 'face' prints
  the @font-face rules of a picked font object, anything else prints the CSS
  font stack (fallback when there is no font). shopify/assets/hero-benefits.js
  picks and spells the stack the same way for live edits.
{%- endcomment -%}
{%- liquid
  assign hbf = picker
  assign hbf_default = false
  if picker == blank or picker == 'assistant_n4' or picker.family == 'Assistant'
    assign hbf_default = true
  endif
  if picker == blank
    assign hbf = legacy | default: 'assistant_n4'
  elsif hbf_default and legacy != blank and legacy != 'assistant_n4'
    assign hbf = legacy
  endif
  assign hbf_out = fallback
  if hbf.family != blank
    if mode == 'face'
      echo hbf | font_face: font_display: 'swap'
      for face in hbf.variants
        echo face | font_face: font_display: 'swap'
      endfor
    else
      assign hbf_fb = hbf.fallback_families | default: 'sans-serif'
      assign hbf_out = '"' | append: hbf.family | append: '", ' | append: hbf_fb
    endif
  elsif mode != 'face'
    case hbf
      when 'theme_heading'
        assign hbf_out = 'var(--heading-font)'
      when 'theme_body'
        assign hbf_out = 'var(--body-font)'
      when 'assistant_n4'
        assign hbf_out = '"Assistant", sans-serif'
      when 'inter_n4'
        assign hbf_out = '"Inter", sans-serif'
      when 'manrope_n4'
        assign hbf_out = '"Manrope", sans-serif'
      when 'dm_sans_n4'
        assign hbf_out = '"DM Sans", sans-serif'
      when 'plus_jakarta_sans_n4'
        assign hbf_out = '"Plus Jakarta Sans", sans-serif'
      when 'outfit_n4'
        assign hbf_out = '"Outfit", sans-serif'
      when 'urbanist_n4'
        assign hbf_out = '"Urbanist", sans-serif'
      when 'space_grotesk_n4'
        assign hbf_out = '"Space Grotesk", sans-serif'
      when 'sora_n4'
        assign hbf_out = '"Sora", sans-serif'
      when 'lexend_n4'
        assign hbf_out = '"Lexend", sans-serif'
      when 'work_sans_n4'
        assign hbf_out = '"Work Sans", sans-serif'
      when 'figtree_n4'
        assign hbf_out = '"Figtree", sans-serif'
      when 'onest_n4'
        assign hbf_out = '"Onest", sans-serif'
      when 'geist_n4'
        assign hbf_out = '"Geist", sans-serif'
      when 'montserrat_n4'
        assign hbf_out = '"Montserrat", sans-serif'
      when 'poppins_n4'
        assign hbf_out = '"Poppins", sans-serif'
      when 'raleway_n4'
        assign hbf_out = '"Raleway", sans-serif'
      when 'nunito_sans_n4'
        assign hbf_out = '"Nunito Sans", sans-serif'
      when 'rubik_n4'
        assign hbf_out = '"Rubik", sans-serif'
      when 'karla_n4'
        assign hbf_out = '"Karla", sans-serif'
      when 'archivo_n4'
        assign hbf_out = '"Archivo", sans-serif'
      when 'barlow_n4'
        assign hbf_out = '"Barlow", sans-serif'
      when 'jost_n4'
        assign hbf_out = '"Jost", sans-serif'
      when 'albert_sans_n4'
        assign hbf_out = '"Albert Sans", sans-serif'
      when 'hanken_grotesk_n4'
        assign hbf_out = '"Hanken Grotesk", sans-serif'
      when 'schibsted_grotesk_n4'
        assign hbf_out = '"Schibsted Grotesk", sans-serif'
      when 'instrument_sans_n4'
        assign hbf_out = '"Instrument Sans", sans-serif'
      when 'ibm_plex_sans_n4'
        assign hbf_out = '"IBM Plex Sans", sans-serif'
      when 'roboto_n4'
        assign hbf_out = '"Roboto", sans-serif'
      when 'lato_n4'
        assign hbf_out = '"Lato", sans-serif'
      when 'open_sans_n4'
        assign hbf_out = '"Open Sans", sans-serif'
      when 'quicksand_n4'
        assign hbf_out = '"Quicksand", sans-serif'
      when 'mulish_n4'
        assign hbf_out = '"Mulish", sans-serif'
      when 'bricolage_grotesque_n4'
        assign hbf_out = '"Bricolage Grotesque", sans-serif'
      when 'syne_n4'
        assign hbf_out = '"Syne", sans-serif'
      when 'unbounded_n4'
        assign hbf_out = '"Unbounded", sans-serif'
      when 'bebas_neue_n4'
        assign hbf_out = '"Bebas Neue", sans-serif'
      when 'oswald_n4'
        assign hbf_out = '"Oswald", sans-serif'
      when 'anton_n4'
        assign hbf_out = '"Anton", sans-serif'
      when 'archivo_black_n4'
        assign hbf_out = '"Archivo Black", sans-serif'
      when 'playfair_display_n4'
        assign hbf_out = '"Playfair Display", Georgia, serif'
      when 'cormorant_garamond_n4'
        assign hbf_out = '"Cormorant Garamond", Georgia, serif'
      when 'dm_serif_display_n4'
        assign hbf_out = '"DM Serif Display", Georgia, serif'
      when 'fraunces_n4'
        assign hbf_out = '"Fraunces", Georgia, serif'
      when 'lora_n4'
        assign hbf_out = '"Lora", Georgia, serif'
      when 'libre_baskerville_n4'
        assign hbf_out = '"Libre Baskerville", Georgia, serif'
      when 'eb_garamond_n4'
        assign hbf_out = '"EB Garamond", Georgia, serif'
      when 'instrument_serif_n4'
        assign hbf_out = '"Instrument Serif", Georgia, serif'
      when 'source_serif_4_n4'
        assign hbf_out = '"Source Serif 4", Georgia, serif'
      when 'bodoni_moda_n4'
        assign hbf_out = '"Bodoni Moda", Georgia, serif'
      when 'libre_caslon_text_n4'
        assign hbf_out = '"Libre Caslon Text", Georgia, serif'
      when 'abril_fatface_n4'
        assign hbf_out = '"Abril Fatface", Georgia, serif'
      when 'merriweather_n4'
        assign hbf_out = '"Merriweather", Georgia, serif'
      when 'newsreader_n4'
        assign hbf_out = '"Newsreader", Georgia, serif'
      when 'young_serif_n4'
        assign hbf_out = '"Young Serif", Georgia, serif'
      when 'jetbrains_mono_n4'
        assign hbf_out = '"JetBrains Mono", ui-monospace, monospace'
      when 'space_mono_n4'
        assign hbf_out = '"Space Mono", ui-monospace, monospace'
      when 'geist_mono_n4'
        assign hbf_out = '"Geist Mono", ui-monospace, monospace'
      when 'helvetica_n4'
        assign hbf_out = '"Helvetica", sans-serif'
      when 'georgia_n4'
        assign hbf_out = '"Georgia", Georgia, serif'
      when 'arial_n4'
        assign hbf_out = '"Arial", sans-serif'
      when 'tahoma_n4'
        assign hbf_out = '"Tahoma", sans-serif'
      when 'verdana_n4'
        assign hbf_out = '"Verdana", sans-serif'
      when 'times_new_roman_n4'
        assign hbf_out = '"Times New Roman", sans-serif'
      when 'courier_new_n4'
        assign hbf_out = '"Courier New", sans-serif'
    endcase
  endif
  if mode != 'face'
    echo hbf_out
  endif
-%}
</template>