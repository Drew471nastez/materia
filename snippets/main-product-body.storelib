<template compat="shopify">
{%- assign fb_accessibility_payment_badges = 'accessibility.payment_badges' | t -%}
{%- assign fb_accessibility_use_code = 'accessibility.use_code' | t -%}
{%- assign fb_accessibility_product_label = 'accessibility.product_label' | t -%}
{%- assign fb_accessibility_add_product = 'accessibility.add_product' | t -%}
{%- assign fb_accessibility_default = 'accessibility.default' | t -%}
{%- assign fb_accessibility_have_questions = 'accessibility.have_questions' | t -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
  {%- assign sw_m = section.settings.section_width_mobile -%}
  {%- if sw_m != blank and sw_m != section.settings.section_width -%}
    @media (max-width: 767px) {
      {%- if sw_m == 'stretch_width' -%}
        #shopify-section-{{ section.id }} .container,
        #shopify-section-{{ section.id }} .fluid_container,
        #shopify-section-{{ section.id }} .full_width {
          max-width: none !important;
          padding-inline: 1rem !important;
        }
      {%- elsif sw_m == 'full_width' -%}
        #shopify-section-{{ section.id }} .container,
        #shopify-section-{{ section.id }} .fluid_container,
        #shopify-section-{{ section.id }} .stretch_width {
          max-width: none !important;
          padding-inline: 0 !important;
        }
      {%- elsif sw_m == 'fluid_container' -%}
        #shopify-section-{{ section.id }} .container,
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }} .full_width {
          max-width: var(--fluid-container-width, 1500px) !important;
          padding-inline: 1.5rem !important;
        }
      {%- elsif sw_m == 'container' -%}
        #shopify-section-{{ section.id }} .fluid_container,
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }} .full_width {
          max-width: var(--page-width, 1300px) !important;
          padding-inline: 1.5rem !important;
        }
      {%- endif -%}
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'main-product.css' | asset_url | stylesheet_tag }}
{{ 'product-page-ui.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-page-ui.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign theme_st = settings
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign enable_sticky_content_on_desktop = section_st.enable_sticky_content_on_desktop
  assign enable_skeleton_loading = false
  assign desktop_media_width = section_st.desktop_media_width
  assign desktop_layout = section_st.desktop_layout
  assign image_zoom = section_st.image_zoom
  assign user_variants_image_group = false
  assign enable_sticky_add_cart_on_desktop = section_st.enable_on_desktop
  assign enable_sticky_add_cart_on_mobile = section_st.enable_on_mobile
  assign enable_frequently_bought_together = false
  if settings.color_swatch_trigger != blank and settings.enable_color_swatches != false
    assign option_color_name = settings.color_swatch_trigger | split: ','
  else
    assign option_color_name = 'Color'
  endif
  comment
    `color_scheme` setting returns a scheme object — use `.id` to get
    the matching `.color-scheme-N` class generated in theme.liquid.
  endcomment
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  comment
    Resolve the actual hex values for the section's scheme so we can
    hard-paint lightbox + sticky add-to-cart without depending on CSS
    variable inheritance. The lightbox is mounted on `<body>` (escapes
    section containment) and the sticky bar is `position: fixed` (also
    paints from page context, not section context), so neither picks
    up the section's `.color-{id}` class via cascade.
  endcomment
  assign pinfo_scheme = section_st.color_scheme
  assign pinfo_bg = ''
  assign pinfo_text = ''
  assign pinfo_heading = ''
  assign pinfo_btn_primary_color = ''
  assign pinfo_btn_primary_bg = ''
  assign pinfo_btn_outline_color = ''
  assign pinfo_btn_outline_border = ''
  if pinfo_scheme.settings
    assign pinfo_bg = pinfo_scheme.settings.background
    assign pinfo_text = pinfo_scheme.settings.text_color
    assign pinfo_heading = pinfo_scheme.settings.heading_color
    assign pinfo_btn_primary_color = pinfo_scheme.settings.btn_primary_color
    assign pinfo_btn_primary_bg = pinfo_scheme.settings.btn_primary_background
    assign pinfo_btn_outline_color = pinfo_scheme.settings.btn_outline_color
    assign pinfo_btn_outline_border = pinfo_scheme.settings.btn_outline_border_color
  endif
  assign products_group = product.metafields.custom.product_grouped
  assign color = false
  for option in product.options_with_values
    for itemColor in option_color_name
      if option.name == itemColor
        assign color = true
      endif
    endfor
  endfor
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign wishlist = pages.wishlist
  assign action_when_click_added_wishlist = theme_st.action_when_click_added_wishlist
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--speed: {{ section_st.speed }}s; --font-size: {{ section_st.font_size }};
{%- endcapture -%}

{%- comment -%} Images per row (mobile) is read by snippets/media-gallery (data-mobile). {%- endcomment -%}

{%- if section_st.enable_nav_dots_mobile -%}
  {%- render 'product-extras', mode: 'nav_dots', section_id: section.id -%}
{%- endif -%}

{%- comment -%}
  Hard-paint <style> for lightbox + sticky add-to-cart bar lives in a
  separate snippet to keep this section file under Shopify's 256 KB
  template-content cap. Pass resolved scheme hex values + section.id.
{%- endcomment -%}
{%- render 'main-product-scheme-paint',
  pinfo_bg: pinfo_bg,
  pinfo_text: pinfo_text,
  pinfo_heading: pinfo_heading,
  pinfo_btn_primary_color: pinfo_btn_primary_color,
  pinfo_btn_primary_bg: pinfo_btn_primary_bg,
  pinfo_btn_outline_color: pinfo_btn_outline_color,
  pinfo_btn_outline_border: pinfo_btn_outline_border,
  section_id: section.id
-%}

{%- if section_st.content_gap_desktop or section_st.enable_custom_padding or section_st.media_square -%}
  <style>
    {%- if section_st.media_square -%}
      /* Square images are drawn 1:1 by snippets/product-media-layout
         (no override needed here, so nothing jumps). */
      /* Sticky-cart thumbnail also goes square (cleaner look) */
      #MainProduct-{{ section.id }} sticky-add-cart .product-item__media--ratio { border-radius: 8px !important; }
    {%- endif -%}
    {%- if section_st.enable_custom_media_gap -%}
      /* Override the inline --col-gap on .main-product so the flex gap
         between media column and content column actually changes. */
      @media (min-width: 1024px) {
        #MainProduct-{{ section.id }} .main-product {
          --col-gap: {{ section_st.content_gap_desktop }}px !important;
          --col-gap-desktop: {{ section_st.content_gap_desktop }}px !important;
          gap: {{ section_st.content_gap_desktop }}px !important;
        }
      }
    {%- endif -%}
    {%- if section_st.enable_custom_padding -%}
      @media (min-width: 1024px) {
        #MainProduct-{{ section.id }} > :is(.container, .fluid_container, .full_width, skeleton-page) {
          padding-left: {{ section_st.padding_left_desktop | default: 0 }}px !important;
          padding-right: {{ section_st.padding_right_desktop | default: 0 }}px !important;
        }
      }
      @media (max-width: 1023px) {
        #MainProduct-{{ section.id }} > :is(.container, .fluid_container, .full_width, skeleton-page) {
          padding-left: {{ section_st.padding_left_mobile | default: 0 }}px !important;
          padding-right: {{ section_st.padding_right_mobile | default: 0 }}px !important;
        }
      }
    {%- endif -%}
{% comment %}{% endcomment %}  </style>
{%- endif -%}

<div
  id="MainProduct-{{ section.id }}"
  class="section sec__featured-product product__item-js {% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  data-section="{{ section.id }}"
  data-color-trigger="{{ settings.color_swatch_trigger }}"
  data-desktop-layout="{{ desktop_layout }}"
  data-mobile-layout="{{ section_st.mobile_options }}"
  data-zoom="{{ image_zoom }}"
  style="{{ style | strip | strip_newlines }}"
>
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {%- assign first_3_d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3_d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    >
  {% endif %}
  {%- if image_zoom == 'external_zoom' or image_zoom == 'inner_zoom_circle' or image_zoom == 'inner_zoom_square' -%}
    {{ 'photoswipe.css' | asset_url | stylesheet_tag }}
  {% endif %}
  {% if image_zoom != 'no_zoom' %}
    {{ 'photoswipe.css' | asset_url | stylesheet_tag }}
  {% endif %}
  {% if enable_skeleton_loading == true %}
    {{ 'skeleton.css' | asset_url | stylesheet_tag }}
    <skeleton-page class="{{ section_width }} skeleton  block">
  {% else %}
    <div class="{{ section_width }}">
  {% endif %}
  <div
    class="flex flex-cols gap flex-wrap main-product"
    style="--col-gap: 30px;--col-width: {{ desktop_media_width }}%"
  >
    {%- if product.media.size > 0 -%}
      <div class="product-detail__media col-md-w-custom w-full ">
        {% comment %} logic check ratio of image{% endcomment %}
        {%- liquid
          assign default_position = 0
          unless product.has_only_default_variant
            assign default_position = product.selected_or_first_available_variant.featured_image.position | minus: 1
          endunless
        -%}
        {% liquid
          assign position = 1
          for opt in product.options_with_values
            for color_trigger_name in option_color_name
              if opt.name == color_trigger_name
                assign position = opt.position
              endif
            endfor
          endfor
          assign default_color_option = ''
          if position == 1
            assign default_color_option = product.selected_or_first_available_variant.option1
          elsif position == 2
            assign default_color_option = product.selected_or_first_available_variant.option2
          elsif position == 3
            assign default_color_option = product.selected_or_first_available_variant.option3
          endif
          assign media = product.media
          if product.metafields.custom.use_variants_image_group != blank and product.metafields.custom.use_variants_image_group
            assign user_variants_image_group = true
            assign alt_tags = ''
            assign first = true
            for image in product.media
              if image.alt != blank
                assign exclude_image = false
                for option in product.options_with_values
                  for value in option.values
                    if image.alt == value
                      assign exclude_image = true
                    endif
                  endfor
                endfor
                if exclude_image == false
                  if first
                    assign alt_tags = image.alt
                    assign first = false
                  else
                    assign alt_tags = alt_tags | append: ', ' | append: image.alt
                  endif
                endif
              endif
            endfor
            assign variant_media = product.media | where: 'alt', default_color_option
            assign alt_tags_list = alt_tags | split: ', '
            assign other_media = ''
            assign added_alts = ''
            for image in product.media
              for alt_tag in alt_tags_list
                if image.alt == alt_tag
                  if added_alts contains alt_tag
                  else
                    assign other_media = other_media | append: image.alt | append: ','
                    assign added_alts = added_alts | append: alt_tag | append: ','
                  endif
                endif
              endfor
            endfor
            assign combined_media = variant_media
            assign other_media_array = other_media | split: ','
            for alt_tag in other_media_array
              assign media_to_add = product.media | where: 'alt', alt_tag
              assign combined_media = combined_media | concat: media_to_add
            endfor
            assign media = combined_media
          endif
          if media.size == 0
            assign media = product.media
          endif
        %}
        {%- liquid
          assign mp_lightbox = true
          if image_zoom == 'no_zoom'
            assign mp_lightbox = false
          endif
        -%}
        {% render 'media-gallery',
          images: media,
          section_st: section_st,
          theme_st: theme_st,
          product: product,
          section: section,
          position_index: default_position,
          desktop_layout: desktop_layout,
          lightbox: mp_lightbox
        %}
        {%- comment -%} Wishlist button — removed per theme settings. {%- endcomment -%}

      </div>
    {%- else -%}
      {%- comment -%} A product without pictures: the column keeps its place. {%- endcomment -%}
      <div class="product-detail__media col-md-w-custom w-full">
        {%- render 'product-media-placeholder', section_st: section_st, product: product -%}
      </div>
    {% endif %}
    {% comment %} Product infomration {% endcomment %}
      <motion-element {% if enable_skeleton_loading == true %} hold {% endif %} class="product-detail__information col-md-remaining w-full {% if enable_skeleton_loading != true %} opacity-0 {% endif %}" data-motion="fade-up-sm">
        {% if enable_sticky_content_on_desktop %}<div class="sticky top-30">{% endif %}
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {% if section.settings.image_zoom == 'external_zoom' %}
          <div class="zoom-external-area"></div>
        {% endif %}
        {%- assign pib_drawn = '' -%}
        {%- for block in section.blocks -%}
          {% assign block_st = block.settings %}
          {%- include 'product-info-blocks' -%}
        {%- endfor -%}
        {% if enable_sticky_content_on_desktop %}</div>{% endif %}
      </motion-element>
  </div>
  {% assign products_bought_together = product.metafields.custom.bought_together | split: ',' | uniq %}
  {% if enable_frequently_bought_together and products_bought_together.size > 0 %}
    <product-bought-together class="block mt-40" id="product-bought-together">
      <script type="application/json" class="productBoughTogether">
        [{{ product.id }},{%- for item in products_bought_together -%}{{ item | split: 'Product/' | last | split: '"' | first }}{%- unless forloop.last -%},{%- endunless forloop.last -%}{%- endfor -%}]
{% comment %}{% endcomment %}      </script>
    </product-bought-together>
  {% endif %}

  {% if enable_sticky_add_cart_on_desktop == true or enable_sticky_add_cart_on_mobile == true %}
    {%- assign product_form_id = 'sticky-addcart-form-' | append: section.id -%}
    {%- assign sticky_show_image = section_st.sticky_show_image -%}
    {%- assign sticky_show_title = section_st.sticky_show_title -%}
    {%- assign sticky_show_variant_picker = section_st.sticky_show_variant_picker -%}
    {%- assign sticky_show_quantity = section_st.sticky_show_quantity -%}
    {%- assign sticky_padding_y = section_st.sticky_padding_y | default: 12 -%}
    {%- assign sticky_button_radius = section_st.sticky_button_radius | default: 8 -%}
    {%- assign sticky_bar_bg_override = section_st.sticky_bar_bg -%}
    {%- assign sticky_border_color_override = section_st.sticky_border_color -%}
    <style>
      sticky-add-cart[data-section-id="{{ section.id }}"] {
        --sticky-pad-y: {{ sticky_padding_y }}px;
        {%- if sticky_bar_bg_override != blank %}
        background-color: {{ sticky_bar_bg_override }} !important;
        {%- endif %}
        {%- if sticky_border_color_override != blank %}
        border-top-color: {{ sticky_border_color_override }} !important;
        {%- endif %}
      }
      sticky-add-cart[data-section-id="{{ section.id }}"] :is(.btn-primary, button[type="submit"], .product-form__submit, button[name="add"]) {
        border-radius: {{ sticky_button_radius }}px !important;
      }
      {%- unless sticky_show_quantity %}
      sticky-add-cart[data-section-id="{{ section.id }}"] .product-form__quantity { display: none !important; }
      {%- endunless %}
      {%- unless sticky_show_variant_picker %}
      sticky-add-cart[data-section-id="{{ section.id }}"] .product-detail__variant-picker { display: none !important; }
      {%- endunless %}
      {%- unless sticky_show_image %}
      sticky-add-cart[data-section-id="{{ section.id }}"] .product-item__inner,
      sticky-add-cart[data-section-id="{{ section.id }}"] .product-item__media { display: none !important; }
      {%- endunless %}
      {%- unless sticky_show_title %}
      sticky-add-cart[data-section-id="{{ section.id }}"] .product-item__information { display: none !important; }
      {%- endunless %}
{% comment %}{% endcomment %}    </style>
    <sticky-add-cart data-section-id="{{ section.id }}" class="fixed z-10 inset-x-0 bottom-0 shadow color-default {% if enable_sticky_add_cart_on_desktop == true %}sticky_desktop--show{% else %} hidden-md{% endif %}{% if enable_sticky_add_cart_on_mobile == true %} sticky_mobile--show{% else %} hidden{% endif %}{% unless sticky_show_variant_picker %} no-picker{% endunless %}{% if product.has_only_default_variant %} no-picker{% endif %}" role="region" aria-label="{{ product.title | escape }}">
      <div class="{{ section_width }}">
        {%- if section_st.sticky_show_reviews -%}
          {%- capture sticky_reviews -%}{%- render 'review', product: product -%}{%- endcapture -%}
          {%- assign sticky_reviews_check = sticky_reviews | strip -%}
          {%- if sticky_reviews_check != blank -%}<div class="sticky-cart-rating">{{ sticky_reviews }}</div>{%- endif -%}
        {%- endif -%}
        <div class="flex gap-15 justify-between align-center">
          {% render 'product-item',
            card_product: product,
            section_id: section.id,
            template_enable_action: false,
            template_enable_product_vendor: false,
            template_enable_rate: section_st.sticky_show_reviews,
            template_enable_product_short_description: false,
            template_enable_color_swatches: false,
            type: 'sticky',
            class: 'hidden block-md',
            section_st: section_st
          %}
          <div class="sticky__item-info flex gap-10 w-full w-md-unset">
            <div class="product-detail__variant-picker text-size heading-color w-full">
              {% if user_variants_image_group %}
                {%- render 'color-swatches', product: product, type: 'sticky_group', section: section -%}
              {% else %}
                {%- render 'color-swatches', product: product, type: 'sticky', section: section -%}
              {% endif %}
            </div>
            <div class="product-detail__buy-buttons w-full">
              {%- render 'buy-buttons',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                show_wishlist: false,
                show_compare: false,
                formClass: 'feature-product-form',
                type: 'sticky'
              -%}
            </div>
          </div>
        </div>
      </div>
    </sticky-add-cart>
  {% endif %}
  {% unless product == empty %}
    <script
      type="application/json"
      data-product-json
      class="productJson"
    >
      {{ product | json }}
{% comment %}{% endcomment %}    </script>
    {%- render 'product-variant-media-json', product: product -%}
  {% endunless %}
  {%- unless product.has_only_default_variant -%}
    <script type="application/json" class="productVariantsQty">
      [
        {%- for variant in product.variants -%}
          { "id": {{ variant.id | json }}, "option": {{ variant.option1 | append: '' | json }}, "qty": {{ variant.inventory_quantity | default: 0 | json }}, "available": {% if variant.available %}true{% else %}false{% endif %}, "mamagement": {{ variant.inventory_management | append: '' | json }}, "incoming": {% if variant.incoming %}true{% else %}false{% endif %}, "incoming_date": {{ variant.next_incoming_date | append: '' | json }} }
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
{% comment %}{% endcomment %}    </script>
  {%- endunless -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function isIE() {
        const ua = window.navigator.userAgent;
        const msie = ua.indexOf('MSIE ');
        const trident = ua.indexOf('Trident/');

        return msie > 0 || trident > 0;
      }

      if (!isIE()) return;
      const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id"]');
      const noScriptInputWrapper = document.createElement('div');
      const variantSwitcher =
        document.querySelector('variant-radios[data-section="{{ section.id }}"]') ||
        document.querySelector('variant-selects[data-section="{{ section.id }}"]');
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }} mt-15 d-block'
      ).textContent;
      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    });
{% comment %}{% endcomment %}  </script>
  {%- if first_3_d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
{% comment %}{% endcomment %}    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {% endif %}
  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media -%}
        "image": [
          {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
        ],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {% endif %}
            {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
            {% endif %}
            {%- if variant.barcode.size == 13 -%}
              "gtin13": {{ variant.barcode }},
            {% endif %}
            {%- if variant.barcode.size == 14 -%}
              "gtin14": {{ variant.barcode }},
            {% endif %}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
{% comment %}{% endcomment %}  </script>
  {% if enable_skeleton_loading == true %}
    </skeleton-page>
  {% else %}
    </div>
  {% endif %}

</div>


</template>
