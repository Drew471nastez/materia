<template compat="shopify">
{%- comment -%}
  Materia Themes. The logo carousel of Brand logo and Logos list: a scroll
  snap row with arrows, dots or a progress bar. Logos per row, gaps, arrows
  and pagination are CSS variables and attributes on the carousel
  (.lgc) and root (.lg); live-logos.js drives arrows, dots, keyboard, loop and
  autoplay. Phone below 768px, tablet to 989px, desktop above.
  {% render 'logos-carousel-style', section: section %}
{%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #shopify-section-{{ sid }} .lgc { position: relative; --per: var(--per-m); --gap: var(--gap-m); }
  #shopify-section-{{ sid }} .lgc__track { display: flex; gap: var(--gap); margin: 0; padding: 0; list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  #shopify-section-{{ sid }} .lgc__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .lgc__track:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  #shopify-section-{{ sid }} .lgc__slide { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); min-width: 0; scroll-snap-align: start; display: flex; align-items: center; justify-content: var(--lgc-justify, center); margin: 0; }
  #shopify-section-{{ sid }} .lgc__arrow { position: absolute; top: var(--arrow-y-m, 50%); z-index: 2; display: none; align-items: center; justify-content: center; width: max(44px, var(--arrow-size, 44px)); height: max(44px, var(--arrow-size, 44px)); margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--arrow-c, var(--color-heading)); cursor: pointer; transform: translateY(-50%); }
  #shopify-section-{{ sid }} .lgc__arrow::before { content: ''; position: absolute; left: 50%; top: 50%; width: var(--arrow-size, 40px); height: var(--arrow-size, 40px); border-radius: 50%; background: var(--arrow-bg, color-mix(in srgb, var(--color-heading) 10%, transparent)); transform: translate(-50%, -50%); z-index: -1; }
  #shopify-section-{{ sid }} .lgc__arrow svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .lgc__arrow--prev { left: 0; }
  #shopify-section-{{ sid }} .lgc__arrow--next { right: 0; }
  #shopify-section-{{ sid }} .lgc__arrow:hover::before { opacity: .8; }
  #shopify-section-{{ sid }} .lgc__arrow[aria-disabled='true'] { opacity: .35; cursor: default; }
  #shopify-section-{{ sid }} .lgc:is([data-arrows='both'], [data-arrows='mobile_only']) .lgc__arrow { display: flex; }
  #shopify-section-{{ sid }} .lgc__dots { display: none; flex-wrap: wrap; justify-content: var(--dots-justify, center); gap: 0; margin-top: 12px; }
  #shopify-section-{{ sid }} .lgc:is([data-pagination='show_dots'], [data-pagination='show_dots_on_mobile']) .lgc__dots { display: flex; }
  #shopify-section-{{ sid }} .lgc__dot { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin: 0; padding: 0; border: 0; background: none; color: var(--lg-text); font: inherit; font-size: 12px; cursor: pointer; }
  #shopify-section-{{ sid }} .lgc__dot::before { content: ''; display: block; width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: .3; transition: width var(--btn-anim-duration, .3s) ease, opacity var(--btn-anim-duration, .3s) ease; }
  #shopify-section-{{ sid }} .lgc__dot[aria-current='true']::before { opacity: 1; }
  #shopify-section-{{ sid }} .lgc__dot span { display: none; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='pill'] .lgc__dot[aria-current='true']::before { width: 24px; border-radius: 4px; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='line'] .lgc__dot::before { width: 24px; height: 2px; border-radius: 0; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='square'] .lgc__dot::before { border-radius: 0; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='ring'] .lgc__dot::before { width: 10px; height: 10px; background: transparent; border: 2px solid currentColor; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='number'] .lgc__dot::before { display: none; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='number'] .lgc__dot span { display: inline; opacity: .45; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='number'] .lgc__dot[aria-current='true'] span { opacity: 1; font-weight: 700; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='progress'] .lgc__dot { min-width: 32px; }
  #shopify-section-{{ sid }} .lgc[data-pstyle='progress'] .lgc__dot::before { width: 28px; height: 4px; border-radius: 2px; }
  #shopify-section-{{ sid }} .lgc__bar { display: none; position: relative; height: 3px; margin: 24px auto 0; max-width: 240px; background: color-mix(in srgb, var(--lg-text) 20%, transparent); border-radius: 3px; overflow: hidden; }
  #shopify-section-{{ sid }} .lgc[data-pagination='show_progress_bar'] .lgc__bar { display: block; }
  #shopify-section-{{ sid }} .lgc__bar span { position: absolute; inset: 0 auto 0 0; width: calc(min(1, var(--per) / var(--count)) * 100% + var(--lgc-p, 0) * (100% - min(1, var(--per) / var(--count)) * 100%)); background: var(--lg-text); border-radius: inherit; }
  @media (max-width: 767px) { #shopify-section-{{ sid }} .lgc[data-fit-m='true'] :is(.lgc__arrow, .lgc__dots, .lgc__bar) { display: none !important; } }
  @media (min-width: 768px) and (max-width: 989px) { #shopify-section-{{ sid }} .lgc[data-fit-t='true'] :is(.lgc__arrow, .lgc__dots, .lgc__bar) { display: none !important; } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .lgc[data-fit-d='true'] :is(.lgc__arrow, .lgc__dots, .lgc__bar) { display: none !important; } }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .lgc { --per: var(--per-t); --gap: var(--gap-d); }
    #shopify-section-{{ sid }} .lgc__arrow { top: var(--arrow-y-d, 50%); }
    #shopify-section-{{ sid }} .lgc[data-arrows='mobile_only'] .lgc__arrow { display: none; }
    #shopify-section-{{ sid }} .lgc[data-arrows='desktop_only'] .lgc__arrow { display: flex; }
    #shopify-section-{{ sid }} .lgc[data-pagination='show_dots_on_mobile'] .lgc__dots { display: none; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .lgc { --per: var(--per-d); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .lgc__track { scroll-behavior: auto; }
    #shopify-section-{{ sid }} .lgc__dot::before { transition: none; }
  }
</style>
</template>
