<template compat="shopify">
{% comment %}Shared first-paint surfaces and typography for the wavy/title control refresh.{% endcomment %}
{% assign s = section.settings %}
{% capture panel %}{% if s.enable_custom_style %}{% render 'scheme-color', color:s.section_bg, fallback:'color-mix(in srgb,var(--color-text) 6%,var(--color-background))' %}{% else %}color-mix(in srgb,var(--color-text) 6%,var(--color-background)){% endif %}{% endcapture %}
<style>
{% if kind == 'wavyrichtextbanner' %}
#shopify-section-{{ section.id }}{background:transparent!important}
#shopify-section-{{ section.id }} [data-text-controls="wavyrichtextbanner"]{--tx-panel-bg:{{ panel | strip }};--section-wave-color:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.wave_color,fallback:'var(--tx-panel-bg)' %}{% else %}var(--tx-panel-bg){% endif %}!important;background:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.outer_background,fallback:'var(--color-background)' %}{% else %}var(--color-background){% endif %}!important}
#shopify-section-{{ section.id }} .LoudzWavyBannerSectionContainer{background:var(--tx-panel-bg)!important}
#shopify-section-{{ section.id }} .LoudzWavesBox path{fill:var(--section-wave-color)!important}
{% else %}
#shopify-section-{{ section.id }} [data-tx-subheading]{font-size:{{ s.subheading_font_size_desktop }}px;line-height:{{ s.subheading_line_height_desktop }};padding-left:{{ s.subheading_padding_left_desktop }}px;padding-right:{{ s.subheading_padding_right_desktop }}px;color:var(--subheading-text-color);margin-inline:auto}
@media(max-width:767px){#shopify-section-{{ section.id }} [data-tx-subheading]{font-size:{{ s.subheading_font_size_mobile }}px;line-height:{{ s.subheading_line_height_mobile }};padding-left:{{ s.subheading_padding_left_mobile }}px;padding-right:{{ s.subheading_padding_right_mobile }}px}}
#shopify-section-{{ section.id }} [data-text-controls="titleandsubtitle"]{background:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.section_background,fallback:'var(--color-background)' %}{% else %}var(--color-background){% endif %}!important;text-align:{{ s.content_alignment | default:'center' }};padding-inline:16px}
#shopify-section-{{ section.id }} [data-tx-subheading]{max-width:{{ s.text_max_width | default:1000 }}px!important}
{% assign subtitle = section.blocks | where:'type','subtitle' | first %}
{% for block in section.blocks %}{% assign b=block.settings %}
#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{margin-top:{{ b.space_above | default:0 | plus:0 }}px!important;margin-bottom:{{ b.space_below | default:0 }}px!important}
{% if block.type == 'subtitle' %}#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{margin-top:{{ s.title_subtitle_gap_desktop | plus:b.space_above }}px!important;margin-bottom:{% if s.subheading_text != blank %}{{ s.title_subheading_gap_desktop | plus:b.space_below }}{% else %}{{ b.space_below | default:0 }}{% endif %}px!important}@media(max-width:767px){#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{margin-top:{{ s.title_subtitle_gap_mobile | plus:b.space_above }}px!important;margin-bottom:{% if s.subheading_text != blank %}{{ s.title_subheading_gap_mobile | plus:b.space_below }}{% else %}{{ b.space_below | default:0 }}{% endif %}px!important}}{% endif %}
{% if b.enable_custom_style %}#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{font-weight:{% if b.font_weight != 'theme' and b.font_weight != blank %}{{ b.font_weight }}{% elsif block.type == 'title' %}{% if s.title_font_weight == 'theme' %}var(--heading-weight,700){% else %}{{ s.title_font_weight }}{% endif %}{% else %}{% if s.subtitle_font_weight == 'theme' %}var(--heading-weight,700){% else %}{{ s.subtitle_font_weight }}{% endif %}{% endif %}!important;letter-spacing:{{ b.letter_spacing | default:0 }}px!important;line-height:{{ b.line_height | default:1.2 }}!important;text-transform:{% if b.text_case == 'theme' or b.text_case == blank %}var(--heading-text-transform,none){% else %}{{ b.text_case }}{% endif %}!important;{% if b.color != blank %}color:{{ b.color }}!important;{% endif %}}{% endif %}
{% endfor %}
@media(max-width:767px){#shopify-section-{{ section.id }} [data-text-controls="titleandsubtitle"]{text-align:{{ s.content_alignment_mobile | default:'center' }}}}
{% endif %}
</style>
</template>
