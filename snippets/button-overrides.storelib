<template compat="shopify">
{%- comment -%}
  Materia Themes. A section's own button values for the theme button contract
  (data-theme-button). Prints only what the creator set, so everything else
  follows Theme settings > Buttons and the colour scheme.
  Colours: bg, text, border, hover_bg, hover_text, hover_border (empty or
  transparent = theme; a border left empty follows its background). Shape and type apply when custom is true: radius,
  padding_y, padding_x, font_size, weight, border_width (numbers, px).
  transform: a text-transform value, any time.
  Use: style="render 'button-overrides', bg: bs.bg, text: bs.color, custom: true, radius: 8"
{%- endcomment -%}
{%- if bg != blank and bg.alpha != 0 -%}--mb-bg: {{ bg }};{%- endif -%}
{%- if text != blank and text.alpha != 0 -%}--mb-text: {{ text }};{%- endif -%}
{%- if border != blank and border.alpha != 0 -%}--mb-border: {{ border }};{%- elsif bg != blank and bg.alpha != 0 -%}--mb-border: {{ bg }};{%- endif -%}
{%- if hover_bg != blank and hover_bg.alpha != 0 -%}--mb-hover-bg: {{ hover_bg }};{%- endif -%}
{%- if hover_text != blank and hover_text.alpha != 0 -%}--mb-hover-text: {{ hover_text }};{%- endif -%}
{%- if hover_border != blank and hover_border.alpha != 0 -%}--mb-hover-border: {{ hover_border }};{%- elsif hover_bg != blank and hover_bg.alpha != 0 -%}--mb-hover-border: {{ hover_bg }};{%- endif -%}
{%- if custom -%}
  {%- if radius != blank -%}--mb-radius: {{ radius }}px;{%- endif -%}
  {%- if padding_y != blank -%}--mb-padding-y: {{ padding_y }}px;{%- endif -%}
  {%- if padding_x != blank -%}--mb-padding-x: {{ padding_x }}px;{%- endif -%}
  {%- if font_size != blank -%}--mb-font-size: {{ font_size }}px;{%- endif -%}
  {%- if weight != blank -%}--mb-weight: {{ weight }};{%- endif -%}
  {%- if border_width != blank -%}--btn-border-width: {{ border_width }}px;{%- endif -%}
{%- endif -%}
{%- if transform != blank -%}--btn-text-transform: {{ transform }};{%- endif -%}
</template>
