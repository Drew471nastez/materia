<template compat="shopify">
{%- comment -%}
  Materia Themes. Arrows (part: 'arrows') or dots and progress bar
  (part: 'pagination') of the logo carousel; count: the number of logos;
  loop: true when the carousel wraps.
{%- endcomment -%}
{%- if part == 'arrows' -%}
  <button type="button" class="lgc__arrow lgc__arrow--prev" data-lg-prev aria-label="Previous logos" aria-controls="lgc-{{ section.id }}" aria-disabled="{% if loop %}false{% else %}true{% endif %}"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <button type="button" class="lgc__arrow lgc__arrow--next" data-lg-next aria-label="Next logos" aria-controls="lgc-{{ section.id }}" aria-disabled="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
{%- else -%}
  <div class="lgc__dots" data-lg-dots>
    {%- for i in (1..count) -%}<button type="button" class="lgc__dot" data-lg-dot="{{ forloop.index0 }}" aria-label="Show logo {{ i }}" aria-controls="lgc-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}><span>{{ i }}</span></button>{%- endfor -%}
  </div>
  <div class="lgc__bar" aria-hidden="true"><span></span></div>
{%- endif -%}
</template>
