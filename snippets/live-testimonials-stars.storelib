<template compat="shopify">
{%- comment -%}
  Materia Themes. Five stars filled to a rating (0 to 5, any fraction: 4.3
  fills four stars and 30% of the fifth). Each star is the empty star with
  the filled star clipped over it (--lt-fill), coloured by --lt-star-on and
  --lt-star-off from the section. live-testimonials.js redraws the same
  fills when a rating changes in the builder.
  rating: the number. class: extra class on the row (optional). hidden: true
  hides the row (it stays in the page so a live edit can show it).
{%- endcomment -%}
{%- assign lt_rating = rating | default: 0 | at_least: 0 | at_most: 5 -%}
<span class="lt-stars{% if class != blank %} {{ class }}{% endif %}" role="img" aria-label="{{ lt_rating }} / 5" data-lt-stars{% if hidden %} hidden{% endif %}>
  {%- for n in (1..5) -%}
    {%- assign lt_fill = lt_rating | minus: n | plus: 1 | at_least: 0 | at_most: 1 | times: 100 | round -%}
    <span class="lt-star" style="--lt-fill: {{ lt_fill }}%;" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z"/></svg></span>
  {%- endfor -%}
</span>
</template>
