<template compat="shopify">
{%- comment -%}
  Materia Themes. The styles Text Columns and Sticky Heading Text share: the
  section wrapper (margins, Show on mobile), the root (background, padding,
  width), the header blocks drawn by snippets/r7-text-header, rich text and
  the text link. p: the section's class prefix (txc, sht).

  Every value a setting changes is a CSS variable on the wrapper, the root or
  a block, printed by the section for the first paint and written again by
  live-r7-text.js on a live edit, with the same names and fallbacks. A
  heading with no size of its own keeps the theme's heading size (--size).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign mt_m = st.section_margin_top_mobile | default: 0
  assign mb_m = st.section_margin_bottom_mobile | default: 0
  assign mt_d = st.section_margin_top_desktop | default: 0
  assign mb_d = st.section_margin_bottom_desktop | default: 0
  if st.reset_spacing
    assign mt_m = 0
    assign mb_m = 0
    assign mt_d = 0
    assign mb_d = 0
  endif
-%}
{%- if st.reset_spacing -%}
<style data-rs-bulletproof>
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}</style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
    max-width: none !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
    margin-top: var(--r7t-mt-m, 0px) !important;
    margin-bottom: var(--r7t-mb-m, 0px) !important;
    --r7t-mt-m: {{ mt_m }}px;
    --r7t-mb-m: {{ mb_m }}px;
    --r7t-mt-d: {{ mt_d }}px;
    --r7t-mb-d: {{ mb_d }}px;
    --r7t-mobile-display: {% if st.show_on_mobile == false %}none{% else %}block{% endif %};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} { margin-top: var(--r7t-mt-d, 0px) !important; margin-bottom: var(--r7t-mb-d, 0px) !important; }
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} { display: var(--r7t-mobile-display, block) !important; }
  }
  #shopify-section-{{ section.id }} .{{ p }} {
    box-sizing: border-box;
    width: 100%;
    background: var(--r7t-bg);
    color: var(--color-text);
    font-family: var(--r7t-body-font);
    padding-block: var(--r7t-pt-m) var(--r7t-pb-m);
  }
  #shopify-section-{{ section.id }} .{{ p }} *,
  #shopify-section-{{ section.id }} .{{ p }} *::before,
  #shopify-section-{{ section.id }} .{{ p }} *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .{{ p }} [hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .{{ p }}__inner {
    max-width: var(--r7t-max);
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .{{ p }} { padding-block: var(--r7t-pt-d) var(--r7t-pb-d); }
    #shopify-section-{{ section.id }} .{{ p }}__inner { padding-inline: var(--r7t-pad-wide); }
  }

  /* Header blocks */
  #shopify-section-{{ section.id }} .{{ p }}__header {
    display: flex;
    flex-direction: column;
    align-items: var(--r7t-items, flex-start);
    text-align: var(--r7t-align, start);
    gap: 14px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .{{ p }}__eyebrow {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: var(--subheading-weight, 500);
    color: var(--hb-c, var(--color-text));
  }
  #shopify-section-{{ section.id }} .{{ p }} .{{ p }}__heading {
    margin: 0;
    max-width: min(100%, 28em);
    font-family: var(--hb-ff, var(--r7t-heading-font));
    font-weight: var(--hb-fw, var(--heading-weight, 700));
    font-size: var(--hb-fs-m, calc(var(--heading-font-scale, 1) * var(--size, 3.2rem)));
    line-height: var(--hb-lh, var(--heading-line-height, 1.2));
    letter-spacing: var(--hb-ls, var(--heading-letter-spacing, normal));
    color: var(--hb-c, var(--color-heading));
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .{{ p }} .{{ p }}__heading { font-size: var(--hb-fs-d, calc(var(--heading-font-scale, 1) * var(--size, 3.6rem))); }
  }
  #shopify-section-{{ section.id }} .{{ p }}__subheading {
    max-width: 60ch;
    font-family: var(--hb-ff, var(--r7t-body-font));
    font-weight: var(--hb-fw, var(--body-weight, 400));
    font-size: var(--hb-fs, var(--body-font-size, 16px));
    line-height: var(--hb-lh, var(--body-line-height, 1.6));
    color: var(--hb-c, var(--color-text));
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .{{ p }}__subheading :is(p, li) { font-size: inherit; line-height: inherit; font-weight: inherit; color: inherit; }
  /* Bold words keep the theme's heading colour until the block or the section has a colour of its own. */
  #shopify-section-{{ section.id }} .{{ p }}__subheading :is(strong, b) { color: var(--hb-c, var(--color-heading)); }
  #shopify-section-{{ section.id }} .{{ p }}__text :is(strong, b) { color: var(--r7t-text-ink, var(--color-heading)); }
  #shopify-section-{{ section.id }} .{{ p }}__action { max-width: 100%; margin-top: 6px; }

  /* Rich text and the text link under it */
  #shopify-section-{{ section.id }} .{{ p }}__text {
    max-width: 68ch;
    font-size: var(--body-font-size, 16px);
    line-height: var(--body-line-height, 1.6);
    color: var(--r7t-text-ink, var(--color-text));
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .{{ p }}__text :is(p, li) { font-size: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .{{ p }} :is(.{{ p }}__text, .{{ p }}__subheading) > * { margin-block: 0; }
  #shopify-section-{{ section.id }} .{{ p }} :is(.{{ p }}__text, .{{ p }}__subheading) > * + * { margin-top: 0.75em; }
  #shopify-section-{{ section.id }} .{{ p }} :is(.{{ p }}__text, .{{ p }}__subheading) :is(ul, ol) { padding-inline-start: 1.25em; }
  #shopify-section-{{ section.id }} .{{ p }} :is(.{{ p }}__text, .{{ p }}__subheading) a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  #shopify-section-{{ section.id }} .{{ p }}__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    font-weight: var(--subheading-weight, 500);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ section.id }} .{{ p }}__link:not(:hover) { color: var(--r7t-link-ink, var(--color-link, var(--color-heading))); }
  #shopify-section-{{ section.id }} .{{ p }}__link[href]:hover { text-decoration-thickness: 2px; }
  #shopify-section-{{ section.id }} .{{ p }}__link[href]:active { opacity: 0.6; }
  #shopify-section-{{ section.id }} .{{ p }}__link:not([href]) { cursor: default; }
  #shopify-section-{{ section.id }} .{{ p }} a:focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 3px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .{{ p }}, #shopify-section-{{ section.id }} .{{ p }} * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
{% comment %}{% endcomment %}</style>
</template>
