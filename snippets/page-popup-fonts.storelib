<template compat="shopify">
{%- comment -%}
  Materia Themes. The custom font variables a page popup's root prints in its
  style attribute (Typography > Custom fonts on), the same values
  shopify/assets/live-page-popups.js writes live. Off, nothing.
  style="{% render 'page-popup-fonts', st: section.settings %}"
{%- endcomment -%}
{%- if st.enable_custom_fonts -%}
{%- if st.heading_font.family != blank %} --heading-font: {{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{% endif -%}
{%- if st.body_font.family != blank %} --body-font: {{ st.body_font.family }}, {{ st.body_font.fallback_families }}; --btn-font: {{ st.body_font.family }}, {{ st.body_font.fallback_families }};{% endif -%}
{%- endif -%}
</template>