<template compat="shopify">
{%- if item.product.has_only_default_variant == false -%}
  <details class="cart-page-variant-editor">
    <summary>{{ 'general.cart.edit' | t }}</summary>
    <cart-item-variant-switch data-cart-page
      data-line-key="{{ item.key | escape }}"
      data-current-variant="{{ item.variant.id }}"
      data-quantity="{{ item.quantity }}"
      data-properties="{{ item.properties | json | escape }}"
      data-selling-plan="{{ item.selling_plan_allocation.selling_plan.id }}">
      <script class="cart-item__variants-json" type="application/json">{{ item.product.variants | json }}</script>
      {%- for option in item.product.options_with_values -%}
        <div class="cart-item__variant-field" role="group" aria-label="{{ option.name | escape }}">
          <span>{{ option.name | escape }}</span>
          <select hidden tabindex="-1" aria-hidden="true" aria-label="{{ option.name | escape }}">
            {%- for value in option.values -%}
              <option value="{{ value | escape }}">{{ value | escape }}</option>
            {%- endfor -%}
          </select>
          <div class="cart-item__variant-choices">
            {%- assign option_index = forloop.index0 -%}
            {%- for value in option.values -%}
              <button type="button" class="cart-item__variant-choice" data-option-index="{{ option_index }}" data-option-value="{{ value | escape }}">{{ value | escape }}</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <button type="button" class="btn-primary relative" data-variant-save data-theme-button="primary">
        <span class="hidden-on-load">{{ 'general.cart.save' | t }}</span>
        <svg width="16" height="16" class="icon-load opacity-0" aria-hidden="true"></svg>
      </button>
      <p class="cart-item__variant-error" role="alert" hidden></p>
    </cart-item-variant-switch>
  </details>
{%- endif -%}
</template>
