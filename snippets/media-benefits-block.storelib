<template compat="shopify">
{%- comment -%}
  Materia Themes. A block's own attributes in the benefits Image and video
  sections, read by media-live-benefits.js for live edits.
{%- endcomment -%}
data-block-id="{{ block.id }}" data-mlb-block="{{ block.id }}" data-mlb-type="{{ block.type }}" data-mlb-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}
</template>
