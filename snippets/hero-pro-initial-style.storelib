<template compat="shopify">
{%- assign s = section.settings -%}{%- assign bg = section.blocks | where: 'type', 'background' | first -%}
--mk-brightness:{{ bg.settings.background_brightness | default: 0.5 }};
--mk-align-d:{{ s.elements_alignment_desktop | default: 'center' }};--mk-align-m:{{ s.elements_alignment_mobile | default: 'center' }};
--mk-ta-d:{% case s.elements_alignment_desktop %}{% when 'flex-start','left' %}left{% when 'flex-end','right' %}right{% else %}center{% endcase %};--mk-ta-m:{% case s.elements_alignment_mobile %}{% when 'flex-start','left' %}left{% when 'flex-end','right' %}right{% else %}center{% endcase %};
--mk-max:{% case s.section_width %}{% when 'container' %}calc(var(--page-width,1300px) + 3rem){% when 'fluid_container' %}calc(var(--fluid-container-width,1500px) + 3rem){% when 'stretch_width' %}calc(100% - 32px){% else %}none{% endcase %};--mk-content-width:{% if s.desktop_width == 0 %}none{% else %}{{ s.desktop_width | default: 500 }}px{% endif %};
--mk-height-vh-d:{{ s.background_height_desktop | default: 70 }};--mk-height-vh-m:{{ s.background_height_mobile | default: 55 }};
--mk-content-pt-d:{{ s.padding_top | default: 130 }}px;--mk-content-pb-d:{{ s.padding_bottom | default: 130 }}px;--mk-content-pl-d:{{ s.hero_content_padding_left_desktop | default: 100 }}px;--mk-content-pr-d:{{ s.hero_content_padding_right_desktop | default: 100 }}px;
--mk-content-pt-m:{{ s.padding_top_mobile | default: 30 }}px;--mk-content-pb-m:{{ s.padding_bottom_mobile | default: 20 }}px;--mk-content-pl-m:{{ s.hero_content_padding_left_mobile | default: 40 }}px;--mk-content-pr-m:{{ s.hero_content_padding_right_mobile | default: 40 }}px;
</template>
