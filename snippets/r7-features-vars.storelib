<template compat="shopify">
{%- comment -%}
  Materia Themes. Settings as CSS variables for Feature Timeline and
  Guarantee Banner. The sections print the same lists on their root in the
  builder (data-r7e-spec), so shopify/assets/live-r7-features.js writes
  exactly the same variables on a live edit.
    s       the settings (section.settings or block.settings)
    px      "id", "id:unit" ("n" = no unit) or "id:unit:switch" (printed only
            while s[switch] is on), comma separated
    c       colour ids, printed only when gate is true and the colour is set
    f       "switch:picker" pairs, printed when s[switch] is on and the
            picker has a family
    gate    the custom styling switch for the colours
  Variables are named --r7-<id>.
{%- endcomment -%}
{%- assign r7_l = px | split: ',' -%}
{%- for r7_k in r7_l -%}
  {%- assign r7_p = r7_k | strip | split: ':' -%}
  {%- assign r7_id = r7_p[0] -%}
  {%- assign r7_u = 'px' -%}
  {%- if r7_p.size > 1 -%}{%- assign r7_u = r7_p[1] -%}{%- endif -%}
  {%- if r7_u == 'n' -%}{%- assign r7_u = '' -%}{%- endif -%}
  {%- assign r7_on = true -%}
  {%- if r7_p.size > 2 -%}
    {%- assign r7_g = r7_p[2] -%}
    {%- unless s[r7_g] -%}{%- assign r7_on = false -%}{%- endunless -%}
  {%- endif -%}
  {%- if r7_on -%}
    {%- assign r7_v = s[r7_id] -%}
    {%- if r7_v == blank and r7_v != 0 -%}{%- assign r7_v = 0 -%}{%- endif -%}
    --r7-{{ r7_id }}:{{ r7_v }}{{ r7_u }};
  {%- endif -%}
{%- endfor -%}
{%- if gate -%}
  {%- assign r7_l = c | split: ',' -%}
  {%- for r7_k in r7_l -%}
    {%- assign r7_id = r7_k | strip -%}
    {%- assign r7_v = s[r7_id] -%}
    {%- if r7_v != blank and r7_v.alpha != 0 and r7_v != 'transparent' and r7_v != 'rgba(0,0,0,0)' and r7_v != 'rgba(0, 0, 0, 0)' and r7_v != '#00000000' -%}--r7-{{ r7_id }}:{{ r7_v }};{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign r7_l = f | split: ',' -%}
{%- for r7_k in r7_l -%}
  {%- assign r7_p = r7_k | strip | split: ':' -%}
  {%- assign r7_g = r7_p[0] -%}
  {%- assign r7_id = r7_p[1] -%}
  {%- assign r7_v = s[r7_id] -%}
  {%- if s[r7_g] and r7_v.family != blank -%}--r7-{{ r7_id }}:{{ r7_v.family }}, {{ r7_v.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endfor -%}
</template>
