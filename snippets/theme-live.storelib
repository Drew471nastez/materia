<template compat="shopify">
{%- comment -%}
  Materia Themes. Live preview of Theme settings in the builder. Every change
  is written as CSS variables on <html> (or one attribute on <body>) in a single
  animation frame; nothing is measured and no page style is rebuilt. Colour
  schemes and the colours picked for every field or button share one
  constructed sheet adopted after the page's own, rewritten only when one of
  them changes: a colour drag touches no element.
{%- endcomment -%}
{%- liquid
  assign live_field_bg = ''
  if settings.field_background != blank and settings.field_background.alpha != 0
    assign live_field_bg = settings.field_background
  endif
  assign live_field_text = ''
  if settings.field_text != blank and settings.field_text.alpha != 0
    assign live_field_text = settings.field_text
  endif
  assign live_hover_bg = ''
  if settings.storelib_button_hover_bg != blank and settings.storelib_button_hover_bg.alpha != 0 and settings.storelib_button_hover_bg != 'transparent' and settings.storelib_button_hover_bg != 'rgba(0,0,0,0)'
    assign live_hover_bg = settings.storelib_button_hover_bg
  endif
  assign live_hover_text = ''
  if settings.storelib_button_hover_text != blank and settings.storelib_button_hover_text.alpha != 0 and settings.storelib_button_hover_text != 'transparent' and settings.storelib_button_hover_text != 'rgba(0,0,0,0)'
    assign live_hover_text = settings.storelib_button_hover_text
  endif
  assign live_hover_border = ''
  if settings.storelib_button_hover_border != blank and settings.storelib_button_hover_border.alpha != 0 and settings.storelib_button_hover_border != 'transparent' and settings.storelib_button_hover_border != 'rgba(0,0,0,0)'
    assign live_hover_border = settings.storelib_button_hover_border
  endif
-%}
<style>
  /* While a setting is being changed, nothing eases: radius, widths, padding
     and colours follow the slider at once instead of trailing behind it. */
  html.sl-live-tweak *, html.sl-live-tweak *::before, html.sl-live-tweak *::after { transition: none !important; }
{% comment %}{% endcomment %}</style>
<script>
(function () {
  if (window.__materiaThemeLive) return;
  window.__materiaThemeLive = true;
  var root = document.documentElement;
  var frame = 0;
  var pending = {};
  var tweakTimer = 0;
  var liveSchemes = {};
  var releaseTimer = 0;
  /* Scheme ids in theme order: the first one is also the page's own (:root). */
  var SCHEME_IDS = [{% for scheme in settings.color_schemes %}{{ scheme.id | json }}{% unless forloop.last %},{% endunless %}{% endfor %}];
  SCHEME_IDS = SCHEME_IDS.filter(function (id) { return typeof id === 'string' && id; });
  var rtlHref = "{{ 'rtl.css' | asset_url }}";
  var state = {
    btn_shape: "{{ settings.btn_shape | default: 'rounded' }}",
    btn_radius: {{ settings.btn_radius | default: 8 | json }},
    enable_rounded: {{ settings.enable_rounded | json }},
    rounded_corner: {{ settings.rounded_corner | default: 0 | json }},
    input_radius: {{ settings.input_radius | default: 4 | json }},
    storelib_input_radius: {{ settings.storelib_input_radius | default: -1 | json }},
    field_background: "{{ live_field_bg }}",
    field_text: "{{ live_field_text }}",
    storelib_input_focus: "{{ settings.storelib_input_focus }}",
    storelib_link_hover: "{{ settings.storelib_link_hover }}",
    storelib_button_hover_bg: "{{ live_hover_bg }}",
    storelib_button_hover_text: "{{ live_hover_text }}",
    storelib_button_hover_border: "{{ live_hover_border }}",
    menu_font: "{{ settings.menu_font | default: 'body_font' }}",
    button_font: "{{ settings.button_font | default: 'heading_font' }}",
    font_body_system: {family: {{ settings.font_body_system.family | default: '' | json }}, fallback_families: {{ settings.font_body_system.fallback_families | default: '' | json }}},
    font_heading_system: {family: {{ settings.font_heading_system.family | default: '' | json }}, fallback_families: {{ settings.font_heading_system.fallback_families | default: '' | json }}},
    font_body_google_family: "{{ settings.font_body_google_family | default: 'none' }}",
    font_heading_google_family: "{{ settings.font_heading_google_family | default: 'none' }}",
    typography_preset: "{{ settings.typography_preset | default: 'none' }}",
    font_type_body: "{{ settings.font_type_body }}",
    font_type_heading: "{{ settings.font_type_heading }}",
    font_body_google: {{ settings.font_body_google | default: '' | json }},
    font_heading_google: {{ settings.font_heading_google | default: '' | json }},
    body_font_weight: {{ settings.body_font_weight | default: 400 | json }},
    heading_font_weight: {{ settings.heading_font_weight | default: 600 | json }},
    subheading_font_weight: {{ settings.subheading_font_weight | default: 500 | json }},
    btn_font_weight: {{ settings.btn_font_weight | default: '500' | json }},
    bubble_bg: "{{ settings.bubble_bg }}",
    bubble_text: "{{ settings.bubble_text }}",
    cart_bubble_custom: {{ settings.cart_bubble_custom | default: false | json }},
    cart_bubble_bg: "{{ settings.cart_bubble_bg }}",
    cart_bubble_color: "{{ settings.cart_bubble_color }}",
    wishlist_bubble_custom: {{ settings.wishlist_bubble_custom | default: false | json }},
    wishlist_bubble_bg: "{{ settings.wishlist_bubble_bg }}",
    wishlist_bubble_color: "{{ settings.wishlist_bubble_color }}"
  };
  var BUBBLE_KEYS = ['bubble_bg', 'bubble_text', 'cart_bubble_custom', 'cart_bubble_bg', 'cart_bubble_color', 'wishlist_bubble_custom', 'wishlist_bubble_bg', 'wishlist_bubble_color'];
  var BUBBLE_RADIUS = {circle: '999px', rounded: '5px', square: '0px'};
  var BUBBLE_ANIMATION = {pop: 'mt-count-pop', bounce: 'mt-count-bounce', none: 'none'};
  /* Menu hovers the header no longer draws; it shows these as underline. */
  var RETIRED_HOVERS = ['background', 'slide_up', 'glow', 'double_line', 'uppercase', 'scale', 'subtle_fade'];
  var BADGE_SHADOW = '0 2px 6px rgba(0,0,0,.18)';
  function yes(value) { return value === true || value === 'true'; }
  var SHEET_KEYS = ['field_background', 'field_text', 'storelib_input_focus', 'storelib_link_hover', 'storelib_button_hover_bg', 'storelib_button_hover_text', 'storelib_button_hover_border'];
  var SHADOWS = {
    soft: '0 2px 10px -2px rgba(0,0,0,0.06)',
    medium: '0 8px 22px -6px rgba(0,0,0,0.12)',
    large: '0 18px 40px -10px rgba(0,0,0,0.18)'
  };

  function has(s, k) { return Object.prototype.hasOwnProperty.call(s, k) && s[k] != null; }
  function px(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /px$|em$|rem$|%$/.test(text) ? text : text + 'px';
  }
  function ms(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /m?s$/.test(text) ? text : text + 'ms';
  }
  function colour(value) {
    if (value == null) return '';
    if (typeof value === 'object') value = value.hex || value.value || value.color || '';
    var text = String(value).trim();
    if (!text || text === 'transparent' || /^rgba\([^)]*,\s*0(\.0+)?\s*\)$/i.test(text) || /^#[0-9a-f]{6}00$/i.test(text)) return '';
    return text;
  }
  /* Only a value that changes is written: an unchanged one would still touch
     <html>'s style attribute and wake every observer of it. */
  function set(name, value) {
    var now = root.style.getPropertyValue(name);
    if (value == null || value === '') { if (now !== '') root.style.removeProperty(name); }
    else if (now !== String(value)) root.style.setProperty(name, value);
  }
  function cssName(value) {
    if (window.CSS && CSS.escape) return CSS.escape(String(value));
    return String(value).replace(/[^a-zA-Z0-9_-]/g, '\\$&');
  }
  /* Colour schemes, then the colours picked for every field or button, in
     ONE constructed sheet adopted after every other sheet on the page. A drag
     replaces its text once per frame: no element gets an inline style, no
     <style> node changes (so the page's MutationObservers stay quiet), and
     nothing is measured. Old browsers get one <style> at the end of <head>. */
  var colourSheet = null;
  var colourEl = null;
  var lastColourCss = null;
  function schemeCss() {
    var css = '';
    var first = SCHEME_IDS.length ? SCHEME_IDS[0] : null;
    Object.keys(liveSchemes).forEach(function (id) {
      var vars = liveSchemes[id];
      var declarations = Object.keys(vars).filter(function (key) { return vars[key] != null && vars[key] !== '' && !/[;{}<]/.test(String(vars[key])); })
        .map(function (key) { return key + ':' + vars[key] + '!important'; }).join(';');
      if (declarations) css += (id === first ? ':root,' : '') + '.color-' + cssName(id) + '{' + declarations + '}';
    });
    return css;
  }
  function writeColours() {
    var css = schemeCss() + overrideCss();
    if (css === lastColourCss) return;
    lastColourCss = css;
    if (colourSheet === null) {
      colourSheet = false;
      try { if ('adoptedStyleSheets' in document && typeof CSSStyleSheet === 'function') colourSheet = new CSSStyleSheet(); } catch (e) { colourSheet = false; }
    }
    if (colourSheet) {
      try {
        colourSheet.replaceSync(css);
        var list = document.adoptedStyleSheets;
        if (list.indexOf(colourSheet) < 0) document.adoptedStyleSheets = list.concat([colourSheet]);
        return;
      } catch (e) { colourSheet = false; }
    }
    if (!colourEl) {
      colourEl = document.createElement('style');
      colourEl.id = 'sl-live-colours';
      document.head.appendChild(colourEl);
    }
    colourEl.textContent = css;
  }
  function fontFamily(value) {
    if (!value) return '';
    /* A font picker handle (poppins_n4) is not a family name: keep the font
       on the page until the builder redraws it with the new font's files. */
    if (typeof value === 'string') return /^[a-z0-9_]+_[nio][1-9]$/.test(value) ? '' : value;
    var family = value.family || value.name || '';
    var fallbacks = value.fallback_families || value.fallbacks || '';
    return family ? '"' + String(family).replace(/"/g, '\\"') + '"' + (fallbacks ? ', ' + fallbacks : '') : '';
  }
  /* More fonts, the pairings and the font picker, resolved as font-variables
     does (More fonts, then a typed Google font, then the pairing, then the
     picker), from the same rows it prints in <meta name="materia-fonts">.
     A family from those rows is requested from Google Fonts at once, with
     the weights the settings use, so the canvas draws it without a reload. */
  var FONT_KEYS = ['font_body_system', 'font_heading_system', 'font_body_google_family', 'font_heading_google_family', 'typography_preset', 'font_type_body', 'font_type_heading', 'font_body_google', 'font_heading_google', 'body_font_weight', 'heading_font_weight', 'subheading_font_weight', 'btn_font_weight', 'menu_font', 'button_font'];
  var FONT_ROWS = {};
  var FONT_PAIRS = {};
  var STACKS = {
    s: 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
    d: 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
    f: 'Georgia, "Times New Roman", serif',
    m: 'ui-monospace, Menlo, Consolas, monospace',
    x: '"Helvetica Neue", Helvetica, Arial, sans-serif',
    y: 'Georgia, "Times New Roman", Times, serif'
  };
  (function readFontRows() {
    var meta = document.querySelector('meta[name="materia-fonts"]');
    if (!meta) return;
    String(meta.getAttribute('content') || '').split('|').forEach(function (row) {
      var cells = row.split(':');
      if (cells[0] && cells[1]) FONT_ROWS[cells[0]] = {name: cells[0], kind: cells[1], has: cells[2] || '4'};
    });
    String(meta.getAttribute('data-pairs') || '').split('|').forEach(function (row) {
      var cells = row.split(':');
      if (cells[0] && cells[1] && cells[2]) FONT_PAIRS[cells[0]] = {body: cells[1], heading: cells[2]};
    });
  })();
  function rowFont(name) {
    var row = FONT_ROWS[name];
    if (!row) return null;
    if (row.kind === 'x' || row.kind === 'y') return {css: STACKS[row.kind], row: null};
    return {css: '"' + row.name + '", ' + STACKS[row.kind], row: row};
  }
  function pickerFont(value) {
    if (!value) return null;
    var name = typeof value === 'string' ? '' : (value.family || value.name || '');
    if (typeof value === 'string') {
      /* A handle (lora_n4) names a family: find it among the rows. */
      var handle = value.replace(/_[nio][1-9]$/, '');
      for (var key in FONT_ROWS) if (key.toLowerCase().replace(/ /g, '_') === handle) { var found = rowFont(key); found.picker = true; return found; }
      return /^[a-z0-9_]+_[nio][1-9]$/.test(value) ? null : {css: fontFamily(value), row: null, picker: true};
    }
    if (!name) return null;
    return {css: fontFamily(value), row: FONT_ROWS[name] && FONT_ROWS[name].kind !== 'x' && FONT_ROWS[name].kind !== 'y' ? FONT_ROWS[name] : null, picker: true};
  }
  function roleFont(role) {
    var more = state['font_' + role + '_google_family'];
    if (more && more !== 'none' && FONT_ROWS[more]) return rowFont(more);
    var typed = state['font_' + role + '_google'];
    if (state['font_type_' + role] === 'google' && typed) {
      typed = String(typed).replace(/["';<>{}]/g, '').trim();
      return {css: '"' + typed + '"', row: FONT_ROWS[typed] || {name: typed, kind: 's', has: '', typed: true}};
    }
    var pair = FONT_PAIRS[state.typography_preset];
    if (pair && FONT_ROWS[pair[role]]) return rowFont(pair[role]);
    return pickerFont(state['font_' + role + '_system']);
  }
  function hundreds(value, fallback) {
    var n = Math.round(Number(value) / 100);
    return isFinite(n) && n > 0 ? n : fallback;
  }
  function snapWeights(row, wants) {
    var has = String(row.has || '4').split('').map(Number);
    var got = [];
    wants.forEach(function (w) {
      var best = has[0];
      /* A tie goes to the heavier weight, as in font-variables. */
      has.forEach(function (d) { if (Math.abs(d - w) <= Math.abs(best - w)) best = d; });
      if (got.indexOf(best) < 0) got.push(best);
    });
    return got.sort(function (a, b) { return a - b; }).map(function (d) { return d + '00'; }).join(';');
  }
  function fontQuery(body, heading) {
    var wBody = [hundreds(state.body_font_weight, 4), 7, hundreds(state.subheading_font_weight, 5)];
    var wHead = [hundreds(state.heading_font_weight, 6)];
    (state.button_font === 'body_font' ? wBody : wHead).push(hundreds(state.btn_font_weight, 5));
    (state.menu_font === 'heading_font' ? wHead : wBody).push(5);
    var parts = [];
    var same = body && heading && body.row && heading.row && body.row.name === heading.row.name;
    [[body, same ? wBody.concat(wHead) : wBody], [same ? null : heading, wHead]].forEach(function (pair) {
      var font = pair[0];
      if (!font || !font.row) return;
      var family = 'family=' + font.row.name.replace(/ /g, '+');
      parts.push(font.row.typed ? family : family + ':wght@' + snapWeights(font.row, pair[1]));
    });
    return parts.join('&');
  }
  function loadFonts(query) {
    if (!query) return;
    var href = 'https://fonts.googleapis.com/css2?' + query + '&display=swap';
    var links = document.querySelectorAll('link[data-materia-fonts]');
    for (var i = 0; i < links.length; i++) if (links[i].getAttribute('href') === href) return;
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = href;
    link.setAttribute('data-materia-fonts', '');
    document.head.appendChild(link);
  }
  /* A picker handle not among the rows keeps the font on the page until the
     builder redraws, unless what is on the page came from More fonts or a
     pairing that is no longer chosen: then the page's own font comes back. */
  var fontFromRows = {body: false, heading: false};
  function applyFonts() {
    var body = roleFont('body');
    var heading = roleFont('heading');
    [['body', body, '--body-font'], ['heading', heading, '--heading-font']].forEach(function (item) {
      if (item[1]) set(item[2], item[1].css);
      else if (fontFromRows[item[0]]) set(item[2], '');
      fontFromRows[item[0]] = !!(item[1] && !item[1].picker);
    });
    loadFonts(fontQuery(body, heading));
  }
  /* "r, g, b" of a hex colour, for the theme's rgba(var(--color-*-rgb), a) rules. */
  function rgb(value) {
    var text = colour(value).replace('#', '');
    if (text.length === 3 || text.length === 4) text = text.replace(/(.)/g, '$1$1');
    if (!/^[0-9a-f]{6}([0-9a-f]{2})?$/i.test(text)) return null;
    return [0, 2, 4].map(function (i) { return parseInt(text.substr(i, 2), 16); }).join(', ');
  }
  function schemeVars(s) {
    if (!s) return null;
    if (s.settings) s = s.settings;
    var bg = s.background;
    var text = s.text_color;
    var heading = s.heading_color;
    var accent = s.primary_color;
    var line = s.border_color;
    var bgRgb = rgb(bg);
    return {
      '--color-primary-rgb': rgb(accent),
      '--color-text-rgb': rgb(text),
      '--color-heading-rgb': rgb(heading),
      '--input-bg': colour(state.field_background) ? null : (bgRgb ? 'rgba(' + bgRgb + ', 0.6)' : null),
      '--color-background': bg,
      '--gradient-background': bg,
      '--color-text': text,
      '--color-heading': heading,
      '--color-primary': accent,
      '--color-border': line,
      '--badge-background': colour(s.badge_background) || s.btn_primary_background || accent,
      '--badge-text': colour(s.badge_text) || s.btn_primary_color || bg,
      '--color-link': heading,
      '--color-link-hover': accent,
      '--btn-primary-bg-color': s.btn_primary_background || accent,
      '--btn-primary-color': s.btn_primary_color || bg,
      '--btn-primary-hover-bg-color': s.btn_primary_hover_background || heading,
      '--btn-primary-hover-color': s.btn_primary_hover_color || bg,
      '--btn-primary-bg-graident-color': s.btn_primary_background || accent,
      '--btn-primary-hover-bg-color-graident': s.btn_primary_hover_background || heading,
      '--btn-primary-border-color': s.btn_primary_border_color || s.btn_primary_background || accent,
      '--btn-primary-hover-border-color': s.btn_primary_hover_border_color || s.btn_primary_hover_background || heading,
      '--btn-secondary-bg-color': s.btn_secondary_background || bg,
      '--btn-secondary-color': s.btn_secondary_color || heading,
      '--btn-secondary-border-color': s.btn_secondary_border || heading,
      '--btn-secondary-hover-bg-color': s.btn_secondary_hover_background || heading,
      '--btn-secondary-hover-color': s.btn_secondary_hover_color || bg,
      '--btn-secondary-hover-border-color': s.btn_secondary_hover_border_color || s.btn_secondary_hover_background || heading,
      '--btn-outline-color': heading,
      '--btn-outline-border-color': line,
      '--btn-link-color': heading,
      '--btn-link-hover-color': accent
    };
  }
  /* Colours picked for every field or every button, written over each colour
     scheme: they follow the scheme rules in the same sheet, so they win. */
  function overrideCss() {
    var all = ':root, body, [class*="color-"]';
    var css = '';
    var v = colour(state.field_background);
    if (v) css += all + '{--input-bg:' + v + ' !important}';
    v = colour(state.field_text);
    if (v) css += all + '{--input-color:' + v + ' !important;--field-text-override:' + v + ' !important}';
    else css += all + '{--field-text-override:initial !important}';
    v = colour(state.storelib_input_focus);
    css += all + '{--input-focus-color:' + (v || 'var(--color-primary)') + ' !important}';
    if (v) css += 'input:focus, textarea:focus, select:focus{outline:2px solid ' + v + ' !important;outline-offset:2px}';
    v = colour(state.storelib_link_hover);
    if (v) css += 'a:hover{color:' + v + '}';
    v = colour(state.storelib_button_hover_bg);
    if (v) css += all + '{--btn-primary-hover-bg-color:' + v + ' !important;--btn-primary-hover-bg-color-graident:' + v + ' !important;--btn-secondary-hover-bg-color:' + v + ' !important}';
    v = colour(state.storelib_button_hover_text);
    if (v) css += all + '{--btn-primary-hover-color:' + v + ' !important;--btn-secondary-hover-color:' + v + ' !important;--btn-link-hover-color:' + v + ' !important}';
    v = colour(state.storelib_button_hover_border);
    if (v) css += all + '{--btn-primary-hover-border-color:' + v + ' !important;--btn-secondary-hover-border-color:' + v + ' !important}';
    return css;
  }
  function setRtl(on) {
    root.setAttribute('dir', on ? 'rtl' : 'ltr');
    root.classList.toggle('rtl', on);
    if (document.body) document.body.classList.toggle('rtl', on);
    var links = document.querySelectorAll('link[href*="rtl.css"]');
    if (on && !links.length) {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = rtlHref;
      link.setAttribute('data-sl-live-rtl', '');
      document.head.appendChild(link);
    }
    for (var i = 0; i < links.length; i++) links[i].disabled = !on;
  }
  function bodyData(name, value) {
    if (document.body && value != null && value !== '' && document.body.getAttribute(name) !== String(value)) document.body.setAttribute(name, String(value));
  }

  function applySettings(s) {
    var k;
    for (k in s) if (Object.prototype.hasOwnProperty.call(s, k) && Object.prototype.hasOwnProperty.call(state, k)) state[k] = s[k];

    /* Type */
    if (FONT_KEYS.some(function (key) { return has(s, key); })) applyFonts();
    if (has(s, 'theme_font_priority')) root.setAttribute('data-font-priority', yes(s.theme_font_priority) ? 'on' : 'off');
    /* Use shared button size and shape: off is read by theme-controls and theme-button-contract.css. */
    if (has(s, 'theme_button_priority')) {
      if (yes(s.theme_button_priority)) root.removeAttribute('data-button-priority');
      else root.setAttribute('data-button-priority', 'off');
    }
    /* Logo width: the header's logo carries its widths inline (snippets/logo). */
    if (has(s, 'desktop_logo_width') || has(s, 'mobile_logo_width')) {
      var logos = document.querySelectorAll('.header__logo');
      for (var lg = 0; lg < logos.length; lg++) {
        if (has(s, 'desktop_logo_width')) logos[lg].style.setProperty('--header-logo-width', px(s.desktop_logo_width));
        if (has(s, 'mobile_logo_width')) logos[lg].style.setProperty('--header-logo-width-mobile', px(s.mobile_logo_width));
      }
    }
    if (has(s, 'body_font_size')) set('--body-font-size', px(s.body_font_size));
    if (has(s, 'body_line_height')) set('--body-line-height', String(s.body_line_height));
    if (has(s, 'body_font_weight')) { set('--body-weight', String(s.body_font_weight)); set('--medium-font-weight', String(s.body_font_weight)); }
    if (has(s, 'heading_font_scale')) set('--heading-font-scale', String(Number(s.heading_font_scale) / 100));
    if (has(s, 'heading_line_height')) set('--heading-line-height', String(s.heading_line_height));
    if (has(s, 'heading_font_weight')) set('--heading-weight', String(s.heading_font_weight));
    if (has(s, 'subheading_font_weight')) set('--subheading-weight', String(s.subheading_font_weight));
    if (has(s, 'heading_text_transform')) set('--heading-text-transform', String(s.heading_text_transform));
    if (has(s, 'heading_letter_spacing')) set('--heading-letter-spacing', s.heading_letter_spacing === 'negative' ? '-0.034em' : String(s.heading_letter_spacing));
    if (has(s, 'menu_font')) set('--menu-font', state.menu_font === 'body_font' ? 'var(--body-font)' : 'var(--heading-font)');
    if (has(s, 'button_font')) set('--btn-font', state.button_font === 'body_font' ? 'var(--body-font)' : 'var(--heading-font)');
    if (has(s, 'menu_hover_style')) {
      var hover = RETIRED_HOVERS.indexOf(String(s.menu_hover_style)) > -1 ? 'underline' : String(s.menu_hover_style);
      bodyData('data-menu-hover', hover);
      var headers = document.querySelectorAll('header[data-menu-hover-theme]');
      for (var h = 0; h < headers.length; h++) headers[h].setAttribute('data-menu-hover', hover);
    }

    /* Layout & spacing. Phone and desktop values have their own variables,
       read by the breakpoints in layout/theme, so one never hides the other. */
    if (has(s, 'page_width')) {
      set('--page-width', px(s.page_width));
      set('--theme-page-width', px(s.page_width));
    }
    if (has(s, 'fluid_container_width')) {
      set('--fluid-container-width', px(s.fluid_container_width));
    }
    if (has(s, 'container_gutter')) set('--container-gutter', px(s.container_gutter));
    if (has(s, 'space_mobile')) set('--sl-live-space-mobile', px(s.space_mobile));
    if (has(s, 'spacing_desktop')) set('--sl-live-space-desktop', px(s.spacing_desktop));
    if (has(s, 'grid_gap_mobile')) set('--sl-live-grid-gap-mobile', px(s.grid_gap_mobile));
    if (has(s, 'grid_gap_desktop')) set('--sl-live-grid-gap-desktop', px(s.grid_gap_desktop));
    if (has(s, 'enable_rounded') || has(s, 'rounded_corner')) {
      var on = state.enable_rounded !== false && state.enable_rounded !== 'false';
      set('--rounded-radius', on ? px(state.rounded_corner || 0) : '0px');
      if (document.body) document.body.classList.toggle('rounded-style', on && Number(state.rounded_corner) > 1);
    }
    if (has(s, 'card_radius')) set('--card-radius', px(s.card_radius));
    if (has(s, 'pill_radius')) set('--pill-radius', px(s.pill_radius));
    if (has(s, 'card_shadow')) set('--card-shadow', SHADOWS[s.card_shadow] || 'none');
    if (has(s, 'border_width')) set('--border-width', px(s.border_width));
    if (has(s, 'divider_style')) set('--divider-style', String(s.divider_style));
    if (has(s, 'rtl')) setRtl(s.rtl === true || s.rtl === 'true');

    /* Buttons */
    if (has(s, 'btn_shape') || has(s, 'btn_radius')) {
      var radius = state.btn_shape === 'pill' ? 999 : state.btn_shape === 'square' ? 0 : state.btn_radius;
      set('--btn-radius', px(radius));
      set('--theme-button-radius', px(radius));
      bodyData('data-btn-shape', state.btn_shape);
    }
    if (has(s, 'btn_font_size')) set('--btn-font-size', px(s.btn_font_size));
    if (has(s, 'btn_padding_y')) { set('--btn-padding-y', px(s.btn_padding_y)); set('--theme-button-padding-y', px(s.btn_padding_y)); }
    if (has(s, 'btn_padding_x')) { set('--btn-padding-x', px(s.btn_padding_x)); set('--theme-button-padding-x', px(s.btn_padding_x)); }
    if (has(s, 'btn_font_weight')) set('--btn-font-weight', String(s.btn_font_weight));
    if (has(s, 'btn_border_width')) set('--btn-border-width', px(s.btn_border_width));
    if (has(s, 'btn_letter_spacing')) set('--btn-letter-spacing', px(s.btn_letter_spacing));
    if (has(s, 'btn_text_transform')) set('--btn-text-transform', String(s.btn_text_transform));
    if (has(s, 'btn_anim_duration')) set('--btn-anim-duration', ms(s.btn_anim_duration));
    if (has(s, 'btn_anim_ease')) set('--btn-anim-ease', String(s.btn_anim_ease));
    if (has(s, 'btn_shadow_enabled')) set('--btn-shadow', (s.btn_shadow_enabled === true || s.btn_shadow_enabled === 'true') ? '0 4px 14px -4px rgba(0, 0, 0, 0.18)' : 'none');
    if (has(s, 'btn_hover_effect')) bodyData('data-btn-hover', s.btn_hover_effect);
    if (has(s, 'btn_style')) bodyData('data-btn-style', s.btn_style);
    if (has(s, 'btn_secondary_style')) bodyData('data-btn-secondary-style', s.btn_secondary_style);
    if (has(s, 'storelib_button_hover_effect')) bodyData('data-sl-btn-hover', s.storelib_button_hover_effect);
    if (has(s, 'icon_btn_size')) set('--icon-btn-size', px(s.icon_btn_size));

    /* Product badges */
    if (has(s, 'badges_rounded_corner')) set('--bages-radius', px(s.badges_rounded_corner));
    if (has(s, 'badges_font_weight')) set('--badges-font-weight', String(s.badges_font_weight));
    if (has(s, 'badges_letter_spacing')) set('--badges-letter-spacing', px(s.badges_letter_spacing));
    if (has(s, 'badges_uppercase')) set('--badges-transform', s.badges_uppercase === false || s.badges_uppercase === 'false' ? 'none' : 'uppercase');
    if (has(s, 'badges_stack_max')) {
      /* product-card.css hides badges past data-max on each badge stack. */
      var stacks = document.querySelectorAll('.product__badges[data-max]');
      for (var bs = 0; bs < stacks.length; bs++) stacks[bs].setAttribute('data-max', String(s.badges_stack_max));
    }
    if (has(s, 'sale_label')) {
      var saleText = String(s.sale_label || '').trim();
      if (saleText) {
        if (window.variantStrings) window.variantStrings.sale = saleText;
        var sales = document.querySelectorAll('.product__badges-sale:not(.product__badges-type-price):not(.product__badges-type-percent)');
        for (var sb = 0; sb < sales.length; sb++) sales[sb].textContent = saleText;
      }
    }
    if (has(s, 'badges_padding_x')) set('--badges-padding-x', px(s.badges_padding_x));
    if (has(s, 'badges_padding_y')) set('--badges-padding-y', px(s.badges_padding_y));
    if (has(s, 'badges_offset_x')) set('--badges-offset-x', px(s.badges_offset_x));
    if (has(s, 'badges_offset_y')) set('--badges-offset-y', px(s.badges_offset_y));
    if (has(s, 'badges_gap')) set('--badges-gap', px(s.badges_gap));
    if (has(s, 'badges_drop_shadow')) set('--badges-shadow', yes(s.badges_drop_shadow) ? BADGE_SHADOW : 'none');
    [['sale_color', '--bages-sale-color'], ['sale_background', '--bages-sale-bg-color'],
     ['new_color', '--bages-new-color'], ['new_background', '--bages-new-bg-color'],
     ['pre_order_color', '--bages-pre-order-color'], ['pre_order_background', '--bages-pre-order-bg-color'],
     ['sold_out_color', '--bages-sold-out-color'], ['sold_out_background', '--bages-sold-out-bg-color'],
     ['custom_badge_color', '--bages-custom-color'], ['custom_badge_background', '--bages-custom-bg-color']].forEach(function (pair) {
      if (Object.prototype.hasOwnProperty.call(s, pair[0])) set(pair[1], colour(s[pair[0]]) || (pair[0].endsWith('background') ? 'var(--badge-background)' : 'var(--badge-text)'));
    });
    if (has(s, 'badges_shape')) bodyData('data-badge-shape', s.badges_shape);
    if (has(s, 'badges_size')) bodyData('data-badge-size', s.badges_size);
    if (has(s, 'badges_position')) bodyData('data-badge-position', s.badges_position);
    if (has(s, 'badges_animation')) bodyData('data-badge-anim', s.badges_animation);
    if (has(s, 'scroll_animation')) bodyData('data-scroll-animation', s.scroll_animation);

    /* Count bubbles (header, sticky header, mobile navigation bar). The
       cart and the wishlist use their own colours only while their custom
       style is on; an empty colour follows the default, then the scheme. */
    if (BUBBLE_KEYS.some(function (key) { return Object.prototype.hasOwnProperty.call(s, key); })) {
      var bubbleBg = colour(state.bubble_bg), bubbleText = colour(state.bubble_text);
      var cartOwn = yes(state.cart_bubble_custom), wishOwn = yes(state.wishlist_bubble_custom);
      set('--count-bubble-bg', (cartOwn && colour(state.cart_bubble_bg)) || bubbleBg || 'var(--color-primary)');
      set('--count-bubble-color', (cartOwn && colour(state.cart_bubble_color)) || bubbleText || 'var(--color-white, #fff)');
      set('--count-bubble-wishlist-bg', (wishOwn && colour(state.wishlist_bubble_bg)) || bubbleBg || 'var(--color-primary)');
      set('--count-bubble-wishlist-color', (wishOwn && colour(state.wishlist_bubble_color)) || bubbleText || 'var(--color-white, #fff)');
    }
    if (has(s, 'bubble_size')) set('--count-bubble-size', px(s.bubble_size));
    if (has(s, 'bubble_font_size')) set('--count-bubble-font-size', px(s.bubble_font_size));
    if (has(s, 'bubble_font_weight')) set('--count-bubble-font-weight', String(s.bubble_font_weight));
    if (has(s, 'bubble_border_width')) set('--count-bubble-border-width', px(s.bubble_border_width));
    if (Object.prototype.hasOwnProperty.call(s, 'bubble_border_color')) set('--count-bubble-border-color', colour(s.bubble_border_color) || 'var(--color-background, #fff)');
    if (has(s, 'bubble_offset_x')) set('--count-bubble-offset-x', px(s.bubble_offset_x));
    if (has(s, 'bubble_offset_y')) set('--count-bubble-offset-y', px(s.bubble_offset_y));
    if (has(s, 'bubble_shape')) set('--count-bubble-radius', BUBBLE_RADIUS[s.bubble_shape] || '999px');
    if (has(s, 'bubble_animation')) set('--count-bubble-animation', BUBBLE_ANIMATION[s.bubble_animation] || 'mt-count-pop');

    /* Motion */
    if (has(s, 'animation_duration')) set('--animation-duration', ms(s.animation_duration));
    if (has(s, 'animation_delay')) set('--animation-delay-base', ms(s.animation_delay));

    /* Forms and fields */
    if (has(s, 'field_height')) set('--input-height', px(s.field_height));
    if (has(s, 'field_padding_x')) set('--input-padding', '1rem ' + px(s.field_padding_x));
    if (has(s, 'field_border_width')) set('--inputs-border-width', px(s.field_border_width));
    if (has(s, 'input_radius') || has(s, 'storelib_input_radius')) {
      var own = Number(state.storelib_input_radius);
      set('--input-border-radius', px(isFinite(own) && own >= 0 ? own : state.input_radius));
    }
    if (has(s, 'search_input_radius')) set('--search-input-radius', px(s.search_input_radius));
    // Legacy field typography settings stay saved, but typography now has one
    // source: the theme's body text. CSS aliases update with it automatically.
    if (Object.prototype.hasOwnProperty.call(s, 'storelib_input_border')) set('--input-border-color', colour(s.storelib_input_border));
    var colours = false;
    for (var i = 0; i < SHEET_KEYS.length; i++) {
      if (Object.prototype.hasOwnProperty.call(s, SHEET_KEYS[i])) { colours = true; break; }
    }

    /* Colour schemes */
    var schemes = s.color_schemes;
    if (schemes && typeof schemes === 'object') {
      var ids = Object.keys(schemes);
      if (!SCHEME_IDS.length && ids.length) SCHEME_IDS = [ids[0]];
      for (var n = 0; n < ids.length; n++) {
        var varsForScheme = schemeVars(schemes[ids[n]]);
        if (!varsForScheme) continue;
        liveSchemes[ids[n]] = varsForScheme;
        colours = true;
      }
    }
    if (colours) writeColours();
    return colours;
  }

  /* Once a colour is let go (or picked in one go), what reads painted colours
     (the cart drawer's readable-text check) looks once. Never during a drag. */
  function afterRelease() {
    clearTimeout(releaseTimer);
    releaseTimer = setTimeout(function () {
      document.dispatchEvent(new CustomEvent('materia:cart-drawer-updated'));
    }, 180);
  }

  document.addEventListener('storelib:settings-change', function (event) {
    var detail = event.detail || {};
    // A section's own settings are not global typography, spacing or colours.
    if (detail.section) return;
    var changed = detail.settings || detail;
    if (!changed || typeof changed !== 'object') return;
    var live = detail.live === true;
    for (var key in changed) if (Object.prototype.hasOwnProperty.call(changed, key)) pending[key] = changed[key];
    if (live) clearTimeout(releaseTimer);
    else pending.__release = true;
    if (!root.classList.contains('sl-live-tweak')) root.classList.add('sl-live-tweak');
    clearTimeout(tweakTimer);
    if (detail.live === true) tweakTimer = setTimeout(function () { root.classList.remove('sl-live-tweak'); }, 400);
    else root.classList.remove('sl-live-tweak');
    if (frame) return;
    frame = requestAnimationFrame(function () {
      frame = 0;
      var next = pending;
      pending = {};
      var release = next.__release;
      delete next.__release;
      if (applySettings(next) && release) afterRelease();
      /* materia-experience re-reads the buttons only when the settings in
         detail touch them, so a colour drag makes no one walk every button. */
      document.dispatchEvent(new CustomEvent('materia:theme-applied', {detail: {settings: next}}));
    });
  });
})();
{% comment %}{% endcomment %}</script>
</template>
