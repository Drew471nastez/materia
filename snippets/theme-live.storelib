<template compat="shopify">
<script>
(function () {
  var root = document.documentElement;
  function px(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /px$|em$|rem$|%$/.test(text) ? text : text + 'px';
  }
  function paint(el, vars) {
    if (!el) return;
    Object.keys(vars).forEach(function (key) {
      if (vars[key] != null && vars[key] !== '') el.style.setProperty(key, vars[key]);
    });
  }
  function schemeVars(s) {
    if (!s) return null;
    if (s.settings) s = s.settings;
    var bg = s.background;
    var text = s.text_color;
    var heading = s.heading_color;
    var accent = s.primary_color;
    var line = s.border_color;
    var primaryBg = s.btn_primary_background || accent;
    var primaryText = s.btn_primary_color || bg;
    var primaryHoverBg = s.btn_primary_hover_background || heading;
    var primaryHoverText = s.btn_primary_hover_color || bg;
    var secondaryBg = s.btn_secondary_background || bg;
    var secondaryText = s.btn_secondary_color || heading;
    var secondaryBorder = s.btn_secondary_border || heading;
    var secondaryHoverBg = s.btn_secondary_hover_background || heading;
    var secondaryHoverText = s.btn_secondary_hover_color || bg;
    return {
      '--color-background': bg,
      '--gradient-background': bg,
      '--color-text': text,
      '--color-heading': heading,
      '--color-primary': accent,
      '--color-border': line,
      '--color-link': heading,
      '--color-link-hover': accent,
      '--btn-primary-bg-color': primaryBg,
      '--btn-primary-color': primaryText,
      '--btn-primary-hover-bg-color': primaryHoverBg,
      '--btn-primary-hover-color': primaryHoverText,
      '--btn-primary-bg-graident-color': primaryBg,
      '--btn-primary-hover-bg-color-graident': primaryHoverBg,
      '--btn-primary-border-color': primaryBg,
      '--btn-primary-hover-border-color': primaryHoverBg,
      '--btn-secondary-bg-color': secondaryBg,
      '--btn-secondary-color': secondaryText,
      '--btn-secondary-border-color': secondaryBorder,
      '--btn-secondary-hover-bg-color': secondaryHoverBg,
      '--btn-secondary-hover-color': secondaryHoverText,
      '--btn-secondary-hover-border-color': secondaryHoverBg,
      '--btn-outline-color': heading,
      '--btn-outline-border-color': line,
      '--btn-link-color': heading,
      '--btn-link-hover-color': accent
    };
  }
  function applyScheme(id, value, index) {
    var vars = schemeVars(value);
    if (!vars) return;
    document.querySelectorAll('.color-' + id).forEach(function (el) { paint(el, vars); });
    if (index === 0 || id === 'default') paint(root, vars);
  }
  function applySettings(settings) {
    if (!settings) return;
    var radius = settings.btn_radius;
    if (settings.btn_shape === 'pill') radius = 999;
    else if (settings.btn_shape === 'square') radius = 0;
    var track = settings.heading_letter_spacing;
    if (track === 'negative') track = '-0.034em';
    var vars = {};
    if (settings.body_font_size != null) vars['--body-font-size'] = px(settings.body_font_size);
    if (settings.body_line_height != null) vars['--body-line-height'] = String(settings.body_line_height);
    if (settings.body_font_weight != null) vars['--body-weight'] = String(settings.body_font_weight);
    if (settings.heading_font_scale != null) vars['--heading-font-scale'] = String(Number(settings.heading_font_scale) / 100);
    if (settings.heading_line_height != null) vars['--heading-line-height'] = String(settings.heading_line_height);
    if (settings.heading_font_weight != null) vars['--heading-weight'] = String(settings.heading_font_weight);
    if (settings.subheading_font_weight != null) vars['--subheading-weight'] = String(settings.subheading_font_weight);
    if (settings.heading_text_transform != null) vars['--heading-text-transform'] = String(settings.heading_text_transform);
    if (track != null) vars['--heading-letter-spacing'] = String(track);
    if (settings.page_width != null) {
      vars['--page-width'] = px(settings.page_width);
      vars['--page-width-value'] = String(settings.page_width);
    }
    if (settings.fluid_container_width != null) {
      vars['--fluid-container-width'] = px(settings.fluid_container_width);
      vars['--fluid-container-width-value'] = String(settings.fluid_container_width);
    }
    if (settings.space_mobile != null) vars['--section-spacing'] = px(settings.space_mobile);
    if (settings.container_gutter != null) vars['--container-gutter'] = px(settings.container_gutter);
    if (settings.btn_font_size != null) vars['--btn-font-size'] = px(settings.btn_font_size);
    if (settings.btn_padding_y != null) vars['--btn-padding-y'] = px(settings.btn_padding_y);
    if (settings.btn_padding_x != null) vars['--btn-padding-x'] = px(settings.btn_padding_x);
    if (settings.btn_font_weight != null) vars['--btn-font-weight'] = String(settings.btn_font_weight);
    if (settings.btn_border_width != null) vars['--btn-border-width'] = px(settings.btn_border_width);
    if (settings.btn_letter_spacing != null) vars['--btn-letter-spacing'] = px(settings.btn_letter_spacing);
    if (radius != null) vars['--btn-radius'] = px(radius);
    if (settings.input_radius != null) vars['--input-border-radius'] = px(settings.input_radius);
    if (settings.card_radius != null) vars['--card-radius'] = px(settings.card_radius);
    paint(root, vars);
    var schemes = settings.color_schemes;
    if (schemes && typeof schemes === 'object') {
      var index = 0;
      Object.keys(schemes).forEach(function (id) {
        applyScheme(id, schemes[id], index);
        index += 1;
      });
    }
  }
  document.addEventListener('storelib:settings-change', function (event) {
    var detail = event.detail || {};
    applySettings(detail.settings || detail);
  });

  /* Opening a block's settings was landing at the bottom of that panel.
     Scroll anchoring does that when the panel grows as controls connect.
     Keep the settings column anchored to the top when a block is opened. */
  function calm(doc) {
    if (!doc || !doc.head || doc.getElementById('sl-editor-calm')) return;
    var style = doc.createElement('style');
    style.id = 'sl-editor-calm';
    style.textContent = 'aside, [class*="sidebar"], [class*="Sidebar"], [class*="settings"], [class*="Settings"] { overflow-anchor: none; }';
    doc.head.appendChild(style);
  }
  calm(document);
  var parentDoc = null;
  try { if (window.parent && window.parent !== window) parentDoc = window.parent.document; } catch (error) { parentDoc = null; }
  calm(parentDoc);
  document.addEventListener('shopify:block:select', function () {
    if (!parentDoc) return;
    var nodes = parentDoc.querySelectorAll('aside, [class*="sidebar"], [class*="Sidebar"], [class*="settings"], [class*="Settings"]');
    nodes.forEach(function (node) {
      var scroller = node.scrollHeight > node.clientHeight + 24 ? node : null;
      if (!scroller) {
        var inner = node.querySelector('[class*="scroll"], [style*="overflow"]');
        if (inner && inner.scrollHeight > inner.clientHeight + 24) scroller = inner;
      }
      if (!scroller || scroller.scrollTop < 80) return;
      if (scroller.getBoundingClientRect().width > 480) return;
      scroller.scrollTop = 0;
    });
  });
})();
{% comment %}{% endcomment %}</script>
</template>
