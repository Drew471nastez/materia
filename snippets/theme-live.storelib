<template compat="shopify">
{%- comment -%}
  Materia Themes. Live preview of Theme settings in the builder. Every change
  is written as CSS variables on <html> (or one attribute on <body>) in a single
  animation frame; nothing is measured and no page style is rebuilt. Colours
  that have to win over each colour scheme go in one small sheet, rewritten
  only when one of those colours changes.
{%- endcomment -%}
{%- liquid
  assign live_field_bg = ''
  if settings.field_background != blank and settings.field_background.alpha != 0
    assign live_field_bg = settings.field_background
  endif
  assign live_field_text = ''
  if settings.field_text != blank and settings.field_text.alpha != 0
    assign live_field_text = settings.field_text
  endif
  assign live_hover_bg = ''
  if settings.storelib_button_hover_bg != blank and settings.storelib_button_hover_bg.alpha != 0
    assign live_hover_bg = settings.storelib_button_hover_bg
  endif
  assign live_hover_text = ''
  if settings.storelib_button_hover_text != blank and settings.storelib_button_hover_text.alpha != 0
    assign live_hover_text = settings.storelib_button_hover_text
  endif
  assign live_hover_border = ''
  if settings.storelib_button_hover_border != blank and settings.storelib_button_hover_border.alpha != 0
    assign live_hover_border = settings.storelib_button_hover_border
  endif
-%}
<style>
  /* While a setting is being changed, nothing eases: radius, widths, padding
     and colours follow the slider at once instead of trailing behind it. */
  html.sl-live-tweak *, html.sl-live-tweak *::before, html.sl-live-tweak *::after { transition: none !important; }
{% comment %}{% endcomment %}</style>
<script>
(function () {
  if (window.__materiaThemeLive) return;
  window.__materiaThemeLive = true;
  var root = document.documentElement;
  var frame = 0;
  var pending = {};
  var tweakTimer = 0;
  var liveSchemes = {};
  var rtlHref = "{{ 'rtl.css' | asset_url }}";
  var state = {
    btn_shape: "{{ settings.btn_shape | default: 'rounded' }}",
    btn_radius: {{ settings.btn_radius | default: 8 | json }},
    enable_rounded: {{ settings.enable_rounded | json }},
    rounded_corner: {{ settings.rounded_corner | default: 0 | json }},
    input_radius: {{ settings.input_radius | default: 4 | json }},
    storelib_input_radius: {{ settings.storelib_input_radius | default: -1 | json }},
    field_background: "{{ live_field_bg }}",
    field_text: "{{ live_field_text }}",
    storelib_input_focus: "{{ settings.storelib_input_focus }}",
    storelib_button_hover_bg: "{{ live_hover_bg }}",
    storelib_button_hover_text: "{{ live_hover_text }}",
    storelib_button_hover_border: "{{ live_hover_border }}"
  };
  var SHEET_KEYS = ['field_background', 'field_text', 'storelib_input_focus', 'storelib_button_hover_bg', 'storelib_button_hover_text', 'storelib_button_hover_border'];
  var SHADOWS = {
    soft: '0 2px 10px -2px rgba(0,0,0,0.06)',
    medium: '0 8px 22px -6px rgba(0,0,0,0.12)',
    large: '0 18px 40px -10px rgba(0,0,0,0.18)'
  };

  function has(s, k) { return Object.prototype.hasOwnProperty.call(s, k) && s[k] != null; }
  function px(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /px$|em$|rem$|%$/.test(text) ? text : text + 'px';
  }
  function ms(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /m?s$/.test(text) ? text : text + 'ms';
  }
  function colour(value) {
    if (value == null) return '';
    if (typeof value === 'object') value = value.hex || value.value || value.color || '';
    var text = String(value).trim();
    if (!text || text === 'transparent' || /^rgba\([^)]*,\s*0(\.0+)?\s*\)$/i.test(text) || /^#[0-9a-f]{6}00$/i.test(text)) return '';
    return text;
  }
  function set(name, value) {
    if (value == null || value === '') root.style.removeProperty(name);
    else root.style.setProperty(name, value);
  }
  function cssName(value) {
    if (window.CSS && CSS.escape) return CSS.escape(String(value));
    return String(value).replace(/[^a-zA-Z0-9_-]/g, '\\$&');
  }
  function schemeSheet() {
    var sheet = document.getElementById('sl-live-schemes');
    if (!sheet) {
      sheet = document.createElement('style');
      sheet.id = 'sl-live-schemes';
      document.head.appendChild(sheet);
    }
    var css = '';
    Object.keys(liveSchemes).forEach(function (id) {
      var vars = liveSchemes[id];
      var declarations = Object.keys(vars).filter(function (key) { return vars[key] != null && vars[key] !== ''; })
        .map(function (key) { return key + ':' + vars[key] + '!important'; }).join(';');
      if (declarations) css += '.color-' + cssName(id) + '{' + declarations + '}';
    });
    if (sheet.textContent !== css) sheet.textContent = css;
  }
  function fontFamily(value) {
    if (!value) return '';
    if (typeof value === 'string') return value;
    var family = value.family || value.name || '';
    var fallbacks = value.fallback_families || value.fallbacks || '';
    return family ? '"' + String(family).replace(/"/g, '\\"') + '"' + (fallbacks ? ', ' + fallbacks : '') : '';
  }
  function schemeVars(s) {
    if (!s) return null;
    if (s.settings) s = s.settings;
    var bg = s.background;
    var text = s.text_color;
    var heading = s.heading_color;
    var accent = s.primary_color;
    var line = s.border_color;
    return {
      '--color-background': bg,
      '--gradient-background': bg,
      '--color-text': text,
      '--color-heading': heading,
      '--color-primary': accent,
      '--color-border': line,
      '--color-link': heading,
      '--color-link-hover': accent,
      '--btn-primary-bg-color': s.btn_primary_background || accent,
      '--btn-primary-color': s.btn_primary_color || bg,
      '--btn-primary-hover-bg-color': s.btn_primary_hover_background || heading,
      '--btn-primary-hover-color': s.btn_primary_hover_color || bg,
      '--btn-primary-bg-graident-color': s.btn_primary_background || accent,
      '--btn-primary-hover-bg-color-graident': s.btn_primary_hover_background || heading,
      '--btn-primary-border-color': s.btn_primary_background || accent,
      '--btn-primary-hover-border-color': s.btn_primary_hover_background || heading,
      '--btn-secondary-bg-color': s.btn_secondary_background || bg,
      '--btn-secondary-color': s.btn_secondary_color || heading,
      '--btn-secondary-border-color': s.btn_secondary_border || heading,
      '--btn-secondary-hover-bg-color': s.btn_secondary_hover_background || heading,
      '--btn-secondary-hover-color': s.btn_secondary_hover_color || bg,
      '--btn-secondary-hover-border-color': s.btn_secondary_hover_background || heading,
      '--btn-outline-color': heading,
      '--btn-outline-border-color': line,
      '--btn-link-color': heading,
      '--btn-link-hover-color': accent
    };
  }
  /* Colours picked for every field or every button are written over each
     colour scheme, so they live in a sheet (important, to beat the scheme
     values this script paints inline). */
  function overrideSheet() {
    var sheet = document.getElementById('sl-live-overrides');
    if (!sheet) {
      sheet = document.createElement('style');
      sheet.id = 'sl-live-overrides';
      document.head.appendChild(sheet);
    }
    var all = ':root, body, [class*="color-"]';
    var css = '';
    var v = colour(state.field_background);
    if (v) css += all + '{--input-bg:' + v + ' !important}';
    v = colour(state.field_text);
    if (v) css += all + '{--input-color:' + v + ' !important}';
    v = colour(state.storelib_input_focus);
    if (v) css += 'input:focus, textarea:focus, select:focus{outline:2px solid ' + v + ' !important;outline-offset:2px}';
    v = colour(state.storelib_button_hover_bg);
    if (v) css += all + '{--btn-primary-hover-bg-color:' + v + ' !important;--btn-primary-hover-bg-color-graident:' + v + ' !important;--btn-secondary-hover-bg-color:' + v + ' !important}';
    v = colour(state.storelib_button_hover_text);
    if (v) css += all + '{--btn-primary-hover-color:' + v + ' !important;--btn-secondary-hover-color:' + v + ' !important;--btn-link-hover-color:' + v + ' !important}';
    v = colour(state.storelib_button_hover_border);
    if (v) css += all + '{--btn-primary-hover-border-color:' + v + ' !important;--btn-secondary-hover-border-color:' + v + ' !important}';
    if (sheet.textContent !== css) sheet.textContent = css;
  }
  function setRtl(on) {
    root.setAttribute('dir', on ? 'rtl' : 'ltr');
    root.classList.toggle('rtl', on);
    if (document.body) document.body.classList.toggle('rtl', on);
    var links = document.querySelectorAll('link[href*="rtl.css"]');
    if (on && !links.length) {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = rtlHref;
      link.setAttribute('data-sl-live-rtl', '');
      document.head.appendChild(link);
    }
    for (var i = 0; i < links.length; i++) links[i].disabled = !on;
  }
  function bodyData(name, value) {
    if (document.body && value != null && value !== '') document.body.setAttribute(name, String(value));
  }

  function applySettings(s) {
    var k;
    for (k in s) if (Object.prototype.hasOwnProperty.call(s, k) && Object.prototype.hasOwnProperty.call(state, k)) state[k] = s[k];

    /* Type */
    if (has(s, 'font_body_system')) set('--body-font', fontFamily(s.font_body_system));
    if (has(s, 'font_heading_system')) set('--heading-font', fontFamily(s.font_heading_system));
    if (has(s, 'body_font_size')) set('--body-font-size', px(s.body_font_size));
    if (has(s, 'body_line_height')) set('--body-line-height', String(s.body_line_height));
    if (has(s, 'body_font_weight')) set('--body-weight', String(s.body_font_weight));
    if (has(s, 'heading_font_scale')) set('--heading-font-scale', String(Number(s.heading_font_scale) / 100));
    if (has(s, 'heading_line_height')) set('--heading-line-height', String(s.heading_line_height));
    if (has(s, 'heading_font_weight')) set('--heading-weight', String(s.heading_font_weight));
    if (has(s, 'subheading_font_weight')) set('--subheading-weight', String(s.subheading_font_weight));
    if (has(s, 'heading_text_transform')) set('--heading-text-transform', String(s.heading_text_transform));
    if (has(s, 'heading_letter_spacing')) set('--heading-letter-spacing', s.heading_letter_spacing === 'negative' ? '-0.034em' : String(s.heading_letter_spacing));

    /* Layout & spacing. Phone and desktop values have their own variables,
       read by the breakpoints in layout/theme, so one never hides the other. */
    if (has(s, 'page_width')) {
      set('--page-width', px(s.page_width));
      set('--page-width-value', String(s.page_width));
      set('--theme-page-width', px(s.page_width));
    }
    if (has(s, 'fluid_container_width')) {
      set('--fluid-container-width', px(s.fluid_container_width));
      set('--fluid-container-width-value', px(s.fluid_container_width));
    }
    if (has(s, 'container_gutter')) set('--container-gutter', px(s.container_gutter));
    if (has(s, 'space_mobile')) set('--sl-live-space-mobile', px(s.space_mobile));
    if (has(s, 'spacing_desktop')) set('--sl-live-space-desktop', px(s.spacing_desktop));
    if (has(s, 'grid_gap_mobile')) set('--sl-live-grid-gap-mobile', px(s.grid_gap_mobile));
    if (has(s, 'grid_gap_desktop')) set('--sl-live-grid-gap-desktop', px(s.grid_gap_desktop));
    if (has(s, 'enable_rounded') || has(s, 'rounded_corner')) {
      var on = state.enable_rounded !== false && state.enable_rounded !== 'false';
      set('--rounded-radius', on ? px(state.rounded_corner || 0) : '0px');
      if (document.body) document.body.classList.toggle('rounded-style', on && Number(state.rounded_corner) > 1);
    }
    if (has(s, 'card_radius')) set('--card-radius', px(s.card_radius));
    if (has(s, 'pill_radius')) set('--pill-radius', px(s.pill_radius));
    if (has(s, 'card_shadow')) set('--card-shadow', SHADOWS[s.card_shadow] || 'none');
    if (has(s, 'border_width')) set('--border-width', px(s.border_width));
    if (has(s, 'divider_style')) set('--divider-style', String(s.divider_style));
    if (has(s, 'rtl')) setRtl(s.rtl === true || s.rtl === 'true');

    /* Buttons */
    if (has(s, 'btn_shape') || has(s, 'btn_radius')) {
      var radius = state.btn_shape === 'pill' ? 999 : state.btn_shape === 'square' ? 0 : state.btn_radius;
      set('--btn-radius', px(radius));
      set('--theme-button-radius', px(radius));
      bodyData('data-btn-shape', state.btn_shape);
    }
    if (has(s, 'btn_font_size')) set('--btn-font-size', px(s.btn_font_size));
    if (has(s, 'btn_padding_y')) { set('--btn-padding-y', px(s.btn_padding_y)); set('--theme-button-padding-y', px(s.btn_padding_y)); }
    if (has(s, 'btn_padding_x')) { set('--btn-padding-x', px(s.btn_padding_x)); set('--theme-button-padding-x', px(s.btn_padding_x)); }
    if (has(s, 'btn_font_weight')) set('--btn-font-weight', String(s.btn_font_weight));
    if (has(s, 'btn_border_width')) set('--btn-border-width', px(s.btn_border_width));
    if (has(s, 'btn_letter_spacing')) set('--btn-letter-spacing', px(s.btn_letter_spacing));
    if (has(s, 'btn_text_transform')) set('--btn-text-transform', String(s.btn_text_transform));
    if (has(s, 'btn_anim_duration')) set('--btn-anim-duration', ms(s.btn_anim_duration));
    if (has(s, 'btn_anim_ease')) set('--btn-anim-ease', String(s.btn_anim_ease));
    if (has(s, 'btn_shadow_enabled')) set('--btn-shadow', (s.btn_shadow_enabled === true || s.btn_shadow_enabled === 'true') ? '0 4px 14px -4px rgba(0, 0, 0, 0.18)' : 'none');
    if (has(s, 'btn_hover_effect')) bodyData('data-btn-hover', s.btn_hover_effect);
    if (has(s, 'btn_style')) bodyData('data-btn-style', s.btn_style);
    if (has(s, 'storelib_button_hover_effect')) bodyData('data-sl-btn-hover', s.storelib_button_hover_effect);

    /* Motion */
    if (has(s, 'animation_duration')) set('--animation-duration', ms(s.animation_duration));
    if (has(s, 'animation_delay')) set('--animation-delay-base', ms(s.animation_delay));

    /* Forms and fields */
    if (has(s, 'field_height')) set('--input-height', px(s.field_height));
    if (has(s, 'field_padding_x')) set('--input-padding', '1rem ' + px(s.field_padding_x));
    if (has(s, 'field_border_width')) set('--inputs-border-width', px(s.field_border_width));
    if (has(s, 'input_radius') || has(s, 'storelib_input_radius')) {
      var own = Number(state.storelib_input_radius);
      set('--input-border-radius', px(isFinite(own) && own >= 0 ? own : state.input_radius));
    }
    if (has(s, 'search_input_radius')) set('--search-input-radius', px(s.search_input_radius));
    if (has(s, 'field_font_size')) set('--input-font-size', px(s.field_font_size));
    if (has(s, 'field_label_weight')) set('--input-label-weight', String(s.field_label_weight));
    if (Object.prototype.hasOwnProperty.call(s, 'storelib_input_border')) set('--input-border-color', colour(s.storelib_input_border));
    for (var i = 0; i < SHEET_KEYS.length; i++) {
      if (Object.prototype.hasOwnProperty.call(s, SHEET_KEYS[i])) { overrideSheet(); break; }
    }

    /* Colour schemes */
    var schemes = s.color_schemes;
    if (schemes && typeof schemes === 'object') {
      var ids = Object.keys(schemes);
      for (var n = 0; n < ids.length; n++) {
        var varsForScheme = schemeVars(schemes[ids[n]]);
        if (!varsForScheme) continue;
        liveSchemes[ids[n]] = varsForScheme;
        if (n === 0 || ids[n] === 'default') {
          Object.keys(varsForScheme).forEach(function (key) { set(key, varsForScheme[key]); });
        }
      }
      schemeSheet();
    }
  }

  document.addEventListener('storelib:settings-change', function (event) {
    var detail = event.detail || {};
    var changed = detail.settings || detail;
    if (!changed || typeof changed !== 'object') return;
    for (var key in changed) if (Object.prototype.hasOwnProperty.call(changed, key)) pending[key] = changed[key];
    if (!root.classList.contains('sl-live-tweak')) root.classList.add('sl-live-tweak');
    clearTimeout(tweakTimer);
    tweakTimer = setTimeout(function () { root.classList.remove('sl-live-tweak'); }, detail.live ? 400 : 250);
    if (frame) return;
    frame = requestAnimationFrame(function () {
      frame = 0;
      var next = pending;
      pending = {};
      applySettings(next);
    });
  });
})();
{% comment %}{% endcomment %}</script>
</template>
