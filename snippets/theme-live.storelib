<template compat="shopify">
<script>
(function () {
  var root = document.documentElement;
  var frame = 0;
  var pending = null;
  var schemeNodes = new Map();
  function px(value) {
    if (value == null || value === '') return null;
    var text = String(value);
    return /px$|em$|rem$|%$/.test(text) ? text : text + 'px';
  }
  function nodesFor(id) {
    var list = schemeNodes.get(id);
    if (list && list.length && list[0].isConnected) return list;
    list = Array.prototype.slice.call(document.querySelectorAll('.color-' + id));
    schemeNodes.set(id, list);
    return list;
  }
  function paint(el, vars) {
    var keys = Object.keys(vars);
    for (var i = 0; i < keys.length; i++) {
      if (vars[keys[i]] != null && vars[keys[i]] !== '') el.style.setProperty(keys[i], vars[keys[i]]);
    }
  }
  function schemeVars(s) {
    if (!s) return null;
    if (s.settings) s = s.settings;
    var bg = s.background;
    var text = s.text_color;
    var heading = s.heading_color;
    var accent = s.primary_color;
    var line = s.border_color;
    return {
      '--color-background': bg,
      '--gradient-background': bg,
      '--color-text': text,
      '--color-heading': heading,
      '--color-primary': accent,
      '--color-border': line,
      '--color-link': heading,
      '--color-link-hover': accent,
      '--btn-primary-bg-color': s.btn_primary_background || accent,
      '--btn-primary-color': s.btn_primary_color || bg,
      '--btn-primary-hover-bg-color': s.btn_primary_hover_background || heading,
      '--btn-primary-hover-color': s.btn_primary_hover_color || bg,
      '--btn-primary-bg-graident-color': s.btn_primary_background || accent,
      '--btn-primary-hover-bg-color-graident': s.btn_primary_hover_background || heading,
      '--btn-primary-border-color': s.btn_primary_background || accent,
      '--btn-primary-hover-border-color': s.btn_primary_hover_background || heading,
      '--btn-secondary-bg-color': s.btn_secondary_background || bg,
      '--btn-secondary-color': s.btn_secondary_color || heading,
      '--btn-secondary-border-color': s.btn_secondary_border || heading,
      '--btn-secondary-hover-bg-color': s.btn_secondary_hover_background || heading,
      '--btn-secondary-hover-color': s.btn_secondary_hover_color || bg,
      '--btn-secondary-hover-border-color': s.btn_secondary_hover_background || heading,
      '--btn-outline-color': heading,
      '--btn-outline-border-color': line,
      '--btn-link-color': heading,
      '--btn-link-hover-color': accent
    };
  }
  function layoutStyle(settings) {
    var sheet = document.getElementById('sl-live-layout');
    if (!sheet) {
      sheet = document.createElement('style');
      sheet.id = 'sl-live-layout';
      document.head.appendChild(sheet);
    }
    var desktop = settings.spacing_desktop;
    var gap = settings.grid_gap_desktop;
    var css = '';
    if (desktop != null) css += '--section-spacing:' + px(desktop) + ';';
    if (gap != null) css += '--grid-gap:' + px(gap) + ';';
    sheet.textContent = css ? '@media (min-width:768px){:root{' + css + '}}' : '';
  }
  function applySettings(settings) {
    if (!settings) return;
    var radius = settings.btn_radius;
    if (settings.btn_shape === 'pill') radius = 999;
    else if (settings.btn_shape === 'square') radius = 0;
    var track = settings.heading_letter_spacing;
    if (track === 'negative') track = '-0.034em';
    var vars = {};
    if (settings.body_font_size != null) vars['--body-font-size'] = px(settings.body_font_size);
    if (settings.body_line_height != null) vars['--body-line-height'] = String(settings.body_line_height);
    if (settings.body_font_weight != null) vars['--body-weight'] = String(settings.body_font_weight);
    if (settings.heading_font_scale != null) vars['--heading-font-scale'] = String(Number(settings.heading_font_scale) / 100);
    if (settings.heading_line_height != null) vars['--heading-line-height'] = String(settings.heading_line_height);
    if (settings.heading_font_weight != null) vars['--heading-weight'] = String(settings.heading_font_weight);
    if (settings.subheading_font_weight != null) vars['--subheading-weight'] = String(settings.subheading_font_weight);
    if (settings.heading_text_transform != null) vars['--heading-text-transform'] = String(settings.heading_text_transform);
    if (track != null) vars['--heading-letter-spacing'] = String(track);
    if (settings.page_width != null) {
      vars['--page-width'] = px(settings.page_width);
      vars['--page-width-value'] = String(settings.page_width);
    }
    if (settings.fluid_container_width != null) {
      vars['--fluid-container-width'] = px(settings.fluid_container_width);
      vars['--fluid-container-width-value'] = String(settings.fluid_container_width);
    }
    if (settings.space_mobile != null) vars['--section-spacing'] = px(settings.space_mobile);
    if (settings.container_gutter != null) vars['--container-gutter'] = px(settings.container_gutter);
    if (settings.grid_gap_mobile != null) vars['--grid-gap'] = px(settings.grid_gap_mobile);
    if (settings.btn_font_size != null) vars['--btn-font-size'] = px(settings.btn_font_size);
    if (settings.btn_padding_y != null) vars['--btn-padding-y'] = px(settings.btn_padding_y);
    if (settings.btn_padding_x != null) vars['--btn-padding-x'] = px(settings.btn_padding_x);
    if (settings.btn_font_weight != null) vars['--btn-font-weight'] = String(settings.btn_font_weight);
    if (settings.btn_border_width != null) vars['--btn-border-width'] = px(settings.btn_border_width);
    if (settings.btn_letter_spacing != null) vars['--btn-letter-spacing'] = px(settings.btn_letter_spacing);
    if (settings.animation_duration != null) vars['--animation-duration'] = px(settings.animation_duration).replace('px', 'ms');
    if (settings.animation_delay != null) vars['--animation-delay-base'] = px(settings.animation_delay).replace('px', 'ms');
    if (radius != null) vars['--btn-radius'] = px(radius);
    if (settings.input_radius != null) vars['--input-border-radius'] = px(settings.input_radius);
    if (settings.storelib_input_radius != null && Number(settings.storelib_input_radius) >= 0) {
      vars['--input-border-radius'] = px(settings.storelib_input_radius);
    }
    if (settings.field_height != null) vars['--input-height'] = px(settings.field_height);
    if (settings.field_padding_x != null) vars['--input-padding'] = '1rem ' + px(settings.field_padding_x);
    if (settings.field_border_width != null) vars['--inputs-border-width'] = px(settings.field_border_width);
    if (settings.field_font_size != null) vars['--input-font-size'] = px(settings.field_font_size);
    if (settings.field_label_weight != null) vars['--input-label-weight'] = String(settings.field_label_weight);
    if (settings.storelib_input_border) vars['--input-border-color'] = String(settings.storelib_input_border);
    if (settings.search_input_radius != null) vars['--search-input-radius'] = px(settings.search_input_radius);
    if (settings.card_radius != null) vars['--card-radius'] = px(settings.card_radius);
    if (settings.rounded_corner != null) vars['--rounded-radius'] = px(settings.rounded_corner);
    paint(root, vars);
    if (settings.spacing_desktop != null || settings.grid_gap_desktop != null) layoutStyle(settings);
    var schemes = settings.color_schemes;
    if (schemes && typeof schemes === 'object') {
      var ids = Object.keys(schemes);
      for (var i = 0; i < ids.length; i++) {
        var varsForScheme = schemeVars(schemes[ids[i]]);
        if (!varsForScheme) continue;
        var list = nodesFor(ids[i]);
        for (var n = 0; n < list.length; n++) paint(list[n], varsForScheme);
        if (i === 0 || ids[i] === 'default') paint(root, varsForScheme);
      }
    }
  }
  document.addEventListener('storelib:settings-change', function (event) {
    pending = (event.detail && (event.detail.settings || event.detail)) || pending;
    if (frame) return;
    frame = requestAnimationFrame(function () {
      frame = 0;
      var next = pending;
      pending = null;
      applySettings(next);
    });
  });
  document.addEventListener('shopify:section:load', function () { schemeNodes.clear(); });
})();
{% comment %}{% endcomment %}</script>
</template>
