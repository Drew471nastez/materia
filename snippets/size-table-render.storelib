<template compat="shopify">
{%- comment -%}
  Materia Themes. Size chart block (size_table): the sizes drawn in the
  page, as a row that opens and closes like Expandable info rows
  (details.mt-acc, animated by product-page-ui) or always open.
  What it shows, first one found:
    1. the size chart given to this product in Storelib (Products > Size
       charts), unless "Use the product's Storelib size chart" is off;
    2. the product's custom field named below, when that is on;
    3. the block's Table data.
  Rows: the first line names the columns, then one size per line, cells
  split by "|" (snippets/size-rows-table). A product's Storelib chart only
  reaches its own page, so elsewhere it is asked from that page by
  size-chart.js and the block shows once it arrives.
  Inputs: block, product.
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign uid = block.id
  assign title = bs.title | default: 'Size guide'

  assign use_chart = true
  if bs.use_storelib_chart == false
    assign use_chart = false
  endif
  assign assigned_native = blank
  if use_chart
    assign assigned_native = product.metafields.storelib.size_chart
    if assigned_native == blank and page.product.id == product.id
      assign assigned_native = page.product.metafields.storelib.size_chart
    endif
  endif

  assign raw = bs.table_data
  if bs.use_metafield
    assign mf_ns  = bs.metafield_namespace | default: 'custom'
    assign mf_key = bs.metafield_key       | default: 'size_table'
    assign mf = product.metafields[mf_ns][mf_key]
    if mf != blank
      assign raw = mf.value | default: mf
    endif
  endif

  assign remote = false
  if use_chart and assigned_native == blank and product.url != blank
    if request.design_mode or request.path != product.url
      assign remote = true
    endif
  endif
-%}
{%- capture assigned_chart -%}{%- if assigned_native != blank -%}{%- render 'product-size-chart-content', product: product, chart_id: block.id -%}{%- endif -%}{%- endcapture -%}
{%- capture typed_rows -%}{%- if assigned_chart == blank -%}{%- render 'size-rows-table', data: raw, unit: bs.table_unit, uid: uid -%}{%- endif -%}{%- endcapture -%}
{%- assign has_rows = false -%}
{%- if assigned_chart != blank or typed_rows != blank -%}{%- assign has_rows = true -%}{%- endif -%}

{%- if has_rows or remote -%}
{%- capture st_head_bg -%}{%- render 'scheme-color', color: bs.accent, fallback: 'unset' -%}{%- endcapture -%}
{%- capture st_head_text -%}{%- render 'scheme-color', color: bs.header_text_color, fallback: 'unset' -%}{%- endcapture -%}
{%- capture st_text -%}{%- render 'scheme-color', color: bs.body_text_color, fallback: 'unset' -%}{%- endcapture -%}
{%- capture st_title -%}{%- render 'scheme-color', color: bs.title_color, fallback: 'unset' -%}{%- endcapture -%}
{%- capture st_border -%}{%- render 'scheme-color', color: bs.border_color, fallback: 'unset' -%}{%- endcapture -%}
{%- capture st_stripe -%}{%- render 'scheme-color', color: bs.zebra_color, fallback: 'unset' -%}{%- endcapture -%}
<style>
  #SizeTable-{{ uid }} {
    margin: {{ bs.space_above | default: 8 }}px 0 {{ bs.space_below | default: 8 }}px;
    font-family: var(--body-font, inherit);
    {%- if st_title != 'unset' %} --mt-acc-title: {{ st_title }};{% endif %}
    {%- if st_border != 'unset' %} --mt-acc-border: {{ st_border }};{% endif %}
  }
  #SizeTable-{{ uid }} .mt-size-chart {
    --sz-radius: {{ bs.radius | default: 8 }}px;
    --sz-fs: {{ bs.cell_size | default: 14 }}px;
    {%- if st_head_bg != 'unset' %} --sz-head-bg: {{ st_head_bg }};{% endif %}
    {%- if st_head_text != 'unset' %} --sz-head-text: {{ st_head_text }};{% endif %}
    {%- if st_text != 'unset' %} --sz-text: {{ st_text }};{% endif %}
    {%- if st_border != 'unset' %} --sz-border: {{ st_border }};{% endif %}
    {%- if bs.zebra == false %} --sz-stripe: var(--sz-bg);{% elsif st_stripe != 'unset' %} --sz-stripe: {{ st_stripe }};{% endif %}
  }
  #SizeTable-{{ uid }} .sz-title {
    margin: 0;
    color: var(--mt-acc-title, var(--color-heading));
    font-family: var(--heading-font, inherit);
    font-size: {{ bs.title_size | default: 16 }}px;
    font-weight: var(--subheading-weight, 600);
    line-height: 1.35;
  }
  #SizeTable-{{ uid }} .sz-title--static { padding: 0 0 12px; }
  #SizeTable-{{ uid }} details > summary.sz-title { padding: 12px 0; }
  #SizeTable-{{ uid }} .sz-body { padding: 0 0 16px; }
  #SizeTable-{{ uid }} .sz-wrap:not(.mt-acc) .sz-body { padding: 0; }
{% comment %}{% endcomment %}</style>

{%- capture _table -%}
  <div class="sz-body">
    {%- if remote -%}<div data-size-chart-remote="{{ product.url }}"{% unless has_rows %} hidden{% endunless %}></div>{%- endif -%}
    {%- if assigned_chart != blank -%}{{ assigned_chart }}{%- elsif typed_rows != blank -%}{%- if remote -%}<div data-size-chart-fallback>{{ typed_rows }}</div>{%- else -%}{{ typed_rows }}{%- endif -%}{%- endif -%}
  </div>
{%- endcapture -%}

<div id="SizeTable-{{ uid }}" class="sz" data-size-chart-root="{{ uid }}"{% if has_rows or request.design_mode != true %} {{ block.shopify_attributes }}{% endif %}{% unless has_rows %} hidden data-size-chart-await{% endunless %}>
  {%- if bs.collapsible != false -%}
    <details class="sz-wrap mt-acc" data-mt-acc-key="{{ uid }}"{% if bs.start_open %} open{% endif %}>
      <summary class="sz-title">
        <span class="mt-acc__title">{{ title | escape }}</span>
        <svg class="mt-acc__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="mt-acc__body">{{ _table }}</div>
    </details>
  {%- else -%}
    <div class="sz-wrap">
      <p class="sz-title sz-title--static">{{ title | escape }}</p>
      {{ _table }}
    </div>
  {%- endif -%}
</div>
{%- endif -%}
{%- unless has_rows -%}
  {%- render 'size-chart-preview', block: block, rows_setting: true -%}
{%- endunless -%}
</template>
