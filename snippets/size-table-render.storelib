<template compat="shopify">
{%- comment -%}
  Materia Themes — Size Table block. Params: block, product.
  Collapsible: a details.mt-acc, opened and closed smoothly by
  product-page-ui (::details-content height, or an animation where the
  browser cannot), the same as Expandable info rows.

  Table data: one row per line, cells separated by "|". The FIRST line is the
  header row. Source is either the block's "Table data" field (same for every
  product using this template) OR a per-product metafield (unique per product).
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign uid = block.id
  assign head_bg   = bs.accent            | default: '#E5E7EB'
  assign head_text = bs.header_text_color | default: '#111827'
  assign body_text = bs.body_text_color   | default: '#374151'
  assign title     = bs.title             | default: 'Size Guide'

  assign raw = bs.table_data
  assign assigned_native = product.metafields.storelib.size_chart
  if assigned_native == blank and page.product.id == product.id
    assign assigned_native = page.product.metafields.storelib.size_chart
  endif
  if bs.use_metafield
    assign mf_ns  = bs.metafield_namespace | default: 'custom'
    assign mf_key = bs.metafield_key       | default: 'size_table'
    assign mf = product.metafields[mf_ns][mf_key]
    if mf != blank
      assign raw = mf.value | default: mf
    endif
  endif
  assign rows = raw | strip | newline_to_br | split: '<br />'
-%}
{%- capture assigned_chart -%}{%- if bs.use_storelib_chart != false and assigned_native != blank -%}{%- render 'product-size-chart-content', product: product, chart_id: block.id -%}{%- endif -%}{%- endcapture -%}

{%- if raw != blank or assigned_chart != blank -%}
<style>
  #SizeTable-{{ uid }} { font-family: var(--body-font, inherit); margin: {{ bs.space_above | default: 8 }}px 0 {{ bs.space_below | default: 8 }}px; }
  #SizeTable-{{ uid }} .sz-wrap { border: 1px solid {{ bs.border_color | default: '#E5E7EB' }}; border-radius: {{ bs.radius | default: 10 }}px; overflow: hidden; }
  #SizeTable-{{ uid }} .sz-title {
    font-family: var(--heading-font, inherit);
    font-size: {{ bs.title_size | default: 16 }}px; font-weight: 700; color: {{ bs.title_color | default: '#111111' }};
    margin: 0; padding: 14px 16px; list-style: none; cursor: default;
  }
  #SizeTable-{{ uid }} details > summary.sz-title { cursor: pointer; display: flex; align-items: center; justify-content: space-between; }
  #SizeTable-{{ uid }} details > summary.sz-title::-webkit-details-marker { display: none; }
  #SizeTable-{{ uid }} details > summary.sz-title::after {
    content: ""; width: 9px; height: 9px; margin-left: 12px; flex: 0 0 auto;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(45deg); transition: transform .2s ease;
  }
  #SizeTable-{{ uid }} details[open]:not(.is-closing) > summary.sz-title::after { transform: rotate(-135deg); }
  #SizeTable-{{ uid }} details > summary.sz-title::after { transition: transform .32s cubic-bezier(.4, 0, .2, 1); }
  #SizeTable-{{ uid }} details > summary.sz-title { min-height: 44px; font-family: var(--heading-font, inherit); }
  #SizeTable-{{ uid }} .sz-wrap.mt-acc { border-bottom: 1px solid {{ bs.border_color | default: '#E5E7EB' }}; }
  #SizeTable-{{ uid }} .mt-acc__body { color: inherit; }
  @media (prefers-reduced-motion: reduce) { #SizeTable-{{ uid }} details > summary.sz-title::after { transition: none; } }
  #SizeTable-{{ uid }} .sz-body { overflow-x: auto; }
  #SizeTable-{{ uid }} table { width: 100%; border-collapse: collapse; font-size: {{ bs.cell_size | default: 14 }}px; }
  #SizeTable-{{ uid }} thead th {
    background: {{ head_bg }}; color: {{ head_text }};
    font-weight: 700; text-transform: uppercase; letter-spacing: .02em;
    padding: 12px 14px; text-align: center; white-space: nowrap;
  }
  #SizeTable-{{ uid }} thead th:first-child { text-align: left; }
  #SizeTable-{{ uid }} tbody td { padding: 11px 14px; text-align: center; color: {{ body_text }}; border-top: 1px solid {{ bs.border_color | default: '#E5E7EB' }}; }
  #SizeTable-{{ uid }} tbody td:first-child { text-align: left; font-weight: 600; }
  {%- if bs.zebra != false -%}
  #SizeTable-{{ uid }} tbody tr:nth-child(even) { background: {{ bs.zebra_color | default: '#F9FAFB' }}; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>

{%- capture _table -%}
  {%- if assigned_chart != blank -%}
    <div class="sz-body">{{ assigned_chart }}</div>
  {%- else -%}
  <div class="sz-body">
    <table>
      {%- for row in rows -%}
        {%- assign cells = row | strip -%}
        {%- if cells == blank -%}{%- continue -%}{%- endif -%}
        {%- assign cells = cells | split: '|' -%}
        {%- if forloop.first -%}
          <thead><tr>{%- for c in cells -%}<th scope="col">{{ c | strip | escape }}</th>{%- endfor -%}</tr></thead><tbody>
        {%- else -%}
          <tr>{%- for c in cells -%}<td>{{ c | strip | escape }}</td>{%- endfor -%}</tr>
        {%- endif -%}
      {%- endfor -%}
      </tbody>
    </table>
  </div>
  {%- endif -%}
{%- endcapture -%}

<div id="SizeTable-{{ uid }}" {{ block.shopify_attributes }}>
  {%- if bs.collapsible != false -%}
    <details class="sz-wrap mt-acc" data-mt-acc-key="{{ uid }}"{% if bs.start_open %} open{% endif %}>
      <summary class="sz-title">{{ title }}</summary>
      <div class="mt-acc__body">{{ _table }}</div>
    </details>
  {%- else -%}
    <div class="sz-wrap">
      <p class="sz-title sz-title--static">{{ title }}</p>
      {{ _table }}
    </div>
  {%- endif -%}
</div>
{%- else -%}
  {%- render 'size-chart-preview', block: block -%}
{%- endif -%}

</template>
