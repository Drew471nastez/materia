<template compat="shopify">
{%- comment -%}
  Materia Themes — Benefits Tab block.
  Horizontal grid of icon-on-top + label-below tabs (default: 4 across).
  Each tab: enable toggle, text, icon (preset / SVG / image / none),
  per-tab icon and text color overrides. Outer container styling
  (background, border, radius, padding, shadow) for the cream-pill look.
  Inherits the theme color scheme via `var(--color-text)`.
  Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'benefits-tab-' | append: block.id

  assign cols_d = s.cols_desktop | default: 4
  assign cols_m = s.cols_mobile  | default: 4

  assign icon_color = s.icon_color | default: '#1f1147'
  assign text_color = s.text_color | default: '#1f1147'
  assign icon_size_d = s.icon_size_desktop | default: 28
  assign icon_size_m = s.icon_size_mobile  | default: 24
  assign text_size_d = s.text_size_desktop | default: 14
  assign text_size_m = s.text_size_mobile  | default: 12
  assign text_weight = s.text_weight | default: '500'
  assign gap_icon_text = s.gap_icon_text | default: 10
  assign gap_x = s.gap_x | default: 12
  assign gap_y = s.gap_y | default: 12

  assign container_bg = s.container_bg | default: 'transparent'
  assign container_radius = s.container_radius | default: 18
  assign container_pad_x  = s.container_padding_x | default: 18
  assign container_pad_y  = s.container_padding_y | default: 18
  assign container_bs     = s.container_border_style | default: 'none'
  assign container_bw     = s.container_border_width | default: 0
  assign container_bc     = s.container_border_color | default: 'transparent'

  assign heading_text  = s.heading_text  | default: ''
  assign heading_color = s.heading_color | default: '#111111'
  assign heading_size_d = s.heading_size_desktop | default: 16
  assign heading_size_m = s.heading_size_mobile  | default: 15
  assign heading_w     = s.heading_weight | default: '700'
  assign heading_align = s.heading_alignment | default: 'left'
  assign heading_mb    = s.heading_margin_bottom | default: 12
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 12 }}px;
    padding-bottom: {{ s.padding_bottom | default: 12 }}px;
    color: var(--color-text, #111);
  }
  #{{ block_id }} .bt-heading {
    margin: 0 0 {{ heading_mb }}px;
    font-size: {{ heading_size_m }}px;
    font-weight: {{ heading_w }};
    color: {{ heading_color }};
    text-align: {{ heading_align }};
    line-height: 1.3;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bt-heading { font-size: {{ heading_size_d }}px; }
  }
  #{{ block_id }} .bt-container {
    background: {{ container_bg }};
    border-radius: {{ container_radius }}px;
    padding: {{ container_pad_y }}px {{ container_pad_x }}px;
    {%- if container_bs != 'none' and container_bw > 0 -%}
      border: {{ container_bw }}px {{ container_bs }} {{ container_bc }};
    {%- endif -%}
    {%- if s.container_shadow -%}
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    {%- endif -%}
    box-sizing: border-box;
  }
  #{{ block_id }} .bt-grid {
    display: grid;
    grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr));
    gap: {{ gap_y }}px {{ gap_x }}px;
    align-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bt-grid {
      grid-template-columns: repeat({{ cols_d }}, minmax(0, 1fr));
    }
  }
  #{{ block_id }} .bt-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ gap_icon_text }}px;
    min-width: 0;
  }
  #{{ block_id }} .bt-icon {
    width: {{ icon_size_m }}px;
    height: {{ icon_size_m }}px;
    color: {{ icon_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bt-icon {
      width: {{ icon_size_d }}px;
      height: {{ icon_size_d }}px;
    }
  }
  #{{ block_id }} .bt-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  #{{ block_id }} .bt-icon svg,
  #{{ block_id }} .bt-icon svg * {
    stroke: currentColor;
  }
  #{{ block_id }} .bt-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  #{{ block_id }} .bt-text {
    color: {{ text_color }};
    font-size: {{ text_size_m }}px;
    font-weight: {{ text_weight }};
    line-height: 1.25;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bt-text { font-size: {{ text_size_d }}px; }
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="benefits-tab-block" {{ block.shopify_attributes }}>
  {%- if heading_text != blank -%}
    <p class="bt-heading">{{ heading_text }}</p>
  {%- endif -%}
  <div class="bt-container">
    <ul class="bt-grid" role="list">
      {%- for i in (1..6) -%}
        {%- capture k_enable -%}tab{{ i }}_enable{%- endcapture -%}
        {%- capture k_text   -%}tab{{ i }}_text{%- endcapture -%}
        {%- capture k_src    -%}tab{{ i }}_icon_source{%- endcapture -%}
        {%- capture k_preset -%}tab{{ i }}_icon_preset{%- endcapture -%}
        {%- capture k_svg    -%}tab{{ i }}_icon_svg{%- endcapture -%}
        {%- capture k_img    -%}tab{{ i }}_icon_image{%- endcapture -%}
        {%- capture k_ic_o   -%}tab{{ i }}_icon_color{%- endcapture -%}
        {%- capture k_tc_o   -%}tab{{ i }}_text_color{%- endcapture -%}

        {%- assign t_enable = s[k_enable] -%}
        {%- assign t_text   = s[k_text] -%}
        {%- assign t_src    = s[k_src]  | default: 'preset' -%}
        {%- assign t_preset = s[k_preset] | default: 'gift' -%}
        {%- assign t_svg    = s[k_svg] -%}
        {%- assign t_img    = s[k_img] -%}
        {%- assign t_ic_o   = s[k_ic_o] -%}
        {%- assign t_tc_o   = s[k_tc_o] -%}

        {%- if t_enable and t_text != blank -%}
          {%- capture icon_inline -%}{%- if t_ic_o != blank -%}color: {{ t_ic_o }};{%- endif -%}{%- endcapture -%}
          {%- capture text_inline -%}{%- if t_tc_o != blank -%}color: {{ t_tc_o }};{%- endif -%}{%- endcapture -%}
          {%- assign icon_inline_trim = icon_inline | strip -%}
          {%- assign text_inline_trim = text_inline | strip -%}
          <li class="bt-item" role="listitem">
            {%- if t_src != 'none' -%}
              <span class="bt-icon" aria-hidden="true"{% if icon_inline_trim != blank %} style="{{ icon_inline_trim }}"{% endif %}>
                {%- if t_src == 'image' and t_img != blank -%}
                  {{ t_img | image_url: width: 128 | image_tag: alt: t_text, loading: 'lazy' }}
                {%- elsif t_src == 'svg' and t_svg != blank -%}
                  {{ t_svg }}
                {%- else -%}
                  {%- case t_preset -%}
                    {%- when 'gift' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="4" rx="1"/><path d="M5 13v8h14v-8M12 9v12M12 9c-2.5-2.5-5-3.5-5-5.5a2.5 2.5 0 0 1 5 0c0 2 0 5.5 0 5.5ZM12 9c2.5-2.5 5-3.5 5-5.5a2.5 2.5 0 0 0-5 0c0 2 0 5.5 0 5.5Z"/></svg>
                    {%- when 'swirl' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4a8 8 0 1 1-7.5 5"/><path d="M12 7a5 5 0 1 1-4.5 3"/><path d="M12 10a2.5 2.5 0 1 1-2 1.5"/></svg>
                    {%- when 'drop' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3 5-6 8.5-6 12a6 6 0 0 0 12 0c0-3.5-3-7-6-12Z"/></svg>
                    {%- when 'leaves' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 14C9 11 6 11 4 13c1 3 4 4 7 3"/><path d="M12 14c3-3 6-3 8-1-1 3-4 4-7 3"/><path d="M12 14V21"/></svg>
                    {%- when 'leaf' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c8 0 14-6 14-14-7 0-13 1-14 8-.5 4 0 6 0 6Z"/><path d="M5 19c2-3 5-6 9-9"/></svg>
                    {%- when 'heart' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-9.5A4 4 0 0 1 12 7a4 4 0 0 1 7 3.5C19 15.5 12 20 12 20Z"/></svg>
                    {%- when 'shield' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 7.5-8 9-4-1.5-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg>
                    {%- when 'star' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.5 6 .9-4.3 4.3 1 6L12 17l-5.4 2.7 1-6L3.3 9.4l6-.9L12 3Z"/></svg>
                    {%- when 'sparkle' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.7 4 4 1.7-4 1.7L12 16l-1.7-4.6-4-1.7 4-1.7L12 4Z"/><path d="M19 14l.7 1.7 1.7.6-1.7.6L19 18.6l-.6-1.7-1.7-.6 1.7-.6L19 14Z"/></svg>
                    {%- when 'sun' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
                    {%- when 'moon' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14a8 8 0 1 1-10-10 7 7 0 0 0 10 10Z"/></svg>
                    {%- when 'flower' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.5"/><path d="M12 3a3 3 0 0 1 0 6M12 15a3 3 0 0 1 0 6M3 12a3 3 0 0 1 6 0M15 12a3 3 0 0 1 6 0"/></svg>
                    {%- when 'bottle' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v3l1 2v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V8l1-2V3Z"/><path d="M9 13h6"/></svg>
                    {%- when 'recycle' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18l-3-2 3-5h4"/><path d="M17 18h-6l3-5h-4"/><path d="M13 6l3-2-3-5h-4"/><path d="M7 18l4 3M11 13l3 5M13 6l-3 5"/></svg>
                    {%- when 'check' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                    {%- when 'lightning' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z"/></svg>
                    {%- when 'fire' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a6 6 0 0 0 6-6c0-3-2-5-3-7-1-2-3-3-3-5 0 3-3 4-4 7s-2 4-2 5a6 6 0 0 0 6 6Z"/></svg>
                    {%- when 'gem' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l3-5h6l3 5-6 11L6 9Z"/><path d="M6 9h12M9 4l3 5 3-5"/></svg>
                    {%- when 'truck' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="13" height="9"/><path d="M15 10h4l3 4v2h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                    {%- else -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="bt-text"{% if text_inline_trim != blank %} style="{{ text_inline_trim }}"{% endif %}>{{ t_text }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

</template>