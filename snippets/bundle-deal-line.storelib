<template compat="shopify">
{%- comment -%}
  Bundle & Save (multi-product) — one product row.
  Params:
    p            (product object, required)
    role         'main' | 'addon' | 'gift'   (default 'addon')
    custom_image (image, optional override of the product's featured image)
    is_free      (bool — render as the free gift)
    thumb_size   (px, default 56)
    thumb_radius (px, default 12)
  Renders: square rounded thumbnail + title + variant <select> (or hidden input
  when the product has a single variant) + price. Prices are filled by JS from
  the selected option's data-price / data-compare, so this stays currency-agnostic.
{%- endcomment -%}
{%- liquid
  assign v0 = p.selected_or_first_available_variant
  assign img = custom_image
  if img == blank
    assign img = p.featured_image
  endif
  assign ts = thumb_size | default: 56
  assign tr = thumb_radius | default: 12
  assign role = role | default: 'addon'
-%}
<div class="bdl-line" data-line data-role="{{ role }}"{% if is_free %} data-free="1"{% endif %}>
  <span class="bdl-thumb" style="--bdl-ts: {{ ts }}px; --bdl-tr: {{ tr }}px;">
    {%- if img != blank -%}
      <img src="{{ img | image_url: width: 200 }}" alt="{{ p.title | escape }}" loading="lazy" width="{{ ts }}" height="{{ ts }}">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'bdl-thumb__ph' }}
    {%- endif -%}
  </span>
  <span class="bdl-line__main">
    <span class="bdl-line__name">
      {%- if is_free -%}<span class="bdl-line__plus">+</span> {% endif -%}{{ p.title }}{%- if is_free -%} <span class="bdl-line__freetag">{{ free_text | default: 'FREE GIFT' }}</span>{%- endif -%}
    </span>
    {%- if p.variants.size > 1 -%}
      <select class="bdl-line__select" data-select aria-label="{{ p.title | escape }} options">
        {%- for v in p.variants -%}
          <option value="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: v.price }}"{% unless v.available %} disabled{% endunless %}{% if v.id == v0.id %} selected{% endif %}>{{ v.title }}{% unless v.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
        {%- endfor -%}
      </select>
    {%- else -%}
      <input type="hidden" data-select data-price="{{ v0.price }}" data-compare="{{ v0.compare_at_price | default: v0.price }}" value="{{ v0.id }}">
    {%- endif -%}
  </span>
  <span class="bdl-line__price">
    {%- if is_free -%}
      <s class="bdl-line__was" data-line-compare></s>
    {%- else -%}
      <span class="bdl-line__amt" data-line-price></span>
      <s class="bdl-line__was" data-line-compare></s>
    {%- endif -%}
  </span>
</div>

</template>