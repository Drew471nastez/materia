<template compat="shopify">
{%- comment -%}
  Materia Themes. The handle icons of the before/after comparison sliders
  (Before and After Slider: icon1 to icon14; Before/After Slider 2: arrows,
  chevrons, lines, dots, plus). Every icon draws in currentColor.
  {% render 'media-ba-icon', icon: 'icon2' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'icon1' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 7L4 12L9 17M15 7L20 12L15 17"/></svg>
  {%- when 'icon2' -%}
    <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3.404,13.019h15.593c0.552,0,1-0.452,1-1.01c0-0.558-0.448-1.01-1-1.01H3.404l5.2-5.275c0.391-0.395,0.391-1.034,0-1.428c-0.391-0.395-1.024-0.395-1.414,0l-6.899,6.999c-0.385,0.389-0.389,1.04,0,1.429l6.9,6.999c0.391,0.395,1.024,0.394,1.414,0c0.391-0.394,0.391-1.034,0-1.428L3.404,13.019z"/><path d="M31.71,19.277l-6.9-6.999c-0.391-0.395-1.024-0.394-1.414,0c-0.391,0.394-0.391,1.034,0,1.428l5.2,5.275H13.003c-0.552,0-1,0.452-1,1.01c0,0.558,0.448,1.01,1,1.01h15.593l-5.2,5.275c-0.391,0.395-0.391,1.034,0,1.428c0.391,0.395,1.024,0.395,1.414,0l6.899-6.999C32.095,20.317,32.099,19.666,31.71,19.277z"/></svg>
  {%- when 'icon3' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2l2.39 6.93L22 9.24l-5 4.87L18.78 22 12 18.56 5.22 22 7 14.11 2 9.24l7.61-0.31L12 2z"/></svg>
  {%- when 'icon10' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="5"/><path d="M12 1V3M12 21V23M4.22 4.22L5.64 5.64M18.36 18.36L19.78 19.78M1 12H3M21 12H23M4.22 19.78L5.64 18.36M18.36 5.64L19.78 4.22"/></svg>
  {%- when 'icon11' -%}
    <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true" focusable="false"><path d="M256,48C141.1,48,48,141.1,48,256s93.1,208,208,208c114.9,0,208-93.1,208-208S370.9,48,256,48z M256,446.7c-105.1,0-190.7-85.5-190.7-190.7c0-105.1,85.5-190.7,190.7-190.7c105.1,0,190.7,85.5,190.7,190.7C446.7,361.1,361.1,446.7,256,446.7z"/><path d="M256,96c-88.4,0-160,71.6-160,160c0,88.4,71.6,160,160,160c88.4,0,160-71.6,160-160C416,167.6,344.4,96,256,96z"/></svg>
  {%- when 'icon12' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8,10V13H14V18H8V21L2,15.5L8,10M22,8.5L16,3V6H10V11H16V14L22,8.5Z"/></svg>
  {%- when 'icon13' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path transform="matrix(1 0 0 -1 0 24)" d="M8,10V13H14V18H8V21L2,15.5L8,10M22,8.5L16,3V6H10V11H16V14L22,8.5Z"/></svg>
  {%- when 'icon14' -%}
    <svg viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10.787 10.787c-11.715 11.715-11.715 30.711 0 42.426c11.714 11.717 30.71 11.717 42.426 0c11.717-11.715 11.717-30.71 0-42.426c-11.716-11.716-30.712-11.716-42.426 0zM36.487 16l15.512 16l-15.512 16V36.628h-8.975V48L12 32l15.513-16v11.373h8.975V16z"/></svg>
  {%- when 'chevrons' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 7 4 12 9 17"/><polyline points="13 7 8 12 13 17"/><polyline points="11 7 16 12 11 17"/><polyline points="15 7 20 12 15 17"/></svg>
  {%- when 'lines' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="9" y1="6" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="18"/></svg>
  {%- when 'dots' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="6" y1="12" x2="18" y2="12"/><polyline points="10 8 6 12 10 16"/><polyline points="14 8 18 12 14 16"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10 7 5 12 10 17"/><polyline points="14 7 19 12 14 17"/></svg>
{%- endcase -%}
</template>
