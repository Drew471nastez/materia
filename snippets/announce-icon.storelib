<template compat="shopify">
{%- comment -%}
  Materia Themes. The separator icons of Announcement Bar Pro 1, drawn inline
  (no icon font to load). shopify/assets/live-announcements.js draws the same
  shapes for a live change (ICONS there).
  {% render 'announce-icon', icon: section.settings.separator_icon %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'fa-star' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></svg>
  {%- when 'fa-heart' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 21s-7.6-4.7-10-9.4C.6 8.4 2.6 4 6.6 4c2.2 0 3.6 1.1 5.4 3.2C13.8 5.1 15.2 4 17.4 4c4 0 6 4.4 4.6 7.6C19.6 16.3 12 21 12 21z"/></svg>
  {%- when 'fa-circle' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><circle fill="currentColor" cx="12" cy="12" r="6"/></svg>
  {%- when 'fa-square' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><rect fill="currentColor" x="6" y="6" width="12" height="12"/></svg>
  {%- when 'fa-diamond' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3l9 9-9 9-9-9z"/></svg>
  {%- when 'fa-bolt' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>
  {%- when 'fa-moon' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  {%- when 'fa-check' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" d="M4 12.5l5 5L20 6.5"/></svg>
  {%- when 'fa-plus' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
  {%- when 'fa-arrow-right' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M4 12h15M13 6l6 6-6 6"/></svg>
  {%- when 'fa-leaf' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20 4C9 4 4 9 4 16c0 1.4.3 2.7.8 4 1.7-5 5.2-8.2 10.2-9.5-4 2-6.8 5-8 9 .9.3 1.9.5 3 .5 7 0 10-6 10-16z"/></svg>
  {%- when 'fa-fire' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 2-5 3-6 0 2 1 3 2 3 0-4 0-6 1-9z"/></svg>
  {%- when 'fa-gift' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 8h18v5H3zM5 14h6v8H5zM13 14h6v8h-6zM11 8h2v5h-2zM12 8c-2-5-7-5-7-2s5 2 7 2zm0 0c2-5 7-5 7-2s-5 2-7 2z"/></svg>
  {%- when 'fa-truck' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M1 5h13v11H1zM15 9h4l4 4v3h-8zM6 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm12 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
  {%- when 'fa-snowflake' -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7"/></svg>
  {%- when 'none' -%}
  {%- else -%}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><circle fill="currentColor" cx="12" cy="12" r="4.5"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"/></svg>
{%- endcase -%}
</template>