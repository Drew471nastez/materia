<template compat="shopify">
{%- comment -%}
  Materia Themes. Theme settings > Typography for this section. Printed first
  in the section, so the section's own rules (sizes, a heading size setting)
  still come after it; what it sets is the theme's: fonts, weights, line
  spacing, letter spacing and capitalisation, all as CSS variables, so a
  change in the builder reaches the section without a redraw.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} {
    font-family: var(--body-font, inherit);
    font-size: var(--body-font-size, inherit);
    font-weight: var(--body-weight, inherit);
    line-height: var(--body-line-height, inherit);
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
    font-weight: var(--heading-weight, inherit);
    letter-spacing: var(--heading-letter-spacing, normal);
    line-height: var(--heading-line-height, 1.2);
    text-transform: var(--heading-text-transform, none);
  }
  {%- unless settings.theme_font_priority == false %}
  #shopify-section-{{ section.id }} :where(.subheading, .sub-heading, [class*='__subheading']) {
    font-weight: var(--subheading-weight, 500);
  }
  {%- endunless %}
{% comment %}{% endcomment %}</style>
</template>
