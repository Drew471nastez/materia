<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared paint for the text-grid Image and video sections
  (Image With Text Bento, Image With Icons, Image With Text Multirow, Image
  With Text Grid). Prints, inside the section's own <style>: the section
  margins, the custom font faces and the base rules that read the --tg-*
  variables the section root carries. media-live-text-grid.js writes the
  same variables live, so the first paint and an edited paint match.
  The margins go in their own <style data-tg-margins> so the controller can
  switch them off live:
  <style data-tg-margins>{% render 'media-tg-base', st: st, sid: sid, bp: 768, part: 'margins' %}</style>
  <style>{% render 'media-tg-base', st: st, sid: sid, bp: 768 %} ...section rules... </style>
{%- endcomment -%}
{%- liquid
  assign mt_m = st.section_margin_top_mobile | default: 0
  assign mb_m = st.section_margin_bottom_mobile | default: 0
  assign mt_d = st.section_margin_top_desktop | default: 0
  assign mb_d = st.section_margin_bottom_desktop | default: 0
  assign use_margins = false
  if st.reset_spacing or mt_m != 0 or mb_m != 0 or mt_d != 0 or mb_d != 0
    assign use_margins = true
  endif
-%}
{%- if part == 'margins' -%}
{%- if use_margins -%}
#shopify-section-{{ sid }}#shopify-section-{{ sid }}{margin-top:{{ mt_m }}px !important;margin-bottom:{{ mb_m }}px !important}
@media (min-width: {{ bp }}px){#shopify-section-{{ sid }}#shopify-section-{{ sid }}{margin-top:{{ mt_d }}px !important;margin-bottom:{{ mb_d }}px !important}}
{%- endif -%}
{%- else -%}
{%- if st.enable_custom_fonts -%}
  {%- if st.heading_font.family != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if st.body_font.family != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
{%- endif %}
#shopify-section-{{ sid }} .tg, #shopify-section-{{ sid }} .tg *, #shopify-section-{{ sid }} .tg *::before, #shopify-section-{{ sid }} .tg *::after { box-sizing: border-box; }
#shopify-section-{{ sid }} .tg {
  background: var(--tg-bg, var(--gradient-background, var(--color-background)));
  color: var(--tg-text, var(--color-text));
  font-family: var(--tg-bf, var(--body-font));
  font-weight: var(--tg-bw, var(--body-weight, 400));
  padding: var(--tg-pt-m) var(--tg-px-m) var(--tg-pb-m);
  margin: 0;
}
@media (min-width: {{ bp }}px) {
  #shopify-section-{{ sid }} .tg { padding: var(--tg-pt-d) var(--tg-px-d) var(--tg-pb-d); }
}
#shopify-section-{{ sid }} .tg__inner { width: 100%; max-width: var(--tg-maxw, none); margin-inline: auto; }
@media (min-width: 1200px) {
  #shopify-section-{{ sid }} .tg__inner { padding-inline: var(--tg-stretch, 0px); }
}
#shopify-section-{{ sid }} .tg :is(p, div, span, li, a, button) { font-family: inherit; }
#shopify-section-{{ sid }} .tg .tg__h { font-family: var(--tg-hf, var(--heading-font)); font-weight: var(--tg-hw, var(--heading-weight, 700)); }
#shopify-section-{{ sid }} .tg [data-theme-button] { font-family: var(--btn-font, var(--tg-bf, var(--body-font))) !important; }
#shopify-section-{{ sid }} .tg [hidden] { display: none !important; }
#shopify-section-{{ sid }} .tg img.tg__ph { object-fit: contain !important; padding: 18%; }
#shopify-section-{{ sid }} .tg :focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
{%- endif -%}
</template>
