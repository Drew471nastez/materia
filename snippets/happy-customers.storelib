<template compat="shopify">
{%- comment -%}
  Materia Themes — Happy Customers block.
  Avatar row + heading + stars row. Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'happy-customers-' | append: block.id
  assign placeholder = 'https://numedicousa.com/wp-content/uploads/2022/02/placeholder.jpg'
  assign avatar_count = s.avatar_count | default: 4
  assign avatar_size = s.avatar_size | default: 40
  assign overlap = s.avatar_overlap | default: 35
  assign filled_count = s.filled_stars | default: 5
  assign total_stars = s.total_stars | default: 5
  assign star_size = s.star_size | default: 14
  assign filled_color = s.filled_color | default: '#22c55e'
  assign unfilled_color = s.unfilled_color | default: '#e5e7eb'
  assign hc_full = filled_count | floor
  assign hc_frac = filled_count | minus: hc_full
  assign hc_has_half = false
  if hc_frac >= 0.5
    assign hc_has_half = true
  endif
  assign hc_half_idx = hc_full | plus: 1
  assign font_size_d = s.font_size_desktop | default: 16
  assign font_size_m = s.font_size_mobile | default: 14
  assign text_color = s.text_color
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 12 }}px;
    padding-bottom: {{ s.padding_bottom | default: 12 }}px;
  }
  #{{ block_id }} .hc-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
  }
  #{{ block_id }} .hc-avatars {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }
  #{{ block_id }} .hc-avatar {
    width: {{ avatar_size }}px;
    height: {{ avatar_size }}px;
    min-width: {{ avatar_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-background, #fff);
    box-sizing: border-box;
    background: #e5e7eb;
    flex: 0 0 auto;
    position: relative;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.05);
  }
  #{{ block_id }} .hc-avatar + .hc-avatar {
    margin-left: calc(-1 * {{ avatar_size }}px * {{ overlap }} / 100);
  }
  #{{ block_id }} .hc-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 50%;
  }
  #{{ block_id }} .hc-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1 1 auto;
  }
  #{{ block_id }} .hc-heading {
    font-size: {{ font_size_m }}px;
    font-weight: {{ s.font_weight | default: '600' }};
    line-height: 1.2;
    {% if text_color != blank %}color: {{ text_color }};{% endif %}
  }
  @media (min-width: 750px) {
    #{{ block_id }} .hc-heading { font-size: {{ font_size_d }}px; }
  }
  #{{ block_id }} .hc-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  #{{ block_id }} .hc-star {
    width: {{ star_size }}px;
    height: {{ star_size }}px;
    display: inline-block;
    color: {{ unfilled_color }};
    flex: 0 0 auto;
  }
  #{{ block_id }} .hc-star.is-filled { color: {{ filled_color }}; }
  #{{ block_id }} .hc-star.is-half {
    color: {{ unfilled_color }};
    position: relative;
  }
  #{{ block_id }} .hc-star.is-half::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 50%;
    overflow: hidden;
    background: {{ filled_color }};
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>");
            mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg>");
    -webkit-mask-size: {{ star_size }}px {{ star_size }}px;
            mask-size: {{ star_size }}px {{ star_size }}px;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: left center;
            mask-position: left center;
    pointer-events: none;
  }
  #{{ block_id }} .hc-star svg { width: 100%; height: 100%; display: block; }
  #{{ block_id }} .hc-rating-text {
    font-size: {{ font_size_m | minus: 2 }}px;
    margin-left: 6px;
    font-weight: 600;
    {% if text_color != blank %}color: {{ text_color }};{% endif %}
  }
  @media (min-width: 750px) {
    #{{ block_id }} .hc-rating-text { font-size: {{ font_size_d | minus: 2 }}px; }
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="happy-customers-block" {{ block.shopify_attributes }}>
  <div class="hc-row">
    {%- if s.show_avatars -%}
      <div class="hc-avatars" aria-hidden="true">
        {%- for i in (1..6) -%}
          {%- if forloop.index > avatar_count -%}{%- break -%}{%- endif -%}
          {%- assign img_src = '' -%}
          {%- if forloop.index == 1 %}{%- assign img_src = s.avatar_1 -%}{%- endif -%}
          {%- if forloop.index == 2 %}{%- assign img_src = s.avatar_2 -%}{%- endif -%}
          {%- if forloop.index == 3 %}{%- assign img_src = s.avatar_3 -%}{%- endif -%}
          {%- if forloop.index == 4 %}{%- assign img_src = s.avatar_4 -%}{%- endif -%}
          {%- if forloop.index == 5 %}{%- assign img_src = s.avatar_5 -%}{%- endif -%}
          {%- if forloop.index == 6 %}{%- assign img_src = s.avatar_6 -%}{%- endif -%}
          {%- assign demo_avatar = '' -%}
          {%- if img_src == blank -%}
            {%- assign akey = block.id | append: '_avatar_' | append: forloop.index -%}
            {%- capture demo_avatar -%}{%- render 'demo-image', key: akey -%}{%- endcapture -%}
            {%- assign demo_avatar = demo_avatar | strip -%}
          {%- endif -%}
          <span class="hc-avatar">
            {%- if img_src != blank -%}
              <img src="{{ img_src | image_url: width: 200 }}" alt="" loading="lazy" width="{{ avatar_size }}" height="{{ avatar_size }}">
            {%- elsif demo_avatar != blank -%}
              <img src="{{ demo_avatar }}" alt="" loading="lazy" width="{{ avatar_size }}" height="{{ avatar_size }}">
            {%- else -%}
              <img src="{{ placeholder }}" alt="" loading="lazy" width="{{ avatar_size }}" height="{{ avatar_size }}">
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="hc-text-wrap">
      {%- if s.heading != blank -%}
        <span class="hc-heading">{{ s.heading }}</span>
      {%- endif -%}
      {%- if s.show_stars -%}
        <span class="hc-stars" aria-label="{{ filled_count }} out of {{ total_stars }} stars">
          {%- for n in (1..total_stars) -%}
            {%- assign idx = forloop.index -%}
            {%- assign cls = '' -%}
            {%- if idx <= hc_full -%}
              {%- assign cls = 'is-filled' -%}
            {%- else -%}
              {%- if hc_has_half and idx == hc_half_idx -%}
                {%- assign cls = 'is-half' -%}
              {%- endif -%}
            {%- endif -%}
            <span class="hc-star {{ cls }}">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </span>
          {%- endfor -%}
          {%- if s.show_rating_text and s.rating_text != blank -%}
            <span class="hc-rating-text">{{ s.rating_text }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </div>
</div>

</template>