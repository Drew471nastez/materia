<template compat="shopify">
{%- comment -%}
  Materia Themes. A font picker value as a CSS font-family list when on is
  true and a font is chosen; the theme variable (fallback) otherwise.
  {% render 'logos-font', font: st.heading_font, on: st.enable_custom_fonts, fallback: 'var(--heading-font)' %}
  weight: true prints the font's weight instead (fallback is then the theme weight).
{%- endcomment -%}
{%- if on and font.family != blank -%}
  {%- if weight -%}{{ font.weight | default: fallback }}{%- else -%}{{ font.family }}, {{ font.fallback_families | default: 'sans-serif' }}{%- endif -%}
{%- else -%}{{ fallback }}{%- endif -%}
</template>
