<template compat="shopify">
{%- assign counter_product = product | default: page.product -%}
{%- if counter_product.id != blank -%}
<template data-product-counter-source="{{ counter_product.id }}" data-sold="{{ counter_product.metafields.custom.sold_count.value | default: counter_product.metafields.custom.sold_count | escape }}"></template>
{%- endif -%}
</template>
