<template compat="shopify">
{%- assign s = section.settings -%}
<style>
{% if kind == 'brand-info' %}
{% for block in section.blocks %}{% assign b = block.settings %}
#shopify-section-{{ section.id }} #editorial-{{ section.id }} .ed-{{ block.id }}{% if block.type == 'link' %} a{% endif %}{font-weight:{% if b.font_weight == 'theme' or b.font_weight == blank %}{% if block.type == 'heading' %}var(--heading-weight,700){% else %}var(--body-weight,400){% endif %}{% else %}{{ b.font_weight }}{% endif %}!important}
{% if block.type == 'link' %}#shopify-section-{{ section.id }} #editorial-{{ section.id }} .ed-{{ block.id }} a:hover{--ec-link-current:var(--ec-link-hover,var(--ed-link-hover));color:var(--ec-link-hover,var(--ed-link-hover))!important;opacity:1}{% endif %}
{% endfor %}
{% elsif kind == 'inline-image-heading' %}
#shopify-section-{{ section.id }} .iih {container-type:inline-size;background:{% if s.enable_custom_style %}{% render 'scheme-color', color:s.section_background, fallback:'var(--color-background)' %}{% else %}var(--color-background){% endif %}!important}
#shopify-section-{{ section.id }} .iih__heading {color:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.heading_color,fallback:'var(--color-heading)' %}{% else %}var(--color-heading){% endif %}!important}
#shopify-section-{{ section.id }} .iih__eyebrow {color:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.eyebrow_color,fallback:'var(--color-text)' %}{% else %}var(--color-text){% endif %}!important}
{% else %}
#qb-{{ section.id }}{--qb-bg:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.bg_color,fallback:'var(--color-primary)' %}{% else %}var(--color-primary){% endif %};--qb-radius:{% if s.enable_custom_style %}{{ s.radius }}px{% else %}var(--rounded-radius,0px){% endif %};background:{% if s.enable_custom_style %}{% render 'scheme-color',color:s.section_bg,fallback:'var(--color-background)' %}{% else %}var(--color-background){% endif %}!important}
#qb-{{ section.id }} :is(.qb-wrap,.qb-card){box-sizing:border-box}
{% for block in section.blocks %}{% if block.type == 'quote' %}#qb-{{ section.id }}{--qb-quote-color:{% if block.settings.enable_custom_style %}{% render 'scheme-color',color:block.settings.quote_color,fallback:'var(--color-background)' %}{% else %}var(--color-primary-contrast,var(--color-background)){% endif %}!important}{% elsif block.type == 'author' %}#qb-{{ section.id }}{--qb-author-color:{% if block.settings.enable_custom_style %}{% render 'scheme-color',color:block.settings.author_color,fallback:'var(--color-background)' %}{% else %}var(--color-primary-contrast,var(--color-background)){% endif %}!important}{% endif %}{% endfor %}
{% endif %}
@media(prefers-reduced-motion:reduce){[data-editorial-controls="{{ kind }}"],[data-editorial-controls="{{ kind }}"] *{animation:none!important;transition:none!important}}
</style>
</template>
