<template compat="shopify">
{%- comment -%}
  Materia Themes. Mega menu + categories (header block menu_categories).
  The chosen collections as categories, each a link with its picture, title
  and product count, beside the menu link's own sub links and an optional
  banner. A list or tiles on desktop; one tappable list in the phone drawer.
  Inputs: block_st (the block's settings), link (the top-level menu link).
  Styles: navigation.css (.mm-cats).
{%- endcomment -%}
{%- liquid
  assign mc_layout = block_st.layout | default: 'list'
  assign mc_img = block_st.image_style | default: 'circle'
  assign mc_size = block_st.image_size | default: 56
  assign mc_cols = block_st.columns | default: 3
  assign mc_thumb_w = mc_size | times: 2
  if mc_layout == 'tiles'
    assign mc_thumb_w = mc_size | times: 3
  endif
  assign mc_links = false
  if block_st.show_links != false and link.links.size > 0
    assign mc_links = true
  endif
  capture mc_style
    echo '--mm-cats-cols: ' | append: mc_cols | append: '; --mm-cats-img: ' | append: mc_size | append: 'px;'
    if block_st.title_color != blank and block_st.title_color.alpha != 0
      echo ' --mm-cats-title: ' | append: block_st.title_color | append: ';'
    endif
    if block_st.count_color != blank and block_st.count_color.alpha != 0
      echo ' --mm-cats-count: ' | append: block_st.count_color | append: ';'
    endif
    if block_st.item_bg != blank and block_st.item_bg.alpha != 0
      echo ' --mm-cats-item-bg: ' | append: block_st.item_bg | append: ';'
    endif
  endcapture
-%}
<div class="mm-cats mm-cats--{{ mc_layout }}{% if mc_links %} mm-cats--links{% endif %}{% if block_st.banner_image != blank %} mm-cats--banner{% endif %}" style="{{ mc_style | strip }}">
  {%- if mc_links -%}
    <div class="menu-list mm-cats__links" style="--row-gap: 24px; --col-desktop: 1;">
      {%- render 'submenu-list', link: link -%}
    </div>
  {%- endif -%}
  <div class="mm-cats__body">
    {%- if block_st.heading != blank -%}
      <p class="mm-cats__heading">{{ block_st.heading | escape }}</p>
    {%- endif -%}
    {%- if block_st.collection_list != blank -%}
      <ul class="mm-cats__grid list-unstyled" role="list">
        {%- for mc_collection in block_st.collection_list -%}
          {%- assign mc_count = mc_collection.products_count | default: mc_collection.all_products_count -%}
          <li>
            <a class="mm-cats__item no-underline" href="{{ mc_collection.url }}">
              {%- if mc_img != 'none' -%}
                <span class="mm-cats__img mm-cats__img--{{ mc_img }}" aria-hidden="true">
                  {%- if mc_collection.featured_image != blank -%}
                    {{ mc_collection.featured_image | image_url: width: mc_thumb_w | image_tag: loading: 'lazy', decoding: 'async', alt: '', width: mc_thumb_w, height: mc_thumb_w }}
                  {%- else -%}
                    <span class="mm-cats__initial">{{ mc_collection.title | slice: 0 | upcase }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
              <span class="mm-cats__text">
                <span class="mm-cats__title">{{ mc_collection.title | escape }}</span>
                {%- if block_st.show_count != false and mc_count > 0 -%}
                  <span class="mm-cats__count">{{ mc_count }} {{ block_st.count_label | default: 'products' | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="mm-cats__empty">Choose collections in this block to show them here as categories.</p>
    {%- endif -%}
    {%- if block_st.view_all_label != blank and block_st.view_all_url != blank -%}
      <a class="mm-cats__all no-underline" href="{{ block_st.view_all_url }}">
        <span>{{ block_st.view_all_label | escape }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
  </div>
  {%- if block_st.banner_image != blank -%}
    {%- assign mc_banner_alt = block_st.banner_image.alt | default: block_st.banner_heading | default: link.title | escape -%}
    <a class="mm-cats__banner no-underline"{% if block_st.banner_link != blank %} href="{{ block_st.banner_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
      <span class="mm-cats__banner-media">
        {% render 'responsive-image',
          type: 'other',
          image: block_st.banner_image,
          image_alt: mc_banner_alt,
          custom_widths: '720, 540, 360',
          sizes: '(min-width: 1025px) 280px, 90vw'
        %}
      </span>
      {%- if block_st.banner_heading != blank -%}
        <span class="mm-cats__banner-heading">{{ block_st.banner_heading | escape }}</span>
      {%- endif -%}
      {%- if block_st.banner_button != blank -%}
        <span class="btn btn-primary mm-cats__banner-btn" data-theme-button="primary">{{ block_st.banner_button | escape }}</span>
      {%- endif -%}
    </a>
  {%- endif -%}
</div>
</template>
