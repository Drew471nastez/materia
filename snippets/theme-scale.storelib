<template compat="shopify">
{%- comment -%}
  Materia Themes. Theme settings > Scale: one size for the whole site on
  phones (below 768px), tablets (768px to 1024px) and desktops (1025px and
  up), with text and spacing adjustable on their own.

  --sl-text-scale multiplies the root font size (every rem in the theme: the
  heading sizes h0 to h6 and most of critical.css) and the body, button and
  section heading text sizes, and --responsive-rate, the fluid part of the
  heading sizes. --sl-space-scale multiplies the shared spacing
  variables: space between sections, side padding, grid gaps, button padding,
  field and icon button heights, and the content widths. No CSS zoom: fixed
  and sticky elements, popovers, sliders and pictures keep measuring the page
  as it is. At 100% every multiplier is 1 and each value computes exactly as
  the theme wrote it.

  Rendered after theme-controls so these definitions are the ones that
  count. The builder's live preview (snippets/theme-live) writes the five
  --sl-scale-* values on <html> while a slider moves, and writes the base
  values it changes (body text size, button padding...) multiplied the same
  way, so a scale and a base value can be dragged in any order.
{%- endcomment -%}
{%- liquid
  assign scale_d = settings.theme_scale_desktop | default: 100 | divided_by: 100.0
  assign scale_t = settings.theme_scale_tablet | default: 100 | divided_by: 100.0
  assign scale_m = settings.theme_scale_mobile | default: 100 | divided_by: 100.0
  assign scale_text = settings.theme_scale_text | default: 100 | divided_by: 100.0
  assign scale_space = settings.theme_scale_spacing | default: 100 | divided_by: 100.0
  assign ts = ' * var(--sl-text-scale, 1))'
  assign ss = ' * var(--sl-space-scale, 1))'
-%}
<style>
  :root {
    --sl-scale-desktop: {{ scale_d }};
    --sl-scale-tablet: {{ scale_t }};
    --sl-scale-mobile: {{ scale_m }};
    --sl-scale-text: {{ scale_text }};
    --sl-scale-space: {{ scale_space }};
    --sl-scale: var(--sl-scale-mobile);
    --sl-text-scale: calc(var(--sl-scale) * var(--sl-scale-text));
    --sl-space-scale: calc(var(--sl-scale) * var(--sl-scale-space));
    --body-font-size: calc({{ settings.body_font_size }}px{{ ts }};
    --btn-font-size: calc({{ settings.btn_font_size | default: 14 }}px{{ ts }};
    --section-heading-size: calc(32px * var(--heading-font-scale, 1){{ ts }};
    --responsive-rate: (((100vw - 575px) / (1600 - 575)) * var(--sl-text-scale, 1));
    --btn-padding-y: calc({{ settings.btn_padding_y | default: 14 }}px{{ ss }};
    --btn-padding-x: calc({{ settings.btn_padding_x | default: 26 }}px{{ ss }};
    --theme-button-padding-y: calc({{ settings.btn_padding_y | default: 14 }}px{{ ss }};
    --theme-button-padding-x: calc({{ settings.btn_padding_x | default: 26 }}px{{ ss }};
    --icon-btn-size: calc({{ settings.icon_btn_size | default: 44 }}px{{ ss }};
    --input-height: calc({{ settings.field_height | default: 50 }}px{{ ss }};
    --input-padding: 1rem calc({{ settings.field_padding_x | default: 16 }}px{{ ss }};
    --container-gutter: calc({{ settings.container_gutter | default: 30 }}px{{ ss }};
    --page-width: calc({{ settings.page_width }}px{{ ss }};
    --theme-page-width: var(--page-width);
    --fluid-container-width: calc({{ settings.fluid_container_width }}px{{ ss }};
    --section-spacing: calc(var(--sl-live-space-mobile, {{ settings.space_mobile }}px){{ ss }};
    --grid-gap: calc(var(--sl-live-grid-gap-mobile, {{ settings.grid_gap_mobile | default: 12 }}px){{ ss }};
  }
  @media (min-width: 768px) {
    :root {
      --sl-scale: var(--sl-scale-tablet);
      --section-spacing: calc(var(--sl-live-space-desktop, {{ settings.spacing_desktop }}px){{ ss }};
      --grid-gap: calc(var(--sl-live-grid-gap-desktop, {{ settings.grid_gap_desktop | default: 20 }}px){{ ss }};
    }
  }
  @media (min-width: 1025px) {
    :root { --sl-scale: var(--sl-scale-desktop); }
  }
  html { font-size: calc(62.5% * var(--sl-text-scale, 1)); }
{% comment %}{% endcomment %}</style>
</template>
