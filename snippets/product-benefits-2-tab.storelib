<template compat="shopify">
{%- comment -%}
  Renders a single Product Benefits 2 "tab" block.
  Expects: block (the block object), st (section.settings), sid (section.id)
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign icon_source = bs.icon_source | default: 'icon'
-%}
<div class="pb2c__tab" {{ block.shopify_attributes }}>
  <div class="pb2c__tab-row">
    {%- if icon_source != 'none' -%}
      <span class="pb2c__tab-icon{% if bs.image_cover and icon_source == 'image' and bs.image != blank %} is-cover{% endif %}"
            style="background:{{ st.benefit_icon_box_bg | default: '#F0F0F0' }};color:{{ st.benefit_icon_color | default: '#0F0F0F' }};">
        {%- case icon_source -%}
          {%- when 'icon' -%}
            {%- render 'benefits-icon', icon: bs.icon, size: st.icon_size | default: 22 -%}
          {%- when 'image' -%}
            {%- if bs.image -%}
              <img src="{{ bs.image | image_url: width: 80 }}" alt="{{ bs.title | default: 'icon' | escape }}" loading="lazy">
            {%- endif -%}
          {%- when 'svg' -%}
            {%- if bs.svg_code != blank -%}{{ bs.svg_code }}{%- endif -%}
        {%- endcase -%}
      </span>
    {%- endif -%}
    <div class="pb2c__tab-body">
      {%- if bs.title != blank -%}
        <h3 class="pb2c__tab-title" style="color:{{ st.benefit_title_color | default: '#0F0F0F' }} !important;">
          {{ bs.title | escape }}
        </h3>
      {%- endif -%}
      {%- if bs.description != blank -%}
        <p class="pb2c__tab-desc" style="color:{{ st.benefit_desc_color | default: '#555555' }} !important;">
          {{ bs.description | escape }}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

</template>