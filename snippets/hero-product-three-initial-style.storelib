<template compat="shopify">
{%- assign s = section.settings -%}{%- assign width = s.text_column_width | default: 50 -%}{%- assign other = 100 | minus: width -%}
--hp3-max:{% case s.section_width %}{% when 'container' %}calc(var(--page-width,1300px) + 3rem){% when 'fluid_container' %}calc(var(--fluid-container-width,1500px) + 3rem){% when 'stretch_width' %}calc(100% - 32px){% else %}none{% endcase %};
--hp3-cols-layout:{% if s.image_position == 'left' %}minmax(0,{{ other }}fr) minmax(0,{{ width }}fr){% else %}minmax(0,{{ width }}fr) minmax(0,{{ other }}fr){% endif %};
--hp3-image-order-d:{% if s.image_position == 'left' %}0{% else %}2{% endif %};--hp3-image-order-m:{% if s.image_position_mobile == 'bottom' %}2{% else %}0{% endif %};
--hp3-align-d:{% case s.content_align_desktop %}{% when 'right' %}flex-end{% when 'center' %}center{% else %}flex-start{% endcase %};--hp3-align-m:{% case s.content_align_mobile %}{% when 'right' %}flex-end{% when 'center' %}center{% else %}flex-start{% endcase %};--hp3-ta-d:{{ s.content_align_desktop | default: 'left' }};--hp3-ta-m:{{ s.content_align_mobile | default: 'left' }};
--hp3-gap-d:{{ s.gap_columns | default: 64 }}px;--hp3-gap-m:{{ s.gap_columns_mobile | default: 32 }}px;--hp3-height-d:{{ s.image_height_desktop | default: 550 }}px;--hp3-height-m:{{ s.image_height_mobile | default: 320 }}px;--hp3-fit:{{ s.image_fit | default: 'cover' }};
--hp3-pt-d:{{ s.padding_top_desktop | default: 64 }}px;--hp3-pb-d:{{ s.padding_bottom_desktop | default: 64 }}px;--hp3-pl-d:{{ s.section_padding_left_desktop | default: 16 }}px;--hp3-pr-d:{{ s.section_padding_right_desktop | default: 16 }}px;--hp3-pt-m:{{ s.padding_top_mobile | default: 32 }}px;--hp3-pb-m:{{ s.padding_bottom_mobile | default: 32 }}px;--hp3-pl-m:{{ s.section_padding_left_mobile | default: 20 }}px;--hp3-pr-m:{{ s.section_padding_right_mobile | default: 20 }}px;
</template>
