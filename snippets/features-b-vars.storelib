<template compat="shopify">
{%- comment -%}
  Materia Themes. Settings as CSS variables for the features-b sections
  (Comparison Cards, Text Comparisons and the comparison tables). The same
  lists are printed on the root as data-fb-spec, so
  shopify/assets/live-features-b.js writes exactly the same variables on a
  live edit.
    s       the settings (section.settings or block.settings)
    px      "id" (px) or "id:unit" ("n" = no unit), comma separated
    c       colour ids, printed only when gate is true and the colour is set
    w       weight ids, printed unless blank or "theme"
    f       "gate:picker" pairs, printed when s[gate] is on and the picker has a family
    gate    custom styling switch for the colours
  Variables are named --fb-<id>.
{%- endcomment -%}
{%- assign fb_l = px | split: ',' -%}
{%- for fb_k in fb_l -%}
  {%- assign fb_p = fb_k | strip | split: ':' -%}
  {%- assign fb_id = fb_p[0] -%}
  {%- assign fb_u = 'px' -%}
  {%- if fb_p.size > 1 -%}{%- assign fb_u = fb_p[1] -%}{%- endif -%}
  {%- if fb_u == 'n' -%}{%- assign fb_u = '' -%}{%- endif -%}
  {%- assign fb_v = s[fb_id] -%}
  {%- if fb_v == blank and fb_v != 0 -%}{%- assign fb_v = 0 -%}{%- endif -%}
  --fb-{{ fb_id }}:{{ fb_v }}{{ fb_u }};
{%- endfor -%}
{%- if gate -%}
  {%- assign fb_l = c | split: ',' -%}
  {%- for fb_k in fb_l -%}
    {%- assign fb_id = fb_k | strip -%}
    {%- assign fb_v = s[fb_id] -%}
    {%- if fb_v != blank and fb_v.alpha != 0 and fb_v != 'transparent' and fb_v != 'rgba(0,0,0,0)' and fb_v != 'rgba(0, 0, 0, 0)' and fb_v != '#00000000' -%}--fb-{{ fb_id }}:{{ fb_v }};{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign fb_l = w | split: ',' -%}
{%- for fb_k in fb_l -%}
  {%- assign fb_id = fb_k | strip -%}
  {%- assign fb_v = s[fb_id] -%}
  {%- if fb_v != blank and fb_v != 'theme' -%}--fb-{{ fb_id }}:{{ fb_v }};{%- endif -%}
{%- endfor -%}
{%- assign fb_l = f | split: ',' -%}
{%- for fb_k in fb_l -%}
  {%- assign fb_p = fb_k | strip | split: ':' -%}
  {%- assign fb_g = fb_p[0] -%}
  {%- assign fb_id = fb_p[1] -%}
  {%- assign fb_v = s[fb_id] -%}
  {%- if s[fb_g] and fb_v.family != blank -%}--fb-{{ fb_id }}:{{ fb_v.family }}, {{ fb_v.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endfor -%}
</template>
