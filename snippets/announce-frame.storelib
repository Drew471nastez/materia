<template compat="shopify">
{%- comment -%}
  Materia Themes. The section wrapper of the Announcements sections (Marquee
  Bar, Announcement Bar Basic, Pro 1 and Pro 2): its own margins (desktop and
  mobile), "Remove default space between sections" keyed on the root's
  data-reset, the section width keyed on the root's data-width, and the
  stacking under the header. shopify/assets/live-announcements.js writes the
  same values in the builder.
  {% render 'announce-frame', section: section, z: 5 %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative;{% if z != blank %} z-index: {{ z }} !important;{% endif %} }
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_mobile | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px !important; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px !important; }
  }
  #shopify-section-{{ sid }}:has(> [data-an-root][data-reset='true']) { padding-top: 0 !important; padding-bottom: 0 !important; --section-spacing: 0px; }
  #shopify-section-{{ sid }}:has(> [data-an-root][data-reset='true']) + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
  .shopify-section:has(+ #shopify-section-{{ sid }} > [data-an-root][data-reset='true']) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }} [data-an-root] { box-sizing: border-box; margin-inline: auto; width: 100%; }
  #shopify-section-{{ sid }} [data-an-root] *, #shopify-section-{{ sid }} [data-an-root] *::before, #shopify-section-{{ sid }} [data-an-root] *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} [data-an-root][data-width='container'] { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} [data-an-root][data-width='fluid_container'] { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} [data-an-root][data-width='stretch_width'] { max-width: calc(100% - 3rem); }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} [data-an-root][data-width='stretch_width'] { max-width: calc(100% - 6rem); } }
  #shopify-section-{{ sid }} [data-an-root] [hidden], #shopify-section-{{ sid }} [data-an-root][hidden] { display: none !important; }
  #shopify-section-{{ sid }} [data-an-root] :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
{% comment %}{% endcomment %}</style>
</template>
