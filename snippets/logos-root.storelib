<template compat="shopify">
{%- comment -%}
  Materia Themes. The root attributes (part: 'attrs') and shared CSS
  variables (part: 'vars') of the Logos and trust sections; live-logos.js
  derives the same values in the builder.
  attrs: type, width, fonts (custom fonts on). The settings JSON is for
  live-logos.js in the builder only, except Brand info, whose runtime reads it.
  vars: custom (custom styling on), bg, text, heading (colour settings),
  fonts, hfont, bfont (font pickers), pt_d, pb_d, pt_m, pb_m, px_d, px_m (px).
{%- endcomment -%}
{%- if part == 'attrs' -%}
data-lg-root="{{ type }}" data-lg-section="{{ section.id }}"{% if request.design_mode or type == 'brand-info' %} data-lg-settings="{{ section.settings | json | escape }}"{% endif %} data-width="{{ width }}"{% if section.settings.reset_spacing != nil %} data-reset="{% if section.settings.reset_spacing %}true{% else %}false{% endif %}"{% endif %}{% if fonts %} data-own-font data-own-weight{% endif %}
{%- else -%}
--lg-bg: {% if custom %}{% render 'scheme-color', color: bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--lg-text: {% if custom %}{% render 'scheme-color', color: text, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--lg-heading: {% if custom %}{% render 'scheme-color', color: heading, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--lg-hf: {% render 'logos-font', font: hfont, on: fonts, fallback: 'var(--heading-font)' %};--lg-bf: {% render 'logos-font', font: bfont, on: fonts, fallback: 'var(--body-font)' %};--lg-hw: {% render 'logos-font', font: hfont, on: fonts, weight: true, fallback: 'var(--heading-weight)' %};--lg-bw: {% render 'logos-font', font: bfont, on: fonts, weight: true, fallback: 'var(--body-weight)' %};--lg-pt-d: {{ pt_d | default: 0 }}px;--lg-pb-d: {{ pb_d | default: 0 }}px;--lg-pt-m: {{ pt_m | default: 0 }}px;--lg-pb-m: {{ pb_m | default: 0 }}px;--lg-px-d: {{ px_d | default: 0 }}px;--lg-px-m: {{ px_m | default: 0 }}px;
{%- endif -%}
</template>
