<template compat="shopify">
{%- comment -%}
  Prints a colour setting. An empty or fully transparent colour prints the
  fallback, which is a theme colour-scheme variable. Storelib writes the
  transparent default as "rgba(0, 0, 0, 0)" (with spaces), so both spellings
  count as transparent.
  {% render 'scheme-color', color: section.settings.bg_color, fallback: 'var(--color-background)' %}
{%- endcomment -%}
{%- liquid
  assign scheme_color_out = fallback | default: 'var(--color-primary)'
  if color != blank and color.alpha != 0 and color != 'transparent' and color != 'rgba(0,0,0,0)' and color != 'rgba(0, 0, 0, 0)' and color != '#00000000'
    assign scheme_color_out = color
  endif
-%}{{ scheme_color_out -}}
</template>
