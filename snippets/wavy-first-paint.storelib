<template compat="shopify">
{% comment %}Critical geometry: match the deferred controller before any external assets arrive.{% endcomment %}
{% assign s = section.settings %}
<style>
#shopify-section-{{ section.id }}#shopify-section-{{ section.id }}{
  margin-top:{{ s.section_margin_top_mobile | default:0 }}px!important;
  margin-bottom:{{ s.section_margin_bottom_mobile | default:0 }}px!important;
}
#shopify-section-{{ section.id }}:has([data-text-controls="wavyrichtextbanner"][data-tx-reset-spacing="true"]){padding-top:0!important;padding-bottom:0!important}
#shopify-section-{{ section.id }} .LoudzWavesBox{position:relative;overflow:hidden}
#shopify-section-{{ section.id }} .LoudzWavesBox__Wave svg{display:block;height:48px;width:100%;overflow:hidden}
#shopify-section-{{ section.id }} .LoudzTextBox__Description{font-size:calc(var(--block-description-size,16px)*.88)}
@media(min-width:768px){#shopify-section-{{ section.id }}#shopify-section-{{ section.id }}{margin-top:{{ s.section_margin_top_desktop | default:0 }}px!important;margin-bottom:{{ s.section_margin_bottom_desktop | default:0 }}px!important}}
@media(min-width:992px){#shopify-section-{{ section.id }} .LoudzWavesBox__Wave svg{height:96px}#shopify-section-{{ section.id }} .LoudzTextBox__Description{font-size:var(--block-description-size,16px)}}
</style>
</template>
