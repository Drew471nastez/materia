<template compat="shopify">
{%- comment -%}
  Materia Themes. The text column of Hero Split and Hero Collage: eyebrow,
  heading, text and button blocks, drawn in the creator's order. Buttons that
  follow each other share one row. Each block carries its id and type (and,
  in the builder, its settings) for live-r7-hero.js, and prints only the
  values its own switches turn on, so everything else is the theme's.
  An element whose own weight, size or button shape switch is on carries
  data-own-weight, data-own-size or data-own-shape, so Theme settings >
  Typography "Use in every section" and the shared button shape leave it to
  its own values.
  Use: render 'r7-hero-text', section: section, tag: 'h2', name: 'Hero Split'
{%- endcomment -%}
{%- liquid
  assign r7_row = false
  assign r7_shown = 0
  assign r7_tag = tag | default: 'h2'
-%}
<div class="r7h__stack">
{%- for block in section.blocks -%}
  {%- if block.hidden -%}{%- continue -%}{%- endif -%}
  {%- if block.type != 'eyebrow' and block.type != 'heading' and block.type != 'subheading' and block.type != 'button' -%}{%- continue -%}{%- endif -%}
  {%- assign b = block.settings -%}
  {%- assign r7_shown = r7_shown | plus: 1 -%}
  {%- if block.type != 'button' and r7_row -%}</div>{%- assign r7_row = false -%}{%- endif -%}
  {%- capture r7_attrs %} data-r7h-block="{{ block.id }}" data-r7h-type="{{ block.type }}"{% if request.design_mode %} data-r7h-block-settings="{{ b | json | escape }}"{% endif %} {{ block.shopify_attributes }}{% endcapture -%}
  {%- case block.type -%}
    {%- when 'eyebrow' -%}
      <p class="r7h__eyebrow"{{ r7_attrs }}{% if b.text == blank %} hidden{% endif %} style="{% if b.enable_custom_style %}--r7h-color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-text)' %};{% endif %}{% if b.size_enable %}--r7h-size:{{ b.size }}px;{% endif %}">{{ b.text | escape }}</p>
    {%- when 'heading' -%}
      <{{ r7_tag }} class="r7h__heading"{{ r7_attrs }}{% if b.weight_enable %} data-own-weight{% endif %}{% if b.size_enable %} data-own-size{% endif %}{% if b.text == blank %} hidden{% endif %} style="{% if b.enable_custom_style %}--r7h-color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-heading)' %};{% endif %}{% if b.weight_enable %}--r7h-weight:{{ b.weight }};{% endif %}{% if b.size_enable %}--r7h-size-d:{{ b.size_desktop }}px;--r7h-size-m:{{ b.size_mobile }}px;--r7h-lh:{{ b.line_height }};--r7h-ls:{{ b.tracking }}px;{% endif %}">{{ b.text }}</{{ r7_tag }}>
    {%- when 'subheading' -%}
      <div class="r7h__text"{{ r7_attrs }}{% if b.text == blank %} hidden{% endif %} style="{% if b.enable_custom_style %}--r7h-color:{% render 'scheme-color', color: b.color, fallback: 'var(--color-text)' %};{% endif %}{% if b.size_enable %}--r7h-size:{{ b.size }}px;--r7h-lh:{{ b.line_height }};{% endif %}">{{ b.text }}</div>
    {%- when 'button' -%}
      {%- unless r7_row -%}<div class="r7h__buttons">{%- assign r7_row = true -%}{%- endunless -%}
      {%- assign r7_role = 'primary' -%}
      {%- if b.button_style == 'secondary' -%}{%- assign r7_role = 'secondary' -%}{%- endif -%}
      {%- capture r7_btn %} class="r7h__cta" data-theme-button="{{ r7_role }}" data-sl-button{{ r7_attrs }}{% if b.use_theme_button == false %} data-own-shape{% endif %}{% if b.text == blank %} hidden{% endif %} style="{% if b.enable_custom_style %}{% render 'button-overrides', bg: b.bg, text: b.color, border: b.border_color, hover_bg: b.bg_hover, hover_text: b.color_hover %}{% endif %}{% if b.use_theme_button == false %}--mb-radius:{{ b.radius }}px;--mb-padding-x:{{ b.pad_x }}px;--mb-padding-y:{{ b.pad_y }}px;--mb-font-size:{{ b.size }}px;--mb-border-width:{{ b.border_width }}px;{% endif %}"{% endcapture -%}
      {%- if b.link != blank and b.link != '#' -%}<a href="{{ b.link | url | escape }}"{{ r7_btn }}>{{ b.text | escape }}</a>{%- else -%}<button type="button"{{ r7_btn }}>{{ b.text | escape }}</button>{%- endif -%}
  {%- endcase -%}
{%- endfor -%}
{%- if r7_row -%}</div>{%- endif -%}
{%- if r7_shown == 0 and request.design_mode -%}{%- render 'hero-preview-cover', name: name -%}{%- endif -%}
</div>
</template>
