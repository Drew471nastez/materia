<template compat="shopify">
{%- comment -%}
  Materia Themes. A block's own attributes in the Logos and trust sections,
  read by live-logos.js for live edits.
{%- endcomment -%}
data-lg-block="{{ block.id }}" data-lg-type="{{ block.type }}" data-lg-settings="{{ block.settings | json | escape }}" {{ block.shopify_attributes }}
</template>
