<template compat="shopify">
{%- if controls.custom_style -%}
--offer-picker-height: {{ controls.custom_picker_height | default: 40 }}px;
--offer-picker-radius: {{ controls.custom_picker_radius | default: 6 }}px;
--offer-picker-width: {{ controls.custom_picker_width | default: 200 }}px;
{%- if controls.custom_picker_bg != blank %}--offer-picker-bg: {{ controls.custom_picker_bg }};{% endif -%}
{%- if controls.custom_picker_text != blank %}--offer-picker-text: {{ controls.custom_picker_text }};{% endif -%}
{%- if controls.custom_picker_border != blank %}--offer-picker-border: {{ controls.custom_picker_border }};{% endif -%}
{%- endif -%}
</template>
