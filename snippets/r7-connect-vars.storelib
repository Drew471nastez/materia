<template compat="shopify">
{%- comment -%}
  Materia Themes. The values r7-connect.css reads, as --r7c-* variables for
  the root's style attribute of Newsletter Split (kind: 'split') and Follow
  Us (kind: 'follow'). live-r7-connect.js derives the same list from the
  settings and writes the ones a live edit changes. Colours follow the colour
  scheme until "Enable custom styling" is on; fonts follow the theme until
  "Enable custom fonts" is on.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign own = st.enable_custom_style
-%}
--r7c-bg:{% if own %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--r7c-pt-m:{{ st.padding_top_mobile | default: 40 }}px;--r7c-pb-m:{{ st.padding_bottom_mobile | default: 40 }}px;--r7c-pt-d:{{ st.padding_top | default: 60 }}px;--r7c-pb-d:{{ st.padding_bottom | default: 60 }}px;
{%- if st.enable_custom_fonts and st.heading_font.family != blank -%}--r7c-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families }};{%- endif -%}
{%- if st.enable_custom_fonts and st.body_font.family != blank -%}--r7c-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families }};{%- endif -%}
{%- if kind == 'split' -%}
--r7c-media-w:{{ st.image_width | default: 50 }}%;--r7c-gap:{{ st.column_gap | default: 64 }}px;--r7c-done:{{ st.success_duration | default: 5 }}s;
--r7c-text:{% if own %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
{%- else -%}
--r7c-tile-gap:{{ st.image_gap | default: 12 }}px;
{%- endif -%}
</template>
