<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- unless carrier -%}{{ 'minicart.css' | asset_url | stylesheet_tag }}{%- endunless -%}
{% render 'cart-recommend-custom-button' %}
{%- unless carrier -%}{{ 'materia-experience.css' | asset_url | stylesheet_tag }}{%- endunless -%}
<style data-cart-drawer-style="size">
  #minicart_wrapper.open_drawer .minicart__wrapper {
    --materia-cart-width: {{ settings.cart_drawer_width | default: 460 }}px;
    --materia-cart-gap: {{ settings.cart_drawer_item_gap | default: 12 }}px;
    --materia-cart-control: {{ settings.cart_drawer_control_size | default: 36 }}px;
    --materia-cart-recommend-gap: {{ settings.cart_drawer_recommend_gap | default: 12 }}px;
  }
{% comment %}{% endcomment %}</style>

{%- comment -%}
  Cart-drawer colour-scheme adaptation.

  The theme's `--grey-color` is hardcoded at the document root
  (`#f5f5f5`), so any element using `grey-bg` (the cart drawer's
  bottom panel, the quantity selector wrapper, etc.) ignores the
  active colour scheme and stays a fixed light-grey. On dark schemes
  this puts white text on a light panel = invisible.

  We also see breakage when the merchant tints the scheme: the
  Subtotal heading uses `--color-heading` and the price uses
  `--color-text`, so picking colours that don't contrast with
  `#f5f5f5` makes one or the other unreadable.

  Strategy:
    1. Re-derive `--grey-color` from the SCHEME background using
       `color-mix(... var(--color-background) ...)` so the panel is
       always a soft variant of the scheme bg, not a hardcoded value.
       (The theme's CSS variable is `--color-background`, NOT
       `--color-bg` — that was the typo in the previous attempt.)
    2. Force every text element inside `grey-bg` to use scheme
       `--color-text` / `--color-heading`, overriding utility classes
       like `.heading-color` that point at the scheme heading colour
       (which on dark schemes is bright/white).
    3. Drive secondary button colours from the new scheme variables
       (added to the color scheme definition in settings_schema.json).
{%- endcomment -%}
{%- unless carrier -%}{{ 'cart-drawer-scheme.css' | asset_url | stylesheet_tag }}{%- endunless -%}
<style data-cart-drawer-style="scheme">
  {%- if settings.cart_freeship_custom_color_enable and settings.cart_freeship_fill_color != blank -%}
    cart-notification.minicart .cart_shipping__fill,
    cart-notification.minicart .percent_shipping_bar.progress,
    .minicart-form .cart_shipping__fill,
    .minicart-form .percent_shipping_bar.progress {
      background: {{ settings.cart_freeship_fill_color }} !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign theme_st = settings
  assign free_shipping = theme_st.show_on_minicart_cart_page
  assign show_currency_code = theme_st.show_currency_code
  assign action_after_add_cart = theme_st.action_after_add_cart
  assign minicart_type = 'disable'
  if theme_st.cart_drawer_recommendations
    assign minicart_type = 'show_inside'
    if theme_st.minicart_type == 'show_beside'
      assign minicart_type = 'show_beside'
    endif
  endif
  assign shipping_rate = theme_st.free_shipping_minimum | times: 1 | default: 0
  assign shipping_rate_cents = shipping_rate | times: 100
  assign shipping_rate_price = shipping_rate_cents | money
  if show_currency_code
    assign shipping_rate_price = shipping_rate_cents | money_with_currency
  endif
  assign cart_duration_show = theme_st.show_duration_on_minicart_cart_page
  assign cart_duration = theme_st.cart_duration
  assign recommendations_heading = theme_st.product_recommendations_heading
  assign product_recommendations_type = theme_st.product_recommendations_type
  assign select_product_recommendations = theme_st.select_product_recommendations
  assign hidden_price = theme_st.hidden_price
  assign drawer_terms_enabled = false
  if theme_st.enable_cart_terms
    assign drawer_terms_enabled = true
  endif
-%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if iso_code != blank and lis_language_rtl contains iso_code
      assign enable_rtl = true
    endif
  endif
%}
{%- comment -%}
  Resolve the cart drawer's colour scheme. Three layers of safety so
  the drawer ALWAYS paints the scheme bg:
    1. Pick `settings.cart_color_scheme`. If blank, fall back to the
       first scheme in `settings.color_schemes` so we never end up
       with no scheme at all.
    2. Append the `.color-{scheme.id}` class to the wrapper. The
       theme.liquid `<style>` block declares
       `body, .color-scheme-N { background-color: var(--color-background); }`
       so the wrapper picks up the scheme bg purely from this class.
    3. Belt-and-braces: emit the full set of `--color-*` vars +
       explicit `background-color` / `color` declarations as inline
       style on both `<cart-notification>` and the wrapper, so even if
       the class ID resolution gets out of sync the inline style
       still wins.
{%- endcomment -%}
{%- assign cart_scheme = settings.cart_color_scheme -%}
{%- if cart_scheme != blank and cart_scheme.settings == blank -%}
  {%- assign cart_scheme_key = cart_scheme -%}
  {%- assign cart_scheme = settings.color_schemes[cart_scheme_key] -%}
  {%- if cart_scheme == blank -%}
    {%- for candidate in settings.color_schemes -%}
      {%- if candidate.id == cart_scheme_key -%}{%- assign cart_scheme = candidate -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
{%- if cart_scheme == blank -%}
  {%- for s in settings.color_schemes -%}
    {%- assign cart_scheme = s -%}
    {%- if s.settings == blank and s.last.settings != blank -%}{%- assign cart_scheme = s.last -%}{%- endif -%}
    {%- break -%}
  {%- endfor -%}
{%- endif -%}
{%- assign cart_scheme_id = '' -%}
{%- if cart_scheme != blank -%}
  {%- assign cart_scheme_id = cart_scheme.id | default: cart_scheme_key | default: 'default' -%}
{%- endif -%}
{%- capture cart_scheme_inline -%}
  --materia-cart-width: {{ settings.cart_drawer_width | default: 460 }}px;
  --materia-cart-gap: {{ settings.cart_drawer_item_gap | default: 12 }}px;
  --materia-cart-control: {{ settings.cart_drawer_control_size | default: 36 }}px;
  --materia-cart-recommend-gap: {{ settings.cart_drawer_recommend_gap | default: 12 }}px;
  --cart-shipping-fill: {% if settings.cart_freeship_custom_color_enable and settings.cart_freeship_fill_color != blank %}{{ settings.cart_freeship_fill_color }}{% else %}var(--color-primary){% endif %};
  {%- if cart_scheme.settings -%}
    --color-background: {{ cart_scheme.settings.background }};
    --color-text: {{ cart_scheme.settings.text_color }};
    --color-heading: {{ cart_scheme.settings.heading_color }};
    --color-primary: {{ cart_scheme.settings.primary_color }};
    --color-border: {{ cart_scheme.settings.border_color }};
    --gradient-background: {% if cart_scheme.settings.background_gradient != blank %}{{ cart_scheme.settings.background_gradient }}{% else %}{{ cart_scheme.settings.background }}{% endif %};
    --btn-primary-color: {{ cart_scheme.settings.btn_primary_color }};
    --btn-primary-bg-color: {{ cart_scheme.settings.btn_primary_background }};
    --btn-primary-hover-color: {{ cart_scheme.settings.btn_primary_hover_color }};
    --btn-primary-hover-bg-color: {{ cart_scheme.settings.btn_primary_hover_background }};
    --btn-secondary-color: {{ cart_scheme.settings.btn_secondary_color | default: cart_scheme.settings.btn_outline_color }};
    --btn-secondary-bg-color: {{ cart_scheme.settings.btn_secondary_background | default: '#ffffff' }};
    --btn-secondary-border-color: {{ cart_scheme.settings.btn_secondary_border | default: cart_scheme.settings.btn_outline_border_color }};
    --btn-secondary-hover-color: {{ cart_scheme.settings.btn_secondary_hover_color | default: '#ffffff' }};
    --btn-secondary-hover-bg-color: {{ cart_scheme.settings.btn_secondary_hover_background | default: cart_scheme.settings.btn_outline_color }};
    --btn-outline-color: {{ cart_scheme.settings.btn_outline_color }};
    --btn-outline-border-color: {{ cart_scheme.settings.btn_outline_border_color }};
    background-color: {{ cart_scheme.settings.background }} !important;
    color: {{ cart_scheme.settings.text_color }} !important;
  {%- endif -%}
{%- endcapture -%}
{%- assign cart_color_scheme_class = '' -%}
{%- if cart_scheme_id != blank -%}
  {%- assign cart_color_scheme_class = ' color-' | append: cart_scheme_id -%}
{%- endif -%}
{%- liquid
  # Resolve raw hex values for the cart scheme. We use these inside
  # a <style> block below to hardcode the cart drawer paint, side-stepping
  # any CSS-variable inheritance issues (e.g. `contain: style` on a
  # parent, or a stylesheet that declares `--color-background` again
  # on `<body>` with higher specificity than `.color-scheme-X`).
  assign cart_bg_color = ''
  assign cart_text_color = ''
  assign cart_heading_color = ''
  assign cart_primary_color = ''
  assign cart_border_color = ''
  assign cart_btn_primary_color = ''
  assign cart_btn_primary_bg = ''
  assign cart_btn_primary_hover_color = ''
  assign cart_btn_primary_hover_bg = ''
  assign cart_btn_outline_color = ''
  assign cart_btn_outline_border = ''
  if cart_scheme.settings
    assign cart_bg_color = cart_scheme.settings.background
    assign cart_text_color = cart_scheme.settings.text_color
    assign cart_heading_color = cart_scheme.settings.heading_color
    assign cart_primary_color = cart_scheme.settings.primary_color
    assign cart_border_color = cart_scheme.settings.border_color
    assign cart_btn_primary_color = cart_scheme.settings.btn_primary_color
    assign cart_btn_primary_bg = cart_scheme.settings.btn_primary_background
    assign cart_btn_primary_hover_color = cart_scheme.settings.btn_primary_hover_color
    assign cart_btn_primary_hover_bg = cart_scheme.settings.btn_primary_hover_background
    assign cart_btn_outline_color = cart_scheme.settings.btn_outline_color
    assign cart_btn_outline_border = cart_scheme.settings.btn_outline_border_color
  endif
-%}
{%- if cart_bg_color != blank -%}
<style data-cart-drawer-style="paint">
  /* HARD PAINT — the cart drawer + cart popup are forced to the
     selected scheme's actual hex values. No CSS variable inheritance
     means no chance of a parent rule winning the cascade. The triple
     selector + `body &` ancestor selector pushes specificity above
     anything the theme.liquid global block can declare. */
  cart-notification.minicart,
  cart-notification.minicart .minicart__wrapper,
  cart-notification.minicart .minicart-form,
  cart-notification.minicart .cart-footer,
  cart-notification.minicart .drawer-bottom,
  body cart-notification.minicart,
  body cart-notification.minicart .minicart__wrapper,
  body cart-notification.minicart .minicart-form,
  html cart-notification.minicart,
  html cart-notification.minicart .minicart__wrapper {
    background-color: {{ cart_bg_color }} !important;
    background: {{ cart_bg_color }} !important;
    color: {{ cart_text_color }} !important;
  }
  /* Re-declare scheme variables on the cart drawer scope so any
     descendant that uses var(--color-background) etc. resolves to
     the cart scheme — not the page scheme. */
  cart-notification.minicart,
  cart-notification.minicart .minicart__wrapper,
  cart-notification.minicart .minicart-form {
    --color-background: {{ cart_bg_color }} !important;
    --color-text: {{ cart_text_color }} !important;
    --color-heading: {{ cart_heading_color }} !important;
    --color-primary: {{ cart_primary_color }} !important;
    --color-border: {{ cart_border_color }} !important;
    --gradient-background: {{ cart_bg_color }} !important;
    --btn-primary-color: {{ cart_btn_primary_color }} !important;
    --btn-primary-bg-color: {{ cart_btn_primary_bg }} !important;
    --btn-primary-hover-color: {{ cart_btn_primary_hover_color }} !important;
    --btn-primary-hover-bg-color: {{ cart_btn_primary_hover_bg }} !important;
    --btn-outline-color: {{ cart_btn_outline_color }} !important;
    --btn-outline-border-color: {{ cart_btn_outline_border }} !important;
    --grey-color: color-mix(in srgb, {{ cart_bg_color }} 93%, {{ cart_text_color }} 7%) !important;
  }
  /* All `grey-bg` regions (header sit-on, free-shipping bar, drawer
     bottom) inherit the SAME scheme background so the whole drawer
     reads as one continuous panel. The previous 7% tint created
     subtle bands between the free-ship bar / countdown / cart
     items / subtotal — merchant feedback was the drawer should be
     ONE colour, not a banded panel. Section separation is handled by
     scheme-aware hairline borders below. */
  cart-notification.minicart .grey-bg,
  cart-notification.minicart .cart_shipping.grey-bg,
  cart-notification.minicart .drawer-bottom.grey-bg,
  cart-notification.minicart .minicart__header,
  cart-notification.minicart .cart-countdown-time {
    background-color: {{ cart_bg_color }} !important;
    background: {{ cart_bg_color }} !important;
  }
  /* Hairline scheme-aware dividers replace the old `grey-bg` tint. */
  cart-notification.minicart .minicart__header {
    border-bottom: 1px solid color-mix(in srgb, {{ cart_text_color }} 12%, transparent) !important;
  }
  cart-notification.minicart .cart_shipping.border-top,
  cart-notification.minicart .cart_shipping.border-bottom,
  cart-notification.minicart .drawer-bottom.border-top {
    border-color: color-mix(in srgb, {{ cart_text_color }} 12%, transparent) !important;
  }
  /* Checkout button — cart scheme's primary. */
  cart-notification.minicart .btn-checkout,
  cart-notification.minicart .btn-checkout * {
    background-color: {{ cart_btn_primary_bg }} !important;
    color: {{ cart_btn_primary_color }} !important;
    border-color: {{ cart_btn_primary_bg }} !important;
  }
  cart-notification.minicart .btn-checkout:hover {
    background-color: {{ cart_btn_primary_hover_bg }} !important;
    color: {{ cart_btn_primary_hover_color }} !important;
  }
  /* View Cart — outline. */
  cart-notification.minicart .btn-outline.viewcart,
  cart-notification.minicart .btn-outline.viewcart * {
    color: {{ cart_btn_outline_color }} !important;
    border-color: {{ cart_btn_outline_border }} !important;
    background: transparent !important;
  }
  /* Cart drawer header — "Your Cart (X)", count bubble, and close
     icon. Pins them to the cart scheme so the title text + close
     icon stay legible regardless of which scheme the merchant picks. */
  cart-notification.minicart .minicart__header,
  cart-notification.minicart .minicart-heading,
  cart-notification.minicart .minicart-heading *,
  cart-notification.minicart .cart-count,
  cart-notification.minicart .cart-count-drawer {
    color: {{ cart_heading_color }} !important;
  }
  cart-notification.minicart .button-close,
  cart-notification.minicart .button-close svg,
  cart-notification.minicart .button-close svg use,
  cart-notification.minicart .button-close svg path,
  cart-notification.minicart .close-cart-button,
  cart-notification.minicart .close-cart-button svg,
  cart-notification.minicart .close-cart-button svg use,
  cart-notification.minicart .close-cart-button svg path {
    color: {{ cart_text_color }} !important;
    fill: currentColor !important;
    stroke: currentColor !important;
  }
  /* Reservation timer — "Your items are reserved for 01m41s". */
  cart-notification.minicart .cart-countdown-time,
  cart-notification.minicart .cart-countdown-time *,
  cart-notification.minicart countdown-timer,
  cart-notification.minicart countdown-timer *,
  cart-notification.minicart .countdown-inner,
  cart-notification.minicart .countdown-inner * {
    color: {{ cart_text_color }} !important;
  }
  cart-notification.minicart .border-bottom-dashed {
    border-bottom-color: color-mix(in srgb, {{ cart_text_color }} 20%, transparent) !important;
  }
  /* Empty cart state — title, description, and Continue Shopping
     button (uses .btn-primary so the global button rule already
     pins it; we only need to pin the empty-state TEXT here). */
  cart-notification.minicart .cart-empty,
  cart-notification.minicart .cart-empty *,
  cart-notification.minicart .cart-body,
  cart-notification.minicart .cart-body :is(h1, h2, h3, h4, h5, h6, p, span, div):not(.btn-primary):not(.btn-primary *):not(.minicart-action):not(.minicart-action *) {
    color: {{ cart_text_color }} !important;
  }
  cart-notification.minicart .cart-empty :is(h1, h2, h3, h4, h5, h6, .h6) {
    color: {{ cart_heading_color }} !important;
  }
  /* The empty-cart icon SVG had hardcoded stroke="#C9CCD1" — pin to
     scheme text so it reads on every scheme. */
  cart-notification.minicart .cart-empty__icon,
  cart-notification.minicart .cart-empty__icon path {
    stroke: color-mix(in srgb, {{ cart_text_color }} 35%, transparent) !important;
  }
  /* Continue Shopping button (.btn-primary.minicart-action) —
     ensure the cart scheme's button-primary customiser drives the
     colours, not the page-default scheme. */
  cart-notification.minicart .minicart-action.btn-primary,
  cart-notification.minicart .minicart-action.btn-primary * {
    background-color: {{ cart_btn_primary_bg }} !important;
    color: {{ cart_btn_primary_color }} !important;
    border-color: {{ cart_btn_primary_bg }} !important;
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
{% if template != 'cart' and action_after_add_cart != 'go_to_cart_page' %}
  <cart-notification data-cart-drawer-version="20261021-2"
    data-show-quantity="{{ settings.cart_drawer_show_quantity }}"
    data-show-shipping-estimator="{{ settings.cart_drawer_show_shipping_estimator }}"
    data-show-free-shipping="{{ settings.show_on_minicart_cart_page }}"
    id="minicart_wrapper" class="minicart {{ action_after_add_cart }} bls-image-js{{ cart_color_scheme_class }}" style="{{ cart_scheme_inline | strip | strip_newlines }}">

    <div class="minicart__wrapper flex flex-column color-default{{ cart_color_scheme_class }} {% if action_after_add_cart == 'open_drawer' %} bls__drawer fixed z-15 inset-y-0 h-full transition-popup{% if enable_rtl %} right left-0{% else %} left right-0{% endif %}{% endif %}{% if action_after_add_cart == 'show_popup' %} popup_cart invisible absolute z-10 transition-popup right-0 rounded shadow{% endif %}" style="{{ cart_scheme_inline | strip | strip_newlines }}">
      <button type="button" class="cart-drawer-sheet-scrim" aria-label="{{ 'general.cart.cancel' | t }}"></button>
      {% if action_after_add_cart == 'show_popup' %}
        <icon-close
          class="border close-cart-button  inline-flex hidden-1025 mx-auto rounded-50 overflow-hidden absolute top-0 inset-x-0 w-50 h-50 content-center heading-color bg-white"
          style="z-inde: 14;transform: translateY(calc(-100% - 15px));"
        >
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" class="transition">
            <use href="#icon-close"></use>
          </svg>
        </icon-close>
      {%- endif %}
      {% if action_after_add_cart == 'open_drawer' %}
        <div class="minicart__header flex gap-10 align-center justify-between px-30 py-18 color-default">
          <div class="h5 minicart-heading my-0">
            {{ 'general.cart.title' | t }}
            <span class="cart-count cart-count-drawer"> ({{ cart.item_count }}) </span>
          </div>
          <button
            class="btn-reset button-close close-cart-button pointer hover-svg-zoom inline-flex align-center"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" class="transition">
              <use href="#icon-close" />
            </svg>
          </button>
        </div>
      {%- endif -%}
      {%- if free_shipping and shipping_rate > 0 -%}
        {%- liquid
          assign items_subtotal_price = cart.items_subtotal_price | default: 0
          assign shipping_price = shipping_rate_cents
          assign fs_remaining = shipping_price | minus: items_subtotal_price
          if fs_remaining < 0
            assign fs_remaining = 0
          endif
          assign fs_percent = items_subtotal_price | times: 100.0 | divided_by: shipping_price | round: 1
          if fs_percent > 100
            assign fs_percent = 100
          endif
          if show_currency_code
            assign fs_remaining_price = fs_remaining | money_with_currency
            assign fs_money_sample = 123456 | money_with_currency
          else
            assign fs_remaining_price = fs_remaining | money
            assign fs_money_sample = 123456 | money
          endif
          comment
            Storelib escapes HTML in translations whose key does not end in _html;
            these two theme strings carry their own price span.
          endcomment
          assign fs_msg_tpl = 'general.cart.free_shipping' | t: amount: '[[amount]]' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#34;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
          assign fs_msg_done = 'general.cart.free_shipping_avaiable' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#34;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
          assign fs_msg_now = fs_msg_tpl | replace: '[[amount]]', fs_remaining_price
          assign fs_reached = false
          if cart.items.size > 0 and fs_remaining == 0
            assign fs_reached = true
          endif
        -%}
        <free-ship-progress-bar
          data-order="{{ items_subtotal_price }}"
          data-fe-amount="{{ shipping_rate }}"
          data-money-sample="{{ fs_money_sample | escape }}"
          data-fe-unavaiable="{{ fs_msg_tpl | escape }}"
          data-fe-avaiable="{{ fs_msg_done | escape }}"
          class="block cart_shipping cart_threshold cart_shipping--modern{% if action_after_add_cart == 'open_drawer' %} grey-bg{% endif %} border-bottom{% if action_after_add_cart != 'show_popup' %} border-top{% endif %} px-30 pt-20 pb-20{% if fs_reached %} cart_shipping_free{% endif %}"
        >
          <div class="cart_shipping__row">
            <span class="cart_shipping__icon" aria-hidden="true">
              <svg class="cart_shipping__glyph cart_shipping__glyph--parcel" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.2 4.2 7v10L12 20.8 19.8 17V7L12 3.2Z" vector-effect="non-scaling-stroke"/>
                <path d="M4.2 7 12 10.9 19.8 7M12 10.9v9.9M8.1 5.1l7.8 3.9" vector-effect="non-scaling-stroke"/>
              </svg>
              <svg class="cart_shipping__glyph cart_shipping__glyph--done" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="8.8" vector-effect="non-scaling-stroke"/>
                <path d="m8.4 12.3 2.5 2.5 4.8-5.2" vector-effect="non-scaling-stroke"/>
              </svg>
            </span>
            <div class="cart_shipping__message free-shipping-message cart-thres cart_thres_1" aria-live="polite">
              {%- if fs_reached -%}{{ fs_msg_done }}{%- else -%}{{ fs_msg_now }}{%- endif -%}
            </div>
          </div>
          <div class="cart_shipping__track" role="progressbar" aria-label="{{ 'general.cart.cart_thres1_html' | t: price: shipping_rate_price | strip_html | strip | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_percent | round }}">
            <span class="cart_shipping__fill percent_shipping_bar progress" style="width: {{ fs_percent }}%; --fs-progress: {{ fs_percent | divided_by: 100.0 }};"></span>
          </div>
        </free-ship-progress-bar>
      {%- endif -%}
      {%- if cart_duration_show and cart.items.size > 0 -%}
        <div class="cart-countdown-time px-30 heading-style color-default">
          <countdown-timer
            data-minutes-left="{{ cart_duration }}"
            data-timeout-message="{{ 'general.cart.timeout_message' | t }}"
            class="flex flex-wrap align-center pt-17 pb-15 border-bottom-dashed  w-full"
          >
            <span class="me-5">{{- 'general.cart.countdown_message_html' | t -}}</span>
            <div class="countdown-inner inline-flex align-center"></div>
          </countdown-timer>
        </div>
      {%- endif -%}
      {%- render 'minicart-form-body', carrier: carrier -%}
    </div>
    {%- unless carrier -%}
      {% render 'cart-drawer-presentation' %}
      {% render 'cart-drawer-polish' %}
      {% render 'cart-drawer-sheets' %}
    {%- endunless -%}
  </cart-notification>
  <div class="overlayminicart">

  </div>

{% endif %}

</template>
