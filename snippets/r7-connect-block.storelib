<template compat="shopify">
{%- comment -%}
  Materia Themes. One block of Newsletter Split (sections/newsletter-split)
  or Follow Us (sections/social-follow-cta), by its type: heading,
  subheading, image (a picture of Follow Us, linked when it has a link).

  block: the block. section: its section.

  In the builder every block carries its settings as JSON (data-r7c-bs) for
  live-r7-connect.js, which applies an edit without drawing the section
  again. data-own-font / data-own-weight / data-own-size keep a custom font,
  weight or size ahead of Theme settings > Typography priority, here in the
  first paint and from the script on live edits.
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign st = section.settings
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
-%}
{%- capture r7c_data -%}data-r7c-block="{{ block.id }}" data-r7c-type="{{ block.type }}"{% if request.design_mode %} data-r7c-bs="{{ bs | json | escape }}"{% endif %} {{ block.shopify_attributes }}{%- endcapture -%}
{%- case block.type -%}
  {%- when 'heading' -%}
    {%- capture fb_vars -%}
      {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
      {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 700 }};{%- endif -%}
      {%- if bs.size_enable -%}--fb-fs-d:{{ bs.size_desktop | default: 36 }}px;--fb-fs-m:{{ bs.size_mobile | default: 26 }}px;--fb-lh:{{ bs.line_height | default: 1.15 }};--fb-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
    {%- endcapture -%}
    {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
    <h2 class="r7c__heading" {{ r7c_data }}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %}>{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    {%- capture fb_vars -%}
      {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
      {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 400 }};{%- endif -%}
      {%- if bs.size_enable -%}--fb-fs:{{ bs.size | default: 16 }}px;--fb-lh:{{ bs.line_height | default: 1.5 }};{%- endif -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
    {%- endcapture -%}
    {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
    <div class="r7c__subheading" {{ r7c_data }}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %}>{{ bs.text }}</div>
  {%- when 'image' -%}
    {%- liquid
      assign tile_alt = bs.alt | default: bs.image.alt | default: ''
      assign tile_tag = 'div'
      if bs.link != blank
        assign tile_tag = 'a'
      endif
    -%}
    <{{ tile_tag }} class="r7c__tile" data-r7c-tile {{ r7c_data }}{% if bs.link != blank %} href="{{ bs.link }}"{% endif %}>
      {%- if bs.image != blank -%}
        <img class="r7c__tile-img" data-r7c-tile-img src="{{ bs.image | image_url: width: 900 }}" srcset="{{ bs.image | image_url: width: 400 }} 400w, {{ bs.image | image_url: width: 600 }} 600w, {{ bs.image | image_url: width: 900 }} 900w" sizes="(min-width: 768px) 25vw, 72vw" width="{{ bs.image.width | default: 900 }}" height="{{ bs.image.height | default: 900 }}" alt="{{ tile_alt | escape }}" loading="lazy" decoding="async"{% if bs.image.presentation.focal_point != blank %} style="object-position: {{ bs.image.presentation.focal_point }}"{% endif %}>
      {%- else -%}
        {%- render 'placeholder-render', class: 'r7c__tile-img r7c__tile-img--ph' -%}
      {%- endif -%}
    </{{ tile_tag }}>
{%- endcase -%}
</template>
