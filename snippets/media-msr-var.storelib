<template compat="shopify">
{%- comment -%}
  Materia Themes. Prints "name: colour;" for a custom colour, only when "on"
  is true and the colour is set and not transparent. Nothing is printed
  otherwise, so the section's CSS falls back to the colour scheme.
  {% render 'media-msr-var', name: '--iws-bg', color: st.section_bg, on: custom %}
{%- endcomment -%}
{%- if on and color != blank and color.alpha != 0 and color != 'transparent' and color != 'rgba(0,0,0,0)' and color != 'rgba(0, 0, 0, 0)' and color != '#00000000' -%}{{ name }}: {{ color }};{%- endif -%}
</template>
