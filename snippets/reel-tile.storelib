<template compat="shopify">
{%- comment -%}
  Reel tile — used by sections/reels-wall.liquid.
  Inputs: b (block.settings), s (section.settings), section_id
{%- endcomment -%}
{%- liquid
  assign has_link = false
  assign tile_href = '#'
  if b.cta_link != blank
    assign has_link = true
    assign tile_href = b.cta_link
  elsif b.product != blank
    assign has_link = true
    assign tile_href = b.product.url
  endif
  assign avatar_letter = b.username | default: '@' | strip | replace: '@', '' | slice: 0, 1 | upcase
-%}
{%- if has_link -%}
  <a class="rw-tile" href="{{ tile_href }}" aria-label="{{ b.heading | default: 'Reel' | escape }}">
{%- else -%}
  <div class="rw-tile">
{%- endif -%}
  {%- if b.local_video != blank -%}
    {%- liquid
      assign vid_src = ''
      for src in b.local_video.sources
        if src.format == 'mp4'
          assign vid_src = src.url
          break
        endif
      endfor
    -%}
    <video
      {% if s.autoplay_videos %}autoplay{% endif %}
      muted
      {% if s.loop_videos %}loop{% endif %}
      playsinline preload="metadata"
      {% if b.poster_image != blank %}poster="{{ b.poster_image | image_url: width: 720 }}"{% endif %}
    >
      <source src="{{ vid_src }}" type="video/mp4">
    </video>
  {%- elsif b.video_url_direct != blank -%}
    <video
      {% if s.autoplay_videos %}autoplay{% endif %}
      muted
      {% if s.loop_videos %}loop{% endif %}
      playsinline preload="metadata"
      {% if b.poster_image != blank %}poster="{{ b.poster_image | image_url: width: 720 }}"{% endif %}
    >
      <source src="{{ b.video_url_direct }}" type="video/mp4">
    </video>
  {%- elsif b.video_url != blank -%}
    {%- assign yt_id = b.video_url.id -%}
    {%- if b.video_url.type == 'youtube' -%}
      <iframe src="https://www.youtube.com/embed/{{ yt_id }}?{% if s.autoplay_videos %}autoplay=1&{% endif %}mute=1&{% if s.loop_videos %}loop=1&playlist={{ yt_id }}&{% endif %}controls=0&rel=0&modestbranding=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    {%- elsif b.video_url.type == 'vimeo' -%}
      <iframe src="https://player.vimeo.com/video/{{ yt_id }}?{% if s.autoplay_videos %}autoplay=1&{% endif %}muted=1&{% if s.loop_videos %}loop=1&{% endif %}controls=0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    {%- endif -%}
  {%- elsif b.poster_image != blank -%}
    <img src="{{ b.poster_image | image_url: width: 720 }}" alt="{{ b.poster_image.alt | escape }}" loading="lazy">
  {%- else -%}
    {%- render 'placeholder-render', class: 'rw-tile__placeholder' -%}
  {%- endif -%}

  <div class="rw-tile__overlay"></div>

  {%- if s.show_handle and b.username != blank -%}
    <div class="rw-handle">
      {%- if b.avatar != blank -%}
        <img src="{{ b.avatar | image_url: width: 64 }}" alt="{{ b.username | escape }}" loading="lazy">
      {%- else -%}
        <span class="rw-handle__avatar-fallback">{{ avatar_letter }}</span>
      {%- endif -%}
      <span>{{ b.username }}</span>
    </div>
  {%- endif -%}

  {%- assign rw_has_html5 = false -%}
  {%- if b.local_video != blank or b.video_url_direct != blank -%}{%- assign rw_has_html5 = true -%}{%- endif -%}
  {%- if s.show_unmute and rw_has_html5 -%}
    <button type="button" class="rw-sound" aria-label="Toggle sound">
      <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/>
        <line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
      </svg>
      <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"/>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
      </svg>
    </button>
  {%- endif -%}

  {%- if s.show_actions and b.show_block_actions != false -%}
    <div class="rw-actions" aria-label="Reel actions">
      <button type="button" class="rw-action" data-action="like" aria-label="Like">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>{{ b.likes | default: '0' }}</span>
      </button>
      <button type="button" class="rw-action" data-action="share" aria-label="Share">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
        <span>{{ b.shares | default: '0' }}</span>
      </button>
      <button type="button" class="rw-action" data-action="save" aria-label="Save">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
        <span>{{ b.saves | default: '0' }}</span>
      </button>
    </div>
  {%- endif -%}

  {%- if b.heading != blank or b.caption != blank or b.cta_label != blank -%}
    <div class="rw-content">
      {%- if b.heading != blank -%}
        <h3 class="rw-content__heading">{{ b.heading }}</h3>
      {%- endif -%}
      {%- if b.caption != blank -%}
        <p class="rw-content__caption">{{ b.caption }}</p>
      {%- endif -%}
      {%- if b.cta_label != blank and b.cta_link != blank -%}
        <span class="rw-cta">
          {{ b.cta_label }}
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if b.product != blank -%}
    {%- assign p = b.product -%}
    <a class="rw-product" href="{{ p.url }}" aria-label="Shop {{ p.title | escape }}" onclick="event.stopPropagation();">
      {%- if p.featured_image != blank -%}
        <img src="{{ p.featured_image | image_url: width: 64 }}" alt="{{ p.title | escape }}" loading="lazy">
      {%- endif -%}
      <div>
        <div class="rw-product__name">{{ p.title }}</div>
        <div class="rw-product__price">{{ p.price | money }}</div>
      </div>
    </a>
  {%- endif -%}

{%- if has_link -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

</template>