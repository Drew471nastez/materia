<template compat="shopify">
{%- comment -%}
  Materia Themes. Clean per-platform social icons.
  Reads display-style settings: enable_custom_social_style toggles the
  custom group on/off. When OFF (default), the icons render with theme
  defaults (outline / 18px / 12px gap / heading colour). When ON, the
  individual settings (social_icon_style / social_icon_color /
  social_icon_bg / social_icon_size / social_icon_gap) override those
  defaults. `social_open_new_tab` is independent — it always applies.
{%- endcomment -%}
{%- liquid
  assign s = settings
  if s.enable_custom_social_style
    assign si_style = s.social_icon_style | default: 'outline'
    assign si_size  = s.social_icon_size  | default: 18
    assign si_gap   = s.social_icon_gap   | default: 12
  else
    assign si_style = 'outline'
    assign si_size  = 18
    assign si_gap   = 12
  endif
  assign si_target = '_blank'
  unless s.social_open_new_tab
    assign si_target = '_self'
  endunless
-%}
{%- if s.facebook != blank
  or s.instagram != blank
  or s.twitter != blank
  or s.youtube != blank
  or s.tiktok != blank
  or s.pinterest != blank
  or s.vimeo != blank
  or s.linkedin != blank
  or s.whatsapp != blank
  or s.tumblr != blank
  or s.snapchat != blank
  or s.social_threads != blank
  or s.social_x != blank
  or s.social_telegram != blank
  or s.social_discord != blank
  or s.social_spotify != blank
  or s.social_reddit != blank
-%}
  <ul class="list-social list-social--{{ si_style }} list-unstyled flex align-center flex-wrap gap" style="--col-gap: {{ si_gap }}px;">
    {%- if settings.facebook != blank and settings.facebook != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex">
        <a
          href="{{ settings.facebook }}"
          class="social-icon-link inline-flex content-center tooltip relative"
          target="{{ si_target }}"
          rel="noopener"
          aria-label="{{ 'general.social.links.facebook' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21.95v-8.26h2.77l.41-3.22H13.5V8.42c0-.93.26-1.57 1.6-1.57h1.71V3.97c-.3-.04-1.31-.13-2.48-.13-2.45 0-4.13 1.5-4.13 4.24v2.39H7.42v3.22h2.78v8.26h3.3Z"/>
          </svg>
          <span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">
            {{- 'general.social.links.facebook' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.instagram != blank and settings.instagram != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex">
        <a
          href="{{ settings.instagram }}"
          class="social-icon-link inline-flex content-center tooltip relative"
          target="{{ si_target }}"
          rel="noopener"
          aria-label="{{ 'general.social.links.instagram' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
          </svg>
          <span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">
            {{- 'general.social.links.instagram' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.twitter != blank and settings.twitter != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex">
        <a
          href="{{ settings.twitter }}"
          class="social-icon-link inline-flex content-center tooltip relative"
          target="{{ si_target }}"
          rel="noopener"
          aria-label="{{ 'general.social.links.twitter' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.53 3.5h3.2l-6.99 7.99L22 20.5h-6.44l-5.04-6.59-5.77 6.59H1.55l7.48-8.55L1.5 3.5h6.6l4.55 6.02L17.53 3.5Zm-1.12 15.06h1.77L7.68 5.33H5.78l10.63 13.23Z"/>
          </svg>
          <span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">
            {{- 'general.social.links.twitter' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.youtube != blank and settings.youtube != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex">
        <a
          href="{{ settings.youtube }}"
          class="social-icon-link inline-flex content-center tooltip relative"
          target="{{ si_target }}"
          rel="noopener"
          aria-label="{{ 'general.social.links.youtube' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.54 7.2a2.78 2.78 0 0 0-1.96-1.96C18.88 4.8 12 4.8 12 4.8s-6.88 0-8.58.44A2.78 2.78 0 0 0 1.46 7.2C1 8.9 1 12 1 12s0 3.1.46 4.8a2.78 2.78 0 0 0 1.96 1.96c1.7.44 8.58.44 8.58.44s6.88 0 8.58-.44a2.78 2.78 0 0 0 1.96-1.96c.46-1.7.46-4.8.46-4.8s0-3.1-.46-4.8ZM9.75 15.27V8.73L15.5 12l-5.75 3.27Z"/>
          </svg>
          <span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">
            {{- 'general.social.links.youtube' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.tiktok != blank and settings.tiktok != '#' or request.design_mode -%}
