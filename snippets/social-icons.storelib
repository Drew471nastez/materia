    {%- endif -%}
    {%- if s.social_x != blank and s.social_x != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex"><a href="{{ s.social_x }}" class="social-icon-link inline-flex content-center tooltip relative" target="{{ si_target }}" rel="noopener" aria-label="X"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.53 3.5h3.2l-6.99 7.99L22 20.5h-6.44l-5.04-6.59-5.77 6.59H1.55l7.48-8.55L1.5 3.5h6.6l4.55 6.02L17.53 3.5Zm-1.12 15.06h1.77L7.68 5.33H5.78l10.63 13.23Z"/></svg><span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">X</span></a></li>
    {%- endif -%}
    {%- if s.social_telegram != blank and s.social_telegram != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex"><a href="{{ s.social_telegram }}" class="social-icon-link inline-flex content-center tooltip relative" target="{{ si_target }}" rel="noopener" aria-label="{{ 'general.social.links.telegram' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.78 6.92-1.7 8.04c-.13.58-.46.72-.94.45l-2.6-1.92-1.25 1.21c-.14.14-.26.26-.52.26l.18-2.62 4.79-4.33c.21-.18-.05-.28-.32-.1l-5.92 3.73L5.95 13c-.55-.18-.56-.55.12-.82l9.96-3.84c.46-.16.86.11.71.78Z"/></svg><span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">Telegram</span></a></li>
    {%- endif -%}
    {%- if s.social_discord != blank and s.social_discord != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex"><a href="{{ s.social_discord }}" class="social-icon-link inline-flex content-center tooltip relative" target="{{ si_target }}" rel="noopener" aria-label="{{ 'general.social.links.discord' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.27 5.33A17.5 17.5 0 0 0 14.84 4l-.2.4a16 16 0 0 1 4.32 1.95 17.7 17.7 0 0 0-13.91 0A16 16 0 0 1 9.36 4.4L9.16 4a17.5 17.5 0 0 0-4.43 1.33C2.04 9.34 1.31 13.27 1.67 17.13a17.6 17.6 0 0 0 5.4 2.74l1.16-1.65a11.4 11.4 0 0 1-1.83-.9c.16-.13.32-.27.46-.4a12.7 12.7 0 0 0 10.28 0l.46.4c-.6.36-1.21.66-1.83.9l1.16 1.65a17.6 17.6 0 0 0 5.4-2.74c.42-4.5-.7-8.4-3.06-11.8ZM8.52 14.71c-1.07 0-1.95-.99-1.95-2.21s.86-2.22 1.95-2.22 1.97 1 1.95 2.22c0 1.22-.86 2.21-1.95 2.21Zm6.96 0c-1.07 0-1.95-.99-1.95-2.21s.86-2.22 1.95-2.22 1.97 1 1.95 2.22c0 1.22-.86 2.21-1.95 2.21Z"/></svg><span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">Discord</span></a></li>
    {%- endif -%}
    {%- if s.social_spotify != blank and s.social_spotify != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex"><a href="{{ s.social_spotify }}" class="social-icon-link inline-flex content-center tooltip relative" target="{{ si_target }}" rel="noopener" aria-label="{{ 'general.social.links.spotify' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.59 14.46a.62.62 0 0 1-.86.21c-2.36-1.44-5.32-1.76-8.81-.97a.62.62 0 1 1-.27-1.21c3.82-.86 7.1-.49 9.74 1.12.3.18.39.57.2.85Zm1.22-2.72a.78.78 0 0 1-1.07.26c-2.69-1.66-6.81-2.14-10-1.17a.78.78 0 1 1-.45-1.5c3.66-1.11 8.18-.57 11.27 1.33a.78.78 0 0 1 .25 1.08Zm.1-2.83C14.69 8.99 9.4 8.81 6.34 9.74a.94.94 0 1 1-.55-1.8c3.51-1.07 9.36-.86 13.04 1.32a.94.94 0 0 1-.95 1.62Z"/></svg><span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">Spotify</span></a></li>
    {%- endif -%}
    {%- if s.social_reddit != blank and s.social_reddit != '#' or request.design_mode -%}
      <li class="list-social__item inline-flex"><a href="{{ s.social_reddit }}" class="social-icon-link inline-flex content-center tooltip relative" target="{{ si_target }}" rel="noopener" aria-label="{{ 'general.social.links.reddit' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.14a2.14 2.14 0 0 0-3.62-1.55 10.5 10.5 0 0 0-5.7-1.81l.97-4.58 3.18.67a1.52 1.52 0 1 0 .15-.74l-3.55-.75a.36.36 0 0 0-.43.28l-1.08 5.13a10.5 10.5 0 0 0-5.78 1.8 2.14 2.14 0 1 0-2.36 3.5 4.4 4.4 0 0 0-.05.66c0 3.34 3.89 6.05 8.69 6.05s8.69-2.71 8.69-6.05a4.4 4.4 0 0 0-.05-.66A2.14 2.14 0 0 0 22 12.14ZM7 13.62a1.5 1.5 0 1 1 1.5 1.5 1.5 1.5 0 0 1-1.5-1.5Zm8.36 4a4.78 4.78 0 0 1-3.36 1.04 4.78 4.78 0 0 1-3.36-1.04.34.34 0 1 1 .47-.49 4.07 4.07 0 0 0 2.89.86 4.07 4.07 0 0 0 2.89-.86.34.34 0 0 1 .47.49Zm-.36-2.5a1.5 1.5 0 1 1 1.5-1.5 1.5 1.5 0 0 1-1.5 1.5Z"/></svg><span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">Reddit</span></a></li>
    {%- endif -%}
  </ul>
  {%- style -%}
    /* Color + bg also respect the `enable_custom_social_style` toggle —
       when OFF, fall back to theme scheme tokens (heading color +
       transparent chip) regardless of any merchant-saved custom values,
       so the toggle behaves as a true "use theme defaults" switch. */
    .list-social {
      --si-color: {% if s.enable_custom_social_style and s.social_icon_color != blank and s.social_icon_color != 'transparent' and s.social_icon_color != 'rgba(0,0,0,0)' %}{{ s.social_icon_color }}{% else %}var(--color-heading){% endif %};
      --si-bg:    {% if s.enable_custom_social_style and s.social_icon_bg    != blank %}{{ s.social_icon_bg }}{% else %}transparent{% endif %};
      --si-size:  {{ si_size }}px;
      --si-chip:  calc(var(--si-size) * 2);
    }
    .list-social .social-icon-link {
      width: var(--si-chip);
      height: var(--si-chip);
      color: var(--si-color);
      transition: opacity .25s ease, transform .25s ease, background-color .25s ease, border-color .25s ease;
    }
    .list-social .social-icon-link svg {
      display: block;
      width: var(--si-size);
      height: var(--si-size);
    }
    .list-social .social-icon-link:hover,
    .list-social .social-icon-link:focus-visible {
      transform: translateY(-1px);
      color: var(--si-color);
    }
    /* Outline (default) */
    .list-social--outline .social-icon-link {
      background: transparent;
      border: 1px solid color-mix(in srgb, var(--si-color) 22%, transparent);
      border-radius: 50%;
      opacity: .8;
    }
    .list-social--outline .social-icon-link:hover { opacity: 1; }
    /* Solid fill (no chrome — straight-up icons) */
    .list-social--solid .social-icon-link {
      background: transparent;
      border: 0;
      padding: 0;
      width: auto;
      height: auto;
      opacity: .85;
    }
    .list-social--solid .social-icon-link:hover { opacity: 1; }
    /* Rounded chip */
    .list-social--rounded .social-icon-link {
      background: var(--si-bg);
      border: 1px solid color-mix(in srgb, var(--si-color) 12%, transparent);
      border-radius: 10px;
    }
    /* Circle background */
    .list-social--circle .social-icon-link {
      background: var(--si-bg);
      border: 0;
      border-radius: 50%;
    }
  {%- endstyle -%}
{%- endif -%}

</template>