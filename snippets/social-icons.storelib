          </svg>
          <span class="tooltip-content invisible rounded-3 absolute pointer-none tooltip-bottom">
            {{- 'general.social.links.tiktok' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.pinterest != blank and settings.pinterest != '#' or request.design_mode -%}
