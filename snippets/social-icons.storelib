            <path d="M12 2.5a9.5 9.5 0 0 0-3.46 18.35c-.08-.77-.15-1.96.03-2.8.17-.76 1.08-4.84 1.08-4.84s-.27-.55-.27-1.37c0-1.28.74-2.24 1.66-2.24.79 0 1.17.59 1.17 1.3 0 .79-.5 1.97-.77 3.07-.22.92.46 1.67 1.36 1.67 1.64 0 2.9-1.73 2.9-4.22 0-2.21-1.59-3.75-3.85-3.75a4 4 0 0 0-4.16 4c0 .79.31 1.64.68 2.11.07.09.08.16.06.25-.07.29-.23.92-.26 1.05-.04.17-.13.21-.3.13-1.12-.52-1.82-2.16-1.82-3.47 0-2.83 2.06-5.42 5.93-5.42 3.11 0 5.53 2.22 5.53 5.18 0 3.09-1.95 5.58-4.66 5.58-.91 0-1.77-.47-2.06-1.03l-.56 2.14c-.2.79-.76 1.78-1.13 2.38A9.5 9.5 0 1 0 12 2.5Z"/>
