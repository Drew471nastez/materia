<template compat="shopify">
{%- comment -%}
  Materia Themes. One copy of the scrolling messages of Announcement Bar
  Pro 1: the Message blocks (or, with none, the section's legacy
  message_1..4) repeated reps times. Only the first message of the first copy
  carries the block's attributes; the rest are data-an-copy, kept in step by
  shopify/assets/live-announcements.js.
  {% render 'announce-scroll-items', section: section, copy: false, reps: 30 %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign msgs = section.blocks | where: 'type', 'message'
-%}
{%- for n in (1..reps) -%}
  {%- if msgs.size > 0 -%}
    {%- for block in msgs -%}
      {%- assign bs = block.settings -%}
      {%- assign bfont = false -%}{%- if bs.enable_custom_fonts and bs.font.family != blank -%}{%- assign bfont = true -%}{%- endif -%}
      <span class="announcement-message" {% if copy == false and n == 1 %}{% render 'announce-block', block: block %}{% else %}data-an-copy="{{ block.id }}"{% endif %}{% if bfont %} data-own-font data-own-weight{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{% if bs.enable_custom_style %}--b-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--ab1-text)' %};{% endif %}{% if bfont %}--b-f: {% render 'announce-font', font: bs.font, on: true, fallback: 'inherit' %};--b-w: {{ bs.font.weight | default: 400 }};{% endif %}">{{ bs.text }}</span>
      {%- unless forloop.last -%}<span class="separator-icon" aria-hidden="true"{% if st.separator_icon == 'none' %} hidden{% endif %}>{% render 'announce-icon', icon: st.separator_icon %}</span>{%- endunless -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..4) -%}
      {%- assign key = 'message_' | append: i -%}
      <span class="announcement-message" {% if copy == false and n == 1 %}data-an-legacy="{{ key }}"{% else %}data-an-legacy-copy="{{ key }}"{% endif %}{% if st[key] == blank %} hidden{% endif %}>{{ st[key] }}</span>
      {%- unless forloop.last -%}<span class="separator-icon" aria-hidden="true"{% if st.separator_icon == 'none' %} hidden{% endif %}>{% render 'announce-icon', icon: st.separator_icon %}</span>{%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
  {%- unless forloop.last -%}<span class="repetition-spacing"></span>{%- endunless -%}
{%- endfor -%}
</template>
