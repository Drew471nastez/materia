<template compat="shopify">
<div class="materia-chart-preview"{% if request.design_mode %} data-editor-preview{% endif %} data-block-preview-root="{{ block.id }}" {{ block.shopify_attributes }}>
  <p class="h6 mt-0 mb-10">{{ block.settings.size_guide_label | default: block.settings.title | default: 'Size guide' | escape }}</p>
  <div class="materia-chart-preview__table" aria-hidden="true"><span>Size</span><span>Measurement</span><span>—</span><span>—</span><span>—</span><span>—</span></div>
  <p>Preview layout only. Assign a size chart to this product in StoreLib to display its measurements.</p>
</div>
<style>
.materia-chart-preview{display:none;padding:16px;border:1px dashed var(--color-border);border-radius:var(--input-radius,8px);color:var(--color-text);background:var(--color-background);max-width:100%;}
html.shopify-design-mode .materia-chart-preview,.materia-chart-preview[data-editor-preview]{display:block;}
.materia-chart-preview__table{display:grid;grid-template-columns:1fr 2fr;border:1px solid var(--color-border);border-radius:6px;overflow:hidden;}
.materia-chart-preview__table span{padding:8px 12px;border-bottom:1px solid var(--color-border);}
.materia-chart-preview__table span:nth-child(-n+2){font-weight:var(--heading-weight,600);background:color-mix(in srgb,var(--color-heading) 4%,var(--color-background));}
.materia-chart-preview p:last-child{margin:12px 0 0;font-size:.85em;line-height:1.5;}
{% comment %}{% endcomment %}</style>
</template>
