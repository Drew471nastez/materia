<template compat="shopify">
{%- assign fb_accessibility_add = 'accessibility.add' | t -%}
{%- assign fb_accessibility_sold_out = 'accessibility.sold_out' | t -%}
{%- assign fb_accessibility_added = 'accessibility.added' | t -%}
{%- comment -%}
  Materia Themes — Upsell Pro block.
  Pass `block` and `current_product`. Renders up to 6 upsell cards with
  AJAX add-to-cart, no page reload. Hides if nothing to show.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign max = s.max_products | default: 3
  assign hide_unavailable = s.hide_unavailable
  assign hide_current = s.hide_current_product

  comment
    Build a comma-separated handle list from the picked product settings.
    Some Liquid contexts return Product objects, others return handle strings.
    Either way, .handle on a Product gives the handle, on a string it's nil
    (blank), so we fall back to the raw value (the string itself).
  endcomment
  assign handles_str = ''
  if s.manual_product_1 != blank
    if s.manual_product_1.handle != blank
      assign handles_str = handles_str | append: s.manual_product_1.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_1 | append: ','
    endif
  endif
  if s.manual_product_2 != blank
    if s.manual_product_2.handle != blank
      assign handles_str = handles_str | append: s.manual_product_2.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_2 | append: ','
    endif
  endif
  if s.manual_product_3 != blank
    if s.manual_product_3.handle != blank
      assign handles_str = handles_str | append: s.manual_product_3.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_3 | append: ','
    endif
  endif
  if s.manual_product_4 != blank
    if s.manual_product_4.handle != blank
      assign handles_str = handles_str | append: s.manual_product_4.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_4 | append: ','
    endif
  endif
  if s.manual_product_5 != blank
    if s.manual_product_5.handle != blank
      assign handles_str = handles_str | append: s.manual_product_5.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_5 | append: ','
    endif
  endif
  if s.manual_product_6 != blank
    if s.manual_product_6.handle != blank
      assign handles_str = handles_str | append: s.manual_product_6.handle | append: ','
    else
      assign handles_str = handles_str | append: s.manual_product_6 | append: ','
    endif
  endif
  assign handles = handles_str | split: ','
  assign has_any = false
  if handles_str != ''
    assign has_any = true
  endif
-%}

{%- if has_any -%}
{%- capture block_id -%}upsell-pro-{{ block.id }}{%- endcapture -%}

<style>
  #{{ block_id }} {
    display: block;
    padding-top: {{ s.padding_top | default: 16 }}px;
    padding-bottom: {{ s.padding_bottom | default: 16 }}px;
    {% if s.bg_color != blank %}background: {{ s.bg_color }};{% endif %}
    {% if s.text_color != blank %}color: {{ s.text_color }};{% endif %}
  }
  #{{ block_id }} .upsell-pro__heading {
    font-size: {{ s.heading_size | default: 14 }}px;
    font-weight: 600;
    margin: 0 0 {{ s.heading_gap | default: 12 }}px;
    {% if s.muted_color != blank %}color: {{ s.muted_color }};{% endif %}
  }
  #{{ block_id }} .upsell-pro__sub { font-size: 12px; margin: -6px 0 12px; opacity: 0.7; }
  #{{ block_id }} .upsell-pro__list { display: flex; flex-direction: column; gap: {{ s.gap | default: 10 }}px; }
  #{{ block_id }} .upsell-card {
    display: flex; align-items: center; gap: 12px; padding: 10px 12px;
    {% if s.card_bg != blank %}background: {{ s.card_bg }};{% else %}background: rgba(0,0,0,0.02);{% endif %}
    border-radius: {{ s.card_radius | default: 12 }}px;
    {% if s.show_border %}border: 1px solid {% if s.border_color != blank %}{{ s.border_color }}{% else %}rgba(0,0,0,0.06){% endif %};{% endif %}
    {% if s.show_shadow %}box-shadow: 0 2px 8px -4px rgba(0,0,0,0.1);{% endif %}
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  #{{ block_id }} .upsell-card:hover {
    {% if s.show_shadow %}box-shadow: 0 4px 14px -4px rgba(0,0,0,0.15);{% endif %}
    transform: translateY(-1px);
  }
  #{{ block_id }} .upsell-card__media {
    width: {{ s.image_size_px | default: 56 }}px; height: {{ s.image_size_px | default: 56 }}px;
    flex: 0 0 auto; overflow: hidden;
    border-radius: {% if s.image_shape == 'square' %}4px{% elsif s.image_shape == 'rounded' %}10px{% else %}8px{% endif %};
    background: rgba(0,0,0,0.04);
  }
  #{{ block_id }} .upsell-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ block_id }} .upsell-card__info { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; }
  #{{ block_id }} .upsell-card__title { font-weight: 600; font-size: 14px; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #{{ block_id }} .upsell-card__sub { font-size: 12px; opacity: 0.65; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #{{ block_id }} .upsell-card__price { font-size: 13px; font-weight: 500; }
  #{{ block_id }} .upsell-card__price .compare-at { text-decoration: line-through; opacity: 0.5; margin-left: 6px; font-weight: 400; }
  #{{ block_id }} .upsell-card__sale-badge {
    display: inline-block; padding: 2px 6px; font-size: 10px; font-weight: 700;
    background: #ff3b30; color: #fff; border-radius: 4px; margin-left: 6px; vertical-align: middle;
  }
  /* Sale badge is desktop-only — hidden on mobile/tablet. */
  @media (max-width: 749px) {
    #{{ block_id }} .upsell-card__sale-badge { display: none !important; }
  }
  #{{ block_id }} .upsell-card__action { flex: 0 0 auto; }
  #{{ block_id }} .upsell-card__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 64px; padding: 8px 16px; font-size: 13px; font-weight: 600;
    border: none; cursor: pointer;
    border-radius: {{ s.button_radius | default: 8 }}px;
    background: {% if s.button_bg != blank %}{{ s.button_bg }}{% else %}var(--color-primary, #ff5a5a){% endif %};
    color: {% if s.button_text_color != blank %}{{ s.button_text_color }}{% else %}#fff{% endif %};
    transition: opacity 0.2s ease, transform 0.1s ease;
  }
  #{{ block_id }} .upsell-card__btn:hover { opacity: 0.85; }
  #{{ block_id }} .upsell-card__btn:active { transform: scale(0.97); }
  #{{ block_id }} .upsell-card__btn:disabled { opacity: 0.6; cursor: not-allowed; }
  #{{ block_id }} .upsell-card.is-loading .upsell-card__btn { pointer-events: none; opacity: 0.7; }
  #{{ block_id }} .upsell-card.is-added .upsell-card__btn { background: #22c55e !important; color: #fff !important; }
  #{{ block_id }} .upsell-card.is-soldout { opacity: 0.7; }
  /* Variant selector — minimal, slim chip with a hard-set height so
     the browser's default `<select>` baseline (often 24-30px) can't
     bloat it. We use explicit `height` + matching `line-height` for
     vertical centering, zero vertical padding, and a thin hairline
     border so the chip reads as a tag, not a form input. */
  #{{ block_id }} .upsell-card__variant {
    display: none;
    margin-top: 6px;
  }
  #{{ block_id }} .upsell-card.has-variants .upsell-card__variant { display: block; }
  #{{ block_id }} .upsell-card__variant select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    /* Content-driven width, hard-set slim height */
    display: inline-block;
    width: auto;
    max-width: 100%;
    height: 22px;
    box-sizing: border-box;
    /* Zero vertical padding — height is fully controlled by `height`
       + `line-height`, no browser default baseline can inflate it */
    padding: 0 20px 0 10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    background-color: color-mix(in srgb, currentColor 3%, transparent);
    /* Smaller chevron — 3px so it looks proportional to the slim chip */
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 12px) 50%,
      calc(100% - 9px) 50%;
    background-size: 3px 3px, 3px 3px;
    background-repeat: no-repeat;
    color: inherit;
    font: inherit;
    font-size: 10.5px;
    font-weight: 500;
    line-height: 20px;          /* height - border */
    letter-spacing: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    vertical-align: middle;
    transition: background-color .2s ease, border-color .2s ease;
  }
  #{{ block_id }} .upsell-card__variant select:hover {
    background-color: color-mix(in srgb, currentColor 6%, transparent);
    border-color: color-mix(in srgb, currentColor 18%, transparent);
  }
  #{{ block_id }} .upsell-card__variant select:focus-visible {
    outline: none;
    border-color: color-mix(in srgb, currentColor 28%, transparent);
    background-color: color-mix(in srgb, currentColor 8%, transparent);
  }
  /* Native options inherit page colors, not the styled select. Force a
     readable default so very dark color schemes don't render
     white-on-white. Bumped to 13px because the OS dropdown menu doesn't
     inherit the slim 10.5px from the closed pill — keeping the open
     list legible. */
  #{{ block_id }} .upsell-card__variant select option {
    color: #111;
    background: #fff;
    font-size: 13px;
  }
  /* Even slimmer on mobile so the chip never crowds the image / Add button. */
  @media (max-width: 749px) {
    #{{ block_id }} .upsell-card__variant { margin-top: 4px; }
    #{{ block_id }} .upsell-card__variant select {
      height: 20px;
      padding: 0 17px 0 8px;
      font-size: 10px;
      line-height: 18px;
      background-position: calc(100% - 10px) 50%, calc(100% - 8px) 50%;
    }
  }
{% comment %}{% endcomment %}</style>

<div
  id="{{ block_id }}"
  class="upsell-pro"
  data-block-id="{{ block.id }}"
  data-open-drawer="{{ s.open_drawer_after_add }}"
  data-button-text="{{ s.upsell_button_text | default: fb_accessibility_add | escape }}"
  data-added-text="{{ s.added_text | default: fb_accessibility_added | escape }}"
  data-soldout-text="{{ s.soldout_text | default: fb_accessibility_sold_out | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if s.heading != blank -%}
    <p class="upsell-pro__heading">{{ s.heading }}</p>
  {%- endif -%}
  {%- if s.subheading != blank -%}
    <p class="upsell-pro__sub">{{ s.subheading }}</p>
  {%- endif -%}
  <div class="upsell-pro__list">
    {%- assign rendered = 0 -%}
    {%- assign cur_id = current_product.id -%}

    {%- if s.manual_product_1 != blank -%}
      {%- assign p = s.manual_product_1 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: true, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
    {%- if s.manual_product_2 != blank and rendered < max -%}
      {%- assign p = s.manual_product_2 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: false, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
    {%- if s.manual_product_3 != blank and rendered < max -%}
      {%- assign p = s.manual_product_3 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: false, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
    {%- if s.manual_product_4 != blank and rendered < max -%}
      {%- assign p = s.manual_product_4 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: false, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
    {%- if s.manual_product_5 != blank and rendered < max -%}
      {%- assign p = s.manual_product_5 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: false, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
    {%- if s.manual_product_6 != blank and rendered < max -%}
      {%- assign p = s.manual_product_6 -%}
      {%- render 'upsell-pro-card', p: p, s: s, is_first: false, cur_id: cur_id, hide_current: hide_current, hide_unavailable: hide_unavailable -%}
      {%- assign rendered = rendered | plus: 1 -%}
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  var I18N_TRY_AGAIN = {{ 'accessibility.try_again' | t | json }};
  /* Document-level delegation so the handler attaches even if this script
     runs before the wrapper is in the DOM. Uses dataset on the wrapper
     for the labels so each Upsell Pro instance reads its own settings. */
  if (window.__upsellProAttached) return;
  window.__upsellProAttached = true;

  /* Variant <select> sync — keeps `data-variant-id` on the card in step
     with whatever variant the customer chose. */
  document.addEventListener('change', function(e) {
    var sel = e.target.closest && e.target.closest('.upsell-card__variant-select');
    if (!sel) return;
    var card = sel.closest('.upsell-card');
    if (card) card.dataset.variantId = sel.value;
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest && e.target.closest('.upsell-card__btn');
    if (!btn) return;
    e.preventDefault();
    var card = btn.closest('.upsell-card');
    if (!card || card.classList.contains('is-loading') || card.classList.contains('is-soldout')) return;
    var root = btn.closest('.upsell-pro');
    var addedText = (root && root.dataset.addedText) || 'Added';
    var btnText = (root && root.dataset.buttonText) || 'Add';
    var openDrawer = !!(root && root.dataset.openDrawer === 'true');
    var variantId = card.dataset.variantId;
    if (!variantId) {
      console.warn('[upsell-pro] missing variantId on card', card);
      return;
    }
    card.classList.add('is-loading');
    btn.disabled = true;
    btn.textContent = '...';

    /* Locate the live cart UI element (cart-notification or cart-drawer).
       If found, we mirror the theme's own bundle / quick-add pattern:
       pass `sections=...` to /cart/add.js so the server returns rendered
       HTML for those sections, then swap the drawer's contents in.
       Without this, /cart/add.js succeeds but the drawer keeps showing
       its stale "empty" state — exactly the reported bug. */
    var cartUI =
      document.querySelector('cart-notification') ||
      document.querySelector('cart-drawer');
    var sectionIds = [];
    if (cartUI && typeof cartUI.getSectionsToRender === 'function') {
      try {
        sectionIds = cartUI.getSectionsToRender().map(function(s) { return s.id; });
      } catch (err) { /* fall through with empty sectionIds */ }
    }

    /* Shopify's Section Rendering API accepts JSON for /cart/add.js when
       you pass `items` + `sections`. Stick with that even for a single
       item — it's the canonical contract. */
    var payload = {
      items: [{ id: parseInt(variantId, 10), quantity: 1 }],
      sections: sectionIds,
      sections_url: window.location.pathname
    };

    fetch((window.routes && window.routes.cart_add_url) || '/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify(payload),
      credentials: 'same-origin'
    })
      .then(function(r) {
        return r.json().then(function(data) { return { ok: r.ok, status: r.status, data: data }; });
      })
      .then(function(res) {
        card.classList.remove('is-loading');
        if (!res.ok) {
          throw new Error((res.data && res.data.description) || 'cart_add_failed');
        }
        card.classList.add('is-added');
        btn.textContent = addedText;

        /* Swap fresh section HTML into the drawer. Mirrors the theme's
           own BundleAddToCart.updateCartSections() implementation in
           theme.js (~line 4242) — we look up `#minicart-form` inside
           each rendered section's HTML and replace the live drawer's
           equivalent element. */
        var data = res.data || {};
        if (cartUI && data.sections && typeof cartUI.getSectionsToRender === 'function') {
          try {
            cartUI.getSectionsToRender().forEach(function(section) {
              var elementToReplace = document.getElementById(section.id);
              if (!elementToReplace || !data.sections[section.id]) return;
              var rendered = new DOMParser().parseFromString(data.sections[section.id], 'text/html');
              var newInner = rendered.querySelector('#minicart-form');
              if (newInner) {
                elementToReplace.innerHTML = newInner.innerHTML;
              } else {
                elementToReplace.innerHTML = rendered.body.innerHTML;
              }
            });
            if (typeof cartUI.cartAction === 'function') cartUI.cartAction();
          } catch (err) {
            console.warn('[upsell-pro] section refresh failed:', err);
          }
        }

        /* Refresh the header count bubble (and any peripheral counters).
           Independent of drawer state — the count must always reflect the
           new total even when the drawer doesn't open. */
        fetch('/cart.json', { credentials: 'same-origin' })
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            if (cart && cart.item_count !== undefined) {
              document.querySelectorAll('.cart-count').forEach(function(el) {
                if (el.classList.contains('cart-count-drawer')) {
                  el.innerHTML = '(' + cart.item_count + ')';
                } else {
                  el.innerHTML = cart.item_count > 100 ? '~' : String(cart.item_count);
                }
                el.classList.remove('hidden');
                el.style.display = '';
              });
              var totalEl = document.querySelector('header-total-price');
              if (totalEl && typeof totalEl.updateTotal === 'function') {
                totalEl.updateTotal(cart);
              }
              if (typeof publish === 'function') {
                try { publish('cartUpdate', { source: 'upsell-pro', cart: cart }); } catch (e) {}
              }
              document.dispatchEvent(new CustomEvent('cart:updated', { detail: { source: 'upsell-pro', cart: cart } }));
              document.dispatchEvent(new CustomEvent('cart:refresh', { detail: { cart: cart } }));
            }
          })
          .catch(function() { /* best-effort */ });

        /* Open the drawer only if the merchant explicitly enabled it.
           Prefer the cart UI element's own .open() method (theme-aware),
           fall back to known class toggles. */
        if (openDrawer) {
          if (cartUI) {
            if (typeof cartUI.open === 'function') cartUI.open();
            else if (typeof cartUI.openDrawer === 'function') cartUI.openDrawer();
            else cartUI.classList && cartUI.classList.add('is-open', 'open', 'active');
          } else {
            var drawer = document.querySelector('[data-cart-drawer], minicart-drawer, side-cart');
            if (drawer) {
              if (typeof drawer.openDrawer === 'function') drawer.openDrawer();
              else if (typeof drawer.open === 'function') drawer.open();
              else drawer.classList && drawer.classList.add('is-open', 'open', 'active');
            }
          }
          document.dispatchEvent(new CustomEvent('cart:open'));
          if (typeof publish === 'function') { try { publish('openCart'); } catch (e) {} }
        }

        setTimeout(function() {
          card.classList.remove('is-added');
          btn.textContent = btnText;
          btn.disabled = false;
        }, 1800);
      })
      .catch(function(err) {
        console.error('[upsell-pro] add failed:', err);
        card.classList.remove('is-loading');
        btn.textContent = I18N_TRY_AGAIN;
        setTimeout(function() { btn.textContent = btnText; btn.disabled = false; }, 1800);
      });
  });
})();
{% comment %}{% endcomment %}</script>
{%- endif -%}

</template>