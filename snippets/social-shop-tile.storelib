<template compat="shopify">
{%- comment -%}
  Materia Themes. A tile of Social Shop Grid (sections/social-shop-grid).
  Inputs: b (block.settings), s (section.settings), ssg_hf / ssg_bf (the
  section's custom heading / body font is on). badge_only: draw only that
  platform badge (the builder keeps them in a template for live edits).
  In the builder the handle, headline and product chip are drawn hidden
  when off or empty, so live-social-dividers.js can show them live.
{%- endcomment -%}
{%- if badge_only -%}
  {%- case badge_only -%}
    {%- when 'instagram' -%}<span class="ssg-platform-badge" data-ssg-badge="instagram" role="img" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></span>
    {%- when 'tiktok' -%}<span class="ssg-platform-badge" data-ssg-badge="tiktok" role="img" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 8.7v3.7a8.1 8.1 0 0 1-4.7-1.5v6.3a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v3.7a2 2 0 1 0 1.4 1.9V2h3.4a4.7 4.7 0 0 0 4.6 4.6V8.7Z"/></svg></span>
    {%- when 'youtube' -%}<span class="ssg-platform-badge" data-ssg-badge="youtube" role="img" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.5a2.5 2.5 0 0 0-1.7-1.8C18.6 6.3 12 6.3 12 6.3s-6.6 0-8.3.4A2.5 2.5 0 0 0 2 8.5C1.6 10.2 1.6 12 1.6 12s0 1.8.4 3.5A2.5 2.5 0 0 0 3.7 17.3c1.7.4 8.3.4 8.3.4s6.6 0 8.3-.4A2.5 2.5 0 0 0 22 15.5c.4-1.7.4-3.5.4-3.5s0-1.8-.4-3.5ZM10 15V9l5 3-5 3Z"/></svg></span>
    {%- when 'pinterest' -%}<span class="ssg-platform-badge" data-ssg-badge="pinterest" role="img" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9.2-.7 1-4.6 1-4.6s-.3-.5-.3-1.3c0-1.3.7-2.2 1.7-2.2.8 0 1.2.6 1.2 1.3 0 .8-.5 2-.7 3-.2.9.4 1.6 1.3 1.6 1.6 0 2.7-2 2.7-4.4 0-1.8-1.2-3.2-3.5-3.2a3.9 3.9 0 0 0-4.1 4c0 .7.3 1.5.6 2 .1.1.1.1.1.2l-.2.9c0 .2-.1.2-.3.1-1.1-.5-1.8-2.1-1.8-3.4 0-2.8 2-5.4 5.9-5.4 3.1 0 5.5 2.2 5.5 5.2 0 3.1-2 5.6-4.7 5.6-.9 0-1.8-.5-2.1-1l-.5 2.2c-.2.8-.7 1.7-1.1 2.3A10 10 0 1 0 12 2Z"/></svg></span>
  {%- endcase -%}
{%- else -%}
{%- liquid
  assign tile_href = ''
  if b.product != blank
    assign tile_href = b.product.url
  elsif b.link != blank
    assign tile_href = b.link
  endif
  assign avatar_letter = b.username | default: '@' | strip | replace: '@', '' | slice: 0, 1 | upcase
  assign show_handle = false
  if s.show_handle and b.username != blank
    assign show_handle = true
  endif
  assign show_chip = false
  if s.show_product and b.product != blank
    assign show_chip = true
  endif
  assign show_content = false
  if b.headline != blank or show_chip
    assign show_content = true
  endif
  assign tile_label = b.headline | default: b.username | default: 'Tile'
-%}
<{% if tile_href != blank %}a href="{{ tile_href }}" aria-label="{{ tile_label | escape }}"{% else %}div{% endif %} class="ssg-tile" data-ssg-tile>
  {%- if b.video != blank -%}
    {%- assign vsrc = '' -%}
    {%- for src in b.video.sources -%}
      {%- if src.format == 'mp4' -%}{%- assign vsrc = src.url -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- comment -%} Plays muted while on screen (live-social-dividers.js), never under reduced motion. {%- endcomment -%}
    <video muted loop playsinline preload="metadata" data-ssg-video
      {% if b.image != blank %}poster="{{ b.image | image_url: width: 600 }}"{% endif %}>
      <source src="{{ vsrc }}" type="video/mp4">
    </video>
  {%- elsif b.image != blank -%}
    <img data-sd-img src="{{ b.image | image_url: width: 600 }}"
         srcset="{{ b.image | image_url: width: 300 }} 300w, {{ b.image | image_url: width: 600 }} 600w, {{ b.image | image_url: width: 900 }} 900w"
         sizes="(min-width: 768px) calc(100vw / {{ s.columns }}), calc(100vw / {{ s.columns_mobile }})"
         alt="{{ b.headline | default: b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy" decoding="async">
  {%- else -%}
    <span class="ssg-ph" data-sd-ph>{%- render 'placeholder-render', class: 'ssg-tile__placeholder' -%}</span>
  {%- endif -%}

  <div class="ssg-overlay" aria-hidden="true"></div>

  {%- if show_handle or request.design_mode -%}
    <div class="ssg-handle" data-ssg-handle{% unless show_handle %} hidden{% endunless %}>
      {%- if b.avatar != blank -%}
        <img src="{{ b.avatar | image_url: width: 64 }}" alt="" width="18" height="18" loading="lazy" data-ssg-avatar>
      {%- else -%}
        <span class="ssg-avatar" aria-hidden="true" data-ssg-avatar>{{ avatar_letter }}</span>
      {%- endif -%}
      <span data-ssg-username>{{ b.username }}</span>
    </div>
  {%- endif -%}

  <span class="ssg-badge-slot" data-ssg-badge-slot="{{ b.platform | default: 'none' }}">
  {%- case b.platform -%}
    {%- when 'instagram' -%}<span class="ssg-platform-badge" data-ssg-badge="instagram" role="img" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></span>
    {%- when 'tiktok' -%}<span class="ssg-platform-badge" data-ssg-badge="tiktok" role="img" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 8.7v3.7a8.1 8.1 0 0 1-4.7-1.5v6.3a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v3.7a2 2 0 1 0 1.4 1.9V2h3.4a4.7 4.7 0 0 0 4.6 4.6V8.7Z"/></svg></span>
    {%- when 'youtube' -%}<span class="ssg-platform-badge" data-ssg-badge="youtube" role="img" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.5a2.5 2.5 0 0 0-1.7-1.8C18.6 6.3 12 6.3 12 6.3s-6.6 0-8.3.4A2.5 2.5 0 0 0 2 8.5C1.6 10.2 1.6 12 1.6 12s0 1.8.4 3.5A2.5 2.5 0 0 0 3.7 17.3c1.7.4 8.3.4 8.3.4s6.6 0 8.3-.4A2.5 2.5 0 0 0 22 15.5c.4-1.7.4-3.5.4-3.5s0-1.8-.4-3.5ZM10 15V9l5 3-5 3Z"/></svg></span>
    {%- when 'pinterest' -%}<span class="ssg-platform-badge" data-ssg-badge="pinterest" role="img" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9.2-.7 1-4.6 1-4.6s-.3-.5-.3-1.3c0-1.3.7-2.2 1.7-2.2.8 0 1.2.6 1.2 1.3 0 .8-.5 2-.7 3-.2.9.4 1.6 1.3 1.6 1.6 0 2.7-2 2.7-4.4 0-1.8-1.2-3.2-3.5-3.2a3.9 3.9 0 0 0-4.1 4c0 .7.3 1.5.6 2 .1.1.1.1.1.2l-.2.9c0 .2-.1.2-.3.1-1.1-.5-1.8-2.1-1.8-3.4 0-2.8 2-5.4 5.9-5.4 3.1 0 5.5 2.2 5.5 5.2 0 3.1-2 5.6-4.7 5.6-.9 0-1.8-.5-2.1-1l-.5 2.2c-.2.8-.7 1.7-1.1 2.3A10 10 0 1 0 12 2Z"/></svg></span>
  {%- endcase -%}
  </span>

  {%- if show_content or request.design_mode -%}
    <div class="ssg-content" data-ssg-content{% unless show_content %} hidden{% endunless %}>
      {%- if b.headline != blank or request.design_mode -%}
        <h3 class="ssg-headline" data-ssg-headline{% if ssg_hf %} data-own-font{% endif %}{% if b.headline == blank %} hidden{% endif %}>{{ b.headline | escape }}</h3>
      {%- endif -%}
      {%- if b.product != blank -%}
        {%- if show_chip or request.design_mode -%}
          {%- assign p = b.product -%}
          <span class="ssg-product" data-ssg-product{% if ssg_bf %} data-own-font{% endif %}{% unless show_chip %} hidden{% endunless %}>
            {%- if p.featured_image != blank -%}
              <img src="{{ p.featured_image | image_url: width: 64 }}" alt="" width="22" height="22" loading="lazy">
            {%- endif -%}
            <span>
              <span class="ssg-product-name">{{ p.title }}</span>
              <span class="ssg-product-price">{{ p.price | money }}</span>
            </span>
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</{% if tile_href != blank %}a{% else %}div{% endif %}>
{%- endif -%}
</template>