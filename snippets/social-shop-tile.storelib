<template compat="shopify">
{%- comment -%}
  Tile for Social Shop Grid section.
  Inputs: b (block.settings), s (section.settings)
{%- endcomment -%}
{%- liquid
  assign has_link = false
  assign tile_href = '#'
  if b.product != blank
    assign has_link = true
    assign tile_href = b.product.url
  elsif b.link != blank
    assign has_link = true
    assign tile_href = b.link
  endif
  assign avatar_letter = b.username | default: '@' | strip | replace: '@', '' | slice: 0, 1 | upcase
-%}
{%- if has_link -%}
  <a class="ssg-tile" href="{{ tile_href }}" aria-label="{{ b.headline | default: b.username | default: 'Tile' | escape }}">
{%- else -%}
  <div class="ssg-tile">
{%- endif -%}

  {%- if b.video != blank -%}
    {%- assign vsrc = '' -%}
    {%- for src in b.video.sources -%}
      {%- if src.format == 'mp4' -%}{%- assign vsrc = src.url -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    <video autoplay muted loop playsinline preload="metadata"
      {% if b.image != blank %}poster="{{ b.image | image_url: width: 600 }}"{% endif %}>
      <source src="{{ vsrc }}" type="video/mp4">
    </video>
  {%- elsif b.image != blank -%}
    <img src="{{ b.image | image_url: width: 600 }}"
         srcset="{{ b.image | image_url: width: 300 }} 300w, {{ b.image | image_url: width: 600 }} 600w, {{ b.image | image_url: width: 900 }} 900w"
         sizes="(min-width: 768px) calc(100vw / {{ s.columns }}), calc(100vw / {{ s.columns_mobile }})"
         alt="{{ b.headline | default: b.image.alt | default: 'Tile' | escape }}" loading="lazy">
  {%- else -%}
    <img src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
         alt="{{ b.headline | default: 'Placeholder' | escape }}" loading="lazy" width="900" height="600">
  {%- endif -%}

  <div class="ssg-overlay"></div>

  {%- if s.show_handle and b.username != blank -%}
    <div class="ssg-handle">
      {%- if b.avatar != blank -%}
        <img src="{{ b.avatar | image_url: width: 64 }}" alt="{{ b.username | escape }}" loading="lazy">
      {%- else -%}
        <span style="width:18px;height:18px;border-radius:50%;background:var(--ssg-accent, #ff2d55);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;">{{ avatar_letter }}</span>
      {%- endif -%}
      <span>{{ b.username }}</span>
    </div>
  {%- endif -%}

  {%- case b.platform -%}
    {%- when 'instagram' -%}
      <span class="ssg-platform-badge" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></span>
    {%- when 'tiktok' -%}
      <span class="ssg-platform-badge" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 8.7v3.7a8.1 8.1 0 0 1-4.7-1.5v6.3a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v3.7a2 2 0 1 0 1.4 1.9V2h3.4a4.7 4.7 0 0 0 4.6 4.6V8.7Z"/></svg></span>
    {%- when 'youtube' -%}
      <span class="ssg-platform-badge" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.5a2.5 2.5 0 0 0-1.7-1.8C18.6 6.3 12 6.3 12 6.3s-6.6 0-8.3.4A2.5 2.5 0 0 0 2 8.5C1.6 10.2 1.6 12 1.6 12s0 1.8.4 3.5A2.5 2.5 0 0 0 3.7 17.3c1.7.4 8.3.4 8.3.4s6.6 0 8.3-.4A2.5 2.5 0 0 0 22 15.5c.4-1.7.4-3.5.4-3.5s0-1.8-.4-3.5ZM10 15V9l5 3-5 3Z"/></svg></span>
    {%- when 'pinterest' -%}
      <span class="ssg-platform-badge" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9.2-.7 1-4.6 1-4.6s-.3-.5-.3-1.3c0-1.3.7-2.2 1.7-2.2.8 0 1.2.6 1.2 1.3 0 .8-.5 2-.7 3-.2.9.4 1.6 1.3 1.6 1.6 0 2.7-2 2.7-4.4 0-1.8-1.2-3.2-3.5-3.2a3.9 3.9 0 0 0-4.1 4c0 .7.3 1.5.6 2 .1.1.1.1.1.2l-.2.9c0 .2-.1.2-.3.1-1.1-.5-1.8-2.1-1.8-3.4 0-2.8 2-5.4 5.9-5.4 3.1 0 5.5 2.2 5.5 5.2 0 3.1-2 5.6-4.7 5.6-.9 0-1.8-.5-2.1-1l-.5 2.2c-.2.8-.7 1.7-1.1 2.3A10 10 0 1 0 12 2Z"/></svg></span>
  {%- endcase -%}

  {%- if b.headline != blank or s.show_product and b.product != blank -%}
    <div class="ssg-content">
      {%- if b.headline != blank -%}
        <h3 class="ssg-headline">{{ b.headline }}</h3>
      {%- endif -%}
      {%- if s.show_product and b.product != blank -%}
        {%- assign p = b.product -%}
        <span class="ssg-product">
          {%- if p.featured_image != blank -%}
            <img src="{{ p.featured_image | image_url: width: 64 }}" alt="{{ p.title | escape }}" loading="lazy">
          {%- endif -%}
          <span>
            <span class="ssg-product-name">{{ p.title }}</span>
            <span class="ssg-product-price">{{ p.price | money }}</span>
          </span>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

{%- if has_link -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

</template>