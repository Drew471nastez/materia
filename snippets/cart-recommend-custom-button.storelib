<template compat="shopify">
{%- comment -%}
  Materia Themes — Cart recommendations: custom Add-to-Cart button colors.

  Emits a scoped <style> block that overrides the Button-Primary scheme
  on the cart-recommendation product cards (the "You may also like…"
  list inside the cart drawer + cart page) when the master toggle
  `settings.enable_custom_recommend_btn` is ON.

  When the toggle is OFF (default), this snippet emits NOTHING and the
  recommendation buttons keep using the existing Button-Primary tokens.

  Scope: every selector is anchored under `.cart-recommend` so the
  override never leaks to other product-item instances on the page
  (collection cards, featured products, related products outside the
  cart). The `.product-item__button-submit` class is the actual button
  rendered by `snippets/product-item.liquid` when `type: 'list'` is
  passed — used exclusively in cart recommendations.

  Specificity: every rule uses `!important` because the base button
  styling in `assets/critical.css` + `assets/theme.css` also uses
  `!important` on the scheme tokens. Inline-style block rendered AFTER
  product-card.css from theme.liquid → cascade order resolves ties
  toward this block.

  Each colour is gated on `!= blank` so partial customization works
  (e.g. only change the hover background, leave everything else as the
  scheme default).
{%- endcomment -%}
{%- liquid
  assign custom_enabled = settings.enable_custom_recommend_btn
  assign scope = '#minicart_wrapper .cart-recommend'
  if cart_page
    assign custom_enabled = settings.cart_page_enable_custom_recommend_btn
    assign scope = '.template-cart .cart-recommend'
  endif
-%}
{%- if custom_enabled -%}
  {%- assign recommend_btn_bg = settings.recommend_btn_bg -%}
  {%- if cart_page -%}{%- assign recommend_btn_bg = settings.cart_page_recommend_btn_bg -%}{%- endif -%}
  {%- assign recommend_btn_color = settings.recommend_btn_color -%}
  {%- if cart_page -%}{%- assign recommend_btn_color = settings.cart_page_recommend_btn_color -%}{%- endif -%}
  {%- assign recommend_btn_hover_bg = settings.recommend_btn_hover_bg -%}
  {%- if cart_page -%}{%- assign recommend_btn_hover_bg = settings.cart_page_recommend_btn_hover_bg -%}{%- endif -%}
  {%- assign recommend_btn_hover_color = settings.recommend_btn_hover_color -%}
  {%- if cart_page -%}{%- assign recommend_btn_hover_color = settings.cart_page_recommend_btn_hover_color -%}{%- endif -%}
  {%- assign s = settings -%}
  <style data-cart-recommend-custom-btn data-cart-drawer-style="recommend">
    /* ===== Theme buttons (data-theme-button) =====
       theme-button-contract.css paints these from --mb-* tokens in a
       cascade layer, which a plain !important background cannot beat, so
       the colours go in as tokens: painted at rest, the theme's hover
       effect and timing kept. */
    {{ scope }} [data-theme-button],
    {{ scope }} .product-item [data-theme-button] {
      {%- if recommend_btn_bg != blank %} --mb-bg: {{ recommend_btn_bg }}; --mb-border: {{ recommend_btn_bg }};{% endif -%}
      {%- if recommend_btn_color != blank %} --mb-text: {{ recommend_btn_color }};{% endif -%}
      {%- if recommend_btn_hover_bg != blank %} --mb-hover-bg: {{ recommend_btn_hover_bg }}; --mb-hover-border: {{ recommend_btn_hover_bg }};{% endif -%}
      {%- if recommend_btn_hover_color != blank %} --mb-hover-text: {{ recommend_btn_hover_color }};{% endif %}
    }
    /* ===== Other buttons: base state ===== */
    {%- if recommend_btn_bg != blank -%}
      {{ scope }} .product-item__button-submit:not([data-theme-button]),
      {{ scope }} .bls-add-cart-list:not([data-theme-button]),
      {{ scope }} a.btn-primary:not([data-theme-button]),
      {{ scope }} button.btn-primary:not([data-theme-button]) {
        background: {{ recommend_btn_bg }} !important;
        background-color: {{ recommend_btn_bg }} !important;
        border-color: {{ recommend_btn_bg }} !important;
      }
    {%- endif -%}
    {%- if recommend_btn_color != blank -%}
      {{ scope }} .product-item__button-submit,
      {{ scope }} .product-item__button-submit *,
      {{ scope }} .bls-add-cart-list,
      {{ scope }} .bls-add-cart-list *,
      {{ scope }} a.btn-primary,
      {{ scope }} a.btn-primary *,
      {{ scope }} button.btn-primary,
      {{ scope }} button.btn-primary * {
        color: {{ recommend_btn_color }} !important;
      }
    {%- endif -%}

    /* ===== Hover state ===== */
    @media (hover: hover) and (pointer: fine) {
      {%- if recommend_btn_hover_bg != blank -%}
        {{ scope }} .product-item__button-submit:hover,
        {{ scope }} .bls-add-cart-list:hover,
        {{ scope }} a.btn-primary:hover,
        {{ scope }} button.btn-primary:hover {
          background: {{ recommend_btn_hover_bg }} !important;
          background-color: {{ recommend_btn_hover_bg }} !important;
          border-color: {{ recommend_btn_hover_bg }} !important;
        }
      {%- endif -%}
      {%- if recommend_btn_hover_color != blank -%}
        {{ scope }} .product-item__button-submit:hover,
        {{ scope }} .product-item__button-submit:hover *,
        {{ scope }} .bls-add-cart-list:hover,
        {{ scope }} .bls-add-cart-list:hover *,
        {{ scope }} a.btn-primary:hover,
        {{ scope }} a.btn-primary:hover *,
        {{ scope }} button.btn-primary:hover,
        {{ scope }} button.btn-primary:hover * {
          color: {{ recommend_btn_hover_color }} !important;
        }
      {%- endif -%}
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}

</template>
