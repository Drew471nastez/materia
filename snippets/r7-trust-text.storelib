<template compat="shopify">
{%- comment -%}
  Materia Themes. The Heading and Text blocks of Logo Wall and Press
  Mentions (round 7, Logos and trust). The same setting ids as the other
  Logos and trust sections, so the words carry over when a creator swaps
  one section for another. Colours follow the colour scheme until the
  block's custom styling is on. live-r7-trust.js applies the same values
  in the builder.
  {% render 'r7-trust-text', block: block, p: 'lw', design: request.design_mode %}
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign r7g_c = 'none' -%}
{%- if bs.enable_custom_style -%}{%- capture r7g_c -%}{%- render 'scheme-color', color: bs.color, fallback: 'none' -%}{%- endcapture -%}{%- assign r7g_c = r7g_c | strip -%}{%- endif -%}
{%- capture r7g_json -%}{"text":{{ bs.text | append: '' | json }},"enable_custom_style":{% if bs.enable_custom_style %}true{% else %}false{% endif %},"color":{{ bs.color | append: '' | json }},"size_desktop":{{ bs.size_desktop | default: 0 | json }},"size_mobile":{{ bs.size_mobile | default: 0 | json }}}{%- endcapture -%}
{%- capture r7g_attrs -%}data-r7g-block="{{ block.id }}" data-r7g-type="{{ block.type }}"{% if design %} data-r7g-settings="{{ r7g_json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{% if r7g_c != 'none' %}--b-c: {{ r7g_c }};{% endif %}--b-fs-m: {{ bs.size_mobile | default: 15 }}px;--b-fs-d: {{ bs.size_desktop | default: 16 }}px;" {{ block.shopify_attributes }}{%- endcapture -%}
{%- if block.type == 'heading' -%}
<h2 class="{{ p }}__heading" {{ r7g_attrs }}>{{ bs.text }}</h2>
{%- else -%}
<div class="{{ p }}__sub" {{ r7g_attrs }}>{{ bs.text }}</div>
{%- endif -%}
</template>
