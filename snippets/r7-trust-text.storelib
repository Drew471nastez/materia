<template compat="shopify">
{%- comment -%}
  Materia Themes. The Heading and Text blocks of Logo Wall and Press
  Mentions (round 7, Logos and trust). The same setting ids as the other
  Logos and trust sections, so the words carry over when a creator swaps
  one section for another. Colours follow the colour scheme until the
  block's custom styling is on. live-r7-trust.js applies the same values
  in the builder.
  {% render 'r7-trust-text', block: block, p: 'lw', design: request.design_mode %}
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign r7t_c = 'none' -%}
{%- if bs.enable_custom_style -%}{%- capture r7t_c -%}{%- render 'scheme-color', color: bs.color, fallback: 'none' -%}{%- endcapture -%}{%- assign r7t_c = r7t_c | strip -%}{%- endif -%}
{%- capture r7t_json -%}{"text":{{ bs.text | append: '' | json }},"enable_custom_style":{% if bs.enable_custom_style %}true{% else %}false{% endif %},"color":{{ bs.color | append: '' | json }},"size_desktop":{{ bs.size_desktop | default: 0 | json }},"size_mobile":{{ bs.size_mobile | default: 0 | json }}}{%- endcapture -%}
{%- capture r7t_attrs -%}data-r7t-block="{{ block.id }}" data-r7t-type="{{ block.type }}"{% if design %} data-r7t-settings="{{ r7t_json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %} style="{% if r7t_c != 'none' %}--b-c: {{ r7t_c }};{% endif %}--b-fs-m: {{ bs.size_mobile | default: 15 }}px;--b-fs-d: {{ bs.size_desktop | default: 16 }}px;" {{ block.shopify_attributes }}{%- endcapture -%}
{%- if block.type == 'heading' -%}
<h2 class="{{ p }}__heading" {{ r7t_attrs }}>{{ bs.text }}</h2>
{%- else -%}
<div class="{{ p }}__sub" {{ r7t_attrs }}>{{ bs.text }}</div>
{%- endif -%}
</template>
