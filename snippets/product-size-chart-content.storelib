<template compat="shopify">
{%- comment -%} Product-specific HTML or page-reference chart. Shared by the
  variant picker guide and chart popup. Missing data produces no fake chart. {%- endcomment -%}
{%- liquid
  assign chart = product.metafields.custom.size_chart.value | default: product.metafields.custom.size_chart
  assign chart_page = pages[chart]
-%}
{%- if chart.content != blank -%}
  {{- chart.content -}}
{%- elsif chart_page.content != blank -%}
  {{- chart_page.content -}}
{%- elsif chart contains '<' -%}
  {{- chart -}}
{%- endif -%}
</template>
