<template compat="shopify">
{%- comment -%}
  Materia Themes. FAQPage structured data for the FAQ sections, built from
  the questions on the page (items: the section's question blocks, each
  with question and answer settings). A question or answer left empty is
  left out. Printed only when the section's "Add FAQ structured data" is on.
{%- endcomment -%}
{%- assign faq_ld_sep = '' -%}
{%- capture faq_ld_entities -%}
  {%- for item in items -%}
    {%- assign faq_ld_q = item.settings.question | strip_html | strip -%}
    {%- assign faq_ld_a = item.settings.answer | strip_html | strip -%}
    {%- if faq_ld_q != blank and faq_ld_a != blank -%}
      {{ faq_ld_sep }}{"@type":"Question","name":{{ faq_ld_q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ faq_ld_a | json }}}}
      {%- assign faq_ld_sep = ',' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if faq_ld_entities != blank -%}
<script type="application/ld+json" data-faq-jsonld>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_ld_entities | replace: '</', '<\/' }}]}</script>
{%- endif -%}
</template>
