<template compat="shopify">
{%- comment -%}
  Materia Themes. One block of FAQ Search (sections/faq-search) or FAQ With
  Contact Card (sections/faq-contact-card), by its type: heading, subheading,
  faq_item, card_text, button, contact_line.

  block: the block. section: its section. open: this question starts open.
  group: the name shared by the questions when only one may be open (a
  <details name>), empty when several may.

  A question is a <details>, so it opens with scripts off. In the builder
  every block carries its settings as JSON (data-r7f-bs) for
  live-r7-faq.js, which applies an edit without drawing the section again.
  data-own-font / data-own-weight / data-own-size / data-own-shape keep a
  custom font, weight, size or button shape ahead of Theme settings >
  Typography and Buttons priority, here in the first paint and from the
  script on live edits.
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign st = section.settings
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
-%}
{%- capture r7f_data -%}data-r7f-block="{{ block.id }}" data-r7f-type="{{ block.type }}"{% if request.design_mode %} data-r7f-bs="{{ bs | json | escape }}"{% endif %} {{ block.shopify_attributes }}{%- endcapture -%}
{%- case block.type -%}
  {%- when 'heading' -%}
    {%- capture fb_vars -%}
      {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
      {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 700 }};{%- endif -%}
      {%- if bs.size_enable -%}--fb-fs-d:{{ bs.size_desktop | default: 36 }}px;--fb-fs-m:{{ bs.size_mobile | default: 26 }}px;--fb-lh:{{ bs.line_height | default: 1.15 }};--fb-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
    {%- endcapture -%}
    {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
    <h2 class="r7f__heading" {{ r7f_data }}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %}>{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    {%- capture fb_vars -%}
      {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
      {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 400 }};{%- endif -%}
      {%- if bs.size_enable -%}--fb-fs:{{ bs.size | default: 16 }}px;--fb-lh:{{ bs.line_height | default: 1.5 }};{%- endif -%}
      {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
    {%- endcapture -%}
    {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
    <div class="r7f__subheading" {{ r7f_data }}{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %}>{{ bs.text }}</div>
  {%- when 'faq_item' -%}
    {%- assign fb_question = 'accessibility.question_goes_here' | t -%}
    <details class="r7f__item" data-r7f-item {{ r7f_data }}{% if group != blank %} name="{{ group }}"{% endif %}{% if open %} open{% endif %}{% if bs.keywords != blank %} data-r7f-keys="{{ bs.keywords | escape }}"{% endif %}>
      <summary class="r7f__summary">
        <h3 class="r7f__q" data-r7f-question{% if sec_font %} data-own-font{% endif %}{% if st.enable_custom_question_weight %} data-own-weight{% endif %}>{{ bs.question | default: fb_question }}</h3>
        <span class="r7f__icon" aria-hidden="true"><svg class="r7f__chev" viewBox="0 0 24 24" focusable="false"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="r7f__plus"></span></span>
      </summary>
      <div class="r7f__a" data-r7f-answer{% if sec_font %} data-own-font{% endif %}>{{ bs.answer }}</div>
    </details>
  {%- when 'card_text' -%}
    <div class="r7f__card-text" {{ r7f_data }}{% if bs.heading == blank and bs.text == blank %} hidden{% endif %}>
      <h3 class="r7f__card-heading" data-r7f-card-heading{% if sec_font %} data-own-font{% endif %}{% if bs.heading == blank %} hidden{% endif %}>{{ bs.heading }}</h3>
      <div class="r7f__card-body" data-r7f-card-body{% if sec_font %} data-own-font{% endif %}{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>
    </div>
  {%- when 'button' -%}
    {%- liquid
      assign fb_learn_more = 'accessibility.learn_more' | t
      assign btn_label = bs.label | default: fb_learn_more
      assign btn_style = bs.style | default: 'primary'
      assign btn_size = bs.size | default: 'medium'
      assign own_shape = false
      if bs.use_theme_button == false
        assign own_shape = true
      endif
    -%}
    {%- capture btn_vars -%}
      {%- comment -%} Custom styling: this button's own colours, starting from the primary button's. {%- endcomment -%}
      {%- if bs.enable_custom_style -%}--mb-bg:{% render 'scheme-color', color: bs.bg_color, fallback: 'var(--btn-primary-bg-color)' %};--mb-text:{% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-primary-color)' %};--mb-border:{% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};--mb-hover-bg:{% render 'scheme-color', color: bs.bg_color_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};--mb-hover-text:{% render 'scheme-color', color: bs.text_color_hover, fallback: 'var(--btn-primary-hover-color)' %};{%- endif -%}
      {%- if own_shape -%}
        --mb-radius:{{ bs.radius | default: 100 }}px;
        {%- case btn_size -%}
          {%- when 'small' -%}--mb-font-size:13px;--mb-padding-y:10px;--mb-padding-x:18px;
          {%- when 'large' -%}--mb-font-size:16px;--mb-padding-y:16px;--mb-padding-x:32px;
          {%- else -%}--mb-font-size:14px;--mb-padding-y:13px;--mb-padding-x:24px;
        {%- endcase -%}
      {%- endif -%}
    {%- endcapture -%}
    <div class="r7f__cta" {{ r7f_data }}>
      {%- if bs.link != blank -%}
        <a class="r7f__btn r7f__btn--{{ btn_style }}" data-r7f-btn{% if btn_style == 'text' %} data-button-local-appearance="underline"{% else %} data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-button-local-appearance="theme"{% endif %} data-full="{% if bs.full_width %}true{% else %}false{% endif %}"{% if own_shape %} data-own-shape{% endif %} href="{{ bs.link }}"{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}>{{ btn_label | escape }}</a>
      {%- else -%}
        <button type="button" class="r7f__btn r7f__btn--{{ btn_style }}" data-r7f-btn{% if btn_style == 'text' %} data-button-local-appearance="underline"{% else %} data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-button-local-appearance="theme"{% endif %} data-full="{% if bs.full_width %}true{% else %}false{% endif %}"{% if own_shape %} data-own-shape{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}>{{ btn_label | escape }}</button>
      {%- endif -%}
    </div>
  {%- when 'contact_line' -%}
    {%- comment -%} The line's link: the Link setting, or, left empty, the text itself when it is an email address (mailto:) or a phone number (tel:). {%- endcomment -%}
    {%- liquid
      assign line_text = bs.text | strip
      assign line_href = bs.link
      if line_href == blank and line_text != blank
        assign line_compact = line_text | remove: ' '
        assign line_digits = line_compact | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
        assign line_rest = line_digits | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
        if line_text contains '@' and line_compact == line_text
          assign line_href = 'mailto:' | append: line_text
        elsif line_rest == blank and line_digits.size >= 6
          assign line_href = line_compact | remove: '-' | remove: '(' | remove: ')' | remove: '.' | prepend: 'tel:'
        endif
      endif
    -%}
    <div class="r7f__line" {{ r7f_data }}{% if bs.label == blank and line_text == blank %} hidden{% endif %}>
      <span class="r7f__line-label" data-r7f-line-label{% if bs.label == blank %} hidden{% endif %}>{{ bs.label | escape }}</span>
      {%- if line_href != blank -%}
        <a class="r7f__line-value" data-r7f-line-value href="{{ line_href }}"{% if line_text == blank %} hidden{% endif %}>{{ line_text | escape }}</a>
      {%- else -%}
        <span class="r7f__line-value" data-r7f-line-value{% if line_text == blank %} hidden{% endif %}>{{ line_text | escape }}</span>
      {%- endif -%}
    </div>
{%- endcase -%}
</template>
