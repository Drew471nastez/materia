<template compat="shopify">
{%- comment -%}
  Materia Themes. An Eyebrow, Heading or Subheading block in the header of
  Recently Viewed and Product Duo. Colours follow the colour scheme until the
  block's Enable custom styling is on. live-r7-products.js writes the same
  values in the builder (the settings JSON is printed there only).
  block: the block. sid: the section id, for the heading's id.
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture r7p_style -%}
  {%- if block.type == 'heading' -%}
    {%- if bs.enable_custom_style -%}--r7p-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
    --r7p-fs-d: {{ bs.size_desktop | default: 32 }}px;--r7p-fs-m: {{ bs.size_mobile | default: 26 }}px;
  {%- else -%}
    {%- if bs.enable_custom_style -%}--r7p-c: {% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
    --r7p-fs: {{ bs.size | default: 16 }}px;
  {%- endif -%}
{%- endcapture -%}
{%- capture r7p_json -%}{"text":{{ bs.text | append: '' | json }},"enable_custom_style":{% if bs.enable_custom_style %}true{% else %}false{% endif %},"color":{{ bs.color | append: '' | json }},"size":{{ bs.size | default: 0 | json }},"size_desktop":{{ bs.size_desktop | default: 0 | json }},"size_mobile":{{ bs.size_mobile | default: 0 | json }}}{%- endcapture -%}
{%- capture r7p_attrs -%}data-r7p-block="{{ block.id }}" data-r7p-type="{{ block.type }}"{% if request.design_mode %} data-r7p-settings="{{ r7p_json | escape }}"{% endif %} style="{{ r7p_style | strip }}"{% if bs.text == blank %} hidden{% endif %} {{ block.shopify_attributes }}{%- endcapture -%}
{%- case block.type -%}
  {%- when 'eyebrow' -%}
    <p class="r7p-eyebrow" {{ r7p_attrs }}>{{ bs.text | escape }}</p>
  {%- when 'heading' -%}
    <h2 class="r7p-heading" id="r7p-heading-{{ sid }}" {{ r7p_attrs }}>{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    <div class="r7p-sub rich__text-m0" {{ r7p_attrs }}>{{ bs.text }}</div>
{%- endcase -%}
</template>
