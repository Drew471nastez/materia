<template compat="shopify">
{%- comment -%}
  Materia Themes. Header > Mobile menu banner: a card in the phone menu, under
  the links of the submenu it names (or at the end of the main menu). Picture,
  small label, heading, text, a divider and a pill button, every one a setting
  of the block. Never drawn on desktop.
{%- endcomment -%}
{%- liquid
  assign mb = block.settings
  assign mb_style = ''
  if mb.banner_bg != blank and mb.banner_bg.alpha != 0
    assign mb_style = mb_style | append: '--mmb-bg: ' | append: mb.banner_bg | append: ';'
  endif
  if mb.banner_text != blank and mb.banner_text.alpha != 0
    assign mb_style = mb_style | append: '--mmb-color: ' | append: mb.banner_text | append: ';'
  endif
  if mb.button_bg != blank and mb.button_bg.alpha != 0
    assign mb_style = mb_style | append: '--mmb-btn-bg: ' | append: mb.button_bg | append: ';'
  endif
  if mb.button_color != blank and mb.button_color.alpha != 0
    assign mb_style = mb_style | append: '--mmb-btn-color: ' | append: mb.button_color | append: ';'
  endif
  assign mb_radius = mb.radius | default: 16
  if mb.radius == 0
    assign mb_radius = 0
  endif
  assign mb_style = mb_style | append: '--mmb-radius: ' | append: mb_radius | append: 'px;'
  assign mb_ratio = mb.image.aspect_ratio | default: 1.6
-%}
{%- if mb.image != blank or mb.heading != blank or mb.body != blank or mb.button_label != blank -%}
  <div class="menu-mobile-banner hidden-1025" {{ block.shopify_attributes }} style="{{ mb_style }}">
    {%- if mb.image != blank -%}
      <div class="menu-mobile-banner__media" style="--aspect-ratio: {{ mb_ratio }}">
        {% render 'responsive-image',
          hidden_at_load: true,
          type: 'other',
          image: mb.image,
          image_alt: mb.image.alt | default: mb.heading | escape,
          custom_widths: '900, 720, 540, 360',
          sizes: '(max-width: 1024px) calc(100vw - 60px), 400px'
        %}
      </div>
    {%- endif -%}
    <div class="menu-mobile-banner__body">
      {%- if mb.label != blank -%}
        <p class="menu-mobile-banner__label">{{ mb.label | escape }}</p>
      {%- endif -%}
      {%- if mb.heading != blank -%}
        <p class="menu-mobile-banner__heading heading-style">{{ mb.heading | escape }}</p>
      {%- endif -%}
      {%- if mb.body != blank -%}
        <p class="menu-mobile-banner__text">{{ mb.body | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if mb.divider == 'wave' -%}
        <svg class="menu-mobile-banner__wave" width="72" height="8" viewBox="0 0 72 8" fill="none" aria-hidden="true" focusable="false">
          <path d="M1 4c3.5-4 7-4 10.5 0S18.5 8 22 4s7-4 10.5 0 7 4 10.5 0 7-4 10.5 0 7 4 10.5 0 7-4 7-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      {%- elsif mb.divider == 'line' -%}
        <span class="menu-mobile-banner__line" aria-hidden="true"></span>
      {%- endif -%}
      {%- if mb.button_label != blank -%}
        <a
          class="menu-mobile-banner__button no-underline"
          {% if mb.button_link != blank %}href="{{ mb.button_link | remove: '#_blank' }}"{% else %}role="link" aria-disabled="true"{% endif %}
          {% render 'link-target', url: mb.button_link %}
        >
          {{- mb.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
</template>
