<template compat="shopify">
{%- assign fb_accessibility_add = 'accessibility.add' | t -%}
{%- assign fb_accessibility_sold_out = 'accessibility.sold_out' | t -%}
{%- comment -%}
  Materia Themes. One Upsell Pro card.
  Pass:
    p                - Product object (or a handle, resolved below)
    s                - block.settings
    cur_id           - id of the current product
    hide_current     - bool
    hide_unavailable - bool
    mode             - 'each' (an Add button) or 'selected' (a tick)
    dom_id           - the block's element id, for the tick's id
  Every option carries its own price, compare at price and stock, so the card
  shows the chosen option's price without asking the server.
{%- endcomment -%}

{%- if p.title == blank -%}
  {%- assign p = all_products[p] -%}
{%- endif -%}

{%- assign skip = false -%}
{%- if p == blank or p.handle == blank -%}{%- assign skip = true -%}{%- endif -%}
{%- if hide_current and p.id == cur_id -%}{%- assign skip = true -%}{%- endif -%}
{%- if hide_unavailable and p.available == false -%}{%- assign skip = true -%}{%- endif -%}

{%- unless skip -%}
  {%- liquid
    assign v = p.selected_or_first_available_variant
    assign sold_out_text = s.soldout_text | default: fb_accessibility_sold_out
    assign add_text = s.upsell_button_text | default: fb_accessibility_add
    assign with_select = false
    if p.variants.size > 1 and s.show_variant_selector
      assign with_select = true
    endif
    assign on_sale = false
    if v.compare_at_price > v.price
      assign on_sale = true
    endif
    assign check_id = dom_id | append: '-' | append: p.id
  -%}
  <div
    class="upsell-card{% if p.available == false %} is-soldout{% endif %}{% if with_select %} has-variants{% endif %}"
    role="listitem"
    data-upsell-card
    data-product-id="{{ p.id }}"
    data-product-handle="{{ p.handle }}"
    data-variant-id="{{ v.id }}"
    data-price="{{ v.price }}"
    {%- if p.available == false %} data-unavailable{% endif %}
  >
    {%- if mode == 'selected' -%}
      <input type="checkbox" class="upsell-card__check" id="{{ check_id }}" data-upsell-check aria-label="{{ p.title | escape }}"{% if s.preselect and p.available %} checked{% endif %}{% unless p.available %} disabled{% endunless %}>
      <label class="upsell-card__pick" for="{{ check_id }}"><span class="upsell-card__box" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12" fill="none"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></label>
    {%- endif -%}
    {%- if s.show_image and p.featured_image != blank -%}
      <a href="{{ p.url }}" class="upsell-card__media" tabindex="-1" aria-hidden="true">
        <img src="{{ p.featured_image | image_url: width: 300 }}" alt="" width="{{ s.image_size_px | default: 56 }}" height="{{ s.image_size_px | default: 56 }}" loading="lazy" decoding="async">
      </a>
    {%- endif -%}
    <div class="upsell-card__info">
      <a href="{{ p.url }}" class="upsell-card__title">{{ p.title | escape }}</a>
      {%- if s.show_subtitle -%}
        {%- assign sub_value = '' -%}
        {%- case s.subtitle_source -%}
          {%- when 'product_type' -%}{%- assign sub_value = p.type -%}
          {%- when 'vendor' -%}{%- assign sub_value = p.vendor -%}
          {%- when 'collection' -%}{%- assign sub_value = p.collections.first.title -%}
          {%- when 'custom' -%}{%- assign sub_value = s.custom_subtitle -%}
        {%- endcase -%}
        {%- if sub_value != blank -%}
          <span class="upsell-card__sub">{{ sub_value | escape }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if s.show_price -%}
        <div class="upsell-card__price">
          <span data-upsell-price>{{ v.price | money }}</span>
          {%- if s.show_compare_at -%}<s data-upsell-compare{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ v.compare_at_price | money }}{% endif %}</s>{%- endif -%}
          {%- if s.show_sale_badge and s.sale_badge_text != blank -%}<span class="upsell-card__sale-badge" data-upsell-sale{% unless on_sale %} hidden{% endunless %}>{{ s.sale_badge_text | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if with_select -%}
        <div class="upsell-card__variant">
          <select class="upsell-card__variant-select" data-upsell-variant aria-label="{{ p.title | escape }}: {{ 'accessibility.select_variant' | t | escape }}">
            {%- for variant in p.variants -%}
              <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}"{% if variant.id == v.id %} selected{% endif %}{% if variant.available == false %} disabled{% endif %}>
                {{- variant.title | escape }}{% if variant.available == false %} ({{ sold_out_text | escape }}){% endif -%}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <input type="hidden" data-upsell-variant value="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}" data-available="{{ v.available }}">
      {%- endif -%}
    </div>
    {%- if mode != 'selected' -%}
      <div class="upsell-card__action">
        <button type="button" class="btn upsell-card__btn" data-theme-button="secondary" data-sl-button data-button-role="secondary" data-upsell-add aria-label="{{ add_text | escape }}: {{ p.title | escape }}"{% if p.available == false %} disabled{% endif %}>
          <span data-label>{%- if p.available == false -%}{{ sold_out_text | escape }}{%- else -%}{{ add_text | escape }}{%- endif -%}</span>
        </button>
      </div>
    {%- endif -%}
  </div>
{%- endunless -%}

</template>
