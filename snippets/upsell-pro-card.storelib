<template compat="shopify">
{%- assign fb_accessibility_add = 'accessibility.add' | t -%}
{%- assign fb_accessibility_sold_out = 'accessibility.sold_out' | t -%}
{%- comment -%}
  Materia Themes — single Upsell Pro card.
  Pass:
    p             - Product object (or string handle, will be resolved)
    s             - block.settings
    is_first      - bool
    cur_id        - id of current product
    hide_current  - bool
    hide_unavailable - bool
{%- endcomment -%}

{%- comment -%} Resolve to a real Product object if a handle string was passed. {%- endcomment -%}
{%- if p.title == blank -%}
  {%- assign p = all_products[p] -%}
{%- endif -%}

{%- assign skip = false -%}
{%- if p == blank or p.handle == blank -%}{%- assign skip = true -%}{%- endif -%}
{%- if hide_current and p.id == cur_id -%}{%- assign skip = true -%}{%- endif -%}
{%- if hide_unavailable and p.available == false -%}{%- assign skip = true -%}{%- endif -%}

{%- unless skip -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  <div
    class="upsell-card{% if p.available == false %} is-soldout{% endif %}{% if p.variants.size > 1 and s.show_variant_selector %} has-variants{% endif %}"
    data-product-handle="{{ p.handle }}"
    data-variant-id="{{ v.id }}"
  >
    {%- if s.show_image and p.featured_image != blank -%}
      <a href="{{ p.url }}" class="upsell-card__media" aria-label="{{ p.title | escape }}">
        <img src="{{ p.featured_image | image_url: width: 200 }}" alt="{{ p.title | escape }}" width="56" height="56" loading="lazy">
      </a>
    {%- endif -%}
    <div class="upsell-card__info">
      <a href="{{ p.url }}" class="upsell-card__title" style="text-decoration:none;color:inherit;">{{ p.title }}</a>
      {%- if s.show_subtitle -%}
        {%- assign sub_value = '' -%}
        {%- case s.subtitle_source -%}
          {%- when 'product_type' -%}{%- assign sub_value = p.type -%}
          {%- when 'vendor' -%}{%- assign sub_value = p.vendor -%}
          {%- when 'collection' -%}{%- assign sub_value = p.collections.first.title -%}
          {%- when 'custom' -%}{%- assign sub_value = s.custom_subtitle -%}
        {%- endcase -%}
        {%- if sub_value != blank -%}
          <span class="upsell-card__sub">{{ sub_value }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if s.show_price -%}
        <div class="upsell-card__price">
          {{ v.price | money }}
          {%- if s.show_compare_at and v.compare_at_price > v.price -%}
            <span class="compare-at">{{ v.compare_at_price | money }}</span>
            {%- if s.show_sale_badge -%}<span class="upsell-card__sale-badge">SALE</span>{%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if p.variants.size > 1 and s.show_variant_selector -%}
        <div class="upsell-card__variant">
          <select class="upsell-card__variant-select" aria-label="{{ 'accessibility.select_variant' | t }}">
            {%- for variant in p.variants -%}
              <option value="{{ variant.id }}"{% if variant.available == false %} disabled{% endif %}>
                {{ variant.title }} — {{ variant.price | money }}{% if variant.available == false %} ({{ s.soldout_text | default: fb_accessibility_sold_out }}){% endif %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>
    <div class="upsell-card__action">
      <button type="button" class="upsell-card__btn" data-action="add"{% if p.available == false %} disabled{% endif %}>
        {%- if p.available == false -%}{{ s.soldout_text | default: fb_accessibility_sold_out }}{%- else -%}{{ s.upsell_button_text | default: fb_accessibility_add }}{%- endif -%}
      </button>
    </div>
  </div>
{%- endunless -%}

</template>