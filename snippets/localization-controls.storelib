<template compat="shopify">
<style>
  /* Keep the native accessible button, without browser-default button chrome.
     Local to the forms so editor renders do not depend on a cached theme asset. */
  localization-form button.button-localization {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px !important;
    min-height: 44px;
    margin: 0 !important;
    padding: 8px 6px !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: inherit !important;
    font-family: inherit !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1.3 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    cursor: pointer;
    transition: none;
  }
  localization-form button.button-localization:hover,
  localization-form button.button-localization.open { background: transparent !important; box-shadow: none !important; }
  localization-form .button-localization:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  localization-form .button-localization > span { gap: 8px !important; }
  localization-form .button-localization .localization-flags { width: 20px; height: 20px; }
  localization-form .button-localization > svg {
    flex: none; width: 10px; height: 6px;
    transform: rotate(0deg);
    transform-origin: center;
    transition: transform 320ms cubic-bezier(.22,.61,.36,1);
  }
  localization-form .button-localization.open > svg { transform: rotate(180deg); }
  .lang__currency-desktop:has(localization-form + localization-form) { gap: 2px !important; }
  .lang__currency-desktop localization-form + localization-form { border: 0 !important; padding-inline-start: 0 !important; }
  localization-form .button-localization > svg { transition: transform .24s cubic-bezier(.2,.7,.2,1) !important; transform-origin: center; }
  localization-form .button-localization[aria-expanded="true"] > svg,
  localization-form .button-localization.open > svg { transform: rotate(180deg) !important; }
  localization-form .disclosure__list a, localization-form .disclosure__list a:hover { text-decoration: none !important; background-image: none !important; }
  @media (prefers-reduced-motion: reduce) {
    localization-form .button-localization { transition: none; }
    localization-form .button-localization > svg { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
</template>
