<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared first-paint rules for Gallery Simple 1, Gallery Grid 1,
  Gallery Interactive 2 and Gallery Simple 3. Every value a setting controls is
  a CSS variable or data attribute on the section root (.mga), so the builder
  can change it live (shopify/assets/media-live-galleries-a.js) and the first
  paint already shows the final look.
  {% render 'media-galleries-a-base', section: section %}
{%- endcomment -%}
{%- assign sid = '#shopify-section-' | append: section.id -%}
<style>
  {{ sid }} { isolation: isolate; position: relative; }
  {{ sid }} .mga, {{ sid }} .mga *, {{ sid }} .mga *::before, {{ sid }} .mga *::after { box-sizing: border-box; }
  {{ sid }}:has(.mga[data-mga-reset="true"]) { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
  {{ sid }}:has(.mga[data-mga-reset="true"]) + .shopify-section { margin-top: 0 !important; }
  {{ sid }} .mga {
    display: block;
    position: relative;
    background: var(--mga-section-bg, var(--mga-bg, var(--color-background)));
    color: var(--color-text);
    padding: var(--mga-pt-m, 0px) var(--mga-pr-m, 0px) var(--mga-pb-m, 0px) var(--mga-pl-m, 0px);
    margin: var(--mga-mt-m, 0px) 0 var(--mga-mb-m, 0px);
  }
  {{ sid }} .mga [hidden] { display: none !important; }
  {{ sid }} .mga[data-mga-show="none"] { display: none; }
  @media (max-width: 749px) { {{ sid }} .mga[data-mga-show="desktop"] { display: none; } }
  @media (min-width: 750px) {
    {{ sid }} .mga[data-mga-show="mobile"] { display: none; }
    {{ sid }} .mga {
      padding: var(--mga-pt-d, 0px) var(--mga-pr-d, 0px) var(--mga-pb-d, 0px) var(--mga-pl-d, 0px);
      margin: var(--mga-mt-d, 0px) 0 var(--mga-mb-d, 0px);
    }
  }
  {{ sid }} .mga__frame { width: 100%; margin-inline: auto; }
  {{ sid }} .mga[data-mga-width="container"] .mga__frame { max-width: calc(var(--page-width, 1300px) + 3rem); padding-inline: 1.5rem; }
  {{ sid }} .mga[data-mga-width="fluid_container"] .mga__frame { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); padding-inline: 1.5rem; }
  {{ sid }} .mga[data-mga-width="stretch_width"] .mga__frame { padding-inline: 1.5rem; }
  @media (min-width: 1200px) { {{ sid }} .mga[data-mga-width="stretch_width"] .mga__frame { padding-inline: 3rem; } }
  {{ sid }} .mga-media {
    position: relative;
    display: block;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-heading) 8%, var(--color-background));
  }
  {{ sid }} .mga-fill { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; margin: 0; object-fit: cover; object-position: center; display: block; }
  {{ sid }} .mga-ph { position: absolute; inset: 0; width: 100%; height: 100%; display: block; color: var(--color-heading); opacity: 0.3; pointer-events: none; }
  {{ sid }} [data-media]:not([data-media="none"]) > .mga-ph { display: none; }
  {{ sid }} .mga :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    {{ sid }} .mga, {{ sid }} .mga * { transition: none !important; }
  }
{% comment %}{% endcomment %}</style>
</template>
