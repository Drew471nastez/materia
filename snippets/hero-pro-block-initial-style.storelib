<template compat="shopify">
{% assign b = block.settings %}
{% case block.type %}
{% when 'top_text' %}--mk-block-mb-d:{{ b.top_text_gap_from_title | default: 10 }}px;--mk-block-mb-m:{{ b.top_text_gap_from_title | default: 10 }}px;
{% when 'badge' %}--mk-block-mb-d:{{ b.badge_vertical_gap | default: 10 }}px;--mk-block-mb-m:{{ b.badge_vertical_gap | default: 10 }}px;
{% when 'referral_kicker' %}--mk-block-mb-d:{{ b.referral_to_title_gap_desktop | default: 20 }}px;--mk-block-mb-m:{{ b.referral_to_title_gap_mobile | default: 10 }}px;
{% when 'heading' %}--mk-block-max-d:{{ b.title_width_desktop | default: 74 }}%;--mk-block-pl-d:{{ b.title_left_padding_desktop | default: 0 }}px;--mk-block-pr-d:{{ b.title_right_padding_desktop | default: 0 }}px;--mk-block-pl-m:{{ b.title_left_padding_mobile | default: 0 }}px;--mk-block-pr-m:{{ b.title_right_padding_mobile | default: 0 }}px;
{% when 'subheading' %}--mk-block-mt-d:{{ b.subheading_vertical_gap | default: 0 }}px;--mk-block-mt-m:{{ b.subheading_vertical_gap | default: 0 }}px;--mk-block-mb-d:{{ b.subheading_to_button_gap | default: 0 }}px;--mk-block-mb-m:{{ b.subheading_to_button_gap | default: 0 }}px;--mk-block-pl-d:{{ b.subheading_left_padding_desktop | default: 0 }}px;--mk-block-pr-d:{{ b.subheading_right_padding_desktop | default: 0 }}px;--mk-block-pl-m:{{ b.subheading_left_padding_mobile | default: 0 }}px;--mk-block-pr-m:{{ b.subheading_right_padding_mobile | default: 0 }}px;
{% when 'primary_button' %}--mk-block-mt-d:{{ b.button_vertical_gap | default: 20 }}px;--mk-block-mt-m:{{ b.button_vertical_gap | default: 20 }}px;
{% when 'text_under_button' %}--mk-block-mt-d:{{ b.text_under_button_gap | default: 10 }}px;--mk-block-mt-m:{{ b.text_under_button_gap | default: 10 }}px;
{% when 'image_over_text' %}--mk-art-layer:{% if b.artwork_layer == 'back' %}0{% else %}3{% endif %};--mk-art-opacity:{% if b.enable_custom_style %}{{ b.artwork_opacity | default: 100 | divided_by: 100.0 }}{% else %}1{% endif %};--mk-art-w-d:{{ b.image_over_text_width_desktop | default: 200 }}px;--mk-art-h-d:{{ b.image_over_text_height_desktop | default: 200 }}px;--mk-art-w-m:{{ b.image_over_text_width_mobile | default: 100 }}px;--mk-art-h-m:{{ b.image_over_text_height_mobile | default: 100 }}px;--mk-art-top-d:{{ b.image_over_text_vertical_position_desktop | default: 0 }}px;--mk-art-top-m:{{ b.image_over_text_vertical_position_mobile | default: 0 }}px;--mk-art-left-d:{% if b.enable_image_over_text_horizontal_position %}{{ b.image_over_text_horizontal_position_desktop | default: 50 }}%{% else %}50%{% endif %};--mk-art-left-m:{% if b.enable_image_over_text_horizontal_position %}{{ b.image_over_text_horizontal_position_mobile | default: 50 }}%{% else %}50%{% endif %};--mk-art-transform:{% if b.enable_image_over_text_horizontal_position %}none{% else %}translateX(-50%){% endif %};--mk-float-time:{{ b.image_over_text_constant_duration | default: 3000 }}ms;--mk-hover-time:{{ b.image_over_text_hover_duration | default: 500 }}ms;--mk-art-fit:{{ b.artwork_fit | default: 'contain' }};
{% endcase %}
</template>
