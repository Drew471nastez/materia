<template compat="shopify">
{% assign b = block.settings %}
{% case block.type %}
{% when 'heading' %}{% if kind == 'pro' %}<h1 class="mk-type mk-heading" data-mk-text="title_text" data-mk-rich style="font-family:var(--mk-font,var(--heading-font))!important;font-size:var(--mk-size,var(--h1-size,48px))!important;font-weight:var(--mk-weight,var(--heading-weight,600))!important;line-height:var(--mk-line,var(--heading-line-height,1.2))!important;letter-spacing:var(--mk-letter,var(--heading-letter-spacing,normal))!important;text-transform:var(--mk-case,var(--heading-text-transform,none))!important;">{{ b.title_text }}</h1>{% else %}<{% if kind == 'strip' %}p{% else %}h2{% endif %} class="mk-type mk-heading" data-mk-text="text" data-mk-rich style="font-family:var(--mk-font,var(--heading-font))!important;font-size:var(--mk-size,{% if kind == "strip" %}var(--body-font-size,16px){% else %}var(--h2-size,32px){% endif %})!important;font-weight:var(--mk-weight,var(--heading-weight,600))!important;line-height:var(--mk-line,var(--heading-line-height,1.2))!important;letter-spacing:var(--mk-letter,var(--heading-letter-spacing,normal))!important;text-transform:var(--mk-case,var(--heading-text-transform,none))!important;">{{ b.text }}</{% if kind == 'strip' %}p{% else %}h2{% endif %}>{% endif %}
{% when 'top_text' %}<div class="mk-type" data-mk-text="top_text">{{ b.top_text | escape }}</div>
{% when 'eyebrow', 'tag' %}<div class="mk-type{% if block.type == 'tag' %} mk-tag{% endif %}" data-mk-text="text">{{ b.text | escape }}</div>
{% when 'subtext', 'description' %}<div class="mk-type" data-mk-text="text" data-mk-rich>{{ b.text }}</div>
{% when 'subheading' %}{% if kind == 'pro' %}<div class="mk-type" data-mk-text="subheading_text" data-mk-rich>{{ b.subheading_text }}</div>{% else %}<div class="mk-type" data-mk-text="text" data-mk-rich>{{ b.text }}</div>{% endif %}
{% when 'badge' %}<div class="mk-badge"><span class="mk-icon" data-mk-badge-icon aria-hidden="true"{% if kind != "pro" or b.enable_badge_svg_icon != true %} hidden{% endif %}></span><span class="mk-type" data-mk-text="{% if kind == 'pro' %}badge_text{% else %}text{% endif %}">{% if kind == 'pro' %}{{ b.badge_text | escape }}{% else %}{{ b.text | escape }}{% endif %}</span></div>
{% when 'buttons' %}<div class="mk-buttons">{% assign roles = 'primary,secondary' | split: ',' %}{% for role in roles %}{% assign label = role | append: '_label' %}{% assign href = role | append: '_link' %}{% if b[href] != blank and b[href] != '#' %}<a class="mk-button" data-mk-role="{{ role }}" data-theme-button="{{ role }}" data-sl-button{% if b[label] == blank %} hidden{% endif %} href="{{ b[href] | url | escape }}">{% else %}<button type="button" class="mk-button" data-mk-role="{{ role }}" data-theme-button="{{ role }}" data-sl-button{% if b[label] == blank %} hidden{% endif %}>{% endif %}<span data-mk-label>{{ b[label] | escape }}</span>{% if b[href] != blank and b[href] != '#' %}</a>{% else %}</button>{% endif %}{% endfor %}</div>
{% when 'button', 'primary_button', 'secondary_button' %}{% assign role = 'primary' %}{% assign label = b.label %}{% assign href = b.url %}{% if block.type == 'primary_button' %}{% assign label = b.button_text %}{% assign href = b.button_link %}{% elsif block.type == 'secondary_button' %}{% assign role = 'secondary' %}{% assign label = b.secondary_button_text %}{% assign href = b.secondary_button_link %}{% endif %}{% if href != blank and href != '#' %}<a class="mk-button" data-mk-role="{{ role }}" data-theme-button="{{ role }}" data-sl-button href="{{ href | url | escape }}">{% else %}<button type="button" class="mk-button" data-mk-role="{{ role }}" data-theme-button="{{ role }}" data-sl-button>{% endif %}<span class="mk-icon mk-button-icon" aria-hidden="true" hidden></span><span data-mk-label>{{ label | escape }}</span><svg class="mk-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden><path d="M5 12h14M13 5l7 7-7 7"/></svg>{% if href != blank and href != '#' %}</a>{% else %}</button>{% endif %}
{% when 'text_under_button' %}<div class="mk-type" data-mk-text="text_under_button">{{ b.text_under_button | escape }}</div>
{% when 'image_over_text' %}<div class="mk-float" data-motion="{{ b.image_over_text_constant_animation | default: 'none' }}" data-hover="{{ b.image_over_text_hover_animation | default: 'none' }}" {{ block.shopify_attributes }}><div class="mk-float-hover"><img{% if b.image_over_text != blank %} src="{% render 'offer-image-url', image: b.image_over_text, escaped: true %}"{% else %} hidden{% endif %} alt="{{ b.artwork_alt | escape }}" width="400" height="400" decoding="async"></div></div>
{% when 'icon' %}<span class="mk-icon" data-mk-strip-icon aria-hidden="true"></span>
{% when 'referral_kicker' %}{% assign has_avatar = false %}{% for n in (1..5) %}{% assign avatar_key = 'ref_avatar_' | append: n %}{% if b[avatar_key] != blank %}{% assign has_avatar = true %}{% endif %}{% endfor %}<div class="mk-referral"><div class="mk-avatars"{% if b.referral_display_type != 'avatars' or has_avatar != true %} hidden{% endif %}>{% for n in (1..5) %}{% assign avatar_key = 'ref_avatar_' | append: n %}<span data-mk-avatar="{{ n }}"{% if b[avatar_key] == blank %} hidden{% endif %}>{% if b[avatar_key] != blank %}<img src="{% render 'offer-image-url', image: b[avatar_key], escaped: true %}" alt="" width="80" height="80" loading="lazy">{% endif %}</span>{% endfor %}</div><div class="mk-ref-stars"{% if b.referral_display_type != 'stars' %} hidden{% endif %}>{% render 'hero-image-one-stars', filled: b.ref_star_rating, total: 5 %}</div><div class="mk-type" data-mk-text="referral_text">{{ b.referral_text | escape }}</div></div>
{% endcase %}
</template>
