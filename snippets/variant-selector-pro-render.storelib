<template compat="shopify">
{%- comment -%}
  Materia Themes. Variant Selector Pro: one row per option (Size, Colour...)
  with the option name and the chosen value. Sizes are buttons, colours are
  swatches drawn from each colour's variant picture, or its swatch colour,
  or its name. The row markup is the theme's variant picker
  (variant-radios-detail), so price, stock, the add button, the variant id,
  the address and the gallery all follow a choice the same way.
  Inputs: block, section, product
{%- endcomment -%}
{%- unless product == blank or product.has_only_default_variant -%}
{%- liquid
  assign vsp = block.settings
  assign vsp_selected = product.selected_or_first_available_variant
  assign vsp_style = vsp.swatch_style | default: 'image'
  assign vsp_size = vsp.swatch_size | default: 44
  if settings.color_swatch_trigger != blank
    assign vsp_color_names = settings.color_swatch_trigger | downcase | split: ','
  else
    assign vsp_color_names = 'color,colour' | split: ','
  endif
-%}
<variant-radios-detail
  id="VariantSelectorPro-{{ block.id }}"
  class="vsp block"
  data-vsp
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  {{ block.shopify_attributes }}
  style="--vsp-size: {{ vsp_size }}px; --vsp-mt: {{ vsp.mt | default: 0 }}px; --vsp-mb: {{ vsp.mb | default: 16 }}px;
    {%- if vsp.vsp_custom_colors -%}
      {%- if vsp.text_color != blank %} --vsp-text: {{ vsp.text_color }};{% endif -%}
      {%- if vsp.selected_text_color != blank %} --vsp-selected-text: {{ vsp.selected_text_color }};{% endif -%}
      {%- if vsp.border_color != blank %} --vsp-border: {{ vsp.border_color }};{% endif -%}
      {%- if vsp.accent != blank %} --vsp-accent: {{ vsp.accent }};{% endif -%}
      {%- if vsp.chip_bg != blank %} --vsp-bg: {{ vsp.chip_bg }};{% endif -%}
      {%- if vsp.selected_bg != blank %} --vsp-selected-bg: {{ vsp.selected_bg }};{% endif -%}
    {%- endif -%}"
>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign opt_pos = option.position | default: forloop.index | plus: 0
      assign opt_key = 'option' | append: opt_pos
      assign opt_name_down = option.name | downcase | strip
      assign is_color = false
      for cn in vsp_color_names
        assign cn_clean = cn | strip
        if cn_clean != blank and opt_name_down contains cn_clean
          assign is_color = true
        endif
      endfor
      assign opt_selected = option.selected_value | default: vsp_selected[opt_key]
    -%}
    <fieldset class="product-form__input vsp__option{% if is_color %} vsp__option--color{% else %} vsp__option--button{% endif %}">
      <legend class="vsp__legend">
        <span class="vsp__name">{{ option.name }}</span>
        {%- if vsp.show_current_variant -%}
          <span class="vsp__sep" aria-hidden="true">:</span>
          <span class="vsp__value option_value">{{ opt_selected }}</span>
        {%- endif -%}
      </legend>
      <div class="vsp__values">
        {%- for value in option.values -%}
          {%- liquid
            assign vsp_id = 'vsp-' | append: block.id | append: '-' | append: opt_pos | append: '-' | append: forloop.index0
            assign value_available = false
            assign value_image = blank
            for v in product.variants
              if v[opt_key] == value
                if v.available
                  assign value_available = true
                endif
                if value_image == blank and v.featured_image
                  assign value_image = v.featured_image
                endif
              endif
            endfor
            assign value_checked = false
            if opt_selected == value
              assign value_checked = true
            endif
            assign swatch_color = ''
            if value.swatch.color
              assign swatch_color = value.swatch.color
            endif
            assign color_name = value | downcase | remove: ' ' | remove: '"' | remove: "'"
          -%}
          {%- if vsp.hide_unavailable and value_available == false and value_checked == false -%}{%- continue -%}{%- endif -%}
          <input
            type="radio"
            class="vsp__radio visually-hidden{% unless value_available %} option-disabled{% endunless %}"
            id="{{ vsp_id }}"
            name="vsp-{{ block.id }}-{{ opt_pos }}"
            value="{{ value | escape }}"
            {% if value_checked %}checked{% endif %}
          >
          {%- if is_color -%}
            {%- if vsp_style == 'image' and value_image != blank -%}
              <label for="{{ vsp_id }}" class="vsp__chip vsp__chip--image" title="{{ value | escape }}" data-image="{{ value_image | image_url: width: 160 }}">
                <img
                  src="{{ value_image | image_url: width: 160 }}"
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                >
                <span class="visually-hidden">{{ value }}</span>
              </label>
            {%- elsif swatch_color != blank -%}
              <label for="{{ vsp_id }}" class="vsp__chip vsp__chip--dot" title="{{ value | escape }}" style="--vsp-dot: {{ swatch_color }};">
                <span class="visually-hidden">{{ value }}</span>
              </label>
            {%- else -%}
              <label for="{{ vsp_id }}" class="vsp__chip vsp__chip--dot" title="{{ value | escape }}" data-vsp-color="{{ color_name | escape }}" style="--vsp-dot: {{ color_name | escape }};">
                <span class="vsp__chip-text">{{ value }}</span>
              </label>
            {%- endif -%}
          {%- else -%}
            <label for="{{ vsp_id }}" class="vsp__chip vsp__chip--button">
              <span>{{ value }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
  <script type="application/json">
    {{ product.variants | json }}
{% comment %}{% endcomment %}  </script>
  {%- render 'variant-price-map', product: product -%}
</variant-radios-detail>

<style>
  #VariantSelectorPro-{{ block.id }} {
    --vsp-text: var(--color-text);
    --vsp-heading: var(--color-heading);
    --vsp-border: var(--color-border);
    --vsp-accent: var(--color-heading);
    --vsp-selected-bg: var(--color-background);
    --vsp-bg: var(--color-background);
    --vsp-selected-text: var(--vsp-heading);
    margin: var(--vsp-mt) 0 var(--vsp-mb);
    color: var(--vsp-text);
    font-family: var(--body-font);
    font-weight: var(--body-weight);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__option {
    border: 0;
    margin: 0 0 16px;
    padding: 0;
    min-width: 0;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__option:last-of-type { margin-bottom: 0; }
  #VariantSelectorPro-{{ block.id }} .vsp__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px;
    padding: 0;
    margin: 0 0 10px;
    line-height: 1.4;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__name {
    color: var(--vsp-heading);
    font-weight: var(--heading-weight);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__sep { margin-left: -2px; color: var(--vsp-heading); }
  #VariantSelectorPro-{{ block.id }} .vsp__value { color: var(--vsp-text); }
  #VariantSelectorPro-{{ block.id }} .vsp__values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    cursor: pointer;
    color: var(--vsp-text);
    -webkit-tap-highlight-color: transparent;
    transition: border-color .2s ease, background-color .2s ease, color .2s ease, box-shadow .2s ease;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--button {
    padding: 0 16px;
    border: 1px solid var(--vsp-border);
    border-radius: var(--btn-radius, 0);
    background: var(--vsp-bg);
    font-family: var(--btn-font, var(--body-font));
    font-weight: var(--btn-font-weight, var(--body-weight));
    letter-spacing: var(--btn-letter-spacing, normal);
    line-height: 1.2;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--button:hover { border-color: var(--vsp-accent); }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__chip--button {
    border-color: var(--vsp-accent);
    background: var(--vsp-selected-bg);
    box-shadow: inset 0 0 0 1px var(--vsp-accent);
    color: var(--vsp-selected-text);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image,
  #VariantSelectorPro-{{ block.id }} .vsp__chip--dot {
    width: var(--vsp-size);
    height: var(--vsp-size);
    min-width: var(--vsp-size);
    min-height: var(--vsp-size);
    padding: 0;
    border: 1px solid var(--vsp-border);
    background: var(--vsp-bg);
    overflow: visible;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image {
    border-radius: var(--input-border-radius, 4px);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--dot {
    border-radius: 50%;
    background: var(--vsp-dot, var(--color-background));
    background-clip: padding-box;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* A colour with no picture and no swatch colour reads as its name. */
  #VariantSelectorPro-{{ block.id }} .vsp__chip--text {
    width: auto;
    padding: 0 16px;
    border-radius: var(--btn-radius, 0);
    background: var(--vsp-bg);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--text .vsp__chip-text {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image:hover,
  #VariantSelectorPro-{{ block.id }} .vsp__chip--dot:hover { border-color: var(--vsp-accent); }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__chip--image,
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__chip--dot {
    border-color: var(--vsp-accent);
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--vsp-accent);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__chip--text {
    background: var(--vsp-selected-bg);
    color: var(--vsp-selected-text);
    box-shadow: inset 0 0 0 1px var(--vsp-accent);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:focus-visible + .vsp__chip {
    outline: 2px solid var(--vsp-accent);
    outline-offset: 3px;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio.option-disabled + .vsp__chip { opacity: .5; }
  #VariantSelectorPro-{{ block.id }} .vsp__radio.option-disabled + .vsp__chip::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(to top left, transparent calc(50% - .5px), var(--vsp-text) calc(50% - .5px), var(--vsp-text) calc(50% + .5px), transparent calc(50% + .5px));
  }
  @media (prefers-reduced-motion: reduce) {
    #VariantSelectorPro-{{ block.id }} .vsp__chip { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- endunless -%}
</template>
