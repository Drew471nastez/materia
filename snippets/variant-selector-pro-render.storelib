<template compat="shopify">
{%- comment -%}
  Materia Themes. Variant Selector Pro: one row per option (Size, Colour...)
  with the option name and the chosen value. Sizes are buttons, colours are
  swatches drawn from each colour's variant picture, or its swatch colour,
  or its name. The row markup is the theme's variant picker
  (variant-radios-detail), so price, stock, the add button, the variant id,
  the address and the gallery all follow a choice the same way.
  Inputs: block, section, product
{%- endcomment -%}
{%- assign product = product | default: page.product -%}
{%- unless product == blank or product.has_only_default_variant -%}
{%- liquid
  assign vsp = block.settings
  assign vsp_selected = product.selected_or_first_available_variant
  assign product = product | default: page.product
  assign vsp_style = vsp.swatch_style | default: 'theme'
  if vsp_style == 'theme'
    if settings.swatch_item_type == 'variant_images'
      assign vsp_style = 'image'
    else
      assign vsp_style = 'color'
    endif
  endif
  assign vsp_size = vsp.swatch_size | default: 44
  comment
    Picture swatches use Overall option size (desktop, mobile); 0 falls
    back to Swatch size. Colour dots and buttons use Swatch size.
  endcomment
  assign vsp_img_d = vsp.option_size_d | default: 0
  if vsp_img_d == 0
    assign vsp_img_d = vsp_size
  endif
  assign vsp_img_m = vsp.option_size_m | default: 0
  if vsp_img_m == 0
    assign vsp_img_m = vsp_img_d
  endif
  if vsp.thumb_max_size > 0
    if vsp_img_d > vsp.thumb_max_size
      assign vsp_img_d = vsp.thumb_max_size
    endif
    if vsp_img_m > vsp.thumb_max_size
      assign vsp_img_m = vsp.thumb_max_size
    endif
  endif
  assign vsp_ratio = '1 / 1'
  if vsp.image_aspect == 'portrait'
    assign vsp_ratio = '3 / 4'
  elsif vsp.image_aspect == 'landscape'
    assign vsp_ratio = '4 / 3'
  endif
  assign vsp_sep = vsp.current_variant_separator | default: ':'
  assign vsp_justify = 'flex-start'
  if vsp.option_alignment == 'center'
    assign vsp_justify = 'center'
  elsif vsp.option_alignment == 'right'
    assign vsp_justify = 'flex-end'
  endif
  comment
    The chosen option's colours are the custom ones only while Custom
    colours is on; otherwise they follow the theme (heading colour).
  endcomment
  assign vsp_accent = ''
  if vsp.enable_vsp_custom
    assign vsp_accent = vsp.selected_border
    if vsp.accent != blank
      assign vsp_accent = vsp.accent
    endif
  endif
  if settings.color_swatch_trigger != blank
    assign vsp_color_names = settings.color_swatch_trigger | downcase | split: ','
  else
    assign vsp_color_names = 'color,colour' | split: ','
  endif
-%}
<variant-radios-detail
  id="VariantSelectorPro-{{ block.id }}"
  class="vsp block{% if vsp.enable_vsp_custom and vsp.hover_effect != blank and vsp.hover_effect != 'none' %} vsp--hover-{{ vsp.hover_effect }}{% endif %}{% if vsp.enable_vsp_custom and vsp.selected_anim != blank and vsp.selected_anim != 'none' %} vsp--anim-{{ vsp.selected_anim }}{% endif %}"
  data-vsp{% if vsp.enable_vsp_custom %} data-vsp-custom{% endif %}
  data-vsp-mode="{{ vsp.swatch_style | default: 'theme' }}" data-vsp-fill="{{ vsp_style }}"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  {%- if vsp.aria_label != blank %} role="group" aria-label="{{ vsp.aria_label | escape }}"{% endif %}
  {{ block.shopify_attributes }}
  style="--vsp-size: {{ vsp_size }}px; --vsp-img-d: {{ vsp_img_d }}px; --vsp-img-m: {{ vsp_img_m }}px; --vsp-ratio: {{ vsp_ratio }}; --vsp-mt: {{ vsp.mt | default: 0 }}px; --vsp-mb: {{ vsp.mb | default: 16 }}px; --vsp-gap: {{ vsp.card_gap | default: 8 }}px; --vsp-gap-m: {{ vsp.card_gap_mobile | default: vsp.card_gap | default: 8 }}px; --vsp-justify: {{ vsp_justify }}; --vsp-radius: {% if vsp.card_radius != blank %}{{ vsp.card_radius }}px{% else %}var(--btn-radius, 0px){% endif %}; --vsp-img-radius: {{ vsp.image_radius | default: 6 }}px; --vsp-img-fit: {{ vsp.image_fit | default: 'cover' }}; --vsp-img-pad: {{ vsp.thumb_inner_padding | default: 0 }}px; --vsp-bw: {{ vsp.selected_border_width | default: 2 }}px; --vsp-ring: {{ vsp.selected_ring_size | default: 0 }}px; --vsp-header-gap: {{ vsp.header_gap | default: 10 }}px;
    {%- if vsp_accent != blank %} --vsp-accent: {{ vsp_accent }};{% endif -%}
    {%- if vsp.image_bg != blank %} --vsp-img-bg: {{ vsp.image_bg }};{% endif -%}
    {%- if vsp.card_bg != blank %} --vsp-bg: {{ vsp.card_bg }};{% endif -%}
    {%- if vsp.muted_color != blank %} --vsp-muted: {{ vsp.muted_color }};{% endif -%}
    {%- if vsp.enable_vsp_custom -%}
      {%- if vsp.text_color != blank %} --vsp-text: {{ vsp.text_color }};{% endif -%}
      {%- if vsp.selected_text_color != blank %} --vsp-selected-text: {{ vsp.selected_text_color }};{% endif -%}
      {%- if vsp.border_color != blank %} --vsp-border: {{ vsp.border_color }};{% endif -%}
      {%- if vsp.chip_bg != blank %} --vsp-bg: {{ vsp.chip_bg }};{% endif -%}
      {%- if vsp.selected_bg != blank %} --vsp-selected-bg: {{ vsp.selected_bg }};{% if vsp.selected_text_color == blank %}{% assign vsp_selected_brightness = vsp.selected_bg | color_brightness %} --vsp-selected-text: {% if vsp_selected_brightness > 127 %}#111111{% else %}#ffffff{% endif %};{% endif %}{% endif -%}
    {%- endif -%}"
>
  {%- if vsp.show_static_title and vsp.title != blank or vsp.subtitle != blank -%}
    <div class="vsp__head" style="text-align: {{ vsp.title_align | default: 'left' }};">
      {%- if vsp.show_static_title and vsp.title != blank -%}
        <p class="vsp__title" style="font-size: {{ vsp.title_size | default: 13 }}px; font-weight: {{ vsp.title_weight | default: 600 }};{% if vsp.title_color != blank %} color: {{ vsp.title_color }};{% endif %}{% if vsp.title_uppercase %} text-transform: uppercase;{% endif %} letter-spacing: {{ vsp.title_letter_spacing | default: 0 }}em;">{{ vsp.title | escape }}</p>
      {%- endif -%}
      {%- if vsp.subtitle != blank -%}
        <p class="vsp__subtitle" style="font-size: {{ vsp.subtitle_size | default: 12 }}px;{% if vsp.subtitle_color != blank %} color: {{ vsp.subtitle_color }};{% endif %}">{{ vsp.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign opt_pos = option.position | default: forloop.index | plus: 0
      assign opt_index = opt_pos | minus: 1
      assign opt_key = 'option' | append: opt_pos
      assign opt_name_down = option.name | downcase | strip
      assign is_color = false
      for cn in vsp_color_names
        assign cn_clean = cn | strip
        if cn_clean != blank and opt_name_down contains cn_clean
          assign is_color = true
        endif
      endfor
      assign opt_selected = option.selected_value | default: vsp_selected[opt_key] | default: vsp_selected.options[opt_index].value | default: vsp_selected.options[opt_index].name | default: vsp_selected.options[opt_index]
    -%}
    <fieldset class="product-form__input vsp__option{% if is_color %} vsp__option--color{% else %} vsp__option--button{% endif %}">
      <legend class="vsp__legend">
        <span class="vsp__name">{{ option.name }}</span>
        {%- if vsp.show_current_variant -%}
          <span class="vsp__sep" aria-hidden="true">{{ vsp_sep | escape }}</span>
          <span class="vsp__value option_value" style="{% if vsp.current_variant_color != blank %}color: {{ vsp.current_variant_color }}; {% endif %}font-weight: {{ vsp.current_variant_weight | default: 700 }};{% if vsp.current_variant_uppercase %} text-transform: uppercase;{% endif %}">{{ opt_selected }}</span>
        {%- endif -%}
      </legend>
      <div class="vsp__values">
        {%- for value in option.values -%}
          {%- liquid
            assign vsp_id = 'vsp-' | append: block.id | append: '-' | append: opt_pos | append: '-' | append: forloop.index0
            assign value_available = false
            assign value_image = ''
            for v in product.variants
              assign variant_value = v[opt_key] | default: v.options[opt_index].value | default: v.options[opt_index].name | default: v.options[opt_index]
              if variant_value == value
                if v.available
                  assign value_available = true
                endif
                if value_image == blank and v.featured_image
                  assign value_image = v.featured_image
                endif
              endif
            endfor
            assign value_checked = false
            if opt_selected == value
              assign value_checked = true
            endif
            assign swatch_color = ''
            if value.swatch.color
              assign swatch_color = value.swatch.color
            endif
            assign value_label = value
            assign ov_img_key = ''
            comment
              Variant 1 to 10 overrides: the Nth value of a colour option
              takes its own picture, colour and label.
            endcomment
            if vsp.enable_vsp_custom and is_color and forloop.index <= 10
              assign ov_img_key = 'variant_' | append: forloop.index | append: '_image'
              assign ov_col_key = 'variant_' | append: forloop.index | append: '_color'
              assign ov_lab_key = 'variant_' | append: forloop.index | append: '_label'
              if vsp[ov_img_key] != blank
                assign value_image = vsp[ov_img_key]
              endif
              if vsp[ov_col_key] != blank
                assign swatch_color = vsp[ov_col_key]
              endif
              if vsp[ov_lab_key] != blank
                assign value_label = vsp[ov_lab_key]
              endif
            endif
            assign color_name = value | downcase | remove: ' ' | remove: '"' | remove: "'"
            assign value_image_url = ''
            comment
              A picked picture is an image (sized with image_url); an address
              pasted under the picker is used as it is.
            endcomment
            if value_image != blank
              if value_image.src != blank or value_image.id != blank
                assign value_image_url = value_image | image_url: width: 240
              else
                assign value_image_url = value_image
              endif
            endif
            assign use_image = false
            if is_color and value_image_url != blank
              if vsp_style == 'image' or ov_img_key != blank and vsp[ov_img_key] != blank
                assign use_image = true
              endif
            endif
          -%}
          {%- if vsp.hide_unavailable and value_available == false and value_checked == false -%}{%- continue -%}{%- endif -%}
          <input
            type="radio"
            class="vsp__radio visually-hidden{% unless value_available %} option-disabled{% endunless %}"
            id="{{ vsp_id }}"
            name="vsp-{{ block.id }}-{{ opt_pos }}"
            value="{{ value | escape }}"
            {% if value_checked %}checked{% endif %}
          >
          <label for="{{ vsp_id }}" class="vsp__cell" data-vsp-image="{{ value_image_url | escape }}" data-vsp-color-value="{{ swatch_color | default: color_name | escape }}" title="{{ value_label | escape }}"{% if use_image %} data-image="{{ value_image_url }}"{% endif %}>
            {%- if is_color -%}
              {%- if use_image -%}
                {%- comment -%} With colour dots, a picture fills a dot of the same size. {%- endcomment -%}
                <span class="vsp__chip vsp__chip--image{% if vsp_style == 'color' %} vsp__chip--photo{% endif %}">
                  <img src="{{ value_image_url }}" alt="" width="120" height="120" loading="lazy" decoding="async">
                </span>
              {%- elsif swatch_color != blank -%}
                <span class="vsp__chip vsp__chip--dot" style="--vsp-dot: {{ swatch_color }};"></span>
              {%- else -%}
                <span class="vsp__chip vsp__chip--dot" data-vsp-color="{{ color_name | escape }}" style="--vsp-dot: {{ color_name | escape }};">
                  <span class="vsp__chip-text" style="font-size: {{ vsp.placeholder_size | default: 11 }}px; font-weight: {{ vsp.placeholder_weight | default: 600 }};{% if vsp.placeholder_uppercase %} text-transform: uppercase;{% endif %}">{{ value_label }}</span>
                </span>
              {%- endif -%}
              {%- if vsp.show_label -%}
                <span class="vsp__label" style="font-size: {{ vsp.label_size | default: 11 }}px; font-weight: {{ vsp.label_weight | default: 500 }};{% if vsp.label_uppercase %} text-transform: uppercase;{% endif %} margin-top: {{ vsp.label_gap | default: 6 }}px;">{{ value_label }}</span>
              {%- else -%}
                <span class="visually-hidden">{{ value_label }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="vsp__chip vsp__chip--button"><span>{{ value_label }}</span></span>
            {%- endif -%}
            {%- if value_available == false and vsp.sold_out_label != blank -%}
              <span class="vsp__soldout" style="{% if vsp.sold_out_badge_bg != blank %}background: {{ vsp.sold_out_badge_bg }};{% endif %}{% if vsp.sold_out_badge_text != blank %} color: {{ vsp.sold_out_badge_text }};{% endif %}">{{ vsp.sold_out_label | escape }}</span>
            {%- endif -%}
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
  {%- if vsp.footer_note != blank -%}
    <p class="vsp__footer"{% if vsp.footer_color != blank %} style="color: {{ vsp.footer_color }};"{% endif %}>{{ vsp.footer_note | escape }}</p>
  {%- endif -%}
  <script type="application/json" data-variant-data>
    {{ product.variants | json }}
{% comment %}{% endcomment %}  </script>
  {%- render 'variant-price-map', product: product -%}
</variant-radios-detail>

<style>
  #VariantSelectorPro-{{ block.id }} {
    --vsp-text: var(--color-text);
    --vsp-heading: var(--color-heading);
    --vsp-border: var(--color-border);
    --vsp-accent: var(--color-heading);
    --vsp-selected-bg: var(--color-heading);
    --vsp-bg: var(--color-background);
    --vsp-selected-text: var(--color-background);
    --vsp-muted: color-mix(in srgb, var(--vsp-text) 70%, transparent);
    margin: var(--vsp-mt) 0 var(--vsp-mb);
    color: var(--vsp-text);
    font-family: var(--body-font);
    font-weight: var(--body-weight);
    display:block;
    width:100%;
    min-width:0;
  }
  #VariantSelectorPro-{{ block.id }}:not([data-vsp-custom]) {
    --vsp-size:44px!important; --vsp-img-d:44px!important; --vsp-img-m:44px!important; --vsp-gap:8px!important; --vsp-gap-m:8px!important;
    --vsp-accent:var(--color-heading)!important; --vsp-text:var(--color-text)!important; --vsp-border:var(--color-border)!important;
    --vsp-bg:var(--color-background)!important; --vsp-selected-bg:var(--color-heading)!important; --vsp-selected-text:var(--color-background)!important;
    --vsp-img-bg:var(--color-background)!important; --vsp-muted:var(--color-text)!important;
    --vsp-radius:var(--input-border-radius,4px)!important; --vsp-bw:var(--input-border-width,1px)!important;
  }
  #VariantSelectorPro-{{ block.id }}:not([data-vsp-custom]) :is(.vsp__title,.vsp__subtitle,.vsp__value,.vsp__label,.vsp__chip-text,.vsp__footer) { font-family:inherit!important; font-size:inherit!important; font-weight:inherit!important; color:inherit!important; letter-spacing:normal!important; text-transform:none!important; }
  #VariantSelectorPro-{{ block.id }}:not([data-vsp-custom]) .vsp__soldout { color:var(--color-text)!important; background:var(--color-border)!important; }
  {%- if vsp.enable_vsp_custom -%}
  #VariantSelectorPro-{{ block.id }}[data-vsp-custom] .vsp__values {
    --vsp-cols:{{ vsp.cols_mobile | default: 4 }};
    display:grid;
    grid-template-columns:repeat(var(--vsp-fit-cols, var(--vsp-cols)), max-content);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__cell { min-width:0; min-height:44px; }
  #VariantSelectorPro-{{ block.id }} .vsp__cell > .vsp__chip { max-width:100%; min-width:0!important; }
  #VariantSelectorPro-{{ block.id }}[data-vsp-custom] .vsp__values .vsp__radio + .vsp__cell { padding:{{ vsp.card_padding | default: 4 }}px!important; box-sizing:border-box; }
  @media(min-width:750px){#VariantSelectorPro-{{ block.id }}[data-vsp-custom] .vsp__values { --vsp-cols:{{ vsp.cols_desktop | default: 4 }}; grid-template-columns:repeat(var(--vsp-fit-cols, var(--vsp-cols)), max-content); }}
  {%- endif -%}
  #VariantSelectorPro-{{ block.id }} .vsp__head { margin: 0 0 var(--vsp-header-gap); }
  #VariantSelectorPro-{{ block.id }} .vsp__title { margin: 0; line-height: 1.3; color: var(--vsp-heading); font-family: var(--heading-font, inherit); }
  #VariantSelectorPro-{{ block.id }} .vsp__subtitle { margin: 4px 0 0; line-height: 1.4; color: var(--vsp-muted); }
  #VariantSelectorPro-{{ block.id }} .vsp__footer { margin: 12px 0 0; font-size: 13px; line-height: 1.45; color: var(--vsp-muted); }
  #VariantSelectorPro-{{ block.id }} .vsp__option { border: 0; margin: 0 0 16px; padding: 0; min-width: 0; }
  #VariantSelectorPro-{{ block.id }} .vsp__option:last-of-type { margin-bottom: 0; }
  #VariantSelectorPro-{{ block.id }} .vsp__legend {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px;
    padding: 0; margin: 0 0 10px; line-height: 1.4;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__name { color: var(--vsp-heading); font-weight: var(--heading-weight); }
  #VariantSelectorPro-{{ block.id }} .vsp__sep { margin-left: -2px; color: var(--vsp-heading); }
  #VariantSelectorPro-{{ block.id }} .vsp__value { color: var(--vsp-text); }
  #VariantSelectorPro-{{ block.id }} .vsp__values {
    display: flex; flex-wrap: wrap; align-items: flex-start;
    justify-content: var(--vsp-justify); gap: var(--vsp-gap-m);
  }
  @media (min-width: 750px) {
    #VariantSelectorPro-{{ block.id }} .vsp__values { gap: var(--vsp-gap); }
  }
  #VariantSelectorPro-{{ block.id }} .vsp__cell {
    position: relative; display: inline-flex; flex-direction: column; align-items: center;
    margin: 0; cursor: pointer; min-width: 44px; max-width: 100%;
    -webkit-tap-highlight-color: transparent;
  }
  /* The cell is the label after the radio: the theme's general "checked
     option" paint (dark background) must not reach it; the chip inside
     carries the chosen state. */
  #VariantSelectorPro-{{ block.id }} .vsp__radio + .vsp__cell,
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__cell {
    background: transparent !important; border: 0 !important; color: inherit !important; box-shadow: none !important; padding: 0 !important;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio + .vsp__cell::before,
  #VariantSelectorPro-{{ block.id }} .vsp__radio + .vsp__cell::after { content: none !important; }
  #VariantSelectorPro-{{ block.id }} .vsp__label { display: block; max-width: calc(var(--vsp-img-d) + 16px); text-align: center; line-height: 1.25; color: var(--vsp-text); overflow-wrap: anywhere; }
  #VariantSelectorPro-{{ block.id }} .vsp__chip {
    position: relative; box-sizing: border-box;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; margin: 0;
    color: var(--vsp-text);
    transition: border-color .2s ease, background-color .2s ease, color .2s ease, box-shadow .2s ease, transform .2s cubic-bezier(.2,.7,.2,1);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--button {
    padding: 0 16px;
    border: 1px solid var(--vsp-border);
    border-radius: var(--vsp-radius);
    background: var(--vsp-bg);
    font-family: var(--btn-font, var(--body-font));
    font-weight: var(--btn-font-weight, var(--body-weight));
    letter-spacing: var(--btn-letter-spacing, normal);
    line-height: 1.2;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__cell:hover .vsp__chip { border-color: var(--vsp-accent); }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__cell .vsp__chip--button {
    border-color: var(--vsp-accent);
    background: var(--vsp-selected-bg);
    box-shadow: inset 0 0 0 calc(var(--vsp-bw) - 1px) var(--vsp-accent);
    color: var(--vsp-selected-text);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image {
    width: var(--vsp-img-m); height: auto; aspect-ratio: var(--vsp-ratio);
    padding: var(--vsp-img-pad);
    border: 1px solid var(--vsp-border);
    border-radius: var(--vsp-img-radius);
    background: var(--vsp-img-bg, var(--vsp-bg));
    overflow: hidden;
  }
  @media (min-width: 750px) {
    #VariantSelectorPro-{{ block.id }} .vsp__chip--image { width: var(--vsp-img-d); }
    #VariantSelectorPro-{{ block.id }} .vsp__label { max-width: calc(var(--vsp-img-d) + 16px); }
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--image img {
    display: block; width: 100%; height: 100%;
    object-fit: var(--vsp-img-fit); border-radius: calc(var(--vsp-img-radius) - 2px);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--dot {
    width: var(--vsp-size); height: var(--vsp-size);
    min-width: var(--vsp-size); min-height: var(--vsp-size);
    padding: 0; border: 1px solid var(--vsp-border); border-radius: 50%;
    background: var(--vsp-dot, var(--color-background)); background-clip: padding-box;
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--photo,
  #VariantSelectorPro-{{ block.id }} .vsp__chip--photo img {
    width: var(--vsp-size) !important; height: var(--vsp-size); min-width: var(--vsp-size); aspect-ratio: 1; padding: 0; border-radius: 50%;
  }
  /* The name is already in the chip: no second label under it. */
  #VariantSelectorPro-{{ block.id }} .vsp__chip--text + .vsp__label { display: none; }
  #VariantSelectorPro-{{ block.id }} .vsp__chip-text {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  /* A colour with no picture and no swatch colour reads as its name. */
  #VariantSelectorPro-{{ block.id }} .vsp__chip--text {
    width: auto; padding: 0 16px; border-radius: var(--vsp-radius); background: var(--vsp-bg);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__chip--text .vsp__chip-text { position: static; width: auto; height: auto; clip: auto; }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__cell :is(.vsp__chip--image, .vsp__chip--dot):not(.vsp__chip--text) {
    border-color: var(--vsp-accent);
    box-shadow: 0 0 0 calc(2px + var(--vsp-ring)) var(--color-background), 0 0 0 calc(2px + var(--vsp-ring) + max(var(--vsp-bw), 2px)) var(--vsp-accent);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__cell .vsp__chip--text {
    background: var(--vsp-selected-bg); color: var(--vsp-selected-text);
    box-shadow: inset 0 0 0 1px var(--vsp-accent);
  }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:checked + .vsp__cell .vsp__label { color: var(--vsp-heading); font-weight: 600; }
  #VariantSelectorPro-{{ block.id }} .vsp__radio:focus-visible + .vsp__cell .vsp__chip { outline: 2px solid var(--vsp-accent); outline-offset: 3px; }
  #VariantSelectorPro-{{ block.id }} .vsp__radio.option-disabled + .vsp__cell .vsp__chip { opacity: .5; }
  #VariantSelectorPro-{{ block.id }} .vsp__radio.option-disabled + .vsp__cell .vsp__chip::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: linear-gradient(to top left, transparent calc(50% - .5px), var(--vsp-text) calc(50% - .5px), var(--vsp-text) calc(50% + .5px), transparent calc(50% + .5px));
  }
  #VariantSelectorPro-{{ block.id }} .vsp__soldout {
    position: absolute; top: -6px; right: -6px; z-index: 1;
    padding: 1px 6px; border-radius: 999px; font-size: 10px; font-weight: 600; line-height: 1.5;
    background: var(--color-heading); color: var(--color-background); pointer-events: none;
  }
  /* Hover never moves an option: "lift" firms its border, "glow" adds a
     soft shadow. */
  @media (hover: hover) {
    #VariantSelectorPro-{{ block.id }}:is(.vsp--hover-lift, .vsp--hover-both) .vsp__radio:not(:checked) + .vsp__cell:hover .vsp__chip { box-shadow: inset 0 0 0 1px var(--vsp-accent); }
    #VariantSelectorPro-{{ block.id }}:is(.vsp--hover-glow, .vsp--hover-both) .vsp__radio:not(:checked) + .vsp__cell:hover .vsp__chip { box-shadow: 0 6px 16px -8px color-mix(in srgb, var(--vsp-accent) 60%, transparent); }
  }
  /* Selected animation */
  #VariantSelectorPro-{{ block.id }}.vsp--anim-scale .vsp__radio:checked + .vsp__cell .vsp__chip { transform: scale(1.04); }
  #VariantSelectorPro-{{ block.id }}.vsp--anim-pulse .vsp__radio:checked + .vsp__cell .vsp__chip { animation: vsp-pulse-{{ block.id | handle }} .45s ease-out 1; }
  @keyframes vsp-pulse-{{ block.id | handle }} { 0% { transform: scale(.94); } 60% { transform: scale(1.05); } 100% { transform: none; } }
  /* Phones: a lighter selector with the same 44px targets. */
  @media (max-width: 749px) {
    #VariantSelectorPro-{{ block.id }} .vsp__option { margin-bottom: 12px; }
    #VariantSelectorPro-{{ block.id }} .vsp__legend { margin-bottom: 8px; font-size: 14px; }
    #VariantSelectorPro-{{ block.id }} .vsp__values { gap: min(var(--vsp-gap-m), 8px); }
    #VariantSelectorPro-{{ block.id }} .vsp__chip--button { padding: 0 12px; font-size: 14px; }
    #VariantSelectorPro-{{ block.id }} .vsp__chip--image { width: min(var(--vsp-img-m), 64px); }
    #VariantSelectorPro-{{ block.id }} .vsp__label { max-width: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #VariantSelectorPro-{{ block.id }} .vsp__chip { transition: none; animation: none !important; transform: none !important; }
  }
{% comment %}{% endcomment %}</style>
{%- endunless -%}
</template>
