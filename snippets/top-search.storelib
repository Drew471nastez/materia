<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
  Global search modal/drawer rendered from layout/theme.liquid.
  Opened by `.top-search-toggle` buttons in the header.
{%- endcomment -%}
{% # theme-check-disable ContentForHeaderModification %}
{%- capture content_for_query_string -%}
  {{ content_for_header }}
{%- endcapture -%}
{% # theme-check-enable ContentForHeaderModification %}
{%- assign page_url = content_for_query_string
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: request.host
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}
{%- assign page_query_string = page_url | split: '?' | last -%}
{%- liquid
  assign theme_st = settings
  assign search_type = theme_st.search_type
  assign show_search_price = theme_st.show_search_price
  assign product_style = theme_st.product_style
  assign popular_key_word = theme_st.popular_key_word
  assign show_trending = theme_st.search_show_trending
  if show_trending == nil
    assign show_trending = true
  endif
  assign search_terms = search.terms
  assign key_terms = search_terms
  assign enable_search_suggestion = theme_st.enable_search_suggestion
  assign collection_suggestion = theme_st.collection_suggestion
  if search_terms contains 'product_type:'
    assign arr_terms = search_terms | remove: 'product_type:' | split: ' AND '
    assign product_type = arr_terms[0] | strip
    assign search_terms = arr_terms[1] | strip
    if search_terms == blank
      assign key_terms = key_terms | remove: ' AND '
      assign search_terms = product_type
    endif
  endif
  if page_query_string contains 'ajax=1' and page_query_string contains 'type=popup'
    assign search_type = 'popup'
  endif
-%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if lis_language_rtl contains iso_code
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
{%- if search_type != 'none' -%}
  {{ 'search-type-default.css' | asset_url | stylesheet_tag }}
  <header-search class="header_search search_type_{{ search_type }}">
    <div class="block block-quick-search block-search predictive_search_suggest search_{{ search_type }}">
      {%- assign popup_anim = theme_st.search_popup_animation | default: 'fade' -%}
      {%- comment -%} Search color scheme — paint the whole search panel so the chosen scheme cascades to the drawer + popup (mirrors the cart drawer, which sets the scheme on both its outer and inner elements). Falls back to the first scheme if blank. {%- endcomment -%}
      {%- assign search_scheme = settings.search_color_scheme -%}
      {%- if search_scheme == blank -%}
        {%- for sc in settings.color_schemes -%}{%- assign search_scheme = sc -%}{%- break -%}{%- endfor -%}
      {%- endif -%}
      {%- assign search_scheme_id = 'default' -%}
      {%- if search_scheme != blank -%}{%- assign search_scheme_id = search_scheme.id | default: search_scheme -%}{%- endif -%}
      {%- capture search_scheme_inline -%}
        {%- if search_scheme.settings -%}
          --color-background: {{ search_scheme.settings.background }};
          --color-text: {{ search_scheme.settings.text_color }};
          --color-heading: {{ search_scheme.settings.heading_color }};
          --color-primary: {{ search_scheme.settings.primary_color }};
          --color-border: {{ search_scheme.settings.border_color }};
          --gradient-background: {% if search_scheme.settings.background_gradient != blank %}{{ search_scheme.settings.background_gradient }}{% else %}{{ search_scheme.settings.background }}{% endif %};
          background-color: {{ search_scheme.settings.background }};
          color: {{ search_scheme.settings.text_color }};
        {%- endif -%}
      {%- endcapture -%}
      <div
        id="search-form"
        class="search__type-{{ search_type }} search__popup-anim--{{ popup_anim }} {% if search_type == 'popup' or search_type == 'basic' %} bls__drawer  top{% if enable_rtl %} left right-0{% else %} right left-0{% endif %}{% else %} bls__drawer transition-popup {% if enable_rtl %} right left-0{% else %} left right-0{% endif %}{% endif %} color-{{ search_scheme_id }} fixed w-full z-16 inset-y-0 h-full"
        style="{{ search_scheme_inline | strip | strip_newlines }}"
      >
        {%- case search_type -%}
          {%- when 'drawer' -%}
            {%- render 'search-drawer' -%}
          {%- when 'basic' -%}
            {%- render 'search-popup', mobile: true, basic_mode: true -%}
          {%- else -%}
            {%- render 'search-popup', mobile: true -%}
        {%- endcase -%}
      </div>
    </div>
  </header-search>
  <div class="overlay_search">

  </div>
{%- endif -%}

</template>