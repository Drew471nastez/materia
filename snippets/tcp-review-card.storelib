<template compat="shopify">
{%- comment -%}
  Renders one Testimonial Carousel Pro review card.
  Args:
    b               - review block
    section_settings - parent section.settings (passed in for fallback)
{%- endcomment -%}
{%- assign rating_raw = b.settings.rating | default: 5 -%}
{%- comment -%}
  Star size now lives at the section level so one slider controls every
  star across every review card. Falls back to 26px if not present.
{%- endcomment -%}
{%- assign star_size = section_settings.star_size | default: 26 -%}
<div class="tcp-card" {{ b.shopify_attributes }}>
  <div class="tcp-card-head">
    <div class="tcp-avatar">
      {%- if b.settings.avatar != blank -%}
        {{ b.settings.avatar | image_url: width: 150 | image_tag:
            loading: 'lazy',
            widths: '60,90,120,150',
            sizes: '54px',
            alt: b.settings.name | default: 'Customer'
        }}
      {%- else -%}
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="32" fill="#e7ebef"/>
          <circle cx="32" cy="26" r="10" fill="#bfc6cf"/>
          <path d="M14 56c0-10 9-16 18-16s18 6 18 16" fill="#bfc6cf"/>
        </svg>
      {%- endif -%}
    </div>
    <div>
      <p class="tcp-name">{{ b.settings.name | default: 'Customer' }}</p>
      {%- if b.settings.role != blank -%}
        <p class="tcp-role">{{ b.settings.role }}</p>
      {%- endif -%}
    </div>
  </div>
  {%- if b.settings.body != blank -%}
    <p class="tcp-body">{{ b.settings.body }}</p>
  {%- endif -%}
  {%- comment -%}
    Star rendering with half-step support. For each of 5 positions:
      - rating >= n         → full star
      - rating >= n - 0.5   → half star
      - otherwise           → empty star
  {%- endcomment -%}
  <div class="tcp-stars" aria-label="{{ rating_raw }} out of 5 stars">
    {%- for n in (1..5) -%}
      {%- assign half_threshold = n | minus: 0.5 -%}
      {%- if rating_raw >= n -%}
        {%- assign cls = '' -%}
      {%- elsif rating_raw >= half_threshold -%}
        {%- assign cls = ' is-half' -%}
      {%- else -%}
        {%- assign cls = ' is-empty' -%}
      {%- endif -%}
      <span class="tcp-star{{ cls }}" style="width: {{ star_size }}px; height: {{ star_size }}px;">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z"/></svg>
      </span>
    {%- endfor -%}
  </div>
</div>

</template>