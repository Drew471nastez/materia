<template compat="shopify">
{%- comment -%}
  Materia Themes — Benefits Stack block.
  Pass `block`. Renders a 2x2 grid of benefit items with check icons.
  Each item: icon (selectable), text. Connected to theme typography + colors.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'benefits-stack-' | append: block.id
  assign cols = s.columns | default: 2
  assign icon_color = s.icon_color | default: '#22c55e'
  assign text_color = s.text_color
  assign font_weight = s.font_weight | default: '400'
  assign font_size_d = s.font_size_desktop | default: 14
  assign font_size_m = s.font_size_mobile | default: 13
  assign icon_size = s.icon_size | default: 20
  assign gap_x = s.gap_x | default: 16
  assign gap_y = s.gap_y | default: 10
  assign padding_top = s.padding_top | default: 8
  assign padding_bottom = s.padding_bottom | default: 8
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if text_color != blank %}color: {{ text_color }};{% endif %}
  }
  #{{ block_id }} .benefits-stack {
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    column-gap: {{ gap_x }}px;
    row-gap: {{ gap_y }}px;
  }
  #{{ block_id }} .benefits-stack__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ font_size_m }}px;
    font-weight: {{ font_weight }};
    line-height: 1.4;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .benefits-stack__item {
      font-size: {{ font_size_d }}px;
    }
  }
  #{{ block_id }} .benefits-stack__icon {
    width: {{ icon_size }}px;
    height: {{ icon_size }}px;
    flex: 0 0 auto;
    {% if icon_color != blank %}color: {{ icon_color }};{% endif %}
  }
  #{{ block_id }} .benefits-stack__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (max-width: 480px) {
    #{{ block_id }} .benefits-stack {
      column-gap: {{ gap_x | minus: 4 }}px;
    }
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="benefits-stack-block" {{ block.shopify_attributes }}>
  <div class="benefits-stack">
    {%- for n in (1..6) -%}
      {%- assign t_key = 'text_' | append: n -%}
      {%- assign i_key = 'icon_' | append: n -%}
      {%- assign t_val = s[t_key] -%}
      {%- assign i_val = s[i_key] -%}
      {%- if t_val != blank -%}
        <div class="benefits-stack__item">
          {%- if i_val != 'none' and i_val != blank -%}
            <span class="benefits-stack__icon" aria-hidden="true">
              {%- render 'guarantee-icon', icon: i_val, stroke: 1.8 -%}
            </span>
          {%- endif -%}
          <span class="benefits-stack__text">{{ t_val }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

</template>