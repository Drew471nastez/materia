<template compat="shopify">
<script>
/* Register before editor/page scripts, without blocking the parser on an asset.
   The deferred handler only takes over a resolved, same-page section link. */
(() => {
  if (window.__materiaSectionLinkCapture) return;
  window.__materiaSectionLinkCapture = true;
  ['click','pointerdown','pointerup','pointercancel'].forEach(type => {
    window.addEventListener(type, event => window.MateriaSectionLinks?.[type]?.(event), true);
  });
})();
</script>
</template>
