<template compat="shopify">
{%- comment -%}
  Materia Themes. Scroll-snap carousel styles shared by Reels Wall and
  Shoppable Video, scoped to one section. Columns, gap and the active page
  are CSS variables on [data-msr-carousel]: --msr-cols-m, --msr-cols-d,
  --msr-gap, --msr-p-m, --msr-p-d (pages) and --msr-i (current page, set by
  shopify/assets/media-live-stats-reels.js). data-mode="grid" lays the same
  slides out as a grid with no controls.
  Input: sid (section id).
{%- endcomment -%}
<style>
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .msr-car { --msr-cols: var(--msr-cols-m, 1); --msr-p: var(--msr-p-m, 1); position: relative; min-width: 0; }
  #shopify-section-{{ sid }} .msr-car__track {
    display: grid; grid-auto-flow: column; gap: var(--msr-gap, 16px);
    grid-auto-columns: calc((100% - (var(--msr-cols) - 1) * var(--msr-gap, 16px)) / var(--msr-cols));
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; padding: 4px 0; margin: -4px 0;
  }
  #shopify-section-{{ sid }} .msr-car__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .msr-car__track:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  #shopify-section-{{ sid }} .msr-car__track.is-dragging { scroll-snap-type: none; scroll-behavior: auto; cursor: grabbing; user-select: none; }
  #shopify-section-{{ sid }} .msr-car__track.is-dragging * { pointer-events: none; }
  #shopify-section-{{ sid }} .msr-car__slide { min-width: 0; scroll-snap-align: start; }
  #shopify-section-{{ sid }} .msr-car[data-mode='grid'] .msr-car__track {
    grid-auto-flow: row; grid-template-columns: repeat(var(--msr-cols), minmax(0, 1fr)); grid-auto-columns: auto;
    overflow: visible; scroll-snap-type: none;
  }
  #shopify-section-{{ sid }} .msr-car[data-mode='grid'] .msr-car__controls { display: none; }
  #shopify-section-{{ sid }} .msr-car__controls { display: flex; align-items: center; gap: 8px; margin-top: 16px; min-height: 44px; }
  #shopify-section-{{ sid }} .msr-car__controls[data-m] { display: none; }
  #shopify-section-{{ sid }} .msr-car__dots { flex: 1 1 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--msr-pos, center); min-width: 0; }
  #shopify-section-{{ sid }} .msr-car__arrows { display: flex; gap: 8px; margin-left: auto; }
  #shopify-section-{{ sid }} .msr-car__arrow {
    width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0; cursor: pointer;
    border: 1px solid var(--color-border); border-radius: var(--btn-radius, 999px);
    background: var(--color-background); color: var(--color-heading);
    transition: opacity var(--btn-anim-duration, .2s) ease, border-color var(--btn-anim-duration, .2s) ease;
  }
  #shopify-section-{{ sid }} .msr-car__arrow:hover:not(:disabled) { border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .msr-car__arrow:disabled { opacity: .4; cursor: default; }
  #shopify-section-{{ sid }} .msr-car__arrow svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} :is(.msr-car__arrow, .msr-car__dot):focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  #shopify-section-{{ sid }} .msr-car__dot {
    position: relative; width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; color: var(--color-text); font: inherit; font-size: 13px;
  }
  #shopify-section-{{ sid }} .msr-car__dot::before {
    content: ''; display: block; width: 8px; height: 8px; border-radius: 999px;
    background: color-mix(in srgb, var(--color-heading) 30%, transparent);
    transition: width .25s ease, background-color .25s ease;
  }
  #shopify-section-{{ sid }} .msr-car__dot[aria-current='true']::before { background: var(--color-heading); }
  #shopify-section-{{ sid }} .msr-car__dot span { display: none; }
  #shopify-section-{{ sid }} [data-style='pill'] .msr-car__dot[aria-current='true']::before { width: 24px; }
  #shopify-section-{{ sid }} [data-style='line'] .msr-car__dot::before { width: 24px; height: 3px; border-radius: 0; }
  #shopify-section-{{ sid }} [data-style='square'] .msr-car__dot::before { border-radius: 0; }
  #shopify-section-{{ sid }} [data-style='ring'] .msr-car__dot::before { width: 10px; height: 10px; background: transparent; border: 2px solid color-mix(in srgb, var(--color-heading) 40%, transparent); }
  #shopify-section-{{ sid }} [data-style='ring'] .msr-car__dot[aria-current='true']::before { background: var(--color-heading); border-color: var(--color-heading); }
  #shopify-section-{{ sid }} [data-style='number'] .msr-car__dot::before { display: none; }
  #shopify-section-{{ sid }} [data-style='number'] .msr-car__dot span { display: inline; opacity: .6; }
  #shopify-section-{{ sid }} [data-style='number'] .msr-car__dot[aria-current='true'] span { opacity: 1; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; color: var(--color-heading); }
  #shopify-section-{{ sid }} .msr-car__progress { flex: 1 1 auto; height: 3px; border-radius: 3px; background: color-mix(in srgb, var(--color-heading) 20%, transparent); overflow: hidden; }
  #shopify-section-{{ sid }} .msr-car__progress span { display: block; height: 100%; width: calc(100% * (var(--msr-i, 0) + 1) / var(--msr-p)); background: var(--color-heading); transition: width .3s ease; }
  #shopify-section-{{ sid }} .msr-car__controls:not([data-dots='progress']) .msr-car__progress,
  #shopify-section-{{ sid }} .msr-car__controls[data-dots='progress'] .msr-car__dots,
  #shopify-section-{{ sid }} .msr-car__controls[data-dots='none'] :is(.msr-car__dots, .msr-car__progress) { display: none; }
  #shopify-section-{{ sid }} .msr-car__dot[data-m] { display: none; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .msr-car { --msr-cols: var(--msr-cols-d, 4); --msr-p: var(--msr-p-d, 1); }
    #shopify-section-{{ sid }} .msr-car__controls[data-m]:not([data-d]) { display: flex; }
    #shopify-section-{{ sid }} .msr-car__controls[data-d] { display: none; }
    #shopify-section-{{ sid }} .msr-car__dot[data-m]:not([data-d]) { display: inline-flex; }
    #shopify-section-{{ sid }} .msr-car__dot[data-d] { display: none; }
    #shopify-section-{{ sid }} .msr-car__controls[data-mobile-only] :is(.msr-car__dots, .msr-car__progress) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .msr-car__track { scroll-behavior: auto; }
    #shopify-section-{{ sid }} :is(.msr-car__dot::before, .msr-car__progress span, .msr-car__arrow) { transition: none; }
  }
{% comment %}{% endcomment %}</style>
</template>
