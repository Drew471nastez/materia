<template compat="shopify">
{%- comment -%}
  Materia Themes. The icons of the cart page blocks (snippets/cart-page-block):
  the Benefits pills presets, and with set: 'guarantee' the Guarantee badge
  icons. Pass icon (and set). Only cart-page-block renders this snippet, and
  live-cart-search.js reads the same icons from a template for live edits.
{%- endcomment -%}
{%- if set == 'guarantee' -%}
  {%- case icon -%}
    {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    {%- when 'shield_check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
    {%- when 'check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
    {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- endcase -%}
{%- else -%}
  {%- case icon -%}
    {%- when 'leaf' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c8 0 14-6 14-14-7 0-13 1-14 8-.5 4 0 6 0 6Z"/><path d="M5 19c2-3 5-6 9-9"/></svg>
    {%- when 'smile' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c.7 1.3 2 2.2 3.5 2.2s2.8-.9 3.5-2.2"/><circle cx="9" cy="10" r=".6" fill="currentColor"/><circle cx="15" cy="10" r=".6" fill="currentColor"/></svg>
    {%- when 'heart' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-9.5A4 4 0 0 1 12 7a4 4 0 0 1 7 3.5C19 15.5 12 20 12 20Z"/></svg>
    {%- when 'shield' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 7.5-8 9-4-1.5-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg>
    {%- when 'lightning' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z"/></svg>
    {%- when 'star' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.5 6 .9-4.3 4.3 1 6L12 17l-5.4 2.7 1-6L3.3 9.4l6-.9L12 3Z"/></svg>
    {%- when 'drop' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3 5-6 8.5-6 12a6 6 0 0 0 12 0c0-3.5-3-7-6-12Z"/></svg>
    {%- when 'fire' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3 4 5 4 9a4 4 0 1 1-8 0c0-2 1-3 2-4-.5 2.5 0 4 2-5Z"/></svg>
    {%- when 'sparkle' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.7 4 4 1.7-4 1.7L12 16l-1.7-4.6-4-1.7 4-1.7L12 4Z"/><path d="M19 14l.7 1.7 1.7.6-1.7.6L19 18.6l-.6-1.7-1.7-.6 1.7-.6L19 14Z"/></svg>
    {%- when 'sun' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
    {%- when 'moon' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14a8 8 0 1 1-10-10 7 7 0 0 0 10 10Z"/></svg>
    {%- when 'brain' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 1 4 3 3 0 0 0 4 2h0v-13Z"/><path d="M15 5a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-1 4 3 3 0 0 1-4 2h0v-13Z"/></svg>
    {%- when 'check' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
    {%- when 'flower' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.5"/><path d="M12 3a3 3 0 0 1 0 6M12 15a3 3 0 0 1 0 6M3 12a3 3 0 0 1 6 0M15 12a3 3 0 0 1 6 0"/></svg>
    {%- when 'gem' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l3-5h6l3 5-6 11L6 9Z"/><path d="M6 9h12M9 4l3 5 3-5"/></svg>
    {%- when 'flame' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a6 6 0 0 0 6-6c0-3-2-5-3-7-1-2-3-3-3-5 0 3-3 4-4 7s-2 4-2 5a6 6 0 0 0 6 6Z"/></svg>
    {%- when 'zap' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M5 12h6M19 12h-6M12 22v-6M6 6l4 4M14 14l4 4M18 6l-4 4M10 14l-4 4"/></svg>
    {%- when 'muscle' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11c2-3 6-3 8 0M13 11c1 2 4 3 6 1M5 11c0 6 4 9 9 9 4 0 6-3 5-7"/></svg>
    {%- when 'pill' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="6" rx="3"/><path d="M12 9v6"/></svg>
    {%- when 'trophy' -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v6a4 4 0 1 1-8 0V4Z"/><path d="M5 6h3M16 6h3M10 18h4M9 21h6M12 14v4"/></svg>
    {%- else -%}<svg fill="none" stroke="currentColor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
  {%- endcase -%}
{%- endif -%}
</template>