<template compat="shopify">
{%- comment -%}
  Materia Themes. What Hero Split and Hero Collage share: the section's
  margins (on the wrapper, so the builder can change them without a redraw),
  the colour scheme background and the text column: eyebrow, heading, text
  and buttons. Every value that a setting changes is a CSS variable printed
  on the root or on the block itself; live-r7-hero.js writes the same
  variables on a live edit. Defaults are the theme's own: scheme colours,
  theme fonts and weights, the theme's h1 size and the theme's buttons.
  Use: render 'r7-hero-style', section: section
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }}{isolation:isolate;position:relative;--r7h-mt-m:{{ st.section_margin_top_mobile | default: 0 }}px;--r7h-mb-m:{{ st.section_margin_bottom_mobile | default: 0 }}px;--r7h-mt-d:{{ st.section_margin_top_desktop | default: 0 }}px;--r7h-mb-d:{{ st.section_margin_bottom_desktop | default: 0 }}px;margin-top:var(--r7h-mt-m);margin-bottom:var(--r7h-mb-m)}
  #shopify-section-{{ sid }}:has(> .r7h[data-reset-spacing]){margin-top:var(--r7h-mt-m)!important;margin-bottom:var(--r7h-mb-m)!important}
  #shopify-section-{{ sid }}:has(> .r7h[data-reset-spacing]) > :is(.section,section,div){margin-top:0!important;margin-bottom:0!important}
  @media (min-width:768px){
    #shopify-section-{{ sid }}{margin-top:var(--r7h-mt-d);margin-bottom:var(--r7h-mb-d)}
    #shopify-section-{{ sid }}:has(> .r7h[data-reset-spacing]){margin-top:var(--r7h-mt-d)!important;margin-bottom:var(--r7h-mb-d)!important}
  }
  #shopify-section-{{ sid }} .r7h,#shopify-section-{{ sid }} .r7h *,#shopify-section-{{ sid }} .r7h *::before,#shopify-section-{{ sid }} .r7h *::after{box-sizing:border-box}
  #shopify-section-{{ sid }} .r7h{background:var(--r7h-bg,var(--gradient-background,var(--color-background)));color:var(--color-text);font-family:var(--r7h-bf,var(--body-font,inherit))}
  #shopify-section-{{ sid }} .r7h__stack{display:flex;flex-direction:column;align-items:var(--r7h-items,flex-start);gap:calc(var(--r7h-gap,16px)*var(--sl-space-scale,1));width:100%;max-width:var(--r7h-max,520px);min-width:0;text-align:var(--r7h-align,left)}
  #shopify-section-{{ sid }} .r7h__stack > *{margin:0;max-width:100%;min-width:0}
  #shopify-section-{{ sid }} .r7h__stack [hidden]{display:none!important}
  #shopify-section-{{ sid }} .r7h__eyebrow{font-family:var(--r7h-bf,var(--body-font,inherit));font-size:var(--r7h-size,1.4rem);font-weight:var(--subheading-weight,500);line-height:1.4;color:var(--r7h-color,var(--color-text))}
  #shopify-section-{{ sid }} .r7h__heading{font-family:var(--r7h-hf,var(--heading-font,inherit));font-size:var(--r7h-size-m,calc(var(--heading-font-scale,1)*3.4rem));font-weight:var(--r7h-weight,var(--heading-weight,600));line-height:var(--r7h-lh,var(--heading-line-height,1.2));letter-spacing:var(--r7h-ls,var(--heading-letter-spacing,normal));color:var(--r7h-color,var(--color-heading));overflow-wrap:break-word;text-wrap:balance}
  #shopify-section-{{ sid }} .r7h__heading :is(strong,b,em,i,span){font-family:inherit;line-height:inherit;letter-spacing:inherit;color:inherit}
  #shopify-section-{{ sid }} .r7h__heading a,#shopify-section-{{ sid }} .r7h__text a{color:inherit;text-decoration:underline;text-underline-offset:.15em}
  #shopify-section-{{ sid }} .r7h__text{font-family:var(--r7h-bf,var(--body-font,inherit));font-size:var(--r7h-size,var(--body-font-size,1.6rem));font-weight:var(--body-weight,400);line-height:var(--r7h-lh,var(--body-line-height,1.6));color:var(--r7h-color,var(--color-text))}
  #shopify-section-{{ sid }} .r7h__text :is(p,ul,ol,li){margin:0;font-size:inherit;line-height:inherit;color:inherit}
  #shopify-section-{{ sid }} .r7h__text > * + *{margin-top:.65em}
  #shopify-section-{{ sid }} .r7h__text :is(ul,ol){padding-inline-start:1.2em;text-align:start}
  #shopify-section-{{ sid }} .r7h__buttons{display:flex;flex-wrap:wrap;justify-content:var(--r7h-items,flex-start);gap:12px;margin-top:calc(8px*var(--sl-space-scale,1))}
  #shopify-section-{{ sid }} .r7h__buttons:not(:has(> :not([hidden]))){display:none}
  #shopify-section-{{ sid }} .r7h__cta{max-width:100%;white-space:normal;overflow-wrap:anywhere;text-align:center;cursor:pointer;-webkit-tap-highlight-color:transparent}
  #shopify-section-{{ sid }} .r7h__cta:active{opacity:.82}
  @media (min-width:768px){
    #shopify-section-{{ sid }} .r7h__heading{font-size:var(--r7h-size-d,var(--h1-size,4rem))}
  }
{% comment %}{% endcomment %}</style>
</template>
