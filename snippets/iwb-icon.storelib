<template compat="shopify">
{%- comment -%}
  Materia Themes — Image With Text Benefits icon renderer.
  Renders an icon based on bb.icon_source: library | image | svg | none

  Required input:
    bb — block.settings (or hash) with: icon_source, icon_name, icon_image, icon_svg
{%- endcomment -%}
{%- assign src = bb.icon_source | default: 'library' -%}

{%- case src -%}
  {%- when 'none' -%}
    {%- comment -%} render nothing {%- endcomment -%}

  {%- when 'image' -%}
    {%- if bb.icon_image != blank -%}
      <img src="{{ bb.icon_image | image_url: width: 200 }}" alt="{{ bb.icon_image.alt | default: 'Icon' | escape }}" loading="lazy">
    {%- else -%}
      {%- comment -%} fallback to library default icon {%- endcomment -%}
      {%- assign src = 'library' -%}
      {%- assign fallback = true -%}
    {%- endif -%}

  {%- when 'svg' -%}
    {%- if bb.icon_svg != blank -%}
      {{ bb.icon_svg }}
    {%- else -%}
      {%- assign src = 'library' -%}
      {%- assign fallback = true -%}
    {%- endif -%}
{%- endcase -%}

{%- if src == 'library' -%}
  {%- assign name = bb.icon_name | default: 'check' -%}
  {%- case name -%}
    {%- when 'check' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4 4L19 7"/></svg>
    {%- when 'star' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.6 5.8 6.4.7-4.8 4.4 1.4 6.3L12 17.1 6.4 20.2l1.4-6.3L3 9.5l6.4-.7L12 3z"/></svg>
    {%- when 'heart' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.5-7 10-7 10z"/></svg>
    {%- when 'leaf' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c8 0 14-6 14-14H10C7 5 5 7 5 10v9z"/><path d="M5 19s5-7 14-14"/></svg>
    {%- when 'sparkle' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v6M12 15v6M3 12h6M15 12h6M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/></svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
    {%- when 'lock' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
    {%- when 'gift' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18"/><path d="M12 9v11"/><path d="M12 9c-2.5 0-4-1.5-4-3s1.5-3 4 0c2.5-3 4-1.5 4 0s-1.5 3-4 3z"/></svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
    {%- when 'clock' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    {%- when 'drop' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s-6 7-6 11a6 6 0 0012 0c0-4-6-11-6-11z"/></svg>
    {%- when 'sun' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
    {%- when 'moon' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14a8 8 0 01-10-10 8 8 0 1010 10z"/></svg>
    {%- when 'flame' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s5 5 5 10a5 5 0 01-10 0c0-3 2-4 2-7 1 2 3 1 3-3z"/></svg>
    {%- when 'flask' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/></svg>
    {%- when 'bottle' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3h4v3l2 3v9a2 2 0 01-2 2h-4a2 2 0 01-2-2V9l2-3V3z"/><path d="M9 3h6"/></svg>
    {%- when 'feather' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-6 0-12 4-12 11v5l13-13a4 4 0 00-1-3z"/><path d="M14 10l-6 6"/><path d="M3 21l5-5"/></svg>
    {%- when 'smile' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="0.5" data-iwb-fill/><circle cx="15" cy="10" r="0.5" data-iwb-fill/><path d="M8 14c1.5 2 6.5 2 8 0"/></svg>
    {%- when 'thumbs_up' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11v9H4v-9z"/><path d="M7 11l4-7c1 0 2 1 2 2v3h5a2 2 0 012 2l-2 7a2 2 0 01-2 2H7"/></svg>
    {%- when 'tag' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="8" cy="8" r="1.5" data-iwb-fill/></svg>
    {%- when 'globe' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
    {%- when 'recycle' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17l-3-3 3-3"/><path d="M4 14h11a3 3 0 003-3"/><path d="M17 7l3 3-3 3"/><path d="M20 10H9a3 3 0 00-3 3"/></svg>
    {%- when 'diamond' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/><path d="M9 3l3 6 3-6"/><path d="M12 9l0 12"/></svg>
    {%- when 'award' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M9 14l-2 7 5-3 5 3-2-7"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4 4L19 7"/></svg>
  {%- endcase -%}
{%- endif -%}

</template>