<template compat="shopify">
{%- assign s = section.settings -%}
{% if s.enable_custom_font or s.enable_custom_fonts %}<style>{% if s.heading_font.family %}{{ s.heading_font | font_face: font_display:'swap' }}{% endif %}{% if s.body_font.family %}{{ s.body_font | font_face: font_display:'swap' }}{% endif %}</style>{% endif %}
<style>
#shopify-section-{{ section.id }} [data-text-controls]{font-family:var(--body-font);color:var(--color-text);{% unless s.enable_custom_style %}background:var(--color-background)!important;{% endunless %}}
#shopify-section-{{ section.id }} [data-text-controls] :is(h2,h3){font-family:var(--heading-font)}
{% if s.enable_custom_font or s.enable_custom_fonts %}{% assign section_heading_font = s.heading_font | default:s.custom_font_title %}{% if section_heading_font.family %}{{ section_heading_font | font_face:font_display:'swap' }}#shopify-section-{{ section.id }} [data-text-controls] :is(h2,h3){font-family:{{ section_heading_font.family }},{{ section_heading_font.fallback_families | default:'sans-serif' }}!important}{% endif %}{% if s.body_font.family %}#shopify-section-{{ section.id }} [data-text-controls]{font-family:{{ s.body_font.family }},{{ s.body_font.fallback_families | default:'sans-serif' }}!important}{% endif %}{% endif %}
{% if kind == 'scroll-text-banner' %}
{% if request.design_mode or page.in_editor %}#shopify-section-{{ section.id }} scroll-text-banner{height:auto!important}#shopify-section-{{ section.id }} .stw__viewport{position:relative!important;min-height:0!important;top:auto!important}{% endif %}
{% else %}
{% for block in section.blocks %}{% assign b = block.settings %}
{% if b.enable_custom_fonts and b.font.family %}{{ b.font | font_face:font_display:'swap' }}{% endif %}
{% if b.enable_custom_fonts %}{% assign chosen_font = b.font | default:b.custom_font_title | default:b.custom_font_description_button %}{% if chosen_font.family %}{{ chosen_font | font_face:font_display:'swap' }}#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{font-family:{{ chosen_font.family }},{{ chosen_font.fallback_families | default:'sans-serif' }}!important}{% endif %}{% endif %}
{% if b.enable_custom_style and b.color != blank %}#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{color:{{ b.color }}!important}{% endif %}
{% unless b.enable_custom_style or s.enable_custom_style %}
#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"]{% if block.type == 'description' or block.type == 'text' %},#shopify-section-{{ section.id }} [data-tx-block="{{ block.id }}"] p{% endif %}{% if block.type != 'button' and block.type != 'buttons' %}{color:{% if block.type == 'title' or block.type == 'heading' or block.type == 'subtitle' %}var(--color-heading){% else %}var(--color-text){% endif %}!important;background-image:none!important;-webkit-text-fill-color:currentColor!important}{% endif %}
{% endunless %}
{% endfor %}
{% endif %}
@media(prefers-reduced-motion:reduce){#shopify-section-{{ section.id }} [data-text-controls],#shopify-section-{{ section.id }} [data-text-controls] *{animation:none!important;transition:none!important}}
</style>
</template>
