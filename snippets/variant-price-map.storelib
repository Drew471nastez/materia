<template compat="shopify">
{%- comment -%}
  Materia Themes. Each variant's price and compare-at price as the shop
  prints them, read by the variant picker when a variant is chosen.
{%- endcomment -%}
<script type="application/json" data-variant-prices>
  {
  {%- for v in product.variants -%}
    {%- if settings.show_currency_code -%}
      {%- assign vp_price = v.price | money_with_currency -%}
      {%- assign vp_compare = v.compare_at_price | money_with_currency -%}
    {%- else -%}
      {%- assign vp_price = v.price | money -%}
      {%- assign vp_compare = v.compare_at_price | money -%}
    {%- endif -%}
    {%- unless v.compare_at_price > v.price -%}{%- assign vp_compare = '' -%}{%- endunless -%}
    {{ v.id | append: '' | json }}: { "price": {{ vp_price | strip | json }}, "compare_at_price": {{ vp_compare | strip | json }} }
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  }
{% comment %}{% endcomment %}</script>
</template>
