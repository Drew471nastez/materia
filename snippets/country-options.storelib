<template compat="shopify">
{%- comment -%}
  Materia Themes. The country list of every country selector, written once per
  page as compact JSON in script#materia-country-options (layout/theme). Each
  selector builds its rows from it the first time it opens. Each entry is
  [code, name, currency code, currency symbol, flag]; the flag address is left
  empty when it is the usual emoji flag, which the script draws from the code.
{%- endcomment -%}
[
{%- for country in localization.available_countries -%}
  {%- assign flag = country | image_url: width: country.width -%}
  {%- if flag contains 'data:image/svg' -%}{%- assign flag = '' -%}{%- endif -%}
  [{{ country.iso_code | json }},{{ country.name | json }},{{ country.currency.iso_code | json }},{{ country.currency.symbol | json }},{{ flag | json }}]{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
</template>
