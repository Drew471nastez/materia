<template compat="shopify">
{%- comment -%}
  Materia Themes. The shared look of the account, password and utility page
  sections (main-login, main-register, main-account, main-addresses,
  main-order, main-activate-account, main-reset-password, login-popup,
  main-password-header, main-password-footer, page-404, page-compare,
  page-contact, page-default, page-wishlist, pages-store-location,
  form-message). Only those sections render it.

  The section root (.ap, [data-ap-root]) carries its values as CSS variables
  in its style attribute, printed by the section and set again by
  shopify/assets/live-account-pages.js on a live edit:
    --ap-pt / --ap-pb         padding on a computer
    --ap-pt-m / --ap-pb-m     padding on a phone
    --ap-h-c / --ap-t-c       heading and text colour (custom styling only)
    --ap-hfs-d / --ap-hfs-m   heading size, --ap-tfs-d / --ap-tfs-m text size
    --ap-align                text alignment
    --heading-font / --body-font / --mb-font   custom fonts (custom fonts only),
                              so the theme's own priority rules read them
  data-ap-reset on the root takes the space between sections away.

  Params: sid (section.id)
{%- endcomment -%}
<style>
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  #shopify-section-{{ sid }}:has([data-ap-reset]) { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }}:has([data-ap-reset]) + .shopify-section { margin-top: 0 !important; }
  #shopify-section-{{ sid }} .ap {
    box-sizing: border-box;
    padding-top: var(--ap-pt-m, 0px);
    padding-bottom: var(--ap-pb-m, 0px);
    background: var(--ap-bg, var(--color-background));
    color: var(--ap-t-c, var(--color-text));
    text-align: var(--ap-align, start);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ap { padding-top: var(--ap-pt, 0px); padding-bottom: var(--ap-pb, 0px); }
  }
  #shopify-section-{{ sid }} .ap__h {
    color: var(--ap-h-c, var(--color-heading));
    font-size: var(--ap-hfs-m, var(--h3-size));
    margin: 0 0 12px;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ sid }} .ap__h--sub { font-size: var(--ap-h2fs, var(--h4-size)); }
  #shopify-section-{{ sid }} .ap__t { font-size: var(--ap-tfs-m, inherit); color: var(--ap-t-c, var(--color-text)); }
  #shopify-section-{{ sid }} .ap__t > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .ap__t > :last-child { margin-bottom: 0; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .ap__h { font-size: var(--ap-hfs-d, var(--ap-hfs-m, var(--h3-size))); }
    #shopify-section-{{ sid }} .ap__t { font-size: var(--ap-tfs-d, var(--ap-tfs-m, inherit)); }
  }
  #shopify-section-{{ sid }} .ap__form { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }
  #shopify-section-{{ sid }} .ap__field { display: flex; flex-direction: column; gap: 6px; text-align: start; }
  #shopify-section-{{ sid }} .ap__field label { color: var(--ap-t-c, var(--color-text)); }
  #shopify-section-{{ sid }} .ap__field input { width: 100%; }
  #shopify-section-{{ sid }} .ap__req { color: var(--color-primary, currentColor); margin-inline-start: 2px; }
  #shopify-section-{{ sid }} .ap__btn { width: 100%; }
  #shopify-section-{{ sid }} .ap__link { color: var(--ap-h-c, var(--color-heading)); text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; min-height: 44px; }
  #shopify-section-{{ sid }} .ap__msg { display: flex; gap: 8px; align-items: flex-start; margin: 0; padding: 12px 14px; border: 1px solid currentColor; background: transparent; border-radius: var(--input-border-radius, 4px); text-align: start; }
  #shopify-section-{{ sid }} .ap__msg ul { margin: 4px 0 0; padding-inline-start: 18px; }
  #shopify-section-{{ sid }} .ap__msg svg { flex: 0 0 auto; margin-top: 3px; }
  #shopify-section-{{ sid }} [hidden] { display: none !important; }
  #shopify-section-{{ sid }} :is(a, button):focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 3px; }
{% comment %}{% endcomment %}</style>
</template>
