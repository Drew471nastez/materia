<template compat="shopify">
{%- liquid
  assign c = controls
  assign custom = c.enable_custom_style
-%}
{%- if kind == 'section' -%}
--tq-width:{{ c.section_width | default: 90 }}%;--tq-intro-width:{{ c.intro_width | default: 30 }}%;--tq-count:{{ c.testimonial_per_row | default: 2 }};--tq-gap:{{ c.testimonials_space_between | default: 20 }}px;--tq-card-pad:{{ c.card_padding | default: 24 }}px;--tq-star:{{ c.stars_size | default: 20 }}px;--tq-lines:{{ c.quote_lines | default: 4 }};
--tq-mobile-card:{% if c.show_peek == false %}100%{% else %}86%{% endif %};
--tq-pt-m:{{ c.top_padding_mobile | default: 20 }}px;--tq-pb-m:{{ c.bottom_padding_mobile | default: 20 }}px;--tq-margin-m:{{ c.vertical_margin_mobile | default: 0 }}px;
--tq-bg:{% if custom %}{% render 'scheme-color', color: c.section_background, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--tq-text:{% if custom %}{% render 'scheme-color', color: c.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--tq-heading:{% if custom %}{% render 'scheme-color', color: c.text_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
--tq-quote:{% if custom %}{% render 'scheme-color', color: c.testimonial_color, fallback: 'var(--tq-text)' %}{% else %}var(--tq-text){% endif %};
--tq-author:{% if custom %}{% render 'scheme-color', color: c.author_color, fallback: 'var(--tq-heading)' %}{% else %}var(--tq-heading){% endif %};
--tq-arrow:{% if custom %}{% render 'scheme-color', color: c.inactive_arrows_color, fallback: 'var(--tq-heading)' %}{% else %}var(--tq-heading){% endif %};
--tq-stars:{% if custom %}{% render 'scheme-color', color: c.stars_color, fallback: 'var(--tq-heading)' %}{% else %}var(--tq-heading){% endif %};
--tq-empty:{% if custom %}{% render 'scheme-color', color: c.empty_stars_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
--tq-card-bg:{% if c.testimonial_box_style == 'border' %}transparent{% elsif custom %}{% render 'scheme-color', color: c.testimonial_box_color, fallback: 'color-mix(in srgb,var(--tq-text) 5%,var(--tq-bg))' %}{% else %}color-mix(in srgb,var(--tq-text) 5%,var(--tq-bg)){% endif %};
--tq-border:{% if custom and c.testimonial_border_color != blank %}{% render 'scheme-color', color: c.testimonial_border_color, fallback: 'transparent' %}{% elsif c.testimonial_box_style == 'border' %}var(--color-border){% else %}transparent{% endif %};
--tq-radius:{% if custom %}{{ c.testimonial_box_corner | default: 14 }}px{% else %}var(--rounded-radius,8px){% endif %};
background:var(--tq-bg)!important;color:var(--tq-text)!important;
--tq-quote-size:{% if custom %}{{ c.testimonial_text_size | default: 16 }}px{% else %}var(--body-font-size,16px){% endif %};
{%- elsif kind == 'button' -%}
{%- if c.use_theme_button == false -%}
--mb-bg:{% render 'scheme-color', color: c.button_background_color, fallback: 'var(--btn-primary-bg-color)' %};--mb-text:{% render 'scheme-color', color: c.button_text_color, fallback: 'var(--btn-primary-color)' %};--mb-border:{% render 'scheme-color', color: c.button_border_color, fallback: 'var(--color-border)' %};--mb-radius:{{ c.button_corner | default: 6 }}px;--mb-hover-border:var(--mb-line);--tq-button-ink:{% render 'scheme-color', color: c.button_text_color, fallback: 'var(--tq-heading)' %};border-radius:{{ c.button_corner | default: 6 }}px!important;
{%- endif -%}
{%- elsif kind == 'testimonial' -%}
--tq-own-card:{% if custom %}{% render 'scheme-color', color: c.card_color, fallback: 'var(--tq-card-bg)' %}{% else %}var(--tq-card-bg){% endif %};
--tq-own-quote:{% if custom %}{% render 'scheme-color', color: c.quote_color, fallback: 'var(--tq-quote)' %}{% else %}var(--tq-quote){% endif %};
background:var(--tq-own-card)!important;border-color:var(--tq-border)!important;border-radius:var(--tq-radius)!important;
--tq-own-size:{% if custom %}{{ c.quote_size | default: 16 }}px{% else %}var(--tq-quote-size,var(--body-font-size,16px)){% endif %};
{%- else -%}
--tq-block-font:{% if custom and c.font_source == 'body' %}var(--body-font){% elsif custom and c.font_source == 'heading' %}var(--heading-font){% elsif kind == 'heading' %}var(--heading-font){% else %}var(--body-font){% endif %};
--tq-block-color:{% if custom %}{% if kind == 'heading' %}{% render 'scheme-color', color: c.color, fallback: 'var(--tq-heading)' %}{% else %}{% render 'scheme-color', color: c.color, fallback: 'var(--tq-text)' %}{% endif %}{% elsif kind == 'heading' %}var(--tq-heading){% else %}var(--tq-text){% endif %};
--tq-block-size-d:{% if custom and kind == 'heading' %}{{ c.heading_size_desktop | default: 38 }}px{% elsif custom %}{{ c.description_size_desktop | default: 16 }}px{% elsif kind == 'heading' %}var(--h2-size,32px){% else %}var(--body-font-size,16px){% endif %};
--tq-block-size-m:{% if custom and kind == 'heading' %}{{ c.heading_size_mobile | default: 34 }}px{% elsif custom %}{{ c.description_size_mobile | default: 14 }}px{% elsif kind == 'heading' %}var(--h2-size,32px){% else %}var(--body-font-size,16px){% endif %};
--tq-block-weight:{% if custom and kind == 'heading' %}{% case c.heading_style %}{% when 'thin' %}100{% when 'light' %}300{% when 'regular' %}400{% when 'bold' %}700{% else %}600{% endcase %}{% elsif kind == 'heading' %}var(--heading-weight,600){% else %}var(--body-weight,400){% endif %};
--tq-block-case:{% if custom and c.text_case != blank and c.text_case != 'theme' %}{{ c.text_case }}{% elsif kind == 'heading' %}var(--heading-text-transform,none){% else %}none{% endif %};
--tq-block-spacing:{% if custom %}{{ c.letter_spacing | default: 0 }}px{% elsif kind == 'heading' %}var(--heading-letter-spacing,normal){% else %}normal{% endif %};
font-family:var(--tq-block-font)!important;font-size:var(--tq-block-current-size,var(--tq-block-size-m))!important;font-weight:var(--tq-block-weight)!important;letter-spacing:var(--tq-block-spacing)!important;text-transform:var(--tq-block-case)!important;color:var(--tq-block-color);line-height:{% if kind == 'heading' %}var(--heading-line-height,1.2){% else %}var(--body-line-height,1.5){% endif %}!important;
{%- endif -%}
</template>
