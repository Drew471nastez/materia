<template compat="shopify">
{%- comment -%}
  Materia Themes. Rules that Testimonial Wall and Testimonial With Product
  share, scoped to one section (sid): the frame and its Section width, the
  eyebrow, heading and subheading blocks, the quote card (stars filled to a
  rating, the customer's words, picture, name and the line under it), the
  button block, focus rings and reduced motion. What a setting chooses
  reaches these rules as --r7t-* properties and data-* attributes on the
  section root, printed by the section and repainted in the builder by
  assets/live-r7-testimonials.js with the same names and fallbacks.
{%- endcomment -%}
<style>
  #shopify-section-{{ sid }} .r7t { position: relative; background: var(--r7t-bg); color: var(--r7t-text); font-family: var(--r7t-bf); padding-top: var(--r7t-pt-m); padding-bottom: var(--r7t-pb-m); margin-top: var(--r7t-mt-m); margin-bottom: var(--r7t-mb-m); overflow: hidden; }
  #shopify-section-{{ sid }} .r7t[data-reset="true"] { margin-top: 0; margin-bottom: 0; }
  #shopify-section-{{ sid }}:has(> .r7t[data-reset="true"]) { margin-top: 0 !important; margin-bottom: 0 !important; }
  #shopify-section-{{ sid }} .r7t *, #shopify-section-{{ sid }} .r7t *::before, #shopify-section-{{ sid }} .r7t *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .r7t [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .r7t__frame { --r7t-pad: 16px; margin-inline: auto; padding-inline: var(--r7t-pad); }
  #shopify-section-{{ sid }} .r7t__frame[data-width="container"] { --r7t-pad: 1.5rem; max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .r7t__frame[data-width="fluid_container"] { --r7t-pad: 1.5rem; max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .r7t__frame[data-width="stretch_width"] { --r7t-pad: 1.5rem; }

  #shopify-section-{{ sid }} .r7t__head { max-width: 720px; margin: 0 0 28px; text-align: start; }
  #shopify-section-{{ sid }} .r7t[data-align="center"] .r7t__head { margin-inline: auto; text-align: center; }
  #shopify-section-{{ sid }} .r7t__head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .r7t__eyebrow { margin: 0 0 10px; color: var(--b-c); font-family: var(--r7t-bf); font-size: 12px; font-weight: 700; line-height: 1.3; letter-spacing: .12em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .r7t__heading { margin: 0; color: var(--b-c); font-family: var(--r7t-hf); font-weight: var(--heading-weight, 700); font-size: var(--b-fs-m); line-height: 1.15; text-wrap: balance; }
  #shopify-section-{{ sid }} .r7t__sub { margin: 12px 0 0; color: var(--b-c); font-family: var(--r7t-bf); font-size: var(--b-fs); line-height: 1.55; }
  #shopify-section-{{ sid }} .r7t__sub p { margin: 0; font-size: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ sid }} .r7t__sub p + p { margin-top: .6em; }
  #shopify-section-{{ sid }} .r7t__sub a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  #shopify-section-{{ sid }} .r7t-stars { display: inline-flex; align-items: center; gap: 2px; line-height: 0; }
  #shopify-section-{{ sid }} .r7t-star { position: relative; display: inline-block; flex: 0 0 auto; width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .r7t-star svg { display: block; width: 100%; height: 100%; fill: var(--r7t-star-off); }
  #shopify-section-{{ sid }} .r7t-star::before { content: ""; position: absolute; inset: 0; background: var(--r7t-star-on); -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z'/></svg>") center / contain no-repeat; mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2l2.95 6.27L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.05-1z'/></svg>") center / contain no-repeat; clip-path: inset(0 calc(100% - var(--r7t-fill, 0%)) 0 0); }
  [dir="rtl"] #shopify-section-{{ sid }} .r7t-star::before { clip-path: inset(0 0 0 calc(100% - var(--r7t-fill, 0%))); }

  #shopify-section-{{ sid }} .r7t-card { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-width: 0; padding: 20px; border: 1px solid transparent; border-radius: var(--r7t-radius); background: var(--r7t-card-bg); text-align: start; }
  #shopify-section-{{ sid }} .r7t[data-card="outline"] .r7t-card { background: transparent; border-color: var(--r7t-card-border); }
  #shopify-section-{{ sid }} .r7t[data-card="plain"] .r7t-card { padding: 18px 0 0; border: 0; border-top: 1px solid var(--r7t-card-border); border-radius: 0; background: transparent; }
  #shopify-section-{{ sid }} .r7t-card__quote { margin: 0; max-width: 100%; color: var(--r7t-quote-c); font-size: var(--r7t-q-m); line-height: 1.55; white-space: pre-line; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .r7t-card__by { display: flex; align-items: center; gap: 12px; min-width: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .r7t-card__avatar { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: color-mix(in srgb, var(--r7t-text) 10%, transparent); }
  #shopify-section-{{ sid }} .r7t-card__avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .r7t-card__who { min-width: 0; }
  #shopify-section-{{ sid }} .r7t-card__name { margin: 0; color: var(--r7t-name-c); font-family: var(--r7t-hf); font-weight: var(--heading-weight, 700); font-size: 15px; line-height: 1.3; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .r7t-card__role { margin: 2px 0 0; color: color-mix(in srgb, var(--r7t-text) 78%, transparent); font-size: 13px; line-height: 1.35; overflow-wrap: anywhere; }

  #shopify-section-{{ sid }} .r7t__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 28px; }
  #shopify-section-{{ sid }} .r7t__actions:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .r7t__btn, #shopify-section-{{ sid }} .r7t__more { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; text-decoration: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} .r7t__btn:active, #shopify-section-{{ sid }} .r7t__more:active { opacity: .82; }
  #shopify-section-{{ sid }} .r7t__btn:focus-visible, #shopify-section-{{ sid }} .r7t__more:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .r7t { padding-top: var(--r7t-pt); padding-bottom: var(--r7t-pb); margin-top: var(--r7t-mt); margin-bottom: var(--r7t-mb); }
    #shopify-section-{{ sid }} .r7t__head { margin-bottom: 40px; }
    #shopify-section-{{ sid }} .r7t__heading { font-size: var(--b-fs-d); }
    #shopify-section-{{ sid }} .r7t-card { padding: 24px; }
    #shopify-section-{{ sid }} .r7t[data-card="plain"] .r7t-card { padding: 20px 0 0; }
    #shopify-section-{{ sid }} .r7t-card__quote { font-size: var(--r7t-q-d); }
    #shopify-section-{{ sid }} .r7t__actions { margin-top: 36px; }
  }
  @media (min-width: 1200px) {
    #shopify-section-{{ sid }} .r7t__frame[data-width="stretch_width"] { --r7t-pad: 3rem; }
  }
{% comment %}{% endcomment %}</style>
</template>
