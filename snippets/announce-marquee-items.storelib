<template compat="shopify">
{%- comment -%}
  Materia Themes. The items of the Marquee Bar, one wrapper per Marquee
  block (display: contents, so the items stay the strip's own flex items).
  copy: true prints a silent copy for the seamless loop (data-an-copy), which
  live-announcements.js keeps in step with the block.
  {% render 'announce-marquee-items', section: section, copy: false %}
{%- endcomment -%}
{%- for block in section.blocks -%}
  {%- liquid
    assign bs = block.settings
    assign has_svg = false
    if bs.svg_icon != blank
      assign has_svg = true
    endif
    assign own_font = false
    if bs.enable_custom_fonts and bs.font.family != blank
      assign own_font = true
    endif
  -%}
  <div class="scrolling__marquee-block" {% if copy %}data-an-copy="{{ block.id }}"{% else %}{% render 'announce-block', block: block %}{% endif %}{% if own_font %} data-own-font data-own-weight{% endif %} style="--svg-size-mobile: {{ bs.svg_icon_size_mobile }}px;--svg-size-desktop: {{ bs.svg_icon_size_desktop }}px;--svg-icon-offset-y: {{ bs.svg_icon_vertical_offset | default: 0 }}px;--svg-color: {% render 'scheme-color', color: bs.svg_icon_color, fallback: 'currentColor' %};{% if bs.enable_custom_style %}--scrolling-text-color: {% render 'scheme-color', color: bs.text_color, fallback: 'var(--color-text)' %};{% endif %}{% if own_font %}--an-b-f: {% render 'announce-font', font: bs.font, on: true, fallback: 'inherit' %};--scrolling-font-weight: {{ bs.font.weight | default: 400 }};{% endif %}">
    <div class="scrolling__marquee-item" data-an-text{% if bs.text == blank %} hidden{% endif %}>{{ bs.text }}</div>
    <div class="scrolling__marquee-item scrolling__marquee-item--icon" data-an-icon{% unless has_svg %} hidden{% endunless %}><div class="scrolling__marquee-svg-wrap" data-colorize="{% if bs.enable_svg_icon_color %}true{% else %}false{% endif %}">{{ bs.svg_icon }}</div></div>
    <div class="scrolling__marquee-item" data-an-pic{% if has_svg or bs.image == blank %} hidden{% endif %}>
      {%- if bs.image != blank -%}<img class="scrolling__marquee-img" src="{{ bs.image | image_url: width: 120 }}" alt="{% if copy %}{% else %}{{ bs.image.alt | escape }}{% endif %}" width="60" height="{{ bs.image.height | times: 60.0 | divided_by: bs.image.width | round | default: 60 }}" loading="lazy" decoding="async">{%- endif -%}
    </div>
  </div>
{%- endfor -%}
</template>