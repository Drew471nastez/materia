<template compat="shopify">
{%- comment -%}
  Materia Themes. The header and question list of FAQ 1, FAQ 2, FAQ 3, FAQ 4
  and FAQ 6 (sections faq1, faq5, faq, faq-pro, faq-side-image). p is the
  section's class prefix (faq1, faq5, faq6, faq7, fsi). own_hw: the legacy
  heading has its own weight (default: Custom heading weight).

  Header: snippets/faq-live-header. Questions: every faq_item block. live-faq.js opens and closes them (one at
  a time unless the section allows several), opens the one picked in the
  builder and applies every setting live.

  Theme settings > Typography "Use in every section" sets the theme's type
  with priority. An element whose own font, weight or size switch is on
  carries data-own-font / data-own-weight / data-own-size, and a button with
  its own shape data-own-shape, here in the first paint and from live-faq.js
  on live edits.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign open_icon = st.open_icon | default: 'plus'
  assign faq_items = section.blocks | where: 'type', 'faq_item'
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign first_open = st.first_item_open | default: st.open_first
  assign fb_question = 'accessibility.question_goes_here' | t
-%}
{%- render 'faq-live-header', section: section, p: p, own_hw: own_hw -%}
      <template data-faq-icons>
        <svg data-icon="chevron" class="{{ p }}__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg data-icon="arrow" class="{{ p }}__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
        <span data-icon="plus" class="{{ p }}__icon-plus"><span class="v"></span><span class="h"></span></span>
      </template>
{%- if faq_items.size > 0 -%}
      <div class="{{ p }}__list" data-{{ p }}-list data-faq-list data-multiple="{% if st.allow_multiple_open %}true{% else %}false{% endif %}">
        {%- for block in faq_items -%}
          {%- liquid
            assign bs = block.settings
            assign open_first = false
            if first_open and forloop.first
              assign open_first = true
            endif
          -%}
          <div class="{{ p }}__item" {% if open_first %}open{% endif %} data-{{ p }}-item data-faq-item id="block-{{ block.id }}" data-faq-block="{{ block.id }}" data-faq-type="faq_item" data-faq-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="{{ p }}__q"
              aria-expanded="{% if open_first %}true{% else %}false{% endif %}"
              aria-controls="{{ p }}-a-{{ sid }}-{{ forloop.index }}"
              data-{{ p }}-trigger data-faq-trigger
            >
              <span data-faq-question>{{ bs.question | default: fb_question }}</span>
              <span class="{{ p }}__icon" aria-hidden="true" data-faq-icon="{{ open_icon }}">
                {%- if open_icon == 'chevron' -%}
                  <svg class="{{ p }}__icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- elsif open_icon == 'arrow' -%}
                  <svg class="{{ p }}__icon-chevron" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke-linecap="round"/></svg>
                {%- else -%}
                  <span class="{{ p }}__icon-plus"><span class="v"></span><span class="h"></span></span>
                {%- endif -%}
              </span>
            </button>
            <div class="{{ p }}__a-wrap" id="{{ p }}-a-{{ sid }}-{{ forloop.index }}" data-faq-panel>
              <div class="{{ p }}__a-inner">
                <div class="{{ p }}__a" data-faq-answer{% if sec_font %} data-own-font{% endif %}>{{ bs.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
{%- endif -%}
{%- if st.structured_data -%}{% render 'faq-live-jsonld', items: faq_items %}{%- endif -%}
</template>
