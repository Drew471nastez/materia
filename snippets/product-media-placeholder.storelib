<template compat="shopify">
{%- comment -%}
  Materia Themes. The media column of Main product and Featured product when
  there is no picture to show (no product picked, or a product without
  pictures). Drawn at the gallery's own shape so the page does not move when
  pictures arrive.
{%- endcomment -%}
{%- liquid
  assign pmp_ratio = '3/4'
  case settings.product_image_ratio
    when 'square'
      assign pmp_ratio = '1/1'
    when 'landscape'
      assign pmp_ratio = '4/3'
    when 'portrait'
      assign pmp_ratio = '3/4'
    when 'custom'
      if settings.product_custom_ratio != blank
        assign pmp_ratio = settings.product_custom_ratio | replace: ':', '/'
      endif
  endcase
  if section_st.media_square or section_st.enable_image_square
    assign pmp_ratio = '1/1'
  endif
-%}
<div class="mt-media-placeholder rounded-5" style="aspect-ratio: {{ pmp_ratio }};" data-mt-media-placeholder>
  {{ 'product-1' | placeholder_svg_tag: 'mt-media-placeholder__svg' }}
  {%- if request.design_mode -%}
    <p class="mt-media-placeholder__note">{% if product == blank %}Pick a product to show its pictures here.{% else %}This product has no pictures yet. Add them to the product to show them here.{% endif %}</p>
  {%- endif -%}
</div>
</template>
