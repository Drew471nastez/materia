<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
<div
  class="swiper-actions flex block-md content-center gap-10 mb-30 mb-md-0 {{ class }} {{ class_prodcut_mobile }}"
>
  <div
    class="swiper-arrow swiper-arrow--prev {{ class }} transition swiper-button-prev bg-white btn-hover inline-flex content-center border {% if settings.rounded_corner > 1 %} rounded-50 overflow-hidden{% endif %}"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
      <use href="#icon-slider-prev" />
    </svg>
  </div>
  <div
    class="swiper-arrow swiper-arrow--next {{ class }} transition swiper-button-next bg-white btn-hover inline-flex content-center border {% if settings.rounded_corner > 1 %} rounded-50 overflow-hidden{% endif %}"
  >
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
      <use href="#icon-slider-next" />
    </svg>
  </div>
</div>

</template>