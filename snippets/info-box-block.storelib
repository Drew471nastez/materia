<template compat="shopify">
{%- comment -%}
  Materia Themes — Info Box Block (snippet)
  In-product Info Box: top message row(s) + smooth collapsible(s) +
  payment badges. Used by the "info_box" block in main product.
{%- endcomment -%}

{%- assign ib = block.settings -%}
{%- comment -%}
  Resolve text colour customizers. The schema default is now
  `rgba(0,0,0,0)` — when transparent (alpha 0), fall back to the
  active colour scheme's text / heading variables so the box reads
  cleanly on every scheme. Picking any non-transparent colour
  overrides the scheme inheritance.
{%- endcomment -%}
{%- assign ib_text_color = ib.text_color -%}
{%- if ib.text_color == blank or ib.text_color.alpha == 0 -%}
  {%- assign ib_text_color = 'var(--color-heading, var(--color-text, #111111))' -%}
{%- endif -%}
{%- assign ib_muted_color = ib.muted_color -%}
{%- if ib.muted_color == blank or ib.muted_color.alpha == 0 -%}
  {%- assign ib_muted_color = 'var(--color-text, #6B7280)' -%}
{%- endif -%}

<div id="IB-{{ block.id }}" class="ib" {{ block.shopify_attributes }}
     style="
       --ib-bg: {{ ib.box_bg | default: 'rgba(0,0,0,0)' }};
       --ib-border: {{ ib.border_color | default: '#E5E7EB' }};
       --ib-text: {{ ib_text_color }};
       --ib-muted: {{ ib_muted_color }};
       --ib-radius: {{ ib.box_radius | default: 12 }}px;
       --ib-pad-y: {{ ib.row_pad_y | default: 16 }}px;
       --ib-pad-x: {{ ib.row_pad_x | default: 18 }}px;
       margin-top: {{ ib.margin_top | default: 16 }}px;
       margin-bottom: {{ ib.margin_bottom | default: 16 }}px;
     ">
  <div class="ib__inner">
    {%- if ib.top_text != blank -%}
      <div class="ib__row ib__row--top">
        <div class="ib__top">
          {%- if ib.top_show_icon -%}
            <span class="ib__top-icon" style="color: {{ ib.top_icon_color | default: '#111111' }};">
              {%- case ib.top_icon -%}
                {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96c1 1.57 2 4.55 2 7.04A6.78 6.78 0 0 1 14 17"/><path d="M2 22 19 5"/></svg>
                {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/></svg>
                {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          <div class="ib__top-text">{{ ib.top_text }}</div>
        </div>
      </div>
    {%- endif -%}

    {%- if ib.collapse_title != blank -%}
      <div class="ib__row ib__row--collapse ib__coll" data-ib-coll {% if ib.collapse_open %}data-open="1"{% endif %}>
        <button type="button" class="ib__summary" data-ib-toggle aria-expanded="{% if ib.collapse_open %}true{% else %}false{% endif %}">
          <span>{{ ib.collapse_title }}</span>
          <span class="ib__chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
        </button>
        <div class="ib__answer-wrap"><div class="ib__answer-inner"><div class="ib__answer">{{ ib.collapse_body }}</div></div></div>
      </div>
    {%- endif -%}

    {%- if ib.collapse2_title != blank -%}
      <div class="ib__row ib__row--collapse ib__coll" data-ib-coll {% if ib.collapse2_open %}data-open="1"{% endif %}>
        <button type="button" class="ib__summary" data-ib-toggle aria-expanded="{% if ib.collapse2_open %}true{% else %}false{% endif %}">
          <span>{{ ib.collapse2_title }}</span>
          <span class="ib__chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
        </button>
        <div class="ib__answer-wrap"><div class="ib__answer-inner"><div class="ib__answer">{{ ib.collapse2_body }}</div></div></div>
      </div>
    {%- endif -%}

    {%- if ib.show_badges -%}
      <div class="ib__row ib__row--badges">
        <div class="ib__badges" style="--ib-bh: {{ ib.badge_height | default: 24 }}px;">
          {%- comment -%}
            Render each badge as a direct inline SVG, gated by its own
            checkbox. Avoids both `payment_type_svg_tag` (which silently
            returns nothing for payment types the merchant hasn't enabled
            in Shopify Payments) and the `concat: 'string'` pattern (which
            doesn't work in Shopify Liquid — `concat` requires an array).
            Each <svg> carries explicit width/height attributes so it
            renders even before CSS loads or when intrinsic-size logic
            misbehaves.
          {%- endcomment -%}
          {%- if ib.badge_visa -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa"><title>Visa</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#142688" d="M28.3 10.1H28c-.4 1-.7 1.5-1 3h1.9c-.3-1.5-.3-2.2-.6-3zm2.9 5.9h-1.7c-.1 0-.1 0-.2-.1l-.2-.9-.1-.2h-2.4c-.1 0-.2 0-.2.2l-.3.9c0 .1-.1.1-.1.1h-2.1l.2-.5L27 8.7c0-.5.3-.7.8-.7h1.5c.1 0 .2 0 .2.2l1.4 6.5c.1.4.2.7.2 1.1.1.1.1.1.1.2zm-13.4-.3l.4-1.8c.1 0 .2.1.2.1.7.3 1.4.5 2.1.4.2 0 .5-.1.7-.2.5-.2.5-.7.1-1.1-.2-.2-.5-.3-.8-.5-.4-.2-.8-.4-1.1-.7-1.2-1-.8-2.4-.1-3.1.6-.4.9-.8 1.7-.8 1.2 0 2.5 0 3.1.2h.1c-.1.6-.2 1.1-.4 1.7-.5-.2-1-.4-1.5-.4-.3 0-.6 0-.9.1-.2 0-.3.1-.4.2-.2.2-.2.5 0 .7l.5.4c.4.2.8.4 1.1.6.5.3 1 .8 1.1 1.4.2.9-.1 1.7-.9 2.3-.5.4-.7.6-1.4.6-1.4 0-2.5.1-3.4-.2-.1.2-.1.2-.2.1zm-3.5.3c.1-.7.1-.7.2-1 .5-2.2 1-4.5 1.4-6.7.1-.2.1-.3.3-.3H18c-.2 1.2-.4 2.1-.7 3.2-.3 1.5-.6 3-1 4.5 0 .2-.1.2-.3.2M5 8.2c0-.1.2-.2.3-.2h3.4c.5 0 .9.3 1 .8l.9 4.4c0 .1 0 .1.1.2 0-.1.1-.1.1-.1l2.1-5.1c-.1-.1 0-.2.1-.2h2.1c0 .1 0 .1-.1.2l-3.1 7.3c-.1.2-.1.3-.2.4-.1.1-.3 0-.5 0H9.7c-.1 0-.2 0-.2-.2L7.9 9.5c-.2-.2-.5-.5-.9-.6-.6-.3-1.7-.5-1.9-.5L5 8.2z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_master -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard"><title>Mastercard</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><circle fill="#EB001B" cx="15" cy="12" r="7"/><circle fill="#F79E1B" cx="23" cy="12" r="7"/><path fill="#FF5F00" d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.3-3 3.4-3 5.7s1.2 4.5 3 5.7c1.8-1.2 3-3.3 3-5.7z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_amex -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="American Express"><title>American Express</title><path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z" opacity=".07"/><path fill="#006FCF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32Z"/><path fill="#FFF" d="M22.012 19.936v-8.421L37 11.528v2.326l-1.732 1.852L37 17.573v2.375h-2.766l-1.47-1.622-1.46 1.628-9.292-.02Z"/><path fill="#006FCF" d="M23.013 19.012v-6.57h5.572v1.513h-3.768v1.028h3.678v1.488h-3.678v1.01h3.768v1.531h-5.572Z"/><path fill="#006FCF" d="m28.557 19.012 3.083-3.289-3.083-3.282h2.386l1.884 2.083 1.89-2.082H37v.051l-3.017 3.23L37 18.92v.093h-2.307l-1.917-2.103-1.898 2.104h-2.321Z"/><path fill="#FFF" d="M22.71 4.04h3.614l1.269 2.881V4.04h4.46l.77 2.159.771-2.159H37v8.421H19l3.71-8.421Z"/><path fill="#006FCF" d="m23.395 4.955-2.916 6.566h2l.55-1.315h2.98l.55 1.315h2.05l-2.904-6.566h-2.31Zm.25 3.777.875-2.09.873 2.09h-1.748Z"/><path fill="#006FCF" d="M28.581 11.52V4.953l2.811.01L32.84 9l1.456-4.046H37v6.565l-1.74.016v-4.51l-1.644 4.494h-1.59L30.35 7.01v4.51h-1.768Z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_apple_pay -%}
            <span class="ib__badge"><svg viewBox="0 0 165.52 105.97" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Apple Pay"><title>Apple Pay</title><path fill="#fff" stroke="#D3D3D3" stroke-width="1.5" d="M150.7.75H14.83c-.56 0-1.13 0-1.7 0-.48 0-.95.01-1.43.02-1.04.03-2.09.09-3.11.27-1.04.19-2.01.5-2.96.97-1.86.95-3.4 2.49-4.35 4.35a10.4 10.4 0 0 0-.97 2.96c-.18 1.03-.24 2.07-.27 3.11-.01.48-.02.96-.02 1.43-.001.57-.001 1.13-.001 1.7v76.32c0 .57 0 1.13.002 1.7.003.48.009.95.022 1.43.028 1.04.09 2.08.275 3.11.187 1.04.493 2.01.974 2.96.482.94 1.094 1.79 1.83 2.52.736.74 1.59 1.35 2.52 1.83.947.48 1.917.79 2.96.98 1.025.18 2.073.24 3.112.27.477.01.953.02 1.43.02.565 0 1.132 0 1.698 0h135.875c.566 0 1.132 0 1.697 0 .476-.01.952-.01 1.431-.02 1.037-.03 2.085-.09 3.113-.27 1.04-.19 2.01-.5 2.96-.98 1.86-.95 3.4-2.49 4.35-4.35.48-.95.79-1.92.97-2.96.19-1.03.25-2.07.27-3.11.01-.48.02-.96.022-1.43.004-.57.004-1.13.004-1.7V14.82c0-.57 0-1.13-.004-1.7-.003-.48-.01-.96-.022-1.43-.028-1.04-.088-2.08-.274-3.11-.18-1.04-.49-2.01-.97-2.96-.95-1.86-2.49-3.4-4.35-4.35-.95-.48-1.92-.79-2.96-.97-1.03-.18-2.08-.25-3.11-.27-.48-.01-.95-.02-1.43-.02C151.83.75 151.27.75 150.7.75Z"/><path fill="#000" d="M43.51 35.77c1.4-1.76 2.36-4.11 2.1-6.52-2.05.1-4.56 1.36-6.01 3.11-1.3 1.5-2.46 3.96-2.16 6.27 2.31.2 4.61-1.15 6.06-2.86Zm2.08 3.31c-3.35-.2-6.2 1.9-7.8 1.9-1.6 0-4.05-1.8-6.7-1.75-3.45.05-6.65 2-8.4 5.1-3.6 6.2-.95 15.4 2.55 20.45 1.7 2.5 3.75 5.25 6.45 5.15 2.55-.1 3.55-1.65 6.65-1.65 3.1 0 4 1.65 6.7 1.6 2.8-.05 4.55-2.5 6.25-5 1.95-2.85 2.75-5.6 2.8-5.75-.05-.05-5.4-2.1-5.45-8.25-.05-5.15 4.2-7.6 4.4-7.75-2.4-3.55-6.15-3.95-7.45-4.05ZM78.97 32.11c7.28 0 12.35 5.02 12.35 12.32 0 7.33-5.17 12.37-12.53 12.37h-8.06v12.82h-5.82V32.11h14.06Zm-8.24 19.81h6.68c5.07 0 7.95-2.73 7.95-7.46 0-4.73-2.88-7.43-7.93-7.43h-6.7v14.89ZM92.76 61.85c0-4.81 3.67-7.56 10.42-7.98l7.25-.44v-2.08c0-3.04-2-4.7-5.56-4.7-2.94 0-5.07 1.51-5.51 3.82h-5.25c.16-4.86 4.73-8.4 10.92-8.4 6.65 0 11 3.48 11 8.89v18.66h-5.38v-4.5h-.13c-1.53 2.94-4.91 4.78-8.58 4.78-5.41 0-9.18-3.22-9.18-8.06Zm17.68-2.42v-2.11l-6.47.42c-3.64.23-5.54 1.59-5.54 3.95 0 2.29 1.97 3.77 5.07 3.77 3.95 0 6.94-2.52 6.94-6.03ZM120.97 79.65v-4.5c.36.05 1.25.1 1.72.1 2.57 0 4.03-1.09 4.91-3.9l.52-1.66-9.85-27.29h6.08l6.86 22.15h.13l6.86-22.15h5.93l-10.22 28.67c-2.34 6.58-5.02 8.74-10.68 8.74-.44 0-1.87-.05-2.26-.16Z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_google_pay -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Google Pay"><title>Google Pay</title><path opacity=".07" fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#FFF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path d="M18.093 11.976v3.2h-1.018v-7.9h2.691a2.447 2.447 0 0 1 1.747.692 2.28 2.28 0 0 1 .11 3.224l-.11.116c-.47.447-1.098.69-1.747.674l-1.673-.006zm0-3.732v2.788h1.698c.377.012.741-.135 1.005-.404a1.391 1.391 0 0 0-1.005-2.354l-1.698-.03zm6.484 1.348c.65-.03 1.286.188 1.778.613.445.43.682 1.03.65 1.649v3.334h-.969v-.766h-.049a1.93 1.93 0 0 1-1.673.931 2.17 2.17 0 0 1-1.496-.533 1.667 1.667 0 0 1-.613-1.324 1.606 1.606 0 0 1 .613-1.336 2.746 2.746 0 0 1 1.698-.515c.517-.02 1.03.093 1.49.331v-.208a1.134 1.134 0 0 0-.417-.901 1.416 1.416 0 0 0-.98-.368 1.545 1.545 0 0 0-1.319.717l-.895-.564a2.488 2.488 0 0 1 2.182-1.06zM23.29 13.52a.79.79 0 0 0 .337.662c.223.176.5.269.785.263.429-.001.84-.17 1.146-.472.305-.286.478-.685.478-1.103a2.047 2.047 0 0 0-1.324-.374 1.716 1.716 0 0 0-1.03.294.883.883 0 0 0-.392.73zm9.286-3.75l-3.39 7.79h-1.048l1.281-2.728-2.224-5.062h1.103l1.612 3.885 1.569-3.885h1.097z"/><path fill="#4285F4" d="M13.986 11.284c0-.308-.024-.616-.073-.92h-4.29v1.747h2.451a2.096 2.096 0 0 1-.9 1.373v1.134h1.464a4.433 4.433 0 0 0 1.348-3.334z"/><path fill="#34A853" d="M9.629 15.721a4.352 4.352 0 0 0 3.01-1.097l-1.466-1.14a2.752 2.752 0 0 1-4.094-1.44H5.577v1.17a4.53 4.53 0 0 0 4.052 2.507z"/><path fill="#FBBC04" d="M7.079 12.05a2.709 2.709 0 0 1 0-1.735v-1.17H5.577a4.505 4.505 0 0 0 0 4.075l1.502-1.17z"/><path fill="#EA4335" d="M9.629 8.44a2.452 2.452 0 0 1 1.74.68l1.3-1.293a4.37 4.37 0 0 0-3.065-1.183 4.53 4.53 0 0 0-4.027 2.5l1.502 1.171a2.715 2.715 0 0 1 2.55-1.875z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_paypal -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PayPal"><title>PayPal</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#003087" d="M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z"/><path fill="#3086C8" d="M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.1-3.2.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.5-.8z"/><path fill="#012169" d="M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z"/></svg></span>
          {%- endif -%}
          {%- if ib.badge_shop_pay -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Shop Pay"><title>Shop Pay</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><rect x="1" y="1" width="36" height="22" rx="2" fill="#5A31F4"/><text x="19" y="16" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="800" font-size="9" letter-spacing="-0.3" fill="#fff" text-anchor="middle">shop Pay</text></svg></span>
          {%- endif -%}
          {%- if ib.badge_klarna -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Klarna"><title>Klarna</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><rect x="1" y="1" width="36" height="22" rx="2" fill="#FFB3C7"/><text x="19" y="16" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="800" font-size="9" letter-spacing="-0.2" fill="#0A0A0A" text-anchor="middle">Klarna.</text></svg></span>
          {%- endif -%}
          {%- if ib.badge_discover -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Discover"><title>Discover</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><path fill="#F47216" d="M19 19h17c.6 0 1-.4 1-1V11c-3.5 4-12.7 7-18 8z"/><circle cx="20.5" cy="11.3" r="2.2" fill="#F47216"/><text x="11" y="14.5" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="700" font-size="6" fill="#000">DISCOVER</text></svg></span>
          {%- endif -%}
          {%- if ib.badge_amazon -%}
            <span class="ib__badge"><svg width="38" height="24" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Amazon"><title>Amazon</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z"/><path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><text x="19" y="14" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" font-weight="700" font-size="7" fill="#221F1F" text-anchor="middle">amazon</text><path fill="#F90" d="M25.95 17c-2.04 1.5-5 2.3-7.55 2.3-3.57 0-6.79-1.32-9.22-3.52-.19-.17-.02-.41.21-.28 2.62 1.52 5.86 2.44 9.21 2.44 2.27 0 4.76-.47 7.05-1.44.35-.15.64.22.3.5z"/></svg></span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #IB-{{ block.id }} { display: block; font-family: var(--body-font, inherit); }
  #IB-{{ block.id }} .ib__inner { background: var(--ib-bg); color: var(--ib-text); border: 1px solid var(--ib-border); border-radius: var(--ib-radius); overflow: hidden; }
  #IB-{{ block.id }} .ib__row { padding: var(--ib-pad-y) var(--ib-pad-x); border-top: 1px solid var(--ib-border); }
  #IB-{{ block.id }} .ib__row:first-child { border-top: 0; }
  #IB-{{ block.id }} .ib__top { display: flex; align-items: center; gap: 10px; }
  #IB-{{ block.id }} .ib__top-icon { flex: 0 0 auto; display: inline-flex; width: 20px; height: 20px; }
  #IB-{{ block.id }} .ib__top-icon svg { width: 100%; height: 100%; }
  #IB-{{ block.id }} .ib__top-text { font-size: 15px; line-height: 1.4; }
  #IB-{{ block.id }} .ib__top-text p { margin: 0; }
  #IB-{{ block.id }} .ib__top-text strong { font-weight: 700; }
  #IB-{{ block.id }} .ib__coll { padding: 0; }
  #IB-{{ block.id }} .ib__summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 24px;
    align-items: center;
    gap: 12px;
    padding: var(--ib-pad-y) var(--ib-pad-x);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ib-text);
    background: transparent;
    border: 0;
    width: 100%;
    text-align: left;
    font-family: inherit;
  }
  #IB-{{ block.id }} .ib__chevron { width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; transition: transform .35s cubic-bezier(.4,0,.2,1); }
  #IB-{{ block.id }} .ib__chevron svg { width: 18px; height: 18px; }
  #IB-{{ block.id }} .ib__coll[data-open="1"] .ib__chevron { transform: rotate(180deg); }
  #IB-{{ block.id }} .ib__answer-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .42s cubic-bezier(.4,0,.2,1); }
  #IB-{{ block.id }} .ib__coll[data-open="1"] .ib__answer-wrap { grid-template-rows: 1fr; }
  #IB-{{ block.id }} .ib__answer-inner { overflow: hidden; }
  #IB-{{ block.id }} .ib__answer { padding: 0 var(--ib-pad-x) var(--ib-pad-y); color: var(--ib-muted); font-size: 14px; line-height: 1.6; }
  #IB-{{ block.id }} .ib__answer p { margin: 0; }
  #IB-{{ block.id }} .ib__answer p + p { margin-top: 10px; }
  #IB-{{ block.id }} .ib__badges { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  #IB-{{ block.id }} .ib__badge { height: var(--ib-bh); width: auto; display: inline-flex; align-items: center; line-height: 0; }
  #IB-{{ block.id }} .ib__badge svg,
  #IB-{{ block.id }} svg.ib__badge { height: var(--ib-bh); width: auto; display: block; }
  @media (prefers-reduced-motion: reduce) { #IB-{{ block.id }} .ib__answer-wrap, #IB-{{ block.id }} .ib__chevron { transition: none !important; } }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  var root = document.getElementById('IB-{{ block.id }}');
  if (!root || root.__ibInit) return;
  root.__ibInit = true;
  root.querySelectorAll('[data-ib-toggle]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var coll = btn.closest('[data-ib-coll]');
      if (!coll) return;
      var isOpen = coll.dataset.open === '1';
      coll.dataset.open = isOpen ? '' : '1';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  });
})();
{% comment %}{% endcomment %}</script>

</template>