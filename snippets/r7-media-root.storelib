<template compat="shopify">
{%- comment -%}
  Materia Themes. The root attributes (part: 'attrs') and the shared CSS
  variables (part: 'vars') of the round 7 Image and video sections. The same
  values are worked out by live-r7-media.js in the builder. The settings JSON
  is printed in the builder only: a visitor's page does not carry it.
{%- endcomment -%}
{%- assign st = section.settings -%}
{%- if part == 'attrs' -%}
data-section-id="{{ section.id }}" data-r7m-section="{{ section.id }}"{% if request.design_mode %} data-r7m-settings="{{ st | json | escape }}"{% endif %} data-width="{{ st.section_width | default: 'container' }}" data-align="{{ st.content_align | default: 'left' }}" data-align-m="{{ st.content_align_mobile | default: 'left' }}"{% if st.enable_custom_fonts %} data-own-font{% endif %}
{%- else -%}
--r7-bg: {% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--r7-text: {% if st.enable_custom_style %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--r7-hf: {% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--r7-bf: {% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--r7-pt-m: {{ st.padding_top_mobile | default: 0 }}px;--r7-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;--r7-pt-d: {{ st.padding_top_desktop | default: 0 }}px;--r7-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px;--r7-px-m: {{ st.side_padding_mobile | default: 0 }}px;--r7-px-d: {{ st.side_padding_desktop | default: 0 }}px;--r7-cgap: {{ st.content_gap | default: 0 }}px;
{%- endif -%}
</template>
