<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared styles of the before/after comparison slider in
  Before and After Slider and Before/After Slider 2. The section root sets
  the --bam-* variables; media-live-before-after.js moves --bam-pos.
  Both images fill the same box and the before layer is clipped with
  clip-path, so the two pictures stay aligned at every position.
  {% render 'media-ba-compare-style', sid: section.id %}
{%- endcomment -%}
<style>
  #shopify-section-{{ sid }} .bam-compare {
    position: relative;
    width: 100%;
    aspect-ratio: var(--bam-ratio, 16 / 9);
    border-radius: var(--bam-radius, 0px);
    overflow: hidden;
    background: var(--bam-empty-after, color-mix(in srgb, var(--color-heading) 12%, var(--color-background)));
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    cursor: ew-resize;
    -webkit-tap-highlight-color: transparent;
  }
  #shopify-section-{{ sid }} .bam-compare__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  #shopify-section-{{ sid }} .bam-compare__before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bam-empty-before, color-mix(in srgb, var(--color-heading) 24%, var(--color-background)));
    clip-path: inset(0 calc(100% - var(--bam-pos, 50%)) 0 0);
  }
  #shopify-section-{{ sid }} .bam-compare__label { position: absolute; z-index: 1; pointer-events: none; margin: 0; }
  #shopify-section-{{ sid }} .bam-compare__label[hidden] { display: none; }
  #shopify-section-{{ sid }} .bam-compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--bam-pos, 50%);
    width: 44px;
    margin-left: -22px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
    cursor: ew-resize;
  }
  #shopify-section-{{ sid }} .bam-compare__bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--bam-line-w, 3px);
    transform: translateX(-50%);
    background: var(--bam-line-color, var(--color-background));
    opacity: var(--bam-line-opacity, 1);
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .bam-compare__knob {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--bam-knob-size, 48px);
    height: var(--bam-knob-size, 48px);
    border-radius: 50%;
    box-sizing: border-box;
    background: var(--bam-knob-bg, var(--color-background));
    color: var(--bam-icon-color, var(--color-heading));
    border: var(--bam-knob-border-w, 0px) solid var(--bam-knob-border-color, transparent);
    opacity: var(--bam-knob-opacity, 1);
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, .35);
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .bam-compare__knob svg { width: var(--bam-icon-size, 55%); height: var(--bam-icon-size, 55%); display: block; }
  #shopify-section-{{ sid }} .bam-compare__handle:focus-visible .bam-compare__knob { box-shadow: 0 0 0 3px var(--color-background), 0 0 0 5px var(--color-heading); }
  #shopify-section-{{ sid }} .bam-compare[data-circle="false"] .bam-compare__knob { display: none; }
  #shopify-section-{{ sid }} .bam-compare[data-circle="false"] .bam-compare__handle:focus-visible { outline: 2px solid var(--color-heading); outline-offset: -2px; }
  #shopify-section-{{ sid }} .bam-compare[data-bar="false"] .bam-compare__bar { display: none; }
  #shopify-section-{{ sid }} .bam-compare.is-dragging, #shopify-section-{{ sid }} .bam-compare.is-dragging .bam-compare__handle { cursor: grabbing; }
{% comment %}{% endcomment %}</style>
</template>
