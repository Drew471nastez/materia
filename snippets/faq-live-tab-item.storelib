<template compat="shopify">
{%- comment -%}
  Materia Themes. One question of FAQ Tabs (sections/faq-tabs): item is the
  faq_item block, sid the section id, is_open opens it on load, sec_font
  marks the answer for the section's custom font.
{%- endcomment -%}
      <div class="fqt__item" id="block-{{ item.id }}" data-faq-item data-faq-block="{{ item.id }}" data-faq-type="faq_item" data-faq-settings="{{ item.settings | json | escape }}" data-fqt-tab="{{ item.settings.tab }}"{% if is_open %} open{% endif %} {{ item.shopify_attributes }}>
        <button type="button" class="fqt__summary" data-faq-trigger aria-expanded="{% if is_open %}true{% else %}false{% endif %}" aria-controls="fqt-a-{{ sid }}-{{ item.id }}">
          <span data-faq-question>{{ item.settings.question }}</span>
          <span class="fqt__plus" aria-hidden="true"></span>
        </button>
        <div class="fqt__answer-wrap" id="fqt-a-{{ sid }}-{{ item.id }}" data-faq-panel><div class="fqt__answer-inner"><div class="fqt__answer" data-faq-answer{% if sec_font %} data-own-font{% endif %}>{{ item.settings.answer }}</div></div></div>
      </div>
</template>
