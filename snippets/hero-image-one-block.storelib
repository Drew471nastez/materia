<template compat="shopify">
{%- assign b = block.settings -%}
{%- case block.type -%}
{%- when 'heading' -%}<h1 class="hi1__heading hi1__type" style="font-family:var(--hi1-font,var(--hi1-heading-font,var(--heading-font)))!important;font-size:var(--hi1-size,var(--h1-size,48px))!important;font-weight:var(--hi1-weight,var(--heading-weight,600))!important;letter-spacing:var(--hi1-letter,var(--heading-letter-spacing,normal))!important;text-transform:var(--hi1-case,var(--heading-text-transform,none))!important;line-height:var(--hi1-line,var(--heading-line-height,1.2))!important;color:var(--hi1-ink,var(--color-heading));">{{ b.text }}</h1>
{%- when 'eyebrow' -%}<p class="hi1__eyebrow hi1__type">{{ b.text | escape }}</p>
{%- when 'subheading' -%}<div class="hi1__subheading hi1__type">{{ b.text }}</div>
{%- when 'badge' -%}<span class="hi1__badge hi1__type"><span class="hi1__badge-icon" aria-hidden="true">{{ b.icon | escape }}</span><span class="hi1__badge-text">{{ b.text | escape }}</span></span>
{%- when 'primary_button', 'secondary_button' -%}
  {%- assign role = 'primary' -%}{%- if block.type == 'secondary_button' -%}{%- assign role = 'secondary' -%}{%- endif -%}
  {%- if b.link != blank and b.link != '#' -%}<a class="hi1__btn" data-theme-button="{{ role }}" data-sl-button href="{{ b.link | url | escape }}">{{ b.label | escape }}</a>{%- else -%}<button type="button" class="hi1__btn" data-theme-button="{{ role }}" data-sl-button>{{ b.label | escape }}</button>{%- endif -%}
{%- when 'benefits_stack' -%}
<div class="hi1__benefits">{%- for n in (1..6) -%}{%- assign tk = 'text_' | append: n -%}{%- assign ik = 'icon_' | append: n -%}<div class="hi1__benefit" data-benefit="{{ n }}"{% if b[tk] == blank %} hidden{% endif %}><span class="hi1__benefit-icon" aria-hidden="true">{% render 'guarantee-icon', icon: b[ik], stroke: 1.8 %}</span><span class="hi1__benefit-text hi1__type">{{ b[tk] | escape }}</span></div>{%- endfor -%}</div>
{%- when 'happy_customers' -%}
<div class="hi1__customers"><div class="hi1__avatars"{% if b.show_avatars == false %} hidden{% endif %}>{%- for n in (1..6) -%}{%- assign ak = 'avatar_' | append: n -%}<span class="hi1__avatar" data-avatar="{{ n }}"{% if b[ak] == blank or n > b.avatar_count %} hidden{% endif %}>{%- if b[ak] != blank -%}<img src="{% render 'offer-image-url', image: b[ak], escaped: true %}" alt="" width="80" height="80" loading="lazy" decoding="async">{%- endif -%}</span>{%- endfor -%}</div><div class="hi1__customer-copy"><span class="hi1__customer-heading hi1__type">{{ b.heading | escape }}</span><div class="hi1__customer-rating"><span class="hi1__customer-stars"{% if b.show_stars == false %} hidden{% endif %}>{% render 'hero-image-one-stars', filled: b.filled_stars, total: b.total_stars %}</span><span class="hi1__rating-text hi1__type"{% unless b.show_rating_text %} hidden{% endunless %}>{{ b.rating_text | escape }}</span></div></div></div>
{%- when 'simple_rating' -%}<div class="hi1__rating">{% render 'hero-image-one-stars', filled: b.filled_stars, total: b.total_stars %}<span class="hi1__rating-text hi1__type">{{ b.text | escape }}</span></div>
{%- when 'lod_rating_badge' -%}
<div class="hi1__rating-badge">{%- if b.enable_link and b.link_url != blank -%}<a class="hi1__rating-link" href="{{ b.link_url | url | escape }}">{%- else -%}<div class="hi1__rating-link">{%- endif -%}{% render 'hero-image-one-stars', filled: b.rating, total: 5, tiles: true %}<span class="hi1__rating-text hi1__type">{{ b.label_text }}</span>{% if b.enable_link and b.link_url != blank %}</a>{% else %}</div>{% endif %}</div>
{%- endcase -%}
</template>
