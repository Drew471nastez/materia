<template compat="shopify">
{%- comment -%}
  Materia Themes. The Heading and Text blocks of the round 7 Image and video
  sections. Colours follow the colour scheme until the block's own custom
  styling is on; the block's settings JSON is printed in the builder only.
  {% render 'r7-media-head', block: block %}
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign own = bs.enable_custom_style -%}
{%- capture r7_block -%}data-block-id="{{ block.id }}" data-r7m-block="{{ block.id }}" data-r7m-type="{{ block.type }}"{% if request.design_mode %} data-r7m-settings="{{ bs | json | escape }}"{% endif %} {{ block.shopify_attributes }}{%- endcapture -%}
{%- case block.type -%}
  {%- when 'heading' -%}
    <h2 class="r7m__heading" {{ r7_block }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--b-fs-m: {{ bs.size_mobile | default: 28 }}px;--b-fs-d: {{ bs.size_desktop | default: 40 }}px;">{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    <div class="r7m__sub" {{ r7_block }}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--r7-text)' %}{% else %}var(--r7-text){% endif %};--b-fs-m: {{ bs.size_mobile | default: 15 }}px;--b-fs-d: {{ bs.size_desktop | default: 17 }}px;">{{ bs.text }}</div>
{%- endcase -%}
</template>
