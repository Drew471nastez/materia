<template compat="shopify">
{%- comment -%}Editor-only empty-state cover. Uses the section's real layout and theme tokens, never storefront placeholder copy.{%- endcomment -%}
<div class="hero-preview-cover" role="img" aria-label="{{ name | escape }} layout preview" style="width:100%;color:var(--color-heading);font-family:var(--heading-font);"><div style="display:flex;gap:4px;margin-bottom:18px;" aria-hidden="true">{% for n in (1..5) %}<span style="width:12px;height:12px;background:currentColor;clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 95%,50% 73%,21% 95%,32% 57%,2% 35%,39% 35%);"></span>{% endfor %}</div><div style="font-size:var(--h1-size,40px);font-weight:var(--heading-weight,600);line-height:1.15;">{{ name | escape }}</div><div aria-hidden="true" style="margin-top:22px;display:grid;gap:9px;"><span style="height:9px;background:currentColor;opacity:.25;width:88%;"></span><span style="height:9px;background:currentColor;opacity:.25;width:64%;"></span></div><div aria-hidden="true" style="margin-top:28px;width:60%;height:46px;border-radius:var(--btn-radius,6px);background:var(--btn-primary-bg-color);border:var(--btn-border-width,1px) solid var(--btn-primary-border-color);"></div></div>
</template>
