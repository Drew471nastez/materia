<template compat="shopify">
{%- comment -%}
  Testimonial card — used by sections/testimonials.liquid.
  Inputs: b (block.settings), show_rating, show_quote_mark, block_id
{%- endcomment -%}
{%- assign demo_avatar = '' -%}
{%- if b.avatar == blank and block_id != blank -%}
  {%- capture demo_avatar -%}{%- render 'demo-image', key: block_id -%}{%- endcapture -%}
  {%- assign demo_avatar = demo_avatar | strip -%}
{%- endif -%}
<div class="tm-card">
  {%- if show_quote_mark -%}
    <span class="tm-card__quote-mark" aria-hidden="true">“</span>
  {%- endif -%}
  {%- if show_rating and b.rating > 0 -%}
    <div class="tm-card__rating" aria-label="Rated {{ b.rating }} out of 5">
      {%- for i in (1..5) -%}
        {%- if i <= b.rating -%}
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.27 5.82.84-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.6l5.82-.84z"/></svg>
        {%- else -%}
          <svg viewBox="0 0 20 20" fill="currentColor" class="star--off" aria-hidden="true"><path d="M10 1.5l2.6 5.27 5.82.84-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.6l5.82-.84z"/></svg>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if b.quote != blank -%}
    <div class="tm-card__quote rich__text-m0">{{ b.quote }}</div>
  {%- endif -%}
  {%- if b.name != blank or b.role != blank or b.avatar != blank or demo_avatar != blank -%}
    <div class="tm-card__author">
      {%- if b.avatar != blank -%}
        <img class="tm-card__avatar" src="{{ b.avatar | image_url: width: 160 }}" alt="{{ b.name | default: 'Avatar' | escape }}" loading="lazy" width="80" height="80">
      {%- elsif demo_avatar != blank -%}
        <img class="tm-card__avatar" src="{{ demo_avatar }}" alt="{{ b.name | default: 'Avatar' | escape }}" loading="lazy" width="80" height="80">
      {%- endif -%}
      <div>
        {%- if b.name != blank -%}<p class="tm-card__name">{{ b.name }}</p>{%- endif -%}
        {%- if b.role != blank -%}<p class="tm-card__role">{{ b.role }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

</template>