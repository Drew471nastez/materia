<template compat="shopify">
{%- comment -%}
  Materia Themes. The extra blocks of the cart page (main-cart-items):
  Simple rating, Happy customers, Benefits pills, Info box, Divider,
  Guarantee badge and Social proof avatars. Drawn once per block, in the
  order summary or below it (render_in_sidebar).

  Theme first: every colour follows the cart's colour scheme until the
  block's "Enable custom styling" is on (Benefits pills: custom_style),
  and text uses the theme fonts until "Enable custom fonts" is on, which
  marks the block data-own-font so Theme settings > Typography lets the
  picked font through. Every value is a CSS variable on the block root,
  so shopify/assets/live-cart-search.js changes it live without a redraw.
  The look itself is in main-cart-items (.lcs-*).

  Pass block, section_id. Only main-cart-items renders this snippet.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign on = false
  if block.type == 'benefits_pills'
    if s.custom_style
      assign on = true
    endif
  elsif s.enable_custom_style
    assign on = true
  endif
  assign own_font = false
  if s.enable_custom_fonts and s.font.family != blank
    assign own_font = true
  endif
  assign design = request.design_mode
  assign star_svg = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'
-%}
{%- capture ff -%}{%- if own_font -%}--lcs-ff: {{ s.font.family }}, {{ s.font.fallback_families | default: 'sans-serif' }};{%- endif -%}{%- endcapture -%}
{%- capture attrs -%}data-lcs-block="{{ block.id }}" data-lcs-type="{{ block.type }}" data-lcs-settings="{{ s | json | escape }}"{% if own_font %} data-own-font{% endif %} {{ block.shopify_attributes }}{%- endcapture -%}
{%- if own_font -%}<style>{{ s.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
{%- case block.type -%}
  {%- when 'simple_rating' -%}
    {%- liquid
      assign total = s.total_stars | default: 5
      assign filled = s.filled_stars | default: 0
      if filled > total
        assign filled = total
      endif
      assign full = filled | floor
      assign half = false
      assign frac = filled | minus: full
      if frac >= 0.5
        assign half = true
      endif
      assign half_idx = full | plus: 1
    -%}
    {%- capture c_on -%}{% render 'scheme-color', color: s.filled_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_off -%}{% render 'scheme-color', color: s.unfilled_color, fallback: 'color-mix(in srgb, var(--color-text) 22%, transparent)' %}{%- endcapture -%}
    {%- capture c_text -%}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
    <div class="cart-block cart-block--simple-rating mt-15 lcs-block lcs-rating" {{ attrs }}
      style="--lcs-pt: {{ s.padding_top | default: 0 }}px; --lcs-pb: {{ s.padding_bottom | default: 0 }}px; --lcs-align: {{ s.alignment | default: 'left' }}; --lcs-star: {{ s.star_size | default: 18 }}px; --lcs-fs-m: {{ s.font_size_mobile | default: 14 }}px; --lcs-fs-d: {{ s.font_size_desktop | default: 16 }}px; --lcs-fw: {{ s.font_weight | default: 500 }};{% if on %} --lcs-star-on: {{ c_on }}; --lcs-star-off: {{ c_off }}; --lcs-text: {{ c_text }};{% endif %} {{ ff }}">
      <div class="lcs-row">
        <span class="lcs-stars" role="img" aria-label="{{ filled }} / {{ total }}" data-lcs-stars>
          {%- for n in (1..total) -%}
            <span class="lcs-star{% if forloop.index <= full %} is-filled{% elsif half and forloop.index == half_idx %} is-half{% endif %}">{{ star_svg }}</span>
          {%- endfor -%}
        </span>
        <span class="lcs-text" data-lcs-text{% if s.text == blank %} hidden{% endif %}>{{ s.text | escape }}</span>
      </div>
    </div>

  {%- when 'happy_customers' -%}
    {%- liquid
      assign total = s.total_stars | default: 5
      assign filled = s.filled_stars | default: 0
      if filled > total
        assign filled = total
      endif
      assign full = filled | floor
      assign half = false
      assign frac = filled | minus: full
      if frac >= 0.5
        assign half = true
      endif
      assign half_idx = full | plus: 1
      assign avatar_count = s.avatar_count | default: 4
      assign avatar_size = s.avatar_size | default: 40
    -%}
    {%- capture c_on -%}{% render 'scheme-color', color: s.filled_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_off -%}{% render 'scheme-color', color: s.unfilled_color, fallback: 'color-mix(in srgb, var(--color-text) 22%, transparent)' %}{%- endcapture -%}
    {%- capture c_text -%}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    <div class="cart-block cart-block--happy-customers mt-15 lcs-block lcs-customers" {{ attrs }}
      style="--lcs-pt: {{ s.padding_top | default: 0 }}px; --lcs-pb: {{ s.padding_bottom | default: 0 }}px; --lcs-star: {{ s.star_size | default: 14 }}px; --lcs-av: {{ avatar_size }}px; --lcs-av-overlap: {{ s.avatar_overlap | default: 0 }}; --lcs-fs-m: {{ s.font_size_mobile | default: 14 }}px; --lcs-fs-d: {{ s.font_size_desktop | default: 16 }}px; --lcs-fw: {{ s.font_weight | default: 600 }};{% if on %} --lcs-star-on: {{ c_on }}; --lcs-star-off: {{ c_off }}; --lcs-text: {{ c_text }};{% endif %} {{ ff }}">
      <div class="lcs-row">
        <span class="lcs-avatars" aria-hidden="true" data-lcs-avatars{% unless s.show_avatars %} hidden{% endunless %}>
          {%- for i in (1..6) -%}
            {%- capture k -%}avatar_{{ i }}{%- endcapture -%}
            {%- assign img = s[k] -%}
            {%- if img != blank -%}
              <span class="lcs-avatar" data-lcs-avatar="{{ i }}"{% if i > avatar_count %} hidden{% endif %}>{{ img | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: avatar_size, height: avatar_size }}</span>
            {%- elsif design -%}
              <span class="lcs-avatar lcs-avatar--empty" data-lcs-avatar="{{ i }}"{% if i > avatar_count %} hidden{% endif %}></span>
            {%- endif -%}
          {%- endfor -%}
        </span>
        <span class="lcs-text-wrap">
          <span class="lcs-heading" data-lcs-text{% if s.heading == blank %} hidden{% endif %}>{{ s.heading | escape }}</span>
          <span class="lcs-stars-row" data-lcs-stars-row{% unless s.show_stars %} hidden{% endunless %}>
            <span class="lcs-stars" role="img" aria-label="{{ filled }} / {{ total }}" data-lcs-stars>
              {%- for n in (1..total) -%}
                <span class="lcs-star{% if forloop.index <= full %} is-filled{% elsif half and forloop.index == half_idx %} is-half{% endif %}">{{ star_svg }}</span>
              {%- endfor -%}
            </span>
            <span class="lcs-rating-text" data-lcs-rating-text{% if s.show_rating_text != true or s.rating_text == blank %} hidden{% endif %}>{{ s.rating_text | escape }}</span>
          </span>
        </span>
      </div>
    </div>

  {%- when 'benefits_pills' -%}
    {%- capture c_head -%}{% render 'scheme-color', color: s.heading_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_ptext -%}{% render 'scheme-color', color: s.pill_text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
    {%- capture c_pbg -%}{% render 'scheme-color', color: s.pill_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %}{%- endcapture -%}
    {%- capture c_picon -%}{% render 'scheme-color', color: s.pill_icon_color, fallback: 'currentColor' %}{%- endcapture -%}
    {%- capture c_pborder -%}{% render 'scheme-color', color: s.pill_border_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
    {%- assign shown = 0 -%}
    {%- for i in (1..6) -%}
      {%- capture k_en -%}pill{{ i }}_enable{%- endcapture -%}
      {%- capture k_tx -%}pill{{ i }}_text{%- endcapture -%}
      {%- if s[k_en] and s[k_tx] != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    <div class="cart-block cart-block--benefits-pills mt-15 lcs-block lcs-pills" {{ attrs }} data-lcs-layout="{{ s.mobile_layout | default: 'wrap' }}"{% if s.pill_shadow %} data-lcs-shadow{% endif %}{% if shown == 0 and design == false %} hidden{% endif %}
      style="--lcs-pt: {{ s.padding_top | default: 0 }}px; --lcs-pb: {{ s.padding_bottom | default: 0 }}px; --lcs-justify: {{ s.alignment | default: 'flex-start' }}; --lcs-gap-x: {{ s.gap_x | default: 0 }}px; --lcs-gap-y: {{ s.gap_y | default: 0 }}px; --lcs-h-align: {{ s.heading_alignment | default: 'left' }}; --lcs-h-mb: {{ s.heading_margin_bottom | default: 0 }}px; --lcs-h-fs-m: {{ s.heading_size_mobile | default: 15 }}px; --lcs-h-fs-d: {{ s.heading_size_desktop | default: 16 }}px; --lcs-h-fw: {{ s.heading_weight | default: 700 }}; --lcs-fs-m: {{ s.pill_font_size_mobile | default: 13 }}px; --lcs-fs-d: {{ s.pill_font_size_desktop | default: 14 }}px; --lcs-fw: {{ s.pill_font_weight | default: 600 }}; --lcs-radius: {{ s.pill_radius | default: 0 }}px; --lcs-px: {{ s.pill_padding_x | default: 0 }}px; --lcs-py: {{ s.pill_padding_y | default: 0 }}px; --lcs-icon-gap: {{ s.pill_gap | default: 0 }}px; --lcs-icon-m: {{ s.pill_icon_size_mobile | default: 14 }}px; --lcs-icon-d: {{ s.pill_icon_size_desktop | default: 16 }}px;{% if s.pill_border_style != 'none' and s.pill_border_width > 0 %} --lcs-border: {{ s.pill_border_width }}px {{ s.pill_border_style }};{% endif %}{% if on %} --lcs-head: {{ c_head }}; --lcs-pill-text: {{ c_ptext }}; --lcs-pill-bg: {{ c_pbg }}; --lcs-pill-icon: {{ c_picon }}; --lcs-pill-border: {{ c_pborder }};{% endif %} {{ ff }}">
      <p class="lcs-pills__heading" data-lcs-text{% if s.show_heading != true or s.heading_text == blank %} hidden{% endif %}>{{ s.heading_text | escape }}</p>
      <ul class="lcs-pills__list" role="list">
        {%- for i in (1..6) -%}
          {%- capture k_en -%}pill{{ i }}_enable{%- endcapture -%}
          {%- capture k_tx -%}pill{{ i }}_text{%- endcapture -%}
          {%- capture k_src -%}pill{{ i }}_icon_source{%- endcapture -%}
          {%- capture k_pre -%}pill{{ i }}_icon_preset{%- endcapture -%}
          {%- capture k_svg -%}pill{{ i }}_icon_svg{%- endcapture -%}
          {%- capture k_img -%}pill{{ i }}_icon_image{%- endcapture -%}
          {%- capture k_ic -%}pill{{ i }}_icon_color{%- endcapture -%}
          {%- capture k_bg -%}pill{{ i }}_bg_color{%- endcapture -%}
          {%- capture k_tc -%}pill{{ i }}_text_color{%- endcapture -%}
          {%- assign p_src = s[k_src] | default: 'preset' -%}
          {%- assign p_text = s[k_tx] -%}
          {%- assign p_show = false -%}
          {%- if s[k_en] and p_text != blank -%}{%- assign p_show = true -%}{%- endif -%}
          {%- if p_show or design -%}
            {%- capture p_style -%}
              {%- if on -%}
                {%- if s[k_bg] != blank -%}--lcs-pill-bg-i: {% render 'scheme-color', color: s[k_bg], fallback: 'var(--lcs-pill-bg)' %};{%- endif -%}
                {%- if s[k_tc] != blank -%}--lcs-pill-text-i: {% render 'scheme-color', color: s[k_tc], fallback: 'var(--lcs-pill-text)' %};{%- endif -%}
                {%- if s[k_ic] != blank -%}--lcs-pill-icon-i: {% render 'scheme-color', color: s[k_ic], fallback: 'var(--lcs-pill-icon)' %};{%- endif -%}
              {%- endif -%}
            {%- endcapture -%}
            <li class="lcs-pill" data-lcs-pill="{{ i }}"{% unless p_show %} hidden{% endunless %}{% assign p_style = p_style | strip %}{% if p_style != blank %} style="{{ p_style }}"{% endif %}>
              <span class="lcs-pill__icon" aria-hidden="true" data-lcs-pill-icon{% if p_src == 'none' %} hidden{% endif %}>
                {%- if p_src == 'image' and s[k_img] != blank -%}
                  {{ s[k_img] | image_url: width: 96 | image_tag: alt: '', loading: 'lazy', width: 48, height: 48 }}
                {%- elsif p_src == 'svg' and s[k_svg] != blank -%}
                  {{ s[k_svg] }}
                {%- else -%}
                  {%- render 'cart-page-pill-icon', icon: s[k_pre] -%}
                {%- endif -%}
              </span>
              <span class="lcs-pill__text" data-lcs-pill-text>{{ p_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

  {%- when 'info_box' -%}
    {%- capture c_bg -%}{% render 'scheme-color', color: s.box_bg, fallback: 'transparent' %}{%- endcapture -%}
    {%- capture c_border -%}{% render 'scheme-color', color: s.border_color, fallback: 'var(--color-border)' %}{%- endcapture -%}
    {%- capture c_text -%}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_muted -%}{% render 'scheme-color', color: s.muted_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
    {%- capture c_icon -%}{% render 'scheme-color', color: s.top_icon_color, fallback: 'currentColor' %}{%- endcapture -%}
    <div class="cart-block cart-block--info-box mt-15 lcs-block lcs-info" {{ attrs }}
      style="--lcs-ib-bg: {% if on %}{{ c_bg }}{% else %}transparent{% endif %}; --lcs-ib-border: {% if on %}{{ c_border }}{% else %}var(--color-border){% endif %}; --lcs-ib-text: {% if on %}{{ c_text }}{% else %}var(--color-heading){% endif %}; --lcs-ib-muted: {% if on %}{{ c_muted }}{% else %}var(--color-text){% endif %}; --lcs-ib-icon: {% if on %}{{ c_icon }}{% else %}currentColor{% endif %}; {{ ff }}">
      {%- render 'info-box-block', block: block -%}
    </div>

  {%- when 'divider' -%}
    {%- capture c_line -%}{% render 'scheme-color', color: s.color, fallback: 'var(--color-border)' %}{%- endcapture -%}
    <hr class="cart-block cart-block--divider lcs-block lcs-divider" {{ attrs }}
      style="--lcs-line: {% if on %}{{ c_line }}{% else %}var(--color-border){% endif %}; --lcs-thick: {{ s.thickness | default: 1 }}px; --lcs-mt: {{ s.margin_top | default: 0 }}px; --lcs-mb: {{ s.margin_bottom | default: 0 }}px;">

  {%- when 'guarantee_badge' -%}
    {%- capture c_text -%}{% render 'scheme-color', color: s.text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
    {%- capture c_icon -%}{% render 'scheme-color', color: s.icon_color, fallback: 'currentColor' %}{%- endcapture -%}
    <div class="cart-guarantee cart-block cart-block--guarantee mt-15 lcs-block lcs-guarantee" {{ attrs }}{% if s.text == blank and design == false %} hidden{% endif %}
      style="--lcs-justify: {{ s.alignment | default: 'flex-start' }}; --lcs-mt: {{ s.margin_top | default: 0 }}px; --lcs-mb: {{ s.margin_bottom | default: 0 }}px; --lcs-icon: {{ s.icon_size | default: 18 }}px; --lcs-fs: {{ s.font_size | default: 14 }}px; --lcs-fw: {{ s.font_weight | default: 500 }};{% if on %} --lcs-text: {{ c_text }}; --lcs-icon-c: {{ c_icon }};{% endif %} {{ ff }}">
      <span class="lcs-guarantee__icon" data-lcs-icon>{%- render 'cart-page-pill-icon', icon: s.icon, set: 'guarantee' -%}</span>
      <span class="lcs-guarantee__text" data-lcs-text>{{ s.text | escape }}</span>
    </div>

  {%- when 'social_proof_avatars' -%}
    {%- liquid
      assign message = s.referral_text | escape
      if s.referral_accent_text != blank and message contains s.referral_accent_text
        assign accent = s.referral_accent_text | escape
        assign accent_html = '<span class="lcs-spa__accent">' | append: accent | append: '</span>'
        assign message = message | replace_first: accent, accent_html
      endif
      assign any_avatar = false
    -%}
    {%- capture c_text -%}{% render 'scheme-color', color: s.referral_text_color, fallback: 'var(--color-text)' %}{%- endcapture -%}
    {%- capture c_accent -%}{% render 'scheme-color', color: s.referral_accent_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_star -%}{% render 'scheme-color', color: s.star_color, fallback: 'var(--color-heading)' %}{%- endcapture -%}
    {%- capture c_ring -%}{% render 'scheme-color', color: s.ref_avatar_border_color, fallback: 'var(--color-background)' %}{%- endcapture -%}
    <div class="cart-spa cart-block cart-block--social-proof mt-15 lcs-block lcs-spa" {{ attrs }}{% if s.referral_text == blank and design == false %} hidden{% endif %}
      style="--lcs-mt: {{ s.margin_top | default: 0 }}px; --lcs-gap-m: {{ s.referral_inline_gap_mobile | default: 0 }}px; --lcs-gap-d: {{ s.referral_inline_gap_desktop | default: 0 }}px; --lcs-mb-m: {{ s.referral_to_title_gap_mobile | default: 0 }}px; --lcs-mb-d: {{ s.referral_to_title_gap_desktop | default: 0 }}px; --lcs-av-m: {{ s.ref_avatar_size_mobile | default: 32 }}px; --lcs-av-d: {{ s.ref_avatar_size_desktop | default: 36 }}px; --lcs-ov-m: {{ s.ref_avatar_overlap_mobile | default: 0 }}px; --lcs-ov-d: {{ s.ref_avatar_overlap_desktop | default: 0 }}px; --lcs-ring-w: {{ s.ref_avatar_border_thickness | default: 0 }}px; --lcs-star-m: {{ s.star_size_mobile | default: 16 }}px; --lcs-star-d: {{ s.star_size_desktop | default: 18 }}px; --lcs-fs-m: {{ s.font_size_mobile | default: 14 }}px; --lcs-fs-d: {{ s.font_size_desktop | default: 15 }}px;{% if on %} --lcs-text: {{ c_text }}; --lcs-accent: {{ c_accent }}; --lcs-star-on: {{ c_star }}; --lcs-ring: {{ c_ring }};{% endif %} {{ ff }}">
      <span class="lcs-spa__avatars" aria-hidden="true">
        {%- for i in (1..5) -%}
          {%- capture k -%}ref_avatar_{{ i }}{%- endcapture -%}
          {%- if s[k] != blank -%}
            {%- assign any_avatar = true -%}
            {{ s[k] | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', width: 36, height: 36 }}
          {%- endif -%}
        {%- endfor -%}
      </span>
      <span class="lcs-stars" aria-hidden="true" data-lcs-stars{% unless s.show_stars %} hidden{% endunless %}>
        {%- for i in (1..5) -%}<span class="lcs-star is-filled">{{ star_svg }}</span>{%- endfor -%}
      </span>
      <span class="lcs-spa__message" data-lcs-text>{{ message }}</span>
    </div>
{%- endcase -%}
</template>
