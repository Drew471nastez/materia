<template compat="shopify">
{%- comment -%}
  Materia Themes. A collection sidebar block that is not a filter: popular
  products, a text panel or an image banner, drawn inside the filter panel
  (snippets/facets-panel) in the order the creator placed them.
  Accepts: block
{%- endcomment -%}
{%- assign block_st = block.settings -%}
{%- case block.type -%}
  {%- when 'popular_product' -%}
    {%- assign block_collection = collections[block_st.collection] -%}
    {%- if block_collection.products.size > 0 -%}
      <details class="facets-group facets-group--extra" data-facets-group="extra-{{ block.id }}" open {{ block.shopify_attributes }}>
        <summary class="facets-group__summary">
          <span class="facets-group__name">{{ block_st.title | escape }}</span>
          <svg class="facets-group__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m1 1.5 5 5 5-5"/></svg>
        </summary>
        <div class="facets-group__content">
          <div class="list list-view-items featured-product products-list__column-items flex flex-column gap-20">
            {%- for product in block_collection.products limit: block_st.items_to_show -%}
              {% render 'product-item',
                card_product: product,
                template_enable_price: true,
                template_enable_add_cart: false,
                template_enable_product_vendor: false,
                template_enable_rate: true,
                template_enable_product_short_description: false,
                template_enable_color_swatches: false,
                type: 'list',
                sizes: '80px'
              %}
            {%- endfor -%}
          </div>
        </div>
      </details>
    {%- endif -%}
  {%- when 'html' -%}
    {%- if block_st.content != blank or block_st.title != blank -%}
      <div class="facets-extra" {{ block.shopify_attributes }}>
        {%- if block_st.title != blank -%}<p class="facets-extra__title heading-style">{{ block_st.title | escape }}</p>{%- endif -%}
        {%- if block_st.content != blank -%}<div class="facets-extra__text rich__text-m0">{{ block_st.content }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  {%- when 'image_banner' -%}
    {%- if block_st.image != blank -%}
      <div class="facets-extra facets-extra--banner" {{ block.shopify_attributes }}>
        {%- if block_st.url != blank -%}<a class="facets-extra__link" href="{{ block_st.url }}" {% render 'link-target', url: block_st.url, new_tab: block_st.open_link %}>{%- endif -%}
        <span class="image responsive-image" style="--aspect-ratio: {{ block_st.image.aspect_ratio | default: 1 }}">
          {% render 'responsive-image',
            type: 'other',
            class: 'rounded',
            image: block_st.image,
            image_alt: block_st.image.alt | escape,
            sizes: '270px'
          %}
        </span>
        {%- if block_st.url != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}
{%- endcase -%}
</template>
