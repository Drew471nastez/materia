<template compat="shopify">
{%- assign c = controls -%}
{%- if kind == 'section' -%}
--hi1-bg:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--hi1-radius:{% if c.enable_custom_style %}{{ c.card_radius | default: 0 }}px{% else %}var(--rounded-radius,0px){% endif %};
--hi1-height-d:{{ c.min_height_desktop | default: 640 }}px;--hi1-height-m:{{ c.min_height_mobile | default: 480 }}px;
--hi1-pt-d:{{ c.padding_top_desktop | default: 120 }}px;--hi1-pb-d:{{ c.padding_bottom_desktop | default: 120 }}px;--hi1-px-d:{{ c.side_padding_desktop | default: 48 }}px;
--hi1-pt-m:{{ c.padding_top_mobile | default: 80 }}px;--hi1-pb-m:{{ c.padding_bottom_mobile | default: 80 }}px;--hi1-px-m:{{ c.side_padding_mobile | default: 24 }}px;
--hi1-gap:{{ c.content_gap | default: 16 }}px;--hi1-content:{{ c.content_max_width | default: 720 }}px;--hi1-buttons-mt:{{ c.buttons_margin_top | default: 8 }}px;
--hi1-overlay:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.overlay_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--hi1-opacity:{{ c.overlay_opacity | default: 30 | divided_by: 100.0 }};
--hi1-x:{{ c.image_position_x | default: 50 }}%;--hi1-y:{{ c.image_position_y | default: 50 }}%;--hi1-fit:{{ c.image_fit | default: 'cover' }};
--hi1-align:{% case c.content_align %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};--hi1-text-align:{{ c.content_align | default: 'center' }};
--hi1-vertical:{% case c.vertical_align %}{% when 'top' %}flex-start{% when 'bottom' %}flex-end{% else %}center{% endcase %};
{%- else -%}
--hi1-font:{% if c.enable_custom_style and c.font_source == 'heading' %}var(--hi1-heading-font,var(--heading-font)){% elsif c.enable_custom_style and c.font_source == 'body' %}var(--hi1-body-font,var(--body-font)){% elsif kind == 'heading' %}var(--hi1-heading-font,var(--heading-font)){% else %}var(--hi1-body-font,var(--body-font)){% endif %};
--hi1-ink:{% if c.enable_custom_style %}{% if kind == 'heading' or kind == 'eyebrow' or kind == 'badge' or kind == 'subheading' %}{% if kind == 'heading' %}{% render 'scheme-color', color: c.color, fallback: 'var(--color-heading)' %}{% else %}{% render 'scheme-color', color: c.color, fallback: 'var(--color-text)' %}{% endif %}{% else %}{% render 'scheme-color', color: c.text_color, fallback: 'var(--color-text)' %}{% endif %}{% elsif kind == 'heading' %}var(--color-heading){% else %}var(--color-text){% endif %};
--hi1-weight:{% if c.enable_custom_style and c.font_weight != blank and c.font_weight != 'theme' %}{{ c.font_weight }}{% elsif kind == 'heading' %}var(--heading-weight,600){% else %}var(--body-weight,400){% endif %};
--hi1-letter:{% if c.enable_custom_style and c.letter_spacing != blank %}{{ c.letter_spacing }}px{% elsif kind == 'heading' %}var(--heading-letter-spacing,normal){% else %}normal{% endif %};
--hi1-case:{% if c.enable_custom_style and c.text_case != blank and c.text_case != 'theme' %}{{ c.text_case }}{% elsif kind == 'heading' %}var(--heading-text-transform,none){% else %}none{% endif %};
--hi1-line:{% if c.enable_custom_style and c.line_height != blank %}{{ c.line_height }}{% elsif kind == 'heading' %}var(--heading-line-height,1.2){% else %}var(--body-line-height,1.5){% endif %};
--hi1-size-m:{% if c.enable_custom_style and c.size_mobile != blank %}{{ c.size_mobile }}px{% elsif c.enable_custom_style and c.font_size_mobile != blank %}{{ c.font_size_mobile }}px{% elsif c.enable_custom_style and c.size != blank %}{{ c.size }}px{% elsif c.enable_custom_style and c.text_size != blank %}{{ c.text_size }}px{% elsif kind == 'heading' %}var(--h1-size,48px){% else %}var(--body-font-size,16px){% endif %};
--hi1-size-d:{% if c.enable_custom_style and c.size_desktop != blank %}{{ c.size_desktop }}px{% elsif c.enable_custom_style and c.font_size_desktop != blank %}{{ c.font_size_desktop }}px{% elsif c.enable_custom_style and c.size != blank %}{{ c.size }}px{% elsif c.enable_custom_style and c.text_size != blank %}{{ c.text_size }}px{% elsif kind == 'heading' %}var(--h1-size,48px){% else %}var(--body-font-size,16px){% endif %};
--hi1-filled:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.filled_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--hi1-empty:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.unfilled_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
{%- if kind == 'badge' -%}--hi1-badge-bg:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.bg, fallback: 'var(--color-background)' %}{% else %}color-mix(in srgb,var(--color-heading) 8%,var(--color-background)){% endif %};--hi1-badge-radius:{% if c.enable_custom_style %}{{ c.radius | default: 8 }}px{% else %}var(--rounded-radius,4px){% endif %};{%- endif -%}
{%- if kind == 'primary_button' or kind == 'secondary_button' -%}{% if c.enable_custom_style %}{% render 'button-overrides', bg: c.bg, text: c.text_color, border: c.border_color, hover_bg: c.bg_hover, hover_text: c.text_color_hover, hover_border: c.border_color_hover, custom: true, radius: c.radius, padding_x: c.padding_x, padding_y: c.padding_y, font_size: c.font_size %}border-radius:{{ c.radius | default: 8 }}px!important;font-size:{{ c.font_size | default: 16 }}px!important;padding:{{ c.padding_y | default: 14 }}px {{ c.padding_x | default: 26 }}px!important;{% if c.font_weight != blank and c.font_weight != 'theme' %}font-weight:{{ c.font_weight }}!important;{% endif %}{% endif %}{%- endif -%}
{%- endif -%}
</template>
