<template compat="shopify">
{%- comment -%}
  Materia Themes. Arrows, page dots and progress bar for the shared
  scroll-snap carousel (Reels Wall, Shoppable Video). Every control is a
  44px button; shopify/assets/media-live-stats-reels.js moves the track.
  Inputs: count (slides), cols_d, cols_m, loop, arrows (true/false),
  dots ('dots', 'progress' or 'none'), mobile_only (true: dots on phones only),
  style (dot, pill, line, square, ring, number), position (left, center, right).
{%- endcomment -%}
{%- liquid
  assign pages_d = count | minus: cols_d | plus: 1
  if pages_d < 1
    assign pages_d = 1
  endif
  assign pages_m = count | minus: cols_m | plus: 1
  if pages_m < 1
    assign pages_m = 1
  endif
  case position
    when 'left'
      assign justify = 'flex-start'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'center'
  endcase
-%}
<div class="msr-car__controls" data-msr-controls data-dots="{{ dots }}" data-style="{{ style | default: 'pill' }}"{% if mobile_only %} data-mobile-only{% endif %}{% if pages_d <= 1 %} data-d{% endif %}{% if pages_m <= 1 %} data-m{% endif %} style="--msr-pos: {{ justify }};">
  <div class="msr-car__dots" data-msr-dots>
    {%- for i in (1..count) -%}
      <button type="button" class="msr-car__dot" data-msr-dot="{{ forloop.index0 }}" aria-label="{{ 'accessibility.go_to_slide' | t }} {{ i }}"{% if forloop.first %} aria-current="true"{% else %} aria-current="false"{% endif %}{% if i > pages_d %} data-d{% endif %}{% if i > pages_m %} data-m{% endif %}><span>{{ i }}</span></button>
    {%- endfor -%}
  </div>
  <div class="msr-car__progress" data-msr-progress aria-hidden="true"><span></span></div>
  <div class="msr-car__arrows" data-msr-arrows{% unless arrows %} hidden{% endunless %}>
    <button type="button" class="msr-car__arrow" data-msr-prev aria-label="{{ 'accessibility.previous' | t }}"{% unless loop %} disabled{% endunless %}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="10 3 5 8 10 13"/></svg>
    </button>
    <button type="button" class="msr-car__arrow" data-msr-next aria-label="{{ 'accessibility.next' | t }}">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 3 11 8 6 13"/></svg>
    </button>
  </div>
</div>
</template>
