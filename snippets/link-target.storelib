<template compat="shopify">
{%- liquid
  if new_tab == nil
    assign new_tab = legacy_new_tab
  endif
  assign external = false
  assign target_url = url | downcase | strip
  assign prefix = target_url | slice: 0, 2
  assign protocol = target_url | split: ':' | first
  if protocol == 'https' or protocol == 'http' or prefix == '//'
    assign target_host = target_url | split: '/' | slice: 2 | first | split: ':' | first
    assign current_host = request.host | downcase | split: ':' | first
    assign store_host = shop.domain | downcase
    assign store_url_host = shop.url | downcase | split: '/' | slice: 2 | first | split: ':' | first
    assign permanent_host = shop.permanent_domain | downcase
    if target_host != blank and target_host != current_host and target_host != store_host and target_host != store_url_host and target_host != permanent_host
      assign external = true
    endif
  endif
-%}
{%- if external and new_tab == true -%}target="_blank" rel="noopener noreferrer"{%- endif -%}
</template>
