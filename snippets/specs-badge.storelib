<template compat="shopify">
{%- comment -%}
  Materia Themes — Specs Badge block.
  Pill-shaped badge with customizable bg, border, text. Theme-connected by default.
  Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'specs-badge-' | append: block.id
-%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 8 }}px;
    padding-bottom: {{ s.padding_bottom | default: 8 }}px;
    text-align: {{ s.alignment | default: 'left' }};
  }
  #{{ block_id }} .specs-badge {
    display: inline-flex;
    align-items: center;
    padding: {{ s.padding_y | default: 8 }}px {{ s.padding_x | default: 14 }}px;
    border-radius: {{ s.border_radius | default: 999 }}px;
    border: {{ s.border_width | default: 1 }}px solid {% if s.border_color != blank %}{{ s.border_color }}{% else %}var(--color-border, rgba(0,0,0,0.12)){% endif %};
    background: {% if s.bg_color != blank %}{{ s.bg_color }}{% else %}transparent{% endif %};
    color: {% if s.text_color != blank %}{{ s.text_color }}{% else %}var(--color-text, #111){% endif %};
    font-size: {{ s.font_size | default: 13 }}px;
    font-weight: {{ s.font_weight | default: '500' }};
    line-height: 1.3;
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 749px) {
    #{{ block_id }} .specs-badge {
      font-size: {{ s.font_size_mobile | default: 12 }}px;
    }
  }
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="specs-badge-block" {{ block.shopify_attributes }}>
  <span class="specs-badge">{{ s.text | default: '30 Servings | From 58p a day' }}</span>
</div>

</template>