<template compat="shopify">
{%- if settings.quantity_enable_custom -%}
:root {
  {%- if settings.quantity_background != blank %}--quantity-bg:{{ settings.quantity_background }};{% endif -%}
  {%- if settings.quantity_text != blank %}--quantity-text:{{ settings.quantity_text }};{% endif -%}
  {%- if settings.quantity_border != blank %}--quantity-border:{{ settings.quantity_border }};{% endif -%}
  --quantity-radius:{{ settings.quantity_radius | default: 4 }}px;
}
{%- endif -%}
</template>
