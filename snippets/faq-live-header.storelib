<template compat="shopify">
{%- comment -%}
  Materia Themes. The header of the FAQ sections: the heading, subheading
  and button blocks in their order. A section with no heading block shows
  its older Heading setting, and one with no subheading block its older
  Subheading setting, first. p: the section's class prefix. own_hw: the
  older heading has its own weight (default: Custom heading weight on).
  data-own-font / data-own-weight / data-own-size / data-own-shape keep a
  custom font, weight, size or button shape ahead of Theme settings >
  Typography and Buttons priority (live-faq.js toggles them on live edits).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  if own_hw == nil
    assign own_hw = st.enable_custom_heading_weight
  endif
  assign heading_blocks = section.blocks | where: 'type', 'heading'
  assign sub_blocks = section.blocks | where: 'type', 'subheading'
  assign button_blocks = section.blocks | where: 'type', 'button'
  assign sec_font = false
  if st.enable_custom_fonts
    assign sec_font = true
  endif
  assign legacy_heading = false
  if heading_blocks.size == 0 and st.heading != blank
    assign legacy_heading = true
  endif
  assign legacy_sub = false
  if sub_blocks.size == 0 and st.subheading != blank
    assign legacy_sub = true
  endif
  assign fb_learn_more = 'accessibility.learn_more' | t
-%}
{%- if legacy_heading or legacy_sub or heading_blocks.size > 0 or sub_blocks.size > 0 or button_blocks.size > 0 -%}
      <div class="{{ p }}__header">
        {%- if legacy_heading -%}<h2 class="{{ p }}__heading" data-faq-legacy="heading"{% if sec_font %} data-own-font{% endif %}{% if own_hw %} data-own-weight{% endif %}>{{ st.heading }}</h2>{%- endif -%}
        {%- if legacy_sub -%}<div class="{{ p }}__subheading" data-faq-legacy="subheading"{% if sec_font %} data-own-font{% endif %}>{{ st.subheading }}</div>{%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- capture fb_vars -%}
                {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %};{%- endif -%}
                {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 700 }};{%- endif -%}
                {%- if bs.size_enable -%}--fb-fs-d:{{ bs.size_desktop | default: 36 }}px;--fb-fs-m:{{ bs.size_mobile | default: 26 }}px;--fb-lh:{{ bs.line_height | default: 1.15 }};--fb-ls:{{ bs.tracking | default: 0 }}px;{%- endif -%}
                {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
              {%- endcapture -%}
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
              <h2 class="{{ p }}__heading" id="block-{{ block.id }}" data-faq-block="{{ block.id }}" data-faq-type="heading" data-faq-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable or own_hw %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              {%- capture fb_vars -%}
                {%- if bs.enable_custom_style -%}--fb-c:{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %};{%- endif -%}
                {%- if bs.weight_enable -%}--fb-fw:{{ bs.weight | default: 400 }};{%- endif -%}
                {%- if bs.size_enable -%}--fb-fs:{{ bs.size | default: 16 }}px;--fb-lh:{{ bs.line_height | default: 1.5 }};{%- endif -%}
                {%- if bs.enable_custom_fonts and bs.font.family != blank -%}--fb-ff:{{ bs.font.family }}, {{ bs.font.fallback_families }};{%- endif -%}
              {%- endcapture -%}
              {%- if bs.enable_custom_fonts and bs.font.family != blank -%}<style>{{ bs.font | font_face: font_display: 'swap' }}{% comment %}{% endcomment %}</style>{%- endif -%}
              <div class="{{ p }}__subheading" id="block-{{ block.id }}" data-faq-block="{{ block.id }}" data-faq-type="subheading" data-faq-settings="{{ bs | json | escape }}"{% if sec_font or bs.enable_custom_fonts %} data-own-font{% endif %}{% if bs.weight_enable %} data-own-weight{% endif %}{% if bs.size_enable %} data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}{% if fb_vars != blank %} style="{{ fb_vars }}"{% endif %} {{ block.shopify_attributes }}>{{ bs.text }}</div>
            {%- when 'button' -%}
              {%- liquid
                assign btn_label = bs.label | default: fb_learn_more
                assign btn_style = bs.style | default: 'primary'
                assign btn_size = bs.size | default: 'medium'
                assign own_shape = false
                if bs.use_theme_button == false
                  assign own_shape = true
                else
                  assign btn_size = 'theme'
                endif
              -%}
              {%- capture btn_vars -%}
                {%- comment -%} Custom styling: this button's own colours, starting from the primary button's. {%- endcomment -%}
                {%- if bs.enable_custom_style -%}--mb-bg:{% render 'scheme-color', color: bs.bg_color, fallback: 'var(--btn-primary-bg-color)' %};--mb-text:{% render 'scheme-color', color: bs.text_color, fallback: 'var(--btn-primary-color)' %};--mb-border:{% render 'scheme-color', color: bs.border_color, fallback: 'var(--btn-primary-border-color, var(--btn-primary-bg-color))' %};--mb-hover-bg:{% render 'scheme-color', color: bs.bg_color_hover, fallback: 'var(--btn-primary-hover-bg-color)' %};--mb-hover-text:{% render 'scheme-color', color: bs.text_color_hover, fallback: 'var(--btn-primary-hover-color)' %};{%- endif -%}
                {%- unless own_shape -%}--{{ p }}-btn-border-width:var(--btn-border-width, 1px);{%- endunless -%}
                {%- if own_shape -%}
                  --mb-radius:{{ bs.radius | default: 100 }}px;
                  {%- case btn_size -%}
                    {%- when 'small' -%}--mb-font-size:13px;--mb-padding-y:10px;--mb-padding-x:18px;
                    {%- when 'large' -%}--mb-font-size:16px;--mb-padding-y:16px;--mb-padding-x:32px;
                    {%- else -%}--mb-font-size:14px;--mb-padding-y:13px;--mb-padding-x:24px;
                  {%- endcase -%}
                {%- endif -%}
              {%- endcapture -%}
              <div class="{{ p }}__cta-row" id="block-{{ block.id }}" data-faq-block="{{ block.id }}" data-faq-type="button" data-faq-settings="{{ bs | json | escape }}" {{ block.shopify_attributes }}>
                {%- if bs.link != blank -%}
                  <a class="{{ p }}__btn {{ p }}__btn--{{ btn_style }} {{ p }}__btn--{{ btn_size }}" data-faq-btn{% if btn_style == 'text' %} data-button-local-appearance="underline"{% else %} data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-button-local-appearance="theme"{% endif %} data-full="{% if bs.full_width %}true{% else %}false{% endif %}"{% if own_shape %} data-own-shape{% endif %} href="{{ bs.link }}"{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}>
                    {{ btn_label | escape }}
                  </a>
                {%- else -%}
                  <button type="button" class="{{ p }}__btn {{ p }}__btn--{{ btn_style }} {{ p }}__btn--{{ btn_size }}" data-faq-btn{% if btn_style == 'text' %} data-button-local-appearance="underline"{% else %} data-theme-button="{% if btn_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-button-local-appearance="theme"{% endif %} data-full="{% if bs.full_width %}true{% else %}false{% endif %}"{% if own_shape %} data-own-shape{% endif %}{% if btn_vars != blank %} style="{{ btn_vars | strip_newlines }}"{% endif %}>
                    {{ btn_label | escape }}
                  </button>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
{%- endif -%}
</template>
