<template compat="shopify">
{%- comment -%}
  Reusable phone-number field with country-code dropdown.
  -------------------------------------------------------
  Renders a country <select> + phone <input>, plus a hidden combined input
  named `contact[phone]` that Shopify captures into the customer profile.
  A small inline script keeps the hidden field in sync as the visitor types.

  Accepts:
    scope                  : unique CSS scope for this instance (e.g. section.id)
    default_country        : ISO-style default key, e.g. 'US' / 'CA' / 'GB'
    phone_placeholder      : placeholder text for the local phone input
    required               : 'true' / 'false' — make phone required
    label                  : optional visible label

  The hidden combined field name is always `contact[phone]` so Shopify's
  newsletter customer form picks it up.
{%- endcomment -%}
{%- assign cc_scope = scope | default: 'phone' -%}
{%- assign cc_default = default_country | default: 'US' -%}
{%- assign cc_placeholder = phone_placeholder | default: 'Phone number' -%}
{%- assign cc_required = required | default: 'false' -%}

<div class="cpnb-phone cpnb-phone--{{ cc_scope }}" data-cpnb-phone>
  {%- if label != blank -%}
    <label class="cpnb-phone__label" for="cpnb-phone-local-{{ cc_scope }}">{{ label }}</label>
  {%- endif -%}
  <div class="cpnb-phone__row">
    <select class="cpnb-phone__cc" data-cpnb-phone-cc aria-label="Country code" id="cpnb-phone-cc-{{ cc_scope }}">
      {%- assign countries = 'US|🇺🇸|+1,CA|🇨🇦|+1,GB|🇬🇧|+44,AU|🇦🇺|+61,NZ|🇳🇿|+64,IE|🇮🇪|+353,IN|🇮🇳|+91,SG|🇸🇬|+65,HK|🇭🇰|+852,JP|🇯🇵|+81,KR|🇰🇷|+82,CN|🇨🇳|+86,DE|🇩🇪|+49,FR|🇫🇷|+33,ES|🇪🇸|+34,IT|🇮🇹|+39,PT|🇵🇹|+351,NL|🇳🇱|+31,BE|🇧🇪|+32,LU|🇱🇺|+352,CH|🇨🇭|+41,AT|🇦🇹|+43,DK|🇩🇰|+45,SE|🇸🇪|+46,NO|🇳🇴|+47,FI|🇫🇮|+358,IS|🇮🇸|+354,PL|🇵🇱|+48,CZ|🇨🇿|+420,SK|🇸🇰|+421,HU|🇭🇺|+36,RO|🇷🇴|+40,GR|🇬🇷|+30,TR|🇹🇷|+90,RU|🇷🇺|+7,UA|🇺🇦|+380,IL|🇮🇱|+972,AE|🇦🇪|+971,SA|🇸🇦|+966,EG|🇪🇬|+20,ZA|🇿🇦|+27,NG|🇳🇬|+234,KE|🇰🇪|+254,BR|🇧🇷|+55,AR|🇦🇷|+54,MX|🇲🇽|+52,CL|🇨🇱|+56,CO|🇨🇴|+57,PE|🇵🇪|+51,VE|🇻🇪|+58,TH|🇹🇭|+66,VN|🇻🇳|+84,PH|🇵🇭|+63,MY|🇲🇾|+60,ID|🇮🇩|+62,TW|🇹🇼|+886' | split: ',' -%}
      {%- comment -%}
        The country list is intentionally compact (top markets, ~50 entries).
        Format per entry: ISO|FLAG|+CALLING_CODE
        For Shopify form submission only the calling code matters — it gets
        prefixed to the phone number to produce E.164 format.
      {%- endcomment -%}
      {%- for entry in countries -%}
        {%- assign parts = entry | split: '|' -%}
        {%- assign iso = parts[0] -%}
        {%- assign flag = parts[1] -%}
        {%- assign code = parts.last -%}
        <option value="{{ code }}" data-iso="{{ iso }}"{% if iso == cc_default %} selected{% endif %}>{{ flag }} {{ iso }} {{ code }}</option>
      {%- endfor -%}
    </select>
    <input
      type="tel"
      class="cpnb-phone__local"
      data-cpnb-phone-local
      id="cpnb-phone-local-{{ cc_scope }}"
      placeholder="{{ cc_placeholder | escape }}"
      aria-label="{{ cc_placeholder | escape }}"
      autocomplete="tel-national"
      inputmode="tel"
      {% if cc_required == 'true' %}required{% endif %}
    >
  </div>
  {%- comment -%}
    Hidden combined field — Shopify reads `contact[phone]` from newsletter
    customer form. Updated by JS as the visitor types / changes country.
    name attribute is set by JS at runtime so we don't accidentally submit
    an empty string before the visitor enters a number.
  {%- endcomment -%}
  <input type="hidden" data-cpnb-phone-combined value="">
</div>

<style>
  .cpnb-phone__row {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .cpnb-phone__cc,
  .cpnb-phone__local {
    min-height: 44px;
    border: max(1px, var(--inputs-border-width, 1px)) solid var(--color-border, #cccccc);
    border-radius: var(--input-border-radius, 8px);
    background: var(--input-bg, var(--color-background, #fff));
    color: var(--input-color, var(--color-text, #111));
    font-size: 16px;
  }
  .cpnb-phone__cc {
    flex: 0 0 auto;
    min-width: 110px;
    padding: 10px;
    cursor: pointer;
  }
  .cpnb-phone__local {
    flex: 1 1 auto;
    min-width: 0;
    padding: 12px 14px;
  }
  .cpnb-phone__local::placeholder { color: var(--input-placeholder-color, color-mix(in srgb, currentColor 55%, transparent)); }
  .cpnb-phone__cc:focus-visible,
  .cpnb-phone__local:focus-visible { outline: 2px solid var(--color-heading, currentColor); outline-offset: 1px; }
  .cpnb-phone__label {
    display: block;
    font-size: 13px;
    margin-bottom: 6px;
    opacity: .85;
  }
  @media (max-width: 480px) {
    .cpnb-phone__cc { min-width: 96px; }
  }
{% comment %}{% endcomment %}</style>

<script>
  (function(){
    // Wire every phone-field instance on this page. Runs at parse time;
    // safe because each snippet emits its own scoped script block.
    document.querySelectorAll('[data-cpnb-phone]').forEach(function(root){
      if (root.__cpnbPhoneWired) return;
      root.__cpnbPhoneWired = true;
      var cc = root.querySelector('[data-cpnb-phone-cc]');
      var local = root.querySelector('[data-cpnb-phone-local]');
      var combined = root.querySelector('[data-cpnb-phone-combined]');
      if (!cc || !local || !combined) return;

      function update(){
        var localValue = (local.value || '').replace(/\D+/g,'').replace(/^0+/,'');
        if (localValue.length === 0) {
          // Don't submit empty phone — clear the name so Shopify ignores it
          combined.removeAttribute('name');
          combined.value = '';
        } else {
          combined.setAttribute('name', 'contact[phone]');
          combined.value = cc.value + localValue;
        }
      }

      cc.addEventListener('change', update);
      local.addEventListener('input', update);

      // On form submit, ensure latest value is set (covers paste / autofill cases)
      var form = root.closest('form');
      if (form) form.addEventListener('submit', update, true);
    });
  })();
{% comment %}{% endcomment %}</script>

</template>