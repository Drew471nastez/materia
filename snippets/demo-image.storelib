<template compat="shopify">
{%- comment -%}
  Global Demo Image Fallback (Materia Prime)
  ------------------------------------------
  Single source of truth for every demo image (and demo video) URL in the theme.

  Returns a public URL for the given `key`, but ONLY when the "Demo Images"
  toggle is ON in Theme settings (settings.enable_demo_images). When the toggle
  is OFF, or the key is unknown, it returns nothing, so the section falls back to
  its normal empty / placeholder state.

  Matching uses `contains`, not exact equality, because Shopify's
  section.id / block.id arrive PREFIXED in JSON templates. The bare key is always
  present inside that string, so `contains` matches it reliably.

  Order matters: any key that is a substring of another (e.g. theme_logo vs
  theme_logo_mobile) MUST be checked most-specific-first.

  Files in this store's Files use demo_base; full Shopify-hosted video URLs are
  assigned to demo_full and emitted verbatim.

  Render order in each section is always:  merchant image > demo > placeholder.
{%- endcomment -%}
{%- liquid
  assign demo_base = 'https://cdn.shopify.com/s/files/1/0734/3724/9606/files/'
  assign demo_file = ''
  assign demo_full = ''

  # ---- Logo (header) ----
  if key contains 'theme_logo'
    assign demo_file = 'LUNEA_7_cc556f7c-7e88-4a25-b453-551c294268b8.png?v=1780297515&width=165'

  # ---- Countdown Promo Popup (overlay, key section.id) ----
  elsif key contains 'countdown_promo_popup'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_10_58_35_AM.png?v=1780300724&width=900'

  # ---- Homepage slideshow (first image slide) ----
  elsif key contains 'slider_item_fLBH4Y'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_10_21_05_AM.png?v=1780298472&width=1500'
  # ---- About slideshow ----
  elsif key contains 'slider_item_NBzkMf'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_01_05_54_PM.png?v=1780308364&width=1100'

  # ---- Social — Brand Logo (4 logos) ----
  elsif key contains 'brand_items_YR7n8E'
    assign demo_file = '2.svg?v=1780300061&width=240'
  elsif key contains 'brand_items_rkzAKh'
    assign demo_file = '12.svg?v=1780299940&width=240'
  elsif key contains 'brand_items_C9xD7a'
    assign demo_file = 'images.png?v=1780300213&width=185'
  elsif key contains 'brand_items_PqV7Vt'
    assign demo_file = 'images.jpg?v=1780300265&width=185'

  # ---- Product Benefits 4 (center image = section.id, 4 hotspots = block.id) ----
  elsif key contains 'product_benefits_4_3HNi6t'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_12_02_44_PM.png?v=1780304578&width=900'
  elsif key contains 'spot_etFhmA'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_12_19_38_PM.png?v=1780305587&width=200'
  elsif key contains 'spot_JbqxM6'
    assign demo_file = 'b4c3611b-8b05-4aef-80e9-b8f625a46888.png?v=1780306696&width=200'
  elsif key contains 'spot_zgFCJf'
    assign demo_file = '66c899e6-6447-4148-ac11-c3d08e8bb02f.png?v=1780305776&width=200'
  elsif key contains 'spot_4ezK39'
    assign demo_file = 'b5e302a4-aad1-4878-a6cb-0059c6d1ebb2.png?v=1780306486&width=200'

  # ---- Marquee Bar — FDA Approved image (first empty marquee block) ----
  elsif key contains 'marquee_xKwAD3'
    assign demo_file = '335-3358338_fda-logo-title-21-cfr-part-11-compliance.png?v=1780305954&width=60'

  # ---- Content Tabs (5 cards, home + product share images in order) ----
  elsif key contains 'tab_Eqb3Xj' or key contains 'tab_NMpeVt'
    assign demo_file = '0ceece51-df3f-482c-9b9b-0135a869e091.png?v=1780309134'
  elsif key contains 'tab_AJ8E9r' or key contains 'tab_CHk3mN'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_01_20_32_PM.png?v=1780309241'
  elsif key contains 'tab_7WLn3D' or key contains 'tab_g7xtDz'
    assign demo_file = '97522974-368c-4ca1-8692-aec1dc33fdca.png?v=1780309341'
  elsif key contains 'tab_W7Tcic' or key contains 'tab_rFCjp4'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_01_23_46_PM.png?v=1780309435'
  elsif key contains 'tab_RhWDxR' or key contains 'tab_HeWbJz'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_01_31_08_PM.png?v=1780309876'

  # ---- Featured Product — Happy customers (4 avatars) ----
  elsif key contains 'happy_customers_MijQ73_avatar_1'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.38.png?v=1780312543&width=200'
  elsif key contains 'happy_customers_MijQ73_avatar_2'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.51.png?v=1780312556&width=200'
  elsif key contains 'happy_customers_MijQ73_avatar_3'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.59.png?v=1780312564&width=200'
  elsif key contains 'happy_customers_MijQ73_avatar_4'
    assign demo_file = 'Screenshot_2026-06-01_at_14.16.40.png?v=1780312606&width=200'

  # ---- Video Testimonials 5 (4 video cards, home + product, demo_full) ----
  elsif key contains 'video_card_UWg9be' or key contains 'video_card_TF4fep'
    assign demo_full = 'https://cdn.shopify.com/videos/c/o/v/316bf06a477f4cfd9de96e39bee42155.mp4'
  elsif key contains 'video_card_NMTHLV' or key contains 'video_card_6neLrp'
    assign demo_full = 'https://cdn.shopify.com/videos/c/o/v/82877ca72c554722bfba2bb20c18ffb8.mp4'
  elsif key contains 'video_card_VUPUmf' or key contains 'video_card_3PaezH'
    assign demo_full = 'https://cdn.shopify.com/videos/c/o/v/b40053fec8f24939921b64b5baa60e56.mp4'
  elsif key contains 'video_card_ctinYt' or key contains 'video_card_paQQmj'
    assign demo_full = 'https://cdn.shopify.com/videos/c/o/v/71f64d723f384de3b7960813117865e3.mp4'

  # ---- Image With Text Steps (key section.id) ----
  elsif key contains 'image_with_text_steps_Hz6cqV'
    assign demo_file = 'ChatGPT_Image_Jun_1_2026_01_05_54_PM.png?v=1780308364&width=1200'

  # ---- Testimonials Grid (5 avatars, home + product share in order) ----
  elsif key contains 'testimonial_mKmJpt' or key contains 'testimonial_4VULYd'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.51.png?v=1780312556&width=160'
  elsif key contains 'testimonial_nM9PYe' or key contains 'testimonial_qNiW3B'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.59.png?v=1780312564&width=160'
  elsif key contains 'testimonial_J8yEL8' or key contains 'testimonial_AnHfd8'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.38.png?v=1780312543&width=160'
  elsif key contains 'testimonial_FtHDEV' or key contains 'testimonial_n7HV8m'
    assign demo_file = 'Screenshot_2026-06-01_at_14.16.40.png?v=1780312606&width=160'
  elsif key contains 'testimonial_ebeAe8' or key contains 'testimonial_KQA9dY'
    assign demo_file = 'ChatGPTImageJun1_2026_01_05_54PM.png?v=1780310886&width=160'

  # ---- About — Image & Video with Text (key section.id) ----
  elsif key contains 'image_and_video_text_4XdREa'
    assign demo_file = 'Screenshot_2026-06-01_at_14.15.38.png?v=1780312543&width=1400'
  elsif key contains 'image_and_video_text_xYtHXK'
    assign demo_file = '66c899e6-6447-4148-ac11-c3d08e8bb02f.png?v=1780305776&width=1400'
  endif

  if settings.enable_demo_images
    if demo_full != blank
      echo demo_full
    elsif demo_file != blank
      echo demo_base | append: demo_file
    endif
  endif
-%}

</template>