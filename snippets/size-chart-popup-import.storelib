<template compat="shopify">
{%- comment -%}
  Materia Themes. Size Chart Popup block (Main product, Featured product).
  The link opens a <dialog> drawn in the top layer by product-page-ui.js
  (data-mt-sheet-open): a bottom sheet on phones, a centred panel on larger
  screens. Escape, the backdrop and the 44px close button shut it, focus
  stays inside while it is open and goes back to the link afterwards. The
  dialog stays where it is in the page, so it keeps the section's colours.

  What it shows, first one found:
    Sizes: the block's Size chart, else the product's own size chart
    (product-size-chart-content: Storelib's size chart, a page or HTML in
    a metafield), else the chosen page.
    How to measure: the picture and rows A to C.
  A tab with nothing in it is left out; with nothing at all the link is
  not drawn on the live site.
{%- endcomment -%}
{%- assign fb_accessibility_measure_hips_desc = 'accessibility.measure_hips_desc' | t -%}
{%- assign fb_accessibility_hips = 'accessibility.hips' | t -%}
{%- assign fb_accessibility_measure_waist_desc = 'accessibility.measure_waist_desc' | t -%}
{%- assign fb_accessibility_waist = 'accessibility.waist' | t -%}
{%- assign fb_accessibility_chest = 'accessibility.chest' | t -%}
{%- assign fb_accessibility_how_to_measure = 'accessibility.how_to_measure' | t -%}
{%- assign fb_accessibility_sizes = 'accessibility.sizes' | t -%}
{%- assign fb_accessibility_size_guide = 'accessibility.size_guide' | t -%}
{%- assign sc = block.settings -%}
{%- capture sc_product_chart -%}{%- render 'product-size-chart-content', product: product, chart_id: block.id -%}{%- endcapture -%}
{%- liquid
  assign sc_align = sc.trig_align | default: 'left'
  assign sc_tabs = sc.enable_size_popup

  comment
    Sizes: the size chart given to the product in Storelib, the block's
    own chart, the product's chart field, then the page.
  endcomment
  assign sc_assigned = false
  if product.metafields.storelib.size_chart != blank
    assign sc_assigned = true
  elsif page.product.id == product.id and page.product.metafields.storelib.size_chart != blank
    assign sc_assigned = true
  endif
  assign sc_sizes = ''
  assign sc_sizes_plain = sc.sizes_content | strip_html | strip
  assign sc_chart_plain = sc_product_chart | strip_html | strip
  if sc_assigned
    assign sc_sizes = sc_product_chart
  elsif sc_sizes_plain != blank or sc.sizes_content contains '<img' or sc.sizes_content contains '<table'
    assign sc_sizes = sc.sizes_content
  elsif sc_chart_plain != blank or sc_product_chart contains '<img' or sc_product_chart contains '<table'
    assign sc_sizes = sc_product_chart
  elsif sc.sizes_page != blank
    assign sc_page = sc.sizes_page
    if sc_page.content != blank
      assign sc_sizes = sc_page.content
    else
      assign sc_sizes = pages[sc_page].content
    endif
  endif

  comment
    How to measure: a picture or any row with words.
  endcomment
  assign sc_measure = false
  if sc.measure_image != blank or sc.h_a_text != blank or sc.h_b_text != blank or sc.h_c_text != blank
    assign sc_measure = true
  endif

  assign sc_has_sizes = false
  if sc_sizes != blank
    assign sc_has_sizes = true
  endif
  assign sc_has = false
  if sc_tabs
    if sc_has_sizes or sc_measure
      assign sc_has = true
    endif
  elsif sc.chart_image != blank or sc_has_sizes
    assign sc_has = true
  endif
-%}
{%- capture sc_trig_color -%}{%- render 'scheme-color', color: sc.trig_color, fallback: 'var(--color-text)' -%}{%- endcapture -%}
{%- capture sc_icon_color -%}{%- render 'scheme-color', color: sc.icon_color, fallback: 'currentColor' -%}{%- endcapture -%}
{%- capture sc_modal_bg -%}{%- render 'scheme-color', color: sc.modal_bg, fallback: 'var(--color-background, #fff)' -%}{%- endcapture -%}
{%- capture sc_title_color -%}{%- render 'scheme-color', color: sc.title_color, fallback: 'var(--color-heading)' -%}{%- endcapture -%}

{%- if sc_has or request.design_mode -%}
<div id="SC-{{ block.id }}"
     class="scp scp--align-{{ sc_align }}"
     {{ block.shopify_attributes }}
     data-sc
     style="
       --sc-trig-fs: {{ sc.trig_font_size | default: 16 }}px;
       --sc-trig-fw: {{ sc.trig_font_weight | default: '600' }};
       --sc-trig-color: {{ sc_trig_color }};
       --sc-trig-gap: {{ sc.trig_gap | default: 8 }}px;
       --sc-trig-pad-t: {{ sc.trig_pad_t_d | default: 8 }}px;
       --sc-trig-pad-b: {{ sc.trig_pad_b_d | default: 8 }}px;
       --sc-trig-pad-l: {{ sc.trig_pad_l_d | default: 0 }}px;
       --sc-trig-pad-r: {{ sc.trig_pad_r_d | default: 0 }}px;
       --sc-trig-pad-t-t: {{ sc.trig_pad_t_t | default: sc.trig_pad_t_d | default: 8 }}px;
       --sc-trig-pad-b-t: {{ sc.trig_pad_b_t | default: sc.trig_pad_b_d | default: 8 }}px;
       --sc-trig-pad-l-t: {{ sc.trig_pad_l_t | default: sc.trig_pad_l_d | default: 0 }}px;
       --sc-trig-pad-r-t: {{ sc.trig_pad_r_t | default: sc.trig_pad_r_d | default: 0 }}px;
       --sc-trig-pad-t-m: {{ sc.trig_pad_t_m | default: sc.trig_pad_t_d | default: 8 }}px;
       --sc-trig-pad-b-m: {{ sc.trig_pad_b_m | default: sc.trig_pad_b_d | default: 8 }}px;
       --sc-trig-pad-l-m: {{ sc.trig_pad_l_m | default: sc.trig_pad_l_d | default: 0 }}px;
       --sc-trig-pad-r-m: {{ sc.trig_pad_r_m | default: sc.trig_pad_r_d | default: 0 }}px;
       --sc-icon-size: {{ sc.icon_size | default: 18 }}px;
       --sc-icon-color: {{ sc_icon_color }};
       --sc-modal-bg: {{ sc_modal_bg }};
       --sc-modal-radius: {{ sc.modal_radius | default: 12 }}px;
       --sc-modal-pad: {{ sc.modal_padding | default: 20 }}px;
       --scw-d: {{ sc.modal_width_d | default: 880 }}px;
       --scw-t: {{ sc.modal_width_t | default: 720 }}px;
       --sc-title-color: {{ sc_title_color }};
       --sc-title-fs: {{ sc.title_size | default: 18 }}px;
       --sc-title-fw: {{ sc.title_weight | default: '700' }};
       --sc-img-radius: {{ sc.image_radius | default: 8 }}px;
       --sc-img-fit: {{ sc.image_fit | default: 'contain' }};
     ">
  {%- if sc_has -%}
  <button type="button"
          class="scp__trigger{% if sc.underline_text %} scp__trigger--underline{% endif %}"
          data-mt-sheet-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="SCDialog-{{ block.id }}">
    <span class="scp__label">{{ sc.trig_text | default: fb_accessibility_size_guide }}</span>
    {%- if sc.show_icon -%}
    <span class="scp__icn" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="icn" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.5 14.5 14.5 3.5l6 6L9.5 20.5z"/>
        <path d="M7 11l1.5 1.5"/>
        <path d="M9.5 8.5 11 10"/>
        <path d="M12 6l1.5 1.5"/>
        <path d="M14.5 14.5l1.5 1.5"/>
      </svg>
    </span>
    {%- endif -%}
  </button>

  <dialog id="SCDialog-{{ block.id }}"
          class="mt-sheet scp__dialog"
          aria-labelledby="SCTitle-{{ block.id }}"
          data-scp-block="{{ block.id }}">
    <div class="mt-sheet__panel scp__modal">
      <div class="mt-sheet__head scp__head">
        <h2 id="SCTitle-{{ block.id }}" class="mt-sheet__title scp__title">{{ sc.modal_title | default: fb_accessibility_size_guide }}</h2>
        <button type="button" class="mt-sheet__close scp__close" data-mt-sheet-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>

      <div class="mt-sheet__body scp__body">
      {%- if sc_tabs -%}
        {%- if sc_has_sizes and sc_measure -%}
        <div class="scp__tabs" role="tablist" data-mt-tabs>
          <button type="button" role="tab" class="scp__tab is-active" id="SCTab-sizes-{{ block.id }}" aria-selected="true" aria-controls="sizes-{{ block.id }}" data-mt-tab>{{ sc.tab_sizes_label | default: fb_accessibility_sizes }}</button>
          <button type="button" role="tab" class="scp__tab" id="SCTab-measure-{{ block.id }}" aria-selected="false" aria-controls="measure-{{ block.id }}" tabindex="-1" data-mt-tab>{{ sc.tab_measure_label | default: fb_accessibility_how_to_measure }}</button>
        </div>
        {%- endif -%}

        {%- if sc_has_sizes -%}
        <div id="sizes-{{ block.id }}" class="scp__panel is-active"{% if sc_measure %} role="tabpanel" aria-labelledby="SCTab-sizes-{{ block.id }}" tabindex="0"{% endif %}>
          <div class="scp__page-wrap mt-sheet__table-wrap">{{ sc_sizes }}</div>
        </div>
        {%- endif -%}

        {%- if sc_measure -%}
        <div id="measure-{{ block.id }}" class="scp__panel{% unless sc_has_sizes %} is-active{% endunless %}"{% if sc_has_sizes %} role="tabpanel" aria-labelledby="SCTab-measure-{{ block.id }}" tabindex="0" hidden{% endif %}>
          {%- unless sc_has_sizes -%}<h3 class="scp__subhead">{{ sc.tab_measure_label | default: fb_accessibility_how_to_measure }}</h3>{%- endunless -%}
          <div class="scp__measure-grid{% if sc.measure_image == blank %} scp__measure-grid--text{% endif %}">
            {%- if sc.measure_image != blank -%}
            <div class="scp__measure-img">
              {{ sc.measure_image | image_url: width: 1200 | image_tag: loading: 'lazy', decoding: 'async', alt: sc.measure_image.alt, class: 'img', widths: '480, 800, 1200', sizes: '(min-width: 768px) 360px, 100vw' }}
            </div>
            {%- endif -%}
            <div class="scp__measure-text">
              {%- if sc.h_a_text != blank -%}
              <div class="row">
                <p class="mtitle">A. {{ sc.h_a_title | default: fb_accessibility_chest }}</p>
                <p class="mbody">{{ sc.h_a_text }}</p>
              </div>
              {%- endif -%}
              {%- if sc.h_b_text != blank -%}
              <div class="row">
                <p class="mtitle">B. {{ sc.h_b_title | default: fb_accessibility_waist }}</p>
                <p class="mbody">{{ sc.h_b_text }}</p>
              </div>
              {%- endif -%}
              {%- if sc.h_c_text != blank -%}
              <div class="row">
                <p class="mtitle">C. {{ sc.h_c_title | default: fb_accessibility_hips }}</p>
                <p class="mbody">{{ sc.h_c_text }}</p>
              </div>
              {%- endif -%}
            </div>
          </div>
        </div>
        {%- endif -%}
      {%- else -%}
        {%- if sc.chart_image != blank -%}
        <div class="scp__imgwrap
                    {%- case sc.image_ratio -%}
                      {%- when '1_1' -%} ar-1-1
                      {%- when '4_5' -%} ar-4-5
                      {%- when '3_4' -%} ar-3-4
                      {%- when '2_3' -%} ar-2-3
                      {%- when '4_3' -%} ar-4-3
                      {%- when '3_2' -%} ar-3-2
                      {%- when '16_9' -%} ar-16-9
                      {%- when '9_16' -%} ar-9-16
                    {%- endcase -%}">
          <img
            src="{{ sc.chart_image | image_url: width: 1440 }}"
            srcset="
              {{ sc.chart_image | image_url: width: 480 }} 480w,
              {{ sc.chart_image | image_url: width: 800 }} 800w,
              {{ sc.chart_image | image_url: width: 1200 }} 1200w,
              {{ sc.chart_image | image_url: width: 1440 }} 1440w
            "
            sizes="(max-width: 768px) 100vw, 880px"
            alt="{{ sc.chart_image.alt | default: sc.modal_title | escape }}"
            width="{{ sc.chart_image.width }}"
            height="{{ sc.chart_image.height }}"
            class="scp__img"
            loading="lazy"
            decoding="async">
        </div>
        {%- elsif sc_has_sizes -%}
        <div class="scp__page-wrap mt-sheet__table-wrap">{{ sc_sizes }}</div>
        {%- endif -%}
      {%- endif -%}
      </div>
    </div>
  </dialog>
  {%- else -%}
    <p class="pib-note">Only you see this note. Give this product a size chart in Storelib under Products &gt; Size charts, or add How to measure rows or a chart picture, to show the size guide link.</p>
  {%- endif -%}
</div>

<style>
  #SC-{{ block.id }} { display: flex; width: 100%; }
  #SC-{{ block.id }}.scp--align-left   { justify-content: flex-start; }
  #SC-{{ block.id }}.scp--align-center { justify-content: center; }
  #SC-{{ block.id }}.scp--align-right  { justify-content: flex-end; }

  #SC-{{ block.id }} .scp__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--sc-trig-gap);
    min-height: 44px;
    padding: var(--sc-trig-pad-t) var(--sc-trig-pad-r) var(--sc-trig-pad-b) var(--sc-trig-pad-l);
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--body-font, inherit);
    font-size: var(--sc-trig-fs);
    font-weight: var(--sc-trig-fw);
    color: var(--sc-trig-color);
    line-height: 1.2;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  #SC-{{ block.id }} .scp__trigger--underline .scp__label {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  #SC-{{ block.id }} .scp__icn {
    display: inline-flex;
    width: var(--sc-icon-size);
    height: var(--sc-icon-size);
    color: var(--sc-icon-color);
    flex: 0 0 auto;
  }
  #SC-{{ block.id }} .scp__icn .icn { width: 100%; height: 100%; }
  #SC-{{ block.id }} .scp__trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
  @media (max-width: 1024px) {
    #SC-{{ block.id }} .scp__trigger { padding: var(--sc-trig-pad-t-t) var(--sc-trig-pad-r-t) var(--sc-trig-pad-b-t) var(--sc-trig-pad-l-t); }
  }
  @media (max-width: 767px) {
    #SC-{{ block.id }} .scp__trigger { padding: var(--sc-trig-pad-t-m) var(--sc-trig-pad-r-m) var(--sc-trig-pad-b-m) var(--sc-trig-pad-l-m); }
  }

  /* The sheet itself: product-page-ui.css (dialog.mt-sheet). Here only
     the block's own colours, width, radius and padding. */
  #SCDialog-{{ block.id }} .scp__modal {
    background: var(--sc-modal-bg);
    border-radius: var(--sc-modal-radius) var(--sc-modal-radius) 0 0;
  }
  #SCDialog-{{ block.id }} .scp__head { padding-inline-start: var(--sc-modal-pad); }
  #SCDialog-{{ block.id }} .scp__body { padding: 16px var(--sc-modal-pad) calc(var(--sc-modal-pad) + env(safe-area-inset-bottom, 0px)); }
  #SCDialog-{{ block.id }} .scp__title {
    color: var(--sc-title-color);
    font-size: var(--sc-title-fs);
    font-weight: var(--sc-title-fw);
  }
  #SCDialog-{{ block.id }} .scp__close { color: var(--sc-title-color); }
  @media (min-width: 768px) {
    #SCDialog-{{ block.id }} .scp__modal {
      max-width: min(var(--scw-t), 100%);
      border-radius: var(--sc-modal-radius);
    }
    #SCDialog-{{ block.id }} .scp__body { padding-bottom: var(--sc-modal-pad); }
  }
  @media (min-width: 1025px) {
    #SCDialog-{{ block.id }} .scp__modal { max-width: min(var(--scw-d), 100%); }
  }

  #SCDialog-{{ block.id }} .scp__tabs {
    display: flex;
    gap: 24px;
    margin: 0 0 18px;
    border-bottom: 1px solid var(--color-border);
  }
  #SCDialog-{{ block.id }} .scp__tab {
    position: relative;
    min-height: 44px;
    padding: 10px 2px;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    font: inherit;
    font-weight: 500;
    white-space: nowrap;
    transition: color .2s ease;
  }
  #SCDialog-{{ block.id }} .scp__tab::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--sc-title-color);
    transform: scaleX(0);
    transition: transform .25s cubic-bezier(.4, 0, .2, 1);
  }
  #SCDialog-{{ block.id }} .scp__tab.is-active { color: var(--sc-title-color); font-weight: 600; }
  #SCDialog-{{ block.id }} .scp__tab.is-active::after { transform: scaleX(1); }
  #SCDialog-{{ block.id }} .scp__tab:focus-visible { outline: 2px solid var(--sc-title-color); outline-offset: 2px; }
  #SCDialog-{{ block.id }} .scp__panel[hidden] { display: none; }
  #SCDialog-{{ block.id }} .scp__panel.is-active { animation: scpFade .24s ease; }
  @keyframes scpFade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  #SCDialog-{{ block.id }} .scp__subhead {
    margin: 0 0 12px;
    color: var(--sc-title-color);
    font-size: calc(var(--body-font-size, 15px) + 1px);
    font-weight: 600;
  }

  #SCDialog-{{ block.id }} .scp__page-wrap table:not(.mt-size-chart__table) { width: 100%; border-collapse: collapse; }
  #SCDialog-{{ block.id }} .scp__page-wrap table:not(.mt-size-chart__table) :is(th, td) { padding: 10px 12px; border: 1px solid var(--color-border); text-align: start; }
  #SCDialog-{{ block.id }} .scp__page-wrap table:not(.mt-size-chart__table) th { background: color-mix(in srgb, var(--color-text) 5%, transparent); color: var(--color-heading); font-weight: 600; }
  #SCDialog-{{ block.id }} .mt-size-chart { --sz-bg: var(--sc-modal-bg); }

  #SCDialog-{{ block.id }} .scp__measure-grid { display: grid; gap: 20px; align-items: start; }
  #SCDialog-{{ block.id }} .scp__measure-img .img { display: block; width: 100%; height: auto; border-radius: var(--sc-img-radius); }
  #SCDialog-{{ block.id }} .scp__measure-text .row + .row { margin-top: 16px; }
  #SCDialog-{{ block.id }} .scp__measure-text .mtitle { margin: 0 0 4px; color: var(--sc-title-color); font-weight: 600; }
  #SCDialog-{{ block.id }} .scp__measure-text .mbody { margin: 0; }
  @media (min-width: 768px) {
    #SCDialog-{{ block.id }} .scp__measure-grid:not(.scp__measure-grid--text) { grid-template-columns: 1fr 1fr; gap: 24px; }
  }

  #SCDialog-{{ block.id }} .scp__imgwrap { width: 100%; border-radius: var(--sc-img-radius); overflow: hidden; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-1-1  { aspect-ratio: 1 / 1; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-4-5  { aspect-ratio: 4 / 5; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-3-4  { aspect-ratio: 3 / 4; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-2-3  { aspect-ratio: 2 / 3; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-4-3  { aspect-ratio: 4 / 3; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-3-2  { aspect-ratio: 3 / 2; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-16-9 { aspect-ratio: 16 / 9; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-9-16 { aspect-ratio: 9 / 16; }
  #SCDialog-{{ block.id }} .scp__img { display: block; width: 100%; height: auto; object-fit: var(--sc-img-fit); }
  #SCDialog-{{ block.id }} .scp__imgwrap[class*="ar-"] .scp__img { height: 100%; }
  @media (prefers-reduced-motion: reduce) {
    #SCDialog-{{ block.id }} .scp__panel.is-active { animation: none; }
    #SCDialog-{{ block.id }} :is(.scp__tab, .scp__tab::after) { transition: none; }
  }
{% comment %}{% endcomment %}</style>
{%- endif -%}
</template>
