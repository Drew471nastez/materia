<template compat="shopify">
{%- assign fb_accessibility_measure_hips_desc = 'accessibility.measure_hips_desc' | t -%}
{%- assign fb_accessibility_hips = 'accessibility.hips' | t -%}
{%- assign fb_accessibility_measure_waist_desc = 'accessibility.measure_waist_desc' | t -%}
{%- assign fb_accessibility_waist = 'accessibility.waist' | t -%}
{%- assign fb_accessibility_chest = 'accessibility.chest' | t -%}
{%- assign fb_accessibility_how_to_measure = 'accessibility.how_to_measure' | t -%}
{%- assign fb_accessibility_sizes = 'accessibility.sizes' | t -%}
{%- assign fb_accessibility_size_guide = 'accessibility.size_guide' | t -%}
{%- assign sc = block.settings -%}
{%- assign sc_align = sc.trig_align | default: 'left' -%}

<div id="SC-{{ block.id }}"
     class="scp scp--align-{{ sc_align }}"
     {{ block.shopify_attributes }}
     data-sc
     style="
       /* trigger */
       --sc-trig-fs: {{ sc.trig_font_size | default: 16 }}px;
       --sc-trig-fw: {{ sc.trig_font_weight | default: '600' }};
       --sc-trig-color: {%- if sc.trig_color == blank or sc.trig_color == 'rgba(0,0,0,0)' -%}var(--color-text, #111111){%- else -%}{{ sc.trig_color }}{%- endif -%};
       --sc-trig-gap: {{ sc.trig_gap | default: 8 }}px;
       --sc-trig-pad-t: {{ sc.trig_pad_t_d | default: 8 }}px;
       --sc-trig-pad-b: {{ sc.trig_pad_b_d | default: 8 }}px;
       --sc-trig-pad-l: {{ sc.trig_pad_l_d | default: 0 }}px;
       --sc-trig-pad-r: {{ sc.trig_pad_r_d | default: 0 }}px;

       /* modal */
       --sc-modal-bg: {%- if sc.modal_bg == blank or sc.modal_bg == 'rgba(0,0,0,0)' -%}var(--color-background, #ffffff){%- else -%}{{ sc.modal_bg }}{%- endif -%};
       --sc-modal-radius: {{ sc.modal_radius | default: 12 }}px;
       --sc-modal-pad: {{ sc.modal_padding | default: 20 }}px;
       --scw-d: {{ sc.modal_width_d | default: 880 }}px;
       --scw-t: {{ sc.modal_width_t | default: 720 }}px;
       --scw-m: {{ sc.modal_width_m | default: 360 }}px;

       {%- comment -%}
         Title + icon colours. Schema default is `rgba(0,0,0,0)` (transparent) —
         Liquid's `default:` filter doesn't fire on transparent (it only fires
         on `nil`/empty string), so the previous `default: '#111111'` was a
         no-op and the popup rendered with INVISIBLE / hardcoded-black text.
         Detect transparent explicitly and fall through to scheme vars so
         "leave transparent to inherit scheme" actually works the same way
         the Info Box block does. Picking a real colour still overrides.
       {%- endcomment -%}
       /* title */
       --sc-title-color: {%- if sc.title_color == blank or sc.title_color == 'rgba(0,0,0,0)' -%}var(--color-heading, var(--color-text, #111111)){%- else -%}{{ sc.title_color }}{%- endif -%};
       --sc-title-fs: {{ sc.title_size | default: 18 }}px;
       --sc-title-fw: {{ sc.title_weight | default: '700' }};

       /* icon */
       --sc-icon-size: {{ sc.icon_size | default: 18 }}px;
       --sc-icon-color: {%- if sc.icon_color == blank or sc.icon_color == 'rgba(0,0,0,0)' -%}var(--color-text, #111111){%- else -%}{{ sc.icon_color }}{%- endif -%};
     ">

  <button type="button"
          class="scp__trigger{% if sc.underline_text %} scp__trigger--underline{% endif %}"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="SCDialog-{{ block.id }}">
    <span class="scp__label">{{ sc.trig_text | default: fb_accessibility_size_guide }}</span>
    {%- if sc.show_icon -%}
    <span class="scp__icn" aria-hidden="true">
      {%- comment -%}
        Ruler / measuring-tape glyph — matches the merchant's reference
        design. Stroke-based so it picks up `currentColor` and scales
        cleanly at any size.
      {%- endcomment -%}
      <svg viewBox="0 0 24 24" class="icn" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.5 14.5 14.5 3.5l6 6L9.5 20.5z"/>
        <path d="M7 11l1.5 1.5"/>
        <path d="M9.5 8.5 11 10"/>
        <path d="M12 6l1.5 1.5"/>
        <path d="M14.5 14.5l1.5 1.5"/>
      </svg>
    </span>
    {%- endif -%}
  </button>

 
  <div id="SCOverlay-{{ block.id }}" class="scp__overlay" data-overlay hidden></div>

  <div id="SCDialog-{{ block.id }}"
       class="scp__dialog"
       role="dialog"
       aria-modal="true"
       aria-labelledby="SCTitle-{{ block.id }}"
       data-dialog
       data-scp-block="{{ block.id }}"
       hidden>

    <div class="scp__modal" data-modal>

      <div class="scp__head">
        <h3 id="SCTitle-{{ block.id }}" class="scp__title">{{ sc.modal_title | default: fb_accessibility_size_guide }}</h3>
        <button type="button" class="scp__close" aria-label="{{ 'accessibility.close_esc' | t }}" data-close>
          <svg viewBox="0 0 24 24" class="icn" xmlns="http://www.w3.org/2000/svg">
            <path fill="currentColor" d="M18.3 5.71L12 12l6.3 6.29-1.41 1.41L10.59 13.41 4.29 19.7 2.88 18.29 9.17 12 2.88 5.71 4.29 4.29 10.59 10.59 16.89 4.29z"/>
          </svg>
        </button>
      </div>

      {%- if sc.enable_size_popup -%}
        <!-- Tabs -->
        <div class="scp__tabs">
          <button type="button" class="scp__tab is-active" data-tab="sizes-{{ block.id }}">{{ sc.tab_sizes_label | default: fb_accessibility_sizes }}</button>
          <button type="button" class="scp__tab" data-tab="measure-{{ block.id }}">{{ sc.tab_measure_label | default: fb_accessibility_how_to_measure }}</button>
        </div>


        <div id="sizes-{{ block.id }}" class="scp__panel is-active">
          <div class="scp__page-wrap">
            {%- if sc.sizes_page != blank -%}
              {{ sc.sizes_page.content }}
            {%- else -%}
              <p style="margin:0;">Assign a “Page containing size chart” in the block settings.</p>
            {%- endif -%}
          </div>
        </div>

    
        <div id="measure-{{ block.id }}" class="scp__panel">
          <div class="scp__measure-grid">
            <div class="scp__measure-img">
              {%- if sc.measure_image != blank -%}
                {{ sc.measure_image | image_url: width: 1440 | image_tag: loading: 'lazy', alt: 'How to measure', class: 'img' }}
              {%- else -%}
                <div class="scp__placeholder" aria-hidden="true">
                  <svg viewBox="0 0 64 48" xmlns="http://www.w3.org/2000/svg" class="ph">
                    <rect x="1" y="1" width="62" height="46" rx="4" fill="#d9d9d9"/>
                    <path d="M8 34l10-12 10 11 8-8 12 13H8z" fill="#c6c6c6"/>
                    <circle cx="23" cy="17" r="4" fill="#c6c6c6"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            <div class="scp__measure-text">
              <div class="row">
                <p class="mtitle">A. {{ sc.h_a_title | default: fb_accessibility_chest }}:</p>
                <p class="mbody">{{ sc.h_a_text | default: 'Measure around the fullest part of your chest, keeping the measuring tape horizontal.' }}</p>
              </div>
              <div class="row">
                <p class="mtitle">B. {{ sc.h_b_title | default: fb_accessibility_waist }}:</p>
                <p class="mbody">{{ sc.h_b_text | default: fb_accessibility_measure_waist_desc }}</p>
              </div>
              <div class="row">
                <p class="mtitle">C. {{ sc.h_c_title | default: fb_accessibility_hips }}:</p>
                <p class="mbody">{{ sc.h_c_text | default: fb_accessibility_measure_hips_desc }}</p>
              </div>
            </div>
          </div>
        </div>
      {%- else -%}
  
        <div class="scp__imgwrap
                    {%- case sc.image_ratio -%}
                      {%- when '1_1' -%} ar-1-1
                      {%- when '4_5' -%} ar-4-5
                      {%- when '3_4' -%} ar-3-4
                      {%- when '2_3' -%} ar-2-3
                      {%- when '4_3' -%} ar-4-3
                      {%- when '3_2' -%} ar-3-2
                      {%- when '16_9' -%} ar-16-9
                      {%- when '9_16' -%} ar-9-16
                    {%- endcase -%}">
          {%- if sc.chart_image != blank -%}
            <img
              src="{{ sc.chart_image | image_url: width: 1440 }}"
              srcset="
                {{ sc.chart_image | image_url: width: 480 }} 480w,
                {{ sc.chart_image | image_url: width: 800 }} 800w,
                {{ sc.chart_image | image_url: width: 1200 }} 1200w,
                {{ sc.chart_image | image_url: width: 1440 }} 1440w
              "
              sizes="(max-width: 768px) 90vw, (max-width: 1024px) 70vw, 50vw"
              alt="{{ sc.modal_title | escape }}"
              class="scp__img"
              loading="lazy"
              decoding="async">
          {%- else -%}
            <div class="scp__placeholder" aria-hidden="true">
              <svg viewBox="0 0 64 48" xmlns="http://www.w3.org/2000/svg" class="ph">
                <rect x="1" y="1" width="62" height="46" rx="4" fill="#d9d9d9"/>
                <path d="M8 34l10-12 10 11 8-8 12 13H8z" fill="#c6c6c6"/>
                <circle cx="23" cy="17" r="4" fill="#c6c6c6"/>
              </svg>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>

  #SC-{{ block.id }} .icn { width: 1em; height: 1em; display: inline-block; }

  /* Wrapper alignment — controls where the trigger sits in its container
     (left / center / right). Uses flex so the underline only spans the
     text + icon, not the full row. */
  #SC-{{ block.id }}{
    display: flex;
    width: 100%;
  }
  #SC-{{ block.id }}.scp--align-left   { justify-content: flex-start; }
  #SC-{{ block.id }}.scp--align-center { justify-content: center; }
  #SC-{{ block.id }}.scp--align-right  { justify-content: flex-end; }

  #SC-{{ block.id }} .scp__trigger{
    display: inline-flex;
    align-items: center;
    gap: var(--sc-trig-gap);
    padding: var(--sc-trig-pad-t) var(--sc-trig-pad-r) var(--sc-trig-pad-b) var(--sc-trig-pad-l);
    background: transparent;
    border: 0;
    cursor: pointer;
    font-size: var(--sc-trig-fs);
    font-weight: var(--sc-trig-fw);
    color: var(--sc-trig-color);
    line-height: 1.2;
    font-family: inherit;
    text-decoration: none;
  }
  #SC-{{ block.id }} .scp__trigger--underline .scp__label{
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  #SC-{{ block.id }} .scp__trigger .scp__icn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sc-icon-size);
    height: var(--sc-icon-size);
    color: var(--sc-icon-color);
    flex: 0 0 auto;
  }
  #SC-{{ block.id }} .scp__trigger .scp__icn .icn{
    width: 100%;
    height: 100%;
  }
  #SC-{{ block.id }} .scp__trigger:focus-visible{ outline: 2px solid #000; outline-offset: 2px; }


  /* The schema only exposes one set of trigger paddings (used at every
     breakpoint), so the responsive overrides below were referencing
     non-existent settings. Removed — the desktop values now apply
     everywhere, and the schema stays clean. */

  /* Dialog + overlay are moved to <body> at runtime so position:fixed
     works inside transformed parents. CSS therefore targets them via
     their unique IDs so the styles apply regardless of DOM location. */
  #SCOverlay-{{ block.id }}{
    position: fixed; inset: 0;
    background: rgba(0,0,0,.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0; pointer-events: none;
    transition: opacity .18s ease;
    z-index: 100000;
  }
  #SCOverlay-{{ block.id }}.is-open{ opacity: 1; pointer-events: auto; }
  #SCOverlay-{{ block.id }}[hidden]{ display: none !important; }

  #SCDialog-{{ block.id }}{
    position: fixed; inset: 0; display: grid; place-items: center;
    z-index: 100001;
    padding: 16px;
    box-sizing: border-box;
    --scw-d: {{ sc.modal_width_d | default: 880 }}px;
    --scw-t: {{ sc.modal_width_t | default: 720 }}px;
    --scw-m: {{ sc.modal_width_m | default: 360 }}px;
    /* The dialog gets moved to <body> at runtime (see JS), so it can't
       inherit the trigger element's inline custom-property block. We
       resolve `--sc-modal-bg` here directly. The schema saves
       `rgba(0,0,0,0)` for the unset state, which is NOT blank — Liquid's
       `default:` filter doesn't fire on transparent strings, so the
       previous `default: '#FFFFFF'` was a no-op and the modal painted
       transparent. Explicit transparent check + white fallback fixes the
       "background not white" bug. */
    --sc-modal-bg: {%- if sc.modal_bg == blank or sc.modal_bg == 'rgba(0,0,0,0)' -%}#FFFFFF{%- else -%}{{ sc.modal_bg }}{%- endif -%};
    --sc-modal-radius: {{ sc.modal_radius | default: 12 }}px;
    --sc-modal-pad: {{ sc.modal_padding | default: 20 }}px;
    --sc-title-color: {%- if sc.title_color == blank or sc.title_color == 'rgba(0,0,0,0)' -%}#111111{%- else -%}{{ sc.title_color }}{%- endif -%};
    --sc-title-fs: {{ sc.title_size | default: 18 }}px;
    --sc-title-fw: {{ sc.title_weight | default: '700' }};
  }
  #SCDialog-{{ block.id }}[hidden]{ display: none !important; }

  #SCDialog-{{ block.id }} *,
  #SCDialog-{{ block.id }} *::before,
  #SCDialog-{{ block.id }} *::after { box-sizing: border-box; }

  #SCDialog-{{ block.id }} .icn { width: 1em; height: 1em; display: inline-block; }

  #SCDialog-{{ block.id }} .scp__modal{
    width: var(--scw-d);
    max-width: calc(100vw - 24px);
    /* Use dynamic viewport units where supported so mobile browser chrome
       (URL bar, gesture bar) doesn't clip the modal mid-scroll. Falls
       back to `100vh` on older browsers. */
    max-height: calc(100vh - 24px);
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
    /* Hardware-accelerated smooth scroll on iOS. */
    -webkit-overflow-scrolling: touch;
    background: var(--sc-modal-bg);
    border-radius: var(--sc-modal-radius);
    box-shadow: 0 10px 30px rgba(0,0,0,.18);
    padding: 0;
    /* Inner padding moved to a child wrapper so the sticky header can sit
       flush with the top edge of the modal (no double-padding seam). */
    transform: translateY(8px) scale(.985);
    opacity: 0;
    transition: transform .28s cubic-bezier(.22, 1, .36, 1), opacity .22s ease;
    color: #111;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.5;
    /* Make the modal a positioning context for the sticky header */
    position: relative;
  }
  #SCDialog-{{ block.id }}.is-open .scp__modal{
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  @media (max-width:1024px){
    #SCDialog-{{ block.id }} .scp__modal{ width: var(--scw-t); }
  }
  @media (max-width:768px){
    #SCDialog-{{ block.id }} .scp__modal{
      width: var(--scw-m);
      max-width: calc(100vw - 16px);
      max-height: calc(100vh - 16px);
      max-height: calc(100dvh - 16px);
      border-radius: calc(var(--sc-modal-radius) - 2px);
    }
  }

  /* Sticky header — the close button must remain visible and tappable
     regardless of how much page content the merchant loads into the
     modal (a long Shopify size-guide page can be hundreds of rows
     long). Pinning the header to the top of the scrolling modal keeps
     "X" available without the user having to scroll back up.

     Backdrop-filter blur + scheme-aware translucent layer so the
     header reads as a header (separated from content) on every theme. */
  #SCDialog-{{ block.id }} .scp__head{
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: var(--sc-modal-pad) var(--sc-modal-pad) 12px;
    margin: 0;
    background: var(--sc-modal-bg);
    border-radius: var(--sc-modal-radius) var(--sc-modal-radius) 0 0;
    /* Soft bottom edge that fades into the scrolling content. */
    box-shadow: 0 4px 12px -8px color-mix(in srgb, currentColor 30%, transparent);
  }
  /* Modal padding was zeroed so the sticky header can sit flush at top.
     Restore left/right + bottom padding on every direct child of the
     modal that isn't the header. The modal lives directly inside the
     dialog (the JS moves the dialog to <body>, but the modal stays
     nested inside the dialog), so the direct-child selector matches. */
  #SCDialog-{{ block.id }} > .scp__modal > :not(.scp__head) {
    padding-left: var(--sc-modal-pad);
    padding-right: var(--sc-modal-pad);
  }
  #SCDialog-{{ block.id }} > .scp__modal > :last-child {
    padding-bottom: var(--sc-modal-pad);
  }
  #SCDialog-{{ block.id }} .scp__title{
    margin: 0;
    color: var(--sc-title-color);
    font-size: var(--sc-title-fs);
    font-weight: var(--sc-title-fw);
    line-height: 1.25;
    /* Title is allowed to wrap, but we cap so it never pushes the
       close button off-screen on narrow phones with very long titles. */
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  #SCDialog-{{ block.id }} .scp__close{
    border: 0;
    background: rgba(0,0,0,.04);
    cursor: pointer;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 999px;
    color: var(--sc-title-color);
    flex: 0 0 auto;
    /* Make the X feel tactile — soft hover scale + smooth color fade. */
    transition: background-color .2s ease, transform .15s ease, color .2s ease;
  }
  #SCDialog-{{ block.id }} .scp__close:hover{
    background: rgba(0,0,0,.10);
    transform: scale(1.06);
  }
  #SCDialog-{{ block.id }} .scp__close:active{ transform: scale(.94); }
  #SCDialog-{{ block.id }} .scp__close:focus-visible{ outline: 2px solid currentColor; outline-offset: 2px; }
  #SCDialog-{{ block.id }} .scp__close .icn{ width: 18px; height: 18px; }
  /* Bigger touch target on phones — Apple HIG / Material both recommend
     ≥44px. The button still LOOKS the same size visually (40px), but
     gains an invisible padded hit area via the surrounding box. */
  @media (max-width: 768px){
    #SCDialog-{{ block.id }} .scp__close{
      width: 44px; height: 44px;
    }
    #SCDialog-{{ block.id }} .scp__close .icn{ width: 20px; height: 20px; }
    #SCDialog-{{ block.id }} .scp__head{
      padding: 14px 14px 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #SCDialog-{{ block.id }} .scp__modal,
    #SCDialog-{{ block.id }} .scp__close {
      transition: none !important;
      transform: none !important;
    }
  }

  /* Tabs row — minimal underline tabs. No pill container, no shadows,
     no overlap edges. Active tab is identified by a 2px bottom bar
     in the title colour; inactive tabs are muted text. Clean, modern,
     and zero risk of the "overflow into margin" issue the pill design
     produced. */
  #SCDialog-{{ block.id }} .scp__tabs{
    display: flex;
    gap: 28px;
    margin-top: 18px;
    margin-bottom: 22px;
    padding: 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  #SCDialog-{{ block.id }} .scp__tab{
    position: relative;
    background: transparent;
    border: 0;
    padding: 10px 2px;
    cursor: pointer;
    border-radius: 0;
    color: color-mix(in srgb, currentColor 55%, transparent);
    font-weight: 500;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: color .2s ease;
  }
  /* Underline bar — same width as the tab text, sits ON the bottom
     border of the tabs row. Inactive tabs render it transparent so the
     row's own bottom border shows through cleanly. */
  #SCDialog-{{ block.id }} .scp__tab::after{
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: transparent;
    transition: background-color .2s ease;
  }
  #SCDialog-{{ block.id }} .scp__tab:hover{
    color: color-mix(in srgb, currentColor 85%, transparent);
  }
  #SCDialog-{{ block.id }} .scp__tab.is-active{
    color: var(--sc-title-color);
    font-weight: 600;
  }
  #SCDialog-{{ block.id }} .scp__tab.is-active::after{
    background: var(--sc-title-color);
  }
  #SCDialog-{{ block.id }} .scp__tab:focus-visible{
    outline: 2px solid color-mix(in srgb, currentColor 40%, transparent);
    outline-offset: 4px;
  }
  @media (max-width: 768px){
    #SCDialog-{{ block.id }} .scp__tabs{ gap: 20px; margin-top: 14px; margin-bottom: 18px; }
    #SCDialog-{{ block.id }} .scp__tab{ font-size: 13px; padding: 9px 2px; }
  }

  #SCDialog-{{ block.id }} .scp__panel{ display: none; }
  #SCDialog-{{ block.id }} .scp__panel.is-active{ display: block; }

  #SCDialog-{{ block.id }} .scp__page-wrap{ width: 100%; overflow-x: auto; }
  #SCDialog-{{ block.id }} .scp__page-wrap table{ width: 100%; border-collapse: collapse; }
  #SCDialog-{{ block.id }} .scp__page-wrap th,
  #SCDialog-{{ block.id }} .scp__page-wrap td{ padding: 10px 12px; border: 1px solid #e5e7eb; text-align: left; }
  #SCDialog-{{ block.id }} .scp__page-wrap th{ background: #f9fafb; font-weight: 700; }

  #SCDialog-{{ block.id }} .scp__measure-grid{
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start;
  }
  #SCDialog-{{ block.id }} .scp__measure-img .img{ width: 100%; height: auto; border-radius: 8px; display: block; }
  #SCDialog-{{ block.id }} .scp__measure-text .row{ margin-bottom: 18px; }
  #SCDialog-{{ block.id }} .scp__measure-text .mtitle{ margin: 0 0 6px 0; font-weight: 700; }
  #SCDialog-{{ block.id }} .scp__measure-text .mbody{ margin: 0; line-height: 1.6; color: #333; }
  @media (max-width: 900px){
    #SCDialog-{{ block.id }} .scp__measure-grid{ grid-template-columns: 1fr; }
  }

  #SCDialog-{{ block.id }} .scp__imgwrap{ width: 100%; border-radius: {{ sc.image_radius | default: 8 }}px; overflow: hidden; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-1-1   { aspect-ratio: 1 / 1; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-4-5   { aspect-ratio: 4 / 5; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-3-4   { aspect-ratio: 3 / 4; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-2-3   { aspect-ratio: 2 / 3; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-4-3   { aspect-ratio: 4 / 3; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-3-2   { aspect-ratio: 3 / 2; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-16-9  { aspect-ratio: 16 / 9; }
  #SCDialog-{{ block.id }} .scp__imgwrap.ar-9-16  { aspect-ratio: 9 / 16; }

  #SCDialog-{{ block.id }} .scp__img,
  #SCDialog-{{ block.id }} .scp__placeholder{ width: 100%; height: 100%; display: block; }
  #SCDialog-{{ block.id }} .scp__img{
    object-fit: {{ sc.image_fit | default: 'contain' }};
    background: #f5f5f5;
    border-radius: inherit;
  }
  #SCDialog-{{ block.id }} .scp__placeholder{ display: grid; place-items: center; background: #d0d0d0; }
  #SCDialog-{{ block.id }} .scp__placeholder .ph{ width: 70%; height: auto; }

  /* Prevent body scroll when open */
  html.scp-lock { overflow: hidden; }

  /* ───── Modern slim scrollbar (vertical + horizontal) ─────
     Applied to the modal itself + every inner scroll context
     (page-wrap for wide tables, tabs row for overflow). Uses
     `currentColor` so it adapts to scheme color automatically.

     Firefox uses the `scrollbar-width: thin` + `scrollbar-color`
     properties. WebKit / Blink browsers need the `::-webkit-*`
     pseudo-elements. Both are supplied for cross-browser parity. */
  #SCDialog-{{ block.id }} .scp__modal,
  #SCDialog-{{ block.id }} .scp__page-wrap {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, currentColor 28%, transparent) transparent;
  }
  #SCDialog-{{ block.id }} .scp__modal::-webkit-scrollbar,
  #SCDialog-{{ block.id }} .scp__page-wrap::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  #SCDialog-{{ block.id }} .scp__modal::-webkit-scrollbar-track,
  #SCDialog-{{ block.id }} .scp__page-wrap::-webkit-scrollbar-track {
    background: transparent;
  }
  #SCDialog-{{ block.id }} .scp__modal::-webkit-scrollbar-thumb,
  #SCDialog-{{ block.id }} .scp__page-wrap::-webkit-scrollbar-thumb {
    background-color: color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 999px;
    border: 0;
    transition: background-color .2s ease;
  }
  #SCDialog-{{ block.id }} .scp__modal::-webkit-scrollbar-thumb:hover,
  #SCDialog-{{ block.id }} .scp__page-wrap::-webkit-scrollbar-thumb:hover {
    background-color: color-mix(in srgb, currentColor 40%, transparent);
  }
  /* Hide scrollbar corner artifact when both axes are scrollable. */
  #SCDialog-{{ block.id }} .scp__modal::-webkit-scrollbar-corner,
  #SCDialog-{{ block.id }} .scp__page-wrap::-webkit-scrollbar-corner {
    background: transparent;
  }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  var root = document.getElementById('SC-{{ block.id }}');
  if(!root || root.__scInit) return;
  root.__scInit = true;

  var trigger = root.querySelector('.scp__trigger');
  var overlay = root.querySelector('[data-overlay]');
  var dialog  = root.querySelector('[data-dialog]');
  var modal   = root.querySelector('[data-modal]');
  var closeBtn= root.querySelector('[data-close]');
  var lastFocus = null;

  {%- comment -%}
    Move the overlay + dialog directly to <body> so position: fixed works
    even when the section is rendered inside a transformed/contained
    parent (which is otherwise the most common cause of fixed elements
    rendering off-center on Shopify product pages).
  {%- endcomment -%}
  if (overlay && overlay.parentNode !== document.body) document.body.appendChild(overlay);
  if (dialog && dialog.parentNode !== document.body) document.body.appendChild(dialog);

  function open(){
    lastFocus = document.activeElement;
    overlay.hidden = false;
    dialog.hidden = false;
    requestAnimationFrame(function(){
      overlay.classList.add('is-open');
      dialog.classList.add('is-open');
      trigger.setAttribute('aria-expanded','true');
      document.documentElement.classList.add('scp-lock');
      var f = getFocusable(modal);
      if(f.length){ f[0].focus(); } else if (closeBtn) { closeBtn.focus(); }
    });
    document.addEventListener('keydown', onKeydown);
    dialog.addEventListener('click', onOutside);
  }
  function close(){
    overlay.classList.remove('is-open');
    dialog.classList.remove('is-open');
    trigger.setAttribute('aria-expanded','false');
    document.documentElement.classList.remove('scp-lock');
    setTimeout(function(){
      overlay.hidden = true;
      dialog.hidden = true;
      if(lastFocus && typeof lastFocus.focus === 'function'){ lastFocus.focus({preventScroll:true}); }
    }, 180);
    document.removeEventListener('keydown', onKeydown);
    dialog.removeEventListener('click', onOutside);
  }
  function onOutside(e){ if(!modal.contains(e.target)) close(); }
  function onKeydown(e){
    if(e.key === 'Escape'){ e.preventDefault(); close(); return; }
    if(e.key === 'Tab'){ trapTab(e); }
  }
  function getFocusable(el){
    return Array.prototype.slice.call(el.querySelectorAll(
      'a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), iframe, object, embed, [tabindex]:not([tabindex="-1"]), [contenteditable="true"]'
    )).filter(function(n){ return n.offsetParent !== null; });
  }
  function trapTab(e){
    var focusable = getFocusable(modal);
    if(!focusable.length) return;
    var first = focusable[0];
    var last  = focusable[focusable.length - 1];
    var active = document.activeElement;
    if(e.shiftKey){
      if(active === first){ e.preventDefault(); last.focus(); }
    }else{
      if(active === last){ e.preventDefault(); first.focus(); }
    }
  }

  trigger.addEventListener('click', open);
  closeBtn.addEventListener('click', close);


  {% if sc.enable_size_popup %}
  /* Tabs live inside the dialog, which has been moved to <body>. Query
     from the dialog (not root) so we still find them after the move. */
  var tabBtns = dialog.querySelectorAll('.scp__tab');
  var panels  = dialog.querySelectorAll('.scp__panel');
  tabBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var id = btn.getAttribute('data-tab');
      tabBtns.forEach(function(b){ b.classList.remove('is-active'); });
      panels.forEach(function(p){ p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var panel = document.getElementById(id);
      if(panel){ panel.classList.add('is-active'); }
    });
  });
  {% endif %}
})();
{% comment %}{% endcomment %}</script>




</template>