<template compat="shopify">
{%- liquid
  assign st = block.settings
  assign field_id = section.id | append: '-' | append: block.id
  assign text_label = st.field_label | default: 'Personalization'
  assign image_label = st.field_image_label | default: 'Upload a photo'
-%}
<div class="product-personalization mb-20" data-personalization data-block-preview-root="{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if st.heading != blank -%}<h2 class="h6 mt-0 mb-10">{{ st.heading | escape }}</h2>{%- endif -%}
  {%- if st.description != blank -%}<div class="product-personalization__description">{{ st.description }}</div>{%- endif -%}
  <product-property class="product-personalization__fields">
    {%- if st.enable_field_text != false -%}
      <div class="product-personalization__field">
        <label for="PersonalizationText-{{ field_id }}">{{ text_label | escape }}</label>
        <input id="PersonalizationText-{{ field_id }}" form="{{ product_form_id }}" type="text" class="text product-personalization__input" name="properties[{{ text_label | escape }}]" placeholder="{{ st.field_placeholder | default: 'Enter a name or note' | escape }}"{% if st.field_required %} required{% endif %} maxlength="{{ st.field_max_length | default: 200 }}" autocomplete="off">
      </div>
    {%- endif -%}
    {%- if st.enable_field_image != false -%}
      <div class="product-personalization__field">
        <label for="PersonalizationImage-{{ field_id }}">{{ image_label | escape }}</label>
        <input id="PersonalizationImage-{{ field_id }}" form="{{ product_form_id }}" type="file" class="file product-personalization__input" name="properties[{{ image_label | escape }}]" accept="image/jpeg,image/png,image/webp" aria-describedby="PersonalizationHelp-{{ field_id }}">
        <p id="PersonalizationHelp-{{ field_id }}" class="product-personalization__help">{{ st.upload_help | default: 'Choose a JPG, PNG or WebP image.' | escape }}</p>
      </div>
    {%- endif -%}
  </product-property>
</div>
<style>
.product-personalization { min-width:0; color:var(--color-text); }
.product-personalization__description { margin:0 0 16px; line-height:1.5; }
.product-personalization__fields { display:grid; gap:16px; }
.product-personalization__field { display:grid; gap:8px; min-width:0; }
.product-personalization__field label { position:static!important; transform:none!important; padding:0!important; font-weight:var(--input-label-weight,var(--body-weight,400)); }
.product-personalization__input { width:100%; min-width:0; min-height:44px; margin:0!important; padding:var(--input-padding,12px 14px); background:var(--input-bg,var(--color-background)); color:var(--input-text,var(--color-text)); border:var(--input-border-width,1px) solid var(--input-border,var(--color-border)); border-radius:var(--input-radius,8px); font:inherit; font-size:var(--input-font-size,16px); }
.product-personalization__input[type=file] { padding:8px; height:auto; line-height:1.5; }
.product-personalization__input::file-selector-button { min-height:36px; padding:6px 12px; margin-inline-end:12px; border:1px solid var(--color-border); border-radius:var(--input-radius,6px); background:var(--color-background); color:var(--color-heading); font:inherit; cursor:pointer; }
.product-personalization__help { margin:0; font-size:.85em; line-height:1.5; opacity:.8; }
{% comment %}{% endcomment %}</style>
</template>
