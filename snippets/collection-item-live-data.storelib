<template compat="shopify">
{%- comment -%}
  Materia Themes. The store data of one Collections Display card as JSON
  (printed escaped in data-cl-card), so live-collections.js can draw the card
  again (snippets/collection-item) when a card setting changes in the builder.
  Accepts: block (a collection block).
{%- endcomment -%}
{%- liquid
  assign cc = block.settings.collection
  assign ci = block.settings.collection_image
  assign is_empty = true
  if cc and cc != empty
    assign is_empty = false
  endif
  assign ar = '3/4'
  if ci != blank
    assign ar = ci.aspect_ratio
  elsif cc.featured_image
    assign ar = cc.featured_image.aspect_ratio
  endif
  assign ia = ''
  if ci.alt != blank
    assign ia = ci.alt
  elsif cc.featured_image.alt != blank
    assign ia = cc.featured_image.alt
  endif
  assign n = cc.products_count
  if n > 1
    assign c1 = 'general.collections.collection_count_multiple_noCP' | t: number: n
    assign c2 = 'general.collections.collection_count_multiple_noP' | t: number: n
    assign c3 = 'general.collections.collection_count_multiple' | t: number: n
  else
    assign c1 = 'general.collections.collection_count_single_noCP' | t: number: n
    assign c2 = 'general.collections.collection_count_single_noP' | t: number: n
    assign c3 = 'general.collections.collection_count_single' | t: number: n
  endif
  assign ot = 'onboarding.collection_title' | t
  assign oc = 'onboarding.collection_count' | t
  assign od = 'onboarding.collection_description' | t
-%}
{"e":{{ is_empty | json }},"t":{{ cc.title | append: '' | json }},"u":{{ cc.url | append: '' | json }},"d":{{ cc.description | append: '' | json }},"ar":{{ ar | json }},"ia":{{ ia | append: '' | json }},"c1":{{ c1 | json }},"c2":{{ c2 | json }},"c3":{{ c3 | json }},"ot":{{ ot | json }},"oc":{{ oc | json }},"od":{{ od | json }}}
</template>
