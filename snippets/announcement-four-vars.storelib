<template compat="shopify">
{%- assign c = controls -%}
{%- if kind == 'button' -%}
{%- unless c.use_theme_button -%}
--ab-btn-size:{{ c.btn_size_mobile | default: 11 }}px;--ab-btn-size-d:{{ c.btn_size_desktop | default: 14 }}px;--ab-btn-py:7px;--ab-btn-px:14px;--ab-btn-py-d:{{ c.btn_pad_y | default: 10 }}px;--ab-btn-px-d:{{ c.btn_pad_x | default: 22 }}px;--ab-btn-radius:{{ c.btn_radius | default: 6 }}px;
--ab-btn-weight:{% if c.enable_custom_btn_weight %}{{ c.btn_weight | default: '700' }}{% else %}var(--btn-font-weight,500){% endif %};
{% render 'button-overrides', bg: c.btn_bg, text: c.btn_text, hover_bg: c.btn_bg_hover, hover_text: c.btn_text_hover %}
{%- endunless -%}
{%- else -%}
--ab-align:{% case c.content_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};--ab-text-align:{{ c.content_alignment | default: 'center' }};
--ab-close-space:{% if c.show_close %}44px{% else %}0px{% endif %};--ab-row-gap:{{ c.row_gap | default: 8 }}px;
--ab-message-m:{{ c.message_size_mobile | default: 13 }}px;--ab-message-d:{{ c.message_size_desktop | default: 16 }}px;--ab-digit-m:{{ c.digit_size_mobile | default: 16 }}px;--ab-digit-d:{{ c.digit_size_desktop | default: 22 }}px;
--ab-gap-m:{{ c.group_gap_mobile | default: 10 }}px;--ab-gap-d:{{ c.group_gap_desktop | default: 16 }}px;
--ab-py-m:{{ c.pad_y_mobile | default: 10 }}px;--ab-py-d:{{ c.pad_y_desktop | default: 14 }}px;--ab-px-m:{{ c.pad_x_mobile | default: 14 }}px;--ab-px-d:{{ c.pad_x_desktop | default: 24 }}px;
--ab-message-weight:{% if c.enable_custom_message_weight %}{{ c.message_weight | default: '700' }}{% else %}var(--body-weight,400){% endif %};--ab-digit-weight:{% if c.enable_custom_digit_weight %}{{ c.digit_weight | default: '700' }}{% else %}var(--heading-weight,600){% endif %};
--ab-bg:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.bg_color, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};
--ab-text:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--ab-digit:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.digit_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
--ab-label:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.digit_label_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};
--ab-separator:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.separator_color, fallback: 'var(--color-border)' %}{% else %}var(--color-border){% endif %};
--ab-close:{% if c.enable_custom_style %}{% render 'scheme-color', color: c.close_color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};
{%- endif -%}
</template>
