<template compat="shopify">
{%- comment -%}
  Materia Themes — Benefits Pills block.
  Optional heading + horizontal stack of pill-shaped benefit tags.
  Each pill: toggle, text, icon (preset / inline SVG / image / none),
  per-pill color overrides for icon, text, and background.
  Pass `block`.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign block_id = 'benefits-pills-' | append: block.id

  assign pill_bg     = s.pill_bg     | default: '#F2F0FF'
  assign pill_text   = s.pill_text_color   | default: '#1f1147'
  assign pill_icon   = s.pill_icon_color   | default: '#1f1147'
  assign pill_radius = s.pill_radius | default: 999
  assign pill_pad_x  = s.pill_padding_x | default: 14
  assign pill_pad_y  = s.pill_padding_y | default: 8
  assign pill_gap    = s.pill_gap    | default: 8
  assign pill_fs_d   = s.pill_font_size_desktop | default: 14
  assign pill_fs_m   = s.pill_font_size_mobile  | default: 13
  assign pill_fw     = s.pill_font_weight | default: '600'
  assign pill_is_d   = s.pill_icon_size_desktop | default: 16
  assign pill_is_m   = s.pill_icon_size_mobile  | default: 14
  assign pill_bs     = s.pill_border_style | default: 'none'
  assign pill_bw     = s.pill_border_width | default: 0
  assign pill_bc     = s.pill_border_color | default: 'transparent'

  comment
    Use the raw setting value so when user deletes the text, the blank
    check below correctly hides the heading. `| default:` would force
    a fallback every time and make `heading_text != blank` always true.
  endcomment
  assign heading_text  = s.heading_text
  assign heading_color = s.heading_color | default: '#111111'
  assign heading_size_d = s.heading_size_desktop | default: 16
  assign heading_size_m = s.heading_size_mobile  | default: 15
  assign heading_w     = s.heading_weight | default: '700'
  assign heading_align = s.heading_alignment | default: 'left'
  assign heading_mb    = s.heading_margin_bottom | default: 12

  assign group_align = s.alignment | default: 'flex-start'
  assign gap_x       = s.gap_x | default: 8
  assign gap_y       = s.gap_y | default: 8
  assign pill_mobile_layout = s.mobile_layout | default: 'wrap'
-%}

{%- capture preset_icons -%}
  {%- comment -%}
    A collection of stroke-based SVGs. The merchant picks one with the
    icon_preset_N setting; all stroke uses currentColor so it tracks the
    pill icon color (or its per-pill override).
  {%- endcomment -%}
{%- endcapture -%}

{%- assign icon_keys = 'leaf,smile,heart,shield,lightning,star,drop,fire,sparkle,sun,moon,brain,check,flower,gem,flame,zap,muscle,pill,trophy' | split: ',' -%}

<style>
  #{{ block_id }} {
    padding-top: {{ s.padding_top | default: 12 }}px;
    padding-bottom: {{ s.padding_bottom | default: 12 }}px;
    color: var(--color-text, #111);
  }
  #{{ block_id }} .bp-heading {
    margin: 0 0 {{ heading_mb }}px;
    font-size: {{ heading_size_m }}px;
    font-weight: {{ heading_w }};
    color: {{ heading_color }};
    text-align: {{ heading_align }};
    line-height: 1.3;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bp-heading { font-size: {{ heading_size_d }}px; }
  }
  #{{ block_id }} .bp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ group_align }};
    gap: {{ gap_y }}px {{ gap_x }}px;
  }
  /* Mobile layout — merchant-selectable:
       stack = one pill per row (one under another)
       two   = two pills per row (2 x 2 grid feel)
       wrap  = natural wrapping, fit as many per row as possible        */
  @media (max-width: 749px) {
    {%- case pill_mobile_layout -%}
      {%- when 'stack' -%}
        #{{ block_id }} .bp-list {
          flex-direction: column;
          flex-wrap: nowrap;
          align-items: {{ group_align }};
        }
      {%- when 'two' -%}
        #{{ block_id }} .bp-list {
          flex-direction: row;
          flex-wrap: wrap;
          justify-content: {{ group_align }};
        }
        #{{ block_id }} .bp-list > .bp-pill {
          flex: 0 1 calc(50% - {{ gap_x }}px);
          justify-content: center;
        }
      {%- else -%}
        #{{ block_id }} .bp-list {
          flex-direction: row;
          flex-wrap: wrap;
          justify-content: {{ group_align }};
        }
    {%- endcase -%}
  }
  #{{ block_id }} .bp-pill {
    display: inline-flex;
    align-items: center;
    gap: {{ pill_gap }}px;
    padding: {{ pill_pad_y }}px {{ pill_pad_x }}px;
    border-radius: {{ pill_radius }}px;
    background: {{ pill_bg }};
    color: {{ pill_text }};
    font-size: {{ pill_fs_m }}px;
    font-weight: {{ pill_fw }};
    line-height: 1.2;
    {%- if pill_bs != 'none' and pill_bw > 0 -%}
      border: {{ pill_bw }}px {{ pill_bs }} {{ pill_bc }};
    {%- endif -%}
    {%- if s.pill_shadow -%}
      box-shadow: 0 2px 6px -2px rgba(0,0,0,0.08);
    {%- endif -%}
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bp-pill { font-size: {{ pill_fs_d }}px; }
  }
  #{{ block_id }} .bp-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ pill_is_m }}px;
    height: {{ pill_is_m }}px;
    color: {{ pill_icon }};
    flex: 0 0 auto;
  }
  @media (min-width: 750px) {
    #{{ block_id }} .bp-icon {
      width: {{ pill_is_d }}px;
      height: {{ pill_is_d }}px;
    }
  }
  #{{ block_id }} .bp-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  #{{ block_id }} .bp-icon svg,
  #{{ block_id }} .bp-icon svg * {
    stroke: currentColor;
  }
  #{{ block_id }} .bp-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  {%- unless s.custom_style -%}
  #{{ block_id }} { font-family: var(--body-font, inherit); }
  #{{ block_id }} .bp-heading {
    color: var(--color-heading); font-family: var(--heading-font, inherit);
    font-size: var(--body-font-size, 16px); font-weight: var(--heading-font-weight, 600);
  }
  #{{ block_id }} .bp-pill {
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    color: var(--color-text); border-color: var(--color-border);
    font-size: var(--body-font-size, 16px); font-weight: var(--body-font-weight, 400);
  }
  #{{ block_id }} .bp-icon { color: currentColor; }
  {%- endunless -%}
{% comment %}{% endcomment %}</style>

<div id="{{ block_id }}" class="benefits-pills-block" {{ block.shopify_attributes }}>
  {%- if s.show_heading and heading_text != blank -%}
    <p class="bp-heading">{{ heading_text }}</p>
  {%- endif -%}
  <ul class="bp-list" role="list">
    {%- for i in (1..6) -%}
      {%- capture k_enable -%}pill{{ i }}_enable{%- endcapture -%}
      {%- capture k_text   -%}pill{{ i }}_text{%- endcapture -%}
      {%- capture k_src    -%}pill{{ i }}_icon_source{%- endcapture -%}
      {%- capture k_preset -%}pill{{ i }}_icon_preset{%- endcapture -%}
      {%- capture k_svg    -%}pill{{ i }}_icon_svg{%- endcapture -%}
      {%- capture k_img    -%}pill{{ i }}_icon_image{%- endcapture -%}
      {%- capture k_ic_o   -%}pill{{ i }}_icon_color{%- endcapture -%}
      {%- capture k_bg_o   -%}pill{{ i }}_bg_color{%- endcapture -%}
      {%- capture k_tc_o   -%}pill{{ i }}_text_color{%- endcapture -%}

      {%- assign p_enable = s[k_enable] -%}
      {%- assign p_text   = s[k_text] -%}
      {%- assign p_src    = s[k_src]  | default: 'preset' -%}
      {%- assign p_preset = s[k_preset] | default: 'leaf' -%}
      {%- assign p_svg    = s[k_svg] -%}
      {%- assign p_img    = s[k_img] -%}
      {%- assign p_ic_o   = s[k_ic_o] -%}
      {%- assign p_bg_o   = s[k_bg_o] -%}
      {%- assign p_tc_o   = s[k_tc_o] -%}

      {%- if p_enable and p_text != blank -%}
        {%- capture pill_inline -%}
          {%- if s.custom_style and p_bg_o != blank -%}background: {{ p_bg_o }};{%- endif -%}
          {%- if s.custom_style and p_tc_o != blank -%}color: {{ p_tc_o }};{%- endif -%}
        {%- endcapture -%}
        {%- assign pill_inline_trim = pill_inline | strip -%}
        {%- capture icon_inline -%}
          {%- if s.custom_style and p_ic_o != blank -%}color: {{ p_ic_o }};{%- endif -%}
        {%- endcapture -%}
        {%- assign icon_inline_trim = icon_inline | strip -%}

        <li class="bp-pill" role="listitem"{% if pill_inline_trim != blank %} style="{{ pill_inline_trim }}"{% endif %}>
          {%- if p_src != 'none' -%}
            <span class="bp-icon" aria-hidden="true"{% if icon_inline_trim != blank %} style="{{ icon_inline_trim }}"{% endif %}>
              {%- if p_src == 'image' and p_img != blank -%}
                {{ p_img | image_url: width: 96 | image_tag: alt: p_text, loading: 'lazy' }}
              {%- elsif p_src == 'svg' and p_svg != blank -%}
                {{ p_svg }}
              {%- else -%}
                {%- case p_preset -%}
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c8 0 14-6 14-14-7 0-13 1-14 8-.5 4 0 6 0 6Z"/><path d="M5 19c2-3 5-6 9-9"/></svg>
                  {%- when 'smile' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c.7 1.3 2 2.2 3.5 2.2s2.8-.9 3.5-2.2"/><circle cx="9" cy="10" r=".6" fill="currentColor"/><circle cx="15" cy="10" r=".6" fill="currentColor"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-9.5A4 4 0 0 1 12 7a4 4 0 0 1 7 3.5C19 15.5 12 20 12 20Z"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 7.5-8 9-4-1.5-8-4-8-9V6l8-3Z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'lightning' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.5 6 .9-4.3 4.3 1 6L12 17l-5.4 2.7 1-6L3.3 9.4l6-.9L12 3Z"/></svg>
                  {%- when 'drop' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-3 5-6 8.5-6 12a6 6 0 0 0 12 0c0-3.5-3-7-6-12Z"/></svg>
                  {%- when 'fire' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3 4 5 4 9a4 4 0 1 1-8 0c0-2 1-3 2-4-.5 2.5 0 4 2-5Z"/></svg>
                  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.7 4 4 1.7-4 1.7L12 16l-1.7-4.6-4-1.7 4-1.7L12 4Z"/><path d="M19 14l.7 1.7 1.7.6-1.7.6L19 18.6l-.6-1.7-1.7-.6 1.7-.6L19 14Z"/></svg>
                  {%- when 'sun' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
                  {%- when 'moon' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14a8 8 0 1 1-10-10 7 7 0 0 0 10 10Z"/></svg>
                  {%- when 'brain' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 1 4 3 3 0 0 0 4 2h0v-13Z"/><path d="M15 5a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-1 4 3 3 0 0 1-4 2h0v-13Z"/></svg>
                  {%- when 'check' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                  {%- when 'flower' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.5"/><path d="M12 3a3 3 0 0 1 0 6M12 15a3 3 0 0 1 0 6M3 12a3 3 0 0 1 6 0M15 12a3 3 0 0 1 6 0"/></svg>
                  {%- when 'gem' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l3-5h6l3 5-6 11L6 9Z"/><path d="M6 9h12M9 4l3 5 3-5"/></svg>
                  {%- when 'flame' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a6 6 0 0 0 6-6c0-3-2-5-3-7-1-2-3-3-3-5 0 3-3 4-4 7s-2 4-2 5a6 6 0 0 0 6 6Z"/></svg>
                  {%- when 'zap' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M5 12h6M19 12h-6M12 22v-6M6 6l4 4M14 14l4 4M18 6l-4 4M10 14l-4 4"/></svg>
                  {%- when 'muscle' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11c2-3 6-3 8 0M13 11c1 2 4 3 6 1M5 11c0 6 4 9 9 9 4 0 6-3 5-7"/></svg>
                  {%- when 'pill' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="6" rx="3"/><path d="M12 9v6"/></svg>
                  {%- when 'trophy' -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v6a4 4 0 1 1-8 0V4Z"/><path d="M5 6h3M16 6h3M10 18h4M9 21h6M12 14v4"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
          {%- endif -%}
          <span class="bp-text">{{ p_text }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

</template>
