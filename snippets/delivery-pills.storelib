<template compat="shopify">
{%- comment -%}
  Materia Themes — Delivery & Warranty Pills
  Rounded "pill" badges, each with an icon + text (e.g. "Fast 2-5 Day Europe
  Delivery", "1 Year Warranty Included"). Up to 4 pills, each toggleable.
  Icons come from the shared 'benefits-icon' library.

  Usage: {%- render 'delivery-pills', block: block -%}
{%- endcomment -%}

{%- liquid
  assign b = block.settings
  assign uid = block.id
  assign cols_d = b.columns_desktop | default: 2
  assign cols_m = b.columns_mobile | default: 2
-%}

<style>
  #dpills-{{ uid }}.dpills {
    display: grid;
    grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr));
    gap: {{ b.gap | default: 12 }}px;
    margin: {{ b.margin_top | default: 8 }}px 0 {{ b.margin_bottom | default: 8 }}px;
  }
  @media (min-width: 768px) {
    #dpills-{{ uid }}.dpills {
      grid-template-columns: repeat({{ cols_d }}, minmax(0, 1fr));
    }
  }
  #dpills-{{ uid }} .dpills__item {
    display: flex;
    align-items: center;
    {% if b.align == 'center' %}justify-content: center; text-align: center;{% endif %}
    gap: 10px;
    min-width: 0;
    background: {{ b.pill_bg | default: '#EEF4FB' }};
    border-radius: {{ b.pill_radius | default: 12 }}px;
    padding: {{ b.pill_padding_y | default: 14 }}px {{ b.pill_padding_x | default: 16 }}px;
    {% if b.pill_border_width and b.pill_border_width > 0 %}border: {{ b.pill_border_width }}px solid {{ b.pill_border_color | default: 'rgba(0,0,0,0.06)' }};{% endif %}
  }
  #dpills-{{ uid }} .dpills__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    color: {{ b.icon_color | default: '#1B1B1B' }};
  }
  #dpills-{{ uid }} .dpills__txt { display: flex; flex-direction: column; min-width: 0; }
  #dpills-{{ uid }} .dpills__t1 {
    margin: 0;
    font-size: {{ b.title_size | default: 14 }}px;
    font-weight: 600;
    line-height: 1.25;
    color: {{ b.text_color | default: '#1B1B1B' }};
  }
  #dpills-{{ uid }} .dpills__t2 {
    margin: 1px 0 0;
    font-size: {{ b.subtitle_size | default: 13 }}px;
    line-height: 1.25;
    color: {{ b.subtitle_color | default: '#5B6470' }};
  }
{% comment %}{% endcomment %}</style>

<div id="dpills-{{ uid }}" class="dpills" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- assign k_en = 'pill_' | append: i | append: '_enable' -%}
    {%- assign k_icon = 'pill_' | append: i | append: '_icon' -%}
    {%- assign k_t1 = 'pill_' | append: i | append: '_title' -%}
    {%- assign k_t2 = 'pill_' | append: i | append: '_subtitle' -%}
    {%- if b[k_en] and b[k_t1] != blank -%}
      <div class="dpills__item">
        {%- assign ic = b[k_icon] -%}
        {%- if ic != blank and ic != 'none' -%}
          <span class="dpills__icon">{%- render 'benefits-icon', icon: ic, size: b.icon_size | default: 22, color: b.icon_color | default: '#1B1B1B', stroke_width: 1.9 -%}</span>
        {%- endif -%}
        <span class="dpills__txt">
          <span class="dpills__t1">{{ b[k_t1] | escape }}</span>
          {%- if b[k_t2] != blank -%}<span class="dpills__t2">{{ b[k_t2] | escape }}</span>{%- endif -%}
        </span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

</template>