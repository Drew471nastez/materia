<template compat="shopify">
{%- comment -%}
  Materia Themes. The icons of the contact sections, by set and name.
  set: 'newsletter' (Newsletter's icon above the text), 'cfs' (Contact Form
  Simple info rows), 'cfs2' (Contact Form Simple 2 info items). name: the
  icon; an unknown name draws the set's fallback. all: true prints every
  icon of the set, each with data-icon, inside a <template data-ct-icons>
  that live-contact.js copies from when an icon setting changes live.
  {% render 'contact-live-icons', set: 'cfs', name: block.settings.icon %}
{%- endcomment -%}
{%- liquid
  case set
    when 'newsletter'
      assign names = 'envelope,paper_plane,bell,gift,sparkles' | split: ','
    when 'cfs'
      assign names = 'mail,phone,pin,clock,message' | split: ','
    else
      assign names = 'mail,map,phone,dot,clock,user,globe,calendar,message,briefcase,home,download,heart,star' | split: ','
  endcase
  if all
    assign list = names
  else
    assign list = name | default: '' | split: '|'
    if list.size == 0
      assign list = '_' | split: '|'
    endif
  endif
-%}
{%- if all -%}<template data-ct-icons>{%- endif -%}
{%- for n in list -%}
  {%- capture attr -%}{% if all %} data-icon="{{ n }}"{% endif %}{%- endcapture -%}
  {%- if set == 'newsletter' -%}
    {%- capture common -%}viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}
    {%- case n -%}
      {%- when 'paper_plane' -%}<svg{{ attr }} {{ common }}><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
      {%- when 'bell' -%}<svg{{ attr }} {{ common }}><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      {%- when 'gift' -%}<svg{{ attr }} {{ common }}><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
      {%- when 'sparkles' -%}<svg{{ attr }} {{ common }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6.3 6.3 2.4 2.4M15.3 15.3l2.4 2.4M17.7 6.3l-2.4 2.4M8.7 15.3l-2.4 2.4"/></svg>
      {%- else -%}<svg{{ attr }} {{ common }}{% if all %} data-icon-default{% endif %}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
    {%- endcase -%}
  {%- elsif set == 'cfs' -%}
    {%- capture common -%}viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}
    {%- case n -%}
      {%- when 'mail' -%}<svg{{ attr }} {{ common }}><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 6 12 13 22 6"/></svg>
      {%- when 'phone' -%}<svg{{ attr }} {{ common }}><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {%- when 'pin' -%}<svg{{ attr }} {{ common }}><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {%- when 'clock' -%}<svg{{ attr }} {{ common }}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      {%- when 'message' -%}<svg{{ attr }} {{ common }}><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      {%- else -%}<svg{{ attr }} {{ common }}{% if all %} data-icon-default{% endif %}><circle cx="12" cy="12" r="10"/></svg>
    {%- endcase -%}
  {%- else -%}
    {%- capture common -%}width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"{%- endcapture -%}
    {%- case n -%}
      {%- when 'mail' -%}<svg{{ attr }} {{ common }}><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"/></svg>
      {%- when 'map' -%}<svg{{ attr }} {{ common }}><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/></svg>
      {%- when 'phone' -%}<svg{{ attr }} {{ common }}><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1.1-.23c1.2.48 2.6.75 4 .75a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C11.85 21 3 12.15 3 2a1 1 0 0 1 1-1h2.28a1 1 0 0 1 1 1c0 1.37.27 2.77.75 4a1 1 0 0 1-.23 1.1L6.6 10.8Z"/></svg>
      {%- when 'clock' -%}<svg{{ attr }} {{ common }}><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13h-1v6l5.25 3.15.75-1.23-4.5-2.67v-5.5h1v1z"/></svg>
      {%- when 'user' -%}<svg{{ attr }} {{ common }}><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      {%- when 'globe' -%}<svg{{ attr }} {{ common }}><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18V4a8 8 0 1 1 0 16zM12 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm0 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm0 4a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
      {%- when 'calendar' -%}<svg{{ attr }} {{ common }}><path d="M19 3h-1V1H6v2H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
      {%- when 'message' -%}<svg{{ attr }} {{ common }}><path d="M20 2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4l4 4 4-4h4a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z"/></svg>
      {%- when 'briefcase' -%}<svg{{ attr }} {{ common }}><path d="M19 7V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2Zm0 12V9H5v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2Z"/></svg>
      {%- when 'home' -%}<svg{{ attr }} {{ common }}><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
      {%- when 'download' -%}<svg{{ attr }} {{ common }}><path d="M12 16l-6-6h4V4h2v6h4l-6 6zm-2-2V8l-4 4h8l-4-4zM4 20h16v2H4z"/></svg>
      {%- when 'heart' -%}<svg{{ attr }} {{ common }}><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      {%- when 'star' -%}<svg{{ attr }} {{ common }}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- else -%}<svg{{ attr }} {{ common }}{% if all %} data-icon-default{% endif %}><circle cx="12" cy="12" r="7"/></svg>
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}
{%- if all -%}</template>{%- endif -%}
</template>