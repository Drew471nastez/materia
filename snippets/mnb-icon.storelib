<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
  Renders a mobile-navigation-bar icon. Accepts `icon` (key) and `fallback` (key used when icon == 'auto').
{%- endcomment -%}
{%- liquid
  assign key = icon
  if key == blank or key == 'auto'
    assign key = fallback
  endif
-%}
{%- case key -%}
  {%- when 'home' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3.5 10.5 12 4l8.5 6.5V20a.5.5 0 0 1-.5.5h-5v-6h-6v6H4a.5.5 0 0 1-.5-.5v-9.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'home-alt' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m3 11 9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/>
    </svg>
  {%- when 'shop' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9h16l-.8 10.2a2 2 0 0 1-2 1.8H6.8a2 2 0 0 1-2-1.8L4 9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M4 9 6 4h12l2 5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 13a3 3 0 1 0 6 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'grid' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'compass' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'star' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m12 3.5 2.7 5.5 6 .9-4.35 4.25L17.4 20 12 17.1 6.6 20l1.05-5.85L3.3 9.9l6-.9L12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'tag' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3.5 10 10 3.5h6.5V10L10 16.5 3.5 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="13" cy="7" r="1.3" fill="currentColor"/>
    </svg>
  {%- when 'category' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m12 3 8 5-8 5-8-5 8-5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="m4 13 8 5 8-5M4 17l8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'sparkle' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'user' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="8.5" r="4" stroke="currentColor" stroke-width="1.5"/>
      <path d="M4.5 20c1.5-3.5 4.5-5.5 7.5-5.5s6 2 7.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'user-circle' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M6.5 19c1-2.5 3-4 5.5-4s4.5 1.5 5.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'lock' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4.5" y="10.5" width="15" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 10.5V7a4 4 0 1 1 8 0v3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'cart' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 8.5h14l-1.1 10.2a2 2 0 0 1-2 1.8H8.1a2 2 0 0 1-2-1.8L5 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8.5 11V7.5a3.5 3.5 0 1 1 7 0V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'basket' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3 9h18l-1.6 9.2a2 2 0 0 1-2 1.8H6.6a2 2 0 0 1-2-1.8L3 9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="m8 9 3-5M16 9l-3-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'trolley' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.5L21 8H6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="9" cy="20" r="1.5" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="18" cy="20" r="1.5" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'heart' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 20.5 4.5 13a4.5 4.5 0 0 1 6.3-6.4l1.2 1.1 1.2-1.1A4.5 4.5 0 0 1 19.5 13L12 20.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'heart-outline' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 20 5 13a4 4 0 0 1 5.6-5.7L12 8.5l1.4-1.2A4 4 0 0 1 19 13l-7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.08"/>
    </svg>
  {%- when 'bookmark' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 3.5h12v17L12 16l-6 4.5v-17Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'search' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'search-alt' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2"/>
      <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
    </svg>
{%- endcase -%}

</template>