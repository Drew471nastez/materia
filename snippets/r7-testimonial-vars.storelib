<template compat="shopify">
{%- comment -%}
  Materia Themes. The --r7t-* properties Testimonial Wall and Testimonial
  With Product print on their root for the first paint: colours from the
  colour scheme until custom styling is on, fonts from Theme settings >
  Typography until custom fonts are on, corners from Theme settings until a
  custom radius is set, and the spacing sliders.
  assets/live-r7-testimonials.js writes the same names in the builder.
  st: the section's settings.
{%- endcomment -%}
{%- assign on = st.enable_custom_style -%}
{%- assign fonts = st.enable_custom_fonts -%}
--r7t-bg: {% render 'live-testimonials-color', on: on, color: st.section_bg, fallback: 'var(--color-background)' %};--r7t-text: {% render 'live-testimonials-color', on: on, color: st.text_color, fallback: 'var(--color-text)' %};--r7t-card-bg: {% render 'live-testimonials-color', on: on, color: st.card_bg, fallback: 'color-mix(in srgb, var(--color-text) 6%, var(--color-background))' %};--r7t-card-border: {% render 'live-testimonials-color', on: on, color: st.card_border_color, fallback: 'var(--color-border)' %};--r7t-quote-c: {% render 'live-testimonials-color', on: on, color: st.quote_color, fallback: 'var(--color-heading)' %};--r7t-name-c: {% render 'live-testimonials-color', on: on, color: st.name_color, fallback: 'var(--color-heading)' %};--r7t-star-on: {% render 'live-testimonials-color', on: on, color: st.star_color, fallback: 'var(--color-primary)' %};--r7t-star-off: {% render 'live-testimonials-color', on: on, color: st.star_empty_color, fallback: 'color-mix(in srgb, var(--color-text) 22%, transparent)' %};--r7t-radius: {% if on %}{{ st.card_radius | default: 0 }}px{% else %}var(--rounded-radius, 0px){% endif %};--r7t-hf: {% if fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--r7t-bf: {% if fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--r7t-gap: {{ st.card_gap | default: 20 }}px;--r7t-q-d: {{ st.quote_size | default: 16 }}px;--r7t-q-m: {{ st.quote_size_mobile | default: 15 }}px;--r7t-pt: {{ st.padding_top | default: 0 }}px;--r7t-pb: {{ st.padding_bottom | default: 0 }}px;--r7t-pt-m: {{ st.padding_top_mobile | default: 0 }}px;--r7t-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;--r7t-mt: {{ st.section_margin_top_desktop | default: 0 }}px;--r7t-mb: {{ st.section_margin_bottom_desktop | default: 0 }}px;--r7t-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px;--r7t-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;
</template>
