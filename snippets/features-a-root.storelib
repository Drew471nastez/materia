<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared root of the Features sections that live-features-a.js
  paints in the builder (Benefits Bar 2, Benefits Bar Pro, Benefits Circles,
  Benefits Icons, Benefits Tabs, Product Benefits Pro).
  part 'attrs': the root's data attributes (type, section id, settings JSON,
  width, own font). part 'vars': the shared CSS variables (background, fonts,
  padding, margins). part 'css': the shared static rules, once per section.
  type: the section type. width: the width setting's value. bg: the
  background colour setting's value (custom style only).
  pt_m, pb_m, pt_d, pb_d: padding values in px.
  The same values are derived by live-features-a.js (common()).
{%- endcomment -%}
{%- assign st = section.settings -%}
{%- if part == 'attrs' -%}
data-fa="{{ type }}" data-fa-section="{{ section.id }}"{% if request.design_mode %} data-fa-settings="{{ st | json | escape }}"{% endif %} data-width="{% if width == 'container' or width == 'fluid_container' or width == 'stretch_width' or width == 'full_width' %}{{ width }}{% else %}{{ width_default | default: 'full_width' }}{% endif %}"{% if st.enable_custom_fonts %} data-own-font{% endif %}
{%- elsif part == 'vars' -%}
{%- unless no_bg -%}--fa-bg: {% if st.enable_custom_style %}{% render 'scheme-color', color: bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};{%- endunless -%}
--fa-hf: {% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--fa-bf: {% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--fa-pt-m: {{ pt_m | default: 0 }}px;--fa-pb-m: {{ pb_m | default: 0 }}px;--fa-pt-d: {{ pt_d | default: 0 }}px;--fa-pb-d: {{ pb_d | default: 0 }}px;
{%- if st.reset_spacing -%}--fa-mt-m: 0px;--fa-mb-m: 0px;--fa-mt-d: 0px;--fa-mb-d: 0px;{%- else -%}--fa-mt-m: {{ st.section_margin_top_mobile | default: 0 }}px;--fa-mb-m: {{ st.section_margin_bottom_mobile | default: 0 }}px;--fa-mt-d: {{ st.section_margin_top_desktop | default: 0 }}px;--fa-mb-d: {{ st.section_margin_bottom_desktop | default: 0 }}px;{%- endif -%}
{%- elsif part == 'fonts' -%}
{%- if st.enable_custom_fonts -%}<style>{{ st.heading_font | font_face: font_display: 'swap' }}{{ st.body_font | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- else -%}
<style>
  :is(#_, [data-fa]) { box-sizing: border-box; background: var(--fa-bg, var(--color-background)); color: var(--color-text); padding-block: var(--fa-pt-m) var(--fa-pb-m); margin-block: var(--fa-mt-m) var(--fa-mb-m); }
  :is(#_, [data-fa]) *, :is(#_, [data-fa]) ::before, :is(#_, [data-fa]) ::after { box-sizing: border-box; }
  :is(#_, [data-fa]) .fa-inner { width: 100%; margin-inline: auto; padding-inline: 20px; }
  :is(#_, [data-fa][data-width="container"]) .fa-inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  :is(#_, [data-fa][data-width="fluid_container"]) .fa-inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  :is(#_, [data-fa]) .fa-h { font-family: var(--fa-hf); }
  :is(#_, [data-fa]) .fa-t, :is(#_, [data-fa]) .fa-t :is(p, li, span, strong, em, a) { font-family: var(--fa-bf); }
  :is(#_, [data-fa]) .fa-rich > :first-child { margin-top: 0; }
  :is(#_, [data-fa]) .fa-rich > :last-child { margin-bottom: 0; }
  :is(#_, [data-fa]) [hidden] { display: none !important; }
  :is(#_, [data-fa]) :is(a, button, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (min-width: 768px) {
    :is(#_, [data-fa]) { padding-block: var(--fa-pt-d) var(--fa-pb-d); margin-block: var(--fa-mt-d) var(--fa-mb-d); }
    :is(#_, [data-fa]) .fa-inner { padding-inline: 1.5rem; }
  }
  @media (min-width: 1200px) { :is(#_, [data-fa][data-width="stretch_width"]) .fa-inner { padding-inline: 3rem; } }
{% comment %}{% endcomment %}</style>
{%- endif -%}
</template>
