<template compat="shopify">
{%- comment -%}
  Materia Themes. The root attributes (part: 'attrs') and the shared CSS
  variables (part: 'vars') of the benefits Image and video sections. The
  same values are derived by media-live-benefits.js in the builder.
  side, align, align_m: the section's own setting values. tw: text column
  width in percent. gap_d, gap_m: column gaps in px.
{%- endcomment -%}
{%- assign st = section.settings -%}
{%- if part == 'attrs' -%}
data-mlb-section="{{ section.id }}" data-mlb-settings="{{ st | json | escape }}" data-width="{{ st.section_width | default: 'full_width' }}" data-side="{{ side | default: 'left' }}" data-align="{{ align | default: 'left' }}" data-align-m="{{ align_m | default: 'left' }}" data-order-m="{{ st.mobile_order | default: 'media_first' }}"
{%- else -%}
--m-bg: {% if st.enable_custom_style %}{% render 'scheme-color', color: st.section_bg, fallback: 'var(--color-background)' %}{% else %}var(--color-background){% endif %};--m-text: {% if st.enable_custom_style %}{% render 'scheme-color', color: st.text_color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--m-hf: {% if st.enable_custom_fonts and st.heading_font.family != blank %}{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }}{% else %}var(--heading-font){% endif %};--m-bf: {% if st.enable_custom_fonts and st.body_font.family != blank %}{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }}{% else %}var(--body-font){% endif %};--m-pt-m: {{ st.padding_top_mobile | default: 0 }}px;--m-pb-m: {{ st.padding_bottom_mobile | default: 0 }}px;--m-pt-d: {{ st.padding_top_desktop | default: 0 }}px;--m-pb-d: {{ st.padding_bottom_desktop | default: 0 }}px;--m-px-m: {{ st.side_padding_mobile | default: 0 }}px;--m-px-d: {{ st.side_padding_desktop | default: 0 }}px;--m-gap-m: {{ gap_m | default: 0 }}px;--m-gap-d: {{ gap_d | default: 0 }}px;--m-cgap: {{ st.content_gap | default: 0 }}px;--m-tw: {{ tw | default: 50 }}%;
{%- endif -%}
</template>
