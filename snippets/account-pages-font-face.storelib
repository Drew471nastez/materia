<template compat="shopify">
{%- comment -%}
  Materia Themes. The @font-face rules of an account, password or utility
  page section's custom fonts (see account-pages-font-vars).
  Params: st (section.settings)
{%- endcomment -%}
{%- if st.enable_custom_fonts -%}
  <style>
    {%- if st.heading_font != blank -%}{{ st.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if st.body_font != blank -%}{{ st.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {% comment %}{% endcomment %}</style>
{%- endif -%}
</template>
