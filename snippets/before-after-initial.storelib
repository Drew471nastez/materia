<template compat="shopify">
{% assign s = section.settings %}
<style>
{% if s.enable_custom_fonts %}
{% if s.body_font.family %}{{ s.body_font | font_face:font_display:'swap' }}#shopify-section-{{ section.id }} [data-before-after-controls]{font-family:{{ s.body_font.family }},{{ s.body_font.fallback_families | default:'sans-serif' }}}{% endif %}
{% if s.heading_font.family %}{{ s.heading_font | font_face:font_display:'swap' }}#shopify-section-{{ section.id }} .bar__heading{font-family:{{ s.heading_font.family }},{{ s.heading_font.fallback_families | default:'sans-serif' }}}{% endif %}
{% endif %}
{% for block in section.blocks %}{% assign b = block.settings %}
{% if b.enable_custom_fonts and b.font.family %}{{ b.font | font_face:font_display:'swap' }}#shopify-section-{{ section.id }} [data-ba-block="{{ block.id }}"]{font-family:{{ b.font.family }},{{ b.font.fallback_families | default:'sans-serif' }}!important}{% endif %}
{% if block.type == 'button' %}
#shopify-section-{{ section.id }} [data-ba-block="{{ block.id }}"]{
{% if b.enable_custom_style %}{% render 'button-overrides', bg:b.bg, text:b.color, border:b.border_color, hover_bg:b.bg_hover, hover_text:b.color_hover %}{% endif %}
{% if b.use_theme_button == false %}--mb-radius:{{ b.radius }}px;--mb-padding-x:{{ b.pad_x }}px;--mb-padding-y:{{ b.pad_y }}px;--mb-font-size:{{ b.size }}px;border-width:{{ b.border_width }}px;{% if b.weight_enable %}--mb-weight:{{ b.weight }};{% endif %}{% endif %}
}
{% endif %}
{% endfor %}
{% if s.show_labels == false %}#shopify-section-{{ section.id }} .bar__label{display:none}{% endif %}
</style>
</template>
