<template compat="shopify">
{%- assign s = block.settings -%}
{%- assign aid = section.id | append: '-' | append: block.id -%}
{%- assign qid = 'QuestionForm-' | append: aid -%}
<div class="product-addons mt-product-actions" {{ block.shopify_attributes }}>
  {%- if s.show_ask_question -%}
    {%- if s.ask_question_mode == 'page' -%}
      <a href="{{ s.ask_question_page.url | default: '/pages/contact' }}" class="mt-product-actions__link">{{ s.ask_question_label | default: 'Have questions?' | escape }}</a>
    {%- else -%}
      <button type="button" class="mt-product-actions__link" popovertarget="Question-{{ aid }}">{{ s.ask_question_label | default: 'Have questions?' | escape }}</button>
      <div id="Question-{{ aid }}" class="mt-product-dialog" popover role="dialog" aria-modal="true" aria-labelledby="QuestionTitle-{{ aid }}">
        <header><h2 id="QuestionTitle-{{ aid }}">{{ s.ask_question_label | default: 'Have questions?' | escape }}</h2><button type="button" popovertarget="Question-{{ aid }}" popovertargetaction="hide" aria-label="{{ 'accessibility.close' | t }}">×</button></header>
        <p>{{ product.title | escape }}</p>
        {%- form 'contact', id: qid, data-storelib-form: 'contact' -%}
          <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[product_url]" value="{{ product.url | escape }}">
          <label for="QuestionName-{{ aid }}">{{ 'templates.contact.form.name' | t }}</label>
          <input id="QuestionName-{{ aid }}" name="contact[name]" autocomplete="name" value="{{ customer.name | escape }}" required>
          <label for="QuestionEmail-{{ aid }}">{{ 'templates.contact.form.email' | t }}</label>
          <input id="QuestionEmail-{{ aid }}" name="contact[email]" type="email" autocomplete="email" value="{{ customer.email | escape }}" required>
          <label for="QuestionBody-{{ aid }}">{{ s.question_message_label | default: 'Your question' | escape }}</label>
          <textarea id="QuestionBody-{{ aid }}" name="contact[body]" rows="4" required placeholder="{{ s.question_placeholder | default: 'What would you like to know?' | escape }}"></textarea>
          {%- if form.posted_successfully? -%}<p role="status">{{ 'templates.contact.form.post_success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <button class="btn-primary" type="submit">{{ 'templates.contact.form.send_contact' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  {%- endif -%}
  {%- if s.show_share -%}
    <button type="button" class="mt-product-actions__link" aria-haspopup="dialog" aria-expanded="false" aria-controls="SharePanel-{{ aid }}" data-product-share data-share-title="{{ product.title | escape }}" data-share-url="{{ product.url | escape }}" data-share-panel="SharePanel-{{ aid }}">{{ 'accessibility.share' | t }}</button>
    <div id="SharePanel-{{ aid }}" class="mt-product-dialog" popover role="dialog" aria-labelledby="ShareTitle-{{ aid }}">
      <header><h2 id="ShareTitle-{{ aid }}">{{ 'accessibility.share' | t }}</h2><button type="button" popovertarget="SharePanel-{{ aid }}" popovertargetaction="hide" aria-label="{{ 'accessibility.close' | t }}">×</button></header>
      <label for="ShareUrl-{{ aid }}">{{ 'accessibility.share_copy_link' | t }}</label>
      <input id="ShareUrl-{{ aid }}" data-share-value value="{{ request.origin }}{{ product.url }}" readonly>
      <button type="button" class="btn-primary" data-copy-product-url>{{ s.share_copy_label | default: 'Copy link' | escape }}</button>
      <p role="status" data-copy-status data-copied="{{ s.share_copied_label | default: 'Link copied' | escape }}" data-copy-error="{{ s.share_error_label | default: 'Select and copy the link above.' | escape }}"></p>
    </div>
  {%- endif -%}
</div>
</template>
