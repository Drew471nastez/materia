<template compat="shopify">
{%- comment -%}
  Materia Themes. A button block of Testimonial Wall and Testimonial With
  Product: a theme button (Theme settings > Buttons draws it), a link when a
  link is set and a plain button when not. Its own colours apply only while
  the block's custom styling is on. No label prints it hidden, so a label
  typed in the builder shows at once.
  b: the block. bs: its settings.
{%- endcomment -%}
{%- capture btn_style -%}{%- if bs.enable_custom_style -%}{%- render 'button-overrides', bg: bs.bg, text: bs.text_color, hover_bg: bs.bg_hover, hover_text: bs.text_hover -%}{%- endif -%}{%- endcapture -%}
{%- capture btn_attrs -%}class="r7t__btn" data-theme-button="{% if bs.button_style == 'secondary' %}secondary{% else %}primary{% endif %}" data-sl-button data-r7t-block="{{ b.id }}" data-r7t-type="button"{% if request.design_mode %} data-r7t-settings="{{ bs | json | escape }}"{% endif %}{% if bs.label == blank %} hidden{% endif %} style="{{ btn_style }}" {{ b.shopify_attributes }}{%- endcapture -%}
{%- if bs.link != blank -%}
  <a href="{{ bs.link }}" {{ btn_attrs }}>{{ bs.label | escape }}</a>
{%- else -%}
  <button type="button" {{ btn_attrs }}>{{ bs.label | escape }}</button>
{%- endif -%}
</template>
