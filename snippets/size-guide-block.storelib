<template compat="shopify">
{%- comment -%}
  Materia Themes — Size Guide Block (snippet)
  Right-aligned "Size Guide" trigger with a clean modal popup. Used by
  the "size_guide" block in the main product section. Inline-content
  size chart driven by block settings — no Shopify Page required.
{%- endcomment -%}

{%- assign sg = block.settings -%}

{%- comment -%}
  Color customizer override pattern.
  - Defaults in the schema are `rgba(0,0,0,0)` (transparent), so the
    SCHEME drives every colour by default. The trigger / icon / modal
    blend into the active page colour scheme.
  - When the merchant picks any opaque colour in the block customiser,
    that value overrides the scheme variable.
  - We treat both blank AND fully-transparent rgba(...,0) as "no
    override" so a fresh customiser uses the scheme.
{%- endcomment -%}
{%- liquid
  assign sg_trig_override   = ''
  assign sg_icon_override   = ''
  assign sg_modal_override  = ''
  assign sg_text_override   = ''
  assign sg_title_override  = ''
  assign sg_tb_override     = ''
  assign sg_ts_override     = ''
  if sg.trig_color != blank and sg.trig_color != 'rgba(0,0,0,0)'
    assign sg_trig_override = sg.trig_color
  endif
  if sg.icon_color != blank and sg.icon_color != 'rgba(0,0,0,0)'
    assign sg_icon_override = sg.icon_color
  endif
  if sg.modal_bg != blank and sg.modal_bg != 'rgba(0,0,0,0)'
    assign sg_modal_override = sg.modal_bg
  endif
  if sg.text_color != blank and sg.text_color != 'rgba(0,0,0,0)'
    assign sg_text_override = sg.text_color
  endif
  if sg.title_color != blank and sg.title_color != 'rgba(0,0,0,0)'
    assign sg_title_override = sg.title_color
  endif
  if sg.table_border != blank and sg.table_border != 'rgba(0,0,0,0)'
    assign sg_tb_override = sg.table_border
  endif
  if sg.table_stripe != blank and sg.table_stripe != 'rgba(0,0,0,0)'
    assign sg_ts_override = sg.table_stripe
  endif
-%}
<div id="SG-{{ block.id }}" class="sg" {{ block.shopify_attributes }}
     style="
       --sg-trig-color: {% if sg_trig_override != blank %}{{ sg_trig_override }}{% else %}var(--color-text, #111111){% endif %};
       --sg-trig-fs: {{ sg.trig_size | default: 14 }}px;
       --sg-icon: {% if sg_icon_override != blank %}{{ sg_icon_override }}{% else %}var(--color-text, #111111){% endif %};
       --sg-modal-bg: {% if sg_modal_override != blank %}{{ sg_modal_override }}{% else %}var(--color-background, #ffffff){% endif %};
       --sg-modal-radius: {{ sg.modal_radius | default: 16 }}px;
       --sg-text: {% if sg_text_override != blank %}{{ sg_text_override }}{% else %}var(--color-text, #111111){% endif %};
       --sg-title: {% if sg_title_override != blank %}{{ sg_title_override }}{% else %}var(--color-heading, var(--color-text, #111111)){% endif %};
       --sg-tb: {% if sg_tb_override != blank %}{{ sg_tb_override }}{% else %}color-mix(in srgb, var(--color-text, #111111) 18%, transparent){% endif %};
       --sg-ts: {% if sg_ts_override != blank %}{{ sg_ts_override }}{% else %}color-mix(in srgb, var(--color-background, #ffffff) 92%, var(--color-text, #111111) 8%){% endif %};
       text-align: {{ sg.align | default: 'right' }};
     ">
  <button type="button" class="sg__trigger{% if sg.underline %} sg__trigger--u{% endif %}" data-sg-open aria-haspopup="dialog" aria-expanded="false" aria-controls="SGDialog-{{ block.id }}">
    <span class="sg__label">{{ sg.trig_text | default: 'Size Guide' }}</span>
    {%- if sg.show_icon -%}
      <span class="sg__icn" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.25 14.5 14.5 3.25l6.25 6.25L9.5 20.75z"/><path d="M7 10.75 8.5 12.25"/><path d="M9.75 8 11.25 9.5"/><path d="M12.5 5.25 14 6.75"/></svg>
      </span>
    {%- endif -%}
  </button>

  <div class="sg__overlay" data-sg-overlay hidden></div>
  <div id="SGDialog-{{ block.id }}" class="sg__dialog" role="dialog" aria-modal="true" aria-labelledby="SGTitle-{{ block.id }}" data-sg-dialog hidden>
    <div class="sg__modal" data-sg-modal>
      <div class="sg__head">
        <h3 id="SGTitle-{{ block.id }}" class="sg__title">{{ sg.modal_title | default: 'Size Guide' }}</h3>
        <button type="button" class="sg__close" aria-label="Close" data-sg-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>
      <div class="sg__body">
        {%- if sg.headers != blank -%}
          {%- assign headers = sg.headers | split: '|' -%}
          <div class="sg__table-wrap">
            <table class="sg__table">
              <thead><tr>{%- for h in headers -%}<th>{{ h | strip }}</th>{%- endfor -%}</tr></thead>
              <tbody>
                {%- for n in (1..8) -%}
                  {%- assign key = 'row_' | append: n -%}{%- assign rv = sg[key] -%}
                  {%- if rv != blank -%}
                    {%- assign cells = rv | split: '|' -%}
                    <tr>{%- for c in cells -%}<td>{{ c | strip }}</td>{%- endfor -%}</tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}
        {%- if sg.html != blank -%}<div class="sg__html">{{ sg.html }}</div>{%- endif -%}
        {%- if sg.notes != blank -%}<div class="sg__notes">{{ sg.notes }}</div>{%- endif -%}
        {%- if sg.headers == blank and sg.html == blank and sg.notes == blank -%}
          <p class="sg__empty">Add column headers and rows in this block's settings to populate the size chart.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #SG-{{ block.id }} { display: block; }
  #SG-{{ block.id }} .sg__trigger {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: 0; cursor: pointer;
    color: var(--sg-trig-color);
    font-size: var(--sg-trig-fs);
    font-weight: 600;
    line-height: 1.2; padding: 6px 0;
    font-family: inherit;
  }
  #SG-{{ block.id }} .sg__trigger--u { text-decoration: underline; text-underline-offset: 2px; }
  #SG-{{ block.id }} .sg__icn { width: 18px; height: 18px; color: var(--sg-icon); display: inline-flex; }
  #SG-{{ block.id }} .sg__icn svg { width: 100%; height: 100%; display: block; }
  #SG-{{ block.id }} .sg__overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); opacity: 0; pointer-events: none; transition: opacity .2s ease; z-index: 9998; }
  #SG-{{ block.id }} .sg__overlay.is-open { opacity: 1; pointer-events: auto; }
  #SG-{{ block.id }} .sg__dialog { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 16px; opacity: 0; pointer-events: none; transition: opacity .2s ease; }
  #SG-{{ block.id }} .sg__dialog.is-open { opacity: 1; pointer-events: auto; }
  #SG-{{ block.id }} .sg__modal {
    background: var(--sg-modal-bg); color: var(--sg-text);
    border-radius: var(--sg-modal-radius); padding: 24px;
    width: 100%; max-width: 360px; max-height: 85vh; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,.3);
    transform: translateY(8px); transition: transform .2s ease;
  }
  #SG-{{ block.id }} .sg__dialog.is-open .sg__modal { transform: translateY(0); }
  @media (min-width: 600px) { #SG-{{ block.id }} .sg__modal { max-width: 720px; } }
  #SG-{{ block.id }} .sg__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  #SG-{{ block.id }} .sg__title { margin: 0 !important; font-size: 20px; font-weight: 700; line-height: 1.2; color: var(--sg-text); }
  #SG-{{ block.id }} .sg__close { background: transparent; border: 0; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; color: var(--sg-text); border-radius: 8px; }
  #SG-{{ block.id }} .sg__close:hover { background: rgba(0,0,0,.06); }
  #SG-{{ block.id }} .sg__close svg { width: 18px; height: 18px; }
  #SG-{{ block.id }} .sg__body { display: flex; flex-direction: column; gap: 14px; font-size: 15px; line-height: 1.55; }
  #SG-{{ block.id }} .sg__table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  #SG-{{ block.id }} .sg__table { width: 100%; border-collapse: collapse; font-size: 14px; }
  #SG-{{ block.id }} .sg__table th, #SG-{{ block.id }} .sg__table td { padding: 10px 12px; border: 1px solid var(--sg-tb); text-align: left; white-space: nowrap; }
  #SG-{{ block.id }} .sg__table th { background: var(--sg-ts); font-weight: 700; }
  #SG-{{ block.id }} .sg__table tbody tr:nth-child(even) td { background: var(--sg-ts); }
  #SG-{{ block.id }} .sg__html { font-size: 14px; }
  #SG-{{ block.id }} .sg__html table { width: 100%; border-collapse: collapse; }
  #SG-{{ block.id }} .sg__html th, #SG-{{ block.id }} .sg__html td { padding: 10px 12px; border: 1px solid var(--sg-tb); text-align: left; }
  #SG-{{ block.id }} .sg__html th { background: var(--sg-ts); font-weight: 700; }
  #SG-{{ block.id }} .sg__notes { font-size: 14px; line-height: 1.6; }
  #SG-{{ block.id }} .sg__notes p { margin: 0; }
  #SG-{{ block.id }} .sg__notes p + p { margin-top: 8px; }
  #SG-{{ block.id }} .sg__empty { color: #6B7280; margin: 0; font-style: italic; }
  html.sg-lock { overflow: hidden; }
{% comment %}{% endcomment %}</style>

<script>
(function(){
  var root = document.getElementById('SG-{{ block.id }}');
  if (!root || root.__sgInit) return;
  root.__sgInit = true;
  var trig = root.querySelector('[data-sg-open]');
  var ov = root.querySelector('[data-sg-overlay]');
  var dlg = root.querySelector('[data-sg-dialog]');
  var modal = root.querySelector('[data-sg-modal]');
  var closeBtn = root.querySelector('[data-sg-close]');
  if (!trig || !ov || !dlg || !modal || !closeBtn) return;
  var lastFocus = null;
  function open(){
    lastFocus = document.activeElement;
    ov.hidden = false; dlg.hidden = false;
    requestAnimationFrame(function(){
      ov.classList.add('is-open'); dlg.classList.add('is-open');
      trig.setAttribute('aria-expanded','true');
      document.documentElement.classList.add('sg-lock');
      closeBtn.focus();
    });
    document.addEventListener('keydown', onKey);
    dlg.addEventListener('click', onOut);
  }
  function close(){
    ov.classList.remove('is-open'); dlg.classList.remove('is-open');
    trig.setAttribute('aria-expanded','false');
    document.documentElement.classList.remove('sg-lock');
    setTimeout(function(){
      ov.hidden = true; dlg.hidden = true;
      if (lastFocus && lastFocus.focus) lastFocus.focus({preventScroll:true});
    }, 200);
    document.removeEventListener('keydown', onKey);
    dlg.removeEventListener('click', onOut);
  }
  function onOut(e){ if (!modal.contains(e.target)) close(); }
  function onKey(e){ if (e.key === 'Escape') { e.preventDefault(); close(); } }
  trig.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  ov.addEventListener('click', close);
})();
{% comment %}{% endcomment %}</script>

</template>