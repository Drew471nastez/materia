<template compat="shopify">
{%- assign code_state = cart.discount_codes | where: 'code', discount_code | first -%}
{%- if code_state != blank -%}
  <small class="cart-code-status" data-applicable="{{ code_state.applicable }}">
    {%- if code_state.applicable -%}{{ 'general.content.discount_code_applied' | t }}{%- else -%}{{ 'general.content.discount_code_error' | t }}{%- endif -%}
  </small>
{%- endif -%}
</template>
