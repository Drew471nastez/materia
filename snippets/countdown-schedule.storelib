<template compat="shopify">
{%- liquid
  assign schedule_end = controls.end_iso | default: legacy_date
  if controls.timing_input != 'iso' and controls.end_date != blank
    assign schedule_hour = controls.end_hour | default: 23 | prepend: '0' | slice: -2, 2
    assign schedule_minute = controls.end_minute | default: 59 | prepend: '0' | slice: -2, 2
    assign schedule_zone = controls.utc_offset | default: '+00:00' | strip
    assign schedule_date = controls.end_date | strip
    assign schedule_end = schedule_date | append: 'T' | append: schedule_hour | append: ':' | append: schedule_minute | append: ':00' | append: schedule_zone
  endif
  if allow_product
    assign product_end = product.metafields.custom.countdown_timer.value | default: product.metafields.custom.countdown_timer
    if controls.date_source == 'product'
      assign schedule_end = product_end | default: schedule_end
    elsif schedule_end == blank
      assign schedule_end = product_end
    endif
  endif
  echo schedule_end
-%}
</template>
