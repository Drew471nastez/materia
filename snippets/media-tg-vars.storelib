<template compat="shopify">
{%- comment -%}
  Materia Themes. The --tg-* variables shared by the text-grid sections,
  printed inside the root's style attribute. Mirrors media-live-text-grid.js.
  Use: style="{% render 'media-tg-vars', st: section.settings %}"
{%- endcomment -%}
{%- liquid
  case st.section_width
    when 'container'
      assign tg_maxw = 'calc(var(--page-width, 1300px) + 3rem)'
    when 'fluid_container'
      assign tg_maxw = 'calc(var(--fluid-container-width, 1500px) + 3rem)'
    when 'custom'
      assign tg_maxw = st.custom_max_width_desktop | default: 1200 | append: 'px'
    else
      assign tg_maxw = 'none'
  endcase
  assign tg_stretch = '0px'
  if st.section_width == 'stretch_width'
    assign tg_stretch = '3rem'
  endif
-%}
--tg-maxw:{{ tg_maxw }};--tg-stretch:{{ tg_stretch }};--tg-pt-d:{{ st.padding_top_desktop | default: 0 }}px;--tg-pb-d:{{ st.padding_bottom_desktop | default: 0 }}px;--tg-px-d:{{ st.side_padding_desktop | default: 0 }}px;--tg-pt-m:{{ st.padding_top_mobile | default: 0 }}px;--tg-pb-m:{{ st.padding_bottom_mobile | default: 0 }}px;--tg-px-m:{{ st.side_padding_mobile | default: 0 }}px;
{%- if st.enable_custom_style -%}
--tg-bg:{% render 'scheme-color', color: st.section_bg, fallback: 'initial' %};
{%- if text_color -%}--tg-text:{% render 'scheme-color', color: st.text_color, fallback: 'initial' %};{%- endif -%}
{%- endif -%}
{%- if st.enable_custom_fonts -%}
{%- if st.heading_font.family != blank -%}--tg-hf:{{ st.heading_font.family }}, {{ st.heading_font.fallback_families | default: 'sans-serif' }};{%- if st.heading_font.weight != blank -%}--tg-hw:{{ st.heading_font.weight }};{%- endif -%}{%- endif -%}
{%- if st.body_font.family != blank -%}--tg-bf:{{ st.body_font.family }}, {{ st.body_font.fallback_families | default: 'sans-serif' }};{%- if st.body_font.weight != blank -%}--tg-bw:{{ st.body_font.weight }};{%- endif -%}{%- endif -%}
{%- endif -%}
</template>
