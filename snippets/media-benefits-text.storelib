<template compat="shopify">
{%- comment -%}
  Materia Themes. Eyebrow, heading, subheading and button blocks of the
  benefits Image and video sections. p: the section's class prefix.
  {% render 'media-benefits-text', block: block, p: 'ivt' %}
{%- endcomment -%}
{%- assign bs = block.settings -%}
{%- assign own = bs.enable_custom_style -%}
{%- case block.type -%}
  {%- when 'eyebrow' -%}
    <p class="{{ p }}__eyebrow mlb__eyebrow" {% render 'media-benefits-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--b-fs: {{ bs.size | default: 12 }}px;">{{ bs.text }}</p>
  {%- when 'heading' -%}
    <h2 class="{{ p }}__heading mlb__heading" {% render 'media-benefits-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-heading)' %}{% else %}var(--color-heading){% endif %};--b-fs-m: {{ bs.size_mobile | default: 32 }}px;--b-fs-d: {{ bs.size_desktop | default: 44 }}px;{% if bs.uppercase != nil %}--b-tt: {% if bs.uppercase %}uppercase{% else %}var(--heading-text-transform, none){% endif %};{% endif %}">{{ bs.text }}</h2>
  {%- when 'subheading' -%}
    {%- assign fs_m = bs.size_mobile | default: bs.size | default: 15 -%}
    {%- assign fs_d = bs.size_desktop | default: bs.size | default: 17 -%}
    <div class="{{ p }}__subheading mlb__sub" {% render 'media-benefits-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--b-fs-m: {{ fs_m }}px;--b-fs-d: {{ fs_d }}px;">{{ bs.text }}</div>
  {%- when 'footnote' -%}
    <p class="{{ p }}__footnote mlb__footnote" {% render 'media-benefits-block', block: block %}{% if bs.text == blank %} hidden{% endif %} style="--b-c: {% if own %}{% render 'scheme-color', color: bs.color, fallback: 'var(--color-text)' %}{% else %}var(--color-text){% endif %};--b-fs: {{ bs.size | default: 13 }}px;--b-mt: {{ bs.margin_top | default: 0 }}px;">{{ bs.text }}</p>
  {%- when 'button' -%}
    {%- capture btn_style -%}
      {%- if own -%}{%- render 'button-overrides', bg: bs.bg, text: bs.color, border: bs.border_color, hover_bg: bs.bg_hover, hover_text: bs.color_hover, hover_border: bs.border_color_hover -%}{%- endif -%}
      {%- if bs.use_theme_button == false -%}--mb-radius: {{ bs.radius }}px;--mb-padding-y: {{ bs.padding_y }}px;--mb-padding-x: {{ bs.padding_x }}px;--mb-font-size: {{ bs.font_size }}px;--mb-weight: {{ bs.font_weight | default: 600 }};--btn-border-width: {{ bs.border_width }}px;{%- endif -%}
      {%- if bs.uppercase -%}--btn-text-transform: uppercase;{%- endif -%}
    {%- endcapture -%}
    {%- assign role = 'primary' -%}
    {%- if bs.button_style == 'secondary' -%}{%- assign role = 'secondary' -%}{%- endif -%}
    {%- capture btn_attrs -%}class="{{ p }}__btn mlb__btn" data-theme-button="{{ role }}" data-sl-button data-full="{% if bs.full_width %}true{% else %}false{% endif %}" {% render 'media-benefits-block', block: block %}{% if bs.label == blank %} hidden{% endif %} style="{{ btn_style }}"{%- endcapture -%}
    {%- if bs.link != blank or fallback_href != blank -%}
      <a href="{{ bs.link | default: fallback_href }}" {{ btn_attrs }}>{{ bs.label | escape }}</a>
    {%- else -%}
      <button type="button" {{ btn_attrs }}>{{ bs.label | escape }}</button>
    {%- endif -%}
{%- endcase -%}
</template>
