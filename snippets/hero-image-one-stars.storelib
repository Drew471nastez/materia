<template compat="shopify">
<span class="hi1__stars{% if tiles %} hi1__stars--tiles{% endif %}" role="img" aria-label="{{ filled }} / {{ total }}">
{%- for n in (1..5) -%}
  {%- assign percent = filled | minus: n | plus: 1 | times: 100 | at_least: 0 | at_most: 100 -%}
  <span class="hi1__star"{% if n > total %} hidden{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01z"/></svg><span class="hi1__star-fill" style="width:{{ percent }}%"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01z"/></svg></span></span>
{%- endfor -%}
</span>
</template>
