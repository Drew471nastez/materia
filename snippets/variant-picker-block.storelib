<template compat="shopify">
{%- comment -%}
  Materia Themes. The Variant picker block of Main product and Featured
  product: buttons and swatches, or one dropdown per option. "Custom style"
  paints both. Inputs: block, product, section, group (variant image groups)
{%- endcomment -%}
{%- assign vp = block.settings -%}
{%- if vp.enable_picker_custom -%}
  <style>
    #variant-picker-{{ block.id }} {
      --mt-select-radius: {{ vp.picker_border_radius | default: 8 }}px;
      {%- if vp.picker_bg_unselected != blank %} --mt-select-bg: {{ vp.picker_bg_unselected }};{% endif -%}
      {%- if vp.picker_text_unselected != blank %} --mt-select-text: {{ vp.picker_text_unselected }};{% endif -%}
      {%- if vp.picker_text_hover != blank %} --mt-select-text-hover: {{ vp.picker_text_hover }}; --mt-select-hover: {{ vp.picker_text_hover }};{% endif -%}
      {%- if vp.picker_border_color != blank %} --mt-select-border: {{ vp.picker_border_color }}; --mt-select-border-active: {{ vp.picker_border_color }};{% endif -%}
      {%- if vp.picker_bg_selected != blank %} --mt-select-opt-active-bg: {{ vp.picker_bg_selected }};{% endif -%}
      {%- if vp.picker_text_selected != blank %} --mt-select-opt-active-text: {{ vp.picker_text_selected }};{% endif %}
    }
    {%- comment -%} Buttons only: :not(.product__color-swatch) leaves colour swatches as they are. {%- endcomment %}
    #variant-picker-{{ block.id }} .product__item-option:not(.product__color-swatch),
    #variant-picker-{{ block.id }} input + label:not(.product__color-swatch) {
      border-radius: {{ vp.picker_border_radius | default: 8 }}px !important;
      transition: background-color .2s ease, color .2s ease, border-color .2s ease !important;
      {% if vp.picker_bg_unselected != blank %}background: {{ vp.picker_bg_unselected }} !important;{% endif %}
      {% if vp.picker_border_color != blank %}border-color: {{ vp.picker_border_color }} !important;{% endif %}
      {% if vp.picker_text_unselected != blank %}color: {{ vp.picker_text_unselected }} !important;{% endif %}
    }
    #variant-picker-{{ block.id }} .product__item-option:not(.product__color-swatch):hover,
    #variant-picker-{{ block.id }} input + label:not(.product__color-swatch):hover {
      {% if vp.picker_text_hover != blank %}color: {{ vp.picker_text_hover }} !important;{% endif %}
    }
    #variant-picker-{{ block.id }} input:checked + label:not(.product__color-swatch),
    #variant-picker-{{ block.id }} .product__item-option:not(.product__color-swatch).active,
    #variant-picker-{{ block.id }} .product__item-option:not(.product__color-swatch)[aria-checked="true"] {
      {% if vp.picker_bg_selected != blank %}background: {{ vp.picker_bg_selected }} !important;{% endif %}
      {% if vp.picker_text_selected != blank %}color: {{ vp.picker_text_selected }} !important;{% endif %}
      {% if vp.picker_border_color != blank %}border-color: {{ vp.picker_border_color }} !important;{% endif %}
    }
  {% comment %}{% endcomment %}</style>
{%- endif -%}
<div
  id="variant-picker-{{ block.id }}"
  class="product-detail__variant-picker mb-25"
  {{ block.shopify_attributes }}
  data-type="{{ vp.variant_type }}"
>
  {% if group %}
    {%- render 'color-swatches', product: product, type: 'group', block: block, section: section -%}
  {% else %}
    {%- render 'color-swatches', product: product, type: 'detail', block: block, section: section -%}
  {% endif %}
</div>
</template>
