<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared layout for the benefits Image and video sections
  (Image & Video with Text, Image & Video Benefits, Image With Text Benefits,
  Image & Text Dual). Every value is a CSS variable the section prints on its
  root (.mlb) and media-live-benefits.js updates in the builder, so the first
  paint and a live edit use the same rules.
  {% render 'media-benefits-style', section: section, bp: 900 %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign bp = bp | default: 900
-%}
<style>
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_mobile | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px !important; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px !important; }
  }
  {%- if st.reset_spacing %}
  #shopify-section-{{ sid }} { padding-top: 0 !important; padding-bottom: 0 !important; --section-spacing: 0px; }
  #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
  .shopify-section:has(+ #shopify-section-{{ sid }}) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  {%- endif %}
  #shopify-section-{{ sid }} .mlb { background: var(--m-bg); color: var(--m-text); font-family: var(--m-bf); padding: var(--m-pt-m) var(--m-px-m) var(--m-pb-m); box-sizing: border-box; }
  #shopify-section-{{ sid }} .mlb *, #shopify-section-{{ sid }} .mlb *::before, #shopify-section-{{ sid }} .mlb *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .mlb [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .mlb :is(h1, h2, h3, h4, h5, h6) { font-family: var(--m-hf); }
  #shopify-section-{{ sid }} .mlb__inner { width: 100%; margin-inline: auto; }
  #shopify-section-{{ sid }} .mlb[data-width='container'] .mlb__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .mlb[data-width='fluid_container'] .mlb__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  @media (min-width: 1200px) { #shopify-section-{{ sid }} .mlb[data-width='stretch_width'] .mlb__inner { padding-inline: 3rem; } }

  #shopify-section-{{ sid }} .mlb__grid { display: flex; flex-direction: column; gap: var(--m-gap-m); }
  #shopify-section-{{ sid }} .mlb__media, #shopify-section-{{ sid }} .mlb__text { width: 100%; min-width: 0; }
  #shopify-section-{{ sid }} .mlb[data-order-m='text_first'] .mlb__media { order: 2; }
  #shopify-section-{{ sid }} .mlb__text { display: flex; flex-direction: column; gap: var(--m-cgap); align-items: flex-start; text-align: left; }
  #shopify-section-{{ sid }} .mlb[data-align-m='center'] .mlb__text { align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .mlb[data-align-m='right'] .mlb__text { align-items: flex-end; text-align: right; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }} .mlb { padding: var(--m-pt-d) var(--m-px-d) var(--m-pb-d); }
    #shopify-section-{{ sid }} .mlb__grid { flex-direction: row; align-items: center; gap: var(--m-gap-d); }
    #shopify-section-{{ sid }} .mlb[data-side='right'] .mlb__grid { flex-direction: row-reverse; }
    #shopify-section-{{ sid }} .mlb[data-order-m] .mlb__media { order: 0; flex: 1 1 0; }
    #shopify-section-{{ sid }} .mlb__text { flex: 0 0 calc(var(--m-tw) - var(--m-gap-d) / 2); width: auto; }
    #shopify-section-{{ sid }} .mlb[data-align='left'] .mlb__text { align-items: flex-start; text-align: left; }
    #shopify-section-{{ sid }} .mlb[data-align='center'] .mlb__text { align-items: center; text-align: center; }
    #shopify-section-{{ sid }} .mlb[data-align='right'] .mlb__text { align-items: flex-end; text-align: right; }
  }

  #shopify-section-{{ sid }} .mlb__frame { position: relative; overflow: hidden; border-radius: var(--m-r, 0px); aspect-ratio: var(--m-ar, 4 / 5); background: var(--m-ph-bg, color-mix(in srgb, var(--color-text) 8%, var(--color-background))); color: var(--color-text); }
  #shopify-section-{{ sid }} .mlb__frame > :is(img, video, .video-wrapper, svg), #shopify-section-{{ sid }} .mlb__frame .video-wrapper > * { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .mlb__frame > :is(img, video), #shopify-section-{{ sid }} .mlb__frame .video-wrapper video { object-fit: var(--m-fit, cover); }
  #shopify-section-{{ sid }} .mlb__frame > svg.mlb__ph { opacity: .35; padding: 18%; }

  #shopify-section-{{ sid }} .mlb__text > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .mlb__eyebrow { color: var(--b-c); font-size: var(--b-fs); font-weight: var(--subheading-weight, 700); letter-spacing: 2px; text-transform: uppercase; line-height: 1.2; }
  #shopify-section-{{ sid }} .mlb__heading { color: var(--b-c); font-size: var(--b-fs-m); line-height: var(--heading-line-height, 1.15); text-transform: var(--b-tt, var(--heading-text-transform, none)); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .mlb__sub { color: var(--b-c); font-size: var(--b-fs-m); line-height: 1.6; max-width: 560px; }
  #shopify-section-{{ sid }} .mlb__sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .mlb__sub p:last-child { margin: 0; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }} .mlb__heading, #shopify-section-{{ sid }} .mlb__sub { font-size: var(--b-fs-d); }
  }
  #shopify-section-{{ sid }} .mlb__btn[data-full='true'] { width: 100%; }
  #shopify-section-{{ sid }} .mlb__btn:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
</style>
</template>
