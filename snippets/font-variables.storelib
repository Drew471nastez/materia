<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% liquid
  assign font_family_body = 'Instrument Sans'
  assign font_family_heading = 'Instrument Sans'

  assign theme_st = settings
  # Typography is two font pickers: body and headings. Pairings and font
  # sources are retired; a picked font is always the font.
  assign tp = 'none'
  assign font_body_shopify = theme_st.font_body_system
  assign font_body_google = theme_st.font_body_google
  assign font_body_google_embed = theme_st.font_body_google_embed
  assign font_type_body = 'default_font'
  if font_body_shopify.family != blank
    assign font_type_body = 'shopify'
  endif

  assign font_heading_shopify = theme_st.font_heading_system
  assign font_heading_google = theme_st.font_heading_google
  assign font_body_heading_embed = theme_st.font_body_heading_embed
  assign font_type_heading = 'default_font'
  if font_heading_shopify.family != blank
    assign font_type_heading = 'shopify'
  endif
%}

{% comment %} Start check setting font {% endcomment %}
{%- comment -%}
  A font picked for body or headings (Google or Shopify) is loaded whether or
  not a pairing is chosen, because a picked font wins over the pairing for its
  text. The theme's own Instrument Sans loads only when no pairing replaces it.
{%- endcomment -%}
{% if font_type_body == 'default_font' and tp == 'none' %}
  {{
    'InstrumentSans-Regular.woff2'
    | asset_url
    | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
  }}
  {% style %}
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-SemiBold.woff2' | asset_url }}) format("woff2");
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Bold.ttf' | asset_url }});
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Medium.woff2' | asset_url }}) format("woff2");
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Regular.woff2' | asset_url }}) format("woff2");
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }
  {% endstyle %}
{% elsif font_type_body == 'google' and font_body_google != blank %}
  {% assign font_family_body = font_body_google %}
  {{ font_body_google_embed }}
{% elsif font_type_body == 'shopify' and font_body_shopify.family != blank %}
  {% # theme-check-disable AssetPreload %}
  <link rel="preload" as="font" href="{{ font_body_shopify | font_url }}" type="font/woff2" crossorigin>
  {% # theme-check-disable AssetPreload %}
  {%- capture font_family_body -%}{{ font_body_shopify.family }}, {{ font_body_shopify.fallback_families }}{%- endcapture -%}
  {%- style -%}
    {%- for variant in font_body_shopify.variants -%}{{ variant | font_face: font_display: 'swap' }}{%- endfor -%}
  {%- endstyle -%}
{% endif %}

{% if font_type_heading == 'default_font' and font_type_body != 'default_font' and tp == 'none' %}
  {{
    'InstrumentSans-Regular.woff2'
    | asset_url
    | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
  }}
  {% style %}
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-SemiBold.woff2' | asset_url }}) format("woff2");
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Bold.ttf' | asset_url }});
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Medium.woff2' | asset_url }}) format("woff2");
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "Instrument Sans";
      src: url({{ 'InstrumentSans-Regular.woff2' | asset_url }}) format("woff2");
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }
  {% endstyle %}
{% elsif font_type_heading == 'google' and font_heading_google != blank %}
  {% assign font_family_heading = font_heading_google %}
  {{ font_body_heading_embed }}
{% elsif font_type_heading == 'shopify' and font_heading_shopify.family != blank %}
  {% # theme-check-disable AssetPreload %}
  <link rel="preload" as="font" href="{{ font_heading_shopify | font_url }}" type="font/woff2" crossorigin>
  {% # theme-check-disable AssetPreload %}
  {%- capture font_family_heading -%}{{ font_heading_shopify.family }}, {{ font_heading_shopify.fallback_families }}{%- endcapture -%}
  {%- style -%}
    {%- for variant in font_heading_shopify.variants -%}{{ variant | font_face: font_display: 'swap' }}{%- endfor -%}
  {%- endstyle -%}
{% endif %}
{% liquid
  assign font_menu_family = font_family_body
  assign font_menu_type = theme_st.menu_font
  if font_menu_type == 'body_font'
    assign font_menu_family = font_family_body
  else
    assign font_menu_family = font_family_heading
  endif

  assign font_button_family = font_family_body
  assign font_button_type = theme_st.button_font
  if font_button_type == 'body_font'
    assign font_button_family = font_family_body
  else
    assign font_button_family = font_family_heading
  endif
%}
{% comment %} End check setting font {% endcomment %}

{% style %}
  :root {
    --body-font: {{ font_family_body }}, sans-serif;
    --heading-font: {{ font_family_heading }}, sans-serif;
    {%- comment -%} Menu and buttons point at the body or heading font, so a new font in the builder reaches them too. {%- endcomment %}
    --menu-font: {% if font_menu_type == 'body_font' %}var(--body-font){% else %}var(--heading-font){% endif %};
    --btn-font: {% if font_button_type == 'body_font' %}var(--body-font){% else %}var(--heading-font){% endif %};
  }
{% endstyle %}

{%- comment -%}
  Typography preset overrides.
  When the merchant picks any preset other than "none", load the matching
  Google Fonts and override --body-font / --heading-font / --menu-font / --btn-font
  plus heading text-transform and letter-spacing. The body/heading font_picker
  values further down become inert until preset is set back to "none".
{%- endcomment -%}
{%- assign tp = 'none' -%}
{%- if tp != 'none' and tp != blank -%}
  {%- case tp -%}
    {%- when 'modern' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif' -%}
      {%- assign tp_head  = '"Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.01em' -%}
    {%- when 'luxury' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:wght@500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Lato", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Playfair Display", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0.005em' -%}
    {%- when 'tech' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Inter", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Space Grotesk", "Inter", system-ui, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.015em' -%}
    {%- when 'editorial' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Source+Serif+4:wght@400;500;600&display=swap' -%}
      {%- assign tp_body  = '"Source Serif 4", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_head  = '"Playfair Display", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0' -%}
    {%- when 'minimal' -%}
      {%- assign tp_link  = '' -%}
      {%- assign tp_body  = '"Helvetica Neue", Helvetica, Arial, sans-serif' -%}
      {%- assign tp_head  = '"Helvetica Neue", Helvetica, Arial, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.02em' -%}
    {%- when 'brutalist' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&display=swap' -%}
      {%- assign tp_body  = '"Inter", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Anton", Impact, "Arial Narrow Bold", sans-serif' -%}
      {%- assign tp_trans = 'uppercase' -%}
      {%- assign tp_track = '0.04em' -%}
    {%- when 'boutique' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Karla:wght@400;500;600&display=swap' -%}
      {%- assign tp_body  = '"Karla", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Cormorant Garamond", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0.01em' -%}
    {%- when 'grotesque' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap' -%}
      {%- assign tp_body  = '"Manrope", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Manrope", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.02em' -%}
    {%- when 'classic' -%}
      {%- assign tp_link  = '' -%}
      {%- assign tp_body  = 'Georgia, "Times New Roman", Times, serif' -%}
      {%- assign tp_head  = 'Georgia, "Times New Roman", Times, serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0' -%}
    {%- when 'bold' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"DM Sans", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Archivo Black", "Arial Black", Impact, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.02em' -%}
    {%- when 'soft' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Quicksand", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Quicksand", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0' -%}
    {%- when 'mono' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap' -%}
      {%- assign tp_body  = '"IBM Plex Sans", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.01em' -%}
    {%- when 'vintage' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Lora:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Lora", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_head  = '"Abril Fatface", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0.005em' -%}
    {%- when 'magazine' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap' -%}
      {%- assign tp_body  = '"Inter", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Bodoni Moda", "Didot", Georgia, serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0' -%}
    {%- when 'wellness' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Nunito+Sans:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Nunito Sans", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"DM Serif Display", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0.01em' -%}
    {%- when 'playful' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap' -%}
      {%- assign tp_body  = '"Plus Jakarta Sans", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Fraunces", Georgia, "Times New Roman", serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.005em' -%}
    {%- when 'industrial' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Roboto:wght@400;500;700&display=swap' -%}
      {%- assign tp_body  = '"Roboto", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Bebas Neue", Impact, "Arial Narrow Bold", sans-serif' -%}
      {%- assign tp_trans = 'uppercase' -%}
      {%- assign tp_track = '0.02em' -%}
    {%- when 'refined' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600;700&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap' -%}
      {%- assign tp_body  = '"Karla", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Libre Caslon Text", "Big Caslon", Georgia, serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '0' -%}
    {%- when 'vivid' -%}
      {%- assign tp_link  = 'https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap' -%}
      {%- assign tp_body  = '"Outfit", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_head  = '"Outfit", system-ui, -apple-system, sans-serif' -%}
      {%- assign tp_trans = 'unset' -%}
      {%- assign tp_track = '-0.02em' -%}
  {%- endcase -%}

  {%- comment -%} The pairing fills the text whose font source is left on the theme font; a font picked below wins for that text. {%- endcomment -%}
  {%- liquid
    assign tp_on_body = false
    assign tp_on_head = false
    if font_type_body == 'default_font'
      assign tp_on_body = true
    endif
    if font_type_heading == 'default_font'
      assign tp_on_head = true
    endif
  -%}

  {%- comment -%}
    The pairing's Google Fonts stylesheet blocks the first paint, so it is
    requested only when the pairing fills body or heading text. display=swap
    is in every pairing link: text shows at once in the fallback font.
  {%- endcomment -%}
  {%- if tp_link != blank and tp_on_body or tp_link != blank and tp_on_head -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ tp_link }}">
  {%- endif -%}
  {% style %}
    :root {
      {%- if tp_on_body %} --body-font: {{ tp_body }} !important;{% endif %}
      {%- if tp_on_head %} --heading-font: {{ tp_head }} !important;{% endif %}
      --menu-font: {% if theme_st.menu_font == 'body_font' %}var(--body-font){% else %}var(--heading-font){% endif %} !important;
      --btn-font: {% if theme_st.button_font == 'body_font' %}var(--body-font){% else %}var(--heading-font){% endif %} !important;
    }
    body { font-family: var(--body-font); }
    h1, h2, h3, h4, h5, h6,
    .heading-font, .product-detail__title, .h1, .h2, .h3, .h4, .h5, .h6 {
      font-family: var(--heading-font);
      {%- if tp_on_head %}
      letter-spacing: var(--heading-letter-spacing, {{ tp_track }});
      text-transform: var(--heading-text-transform, {{ tp_trans }});
      {%- endif %}
    }
  {% endstyle %}
{%- endif -%}

</template>
