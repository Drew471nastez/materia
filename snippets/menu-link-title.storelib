<template compat="shopify">
{%- comment -%}
  Materia Themes. A menu link's title and its badge.
  A badge comes from a tag in the link's title in Navigation: [hot], [new],
  [sale], [popular], [custom_1] or [custom_2] (any case), for example
  "Masonry [hot]". The tag never shows; the badge's words and colours are the
  header's Menu badges block. label: a block's own badge (Badge label), which
  wins over a tag. mode: 'text' prints the clean title only.
{%- endcomment -%}
{%- liquid
  assign mlt_badges = null
  for mlt_block in section.blocks
    if mlt_block.type == 'menu_badges'
      assign mlt_badges = mlt_block.settings
    endif
  endfor
  assign mlt_key = ''
  assign mlt_clean = title | default: ''
  assign mlt_keys = 'hot,new,sale,popular,custom_1,custom_2' | split: ','
  for mlt_k in mlt_keys
    assign mlt_tok = '[' | append: mlt_k | append: ']'
    assign mlt_low = mlt_clean | downcase
    if mlt_low contains mlt_tok
      if mlt_key == ''
        assign mlt_key = mlt_k
      endif
      assign mlt_up = mlt_tok | upcase
      assign mlt_cap = mlt_k | capitalize
      assign mlt_cap = '[' | append: mlt_cap | append: ']'
      assign mlt_clean = mlt_clean | remove: mlt_tok | remove: mlt_up | remove: mlt_cap
    endif
  endfor
  assign mlt_clean = mlt_clean | remove: '[coming soon]' | strip
  if label != blank and label != 'unset'
    assign mlt_key = label
  endif
  assign mlt_text = ''
  if mlt_key != '' and mlt_badges != null
    assign mlt_text = mlt_badges[mlt_key]
  endif
-%}
{%- if mode == 'text' -%}
  {{- mlt_clean -}}
{%- else -%}
  <span{% if span_class != blank %} class="{{ span_class }}"{% endif %}>{{- mlt_clean -}}</span>
  {%- if mlt_text != blank -%}
    <span class="menu_label rounded-2 text-center heading_weight relative absolute-1025 whitespace-nowrap uppercase {{ mlt_key }}">{{ mlt_text }}</span>
  {%- endif -%}
{%- endif -%}
</template>
