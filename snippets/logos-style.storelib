<template compat="shopify">
{%- comment -%}
  Materia Themes. Shared rules of the Logos and trust sections. Every value
  is a CSS variable the section prints on its root (.lg) and live-logos.js
  updates in the builder, so the first paint and a live edit use the same
  rules. bp: the desktop breakpoint in px. margins: true when the section has
  section_margin_* settings.
  {% render 'logos-style', section: section, bp: 768, margins: true %}
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign bp = bp | default: 768
-%}
<style>
  {%- if margins %}
  #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_mobile | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_mobile | default: 0 }}px !important; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }}#shopify-section-{{ sid }} { margin-top: {{ st.section_margin_top_desktop | default: 0 }}px !important; margin-bottom: {{ st.section_margin_bottom_desktop | default: 0 }}px !important; }
  }
  {%- endif %}
  #shopify-section-{{ sid }}:has([data-lg-root][data-reset='true']) { padding-top: 0 !important; padding-bottom: 0 !important; --section-spacing: 0px; }
  #shopify-section-{{ sid }}:has([data-lg-root][data-reset='true']) + .shopify-section { margin-top: 0 !important; padding-top: 0 !important; }
  .shopify-section:has(+ #shopify-section-{{ sid }} [data-lg-root][data-reset='true']) { margin-bottom: 0 !important; padding-bottom: 0 !important; }
  #shopify-section-{{ sid }} .lg { display: block; position: relative; background: var(--lg-bg); color: var(--lg-text); font-family: var(--lg-bf); font-weight: var(--lg-bw); padding: var(--lg-pt-m) 0 var(--lg-pb-m); box-sizing: border-box; overflow: hidden; }
  #shopify-section-{{ sid }} .lg *, #shopify-section-{{ sid }} .lg *::before, #shopify-section-{{ sid }} .lg *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .lg [hidden] { display: none !important; }
  #shopify-section-{{ sid }} .lg :is(h1, h2, h3, h4, h5, h6) { font-family: var(--lg-hf); font-weight: var(--lg-hw); }
  #shopify-section-{{ sid }} .lg__inner { width: 100%; margin-inline: auto; padding-inline: var(--lg-px-m); }
  #shopify-section-{{ sid }} .lg:is([data-width='container'], [data-width='wide']) .lg__inner { max-width: calc(var(--page-width, 1300px) + 3rem); }
  #shopify-section-{{ sid }} .lg:is([data-width='fluid_container'], [data-width='fluid']) .lg__inner { max-width: calc(var(--fluid-container-width, 1500px) + 3rem); }
  #shopify-section-{{ sid }} .lg[data-width='narrow'] .lg__inner { max-width: 720px; }
  #shopify-section-{{ sid }} .lg[data-width='medium'] .lg__inner { max-width: 960px; }

  #shopify-section-{{ sid }} .lg-head { display: flex; flex-direction: column; gap: var(--lg-hgap, 12px); align-items: center; text-align: center; max-width: var(--lg-hmax, none); margin: 0 auto var(--lg-hmb-m, 24px); }
  #shopify-section-{{ sid }} .lg[data-head-align='left'] .lg-head { align-items: flex-start; text-align: left; margin-left: 0; }
  #shopify-section-{{ sid }} .lg[data-head-align='right'] .lg-head { align-items: flex-end; text-align: right; margin-right: 0; }
  #shopify-section-{{ sid }} .lg-head:not(:has(> :not([hidden]))) { display: none; }
  #shopify-section-{{ sid }} .lg-head > * { margin: 0; max-width: 100%; }
  #shopify-section-{{ sid }} .lg__eyebrow { color: var(--b-c); font-size: var(--b-fs); font-weight: var(--subheading-weight, 600); letter-spacing: .12em; text-transform: var(--b-tt, uppercase); line-height: 1.3; }
  #shopify-section-{{ sid }} .lg__heading { color: var(--b-c); font-size: var(--b-fs-m); overflow-wrap: break-word; }
  #shopify-section-{{ sid }} .lg__sub { color: var(--b-c); font-size: var(--b-fs-m); line-height: var(--body-line-height, 1.6); max-width: 640px; }
  #shopify-section-{{ sid }} .lg__sub p { margin: 0 0 .5em; }
  #shopify-section-{{ sid }} .lg__sub p:last-child { margin: 0; }
  #shopify-section-{{ sid }} .lg__btn[data-full='true'] { width: 100%; }
  #shopify-section-{{ sid }} .lg__btn:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  #shopify-section-{{ sid }} .lg :is(a, button):focus-visible { outline: 2px solid var(--color-heading); outline-offset: 3px; }
  @media (min-width: {{ bp }}px) {
    #shopify-section-{{ sid }} .lg { padding: var(--lg-pt-d) 0 var(--lg-pb-d); }
    #shopify-section-{{ sid }} .lg__inner { padding-inline: var(--lg-px-d); }
    #shopify-section-{{ sid }} .lg-head { margin-bottom: var(--lg-hmb-d, 32px); }
    #shopify-section-{{ sid }} .lg__heading, #shopify-section-{{ sid }} .lg__sub { font-size: var(--b-fs-d); }
  }
  {%- comment -%} Reveal on scroll: hidden only once the controller says the section is below the fold, never in the editor or under reduced motion. {%- endcomment %}
  #shopify-section-{{ sid }} .lg[data-reveal='true'][data-lg-reveal='wait'] [data-lg-reveal-item] { opacity: 0; transform: translateY(16px); }
  #shopify-section-{{ sid }} .lg[data-reveal='true'] [data-lg-reveal-item] { transition: opacity .6s ease, transform .6s ease; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .lg [data-lg-reveal-item] { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>
</template>
