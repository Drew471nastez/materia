<template compat="shopify">
{%- assign b = block.settings -%}
<div class="hps-pane" data-hps-image="{{ block.id }}" data-hps-image-settings="{{ b | json | escape }}" {{ block.shopify_attributes }}>
 <picture>{% if b.image_mobile != blank %}<source media="(max-width:767px)" srcset="{% render 'offer-image-url', image: b.image_mobile, escaped: true %}">{% endif %}<img src="{% if b.image != blank %}{% render 'offer-image-url', image: b.image, escaped: true %}{% elsif b.image_mobile != blank %}{% render 'offer-image-url', image: b.image_mobile, escaped: true %}{% else %}{{ placeholder | escape }}{% endif %}" data-hps-placeholder="{{ placeholder | escape }}" alt="{{ b.image_alt | default: b.image.alt | escape }}" width="1600" height="1200" loading="{% if first %}eager{% else %}lazy{% endif %}"{% if first %} fetchpriority="high"{% endif %} decoding="async"></picture>
</div>
</template>
