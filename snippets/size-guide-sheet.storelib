<template compat="shopify">
{%- comment -%}
  Materia Themes. Size guide link and its sheet for the variant picker.
  The guide is the block's "Size guide content"; a page or a product
  size_chart metafield is used when the content is empty. Opens in a
  <dialog>: a bottom sheet on phones, a centred panel on larger screens.
  Inputs: block, product, section
{%- endcomment -%}
{%- liquid
  assign sg_content = block.settings.size_guide_content
  assign sg_plain = sg_content | strip_html | strip
  if sg_plain == blank and sg_content contains '<img'
    assign sg_plain = 'image'
  endif
  if sg_plain == blank and sg_content contains '<table'
    assign sg_plain = 'table'
  endif
  if sg_plain == blank
    assign sg_meta = product.metafields.custom.size_chart
    if sg_meta != blank
      assign sg_page = pages[sg_meta]
      if sg_page.content != blank
        assign sg_content = sg_page.content
      elsif sg_meta contains '<'
        assign sg_content = sg_meta
      endif
    endif
  endif
  assign sg_plain = sg_content | strip_html | strip
  if sg_plain == blank and block.settings.size_guide_page != blank
    assign sg_page = block.settings.size_guide_page
    if sg_page.content != blank
      assign sg_content = sg_page.content
    else
      assign sg_content = pages[sg_page].content
    endif
  endif
  assign sg_check = sg_content | strip_html | strip
  if sg_check == blank and sg_content contains '<img'
    assign sg_check = 'image'
  endif
  assign sg_label = block.settings.size_guide_label | default: 'Size guide'
  assign sg_id = 'SizeGuide-' | append: section.id | append: '-' | append: block.id
-%}
{%- if sg_check != blank -%}
  <button
    type="button"
    class="mt-size-guide"
    data-mt-sheet-open
    aria-controls="{{ sg_id }}"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 8.5 3l12.5 12.5-5.5 5.5z"/><path d="m7 7 1.5 1.5M10 5.5 11.5 7M13 8.5 14.5 10M11 11l1.5 1.5M16 11.5l1.5 1.5"/></svg>
    <span>{{ sg_label | escape }}</span>
  </button>
  <dialog id="{{ sg_id }}" class="mt-sheet" aria-labelledby="{{ sg_id }}-title">
    <div class="mt-sheet__panel">
      <div class="mt-sheet__head">
        <h2 id="{{ sg_id }}-title" class="mt-sheet__title">{{ sg_label | escape }}</h2>
        <button type="button" class="mt-sheet__close" data-mt-sheet-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="mt-sheet__body rte">
        <div class="mt-sheet__table-wrap">{{ sg_content }}</div>
      </div>
    </div>
  </dialog>
{%- endif -%}
</template>
