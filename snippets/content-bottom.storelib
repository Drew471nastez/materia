<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign theme_st = settings
  assign money_format = shop.money_format
  if theme_st.currency_code_enabled
    assign money_format = shop.money_with_currency_format | strip_html
  endif
-%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if lis_language_rtl contains iso_code
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<link rel="stylesheet" href="{{ 'tingle.min.css' | asset_url }}" media="print" onload="this.media='all'">
<a class="skip-to-content-link no-underline visually-hidden" href="#MainContent">
  {{ 'accessibility.skip_to_text' | t }}
</a>
<ul hidden>
  <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
</ul>
{%- if theme_st.enable_cookies != blank -%}
  {%- capture cookie_vars -%}{%- if theme_st.cookie_custom_styling -%}--cookie-bg:{{ theme_st.cookie_bg_color }};--cookie-text:{{ theme_st.cookie_text_color }};--cookie-heading:{{ theme_st.cookie_heading_color }};--cookie-btn-bg:{{ theme_st.cookie_btn_bg }};--cookie-btn-text:{{ theme_st.cookie_btn_text }};--cookie-btn2-text:{{ theme_st.cookie_btn2_text }};--cookie-btn-radius:{{ theme_st.cookie_btn_radius | default: 12 }}px;{%- endif -%}{%- endcapture -%}
  <cookie-bar id="cookie" class="cookie-bar hidden" data-cookie-style="{{ theme_st.cookie_style | default: 'bar-center' }}" style="{{ cookie_vars }}">
    <div class="cookie-bar__inner">
      <div class="cookie-bar__copy">
        {% if theme_st.heading_cookies != blank %}
          <span class="cookie-bar__heading">{{ theme_st.heading_cookies }}</span>
        {% endif %}
        {% if theme_st.content_cookies != blank %}
          <span class="cookie-bar__message">{{ theme_st.content_cookies }}</span>
        {% endif %}
      </div>
      <div class="cookie-bar__actions">
        {% if theme_st.label_refuse != blank %}
          <button type="button" class="cookie-bar__btn cookie-bar__btn--ghost cookie-dismiss" id="cookie-refuse">
            {{ theme_st.label_refuse }}
          </button>
        {% endif %}
        {%- if theme_st.label_allow != blank -%}
          <button type="button" class="cookie-bar__btn cookie-bar__btn--solid cookie-dismiss" id="cookie-dismiss">
            {{ theme_st.label_allow }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </cookie-bar>
{%- endif -%}
<script>
  
  
  window.shopUrl = '{{ request.origin }}';
  window.routes = {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_change_url: '{{ routes.cart_change_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}',
    search_url: '{{ routes.search_url }}',
    predictive_search_url: '{{ routes.predictive_search_url }}',
  };
  window.cartStrings = {
    error: `{{ 'sections.cart.cart_error' | t }}`,
    no_shipping: `{{ 'sections.cart.no_shipping' | t }}`,
    shipping_rate: `{{ 'sections.cart.shipping_rate' | t }}`,
    quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
    money_format: {{ money_format | json }},
    quick_edit: `{{ 'sections.cart.quick_edit' | t }}`,
    cart_symbol: '{{ cart.currency.symbol }}',
    discount_removed: `{{ 'general.content.discount_code_remove' | t }}`,
    discount_applied: `{{ 'general.content.discount_code_applied' | t }}`,
    discount_already: `{{ 'general.content.discount_code_already' | t }}`,
    discount_error: `{{ 'general.content.discount_code_error' | t }}`
  }
      
  window.themeGlobalVariables = {
    settings: {
      money_format: {{ shop.money_format | json }},
    }
  }
  window.variantStrings = {
    incoming_with_date: `{{ 'products.product.inventory_status.incoming_with_date' | t }}`,
    incoming: `{{ 'products.product.inventory_status.incoming' | t }}`,
    addToCart: `{{ 'products.product.add_to_cart' | t }}`,
    addToCartBundle: `{{ 'products.product.actions.add_to_bundle.label_bundle' | t }}`,
    addedToCartBundle: `{{ 'products.product.actions.add_to_bundle.label_bundle_added' | t }}`,
    soldOut: `{{ 'products.product.sold_out' | t }}`,
    unavailable: `{{ 'products.product.unavailable' | t }}`,
    outStock: `{{ 'products.product.outstock' | t }}`,
    preOrder: `{{ 'products.product.pre_order' | t }}`,
    save: `{{ 'products.product.save' | t }}`,
    inStock: `{{ 'products.product.instock' | t }}`,
    addSuccess: `{{ 'products.product.addSuccess' | t }}`,
    addGiftCard: `{{ 'products.product.addGiftCard' | t  }}`,
    removeCartItem: `{{ 'products.product.removeCartItem' | t }}`,
    unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
    sale: `{{ 'products.product.label.sale_label' | t }}`
  };

  {%- liquid
    assign tab_interval = theme_st.tab_notification_interval | default: 2
    assign cart_tab_tpl = theme_st.cart_tab_message_template
    if cart_tab_tpl == blank
      assign cart_tab_tpl = '({count}) items in your cart'
    endif
    assign idle_msg = theme_st.idle_message
    if idle_msg == blank
      assign idle_msg = 'Still there?'
    endif
    assign idle_thr = theme_st.idle_threshold | default: 120
    assign away_fav_url = ''
    if theme_st.away_favicon
      assign away_fav_url = theme_st.away_favicon | image_url: width: 64
    endif
  -%}
  window.flashingBrowseTab = {
    enable: {{ theme_st.enable_browser_tab_notifications | default: false }},
    firstNotification: {{ theme_st.first_notification | json }},
    secondaryNotification: {{ theme_st.secondary_notification | json }},
    interval: {{ tab_interval }},
    enableAwayFavicon: {{ theme_st.enable_away_favicon | default: false }},
    awayFavicon: {{ away_fav_url | json }},
    enableCartTabMessage: {{ theme_st.enable_cart_tab_message | default: false }},
    cartTabTemplate: {{ cart_tab_tpl | json }},
    cartCount: {{ cart.item_count | default: 0 }},
    enableIdle: {{ theme_st.enable_idle_message | default: false }},
    idleThreshold: {{ idle_thr }},
    idleMessage: {{ idle_msg | json }}
  };
{% comment %}{% endcomment %}</script>
{%- if theme_st.enable_browser_tab_notifications or theme_st.enable_away_favicon or theme_st.enable_cart_tab_message or theme_st.enable_idle_message -%}
<script>
  (function(){
    var cfg = window.flashingBrowseTab || {};
    var origTitle = document.title;
    var origFavicon = (document.querySelector("link[rel*='icon']") || {}).href || '';
    var faviconEl = document.querySelector("link[rel*='icon']");
    var rotateTimer = null;
    var idleTimer = null;
    var lastIdleAt = Date.now();
    var msgs = [];
    if (cfg.firstNotification) msgs.push(cfg.firstNotification);
    if (cfg.secondaryNotification) msgs.push(cfg.secondaryNotification);

    // Cart-aware initial title
    if (cfg.enableCartTabMessage && cfg.cartCount > 0) {
      document.title = cfg.cartTabTemplate
        .replace('{count}', cfg.cartCount)
        .replace('{title}', origTitle);
      origTitle = document.title;
    }

    function startRotation(){
      if (!cfg.enable || msgs.length === 0) return;
      var i = 0;
      var intervalSec = Math.max(1, parseInt(cfg.interval || 2, 10));
      rotateTimer = setInterval(function(){
        document.title = msgs[i % msgs.length];
        i++;
      }, intervalSec * 1000);
    }
    function stopRotation(){
      if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = null; }
      document.title = origTitle;
    }
    function swapFavicon(toAway){
      if (!cfg.enableAwayFavicon || !cfg.awayFavicon || !faviconEl) return;
      faviconEl.href = toAway ? cfg.awayFavicon : origFavicon;
    }
    function startIdleWatch(){
      if (!cfg.enableIdle) return;
      var threshold = Math.max(15, parseInt(cfg.idleThreshold || 120, 10)) * 1000;
      var resetIdle = function(){
        lastIdleAt = Date.now();
        if (idleTimer) { clearTimeout(idleTimer); }
        idleTimer = setTimeout(function(){
          if (cfg.enable) msgs.push(cfg.idleMessage);
          else document.title = cfg.idleMessage;
        }, threshold);
      };
      ['mousemove','keydown','scroll','touchstart','click'].forEach(function(ev){
        window.addEventListener(ev, resetIdle, { passive: true });
      });
      resetIdle();
    }

    document.addEventListener('visibilitychange', function(){
      if (document.hidden) {
        startRotation();
        swapFavicon(true);
      } else {
        stopRotation();
        swapFavicon(false);
      }
    });

    startIdleWatch();

    // Live cart count update — watch for cart drawer DOM changes
    document.addEventListener('cart:refresh', function(e){
      if (!cfg.enableCartTabMessage) return;
      var newCount = (e && e.detail && e.detail.data && e.detail.data.item_count) || cfg.cartCount;
      cfg.cartCount = newCount;
      if (newCount > 0) {
        origTitle = cfg.cartTabTemplate
          .replace('{count}', newCount)
          .replace('{title}', document.title);
      }
    });
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

</template>