<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign theme_st = settings
  assign money_format = shop.money_format
  if theme_st.currency_code_enabled
    assign money_format = shop.money_with_currency_format | strip_html
  endif
-%}
{% liquid
  assign enable_rtl = settings.rtl
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank
    if lis_language_rtl contains iso_code
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<link rel="stylesheet" href="{{ 'tingle.min.css' | asset_url }}" media="print" onload="this.media='all'">
<a class="skip-to-content-link no-underline visually-hidden" href="#MainContent">
  {{ 'accessibility.skip_to_text' | t }}
</a>
<ul hidden>
  <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
</ul>
{%- comment -%}
  Cookies and consent (Theme settings > Cookies & consent). Markup here, the
  look in cookie-consent.css, the behaviour in cookie-consent.js. Buttons are
  theme buttons (data-theme-button), so Theme settings > Buttons applies; the
  custom colours only override them when "Use custom colours" is on. In the
  builder it is drawn only for "Show in the builder", and follows changes live.
{%- endcomment -%}
{%- liquid
  assign ck_design = false
  if request.design_mode
    assign ck_design = true
  endif
  assign ck_page = template | split: '.' | first
  assign ck_page_ok = true
  case theme_st.cookie_pages
    when 'home'
      if ck_page != 'index'
        assign ck_page_ok = false
      endif
    when 'not_cart'
      if ck_page == 'cart' or request.path contains '/checkout' or request.path contains '/cart'
        assign ck_page_ok = false
      endif
  endcase
  assign ck_render = false
  if ck_design
    assign ck_render = true
  elsif theme_st.enable_cookies != blank and ck_page_ok
    assign ck_render = true
  endif
-%}
{%- if ck_render -%}
  {%- liquid
    assign ck_position = theme_st.cookie_position | default: 'bottom_center'
    assign ck_look = theme_st.cookie_style | default: 'bar-center'
    comment
      Earlier looks also set a position; read them as Standard at that position.
    endcomment
    case ck_look
      when 'full'
        if ck_position == 'bottom_center'
          assign ck_position = 'bottom_bar'
        endif
        assign ck_look = 'bar-center'
      when 'card-left'
        if ck_position == 'bottom_center'
          assign ck_position = 'bottom_left'
        endif
        assign ck_look = 'bar-center'
      when 'card-right'
        if ck_position == 'bottom_center'
          assign ck_position = 'bottom_right'
        endif
        assign ck_look = 'bar-center'
      when 'top'
        if ck_position == 'bottom_center'
          assign ck_position = 'top_bar'
        endif
        assign ck_look = 'bar-center'
    endcase
    assign ck_scheme = theme_st.cookie_color_scheme
    assign ck_scheme_id = ck_scheme.id | default: ck_scheme
    assign ck_modal = false
    if ck_position == 'modal'
      assign ck_modal = true
    endif
    assign ck_allow = theme_st.label_allow | default: 'Accept'
    assign ck_refuse = theme_st.label_refuse | default: 'Decline'
    assign ck_custom = false
    if theme_st.cookie_custom_styling
      assign ck_custom = true
    endif
  -%}
  {%- capture cookie_vars -%}
    {%- if ck_custom -%}
      {%- if theme_st.cookie_bg_color != blank and theme_st.cookie_bg_color.alpha != 0 -%}--cookie-bg:{{ theme_st.cookie_bg_color }};{%- endif -%}
      {%- if theme_st.cookie_text_color != blank and theme_st.cookie_text_color.alpha != 0 -%}--cookie-text:{{ theme_st.cookie_text_color }};{%- endif -%}
      {%- if theme_st.cookie_heading_color != blank and theme_st.cookie_heading_color.alpha != 0 -%}--cookie-heading:{{ theme_st.cookie_heading_color }};{%- endif -%}
    {%- endif -%}
    {%- comment -%} Custom text sizes: only with the toggle on; otherwise the theme's typography and button size. {%- endcomment -%}
    {%- if theme_st.cookie_custom_text_sizes -%}
      --cookie-heading-size:{{ theme_st.cookie_heading_size | default: 16 }}px;--cookie-text-size:{{ theme_st.cookie_text_size | default: 14 }}px;--cookie-btn-size:{{ theme_st.cookie_button_text_size | default: 14 }}px;
    {%- endif -%}
  {%- endcapture -%}
  {{ 'cookie-consent.css' | asset_url | stylesheet_tag }}
  <cookie-consent
    class="cookie-consent{% if ck_scheme_id != blank %} color-{{ ck_scheme_id }}{% endif %}"
    hidden
    data-enabled="{% if theme_st.enable_cookies != blank %}true{% else %}false{% endif %}"
    data-page-ok="{{ ck_page_ok }}"
    data-page="{% if ck_page == 'cart' or request.path contains '/cart' or request.path contains '/checkout' %}cart{% elsif ck_page == 'index' %}home{% else %}other{% endif %}"
    data-design="{{ ck_design }}"
    data-text-sizes="{% if theme_st.cookie_custom_text_sizes %}custom{% else %}theme{% endif %}"
    data-preview="{% if ck_design and theme_st.cookie_show_in_builder %}true{% else %}false{% endif %}"
    data-position="{{ ck_position }}"
    data-look="{{ ck_look }}"
    data-animation="{{ theme_st.cookie_animation | default: 'slide' }}"
    data-mobile="{{ theme_st.cookie_mobile_layout | default: 'sheet' }}"
    data-backdrop="{% if theme_st.cookie_modal_backdrop == false %}false{% else %}true{% endif %}"
    data-require="{% if theme_st.cookie_require_choice %}true{% else %}false{% endif %}"
    data-above-nav="{% if theme_st.cookie_above_mobile_nav == false %}false{% else %}true{% endif %}"
    data-delay="{{ theme_st.cookie_delay | default: 0 }}"
    data-expiry="{{ theme_st.cookie_expiry_days | default: 180 }}"
    data-frequency="{{ theme_st.cookie_frequency | default: 'every_page' }}"
    style="{{ cookie_vars }}"
  >
    <div class="cookie-consent__backdrop" data-consent-backdrop></div>
    <div
      class="cookie-consent__panel"
      {% if ck_modal %}role="dialog" aria-modal="true"{% else %}role="region"{% endif %}
      aria-labelledby="CookieConsentHeading"
      aria-describedby="CookieConsentMessage"
      tabindex="-1"
      data-consent-panel
    >
      <div class="cookie-consent__copy">
        <h2 class="cookie-consent__heading" id="CookieConsentHeading" data-consent-heading{% if theme_st.heading_cookies == blank %} hidden{% endif %}>{{ theme_st.heading_cookies | default: 'Cookies' }}</h2>
        <div class="cookie-consent__message rte" id="CookieConsentMessage">
          <div data-consent-message>{{ theme_st.content_cookies }}</div>
          <a
            class="cookie-consent__link"
            data-consent-link
            href="{{ theme_st.cookie_link_url | default: '#' }}"
            {% if theme_st.cookie_link_url == blank or theme_st.cookie_link_label == blank %}hidden{% endif %}
          >{{ theme_st.cookie_link_label }}</a>
        </div>
      </div>
      <div class="cookie-consent__actions">
        <button
          type="button"
          class="cookie-consent__btn btn-outline"
          data-theme-button="secondary"
          data-sl-button
          data-consent="decline"
          {% if theme_st.cookie_show_decline == false %}hidden{% endif %}
          {% if ck_custom %}style="{%- render 'button-overrides', text: theme_st.cookie_btn2_text, custom: true, radius: theme_st.cookie_btn_radius -%}"{% endif %}
        >{{ ck_refuse }}</button>
        <button
          type="button"
          class="cookie-consent__btn btn-primary"
          data-theme-button="primary"
          data-sl-button
          data-consent="accept"
          {% if ck_custom %}style="{%- render 'button-overrides', bg: theme_st.cookie_btn_bg, text: theme_st.cookie_btn_text, custom: true, radius: theme_st.cookie_btn_radius -%}"{% endif %}
        >{{ ck_allow }}</button>
      </div>
      <button
        type="button"
        class="cookie-consent__close"
        data-consent="close"
        aria-label="{{ 'accessibility.close' | t }}"
        {% if theme_st.cookie_show_close != true or ck_modal and theme_st.cookie_require_choice %}hidden{% endif %}
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </cookie-consent>
  {%- if ck_design -%}
    {%- comment -%} Builder only: the values the live preview starts from. {%- endcomment -%}
    <script type="application/json" data-consent-settings>{
      "enable_cookies": {{ theme_st.enable_cookies | json }},
      "cookie_show_in_builder": {{ theme_st.cookie_show_in_builder | json }},
      "cookie_style": {{ theme_st.cookie_style | default: 'bar-center' | json }},
      "cookie_position": {{ theme_st.cookie_position | default: 'bottom_center' | json }},
      "cookie_show_close": {{ theme_st.cookie_show_close | json }},
      "cookie_custom_styling": {{ ck_custom | json }},
      "cookie_bg_color": {{ theme_st.cookie_bg_color | json }},
      "cookie_text_color": {{ theme_st.cookie_text_color | json }},
      "cookie_heading_color": {{ theme_st.cookie_heading_color | json }},
      "cookie_btn_bg": {{ theme_st.cookie_btn_bg | json }},
      "cookie_btn_text": {{ theme_st.cookie_btn_text | json }},
      "cookie_btn2_text": {{ theme_st.cookie_btn2_text | json }},
      "cookie_btn_radius": {{ theme_st.cookie_btn_radius | default: 12 | json }},
      "cookie_pages": {{ theme_st.cookie_pages | default: 'all' | json }},
      "cookie_custom_text_sizes": {{ theme_st.cookie_custom_text_sizes | json }},
      "cookie_heading_size": {{ theme_st.cookie_heading_size | default: 16 | json }},
      "cookie_text_size": {{ theme_st.cookie_text_size | default: 14 | json }},
      "cookie_button_text_size": {{ theme_st.cookie_button_text_size | default: 14 | json }}
    }</script>
  {%- endif -%}
  <script src="{{ 'cookie-consent.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- comment -%}
  Sign-up and contact forms everywhere: a pending button, one submit at a
  time, a hidden trap field and a minimum time before sending, a small toast
  on success and errors inline. Storelib still sends every form. In the
  builder it only redraws field colours live (Theme settings > Forms and fields).
{%- endcomment -%}
{%- if request.design_mode -%}
  <script type="application/json" data-field-settings>{
    "field_style": {{ theme_st.field_style | default: 'outline' | json }},
    "field_text": {{ theme_st.field_text | json }},
    "field_background": {{ theme_st.field_background | json }},
    "storelib_input_border": {{ theme_st.storelib_input_border | json }},
    "storelib_input_radius": {{ theme_st.storelib_input_radius | default: -1 | json }}
  }</script>
{%- endif -%}
{{ 'materia-forms.css' | asset_url | stylesheet_tag }}
<script src="{{ 'materia-forms.js' | asset_url }}" defer="defer"></script>
<script>
  
  
  window.shopUrl = '{{ request.origin }}';
  window.routes = {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_change_url: '{{ routes.cart_change_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}',
    search_url: '{{ routes.search_url }}',
    predictive_search_url: '{{ routes.predictive_search_url }}',
  };
  window.cartStrings = {
    error: `{{ 'sections.cart.cart_error' | t }}`,
    no_shipping: `{{ 'sections.cart.no_shipping' | t }}`,
    shipping_rate: `{{ 'sections.cart.shipping_rate' | t }}`,
    quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
    money_format: {{ money_format | json }},
    quick_edit: `{{ 'sections.cart.quick_edit' | t }}`,
    cart_symbol: '{{ cart.currency.symbol }}',
    discount_removed: `{{ 'general.content.discount_code_remove' | t }}`,
    discount_applied: `{{ 'general.content.discount_code_applied' | t }}`,
    discount_already: `{{ 'general.content.discount_code_already' | t }}`,
    discount_error: `{{ 'general.content.discount_code_error' | t }}`
  }
      
  window.themeGlobalVariables = {
    settings: {
      money_format: {{ shop.money_format | json }},
    }
  }
  window.variantStrings = {
    incoming_with_date: `{{ 'products.product.inventory_status.incoming_with_date' | t }}`,
    incoming: `{{ 'products.product.inventory_status.incoming' | t }}`,
    addToCart: `{{ 'products.product.add_to_cart' | t }}`,
    addToCartBundle: `{{ 'products.product.actions.add_to_bundle.label_bundle' | t }}`,
    addedToCartBundle: `{{ 'products.product.actions.add_to_bundle.label_bundle_added' | t }}`,
    soldOut: `{{ 'products.product.sold_out' | t }}`,
    unavailable: `{{ 'products.product.unavailable' | t }}`,
    outStock: `{{ 'products.product.outstock' | t }}`,
    preOrder: `{{ 'products.product.pre_order' | t }}`,
    save: `{{ 'products.product.save' | t }}`,
    inStock: `{{ 'products.product.instock' | t }}`,
    addSuccess: `{{ 'products.product.addSuccess' | t }}`,
    addGiftCard: `{{ 'products.product.addGiftCard' | t  }}`,
    removeCartItem: `{{ 'products.product.removeCartItem' | t }}`,
    unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
    sale: `{{ 'products.product.label.sale_label' | t }}`
  };

  {%- liquid
    assign tab_interval = theme_st.tab_notification_interval | default: 2
    assign cart_tab_tpl = theme_st.cart_tab_message_template
    if cart_tab_tpl == blank
      assign cart_tab_tpl = '({count}) items in your cart'
    endif
    assign idle_msg = theme_st.idle_message
    if idle_msg == blank
      assign idle_msg = 'Still there?'
    endif
    assign idle_thr = theme_st.idle_threshold | default: 120
    assign away_fav_url = ''
    if theme_st.away_favicon
      assign away_fav_url = theme_st.away_favicon | image_url: width: 64
    endif
  -%}
  window.flashingBrowseTab = {
    enable: {{ theme_st.enable_browser_tab_notifications | default: false }},
    firstNotification: {{ theme_st.first_notification | json }},
    secondaryNotification: {{ theme_st.secondary_notification | json }},
    interval: {{ tab_interval }},
    enableAwayFavicon: {{ theme_st.enable_away_favicon | default: false }},
    awayFavicon: {{ away_fav_url | json }},
    enableCartTabMessage: {{ theme_st.enable_cart_tab_message | default: false }},
    cartTabTemplate: {{ cart_tab_tpl | json }},
    cartCount: {{ cart.item_count | default: 0 }},
    enableIdle: {{ theme_st.enable_idle_message | default: false }},
    idleThreshold: {{ idle_thr }},
    idleMessage: {{ idle_msg | json }}
  };
{% comment %}{% endcomment %}</script>
{%- if theme_st.enable_browser_tab_notifications or theme_st.enable_away_favicon or theme_st.enable_cart_tab_message or theme_st.enable_idle_message -%}
<script>
  (function(){
    var cfg = window.flashingBrowseTab || {};
    var origTitle = document.title;
    var origFavicon = (document.querySelector("link[rel*='icon']") || {}).href || '';
    var faviconEl = document.querySelector("link[rel*='icon']");
    var rotateTimer = null;
    var idleTimer = null;
    var lastIdleAt = Date.now();
    var msgs = [];
    if (cfg.firstNotification) msgs.push(cfg.firstNotification);
    if (cfg.secondaryNotification) msgs.push(cfg.secondaryNotification);

    // Cart-aware initial title
    if (cfg.enableCartTabMessage && cfg.cartCount > 0) {
      document.title = cfg.cartTabTemplate
        .replace('{count}', cfg.cartCount)
        .replace('{title}', origTitle);
      origTitle = document.title;
    }

    function startRotation(){
      if (!cfg.enable || msgs.length === 0) return;
      var i = 0;
      var intervalSec = Math.max(1, parseInt(cfg.interval || 2, 10));
      rotateTimer = setInterval(function(){
        document.title = msgs[i % msgs.length];
        i++;
      }, intervalSec * 1000);
    }
    function stopRotation(){
      if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = null; }
      document.title = origTitle;
    }
    function swapFavicon(toAway){
      if (!cfg.enableAwayFavicon || !cfg.awayFavicon || !faviconEl) return;
      faviconEl.href = toAway ? cfg.awayFavicon : origFavicon;
    }
    function startIdleWatch(){
      if (!cfg.enableIdle) return;
      var threshold = Math.max(15, parseInt(cfg.idleThreshold || 120, 10)) * 1000;
      var resetIdle = function(){
        lastIdleAt = Date.now();
        if (idleTimer) { clearTimeout(idleTimer); }
        idleTimer = setTimeout(function(){
          if (cfg.enable) msgs.push(cfg.idleMessage);
          else document.title = cfg.idleMessage;
        }, threshold);
      };
      ['mousemove','keydown','scroll','touchstart','click'].forEach(function(ev){
        window.addEventListener(ev, resetIdle, { passive: true });
      });
      resetIdle();
    }

    document.addEventListener('visibilitychange', function(){
      if (document.hidden) {
        startRotation();
        swapFavicon(true);
      } else {
        stopRotation();
        swapFavicon(false);
      }
    });

    startIdleWatch();

    // Live cart count update — watch for cart drawer DOM changes
    document.addEventListener('cart:refresh', function(e){
      if (!cfg.enableCartTabMessage) return;
      var newCount = (e && e.detail && e.detail.data && e.detail.data.item_count) || cfg.cartCount;
      cfg.cartCount = newCount;
      if (newCount > 0) {
        origTitle = cfg.cartTabTemplate
          .replace('{count}', newCount)
          .replace('{title}', document.title);
      }
    });
  })();
{% comment %}{% endcomment %}</script>
{%- endif -%}

</template>