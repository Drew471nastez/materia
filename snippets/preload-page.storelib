<template compat="shopify">
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% liquid
  assign enable_preload = settings.enable_preload
  assign preload_page = settings.preload_page
  assign preload_custom_image = settings.preload_custom_image
  assign preloader_size = settings.preloader_size
  assign preloader_duration = settings.preloader_duration
%}

{% if enable_preload and request.design_mode != true %}
  <preload-page
    class="preload-page"
    style="
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fafafa;
      opacity: 1;
      transition: opacity 0.5s ease;
    "
  >
    {% case preload_page %}
      {% when 'dot' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; display: flex; gap: 10px; align-items: center; justify-content: center;">
          <div class="modern-dot" style="animation-delay: 0s;"></div>
          <div class="modern-dot" style="animation-delay: 0.12s;"></div>
          <div class="modern-dot" style="animation-delay: 0.24s;"></div>
        </div>

      {% when 'spin' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <svg viewBox="0 0 50 50" style="width: 100%; height: 100%;">
            <defs>
              <linearGradient id="spinGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
                <stop offset="50%" style="stop-color:#666;stop-opacity:0.7" />
                <stop offset="100%" style="stop-color:#d0d0d0;stop-opacity:0.4" />
              </linearGradient>
            </defs>
            <circle class="modern-spinner" cx="25" cy="25" r="20" fill="none" stroke="url(#spinGradient)" stroke-width="3" stroke-linecap="round"></circle>
          </svg>
        </div>

      {% when 'ripple' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <div class="modern-ripple" style="animation-delay: 0s;"></div>
          <div class="modern-ripple" style="animation-delay: 0.6s;"></div>
          <div class="modern-ripple" style="animation-delay: 1.2s;"></div>
        </div>

      {% when 'custom' %}
        {% if preload_custom_image != blank %}
          <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px;">
            <img
              src="{{ preload_custom_image | img_url: '200x' }}"
              alt="{{ 'accessibility.preloader' | t }}"
              style="
                width: 100%;
                height: 100%;
                object-fit: contain;
                animation: modern-pulse 1.8s infinite ease-in-out;
              "
            >
          </div>
        {% else %}
          <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
            <svg viewBox="0 0 50 50" style="width: 100%; height: 100%;">
              <defs>
                <linearGradient id="spinGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
                  <stop offset="50%" style="stop-color:#666;stop-opacity:0.7" />
                  <stop offset="100%" style="stop-color:#d0d0d0;stop-opacity:0.4" />
                </linearGradient>
              </defs>
              <circle class="modern-spinner" cx="25" cy="25" r="20" fill="none" stroke="url(#spinGradient)" stroke-width="3" stroke-linecap="round"></circle>
            </svg>
          </div>
        {% endif %}

      {% when 'rect_flicker' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; display: flex; gap: 8px; align-items: flex-end; justify-content: center;">
          <div class="modern-bar" style="animation-delay: 0s; height: 50%;"></div>
          <div class="modern-bar" style="animation-delay: 0.12s; height: 70%;"></div>
          <div class="modern-bar" style="animation-delay: 0.24s; height: 40%;"></div>
          <div class="modern-bar" style="animation-delay: 0.36s; height: 60%;"></div>
          <div class="modern-bar" style="animation-delay: 0.48s; height: 45%;"></div>
        </div>

      {% when 'circles_slide' %}
        <div style="width: {{ preloader_size }}px; height: 20px; position: relative; overflow: hidden;">
          <div class="slide-modern" style="animation-delay: 0s;"></div>
          <div class="slide-modern" style="animation-delay: 0.2s;"></div>
          <div class="slide-modern" style="animation-delay: 0.4s;"></div>
        </div>

      {% when 'wave_path' %}
        <div style="width: {{ preloader_size }}px; height: 60px; display: flex; align-items: center; justify-content: center; gap: 6px;">
          <div class="wave-modern" style="animation-delay: 0s;"></div>
          <div class="wave-modern" style="animation-delay: 0.1s;"></div>
          <div class="wave-modern" style="animation-delay: 0.2s;"></div>
          <div class="wave-modern" style="animation-delay: 0.3s;"></div>
          <div class="wave-modern" style="animation-delay: 0.4s;"></div>
        </div>

      {% when 'double_line_spin' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <div class="orbit-ring"></div>
          <div class="orbit-ring" style="animation-delay: 0.6s; animation-direction: reverse;"></div>
          <div class="orbit-dot"></div>
        </div>

      {% when 'square_fold' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <div class="morph-square"></div>
        </div>

      {% when 'progress_text' %}
        <div style="width: {{ preloader_size }}px; height: auto; display: flex; flex-direction: column; align-items: center; gap: 16px;">
          <div class="modern-progress-ring">
            <svg viewBox="0 0 100 100" style="width: 100%; height: 100%; transform: rotate(-90deg);">
              <circle cx="50" cy="50" r="45" fill="none" stroke="#e8e8e8" stroke-width="6"></circle>
              <circle class="progress-circle" cx="50" cy="50" r="45" fill="none" stroke="url(#progressGradient)" stroke-width="6" stroke-linecap="round" stroke-dasharray="282.7" stroke-dashoffset="282.7"></circle>
              <defs>
                <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#888;stop-opacity:1" />
                </linearGradient>
              </defs>
            </svg>
            <div class="progress-percent">0%</div>
          </div>
        </div>

      {% when 'rotating_arc' %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <svg viewBox="0 0 50 50" style="width: 100%; height: 100%;">
            <defs>
              <linearGradient id="arcGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#d0d0d0;stop-opacity:0.3" />
                <stop offset="50%" style="stop-color:#666;stop-opacity:0.7" />
                <stop offset="100%" style="stop-color:#1a1a1a;stop-opacity:1" />
              </linearGradient>
            </defs>
            <circle class="modern-arc" cx="25" cy="25" r="20" fill="none" stroke="url(#arcGradient)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="40 85"></circle>
          </svg>
        </div>

      {% else %}
        <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px; position: relative;">
          <svg viewBox="0 0 50 50" style="width: 100%; height: 100%;">
            <defs>
              <linearGradient id="spinGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
                <stop offset="50%" style="stop-color:#666;stop-opacity:0.7" />
                <stop offset="100%" style="stop-color:#d0d0d0;stop-opacity:0.4" />
              </linearGradient>
            </defs>
            <circle class="modern-spinner" cx="25" cy="25" r="20" fill="none" stroke="url(#spinGradient)" stroke-width="3" stroke-linecap="round"></circle>
          </svg>
        </div>
    {% endcase %}
  </preload-page>

  <script>
    (function() {
      function startPreloader() {
      const preload = document.querySelector('.preload-page');
      if (!preload || preload.dataset.started) return;
      preload.dataset.started = 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const removeDelay = reducedMotion ? 0 : {{ preloader_duration | times: 1000 }};
      
      {% if preload_page == 'progress_text' %}
        const progressPercent = document.querySelector('.progress-percent');
        const progressCircle = document.querySelector('.progress-circle');
        const circumference = 282.7;
        
        if (!reducedMotion && progressPercent && progressCircle) {
          let progress = 0;
          const duration = removeDelay;
          const steps = 60;
          const increment = 100 / steps;
          const stepDuration = duration / steps;
          
          const interval = setInterval(() => {
            progress += increment + (Math.random() * 5);
            if (progress > 100) progress = 100;
            
            const offset = circumference - (progress / 100) * circumference;
            progressCircle.style.strokeDashoffset = offset;
            progressPercent.textContent = Math.floor(progress) + '%';
            
            if (progress >= 100) clearInterval(interval);
          }, stepDuration);
        }
      {% endif %}
      
      setTimeout(function() {
        if (preload.isConnected) {
          preload.style.opacity = '0';
          setTimeout(function() {
            preload.remove();
          }, reducedMotion ? 0 : 500);
        }
      }, removeDelay);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startPreloader, { once: true });
      } else {
        startPreloader();
      }
      // Restored pages must never return with a loading overlay.
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) document.querySelector('.preload-page')?.remove();
      });
    })();
{% comment %}{% endcomment %}  </script>

  <style>
    /* Modern Bouncing Dots */
    .modern-dot {
      width: 14px;
      height: 14px;
      background: linear-gradient(135deg, #1a1a1a 0%, #888 50%, #d0d0d0 100%);
      border-radius: 50%;
      animation: modern-bounce 1.2s infinite cubic-bezier(0.45, 0, 0.55, 1);
    }
    @keyframes modern-bounce {
      0%, 100% { 
        transform: translateY(0) scale(1);
        opacity: 1;
      }
      50% { 
        transform: translateY(-24px) scale(0.85);
        opacity: 0.7;
      }
    }

    /* Modern Spinner */
    .modern-spinner {
      animation: modern-spin 1.4s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
      transform-origin: center;
      stroke-dasharray: 90, 150;
      stroke-dashoffset: 0;
    }
    @keyframes modern-spin {
      0% { 
        transform: rotate(0deg);
        stroke-dasharray: 1, 150;
        stroke-dashoffset: 0;
      }
      50% {
        stroke-dasharray: 90, 150;
        stroke-dashoffset: -35;
      }
      100% { 
        transform: rotate(720deg);
        stroke-dasharray: 1, 150;
        stroke-dashoffset: -124;
      }
    }

    /* Modern Ripple */
    .modern-ripple {
      position: absolute;
      inset: 0;
      border: 2.5px solid;
      border-color: rgba(26, 26, 26, 0.6);
      border-radius: 50%;
      animation: modern-ripple-anim 2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    }
    @keyframes modern-ripple-anim {
      0% {
        transform: scale(0.3);
        opacity: 1;
        border-color: rgba(26, 26, 26, 0.8);
      }
      50% {
        opacity: 0.5;
        border-color: rgba(136, 136, 136, 0.6);
      }
      100% {
        transform: scale(1.2);
        opacity: 0;
        border-color: rgba(208, 208, 208, 0.2);
      }
    }

    /* Modern Bars */
    .modern-bar {
      width: 6px;
      background: linear-gradient(180deg, #1a1a1a 0%, #888 50%, #d0d0d0 100%);
      border-radius: 3px;
      animation: modern-bar-pulse 1s infinite ease-in-out;
    }
    @keyframes modern-bar-pulse {
      0%, 100% { 
        transform: scaleY(0.5);
        opacity: 0.4;
      }
      50% { 
        transform: scaleY(1.2);
        opacity: 1;
      }
    }

    /* Modern Slide */
    .slide-modern {
      position: absolute;
      width: 18px;
      height: 18px;
      background: linear-gradient(135deg, #1a1a1a 0%, #888 50%, #d0d0d0 100%);
      border-radius: 50%;
      left: 0;
      animation: modern-slide 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    @keyframes modern-slide {
      0%, 100% { 
        left: 0;
        transform: scale(1);
        opacity: 1;
      }
      50% { 
        left: calc(100% - 18px);
        transform: scale(0.8);
        opacity: 0.6;
      }
    }

    /* Modern Wave */
    .wave-modern {
      width: 8px;
      height: 8px;
      background: linear-gradient(135deg, #1a1a1a 0%, #888 50%, #d0d0d0 100%);
      border-radius: 50%;
      animation: modern-wave 1.2s infinite ease-in-out;
    }
    @keyframes modern-wave {
      0%, 100% { 
        transform: translateY(0) scale(1);
      }
      50% { 
        transform: translateY(-20px) scale(1.2);
      }
    }

    /* Orbit Ring */
    .orbit-ring {
      position: absolute;
      inset: 8px;
      border: 2.5px solid transparent;
      border-top-color: #1a1a1a;
      border-right-color: #888;
      border-radius: 50%;
      animation: orbit-spin 1.2s linear infinite;
      opacity: 0.8;
    }
    .orbit-dot {
      position: absolute;
      width: 12px;
      height: 12px;
      background: linear-gradient(135deg, #1a1a1a 0%, #888 100%);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      animation: orbit-pulse 1.2s infinite ease-in-out;
    }
    @keyframes orbit-spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes orbit-pulse {
      0%, 100% { transform: translate(-50%, -50%) scale(1); }
      50% { transform: translate(-50%, -50%) scale(1.3); }
    }

    /* Morph Square */
    .morph-square {
      position: absolute;
      inset: 0;
      background: transparent;
      border: 3.5px solid;
      border-image: linear-gradient(135deg, #1a1a1a 0%, #888 50%, #d0d0d0 100%) 1;
      animation: morph 2.4s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
    }
    @keyframes morph {
      0%, 100% { 
        border-radius: 0;
        transform: rotate(0deg) scale(1);
      }
      25% {
        border-radius: 50%;
        transform: rotate(90deg) scale(0.75);
      }
      50% {
        border-radius: 0;
        transform: rotate(180deg) scale(1);
      }
      75% {
        border-radius: 50%;
        transform: rotate(270deg) scale(0.75);
      }
    }

    /* Modern Progress Ring */
    .modern-progress-ring {
      width: 120px;
      height: 120px;
      position: relative;
    }
    .progress-circle {
      transition: stroke-dashoffset 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .progress-percent {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(135deg, #1a1a1a 0%, #666 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* Modern Arc */
    .modern-arc {
      animation: modern-arc-spin 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      transform-origin: center;
    }
    @keyframes modern-arc-spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Modern Pulse */
    @keyframes modern-pulse {
      0%, 100% { 
        opacity: 1;
        transform: scale(1);
      }
      50% { 
        opacity: 0.5;
        transform: scale(0.92);
      }
    }
{% comment %}{% endcomment %}  </style>
{% endif %}
</template>
