<template compat="shopify">
{%- comment -%}
  Materia Themes. One percentage ring row for sections/image-with-text-stats.
  Input: stat (a stat block). The ring's final offset is the --iws-off
  variable, so the section CSS can hold it empty until the reveal.
{%- endcomment -%}
{%- liquid
  assign sb = stat.settings
  assign pct = sb.percent | default: 0
  if pct > 100
    assign pct = 100
  endif
  if pct < 0
    assign pct = 0
  endif
  assign offset = 175.93 | times: pct | divided_by: 100.0
  assign final_offset = 175.93 | minus: offset | round: 2
-%}
<div class="iws__stat" data-msr-block="{{ stat.id }}" data-msr-type="stat" data-msr-settings="{{ sb | json | escape }}" style="--iws-off: {{ final_offset }};{% if sb.weight_enable %} --b-weight: {{ sb.weight | default: 400 }};{% endif %}" {{ stat.shopify_attributes }}>
  <div class="iws__stat-ring">
    <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <circle class="iws__stat-ring-bg" cx="32" cy="32" r="28" fill="none" stroke-width="6"/>
      <circle class="iws__stat-ring-fill" cx="32" cy="32" r="28" fill="none" stroke-width="6"/>
    </svg>
    <span class="iws__stat-percent" data-iws-percent>{{ pct }}%</span>
  </div>
  <div class="iws__stat-body">{{ sb.text }}</div>
</div>
</template>
