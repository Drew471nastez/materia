          "type": "qa",
          "settings": {
            "open": true,
            "answer": "<p>Black or Beige. Pick one on the product page before you add it to your cart.</p>",
            "question": "Which colours can I choose?"
          }
        },
        "qa-58d489d642": {
          "type": "qa",
          "settings": {
            "open": false,
            "answer": "<p>S, M and L. All three cost the same, 130 RON while the sale is on.</p>",
            "question": "Which sizes are there?"
          }
        },
        "qa-b50d2f6010": {
          "type": "qa",
          "settings": {
            "open": false,
            "answer": "<p>Yes. You pay 130 RON instead of 200 RON, and the price is shown at checkout before you confirm.</p>",
            "question": "Is the sale price final?"
          }
        },
        "qa-302cd7a84c": {
          "type": "qa",
          "settings": {
            "open": false,
            "answer": "<p>Through the secure Storelib checkout. Once you have paid you are sent back to the shop.</p>",
            "question": "How do I pay?"
          }
        },
        "qa-dba9a6e08b": {
          "type": "qa",
          "settings": {
            "open": false,
            "answer": "<p>Yes. Add a Black pair and a Beige pair to the cart and check out once.</p>",
            "question": "Can I order more than one colour?"
          }
        },
        "qa-44cd6aa003": {
          "type": "qa",
          "settings": {
            "open": false,
            "answer": "<p>Use the contact page and include your name and order details so we can find it quickly.</p>",
            "question": "Who do I contact about my order?"
          }
        }
