<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Mega menu + banners' -%}
</template>

<schema>
{
  "shopify": {
    "type": "menu_promotion",
    "name": "Mega menu + banners",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Top-level menu link title",
        "info": "The top-level menu link this dropdown opens from, for example Shop."
      },
      {
        "type": "select",
        "id": "item_label",
        "default": "unset",
        "label": "Badge label",
        "options": [
          {
            "value": "unset",
            "label": "No badge"
          },
          {
            "value": "hot",
            "label": "Hot"
          },
          {
            "value": "new",
            "label": "New"
          },
          {
            "value": "sale",
            "label": "Sale"
          },
          {
            "value": "popular",
            "label": "Popular"
          },
          {
            "value": "custom_1",
            "label": "Custom 1"
          },
          {
            "value": "custom_2",
            "label": "Custom 2"
          }
        ]
      },
      {
        "type": "header",
        "content": "Banners"
      },
      {
        "type": "range",
        "id": "promotion_image_width",
        "min": 0,
        "max": 50,
        "step": 1,
        "label": "Banner column width",
        "default": 27,
        "unit": "%"
      },
      {
        "type": "image_picker",
        "id": "promotion_image_1",
        "label": "Image"
      },
      {
        "type": "url",
        "id": "promotion_link_1",
        "label": "Link"
      },
      {
        "type": "checkbox",
        "id": "promotion_link_newtab_1",
        "label": "Open in a new tab",
        "default": false,
        "info": "Opens this link in a new tab, on this site or another. Off, it opens in the same tab. A menu link set to open in a new tab in Navigation opens in one either way."
      },
      {
        "type": "text",
        "id": "promotion_label_1",
        "label": "Label on the image",
        "info": "Drawn as set in Header > Image card label."
      },
      {
        "type": "image_picker",
        "id": "promotion_image_2",
        "label": "Image"
      },
      {
        "type": "url",
        "id": "promotion_link_2",
        "label": "Link"
      },
      {
        "type": "checkbox",
        "id": "promotion_link_newtab_2",
        "label": "Open in a new tab",
        "default": false,
        "info": "Opens this link in a new tab, on this site or another. Off, it opens in the same tab. A menu link set to open in a new tab in Navigation opens in one either way."
      },
      {
        "type": "text",
        "id": "promotion_label_2",
        "label": "Label on the image",
        "info": "Drawn as set in Header > Image card label."
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "promotion_menu_column",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Columns (desktop)",
        "default": 4
      },
      {
        "type": "range",
        "id": "mega_custom_width",
        "min": 600,
        "max": 1600,
        "unit": "px",
        "step": 10,
        "label": "Dropdown max width",
        "default": 1030
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width dropdown",
        "default": true
      },
      {
        "type": "select",
        "id": "promotion_position",
        "default": "right",
        "label": "Banner position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "checkbox",
        "id": "open-link-newtab",
        "label": "Open in a new tab",
        "default": false,
        "info": "Opens this link in a new tab, on this site or another. Off, it opens in the same tab. A menu link set to open in a new tab in Navigation opens in one either way."
      },
      {
        "type": "checkbox",
        "id": "center_submenu",
        "label": "Center dropdown",
        "default": true
      }
    ]
  }
}
</schema>

