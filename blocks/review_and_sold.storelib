<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- assign preview_form = 'product-form-' | append: section.id -%}
{%- render 'review-sold-block', product: preview_product, block: block, section: section -%}
</template>

<schema>
{
  "shopify": {
    "type": "review_and_sold",
    "name": "Reviews & sold counter",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "review_label",
        "label": "Review label",
        "default": "reviews"
      },
      {
        "type": "select",
        "id": "review_style",
        "label": "Rating style",
        "default": "stars",
        "options": [
          {
            "value": "stars",
            "label": "Stars"
          },
          {
            "value": "compact",
            "label": "Compact"
          }
        ]
      },
      {
        "type": "select",
        "id": "review_source",
        "label": "Review source",
        "default": "product",
        "options": [
          {
            "value": "product",
            "label": "Product's rating, else mine"
          },
          {
            "value": "manual",
            "label": "Mine only"
          }
        ],
        "info": "The product's own rating and review count when it has them, else the rating and count below."
      },
      {
        "type": "number",
        "id": "manual_review_count",
        "label": "Your review count",
        "default": 0,
        "info": "How many reviews you have. Shown with your rating when the product has none of its own."
      },
      {
        "type": "range",
        "id": "manual_review_rating",
        "label": "Your rating",
        "min": 0,
        "max": 5,
        "step": 0.1,
        "default": 0,
        "info": "Out of 5. 0 hides it."
      },
      {
        "type": "select",
        "id": "sold_source",
        "label": "Sold count source",
        "default": "product",
        "options": [
          {
            "value": "product",
            "label": "Product's count, else mine"
          },
          {
            "value": "manual",
            "label": "Mine only"
          }
        ],
        "info": "The product's custom.sold_count field when it has one, else your number below."
      },
      {
        "type": "text",
        "id": "sold_label",
        "label": "Sold label",
        "default": "sold"
      },
      {
        "type": "checkbox",
        "id": "show_review",
        "default": true,
        "label": "Show reviews"
      },
      {
        "type": "checkbox",
        "id": "show_sold_products",
        "default": true,
        "label": "Show sold counter"
      },
      {
        "type": "checkbox",
        "id": "show_live_dot",
        "label": "Show status dot",
        "default": true
      },
      {
        "type": "textarea",
        "id": "sold",
        "label": "Your sold count",
        "default": "",
        "info": "One whole number, such as 34. A list such as 8,10,12 is not shown."
      },
      {
        "type": "textarea",
        "id": "hours",
        "label": "Period in hours",
        "default": "",
        "info": "Optional, one number: \"34 sold in the last 24 hours\". Leave empty for \"34 sold\"."
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "font_size_desktop",
        "label": "Font size (desktop)",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "font_size_mobile",
        "label": "Font size (mobile)",
        "min": 10,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 13
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Star colour",
        "info": "Empty follows the colour scheme."
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text colour",
        "info": "Empty follows the colour scheme."
      },
      {
        "type": "color",
        "id": "live_dot_color",
        "label": "Dot color",
        "visible_if": "{{ block.settings.show_live_dot }}"
      },
      {
        "type": "text",
        "id": "sold_period_label",
        "label": "Period phrase",
        "default": "in the last"
      },
      {
        "type": "text",
        "id": "hours_label",
        "label": "Hours label",
        "default": "hours"
      }
    ]
  }
}
</schema>

