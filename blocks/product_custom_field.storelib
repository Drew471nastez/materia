<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- assign preview_form = 'product-form-' | append: section.id -%}
{%- render 'product-personalization', product: preview_product, block: block, section: section, product_form_id: preview_form -%}
</template>

<schema>
{
  "shopify": {
    "type": "product_custom_field",
    "name": "Personalization fields",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "enable_field_text",
        "label": "t:sections.main-product.blocks.product_custom_field.settings.field_type.enable_field_text",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_field_image",
        "label": "t:sections.main-product.blocks.product_custom_field.settings.field_type.enable_field_image",
        "default": true
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Make it yours"
      },
      {
        "type": "text",
        "id": "field_image_label",
        "label": "t:sections.main-product.blocks.product_custom_field.settings.field_label",
        "visible_if": "{{ block.settings.enable_field_image }}",
        "default": "Upload a photo"
      },
      {
        "type": "inline_richtext",
        "id": "description",
        "label": "Description",
        "default": "Add a name, note, or photo to your item."
      },
      {
        "type": "text",
        "id": "field_label",
        "label": "t:sections.main-product.blocks.product_custom_field.settings.field_label",
        "default": "Personalization"
      },
      {
        "type": "text",
        "id": "field_placeholder",
        "label": "Text placeholder",
        "default": "Enter a name or note"
      },
      {
        "type": "checkbox",
        "id": "field_required",
        "label": "Text is required",
        "default": false
      },
      {
        "type": "range",
        "id": "field_max_length",
        "label": "Maximum characters",
        "min": 20,
        "max": 500,
        "step": 10,
        "default": 200
      },
      {
        "type": "checkbox",
        "id": "field_image_required",
        "label": "Photo is required",
        "default": false,
        "visible_if": "{{ block.settings.enable_field_image }}"
      },
      {
        "type": "text",
        "id": "upload_help",
        "label": "Upload help",
        "default": "JPG, PNG or WebP, up to 10 MB."
      }
    ]
  }
}
</schema>

