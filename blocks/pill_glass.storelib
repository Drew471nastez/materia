<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Pill & Glassmorphism' -%}
</template>

<schema>
{
  "shopify": {
    "type": "pill_glass",
    "name": "Pill & Glassmorphism",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Pill header"
      },
      {
        "type": "checkbox",
        "id": "header_pill_enable",
        "label": "Enable pill-shaped header",
        "default": false
      },
      {
        "type": "range",
        "id": "header_max_width",
        "label": "Max pill width",
        "min": 60,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 94
      },
      {
        "type": "range",
        "id": "header_top_offset",
        "label": "Top offset (push down)",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "header_side_offset",
        "label": "Side offset (left/right inset)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "header_bottom_offset",
        "label": "Bottom margin",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "header_padding_x",
        "label": "Horizontal padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "header_radius",
        "label": "Border radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 50
      },
      {
        "type": "color",
        "id": "header_pill_bg",
        "label": "Pill background color",
        "default": "#FFFFFF",
        "visible_if": "{{ block.settings.glass_enabled == false }}"
      },
      {
        "type": "range",
        "id": "header_pill_border_width",
        "label": "Border width",
        "min": 0,
        "max": 4,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "color",
        "id": "header_pill_border_color",
        "label": "Border color"
      },
      {
        "type": "checkbox",
        "id": "header_pill_blur",
        "label": "Glassmorphism blur behind pill",
        "default": false
      },
      {
        "type": "range",
        "id": "header_pill_blur_amount",
        "label": "Blur amount",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 12,
        "visible_if": "{{ block.settings.header_pill_blur }}"
      },
      {
        "type": "header",
        "content": "Pill on phones & tablets"
      },
      {
        "type": "checkbox",
        "id": "header_pill_mobile",
        "label": "Enable pill on mobile devices",
        "default": false
      },
      {
        "type": "range",
        "id": "header_pill_mobile_top",
        "label": "Mobile top offset",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.header_pill_mobile }}"
      },
      {
        "type": "range",
        "id": "header_pill_mobile_side",
        "label": "Mobile side offset",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 10,
        "visible_if": "{{ block.settings.header_pill_mobile }}"
      },
      {
        "type": "range",
        "id": "header_pill_mobile_radius",
        "label": "Mobile border radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "default": 50,
        "visible_if": "{{ block.settings.header_pill_mobile }}"
      },
      {
        "type": "header",
        "content": "Glass appearance"
      },
      {
        "type": "checkbox",
        "id": "glass_enabled",
        "label": "Enable glassmorphism",
        "default": false
      },
      {
        "type": "color",
        "id": "glass_color",
        "label": "Tint color",
        "default": "#ffffff",
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_opacity",
        "label": "Tint opacity",
        "min": 5,
        "max": 90,
        "step": 1,
        "unit": "%",
        "default": 30,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_blur",
        "label": "Blur strength",
        "min": 4,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 20,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_brightness",
        "label": "Brightness",
        "min": 70,
        "max": 140,
        "step": 1,
        "unit": "%",
        "default": 105,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_saturation",
        "label": "Saturation boost",
        "min": 100,
        "max": 200,
        "step": 5,
        "unit": "%",
        "default": 140,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_contrast",
        "label": "Contrast",
        "min": 80,
        "max": 140,
        "step": 1,
        "unit": "%",
        "default": 110,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_shine",
        "label": "Edge highlight",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "%",
        "default": 35,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "range",
        "id": "glass_shadow",
        "label": "Drop shadow depth",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 28,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "glass_border",
        "label": "Show subtle bottom border",
        "default": true,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "glass_text_enable",
        "label": "Enable custom text & icons color",
        "default": false,
        "visible_if": "{{ block.settings.glass_enabled }}"
      },
      {
        "type": "color",
        "id": "glass_text_color",
        "label": "Text & icons color",
        "default": "#ffffff",
        "visible_if": "{{ block.settings.glass_text_enable }}"
      },
      {
        "type": "header",
        "content": "Pill spacing"
      },
      {
        "type": "range",
        "id": "header_padding_y",
        "label": "Inner vertical padding",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  }
}
</schema>

