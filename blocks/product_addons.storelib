<template compat="shopify">
{%- assign product = product | default: page.product -%}
{%- assign block_st = block.settings -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script src="{{ 'product-block-runtime.js' | asset_url }}" defer></script>
{{ 'product-block-runtime.css' | asset_url | stylesheet_tag }}
{%- include 'product-info-blocks' -%}
</template>

<schema>
{
  "shopify": {
    "type": "product_addons",
    "name": "Product addons",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Question"
      },
      {
        "type": "checkbox",
        "id": "show_ask_question",
        "default": true,
        "label": "Show \"Have questions?\" link"
      },
      {
        "type": "text",
        "id": "ask_question_label",
        "label": "Link label",
        "default": "Have questions?",
        "visible_if": "{{ block.settings.show_ask_question }}"
      },
      {
        "type": "select",
        "id": "ask_question_mode",
        "label": "Open question",
        "default": "modal",
        "options": [
          {
            "value": "modal",
            "label": "Message modal"
          },
          {
            "value": "page",
            "label": "Contact page"
          }
        ]
      },
      {
        "type": "page",
        "id": "ask_question_page",
        "label": "Page to redirect to",
        "visible_if": "{{ block.settings.ask_question_mode == 'page' }}"
      },
      {
        "type": "text",
        "id": "question_message_label",
        "label": "Message label",
        "default": "Your question"
      },
      {
        "type": "text",
        "id": "question_placeholder",
        "label": "Message placeholder",
        "default": "What would you like to know?"
      },
      {
        "type": "header",
        "content": "Share"
      },
      {
        "type": "checkbox",
        "id": "show_share",
        "default": true,
        "label": "Show share link"
      },
      {
        "type": "text",
        "id": "share_copy_label",
        "label": "Copy button",
        "default": "Copy link"
      },
      {
        "type": "text",
        "id": "share_copied_label",
        "label": "Copied message",
        "default": "Link copied"
      },
      {
        "type": "text",
        "id": "share_error_label",
        "label": "Copy error",
        "default": "Select and copy the link above."
      }
    ]
  }
}
</schema>
