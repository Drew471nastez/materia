        "default": "own",
        "options": [
          {
            "value": "own",
            "label": "Block button"
          },
          {
            "value": "main",
            "label": "Main buttons"
          },
          {
            "value": "both",
            "label": "Both"
          }
        ],
        "info": "Main buttons include this selection in the product Add to cart and Buy now. Buy now uses cart checkout, including existing cart items and required cart terms."
      },
      {
        "type": "checkbox",
        "id": "show_button",
        "label": "Show block Add to cart button",
        "default": true,
        "info": "Choose Main buttons above to purchase this selection without its own button."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Add to cart",
        "visible_if": "{{ block.settings.show_button }}"
      },
      {
        "type": "text",
        "id": "error_text",
        "label": "Error message",
        "default": "This could not be added. Try again."
      },
      {
        "type": "checkbox",
        "id": "sync_form_quantity",
        "label": "Sync visible product quantity",
        "default": true,
        "info": "Controls the displayed quantity field. Main buttons mode still purchases the selected tier."
      },
      {
        "type": "text",
        "id": "checkout_note",
        "label": "Note when Storelib takes the saving off",
        "default": "The saving comes off at checkout."
      },
