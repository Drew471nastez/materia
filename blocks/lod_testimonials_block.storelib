<template compat="shopify">
{%- assign product = product | default: page.product -%}
{%- assign block_st = block.settings -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script src="{{ 'product-block-runtime.js' | asset_url }}" defer></script>
{{ 'product-block-runtime.css' | asset_url | stylesheet_tag }}
{%- include 'product-info-blocks' -%}
</template>

<schema>
{
  "shopify": {
    "type": "lod_testimonials_block",
    "name": "Testimonials",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "show_verified_badge",
        "label": "Show Verified Badge",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "custom_star_image",
        "label": "Custom Star Image"
      },
      {
        "type": "text",
        "id": "verified_text",
        "label": "Verified Text",
        "default": "Verified"
      },
      {
        "type": "header",
        "content": "Testimonial 1"
      },
      {
        "type": "checkbox",
        "id": "t1_enable",
        "label": "Enable",
        "default": true
      },
      {
        "type": "inline_richtext",
        "id": "t1_title",
        "label": "Title",
        "visible_if": "{{ block.settings.t1_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t1_text",
        "label": "Text",
        "visible_if": "{{ block.settings.t1_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t1_author",
        "label": "Author",
        "visible_if": "{{ block.settings.t1_enable }}"
      },
      {
        "type": "select",
        "id": "t1_rating",
        "label": "Stars",
        "default": "4",
        "options": [
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          }
        ],
        "visible_if": "{{ block.settings.t1_enable }}"
      },
      {
        "type": "header",
        "content": "Testimonial 2"
      },
      {
        "type": "checkbox",
        "id": "t2_enable",
        "label": "Enable",
        "default": true
      },
      {
        "type": "inline_richtext",
        "id": "t2_title",
        "label": "Title",
        "visible_if": "{{ block.settings.t2_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t2_text",
        "label": "Text",
        "visible_if": "{{ block.settings.t2_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t2_author",
        "label": "Author",
        "visible_if": "{{ block.settings.t2_enable }}"
      },
      {
        "type": "select",
        "id": "t2_rating",
        "label": "Stars",
        "default": "4",
        "options": [
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          }
        ],
        "visible_if": "{{ block.settings.t2_enable }}"
      },
      {
        "type": "header",
        "content": "Testimonial 3"
      },
      {
        "type": "checkbox",
        "id": "t3_enable",
        "label": "Enable",
        "default": true
      },
      {
        "type": "inline_richtext",
        "id": "t3_title",
        "label": "Title",
        "visible_if": "{{ block.settings.t3_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t3_text",
        "label": "Text",
        "visible_if": "{{ block.settings.t3_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t3_author",
        "label": "Author",
        "visible_if": "{{ block.settings.t3_enable }}"
      },
      {
        "type": "select",
        "id": "t3_rating",
        "label": "Stars",
        "default": "5",
        "options": [
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          }
        ],
        "visible_if": "{{ block.settings.t3_enable }}"
      },
      {
        "type": "header",
        "content": "Testimonial 4"
      },
      {
        "type": "checkbox",
        "id": "t4_enable",
        "label": "Enable",
        "default": false
      },
      {
        "type": "inline_richtext",
        "id": "t4_title",
        "label": "Title",
        "visible_if": "{{ block.settings.t4_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t4_text",
        "label": "Text",
        "visible_if": "{{ block.settings.t4_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t4_author",
        "label": "Author",
        "visible_if": "{{ block.settings.t4_enable }}"
      },
      {
        "type": "select",
        "id": "t4_rating",
        "label": "Stars",
        "default": "5",
        "options": [
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          }
        ],
        "visible_if": "{{ block.settings.t4_enable }}"
      },
      {
        "type": "header",
        "content": "Testimonial 5"
      },
      {
        "type": "checkbox",
        "id": "t5_enable",
        "label": "Enable",
        "default": false
      },
      {
        "type": "inline_richtext",
        "id": "t5_title",
        "label": "Title",
        "visible_if": "{{ block.settings.t5_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t5_text",
        "label": "Text",
        "visible_if": "{{ block.settings.t5_enable }}"
      },
      {
        "type": "inline_richtext",
        "id": "t5_author",
        "label": "Author",
        "visible_if": "{{ block.settings.t5_enable }}"
      },
      {
        "type": "select",
        "id": "t5_rating",
        "label": "Stars",
        "default": "5",
        "options": [
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          },
          {
            "label": "4",
            "value": "4"
          },
          {
            "label": "5",
            "value": "5"
          }
        ],
        "visible_if": "{{ block.settings.t5_enable }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "verified_badge_padding_x",
        "label": "Badge Padding — X",
        "min": 4,
        "max": 24,
        "step": 1,
        "default": 8,
        "unit": "px",
        "visible_if": "{{ block.settings.show_verified_badge }}"
      },
      {
        "type": "range",
        "id": "verified_badge_padding_y",
        "label": "Badge Padding — Y",
        "min": 2,
        "max": 12,
        "step": 1,
        "default": 4,
        "unit": "px",
        "visible_if": "{{ block.settings.show_verified_badge }}"
      },
      {
        "type": "range",
        "id": "star_gap",
        "label": "Gap Between Stars",
        "min": 0,
        "max": 14,
        "step": 1,
        "default": 6,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_top",
        "label": "Section Margin Top",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 15,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_margin_bottom",
        "label": "Section Margin Bottom",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 15,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "card_padding",
        "label": "Card Inner Padding",
        "min": 16,
        "max": 32,
        "step": 2,
        "default": 24,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "cards_per_row",
        "label": "Cards Per Row (Desktop)",
        "min": 1,
        "max": 2,
        "step": 0.2,
        "default": 1.4
      },
      {
        "type": "range",
        "id": "cards_gap",
        "label": "Gap Between Cards",
        "min": 5,
        "max": 60,
        "step": 5,
        "default": 10,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "star_size_mobile",
        "label": "Star Tile Size (Mobile)",
        "min": 10,
        "max": 40,
        "step": 1,
        "default": 18,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "star_size",
        "label": "Star Tile Size (Desktop)",
        "min": 12,
        "max": 48,
        "step": 1,
        "default": 22,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "title_size",
        "label": "Title Font Size",
        "min": 9,
        "max": 32,
        "step": 1,
        "default": 14,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "title_size_mobile",
        "label": "Title Font Size (Mobile)",
        "min": 9,
        "max": 28,
        "step": 1,
        "default": 14,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Text Font Size",
        "min": 9,
        "max": 24,
        "step": 1,
        "default": 13,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "author_size",
        "label": "Author Font Size",
        "min": 9,
        "max": 24,
        "step": 1,
        "default": 13,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "text_size_mobile",
        "label": "Text Font Size (Mobile)",
        "min": 9,
        "max": 22,
        "step": 1,
        "default": 12,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "author_size_mobile",
        "label": "Author Font Size (Mobile)",
        "min": 9,
        "max": 22,
        "step": 1,
        "default": 12,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "verified_text_size",
        "label": "Text Size",
        "min": 9,
        "max": 20,
        "step": 1,
        "default": 10,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "title_text_color",
        "label": "Title Text Color",
        "default": "#333333",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "testimonial_text_color",
        "label": "Testimonial Text Color",
        "default": "#666666",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "author_text_color",
        "label": "Author Text Color",
        "default": "#333333",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "verified_text_color",
        "label": "Verified Badge Text Color",
        "default": "#FFFFFF",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "nav_arrow_color",
        "label": "Navigation Arrow Color",
        "default": "#333333",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "card_background_color",
        "label": "Card Background Color",
        "default": "#F8F8F8",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "White Star (Glyph) Color",
        "default": "#FFFFFF",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_background_color",
        "label": "Filled Tile Color",
        "default": "#00B67A",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "star_empty_background_color",
        "label": "Empty Tile Color",
        "default": "#E6E6E6",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "nav_background_color",
        "label": "Navigation Background Color",
        "default": "rgba(255,255,255,0.9)",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "range",
        "id": "star_radius",
        "label": "Star Tile Border Radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 3,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "verified_badge_radius",
        "label": "Badge Radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 8,
        "unit": "px",
        "visible_if": "{{ block.settings.show_verified_badge }}"
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "label": "Card Border Radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 0,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "star_style",
        "label": "Star Icon Style",
        "options": [
          {
            "value": "default",
            "label": "Default Star"
          },
          {
            "value": "custom",
            "label": "Custom Image"
          }
        ],
        "default": "default"
      },
      {
        "type": "header",
        "content": "Icons"
      },
      {
        "type": "color",
        "id": "verified_icon_bg_color",
        "label": "Verified Badge Background Color",
        "default": "#484848",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "star_icon_scale_m",
        "label": "White Star Size (Mobile, % of tile)",
        "min": 55,
        "max": 95,
        "step": 1,
        "default": 95,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "star_icon_scale_d",
        "label": "White Star Size (Desktop, % of tile)",
        "min": 55,
        "max": 95,
        "step": 1,
        "default": 95,
        "unit": "%"
      },
      {
        "type": "header",
        "content": "Options"
      },
      {
        "type": "range",
        "id": "mobile_peek_percentage",
        "label": "Mobile Peek Percentage",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 10,
        "unit": "%"
      },
      {
        "type": "header",
        "content": "Theme styling"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      }
    ]
  }
}
</schema>
