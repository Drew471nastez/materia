<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- assign preview_form = 'product-form-' | append: section.id -%}
{%- render 'upsell-pro', current_product: preview_product, product: preview_product, block: block, section: section, product_form_id: preview_form -%}
</template>

<schema>
{
  "shopify": {
    "type": "upsell_pro",
    "name": "Upsell Pro",
    "limit": 2,
    "settings": [
      {
        "type": "paragraph",
        "content": "Shows other products to add with this one. Prices come from each product and the option chosen. Items are added at their own price: Storelib checkout takes a saving off only for a bundle or checkout offer set up under Products › Upsells and bundles, or a discount code."
      },
      {
        "type": "header",
        "content": "Products"
      },
      {
        "type": "select",
        "id": "source",
        "label": "Product source",
        "info": "Auto shows any manual products first, then fills up to Max products with products recommended for this one (its collection, else the whole shop), never the product itself.",
        "default": "manual",
        "options": [
          {
            "value": "manual",
            "label": "Picked"
          },
          {
            "value": "auto",
            "label": "Picked, then recommended"
          }
        ]
      },
      {
        "type": "product",
        "id": "manual_product_1",
        "label": "Manual product 1"
      },
      {
        "type": "product",
        "id": "manual_product_2",
        "label": "Manual product 2"
      },
      {
        "type": "product",
        "id": "manual_product_3",
        "label": "Manual product 3"
      },
      {
        "type": "product",
        "id": "manual_product_4",
        "label": "Manual product 4"
      },
      {
        "type": "product",
        "id": "manual_product_5",
        "label": "Manual product 5"
      },
      {
        "type": "product",
        "id": "manual_product_6",
        "label": "Manual product 6"
      },
      {
        "type": "range",
        "id": "max_products",
        "label": "Max products to show",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "hide_current_product",
        "label": "Hide current product",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "hide_unavailable",
        "label": "Hide unavailable products",
        "default": true
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "default": "cards",
        "options": [
          {
            "value": "cards",
            "label": "Cards"
          },
          {
            "value": "list",
            "label": "List"
          },
          {
            "value": "tiles",
            "label": "Tiles"
          },
          {
            "value": "bold",
            "label": "Bold"
          },
          {
            "value": "soft",
            "label": "Soft"
          },
          {
            "value": "minimal",
            "label": "Minimal"
          },
          {
            "value": "compact",
            "label": "Compact rows"
          }
        ]
      },
      {
        "type": "select",
        "id": "image_shape",
        "label": "Image shape",
        "default": "rounded",
        "options": [
          {
            "value": "square",
            "label": "Square (slight radius)"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "natural",
            "label": "Natural"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_size_px",
        "label": "Image size",
        "min": 40,
        "max": 96,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "range",
        "id": "heading_size",
        "label": "Heading size",
        "min": 11,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "heading_gap",
        "label": "Heading bottom margin",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "gap",
        "label": "Gap between cards",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "You may also like"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading"
      },
      {
        "type": "checkbox",
        "id": "show_image",
        "label": "Show product image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_subtitle",
        "label": "Show subtitle",
        "default": true
      },
      {
        "type": "select",
        "id": "subtitle_source",
        "label": "Subtitle source",
        "default": "product_type",
        "options": [
          {
            "value": "product_type",
            "label": "Product type"
          },
          {
            "value": "vendor",
            "label": "Vendor"
          },
          {
            "value": "collection",
            "label": "First collection"
          },
          {
            "value": "custom",
            "label": "Custom text"
          }
        ],
        "visible_if": "{{ block.settings.show_subtitle }}"
      },
      {
        "type": "text",
        "id": "custom_subtitle",
        "label": "Custom subtitle text",
        "visible_if": "{{ block.settings.show_subtitle }}"
      },
      {
        "type": "checkbox",
        "id": "show_price",
        "label": "Show price",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_compare_at",
        "label": "Show compare-at price",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "text",
        "id": "sale_badge_text",
        "label": "Sale badge text",
        "default": "Sale",
        "visible_if": "{{ block.settings.show_sale_badge }}"
      },
      {
        "type": "checkbox",
        "id": "show_variant_selector",
        "label": "Show option picker",
        "default": false
      },
      {
        "type": "header",
        "content": "Adding to cart"
      },
      {
        "type": "select",
        "id": "add_mode",
        "label": "Add",
        "default": "each",
        "options": [
          {
            "value": "each",
            "label": "Each card"
          },
          {
            "value": "selected",
            "label": "Tick and add"
          }
        ],
        "info": "Tick and add: the buyer ticks products and adds them in one step, with the total shown."
      },
      {
        "type": "checkbox",
        "id": "preselect",
        "label": "Start ticked",
        "default": true,
        "visible_if": "{{ block.settings.add_mode == 'selected' }}"
      },
      {
        "type": "text",
        "id": "upsell_button_text",
        "label": "Button text",
        "default": "Add",
        "visible_if": "{{ block.settings.add_mode == 'each' }}"
      },
      {
        "type": "text",
        "id": "added_text",
        "label": "Added button text",
        "default": "Added",
        "visible_if": "{{ block.settings.add_mode == 'each' }}"
      },
      {
        "type": "text",
        "id": "add_selected_label",
        "label": "Add selected button",
        "default": "Add chosen items",
        "visible_if": "{{ block.settings.add_mode == 'selected' }}"
      },
      {
        "type": "text",
        "id": "total_label",
        "label": "Total label",
        "default": "Total",
        "visible_if": "{{ block.settings.add_mode == 'selected' }}"
      },
      {
        "type": "text",
        "id": "soldout_text",
        "label": "Sold out text",
        "default": "Sold out"
      },
      {
        "type": "text",
        "id": "error_text",
        "label": "Error message",
        "default": "This could not be added. Try again."
      },
      {
        "type": "checkbox",
        "id": "open_drawer_after_add",
        "label": "Open cart drawer after add",
        "default": false,
        "info": "Tick and add always opens the cart."
      },
      {
        "type": "header",
        "content": "Custom style"
      },
      {
        "type": "checkbox",
        "id": "custom_style",
        "label": "Use the custom style below",
        "default": false,
        "info": "On: the colours, corners, borders and spacing below are used (an empty colour follows the colour scheme). Off: everything follows the colour scheme and Theme settings > Buttons."
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Block background",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Card border color",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "muted_color",
        "label": "Muted text color",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "show_border",
        "label": "Show card border",
        "default": false,
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "checkbox",
        "id": "show_shadow",
        "label": "Show card shadow",
        "default": false,
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card border radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 12,
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button border radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background",
        "visible_if": "{{ block.settings.custom_style }}"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text color",
        "visible_if": "{{ block.settings.custom_style }}"
      }
    ]
  }
}
</schema>

