<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Mega menu: collections only' -%}
</template>

<schema>
{
  "shopify": {
    "type": "menu_collections_only",
    "name": "Mega menu: collections only",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Top-level menu link title",
        "info": "The top-level menu link this dropdown opens from, for example Shop."
      },
      {
        "type": "header",
        "content": "Collections"
      },
      {
        "type": "collection_list",
        "id": "collection_list",
        "label": "Collections",
        "limit": 8
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "columns",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Columns (desktop)",
        "default": 4
      },
      {
        "type": "checkbox",
        "id": "show_titles",
        "label": "Show collection titles",
        "default": true
      },
      {
        "type": "select",
        "id": "image_ratio",
        "label": "Image ratio",
        "default": "square",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          }
        ]
      },
      {
        "type": "range",
        "id": "mega_custom_width",
        "min": 600,
        "max": 1600,
        "unit": "px",
        "step": 10,
        "label": "Dropdown max width",
        "default": 1030
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width dropdown",
        "default": false
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "item_label",
        "default": "unset",
        "label": "Badge label",
        "options": [
          {
            "value": "unset",
            "label": "No badge"
          },
          {
            "value": "hot",
            "label": "Hot"
          },
          {
            "value": "new",
            "label": "New"
          },
          {
            "value": "sale",
            "label": "Sale"
          },
          {
            "value": "popular",
            "label": "Popular"
          },
          {
            "value": "custom_1",
            "label": "Custom 1"
          },
          {
            "value": "custom_2",
            "label": "Custom 2"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "center_submenu",
        "label": "Center dropdown",
        "default": true
      }
    ]
  }
}
</schema>

