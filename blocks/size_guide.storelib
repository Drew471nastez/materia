<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- render 'size-guide-sheet', block: block, product: preview_product, section: section -%}
</template>
<schema>
{
  "name": "Size guide",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Product size chart"
    },
    {
      "type": "paragraph",
      "id": "para_2",
      "label": "Uses the chart assigned in Storelib > Products > Size charts. It updates for each product. Without an assigned chart, optional content or a page below is used.",
      "content": "Uses the chart assigned in Storelib > Products > Size charts. It updates for each product. Without an assigned chart, optional content or a page below is used."
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Link or button label",
      "default": "Size guide"
    },
    {
      "type": "select",
      "id": "size_guide_display",
      "label": "Open size guide as",
      "default": "modal",
      "options": [
        {
          "value": "modal",
          "label": "Modal / mobile sheet"
        },
        {
          "value": "collapsible",
          "label": "Collapsible row"
        }
      ]
    },
    {
      "type": "select",
      "id": "size_guide_appearance",
      "label": "Appearance",
      "default": "link",
      "options": [
        {
          "value": "link",
          "label": "Text link"
        },
        {
          "value": "button",
          "label": "Secondary button"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Fallback content"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Fallback page"
    }
  ],
  "shopify": {
    "type": "size_guide",
    "name": "Size guide",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Product size chart"
      },
      {
        "type": "paragraph",
        "content": "Uses the chart assigned in Storelib > Products > Size charts. It updates for each product. Without an assigned chart, optional content or a page below is used."
      },
      {
        "type": "text",
        "id": "size_guide_label",
        "label": "Link or button label",
        "default": "Size guide"
      },
      {
        "type": "select",
        "id": "size_guide_display",
        "label": "Open size guide as",
        "default": "modal",
        "options": [
          {
            "value": "modal",
            "label": "Modal / mobile sheet"
          },
          {
            "value": "collapsible",
            "label": "Collapsible row"
          }
        ]
      },
      {
        "type": "select",
        "id": "size_guide_appearance",
        "label": "Appearance",
        "default": "link",
        "options": [
          {
            "value": "link",
            "label": "Text link"
          },
          {
            "value": "button",
            "label": "Secondary button"
          }
        ]
      },
      {
        "type": "richtext",
        "id": "size_guide_content",
        "label": "Fallback content"
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "Fallback page"
      }
    ]
  }
}
</schema>

