<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- assign preview_form = 'product-form-' | append: section.id -%}
{%- render 'product-offers', product: preview_product, block: block, section: section, kind: 'bundle', product_form_id: preview_form -%}
</template>

<schema>
{
  "name": "Bundle",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "paragraph",
      "id": "para_5",
      "label": "Sells this product with one to three others you pick, added to the cart in one step. Prices come from your products. Storelib checkout takes the saving off when the store has the same bundle under Pro",
      "content": "Sells this product with one to three others you pick, added to the cart in one step. Prices come from your products. Storelib checkout takes the saving off when the store has the same bundle under Products › Upsells and bundles; the block then shows that bundle's saving by itself. Otherwise set a discount code below and keep the saving shown the same."
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "bold",
          "label": "Bold"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "compact",
          "label": "Compact rows"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show pictures",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare at prices",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "visible_if": "{{ block.settings.custom_style }}",
      "label": "Accent",
      "info": "Empty follows the colour scheme."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy it together"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "A short line above the box, such as Bundle & save."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Optional, on the box's top edge, such as Best value."
    },
    {
      "type": "text",
      "id": "this_item_label",
      "label": "Label on this product",
      "default": "This item"
    },
    {
      "type": "text",
      "id": "option_label",
      "label": "Option list name",
      "default": "Option"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Saving"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Saving shown",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "Shown when every product is ticked. A matching Storelib bundle's own saving is shown instead. 0 shows no saving."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "Optional. Applied to the cart when the whole set is added. Create the code in Storelib first."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Saving label",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "checkout_note",
      "label": "Note when Storelib takes the saving off",
      "default": "The saving comes off at checkout."
    },
    {
      "type": "header",
      "id": "hdr_26",
      "label": "Button"
    },
    {
      "type": "select",
      "id": "purchase_action",
      "label": "Purchase buttons",
      "default": "own",
      "options": [
        {
          "value": "own",
          "label": "Block button"
        },
        {
          "value": "main",
          "label": "Main buttons"
        },
        {
          "value": "both",
          "label": "Both"
        }
      ],
      "info": "Main buttons include this selection in the product Add to cart and Buy now. Buy now uses cart checkout, including existing cart items and required cart terms."
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show block Add to cart button",
      "default": true,
      "info": "Choose Main buttons above to purchase this selection without its own button."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "These could not be added. Try again."
    },
    {
      "type": "text",
      "id": "adding_label",
      "label": "Loading announcement",
      "default": "Adding to cart",
      "info": "Screen-reader text while the loading spinner is shown."
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Button text once added",
      "default": "Added to cart"
    },
    {
      "type": "checkbox",
      "id": "open_cart_after_add",
      "label": "Open the cart after adding",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_29",
      "label": "Custom style"
    },
    {
      "type": "checkbox",
      "id": "custom_style",
      "label": "Use the custom style below",
      "default": false,
      "info": "On: the colours, corners, borders and spacing below are used (an empty colour follows the colour scheme). Off: everything follows the colour scheme and Theme settings > Buttons."
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Card background",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_heading",
      "label": "Titles and prices",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Border",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_selected",
      "label": "Chosen outline and ticks",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_save",
      "label": "Saving text",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_badge_bg",
      "label": "Badge background",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "color",
      "id": "custom_badge_text",
      "label": "Badge text",
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "range",
      "id": "custom_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "range",
      "id": "custom_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.custom_style }}"
    },
    {
      "type": "range",
      "id": "custom_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.custom_style }}"
    }
  ],
  "shopify": {
