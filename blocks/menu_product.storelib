<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Mega menu + products' -%}
</template>

<schema>
{
  "name": "Mega menu + products",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Top-level menu link title",
      "info": "The top-level menu link this dropdown opens from, for example Shop."
    },
    {
      "type": "select",
      "id": "item_label",
      "default": "unset",
      "label": "Badge label",
      "options": [
        {
          "value": "unset",
          "label": "No badge"
        },
        {
          "value": "hot",
          "label": "Hot"
        },
        {
          "value": "new",
          "label": "New"
        },
        {
          "value": "sale",
          "label": "Sale"
        },
        {
          "value": "popular",
          "label": "Popular"
        },
        {
          "value": "custom_1",
          "label": "Custom 1"
        },
        {
          "value": "custom_2",
          "label": "Custom 2"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_9",
      "label": "Layout & spacing"
    },
    {
      "type": "range",
      "id": "product_menu_column",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "mega_custom_width",
      "min": 600,
      "max": 1600,
      "unit": "px",
      "step": 10,
      "label": "Dropdown max width",
      "default": 1030
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width dropdown",
      "default": true
    },
    {
      "type": "range",
      "id": "product_width",
      "min": 0,
      "max": 50,
      "unit": "%",
      "step": 5,
      "label": "Product column width",
      "default": 50
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "open_link_newtab",
      "label": "Open in a new tab",
      "default": false,
      "info": "Opens this link in a new tab, on this site or another. Off, it opens in the same tab. A menu link set to open in a new tab in Navigation opens in one either way."
    },
    {
      "type": "checkbox",
      "id": "center_submenu",
      "label": "Center dropdown",
      "default": true
    }
  ],
  "shopify": {
    "type": "menu_product",
    "name": "Mega menu + products",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Top-level menu link title",
        "info": "The top-level menu link this dropdown opens from, for example Shop."
      },
      {
        "type": "select",
        "id": "item_label",
        "default": "unset",
        "label": "Badge label",
        "options": [
          {
            "value": "unset",
            "label": "No badge"
          },
          {
            "value": "hot",
            "label": "Hot"
          },
          {
            "value": "new",
            "label": "New"
          },
          {
            "value": "sale",
            "label": "Sale"
          },
          {
            "value": "popular",
            "label": "Popular"
          },
          {
            "value": "custom_1",
            "label": "Custom 1"
          },
          {
            "value": "custom_2",
            "label": "Custom 2"
          }
        ]
      },
      {
        "type": "header",
        "content": "Products"
      },
      {
        "type": "product",
        "id": "product_1",
        "label": "Product 1"
      },
      {
        "type": "product",
        "id": "product_2",
        "label": "Product 2"
      },
      {
        "type": "product",
        "id": "product_3",
        "label": "Product 3"
      },
      {
        "type": "checkbox",
        "id": "show_price",
        "label": "Show prices",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "product_menu_column",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Columns (desktop)",
        "default": 4
      },
      {
        "type": "range",
        "id": "mega_custom_width",
        "min": 600,
        "max": 1600,
        "unit": "px",
        "step": 10,
        "label": "Dropdown max width",
        "default": 1030
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width dropdown",
        "default": true
      },
      {
        "type": "range",
        "id": "product_width",
        "min": 0,
        "max": 50,
        "unit": "%",
        "step": 5,
        "label": "Product column width",
        "default": 50
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "checkbox",
        "id": "open-link-newtab",
        "label": "Open in a new tab",
        "default": false,
        "info": "Opens this link in a new tab, on this site or another. Off, it opens in the same tab. A menu link set to open in a new tab in Navigation opens in one either way."
      },
      {
        "type": "checkbox",
        "id": "center_submenu",
        "label": "Center dropdown",
        "default": true
      }
    ]
  }
}
</schema>

