<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- if preview_product.id != blank -%}
{%- render 'variant-picker-block', product: preview_product, block: block, section: section -%}
{%- else -%}
{%- render 'editor-block-preview', block: block, title: 't:sections.main-product.blocks.variant_picker.name', message: 'Choose a product with variants to preview its option selector.' -%}
{%- endif -%}
</template>

<schema>
{
  "name": "Variant picker",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Picker"
    },
    {
      "type": "select",
      "id": "picker_swatch_style",
      "label": "Color swatch fill",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "color_swatches",
          "label": "Colors"
        },
        {
          "value": "variant_images",
          "label": "Images"
        }
      ],
      "info": "Images use each variant’s product image; colors use the general Variant Swatches settings."
    },
    {
      "type": "select",
      "id": "variant_type",
      "label": "Picker type",
      "options": [
        {
          "value": "swatches",
          "label": "Buttons"
        },
        {
          "value": "dropdown",
          "label": "Dropdown"
        }
      ],
      "default": "swatches"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide",
      "default": false
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Link text",
      "default": "Size guide",
      "visible_if": "{{ block.settings.show_size_guide }}"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size chart page",
      "visible_if": "{{ false }}"
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Size guide",
      "info": "Table, text or image",
      "visible_if": "{{ block.settings.show_size_guide }}"
    },
    {
      "type": "header",
      "id": "hdr_8",
      "label": "Style"
    },
    {
      "type": "checkbox",
      "id": "enable_picker_custom",
      "label": "Custom style",
      "default": false
    },
    {
      "type": "range",
      "id": "picker_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_text_selected",
      "label": "Text (selected)",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_text_unselected",
      "label": "Text",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_text_hover",
      "label": "Text (hover)",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_bg_selected",
      "label": "Background (selected)",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_bg_unselected",
      "label": "Background",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    },
    {
      "type": "color",
      "id": "picker_border_color",
      "label": "Border",
      "visible_if": "{{ block.settings.enable_picker_custom }}"
    }
  ],
  "shopify": {
    "type": "variant_picker",
    "name": "t:sections.main-product.blocks.variant_picker.name",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Picker"
      },
      {
        "type": "select",
        "id": "picker_swatch_style",
        "label": "Color swatch fill",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Theme"
          },
          {
            "value": "color_swatches",
            "label": "Colors"
          },
          {
            "value": "variant_images",
            "label": "Images"
          }
        ],
        "info": "Images use each variant’s product image; colors use the general Variant Swatches settings."
      },
      {
        "type": "select",
        "id": "variant_type",
        "label": "Picker type",
        "options": [
          {
            "value": "swatches",
            "label": "Buttons"
          },
          {
            "value": "dropdown",
            "label": "Dropdown"
          }
        ],
        "default": "swatches"
      },
      {
        "type": "checkbox",
        "id": "show_size_guide",
        "label": "Show size guide",
        "default": false
      },
      {
        "type": "text",
        "id": "size_guide_label",
        "label": "Link text",
        "default": "Size guide",
        "visible_if": "{{ block.settings.show_size_guide }}"
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "t:sections.main-product.blocks.variant_picker.settings.size_guide.settings.size_guide_page",
        "visible_if": "{{ false }}"
      },
      {
        "type": "richtext",
        "id": "size_guide_content",
        "label": "Size guide",
        "info": "Table, text or image",
        "visible_if": "{{ block.settings.show_size_guide }}"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "checkbox",
        "id": "enable_picker_custom",
        "label": "Custom style",
        "default": false
      },
      {
        "type": "range",
        "id": "picker_border_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_text_selected",
        "label": "Text (selected)",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_text_unselected",
        "label": "Text",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_text_hover",
        "label": "Text (hover)",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_bg_selected",
        "label": "Background (selected)",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_bg_unselected",
        "label": "Background",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      },
      {
        "type": "color",
        "id": "picker_border_color",
        "label": "Border",
        "visible_if": "{{ block.settings.enable_picker_custom }}"
      }
    ]
  }
}
</schema>

