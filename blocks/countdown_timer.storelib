        "min": 0,
        "max": 23,
        "step": 1,
        "default": 23,
        "visible_if": "{{ block.settings.timing_input == 'parts' }}"
      },
      {
        "type": "range",
        "id": "end_minute",
        "label": "Minute",
        "min": 0,
        "max": 59,
        "step": 1,
        "default": 59,
        "visible_if": "{{ block.settings.timing_input == 'parts' }}"
      },
      {
        "type": "text",
        "id": "utc_offset",
        "label": "UTC offset",
        "default": "+00:00",
        "info": "For example +02:00 or -05:00. Use the offset in effect on your end date, including daylight saving.",
        "visible_if": "{{ block.settings.timing_input == 'parts' }}"
      },
      {
        "type": "text",
        "id": "end_iso",
        "label": "End date and time",
        "info": "Full ISO date and time, for example 2027-12-31T23:59:59+02:00.",
        "visible_if": "{{ block.settings.timing_input == 'iso' }}"
      },
      {
        "type": "select",
        "id": "date_source",
        "label": "Date source",
        "default": "block",
        "options": [
          {
            "value": "block",
            "label": "This block"
          },
          {
            "value": "product",
            "label": "Product field"
          }
        ],
        "info": "Product field reads custom.countdown_timer. A date entered in this block takes priority by default."
      },
      {
        "type": "select",
        "id": "on_end",
        "label": "When the countdown ends",
        "default": "zeros",
        "options": [
          {
            "value": "zeros",
            "label": "Show zeros"
          },
          {
            "value": "ended",
            "label": "Show message"
          },
          {
            "value": "hide",
            "label": "Hide timer"
          }
        ]
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "inline_richtext",
        "id": "content",
        "label": "t:sections.main-product.blocks.countdown_timer.settings.content",
        "default": "🔥 Hurry Up! Sale ends in:"
      },
      {
        "type": "text",
        "id": "ended_text",
        "label": "Ended message",
        "default": "Countdown ended",
        "visible_if": "{{ block.settings.on_end == 'ended' }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "timer_style",
        "options": [
          {
            "value": "default",
            "label": "t:sections.main-product.blocks.countdown_timer.settings.timer_style.default"
          },
          {
            "value": "highlight",
            "label": "t:sections.main-product.blocks.countdown_timer.settings.timer_style.highlight"
          },
          {
            "value": "tiles",
            "label": "Tiles"
          }
        ],
        "default": "default",
        "label": "t:sections.main-product.blocks.countdown_timer.settings.timer_style.label"
      },
      {
        "type": "range",
        "id": "item_gap",
        "label": "Gap between units",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top spacing",
        "min": 0,
        "max": 80,
        "step": 2,
        "default": 8,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom spacing",
        "min": 0,
        "max": 80,
        "step": 2,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Custom styling"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      },
      {
        "type": "color",
        "id": "custom_bg",
        "label": "Background",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_heading_color",
        "label": "Heading",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_number_color",
        "label": "Numbers",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_label_color",
        "label": "Unit labels",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "custom_border",
        "label": "Border",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "number_size",
        "label": "Number size",
        "min": 12,
        "max": 40,
        "step": 1,
        "default": 20,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "custom_radius",
        "label": "Corners",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 6,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "custom_padding",
        "label": "Inner padding",
        "min": 0,
        "max": 32,
        "step": 1,
        "default": 12,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "text",
        "id": "invalid_date_label",
        "label": "Date setup hint",
        "default": "Choose a valid end date and time."
      }
    ]
  }
}
</schema>
