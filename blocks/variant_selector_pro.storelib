      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 11,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "label_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "Label weight",
      "default": 500,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "checkbox",
      "id": "label_uppercase",
      "label": "UPPERCASE labels",
      "default": false,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "label_gap",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Gap between thumbnail and label",
      "default": 6,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "placeholder_size",
      "min": 9,
