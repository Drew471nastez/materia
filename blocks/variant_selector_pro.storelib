<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- if preview_product.id != blank -%}
{%- render 'variant-selector-pro-render', product: preview_product, block: block, section: section -%}
{%- else -%}
{%- render 'editor-block-preview', block: block, title: 'Variant Selector Pro', message: 'Choose a product with variants to preview its option selector.' -%}
{%- endif -%}
</template>

<schema>
{
  "name": "Variant Selector Pro",
  "settings": [
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_current_variant",
      "label": "Show chosen value",
      "default": true
    },
    {
      "type": "select",
      "id": "swatch_style",
      "label": "Colour swatch",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "image",
          "label": "Picture"
        },
        {
          "value": "color",
          "label": "Colour"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_unavailable",
      "label": "Hide sold out",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_static_title",
      "label": "Show 'SELECT YOUR OPTION' static title",
      "default": false,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Select your option",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Screen-reader label",
      "default": "Choose variant",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "text",
      "id": "current_variant_separator",
      "label": "Separator between title and value",
      "default": ":",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show variant label below thumbnail",
      "default": false,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "mt",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 16,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "mb",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 16,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap between header and grid",
      "default": 10,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "select",
      "id": "option_alignment",
      "label": "Option alignment (only when size is capped)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "header",
      "content": "Custom style"
    },
    {
      "type": "checkbox",
      "id": "enable_vsp_custom",
      "label": "Enable custom style",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "selected_text_color",
      "label": "Selected text",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E5E5E5",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Selected border",
      "default": "#717171",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "chip_bg",
      "label": "Background",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "selected_bg",
      "label": "Selected background",
      "default": "#FFF8EC",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "selected_border",
      "label": "Selected card border",
      "default": "#F59E0B",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted (subtitle, footer)",
      "default": "#666666",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Image background",
      "default": "#F5F5F5",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "footer_color",
      "label": "Footer color",
      "default": "#666666",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "header",
      "content": "Custom layout"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "cols_mobile",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (mobile)",
      "default": 4,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card gap (desktop)",
      "default": 8,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Card gap (mobile)",
      "default": 6,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Card inner padding",
      "default": 4,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card radius",
      "default": 10,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 44,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "selected_border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 2,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "selected_ring_size",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Selected glow size",
      "default": 0,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "header",
      "content": "Thumbnail images"
    },
    {
      "type": "range",
      "id": "option_size_d",
      "min": 0,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Overall option size (desktop)",
      "default": 80,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "option_size_m",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Overall option size (mobile)",
      "default": 75,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "select",
      "id": "image_aspect",
      "label": "Image aspect ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ],
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill + crop)"
        },
        {
          "value": "contain",
          "label": "Contain (fit without crop)"
        },
        {
          "value": "fill",
          "label": "Fill (stretch to fit)"
        }
      ],
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Thumbnail corner radius",
      "default": 6,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "thumb_max_size",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Thumbnail max size (0 = fill column)",
      "default": 0,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "thumb_inner_padding",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Padding inside thumbnail",
      "default": 0,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "header",
      "content": "Custom typography"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 13,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "title_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "Title weight",
      "default": 600,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "UPPERCASE title",
      "default": true,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "min": 0,
      "max": 0.4,
      "step": 0.1,
      "unit": "em",
      "label": "Title letter spacing",
      "default": 0,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "color",
      "id": "current_variant_color",
      "label": "Selected variant text colour",
      "default": "#111111",
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "current_variant_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "label": "Selected variant font weight",
      "default": 700,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "checkbox",
      "id": "current_variant_uppercase",
      "label": "UPPERCASE selected variant name",
      "default": false,
      "visible_if": "{{ block.settings.enable_vsp_custom }}"
    },
    {
      "type": "range",
      "id": "subtitle_size",
