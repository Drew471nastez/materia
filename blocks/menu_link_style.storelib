<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Menu link: badge & colour' -%}
</template>

<schema>
{
  "name": "Menu link: badge & colour",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Top-level menu link title",
      "info": "The top-level link this styles, for example Buy Theme!"
    },
    {
      "type": "select",
      "id": "item_label",
      "default": "hot",
      "label": "Badge above the link",
      "options": [
        {
          "value": "unset",
          "label": "No badge"
        },
        {
          "value": "hot",
          "label": "Hot"
        },
        {
          "value": "new",
          "label": "New"
        },
        {
          "value": "sale",
          "label": "Sale"
        },
        {
          "value": "popular",
          "label": "Popular"
        },
        {
          "value": "custom_1",
          "label": "Custom 1"
        },
        {
          "value": "custom_2",
          "label": "Custom 2"
        }
      ]
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link colour",
      "info": "Empty follows the header."
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link colour on hover",
      "info": "Empty keeps the link colour."
    }
  ],
  "shopify": {
    "type": "menu_link_style",
    "name": "Menu link: badge & colour",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Top-level menu link title",
        "info": "The top-level link this styles, for example Buy Theme!"
      },
      {
        "type": "select",
        "id": "item_label",
        "default": "hot",
        "label": "Badge above the link",
        "options": [
          {
            "value": "unset",
            "label": "No badge"
          },
          {
            "value": "hot",
            "label": "Hot"
          },
          {
            "value": "new",
            "label": "New"
          },
          {
            "value": "sale",
            "label": "Sale"
          },
          {
            "value": "popular",
            "label": "Popular"
          },
          {
            "value": "custom_1",
            "label": "Custom 1"
          },
          {
            "value": "custom_2",
            "label": "Custom 2"
          }
        ]
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Link colour",
        "info": "Empty follows the header."
      },
      {
        "type": "color",
        "id": "link_hover_color",
        "label": "Link colour on hover",
        "info": "Empty keeps the link colour."
      }
    ]
  }
}
</schema>

