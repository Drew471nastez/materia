<template compat="shopify">
{%- assign product = product | default: page.product -%}
{%- assign block_st = block.settings -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- include 'product-info-blocks' -%}
</template>

<schema>
{
  "shopify": {
    "type": "product_addon",
    "name": "Product Add-On",
    "limit": 6,
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "checkbox",
        "id": "enable_variant_selector",
        "label": "Enable variant selector",
        "default": false
      },
      {
        "type": "product",
        "id": "addon_product",
        "label": "Select add-on product"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "section_width_d",
        "label": "Section width",
        "min": 320,
        "max": 900,
        "step": 10,
        "default": 370
      },
      {
        "type": "range",
        "id": "section_width_m",
        "label": "Section width (mobile)",
        "min": 260,
        "max": 640,
        "step": 10,
        "default": 340
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Image size",
        "min": 36,
        "max": 96,
        "step": 2,
        "default": 54
      },
      {
        "type": "range",
        "id": "variant_space_top",
        "label": "Variant selector top spacing",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "variant_space_bottom",
        "label": "Variant selector bottom spacing",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_top_d",
        "label": "Top padding",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_bottom_d",
        "label": "Bottom padding",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_left_d",
        "label": "Left padding",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_right_d",
        "label": "Right padding",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "margin_top_d",
        "label": "Top margin",
        "min": 0,
        "max": 48,
        "step": 1,
        "default": 12
      },
      {
        "type": "range",
        "id": "margin_bottom_d",
        "label": "Bottom margin",
        "min": 0,
        "max": 48,
        "step": 1,
        "default": 12
      },
      {
        "type": "range",
        "id": "pad_top_m",
        "label": "Top padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_bottom_m",
        "label": "Bottom padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_left_m",
        "label": "Left padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "pad_right_m",
        "label": "Right padding (mobile)",
        "min": 0,
        "max": 40,
        "step": 1,
        "default": 8
      },
      {
        "type": "range",
        "id": "margin_top_m",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 48,
        "step": 1,
        "default": 12
      },
      {
        "type": "range",
        "id": "margin_bottom_m",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 48,
        "step": 1,
        "default": 12
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "select",
        "id": "text_weight",
        "label": "Title weight (for name)",
        "default": "600",
        "options": [
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "select",
        "id": "add_text_weight",
        "label": "“Add” text weight",
        "default": "700",
        "options": [
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Title size",
        "min": 12,
        "max": 24,
        "step": 1,
        "default": 16
      },
      {
        "type": "select",
        "id": "price_weight",
        "label": "Price weight",
        "default": "600",
        "options": [
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "range",
        "id": "price_size",
        "label": "Price size",
        "min": 12,
        "max": 22,
        "step": 1,
        "default": 16
      },
      {
        "type": "select",
        "id": "compare_weight",
        "label": "Compare-at weight",
        "default": "400",
        "options": [
          {
            "value": "400",
            "label": "400"
          },
          {
            "value": "500",
            "label": "500"
          },
          {
            "value": "600",
            "label": "600"
          },
          {
            "value": "700",
            "label": "700"
          }
        ]
      },
      {
        "type": "range",
        "id": "compare_size",
        "label": "Compare-at size",
        "min": 10,
        "max": 20,
        "step": 1,
        "default": 14
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "price_color",
        "label": "Price color",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "active_border_color",
        "label": "Active border color (when checked)",
        "default": "#929292"
      },
      {
        "type": "color",
        "id": "compare_color",
        "label": "Compare-at color",
        "default": "#9AA0A6"
      },
      {
        "type": "color",
        "id": "chk_bg",
        "label": "Checkbox background",
        "default": "#EBEBEB"
      },
      {
        "type": "color",
        "id": "chk_check_color",
        "label": "Check icon color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "chk_bg_checked",
        "label": "Checkbox background (checked)",
        "default": "#1575F4"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#F6F7F9"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#E3E5EA"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Image radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 10
      },
      {
        "type": "range",
        "id": "active_border_width",
        "label": "Active border thickness",
        "min": 0,
        "max": 6,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Border radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "default": 12
      }
    ]
  }
}
</schema>
