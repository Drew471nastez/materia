<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- render 'size-table-render', block: block, product: preview_product, section: section -%}
</template>
<schema>
{
  "shopify": {
    "type": "size_table",
    "name": "Size chart",
    "limit": 3,
    "settings": [
      {
        "type": "checkbox",
        "id": "use_storelib_chart",
        "label": "Use assigned Storelib size chart",
        "default": true,
        "info": "The chart assigned to each product is used first. Manual table data below is a fallback."
      },
      {
        "type": "header",
        "content": "How it works"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Size Guide"
      },
      {
        "type": "textarea",
        "id": "table_data",
        "label": "Table data",
        "info": "Optional fallback: first line is the header. Separate cells with |. Never enter guessed measurements."
      },
      {
        "type": "header",
        "content": "Per-product data (optional)"
      },
      {
        "type": "checkbox",
        "id": "use_metafield",
        "label": "Use the product's custom field",
        "default": false
      },
      {
        "type": "text",
        "id": "metafield_namespace",
        "label": "Custom field namespace",
        "default": "custom",
        "visible_if": "{{ block.settings.use_metafield }}"
      },
      {
        "type": "text",
        "id": "metafield_key",
        "label": "Custom field key",
        "default": "size_table",
        "visible_if": "{{ block.settings.use_metafield }}"
      },
      {
        "type": "header",
        "content": "Collapsible"
      },
      {
        "type": "checkbox",
        "id": "collapsible",
        "label": "Collapsible",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "start_open",
        "label": "Open by default",
        "default": false
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "color",
        "id": "accent",
        "label": "Header background",
        "default": "#E5E7EB"
      },
      {
        "type": "color",
        "id": "header_text_color",
        "label": "Header text",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "body_text_color",
        "label": "Body text",
        "default": "#374151"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Title color",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#E5E7EB"
      },
      {
        "type": "checkbox",
        "id": "zebra",
        "label": "Striped rows",
        "default": true
      },
      {
        "type": "color",
        "id": "zebra_color",
        "label": "Stripe color",
        "default": "#F9FAFB"
      },
      {
        "type": "range",
        "id": "title_size",
        "label": "Title size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "cell_size",
        "label": "Cell text size",
        "min": 11,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 14
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 10
      },
      {
        "type": "range",
        "id": "space_above",
        "label": "Space above",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 8
      },
      {
        "type": "range",
        "id": "space_below",
        "label": "Space below",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  }
}
</schema>

