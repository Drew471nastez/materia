<template compat="shopify">
{%- assign product = product | default: page.product -%}
{%- assign block_st = block.settings -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script src="{{ 'product-block-runtime.js' | asset_url }}" defer></script>
{{ 'product-block-runtime.css' | asset_url | stylesheet_tag }}
{%- include 'product-info-blocks' -%}
</template>

<schema>
{
  "name": "Countdown badge",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Schedule"
    },
    {
      "type": "select",
      "id": "timing_input",
      "label": "Date setup",
      "default": "parts",
      "options": [
        {
          "value": "parts",
          "label": "Date and time"
        },
        {
          "value": "iso",
          "label": "Advanced ISO"
        }
      ]
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date",
      "info": "YYYY-MM-DD, for example 2027-12-31. An existing advanced date is retained until you enter a date here.",
      "visible_if": "{{ block.settings.timing_input == 'parts' }}"
    },
    {
      "type": "range",
      "id": "end_hour",
      "label": "Hour (24-hour clock)",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 23,
      "visible_if": "{{ block.settings.timing_input == 'parts' }}"
    },
    {
      "type": "range",
      "id": "end_minute",
      "label": "Minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 59,
      "visible_if": "{{ block.settings.timing_input == 'parts' }}"
    },
    {
      "type": "text",
      "id": "utc_offset",
      "label": "UTC offset",
      "default": "+00:00",
      "info": "For example +02:00 or -05:00. Use the offset in effect on your end date, including daylight saving.",
      "visible_if": "{{ block.settings.timing_input == 'parts' }}"
    },
    {
      "type": "text",
      "id": "end_iso",
      "label": "End date and time",
      "info": "Full ISO date and time, for example 2027-12-31T23:59:59+02:00.",
      "visible_if": "{{ block.settings.timing_input == 'iso' }}"
    },
    {
      "type": "select",
      "id": "on_end",
      "label": "When countdown ends",
      "default": "zeros",
      "options": [
        {
          "value": "zeros",
          "label": "Display 00 : 00 : 00 : 00"
        },
        {
          "value": "ended",
          "label": "Show ended text"
        },
        {
          "value": "restart",
          "label": "Repeat interval"
        }
      ],
      "info": "Repeat only for an explicitly recurring event; never imply a sale deadline that does not exist."
    },
    {
      "type": "range",
      "id": "restart_days",
      "label": "Restart days",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.on_end == 'restart' }}"
    },
    {
      "type": "range",
      "id": "restart_hours",
      "label": "Restart hours",
      "min": 0,
      "max": 48,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.on_end == 'restart' }}"
    },
    {
      "type": "range",
      "id": "restart_minutes",
      "label": "Restart minutes",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.on_end == 'restart' }}"
    },
    {
      "type": "range",
      "id": "restart_seconds",
      "label": "Restart seconds",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.on_end == 'restart' }}"
    },
    {
      "type": "header",
      "id": "hdr_13",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Hurry Up! Sale ends in:"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days label",
      "default": "days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "hours"
    },
    {
      "type": "text",
      "id": "mins_label",
      "label": "Mins label",
      "default": "min"
    },
    {
      "type": "text",
      "id": "secs_label",
      "label": "Secs label",
      "default": "sec"
    },
    {
      "type": "text",
      "id": "ended_text",
      "label": "Ended text",
      "default": "Sale ended",
      "visible_if": "{{ block.settings.on_end == 'ended' }}"
    },
    {
      "type": "header",
      "id": "hdr_20",
      "label": "Size and spacing"
    },
    {
      "type": "range",
      "id": "timer_width_d_px",
      "label": "Countdown width (Desktop, px)",
      "min": 200,
      "max": 1200,
      "step": 10,
      "default": 370
    },
    {
      "type": "range",
      "id": "timer_width_m_px",
      "label": "Countdown width (Mobile, px)",
      "min": 160,
      "max": 600,
      "step": 10,
      "default": 320
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "pad_left_d",
      "label": "Left padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "pad_right_d",
      "label": "Right padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "pad_left_m",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "pad_right_m",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "section_pt_d",
      "label": "Top margin (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "section_pb_d",
      "label": "Bottom margin (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "section_pt_m",
      "label": "Top margin (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "section_pb_m",
      "label": "Bottom margin (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "id": "hdr_32",
      "label": "Custom styling"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_style",
      "label": "Enable custom styling",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFF1F1",
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#F2B6B6",
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 10,
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111",
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "heading_size_d",
      "label": "Heading size (desktop)",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 18,
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "label": "Heading size (mobile)",
      "min": 12,
      "max": 26,
      "step": 1,
      "default": 16,
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        }
      ],
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Numbers & separators color",
      "default": "#D23B3B",
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "number_size_d",
      "label": "Number size (desktop)",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 18,
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "range",
      "id": "number_size_m",
      "label": "Number size (mobile)",
      "min": 12,
      "max": 26,
      "step": 1,
      "default": 16,
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "select",
      "id": "number_weight",
      "label": "Number weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        }
      ],
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Units label color",
      "default": "#7A1F1F",
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Units label weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "visible_if": "{{ block.settings.enable_custom_style }}"
    },
    {
      "type": "text",
      "id": "invalid_date_label",
      "label": "Date setup hint",
      "default": "Choose a valid end date and time."
    }
  ],
