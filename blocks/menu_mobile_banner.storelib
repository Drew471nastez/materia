        "id": "text",
        "label": "Show under menu link",
        "info": "A top-level link title, for example Shop: the banner shows in that submenu on phones. Empty shows it at the end of the main menu."
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "label",
        "label": "Small label",
        "default": "New in"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The new season"
      },
      {
        "type": "textarea",
        "id": "body",
        "label": "Text"
      },
      {
        "type": "select",
        "id": "divider",
        "label": "Divider",
        "default": "wave",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "line",
            "label": "Line"
          },
          {
            "value": "wave",
