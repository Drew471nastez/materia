        "label": "Background",
        "info": "Empty is a soft tint of the menu text colour."
      },
      {
        "type": "color",
        "id": "banner_text",
        "label": "Text colour"
      },
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background"
      },
      {
        "type": "color",
        "id": "button_color",
        "label": "Button text"
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 32,
        "step": 1,
