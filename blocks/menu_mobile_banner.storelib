<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Mobile menu banner' -%}
</template>

<schema>
{
  "name": "Mobile menu banner",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Show under menu link",
      "info": "A top-level link title, for example Shop: the banner shows in that submenu on phones. Empty shows it at the end of the main menu."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "New in"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The new season"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Divider",
      "default": "wave",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "line",
          "label": "Line"
        },
        {
          "value": "wave",
          "label": "Wave"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "banner_bg",
      "label": "Background",
      "info": "Empty is a soft tint of the menu text colour."
    },
    {
      "type": "color",
      "id": "banner_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text"
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    }
  ],
  "shopify": {
    "type": "menu_mobile_banner",
    "name": "Mobile menu banner",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
