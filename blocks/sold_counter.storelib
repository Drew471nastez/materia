<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- render 'review-sold-block', product: preview_product, block: block, mode: 'sold', section: section -%}
</template>

<schema>
{
  "name": "Sold counter",
  "settings": [
    {
      "type": "header",
      "id": "hdr_1",
      "label": "Content"
    },
    {
      "type": "paragraph",
      "id": "para_2",
      "label": "Reads custom.sold_count for each product, or one verified count you supply. No random numbers are generated.",
      "content": "Reads custom.sold_count for each product, or one verified count you supply. No random numbers are generated."
    },
    {
      "type": "checkbox",
      "id": "refresh_sold_count",
      "label": "Refresh product count",
      "default": true,
      "info": "Refreshes the product’s published custom.sold_count while visible, at most once per minute. Manual counts remain fixed. Never generates or rotates numbers.",
      "visible_if": "{{ block.settings.sold_source == 'product' }}"
    },
    {
      "type": "select",
      "id": "sold_source",
      "label": "Source",
      "default": "product",
      "options": [
        {
          "value": "product",
          "label": "Product data"
        },
        {
          "value": "manual",
          "label": "Verified count"
        }
      ]
    },
    {
      "type": "number",
      "id": "sold",
      "label": "Verified sold count",
      "default": 0,
      "visible_if": "{{ block.settings.sold_source == 'manual' }}"
    },
    {
      "type": "number",
      "id": "hours",
      "label": "Verified period (hours)",
      "default": 0,
      "visible_if": "{{ block.settings.sold_source == 'manual' }}"
    },
    {
      "type": "text",
      "id": "sold_label",
      "label": "Count label",
      "default": "sold"
    },
    {
      "type": "text",
      "id": "sold_period_label",
      "label": "Period phrase",
      "default": "in the last"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Period unit",
      "default": "hours"
    },
    {
      "type": "checkbox",
      "id": "show_live_dot",
      "label": "Show status dot",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "Custom style"
    },
    {
      "type": "checkbox",
      "id": "enable_counter_custom",
      "label": "Enable custom style",
      "default": false
    },
    {
      "type": "color",
      "id": "live_dot_color",
      "label": "Status dot",
      "visible_if": "{{ block.settings.enable_counter_custom }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "visible_if": "{{ block.settings.enable_counter_custom }}"
    }
  ],
  "shopify": {
    "type": "sold_counter",
    "name": "Sold counter",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "Reads custom.sold_count for each product, or one verified count you supply. No random numbers are generated."
      },
      {
        "type": "checkbox",
        "id": "refresh_sold_count",
        "label": "Refresh product count",
        "default": true,
        "info": "Refreshes the product’s published custom.sold_count while visible, at most once per minute. Manual counts remain fixed. Never generates or rotates numbers.",
        "visible_if": "{{ block.settings.sold_source == 'product' }}"
      },
      {
        "type": "select",
        "id": "sold_source",
        "label": "Source",
        "default": "product",
        "options": [
          {
            "value": "product",
            "label": "Product data"
          },
          {
            "value": "manual",
            "label": "Verified count"
          }
        ]
      },
      {
        "type": "number",
        "id": "sold",
        "label": "Verified sold count",
        "default": 0,
        "visible_if": "{{ block.settings.sold_source == 'manual' }}"
      },
      {
        "type": "number",
        "id": "hours",
        "label": "Verified period (hours)",
        "default": 0,
        "visible_if": "{{ block.settings.sold_source == 'manual' }}"
      },
      {
        "type": "text",
        "id": "sold_label",
        "label": "Count label",
        "default": "sold"
      },
      {
        "type": "text",
        "id": "sold_period_label",
        "label": "Period phrase",
        "default": "in the last"
      },
      {
        "type": "text",
        "id": "hours_label",
        "label": "Period unit",
        "default": "hours"
      },
      {
        "type": "checkbox",
        "id": "show_live_dot",
        "label": "Show status dot",
        "default": true
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top spacing",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom spacing",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Custom style"
      },
      {
        "type": "checkbox",
        "id": "enable_counter_custom",
        "label": "Enable custom style",
        "default": false
      },
      {
        "type": "color",
        "id": "live_dot_color",
        "label": "Status dot",
        "visible_if": "{{ block.settings.enable_counter_custom }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ block.settings.enable_counter_custom }}"
      }
    ]
  }
}
</schema>

