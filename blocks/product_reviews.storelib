<template compat="shopify">
{%- assign preview_product = product | default: page.product -%}
{%- render 'review-sold-block', product: preview_product, block: block, mode: 'reviews', section: section -%}
</template>

<schema>
{
  "shopify": {
    "type": "product_reviews",
    "name": "Reviews",
    "limit": 1,
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "paragraph",
        "content": "Shows this product’s published rating and review count. Manual values are used only when supplied by you."
      },
      {
        "type": "select",
        "id": "review_source",
        "label": "Source",
        "default": "product",
        "options": [
          {
            "value": "product",
            "label": "Product data"
          },
          {
            "value": "manual",
            "label": "My values"
          }
        ]
      },
      {
        "type": "range",
        "id": "manual_review_rating",
        "label": "Rating",
        "min": 0,
        "max": 5,
        "step": 0.1,
        "default": 0,
        "visible_if": "{{ block.settings.review_source == 'manual' }}"
      },
      {
        "type": "number",
        "id": "manual_review_count",
        "label": "Review count",
        "default": 0,
        "visible_if": "{{ block.settings.review_source == 'manual' }}"
      },
      {
        "type": "text",
        "id": "review_label",
        "label": "Count label",
        "default": "reviews"
      },
      {
        "type": "header",
        "content": "Custom style"
      },
      {
        "type": "checkbox",
        "id": "enable_counter_custom",
        "label": "Enable custom style",
        "default": false
      },
      {
        "type": "color",
        "id": "star_color",
        "label": "Stars",
        "visible_if": "{{ block.settings.enable_counter_custom }}"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "visible_if": "{{ block.settings.enable_counter_custom }}"
      }
    ]
  }
}
</schema>

