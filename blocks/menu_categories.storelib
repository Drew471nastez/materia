<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Mega menu + categories' -%}
</template>

<schema>
{
  "shopify": {
    "type": "menu_categories",
    "name": "Mega menu + categories",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Top-level menu link title",
        "info": "The top-level menu link this dropdown opens from, for example Shop."
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Shop by category"
      },
      {
        "type": "collection_list",
        "id": "collection_list",
        "label": "Categories",
        "limit": 12,
        "info": "Each collection is a category: its picture, title and product count."
      },
      {
        "type": "checkbox",
        "id": "show_links",
        "label": "Show the link's own sub links",
        "default": true,
        "info": "The links under this menu link in Navigation, beside the categories."
      },
      {
        "type": "header",
        "content": "Categories"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "default": "list",
        "options": [
          {
            "value": "list",
            "label": "List"
          },
          {
            "value": "tiles",
            "label": "Tiles"
          }
        ]
      },
      {
        "type": "range",
        "id": "columns",
        "label": "Columns (desktop)",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 3
      },
      {
        "type": "select",
        "id": "image_style",
        "label": "Picture",
        "default": "circle",
        "options": [
          {
            "value": "circle",
            "label": "Circle"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "none",
            "label": "None"
          }
        ]
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Picture size",
        "min": 32,
        "max": 96,
        "step": 4,
        "unit": "px",
        "default": 56
      },
      {
        "type": "checkbox",
        "id": "show_count",
        "label": "Show product counts",
        "default": true
      },
      {
        "type": "text",
        "id": "count_label",
        "label": "Count label",
        "default": "products"
      },
      {
        "type": "header",
        "content": "Shop all link"
      },
      {
        "type": "text",
        "id": "view_all_label",
        "label": "Label",
        "default": "Shop all"
      },
      {
        "type": "url",
        "id": "view_all_url",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Banner"
      },
      {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "banner_heading",
        "label": "Heading"
      },
      {
        "type": "text",
        "id": "banner_button",
        "label": "Button label",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "banner_link",
        "label": "Link"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Titles",
        "info": "Empty follows the header colours."
      },
      {
        "type": "color",
        "id": "count_color",
        "label": "Counts"
      },
      {
        "type": "color",
        "id": "item_bg",
        "label": "Category background"
      },
      {
        "type": "header",
        "content": "Layout & spacing"
      },
      {
        "type": "range",
        "id": "mega_custom_width",
        "min": 600,
        "max": 1600,
        "unit": "px",
        "step": 10,
        "label": "Dropdown max width",
        "default": 1030
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width dropdown",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "center_submenu",
        "label": "Center dropdown",
        "default": true
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "item_label",
        "default": "unset",
        "label": "Badge label",
        "options": [
          {
            "value": "unset",
            "label": "No badge"
          },
          {
            "value": "hot",
            "label": "Hot"
          },
          {
            "value": "new",
            "label": "New"
          },
          {
            "value": "sale",
            "label": "Sale"
          },
          {
            "value": "popular",
            "label": "Popular"
          },
          {
            "value": "custom_1",
            "label": "Custom 1"
          },
          {
            "value": "custom_2",
            "label": "Custom 2"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "open_link_newtab",
        "label": "Open the menu link in a new tab",
        "default": false
      }
    ]
  }
}
</schema>

