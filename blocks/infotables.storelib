<template compat="shopify">
{%- assign product = product | default: page.product -%}
{%- assign block_st = block.settings -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script src="{{ 'product-block-runtime.js' | asset_url }}" defer></script>
{{ 'product-block-runtime.css' | asset_url | stylesheet_tag }}
{%- include 'product-info-blocks' -%}
</template>

<schema>
{
  "shopify": {
    "type": "infotables",
    "name": "Info Rows",
    "settings": [
      {
        "type": "header",
        "content": "Row 1"
      },
      {
        "type": "checkbox",
        "id": "row1_enable",
        "label": "Enable row 1",
        "default": true
      },
      {
        "type": "text",
        "id": "row1_lead",
        "label": "Lead text",
        "default": "Product details",
        "visible_if": "{{ block.settings.row1_enable }}"
      },
      {
        "type": "text",
        "id": "row1_strong",
        "label": "Highlight text",
        "visible_if": "{{ block.settings.row1_enable }}"
      },
      {
        "type": "checkbox",
        "id": "row1_custom_icon",
        "label": "Enable custom SVG icon",
        "default": false,
        "visible_if": "{{ block.settings.row1_enable }}"
      },
      {
        "type": "range",
        "id": "row1_highlight_weight",
        "label": "Row 1 highlight weight",
        "min": 500,
        "max": 900,
        "step": 50,
        "default": 700,
        "visible_if": "{{ block.settings.row1_enable }}"
      },
      {
        "type": "textarea",
        "id": "row1_svg",
        "label": "Custom icon SVG (used only if enabled)",
        "default": "/",
        "visible_if": "{{ block.settings.row1_custom_icon }}"
      },
      {
        "type": "header",
        "content": "Row 2"
      },
      {
        "type": "checkbox",
        "id": "row2_enable",
        "label": "Enable row 2",
        "default": false
      },
      {
        "type": "text",
        "id": "row2_lead",
        "label": "Lead text",
        "default": "Use code",
        "visible_if": "{{ block.settings.row2_enable }}"
      },
      {
        "type": "text",
        "id": "row2_code",
        "label": "Discount code",
        "visible_if": "{{ block.settings.row2_enable }}"
      },
      {
        "type": "text",
        "id": "row2_tail",
        "label": "Trailing text",
        "visible_if": "{{ block.settings.row2_enable }}"
      },
      {
        "type": "checkbox",
        "id": "row2_custom_icon",
        "label": "Enable custom SVG icon",
        "default": false,
        "visible_if": "{{ block.settings.row2_enable }}"
      },
      {
        "type": "range",
        "id": "row2_highlight_weight",
        "label": "Row 2 highlight weight",
        "min": 500,
        "max": 900,
        "step": 50,
        "default": 700,
        "visible_if": "{{ block.settings.row2_enable }}"
      },
      {
        "type": "textarea",
        "id": "row2_svg",
        "label": "Custom icon SVG (used only if enabled)",
        "default": "<svg viewBox=\"-0.5 0 25 25\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <path d=\"M18 3.91992H6C3.79086 3.91992 2 5.71078 2 7.91992V17.9199C2 20.1291 3.79086 21.9199 6 21.9199H18C20.2091 21.9199 22 20.1291 22 17.9199V7.91992C22 5.71078 20.2091 3.91992 18 3.91992Z\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> <path d=\"M7 17.9199L17 7.91992\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> <path d=\"M8 11.9199C9.10457 11.9199 10 11.0245 10 9.91992C10 8.81535 9.10457 7.91992 8 7.91992C6.89543 7.91992 6 8.81535 6 9.91992C6 11.0245 6.89543 11.9199 8 11.9199Z\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> <path d=\"M16 17.9199C17.1046 17.9199 18 17.0245 18 15.9199C18 14.8154 17.1046 13.9199 16 13.9199C14.8954 13.9199 14 14.8154 14 15.9199C14 17.0245 14.8954 17.9199 16 17.9199Z\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> </g></svg>",
        "visible_if": "{{ block.settings.row2_custom_icon }}"
      },
      {
        "type": "header",
        "content": "Row 3"
      },
      {
        "type": "checkbox",
        "id": "row3_enable",
        "label": "Enable row 3",
        "default": false
      },
      {
        "type": "text",
        "id": "row3_lead",
        "label": "Lead text",
        "default": "Free shipping & returns:",
        "visible_if": "{{ block.settings.row3_enable }}"
      },
      {
        "type": "text",
        "id": "row3_strong",
        "label": "Highlight text",
        "visible_if": "{{ block.settings.row3_enable }}"
      },
      {
        "type": "checkbox",
        "id": "row3_custom_icon",
        "label": "Enable custom SVG icon",
        "default": false,
        "visible_if": "{{ block.settings.row3_enable }}"
      },
      {
        "type": "range",
        "id": "row3_highlight_weight",
        "label": "Row 3 highlight weight",
        "min": 500,
        "max": 900,
        "step": 50,
        "default": 700,
        "visible_if": "{{ block.settings.row3_enable }}"
      },
      {
        "type": "textarea",
        "id": "row3_svg",
        "label": "Custom icon SVG (used only if enabled)",
        "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <path d=\"M15.5777 3.38197L17.5777 4.43152C19.7294 5.56066 20.8052 6.12523 21.4026 7.13974C22 8.15425 22 9.41667 22 11.9415V12.0585C22 14.5833 22 15.8458 21.4026 16.8603C20.8052 17.8748 19.7294 18.4393 17.5777 19.5685L15.5777 20.618C13.8221 21.5393 12.9443 22 12 22C11.0557 22 10.1779 21.5393 8.42229 20.618L6.42229 19.5685C4.27063 18.4393 3.19479 17.8748 2.5974 16.8603C2 15.8458 2 14.5833 2 12.0585V11.9415C2 9.41667 2 8.15425 2.5974 7.13974C3.19479 6.12523 4.27063 5.56066 6.42229 4.43152L8.42229 3.38197C10.1779 2.46066 11.0557 2 12 2C12.9443 2 13.8221 2.46066 15.5777 3.38197Z\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path> <path d=\"M21 7.5L17 9.5M12 12L3 7.5M12 12V21.5M12 12C12 12 14.7426 10.6287 16.5 9.75C16.6953 9.65237 17 9.5 17 9.5M17 9.5V13M17 9.5L7.5 4.5\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path> </g></svg>",
        "visible_if": "{{ block.settings.row3_custom_icon }}"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "max_width",
        "label": "Max width",
        "min": 480,
        "max": 1400,
        "step": 10,
        "default": 760
      },
      {
        "type": "range",
        "id": "section_pt_d",
        "label": "Top margin",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 25
      },
      {
        "type": "range",
        "id": "section_pb_d",
        "label": "Bottom margin",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 25
      },
      {
        "type": "range",
        "id": "section_pt_m",
        "label": "Top margin (mobile)",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 20
      },
      {
        "type": "range",
        "id": "section_pb_m",
        "label": "Bottom margin (mobile)",
        "min": 0,
        "max": 120,
        "step": 5,
        "default": 15
      },
      {
        "type": "range",
        "id": "pt_d",
        "label": "Top",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 15
      },
      {
        "type": "range",
        "id": "pb_d",
        "label": "Bottom",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 15
      },
      {
        "type": "range",
        "id": "pl_d",
        "label": "Left",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 18
      },
      {
        "type": "range",
        "id": "pr_d",
        "label": "Right",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 18
      },
      {
        "type": "range",
        "id": "pt_m",
        "label": "Top (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 12
      },
      {
        "type": "range",
        "id": "pb_m",
        "label": "Bottom (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 12
      },
      {
        "type": "range",
        "id": "pl_m",
        "label": "Left (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 14
      },
      {
        "type": "range",
        "id": "pr_m",
        "label": "Right (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "default": 14
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "font_size_d",
        "label": "Font size (desktop, px)",
        "min": 12,
        "max": 22,
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "font_size_m",
        "label": "Font size (mobile, px)",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 15
      },
      {
        "type": "range",
        "id": "line_height",
        "label": "Line height (%)",
        "min": 110,
        "max": 190,
        "step": 5,
        "default": 150
      },
      {
        "type": "range",
        "id": "font_weight",
        "label": "Base font weight",
        "min": 300,
        "max": 800,
        "step": 50,
        "default": 400
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#222222",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#ffffff",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#e9e9e9",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "color",
        "id": "divider_color",
        "label": "Row divider color",
        "default": "#eeeeee",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "select",
        "id": "border_style",
        "label": "Border style",
        "default": "solid",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "dashed",
            "label": "Dashed"
          },
          {
            "value": "dotted",
            "label": "Dotted"
          }
        ]
      },
      {
        "type": "select",
        "id": "divider_style",
        "label": "Row divider style",
        "default": "solid",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "dashed",
            "label": "Dashed"
          },
          {
            "value": "dotted",
            "label": "Dotted"
          }
        ]
      },
      {
        "type": "header",
        "content": "Icons"
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon color",
        "default": "#222222",
        "visible_if": "{{ block.settings.enable_custom_style }}"
      },
      {
        "type": "range",
        "id": "icon_gap",
        "label": "Horizontal gap (icon ↔ text, px)",
        "min": 6,
        "max": 40,
        "step": 1,
        "default": 18
      },
      {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 14,
        "max": 40,
        "step": 1,
        "default": 22
      },
      {
        "type": "header",
        "content": "Options"
      },
      {
        "type": "checkbox",
        "id": "center_card",
        "label": "Center within container",
        "default": true
      },
      {
        "type": "header",
        "content": "Theme styling"
      },
      {
        "type": "checkbox",
        "id": "enable_custom_style",
        "label": "Enable custom styling",
        "default": false
      }
    ]
  }
}
</schema>
