<template compat="shopify">
{%- render 'menu-block-preview', block: block, title: 'Menu badges' -%}
</template>

<schema>
{
  "name": "Menu badges",
  "settings": [
    {
      "type": "select",
      "id": "menu_badge_style",
      "label": "Badge style",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "label": "Pill (soft rounded)"
        },
        {
          "value": "solid",
          "label": "Solid block"
        },
        {
          "value": "ghost",
          "label": "Ghost (outlined)"
        },
        {
          "value": "minimal",
          "label": "Minimal (dot + text)"
        },
        {
          "value": "soft",
          "label": "Soft (tinted)"
        },
        {
          "value": "gradient",
          "label": "Gradient glow"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "button",
          "label": "Primary button"
        },
        {
          "value": "button_secondary",
          "label": "Secondary button"
        }
      ],
      "info": "Primary button and Secondary button follow Theme settings > Buttons: colours, hover, corners, border and font. The badge colours below are for the other styles."
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Look"
    },
    {
      "type": "select",
      "id": "badge_shape",
      "label": "Corners",
      "default": "style",
      "options": [
        {
          "value": "style",
          "label": "From the style"
        },
        {
          "value": "button",
          "label": "Button corners"
        },
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "select",
      "id": "badge_font",
      "label": "Font",
      "default": "style",
      "options": [
        {
          "value": "style",
          "label": "From the style"
        },
        {
          "value": "menu",
          "label": "Menu font"
        },
        {
          "value": "button",
          "label": "Button font"
        },
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        }
      ]
    },
    {
      "type": "select",
      "id": "badge_case",
      "label": "Letter case",
      "default": "style",
      "options": [
        {
          "value": "style",
          "label": "From the style"
        },
        {
          "value": "upper",
          "label": "Uppercase"
        },
        {
          "value": "button",
          "label": "As buttons"
        },
        {
          "value": "none",
          "label": "As typed"
        }
      ]
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Text size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "badge_border",
      "label": "Border width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Outline, Primary button and Secondary button styles."
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Place on desktop",
      "default": "above",
      "options": [
        {
          "value": "above",
          "label": "Above the link"
        },
        {
          "value": "inline",
          "label": "Beside the link"
        }
      ],
      "info": "Top-level links. In dropdowns and on phones a badge sits beside its link."
    },
    {
      "type": "checkbox",
      "id": "badge_hover",
      "label": "Lift on hover",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_10",
      "label": "Hot badge"
    },
    {
      "type": "text",
      "id": "hot",
      "label": "Label text",
      "default": "Hot"
    },
    {
      "type": "color",
      "id": "label_color_hot",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "label_background_hot",
      "label": "Background",
      "default": "#353535"
    },
    {
      "type": "header",
      "id": "hdr_14",
      "label": "New badge"
    },
    {
      "type": "text",
      "id": "new",
      "label": "Label text",
      "default": "New"
    },
    {
